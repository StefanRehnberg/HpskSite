@*
 * Föreslaget skjuttid — breakdown modal. Used by the standalone
 * /faltkonfig/{id}/redigera editor.
 *@
<div class="modal fade" id="faltCfgSuggDetailsModal" tabindex="-1" style="z-index:1080">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-info-circle me-2"></i>Föreslaget skjuttid &mdash; uppdelning</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div id="faltCfgSuggDetailsContext" class="text-muted small mb-2"></div>
                <table class="table table-sm align-middle mb-0" style="table-layout:fixed;width:100%">
                    <colgroup>
                        <col style="width:auto">
                        <col style="width:140px">
                    </colgroup>
                    <tbody id="faltCfgSuggDetailsBody" style="word-break:break-word"></tbody>
                    <tfoot id="faltCfgSuggDetailsFoot" style="word-break:break-word"></tfoot>
                </table>
                <div class="text-muted small mt-2">
                    Per-skott-tider avrundas upp&aring;t till hela sekunder. St&ouml;dhand till&aring;ten s&auml;nker per-skott-tiden enligt SHB D.10.6.1 (en figur fr&aring;n &laquo;ett nummer h&ouml;gre grupp&raquo; &mdash; vi anv&auml;nder grupp &minus; 1 vid max-avst&aring;ndsber&auml;kningen).
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">St&auml;ng</button>
            </div>
        </div>
    </div>
</div>
