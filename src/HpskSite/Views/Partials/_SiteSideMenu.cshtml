@* Besökarens vy: ägarens sidor som en VÄNSTERMENY (klubbens och kretsens sida, och deras egna sidor), i stället för flikraden. Gäller ägare med den nya sidstrukturen PÅ;
   AV = dagens flikrad (ClubNavigation/RegionalNavigation ritar den som förut).
   Hem och Admin är Bootstrap-flikar på rotadressen (de växlar utan omladdning, med dagens flik-id:n och hashtolkare); varje annan post är en länk. Alla har id "{panel}-tab"
   och data-bs-target, så att dagens skript och djuplänkar (getElementById('clubCalendar-tab').click(), #clubCompetitions m.fl.) leder rätt.
   En låst sida (en vanlig medlem skulle få se den, men inte tittaren) har ett hänglås och leder till en ruta, aldrig till innehållet.
   Telefon (< 768 px): EN knapp "Meny · {sida} ▾" som fäller ut listan. Layouten (menyn till vänster, innehållet till höger) sätts av omslaget .hpsk-sidelayout/.hpsk-sidebody i vyn. *@
@model HpskSite.Services.SitePages.SiteSideMenuModel
@{
    var listId = Model.ListId;
    var current = (Model.Items.FirstOrDefault(i => i.Current) ?? Model.Items.FirstOrDefault())?.Page.Label ?? "";
}
<nav class="hpsk-sidemenu" aria-label="Sidor">
    <button type="button" class="btn btn-outline-secondary w-100 text-start d-md-none mb-2 hpsk-sitenav-toggle" id="@(listId)-toggle"
            data-bs-toggle="collapse" data-bs-target="#@listId" aria-controls="@listId" aria-expanded="false">
        <i class="bi bi-list me-2"></i>Meny · <span class="hpsk-sitenav-current">@current</span>
        <i class="bi bi-chevron-down float-end mt-1"></i>
    </button>
    <ul class="nav nav-pills flex-column collapse d-md-flex hpsk-sidemenu-list" id="@listId" role="tablist">
        @foreach (var item in Model.Items)
        {
            var icon = HpskSite.Services.SitePages.SiteMenuIcons.For(Model.OwnerType, item.Page.Key);
            <li class="nav-item" role="presentation">
                @if (item.Locked)
                {
                    <a class="nav-link hpsk-locked @(item.Current ? "active" : "")" id="@(item.PaneId)-tab" href="@item.Href" data-bs-target="#@(item.PaneId)" aria-current="@(item.Current ? "page" : null)" title="Bara för inloggade medlemmar">
                        <i class="bi @icon me-2"></i>@item.Page.Label
                        <i class="bi bi-lock-fill hpsk-lock" role="img" aria-label="Låst, bara för medlemmar"></i>
                    </a>
                }
                else if (item.IsTabButton)
                {
                    <button class="nav-link @(item.Current ? "active" : "")" id="@(item.PaneId)-tab" data-bs-toggle="tab" data-bs-target="#@(item.PaneId)" type="button" role="tab" aria-controls="@(item.PaneId)" aria-selected="@(item.Current ? "true" : "false")">
                        <i class="bi @icon me-2"></i>@item.Page.Label
                    </button>
                }
                else
                {
                    <a class="nav-link @(item.Current ? "active" : "")" id="@(item.PaneId)-tab" href="@item.Href" data-bs-target="#@(item.PaneId)" aria-current="@(item.Current ? "page" : null)">
                        <i class="bi @icon me-2"></i>@item.Page.Label
                        @if (item.Page.Key == "members")
                        {
                            <span id="prospectBadge" class="badge bg-warning text-dark ms-2" style="display: none;"></span>
                        }
                    </a>
                }
            </li>
        }
        @if (!string.IsNullOrEmpty(Model.ExternalUrl) && !string.IsNullOrEmpty(Model.ExternalLabel))
        {
            <li class="hpsk-sidemenu-sep" role="presentation" aria-hidden="true"></li>
            <li class="nav-item" role="presentation">
                <a class="nav-link hpsk-external" href="@Model.ExternalUrl">@Model.ExternalLabel<i class="bi bi-box-arrow-up-right ms-2" aria-hidden="true"></i></a>
            </li>
        }
        @* Hemsidan ligger i Admin (som Styrelsearbete och Ekonomi), inte här. *@
        @if (Model.IsAdmin && !string.IsNullOrEmpty(Model.Tutorial))
        {
            <li class="hpsk-sidemenu-sep" role="presentation" aria-hidden="true"></li>
        }
        @if (Model.IsAdmin && !string.IsNullOrEmpty(Model.Tutorial))
        {
            <li class="nav-item" role="presentation">
                <button class="btn btn-sm btn-outline-primary w-100" onclick="TutorialHelper.open('@Model.Tutorial')" title="Se instruktionsvideo för administratörer">
                    <i class="bi bi-play-circle me-1"></i>Guide
                </button>
            </li>
        }
    </ul>
</nav>
<style>
    @@media (min-width: 768px) {
        .hpsk-sidelayout { display: flex; gap: 1.5rem; align-items: flex-start; }
        .hpsk-sidelayout > .hpsk-sidemenu { flex: 0 0 250px; width: 250px; position: sticky; top: 1rem; }
        .hpsk-sidelayout > .hpsk-sidebody { flex: 1 1 auto; min-width: 0; }
        .hpsk-sidemenu .hpsk-sidemenu-list { gap: 2px; background-color: var(--bs-tertiary-bg); border: 1px solid var(--bs-border-color); border-radius: .5rem; padding: 8px; }
    }
    .hpsk-sidelayout.hpsk-admin-open > .hpsk-sidemenu { display: none; }
    .hpsk-admin-back { display: none; }
    a.hpsk-admin-back { color: var(--bs-secondary-color); font-size: .9rem; padding: 6px 12px 10px; margin-bottom: 6px; border-bottom: 1px solid var(--bs-border-color); text-decoration: none; }
    a.hpsk-admin-back:hover { color: var(--bs-link-color); }
    .hpsk-sidelayout .hpsk-admin-back { display: block; }
    .hpsk-sidemenu .nav-link { display: flex; align-items: center; width: 100%; text-align: left; color: var(--bs-body-color); border-radius: 8px; padding: 8px 12px; border-left: 3px solid transparent; }
    .hpsk-sidemenu .nav-link:hover { background-color: var(--bs-secondary-bg); }
    .hpsk-sidemenu .nav-link.active { background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary-text-emphasis); font-weight: 600; border-left-color: var(--bs-primary); }
    .hpsk-sidemenu .nav-link.hpsk-locked:not(.active) { color: var(--bs-secondary-color); }
    .hpsk-sidemenu .hpsk-lock { margin-left: auto; font-size: .85rem; }
    .hpsk-sidemenu .hpsk-external { font-size: .9rem; color: var(--bs-link-color); }
    .hpsk-sidemenu .hpsk-sidemenu-sep { border-top: 1px solid var(--bs-border-color); margin: .5rem .25rem; list-style: none; }
    @@media (max-width: 767.98px) {
        .hpsk-sidemenu .hpsk-sidemenu-list { margin-bottom: .75rem; border: 1px solid var(--bs-border-color); border-radius: .375rem; padding: .25rem; }
    }
</style>
<script>
    (function () {
        var list = document.getElementById('@listId'), btn = document.getElementById('@(listId)-toggle');
        if (!list || !btn) return;
        var label = btn.querySelector('.hpsk-sitenav-current');
        function collapseIfOpen() {
            if (list.classList.contains('show') && window.bootstrap) bootstrap.Collapse.getOrCreateInstance(list).hide();
        }
        // Hem och Admin är flikar på samma sida: etiketten följer den aktiva fliken och menyn fälls ihop.
        // Admin har en egen meny: den ERSÄTTER sidmenyn (ingen andra meny bredvid), och "Tillbaka till sidorna" i adminpanelen leder hem.
        var layout = list.closest('.hpsk-sidelayout');
        list.addEventListener('shown.bs.tab', function (e) {
            var t = e.target && e.target.textContent ? e.target.textContent.replace(/\s+/g, ' ').trim() : '';
            if (t && label) label.textContent = t;
            if (layout) layout.classList.toggle('hpsk-admin-open', !!(e.target && /Admin-tab$/.test(e.target.id)));
            collapseIfOpen();
        });
        document.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('[data-hpsk-back-to-pages]') : null;
            if (!b) return;
            e.preventDefault();
            var home = list.querySelector('button[data-bs-toggle="tab"]:not([id$="Admin-tab"])');
            if (home) home.click();
        });
        list.addEventListener('shown.bs.collapse', function () { btn.setAttribute('aria-expanded', 'true'); });
        list.addEventListener('hidden.bs.collapse', function () { btn.setAttribute('aria-expanded', 'false'); });
    })();
</script>
