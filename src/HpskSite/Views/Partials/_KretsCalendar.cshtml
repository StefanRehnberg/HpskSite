@model int
@*
    Kretskalendern (kretsgranskning fas 4) — modell = kretsnodens id.

    ⚠️ TVÅ LÄGEN, samma partial (Stefans beslut 2026-10-02), styrda av ViewData["KcMode"]:
      * "public"   (standard) — kretssidans flik Kalender: tävlingar, godkända ansökningar och
                   kretsens händelser. Inga krockar, inget stomprogram, ingen ansökningsknapp.
      * "planning" — kretsens och klubbens adminpanel: preliminära ansökningar, stomprogrammet,
                   krockvarningar och "Ansök den här dagen". Servern prövar behörigheten.
    ⚠️ Två exemplar kan stå på SAMMA sida (en kretsadmin ser både kretssidans flik och adminpanelens),
    så varje id bär ett prefix: ViewData["KcPrefix"] (standard "kc"). ViewData["KcTabId"] /
    ["KcPaneId"] = flikknappen och panelen som startar laddningen.

    Visar tävlingar, kretsens egna ansökningar (preliminära och godkända) och kretsens händelser,
    med växeln "Visa grannkretsar". Allt läses genom CompetitionApplication/GetCalendar, som avgör
    vad besökaren får se. En inloggad klubbadministratör i kretsen kan klicka på en dag och ansöka.

    ⚠️ Egna id:n och funktioner med prefixet kc — ClubCalendar har globala namn utan prefix och de
    får aldrig krocka om båda en dag hamnar på samma sida.
*@
@{
    var kcPlanning = string.Equals(ViewData["KcMode"] as string, "planning", StringComparison.OrdinalIgnoreCase);
    var P = ViewData["KcPrefix"] as string ?? (kcPlanning ? "kcp" : "kc");
    var kcTab = ViewData["KcTabId"] as string ?? "regionCalendar-tab";
    var kcPane = ViewData["KcPaneId"] as string ?? "regionCalendar";
}
@await Html.PartialAsync("_HtmlEscape")

@await Html.PartialAsync("_CalendarShared")

<div class="kc-wrap" id="@(P)Root" data-region-id="@Model" data-kc-mode="@(kcPlanning ? "planning" : "public")">
    @if (kcPlanning)
    {
        <div class="d-flex align-items-start gap-2 mb-2">
            <p class="small text-muted mb-0 flex-grow-1">Planeringskalendern: tävlingar, ansökningar (också preliminära), Förbundets stomprogram och krockvarningar. Skyttarna ser kretsens publicerade kalender på kretssidan — utan preliminära ansökningar och krockar.</p>
            @* Instruktionsfilmen om ansökan och kretsens beslut — noden tutorial-kretsplanering under /tutorials. *@
            <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" onclick="TutorialHelper.open('tutorial-kretsplanering')" title="Se instruktionsvideo om kretsens planering">
                <i class="bi bi-play-circle me-1"></i>Guide
            </button>
        </div>
    }
    <div class="kc-head">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="@(P)Prev" aria-label="Föregående"><i class="bi bi-chevron-left"></i></button>
        <h3 id="@(P)Title" aria-live="polite"></h3>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="@(P)Next" aria-label="Nästa"><i class="bi bi-chevron-right"></i></button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="@(P)Today">I dag</button>
        <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Visning">
            <button type="button" class="btn btn-outline-primary active" id="@(P)MonthBtn">Månad</button>
            <button type="button" class="btn btn-outline-primary" id="@(P)ListBtn">Lista</button>
        </div>
        <div class="form-check form-switch ms-2 mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="@(P)Neighbours">
            <label class="form-check-label small" for="@(P)Neighbours" id="@(P)NeighboursLabel">Visa grannkretsar</label>
        </div>
        <div class="form-check form-switch ms-2 mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="@(P)Holidays">
            <label class="form-check-label small" for="@(P)Holidays">Visa helgdagar</label>
        </div>
    </div>
    <div class="kc-legend mb-2">
        <span><i class="sw kc-s-tavling"></i>Tävling</span>
        <span><i class="sw kc-s-godkand"></i>Godkänd ansökan</span>
        <span><i class="sw kc-s-handelse"></i>Kretsens händelse</span>
        @if (kcPlanning)
        {
        <span><i class="sw kc-s-preliminar"></i>Preliminär (sökt)</span>
        <span><i class="sw kc-s-stomprogram"></i>Förbundets stomprogram</span>
        <span class="kc-warn"><i class="bi bi-exclamation-triangle"></i>Krock</span>
        }
    </div>
    @if (kcPlanning)
    {
    <div id="@(P)ApplyHint" class="small text-muted mb-2 d-none"><i class="bi bi-hand-index me-1"></i>Klicka på en dag för att ansöka om en tävling.</div>
    }
    <div id="@(P)Body"><div class="text-muted small">Hämtar…</div></div>
    <div id="@(P)Day" class="mt-3"></div>
</div>

@* Bara dialogen — ApplicationsClubId nollas, annars följer klubbpanelens värde med och kortet med ansökningslistan renderas en gång till. *@
@* ⚠️ Indexering, inte en samlingsinitierare: den anropar Add och kastar när nyckeln redan finns (klubbpanelen sätter den). *@
@if (kcPlanning)
{
    var kcAppsVd = new ViewDataDictionary(ViewData);
    kcAppsVd["ApplicationsClubId"] = 0;
    @await Html.PartialAsync("_CompetitionApplications", kcAppsVd)
}

<script>
(function () {
    const P = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(P));
    const MODE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(kcPlanning ? "planning" : "public"));
    const TAB = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(kcTab));
    const PANE = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(kcPane));
    const root = document.getElementById(P + 'Root');
    if (!root || root.dataset.kcInit) return;
    root.dataset.kcInit = '1';
    const REGION_ID = parseInt(root.dataset.regionId, 10);
    // Id:n skrivs som 'kcXxx' i koden och översätts till exemplarets prefix.
    const $ = id => document.getElementById(id.replace(/^kc/, P));
    const esc = s => window.hpskEsc(s);
    const MONTHS = ['januari', 'februari', 'mars', 'april', 'maj', 'juni', 'juli', 'augusti', 'september', 'oktober', 'november', 'december'];
    const DOW = ['Mån', 'Tis', 'Ons', 'Tor', 'Fre', 'Lör', 'Sön'];

    const pref = (k, d) => { try { return localStorage.getItem('kc_' + MODE + '_' + k) ?? d; } catch (e) { return d; } };
    const setPref = (k, v) => { try { localStorage.setItem('kc_' + MODE + '_' + k, v); } catch (e) { } };

    let view = pref('view', 'month');
    let cursor = new Date(); cursor.setDate(1);
    let data = null;
    $('kcNeighbours').checked = pref('neighbours', '0') === '1';
    $('kcHolidays').checked = pref('holidays', '0') === '1';
    let selectedDay = null;

    // Svenska helgdagar och aftnar — beräkningen bor i _CalendarShared, delad med klubbkalendern.
    const holidaysFor = y => window.hpskSwedishHolidays(y);   // _CalendarShared
    const holidayOn = k => $('kcHolidays').checked ? (holidaysFor(parseInt(k.slice(0, 4), 10))[k] || '') : '';

    const pad = n => String(n).padStart(2, '0');
    const key = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());

    function range() {
        if (view === 'list') {
            const f = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
            const t = new Date(cursor.getFullYear(), cursor.getMonth() + 12, 0);
            return [f, t];
        }
        const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
        const start = new Date(first); start.setDate(first.getDate() - ((first.getDay() + 6) % 7));
        const last = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0);
        const end = new Date(last); end.setDate(last.getDate() + (6 - ((last.getDay() + 6) % 7)));
        return [start, end];
    }

    function load() {
        const [f, t] = range();
        $('kcTitle').textContent = view === 'list'
            ? 'Från ' + MONTHS[cursor.getMonth()] + ' ' + cursor.getFullYear()
            : MONTHS[cursor.getMonth()].charAt(0).toUpperCase() + MONTHS[cursor.getMonth()].slice(1) + ' ' + cursor.getFullYear();
        const qs = 'regionId=' + REGION_ID + '&from=' + key(f) + '&to=' + key(t) + '&neighbours=' + ($('kcNeighbours').checked ? 'true' : 'false') + '&mode=' + MODE;
        return fetch('/umbraco/surface/CompetitionApplication/GetCalendar?' + qs, { credentials: 'same-origin' })
            .then(r => r.json()).then(d => {
                if (!d.success) { $('kcBody').innerHTML = '<div class="text-danger small">' + esc(d.message) + '</div>'; return; }
                data = d;
                // Antalet i etiketten, namnen i title — sex kretsnamn på en rad bryter huvudet.
                if (d.neighbours && d.neighbours.length) {
                    $('kcNeighboursLabel').textContent = 'Visa grannkretsar (' + d.neighbours.length + ')';
                    $('kcNeighboursLabel').title = d.neighbours.join(', ');
                }
                // Tipset bara i månadsvyn — listan har inga dagar att klicka på.
                if ($('kcApplyHint')) $('kcApplyHint').classList.toggle('d-none', view !== 'month' || !(d.applyClubs.length || d.canApplyAsRegion));
                view === 'list' ? renderList(f, t) : renderMonth(f, t);
            })
            .catch(() => { $('kcBody').innerHTML = '<div class="text-danger small">Kalendern kunde inte hämtas.</div>'; });
    }

    // ⚠️ Periodtävlingar (hemmabanetävlingar, minst fem dagar) ligger inte i dagrutorna — de hade
    // fyllt varje ruta i en hel månad. De står i ett band ovanför rutnätet och under "Pågår också".
    function entriesOn(k) {
        return data.entries.filter(e => !e.isPeriod && e.date <= k && (e.endDate || e.date) >= k);
    }
    function periodsOn(k) {
        return data.entries.filter(e => e.isPeriod && e.date <= k && (e.endDate || e.date) >= k);
    }
    const shortDate = s => { const [y, m, d] = s.split('-'); return parseInt(d, 10) + ' ' + MONTHS[parseInt(m, 10) - 1].slice(0, 3); };
    const spanText = e => shortDate(e.date) + '–' + shortDate(e.endDate || e.date);

    function chip(e) {
        const cls = 'kc-chip kc-s-' + e.status + (e.isNeighbour ? ' kc-neighbour' : '');
        const warn = e.conflicts && e.conflicts.length ? '<i class="bi bi-exclamation-triangle kc-warn me-1"></i>' : '';
        const label = (e.isNeighbour && !e.isSm ? e.regionName + ': ' : '') + e.name;
        return '<span class="' + cls + '" title="' + esc(label + ' · ' + e.statusLabel) + '">' + warn + esc(label) + '</span>';
    }

    function renderMonth(f, t) {
        const mFirst = key(new Date(cursor.getFullYear(), cursor.getMonth(), 1));
        const mLast = key(new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0));
        const periods = data.entries.filter(e => e.isPeriod && e.date <= mLast && (e.endDate || e.date) >= mFirst);
        let html = periods.length
            ? '<div class="kc-period" id="@(P)Periods"><div class="small fw-semibold mb-1"><i class="bi bi-calendar-range me-1"></i>Pågår under månaden — kan skjutas vilken dag som helst under perioden</div>'
              + periods.map(e => '<span class="kc-chip kc-s-' + e.status + (e.isNeighbour ? ' kc-neighbour' : '') + '" title="' + esc(e.name + ' · ' + spanText(e)) + '">'
                  + esc((e.isNeighbour && !e.isSm ? e.regionName + ': ' : '') + e.name) + ' · ' + esc(spanText(e)) + '</span>').join('') + '</div>'
            : '';
        html += '<div class="kc-grid" id="@(P)Grid">' + DOW.map(d => '<div class="kc-dow">' + d + '</div>').join('');
        const today = key(new Date());
        for (let d = new Date(f); d <= t; d.setDate(d.getDate() + 1)) {
            const k = key(d);
            const items = entriesOn(k);
            const other = d.getMonth() !== cursor.getMonth();
            const hol = holidayOn(k);
            html += '<div class="kc-day' + (other ? ' kc-other' : '') + (k === today ? ' kc-today' : '') + (hol ? ' kc-holiday' : '') + (k === selectedDay ? ' kc-selected' : '') + '" tabindex="0" role="button" data-kc-day="' + k + '" aria-label="' + d.getDate() + ' ' + MONTHS[d.getMonth()] + (hol ? ', ' + hol : '') + (items.length ? ', ' + items.length + ' poster' : '') + '">'
                + '<span class="kc-num">' + d.getDate() + '</span>'
                + (hol ? '<span class="kc-hol" title="' + esc(hol) + '">' + esc(hol) + '</span>' : '')
                + items.slice(0, 3).map(chip).join('')
                + (items.length > 3 ? '<span class="kc-chip">+' + (items.length - 3) + ' till</span>' : '')
                + '</div>';
        }
        html += '</div>';
        $('kcBody').innerHTML = html;
    }

    function renderList(f, t) {
        const items = data.entries.slice();
        if ($('kcHolidays').checked) {
            for (let y = f.getFullYear(); y <= t.getFullYear(); y++)
                Object.entries(holidaysFor(y)).forEach(([k, name]) => {
                    if (k >= key(f) && k <= key(t)) items.push({ kind: 'holiday', id: k, name: name, date: k, status: 'holiday' });
                });
        }
        items.sort((a, b) => a.date.localeCompare(b.date));
        if (!items.length) { $('kcBody').innerHTML = '<div class="text-muted">Inget i kalendern de kommande tolv månaderna.</div>'; return; }
        let html = '', lastMonth = '';
        items.forEach(e => {
            const m = e.date.slice(0, 7);
            if (m !== lastMonth) {
                const [y, mo] = m.split('-');
                html += '<div class="kc-list-month">' + MONTHS[parseInt(mo, 10) - 1].replace(/^./, c => c.toUpperCase()) + ' ' + y + '</div>';
                lastMonth = m;
            }
            html += row(e);
        });
        $('kcBody').innerHTML = '<div id="@(P)List">' + html + '</div>';
    }

    function row(e) {
        if (e.kind === 'holiday')
            return '<div class="kc-list-row kc-holiday-row" data-kc-entry="holiday-' + esc(e.id) + '"><div class="kc-list-date">' + esc(e.date) + '</div><div class="flex-grow-1"><i class="bi bi-flag me-1"></i>' + esc(e.name) + '</div></div>';
        const name = e.url ? '<a href="' + esc(e.url) + '">' + esc(e.name) + '</a>' : esc(e.name);
        return '<div class="kc-list-row' + (e.isNeighbour ? ' kc-neighbour' : '') + '" data-kc-entry="' + esc(e.kind + '-' + e.id) + '">'
            + '<div class="kc-list-date">' + esc(e.date) + (e.endDate && e.endDate !== e.date ? '<div class="small text-muted">– ' + esc(e.endDate) + '</div>' : '') + '</div>'
            + '<div class="flex-grow-1"><div><span class="kc-chip kc-s-' + e.status + ' d-inline-block me-1">' + esc(e.statusLabel) + '</span>' + name + '</div>'
            + '<div class="small text-muted">' + [e.organiser, e.disciplineLabel, e.levelLabel, e.place, e.isNeighbour && !e.isSm ? e.regionName : ''].filter(Boolean).map(esc).join(' · ') + '</div>'
            + (e.conflicts && e.conflicts.length ? '<div class="kc-warn"><i class="bi bi-exclamation-triangle me-1"></i>' + e.conflicts.map(esc).join(' · ') + '</div>' : '')
            + '</div></div>';
    }

    function showDay(k) {
        const items = entriesOn(k);
        const [y, mo, d] = k.split('-');
        const hol = holidayOn(k);
        let html = '<div class="card border-primary"><div class="card-body"><h4 class="h6 mb-2">' + parseInt(d, 10) + ' ' + MONTHS[parseInt(mo, 10) - 1] + ' ' + y
            + (hol ? ' <span class="small fw-normal kc-hol d-inline">— ' + esc(hol) + '</span>' : '') + '</h4>';
        html += items.length ? items.map(row).join('') : '<div class="text-muted small">Inget den dagen.</div>';
        const ongoing = periodsOn(k);
        if (ongoing.length) html += '<div class="small fw-semibold mt-3" id="@(P)DayPeriods">Pågår också (kan skjutas vilken dag som helst under perioden)</div>' + ongoing.map(row).join('');
        const clubs = data.applyClubs || [];
        if (clubs.length || data.canApplyAsRegion) {
            html += '<div class="mt-3"><button type="button" class="btn btn-primary btn-sm" data-kc-apply="1" data-date="' + k + '"><i class="bi bi-plus-lg me-1"></i>Ansök om en tävling den här dagen</button>'
                + (items.some(e => e.kind !== 'event') ? '<div class="small text-muted mt-1">Det finns redan något i kalendern den dagen — kretsen ser krockar, men de stoppar inte en ansökan.</div>' : '') + '</div>';
        }
        html += '</div></div>';
        $('kcDay').innerHTML = html;
        // ⚠️ Dagvyn står under rutnätet, ofta långt nedanför skärmkanten — utan rullningen ser ett
        // klick på en dag ut att inte göra någonting.
        selectedDay = k;
        root.querySelectorAll('.kc-day.kc-selected').forEach(x => x.classList.remove('kc-selected'));
        const cell = root.querySelector('[data-kc-day="' + k + '"]');
        if (cell) cell.classList.add('kc-selected');
        const card = $('kcDay').firstElementChild;
        if (card) {
            const r = card.getBoundingClientRect();
            if (r.top < 0 || r.bottom > window.innerHeight) card.scrollIntoView({ behavior: 'smooth', block: r.height > window.innerHeight ? 'start' : 'nearest' });
            const btn = card.querySelector('[data-kc-apply]');
            if (btn) btn.focus({ preventScroll: true });
        }
    }

    document.addEventListener('click', function (e) {
        const day = e.target.closest('[data-kc-day]');
        if (day && root.contains(day)) { showDay(day.dataset.kcDay); return; }
        const apply = e.target.closest('[data-kc-apply]');
        if (apply && root.contains(apply)) {
            const clubs = (data.applyClubs || []).slice();
            if (!clubs.length && data.canApplyAsRegion) clubs.push({ id: 0, name: data.region.name + ' (kretsen själv)' });
            window.hpskAppOpenForm({ clubs: clubs, date: apply.dataset.date, regionId: REGION_ID });
        }
    });
    document.addEventListener('keydown', function (e) {
        const day = e.target.closest && e.target.closest('[data-kc-day]');
        if (day && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); showDay(day.dataset.kcDay); }
    });
    // Efter en ansökan från kalendern: läs om, så att den preliminära posten syns direkt.
    if (MODE === 'planning') window.hpskAppSaved = function () { load(); $('kcDay').innerHTML = '<div class="alert alert-success py-2">Ansökan är skickad. Den syns i kalendern som preliminär tills kretsen beslutat.</div>'; };

    $('kcPrev').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() - 1); load(); });
    $('kcNext').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() + 1); load(); });
    $('kcToday').addEventListener('click', () => { cursor = new Date(); cursor.setDate(1); load(); });
    function setView(v) {
        view = v; setPref('view', v);
        $('kcMonthBtn').classList.toggle('active', v === 'month');
        $('kcListBtn').classList.toggle('active', v === 'list');
        $('kcDay').innerHTML = '';
        selectedDay = null;
        load();
    }
    $('kcMonthBtn').addEventListener('click', () => setView('month'));
    $('kcListBtn').addEventListener('click', () => setView('list'));
    $('kcNeighbours').addEventListener('change', () => { setPref('neighbours', $('kcNeighbours').checked ? '1' : '0'); load(); });
    // Helgdagarna räknas i webbläsaren — ingen ny hämtning behövs, bara en ny ritning.
    $('kcHolidays').addEventListener('change', () => {
        setPref('holidays', $('kcHolidays').checked ? '1' : '0');
        if (!data) return;
        const [f, t] = range();
        view === 'list' ? renderList(f, t) : renderMonth(f, t);
        if (selectedDay && $('kcDay').innerHTML) showDay(selectedDay);
    });

    // Ladda när fliken visas första gången (sidan har många flikar).
    let started = false;
    const start = () => { if (started) return; started = true; setView(view); };
    const tab = document.getElementById(TAB);
    if (tab) { tab.addEventListener('shown.bs.tab', start); tab.addEventListener('click', start); }
    if (document.getElementById(PANE)?.classList.contains('active')) start();
})();
</script>
