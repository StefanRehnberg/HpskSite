@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // P2 (Stefan 2026-10-23): förberedelserna görs i tävlingens PLANERING. Den här fliken visar bara
    // läget och leder dit — eller startar planeringen, eller kopplar en planering man redan leder.
    // Ingenting skapas när sidan visas. Se notes/tavlingsplanering-p2-plan-2026-10-23.md.
    var competitionId = ViewData["CompetitionId"];
    var cpToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<div id="cpCard" class="card shadow-sm" style="max-width:760px">
    <div class="card-body">
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Laddar…</div>
    </div>
</div>
<script>
(function () {
    var COMP = @(competitionId ?? 0);
    var TOKEN = '@cpToken';
    var card = document.getElementById('cpCard');
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function body(html) { card.querySelector('.card-body').innerHTML = html; }
    function post(url, data) {
        var fd = new FormData();
        Object.keys(data || {}).forEach(function (k) { fd.append(k, data[k]); });
        fd.append('__RequestVerificationToken', TOKEN);
        return fetch(url, { method: 'POST', body: fd, credentials: 'same-origin' }).then(function (r) { return r.json(); });
    }
    function plural(n, one, many) { return n + ' ' + (n === 1 ? one : many); }

    function render(s) {
        if (!s.success) { body('<div class="alert alert-warning mb-0">' + esc(s.message || 'Förberedelserna kunde inte läsas.') + '</div>'); return; }
        if (s.planning) {
            var p = s.planning;
            var stats = [];
            stats.push('<span class="badge text-bg-light border">' + plural(p.open, 'öppen uppgift', 'öppna uppgifter') + '</span>');
            if (p.overdue > 0) stats.push('<span class="badge text-bg-danger">' + plural(p.overdue, 'försenad', 'försenade') + '</span>');
            if (p.done > 0) stats.push('<span class="badge text-bg-success">' + p.done + ' utförda</span>');
            body('<h2 class="h5 mb-1"><i class="bi bi-list-check me-2"></i>Förberedelserna</h2>'
                + '<p class="text-muted mb-3">Görs i tävlingens planering, <b>' + esc(p.name) + '</b>. Där finns också meddelanden, möten och vem som gör vad.</p>'
                + '<div class="d-flex flex-wrap gap-2 mb-3">' + stats.join('') + '</div>'
                + '<a class="btn btn-primary btn-lg" id="cpOpen" href="' + esc(p.url) + '"><i class="bi bi-box-arrow-in-right me-2"></i>Öppna förberedelserna</a>');
            return;
        }
        var moved = s.oldPrepCount > 0
            ? '<p class="mb-3">Tävlingen har redan <b>' + plural(s.oldPrepCount, 'uppgift', 'uppgifter') + '</b> i förberedelserna. De flyttas in i planeringen när du startar den.</p>'
            : '';
        var link = '';
        if (s.canLink && s.linkable && s.linkable.length) {
            link = '<hr class="my-4"><p class="mb-2"><b>Planerar ni redan i en egen planering?</b> Koppla den till tävlingen i stället.</p>'
                + '<div class="d-flex flex-wrap gap-2"><select class="form-select" id="cpLinkSel" style="max-width:340px">'
                + s.linkable.map(function (l) { return '<option value="' + l.id + '">' + esc(l.name) + '</option>'; }).join('')
                + '</select><button type="button" class="btn btn-outline-primary" id="cpLink">Koppla planeringen</button></div>';
        }
        body('<h2 class="h5 mb-1"><i class="bi bi-list-check me-2"></i>Förberedelserna</h2>'
            + '<p class="text-muted mb-3">Förberedelserna görs i en planering: vem som gör vad, sista dagar, möten och meddelanden — på ett ställe. '
            + 'Alla som har tillgång till tävlingen kommer in i den.</p>'
            + moved
            + '<button type="button" class="btn btn-primary btn-lg" id="cpStart"><i class="bi bi-play-circle me-2"></i>Starta tävlingens planering</button>'
            + '<div id="cpMsg" class="mt-3"></div>'
            + link);
        document.getElementById('cpStart').addEventListener('click', function (e) {
            e.target.disabled = true;
            post('/umbraco/surface/Planning/StartForCompetition', { competitionId: COMP }).then(function (r) {
                if (r.success) { location.href = r.url; return; }
                e.target.disabled = false;
                document.getElementById('cpMsg').innerHTML = '<div class="alert alert-danger mb-0">' + esc(r.message || 'Planeringen kunde inte startas.') + '</div>';
            });
        });
        var lb = document.getElementById('cpLink');
        if (lb) lb.addEventListener('click', function () {
            lb.disabled = true;
            var pid = document.getElementById('cpLinkSel').value;
            post('/umbraco/surface/Planning/LinkCompetition', { id: pid, competitionId: COMP }).then(function (r) {
                if (r.success) { location.href = r.url; return; }
                lb.disabled = false;
                document.getElementById('cpMsg').innerHTML = '<div class="alert alert-danger mb-0">' + esc(r.message || 'Planeringen kunde inte kopplas.') + '</div>';
            });
        });
    }
    fetch('/umbraco/surface/Planning/CompetitionState?competitionId=' + COMP, { credentials: 'same-origin' })
        .then(function (r) { return r.json(); }).then(render)
        .catch(function () { body('<div class="alert alert-warning mb-0">Förberedelserna kunde inte läsas. Ladda om sidan.</div>'); });
})();
</script>
