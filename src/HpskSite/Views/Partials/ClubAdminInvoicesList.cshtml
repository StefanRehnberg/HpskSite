@*
 * Club Admin Invoices List View
 * Displays table of invoices for club competitions with filtering and payment actions
 * Swedish translation, simplified from AdminInvoicesList.cshtml
 * Version: 2025-12-23 v1
*@

<div class="club-invoices-list">
    <!-- Header with View Type Selector -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h5><i class="bi bi-receipt me-2"></i>Fakturor</h5>
    </div>

    <!-- View Type Selector -->
    <div class="mb-3">
        <select class="form-select" id="clubInvoiceViewType" onchange="changeClubInvoiceViewType()">
            <option value="outgoing">Fakturor att betala</option>
            <option value="incoming">Fakturor att få betalt för</option>
            <option value="members">Medlemmars fakturor</option>
        </select>
    </div>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="clubStatusFilterInvoices" class="form-label">Status</label>
                    <select class="form-select" id="clubStatusFilterInvoices" onchange="applyClubInvoiceFilters()">
                        <option value="">Alla</option>
                        <option value="Pending">Väntande</option>
                        <option value="Paid">Betald</option>
                        <option value="Cancelled">Makulerad</option>
                        <option value="Failed">Misslyckad</option>
                        <option value="Refunded">Återbetald</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="clubMemberSearchInvoices" class="form-label">Medlem</label>
                    <input type="text" class="form-control" id="clubMemberSearchInvoices" placeholder="Sök medlem..." onkeyup="applyClubInvoiceFilters()">
                </div>
                <div class="col-md-3">
                    <label for="clubInvoiceNumberSearch" class="form-label">Fakturanummer</label>
                    <input type="text" class="form-control" id="clubInvoiceNumberSearch" placeholder="Sök faktura..." onkeyup="applyClubInvoiceFilters()">
                </div>
                <div class="col-md-3 d-flex flex-column justify-content-between">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="clubExcludePaidFilter" checked onchange="applyClubInvoiceFilters()">
                        <label class="form-check-label" for="clubExcludePaidFilter">
                            Dölj betalda och makulerade
                        </label>
                    </div>
                    <button class="btn btn-outline-secondary btn-sm mt-2" onclick="clearClubInvoiceFilters()">
                        <i class="bi bi-x-circle me-1"></i>Rensa filter
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4" id="clubInvoiceSummaryCards">
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Totalt</h6>
                    <h4 class="card-title mb-0" id="clubTotalInvoicesCount">-</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Betald</h6>
                    <h4 class="card-title mb-0 text-success" id="clubPaidAmount">- kr</h4>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Väntande</h6>
                    <h4 class="card-title mb-0 text-warning" id="clubPendingAmount">- kr</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    <div class="spinner-border text-primary d-none" id="clubInvoicesLoadingSpinner" role="status">
        <span class="visually-hidden">Laddar...</span>
    </div>

    <!-- Invoices Table -->
    @* Betala flera — only meaningful in the PAYER views (the club pays its own fees, or pays on its
       members' behalf). In "att få betalt för" the club is the recipient, so there is nothing to pay.
       Hidden until the doctype properties exist (see GetConsolidationReadiness). *@
    <div class="alert alert-primary d-none align-items-center justify-content-between flex-wrap gap-2"
         id="clubPayBar" role="region" aria-label="Betala flera fakturor">
        <div>
            <i class="bi bi-check2-square me-2"></i>
            <strong id="clubPayBarCount">0 valda</strong>
            <span class="ms-2" id="clubPayBarTotal"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="clubPayBarClear">Avmarkera alla</button>
            <button type="button" class="btn btn-sm btn-primary" id="clubPayBarPay">
                <i class="bi bi-receipt me-1"></i>Betala valda
            </button>
        </div>
    </div>
    <div class="alert alert-warning d-none small" id="clubConsolidationUnavailable"></div>

    <div class="table-responsive" id="clubInvoicesTableContainer">
        <table class="table table-hover table-sm">
            <thead class="table-light">
                <tr>
                    <th class="d-none" id="clubInvoiceSelectAllCell" style="width:36px;">
                        <input type="checkbox" class="form-check-input" id="clubInvoiceSelectAll"
                               title="Markera alla på denna sida" aria-label="Markera alla på denna sida">
                    </th>
                    <th>Fakturanummer</th>
                    <th>Tävling</th>
                    <th>Medlem</th>
                    <th class="text-end">Belopp</th>
                    <th>Status</th>
                    <th>Skapad</th>
                    <th>Betaldatum</th>
                    <th class="text-end">Åtgärder</th>
                </tr>
            </thead>
            <tbody id="clubInvoicesTableBody">
                <tr class="text-muted">
                    <td colspan="9" class="text-center py-4">Laddar fakturor...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <nav aria-label="Club invoice pagination" class="d-none" id="clubInvoicePaginationNav">
        <div class="d-flex justify-content-between align-items-center">
            <div class="text-muted">
                Visar <span id="clubInvoicePageInfo">-</span>
            </div>
            <ul class="pagination mb-0" id="clubInvoicePagination">
                <!-- Pagination items will be inserted here -->
            </ul>
        </div>
    </nav>

    <!-- Empty State -->
    <div class="alert alert-info d-none text-center" id="clubNoInvoicesAlert">
        <i class="bi bi-inbox me-2"></i>
        <span id="clubNoInvoicesMessage">Inga fakturor hittades.</span>
    </div>

    <!-- Error Alert -->
    <div class="alert alert-danger d-none" id="clubInvoicesErrorAlert" role="alert">
        <strong>Fel:</strong> <span id="clubInvoicesErrorMessage"></span>
    </div>
</div>

<!-- Include Swish Payment Modal Partial -->
@await Html.PartialAsync("SwishPaymentModal")

@* Confirmation for "Betala valda". Shows what will actually be created BEFORE anything is written:
   one faktura per tävling, who receives each payment, and anything that had to be dropped. A
   selection spanning tävlingar/mottagare can never be one payment, so that is stated plainly. *@
<div class="modal fade" id="clubConsolidateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-receipt me-2"></i>Betala flera fakturor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div id="clubConsolidateLoading" class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                    <span class="ms-2">Kontrollerar valda fakturor...</span>
                </div>
                <div id="clubConsolidateBody" class="d-none">
                    <div class="alert alert-warning d-none" id="clubConsolidateWarning"></div>
                    <div id="clubConsolidateGroups"></div>
                    <div class="d-none" id="clubConsolidateRejectedWrap">
                        <hr>
                        <h6 class="text-muted"><i class="bi bi-exclamation-circle me-1"></i>Kan inte betalas nu</h6>
                        <ul class="small mb-0" id="clubConsolidateRejected"></ul>
                    </div>
                </div>
                <div class="alert alert-danger d-none" id="clubConsolidateError"></div>
                <div class="alert alert-success d-none" id="clubConsolidateSuccess"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="clubConsolidateConfirm" disabled>
                    Skapa faktura(-or)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- HTML Template for Invoice Row -->
<script type="text/html" id="club-invoice-row-template">
    <tr data-invoice-id="{id}">
        <td class="club-invoice-select-cell d-none">
            @* data-status must be the RAW status: {paymentStatus} is substituted with the translated
               Swedish label ("Väntande"), which would never match the "Pending" test. *@
            @* data-settled: an invoice already covered by a samlingsfaktura stays PENDING until that
               parent is paid, so a status test alone would still offer it — and the user would only
               find out from the confirmation dialog. *@
            <input type="checkbox" class="form-check-input club-invoice-select" value="{id}"
                   data-amount="{totalAmount}" data-status="{rawStatus}" data-settled="{settledBy}"
                   aria-label="Välj faktura {invoiceNumber}">
        </td>
        <td><strong>{invoiceNumber}</strong>{kindBadge}</td>
        <td>{competitionName}</td>
        <td>{memberName}</td>
        <td class="text-end">{totalAmount} kr</td>
        <td><span class="badge bg-{statusClass}">{paymentStatus}</span>{sentBadge}</td>
        <td>{createdDate}</td>
        <td>{paymentDate}</td>
        <td class="text-end">
            <div class="btn-group btn-group-sm" role="group">
                <button class="btn btn-outline-primary" onclick="showClubSwishQRCode({id})" title="Visa Swish QR-kod">
                    <i class="bi bi-qr-code"></i>
                </button>
                <button class="btn btn-outline-info" onclick="resendClubInvoiceEmail({id})" title="Skicka QR-kod via e-post">
                    <i class="bi bi-envelope"></i>
                </button>
                {markAction}
                <button class="btn btn-outline-danger {hideIfCancelled}" onclick="cancelClubInvoice({id}, '{invoiceNumber}')" title="Makulera">
                    <i class="bi bi-x-circle"></i>
                </button>
            </div>
        </td>
    </tr>
</script>

<style>
/* Compact table styling */
.club-invoices-list .table-sm td,
.club-invoices-list .table-sm th {
    padding: 0.4rem;
    font-size: 0.9rem;
}

.club-invoices-list .btn-group-sm > .btn {
    padding: 0.2rem 0.4rem;
    font-size: 0.85rem;
}
</style>

<script>
// Club Invoices variables (namespaced to avoid conflicts)
let clubInvoicesListLoaded = false;
let currentClubInvoicePage = 1;
const clubInvoicesPerPage = 50;

function changeClubInvoiceViewType() {
    currentClubInvoicePage = 1;
    // Switching view changes WHICH invoices are on screen, and in "att få betalt för" selection is
    // meaningless — so drop any ticks rather than carry them across.
    clubResetSelection();
    loadClubInvoices();
}

// Ask once whether samlingsfakturor are usable, and wire the pay bar. Runs on include; the readiness
// probe is cheap and read-only, and the checkbox column stays hidden until it answers yes.
(function clubInitConsolidation() {
    function start() {
        clubBindPayBar();
        clubCheckConsolidationReady();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
})();

// Every load gets a sequence number and only the NEWEST response is allowed to render. Without this
// a slow earlier request (this list walks the content tree and can take 20-30 s) lands after a newer
// one and repaints the table with the previous view's rows — while the checkboxes keep the selection
// made against what is now on screen. That is the difference between a cosmetic flicker and a club
// paying the wrong invoices.
let clubInvoiceLoadSeq = 0;

// Load club invoices function
function loadClubInvoices() {
    const mySeq = ++clubInvoiceLoadSeq;
    const spinner = document.getElementById('clubInvoicesLoadingSpinner');
    const tableContainer = document.getElementById('clubInvoicesTableContainer');
    const tbody = document.getElementById('clubInvoicesTableBody');
    const errorAlert = document.getElementById('clubInvoicesErrorAlert');
    const errorMessage = document.getElementById('clubInvoicesErrorMessage');
    const noInvoicesAlert = document.getElementById('clubNoInvoicesAlert');

    spinner.classList.remove('d-none');
    errorAlert.classList.add('d-none');
    noInvoicesAlert.classList.add('d-none');

    // Build query parameters - using clubId from parent scope
    const viewType = document.getElementById('clubInvoiceViewType')?.value || 'outgoing';
    const paymentStatus = document.getElementById('clubStatusFilterInvoices')?.value || '';
    const memberSearch = document.getElementById('clubMemberSearchInvoices')?.value || '';
    const invoiceNumberSearch = document.getElementById('clubInvoiceNumberSearch')?.value || '';
    const excludePaid = document.getElementById('clubExcludePaidFilter')?.checked ?? true;

    const params = new URLSearchParams({
        clubId: clubId,  // Uses the global clubId variable from ClubAdminPanel
        page: currentClubInvoicePage,
        pageSize: clubInvoicesPerPage,
        activeCompetitionsOnly: false,  // Show all competitions for the club
        excludePaid: excludePaid,
        viewType: viewType
    });

    if (paymentStatus) params.append('paymentStatus', paymentStatus);
    if (memberSearch) params.append('memberSearch', memberSearch);
    if (invoiceNumberSearch) params.append('invoiceNumberSearch', invoiceNumberSearch);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    fetch(`/umbraco/surface/InvoiceAdmin/GetInvoices?${params.toString()}`, {
        method: 'GET',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        credentials: 'include'
    })
        .then(response => response.json())
        .then(data => {
            if (mySeq !== clubInvoiceLoadSeq) return;   // a newer load already owns the table
            spinner.classList.add('d-none');

            if (!data.success) {
                errorMessage.textContent = data.message || 'Kunde inte ladda fakturor';
                errorAlert.classList.remove('d-none');
                tbody.innerHTML = '<tr class="text-muted"><td colspan="9" class="text-center py-4">Fel vid laddning av fakturor</td></tr>';
                return;
            }

            const invoices = data.invoices || [];
            const metadata = data.metadata || {};

            // Update summary cards
            updateClubSummaryCards(metadata);

            if (invoices.length === 0) {
                tableContainer.classList.add('d-none');
                noInvoicesAlert.classList.remove('d-none');
                const emptyMessages = {
                    'outgoing': 'Inga fakturor att betala hittades.',
                    'incoming': 'Inga fakturor att få betalt för hittades.',
                    'members': 'Inga fakturor för klubbens medlemmar hittades.'
                };
                const vt = document.getElementById('clubInvoiceViewType')?.value || 'outgoing';
                document.getElementById('clubNoInvoicesMessage').textContent = emptyMessages[vt] || 'Inga fakturor hittades.';
                tbody.innerHTML = '';
                document.getElementById('clubInvoicePaginationNav').classList.add('d-none');
            } else {
                tableContainer.classList.remove('d-none');
                noInvoicesAlert.classList.add('d-none');
                renderClubInvoices(invoices);
                renderClubPagination(metadata);
            }
            // The rows just changed, so any prior tick refers to rows that may be gone.
            clubResetSelection();
            clubApplySelectionMode();
        })
        .catch(error => {
            if (mySeq !== clubInvoiceLoadSeq) return;
            spinner.classList.add('d-none');
            errorMessage.textContent = error.message || 'Nätverksfel';
            errorAlert.classList.remove('d-none');
        });
}

// ==================== Betala flera (samlingsfaktura) ====================
// Selection lives here rather than on the DOM so it survives a re-render; the ids are re-checked
// against the visible rows on every render, and the server re-validates everything again at POST.
const clubSelectedInvoices = new Set();
let clubConsolidationReady = null;   // null = not asked yet

// Only the payer views: in "att få betalt för" the club is the RECIPIENT, so there is nothing to pay.
function clubSelectionAllowed() {
    const vt = document.getElementById('clubInvoiceViewType')?.value || 'outgoing';
    return (vt === 'outgoing' || vt === 'members') && clubConsolidationReady === true;
}

function clubResetSelection() {
    clubSelectedInvoices.clear();
    const all = document.getElementById('clubInvoiceSelectAll');
    if (all) { all.checked = false; all.indeterminate = false; }
    clubUpdatePayBar();
}

// Show/hide the checkbox column and keep the ticks in sync with what is actually on screen.
function clubApplySelectionMode() {
    const allowed = clubSelectionAllowed();
    document.getElementById('clubInvoiceSelectAllCell')?.classList.toggle('d-none', !allowed);
    document.querySelectorAll('.club-invoice-select-cell').forEach(td => td.classList.toggle('d-none', !allowed));

    if (!allowed) { clubSelectedInvoices.clear(); clubUpdatePayBar(); return; }

    document.querySelectorAll('.club-invoice-select').forEach(cb => {
        // Only unpaid invoices can be consolidated, AND not ones already covered by a samlingsfaktura
        // (those stay Pending until their parent is paid, so the status alone would still offer them).
        // The server rejects both anyway; a disabled box is clearer than a rejection after the fact.
        const alreadySettled = parseInt(cb.dataset.settled || '0') > 0;
        const payable = (cb.dataset.status || '') === 'Pending' && !alreadySettled;
        cb.disabled = !payable;
        if (alreadySettled) {
            cb.title = 'Ingår redan i en samlingsfaktura';
            cb.closest('tr')?.classList.add('text-muted');
        }
        if (!payable) { cb.checked = false; clubSelectedInvoices.delete(parseInt(cb.value)); }
        else cb.checked = clubSelectedInvoices.has(parseInt(cb.value));
        cb.onchange = () => {
            const id = parseInt(cb.value);
            if (cb.checked) clubSelectedInvoices.add(id); else clubSelectedInvoices.delete(id);
            clubUpdatePayBar();
        };
    });
    clubUpdatePayBar();
}

function clubUpdatePayBar() {
    const bar = document.getElementById('clubPayBar');
    if (!bar) return;
    const allowed = clubSelectionAllowed();
    const n = clubSelectedInvoices.size;
    bar.classList.toggle('d-none', !allowed || n === 0);
    if (!allowed || n === 0) return;

    bar.classList.add('d-flex');
    let sum = 0;
    document.querySelectorAll('.club-invoice-select').forEach(cb => {
        if (clubSelectedInvoices.has(parseInt(cb.value))) sum += parseFloat(cb.dataset.amount || '0') || 0;
    });
    document.getElementById('clubPayBarCount').textContent = `${n} valda`;
    // Only the ticks on THIS page can be summed, so say so rather than showing a misleading total.
    document.getElementById('clubPayBarTotal').textContent = `· ${sum.toFixed(2)} kr på denna sida`;

    const boxes = Array.from(document.querySelectorAll('.club-invoice-select:not(:disabled)'));
    const all = document.getElementById('clubInvoiceSelectAll');
    if (all && boxes.length) {
        const checked = boxes.filter(cb => cb.checked).length;
        all.checked = checked === boxes.length;
        all.indeterminate = checked > 0 && checked < boxes.length;
    }
}

async function clubCheckConsolidationReady() {
    try {
        const r = await fetch('/umbraco/surface/InvoiceAdmin/GetConsolidationReadiness',
            { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const d = await r.json();
        clubConsolidationReady = d.success === true && d.ready === true;
        const warn = document.getElementById('clubConsolidationUnavailable');
        if (warn && d.success && !d.ready) {
            warn.textContent = d.message || 'Samlingsfakturor är inte aktiverade.';
            warn.classList.remove('d-none');
        }
    } catch (e) {
        clubConsolidationReady = false;
    }
    clubApplySelectionMode();
}

function clubBindPayBar() {
    document.getElementById('clubInvoiceSelectAll')?.addEventListener('change', function () {
        document.querySelectorAll('.club-invoice-select:not(:disabled)').forEach(cb => {
            cb.checked = this.checked;
            const id = parseInt(cb.value);
            if (this.checked) clubSelectedInvoices.add(id); else clubSelectedInvoices.delete(id);
        });
        clubUpdatePayBar();
    });
    document.getElementById('clubPayBarClear')?.addEventListener('click', () => {
        document.querySelectorAll('.club-invoice-select').forEach(cb => { cb.checked = false; });
        clubResetSelection();
    });
    document.getElementById('clubPayBarPay')?.addEventListener('click', clubOpenConsolidateModal);
    document.getElementById('clubConsolidateConfirm')?.addEventListener('click', clubDoConsolidate);
}

function clubEsc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, c =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
}

let clubConsolidatePlan = null;

async function clubOpenConsolidateModal() {
    const ids = Array.from(clubSelectedInvoices);
    if (!ids.length) return;

    const modalEl = document.getElementById('clubConsolidateModal');
    const modal = new bootstrap.Modal(modalEl);
    document.getElementById('clubConsolidateLoading').classList.remove('d-none');
    document.getElementById('clubConsolidateBody').classList.add('d-none');
    document.getElementById('clubConsolidateError').classList.add('d-none');
    document.getElementById('clubConsolidateSuccess').classList.add('d-none');
    document.getElementById('clubConsolidateConfirm').disabled = true;
    modal.show();

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    let data;
    try {
        const r = await fetch('/umbraco/surface/InvoiceAdmin/PreviewConsolidation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ payerClubId: clubId, invoiceIds: ids })
        });
        data = await r.json();
    } catch (e) {
        document.getElementById('clubConsolidateLoading').classList.add('d-none');
        const err = document.getElementById('clubConsolidateError');
        err.textContent = 'Nätverksfel vid kontroll av fakturor.';
        err.classList.remove('d-none');
        return;
    }

    document.getElementById('clubConsolidateLoading').classList.add('d-none');
    if (!data.success) {
        const err = document.getElementById('clubConsolidateError');
        err.textContent = data.message || 'Kunde inte kontrollera fakturorna.';
        err.classList.remove('d-none');
        return;
    }

    clubConsolidatePlan = ids;
    document.getElementById('clubConsolidateBody').classList.remove('d-none');

    const warnEl = document.getElementById('clubConsolidateWarning');
    warnEl.classList.toggle('d-none', !data.warning);
    if (data.warning) warnEl.textContent = data.warning;

    const groups = data.groups || [];
    // A group with no resolvable recipient is refused by the server (a payment claim needs someone to
    // pay), so say that HERE rather than letting the user press Skapa and get a failure back.
    const payableGroups = groups.filter(g => g.payeeKey && g.payeeKey.length > 0);
    document.getElementById('clubConsolidateGroups').innerHTML = groups.length === 0
        ? '<p class="text-muted mb-0">Inga av de valda fakturorna kan betalas nu.</p>'
        : groups.map(g => {
            const blocked = !g.payeeKey || g.payeeKey.length === 0;
            return `
            <div class="card mb-2 ${blocked ? 'border-danger' : ''}">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>${clubEsc(g.competitionName)}</strong><br>
                            <span class="small text-muted">
                                Betalas till ${clubEsc(g.payeeName)}
                                ${g.hasSwishNumber || blocked ? '' : ' <span class="text-danger">(inget Swish-nummer angivet)</span>'}
                            </span>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold">${Number(g.total).toFixed(2)} kr</div>
                            <div class="small text-muted">${g.invoices.length} anmälningar</div>
                        </div>
                    </div>
                    <div class="small mt-2">
                        ${blocked
                            ? '<span class="badge bg-danger">Ingen tydlig mottagare — kan inte betalas här</span>'
                            : g.needsParent
                                ? '<span class="badge bg-primary">En samlingsfaktura skapas</span>'
                                : '<span class="badge bg-secondary">Endast en faktura — betalas direkt, ingen samlingsfaktura</span>'}
                    </div>
                    <ul class="small text-muted mb-0 mt-2">
                        ${g.invoices.map(i => `<li>${clubEsc(i.invoiceNumber)} · ${clubEsc(i.memberName)} · ${Number(i.amount).toFixed(2)} kr</li>`).join('')}
                    </ul>
                </div>
            </div>`; }).join('');

    const rejected = data.rejected || [];
    document.getElementById('clubConsolidateRejectedWrap').classList.toggle('d-none', rejected.length === 0);
    document.getElementById('clubConsolidateRejected').innerHTML = rejected
        .map(r => `<li>${clubEsc(r.invoiceNumber || '')} ${clubEsc(r.memberName || '')} — ${clubEsc(r.reason || '')}</li>`).join('');

    document.getElementById('clubConsolidateConfirm').disabled = payableGroups.length === 0;
}

async function clubDoConsolidate() {
    const btn = document.getElementById('clubConsolidateConfirm');
    btn.disabled = true;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    try {
        const r = await fetch('/umbraco/surface/InvoiceAdmin/CreateConsolidatedInvoices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ payerClubId: clubId, invoiceIds: clubConsolidatePlan || [] })
        });
        const d = await r.json();
        if (!d.success) {
            const err = document.getElementById('clubConsolidateError');
            err.textContent = d.message || 'Kunde inte skapa samlingsfakturan.';
            err.classList.remove('d-none');
            btn.disabled = false;
            return;
        }
        const okEl = document.getElementById('clubConsolidateSuccess');
        const failedGroups = (d.parents || []).filter(x => x.error);
        okEl.innerHTML = clubEsc(d.message)
            + (failedGroups.length
                ? '<ul class="mb-0 mt-2">' + failedGroups.map(x => `<li>${clubEsc(x.competitionName)}: ${clubEsc(x.error)}</li>`).join('') + '</ul>'
                : '');
        okEl.classList.remove('d-none');
        document.getElementById('clubConsolidateBody').classList.add('d-none');
        clubResetSelection();
        loadClubInvoices();
    } catch (e) {
        const err = document.getElementById('clubConsolidateError');
        err.textContent = 'Nätverksfel.';
        err.classList.remove('d-none');
        btn.disabled = false;
    }
}

function updateClubSummaryCards(metadata) {
    document.getElementById('clubTotalInvoicesCount').textContent = metadata.totalInvoices || 0;
    document.getElementById('clubPaidAmount').textContent = (metadata.paidAmount || 0).toFixed(2) + ' kr';
    document.getElementById('clubPendingAmount').textContent = (metadata.pendingAmount || 0).toFixed(2) + ' kr';

    // Update summary card labels based on view type
    const vt = document.getElementById('clubInvoiceViewType')?.value || 'outgoing';
    const paidLabel = document.querySelector('#clubInvoiceSummaryCards .text-success')?.closest('.card-body')?.querySelector('.card-subtitle');
    const pendingLabel = document.querySelector('#clubInvoiceSummaryCards .text-warning')?.closest('.card-body')?.querySelector('.card-subtitle');
    if (paidLabel) paidLabel.textContent = vt === 'outgoing' ? 'Betalt' : 'Betald';
    if (pendingLabel) pendingLabel.textContent = vt === 'outgoing' ? 'Att betala' : 'Väntande';
}

function renderClubInvoices(invoices) {
    const tbody = document.getElementById('clubInvoicesTableBody');
    const template = document.getElementById('club-invoice-row-template').textContent;

    // In the payer views (the club pays on members' behalf, or pays its team fees) the
    // mark action is a "betald av klubben" CLAIM — it must NOT flip the organizer's
    // authoritative "received" state. Only the organizer (incoming view) sets received.
    const viewType = document.getElementById('clubInvoiceViewType')?.value || 'outgoing';
    const isPayerView = (viewType === 'members' || viewType === 'outgoing');

    tbody.innerHTML = invoices.map(invoice => {
        const statusClass = getClubStatusClass(invoice.paymentStatus);
        const statusText = translateClubStatus(invoice.paymentStatus);
        const hideIfCancelled = invoice.paymentStatus === 'Cancelled' ? 'd-none' : '';
        const createdDate = invoice.createdDate ? new Date(invoice.createdDate).toLocaleDateString('sv-SE') : '-';
        const paymentDate = invoice.paymentDate ? new Date(invoice.paymentDate).toLocaleDateString('sv-SE') : '-';

        // A samlingsfaktura and a kreditfaktura are NOT ordinary fees. Unlabelled, a parent reads as a
        // duplicate demand for money the club is already paying per shooter, and a credit note reads as
        // yet another charge instead of a deduction.
        let kindBadge = '';
        if (invoice.invoiceKind === 'consolidated') {
            kindBadge = ' <span class="badge bg-primary" title="Samlar flera anmälningar i en betalning">Samlingsfaktura</span>';
        } else if (invoice.invoiceKind === 'creditNote') {
            kindBadge = ' <span class="badge bg-dark" title="Avdrag / återbetalning – ingen ny avgift">Kreditfaktura</span>';
        } else if (invoice.settledByInvoiceId > 0) {
            kindBadge = ' <span class="badge bg-secondary" title="Betalas via en samlingsfaktura">Ingår i samlingsfaktura</span>';
        }

        const isSettled = invoice.paymentStatus === 'Paid' || invoice.paymentStatus === 'Cancelled';
        const alreadySent = !!invoice.paymentSentDate;
        const sentDateStr = alreadySent ? new Date(invoice.paymentSentDate).toLocaleDateString('sv-SE') : '';

        // Sent-claim badge (shown alongside the status until the organizer confirms receipt).
        let sentBadge = '';
        if (alreadySent && !isSettled) {
            const by = invoice.paymentSentBy ? ` av ${escapeClubHtml(invoice.paymentSentBy)}` : '';
            const lbl = isPayerView ? 'Betald av klubben' : 'Betalning anmäld';
            sentBadge = ` <span class="badge bg-info text-dark" title="Anmäld${by} ${sentDateStr} — ej bekräftad som mottagen av arrangören">${lbl} ${sentDateStr}</span>`;
        }

        // Mark action: payer-view = sent-claim (+ undo); organizer-view = authoritative received.
        let markAction = '';
        if (!isSettled) {
            if (isPayerView) {
                markAction = alreadySent
                    ? `<button class="btn btn-outline-secondary" onclick="clearClubInvoicePaymentSent(${invoice.id})" title="Ångra betalningsanmälan"><i class="bi bi-arrow-counterclockwise"></i></button>`
                    : `<button class="btn btn-outline-success" onclick="markClubInvoicePaymentSent(${invoice.id})" title="Markera som betald av klubben"><i class="bi bi-check-circle"></i></button>`;
            } else {
                markAction = `<button class="btn btn-outline-success" onclick="markClubInvoiceAsPaid(${invoice.id})" title="Markera som betald (mottagen)"><i class="bi bi-check-circle"></i></button>`;
            }
        }

        return template
            .replace(/{id}/g, invoice.id)
            .replace(/{invoiceNumber}/g, escapeClubHtml(invoice.invoiceNumber))
            .replace(/{competitionName}/g, escapeClubHtml(invoice.competitionName))
            .replace(/{memberName}/g, escapeClubHtml(invoice.memberName))
            .replace(/{totalAmount}/g, invoice.totalAmount.toFixed(2))
            .replace(/{paymentStatus}/g, escapeClubHtml(statusText))
            .replace(/{rawStatus}/g, escapeClubHtml(invoice.paymentStatus || ''))
            .replace(/{settledBy}/g, String(invoice.settledByInvoiceId || 0))
            .replace(/{kindBadge}/g, kindBadge)
            .replace(/{statusClass}/g, statusClass)
            .replace(/{sentBadge}/g, sentBadge)
            .replace(/{markAction}/g, markAction)
            .replace(/{createdDate}/g, createdDate)
            .replace(/{paymentDate}/g, paymentDate)
            .replace(/{hideIfCancelled}/g, hideIfCancelled);
    }).join('');
}

function renderClubPagination(metadata) {
    const nav = document.getElementById('clubInvoicePaginationNav');
    const pagination = document.getElementById('clubInvoicePagination');
    const pageInfo = document.getElementById('clubInvoicePageInfo');

    if (metadata.totalPages <= 1) {
        nav.classList.add('d-none');
        return;
    }

    nav.classList.remove('d-none');

    const start = ((metadata.page - 1) * metadata.pageSize) + 1;
    const end = Math.min(metadata.page * metadata.pageSize, metadata.filteredInvoices);
    pageInfo.textContent = `${start}-${end} av ${metadata.filteredInvoices}`;

    let paginationHTML = '';

    // Previous button
    paginationHTML += `<li class="page-item ${metadata.page === 1 ? 'disabled' : ''}">
        <a class="page-link" href="#" onclick="goToClubInvoicePage(${metadata.page - 1}); return false;">Föregående</a>
    </li>`;

    // Page numbers (show max 5 pages)
    const startPage = Math.max(1, metadata.page - 2);
    const endPage = Math.min(metadata.totalPages, startPage + 4);

    for (let i = startPage; i <= endPage; i++) {
        paginationHTML += `<li class="page-item ${i === metadata.page ? 'active' : ''}">
            <a class="page-link" href="#" onclick="goToClubInvoicePage(${i}); return false;">${i}</a>
        </li>`;
    }

    // Next button
    paginationHTML += `<li class="page-item ${metadata.page === metadata.totalPages ? 'disabled' : ''}">
        <a class="page-link" href="#" onclick="goToClubInvoicePage(${metadata.page + 1}); return false;">Nästa</a>
    </li>`;

    pagination.innerHTML = paginationHTML;
}

function goToClubInvoicePage(page) {
    currentClubInvoicePage = page;
    loadClubInvoices();
}

function applyClubInvoiceFilters() {
    currentClubInvoicePage = 1;
    loadClubInvoices();
}

function clearClubInvoiceFilters() {
    document.getElementById('clubStatusFilterInvoices').value = '';
    document.getElementById('clubMemberSearchInvoices').value = '';
    document.getElementById('clubInvoiceNumberSearch').value = '';
    document.getElementById('clubExcludePaidFilter').checked = true;
    applyClubInvoiceFilters();
}

function getClubStatusClass(status) {
    switch (status) {
        case 'Paid': return 'success';
        case 'Pending': return 'warning';
        case 'Cancelled': return 'secondary';
        case 'Failed': return 'danger';
        case 'Refunded': return 'info';
        default: return 'secondary';
    }
}

function translateClubStatus(status) {
    switch (status) {
        case 'Paid': return 'Betald';
        case 'Pending': return 'Väntande';
        case 'Cancelled': return 'Makulerad';
        case 'Failed': return 'Misslyckad';
        case 'Refunded': return 'Återbetald';
        default: return status;
    }
}

// Invoice Actions (namespaced for club)

function showClubSwishQRCode(invoiceId) {
    const modal = new bootstrap.Modal(document.getElementById('swishPaymentModal'));
    const modalBody = document.getElementById('swishPaymentModalBody');

    // Show loading spinner
    modalBody.innerHTML = '<div class="spinner-border text-primary" role="status"><span class="visually-hidden">Laddar QR-kod...</span></div>';
    modal.show();

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    fetch(`/umbraco/surface/InvoiceAdmin/GenerateInvoiceQRCode?invoiceId=${invoiceId}`, {
        method: 'GET',
        headers: {
            'RequestVerificationToken': token
        },
        credentials: 'include'
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                modalBody.innerHTML = `
                    <div class="text-center">
                        <h5>${escapeClubHtml(data.competitionName)}</h5>
                        <p class="mb-3">Belopp: <strong>${data.amount} kr</strong></p>
                        <img src="data:image/png;base64,${data.qrCodeBase64}" alt="Swish QR Code" class="img-fluid mb-3" style="max-width: 300px;">
                        <p class="text-muted">Scanna QR-koden med Swish-appen</p>
                        <p class="small">Fakturanummer: ${escapeClubHtml(data.invoiceNumber)}</p>
                    </div>
                `;
            } else {
                modalBody.innerHTML = `<div class="alert alert-danger">${escapeClubHtml(data.message)}</div>`;
            }
        })
        .catch(error => {
            modalBody.innerHTML = `<div class="alert alert-danger">Fel vid generering av QR-kod: ${escapeClubHtml(error.message)}</div>`;
        });
}

function resendClubInvoiceEmail(invoiceId) {
    if (!confirm('Vill du skicka QR-koden via e-post till medlemmen?')) {
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    fetch('/umbraco/surface/InvoiceAdmin/ResendInvoiceEmail', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        credentials: 'include',
        body: JSON.stringify({ invoiceId: invoiceId })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('E-post skickat!');
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(error => {
            alert('Nätverksfel: ' + error.message);
        });
}

function markClubInvoiceAsPaid(invoiceId) {
    if (!confirm('Markera fakturan som betald?')) {
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    fetch('/umbraco/surface/InvoiceAdmin/MarkAsPaid', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        credentials: 'include',
        body: JSON.stringify({ invoiceId: invoiceId })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Faktura markerad som betald');
                loadClubInvoices();
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(error => {
            alert('Nätverksfel: ' + error.message);
        });
}

// Payer-side claim: "Betald av klubben". Records that the club has paid on the members'
// behalf — it does NOT mark the invoice received at the organizer. The organizer confirms
// receipt separately. Distinct from markClubInvoiceAsPaid (which sets received).
function markClubInvoicePaymentSent(invoiceId) {
    if (!confirm('Markera som betald av klubben?\n\nDetta meddelar arrangören att klubben har betalat. Arrangören bekräftar själv när betalningen är mottagen.')) {
        return;
    }
    postClubPaymentSentAction('/umbraco/surface/InvoiceAdmin/MarkPaymentSent', invoiceId);
}

function clearClubInvoicePaymentSent(invoiceId) {
    if (!confirm('Ångra betalningsanmälan för denna faktura?')) {
        return;
    }
    postClubPaymentSentAction('/umbraco/surface/InvoiceAdmin/ClearPaymentSent', invoiceId);
}

function postClubPaymentSentAction(url, invoiceId) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        credentials: 'include',
        body: JSON.stringify({ invoiceId: invoiceId })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadClubInvoices();
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(error => {
            alert('Nätverksfel: ' + error.message);
        });
}

function cancelClubInvoice(invoiceId, invoiceNumber) {
    if (!confirm(`Vill du makulera faktura ${invoiceNumber}?`)) {
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    fetch('/umbraco/surface/InvoiceAdmin/CancelInvoice', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        credentials: 'include',
        body: JSON.stringify({ invoiceId: invoiceId })
    })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                alert('Faktura makulerad');
                loadClubInvoices();
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(error => {
            alert('Nätverksfel: ' + error.message);
        });
}

// Utility function for HTML escaping (namespaced)
function escapeClubHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
