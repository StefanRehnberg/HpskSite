@using HpskSite.Controllers
@model KretsAnsokningarModel
@*
    Kretsgranskning fas 2 — kretsens granskning av resultatlistor. EN partial som både kretsens
    adminpanel (fliken Resultatgranskning) och den fristående sidan /kretsen/granskning renderar.
    Den fristående sidan finns för resultatgranskaren som inte är kretsadmin — mejlen pekar dit.

    ⚠️ FORMEN ÄR KODBASENS INKORGSFORM, inte påhittad (Stefans beslut 2026-10-02): samma som
    "Väntande godkännanden" i UserManagement och föreningsintygets inkorg.
      1. Siffran i rälsen (räknas vid sidladdning av panelen, GetPendingCounts).
      2. Ett GULT KORT överst med det som väntar på kretsen — en synlig knapp per rad (Granska).
         Kortet göms helt när inget väntar; ett tomt gult kort läser som ett problem.
      3. En tabell med allt övrigt och dess status, med statusfilter och år.
    Inställningarna ligger bakom sidans blå Åtgärder, i en dialog — inte på sidan.

    ⚠️ Inga användartexter i attribut — rader och knappar bär bara id:n.
    Laddas lat: window.hpskKretsResultReviewInit(). CSS:en är Bootstrap; inget eget behövs.
*@
@{ var m = Model; }
<div class="kg-root" data-region-id="@m.RegionId">
    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h5 class="mb-1">
                <i class="bi bi-clipboard-check text-primary me-2"></i>Resultatgranskning
                <span class="badge bg-warning text-dark ms-1 d-none" id="kgBadge">0</span>
            </h5>
            <div class="small text-muted" id="kgReviewerLine"></div>
        </div>
        <div class="dropdown">
            <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="kgActions">
                <i class="bi bi-sliders me-2"></i>Åtgärder
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="min-width:280px;">
                <li><h6 class="dropdown-header">Inställningar</h6></li>
                <li>
                    <button class="dropdown-item" type="button" data-kg="settings">
                        <i class="bi bi-gear me-2"></i>Kretsens inställningar för granskningen…
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <div id="kgTopMessage"></div>

    @* ── Väntar på kretsen ─────────────────────────────────────────────────────────────── *@
    <div class="card mb-3 border-warning d-none" id="kgPendingCard">
        <div class="card-header bg-warning text-dark">
            <h6 class="mb-0">
                <i class="bi bi-inbox me-1"></i>Väntar på kretsen
                <span class="badge bg-dark ms-2" id="kgPendingCount">0</span>
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Inskickad</th><th>Tävling</th><th>Arrangör</th><th class="text-end"></th></tr></thead>
                    <tbody id="kgPendingRows"></tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Alla övriga resultatlistor ──────────────────────────────────────────────────────── *@
    <div class="card">
        <div class="card-header py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-list-check me-2"></i>Resultatlistor</strong>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <label class="visually-hidden" for="kgStatusFilter">Visa</label>
                <select class="form-select form-select-sm w-auto" id="kgStatusFilter"></select>
                <label class="visually-hidden" for="kgYear">Tävlingsår</label>
                <select class="form-select form-select-sm w-auto" id="kgYear"></select>
            </div>
        </div>
        <div class="card-body">
            <div id="kgBody"><div class="text-muted small">Laddar…</div></div>
        </div>
    </div>
</div>

@* Ärendet — checklistan och beslutet — i en dialog, så att man inte tappar sin plats i tabellen. *@
<div class="modal fade" id="kgCaseModal" tabindex="-1" aria-labelledby="kgCaseTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kgCaseTitle"><i class="bi bi-clipboard-check me-2"></i>Granska resultatlistan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="kgCaseBody"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="kgSettingsModal" tabindex="-1" aria-labelledby="kgSettingsTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kgSettingsTitle"><i class="bi bi-gear me-2"></i>Kretsens inställningar för granskningen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="kgSettings"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ResultReviewCase")
<script>
if (!window.hpskKretsResultReviewInit) {
window.hpskKretsResultReviewInit = function () {
    if (window.hpskKretsResultReviewInit.done) return;
    window.hpskKretsResultReviewInit.done = true;

    const root = document.querySelector('.kg-root');
    const REGION_ID = +root.getAttribute('data-region-id');
    // ⚠️ Dialogerna flyttas till body: i adminpanelen ligger partialen i en flik, och en modal i
    // en dold förälder får .show men blir aldrig synlig.
    ['kgCaseModal', 'kgSettingsModal'].forEach(id => { const el = document.getElementById(id); if (el && el.parentNode !== document.body) document.body.appendChild(el); });
    const $ = id => document.getElementById(id);
    const esc = s => window.hpskEsc(s == null ? '' : String(s));
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;
    const statusBadge = s => s === 'Godkand' ? '<span class="badge bg-success">Godkänd</span>'
        : s === 'Atersand' ? '<span class="badge bg-secondary">Återsänd till arrangören</span>'
        : s === 'awaiting' ? '<span class="badge bg-warning-subtle text-warning-emphasis">Väntar på arrangören</span>'
        : s === 'notSubmitted' ? '<span class="badge bg-light text-dark border">Inte inskickad</span>'
        : '<span class="badge bg-warning text-dark">Väntar på kretsen</span>';
    let year = new Date().getFullYear(), data = null;

    const yearSel = $('kgYear');
    for (let y = year + 1; y >= year - 3; y--) yearSel.insertAdjacentHTML('beforeend', '<option value="' + y + '"' + (y === year ? ' selected' : '') + '>' + y + '</option>');
    yearSel.addEventListener('change', () => { year = +yearSel.value; load(); });
    const filter = $('kgStatusFilter');
    filter.addEventListener('change', renderTable);

    function setRailCount(n) {
        const r = document.getElementById('regionResultReviewRailCount');
        if (r) { r.textContent = n; r.classList.toggle('d-none', n === 0); }
    }

    function load() {
        return fetch('/umbraco/surface/ResultReview/GetRegionReviews?regionId=' + REGION_ID + '&year=' + year, { credentials: 'same-origin' })
            .then(r => r.json()).then(d => {
                if (!d.success) { $('kgBody').innerHTML = '<div class="alert alert-warning mb-0">' + esc(d.message) + '</div>'; return; }
                data = d;
                const rev = d.reviewers || [];
                $('kgReviewerLine').innerHTML = rev.length
                    ? 'Resultatgranskare: ' + rev.map(esc).join(', ') + '.'
                    : 'Kretsen har ingen resultatgranskare — listorna kommer som en länk till kretsens kontaktadress och till kretsadministratörerna.';
                renderPending();
                renderTable();
            }).catch(() => { $('kgBody').innerHTML = '<div class="alert alert-warning mb-0">Granskningarna kunde inte hämtas. Försök igen om en stund.</div>'; });
    }

    function renderPending() {
        const open = data.reviews.filter(x => x.review.status === 'Inskickad');
        $('kgPendingCard').classList.toggle('d-none', open.length === 0);
        $('kgPendingCount').textContent = open.length;
        $('kgBadge').textContent = open.length;
        $('kgBadge').classList.toggle('d-none', open.length === 0);
        setRailCount(open.length);
        $('kgPendingRows').innerHTML = open.map(x => {
            const r = x.review;
            return '<tr>'
                + '<td class="small text-nowrap">' + esc(r.submittedAt) + '</td>'
                + '<td><strong>' + esc(x.name) + '</strong><div class="small text-muted">' + esc(x.date || '') + '</div>'
                + (r.firstApprover ? '<div class="small text-muted">' + esc(r.firstApprover) + ' har godkänt — en andra granskare behövs.</div>' : '')
                + (r.gated ? '<div class="small text-warning-emphasis"><i class="bi bi-hourglass-split me-1"></i>Skyttarnas standardmedaljer väntar.</div>' : '')
                + '</td>'
                + '<td class="small">' + esc(x.organiser) + '</td>'
                + '<td class="text-end text-nowrap"><button type="button" class="btn btn-primary btn-sm" data-kg="open" data-id="' + r.id + '">Granska <i class="bi bi-arrow-right ms-1"></i></button></td>'
                + '</tr>';
        }).join('');
    }

    function tableRows() {
        const rows = data.reviews.filter(x => x.review.status !== 'Inskickad').map(x => ({
            key: x.review.status, date: x.date || '', name: x.name, organiser: x.organiser, id: x.review.id,
            note: x.review.status === 'Godkand' ? 'Godkänd ' + (x.review.decidedAt || '') + (x.review.decider ? ' av ' + x.review.decider : '')
                : x.review.status === 'Atersand' ? (x.review.comment || '') : ''
        }));
        // Bara när kretsen KRÄVER sitt godkännande väntar något på arrangören (medaljerna hänger på
        // inskicket, och det finns en sista dag). Annars är inskicket frivilligt: neutral status.
        (data.awaiting || []).forEach(a => rows.push({
            key: a.required ? 'awaiting' : 'notSubmitted', date: a.date || '', name: a.name, organiser: a.organiser, id: 0, late: a.late,
            note: (a.resultPublished ? 'Resultatlistan är publicerad, men inte inskickad till kretsen' : 'Resultatlistan är inte publicerad')
                + (a.required && a.deadline ? ' · skickas in senast ' + a.deadline : '')
        }));
        return rows.sort((p, q) => (q.date || '').localeCompare(p.date || ''));
    }

    function renderTable() {
        const all = tableRows();
        const counts = { all: all.length, awaiting: 0, notSubmitted: 0, Atersand: 0, Godkand: 0 };
        all.forEach(r => counts[r.key]++);
        const cur = filter.value || 'all';
        // "Väntar på arrangören" erbjuds bara när kretsen kräver godkännande — annars finns inget sådant läge.
        const opts = [['all', 'Alla']]
            .concat(data.settings && data.settings.requireApproval ? [['awaiting', 'Väntar på arrangören']] : [])
            .concat([['notSubmitted', 'Inte inskickade'], ['Atersand', 'Återsända'], ['Godkand', 'Godkända']]);
        filter.innerHTML = opts
            .map(([v, l]) => '<option value="' + v + '"' + (v === cur ? ' selected' : '') + '>' + l + ' (' + counts[v] + ')</option>').join('');
        const rows = cur === 'all' ? all : all.filter(r => r.key === cur);
        if (!all.length) {
            $('kgBody').innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-inbox display-6 d-block mb-2"></i>'
                + '<p class="mb-0 small">Inga andra resultatlistor ' + year + '.</p></div>';
            return;
        }
        $('kgBody').innerHTML = '<p class="small text-muted">Visar ' + rows.length + ' av ' + all.length + '.</p>'
            + '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Datum</th><th>Tävling</th><th>Arrangör</th><th>Status</th><th class="text-end"></th></tr></thead><tbody>'
            + rows.map(r => '<tr>'
                + '<td class="small text-nowrap">' + esc(r.date) + '</td>'
                + '<td>' + esc(r.name) + (r.note ? '<div class="small text-muted">' + esc(r.note) + '</div>' : '') + '</td>'
                + '<td class="small">' + esc(r.organiser) + '</td>'
                + '<td>' + statusBadge(r.key) + (r.late ? ' <span class="badge bg-danger-subtle text-danger-emphasis">sen</span>' : '') + '</td>'
                + '<td class="text-end">' + (r.id ? '<button type="button" class="btn btn-outline-secondary btn-sm" data-kg="open" data-id="' + r.id + '">Visa</button>' : '') + '</td>'
                + '</tr>').join('')
            + '</tbody></table></div>';
    }

    function openCase(id) {
        const body = $('kgCaseBody');
        body.innerHTML = '<div class="text-muted">Hämtar…</div>';
        bootstrap.Modal.getOrCreateInstance($('kgCaseModal')).show();
        fetch('/umbraco/surface/ResultReview/GetReview?id=' + id, { credentials: 'same-origin' }).then(r => r.json()).then(d => {
            if (!d.success) { body.innerHTML = '<div class="alert alert-warning">' + esc(d.message) + '</div>'; return; }
            window.hpskRenderReviewCase(body, d, { mode: 'inloggad', onDone: load });
        });
    }

    function renderSettings() {
        const s = data.settings, rev = data.reviewers || [];
        let html = '<p class="small text-muted">Resultatgranskare: ' + (rev.length ? rev.map(esc).join(', ') : '<strong>ingen utsedd</strong>') + '. Uppdragen ändras i Styrelsearbete.</p>';
        if (!data.canEditSettings) {
            html += '<p class="mb-1">' + (s.requireApproval ? 'Kretsen kräver sitt godkännande innan standardmedaljerna räknas (sedan ' + esc(s.since) + ').' : 'Granskningen är en stämpel. Standardmedaljerna räknas när resultatlistan publiceras.') + '</p>'
                + '<p class="mb-0">' + (s.twoReviewers ? 'Två granskare krävs vid SM och landsdelsmästerskap.' : 'En granskare räcker.') + '</p>'
                + '<p class="small text-muted mt-2 mb-0">Inställningarna ändras av kretsadministratören.</p>';
            $('kgSettings').innerHTML = html; return;
        }
        html += '<div class="form-check form-switch mb-1"><input class="form-check-input" type="checkbox" id="kgRequire"' + (s.requireApproval ? ' checked' : '') + (rev.length || s.requireApproval ? '' : ' disabled') + '>'
            + '<label class="form-check-label" for="kgRequire">Kräv kretsens godkännande innan standardmedaljerna räknas</label></div>'
            + '<p class="small text-muted ms-4">' + (rev.length ? 'Av som standard. Påslaget väntar skyttarnas standardmedaljer tills kretsen godkänt listan. Gäller bara tävlingar från dagen det slås på.' : 'Utse minst en resultatgranskare först (Styrelsearbete → Kretsens uppdrag).') + (s.since ? ' Påslaget sedan ' + esc(s.since) + '.' : '') + '</p>'
            + '<div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="kgTwo"' + (s.twoReviewers ? ' checked' : '') + '>'
            + '<label class="form-check-label" for="kgTwo">Två olika granskare vid SM och landsdelsmästerskap</label></div>'
            + '<button type="button" class="btn btn-primary" id="kgSaveSettings">Spara</button><div id="kgSettingsResult" class="mt-2" role="status"></div>';
        $('kgSettings').innerHTML = html;
        $('kgSaveSettings').addEventListener('click', () => {
            fetch('/umbraco/surface/ResultReview/SaveSettings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
                body: new URLSearchParams({ regionId: REGION_ID, requireApproval: $('kgRequire').checked ? '1' : '0', twoReviewers: $('kgTwo').checked ? '1' : '0' }).toString()
            }).then(r => r.json()).then(r => {
                const res = $('kgSettingsResult');
                res.className = 'mt-2 alert py-2 ' + (r.success ? 'alert-success' : 'alert-warning');
                res.textContent = r.message || '';
                if (r.success) load();
            });
        });
    }

    root.addEventListener('click', e => {
        const b = e.target.closest('[data-kg]');
        if (!b) return;
        if (b.dataset.kg === 'open') openCase(+b.dataset.id);
        if (b.dataset.kg === 'settings' && data) { renderSettings(); bootstrap.Modal.getOrCreateInstance($('kgSettingsModal')).show(); }
    });

    const deep = new URLSearchParams(location.search).get('granskning');
    load().then(() => { if (deep) openCase(+deep); });
};
}
</script>
