													disabled data-class="AP_@shootingClass.Id">
												<i class="bi bi-pencil" style="font-size: 0.8rem;"></i>
											</button>
										</div>
									</div>
								}
							</div>
						}

						@* AG Classes Group (own weapon group — moderna tjänstepistoler) *@
						@if (aGClasses.Any())
						{
							<div class="mb-2">
								<h6 class="text-primary border-bottom border-primary pb-1 mb-1">
									<i class="bi bi-trophy"></i> AG-klasser
								</h6>
								@foreach (var shootingClass in aGClasses)
