						@* C Veteran Classes Group *@
						@if (cVetClasses.Any())
						{
							<div class="mb-2">
								<h6 class="text-secondary border-bottom border-secondary pb-1 mb-1">
									<i class="bi bi-star"></i> C-klasser (Veteran)
								</h6>
								@foreach (var shootingClass in cVetClasses)
