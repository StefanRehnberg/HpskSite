@*
 * Fältskytte Target Picker Modal
 * Split layout: scrollable grid on the left, fixed detail panel on the right.
 * Admins can edit target name, variant names/colors, and distances inline.
 *@

<style>
    /* Mobile / small-tablet layout: stack the picker vertically so the
       340px detail panel doesn't crush the grid on narrow viewports.
       modal-fullscreen-md-down (on the dialog below) gives us full
       viewport space to stack into. */
    @@media (max-width: 767.98px) {
        #faltTargetPickerModal .faltPicker-body {
            height: auto !important;
            min-height: calc(100vh - 60px);
        }
        #faltTargetPickerModal #faltPickerDetailPanel {
            width: 100% !important;
            border-left: 0 !important;
            border-top: 1px solid var(--bs-border-color);
        }
    }
</style>
<div class="modal fade" id="faltTargetPickerModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true" style="z-index:1070">
    <div class="modal-dialog modal-xl modal-fullscreen-md-down modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-bullseye me-2"></i>Figurkatalog</h5>
                <button type="button" class="btn-close" onclick="faltPickerClose()"></button>
            </div>
            <div class="modal-body p-0 faltPicker-body" style="height:70vh">
                <div class="d-flex flex-column flex-md-row h-100">
                    <!-- Left: search + grid -->
                    <div class="flex-grow-1 overflow-auto p-3" style="min-width:0">
                        <div class="d-flex gap-2 mb-2">
                            <input type="text" class="form-control form-control-sm" id="faltPickerSearch" placeholder="Sök figur..." oninput="faltPickerFilter()">
                            <button class="btn btn-primary btn-sm text-nowrap" onclick="faltPickerCreateNew()"><i class="bi bi-plus-lg me-1"></i>Ny figur</button>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mb-2 align-items-center small">
                            <span class="text-muted me-1">Storleksgrupp:</span>
                            <button class="btn btn-link btn-sm py-0 px-1" onclick="faltPickerFilterAll(true)">Alla</button>
                            <button class="btn btn-link btn-sm py-0 px-1" onclick="faltPickerFilterAll(false)">Inga</button>
                            <span class="vr mx-1"></span>
                            <div id="faltPickerGroupChips" class="d-flex flex-wrap gap-1"></div>
                        </div>
                        <div id="faltPickerGrid"></div>
                    </div>
                    <!-- Right: detail panel -->
                    <div id="faltPickerDetailPanel" class="border-start bg-body-tertiary overflow-auto p-3" style="width:340px;flex-shrink:0">
                        <div id="faltPickerNoSelection" class="text-center text-muted py-5">
                            <i class="bi bi-arrow-left-circle" style="font-size:2rem"></i>
                            <p class="mt-2">Klicka på en figur för att se detaljer</p>
                        </div>
                        <div id="faltPickerDetail" style="display:none">
                            <div class="text-center mb-3">
                                <img id="faltPickerDetailImg" src="" style="max-height:150px;max-width:100%;border-radius:6px" alt="">
                            </div>
                            <h6 id="faltPickerDetailName" class="mb-2"></h6>

                            <!-- Color selector -->
                            <div class="mb-3">
                                <label class="form-label small mb-1 fw-bold">Färg</label>
                                <select class="form-select form-select-sm" id="faltPickerColorSelect" onchange="faltPickerColorChanged()"></select>
                            </div>

                            <!-- Pick button (shown in pick mode, right below color selector) -->
                            <div id="faltPickerSelectSection" style="display:none" class="mb-3">
                                <button class="btn btn-primary w-100" onclick="faltPickerSelect()">
                                    <i class="bi bi-check-circle me-1"></i>Välj denna figur
                                </button>
                            </div>

                            <!-- Admin edit section (hidden in pick mode) -->
                            <div id="faltPickerAdminSection" style="display:none">
                                <hr>
                                <div class="mb-2">
                                    <label class="form-label small mb-1 fw-bold">Namn</label>
                                    <input type="text" class="form-control form-control-sm" id="faltPickerEditName" placeholder="Namn" autocomplete="off" data-1p-ignore="true">
                                </div>
                                <div class="row g-2 mb-2">
                                    <div class="col-7">
                                        <label class="form-label small mb-1 fw-bold">Antal m&aring;l i figuren</label>
                                        <input type="number" class="form-control form-control-sm" id="faltPickerEditTargetsPerFig" min="1" max="6" value="1" style="width:80px">
                                        <div class="form-text small">Flerm&aring;lsfigurer (ex. Ballongmål) har fler &auml;n 1.</div>
                                    </div>
                                    <div class="col-5 text-end">
                                        <label class="form-label small mb-1 fw-bold">Storleksgrupp</label>
                                        <input type="number" class="form-control form-control-sm ms-auto text-end" id="faltPickerEditSizeGroup" min="1" max="15" value="15" style="width:80px;margin-left:auto">
                                        <div class="form-text small">1&ndash;14 styr max avst&aring;nd. 15 = ej grupperad.</div>
                                    </div>
                                </div>
                                <!-- Variant editing -->
                                <div id="faltPickerVariantEdits" class="mb-2"></div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-outline-primary btn-sm" onclick="faltPickerAddVariant()">
                                        <i class="bi bi-plus me-1"></i>Ny variant
                                    </button>
                                    <button class="btn btn-sm btn-primary flex-grow-1" onclick="faltPickerSaveTarget()">
                                        <i class="bi bi-check-lg me-1"></i>Spara
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="faltPickerDeleteTarget()" title="Ta bort figur">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
var _faltPickerCatalog = [];
var _faltPickerSelected = null;
var _faltPickerSelectedVariant = null;
var _faltPickerCallback = null;
var _faltPickerWeaponClass = 'C';
var _faltPickerIsAdmin = false;

// SHB diagram 1-3 max distances per storleksgrupp (SHB 2026 pp 100-122),
// formatted for the section-header label. Group 15 is the "ej grupperad"
// bucket — figures whose admin hasn't bucketed them yet.
var FALT_PICKER_GROUP_LABELS = {
    1:  'A&R 70 m · B 80 m · C 90 m',
    2:  'A&R 60 m · B 65 m · C 75 m',
    3:  'A&R 50 m · B 55 m · C 65 m',
    4:  'A&R 45 m · B 50 m · C 55 m',
    5:  'A&R 40 m · B 45 m · C 50 m',
    6:  'A&R 35 m · B 40 m · C 45 m',
    7:  'A&R 30 m · B 35 m · C 40 m',
    8:  'A&R 27 m · B 32 m · C 36 m',
    9:  'A&R 24 m · B 27 m · C 30 m',
    10: 'A&R 20 m · B 22 m · C 25 m',
    11: 'A&R 16 m · B 18 m · C 20 m',
    12: 'A&R 14 m · B 16 m · C 18 m',
    13: 'A&R 12 m · B 14 m · C 16 m',
    14: 'A&R 7 m · B 8 m · C 9 m',
    15: ''
};
var FALT_PICKER_STORAGE_KEY = 'faltPickerVisibleGroups';
var _faltPickerVisibleGroups = null;

// 0 is a phantom SHB calculation reference (stödhand offset), not a real
// catalog bucket. Any legacy row that still has SizeGroup=0 is normalized
// to 15 ("Ej grupperad") for filter + section purposes.
function faltPickerNormGroup(g) {
    var n = parseInt(g, 10);
    if (isNaN(n) || n < 1 || n > 15) return 15;
    return n;
}

function faltPickerLoadVisibleGroups() {
    try {
        var stored = sessionStorage.getItem(FALT_PICKER_STORAGE_KEY);
        if (stored) { _faltPickerVisibleGroups = new Set(JSON.parse(stored)); return; }
    } catch (e) { /* fall through */ }
    var all = []; for (var i = 1; i <= 15; i++) all.push(i);
    _faltPickerVisibleGroups = new Set(all);
}

function faltPickerSaveVisibleGroups() {
    try { sessionStorage.setItem(FALT_PICKER_STORAGE_KEY, JSON.stringify([..._faltPickerVisibleGroups])); } catch (e) {}
}

function faltPickerToggleGroup(g) {
    if (_faltPickerVisibleGroups.has(g)) _faltPickerVisibleGroups.delete(g);
    else _faltPickerVisibleGroups.add(g);
    faltPickerSaveVisibleGroups();
    faltPickerRenderFilterChips();
    faltPickerFilter();
}

function faltPickerFilterAll(on) {
    _faltPickerVisibleGroups = new Set();
    if (on) for (var i = 1; i <= 15; i++) _faltPickerVisibleGroups.add(i);
    faltPickerSaveVisibleGroups();
    faltPickerRenderFilterChips();
    faltPickerFilter();
}

function faltPickerRenderFilterChips() {
    var c = document.getElementById('faltPickerGroupChips');
    if (!c) return;
    var html = '';
    for (var g = 1; g <= 15; g++) {
        var on = _faltPickerVisibleGroups.has(g);
        var label = g === 15 ? 'Ej' : g;
        var title = g === 15
            ? 'Ej grupperad'
            : ('Storleksgrupp ' + g + (FALT_PICKER_GROUP_LABELS[g] ? ' — ' + FALT_PICKER_GROUP_LABELS[g] : ''));
        html += '<button type="button" class="btn btn-sm py-0 px-2 ' + (on ? 'btn-primary' : 'btn-outline-secondary') + '" onclick="faltPickerToggleGroup(' + g + ')" title="' + title + '">' + label + '</button>';
    }
    c.innerHTML = html;
}

async function faltPickerOpen(weaponClass, callback) {
    _faltPickerWeaponClass = weaponClass || 'C';
    _faltPickerCallback = callback;
    _faltPickerSelected = null;
    _faltPickerSelectedVariant = null;
    document.getElementById('faltPickerDetail').style.display = 'none';
    document.getElementById('faltPickerSelectSection').style.display = callback ? '' : 'none';
    document.getElementById('faltPickerNoSelection').style.display = '';
    document.getElementById('faltPickerSearch').value = '';

    _faltPickerIsPickMode = !!callback;

    _faltPickerIsAdmin = true; // Edit UI shown to all; server validates admin on save

    if (_faltPickerCatalog.length === 0) {
        var resp = await fetch('/umbraco/surface/Faltskytte/GetTargetCatalog');
        var data = await resp.json();
        if (data.success) _faltPickerCatalog = data.targets;
    }

    faltPickerLoadVisibleGroups();
    faltPickerRenderFilterChips();
    faltPickerFilter(); // applies search + group filter to render
    bootstrap.Modal.getOrCreateInstance(document.getElementById('faltTargetPickerModal')).show();
}

function faltPickerClose() {
    bootstrap.Modal.getInstance(document.getElementById('faltTargetPickerModal')).hide();
}

function faltPickerFilter() {
    var q = document.getElementById('faltPickerSearch').value.toLowerCase();
    var filtered = _faltPickerCatalog.filter(function(t) {
        if (!_faltPickerVisibleGroups.has(faltPickerNormGroup(t.sizeGroup))) return false;
        return !q || t.name.toLowerCase().indexOf(q) >= 0;
    });
    faltPickerRenderGrid(filtered);
}

function faltPickerRenderGrid(targets) {
    var grid = document.getElementById('faltPickerGrid');
    grid.innerHTML = '';
    if (targets.length === 0) {
        grid.innerHTML = '<div class="text-center text-muted py-4">Inga figurer hittades</div>';
        return;
    }

    // Bucket by sizeGroup; sort by name within each bucket.
    var buckets = {};
    targets.forEach(function(t) {
        var g = faltPickerNormGroup(t.sizeGroup);
        if (!buckets[g]) buckets[g] = [];
        buckets[g].push(t);
    });
    var groupNums = Object.keys(buckets).map(function(n) { return parseInt(n, 10); }).sort(function(a,b){ return a-b; });

    groupNums.forEach(function(g) {
        var labelText = g === 15 ? 'Ej grupperad' : 'Storleksgrupp ' + g;
        var distText = FALT_PICKER_GROUP_LABELS[g] || '';
        var header = '<div class="d-flex align-items-center gap-2 small text-muted mb-1 mt-2">' +
            '<span class="fw-bold text-body">' + labelText + '</span>' +
            (distText ? '<span>· ' + distText + '</span>' : '') +
            '<hr class="flex-grow-1 my-0 opacity-25">' +
        '</div>';

        var cardsHtml = '<div class="d-flex flex-wrap gap-2">';
        buckets[g]
            .slice()
            .sort(function(a,b) { return (a.name || '').localeCompare(b.name || '', 'sv'); })
            .forEach(function(t) {
                var firstVariant = t.variants && t.variants.length > 0 ? t.variants[0] : null;
                var imgUrl = firstVariant ? firstVariant.imageUrl : '';
                var isSelected = _faltPickerSelected && _faltPickerSelected.id === t.id;
                var nameSafe = (t.name || '').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                cardsHtml += '<div class="card text-center p-1" style="width:100px;cursor:pointer' + (isSelected ? ';border-color:var(--bs-primary);border-width:2px' : '') + '" onclick="faltPickerSelectTarget(' + t.id + ')">' +
                    (imgUrl ? '<img src="' + imgUrl + '" style="height:55px;object-fit:contain" alt="">' : '<div style="height:55px" class="bg-body-secondary rounded"></div>') +
                    '<div class="p-1"><div class="small text-truncate" style="font-size:0.7em" title="' + nameSafe + '">' + nameSafe + '</div></div>' +
                '</div>';
            });
        cardsHtml += '</div>';

        var section = document.createElement('div');
        section.className = 'mb-2';
        section.innerHTML = header + cardsHtml;
        grid.appendChild(section);
    });
}

function faltPickerSelectTarget(targetId) {
    _faltPickerSelected = _faltPickerCatalog.find(function(t) { return t.id === targetId; });
    if (!_faltPickerSelected) return;

    document.getElementById('faltPickerNoSelection').style.display = 'none';
    document.getElementById('faltPickerDetail').style.display = '';
    document.getElementById('faltPickerDetailName').textContent = _faltPickerSelected.name;

    // Color selector
    var colorSelect = document.getElementById('faltPickerColorSelect');
    colorSelect.innerHTML = '';
    _faltPickerSelected.variants.forEach(function(v) {
        var opt = document.createElement('option');
        opt.value = v.color;
        opt.textContent = v.color || v.fullName;
        colorSelect.appendChild(opt);
    });
    faltPickerColorChanged();

    // Admin section (hidden in pick mode)
    var adminSection = document.getElementById('faltPickerAdminSection');
    if (_faltPickerIsAdmin && !_faltPickerIsPickMode) {
        adminSection.style.display = '';
        document.getElementById('faltPickerEditName').value = _faltPickerSelected.name;
        document.getElementById('faltPickerEditTargetsPerFig').value = _faltPickerSelected.targetsPerFigure || 1;
        document.getElementById('faltPickerEditSizeGroup').value = faltPickerNormGroup(_faltPickerSelected.sizeGroup);

        // Variant edits with image upload
        var varEdits = document.getElementById('faltPickerVariantEdits');
        varEdits.innerHTML = '<label class="form-label small mb-1 fw-bold">Varianter</label>';
        _faltPickerSelected.variants.forEach(function(v) {
            var imgPreview = v.imageUrl ? '<img src="' + v.imageUrl + '" style="height:24px;border-radius:3px" alt="">' : '';
            varEdits.innerHTML += '<div class="d-flex gap-1 mb-1 align-items-center" data-variant-id="' + v.id + '">' +
                '<input type="text" class="form-control form-control-sm variant-fullname" value="' + (v.fullName || '').replace(/"/g, '&quot;') + '" placeholder="Namn" style="flex:2" autocomplete="off" data-1p-ignore="true">' +
                '<input type="text" class="form-control form-control-sm variant-color" value="' + (v.color || '').replace(/"/g, '&quot;') + '" placeholder="Färg" style="flex:1" autocomplete="off" data-1p-ignore="true">' +
                imgPreview +
                '<label class="btn btn-outline-secondary btn-sm py-0 px-1 mb-0" title="Ladda upp bild">' +
                '<i class="bi bi-image"></i>' +
                '<input type="file" class="d-none" accept="image/*" onchange="faltPickerUploadVariantImage(this,' + v.id + ')">' +
                '</label>' +
                '<button class="btn btn-outline-info btn-sm py-0 px-1" onclick="faltPickerMoveVariant(' + v.id + ')" title="Flytta till annan figur"><i class="bi bi-arrow-right-circle"></i></button>' +
                '<button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="faltPickerDeleteVariant(' + v.id + ')" title="Ta bort variant"><i class="bi bi-trash"></i></button>' +
                '</div>';
        });
    } else {
        adminSection.style.display = 'none';
    }

    // Re-render through the filter so search + group toggles stay applied.
    faltPickerFilter();
}

function faltPickerColorChanged() {
    var color = document.getElementById('faltPickerColorSelect').value;
    _faltPickerSelectedVariant = _faltPickerSelected.variants.find(function(v) { return v.color === color; });
    var img = document.getElementById('faltPickerDetailImg');
    if (_faltPickerSelectedVariant && _faltPickerSelectedVariant.imageUrl) {
        img.src = _faltPickerSelectedVariant.imageUrl;
        img.style.display = '';
    } else {
        img.src = '';
        img.style.display = 'none';
    }
}

async function faltPickerSaveTarget() {
    if (!_faltPickerSelected) return;

    var variants = [];
    document.querySelectorAll('#faltPickerVariantEdits [data-variant-id]').forEach(function(el) {
        variants.push({
            id: parseInt(el.dataset.variantId),
            fullName: el.querySelector('.variant-fullname').value,
            color: el.querySelector('.variant-color').value
        });
    });

    var body = {
        targetId: _faltPickerSelected.id,
        name: document.getElementById('faltPickerEditName').value,
        targetsPerFigure: parseInt(document.getElementById('faltPickerEditTargetsPerFig').value) || 1,
        sizeGroup: Math.max(1, Math.min(15, parseInt(document.getElementById('faltPickerEditSizeGroup').value) || 15)),
        variants: variants
    };

    var resp = await fetch('/umbraco/surface/Faltskytte/UpdateTarget', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: JSON.stringify(body)
    });
    var data = await resp.json();
    if (data.success) {
        // Update local cache
        _faltPickerSelected.name = body.name;
        _faltPickerSelected.targetsPerFigure = body.targetsPerFigure;
        _faltPickerSelected.sizeGroup = body.sizeGroup;
        variants.forEach(function(vReq) {
            var v = _faltPickerSelected.variants.find(function(x) { return x.id === vReq.id; });
            if (v) { v.fullName = vReq.fullName; v.color = vReq.color; }
        });
        faltPickerFilter();
        faltPickerSelectTarget(_faltPickerSelected.id);
    } else {
        alert(data.message || 'Fel');
    }
}

function faltPickerSelect() {
    if (!_faltPickerSelected || !_faltPickerSelectedVariant) return;
    if (_faltPickerCallback) {
        _faltPickerCallback({
            imageUrl: _faltPickerSelectedVariant.imageUrl,
            targetName: _faltPickerSelected.name,
            targetColor: _faltPickerSelectedVariant.color,
            targetsPerFigure: _faltPickerSelected.targetsPerFigure || 1,
            sizeGroup: faltPickerNormGroup(_faltPickerSelected.sizeGroup)
        });
    }
    faltPickerClose();
}

async function faltPickerCreateNew() {
    var name = prompt('Namn på ny figur:');
    if (!name) return;

    var resp = await fetch('/umbraco/surface/Faltskytte/CreateTarget', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
        body: JSON.stringify({ name: name })
    });
    var data = await resp.json();
    if (data.success) {
        // Add to local cache and select it
        var newTarget = { id: data.targetId, name: name, variants: [], targetsPerFigure: 1, sizeGroup: 15 };
        _faltPickerCatalog.push(newTarget);
        _faltPickerCatalog.sort(function(a, b) { return a.name.localeCompare(b.name); });
        faltPickerFilter();
        faltPickerSelectTarget(data.targetId);
    } else {
        alert(data.message || 'Fel');
    }
}

async function faltPickerDeleteTarget() {
    if (!_faltPickerSelected) return;
    if (!confirm('Ta bort figur "' + _faltPickerSelected.name + '" och alla dess varianter?')) return;

    var resp = await fetch('/umbraco/surface/Faltskytte/DeleteTarget', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
        body: JSON.stringify({ targetId: _faltPickerSelected.id })
    });
    var data = await resp.json();
    if (data.success) {
        _faltPickerCatalog = _faltPickerCatalog.filter(function(t) { return t.id !== _faltPickerSelected.id; });
        _faltPickerSelected = null;
        _faltPickerSelectedVariant = null;
        document.getElementById('faltPickerDetail').style.display = 'none';
        document.getElementById('faltPickerNoSelection').style.display = '';
        faltPickerFilter();
    } else {
        alert(data.message || 'Fel');
    }
}

async function faltPickerAddVariant() {
    if (!_faltPickerSelected) return;
    var fullName = prompt('Namn på ny variant:');
    if (!fullName) return;

    var resp = await fetch('/umbraco/surface/Faltskytte/AddVariant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
        body: JSON.stringify({ targetId: _faltPickerSelected.id, fullName: fullName, imageName: '', color: '' })
    });
    var data = await resp.json();
    if (data.success) {
        _faltPickerSelected.variants.push({
            id: data.variantId,
            fullName: fullName,
            imageName: '',
            imageUrl: '',
            color: ''
        });
        faltPickerSelectTarget(_faltPickerSelected.id);
    } else {
        alert(data.message || 'Fel');
    }
}

async function faltPickerDeleteVariant(variantId) {
    if (!confirm('Ta bort denna variant?')) return;

    var resp = await fetch('/umbraco/surface/Faltskytte/DeleteVariant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
        body: JSON.stringify({ variantId: variantId })
    });
    var data = await resp.json();
    if (data.success) {
        if (_faltPickerSelected) {
            _faltPickerSelected.variants = _faltPickerSelected.variants.filter(function(v) { return v.id !== variantId; });
            faltPickerSelectTarget(_faltPickerSelected.id);
        }
    } else {
        alert(data.message || 'Fel');
    }
}

async function faltPickerMoveVariant(variantId) {
    if (!_faltPickerSelected) return;
    // Build a list of other targets to choose from
    var options = _faltPickerCatalog
        .filter(function(t) { return t.id !== _faltPickerSelected.id; })
        .map(function(t) { return t.name + ' (ID:' + t.id + ')'; });

    var choice = prompt('Flytta variant till vilken figur?\n\nSkriv figurens namn (eller del av namnet):');
    if (!choice) return;

    var searchLower = choice.toLowerCase();
    var matches = _faltPickerCatalog.filter(function(t) {
        return t.id !== _faltPickerSelected.id && t.name.toLowerCase().indexOf(searchLower) >= 0;
    });

    if (matches.length === 0) {
        alert('Ingen figur hittades med namnet "' + choice + '"');
        return;
    }
    var target = matches[0];
    if (matches.length > 1) {
        var names = matches.map(function(t,i) { return (i+1) + '. ' + t.name; }).join('\n');
        var idx = prompt('Flera träffar:\n' + names + '\n\nVälj nummer:');
        if (!idx) return;
        target = matches[parseInt(idx) - 1];
        if (!target) { alert('Ogiltigt val.'); return; }
    }

    if (!confirm('Flytta varianten till "' + target.name + '"?')) return;

    var resp = await fetch('/umbraco/surface/Faltskytte/MoveVariant', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
        body: JSON.stringify({ variantId: variantId, newTargetId: target.id })
    });
    var data = await resp.json();
    if (data.success) {
        // Move variant in local cache
        var movedVariant = null;
        _faltPickerSelected.variants = _faltPickerSelected.variants.filter(function(v) {
            if (v.id === variantId) { movedVariant = v; return false; }
            return true;
        });
        if (movedVariant) {
            var destTarget = _faltPickerCatalog.find(function(t) { return t.id === target.id; });
            if (destTarget) destTarget.variants.push(movedVariant);
        }
        // Remove source target if now empty
        if (data.oldTargetEmpty) {
            if (confirm('"' + _faltPickerSelected.name + '" har inga varianter kvar. Ta bort den?')) {
                await faltPickerDeleteTarget();
                return;
            }
        }
        faltPickerFilter();
        faltPickerSelectTarget(_faltPickerSelected.id);
    } else {
        alert(data.message || 'Fel');
    }
}

async function faltPickerUploadVariantImage(inputEl, variantId) {
    var file = inputEl.files[0];
    if (!file) return;

    var formData = new FormData();
    formData.append('file', file);
    formData.append('variantId', variantId);

    try {
        var resp = await fetch('/umbraco/surface/Faltskytte/UploadVariantImage', {
            method: 'POST',
            body: formData
        });
        var data = await resp.json();
        if (data.success && _faltPickerSelected) {
            var v = _faltPickerSelected.variants.find(function(x) { return x.id === variantId; });
            if (v) {
                v.imageUrl = data.imageUrl;
                v.imageName = data.imageName;
            }
            faltPickerSelectTarget(_faltPickerSelected.id);
        } else {
            alert(data.message || 'Uppladdningsfel');
        }
    } catch(e) {
        alert('Nätverksfel.');
    }
}
</script>
