@using HpskSite.Models
@using static HpskSite.Models.Federations
@using System.Text.Json
@using System.Text.Encodings.Web
@* Stafett (Relay) Registration Modal *@
@* Included from Competition.cshtml when allowStafett is true *@

<div class="modal fade" id="stafettRegistrationModal" tabindex="-1" aria-labelledby="stafettRegistrationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stafettRegistrationModalLabel">
                    <i class="bi bi-people-fill me-2"></i>Stafettanmälan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <ul class="nav nav-tabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#stafettTeamsListTab" type="button" role="tab">
                            <i class="bi bi-list-ul me-1"></i>Stafettlag
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#createStafettTab" type="button" role="tab">
                            <i class="bi bi-plus-circle me-1"></i>Skapa stafettlag
                        </button>
                    </li>
                </ul>

                <div class="tab-content pt-3">
                    @* ====== Tab 1: Existing Stafett Teams ====== *@
                    <div class="tab-pane fade show active" id="stafettTeamsListTab" role="tabpanel">
                        <div id="existingStafettTeamsList">
                            <div class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                <span class="ms-2">Laddar stafettlag...</span>
                            </div>
                        </div>
                        <div id="stafettTeamsListMessage" class="d-none mt-2"></div>
                    </div>

                    @* ====== Tab 2: Create Stafett Team ====== *@
                    <div class="tab-pane fade" id="createStafettTab" role="tabpanel">
                        @* Payment options for the relay team just created land HERE, above a freshly
                           cleared form - they used to replace the whole tab (SM rehearsal 2026-08-03). *@
                        <div id="stafettPaymentPanel"></div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="stafettRegionSelect" class="form-label">Krets</label>
                                <select class="form-select" id="stafettRegionSelect">
                                    <option value="">Alla kretsar</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="stafettClubSelect" class="form-label">Förening</label>
                                <select class="form-select" id="stafettClubSelect">
                                    <option value="">Välj förening...</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="stafettTeamName" class="form-label">Lagnamn</label>
                            <input type="text" class="form-control" id="stafettTeamName" placeholder="T.ex. 'Klubbens Stafett A'" maxlength="100">
                        </div>

                        <div class="mb-3">
                            <label for="stafettClassSelect" class="form-label">Stafettklass</label>
                            <select class="form-select" id="stafettClassSelect">
                                <option value="">Välj stafettklass...</option>
                            </select>
                            <div class="form-text" id="stafettClassInfo"></div>
                        </div>

                        @if ((bool)(ViewData["IsSpringskytte"] ?? false))
                        {
                            <div id="stafettOptionalMembersHint" class="bg-info-subtle border border-info-subtle text-info-emphasis rounded py-2 px-3 small mb-2">
                                <i class="bi bi-info-circle me-1"></i>Att välja deltagare är valfritt. Du kan skapa stafettlaget och betala avgiften nu, och lägga till eller ändra deltagarna när som helst före tävlingen (via <i class="bi bi-pencil"></i> Redigera).
                            </div>
                        }

                        <div id="stafettMemberSelectionArea" style="display:none;">
                            <label class="form-label">Klubbmedlemmar</label>
                            <p class="text-muted small mb-2">Stafettdeltagare behöver inte vara individuellt anmälda i tävlingen.</p>
                            <div style="max-height: 280px; overflow-y: auto; border: 1px solid var(--bs-border-color); border-radius: 0.375rem;">
                                <table class="table table-sm table-hover mb-0" id="stafettMembersTable">
                                    <thead class="sticky-top" style="background: var(--bs-body-bg);">
                                        <tr>
                                            <th style="width:40px;"></th>
                                            <th>Namn</th>
                                        </tr>
                                    </thead>
                                    <tbody id="stafettMembersTableBody">
                                    </tbody>
                                </table>
                            </div>
                            <div class="form-text mt-1" id="stafettMemberCountInfo"></div>
                        </div>

                        <div id="createStafettError" class="alert alert-danger d-none mt-3"></div>
                        <div id="createStafettSuccess" class="alert alert-success d-none mt-3"></div>

                        <button type="button" class="btn btn-primary w-100 mt-3" id="createStafettBtn">
                            <i class="bi bi-people-fill me-1"></i>Skapa stafettlag
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

@* ====== Edit Stafett Team Modal (nested) — Springskytte deferred participant selection ====== *@
<div class="modal fade" id="stafettEditTeamModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Redigera stafettlag</h5>
                <button type="button" class="btn-close" id="stafettEditCloseBtn" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="stafettEditTeamId">
                <input type="hidden" id="stafettEditTeamClass">
                <input type="hidden" id="stafettEditClubId">

                <div class="mb-3">
                    <label for="stafettEditTeamName" class="form-label">Lagnamn</label>
                    <input type="text" class="form-control" id="stafettEditTeamName" maxlength="100">
                </div>

                <div class="mb-1">
                    <span class="form-label">Stafettklass: <strong id="stafettEditClassDisplay"></strong></span>
                    <span class="form-text ms-2" id="stafettEditClassInfo"></span>
                </div>

                <p class="text-muted small mb-2">Stafettdeltagare behöver inte vara individuellt anmälda i tävlingen. Du kan namnge dem nu eller senare (när som helst före tävlingen).</p>
                <div style="max-height: 280px; overflow-y: auto; border: 1px solid var(--bs-border-color); border-radius: 0.375rem;">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="sticky-top" style="background: var(--bs-body-bg);">
                            <tr>
                                <th style="width:40px;"></th>
                                <th>Namn</th>
                            </tr>
                        </thead>
                        <tbody id="stafettEditMembersTableBody">
                        </tbody>
                    </table>
                </div>
                <div class="form-text mt-1" id="stafettEditMemberCountInfo"></div>

                <div id="stafettEditError" class="alert alert-danger d-none mt-3"></div>
                <div id="stafettEditSuccess" class="alert alert-success d-none mt-3"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="stafettEditCancelBtn">Avbryt</button>
                <button type="button" class="btn btn-primary" id="stafettEditSaveBtn">
                    <i class="bi bi-check-lg me-1"></i>Spara ändringar
                </button>
            </div>
        </div>
    </div>
</div>

@{
    var stafettRegionOptions = new List<object>();
    foreach (Federations.RegionalFederations rf in Enum.GetValues(typeof(Federations.RegionalFederations)))
    {
        stafettRegionOptions.Add(new { code = rf.ToString(), name = rf.GetDescription() });
    }
    var stafettJsonOpts = new JsonSerializerOptions { Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    var stafettRegionOptionsJson = JsonSerializer.Serialize(stafettRegionOptions, stafettJsonOpts);
}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const stafettCompetitionId = @(ViewData["CompetitionId"]);
    const stafettCurrentMemberClubId = @(ViewData["CurrentMemberClubId"] ?? 0);
    const stafettCurrentMemberClubName = '@Html.Raw(((string)(ViewData["CurrentMemberClubName"] ?? "")).Replace("'", "\\'"))';
    const stafettCurrentMemberId = @(ViewData["CurrentMemberId"] ?? 0);
    const stafettRegRole = '@(ViewData["RegRole"] ?? "member")';
    const stafettRegRegionCode = '@(ViewData["RegRegionCode"] ?? "")';
    const stafettAllClubsWithRegions = @Html.Raw((string)(ViewData["ClubsWithRegionsJson"] ?? "[]"));
    const stafettAllRegions = @Html.Raw(stafettRegionOptionsJson);
    const stafettRegistrationFee = @(ViewData["StafettRegistrationFee"] ?? 0);
    const stafettHasSwish = @((ViewData["StafettHasSwish"] as bool? ?? false).ToString().ToLower());

    const stafettIsAdmin = stafettRegRole === 'admin';
    const stafettIsRegionalAdmin = stafettRegRole === 'regionalAdmin';
    const stafettIsMember = !stafettIsAdmin && !stafettIsRegionalAdmin;

    // Edit/Delete is allowed for site admins (all), regional admins (teams whose club is in
    // their region), and members whose PRIMARY club is the team's club. Mirrors the server check.
    function stafettCanManageTeam(team) {
        if (!team) return false;
        if (stafettIsAdmin) return true;
        if (stafettIsRegionalAdmin) {
            const club = (stafettAllClubsWithRegions || []).find(c => Number(c.id) === Number(team.clubId));
            return !!club && club.region === stafettRegRegionCode;
        }
        return Number(team.clubId) === Number(stafettCurrentMemberClubId);
    }

    let stafettTeamClasses = [];
    let stafettClubMembers = [];
    let stafettSelectedMembers = new Set();
    // Springskytte allows creating/saving a relay with no or partial participants (named later).
    let stafettIsSpringskytteComp = false;

    // ==================== Region/Club dropdowns ====================
    // let, not const: the create tab's HTML is restored after payment options replace it,
    // which detaches these nodes - stafettRebindCreateTab() re-resolves them.
    let stafettRegionSelect = document.getElementById('stafettRegionSelect');
    let stafettClubSelect = document.getElementById('stafettClubSelect');

    function stafettInitDropdowns() {
        stafettRegionSelect.innerHTML = '<option value="">Alla kretsar</option>';
        stafettAllRegions.forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.code;
            opt.textContent = r.name;
            stafettRegionSelect.appendChild(opt);
        });

        if (stafettIsMember) {
            stafettRegionSelect.value = stafettRegRegionCode;
            stafettRegionSelect.disabled = true;
            stafettPopulateClubDropdown(stafettRegRegionCode);
            stafettClubSelect.value = stafettCurrentMemberClubId.toString();
            stafettClubSelect.disabled = true;
        } else if (stafettIsRegionalAdmin) {
            stafettRegionSelect.value = stafettRegRegionCode;
            stafettRegionSelect.disabled = true;
            stafettPopulateClubDropdown(stafettRegRegionCode);
            if (stafettCurrentMemberClubId > 0) stafettClubSelect.value = stafettCurrentMemberClubId.toString();
        } else {
            stafettPopulateClubDropdown('');
        }
    }

    function stafettPopulateClubDropdown(regionFilter) {
        const currentVal = stafettClubSelect.value;
        stafettClubSelect.innerHTML = '<option value="">Välj förening...</option>';

        if (stafettIsMember && stafettCurrentMemberClubId > 0) {
            const opt = document.createElement('option');
            opt.value = stafettCurrentMemberClubId;
            opt.textContent = stafettCurrentMemberClubName;
            stafettClubSelect.appendChild(opt);
            stafettClubSelect.value = stafettCurrentMemberClubId.toString();
            return;
        }

        let clubs = stafettAllClubsWithRegions;
        if (regionFilter) clubs = clubs.filter(c => c.region === regionFilter);
        clubs.forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.name;
            stafettClubSelect.appendChild(opt);
        });

        if (currentVal && stafettClubSelect.querySelector(`option[value="${currentVal}"]`)) {
            stafettClubSelect.value = currentVal;
        }
    }

    function stafettBindRegionClubSelects() {
        stafettRegionSelect = document.getElementById('stafettRegionSelect');
        stafettClubSelect = document.getElementById('stafettClubSelect');
        stafettRegionSelect.addEventListener('change', function() {
            stafettPopulateClubDropdown(this.value);
            stafettOnClubChanged();
        });
        stafettClubSelect.addEventListener('change', stafettOnClubChanged);
    }
    stafettBindRegionClubSelects();

    async function stafettOnClubChanged() {
        stafettClearAllAlerts();
        const clubId = stafettClubSelect.value;
        const memberArea = document.getElementById('stafettMemberSelectionArea');
        stafettSelectedMembers.clear();
        stafettClubMembers = [];

        if (!clubId) {
            memberArea.style.display = 'none';
            stafettUpdateMemberCountInfo();
            return;
        }
        memberArea.style.display = 'block';
        await stafettLoadClubMembers(parseInt(clubId));
    }

    // ==================== Modal init ====================
    let stafettSuccessTimer = null;
    function stafettClearAllAlerts() {
        if (stafettSuccessTimer) { clearTimeout(stafettSuccessTimer); stafettSuccessTimer = null; }
        document.querySelectorAll('#stafettRegistrationModal .alert, #stafettTeamsListMessage').forEach(el => {
            el.classList.add('d-none');
            el.textContent = '';
        });
    }
    function stafettShowSuccessAlert(el, message) {
        el.textContent = message;
        el.classList.remove('d-none');
        if (stafettSuccessTimer) clearTimeout(stafettSuccessTimer);
        stafettSuccessTimer = setTimeout(() => { el.classList.add('d-none'); stafettSuccessTimer = null; }, 3000);
    }

    const stafettModal = document.getElementById('stafettRegistrationModal');
    const stafettCreateTabEl = document.getElementById('createStafettTab');
    const stafettCreateTabOriginalHtml = stafettCreateTabEl.innerHTML;

    stafettModal.addEventListener('show.bs.modal', () => {
        // Restore create tab if it was replaced by payment options
        if (!document.getElementById('createStafettBtn')) {
            stafettCreateTabEl.innerHTML = stafettCreateTabOriginalHtml;
            stafettRebindCreateTab();
        }
        stafettSelectedMembers.clear();
        stafettClubMembers = [];
        document.getElementById('stafettMemberSelectionArea').style.display = 'none';
        document.getElementById('stafettMembersTableBody').innerHTML = '';
        // ...and the rest of the form + any leftover payment panel, so a reopen is always pristine.
        const stfNameOnOpen = document.getElementById('stafettTeamName');
        if (stfNameOnOpen) stfNameOnOpen.value = '';
        const stfClassOnOpen = document.getElementById('stafettClassSelect');
        if (stfClassOnOpen) stfClassOnOpen.value = '';
        const stfInfoOnOpen = document.getElementById('stafettClassInfo');
        if (stfInfoOnOpen) stfInfoOnOpen.textContent = '';
        stafettClearPaymentPanel();
        stafettClearAllAlerts();
        stafettInitDropdowns();
        stafettLoadTeamClasses();
        stafettLoadExistingTeams();
        if (stafettClubSelect.value) stafettOnClubChanged();
    });

    stafettModal.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
        tab.addEventListener('show.bs.tab', stafettClearAllAlerts);
    });

    async function stafettLoadTeamClasses() {
        try {
            const resp = await fetch(`/umbraco/surface/CompetitionTeam/GetTeamsForCompetition?competitionId=${stafettCompetitionId}`);
            const data = await resp.json();
            if (!data.success) return;
            stafettIsSpringskytteComp = !!data.isSpringskytte;
            stafettTeamClasses = data.stafettTeamClasses || [];
            const select = document.getElementById('stafettClassSelect');
            select.innerHTML = '<option value="">Välj stafettklass...</option>';
            stafettTeamClasses.forEach(tc => {
                const opt = document.createElement('option');
                opt.value = tc.teamClass;
                opt.textContent = `${tc.teamClass} (${tc.coreMembers} deltagare, ${tc.description})`;
                select.appendChild(opt);
            });
        } catch(e) {
            console.error('Error loading stafett classes:', e);
        }
    }

    function stafettBindClassSelect() {
        document.getElementById('stafettClassSelect').addEventListener('change', function() {
            stafettClearAllAlerts();
            stafettClearValidation();
            const teamClass = this.value;
            const info = document.getElementById('stafettClassInfo');
            if (!teamClass) {
                info.textContent = '';
            } else {
                const tc = stafettTeamClasses.find(t => t.teamClass === teamClass);
                if (tc) {
                    info.textContent = `${tc.coreMembers} deltagare. ${tc.description}`;
                }
            }
            stafettSelectedMembers.clear();
            stafettSelectedSpare = null;
            stafettRenderMembersTable();
        });
    }
    stafettBindClassSelect();

    // ==================== Load club members (ALL members, not just registered) ====================
    async function stafettLoadClubMembers(clubId) {
        const tbody = document.getElementById('stafettMembersTableBody');
        tbody.innerHTML = '<tr><td colspan="3" class="text-center"><div class="spinner-border spinner-border-sm"></div></td></tr>';
        try {
            const resp = await fetch(`/umbraco/surface/CompetitionTeam/GetClubMembersForRelay?competitionId=${stafettCompetitionId}&clubId=${clubId}`);
            const data = await resp.json();
            if (!data.success || !data.members?.length) {
                tbody.innerHTML = '<tr><td colspan="3" class="text-muted small">Inga medlemmar hittades för denna förening.</td></tr>';
                stafettClubMembers = [];
                stafettUpdateMemberCountInfo();
                return;
            }
            stafettClubMembers = data.members;
            stafettRenderMembersTable();
        } catch(e) {
            tbody.innerHTML = '<tr><td colspan="3" class="text-danger small">Fel vid laddning.</td></tr>';
        }
    }

    // "F" = damer only, null = mixed. Mirrors TeamClassHelper.GetStafettGenderRestriction; the
    // server re-checks on save, this only stops the mistake being made in the first place.
    function stafettGenderRestriction(teamClass) {
        const tc = teamClass ? stafettTeamClasses.find(t => t.teamClass === teamClass) : null;
        return (tc && tc.genderRestriction) ? tc.genderRestriction : null;
    }

    // Unknown gender ('') passes — same lenient rule as the server, so members without a gender or
    // personnummer on file are never silently locked out of a relay.
    function stafettMemberAllowed(m, restriction) {
        if (!restriction) return true;
        const g = (m.gender || '').trim();
        return g === '' || g === restriction;
    }

    function stafettRenderMembersTable() {
        const tbody = document.getElementById('stafettMembersTableBody');
        const teamClass = document.getElementById('stafettClassSelect').value;

        if (!stafettClubMembers.length) {
            tbody.innerHTML = '<tr><td colspan="2" class="text-muted small">Inga medlemmar.</td></tr>';
            stafettUpdateMemberCountInfo();
            return;
        }

        tbody.innerHTML = '';
        const restriction = stafettGenderRestriction(teamClass);
        stafettClubMembers.forEach(m => {
            const row = document.createElement('tr');
            const isSelected = stafettSelectedMembers.has(m.memberId);
            const isEligible = stafettMemberAllowed(m, restriction);

            const tdCheck = document.createElement('td');
            const cb = document.createElement('input');
            cb.type = 'checkbox'; cb.className = 'form-check-input'; cb.value = m.memberId;
            cb.checked = isSelected; cb.disabled = !teamClass || !isEligible;
            tdCheck.appendChild(cb);
            row.appendChild(tdCheck);

            const tdName = document.createElement('td');
            tdName.textContent = m.name;
            if (!isEligible) {
                row.classList.add('text-muted');
                tdName.title = 'Klassen är endast för damer';
            }
            row.appendChild(tdName);

            cb.addEventListener('change', function() {
                if (this.checked) stafettSelectedMembers.add(m.memberId);
                else stafettSelectedMembers.delete(m.memberId);
                stafettUpdateMemberCountInfo();
            });

            tbody.appendChild(row);
        });
        stafettUpdateMemberCountInfo();
    }

    // ==================== Validation ====================
    function stafettClearValidation() {
        document.querySelectorAll('#createStafettTab .is-invalid').forEach(el => el.classList.remove('is-invalid'));
        document.querySelectorAll('#createStafettTab .invalid-feedback').forEach(el => el.remove());
        document.getElementById('createStafettError').classList.add('d-none');
    }

    function stafettMarkInvalid(el, msg) {
        el.classList.add('is-invalid');
        let fb = el.parentElement.querySelector('.invalid-feedback');
        if (!fb) {
            fb = document.createElement('div');
            fb.className = 'invalid-feedback';
            el.after(fb);
        }
        fb.textContent = msg;
    }

    function stafettUpdateMemberCountInfo() {
        const teamClass = document.getElementById('stafettClassSelect').value;
        const tc = teamClass ? stafettTeamClasses.find(t => t.teamClass === teamClass) : null;
        const countInfo = document.getElementById('stafettMemberCountInfo');
        if (!tc) { countInfo.textContent = ''; return; }
        const total = stafettSelectedMembers.size;
        countInfo.textContent = total > 0
            ? `Valda: ${total} av ${tc.coreMembers}`
            : (stafettIsSpringskytteComp
                ? `Valfritt nu – välj ${tc.coreMembers} deltagare nu eller senare`
                : `Välj ${tc.coreMembers} deltagare`);
    }

    function stafettValidateCreateForm() {
        stafettClearValidation();
        let valid = true;
        const classEl = document.getElementById('stafettClassSelect');
        const nameEl = document.getElementById('stafettTeamName');
        const teamClass = classEl.value;
        const teamName = nameEl.value.trim();
        const tc = teamClass ? stafettTeamClasses.find(t => t.teamClass === teamClass) : null;

        if (!stafettClubSelect.value) { stafettMarkInvalid(stafettClubSelect, 'Välj en förening'); valid = false; }
        if (!teamName) { stafettMarkInvalid(nameEl, 'Ange ett lagnamn'); valid = false; }
        if (!teamClass || !tc) { stafettMarkInvalid(classEl, 'Välj en stafettklass'); valid = false; }

        if (tc) {
            const total = stafettSelectedMembers.size;
            // Springskytte: participants can be added later, so 0..core is OK at create.
            if (stafettIsSpringskytteComp) {
                if (total > tc.coreMembers) {
                    const errorEl = document.getElementById('createStafettError');
                    errorEl.textContent = `Max ${tc.coreMembers} deltagare (${total} valda).`;
                    errorEl.classList.remove('d-none');
                    valid = false;
                }
            } else if (total !== tc.coreMembers) {
                const errorEl = document.getElementById('createStafettError');
                errorEl.textContent = `Välj exakt ${tc.coreMembers} deltagare (${total} valda).`;
                errorEl.classList.remove('d-none');
                valid = false;
            }
        }
        if (!valid) {
            const firstInvalid = document.querySelector('#createStafettTab .is-invalid')
                || document.querySelector('#createStafettError:not(.d-none)');
            if (firstInvalid) firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return valid;
    }

    function stafettBindCreateTabEvents() {
        document.getElementById('stafettTeamName').addEventListener('input', () => { stafettClearValidation(); });
        document.getElementById('createStafettBtn').addEventListener('click', stafettHandleCreate);
    }
    stafettBindCreateTabEvents();

    function stafettRebindCreateTab() {
        stafettBindRegionClubSelects();
        stafettBindClassSelect();
        stafettBindCreateTabEvents();
        stafettSelectedMembers.clear();
        stafettClubMembers = [];
        document.getElementById('stafettMemberSelectionArea').style.display = 'none';
    }

    // ==================== "Redan med i en stafett"-varning ====================
    // A shooter may be in a lag AND a stafett, but not two stafetter. Advisory only — the server
    // agrees and merely warns, so this is about making it visible before anything is written.
    async function stafettCheckConflicts(teamClass, memberIds) {
        if (!memberIds.length) return [];
        try {
            const resp = await fetch('/umbraco/surface/CompetitionTeam/CheckTeamMembership', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ competitionId: stafettCompetitionId, teamClass, memberIds, excludeTeamId: null })
            });
            const d = await resp.json();
            return (d && d.conflicts) ? d.conflicts : [];
        } catch (e) { return []; }
    }

    function stafettConfirmConflicts(conflicts) {
        const lines = conflicts
            .map(c => `• ${c.memberName} är redan med i ${c.teamName} (${c.teamClass})${c.isSpare ? ' — som reserv' : ''}`)
            .join('\n');
        return window.confirm(
            `Redan med i en stafett:\n\n${lines}\n\n` +
            `Det är tillåtet att vara med i flera lag. Vill du fortsätta ändå?`);
    }

    // ==================== Create stafett team ====================
    async function stafettHandleCreate() {
        if (!stafettValidateCreateForm()) return;
        const btn = document.getElementById('createStafettBtn'); btn.disabled = true;
        const errorEl = document.getElementById('createStafettError');
        const successEl = document.getElementById('createStafettSuccess');
        errorEl.classList.add('d-none'); successEl.classList.add('d-none');

        const relayConflicts = await stafettCheckConflicts(
            document.getElementById('stafettClassSelect').value, Array.from(stafettSelectedMembers));
        if (relayConflicts.length && !stafettConfirmConflicts(relayConflicts)) { btn.disabled = false; return; }

        try {
            const resp = await fetch('/umbraco/surface/CompetitionTeam/CreateStafettTeam', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    competitionId: stafettCompetitionId,
                    teamName: document.getElementById('stafettTeamName').value.trim(),
                    teamClass: document.getElementById('stafettClassSelect').value,
                    clubId: parseInt(stafettClubSelect.value),
                    memberIds: Array.from(stafettSelectedMembers)
                })
            });
            const data = await resp.json();
            if (data.success) {
                const savedName = document.getElementById('stafettTeamName').value.trim();
                stafettShowSuccessAlert(successEl, data.message);
                await stafettClearCreateForm();
                btn.disabled = false;
                stafettLoadExistingTeams();
                // Payment options ride above the (now empty) form - see stafettShowPaymentOptions.
                if (stafettHasSwish && data.teamId) {
                    stafettShowPaymentOptions(data.teamId, savedName);
                }
            } else {
                errorEl.textContent = data.message; errorEl.classList.remove('d-none'); btn.disabled = false;
            }
        } catch(e) {
            errorEl.textContent = 'Ett nätverksfel uppstod.'; errorEl.classList.remove('d-none'); btn.disabled = false;
        }
    }

    // ==================== Tab 1: List existing stafett teams ====================
    async function stafettLoadExistingTeams() {
        const container = document.getElementById('existingStafettTeamsList');
        try {
            const resp = await fetch(`/umbraco/surface/CompetitionTeam/GetTeamsForCompetition?competitionId=${stafettCompetitionId}`);
            const data = await resp.json();

            // Only show relay teams
            const relayTeams = (data.teams || []).filter(t => t.isRelay);

            if (!data.success || !relayTeams.length) {
                container.innerHTML = '<div class="text-muted text-center py-3">Inga stafettlag skapade ännu.</div>';
                return;
            }

            let html = '';
            const teamsByClass = {};
            relayTeams.forEach(t => {
                if (!teamsByClass[t.teamClass]) teamsByClass[t.teamClass] = [];
                teamsByClass[t.teamClass].push(t);
            });

            for (const [cls, teams] of Object.entries(teamsByClass)) {
                const tcInfo = (data.stafettTeamClasses || []).find(tc => tc.teamClass === cls);
                const maxTotal = tcInfo ? tcInfo.coreMembers + tcInfo.maxSpares : 4;

                html += `<h6 class="mt-3 mb-2">${cls}</h6>`;
                teams.forEach(team => {
                    const memberCount = team.members?.length || 0;

                    html += `<div class="card mb-2"><div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <strong>${team.teamName}</strong>
                                <span class="text-muted small ms-2">${team.clubName}</span>
                                <div class="small mt-1">`;

                    if (team.members) {
                        team.members.forEach(m => {
                            html += `<span class="d-block">${m.name}</span>`;
                        });
                    }

                    // Only those who may manage this club's teams see edit/delete; others see
                    // the stafett team read-only. Edit additionally requires Springskytte.
                    const stafettCanManage = stafettCanManageTeam(team);
                    const stafettEditBtn = (stafettCanManage && stafettIsSpringskytteComp) ? `
                            <button class="btn btn-outline-primary btn-sm me-1 stafett-edit-team-btn" data-team-id="${team.id}" data-team-name="${team.teamName.replace(/"/g, '&quot;')}" data-team-class="${team.teamClass}" data-club-id="${team.clubId}" title="Redigera deltagare">
                                <i class="bi bi-pencil"></i>
                            </button>` : '';
                    const stafettDeleteBtn = stafettCanManage ? `
                            <button class="btn btn-outline-danger btn-sm stafett-delete-team-btn" data-team-id="${team.id}" data-team-name="${team.teamName.replace(/"/g, '&quot;')}" title="Ta bort">
                                <i class="bi bi-trash"></i>
                            </button>` : '';

                    html += `</div></div><div class="d-flex flex-column align-items-end">
                        <span class="badge bg-info mb-2">${memberCount}/${maxTotal}</span>
                        <div>${stafettEditBtn}${stafettDeleteBtn}</div>
                    </div></div></div></div>`;
                });
            }

            container.innerHTML = html;

            container.querySelectorAll('.stafett-delete-team-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const teamId = parseInt(this.dataset.teamId);
                    const teamName = this.dataset.teamName;
                    if (!confirm(`Vill du verkligen ta bort stafettlaget "${teamName}"?`)) return;
                    await stafettDeleteTeam(teamId);
                });
            });

            container.querySelectorAll('.stafett-edit-team-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    stafettOpenEditModal(
                        parseInt(this.dataset.teamId),
                        this.dataset.teamName,
                        this.dataset.teamClass,
                        parseInt(this.dataset.clubId)
                    );
                });
            });

        } catch(e) {
            container.innerHTML = '<div class="text-danger small">Fel vid laddning av stafettlag.</div>';
        }
    }

    async function stafettDeleteTeam(teamId) {
        const msgEl = document.getElementById('stafettTeamsListMessage');
        msgEl.classList.add('d-none');
        try {
            const resp = await fetch('/umbraco/surface/CompetitionTeam/DeleteTeam', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ teamId })
            });
            const data = await resp.json();
            if (data.success) {
                msgEl.className = 'alert alert-success mt-2';
                stafettShowSuccessAlert(msgEl, data.message);
                stafettLoadExistingTeams();
            } else {
                msgEl.className = 'alert alert-danger mt-2';
                msgEl.textContent = data.message;
                msgEl.classList.remove('d-none');
            }
        } catch(e) {
            msgEl.className = 'alert alert-danger mt-2';
            msgEl.textContent = 'Ett nätverksfel uppstod.';
        }
    }

    // ==================== Edit Stafett Team Modal (Springskytte deferred selection) ====================
    let stafettEditClubMembers = [];
    let stafettEditSelectedMembers = new Set();
    const stafettEditModalEl = document.getElementById('stafettEditTeamModal');

    document.getElementById('stafettEditCloseBtn').addEventListener('click', stafettCloseEditModal);
    document.getElementById('stafettEditCancelBtn').addEventListener('click', stafettCloseEditModal);

    function stafettCloseEditModal() {
        bootstrap.Modal.getOrCreateInstance(stafettEditModalEl).hide();
        setTimeout(() => bootstrap.Modal.getOrCreateInstance(stafettModal).show(), 200);
    }

    async function stafettOpenEditModal(teamId, teamName, teamClass, clubId) {
        bootstrap.Modal.getOrCreateInstance(stafettModal).hide();

        document.getElementById('stafettEditTeamId').value = teamId;
        document.getElementById('stafettEditTeamName').value = teamName;
        document.getElementById('stafettEditTeamClass').value = teamClass;
        document.getElementById('stafettEditClubId').value = clubId;
        document.getElementById('stafettEditClassDisplay').textContent = teamClass;
        const tc = stafettTeamClasses.find(t => t.teamClass === teamClass);
        document.getElementById('stafettEditClassInfo').textContent = tc ? `(${tc.coreMembers} deltagare)` : '';

        stafettEditSelectedMembers.clear();
        stafettEditClubMembers = [];
        document.getElementById('stafettEditError').classList.add('d-none');
        document.getElementById('stafettEditSuccess').classList.add('d-none');

        const tbody = document.getElementById('stafettEditMembersTableBody');
        tbody.innerHTML = '<tr><td colspan="2" class="text-center"><div class="spinner-border spinner-border-sm"></div></td></tr>';

        setTimeout(() => bootstrap.Modal.getOrCreateInstance(stafettEditModalEl).show(), 200);

        try {
            const resp = await fetch(`/umbraco/surface/CompetitionTeam/GetClubMembersForRelay?competitionId=${stafettCompetitionId}&clubId=${clubId}`);
            const data = await resp.json();
            stafettEditClubMembers = data.success ? (data.members || []) : [];

            // Pre-select the team's current participants
            const teamsResp = await fetch(`/umbraco/surface/CompetitionTeam/GetTeamsForCompetition?competitionId=${stafettCompetitionId}`);
            const teamsData = await teamsResp.json();
            if (teamsData.success) {
                const team = (teamsData.teams || []).find(t => t.id === teamId);
                if (team?.members) team.members.forEach(m => stafettEditSelectedMembers.add(m.memberId));
            }
            stafettRenderEditMembersTable();
        } catch(e) {
            tbody.innerHTML = '<tr><td colspan="2" class="text-danger small">Fel vid laddning.</td></tr>';
        }
    }

    function stafettRenderEditMembersTable() {
        const tbody = document.getElementById('stafettEditMembersTableBody');
        if (!stafettEditClubMembers.length) {
            tbody.innerHTML = '<tr><td colspan="2" class="text-muted small">Inga medlemmar hittades.</td></tr>';
            stafettUpdateEditCountInfo();
            return;
        }
        tbody.innerHTML = '';
        stafettEditClubMembers.forEach(m => {
            const row = document.createElement('tr');
            const tdCheck = document.createElement('td');
            const cb = document.createElement('input');
            cb.type = 'checkbox'; cb.className = 'form-check-input'; cb.value = m.memberId;
            cb.checked = stafettEditSelectedMembers.has(m.memberId);
            tdCheck.appendChild(cb); row.appendChild(tdCheck);
            const tdName = document.createElement('td'); tdName.textContent = m.name; row.appendChild(tdName);
            cb.addEventListener('change', function() {
                if (this.checked) stafettEditSelectedMembers.add(m.memberId);
                else stafettEditSelectedMembers.delete(m.memberId);
                stafettUpdateEditCountInfo();
            });
            tbody.appendChild(row);
        });
        stafettUpdateEditCountInfo();
    }

    function stafettUpdateEditCountInfo() {
        const teamClass = document.getElementById('stafettEditTeamClass').value;
        const tc = stafettTeamClasses.find(t => t.teamClass === teamClass);
        const info = document.getElementById('stafettEditMemberCountInfo');
        const btn = document.getElementById('stafettEditSaveBtn');
        const teamName = document.getElementById('stafettEditTeamName').value.trim();
        if (!tc) { info.textContent = ''; btn.disabled = !teamName; return; }
        const total = stafettEditSelectedMembers.size;
        info.textContent = total > 0 ? `Valda: ${total} av ${tc.coreMembers}` : 'Inga deltagare valda än (kan namnges senare)';
        // Springskytte: allow saving a partial/empty roster; block only over-fill or missing name.
        btn.disabled = !teamName || total > tc.coreMembers;
    }

    document.getElementById('stafettEditTeamName').addEventListener('input', stafettUpdateEditCountInfo);

    document.getElementById('stafettEditSaveBtn').addEventListener('click', async function() {
        const btn = this; btn.disabled = true;
        const errorEl = document.getElementById('stafettEditError');
        const successEl = document.getElementById('stafettEditSuccess');
        errorEl.classList.add('d-none'); successEl.classList.add('d-none');
        try {
            const resp = await fetch('/umbraco/surface/CompetitionTeam/UpdateTeam', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    teamId: parseInt(document.getElementById('stafettEditTeamId').value),
                    teamName: document.getElementById('stafettEditTeamName').value.trim(),
                    memberIds: Array.from(stafettEditSelectedMembers),
                    spareId: null
                })
            });
            const data = await resp.json();
            if (data.success) {
                successEl.textContent = data.message; successEl.classList.remove('d-none');
                stafettLoadExistingTeams();
                setTimeout(stafettCloseEditModal, 800);
            } else {
                errorEl.textContent = data.message; errorEl.classList.remove('d-none'); btn.disabled = false;
            }
        } catch(e) {
            errorEl.textContent = 'Ett nätverksfel uppstod.'; errorEl.classList.remove('d-none'); btn.disabled = false;
        }
    });

    // ==================== Payment Options ====================
    // Rendered ABOVE the create form, never over it: the form is already cleared and must stay usable
    // so a club can register its next relay team without closing the modal.
    function stafettShowPaymentOptions(teamId, teamName) {
        const panel = document.getElementById('stafettPaymentPanel');
        if (!panel) return;
        const safeName = String(teamName || 'Stafettlaget').replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
        panel.innerHTML = `
            <div class="alert alert-info mb-3">
                <h5 class="mb-2"><i class="bi bi-check-circle-fill text-success me-1"></i>${safeName} har skapats</h5>
                <p class="mb-3">Slutför stafettanmälan genom att betala avgiften (${stafettRegistrationFee} kr) med Swish. Du kan betala nu eller senare — formuläret nedan är redan tomt för nästa lag.</p>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary" id="stafettPayNowBtn">
                        <i class="bi bi-qr-code me-1"></i>Betala nu med Swish
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="stafettPayLaterBtn">
                        <i class="bi bi-clock me-1"></i>Betala senare
                    </button>
                </div>
            </div>`;
        document.getElementById('stafettPayNowBtn').addEventListener('click', () => showStafettSwishQR(teamId));
        document.getElementById('stafettPayLaterBtn').addEventListener('click', stafettClearPaymentPanel);
        panel.scrollIntoView({ block: 'nearest' });
    }

    function stafettClearPaymentPanel() {
        const panel = document.getElementById('stafettPaymentPanel');
        if (panel) panel.innerHTML = '';
    }

    // Empty the create form in place so it is immediately reusable for the next relay team.
    async function stafettClearCreateForm() {
        stafettClearValidation();
        const nameEl = document.getElementById('stafettTeamName');
        if (nameEl) nameEl.value = '';
        const classEl = document.getElementById('stafettClassSelect');
        if (classEl) classEl.value = '';
        const infoEl = document.getElementById('stafettClassInfo');
        if (infoEl) infoEl.textContent = '';
        stafettSelectedMembers.clear();
        if (stafettClubSelect && stafettClubSelect.value) {
            await stafettLoadClubMembers(parseInt(stafettClubSelect.value));
        } else {
            const tb = document.getElementById('stafettMembersTableBody');
            if (tb) tb.innerHTML = '';
        }
        stafettUpdateMemberCountInfo();
    }

    // ==================== Swish QR Code ====================
    function showStafettSwishQR(teamId) {
        const swishModalEl = document.getElementById('swishPaymentModal');
        if (!swishModalEl) return;

        // Hide stafett registration modal first - and come back to it when the QR is dismissed, so the
        // club lands on the (already cleared) form instead of on a page with nothing open.
        // One-shot listener: swishPaymentModal is shared with individual registration.
        swishModalEl.addEventListener('hidden.bs.modal', function backToStafett() {
            swishModalEl.removeEventListener('hidden.bs.modal', backToStafett);
            bootstrap.Modal.getOrCreateInstance(stafettModal).show();
        });
        bootstrap.Modal.getOrCreateInstance(stafettModal).hide();

        const modalBody = document.getElementById('swishPaymentModalBody');
        modalBody.innerHTML = `
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar QR-kod...</span>
            </div>
            <p class="mt-2">Laddar betalningsinformation...</p>
        `;

        setTimeout(() => {
            bootstrap.Modal.getOrCreateInstance(swishModalEl).show();
        }, 200);

        fetch(`/umbraco/surface/Swish/GenerateTeamPaymentQR?competitionId=${stafettCompetitionId}&teamId=${teamId}`)
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    // On a phone you can't scan the QR with the same device, so offer a
                    // deep-link button that opens the Swish app with the payment pre-filled.
                    const swishAppButton = data.swishAppUrl ? `
                        <a href="${data.swishAppUrl}" class="btn btn-success btn-lg w-100 mb-2">
                            <i class="bi bi-phone me-1"></i> Öppna Swish och betala
                        </a>
                        <div class="text-muted small mb-3">— eller skanna QR-koden med Swish-appen på en annan telefon —</div>
                    ` : '';

                    modalBody.innerHTML = `
                        ${swishAppButton}
                        <div class="mb-3">
                            <img src="${data.qrCode}" alt="Swish QR Code" style="max-width: 300px; width: 100%;" class="img-fluid">
                        </div>
                        <div class="alert alert-info text-start mb-0">
                            <h6 class="mb-2"><strong><i class="bi bi-info-circle"></i> Betalningsinformation</strong></h6>
                            <p class="mb-1"><strong>Lag:</strong> ${data.teamName}</p>
                            <p class="mb-1"><strong>Klass:</strong> ${data.teamClass}</p>
                            <p class="mb-1"><strong>Förening:</strong> ${data.clubName}</p>
                            <p class="mb-1"><strong>Belopp:</strong> ${data.amount} kr</p>
                            <p class="mb-0"><strong>Fakturanummer:</strong> ${data.invoiceNumber}</p>
                        </div>
                    `;
                } else {
                    modalBody.innerHTML = `
                        <div class="alert alert-danger mb-0">
                            <i class="bi bi-exclamation-triangle"></i> <strong>Fel</strong><br>${data.message}
                        </div>
                    `;
                }
            })
            .catch(() => {
                modalBody.innerHTML = `
                    <div class="alert alert-danger mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Ett nätverksfel uppstod.
                    </div>
                `;
            });
    }
});
</script>
