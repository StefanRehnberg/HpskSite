@* Admin Statistics Tab - Site admin only *@

<div id="statisticsContainer">
    <!-- Refresh button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-graph-up me-2"></i>Statistik</h3>
        <button class="btn btn-outline-primary btn-sm" id="refreshStatsBtn" onclick="loadStatistics(true)">
            <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
        </button>
    </div>

    <!-- Loading spinner -->
    <div id="statsLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Laddar...</span>
        </div>
        <p class="text-muted mt-2">Laddar statistik...</p>
    </div>

    <!-- Error alert -->
    <div id="statsError" class="alert alert-danger d-none" role="alert">
        <strong>Fel:</strong> <span id="statsErrorMessage"></span>
    </div>

    <!-- Content (hidden until loaded) -->
    <div id="statsContent" style="display: none;">

        <!-- Section A: Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-primary">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">Medlemmar</h6>
                        <h2 class="card-title mb-1" id="statTotalMembers">—</h2>
                        <small class="text-success" id="statNewMembersMonth"></small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-success">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">Klubbar</h6>
                        <h2 class="card-title mb-1" id="statClubs">—</h2>
                        <small class="text-success" id="statNewClubs"></small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-info">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">Tävlingar i år</h6>
                        <h2 class="card-title mb-1" id="statCompetitions">—</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-warning">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">Träningsmatcher (30d)</h6>
                        <h2 class="card-title mb-1" id="statTrainingMatches30d">—</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section B: Medlemsstatistik -->
        <h5 class="mt-4 mb-3"><i class="bi bi-people me-2"></i>Medlemsstatistik</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Nya medlemmar per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartNewMembers"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="card-title mb-0">Medlemmar per krets</h6>
                            <button class="btn btn-sm btn-link p-0 text-muted d-none" id="regionChartToggle" onclick="toggleRegionChart()">
                                <i class="bi bi-arrows-expand" id="regionToggleIcon"></i>
                            </button>
                        </div>
                        <div style="position:relative;height:220px;overflow:hidden;transition:height 0.3s ease" id="regionChartWrapper">
                            <canvas id="chartMembersByRegion"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section C: Tävlingsstatistik -->
        <h5 class="mt-4 mb-3"><i class="bi bi-trophy me-2"></i>Tävlingsstatistik</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Tävlingar per disciplin</h6>
                        <div style="position:relative;height:220px"><canvas id="chartCompetitionsByDiscipline"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Största tävlingar</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tävling</th>
                                        <th>Disciplin</th>
                                        <th class="text-end">Anmälda</th>
                                    </tr>
                                </thead>
                                <tbody id="topCompetitionsBody">
                                    <tr><td colspan="3" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section D: Träningsmatcher -->
        <h5 class="mt-4 mb-3"><i class="bi bi-controller me-2"></i>Träningsmatcher</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Träningsmatcher per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartTrainingMatches"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Matcher senaste 30d</small>
                            <h3 class="mb-0" id="statMatchCount30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Unika deltagare (30d)</small>
                            <h3 class="mb-0" id="statParticipants30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Klubbar representerade (30d)</small>
                            <h3 class="mb-0" id="statMatchClubs30d">—</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section E: Skyttetrappan -->
        <h5 class="mt-4 mb-3"><i class="bi bi-ladder me-2"></i>Skyttetrappan</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Medlemmar per nivå</h6>
                        <div style="position:relative;height:220px"><canvas id="chartTrainingStairsLevels"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva elever</small>
                            <h3 class="mb-0" id="statActiveTrainees">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Steg godkända (30d)</small>
                            <h3 class="mb-0" id="statStepsCompleted30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva träningsgrupper</small>
                            <h3 class="mb-0" id="statActiveGroups">—</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section F: Aktivitet -->
        <h5 class="mt-4 mb-3"><i class="bi bi-activity me-2"></i>Aktivitet</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Träningsresultat per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartTrainingScores"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva medlemmar (30d)</small>
                            <h3 class="mb-0" id="statActive30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva medlemmar (90d)</small>
                            <h3 class="mb-0" id="statActive90d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva medlemmar (365d)</small>
                            <h3 class="mb-0" id="statActive365d">—</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
(function () {
    let statsLoaded = false;
    let chartInstances = {};
    let lastStatsData = null;

    // Theme-aware colors
    function getColors() {
        const style = getComputedStyle(document.documentElement);
        return {
            primary: style.getPropertyValue('--chart-primary').trim() || '#0d6efd',
            success: style.getPropertyValue('--chart-success').trim() || '#198754',
            danger: style.getPropertyValue('--chart-danger').trim() || '#dc3545',
            warning: '#ffc107',
            info: '#0dcaf0',
            text: style.getPropertyValue('--chart-text').trim() || '#212529',
            grid: style.getPropertyValue('--chart-grid').trim() || 'rgba(0, 0, 0, 0.1)',
            muted: style.getPropertyValue('--bs-secondary-color') || '#6c757d'
        };
    }

    // Broad palette so every discipline gets a distinct color
    const chartPalette = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#0dcaf0', '#6c757d'];

    function getDisciplineColor(discipline, index) {
        const known = { 'Precision': 0, 'Duell': 1, 'Milsnabb': 2, 'Springskytte': 3 };
        if (discipline in known) return chartPalette[known[discipline]];
        return chartPalette[index % chartPalette.length];
    }

    let regionChartExpanded = false;

    function destroyChart(id) {
        if (chartInstances[id]) {
            chartInstances[id].destroy();
            chartInstances[id] = null;
        }
    }

    function formatMonth(monthStr) {
        const [y, m] = monthStr.split('-');
        const months = ['jan', 'feb', 'mar', 'apr', 'maj', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
        return months[parseInt(m) - 1] + ' ' + y.slice(2);
    }

    window.loadStatistics = function (force) {
        if (statsLoaded && !force) return;

        const loading = document.getElementById('statsLoading');
        const content = document.getElementById('statsContent');
        const error = document.getElementById('statsError');
        const btn = document.getElementById('refreshStatsBtn');

        loading.style.display = '';
        content.style.display = 'none';
        error.classList.add('d-none');
        if (btn) btn.disabled = true;

        const url = '/umbraco/surface/AdminStatistics/GetStatistics?force=' + (force ? 'true' : 'false');

        fetch(url)
            .then(r => r.json())
            .then(resp => {
                loading.style.display = 'none';
                if (btn) btn.disabled = false;

                if (!resp.success) {
                    error.classList.remove('d-none');
                    document.getElementById('statsErrorMessage').textContent = resp.message || 'Okänt fel';
                    return;
                }

                statsLoaded = true;
                lastStatsData = resp.data;
                content.style.display = '';
                renderStatistics(resp.data);
            })
            .catch(err => {
                loading.style.display = 'none';
                if (btn) btn.disabled = false;
                error.classList.remove('d-none');
                document.getElementById('statsErrorMessage').textContent = err.message || 'Nätverksfel';
            });
    };

    function renderStatistics(d) {
        const colors = getColors();

        // Section A: Summary cards
        document.getElementById('statTotalMembers').textContent = d.totalMembers;
        document.getElementById('statNewMembersMonth').textContent = d.newMembersThisMonth > 0
            ? '+' + d.newMembersThisMonth + ' denna månad' : '';
        document.getElementById('statClubs').textContent = d.activeClubs + ' aktiva / ' + d.totalClubs;
        document.getElementById('statNewClubs').textContent = d.newClubs30d > 0
            ? '+' + d.newClubs30d + ' nya' : '';
        document.getElementById('statCompetitions').textContent = d.competitionsThisYear;
        document.getElementById('statTrainingMatches30d').textContent = d.trainingMatches30d;

        // Section B: New members per month (bar chart)
        if (d.newMembersPerMonth && d.newMembersPerMonth.length) {
            destroyChart('chartNewMembers');
            const ctx = document.getElementById('chartNewMembers').getContext('2d');
            chartInstances['chartNewMembers'] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: d.newMembersPerMonth.map(x => formatMonth(x.month)),
                    datasets: [{
                        label: 'Nya medlemmar',
                        data: d.newMembersPerMonth.map(x => x.count),
                        backgroundColor: colors.primary + 'cc',
                        borderColor: colors.primary,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        x: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section B: Members by region (horizontal bar)
        // Store full data for expand/collapse re-render
        window._regionData = d.membersByRegion;
        renderRegionChart(colors);

        // Section C: Competitions by discipline (doughnut)
        if (d.competitionsByDiscipline && d.competitionsByDiscipline.length) {
            destroyChart('chartCompetitionsByDiscipline');
            const ctx = document.getElementById('chartCompetitionsByDiscipline').getContext('2d');
            const bgColors = d.competitionsByDiscipline.map((x, i) => getDisciplineColor(x.discipline, i));
            chartInstances['chartCompetitionsByDiscipline'] = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: d.competitionsByDiscipline.map(x => x.discipline + ' (' + x.count + ')'),
                    datasets: [{
                        data: d.competitionsByDiscipline.map(x => x.count),
                        backgroundColor: bgColors,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: colors.text,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 12
                            }
                        }
                    }
                }
            });
        }

        // Section C: Top competitions table
        var tbody = document.getElementById('topCompetitionsBody');
        if (d.topCompetitions && d.topCompetitions.length) {
            tbody.innerHTML = d.topCompetitions.map((c, i) =>
                '<tr><td>' + escapeHtml(c.name) + '</td>' +
                '<td><span class="badge" style="background-color:' + getDisciplineColor(c.discipline, i) + '">' + escapeHtml(c.discipline) + '</span></td>' +
                '<td class="text-end">' + c.registrations + '</td></tr>'
            ).join('');
        } else {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">Inga tävlingar att visa</td></tr>';
        }

        // Section D: Training matches per month (bar chart)
        if (d.trainingMatchesPerMonth && d.trainingMatchesPerMonth.length) {
            destroyChart('chartTrainingMatches');
            const ctx = document.getElementById('chartTrainingMatches').getContext('2d');
            chartInstances['chartTrainingMatches'] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: d.trainingMatchesPerMonth.map(x => formatMonth(x.month)),
                    datasets: [{
                        label: 'Träningsmatcher',
                        data: d.trainingMatchesPerMonth.map(x => x.count),
                        backgroundColor: colors.warning + 'cc',
                        borderColor: colors.warning,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        x: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section D: Stat cards
        document.getElementById('statMatchCount30d').textContent = d.trainingMatches30d;
        document.getElementById('statParticipants30d').textContent = d.trainingMatchParticipants30d;
        document.getElementById('statMatchClubs30d').textContent = d.trainingMatchClubs30d;

        // Section E: Training stairs levels (horizontal bar)
        if (d.trainingStairsMembersPerLevel && d.trainingStairsMembersPerLevel.length) {
            destroyChart('chartTrainingStairsLevels');
            const ctx = document.getElementById('chartTrainingStairsLevels').getContext('2d');
            chartInstances['chartTrainingStairsLevels'] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: d.trainingStairsMembersPerLevel.map(x => 'Nivå ' + x.level),
                    datasets: [{
                        label: 'Medlemmar',
                        data: d.trainingStairsMembersPerLevel.map(x => x.count),
                        backgroundColor: colors.info + 'cc',
                        borderColor: colors.info,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        y: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section E: Stat cards
        document.getElementById('statActiveTrainees').textContent = d.trainingStairsActiveTrainees;
        document.getElementById('statStepsCompleted30d').textContent = d.trainingStairsStepsCompleted30d;
        document.getElementById('statActiveGroups').textContent = d.trainingStairsActiveGroups;

        // Section F: Training scores per month (line chart)
        if (d.trainingScoresPerMonth && d.trainingScoresPerMonth.length) {
            destroyChart('chartTrainingScores');
            const ctx = document.getElementById('chartTrainingScores').getContext('2d');
            chartInstances['chartTrainingScores'] = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: d.trainingScoresPerMonth.map(x => formatMonth(x.month)),
                    datasets: [{
                        label: 'Träningsresultat',
                        data: d.trainingScoresPerMonth.map(x => x.count),
                        borderColor: colors.primary,
                        backgroundColor: colors.primary + '33',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        x: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section F: Active members
        document.getElementById('statActive30d').textContent = d.activeMembers30d;
        document.getElementById('statActive90d').textContent = d.activeMembers90d;
        document.getElementById('statActive365d').textContent = d.activeMembers365d;
    }

    const REGION_COLLAPSED_MAX = 7;

    function renderRegionChart(colors) {
        if (!colors) colors = getColors();
        const allData = window._regionData;
        if (!allData || !allData.length) return;

        const toggleBtn = document.getElementById('regionChartToggle');
        const icon = document.getElementById('regionToggleIcon');
        const needsToggle = allData.length > REGION_COLLAPSED_MAX;

        if (needsToggle) {
            toggleBtn.classList.remove('d-none');
            toggleBtn.title = regionChartExpanded ? 'Visa topp ' + REGION_COLLAPSED_MAX : 'Visa alla kretsar';
            icon.className = regionChartExpanded ? 'bi bi-arrows-collapse' : 'bi bi-arrows-expand';
        } else {
            toggleBtn.classList.add('d-none');
        }

        const data = regionChartExpanded ? allData : allData.slice(0, REGION_COLLAPSED_MAX);
        const barHeight = 28;
        const chartHeight = Math.max(180, data.length * barHeight);
        const wrapper = document.getElementById('regionChartWrapper');
        wrapper.style.height = chartHeight + 'px';

        destroyChart('chartMembersByRegion');
        const ctx = document.getElementById('chartMembersByRegion').getContext('2d');
        chartInstances['chartMembersByRegion'] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(x => x.region),
                datasets: [{
                    label: 'Medlemmar',
                    data: data.map(x => x.count),
                    backgroundColor: colors.success + 'cc',
                    borderColor: colors.success,
                    borderWidth: 1,
                    barThickness: 18
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                    y: { ticks: { autoSkip: false, color: colors.text }, grid: { display: false } }
                }
            }
        });
    }

    window.toggleRegionChart = function () {
        regionChartExpanded = !regionChartExpanded;
        renderRegionChart();
    };

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    // Lazy-load: trigger when statistics tab is shown
    document.addEventListener('DOMContentLoaded', function () {
        var statsTab = document.getElementById('statistics-tab');
        if (statsTab) {
            statsTab.addEventListener('shown.bs.tab', function () {
                loadStatistics(false);
            });
        }
    });
})();
</script>
