        destroyChart(canvasId);
        if (!data.length) {
            canvas.parentElement.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 text-muted">Inga data ännu</div>';
            return;
        }
        chartInstances[canvasId] = new Chart(canvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: data.map(function (x) { return x.label; }),
                datasets: [{
                    data: data.map(function (x) { return x.count; }),
                    backgroundColor: data.map(function (x, i) { return chartPalette[i % chartPalette.length]; })
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'right', labels: { color: colors.text } } }
            }
        });
    }

