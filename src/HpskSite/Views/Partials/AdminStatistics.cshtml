    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    function loadVisitorStats(force) {
        const url = '/umbraco/surface/AdminStatistics/GetVisitorStats?force=' + (force ? 'true' : 'false');
        fetch(url)
            .then(r => r.json())
            .then(resp => {
                if (!resp.success) {
                    console.warn('Visitor stats unavailable:', resp.message);
                    return;
                }
                renderVisitorStats(resp.daily || [], resp.weekly || []);
                renderFeatureUsage(resp.featureUsage || []);
            })
            .catch(err => {
                console.warn('Visitor stats fetch failed:', err);
            });
    }

    // Known feature buckets — kept in sync with the CASE in AdminStatisticsController.GetVisitorStats.
    // We render every one (filling 0 for any the server didn't return) so "this feature gets no
    // traffic" is shown explicitly rather than silently dropping out.
    const FEATURE_ORDER = ['Utbildning', 'Styrelse', 'Fältkonfig', 'Siktbild', 'Skjutbanor', 'Skyttetrappan', 'Träningsmatch', 'Tävlingar', 'Märken', 'Live-resultat'];

    function renderFeatureUsage(featureUsage) {
        const colors = getColors();
        const wrapper = document.getElementById('featureUsageWrapper');
        const empty = document.getElementById('featureUsageEmpty');
        if (!wrapper) return;

        const byName = {};
        featureUsage.forEach(f => { byName[f.feature] = f; });
        // Merge zeros for missing buckets, then sort by sessions desc.
        const rows = FEATURE_ORDER
            .map(name => ({ feature: name, sessions: (byName[name] ? byName[name].sessions : 0), pageViews: (byName[name] ? byName[name].pageViews : 0) }))
            .sort((a, b) => b.sessions - a.sessions);

        const anyData = rows.some(r => r.sessions > 0);
        if (empty) empty.style.display = anyData ? 'none' : '';

        wrapper.style.height = Math.max(220, rows.length * 32) + 'px';

        destroyChart('chartFeatureUsage');
        const ctx = document.getElementById('chartFeatureUsage').getContext('2d');
        chartInstances['chartFeatureUsage'] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: rows.map(r => r.feature),
                datasets: [{
                    label: 'Unika sessioner (30d)',
                    data: rows.map(r => r.sessions),
                    backgroundColor: colors.primary + 'cc',
                    borderColor: colors.primary,
                    borderWidth: 1,
                    barThickness: 18
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            afterBody: function (items) {
                                const idx = items[0].dataIndex;
                                return 'Sidvisningar: ' + rows[idx].pageViews;
                            }
                        }
                    }
                },
                scales: {
                    x: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                    y: { ticks: { autoSkip: false, color: colors.text }, grid: { display: false } }
                }
            }
        });
    }

    function renderVisitorStats(daily, weekly) {
        const colors = getColors();

        // Daily — last 30 days, label every 5th day (so the axis stays readable on narrow screens)
        const dailyLabels = daily.map(function (x, i) {
            return (i % 5 === 0 || i === daily.length - 1) ? formatShortDate(x.date) : '';
        });

        destroyChart('chartVisitorsDaily');
        const dailyCtx = document.getElementById('chartVisitorsDaily').getContext('2d');
        chartInstances['chartVisitorsDaily'] = new Chart(dailyCtx, {
            type: 'bar',
            data: {
                labels: dailyLabels,
                datasets: [{
                    label: 'Unika besökare',
                    data: daily.map(x => x.visitors),
                    backgroundColor: colors.primary + 'cc',
                    borderColor: colors.primary,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: function (items) {
                                const idx = items[0].dataIndex;
                                return formatLongDate(daily[idx].date);
                            },
                            afterBody: function (items) {
                                const idx = items[0].dataIndex;
                                return 'Sidvisningar: ' + daily[idx].pageViews;
                            }
                        }
                    }
                },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                    x: { ticks: { color: colors.text, autoSkip: false, maxRotation: 0 }, grid: { display: false } }
                }
            }
        });

        // Weekly — last 53 weeks, label every 4th week
        const weeklyLabels = weekly.map(function (x, i) {
            return (i % 4 === 0 || i === weekly.length - 1) ? formatShortDate(x.weekStart) : '';
        });

        destroyChart('chartVisitorsWeekly');
        const weeklyCtx = document.getElementById('chartVisitorsWeekly').getContext('2d');
        chartInstances['chartVisitorsWeekly'] = new Chart(weeklyCtx, {
            type: 'bar',
            data: {
                labels: weeklyLabels,
                datasets: [{
                    label: 'Unika besökare',
                    data: weekly.map(x => x.visitors),
                    backgroundColor: colors.success + 'cc',
                    borderColor: colors.success,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: function (items) {
                                const idx = items[0].dataIndex;
                                return 'Vecka som börjar ' + formatLongDate(weekly[idx].weekStart);
                            },
                            afterBody: function (items) {
                                const idx = items[0].dataIndex;
                                return 'Sidvisningar: ' + weekly[idx].pageViews;
                            }
                        }
                    }
                },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                    x: { ticks: { color: colors.text, autoSkip: false, maxRotation: 0 }, grid: { display: false } }
                }
            }
        });
    }

    function formatShortDate(iso) {
        // "2026-04-29" -> "29/4"
        if (!iso) return '';
        const parts = iso.split('-');
        if (parts.length !== 3) return iso;
        return parseInt(parts[2], 10) + '/' + parseInt(parts[1], 10);
    }

    function formatLongDate(iso) {
        if (!iso) return '';
        const d = new Date(iso + 'T00:00:00');
        return d.toLocaleDateString('sv-SE', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
    }

    // Lazy-load: trigger when statistics tab is shown
    document.addEventListener('DOMContentLoaded', function () {
        var statsTab = document.getElementById('statistics-tab');
        if (statsTab) {
            statsTab.addEventListener('shown.bs.tab', function () {
                loadStatistics(false);
            });
        }
    });
})();
</script>
