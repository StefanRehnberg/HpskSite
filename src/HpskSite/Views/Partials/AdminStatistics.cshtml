@* Admin Statistics Tab - Site admin only *@

<div id="statisticsContainer">
    <!-- Refresh button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-graph-up me-2"></i>Statistik</h3>
        <button class="btn btn-outline-primary btn-sm" id="refreshStatsBtn" onclick="loadStatistics(true)">
            <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
        </button>
    </div>

    <!-- Loading spinner -->
    <div id="statsLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Laddar...</span>
        </div>
        <p class="text-muted mt-2">Laddar statistik...</p>
    </div>

    <!-- Error alert -->
    <div id="statsError" class="alert alert-danger d-none" role="alert">
        <strong>Fel:</strong> <span id="statsErrorMessage"></span>
    </div>

    <!-- Content (hidden until loaded) -->
    <div id="statsContent" style="display: none;">

        <!-- Section A: Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-primary">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Medlemmar
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Totalt antal godkända medlemmar. Nya = registrerade senaste 30 dagarna."></i>
                        </h6>
                        <h2 class="card-title mb-1" id="statTotalMembers">—</h2>
                        <small class="text-success" id="statNewMembersMonth"></small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-success">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Klubbar
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Med medlemmar = minst 1 registrerad medlem. Aktiva = har dessutom ett event eller en arrangerad tävling inom senaste 3 månaderna eller framåt."></i>
                        </h6>
                        <h4 class="card-title mb-1" id="statClubsWithMembers">—</h4>
                        <small class="d-block" id="statClubsActive"></small>
                        <small class="d-block text-muted" id="statClubsTotal"></small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-info">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Tävlingar i år
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Antal tävlingar med tävlingsdatum under innevarande kalenderår."></i>
                        </h6>
                        <h2 class="card-title mb-1" id="statCompetitions">—</h2>
                        <small class="text-muted" id="statDisciplineCount"></small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-warning">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Träningsmatcher
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Totalt antal träningsmatcher. Siffran under visar de senaste 30 dagarna."></i>
                        </h6>
                        <h2 class="card-title mb-1" id="statTrainingMatchesTotal">—</h2>
                        <small class="text-success" id="statTrainingMatches30dBadge"></small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section A2: Besökarstatistik -->
        <h5 class="mt-4 mb-3"><i class="bi bi-people-fill me-2"></i>Besökarstatistik</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Unika besökare per dag (30d)
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Antal unika sessioner som besökte minst två sidor inom samma dag. En session är 30 minuters inaktivitet. En-sidiga sessioner (oftast botar och scrapers utan cookies) räknas inte."></i>
                        </h6>
                        <div style="position:relative;height:240px"><canvas id="chartVisitorsDaily"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Unika besökare per vecka (53w)
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Antal unika sessioner per kalendervecka (måndag–söndag) som besökte minst två sidor. En session räknas i den vecka den startade. En-sidiga sessioner (botar/scrapers) är filtrerade."></i>
                        </h6>
                        <div style="position:relative;height:240px"><canvas id="chartVisitorsWeekly"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section A3: Funktionsanvändning (feature popularity) -->
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Funktionsanvändning (30d)
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Hur många unika sessioner som besökt varje funktionsområde de senaste 30 dagarna, härlett från sidvisningar. Inloggningsskyddade ytor (Styrelse, Fältkonfig) räknar verkliga användare. Samma filtrering som besökarstatistiken: en-sidiga sessioner (botar/scrapers) räknas inte, så funktioner man når via en enda djuplänk kan underskattas. 0 = ingen trafik under perioden."></i>
                        </h6>
                        <div id="featureUsageWrapper" style="position:relative;height:360px"><canvas id="chartFeatureUsage"></canvas></div>
                        <p class="text-muted small mb-0 mt-2" id="featureUsageEmpty" style="display:none;">Ingen besöksdata ännu.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section B: Medlemsstatistik -->
        <h5 class="mt-4 mb-3"><i class="bi bi-people me-2"></i>Medlemsstatistik</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Nya medlemmar per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartNewMembers"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="card-title mb-0">Medlemmar per krets</h6>
                            <button class="btn btn-sm btn-link p-0 text-muted d-none" id="regionChartToggle" onclick="toggleRegionChart()">
                                <i class="bi bi-arrows-expand" id="regionToggleIcon"></i>
                            </button>
                        </div>
                        <div style="position:relative;height:220px;overflow:hidden;transition:height 0.3s ease" id="regionChartWrapper">
                            <canvas id="chartMembersByRegion"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section C: Tävlingsstatistik -->
        <h5 class="mt-4 mb-3"><i class="bi bi-trophy me-2"></i>Tävlingsstatistik</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Tävlingar per disciplin</h6>
                        <div style="position:relative;height:220px"><canvas id="chartCompetitionsByDiscipline"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Största tävlingar</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tävling</th>
                                        <th>Disciplin</th>
                                        <th class="text-end">Anmälda</th>
                                    </tr>
                                </thead>
                                <tbody id="topCompetitionsBody">
                                    <tr><td colspan="3" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section C2: Klubbaktiviteter -->
        <h5 class="mt-4 mb-3"><i class="bi bi-calendar-event me-2"></i>Klubbaktiviteter</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-sm-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <small class="text-muted">
                            Events i år
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Totalt antal klubbevent med eventdatum under respektive kalenderår."></i>
                        </small>
                        <h3 class="mb-1" id="statClubEventsYear">—</h3>
                        <small class="text-success d-block" id="statClubEvents30d"></small>
                        <hr class="my-2">
                        <div class="d-flex justify-content-around text-muted small">
                            <div><span id="statClubEventsLastYear">—</span><br><span class="text-muted" id="labelLastYear"></span></div>
                            <div><span id="statClubEventsYearBefore">—</span><br><span class="text-muted" id="labelYearBefore"></span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Events per typ</h6>
                        <div style="position:relative;height:140px"><canvas id="chartClubEventsByType"></canvas></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Events per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartClubEventsPerMonth"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Mest aktiva klubbar (30d)
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Klubbar med flest medlemmar som varit aktiva (webb eller mobilapp) senaste 30 dagarna."></i>
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Klubb</th>
                                        <th class="text-end">Aktiva</th>
                                    </tr>
                                </thead>
                                <tbody id="topClubsByActiveMembersBody">
                                    <tr><td colspan="2" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-sm btn-link p-0 mt-2 d-none" id="topClubsByActiveMembersToggle" onclick="toggleTopActiveClubs()">
                            Visa fler
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Mest events</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Klubb</th>
                                        <th class="text-end">Events</th>
                                    </tr>
                                </thead>
                                <tbody id="topClubsByEventsBody">
                                    <tr><td colspan="2" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-sm btn-link p-0 mt-2 d-none" id="topClubsByEventsToggle" onclick="toggleTopClubsByEvents()">
                            Visa fler
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Flest medlemmar</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Klubb</th>
                                        <th class="text-end">Medlemmar</th>
                                    </tr>
                                </thead>
                                <tbody id="topClubsByMembersBody">
                                    <tr><td colspan="2" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <button type="button" class="btn btn-sm btn-link p-0 mt-2 d-none" id="topClubsByMembersToggle" onclick="toggleTopClubsByMembers()">
                            Visa fler
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section D: Träningsmatcher -->
        <h5 class="mt-4 mb-3"><i class="bi bi-controller me-2"></i>Träningsmatcher</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Träningsmatcher per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartTrainingMatches"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Matcher senaste 30d</small>
                            <h3 class="mb-0" id="statMatchCount30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Unika deltagare (30d)</small>
                            <h3 class="mb-0" id="statParticipants30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Klubbar representerade (30d)</small>
                            <h3 class="mb-0" id="statMatchClubs30d">—</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section E: Skyttetrappan -->
        <h5 class="mt-4 mb-3"><i class="bi bi-ladder me-2"></i>Skyttetrappan</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Medlemmar per nivå</h6>
                        <div style="position:relative;height:220px"><canvas id="chartTrainingStairsLevels"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva elever</small>
                            <h3 class="mb-0" id="statActiveTrainees">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Steg godkända (30d)</small>
                            <h3 class="mb-0" id="statStepsCompleted30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva träningsgrupper</small>
                            <h3 class="mb-0" id="statActiveGroups">—</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section F3: Märken — validerade serier -->
        <h5 class="mt-4 mb-3"><i class="bi bi-patch-check me-2"></i>Märken — validerade serier</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100"><div class="card-body text-center">
                    <h6 class="card-title">Guldserier</h6>
                    <h3 class="mb-0" id="statGuldserierTotal">—</h3>
                    <small class="text-muted"><span id="statGuldserierYear">—</span> i år</small>
                </div></div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100"><div class="card-body text-center">
                    <h6 class="card-title">Snabbserier</h6>
                    <h3 class="mb-0" id="statSnabbserierTotal">—</h3>
                    <small class="text-muted"><span id="statSnabbserierYear">—</span> i år</small>
                </div></div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100"><div class="card-body text-center">
                    <h6 class="card-title">Luftpistolserier</h6>
                    <h3 class="mb-0" id="statLuftpistolserierTotal">—</h3>
                    <small class="text-muted"><span id="statLuftpistolserierYear">—</span> i år</small>
                </div></div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100"><div class="card-body">
                    <h6 class="card-title">Snabbserier per typ</h6>
                    <div id="snabbserierByTypeList" class="small">—</div>
                </div></div>
            </div>
        </div>

        <!-- Section F: Aktivitet & Engagemang -->
        <h5 class="mt-4 mb-3"><i class="bi bi-activity me-2"></i>Aktivitet & Engagemang</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Träningsresultat
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Självregistrerade träningsresultat under innevarande kalenderår."></i>
                        </h6>
                        <div class="mb-3 text-center">
                            <h3 class="mb-0" id="statTrainingScoresTotal">—</h3>
                            <small class="text-muted">resultat i år</small>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <h6 class="small text-muted mb-1">Per vapengrupp</h6>
                                <div id="trainingByWeaponList" class="small">—</div>
                            </div>
                            <div class="col-6">
                                <h6 class="small text-muted mb-1">Per disciplin</h6>
                                <div id="trainingByDisciplineList" class="small">—</div>
                            </div>
                        </div>
                        <hr class="my-2">
                        <div class="text-center">
                            <small class="text-muted">Unika tränande (30d)</small>
                            <h4 class="mb-0" id="statUniqueTrainers30d">—</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Träningsresultat per månad</h6>
                        <div style="position:relative;height:280px"><canvas id="chartTrainingScores"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">
                                Webb (30d)
                                <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Medlemmar som besökt webbplatsen senaste 30 dagarna."></i>
                            </small>
                            <h3 class="mb-0" id="statWebActive30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">
                                Mobilapp (30d)
                                <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Medlemmar som använt mobilappen senaste 30 dagarna."></i>
                            </small>
                            <h3 class="mb-0" id="statMobileActive30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Båda (30d)</small>
                            <h3 class="mb-0" id="statBothActive30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">
                                Unika mobil-inloggningar (30d)
                                <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Unika medlemmar som loggat in via mobilappen (JWT-token) senaste 30 dagarna."></i>
                            </small>
                            <h3 class="mb-0" id="statUniqueLogins30d">—</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Medlemsengagemang
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Aktiv: senaste 30d. Tillfällig: 31-90d. Sällan: 91-365d. Vilande: >365d eller aldrig."></i>
                        </h6>
                        <div style="position:relative;height:240px"><canvas id="chartEngagementFunnel"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Mobilapp-installationer</h6>
                        <div style="position:relative;height:240px"><canvas id="chartDevicePlatforms"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section G: Diskutrymme -->
        <h5 class="mt-4 mb-3"><i class="bi bi-hdd me-2"></i>Diskutrymme</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Total användning</h6>
                        <div class="text-center py-3">
                            <h3 class="mb-1"><span id="statDiskUsed">—</span> / <span id="statDiskTotal">—</span> MB</h3>
                            <div class="progress mt-2" style="height: 20px;">
                                <div class="progress-bar" id="diskProgressBar" role="progressbar" style="width: 0%">0%</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Användning per klubb/krets</h6>
                        <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light" style="position: sticky; top: 0;">
                                    <tr>
