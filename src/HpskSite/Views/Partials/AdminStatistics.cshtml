    function renderStyrelseOwners() {
        const all = window._styrelseOwners || [];
        const body = document.getElementById('styrelseOwnersBody');
        const toggle = document.getElementById('styrelseOwnersToggle');
        if (!body) return;

        if (!all.length) {
            body.innerHTML = '<tr><td colspan="6" class="text-center text-muted">Inga styrelser har använt verktyget ännu</td></tr>';
            if (toggle) toggle.classList.add('d-none');
            return;
        }

        if (toggle) {
            if (all.length > STYRELSE_OWNERS_COLLAPSED) {
                toggle.classList.remove('d-none');
                toggle.textContent = styrelseOwnersExpanded ? 'Visa färre' : ('Visa alla (' + all.length + ')');
            } else {
                toggle.classList.add('d-none');
            }
        }

        const rows = styrelseOwnersExpanded ? all : all.slice(0, STYRELSE_OWNERS_COLLAPSED);
        body.innerHTML = rows.map(function (o) {
            return '<tr>' +
                '<td>' + escapeHtml(o.name) + '</td>' +
                '<td><span class="badge ' + (o.type === 'Krets' ? 'bg-primary' : 'bg-secondary') + '">' + o.type + '</span></td>' +
                '<td class="text-end">' + o.meetingsThisYear + '</td>' +
                '<td class="text-end">' + o.meetings + '</td>' +
                '<td class="text-end">' + (o.openActions > 0 ? '<span class="text-warning fw-semibold">' + o.openActions + '</span>' : '0') + '</td>' +
                '<td class="text-end"><small class="text-muted">' + (o.lastActivity || '') + '</small></td>' +
                '</tr>';
        }).join('');
    }

