<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
(function () {
    let statsLoaded = false;
    let chartInstances = {};
    let lastStatsData = null;
    // Top-clubs card expand-state. Each card shows top 5 by default with a "Visa fler"
    // toggle that expands to the controller's full take (currently 25). Cache holds the
    // last loaded list per card so the toggle re-renders without a refetch.
    const topClubCards = {
        active:  { cacheKey: 'topClubsByActiveMembers', bodyId: 'topClubsByActiveMembersBody', toggleId: 'topClubsByActiveMembersToggle', cache: [], expanded: false, emptyText: 'Inga aktiva klubbar' },
        events:  { cacheKey: 'topClubs',                bodyId: 'topClubsByEventsBody',         toggleId: 'topClubsByEventsToggle',         cache: [], expanded: false, emptyText: 'Inga events att visa' },
        members: { cacheKey: 'topClubsByMembers',       bodyId: 'topClubsByMembersBody',        toggleId: 'topClubsByMembersToggle',        cache: [], expanded: false, emptyText: 'Inga klubbar att visa' }
    };

    // Theme-aware colors
    function getColors() {
        const style = getComputedStyle(document.documentElement);
        return {
            primary: style.getPropertyValue('--chart-primary').trim() || '#0d6efd',
            success: style.getPropertyValue('--chart-success').trim() || '#198754',
            danger: style.getPropertyValue('--chart-danger').trim() || '#dc3545',
            warning: '#ffc107',
            info: '#0dcaf0',
            text: style.getPropertyValue('--chart-text').trim() || '#212529',
            grid: style.getPropertyValue('--chart-grid').trim() || 'rgba(0, 0, 0, 0.1)',
            muted: style.getPropertyValue('--bs-secondary-color') || '#6c757d'
        };
    }

    // Broad palette so every discipline gets a distinct color
    const chartPalette = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#0dcaf0', '#6c757d'];

    function getDisciplineColor(discipline, index) {
        const known = { 'Precision': 0, 'Duell': 1, 'Milsnabb': 2, 'Springskytte': 3 };
        if (discipline in known) return chartPalette[known[discipline]];
        return chartPalette[index % chartPalette.length];
    }

    let regionChartExpanded = false;
    let styrelseOwnersExpanded = false;

    function destroyChart(id) {
        if (chartInstances[id]) {
            chartInstances[id].destroy();
            chartInstances[id] = null;
        }
    }

    function formatMonth(monthStr) {
        const [y, m] = monthStr.split('-');
        const months = ['jan', 'feb', 'mar', 'apr', 'maj', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
        return months[parseInt(m) - 1] + ' ' + y.slice(2);
    }

    window.loadStatistics = function (force) {
        if (statsLoaded && !force) return;

        const loading = document.getElementById('statsLoading');
        const content = document.getElementById('statsContent');
        const error = document.getElementById('statsError');
        const btn = document.getElementById('refreshStatsBtn');

        loading.style.display = '';
        content.style.display = 'none';
        error.classList.add('d-none');
        if (btn) btn.disabled = true;

        const url = '/umbraco/surface/AdminStatistics/GetStatistics?force=' + (force ? 'true' : 'false');

        fetch(url)
            .then(r => r.json())
            .then(resp => {
                loading.style.display = 'none';
                if (btn) btn.disabled = false;

                if (!resp.success) {
                    error.classList.remove('d-none');
                    document.getElementById('statsErrorMessage').textContent = resp.message || 'Okänt fel';
                    return;
                }

                statsLoaded = true;
                lastStatsData = resp.data;
                content.style.display = '';
                renderStatistics(resp.data);
                loadVisitorStats(force);
            })
            .catch(err => {
                loading.style.display = 'none';
                if (btn) btn.disabled = false;
                error.classList.remove('d-none');
                document.getElementById('statsErrorMessage').textContent = err.message || 'Nätverksfel';
            });
    };

    function renderStatistics(d) {
        const colors = getColors();

        // Section A: Summary cards
        document.getElementById('statTotalMembers').textContent = d.totalMembers;
        document.getElementById('statNewMembersMonth').textContent = d.newMembers30d > 0
            ? '+' + d.newMembers30d + ' senaste 30d' : '';
        document.getElementById('statClubsWithMembers').textContent = d.clubsWithMembers + ' har medlemmar';
        document.getElementById('statClubsActive').textContent = 'varav ' + d.activeClubs + ' aktiva';
        document.getElementById('statClubsTotal').textContent = 'av totalt ' + d.totalClubs;
        document.getElementById('statCompetitions').textContent = d.competitionsThisYear;
        var discCount = d.competitionsByDiscipline ? d.competitionsByDiscipline.length : 0;
        document.getElementById('statDisciplineCount').textContent = discCount > 0 ? discCount + ' discipliner' : '';
        document.getElementById('statTrainingMatchesTotal').textContent = d.trainingMatchesTotal;
        document.getElementById('statTrainingMatches30dBadge').textContent = d.trainingMatches30d > 0
            ? '+' + d.trainingMatches30d + ' senaste 30d' : '';

        // Section B: New members per month (bar chart)
        if (d.newMembersPerMonth && d.newMembersPerMonth.length) {
            destroyChart('chartNewMembers');
            const ctx = document.getElementById('chartNewMembers').getContext('2d');
            chartInstances['chartNewMembers'] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: d.newMembersPerMonth.map(x => formatMonth(x.month)),
                    datasets: [{
                        label: 'Nya medlemmar',
                        data: d.newMembersPerMonth.map(x => x.count),
                        backgroundColor: colors.primary + 'cc',
                        borderColor: colors.primary,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        x: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section B: Members by region (horizontal bar)
        // Store full data for expand/collapse re-render
        window._regionData = d.membersByRegion;
        renderRegionChart(colors);

        // Section C: Competitions by discipline (doughnut)
        if (d.competitionsByDiscipline && d.competitionsByDiscipline.length) {
            destroyChart('chartCompetitionsByDiscipline');
            const ctx = document.getElementById('chartCompetitionsByDiscipline').getContext('2d');
            const bgColors = d.competitionsByDiscipline.map((x, i) => getDisciplineColor(x.discipline, i));
            chartInstances['chartCompetitionsByDiscipline'] = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: d.competitionsByDiscipline.map(x => x.discipline + ' (' + x.count + ')'),
                    datasets: [{
                        data: d.competitionsByDiscipline.map(x => x.count),
                        backgroundColor: bgColors,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: colors.text,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 12
                            }
                        }
                    }
                }
            });
        }

        // Section C: Top competitions table
        var tbody = document.getElementById('topCompetitionsBody');
        if (d.topCompetitions && d.topCompetitions.length) {
            tbody.innerHTML = d.topCompetitions.map((c, i) =>
                '<tr><td>' + escapeHtml(c.name) + '</td>' +
                '<td><span class="badge" style="background-color:' + getDisciplineColor(c.discipline, i) + '">' + escapeHtml(c.discipline) + '</span></td>' +
                '<td class="text-end">' + c.registrations + '</td></tr>'
            ).join('');
        } else {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">Inga tävlingar att visa</td></tr>';
        }

        // Section C2: Club activities
        if (d.clubActivities) {
            document.getElementById('statClubEventsYear').textContent = d.clubActivities.eventsThisYear;
            document.getElementById('statClubEvents30d').textContent = d.clubActivities.events30d > 0
                ? '+' + d.clubActivities.events30d + ' senaste 30d' : '';
            var thisYear = new Date().getFullYear();
            document.getElementById('statClubEventsLastYear').textContent = d.clubActivities.eventsLastYear;
            document.getElementById('labelLastYear').textContent = thisYear - 1;
            document.getElementById('statClubEventsYearBefore').textContent = d.clubActivities.eventsYearBefore;
            document.getElementById('labelYearBefore').textContent = thisYear - 2;

            // Events by type (doughnut)
            if (d.clubActivities.byType && d.clubActivities.byType.length) {
                var eventTypePalette = { 'Tävling': '#dc3545', 'Träning': '#198754', 'Städning': '#ffc107', 'Möte': '#0d6efd', 'Socialt': '#6f42c1', 'Annat': '#6c757d' };
                destroyChart('chartClubEventsByType');
                var ctx = document.getElementById('chartClubEventsByType').getContext('2d');
                var etColors = d.clubActivities.byType.map(function (x, i) { return eventTypePalette[x.type] || chartPalette[i % chartPalette.length]; });
                chartInstances['chartClubEventsByType'] = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: d.clubActivities.byType.map(function (x) { return x.type + ' (' + x.count + ')'; }),
                        datasets: [{ data: d.clubActivities.byType.map(function (x) { return x.count; }), backgroundColor: etColors, borderWidth: 2 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'right', labels: { color: colors.text, usePointStyle: true, pointStyle: 'circle', padding: 8, font: { size: 11 } } } }
                    }
                });
            }

            // Events per month (bar chart)
            if (d.clubActivities.perMonth && d.clubActivities.perMonth.length) {
                destroyChart('chartClubEventsPerMonth');
                var ctx = document.getElementById('chartClubEventsPerMonth').getContext('2d');
                chartInstances['chartClubEventsPerMonth'] = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: d.clubActivities.perMonth.map(function (x) { return formatMonth(x.month); }),
                        datasets: [{ label: 'Events', data: d.clubActivities.perMonth.map(function (x) { return x.count; }), backgroundColor: colors.success + 'cc', borderColor: colors.success, borderWidth: 1 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                            x: { ticks: { color: colors.text }, grid: { display: false } }
                        }
                    }
                });
            }

            // Top-club cards: cache the full list per card and render the default top-5
            // view. Clicking the per-card "Visa fler" toggle re-renders without refetching.
            topClubCards.events.cache  = d.clubActivities[topClubCards.events.cacheKey]  || [];
            topClubCards.members.cache = d.clubActivities[topClubCards.members.cacheKey] || [];
            topClubCards.active.cache  = d.clubActivities[topClubCards.active.cacheKey]  || [];
            topClubCards.events.expanded  = false;
            topClubCards.members.expanded = false;
            topClubCards.active.expanded  = false;
            renderTopClubsCard('events');
            renderTopClubsCard('members');
            renderTopClubsCard('active');
        }

        function renderTopClubsCard(cardKey) {
            var card = topClubCards[cardKey];
            if (!card) return;
            var body = document.getElementById(card.bodyId);
            var toggle = document.getElementById(card.toggleId);
            if (!body) return;

            if (!card.cache || card.cache.length === 0) {
                body.innerHTML = '<tr><td colspan="2" class="text-center text-muted">' + escapeHtml(card.emptyText) + '</td></tr>';
                if (toggle) toggle.classList.add('d-none');
                return;
            }

            var visible = card.expanded ? card.cache : card.cache.slice(0, 5);
            body.innerHTML = visible.map(function (c) {
                // Club name is a link to the club's published page when the URL is known;
                // fall back to plain text for legacy entries that lack one.
                var label = c.url
