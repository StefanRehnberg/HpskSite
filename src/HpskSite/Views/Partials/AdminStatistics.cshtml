@* Admin Statistics Tab - Site admin only *@

<div id="statisticsContainer">
    <!-- Refresh button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-graph-up me-2"></i>Statistik</h3>
        <button class="btn btn-outline-primary btn-sm" id="refreshStatsBtn" onclick="loadStatistics(true)">
            <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
        </button>
    </div>

    <!-- Loading spinner -->
    <div id="statsLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Laddar...</span>
        </div>
        <p class="text-muted mt-2">Laddar statistik...</p>
    </div>

    <!-- Error alert -->
    <div id="statsError" class="alert alert-danger d-none" role="alert">
        <strong>Fel:</strong> <span id="statsErrorMessage"></span>
    </div>

    <!-- Content (hidden until loaded) -->
    <div id="statsContent" style="display: none;">

        <!-- Section A: Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-primary">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Medlemmar
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Totalt antal godkända medlemmar. Nya = registrerade denna kalendermånad."></i>
                        </h6>
                        <h2 class="card-title mb-1" id="statTotalMembers">—</h2>
                        <small class="text-success" id="statNewMembersMonth"></small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-success">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Klubbar
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Aktiva = klubbar med minst 1 medlem OCH ett event inom senaste 3 månaderna eller framåt. Nya = klubbar vars första medlem registrerades inom 30 dagar."></i>
                        </h6>
                        <h2 class="card-title mb-1" id="statClubs">—</h2>
                        <small class="text-success" id="statNewClubs"></small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-info">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Tävlingar i år
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Antal tävlingar med tävlingsdatum under innevarande kalenderår."></i>
                        </h6>
                        <h2 class="card-title mb-1" id="statCompetitions">—</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="card h-100 border-warning">
                    <div class="card-body text-center">
                        <h6 class="card-subtitle mb-2 text-muted">
                            Träningsmatcher
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Totalt antal träningsmatcher. Siffran under visar de senaste 30 dagarna."></i>
                        </h6>
                        <h2 class="card-title mb-1" id="statTrainingMatchesTotal">—</h2>
                        <small class="text-success" id="statTrainingMatches30dBadge"></small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section B: Medlemsstatistik -->
        <h5 class="mt-4 mb-3"><i class="bi bi-people me-2"></i>Medlemsstatistik</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Nya medlemmar per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartNewMembers"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="card-title mb-0">Medlemmar per krets</h6>
                            <button class="btn btn-sm btn-link p-0 text-muted d-none" id="regionChartToggle" onclick="toggleRegionChart()">
                                <i class="bi bi-arrows-expand" id="regionToggleIcon"></i>
                            </button>
                        </div>
                        <div style="position:relative;height:220px;overflow:hidden;transition:height 0.3s ease" id="regionChartWrapper">
                            <canvas id="chartMembersByRegion"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section C: Tävlingsstatistik -->
        <h5 class="mt-4 mb-3"><i class="bi bi-trophy me-2"></i>Tävlingsstatistik</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Tävlingar per disciplin</h6>
                        <div style="position:relative;height:220px"><canvas id="chartCompetitionsByDiscipline"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Största tävlingar</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tävling</th>
                                        <th>Disciplin</th>
                                        <th class="text-end">Anmälda</th>
                                    </tr>
                                </thead>
                                <tbody id="topCompetitionsBody">
                                    <tr><td colspan="3" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section C2: Klubbaktiviteter -->
        <h5 class="mt-4 mb-3"><i class="bi bi-calendar-event me-2"></i>Klubbaktiviteter</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-sm-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <small class="text-muted">
                            Events i år
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Totalt antal klubbevent med eventdatum under respektive kalenderår."></i>
                        </small>
                        <h3 class="mb-1" id="statClubEventsYear">—</h3>
                        <small class="text-success d-block" id="statClubEvents30d"></small>
                        <hr class="my-2">
                        <div class="d-flex justify-content-around text-muted small">
                            <div><span id="statClubEventsLastYear">—</span><br><span class="text-muted" id="labelLastYear"></span></div>
                            <div><span id="statClubEventsYearBefore">—</span><br><span class="text-muted" id="labelYearBefore"></span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Events per typ</h6>
                        <div style="position:relative;height:200px"><canvas id="chartClubEventsByType"></canvas></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Events per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartClubEventsPerMonth"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Mest aktiva klubbar</h6>
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Klubb</th>
                                        <th class="text-end">Events</th>
                                    </tr>
                                </thead>
                                <tbody id="topClubsByEventsBody">
                                    <tr><td colspan="2" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section D: Träningsmatcher -->
        <h5 class="mt-4 mb-3"><i class="bi bi-controller me-2"></i>Träningsmatcher</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Träningsmatcher per månad</h6>
                        <div style="position:relative;height:220px"><canvas id="chartTrainingMatches"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Matcher senaste 30d</small>
                            <h3 class="mb-0" id="statMatchCount30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Unika deltagare (30d)</small>
                            <h3 class="mb-0" id="statParticipants30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Klubbar representerade (30d)</small>
                            <h3 class="mb-0" id="statMatchClubs30d">—</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section E: Skyttetrappan -->
        <h5 class="mt-4 mb-3"><i class="bi bi-ladder me-2"></i>Skyttetrappan</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Medlemmar per nivå</h6>
                        <div style="position:relative;height:220px"><canvas id="chartTrainingStairsLevels"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva elever</small>
                            <h3 class="mb-0" id="statActiveTrainees">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Steg godkända (30d)</small>
                            <h3 class="mb-0" id="statStepsCompleted30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Aktiva träningsgrupper</small>
                            <h3 class="mb-0" id="statActiveGroups">—</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section F: Aktivitet & Engagemang -->
        <h5 class="mt-4 mb-3"><i class="bi bi-activity me-2"></i>Aktivitet & Engagemang</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Träningsresultat
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Självregistrerade träningsresultat under innevarande kalenderår."></i>
                        </h6>
                        <div class="mb-3 text-center">
                            <h3 class="mb-0" id="statTrainingScoresTotal">—</h3>
                            <small class="text-muted">resultat i år</small>
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <h6 class="small text-muted mb-1">Per vapengrupp</h6>
                                <div id="trainingByWeaponList" class="small">—</div>
                            </div>
                            <div class="col-6">
                                <h6 class="small text-muted mb-1">Per disciplin</h6>
                                <div id="trainingByDisciplineList" class="small">—</div>
                            </div>
                        </div>
                        <hr class="my-2">
                        <div class="text-center">
                            <small class="text-muted">Unika tränande (30d)</small>
                            <h4 class="mb-0" id="statUniqueTrainers30d">—</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Träningsresultat per månad</h6>
                        <div style="position:relative;height:280px"><canvas id="chartTrainingScores"></canvas></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="d-flex flex-column gap-3 h-100">
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">
                                Webb (30d)
                                <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Medlemmar som besökt webbplatsen senaste 30 dagarna."></i>
                            </small>
                            <h3 class="mb-0" id="statWebActive30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">
                                Mobilapp (30d)
                                <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Medlemmar som använt mobilappen senaste 30 dagarna."></i>
                            </small>
                            <h3 class="mb-0" id="statMobileActive30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">Båda (30d)</small>
                            <h3 class="mb-0" id="statBothActive30d">—</h3>
                        </div>
                    </div>
                    <div class="card flex-fill">
                        <div class="card-body text-center py-3">
                            <small class="text-muted">
                                Unika mobil-inloggningar (30d)
                                <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="Unika medlemmar som loggat in via mobilappen (JWT-token) senaste 30 dagarna."></i>
                            </small>
                            <h3 class="mb-0" id="statUniqueLogins30d">—</h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">
                            Medlemsengagemang
                            <i class="bi bi-info-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Aktiv: senaste 30d. Tillfällig: 31-90d. Sällan: 91-365d. Vilande: >365d eller aldrig."></i>
                        </h6>
                        <div style="position:relative;height:240px"><canvas id="chartEngagementFunnel"></canvas></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Mobilapp-installationer</h6>
                        <div style="position:relative;height:240px"><canvas id="chartDevicePlatforms"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section G: Diskutrymme -->
        <h5 class="mt-4 mb-3"><i class="bi bi-hdd me-2"></i>Diskutrymme</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Total användning</h6>
                        <div class="text-center py-3">
                            <h3 class="mb-1"><span id="statDiskUsed">—</span> / <span id="statDiskTotal">—</span> MB</h3>
                            <div class="progress mt-2" style="height: 20px;">
                                <div class="progress-bar" id="diskProgressBar" role="progressbar" style="width: 0%">0%</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="card-title">Användning per klubb/krets</h6>
                        <div class="table-responsive" style="max-height: 260px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light" style="position: sticky; top: 0;">
                                    <tr>
                                        <th>Namn</th>
                                        <th>Typ</th>
                                        <th class="text-end">Använt</th>
                                        <th class="text-end">Gräns</th>
                                        <th style="width: 100px;"></th>
                                    </tr>
                                </thead>
                                <tbody id="diskStorageBody">
                                    <tr><td colspan="5" class="text-center text-muted">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<script>
(function () {
    let statsLoaded = false;
    let chartInstances = {};
    let lastStatsData = null;

    // Theme-aware colors
    function getColors() {
        const style = getComputedStyle(document.documentElement);
        return {
            primary: style.getPropertyValue('--chart-primary').trim() || '#0d6efd',
            success: style.getPropertyValue('--chart-success').trim() || '#198754',
            danger: style.getPropertyValue('--chart-danger').trim() || '#dc3545',
            warning: '#ffc107',
            info: '#0dcaf0',
            text: style.getPropertyValue('--chart-text').trim() || '#212529',
            grid: style.getPropertyValue('--chart-grid').trim() || 'rgba(0, 0, 0, 0.1)',
            muted: style.getPropertyValue('--bs-secondary-color') || '#6c757d'
        };
    }

    // Broad palette so every discipline gets a distinct color
    const chartPalette = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#fd7e14', '#20c997', '#e83e8c', '#0dcaf0', '#6c757d'];

    function getDisciplineColor(discipline, index) {
        const known = { 'Precision': 0, 'Duell': 1, 'Milsnabb': 2, 'Springskytte': 3 };
        if (discipline in known) return chartPalette[known[discipline]];
        return chartPalette[index % chartPalette.length];
    }

    let regionChartExpanded = false;

    function destroyChart(id) {
        if (chartInstances[id]) {
            chartInstances[id].destroy();
            chartInstances[id] = null;
        }
    }

    function formatMonth(monthStr) {
        const [y, m] = monthStr.split('-');
        const months = ['jan', 'feb', 'mar', 'apr', 'maj', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
        return months[parseInt(m) - 1] + ' ' + y.slice(2);
    }

    window.loadStatistics = function (force) {
        if (statsLoaded && !force) return;

        const loading = document.getElementById('statsLoading');
        const content = document.getElementById('statsContent');
        const error = document.getElementById('statsError');
        const btn = document.getElementById('refreshStatsBtn');

        loading.style.display = '';
        content.style.display = 'none';
        error.classList.add('d-none');
        if (btn) btn.disabled = true;

        const url = '/umbraco/surface/AdminStatistics/GetStatistics?force=' + (force ? 'true' : 'false');

        fetch(url)
            .then(r => r.json())
            .then(resp => {
                loading.style.display = 'none';
                if (btn) btn.disabled = false;

                if (!resp.success) {
                    error.classList.remove('d-none');
                    document.getElementById('statsErrorMessage').textContent = resp.message || 'Okänt fel';
                    return;
                }

                statsLoaded = true;
                lastStatsData = resp.data;
                content.style.display = '';
                renderStatistics(resp.data);
            })
            .catch(err => {
                loading.style.display = 'none';
                if (btn) btn.disabled = false;
                error.classList.remove('d-none');
                document.getElementById('statsErrorMessage').textContent = err.message || 'Nätverksfel';
            });
    };

    function renderStatistics(d) {
        const colors = getColors();

        // Section A: Summary cards
        document.getElementById('statTotalMembers').textContent = d.totalMembers;
        document.getElementById('statNewMembersMonth').textContent = d.newMembersThisMonth > 0
            ? '+' + d.newMembersThisMonth + ' denna månad' : '';
        document.getElementById('statClubs').textContent = d.activeClubs + ' aktiva / ' + d.totalClubs;
        document.getElementById('statNewClubs').textContent = d.newClubs30d > 0
            ? '+' + d.newClubs30d + ' nya' : '';
        document.getElementById('statCompetitions').textContent = d.competitionsThisYear;
        document.getElementById('statTrainingMatchesTotal').textContent = d.trainingMatchesTotal;
        document.getElementById('statTrainingMatches30dBadge').textContent = d.trainingMatches30d > 0
            ? '+' + d.trainingMatches30d + ' senaste 30d' : '';

        // Section B: New members per month (bar chart)
        if (d.newMembersPerMonth && d.newMembersPerMonth.length) {
            destroyChart('chartNewMembers');
            const ctx = document.getElementById('chartNewMembers').getContext('2d');
            chartInstances['chartNewMembers'] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: d.newMembersPerMonth.map(x => formatMonth(x.month)),
                    datasets: [{
                        label: 'Nya medlemmar',
                        data: d.newMembersPerMonth.map(x => x.count),
                        backgroundColor: colors.primary + 'cc',
                        borderColor: colors.primary,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        x: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section B: Members by region (horizontal bar)
        // Store full data for expand/collapse re-render
        window._regionData = d.membersByRegion;
        renderRegionChart(colors);

        // Section C: Competitions by discipline (doughnut)
        if (d.competitionsByDiscipline && d.competitionsByDiscipline.length) {
            destroyChart('chartCompetitionsByDiscipline');
            const ctx = document.getElementById('chartCompetitionsByDiscipline').getContext('2d');
            const bgColors = d.competitionsByDiscipline.map((x, i) => getDisciplineColor(x.discipline, i));
            chartInstances['chartCompetitionsByDiscipline'] = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: d.competitionsByDiscipline.map(x => x.discipline + ' (' + x.count + ')'),
                    datasets: [{
                        data: d.competitionsByDiscipline.map(x => x.count),
                        backgroundColor: bgColors,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: colors.text,
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 12
                            }
                        }
                    }
                }
            });
        }

        // Section C: Top competitions table
        var tbody = document.getElementById('topCompetitionsBody');
        if (d.topCompetitions && d.topCompetitions.length) {
            tbody.innerHTML = d.topCompetitions.map((c, i) =>
                '<tr><td>' + escapeHtml(c.name) + '</td>' +
                '<td><span class="badge" style="background-color:' + getDisciplineColor(c.discipline, i) + '">' + escapeHtml(c.discipline) + '</span></td>' +
                '<td class="text-end">' + c.registrations + '</td></tr>'
            ).join('');
        } else {
            tbody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">Inga tävlingar att visa</td></tr>';
        }

        // Section C2: Club activities
        if (d.clubActivities) {
            document.getElementById('statClubEventsYear').textContent = d.clubActivities.eventsThisYear;
            document.getElementById('statClubEvents30d').textContent = d.clubActivities.events30d > 0
                ? '+' + d.clubActivities.events30d + ' senaste 30d' : '';
            var thisYear = new Date().getFullYear();
            document.getElementById('statClubEventsLastYear').textContent = d.clubActivities.eventsLastYear;
            document.getElementById('labelLastYear').textContent = thisYear - 1;
            document.getElementById('statClubEventsYearBefore').textContent = d.clubActivities.eventsYearBefore;
            document.getElementById('labelYearBefore').textContent = thisYear - 2;

            // Events by type (doughnut)
            if (d.clubActivities.byType && d.clubActivities.byType.length) {
                var eventTypePalette = { 'Tävling': '#dc3545', 'Träning': '#198754', 'Städning': '#ffc107', 'Möte': '#0d6efd', 'Socialt': '#6f42c1', 'Annat': '#6c757d' };
                destroyChart('chartClubEventsByType');
                var ctx = document.getElementById('chartClubEventsByType').getContext('2d');
                var etColors = d.clubActivities.byType.map(function (x, i) { return eventTypePalette[x.type] || chartPalette[i % chartPalette.length]; });
                chartInstances['chartClubEventsByType'] = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: d.clubActivities.byType.map(function (x) { return x.type + ' (' + x.count + ')'; }),
                        datasets: [{ data: d.clubActivities.byType.map(function (x) { return x.count; }), backgroundColor: etColors, borderWidth: 2 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { color: colors.text, usePointStyle: true, pointStyle: 'circle', padding: 12 } } }
                    }
                });
            }

            // Events per month (bar chart)
            if (d.clubActivities.perMonth && d.clubActivities.perMonth.length) {
                destroyChart('chartClubEventsPerMonth');
                var ctx = document.getElementById('chartClubEventsPerMonth').getContext('2d');
                chartInstances['chartClubEventsPerMonth'] = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: d.clubActivities.perMonth.map(function (x) { return formatMonth(x.month); }),
                        datasets: [{ label: 'Events', data: d.clubActivities.perMonth.map(function (x) { return x.count; }), backgroundColor: colors.success + 'cc', borderColor: colors.success, borderWidth: 1 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                            x: { ticks: { color: colors.text }, grid: { display: false } }
                        }
                    }
                });
            }

            // Top clubs by events (table)
            var evtBody = document.getElementById('topClubsByEventsBody');
            if (d.clubActivities.topClubs && d.clubActivities.topClubs.length) {
                evtBody.innerHTML = d.clubActivities.topClubs.map(function (c) {
                    return '<tr><td>' + escapeHtml(c.club) + '</td><td class="text-end">' + c.count + '</td></tr>';
                }).join('');
            } else {
                evtBody.innerHTML = '<tr><td colspan="2" class="text-center text-muted">Inga events att visa</td></tr>';
            }
        }

        // Section D: Training matches per month (bar chart)
        if (d.trainingMatchesPerMonth && d.trainingMatchesPerMonth.length) {
            destroyChart('chartTrainingMatches');
            const ctx = document.getElementById('chartTrainingMatches').getContext('2d');
            chartInstances['chartTrainingMatches'] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: d.trainingMatchesPerMonth.map(x => formatMonth(x.month)),
                    datasets: [{
                        label: 'Träningsmatcher',
                        data: d.trainingMatchesPerMonth.map(x => x.count),
                        backgroundColor: colors.warning + 'cc',
                        borderColor: colors.warning,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        x: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section D: Stat cards
        document.getElementById('statMatchCount30d').textContent = d.trainingMatches30d;
        document.getElementById('statParticipants30d').textContent = d.trainingMatchParticipants30d;
        document.getElementById('statMatchClubs30d').textContent = d.trainingMatchClubs30d;

        // Section E: Training stairs levels (horizontal bar)
        if (d.trainingStairsMembersPerLevel && d.trainingStairsMembersPerLevel.length) {
            destroyChart('chartTrainingStairsLevels');
            const ctx = document.getElementById('chartTrainingStairsLevels').getContext('2d');
            chartInstances['chartTrainingStairsLevels'] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: d.trainingStairsMembersPerLevel.map(x => 'Nivå ' + x.level),
                    datasets: [{
                        label: 'Medlemmar',
                        data: d.trainingStairsMembersPerLevel.map(x => x.count),
                        backgroundColor: colors.info + 'cc',
                        borderColor: colors.info,
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        y: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section E: Stat cards
        document.getElementById('statActiveTrainees').textContent = d.trainingStairsActiveTrainees;
        document.getElementById('statStepsCompleted30d').textContent = d.trainingStairsStepsCompleted30d;
        document.getElementById('statActiveGroups').textContent = d.trainingStairsActiveGroups;

        // Section F: Training scores per month (line chart)
        if (d.trainingScoresPerMonth && d.trainingScoresPerMonth.length) {
            destroyChart('chartTrainingScores');
            const ctx = document.getElementById('chartTrainingScores').getContext('2d');
            chartInstances['chartTrainingScores'] = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: d.trainingScoresPerMonth.map(x => formatMonth(x.month)),
                    datasets: [{
                        label: 'Träningsresultat',
                        data: d.trainingScoresPerMonth.map(x => x.count),
                        borderColor: colors.primary,
                        backgroundColor: colors.primary + '33',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                        x: { ticks: { color: colors.text }, grid: { display: false } }
                    }
                }
            });
        }

        // Section F: Training score breakdowns
        document.getElementById('statTrainingScoresTotal').textContent = d.trainingScoresThisYear || 0;
        document.getElementById('statUniqueTrainers30d').textContent = d.uniqueTrainers30d || 0;

        var weaponList = document.getElementById('trainingByWeaponList');
        if (d.scoresByWeaponClass && d.scoresByWeaponClass.length) {
            weaponList.innerHTML = d.scoresByWeaponClass.map(function (x) {
                return '<div class="d-flex justify-content-between"><span>' + escapeHtml(x.weaponClass) + '</span><span class="text-muted">' + x.count + '</span></div>';
            }).join('');
        } else {
            weaponList.innerHTML = '<span class="text-muted">Inga</span>';
        }

        var discList = document.getElementById('trainingByDisciplineList');
        if (d.scoresByDiscipline && d.scoresByDiscipline.length) {
            discList.innerHTML = d.scoresByDiscipline.map(function (x) {
                return '<div class="d-flex justify-content-between"><span>' + escapeHtml(x.discipline) + '</span><span class="text-muted">' + x.count + '</span></div>';
            }).join('');
        } else {
            discList.innerHTML = '<span class="text-muted">Inga</span>';
        }

        // Section F2: Engagement
        if (d.engagement) {
            document.getElementById('statWebActive30d').textContent = d.engagement.webActive30d;
            document.getElementById('statMobileActive30d').textContent = d.engagement.mobileActive30d;
            document.getElementById('statBothActive30d').textContent = d.engagement.bothActive30d;
            document.getElementById('statUniqueLogins30d').textContent = d.engagement.uniqueLogins30d;

            // Engagement funnel (horizontal stacked bar)
            if (d.engagement.funnel) {
                var f = d.engagement.funnel;
                destroyChart('chartEngagementFunnel');
                var ctx = document.getElementById('chartEngagementFunnel').getContext('2d');
                chartInstances['chartEngagementFunnel'] = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: ['Aktiv (0-30d)', 'Tillfällig (31-90d)', 'Sällan (91-365d)', 'Vilande (>365d)'],
                        datasets: [{
                            data: [f.active, f.occasional, f.infrequent, f.dormant],
                            backgroundColor: [colors.success + 'cc', colors.primary + 'cc', colors.warning + 'cc', colors.danger + 'cc'],
                            borderColor: [colors.success, colors.primary, colors.warning, colors.danger],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        indexAxis: 'y',
                        plugins: { legend: { display: false } },
                        scales: {
                            x: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                            y: { ticks: { color: colors.text }, grid: { display: false } }
                        }
                    }
                });
            }

            // Device platforms (doughnut)
            if (d.engagement.devicesByPlatform && d.engagement.devicesByPlatform.length) {
                var platformColors = { 'Android': '#3ddc84', 'iOS': '#007aff' };
                destroyChart('chartDevicePlatforms');
                var ctx = document.getElementById('chartDevicePlatforms').getContext('2d');
                var pColors = d.engagement.devicesByPlatform.map(function (x, i) { return platformColors[x.platform] || chartPalette[i % chartPalette.length]; });
                chartInstances['chartDevicePlatforms'] = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: d.engagement.devicesByPlatform.map(function (x) { return x.platform + ' (' + x.count + ')'; }),
                        datasets: [{ data: d.engagement.devicesByPlatform.map(function (x) { return x.count; }), backgroundColor: pColors, borderWidth: 2 }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom', labels: { color: colors.text, usePointStyle: true, pointStyle: 'circle', padding: 12 } } }
                    }
                });
            } else {
                var canvas = document.getElementById('chartDevicePlatforms');
                if (canvas) canvas.parentElement.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 text-muted">Inga registrerade enheter</div>';
            }
        }

        // Section G: Disk space
        if (d.diskSpace) {
            document.getElementById('statDiskUsed').textContent = d.diskSpace.totalUsedMB;
            document.getElementById('statDiskTotal').textContent = d.diskSpace.totalDiskSpaceMB;

            var pct = d.diskSpace.totalDiskPercentage;
            var bar = document.getElementById('diskProgressBar');
            bar.style.width = pct + '%';
            bar.textContent = pct + '%';
            bar.className = 'progress-bar' + (pct > 80 ? ' bg-danger' : pct > 60 ? ' bg-warning' : ' bg-success');

            var rows = [];
            if (d.diskSpace.regionStorage) {
                d.diskSpace.regionStorage.forEach(function (r) {
                    rows.push({ name: r.name, type: 'Krets', usedMB: r.usedMB, limitMB: r.limitMB, percentage: r.percentage });
                });
            }
            if (d.diskSpace.clubStorage) {
                d.diskSpace.clubStorage.forEach(function (c) {
                    rows.push({ name: c.name, type: 'Klubb', usedMB: c.usedMB, limitMB: c.limitMB, percentage: c.percentage });
                });
            }
            rows.sort(function (a, b) { return b.usedMB - a.usedMB; });

            var tbody = document.getElementById('diskStorageBody');
            if (rows.length > 0) {
                tbody.innerHTML = rows.map(function (r) {
                    var barColor = r.percentage > 80 ? 'bg-danger' : r.percentage > 60 ? 'bg-warning' : 'bg-success';
                    return '<tr>' +
                        '<td>' + escapeHtml(r.name) + '</td>' +
                        '<td><span class="badge ' + (r.type === 'Krets' ? 'bg-primary' : 'bg-secondary') + '">' + r.type + '</span></td>' +
                        '<td class="text-end">' + r.usedMB + ' MB</td>' +
                        '<td class="text-end">' + r.limitMB + ' MB</td>' +
                        '<td><div class="progress" style="height:14px"><div class="progress-bar ' + barColor + '" style="width:' + r.percentage + '%"></div></div></td>' +
                        '</tr>';
                }).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted">Inga dokument uppladdade</td></tr>';
            }
        }

        // Initialize tooltips
        document.querySelectorAll('#statisticsContainer [data-bs-toggle="tooltip"]').forEach(function (el) {
            bootstrap.Tooltip.getOrCreateInstance(el);
        });
    }

    const REGION_COLLAPSED_MAX = 7;

    function renderRegionChart(colors) {
        if (!colors) colors = getColors();
        const allData = window._regionData;
        if (!allData || !allData.length) return;

        const toggleBtn = document.getElementById('regionChartToggle');
        const icon = document.getElementById('regionToggleIcon');
        const needsToggle = allData.length > REGION_COLLAPSED_MAX;

        if (needsToggle) {
            toggleBtn.classList.remove('d-none');
            toggleBtn.title = regionChartExpanded ? 'Visa topp ' + REGION_COLLAPSED_MAX : 'Visa alla kretsar';
            icon.className = regionChartExpanded ? 'bi bi-arrows-collapse' : 'bi bi-arrows-expand';
        } else {
            toggleBtn.classList.add('d-none');
        }

        const data = regionChartExpanded ? allData : allData.slice(0, REGION_COLLAPSED_MAX);
        const barHeight = 28;
        const chartHeight = Math.max(180, data.length * barHeight);
        const wrapper = document.getElementById('regionChartWrapper');
        wrapper.style.height = chartHeight + 'px';

        destroyChart('chartMembersByRegion');
        const ctx = document.getElementById('chartMembersByRegion').getContext('2d');
        chartInstances['chartMembersByRegion'] = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: data.map(x => x.region),
                datasets: [{
                    label: 'Medlemmar',
                    data: data.map(x => x.count),
                    backgroundColor: colors.success + 'cc',
                    borderColor: colors.success,
                    borderWidth: 1,
                    barThickness: 18
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { beginAtZero: true, ticks: { precision: 0, color: colors.text }, grid: { color: colors.grid } },
                    y: { ticks: { autoSkip: false, color: colors.text }, grid: { display: false } }
                }
            }
        });
    }

    window.toggleRegionChart = function () {
        regionChartExpanded = !regionChartExpanded;
        renderRegionChart();
    };

    function escapeHtml(str) {
        if (!str) return '';
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    // Lazy-load: trigger when statistics tab is shown
    document.addEventListener('DOMContentLoaded', function () {
        var statsTab = document.getElementById('statistics-tab');
        if (statsTab) {
            statsTab.addEventListener('shown.bs.tab', function () {
                loadStatistics(false);
            });
        }
    });
})();
</script>
