@*
    Kalendrarnas gemensamma form (Stefan 2026-10-05: klubbkalendern ska se ut som kretskalendern).
    Används av _KretsCalendar och ClubCalendar — skriv aldrig en tredje kopia av stilen eller av
    helgdagsberäkningen.

    * Stilen (.kc-*): rubrikrad, rutnät, etiketter, förklaring, listvy, dagvy.
    * window.hpskSwedishHolidays(year) → { "yyyy-MM-dd": "Namn" } — svenska helgdagar och aftnar,
      räknade i webbläsaren (påsken med den gregorianska algoritmen, midsommar och alla helgons dag
      som "lördagen mellan"). Ingen hämtning: att slå på helgdagarna ritar bara om.

    Renderas EN gång per sida (Context.Items), oavsett hur många kalendrar sidan bär.
*@
@{
    var calSharedFirst = Context.Items["hpskCalShared"] == null;
    Context.Items["hpskCalShared"] = true;
}
@if (calSharedFirst)
{
<style>
    .kc-wrap { font-size: 1rem; }
    .kc-head { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-bottom: .75rem; }
    .kc-head h3 { font-size: 1.25rem; margin: 0 .5rem 0 0; min-width: 11rem; }
    .kc-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); border-left: 1px solid var(--bs-border-color); border-top: 1px solid var(--bs-border-color); }
    .kc-dow { font-size: .8rem; font-weight: 600; text-align: center; padding: .25rem; background: var(--bs-tertiary-bg); border-right: 1px solid var(--bs-border-color); border-bottom: 1px solid var(--bs-border-color); }
    .kc-day { min-height: 6.2rem; padding: .25rem; border-right: 1px solid var(--bs-border-color); border-bottom: 1px solid var(--bs-border-color); cursor: pointer; background: var(--bs-body-bg); min-width: 0; }
    .kc-day.kc-other { background: var(--bs-tertiary-bg); color: var(--bs-secondary-color); }
    .kc-day.kc-today .kc-num { background: var(--bs-primary); color: #fff; border-radius: 50%; }
    .kc-day:focus-visible { outline: 2px solid var(--bs-primary); outline-offset: -2px; }
    .kc-num { display: inline-flex; width: 1.6rem; height: 1.6rem; align-items: center; justify-content: center; font-size: .85rem; }
    .kc-chip { display: block; font-size: .74rem; line-height: 1.25; padding: .1rem .3rem; border-radius: .3rem; margin-top: .15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-left: 3px solid transparent; color: var(--bs-body-color); }
    a.kc-chip { text-decoration: none; }
    a.kc-chip:hover, a.kc-chip:focus { text-decoration: underline; }
    .kc-s-tavling { background: var(--bs-primary-bg-subtle); border-left-color: var(--bs-primary); }
    .kc-s-godkand { background: var(--bs-success-bg-subtle); border-left-color: var(--bs-success); }
    .kc-s-preliminar { background: var(--bs-warning-bg-subtle); border-left-color: var(--bs-warning); border-left-style: dashed; }
    .kc-s-handelse { background: var(--bs-secondary-bg-subtle); border-left-color: var(--bs-secondary); }
    .kc-s-stomprogram { background: var(--bs-info-bg-subtle); border-left-color: var(--bs-info); font-style: italic; }
    /* Klubbkalenderns sorter. Träning = grön, tävling = blå (som kretsens), övrigt i klubben = grå,
       utanför klubben = streckad, så den inte läses som klubbens egen. */
    .kc-s-traning { background: var(--bs-success-bg-subtle); border-left-color: var(--bs-success); }
    .kc-s-utanfor { background: var(--bs-tertiary-bg); border-left-color: var(--bs-secondary); border-left-style: dashed; }
    .kc-chip.kc-cancelled { text-decoration: line-through; opacity: .65; }
    .kc-day.kc-selected { outline: 2px solid var(--bs-primary); outline-offset: -2px; }
    .kc-hol { display: block; font-size: .68rem; line-height: 1.1; color: var(--bs-danger-text-emphasis); margin-bottom: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .kc-day.kc-holiday .kc-num { color: var(--bs-danger-text-emphasis); font-weight: 700; }
    .kc-list-row.kc-holiday-row { color: var(--bs-danger-text-emphasis); }
    .kc-neighbour { opacity: .6; }
    .kc-legend span { display: inline-flex; align-items: center; gap: .3rem; margin-right: .9rem; font-size: .85rem; }
    /* ⚠️ Bara bredd och stil här — FÄRGEN kommer från .kc-s-*. En shorthand med "transparent"
       skrev över den, och då försvann rutans accent i båda temana (i mörkt nästan hela rutan).
       Konturen gör att en ljus ruta syns mot ljus bakgrund och en mörk mot mörk. */
    .kc-legend i.sw { width: .9rem; height: .9rem; border-radius: .2rem; display: inline-block; border-left-width: 3px; border-left-style: solid; box-shadow: 0 0 0 1px var(--bs-border-color); }
    .kc-list-month { font-weight: 700; margin: 1rem 0 .35rem; }
    .kc-list-row { display: flex; gap: .75rem; padding: .45rem 0; border-top: 1px solid var(--bs-border-color); }
    .kc-list-date { flex: none; width: 6.5rem; font-variant-numeric: tabular-nums; }
    .kc-warn { color: var(--bs-warning-text-emphasis); font-size: .85rem; }
    .kc-period { border: 1px dashed var(--bs-border-color); border-radius: .4rem; padding: .4rem .6rem; margin-bottom: .5rem; background: var(--bs-tertiary-bg); }
    .kc-period .kc-chip { display: inline-block; max-width: 100%; margin: .15rem .35rem .15rem 0; }
    @@media (max-width: 767.98px) { .kc-day { min-height: 3.6rem; } .kc-chip { font-size: .68rem; } }
</style>
<script>
(function () {
    if (window.hpskSwedishHolidays) return;
    const pad = n => String(n).padStart(2, '0');
    const key = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    const cache = {};
    window.hpskSwedishHolidays = function (year) {
        if (cache[year]) return cache[year];
        const a = year % 19, b = Math.floor(year / 100), c = year % 100, d = Math.floor(b / 4), e = b % 4;
        const f = Math.floor((b + 8) / 25), g = Math.floor((b - f + 1) / 3), h = (19 * a + b - d - g + 15) % 30;
        const i = Math.floor(c / 4), k = c % 4, l = (32 + 2 * e + 2 * i - h - k) % 7, m = Math.floor((a + 11 * h + 22 * l) / 451);
        const month = Math.floor((h + l - 7 * m + 114) / 31), day = ((h + l - 7 * m + 114) % 31) + 1;
        const easter = new Date(year, month - 1, day);
        const rel = n => { const x = new Date(easter); x.setDate(x.getDate() + n); return x; };
        const sat = (mo, from) => { const x = new Date(year, mo, from); x.setDate(from + ((6 - x.getDay() + 7) % 7)); return x; };
        const midsommardagen = sat(5, 20);
        const midsommarafton = new Date(midsommardagen); midsommarafton.setDate(midsommarafton.getDate() - 1);
        const list = [
            [new Date(year, 0, 1), 'Nyårsdagen'], [new Date(year, 0, 6), 'Trettondedag jul'],
            [rel(-2), 'Långfredagen'], [rel(-1), 'Påskafton'], [easter, 'Påskdagen'], [rel(1), 'Annandag påsk'],
            [new Date(year, 4, 1), 'Första maj'], [rel(39), 'Kristi himmelsfärdsdag'],
            [rel(48), 'Pingstafton'], [rel(49), 'Pingstdagen'], [new Date(year, 5, 6), 'Sveriges nationaldag'],
            [midsommarafton, 'Midsommarafton'], [midsommardagen, 'Midsommardagen'],
            [sat(9, 31), 'Alla helgons dag'],
            [new Date(year, 11, 24), 'Julafton'], [new Date(year, 11, 25), 'Juldagen'], [new Date(year, 11, 26), 'Annandag jul'],
            [new Date(year, 11, 31), 'Nyårsafton']
        ];
        const map = {};
        list.forEach(([dt, name]) => { const kk = key(dt); map[kk] = map[kk] ? map[kk] + ' · ' + name : name; });
        return (cache[year] = map);
    };
})();
</script>
}
