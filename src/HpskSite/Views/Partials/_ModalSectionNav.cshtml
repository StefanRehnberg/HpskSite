@*
    Flikar för långa redigeringsmodaler.

    VARFÖR: tävlingsredigeringen visade ALLT på en gång i en 3,3–5,5 skärmar hög
    dialog (uppmätt 2026-08-29 över Precision, Fältskytte och Standardpistol på
    1280×720 … 1920×1080), med Spara 3 500 px ned. Ett första försök gav den en
    sticky rad med hoppknappar — men det var fortfarande samma röriga formulär,
    bara med genvägar. Stefan: *"det ska vara mer som wizarden fast med tabbar"*.
    Nu visas ETT avsnitt i taget, med samma avsnittsindelning som guidens steg.

    HUR: markupen rörs inte. `hpskModalSectionNav` grupperar om befintliga rubriker
    och deras följande syskon till <section>-element vid öppning och visar en i
    taget. Att gruppera i DOM:en i stället för att skriva om markupen kan per
    konstruktion inte ändra formulärets fältmängd, namn eller värden — bara var
    noderna sitter. Det bär hela verifieringen: sparvägen läser
    `new FormData(form)`, så en payload-skillnad vore en regression.

    ⚠ ETT AVSNITT I TAGET BETYDER ATT RESTEN ÄR display:none. Formulärets fält finns
    kvar i DOM:en och FormData läser dem ändå — men `checkValidity()` hoppar över
    dolda fält i vissa webbläsare och `reportValidity()` kan inte fokusera ett fält
    på en annan flik. Därför byter `hpskRevealField` till rätt flik innan ett
    ogiltigt fält rapporteras. Utan det blir "Spara gör ingenting" igen, fast av en
    ny anledning.

    Anropas: hpskModalSectionNav('#competitionEditModal')
    Idempotent — säker att anropa vid varje öppning.
*@
@{
    // ⚠ ViewData duger INTE som guard har. Html.PartialAsync ger varje partial en
    // KOPIA av foralderns ViewData, sa tva syskonpartialer (guiden och redigeringen)
    // ser aldrig varandras flagga — resultatet blev tva overlagg med samma id och 96
    // kryssrutor i stallet for 48. Context.Items lever over hela requesten.
    var _hpskAlreadyRendered = Context.Items.ContainsKey("_hpskModalSectionNavLoaded");
    if (!_hpskAlreadyRendered) { Context.Items["_hpskModalSectionNavLoaded"] = true; }
}
@if (!_hpskAlreadyRendered)
{
    <style>
        .hpsk-sectabs {
            position: sticky; top: 0; z-index: 5;
            background: var(--bs-body-bg);
            border-bottom: 1px solid var(--bs-border-color);
            margin: -1rem -1rem 1rem -1rem; padding: .5rem 1rem 0 1rem;
            display: flex; flex-wrap: wrap; gap: .15rem;
        }
        .hpsk-sectabs button {
            border: 1px solid transparent;
            border-bottom: none;
            background: transparent; color: var(--bs-secondary-color);
            border-radius: .375rem .375rem 0 0;
            padding: .4rem .85rem; margin-bottom: -1px;
            font-size: .875rem; line-height: 1.4; white-space: nowrap; cursor: pointer;
        }
        .hpsk-sectabs button:hover { background: var(--bs-tertiary-bg); color: var(--bs-body-color); }
        .hpsk-sectabs button.active {
            background: var(--bs-body-bg);
            color: var(--bs-primary);
            border-color: var(--bs-border-color);
            border-bottom: 1px solid var(--bs-body-bg);
            font-weight: 600;
        }
        /* Rubriken inne i avsnittet är överflödig när fliken redan bär namnet. */
        .hpsk-section.hpsk-tabbed > :is(h6, .row:first-child > .col-12 > h6) { display: none; }
        /* Rubriken inne i avsnittet ar overflodig nar fliken redan bar namnet. */
        .hpsk-section.hpsk-tabbed > h6,
        .hpsk-section.hpsk-tabbed > .row:first-child h6 { display: none; }
        .hpsk-section[hidden] { display: none !important; }
        /* Datumvaljaren ar flyttad till dokumentets body (se CompetitionEditModal)
           sa den inte kan klippas av modalkroppens overflow. Da maste den ocksa ligga
           OVANPA modalen: Bootstrap-modalen ar 1055, backdrop 1050.
           OBS: skriv ALDRIG en HTML-tagg i en CSS-kommentar har — Razor laser den som
           markup och vyn slutar kompilera, utan felmeddelande. Det kostade en bisektion. */
        .flatpickr-calendar { z-index: 1065 !important; }
    </style>
    <script>
    (function () {
        if (window.hpskModalSectionNav) return;

        window.hpskModalSectionNav = function (modalSelector, opts) {
            opts = opts || {};
            var modal = document.querySelector(modalSelector);
            if (!modal) return 0;
            var body = modal.querySelector('.modal-body');
            if (!body) return 0;

            // ⚠ Inte bara h6: "Arrangör / Synlighet" är en .card-header, och med enbart
            // h6-selektorn svaldes hela det kortet (395 px) av föregående avsnitt.
            var headingSel = opts.headingSelector || 'h6.text-primary, .card-header';
            var headings = [].slice.call(body.querySelectorAll(headingSel));
            if (!headings.length) return 0;

            if (!body.querySelector('.hpsk-section')) {
                headings.forEach(function (h, i) {
                    var anchor = h;
                    while (anchor.parentElement &&
                           anchor.parentElement !== body &&
                           anchor.parentElement.tagName !== 'FORM') {
                        anchor = anchor.parentElement;
                    }
                    // ⚠ Ett NÄSTLAT kort ankrar till samma nod som avsnittet självt och
                    // skulle annars klyva det mitt itu.
                    if (anchor.closest && anchor.closest('.hpsk-section')) return;
                    var sec = document.createElement('section');
                    sec.className = 'hpsk-section hpsk-tabbed';
                    sec.id = 'hpsksec-' + i;
                    sec.setAttribute('data-title', (h.textContent || '').trim());
                    anchor.parentElement.insertBefore(sec, anchor);
                    var node = anchor;
                    while (node) {
                        var next = node.nextSibling;
                        if (node.nodeType === 1 && node !== anchor &&
                            (node.matches(headingSel) || node.querySelector(headingSel))) {
                            break;
                        }
                        sec.appendChild(node);
                        node = next;
                    }
                });
            }

            var sections = [].slice.call(body.querySelectorAll('.hpsk-section'));
            if (!sections.length) return 0;

            // ⚠ Sektioner som står i MARKUPEN har inget id — och hela flikväxlingen
            // adresserar avsnitt via id. Utan detta blev `available[0].id` tom sträng,
            // hpskShowSection returnerade direkt, ingenting doldes och noll flikar blev
            // aktiva: alla elva avsnitt visades på en gång. Ge dem ett id här i stället
            // för att kräva att varje <section> i markupen kommer ihåg ett.
            sections.forEach(function (s, i) {
                if (!s.id) s.id = 'hpsksec-' + i;
                s.classList.add('hpsk-tabbed');   // döljer avsnittets egen rubrik
            });

            // ⚠ Synlighet måste mätas på det som DÖLJS, inte på wrappern: det är ett
            // BARN (#editFaltskytteSection) som bär display:none, och en tom men synlig
            // wrapper passerar offsetParent-testet. Mät att avsnittet renderar något.
            // Ett avsnitt som är dolt AV FLIKARNA räknas fortfarande som "finns".
            var isAvailable = function (s) {
                var wasHidden = s.hidden;
                if (wasHidden) s.hidden = false;
                var rendered = s.offsetParent !== null &&
                               s.getClientRects().length &&
                               s.getBoundingClientRect().height > 4;
                if (wasHidden) s.hidden = true;
                return rendered;
            };

            var nav = body.querySelector('.hpsk-sectabs');
            if (!nav) {
                nav = document.createElement('div');
                nav.className = 'hpsk-sectabs';
                body.insertBefore(nav, body.firstChild);
            }
            nav.innerHTML = '';

            var available = sections.filter(isAvailable);
            sections.forEach(function (s) { s.hidden = available.indexOf(s) === -1; });

            available.forEach(function (s, i) {
                var b = document.createElement('button');
                b.type = 'button';
                b.textContent = s.getAttribute('data-title') || 'Avsnitt';
                b.setAttribute('data-target', s.id);
                b.addEventListener('click', function () { window.hpskShowSection(modalSelector, s.id); });
                nav.appendChild(b);
            });

            var current = body.dataset.hpskCurrentSection;
            var keep = current && available.some(function (s) { return s.id === current; });
            window.hpskShowSection(modalSelector, keep ? current : (available[0] && available[0].id));
            return available.length;
        };

        window.hpskShowSection = function (modalSelector, sectionId) {
            var modal = document.querySelector(modalSelector);
            if (!modal || !sectionId) return;
            var body = modal.querySelector('.modal-body');
            var nav = body.querySelector('.hpsk-sectabs');
            var ids = [].slice.call(nav.querySelectorAll('button')).map(function (b) { return b.getAttribute('data-target'); });
            if (ids.indexOf(sectionId) === -1) return;
            [].slice.call(body.querySelectorAll('.hpsk-section')).forEach(function (s) {
                if (ids.indexOf(s.id) === -1) return;   // avsnitt utan flik forblir dolt
                s.hidden = (s.id !== sectionId);
            });
            [].slice.call(nav.querySelectorAll('button')).forEach(function (b) {
                b.classList.toggle('active', b.getAttribute('data-target') === sectionId);
            });
            body.dataset.hpskCurrentSection = sectionId;
            body.scrollTop = 0;
        };

        // Byter till den flik som bar ett visst falt, och fokuserar det. Anvands nar
        // valideringen pekar ut ett falt pa en annan flik — utan detta ser Spara ut
        // att inte gora nagonting.
        window.hpskRevealField = function (modalSelector, el) {
            if (!el) return false;
            var sec = el.closest ? el.closest('.hpsk-section') : null;
            if (!sec) return false;
            window.hpskShowSection(modalSelector, sec.id);
            try { el.focus({ preventScroll: false }); } catch (e) { }
            return true;
        };
    })();
    </script>
}
