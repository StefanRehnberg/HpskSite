@*
    Sticky sektionsnavigering för långa redigeringsmodaler.

    VARFÖR: tävlingsredigeringen mätte 3,3–5,5 SKÄRMAR hög på 1280×720 … 1920×1080
    (uppmätt 2026-08-29 över Precision, Fältskytte och Standardpistol). Sektionerna
    fanns redan — Grundinformation, Datum, Anmälansinformation, Konfiguration,
    Egenbokning, Fältskytte-inställningar, Arrangör/Synlighet, Tävlingsledning —
    men de rullade bort tillsammans med innehållet, och Spara låg 3 500 px ned.
    Det är därför arrangörer hellre raderar tävlingen och börjar om.

    HUR: markupen rörs inte. `hpskModalSectionNav` grupperar om befintliga
    `h6`-rubriker och deras följande syskon till <section>-element vid öppning, och
    ritar en sticky rad med hoppknappar. Att gruppera i DOM:en i stället för att
    skriva om markupen kan per konstruktion inte ändra formulärets fältmängd,
    namn eller värden — bara var noderna sitter. Det är hela poängen: sparvägen
    läser `new FormData(form)`, så en payload-skillnad vore en regression.

    ⚠ Kräver `modal-dialog-scrollable` på dialogen för att bära sin vikt. Utan den
    växer dialogen förbi skärmen igen och rubrikraden har inget att sitta fast i.

    Anropas: hpskModalSectionNav('#competitionEditModal', { headingSelector: 'h6.text-primary' })
    Idempotent — säker att anropa vid varje öppning.
*@
@if (ViewData["_hpskModalSectionNavLoaded"] == null)
{
    ViewData["_hpskModalSectionNavLoaded"] = true;
    <style>
        .hpsk-secnav {
            position: sticky; top: 0; z-index: 5;
            background: var(--bs-body-bg);
            border-bottom: 1px solid var(--bs-border-color);
            margin: -1rem -1rem 1rem -1rem; padding: .6rem 1rem;
            display: flex; flex-wrap: wrap; gap: .35rem;
        }
        .hpsk-secnav button {
            border: 1px solid var(--bs-border-color);
            background: var(--bs-body-bg); color: var(--bs-body-color);
            border-radius: 999px; padding: .2rem .7rem;
            font-size: .8rem; line-height: 1.4; white-space: nowrap; cursor: pointer;
        }
        .hpsk-secnav button:hover { background: var(--bs-tertiary-bg); }
        .hpsk-secnav button.active {
            background: var(--bs-primary); color: #fff; border-color: var(--bs-primary);
        }
        .hpsk-section { scroll-margin-top: 3.2rem; }
    </style>
    <script>
    (function () {
        if (window.hpskModalSectionNav) return;

        window.hpskModalSectionNav = function (modalSelector, opts) {
            opts = opts || {};
            var modal = document.querySelector(modalSelector);
            if (!modal) return 0;
            var body = modal.querySelector('.modal-body');
            if (!body) return 0;

            // ⚠ Inte bara h6: "Arrangör / Synlighet" är en .card-header, och med enbart
            // h6-selektorn svaldes hela det kortet (395 px) av föregående sektion — så
            // en precisionstävling fick en knapp "Fältskytte-inställningar" som ledde
            // till nästa avsnitts innehåll. Rubriker MÅSTE speglas mot vad som faktiskt
            // renderas som avsnitt, inte mot en taggtyp.
            var headingSel = opts.headingSelector || 'h6.text-primary, .card-header';
            var headings = [].slice.call(body.querySelectorAll(headingSel));
            if (!headings.length) return 0;

            // Gruppera EN gång. Att köra om på en redan grupperad modal ska vara
            // gratis — den anropas vid varje öppning.
            if (!body.querySelector('.hpsk-section')) {
                headings.forEach(function (h, i) {
                    // Rubriken kan ligga i en <div class="row"><div class="col-12">-wrapper.
                    // Klättra upp till den nod som är ett direkt barn till formuläret/kroppen,
                    // annars sveper vi in fel saker.
                    var anchor = h;
                    while (anchor.parentElement &&
                           anchor.parentElement !== body &&
                           anchor.parentElement.tagName !== 'FORM') {
                        anchor = anchor.parentElement;
                    }
                    // ⚠ Ett NÄSTLAT kort (en .card-header inuti ett avsnitt) ankrar till
                    // samma nod som avsnittet självt och skulle annars klyva det mitt itu.
                    // Är ankaret redan inne i en skapad sektion är rubriken inte ett avsnitt.
                    if (anchor.closest && anchor.closest('.hpsk-section')) return;
                    var sec = document.createElement('section');
                    sec.className = 'hpsk-section';
                    sec.id = 'hpsksec-' + i;
                    sec.setAttribute('data-title', (h.textContent || '').trim());
                    anchor.parentElement.insertBefore(sec, anchor);
                    // Flytta in rubriken och allt fram till nästa rubriks ankare.
                    var node = anchor;
                    while (node) {
                        var next = node.nextSibling;
                        // Stanna när nästa rubrik nås.
                        if (node.nodeType === 1 && node !== anchor &&
                            (node.matches(headingSel) || node.querySelector(headingSel))) {
                            break;
                        }
                        sec.appendChild(node);
                        node = next;
                    }
                });
            }

            var sections = [].slice.call(body.querySelectorAll('.hpsk-section'));
            if (!sections.length) return 0;

            var nav = body.querySelector('.hpsk-secnav');
            if (!nav) {
                nav = document.createElement('div');
                nav.className = 'hpsk-secnav';
                body.insertBefore(nav, body.firstChild);
            }
            nav.innerHTML = '';

            // En dold sektion (t.ex. Fältskytte-inställningar på en precisionstävling)
            // ska inte ha en knapp som hoppar till ingenting.
            //
            // ⚠ `offsetParent !== null` DUGER INTE här, och det gav en tyst felaktig rad
            // första gången: det som döljs är ett BARN (`#editFaltskytteSection` bär
            // `display:none`), inte den <section> vi själva svepte runt det. En tom men
            // synlig wrapper passerar offsetParent-testet. Mät att sektionen faktiskt
            // renderar något i stället.
            var isRendered = function (s) {
                if (s.offsetParent === null) return false;
                if (!s.getClientRects().length) return false;
                return s.getBoundingClientRect().height > 4;
            };
            var visible = sections.filter(isRendered);
            visible.forEach(function (s) {
                var b = document.createElement('button');
                b.type = 'button';
                b.textContent = s.getAttribute('data-title') || 'Avsnitt';
                b.addEventListener('click', function () {
                    s.scrollIntoView({ behavior: 'smooth', block: 'start' });
                });
                nav.appendChild(b);
            });

            // Markera vilket avsnitt man är i. rAF-strypt: scroll-händelser i en
            // 3 500 px kropp kommer i hundratal och layout-läsning i varje är dyrt.
            if (!body.dataset.hpskSecnavBound) {
                body.dataset.hpskSecnavBound = '1';
                var ticking = false;
                body.addEventListener('scroll', function () {
                    if (ticking) return;
                    ticking = true;
                    requestAnimationFrame(function () {
                        ticking = false;
                        var btns = nav.querySelectorAll('button');
                        var vis = [].slice.call(body.querySelectorAll('.hpsk-section'))
                                    .filter(isRendered);
                        var top = body.getBoundingClientRect().top + 60;
                        var idx = 0;
                        vis.forEach(function (s, i) {
                            if (s.getBoundingClientRect().top <= top) idx = i;
                        });
                        btns.forEach(function (b, i) { b.classList.toggle('active', i === idx); });
                    });
                }, { passive: true });
            }
            if (nav.firstChild) nav.firstChild.classList.add('active');
            return visible.length;
        };
    })();
    </script>
}
