@*
 * Board Meetings Management — reusable partial (Phase 2 board work).
 * Club context (ownerType=0): renders as modal #boardMeetingsModal, opened by showBoardMeetingsModal().
 * Region context (ownerType=1): renders inline, loaded when the Styrelsemöten sub-tab is shown.
 * Requires ViewBag: BoardOwnerType (int), BoardOwnerId (int).
 * Master-detail in one container (#bmContent → #bmListView / #bmDetailView), no new Umbraco node.
 *@
@{
    var bmOwnerTypeVal = ViewBag.BoardOwnerType as int? ?? 0;
    var bmOwnerIdVal = ViewBag.BoardOwnerId as int? ?? 0;
    var bmIsClubCtx = bmOwnerTypeVal == 0;
}

<!-- Flatpickr (guarded; harmless if already loaded by another partial on the page) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

@if (bmIsClubCtx)
{
    <div class="modal fade" id="boardMeetingsModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-calendar-event me-2"></i>Styrelsemöten</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="bmContent">
                        <div id="bmListView"></div>
                        <div id="bmDetailView" style="display:none;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div id="bmContent">
        <div id="bmListView"></div>
        <div id="bmDetailView" style="display:none;"></div>
    </div>
}

<script>
(function () {
    const bmOwnerType = @bmOwnerTypeVal;
    const bmOwnerId = @bmOwnerIdVal;
    const bmIsClub = @(bmIsClubCtx.ToString().ToLower());
    let bmLoaded = false;
    let bmDetail = null;          // current meeting detail payload
    let bmAddActionAgendaId = ''; // pre-fill target for "skapa åtgärd" from an agenda item

    function bmInit() {
        if (bmLoaded) return;
        bmLoaded = true;
        bmShowList();
    }

    if (bmIsClub) {
        window.showBoardMeetingsModal = function () {
            new bootstrap.Modal(document.getElementById('boardMeetingsModal')).show();
            bmInit();
        };
    } else {
        const tabEl = document.getElementById('regionMeetings-tab');
        if (tabEl) tabEl.addEventListener('shown.bs.tab', bmInit);
    }

    function bmToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    }
    function bmPost(action, params) {
        return fetch('/umbraco/surface/BoardMeeting/' + action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': bmToken() },
            body: new URLSearchParams(params).toString()
        }).then(r => r.json());
    }
    function bmGet(action, qs) {
        return fetch('/umbraco/surface/BoardMeeting/' + action + '?' + new URLSearchParams(qs).toString()).then(r => r.json());
    }
    function esc(s) {
        if (s === null || s === undefined) return '';
        const m = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return s.toString().replace(/[&<>"']/g, c => m[c]);
    }

    // ---- List view ------------------------------------------------------

    function bmShowList() {
        document.getElementById('bmDetailView').style.display = 'none';
        const lv = document.getElementById('bmListView');
        lv.style.display = '';
        lv.innerHTML = '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Laddar...</div>';

        Promise.all([
            bmGet('GetMeetings', { ownerType: bmOwnerType, ownerId: bmOwnerId }),
            bmGet('GetOpenActions', { ownerType: bmOwnerType, ownerId: bmOwnerId })
        ]).then(([mRes, aRes]) => {
            const meetings = (mRes.success && mRes.data) ? mRes.data : [];
            const actions = (aRes.success && aRes.data) ? aRes.data : [];
            renderList(lv, meetings, actions);
        }).catch(() => { lv.innerHTML = '<p class="text-danger">Kunde inte ladda möten.</p>'; });
    }

    function renderList(lv, meetings, actions) {
        const types = [
            { k: 'Styrelsemote', l: 'Ordinarie styrelsemöte' },
            { k: 'Konstituerande', l: 'Konstituerande styrelsemöte' },
            { k: 'Arsmote', l: 'Årsmöte' },
            { k: 'ExtraArsmote', l: 'Extra årsmöte' },
            { k: 'Custom', l: 'Eget möte' }
        ];

        let html = `
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
            <p class="text-muted small mb-0">Planera möten, för protokoll och följ upp beslut och åtgärder.</p>
            <div class="d-flex gap-2 align-items-end">
                <div>
                    <label class="form-label small mb-0">Ny mötestyp</label>
                    <select id="bmNewType" class="form-select form-select-sm">
                        ${types.map(t => `<option value="${t.k}">${esc(t.l)}</option>`).join('')}
                    </select>
                </div>
                <button class="btn btn-sm btn-primary" onclick="bmNewMeeting()"><i class="bi bi-plus-circle me-1"></i>Nytt möte</button>
            </div>
        </div>`;

        // Open actions summary
        const open = actions.length;
        const overdue = actions.filter(a => a.isOverdue).length;
        html += `<div class="alert ${overdue ? 'alert-warning' : 'alert-light'} py-2 small d-flex justify-content-between align-items-center">
            <span><i class="bi bi-check2-square me-1"></i><strong>${open}</strong> öppna åtgärder${overdue ? ` · <span class="text-danger">${overdue} försenade</span>` : ''}</span>
        </div>`;

        const upcoming = meetings.filter(m => !m.isPast);
        const past = meetings.filter(m => m.isPast);

        html += renderMeetingGroup('Kommande möten', upcoming, 'bi-calendar-plus');
        html += renderMeetingGroup('Tidigare möten', past, 'bi-calendar-check');
        if (meetings.length === 0)
            html += '<p class="text-muted text-center py-3">Inga möten ännu. Skapa ett ovan.</p>';

        lv.innerHTML = html;
    }

    function renderMeetingGroup(title, list, icon) {
        if (!list.length) return '';
        let h = `<h6 class="fw-semibold mt-3 mb-2"><i class="bi ${icon} me-1"></i>${esc(title)}</h6>
            <div class="list-group mb-2">`;
        list.forEach(m => {
            h += `<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="bmOpen(${m.id})">
                <span>
                    <span class="fw-semibold">${esc(m.title)}</span>
                    <span class="text-muted small d-block">${esc(m.meetingDate)}${m.location ? ' · ' + esc(m.location) : ''}</span>
                </span>
                ${statusBadge(m.status)}
            </button>`;
        });
        return h + '</div>';
    }

    function statusBadge(status) {
        const map = { 'Planerat': 'bg-secondary', 'Genomfört': 'bg-info text-dark', 'Justerat': 'bg-success' };
        return `<span class="badge ${map[status] || 'bg-secondary'}">${esc(status)}</span>`;
    }

    window.bmNewMeeting = function () {
        const type = document.getElementById('bmNewType').value;
        // Default date: today 18:30
        const now = new Date();
        const def = now.toISOString().slice(0, 10) + ' 18:30';
        bmPost('CreateMeeting', {
            ownerType: bmOwnerType, ownerId: bmOwnerId, meetingType: type, title: '', meetingDate: def, location: ''
        }).then(res => {
            if (res.success) bmOpen(res.data.id);
            else alert(res.message || 'Kunde inte skapa möte');
        }).catch(() => alert('Fel vid skapande av möte'));
    };

    // ---- Detail view ----------------------------------------------------

    window.bmOpen = function (meetingId) {
        const dv = document.getElementById('bmDetailView');
        document.getElementById('bmListView').style.display = 'none';
        dv.style.display = '';
        dv.innerHTML = '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Laddar...</div>';
        bmGet('GetMeetingDetail', { meetingId }).then(res => {
            if (!res.success) { dv.innerHTML = `<p class="text-danger">${esc(res.message || 'Fel')}</p>`; return; }
            bmDetail = res;
            renderDetail(dv, res);
        }).catch(() => { dv.innerHTML = '<p class="text-danger">Kunde inte ladda mötet.</p>'; });
    };

    function renderDetail(dv, d) {
        const m = d.meeting;
        const locked = m.status === 'Justerat';
        const q = d.quorum;
        const quorumClass = q.isMet ? 'alert-success' : 'alert-warning';
        const quorumText = q.isMet ? 'Beslutsför' : 'Ej beslutsför';

        let html = `
        <div class="d-flex justify-content-between align-items-start mb-2">
            <button class="btn btn-sm btn-outline-secondary" onclick="bmShowList()"><i class="bi bi-arrow-left me-1"></i>Tillbaka</button>
            <div class="d-flex gap-2 align-items-center">
                ${statusBadge(m.status)}
                ${locked ? '' : `<button class="btn btn-sm btn-outline-danger" onclick="bmDeleteMeeting(${m.id})"><i class="bi bi-trash"></i></button>`}
            </div>
        </div>`;

        // Header / meta
        if (locked) {
            html += `<h5 class="mb-1">${esc(m.title)}</h5>
                <p class="text-muted mb-1">${esc(m.typeLabel)} · ${esc(m.meetingDate)}${m.location ? ' · ' + esc(m.location) : ''}</p>
                <p class="small text-success"><i class="bi bi-lock-fill me-1"></i>Protokollet är justerat${m.justifiedDate ? ' ' + esc(m.justifiedDate) : ''} och låst för redigering.</p>`;
        } else {
            html += `<div class="row g-2 mb-3">
                <div class="col-12 col-md-5"><label class="form-label small mb-0">Titel</label>
                    <input type="text" id="bmTitle" class="form-control form-control-sm" value="${esc(m.title)}"></div>
                <div class="col-6 col-md-3"><label class="form-label small mb-0">Datum & tid</label>
                    <input type="text" id="bmDate" class="form-control form-control-sm" value="${esc(m.meetingDate)}"></div>
                <div class="col-6 col-md-4"><label class="form-label small mb-0">Plats</label>
                    <input type="text" id="bmLocation" class="form-control form-control-sm" value="${esc(m.location || '')}"></div>
                <div class="col-12 d-flex justify-content-end">
                    <button class="btn btn-sm btn-outline-primary mt-1" onclick="bmSaveMeeting(${m.id})"><i class="bi bi-save me-1"></i>Spara möteinfo</button>
                </div>
            </div>`;
        }

        // Quorum + attendance
        html += `<div class="alert ${quorumClass} py-2 small mb-2 d-flex justify-content-between">
            <span><strong>${quorumText}.</strong> Närvarande ${q.present} av ${q.total} · krav ${q.required}</span>
            ${locked ? '' : `<a href="#" onclick="bmSyncAttendees(${m.id});return false;" class="text-decoration-none">Synka styrelsen</a>`}
        </div>`;

        html += '<h6 class="fw-semibold mb-1"><i class="bi bi-people me-1"></i>Närvaro</h6>';
        html += '<div class="table-responsive mb-3"><table class="table table-sm align-middle mb-0"><tbody>';
        d.attendees.forEach(a => {
            const roles = [a.isChairman ? 'Ordf.' : '', a.isSecretary ? 'Sekr.' : '', a.isAdjuster ? 'Just.' : ''].filter(Boolean).join(' ');
            if (locked) {
                html += `<tr><td>${esc(a.memberName || '-')} ${roles ? '<span class="badge bg-light text-dark ms-1">' + esc(roles) + '</span>' : ''}</td>
                    <td class="text-muted small">${esc(a.roleTitle || '')}</td>
                    <td class="text-end small">${esc(a.attendanceStatus)}</td></tr>`;
            } else {
                html += `<tr>
                    <td>${esc(a.memberName || '-')}<span class="text-muted small d-block">${esc(a.roleTitle || '')}</span></td>
                    <td>
                        <select class="form-select form-select-sm" onchange="bmSaveAttendee(${a.id})" id="bmAtt_status_${a.id}">
                            ${['Närvarande', 'Frånvarande', 'Anmält förhinder'].map(s => `<option ${a.attendanceStatus === s ? 'selected' : ''}>${s}</option>`).join('')}
                        </select>
                    </td>
                    <td class="text-nowrap small">
                        <label class="me-2"><input type="checkbox" id="bmAtt_ordf_${a.id}" ${a.isChairman ? 'checked' : ''} onchange="bmSaveAttendee(${a.id})"> Ordf</label>
                        <label class="me-2"><input type="checkbox" id="bmAtt_sekr_${a.id}" ${a.isSecretary ? 'checked' : ''} onchange="bmSaveAttendee(${a.id})"> Sekr</label>
                        <label class="me-2"><input type="checkbox" id="bmAtt_just_${a.id}" ${a.isAdjuster ? 'checked' : ''} onchange="bmSaveAttendee(${a.id})"> Just</label>
                    </td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="bmRemoveAttendee(${a.id})"><i class="bi bi-x"></i></button></td>
                </tr>`;
            }
        });
        html += '</tbody></table></div>';

        // Agenda / protokoll
        html += '<h6 class="fw-semibold mb-2"><i class="bi bi-list-ol me-1"></i>Dagordning &amp; protokoll</h6>';
        html += '<div id="bmAgenda">';
        d.agenda.forEach((it, idx) => { html += renderAgendaItem(it, idx + 1, locked); });
        html += '</div>';
        if (!locked) {
            html += `<div class="input-group input-group-sm mb-3" style="max-width:520px">
                <input type="text" id="bmNewAgendaHeading" class="form-control" placeholder="Ny dagordningspunkt...">
                <button class="btn btn-outline-secondary" onclick="bmAddAgenda(${m.id})"><i class="bi bi-plus"></i> Lägg till</button>
            </div>`;
        }

        // Actions
        html += '<h6 class="fw-semibold mb-2"><i class="bi bi-check2-square me-1"></i>Åtgärder</h6>';
        html += '<div id="bmActions">' + renderActions(d.actions, d.attendees, locked) + '</div>';
        if (!locked) {
            html += renderAddActionForm(d.attendees);
        }

        // Justering
        if (!locked) {
            const adjOptions = d.attendees.map(a => `<option value="${a.memberId}" ${a.isAdjuster ? 'selected' : ''}>${esc(a.memberName || '')}</option>`).join('');
            html += `<hr><div class="d-flex flex-wrap gap-2 align-items-end">
                <div>
                    <label class="form-label small mb-0">Status</label>
                    <select id="bmStatus" class="form-select form-select-sm" onchange="bmSetStatus(${m.id})">
                        ${['Planerat', 'Genomfört'].map(s => `<option ${m.status === s ? 'selected' : ''}>${s}</option>`).join('')}
                    </select>
                </div>
                <div>
                    <label class="form-label small mb-0">Justerare</label>
                    <select id="bmAdjuster" class="form-select form-select-sm">${adjOptions || '<option value="">—</option>'}</select>
                </div>
                <button class="btn btn-sm btn-success" onclick="bmJustera(${m.id})"><i class="bi bi-lock me-1"></i>Markera som justerat</button>
            </div>
            <p class="text-muted small mt-1">Justering låser protokollet för redigering.</p>`;
        }

        dv.innerHTML = html;

        // Init date pickers (if flatpickr present)
        if (typeof flatpickr !== 'undefined' && !locked) {
            const dateEl = document.getElementById('bmDate');
            if (dateEl) flatpickr(dateEl, { locale: 'sv', enableTime: true, time_24hr: true, dateFormat: 'Y-m-d H:i' });
            const due = document.getElementById('bmActDue');
            if (due) flatpickr(due, { locale: 'sv', dateFormat: 'Y-m-d' });
        }
    }

    function renderAgendaItem(it, num, locked) {
        if (locked) {
            return `<div class="mb-2 pb-2 border-bottom">
                <div class="fw-semibold">${num}. ${esc(it.heading)}</div>
                ${it.discussion ? `<div class="small text-muted" style="white-space:pre-wrap">${esc(it.discussion)}</div>` : ''}
                ${it.decision ? `<div class="small mt-1"><span class="badge bg-success me-1">Beslut</span><span style="white-space:pre-wrap">${esc(it.decision)}</span></div>` : ''}
            </div>`;
        }
        return `<div class="mb-2 pb-2 border-bottom" data-agenda="${it.id}">
            <div class="d-flex justify-content-between align-items-center">
                <input type="text" class="form-control form-control-sm fw-semibold border-0 px-0" value="${esc(it.heading)}" id="bmAg_head_${it.id}" onblur="bmSaveAgenda(${it.id})">
                <div class="text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Skapa åtgärd" onclick="bmAddActionFor(${it.id})"><i class="bi bi-check2-square"></i></button>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" title="Ta bort punkt" onclick="bmRemoveAgenda(${it.id})"><i class="bi bi-x"></i></button>
                </div>
            </div>
            <textarea class="form-control form-control-sm mt-1" rows="2" placeholder="Anteckningar / diskussion..." id="bmAg_disc_${it.id}" onblur="bmSaveAgenda(${it.id})">${esc(it.discussion || '')}</textarea>
            <div class="input-group input-group-sm mt-1">
                <span class="input-group-text bg-success-subtle">Beslut</span>
                <textarea class="form-control" rows="1" placeholder="Beslut..." id="bmAg_dec_${it.id}" onblur="bmSaveAgenda(${it.id})">${esc(it.decision || '')}</textarea>
            </div>
        </div>`;
    }

    function renderActions(actions, attendees, locked) {
        if (!actions.length) return '<p class="text-muted small">Inga åtgärder.</p>';
        let h = '<ul class="list-group list-group-flush mb-2">';
        actions.forEach(a => {
            const due = a.dueDate ? `<span class="${a.isOverdue ? 'text-danger' : 'text-muted'} small ms-2">${esc(a.dueDate)}</span>` : '';
            const who = a.assignedToName ? `<span class="badge bg-light text-dark ms-2">${esc(a.assignedToName)}</span>` : '';
            h += `<li class="list-group-item px-0 py-1 d-flex justify-content-between align-items-center">
                <span>
                    <input type="checkbox" class="form-check-input me-2" ${a.isDone ? 'checked' : ''} ${locked ? 'disabled' : ''} onchange="bmToggleAction(${a.id}, this.checked)">
                    <span class="${a.isDone ? 'text-decoration-line-through text-muted' : ''}">${esc(a.description)}</span>${who}${due}
                </span>
                ${locked ? '' : `<button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="bmRemoveAction(${a.id})"><i class="bi bi-x"></i></button>`}
            </li>`;
        });
        return h + '</ul>';
    }

    function renderAddActionForm(attendees) {
        const opts = '<option value="">— tilldela —</option>' +
            attendees.map(a => `<option value="${a.memberId}">${esc(a.memberName || '')}</option>`).join('');
        return `<div class="row g-2 align-items-end mb-3">
            <div class="col-12 col-md-5"><input type="text" id="bmActDesc" class="form-control form-control-sm" placeholder="Ny åtgärd..."></div>
            <div class="col-6 col-md-3"><select id="bmActAssignee" class="form-select form-select-sm">${opts}</select></div>
            <div class="col-6 col-md-2"><input type="text" id="bmActDue" class="form-control form-control-sm" placeholder="Senast..."></div>
            <div class="col-12 col-md-2"><button class="btn btn-sm btn-primary w-100" onclick="bmAddAction()"><i class="bi bi-plus"></i> Lägg till</button></div>
        </div>`;
    }

    // ---- Detail actions -------------------------------------------------

    window.bmSaveMeeting = function (id) {
        bmPost('UpdateMeeting', {
            meetingId: id,
            meetingType: bmDetail.meeting.meetingType,
            title: document.getElementById('bmTitle').value,
            meetingDate: document.getElementById('bmDate').value,
            location: document.getElementById('bmLocation').value,
            notes: bmDetail.meeting.notes || ''
        }).then(res => { if (!res.success) alert(res.message || 'Kunde inte spara'); });
    };

    window.bmSaveAgenda = function (id) {
        bmPost('UpdateAgendaItem', {
            agendaItemId: id,
            heading: document.getElementById('bmAg_head_' + id).value,
            discussion: document.getElementById('bmAg_disc_' + id).value,
            decision: document.getElementById('bmAg_dec_' + id).value
        });
    };

    window.bmAddAgenda = function (meetingId) {
        const h = document.getElementById('bmNewAgendaHeading').value.trim();
        if (!h) return;
        bmPost('AddAgendaItem', { meetingId, heading: h }).then(res => { if (res.success) bmOpen(meetingId); });
    };

    window.bmRemoveAgenda = function (id) {
        if (!confirm('Ta bort dagordningspunkten?')) return;
        bmPost('RemoveAgendaItem', { agendaItemId: id }).then(res => { if (res.success) bmOpen(bmDetail.meeting.id); });
    };

    window.bmSaveAttendee = function (id) {
        bmPost('UpdateAttendee', {
            attendeeId: id,
            attendanceStatus: document.getElementById('bmAtt_status_' + id).value,
            isChairman: document.getElementById('bmAtt_ordf_' + id).checked,
            isSecretary: document.getElementById('bmAtt_sekr_' + id).checked,
            isAdjuster: document.getElementById('bmAtt_just_' + id).checked
        }).then(res => { if (res.success) bmOpen(bmDetail.meeting.id); }); // refresh quorum
    };

    window.bmRemoveAttendee = function (id) {
        bmPost('RemoveAttendee', { attendeeId: id }).then(res => { if (res.success) bmOpen(bmDetail.meeting.id); });
    };

    window.bmSyncAttendees = function (meetingId) {
        bmPost('SyncAttendees', { meetingId }).then(res => { if (res.success) bmOpen(meetingId); });
    };

    window.bmAddActionFor = function (agendaItemId) {
        bmAddActionAgendaId = agendaItemId;
        const desc = document.getElementById('bmActDesc');
        if (desc) { desc.focus(); desc.scrollIntoView({ behavior: 'smooth', block: 'center' }); desc.placeholder = 'Åtgärd kopplad till punkten...'; }
    };

    window.bmAddAction = function () {
        const desc = document.getElementById('bmActDesc').value.trim();
        if (!desc) { alert('Ange en åtgärd'); return; }
        bmPost('AddAction', {
            ownerType: bmOwnerType, ownerId: bmOwnerId,
            meetingId: bmDetail.meeting.id,
            agendaItemId: bmAddActionAgendaId || '',
            description: desc,
            assignedToMemberId: document.getElementById('bmActAssignee').value || '',
            dueDate: document.getElementById('bmActDue').value || ''
        }).then(res => {
            bmAddActionAgendaId = '';
            if (res.success) bmOpen(bmDetail.meeting.id);
            else alert(res.message || 'Kunde inte lägga till');
        });
    };

    window.bmToggleAction = function (id, done) {
        bmPost('SetActionDone', { actionId: id, done }).then(res => { if (res.success) bmOpen(bmDetail.meeting.id); });
    };
    window.bmRemoveAction = function (id) {
        bmPost('RemoveAction', { actionId: id }).then(res => { if (res.success) bmOpen(bmDetail.meeting.id); });
    };

    window.bmSetStatus = function (id) {
        bmPost('SetMeetingStatus', { meetingId: id, status: document.getElementById('bmStatus').value });
    };

    window.bmJustera = function (id) {
        const adj = document.getElementById('bmAdjuster').value;
        if (!adj) { alert('Välj en justerare'); return; }
        if (!confirm('Markera protokollet som justerat? Det låses då för redigering.')) return;
        bmPost('SetJusterat', { meetingId: id, adjusterMemberId: adj }).then(res => {
            if (res.success) bmOpen(id); else alert(res.message || 'Kunde inte justera');
        });
    };

    window.bmDeleteMeeting = function (id) {
        if (!confirm('Ta bort hela mötet? Detta kan inte ångras.')) return;
        bmPost('DeleteMeeting', { meetingId: id }).then(res => { if (res.success) bmShowList(); });
    };
})();
</script>
