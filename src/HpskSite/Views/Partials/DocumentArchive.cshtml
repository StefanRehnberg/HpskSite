@{
    var docOwnerType = ViewBag.DocumentOwnerType as int? ?? 0;
    var docOwnerId = ViewBag.DocumentOwnerId as int? ?? 0;
    var archivePrefix = $"archive_{docOwnerType}_{docOwnerId}";
}

<div class="document-archive" id="@(archivePrefix)_root">
    <!-- Category Filter -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-archive me-2"></i>Dokumentarkiv</h5>
        <select class="form-select form-select-sm" id="@(archivePrefix)_categoryFilter" style="max-width: 250px;" onchange="docArchive_filterByCategory('@archivePrefix')">
            <option value="">Alla kategorier</option>
        </select>
    </div>

    <div id="@(archivePrefix)_container">
        <div class="text-center py-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Laddar dokument...</span>
            </div>
        </div>
    </div>
</div>

<script>
window.docArchiveState = window.docArchiveState || {};
window.docArchiveState['@archivePrefix'] = {
    ownerType: @docOwnerType,
    ownerId: @docOwnerId,
    documents: [],
    categories: [],
    selectedCategory: ''
};

(function() {
    docArchive_load('@archivePrefix');
})();

function docArchive_load(prefix) {
    const state = window.docArchiveState[prefix];
    fetch(`/umbraco/surface/Document/GetPublicDocuments?ownerType=${state.ownerType}&ownerId=${state.ownerId}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                state.documents = data.data;
                state.categories = data.categories;
                docArchive_populateFilter(prefix);
                docArchive_render(prefix);
            } else {
                document.getElementById(`${prefix}_container`).innerHTML = '<div class="alert alert-info">Inga dokument tillgängliga.</div>';
            }
        })
        .catch(err => {
            console.error('Document archive load error:', err);
            document.getElementById(`${prefix}_container`).innerHTML = '<div class="alert alert-danger">Fel vid laddning av dokument.</div>';
        });
}

function docArchive_populateFilter(prefix) {
    const state = window.docArchiveState[prefix];
    const select = document.getElementById(`${prefix}_categoryFilter`);
    select.innerHTML = '<option value="">Alla kategorier</option>';
    const sorted = (state.categories || []).slice().sort((a, b) => b.name.localeCompare(a.name, 'sv'));
    sorted.forEach(cat => {
        select.innerHTML += `<option value="${cat.id}">${docArchive_escape(cat.name)}</option>`;
    });
}

function docArchive_filterByCategory(prefix) {
    const state = window.docArchiveState[prefix];
    state.selectedCategory = document.getElementById(`${prefix}_categoryFilter`).value;
    docArchive_render(prefix);
}

function docArchive_render(prefix) {
    const state = window.docArchiveState[prefix];
    const container = document.getElementById(`${prefix}_container`);
    let docs = state.documents;

    if (state.selectedCategory) {
        docs = docs.filter(d => d.categoryId == state.selectedCategory);
    }

    if (!docs || docs.length === 0) {
        container.innerHTML = '<div class="alert alert-info">Inga dokument hittades.</div>';
        return;
    }

    // Group by category
    const grouped = {};
    const uncategorized = [];

    docs.forEach(doc => {
        if (doc.categoryId && doc.categoryName) {
            if (!grouped[doc.categoryName]) grouped[doc.categoryName] = [];
            grouped[doc.categoryName].push(doc);
        } else {
            uncategorized.push(doc);
        }
    });

    let html = '';

    // Render categorized groups (descending alphanumeric, Swedish locale)
    const sortedCatNames = Object.keys(grouped).sort((a, b) => b.localeCompare(a, 'sv'));
    for (const catName of sortedCatNames) {
        const catDocs = grouped[catName];
        html += `<div class="mb-4">
            <h6 class="text-muted border-bottom pb-2"><i class="bi bi-folder me-2"></i>${docArchive_escape(catName)}</h6>
            <div class="list-group">`;

        catDocs.forEach(doc => {
            html += docArchive_renderDocItem(doc);
        });

        html += '</div></div>';
    }

    // Render uncategorized
    if (uncategorized.length > 0) {
        if (Object.keys(grouped).length > 0) {
            html += `<div class="mb-4">
                <h6 class="text-muted border-bottom pb-2"><i class="bi bi-folder me-2"></i>Övrigt</h6>
                <div class="list-group">`;
        } else {
            html += '<div class="list-group mb-4">';
        }

        uncategorized.forEach(doc => {
            html += docArchive_renderDocItem(doc);
        });

        html += '</div>';
        if (Object.keys(grouped).length > 0) html += '</div>';
    }

    container.innerHTML = html;
}

function docArchive_renderDocItem(doc) {
    const icon = docArchive_getIcon(doc.contentType, doc.fileName);
    const size = doc.fileSize >= 1048576
        ? (doc.fileSize / 1048576).toFixed(1) + ' MB'
        : (doc.fileSize / 1024).toFixed(0) + ' KB';

    return `<a href="/umbraco/surface/Document/DownloadDocument?id=${doc.id}" class="list-group-item list-group-item-action d-flex align-items-center" target="_blank">
        <i class="bi ${icon} fs-4 me-3 text-primary"></i>
        <div class="flex-grow-1">
            <strong>${docArchive_escape(doc.title)}</strong>
            ${doc.description ? `<small class="d-block text-muted">${docArchive_escape(doc.description)}</small>` : ''}
            <small class="text-muted">${docArchive_escape(doc.fileName)} (${size})</small>
        </div>
        <i class="bi bi-download text-muted"></i>
    </a>`;
}

function docArchive_getIcon(contentType, fileName) {
    const ext = fileName ? fileName.split('.').pop().toLowerCase() : '';
    const iconMap = {
        'pdf': 'bi-file-earmark-pdf',
        'doc': 'bi-file-earmark-word', 'docx': 'bi-file-earmark-word',
        'xls': 'bi-file-earmark-excel', 'xlsx': 'bi-file-earmark-excel',
        'ppt': 'bi-file-earmark-ppt', 'pptx': 'bi-file-earmark-ppt',
        'txt': 'bi-file-earmark-text', 'csv': 'bi-file-earmark-text',
        'zip': 'bi-file-earmark-zip',
        'jpg': 'bi-file-earmark-image', 'jpeg': 'bi-file-earmark-image', 'png': 'bi-file-earmark-image'
    };
    return iconMap[ext] || 'bi-file-earmark';
}

function docArchive_escape(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}
</script>
