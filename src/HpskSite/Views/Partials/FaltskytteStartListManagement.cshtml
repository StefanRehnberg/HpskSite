    window.faltRenumberPatrols = async function() {
        // Ask the server what would change and name it. A patrol NUMBER is what is printed on the
        // patrol list, the station cards and the copies the shooters carry, so a generic
        // "numrera om alla patruller?" asks the operator to approve something they cannot see.
        var pre;
        try {
            pre = await apiGet('PreviewRenumberPatrols?competitionId=' + compId);
        } catch (e) {
            await faltNotice('Kunde inte läsa vad omnumreringen skulle innebära. Försök igen.');
            return;
        }
        if (!pre || !pre.success) {
            await faltNotice('Fel: ' + ((pre && pre.message) || 'Kunde inte förhandsgranska omnumreringen'));
            return;
        }

        var changes = pre.changes || [];
        if (changes.length === 0) {
            // Nothing to do is worth SAYING. Silently reloading looks like the button is broken.
            await faltNotice('Patrullerna är redan numrerade 1–' + pre.total + ' i följd. Inget att göra.');
            return;
        }

        // Name them, but cap the list — a 40-patrol dialog is as unreadable as no dialog.
        var shown = changes.slice(0, 12).map(function(c) {
            var extra = [];
            if (c.weaponGroup) extra.push('vapengrupp ' + window.formatWeaponGroups(c.weaponGroup));
            if (c.label) extra.push(c.label);
            if (c.resultCount > 0) extra.push(c.resultCount + ' resultat');
            return '  Patrull ' + c.oldNumber + ' → ' + c.newNumber
                 + (extra.length ? ' (' + extra.join(', ') + ')' : '');
        });
        if (changes.length > shown.length) {
            shown.push('  … och ' + (changes.length - shown.length) + ' till');
        }

        var msg = changes.length + ' av ' + pre.total + ' patruller får ett nytt nummer:\n\n'
                + shown.join('\n') + '\n\n'
                + 'Ordningen behålls — det är numreringen som städas. Men numret står på '
                + 'utskrivna patrullistor och stationskort, så redan utdelade papper stämmer inte '
                + 'efteråt.';

        if (pre.duplicateNumbers && pre.duplicateNumbers.length) {
            // The one case the result-row migration cannot resolve — say it before, not after.
            msg += '\n\nOBS: nummer ' + pre.duplicateNumbers.join(', ') + ' används av flera '
                 + 'patruller. Redan inmatade resultat på ett sådant nummer kan inte skiljas åt '
                 + 'och hamnar på en av dem.';
        }
        if (pre.hasResults) {
            msg += '\n\nResultat är redan inmatade. De följer med till de nya numren.';
        }

        msg += '\n\nNumrera om?';

        if (!(await faltConfirm(msg))) return;

        var data = await apiPost('RenumberPatrols', { competitionId: parseInt(compId) });
        if (data.success) {
            loadFaltPatrols();
        } else {
            await faltNotice('Fel: ' + (data.message || 'Okänt fel'));
        }
    };
    window.faltPrintPatrolList = function() {
        if (allPatrols.length === 0) return;

        var w = window.open('', '_blank');
        w.document.write('<html><head><title>Patrullista</title>');
        w.document.write('<style>');
        w.document.write('body{font-family:sans-serif;margin:20px;max-width:210mm}');
        w.document.write('h1{font-size:1.5em;border-bottom:2px solid #333;padding-bottom:6px;margin-bottom:12px}');
        w.document.write('h2{font-size:1.2em;margin:16px 0 8px;color:#333}');
        w.document.write('.patrol{margin:8px 0;padding:8px 12px;border:1px solid #ccc;border-radius:6px;page-break-inside:avoid}');
        w.document.write('.patrol-header{font-weight:bold;margin-bottom:4px}');
        w.document.write('.patrol-time{color:#666;font-weight:normal;margin-left:8px}');
        // Write-in rule after the start time. A patrol's send-off slips on the day and the starter
        // pens the new time onto the sheet in their hand; with no room they write over the printed
        // one. A patrol shares one time, so it belongs in the header rather than on every member.
        w.document.write('.patrol-writein{display:inline-block;border-bottom:1px dotted #666;min-width:26mm;margin-left:6mm}');
        w.document.write('.member{margin:2px 0 2px 16px;font-size:0.9em}');
        w.document.write('.member-class{color:#666;font-size:0.85em}');
        w.document.write('.summary{font-size:0.85em;color:#666;margin-top:4px}');
        w.document.write('@@media print{body{margin:15mm}h2{page-break-after:avoid}}');
        w.document.write('<' + '/style><' + '/head><body>');
        w.document.write('<h1>Patrullista</h1>');

        // EN rak lista i patrullordning; vapengruppen st\u00e5r vid varje patrull (kombinationerna \u00e4r inga rubriker).
        {
            var grp = allPatrols;
            var total = grp.reduce(function(s,p){return s+p.members.length;},0);
            w.document.write('<h2>' + grp.length + ' patruller, ' + total + ' skyttar</h2>');
            grp.forEach(function(p) {
                var fams = patrolFamilies(p).map(function(c){ return window.formatWeaponGroups(c); }).join(' + ');
                var t = p.startTime ? new Date(p.startTime).toLocaleTimeString('sv-SE',{hour:'2-digit',minute:'2-digit'}) : '';
                // Was a hand-rolled three-replace escape that missed both quote kinds.
                var lblHtml = p.label ? ' &mdash; ' + hpskEsc(p.label) : '';
                w.document.write('<div class="patrol">');
                w.document.write('<div class="patrol-header">Patrull ' + p.patrolNumber + lblHtml
                    + (t ? '<span class="patrol-time">' + t + '</span>' : '')
                    + (fams ? '<span class="patrol-time">' + hpskEsc(fams) + '</span>' : '')
                    + '<span class="patrol-writein"></span></div>');
                p.members.forEach(function(m) {
                    w.document.write('<div class="member">' + hpskEsc(m.name) + ' <span class="member-class">(' + hpskEsc(m.club) + ') ' + hpskEsc(window.getShootingClassName(m.shootingClass)) + (m.outOfCompetition ? ' – utanför mästerskapet' : '') + '</span></div>');
                });
                w.document.write('</div>');
            });
        }

        w.document.write('<' + '/body><' + '/html>');
        w.document.close();
        w.print();
    };

    // ── Skjutkort ─────────────────────────────────────────────────────
    // Papperskortet patrullen bär med sig. Utskriften är en serverrenderad sida (/faltskytte/skjutkort/{id}) som öppnas i en ny flik;
    // dialogen här väljer bara urval, layout, papper och antal kort per sida. Rutornas bredd räknas på servern (samma räkning som
    // utskriften), så varningen här kan inte säga något annat än det som skrivs ut.
    var CARDS_KEY = 'hpsk_skjutkort_val';
    var cardsFit = {};   // "summa|poäng" → svaret från /matt
    var cardsPreviewTimer = null, cardsLastSrc = '';
    var CARDS_NEW = { blk: true, card: true };   // Skyttblock och Skyttkort: låsta papper, poängval, namnval, färg

    function cardsVal(name) {
        var el = document.querySelector('input[name="' + name + '"]:checked');
        return el ? el.value : '';
    }
    function cardsFmt(n) { return String(Math.round(n * 10) / 10).replace('.', ','); }
    function cardsIsNew() { return !!CARDS_NEW[cardsVal('faltCardsLayout')]; }
    function cardsSetRadio(name, value) {
        var el = document.querySelector('input[name="' + name + '"][value="' + value + '"]');
        if (el && !el.disabled) el.checked = true;
    }
    function cardsReadSaved() {
        try { var raw = localStorage.getItem(CARDS_KEY); return raw ? JSON.parse(raw) : null; } catch (e) { return null; }
    }
    // Sparat val: version 2 har layoutens id och papper per layout; ett äldre val (utan v) gäller bara Ruta per figur / En ruta per station.
    function cardsLoadSaved() {
        try {
            var v = cardsReadSaved();
            if (!v) return;
            var lay = v.layout;
            if (v.v !== 2 && lay !== 'fig' && lay !== 'tot') lay = null;
            if (lay) cardsSetRadio('faltCardsLayout', lay);
            var per = (v.by && v.by[cardsVal('faltCardsLayout')]) || (v.v !== 2 ? v : null);
            if (per) { cardsSetRadio('faltCardsPaper', per.paper); cardsSetRadio('faltCardsPer', per.per); }
            if (v.poang) cardsSetRadio('faltCardsPoang', v.poang);
            if (v.names) cardsSetRadio('faltCardsNames', v.names);
            if (typeof v.color === 'boolean') document.getElementById('faltCardsColor').checked = v.color;
            if (typeof v.sum === 'boolean') document.getElementById('faltCardsSum').checked = v.sum;
            if (typeof v.notes === 'boolean') document.getElementById('faltCardsNotes').checked = v.notes;
        } catch (e) { /* inget sparat val: förvalen gäller */ }
    }
    function cardsSave() {
        try {
            var old = cardsReadSaved(), by = (old && old.v === 2 && old.by) ? old.by : {};
            by[cardsVal('faltCardsLayout')] = { paper: cardsVal('faltCardsPaper'), per: cardsVal('faltCardsPer') };
            localStorage.setItem(CARDS_KEY, JSON.stringify({
                v: 2, layout: cardsVal('faltCardsLayout'), by: by, poang: cardsVal('faltCardsPoang'), names: cardsVal('faltCardsNames'),
                color: document.getElementById('faltCardsColor').checked, sum: document.getElementById('faltCardsSum').checked,
                notes: document.getElementById('faltCardsNotes').checked
            }));
        } catch (e) { /* webbläsaren får inte spara: valet börjar om nästa gång */ }
    }
    function cardsApplyVisibility() {
        var isNew = cardsIsNew();
        document.getElementById('faltCardsNewBox').style.display = isNew ? '' : 'none';
        document.getElementById('faltCardsPaperBox').style.display = isNew ? 'none' : '';
        document.getElementById('faltCardsNotesBox').style.display = isNew ? 'none' : '';
        document.getElementById('faltCardsSumLabel').textContent = isNew ? 'Summa träff/figurer (en extra rad eller kolumn)' : 'Summa-kolumn';
    }
    async function cardsFetchFit(sum, poang) {
        var key = sum + '|' + poang;
        if (cardsFit[key]) return cardsFit[key];
        try {
            var r = await fetch('/faltskytte/skjutkort/' + compId + '/matt?sum=' + sum + '&poang=' + encodeURIComponent(poang));
            var d = await r.json();
            if (d && d.success) cardsFit[key] = d;
            return d;
        } catch (e) { return null; }
    }
    async function cardsRefreshFit() {
        var box = document.getElementById('faltCardsFit');
        var sum = document.getElementById('faltCardsSum').checked ? 1 : 0, poang = cardsVal('faltCardsPoang') || 'fig';
        var layout = cardsVal('faltCardsLayout'), paper = cardsVal('faltCardsPaper'), per = parseInt(cardsVal('faltCardsPer'), 10) || 1;
        var d = await cardsFetchFit(sum, poang);
        if (!d || !d.success) { box.className = 'alert alert-secondary py-2 small'; box.textContent = (d && d.message) || 'Kunde inte räkna ut rutornas storlek.'; return; }
        if (!d.hasStations) { box.className = 'alert alert-warning py-2 small'; box.textContent = 'Tävlingen har ingen stationskonfiguration än, så korten blir utan stationer.'; return; }
        if (!d.layouts) {
            // Äldre server utan de nya layouterna (halv uppladdning): visa bara de gamla.
            ['faltCardsLayBlk', 'faltCardsLayCard'].forEach(function(id) { var el = document.getElementById(id); el.disabled = true; el.closest('.form-check').style.display = 'none'; });
            if (CARDS_NEW[layout]) { cardsSetRadio('faltCardsLayout', 'fig'); cardsApplyVisibility(); }
            return;
        }
        var l = d.layouts.filter(function(x) { return x.id === layout; })[0];
        if (!l) return;
        var e = l.formats.length === 1 ? l.formats[0] : (l.formats.filter(function(f) { return f.paper === paper && f.perSheet === per; })[0] || l.formats[0]);
        var info = ' Banan har ' + d.stationCount + ' stationer och ' + d.figureCount + ' figurer.';
        var paperText = l.formats.length === 1 ? ' Papper: ' + hpskEsc(e.label) + '.' : '';
        if (e.level === 'ok') {
            box.className = 'alert alert-success py-2 small';
            box.innerHTML = '<i class="bi bi-check-circle me-1"></i>' + hpskEsc(e.limit) + ' blir <strong>' + cardsFmt(e.w) + ' mm</strong>. Det går att skriva i.' + paperText + info;
            return;
        }
        var better = [];
        d.layouts.forEach(function(x) {
            x.formats.forEach(function(f) { if (f.level === 'ok' && x.id !== layout && better.indexOf(x.name) < 0) better.push(x.name); });
        });
        if (l.formats.length > 1) l.formats.forEach(function(f) { if (f.level === 'ok' && f !== e) better.unshift(l.name + ', ' + f.label); });
        box.className = 'alert ' + (e.level === 'warn' ? 'alert-warning' : 'alert-danger') + ' py-2 small';
        box.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>' + hpskEsc(e.limit) + ' blir <strong>' + cardsFmt(e.w) + ' mm</strong>'
            + (e.level === 'warn' ? ' (tight)' : ', vilket är för trångt för handskrift') + '.' + paperText + info + ' '
            + (better.length ? 'Det går bättre med: ' + hpskEsc(better.join(', ')) + '.' : 'Det finns inget val där det blir bra med den här banan.');
    }

    // Frågesträngen för utskriften, och för förhandsvisningen (samma sida, bara första arket och första patrullen).
    function cardsQuery(preview) {
        var who = cardsVal('faltCardsWho'), q = [];
        if (who === 'list') {
            var txt = (document.getElementById('faltCardsList').value || '').trim();
            if (!/\d/.test(txt)) return { error: 'Skriv patrullnummer, till exempel 1-4, 7.' };
            q.push('patrols=' + encodeURIComponent(txt));
        } else if (who === 'wg') {
            var g = document.getElementById('faltCardsWg').value;
            if (!g) return { error: 'Det finns ingen vapengrupp att välja.' };
            q.push('wg=' + encodeURIComponent(g));
        } else if (preview && allPatrols.length > 0) {
            q.push('patrols=' + encodeURIComponent(allPatrols[0].patrolNumber));
        }
        var blank = preview ? 0 : Math.max(0, Math.min(50, parseInt(document.getElementById('faltCardsBlank').value, 10) || 0));
        q.push('layout=' + cardsVal('faltCardsLayout'), 'paper=' + cardsVal('faltCardsPaper'), 'per=' + cardsVal('faltCardsPer'),
            'sum=' + (document.getElementById('faltCardsSum').checked ? 1 : 0), 'notes=' + (document.getElementById('faltCardsNotes').checked ? 1 : 0),
            'poang=' + (cardsVal('faltCardsPoang') || 'fig'), 'names=' + (cardsVal('faltCardsNames') || 'pre'),
            'color=' + (document.getElementById('faltCardsColor').checked ? 1 : 0), 'blank=' + blank);
        return { q: q };
    }
    function cardsRefreshPreview() {
        clearTimeout(cardsPreviewTimer);
        cardsPreviewTimer = setTimeout(function() {
            var frame = document.getElementById('faltCardsPreview');
            if (!frame || frame.offsetParent === null) return;   // dold på mindre skärmar: knappen öppnar förhandsvisningen i en flik
            var r = cardsQuery(true);
            if (r.error) return;
            var src = '/faltskytte/skjutkort/' + compId + '?' + r.q.join('&') + '&preview=1';
            if (src === cardsLastSrc) return;
            cardsLastSrc = src;
            frame.src = src;
        }, 300);
    }
    function cardsRefreshAll() {
        cardsApplyVisibility();
        document.getElementById('faltCardsHint').textContent = !cardsIsNew() && parseInt(cardsVal('faltCardsPer'), 10) === 2
            ? 'Med två kort per sida hamnar patrull 1 och 2 på första bladet, 3 och 4 på nästa. Ett udda antal ger ett blad med en tom halva.'
            : (cardsVal('faltCardsLayout') === 'blk' ? 'Fyra skyttar per blad. En patrull med fler skyttar fortsätter på ett nytt blad.'
                : (cardsVal('faltCardsLayout') === 'card' ? 'Ett kort per skytt, två kort per A4. Klipp längs den streckade linjen.' : 'Ett kort per blad.'));
        cardsRefreshFit();
        cardsRefreshPreview();
    }

    window.faltShowCardsModal = function() {
        if (allPatrols.length === 0) return;
        document.getElementById('faltCardsAllCount').textContent = allPatrols.length;
        var seen = {}, opts = '';
        allPatrols.forEach(function(p) {
            var g = p.weaponGroup || '';
            if (g && !seen[g]) { seen[g] = true; opts += '<option value="' + hpskEsc(g) + '">' + hpskEsc(window.formatWeaponGroups(g)) + '</option>'; }
        });
        document.getElementById('faltCardsWg').innerHTML = opts;
        document.getElementById('faltCardsError').style.display = 'none';
        cardsLoadSaved();
        cardsLastSrc = '';
        cardsRefreshAll();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('faltCardsModal')).show();
    };

    window.faltOpenCards = function() {
        var err = document.getElementById('faltCardsError');
        err.style.display = 'none';
        var r = cardsQuery(false);
        if (r.error) { err.textContent = r.error; err.style.display = ''; return; }
        cardsSave();
        window.open('/faltskytte/skjutkort/' + compId + '?' + r.q.join('&') + '&print=1', '_blank');
        bootstrap.Modal.getOrCreateInstance(document.getElementById('faltCardsModal')).hide();
    };

    // Förhandsvisningen i en egen flik (på små skärmar, eller för full storlek): samma sida som utskriften, utan automatisk utskrift.
    window.faltOpenCardsPreview = function() {
        var err = document.getElementById('faltCardsError');
        err.style.display = 'none';
        var r = cardsQuery(true);
        if (r.error) { err.textContent = r.error; err.style.display = ''; return; }
        window.open('/faltskytte/skjutkort/' + compId + '?' + r.q.join('&'), '_blank');
    };

    (function() {
        var m = document.getElementById('faltCardsModal');
        if (!m) return;
        m.addEventListener('change', function(e) {
            if (e.target.id === 'faltCardsWg') document.getElementById('faltCardsWhoWg').checked = true;
            if (e.target.name === 'faltCardsWho') { cardsRefreshPreview(); return; }
            cardsRefreshAll();
        });
        document.getElementById('faltCardsList').addEventListener('input', function() {
            document.getElementById('faltCardsWhoList').checked = true;
            cardsRefreshPreview();
        });
    })();
})();
</script>
