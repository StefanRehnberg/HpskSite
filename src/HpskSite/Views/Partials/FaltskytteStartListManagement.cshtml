@await Html.PartialAsync("_ShootingClassesBootstrap")
@*
 * Fältskytte Patrol Management
 * Full CRUD for patrols and shooters, with publish mechanism.
 *@

@* hpskEsc() — shooter and club names are member-supplied and are rendered into innerHTML
   and into document.write print windows here. Included by the PARTIAL rather than by the
   host page so the helper travels with the code that needs it and cannot be forgotten when
   this partial is added to a new surface. Guarded, so a double include is harmless. *@
@await Html.PartialAsync("_HtmlEscape")

@* Delad publiceringsdialog (kryssrutan "stäng självanmälan"). Inkluderas av partialen själv, samma
   regel som _HtmlEscape. Spärrar mot dubbelinkludering internt. *@
@await Html.PartialAsync("_PublishStartListDialog")

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
    var rollingStartJson = ViewData["RollingStart"]?.ToString() ?? "";
    var isRollingStart = false;
    if (!string.IsNullOrEmpty(rollingStartJson)) {
        try {
            var rsObj = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(rollingStartJson);
            isRollingStart = rsObj?.enabled == true;
        } catch {}
    }
}

<div class="faltskytte-startlist-management" data-competition-id="@competitionId">
    <div class="card mb-3">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="mb-0 d-inline"><i class="bi bi-people me-2"></i>Patrullista</h5>
                    <span class="badge ms-2" id="faltPublishBadge">Preliminär</span>
                    @if (isRollingStart)
                    {
                        <span class="badge bg-info text-dark ms-1" title="Patruller skapas automatiskt när skyttar anmäler sig"><i class="bi bi-arrow-repeat me-1"></i>Rullande start</span>
                    }
                </div>
                <div class="dropdown" id="faltActions">
                    <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-sliders me-1"></i>Åtgärder
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width:270px">
                        <li><h6 class="dropdown-header">Skapa</h6></li>
                        @* Generera/Skapa stay available even under rolling start so a stranded comp (patrols
                           deleted) can be rebuilt — but under rolling start "Generera" is guarded (rolling start auto-creates;
                           regenerating is an "only if something is wrong" action). "Skapa patrull" (add one) is safe and stays normal. *@
                        @if (isRollingStart)
                        {
                            <li><button class="dropdown-item" type="button" onclick="faltGuardedGenerate()" title="Rullande start: patruller skapas automatiskt vid anmälan. Generera om bara om något är fel."><i class="bi bi-plus-lg me-2"></i>Generera patruller</button></li>
                        }
                        else
                        {
                            <li><button class="dropdown-item" type="button" onclick="faltShowGenerateModal()"><i class="bi bi-plus-lg me-2"></i>Generera patruller</button></li>
                        }
                        <li><button class="dropdown-item" type="button" onclick="faltCreatePatrol()"><i class="bi bi-plus-circle me-2"></i>Skapa patrull</button></li>
                        @* Den avancerade vägen (Stefan 2026-10-30): en egen sida där man laborerar med vila, dagens slut, uppdelning, lås och jämför två förslag innan något sparas.
                           "Generera patruller" ovan är den enkla vägen och räcker för en klubbtävling med en start per skytt. Visas för alla tävlingar (kräver ingen planering). *@
                        @if (int.TryParse(competitionId, out var compIdForGenerator))
                        {
                            <li><a class="dropdown-item" href="/patrullgenerator/@compIdForGenerator" title="Avancerad: bygger om startlistan runt funktionärernas uppdrag, vila, önskemål och kamratkrav. Du ser förslaget och vem som flyttas innan något sparas, och kan ångra. För en enkel startlista räcker Generera patruller."><i class="bi bi-sliders me-2"></i>Patrullgenerator (avancerad)</a></li>
                        }
                        @* Publicering: bara när det finns patruller (updatePublishUI). Publicera/Avpublicera byter plats som knapparna gjorde. *@
                        <li id="faltPublishGroup" style="display:none">
                            <hr class="dropdown-divider">
                            <h6 class="dropdown-header">Publicering</h6>
                            <ul class="list-unstyled mb-0">
                                <li id="faltPublishBtn" style="display:none"><button class="dropdown-item" type="button" onclick="faltPublish(true)"><i class="bi bi-globe me-2"></i>Publicera</button></li>
                                <li id="faltUnpublishBtn" style="display:none"><button class="dropdown-item" type="button" onclick="faltPublish(false)"><i class="bi bi-eye-slash me-2"></i>Avpublicera</button></li>
                            </ul>
                        </li>
                        @* Skriv ut: anslaget med starttider (för tävlingar utan skärm) och skjutkorten (papperet patrullen bär med sig). Id:t faltPrintBtn styr hela gruppen. *@
                        <li id="faltPrintBtn" style="display:none">
                            <hr class="dropdown-divider">
                            <h6 class="dropdown-header">Skriv ut</h6>
                            <ul class="list-unstyled mb-0">
                                <li><button class="dropdown-item" type="button" onclick="faltPrintPatrolList()" title="Hela listan med starttider, för anslag där alla kan se sin starttid"><i class="bi bi-printer me-2"></i>Patrullista för anslag</button></li>
                                <li><button class="dropdown-item" type="button" onclick="faltShowCardsModal()" title="Papperskortet som varje patrull bär med sig och som stationernas funktionärer skriver resultatet på"><i class="bi bi-card-list me-2"></i>Skjutkort…</button></li>
                            </ul>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Tävlingsdagen</h6></li>
                        @* Starter's OPERATOR screen (send-off / hold / DNS at the line) — pad-optimised,
                           staff-only. The public read-only wall is the "Visa patrullista" page. *@
                        <li><a class="dropdown-item" href="/startledare/@competitionId" target="_blank" title="Öppna startledarvyn — skicka iväg patruller, håll kvar, markera DNS"><i class="bi bi-megaphone me-2"></i>Startledarvy <i class="bi bi-box-arrow-up-right ms-1 small text-muted"></i></a></li>
                        @if (int.TryParse(competitionId, out _))
                        {
                            <li><button class="dropdown-item" type="button" onclick="TutorialHelper.open('tutorial-patrullgenerator')" title="Se instruktionsfilm om startlistan och patrullgeneratorn"><i class="bi bi-play-circle me-2"></i>Instruktionsfilm</button></li>
                        }
                        @* Ändrar alla patruller: sist, efter en avdelare. Id:t faltRenumberBtn styr hela gruppen, faltDeleteAllBtn raden. *@
                        <li id="faltRenumberBtn" style="display:none">
                            <hr class="dropdown-divider">
                            <ul class="list-unstyled mb-0">
                                <li><button class="dropdown-item" type="button" onclick="faltRenumberPatrols()" title="Numrera om patruller löpande 1..N (stänger luckor och löser dubbletter)"><i class="bi bi-sort-numeric-down me-2"></i>Numrera om patruller</button></li>
                                <li id="faltDeleteAllBtn"><button class="dropdown-item text-danger" type="button" onclick="faltDeleteAllPatrols()"><i class="bi bi-trash me-2"></i>Ta bort alla patruller</button></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Bulk action bar (visible when shooters selected) -->
            @* Ingen d-flex här: den har !important och skrev över display:none, så raden "0 markerade" låg alltid framme (och bredde sidan på telefon). Visas som flex av updateBulkBar. *@
            <div class="alert alert-info py-2 gap-2 align-items-center flex-wrap" id="faltBulkBar" style="display:none">
                <span id="faltBulkCount">0</span> markerade
                <select class="form-select form-select-sm" id="faltBulkTarget" style="width:auto">
                    <option value="">Flytta till patrull...</option>
                </select>
                <button class="btn btn-sm btn-outline-primary" onclick="faltBulkMove()">Flytta</button>
                <button class="btn btn-sm btn-outline-warning" onclick="faltBulkDns()" title="Markera som DNS – frigör platserna">Markera DNS</button>
                <button class="btn btn-sm btn-outline-danger" onclick="faltBulkRemove()">Ta bort</button>
                <button class="btn btn-sm btn-outline-secondary ms-auto" onclick="faltClearSelection()">Avmarkera</button>
            </div>

            <div id="faltPatrolsLoading" class="text-center py-4" style="display:none">
                <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Laddar...</span></div>
            </div>
            <div id="faltPatrolsEmpty" class="text-center py-4">
                @if (isRollingStart)
                {
                <p class="text-muted mb-0">Rullande start aktiverad — patruller skapas automatiskt vid anmälan. Du kan även generera eller skapa patruller manuellt under <strong>Åtgärder</strong>.</p>
                }
                else
                {
                <p class="text-muted mb-0">Inga patruller skapade. Välj <strong>Åtgärder → Generera patruller</strong>, eller skapa dem manuellt.</p>
                }
            </div>
            <div id="faltPatrolsContainer" style="display:none">
                <div id="faltPatrolGroups"></div>
            </div>
        </div>
    </div>
</div>

<script>
    // Under rolling start, regenerating replaces the auto-created lists — confirm before opening the
    // generate modal so it can't be triggered by accident.
    window.faltGuardedGenerate = async function () {
        if (await window.faltConfirm('Rullande start är aktiverad — patruller skapas automatiskt när skyttar anmäler sig.\n\nGenerera om patrullerna bara om något är fel. Vill du fortsätta?', 'Generera om')) {
            faltShowGenerateModal();
        }
    };
</script>

<!-- Generation Settings Modal -->
<div class="modal fade" id="faltGenerateModal" tabindex="-1" style="z-index:1060">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-gear me-2"></i>Generera patruller</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Vapenklasser att inkludera</label>
                    <div class="d-flex flex-wrap gap-3" id="faltGenWeaponClasses">
                        <span class="text-muted small">Laddar...</span>
                    </div>
                    <div class="form-text">Valda vapenklasser blandas i samma patruller</div>
                </div>
                <div class="mb-3">
                    <label for="faltGenPatrolSize" class="form-label fw-bold">Patrullstorlek</label>
                    <input type="number" class="form-control" id="faltGenPatrolSize" min="2" max="12" value="6" style="max-width:100px">
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="faltGenStartTime" class="form-label fw-bold">Starttid</label>
                            <input type="text" class="form-control" id="faltGenStartTime" value="09:00">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label for="faltGenInterval" class="form-label fw-bold">Intervall (min)</label>
                            <input type="number" class="form-control" id="faltGenInterval" min="5" max="60" value="15">
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="faltGenMultiClassGap" class="form-label fw-bold">Tid mellan vapenklasser (min)</label>
                    <input type="number" class="form-control" id="faltGenMultiClassGap" min="0" max="300" value="0" style="max-width:100px">
                    <div class="form-text">Minsta tid mellan patruller för skyttar som skjuter flera vapenklasser. 0 = ingen separering.</div>
                </div>
                <div class="alert alert-secondary small mb-0">
                    <i class="bi bi-info-circle me-1"></i>Patruller läggs till befintliga. Generera för varje vapenklassgrupp separat med olika tider.
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button class="btn btn-primary" onclick="faltGeneratePatrols()">
                    <i class="bi bi-plus-lg me-1"></i>Generera
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Shooter Modal -->
<div class="modal fade" id="faltAddShooterModal" tabindex="-1" style="z-index:1065">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Lägg till skytt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="faltAddShooterPatrolId">
                <input type="hidden" id="faltAddShooterWeaponGroup">
                <div class="mb-3">
                    <label class="form-label">Sök bland anmälda skyttar <span class="text-muted small" id="faltAddShooterWgLabel"></span></label>
                    <input type="text" class="form-control" id="faltAddShooterSearch" placeholder="Sök namn eller klubb..." autocomplete="off" data-1p-ignore="true" oninput="faltSearchShooters()">
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="faltAddShooterShowAll" onchange="faltSearchShooters()">
                        <label class="form-check-label small text-muted" for="faltAddShooterShowAll">Visa alla anmälda (även de som redan är i en patrull)</label>
                    </div>
                </div>
                <div id="faltAddShooterResults" style="max-height:300px;overflow-y:auto"></div>
            </div>
        </div>
    </div>
</div>

<!-- Create Patrol Modal -->
<div class="modal fade" id="faltCreatePatrolModal" tabindex="-1" style="z-index:1065">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Skapa patrull</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Vapengrupp</label>
                    <input type="text" class="form-control" id="faltNewPatrolWg" value="C" autocomplete="off" data-1p-ignore="true">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Position</label>
                    <select class="form-select" id="faltNewPatrolAfter">
                        <option value="0">Sist</option>
                    </select>
                    <div class="form-text">Övriga patruller numreras om.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button class="btn btn-primary" onclick="faltDoCreatePatrol()">Skapa</button>
            </div>
        </div>
    </div>
</div>

<!-- Skjutkort: val av layout, papper och urval. Öppnar utskriften i en ny flik (/faltskytte/skjutkort/{id}). -->
<div class="modal fade" id="faltCardsModal" tabindex="-1" style="z-index:1065">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-card-list me-2"></i>Skriv ut skjutkort</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Vilka patruller</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="faltCardsWho" id="faltCardsWhoAll" value="all" checked>
                                <label class="form-check-label" for="faltCardsWhoAll">Alla patruller (<span id="faltCardsAllCount">0</span>)</label>
                            </div>
                            <div class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input mt-0" type="radio" name="faltCardsWho" id="faltCardsWhoWg" value="wg">
                                <label class="form-check-label text-nowrap" for="faltCardsWhoWg">En vapengrupp</label>
                                <select class="form-select form-select-sm w-auto" id="faltCardsWg" aria-label="Vapengrupp"></select>
                            </div>
                            <div class="form-check d-flex align-items-center gap-2 mt-1">
                                <input class="form-check-input mt-0" type="radio" name="faltCardsWho" id="faltCardsWhoList" value="list">
                                <label class="form-check-label text-nowrap" for="faltCardsWhoList">Välj patruller</label>
                                <input type="text" class="form-control form-control-sm" id="faltCardsList" placeholder="till exempel 1-4, 7" autocomplete="off" data-1p-ignore="true" style="max-width:180px" aria-label="Patrullnummer">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Hur ska kortet se ut?</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="faltCardsLayout" id="faltCardsLayBlk" value="blk" checked>
                                <label class="form-check-label" for="faltCardsLayBlk">Fyra skyttar på ett blad</label>
                                <div class="form-text mt-0">Skyttblock: hela patrullen på ett A4 liggande, stationerna bredvid varandra.</div>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="radio" name="faltCardsLayout" id="faltCardsLayCard" value="card">
                                <label class="form-check-label" for="faltCardsLayCard">Ett kort per skytt</label>
                                <div class="form-text mt-0">Skyttkort, A5 liggande, två per A4 stående som klipps isär. Stationerna är rader.</div>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="radio" name="faltCardsLayout" id="faltCardsLayFig" value="fig">
                                <label class="form-check-label" for="faltCardsLayFig">Ruta per figur</label>
                                <div class="form-text mt-0">Hela patrullen på ett kort, en rad per skytt. Behöver mest plats.</div>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="radio" name="faltCardsLayout" id="faltCardsLayTot" value="tot">
                                <label class="form-check-label" for="faltCardsLayTot">En ruta per station</label>
                                <div class="form-text mt-0">Bara träff/figurer, till exempel 6/3.</div>
                            </div>
                        </div>
                        <div class="mb-3" id="faltCardsNewBox">
                            <div class="mb-2">
                                <label class="form-label fw-bold mb-1">Poängrutan</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsPoang" id="faltCardsPoangFig" value="fig" checked>
                                    <label class="form-check-label" for="faltCardsPoangFig">Vid figuren</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsPoang" id="faltCardsPoangRow" value="row">
                                    <label class="form-check-label" for="faltCardsPoangRow">På en egen rad eller kolumn</label>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-bold mb-1">Skyttarna</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsNames" id="faltCardsNamesPre" value="pre" checked>
                                    <label class="form-check-label" for="faltCardsNamesPre">Förtryckta namn ur startlistan</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsNames" id="faltCardsNamesBlank" value="blank">
                                    <label class="form-check-label" for="faltCardsNamesBlank">Tomma rader, skrivs för hand</label>
                                </div>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="faltCardsColor">
                                <label class="form-check-label" for="faltCardsColor">Färg som hjälp att skilja rutorna åt</label>
                                <div class="form-text mt-0">Svartvitt fungerar alltid. Snedstreckad ruta betyder skriv inte, ruta med fet P betyder skriv poäng.</div>
                            </div>
                        </div>
                        <div class="row mb-3" id="faltCardsPaperBox">
                            <div class="col-sm-6">
                                <label class="form-label fw-bold">Papper</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsPaper" id="faltCardsPaperPortrait" value="portrait">
                                    <label class="form-check-label" for="faltCardsPaperPortrait">A4 stående</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsPaper" id="faltCardsPaperLandscape" value="landscape" checked>
                                    <label class="form-check-label" for="faltCardsPaperLandscape">A4 liggande</label>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold">Kort per sida</label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsPer" id="faltCardsPer1" value="1" checked>
                                    <label class="form-check-label" for="faltCardsPer1">1</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="faltCardsPer" id="faltCardsPer2" value="2">
                                    <label class="form-check-label" for="faltCardsPer2">2</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Innehåll</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="faltCardsSum">
                                <label class="form-check-label" for="faltCardsSum" id="faltCardsSumLabel">Summa-kolumn</label>
                            </div>
                            <div class="form-check" id="faltCardsNotesBox">
                                <input class="form-check-input" type="checkbox" id="faltCardsNotes" checked>
                                <label class="form-check-label" for="faltCardsNotes">Anteckningsruta när platsen räcker</label>
                            </div>
                        </div>
                        <div class="small text-muted" id="faltCardsHint"></div>
                        <div class="text-danger small mt-2" id="faltCardsError" style="display:none"></div>
                    </div>
                    <div class="col-lg-6">
                        <div id="faltCardsFit" class="alert alert-secondary py-2 small" role="status">Räknar ut rutornas storlek…</div>
                        <label class="form-label fw-bold">Förhandsvisning</label>
                        <div class="border rounded bg-body-secondary p-2" id="faltCardsPreviewWrap">
                            <iframe id="faltCardsPreview" title="Förhandsvisning av skjutkortet" class="w-100 border-0 bg-white d-none d-lg-block" style="height:440px" loading="lazy"></iframe>
                            <div class="small text-muted d-lg-none">Förhandsvisningen öppnas i en egen flik på mindre skärmar.</div>
                        </div>
                        <div class="small text-muted mt-1" id="faltCardsPreviewCaption">Första sidan med första patrullen. Linjer och snedstreckning syns bäst på en provutskrift.</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="faltOpenCardsPreview()"><i class="bi bi-box-arrow-up-right me-1"></i>Öppna förhandsvisningen i ny flik</button>
                        <div class="d-flex align-items-center gap-2 mt-3">
                            <label class="form-check-label" for="faltCardsBlank">Extra blanka kort</label>
                            <input type="number" class="form-control form-control-sm" id="faltCardsBlank" min="0" max="50" value="0" style="width:80px">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button class="btn btn-primary" onclick="faltOpenCards()"><i class="bi bi-printer me-1"></i>Skriv ut</button>
            </div>
        </div>
    </div>
</div>

<!-- Flatpickr for time picker -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<script>
(function() {
    var compId = document.querySelector('.faltskytte-startlist-management')?.dataset.competitionId;
    var allPatrols = []; // Cache for rendering
    var isPublished = false;
    var publishedGroupsCsv = '';   // vilka vapengrupper som är publicerade ("C,B"); tom = hela listan (om publicerad)
    var faltPatrolSize = 6; // Default; updated when generating
    var _faltHasResults = false;

    // Check if results exist (for modification warning). Re-read on every tab activation,
    // not just at page load: results appear DURING the day, and this flag is what decides
    // whether destructive patrol edits warn at all.
    function faltRefreshHasResults() {
        return apiGet('HasResults?competitionId=' + compId).then(function(d) {
            _faltHasResults = d.hasResults || false;
        }).catch(function() {});
    }

    if (compId) {
        faltRefreshHasResults();
        loadFaltPatrols();

        // Reload when the Startlistor tab is opened. Without this the patrol list rendered
        // once at page load and went stale the moment the desk registered anyone — the
        // organiser then made patrol decisions from a list that was minutes or hours old.
        // Precision (CompetitionStartListManagement.cshtml) and Springskytte
        // (SpringskytteStartListManagement.cshtml) already do this; Fältskytte was the
        // last one that did not.
        //
        // Same selectors as the precision partial, for the same reason: the admin page uses
        // #comp-startlists and the standalone page #startlists. Listened for on document so
        // it survives the tab button being re-rendered.
        document.addEventListener('shown.bs.tab', function (ev) {
            var target = ev.target && ev.target.getAttribute
                ? (ev.target.getAttribute('data-bs-target') || '')
                : '';
            if (target !== '#comp-startlists' && target !== '#startlists') return;
            faltRefreshHasResults();
            loadFaltPatrols();
        });
    }

    async function confirmIfResultsExist(action) {
        if (!_faltHasResults) return true;
        return faltConfirm('OBS! Det finns redan registrerade resultat f\u00f6r denna t\u00e4vling.\n\n\u00c4ndring av patrullistan kan p\u00e5verka p\u00e5g\u00e5ende t\u00e4vling.\n\nVill du forts\u00e4tta med: ' + action + '?');
    }

    setTimeout(function() {
        flatpickr('#faltGenStartTime', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, defaultHour: 9, defaultMinute: 0 });
    }, 100);

    function apiPost(endpoint, body) {
        return fetch('/umbraco/surface/Faltskytte/' + endpoint, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify(body)
        }).then(function(r) {
            if (!r.ok) return r.text().then(function(t) { throw new Error('Server ' + r.status + ': ' + t.substring(0, 200)); });
            return r.json();
        });
    }

    // Ingen spärr är absolut: svarar servern needsForce visas skälet och användaren får bekräfta och försöka igen. Servern ställer EN fråga
    // i taget (resultat finns, par skiljs åt, patrullen är full) och varje fråga har sin egen bekräftelse: kapacitetsfrågan bekräftas med
    // forceCapacity, övriga med force. Annars skulle en bekräftad parseparation tyst släppa igenom en överfull patrull.
    async function apiPostForce(endpoint, body) {
        var sent = Object.assign({}, body);
        for (var round = 0; round < 4; round++) {
            var data = await apiPost(endpoint, sent);
            if (!(data && data.needsForce)) return data;
            var q = String(data.message || '').trim();
            if (!/\?$/.test(q)) q += '\n\nVill du fortsätta ändå?';
            if (!(await faltConfirm(q, 'Fortsätt ändå'))) return { success: false, cancelled: true };
            if (data.overCapacity) sent.forceCapacity = true; else sent.force = true;
        }
        return { success: false, message: 'Det gick inte att slutföra. Försök igen.' };
    }

    // ── Dialoger i sidan — aldrig webbläsarens confirm/prompt/alert ──────────────────────────────
    // EN dialog för bekräftelse, fråga och besked. Ett löfte: true/false (bekräfta), en lista med fältens värden
    // eller null (fråga), true (besked). Texten är ren text (radbrytningar behålls), aldrig HTML.
    // ⚠️ Dialogerna går i KÖ och löftet avgörs först när dialogen är helt stängd (hidden.bs.modal): två anrop nästan samtidigt (två snabba
    // tryck på en telefon, eller en bekräftelse följd av en till) får annars den första skärmtäckningen att bli kvar över sidan.
    var _faltAskChain = Promise.resolve();
    function faltAsk(o) {
        var p = _faltAskChain.then(function() { return faltAskNow(o); });
        _faltAskChain = p.catch(function() {});
        return p;
    }
    function faltAskNow(o) {
        return new Promise(function(resolve) {
            var inputs = o.inputs || [];
            var el = document.createElement('div');
            el.className = 'modal fade'; el.id = 'faltAskModal'; el.tabIndex = -1; el.style.zIndex = 1090;
            el.setAttribute('aria-labelledby', 'faltAskTitle');
            var fieldsHtml = inputs.map(function(f, i) {
                return '<div class="mb-2"><label class="form-label small mb-1" for="faltAskField' + i + '">' + hpskEsc(f.label) + '</label>' +
                    '<input type="' + (f.type || 'text') + '" class="form-control" style="min-height:44px" id="faltAskField' + i + '" value="' + hpskEsc(f.value || '') + '"' +
                    (f.placeholder ? ' placeholder="' + hpskEsc(f.placeholder) + '"' : '') + '></div>';
            }).join('');
            el.innerHTML =
                '<div class="modal-dialog modal-dialog-centered"><div class="modal-content">' +
                '<div class="modal-header"><h5 class="modal-title" id="faltAskTitle">' + hpskEsc(o.title || 'Bekräfta') + '</h5>' +
                '<button type="button" class="btn-close" data-fa-cancel aria-label="Stäng"></button></div>' +
                '<div class="modal-body">' + (o.message ? '<p class="mb-2" style="white-space:pre-line">' + hpskEsc(o.message) + '</p>' : '') + fieldsHtml +
                '<div class="text-danger small d-none" data-fa-err role="alert"></div></div>' +
                '<div class="modal-footer">' +
                (o.notice ? '' : '<button type="button" class="btn btn-secondary" style="min-height:44px" data-fa-cancel>' + hpskEsc(o.cancelText || 'Avbryt') + '</button>') +
                '<button type="button" class="btn ' + (o.danger ? 'btn-danger' : 'btn-primary') + '" style="min-height:44px" data-fa-ok>' + hpskEsc(o.okText || 'OK') + '</button>' +
                '</div></div></div>';
            document.body.appendChild(el);
            var modal = bootstrap.Modal.getOrCreateInstance(el, { backdrop: 'static' });
            var result = o.notice ? true : (inputs.length ? null : false);
            function finish(v) { result = v; modal.hide(); }
            function values() { return inputs.map(function(f, i) { return document.getElementById('faltAskField' + i).value; }); }
            function submit() {
                if (o.notice) return finish(true);
                if (inputs.length) {
                    var vals = values();
                    var err = o.validate ? o.validate(vals) : null;
                    if (err) { var e = el.querySelector('[data-fa-err]'); e.textContent = err; e.classList.remove('d-none'); return; }
                    return finish(vals);
                }
                finish(true);
            }
            el.querySelector('[data-fa-ok]').addEventListener('click', submit);
            // Enter i ett fält sparar (telefonens tangentbord har ingen annan väg).
            el.addEventListener('keydown', function(ev) { if (ev.key === 'Enter' && ev.target && ev.target.tagName === 'INPUT') { ev.preventDefault(); submit(); } });
            el.querySelectorAll('[data-fa-cancel]').forEach(function(b) { b.addEventListener('click', function() { finish(inputs.length ? null : false); }); });
            // Löftet avgörs när dialogen är HELT stängd — då är skärmtäckningen borta och nästa dialog i kön kan öppnas.
            el.addEventListener('hidden.bs.modal', function() { el.remove(); resolve(result); });
            el.addEventListener('shown.bs.modal', function() {
                // En farlig åtgärd (Ta bort …) börjar med fokus på Avbryt, så Enter aldrig tar bort något av misstag.
                var first = o.danger ? el.querySelector('[data-fa-cancel].btn-secondary') : el.querySelector('input');
                (first || el.querySelector('[data-fa-ok]')).focus();
            });
            modal.show();
            // En dialog ovanpå en annan (t.ex. Lägg till skytt) måste ha sin skärmtäckning över den andra dialogen.
            var bds = document.querySelectorAll('.modal-backdrop'); if (bds.length) bds[bds.length - 1].style.zIndex = 1085;
        });
    }
    function faltConfirm(message, okText, danger) { return faltAsk({ title: danger ? 'Ta bort?' : 'Bekräfta', message: message, okText: okText || 'Fortsätt', danger: !!danger }); }
    function faltNotice(message) { return faltAsk({ title: 'Meddelande', message: message, okText: 'OK', notice: true }); }
    window.faltConfirm = faltConfirm;
    window.faltNotice = faltNotice;

    // Märket för en skytt som skjuter utanför mästerskapet (gällande läge ur servern; saknas fältet är skytten med som vanligt).
    function faltOutsideBadge(m) {
        return m.outOfCompetition
            ? ' <span class="badge bg-secondary text-wrap" title="Skjuter utanför mästerskapet i den här klassen: resultatet räknas, men ingen mästerskapsplats.">Utanför mästerskapet</span>'
            : '';
    }

    function apiGet(endpoint) {
        return fetch('/umbraco/surface/Faltskytte/' + endpoint).then(function(r) {
            if (!r.ok) return r.text().then(function(t) { throw new Error('Server ' + r.status + ': ' + t.substring(0, 200)); });
            return r.json();
        });
    }

    async function loadFaltPatrols() {
        var loading = document.getElementById('faltPatrolsLoading');
        var empty = document.getElementById('faltPatrolsEmpty');
        var container = document.getElementById('faltPatrolsContainer');
        var deleteAllBtn = document.getElementById('faltDeleteAllBtn');
        var printBtn = document.getElementById('faltPrintBtn');
        var renumberBtn = document.getElementById('faltRenumberBtn');

        loading.style.display = '';
        empty.style.display = 'none';
        container.style.display = 'none';

        // Placement coverage is stale after any patrol change, and every one of those paths
        // comes back through here.
        if (window.hpskLoadStartListCoverage) window.hpskLoadStartListCoverage();

        try {
            var data = await apiGet('GetPatrols?competitionId=' + compId);
            loading.style.display = 'none';

            allPatrols = (data.success && data.patrols) ? data.patrols : [];
            // Generatorns tal förifylls med tävlingens "Högsta antal skyttar per patrull" (servern är källan).
            if (data.success && data.maxPatrolSize > 0) {
                var genSize = document.getElementById('faltGenPatrolSize');
                if (genSize) genSize.value = data.maxPatrolSize;
                var genLbl = document.querySelector('label[for="faltGenPatrolSize"]');
                if (genLbl) genLbl.textContent = 'Skyttar per patrull (från tävlingen)';
            }

            if (allPatrols.length === 0) {
                empty.style.display = '';
                deleteAllBtn.style.display = 'none';
                printBtn.style.display = 'none';
                if (renumberBtn) renumberBtn.style.display = 'none';
            } else {
                container.style.display = '';
                deleteAllBtn.style.display = '';
                printBtn.style.display = '';
                if (renumberBtn) renumberBtn.style.display = '';
                renderPatrols();
            }

            // Check publish status
            updatePublishUI();
            updateBulkBar();
        } catch (err) {
            loading.style.display = 'none';
            empty.style.display = '';
        }
    }

    async function updatePublishUI() {
        // Read publish status from a data attribute or API; for now check competition property
        try {
            var data = await apiGet('GetPublicPatrols?competitionId=' + compId);
            isPublished = data.published || false;
            publishedGroupsCsv = data.publishedGroups || '';
        } catch(e) { isPublished = false; }

        var badge = document.getElementById('faltPublishBadge');
        var pubBtn = document.getElementById('faltPublishBtn');
        var unpubBtn = document.getElementById('faltUnpublishBtn');
        if (isPublished) {
            badge.className = 'badge bg-success ms-2';
            // Per vapengrupp: "Publicerad (C)" och möjlighet att publicera fler grupper senare.
            var partial = !!publishedGroupsCsv;
            badge.textContent = partial ? 'Publicerad: ' + publishedGroupsCsv.split(',').join(', ') : 'Publicerad';
            pubBtn.style.display = partial && allPatrols.length > 0 ? '' : 'none';
            unpubBtn.style.display = allPatrols.length > 0 ? '' : 'none';
        } else {
            badge.className = 'badge bg-warning text-dark ms-2';
            badge.textContent = 'Preliminär';
            pubBtn.style.display = allPatrols.length > 0 ? '' : 'none';
            unpubBtn.style.display = 'none';
        }
        // Gruppen "Publicering" i Åtgärder-menyn syns bara när minst ett av valen gör det (annars en tom rubrik).
        var pubGroup = document.getElementById('faltPublishGroup');
        if (pubGroup) pubGroup.style.display = (pubBtn.style.display !== 'none' || unpubBtn.style.display !== 'none') ? '' : 'none';
    }

    // En patrulls vapengrupper som enskilda koder ("A+A_Opt" → A; A_Opt räknas som A). Etiketten räknas fram ur
    // vilka klasser som sitter i patrullen, så den kan inte användas som rubrik: varje kombination blev ett eget kort.
    function patrolFamilies(p) {
        var seen = {}, out = [];
        String(p.weaponGroup || '').split('+').forEach(function(c) {
            c = c.trim(); if (!c || c === '?') return;
            if (c === 'A_Opt') c = 'A';
            if (!seen[c]) { seen[c] = true; out.push(c); }
        });
        return out;
    }
    var faltPatrolFilter = '';

    window.faltSetPatrolFilter = function(code) {
        faltPatrolFilter = code || '';
        renderPatrols();
    };

    function renderPatrols() {
        // EN rak lista i patrullordning (som numren). Vapengruppen är en etikett på varje patrull; filtret ersätter korten.
        var codes = [];
        allPatrols.forEach(function(p) { patrolFamilies(p).forEach(function(c) { if (codes.indexOf(c) < 0) codes.push(c); }); });
        if (faltPatrolFilter && codes.indexOf(faltPatrolFilter) < 0) faltPatrolFilter = '';

        var groupsEl = document.getElementById('faltPatrolGroups');
        groupsEl.innerHTML = '';

        var grpPatrols = allPatrols.filter(function(p) { return !faltPatrolFilter || patrolFamilies(p).indexOf(faltPatrolFilter) >= 0; });
        var totalShooters = grpPatrols.reduce(function(s, p) { return s + p.members.filter(function(m) { return m.status !== 'DNS'; }).length; }, 0);

        var filterBtns = '';
        if (codes.length > 1) {
            filterBtns = '<span class="btn-group btn-group-sm ms-3" role="group" aria-label="Visa vapengrupp">' +
                [''].concat(codes).map(function(c) {
                    var on = (c === faltPatrolFilter);
                    return '<button type="button" class="btn ' + (on ? 'btn-primary' : 'btn-outline-primary') + '" aria-pressed="' + on + '" onclick="faltSetPatrolFilter(\'' + c.replace(/'/g, "\\'") + '\')">' + (c ? hpskEsc(window.formatWeaponGroups(c)) : 'Alla') + '</button>';
                }).join('') + '</span>';
        }

        {
            var html = '<div class="card mb-3">' +
                '<div class="card-header py-2 d-flex flex-wrap align-items-center gap-1">' +
                '<span class="badge bg-primary">' + grpPatrols.length + ' patruller</span>' +
                '<span class="badge bg-secondary">' + totalShooters + ' skyttar</span>' +
                filterBtns +
                '</div><div class="card-body p-0">';

            grpPatrols.forEach(function(patrol) {
                var wg = patrol.weaponGroup || '';
                var famBadges = patrolFamilies(patrol).map(function(c) { return '<span class="badge bg-info-subtle text-info-emphasis ms-1">' + hpskEsc(window.formatWeaponGroups(c)) + '</span>'; }).join('');
                var startTimeStr = patrol.startTime ? new Date(patrol.startTime).toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' }) : '';
                var wgEsc = (wg || '').replace(/'/g, "\\'");
                var labelStr = patrol.label || '';
                var labelSuffix = labelStr ? ' — ' + escapeHtmlInline(labelStr) : '';
                // Värdena bärs i data-attribut (HTML-escapade), aldrig som JSON i ett onclick="…": ett " i
                // attributet klippte det och gav "SyntaxError: Unexpected end of input" — pennan gick inte att klicka.
                var editAttrs = 'data-patrol-id="' + patrol.patrolId + '" data-time="' + hpskEsc(startTimeStr) + '" data-label="' + hpskEsc(labelStr) + '"';
                html += '<div class="border-bottom px-3 py-2" data-patrol-id="' + patrol.patrolId + '">' +
                    '<div class="d-flex justify-content-between align-items-center mb-1">' +
                    '<span>' +
                    '<strong>Patrull ' + patrol.patrolNumber + labelSuffix + '</strong>' + famBadges +
                    (startTimeStr ? '<span class="text-muted ms-2"><i class="bi bi-clock me-1"></i>' + startTimeStr +
                        ' <button class="btn btn-link btn-sm px-1 py-0 text-muted" ' + editAttrs + ' onclick="faltEditPatrolFromButton(this)" title="Redigera patrull (starttid och namn)"><i class="bi bi-pencil"></i></button></span>' :
                        ' <button class="btn btn-link btn-sm px-1 py-0 text-muted ms-2" ' + editAttrs + ' onclick="faltEditPatrolFromButton(this)" title="Redigera patrull (starttid och namn)"><i class="bi bi-pencil"></i></button>') +
                    '<span class="badge bg-secondary ms-2">' + patrol.members.filter(function(m) { return m.status !== 'DNS'; }).length + '</span>' +
                    '</span>' +
                    '<span class="d-flex gap-1">' +
                    '<button class="btn btn-outline-primary btn-sm py-0 px-1" onclick="faltShowAddShooter(' + patrol.patrolId + ',\'' + wgEsc + '\')" title="Lägg till skytt"><i class="bi bi-person-plus"></i></button>' +
                    '<button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="faltDeletePatrol(' + patrol.patrolId + ')" title="Ta bort patrull"><i class="bi bi-trash"></i></button>' +
                    '</span></div>';

                // Rad 2: antal platser mot taket (servern avgör taket). Över taket med färg OCH text, aldrig bara färg.
                var seatedN = patrol.members.filter(function(m) { return m.status !== 'DNS'; }).length;
                if (patrol.limit) {
                    var over = seatedN > patrol.limit;
                    html += '<div class="small mb-1 ' + (over ? 'text-danger fw-bold' : 'text-muted') + '">' + seatedN + ' av ' + patrol.limit + ' platser' +
                        (over ? ' &ndash; &ouml;ver max' : '') + '</div>';
                }
                if (patrol.members.length === 0) {
                    html += '<div class="text-muted small fst-italic">Tom patrull</div>';
                } else {
                    // Platserna är fasta: en skytt som tas bort eller får DNS lämnar en ledig plats i stället
                    // för att de andra flyttas upp (Michael Henriksson 2026-10-27). DNS visas efter platserna.
                    var seated = patrol.members.filter(function(m) { return m.status !== 'DNS'; });
                    var dnsMembers = patrol.members.filter(function(m) { return m.status === 'DNS'; });
                    var seatByPos = {};
                    var maxSeat = 0;
                    seated.forEach(function(m) {
                        // Äldre rader utan giltig plats läggs sist så de syns.
                        var pos = m.position > 0 ? m.position : (maxSeat + 1);
                        while (seatByPos[pos]) pos++;
                        seatByPos[pos] = m;
                        if (pos > maxSeat) maxSeat = pos;
                    });
                    for (var seat = 1; seat <= Math.max(maxSeat, patrol.limit || 0); seat++) {
                        var m = seatByPos[seat];
                        if (!m) {
                            html += '<div class="d-flex align-items-center gap-2 py-1 text-muted small fst-italic">' +
                                '<span style="width:1.5rem" class="text-end">' + seat + '.</span>' +
                                '<span class="flex-grow-1">Ledig plats</span>' +
                                '<button class="btn btn-outline-primary btn-sm py-0 px-1" onclick="faltShowAddShooter(' + patrol.patrolId + ',\'' + wgEsc + '\')" title="Lägg till skytt"><i class="bi bi-person-plus"></i></button>' +
                                '</div>';
                            continue;
                        }
                        html += '<div class="d-flex align-items-center gap-2 py-1 falt-member-row" data-pm-id="' + m.patrolMemberId + '">' +
                            '<span style="width:1.5rem" class="text-end text-muted small">' + seat + '.</span>' +
                            '<input type="checkbox" class="form-check-input falt-member-check" data-pm-id="' + m.patrolMemberId + '" onchange="faltUpdateBulkBar()">' +
                            '<span class="flex-grow-1 small">' + hpskEsc(m.name) + ' <span class="text-muted">(' + hpskEsc(m.club) + ')</span>' +
                            ' <span class="badge bg-body-secondary text-body">' + hpskEsc(window.getShootingClassName(m.shootingClass)) + '</span>' + faltOutsideBadge(m) + '</span>' +
                            '<button class="btn btn-outline-secondary btn-sm py-0 px-1"' + (seat <= 1 ? ' disabled' : '') + ' onclick="faltSetPosition(' + m.patrolMemberId + ',' + (seat - 1) + ')" title="Flytta upp en plats"><i class="bi bi-arrow-up"></i></button>' +
                            '<button class="btn btn-outline-secondary btn-sm py-0 px-1"' + (seat >= maxSeat ? ' disabled' : '') + ' onclick="faltSetPosition(' + m.patrolMemberId + ',' + (seat + 1) + ')" title="Flytta ner en plats"><i class="bi bi-arrow-down"></i></button>' +
                            '<button class="btn btn-outline-warning btn-sm py-0 px-1" onclick="faltSetDns(' + m.patrolMemberId + ',true)" title="Markera DNS – platsen blir ledig">DNS</button>' +
                            '<button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="faltRemoveShooter(' + m.patrolMemberId + ')" title="Ta bort"><i class="bi bi-x"></i></button>' +
                            '</div>';
                    }
                    dnsMembers.forEach(function(m) {
                        html += '<div class="d-flex align-items-center gap-2 py-1 falt-member-row opacity-50" data-pm-id="' + m.patrolMemberId + '">' +
                            '<span style="width:1.5rem"></span>' +
                            '<input type="checkbox" class="form-check-input falt-member-check" data-pm-id="' + m.patrolMemberId + '" onchange="faltUpdateBulkBar()">' +
                            '<span class="flex-grow-1 small">' + hpskEsc(m.name) + ' <span class="text-muted">(' + hpskEsc(m.club) + ')</span>' +
                            ' <span class="badge bg-body-secondary text-body">' + hpskEsc(window.getShootingClassName(m.shootingClass)) + '</span>' + faltOutsideBadge(m) +
                            ' <span class="badge bg-secondary">DNS</span></span>' +
