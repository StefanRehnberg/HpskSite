    window.faltPublish = async function(pub) {
        // Kryssrutan "stäng självanmälan" hör bara till publiceringen. Vid AVpublicering skickas
        // close som null: grinden är härledd (val OCH publicerad lista), så anmälan öppnas igen av
        // sig själv, och att nollställa valet här vore att radera inställningen som sidoeffekt.
        var close = null;
        var groups = null;
        if (pub) {
            // Per vapengrupp ("C först, B senare"): en kryssruta per grupp som finns i listan; de som redan är publicerade är förkryssade.
            var codes = []; (allPatrols || []).forEach(function(p) { String(p.weaponGroup || '').split('+').forEach(function(c) { c = c.trim(); if (c && c !== '?' && codes.indexOf(c) < 0) codes.push(c); }); });
            codes.sort();
            var already = (publishedGroupsCsv || '').split(',').map(function(c) { return c.trim(); }).filter(Boolean);
            var res = await window.hpskAskPublishStartList({
                title: 'Publicera patrullistan',
                body: 'De valda grupperna blir synliga för alla på tävlingssidan, och skyttarna planerar efter tiderna. Publicerade grupper ligger fast och byggs inte om av patrullgeneratorn.',
                confirmLabel: 'Publicera',
                alreadyPublished: isPublished,
                currentlyClosed: window.hpskCloseRegistrationCurrent === true,
                groups: codes.length > 1 ? codes.map(function(c) { return { code: c, label: 'Vapengrupp ' + c, checked: !isPublished || already.length === 0 || already.indexOf(c) >= 0 }; }) : null
            });
            if (!res.proceed) return;
            close = res.close;
            groups = res.groups || null;
        } else {
            if (!(await faltConfirm('Avpublicera patrullistan?\n\nSjälvanmälan öppnas igen om den stängdes vid publiceringen.'))) return;
        }

        var data = await apiPost('PublishPatrolList', { competitionId: parseInt(compId), publish: pub, closeRegistration: close, groups: groups });
        if (data.success) {
            isPublished = pub;
            publishedGroupsCsv = pub && groups && groups.length ? groups.join(',') : '';
            if (close === true || close === false) window.hpskCloseRegistrationCurrent = close;
            updatePublishUI();
            // Servern svarar success även när patrullistan publicerades men inställningen inte kunde
            // sparas (t.ex. saknad doctype-egenskap) — den varningen får inte gå tyst förbi.
            if (data.message) await faltNotice(data.message);
        } else { await faltNotice('Fel: ' + (data.message || 'Okänt fel')); }
    };

