    window.faltEditPatrol = async function(patrolId, currentTime, currentLabel) {
        if (!(await confirmIfResultsExist('Redigera patrull'))) return;
        // EN dialog med båda fälten (förut två webbläsarrutor efter varandra).
        var vals = await faltAsk({
            title: 'Redigera patrull',
            okText: 'Spara',
            inputs: [
                { label: 'Starttid (HH:mm) — lämna tomt för att inte ändra', value: currentTime || '', placeholder: '09:30' },
                { label: 'Namn / dag (valfritt, t.ex. "Lördag fm")', value: currentLabel || '' }
            ],
            validate: function(v) {
                var t = (v[0] || '').trim();
                if (t === '') return null;
                var m = /^([01]?\d|2[0-3]):([0-5]\d)$/.exec(t);
                return m ? null : 'Ogiltig tid. Använd HH:mm, till exempel 09:30.';
            }
        });
        if (vals === null) return;
        var dt = null;
        var newTime = (vals[0] || '').trim();
        if (newTime !== '') {
            var parts = newTime.split(':');
            dt = new Date();
            dt.setHours(parseInt(parts[0]) || 9, parseInt(parts[1]) || 0, 0, 0);
        }
        var data = await apiPost('UpdatePatrolTime', { competitionId: parseInt(compId), patrolId: patrolId, startTime: dt ? dt.toISOString() : null, label: vals[1] });
        if (data.success) loadFaltPatrols();
        else if (!data.cancelled) await faltNotice('Fel: ' + (data.message || 'Okänt fel'));
    };
