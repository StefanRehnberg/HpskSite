@{
    var clubId = ViewBag.clubId as int? ?? 0;
    var isClubAdmin = ViewBag.isClubAdmin as bool? ?? false;
}

<ul class="nav nav-tabs" id="clubPageTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="clubHome-tab" data-bs-toggle="tab" data-bs-target="#clubHome" type="button" role="tab" aria-controls="clubHome" aria-selected="true">
            <i class="bi bi-house-fill me-2"></i>Hem
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="clubAbout-tab" data-bs-toggle="tab" data-bs-target="#clubAbout" type="button" role="tab" aria-controls="clubAbout" aria-selected="false">
            <i class="bi bi-info-circle me-2"></i>Om Klubben
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="clubRanges-tab" data-bs-toggle="tab" data-bs-target="#clubRanges" type="button" role="tab" aria-controls="clubRanges" aria-selected="false">
            <i class="bi bi-geo-alt me-2"></i>Banor
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="clubCalendar-tab" data-bs-toggle="tab" data-bs-target="#clubCalendar" type="button" role="tab" aria-controls="clubCalendar" aria-selected="false">
            <i class="bi bi-calendar-event me-2"></i>Kalender
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="clubCompetitions-tab" data-bs-toggle="tab" data-bs-target="#clubCompetitions" type="button" role="tab" aria-controls="clubCompetitions" aria-selected="false">
            <i class="bi bi-trophy me-2"></i>Tävlingar
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="clubMembers-tab" data-bs-toggle="tab" data-bs-target="#clubMembers" type="button" role="tab" aria-controls="clubMembers" aria-selected="false">
            <i class="bi bi-people-fill me-2"></i>Medlemmar
            <span id="prospectBadge" class="badge bg-warning text-dark ms-2" style="display: none;"></span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="clubRecords-tab" data-bs-toggle="tab" data-bs-target="#clubRecords" type="button" role="tab" aria-controls="clubRecords" aria-selected="false">
            <i class="bi bi-award me-2"></i>Rekord
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="clubDocuments-tab" data-bs-toggle="tab" data-bs-target="#clubDocuments" type="button" role="tab" aria-controls="clubDocuments" aria-selected="false">
            <i class="bi bi-archive me-2"></i>Dokument
        </button>
    </li>
    @if (isClubAdmin)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="clubAdmin-tab" data-bs-toggle="tab" data-bs-target="#clubAdmin" type="button" role="tab" aria-controls="clubAdmin" aria-selected="false">
                <i class="bi bi-gear-fill me-2"></i>Admin
            </button>
        </li>
        <li class="nav-item ms-auto" role="presentation">
            <button class="btn btn-sm btn-outline-primary align-self-center mt-1" onclick="TutorialHelper.open('tutorial-07')" title="Se instruktionsvideo för klubbadministratörer">
                <i class="bi bi-play-circle me-1"></i>Guide
            </button>
        </li>
    }
</ul>
