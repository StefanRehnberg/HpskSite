// NEW SHOOTER-BASED NAVIGATION SYSTEM
// Results entry now works from registrations, with optional start list ordering

let shootersData = [];       // All shooters (from registrations)
let currentShooterIndex = 0; // Current position in shootersData
let hasStartList = false;    // Whether start list exists
let currentEntryOrder = @(isStationPage ? Html.Raw("'startlist'") : Html.Raw("'registration'")); // 'registration' or 'startlist'
let presetTeamNumber = @presetTeamNumber; // 0 = no preset, >0 = filter to this team on station page
let currentSeries = 1;
let currentUserId = null;    // Will be set when page loads

// Per-officer position-range filter. Stored in localStorage so when the same browser
// reopens any team in this competition, only shooters in officerRangeStart..officerRangeEnd
// are visible. null = no filter (show whole team).
let officerRangeStart = null;
let officerRangeEnd = null;

// Legacy support - keep startListData for some existing functions
let startListData = null;
let currentTeam = 1;
let currentPosition = 1;

// ----- Per-officer position range (localStorage) -----
// Key includes phase so finals (which has its own teams + position numbering) gets its
// own range. Team isn't in the key — officers handle the same physical positions across
// all teams in a competition, so the same range applies to Lag 1, Lag 2, etc.
function officerRangeStorageKey() {
    var compId = competitionData.competitionId || $('.competition-results-management').data('competition-id') || '0';
    var phase = (competitionData.currentPhase === 'finals') ? 'finals' : 'qualification';
    return 'hpsk_officer_range_' + compId + '_' + phase;
}
function loadOfficerRangeFromStorage() {
    try {
        var raw = localStorage.getItem(officerRangeStorageKey());
        if (!raw) { officerRangeStart = null; officerRangeEnd = null; return; }
        var parsed = JSON.parse(raw);
        officerRangeStart = (parsed && Number.isFinite(parsed.start)) ? parsed.start : null;
        officerRangeEnd   = (parsed && Number.isFinite(parsed.end))   ? parsed.end   : null;
    } catch (e) { officerRangeStart = null; officerRangeEnd = null; }
}
function saveOfficerRangeToStorage() {
    try {
        if (officerRangeStart != null && officerRangeEnd != null) {
            localStorage.setItem(officerRangeStorageKey(),
                JSON.stringify({ start: officerRangeStart, end: officerRangeEnd }));
        } else {
            localStorage.removeItem(officerRangeStorageKey());
        }
    } catch (e) { /* localStorage unavailable — silent */ }
}
// Filter shootersData in place to officer's range. Called after the team filter so it
// applies on top of presetTeamNumber filtering. No-op if range isn't set/valid.
function applyOfficerRange() {
    if (officerRangeStart == null || officerRangeEnd == null) return;
    if (officerRangeStart < 1 || officerRangeEnd < officerRangeStart) return;
    shootersData = shootersData.filter(function(s) {
        var p = s.position || 0;
        return p >= officerRangeStart && p <= officerRangeEnd;
    });
}

function loadCompetitionData() {
    const competitionId = $('.competition-results-management').data('competition-id');

    // Get current user ID first
    fetch('/umbraco/surface/CompetitionResults/GetCurrentUserId')
    .then(response => response.json())
    .then(userResponse => {
        if (userResponse.success) {
            currentUserId = userResponse.userId;
            console.log('Current user ID:', currentUserId);
        } else {
            console.error('Failed to get current user ID:', userResponse.message);
            currentUserId = 1; // Fallback
        }
    })
    .catch(error => {
        console.error('Error getting current user ID:', error);
        currentUserId = 1; // Fallback
    });

    // Update competition data
    competitionData.competitionId = competitionId;
    competitionData.competitionType = 'Precision';

    // Phase is locked at load by the URL (?phase=finals on the Finals skjutlag buttons).
    // Read it now so we can skip the qualifying-shooter fetch when entering finals scores.
    var rootEl = document.querySelector('.competition-results-management');
    var presetPhase = (rootEl && rootEl.dataset && rootEl.dataset.presetPhase) || 'qualification';
    competitionData.currentPhase = presetPhase === 'finals' ? 'finals' : 'qualification';

    // Restore the officer's saved range filter (per competition+phase) — applied after the
    // team filter in the loadShooters / loadFinalsStartList callbacks.
    loadOfficerRangeFromStorage();

    if (competitionData.currentPhase === 'finals') {
        // initializePhaseSelector() (fires below) will call loadFinalsStartList() which
        // populates shootersData from the finals start list directly.
        return;
    }

    // Load shooters from registrations (new approach - no start list required)
    loadShooters(currentEntryOrder);
}

// Load shooters from registrations (called on page load and when order changes)
function loadShooters(orderBy = 'registration') {
    const competitionId = $('.competition-results-management').data('competition-id');

    console.log('Loading shooters for competition', competitionId, 'orderBy:', orderBy);

    fetch(`/umbraco/surface/CompetitionResults/GetShootersForResultsEntry?competitionId=${competitionId}&orderBy=${orderBy}`)
        .then(response => response.json())
        .then(data => {
            console.log('GetShootersForResultsEntry response:', data);

            if (data.success) {
                shootersData = data.shooters;
                hasStartList = data.hasStartList;
                currentEntryOrder = orderBy;

                // If start list order requested but no start list exists
                if (orderBy === 'startlist' && !hasStartList) {
                    alert('Ingen startlista finns. Skyttar visas i anmälningsordning.');
                    document.getElementById('entryOrderSelect').value = 'registration';
                    currentEntryOrder = 'registration';
                }

                // Station page: filter to preset team and update header
                if (presetTeamNumber > 0 && shootersData.length > 0) {
                    var teamShooters = shootersData.filter(function(s) { return s.teamNumber === presetTeamNumber; });
                    if (teamShooters.length > 0) {
                        shootersData = teamShooters;
                        // Update header with team info. Use "Final N" prefix when this entry
                        // page was opened from a finals skjutlag button (?phase=finals).
                        var labelEl = document.getElementById('presetTeamLabel');
                        if (labelEl) {
                            var startTime = teamShooters[0].startTime || '';
                            var prefix = competitionData.currentPhase === 'finals' ? 'Final ' : 'Lag ';
                            labelEl.textContent = prefix + presetTeamNumber + (startTime ? ' (' + startTime + ')' : '');
                        }
                    }
                    // Officer range filter sits on top of the team filter.
                    applyOfficerRange();
                    currentShooterIndex = 0;
                }
                else {
                    // Restore last session or start from first shooter
                    restoreLastSession();
                }

                // Update display
                updateShooterDisplay();
                loadCurrentShooterByIndex();

                console.log('Loaded', shootersData.length, 'shooters');
            } else {
                showNoShootersError(data.message || 'Kunde inte ladda skyttar för resultatinmatning.');
            }
        })
        .catch(error => {
            console.error('Error loading shooters:', error);
            showNoShootersError('Ett fel uppstod vid laddning av skyttar: ' + error.message);
        });
}

// Change entry order
function changeEntryOrder() {
    const orderBy = document.getElementById('entryOrderSelect').value;
    // Reset to first shooter when changing order
    currentShooterIndex = 0;
    // Load shooters - warning will be shown by loadShooters() if no start list exists
    loadShooters(orderBy);
