function navigateToPreviousSeries() {
    // Determine minimum series based on phase
    let minSeries = 1;
    if (competitionData.hasFinalsRound && competitionData.currentPhase === 'finals') {
        minSeries = competitionData.qualificationSeriesCount + 1;
    }
    
    if (currentSeries > minSeries) {
        currentSeries--;
        updateNavigationDisplays();
        loadCurrentShooter();
    }
}

function navigateToNextSeries() {
    if (!competitionData) return;
    
    // Determine maximum series based on phase
    let maxSeries = competitionData.numberOfSeries;
    if (competitionData.hasFinalsRound && competitionData.currentPhase === 'qualification') {
        maxSeries = competitionData.qualificationSeriesCount;
    }
    
    if (currentSeries < maxSeries) {
        currentSeries++;
        updateNavigationDisplays();
        loadCurrentShooter();
    }
}

// ========================================
// Finals Phase Management
// ========================================

let finalsStartListData = null;

// Phase is locked at page load by the URL (?phase=finals on the finals buttons in the
// Resultatinmatning section, anything else defaults to qualification). The in-page radio
// switcher was removed 2026-05-22; this function now just reads data-preset-phase and
// initiates the correct start-list load. There is no runtime toggle anymore.
function initializePhaseSelector() {
    if (!competitionData.hasFinalsRound) {
        return; // Nothing phase-specific to do when there's no finals round configured.
    }

    var root = document.querySelector('.competition-results-management');
    var preset = (root && root.dataset && root.dataset.presetPhase) || 'qualification';
    competitionData.currentPhase = preset === 'finals' ? 'finals' : 'qualification';

    // (populateSeriesDropdown / populateTeamsDropdown / populatePositionsDropdown
    //  reference seriesSelect/teamSelect/positionSelect DOM elements that no longer
    //  exist — they're orphaned from an older UI. Calling them throws a TypeError
    //  on the missing element and breaks the rest of the init chain. Skipped here.)

    if (competitionData.currentPhase === 'finals') {
        loadFinalsStartList();
    }

    console.log('Phase initialized (locked) to:', competitionData.currentPhase);
}

function loadFinalsStartList() {
    const competitionId = $('.competition-results-management').data('competition-id');

    console.log('Loading finals start list for competition', competitionId);

    fetch(`/umbraco/surface/PrecisionStartList/GetFinalsStartList?competitionId=${competitionId}`)
        .then(response => response.json())
        .then(data => {
            console.log('Finals start list response:', data);

            // GetFinalsStartList returns PascalCase property names (Success/Exists/StartList).
            // Other endpoints in the same controller return camelCase — accept both so the
            // function is robust to either casing convention.
            var ok = data.Success || data.success;
            var exists = data.Exists || data.exists;
            var sl = data.StartList || data.startList;

            if (ok && exists && sl) {
                finalsStartListData = sl;

                // Use finals start list as the current start list
                startListData = sl;

                // Reset to first finals series
                currentSeries = competitionData.qualificationSeriesCount + 1;
                currentTeam = 1;
                currentPosition = 1;

                // Synthesize shootersData from the finals start list teams. shape mirrors
                // what /GetShootersForResultsEntry returns for qualifying — same field names
                // so the rest of the entry UI (updateShooterDisplay, loadCurrentShooterByIndex,
                // save/load flows) works unchanged.
                var teams = sl.Teams || sl.teams || [];
                var allShooters = [];
                teams.forEach(function(t) {
                    var teamNum = t.TeamNumber != null ? t.TeamNumber : t.teamNumber;
                    var teamStart = t.StartTime || t.startTime || '';
                    var shooters = t.Shooters || t.shooters || [];
                    shooters.forEach(function(s) {
                        allShooters.push({
                            memberId: s.MemberId != null ? s.MemberId : s.memberId,
                            name: s.Name || s.name || '',
                            club: s.Club || s.club || '',
                            weaponClass: s.WeaponClass || s.weaponClass || '',
                            // ⚠️ The start list stores the class Id ("C_Vet_Y"); a result row
                            // stores the display Name ("C Vet Y"), which is what the qualifying
                            // path gets from GetShootersForResultsEntry. Posting the Id here gave
                            // the finalserier a different ShootingClass than the grundserier for
                            // every class where Id and Name differ, and the result list — grouped
                            // on (MemberId, ShootingClass) — listed the shooter twice.
                            shootingClass: window.getShootingClassName(s.WeaponClass || s.weaponClass || ''),
                            position: s.Position != null ? s.Position : s.position,
                            teamNumber: teamNum,
                            startTime: teamStart
                        });
                    });
                });

                // Filter to the team the admin opened (presetTeamNumber comes from ?s=N).
                if (presetTeamNumber > 0) {
                    var filtered = allShooters.filter(function(s) { return s.teamNumber === presetTeamNumber; });
                    shootersData = filtered.length > 0 ? filtered : allShooters;
                } else {
                    shootersData = allShooters;
                }
                // Officer range filter on top of the team filter.
                applyOfficerRange();
                hasStartList = true;
                currentShooterIndex = 0;

                // Update the header label to "Final N (HH:mm)".
                if (shootersData.length > 0) {
                    var labelEl = document.getElementById('presetTeamLabel');
                    if (labelEl) {
                        var st = shootersData[0].startTime || '';
                        labelEl.textContent = 'Final ' + presetTeamNumber + (st ? ' (' + st + ')' : '');
                    }
                }

                // Update UI — populateTeamsDropdown/populatePositionsDropdown skipped:
                // they reference orphan select elements no longer in the markup.
                updateNavigationDisplays();
                updateShooterDisplay();
                loadCurrentShooterByIndex();

                console.log('Finals start list loaded successfully — ' + shootersData.length + ' shooters');
            } else {
                // The URL pinned us to finals but no finals start list exists. Tell the
                // admin — no in-page toggle to flip back to.
                alert('Ingen finalsstartlista finns. Skapa den först från Startlistor-fliken.');
            }
        })
        .catch(error => {
            console.error('Error loading finals start list:', error);
            alert('Ett fel uppstod vid laddning av finalsstartlistan: ' + error.message);
        });
}

function getCurrentStartList() {
    if (competitionData.hasFinalsRound && competitionData.currentPhase === 'finals') {
        return finalsStartListData || startListData;
    }
    return startListData;
}

function populateTeamsDropdown() {
    const teamSelect = document.getElementById('teamSelect');
    if (!teamSelect) return;

    teamSelect.innerHTML = '<option value="">Välj lag...</option>';

    const currentList = getCurrentStartList();
    if (!currentList || !currentList.teams) {
        return;
    }

    currentList.teams.forEach(team => {
        const option = document.createElement('option');
        option.value = team.teamNumber;

        if (competitionData.hasFinalsRound && competitionData.currentPhase === 'finals') {
            option.textContent = `Team F${team.teamNumber} (${team.shooterCount} shooters)`;
        } else {
            option.textContent = `Team ${team.teamNumber} (${team.shooterCount} shooters)`;
        }

        teamSelect.appendChild(option);
    });
}

function populatePositionsDropdown() {
    const positionSelect = document.getElementById('positionSelect');
    if (!positionSelect) return;

    positionSelect.innerHTML = '<option value="">Välj position...</option>';

    const currentList = getCurrentStartList();
    if (!currentList || !currentList.teams) {
        return;
    }

    const team = currentList.teams.find(t => t.teamNumber === currentTeam);
    if (!team || !team.shooters) {
        return;
    }

    team.shooters.forEach(shooter => {
        const option = document.createElement('option');
        option.value = shooter.position;
        option.textContent = `Pos ${shooter.position}: ${shooter.name || 'Unknown'} (${shooter.weaponClass || 'N/A'})`;
        positionSelect.appendChild(option);
    });
}

// Initialize phase selector when page loads
if (competitionData.hasFinalsRound) {
    // Wait a moment for DOM to be ready
    setTimeout(() => {
        initializePhaseSelector();
    }, 100);
}

// --- Change Shooter Class ---

// ── DNS / DNF ────────────────────────────────────────────────────────────────
// Records that a shooter will produce no further results, so a missing series stops being
// ambiguous between "still shooting", "never started" and "withdrew". The championship
// särskjutning gate reads this before it will decide a medal on a tie.
// The shooter keeps their placement on whatever they scored — this only explains the short total.

async function resSetParticipantStatus(memberId, shootingClass, status) {
    const label = status === 'DNS' ? 'ej start' : 'bruten';
    if (!confirm(`Markera skytten som ${label}? Skytten behåller sina inmatade serier och sin placering, men markeras i resultatlistan.`)) return;

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (!token) { alert('Säkerhetstoken saknas. Ladda om sidan och försök igen.'); return; }

    try {
        const r = await fetch('/umbraco/surface/CompetitionResults/SetParticipantStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId, memberId, shootingClass, status })
        });
        const d = await r.json();
        if (d.success || d.Success) {
            resRenderParticipantStatusBadge(d.label || d.Label);
            loadResultsList();
        } else {
            alert(d.message || d.Message || 'Statusen kunde inte sparas.');
        }
    } catch (e) {
        alert('Ett oväntat fel uppstod när statusen skulle sparas.');
    }
}

async function resClearParticipantStatus(memberId, shootingClass) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (!token) { alert('Säkerhetstoken saknas. Ladda om sidan och försök igen.'); return; }

    try {
        const r = await fetch('/umbraco/surface/CompetitionResults/ClearParticipantStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId, memberId, shootingClass })
        });
        const d = await r.json();
        if (d.success || d.Success) {
            resRenderParticipantStatusBadge(null);
            loadResultsList();
        } else {
            alert(d.message || d.Message || 'Hittade ingen status att ta bort.');
        }
    } catch (e) {
        alert('Ett oväntat fel uppstod när statusen skulle tas bort.');
    }
}

function resRenderParticipantStatusBadge(label) {
    const el = document.getElementById('shooterParticipantStatusBadge');
    if (!el) return;
    el.innerHTML = label
        ? `<span class="badge bg-warning text-dark">${label}</span>`
        : '';
}

function openChangeClassModal(memberId, name, currentClass) {
    document.getElementById('changeClassMemberId').value = memberId;
    document.getElementById('changeClassOldClass').value = currentClass;
    document.getElementById('changeClassShooterName').textContent = name;
    document.getElementById('changeClassCurrentBadge').textContent = currentClass;
    document.getElementById('changeClassShowAll').checked = false;

    // Reset dropdown
    const select = document.getElementById('changeClassNewSelect');
    select.value = '';

    // Determine weapon group from current class via the registry helper so A_opt_X resolves
    // to "A_Opt" instead of being lumped with plain A.
    const weaponType = window.getWeaponClassCode(currentClass);
    select.dataset.currentWeapon = weaponType;

    filterChangeClassOptions();

    var modal = new bootstrap.Modal(document.getElementById('changeClassModal'));
    modal.show();
}

function filterChangeClassOptions() {
    const select = document.getElementById('changeClassNewSelect');
    const showAll = document.getElementById('changeClassShowAll').checked;
    const weaponType = select.dataset.currentWeapon || '';
    const currentClass = document.getElementById('changeClassOldClass').value;

    const options = select.querySelectorAll('option[data-weapon]');
    options.forEach(opt => {
        // data-weapon already holds the WeaponClass enum value ("A", "A_Opt", "B", ...);
        // compare against weaponType directly so A and A_Opt are not treated as the same group.
        const optWeapon = opt.getAttribute('data-weapon') || '';

        if (showAll) {
            opt.style.display = '';
        } else {
            opt.style.display = (optWeapon === weaponType) ? '' : 'none';
        }

        // Disable the current class option
        opt.disabled = (opt.value === currentClass);
    });
}

function confirmChangeShooterClass() {
    const competitionId = parseInt($('.competition-results-management').data('competition-id'));
    const memberId = parseInt(document.getElementById('changeClassMemberId').value);
    const oldClass = document.getElementById('changeClassOldClass').value;
    const newClass = document.getElementById('changeClassNewSelect').value;

    if (!newClass) {
        alert('Välj en ny vapenklass.');
        return;
    }

    if (newClass === oldClass) {
        alert('Du har valt samma klass. Välj en annan klass.');
        return;
    }

    const btn = document.getElementById('btnConfirmChangeClass');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Ändrar...';
    btn.disabled = true;

    fetch('/umbraco/surface/CompetitionResults/ChangeShooterClass', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify({
            competitionId: competitionId,
            memberId: memberId,
            oldShootingClass: oldClass,
            newShootingClass: newClass
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Close modal
            var modal = bootstrap.Modal.getInstance(document.getElementById('changeClassModal'));
            if (modal) modal.hide();

            showSaveMessage(data.message, 'success');

            // Refresh shooter list and results
            loadShooters(currentEntryOrder);
            loadResultsList();
        } else {
            alert('Fel: ' + (data.message || 'Okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error changing class:', error);
        alert('Ett fel uppstod vid ändring av vapenklass.');
    })
    .finally(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
    });
}

