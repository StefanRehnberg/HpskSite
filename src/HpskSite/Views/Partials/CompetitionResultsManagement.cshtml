<!-- Class Merge Analysis Modal -->
<div class="modal fade" id="classMergeModal" tabindex="-1" aria-labelledby="classMergeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="classMergeModalLabel">
                    <i class="bi bi-arrows-collapse me-2"></i>Klasssammanslagning
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Klasser med färre än 5 deltagare kan slås samman med närmaste klass. Avmarkera för att behålla klassen separat.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle" id="classMergeTable">
                        <thead>
                            <tr>
                                <th>Klass</th>
                                <th class="text-center">Antal</th>
                                <th>Sammanslagning</th>
                                <th>Om ej sammanslagen</th>
                            </tr>
                        </thead>
                        <tbody id="classMergeTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Avbryt
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="submitCreateResultsListNoMerges()">
                    <i class="bi bi-arrow-clockwise me-1"></i>Skapa utan sammanslagning
                </button>
                <button type="button" class="btn btn-primary" onclick="applyMergesAndCreateResults()">
                    <i class="bi bi-check-circle me-1"></i>Skapa med sammanslagning
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Results Management JavaScript

// Toggle results entry section
function toggleResultsEntry(event) {
    // Prevent clicks on child elements from bubbling
    if (event && event.target !== event.currentTarget && !event.target.closest('.card-header')) {
        return;
    }
    
    const body = document.getElementById('resultsEntryBody');
    const chevron = document.getElementById('resultsEntryChevron');
    
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

async function createResultsList(event) {
    if (event) event.stopPropagation();

    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) { alert('Ingen tävling vald.'); return; }

    const button = event?.target?.closest('button');
    if (!button) return;
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyserar...';
    button.disabled = true;

    try {
        // Step 1: Analyze classes for merge suggestions
        const resp = await fetch(`/umbraco/surface/CompetitionResults/AnalyzeClassMerges?competitionId=${competitionId}`);
        const data = await resp.json();

        if (!data.success) {
            alert('Fel vid analys: ' + (data.message || 'Okänt fel'));
            return;
        }

        if (!data.classes || data.classes.length === 0) {
            // No results data yet
            if (confirm('Det finns inga resultat att bearbeta ännu. Vill du skapa en tom resultatlista?')) {
                submitCreateResultsList(competitionId, null);
            }
        } else if (data.suggestions && data.suggestions.length > 0) {
            // Show merge modal
            renderMergeModal(data.classes, data.suggestions);
            new bootstrap.Modal(document.getElementById('classMergeModal')).show();
        } else {
            // No merges needed — proceed directly
            if (confirm('Alla klasser har minst 5 deltagare. Vill du skapa/uppdatera resultatlistan?')) {
                submitCreateResultsList(competitionId, null);
            }
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid analys av klasser.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

// Dedicated "Sammanfoga klasser" button. Unlike "Uppdatera" (which only pops the
// merge modal automatically when a class has < 5 deltagare), this always opens the
// modal so an admin can review/merge classes on demand — including manually merging
// classes that each already have ≥ 5 participants.
async function showMergeAnalysisModal(event) {
    if (event) event.stopPropagation();

    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) { alert('Ingen tävling vald.'); return; }

    const button = event?.target?.closest('button');
    const originalText = button ? button.innerHTML : '';
    if (button) {
        button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyserar...';
        button.disabled = true;
    }

    try {
        const resp = await fetch(`/umbraco/surface/CompetitionResults/AnalyzeClassMerges?competitionId=${competitionId}`);
        const data = await resp.json();

        if (!data.success) {
            alert('Fel vid analys: ' + (data.message || 'Okänt fel'));
            return;
        }

        if (!data.classes || data.classes.length === 0) {
            alert('Det finns inga resultat att slå samman ännu. Klicka på "Uppdatera" för att skapa resultatlistan först.');
            return;
        }

        renderMergeModal(data.classes, data.suggestions || []);
        new bootstrap.Modal(document.getElementById('classMergeModal')).show();
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid analys av klasser.');
    } finally {
        if (button) {
            button.innerHTML = originalText;
            button.disabled = false;
        }
    }
}

function renderMergeModal(classes, suggestions) {
    const tbody = document.getElementById('classMergeTableBody');
    tbody.innerHTML = '';

    // Build a lookup for quick access
    const suggestionMap = {};
    suggestions.forEach(s => { suggestionMap[s.sourceClass] = s; });

    // Also track which classes are targets of other merges (to show "(ingår i sammanslagning ovan)")
    const mergeTargets = new Set();
    suggestions.forEach(s => {
        if (s.defaultTarget) mergeTargets.add(s.defaultTarget);
    });

    classes.forEach(cls => {
        const suggestion = suggestionMap[cls.className];
        const isMergeTarget = mergeTargets.has(cls.className) && !suggestion;
        const row = document.createElement('tr');

        if (cls.belowThreshold) {
            row.classList.add('table-warning');
        }

        // Class name
        const tdClass = document.createElement('td');
        tdClass.innerHTML = `<strong>${escapeHtml(cls.className)}</strong>`;
        row.appendChild(tdClass);

        // Count
        const tdCount = document.createElement('td');
        tdCount.className = 'text-center';
        if (cls.belowThreshold) {
            tdCount.innerHTML = `<span class="badge bg-warning text-dark">${cls.participantCount}</span>`;
        } else {
            tdCount.textContent = cls.participantCount;
        }
        row.appendChild(tdCount);

        // Merge action
        const tdMerge = document.createElement('td');
        if (suggestion) {
            const checkId = `merge_${cls.className.replace(/\s/g, '_')}`;
            let mergeHtml = `<div class="form-check d-inline-block">`;
            mergeHtml += `<input class="form-check-input merge-checkbox" type="checkbox" id="${checkId}" checked `;
            mergeHtml += `data-source="${escapeAttr(cls.className)}" `;

            if (suggestion.requiresAdminChoice) {
                // Dropdown for admin-choice classes
                mergeHtml += `data-requires-choice="true">`;
                mergeHtml += `<label class="form-check-label" for="${checkId}">Slå samman med </label>`;
                mergeHtml += `</div>`;
                mergeHtml += `<select class="form-select form-select-sm d-inline-block ms-1 merge-target-select" style="width: auto;" data-source="${escapeAttr(cls.className)}">`;
                suggestion.possibleTargets.forEach((t, i) => {
                    mergeHtml += `<option value="${escapeAttr(t)}">${escapeHtml(t)}</option>`;
                });
                mergeHtml += `</select>`;
            } else {
                // Fixed target
                mergeHtml += `data-target="${escapeAttr(suggestion.defaultTarget)}">`;
                mergeHtml += `<label class="form-check-label" for="${checkId}">Slå samman med <strong>${escapeHtml(suggestion.defaultTarget)}</strong></label>`;
                mergeHtml += `</div>`;
            }

            tdMerge.innerHTML = mergeHtml;
        } else {
            tdMerge.innerHTML = '<span class="text-muted">—</span>';
        }
        row.appendChild(tdMerge);

        // Medal impact
        const tdMedal = document.createElement('td');
        if (cls.medalImpact) {
            const isJunior = cls.className.includes('Jun');
            const badgeClass = isJunior ? 'bg-info' : (cls.participantCount <= 2 ? 'bg-danger' : 'bg-warning text-dark');
            tdMedal.innerHTML = `<span class="badge ${badgeClass} small">${escapeHtml(cls.medalImpact)}</span>`;
        } else {
            tdMedal.innerHTML = '<span class="text-muted">—</span>';
        }
        row.appendChild(tdMedal);

        tbody.appendChild(row);
    });
}

function collectMergeConfig() {
    const merges = [];
    document.querySelectorAll('.merge-checkbox:checked').forEach(cb => {
        const source = cb.dataset.source;
        let target;
        if (cb.dataset.requiresChoice === 'true') {
            const select = document.querySelector(`.merge-target-select[data-source="${source}"]`);
            target = select ? select.value : null;
        } else {
            target = cb.dataset.target;
        }
        if (source && target) {
            merges.push({ sourceClass: source, targetClass: target });
        }
    });
    return merges;
}

function applyMergesAndCreateResults() {
    const competitionId = $('.competition-results-management').data('competition-id');
    const merges = collectMergeConfig();
    bootstrap.Modal.getInstance(document.getElementById('classMergeModal')).hide();
    submitCreateResultsList(competitionId, merges.length > 0 ? merges : null);
}

function submitCreateResultsListNoMerges() {
    const competitionId = $('.competition-results-management').data('competition-id');
    bootstrap.Modal.getInstance(document.getElementById('classMergeModal')).hide();
    submitCreateResultsList(competitionId, null);
}

function submitCreateResultsList(competitionId, merges) {
    const btn = document.getElementById('btnCreateResultsList');
    if (btn) {
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Skapar...';
        btn.disabled = true;
    }

    const body = { competitionId: parseInt(competitionId) };
    if (merges) body.merges = merges;

    fetch('/umbraco/surface/CompetitionResults/CreateResultsList', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify(body)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSaveMessage('Resultatlistan har skapats/uppdaterats! (' + data.resultsCount + ' deltagare)', 'success');
            loadResultsList();
        } else {
            alert('Fel vid skapande av resultatlista: ' + (data.message || 'Okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Ett fel uppstod vid skapande av resultatlista.');
    })
    .finally(() => {
        if (btn) {
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Uppdatera';
            btn.disabled = false;
        }
    });
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

function escapeAttr(str) {
    return str.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

// Global variables
let currentResultsListData = null;
let currentResultPageUrl = null;

async function loadResultsList() {
    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) {
        console.error('No competition ID');
        return;
    }

    console.log('Loading results list for competition:', competitionId);

    try {
        const response = await fetch(`/umbraco/surface/CompetitionResults/GetResultsList?competitionId=${competitionId}`);
        const data = await response.json();

        console.log('Results list response:', data);

        const section = document.getElementById('resultsListSection');
        const body = document.getElementById('resultsListBody');
        const chevron = document.getElementById('resultsListChevron');
        const noResultsMessage = document.getElementById('noResultsMessage');
        const resultsDisplay = document.getElementById('resultsDisplay');
        const statusBadge = document.getElementById('resultsListStatusBadge');
        const summary = document.getElementById('resultsListSummary');
        const btnMarkOfficial = document.getElementById('btnMarkOfficial');
        const btnMarkPreliminary = document.getElementById('btnMarkPreliminary');

        if (data.success && data.exists) {
            currentResultsListData = data.results;

            // Show results list section (unless hidden by d-none class on station page)
            if (section && !section.classList.contains('d-none')) {
                section.style.display = 'block';

                // Auto-expand the section
                if (body && chevron) {
                    body.style.display = 'block';
                    chevron.classList.remove('bi-chevron-right');
                    chevron.classList.add('bi-chevron-down');
                    console.log('Results list section expanded');
                }
            }

            // Show results display, hide no-results message
            if (noResultsMessage) noResultsMessage.style.display = 'none';
            if (resultsDisplay) resultsDisplay.style.display = 'block';

            // Show status badge, summary, and action buttons
            if (statusBadge) statusBadge.style.display = 'inline-block';
            if (summary) summary.style.display = 'inline-block';
            if (btnMarkOfficial || btnMarkPreliminary) {
                updateResultsListStatus(data.isOfficial);
            }

            // Update summary
            const totalShooters = data.results.classGroups.reduce((sum, group) => sum + group.shooters.length, 0);
            const resultsCountEl = document.getElementById('resultsListCount');
            if (resultsCountEl) resultsCountEl.textContent = totalShooters;

            // Load the result page in iframe using the URL from API
            if (data.resultPageUrl) {
                currentResultPageUrl = data.resultPageUrl;
                const iframe = document.getElementById('resultsManagementIframe');
                if (iframe) {
                    iframe.src = currentResultPageUrl;
                }
            }

            // Refresh the Särskjutning card whenever the main result list changes.
            loadShootOffStatus(false);
        } else {
            console.log('No results list exists yet - success:', data.success, 'exists:', data.exists);

            // Section stays visible, but show "no results" message
            if (section) section.style.display = 'block';

            // Auto-expand to show the no-results message
            if (body && chevron) {
                body.style.display = 'block';
                chevron.classList.remove('bi-chevron-right');
                chevron.classList.add('bi-chevron-down');
            }

            // Show no-results message, hide results display
            if (noResultsMessage) noResultsMessage.style.display = 'block';
            if (resultsDisplay) resultsDisplay.style.display = 'none';

            // Hide status badge, summary, and action buttons
            if (statusBadge) statusBadge.style.display = 'none';
            if (summary) summary.style.display = 'none';
            if (btnMarkOfficial) btnMarkOfficial.style.display = 'none';
            if (btnMarkPreliminary) btnMarkPreliminary.style.display = 'none';
        }
    } catch (error) {
        console.error('Error loading results list:', error);
    }
}

function toggleResultsList(event) {
    // Prevent clicks on child elements from bubbling
    if (event && event.target !== event.currentTarget && !event.target.closest('.card-header')) {
        return;
    }
    
    const body = document.getElementById('resultsListBody');
    const chevron = document.getElementById('resultsListChevron');
    
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
        
        // Load results if not already loaded
        if (!currentResultsListData) {
            loadResultsList();
        }
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

function updateResultsListStatus(isOfficial) {
    const statusBadge = document.getElementById('resultsListStatusBadge');
    const btnMarkOfficial = document.getElementById('btnMarkOfficial');
    const btnMarkPreliminary = document.getElementById('btnMarkPreliminary');

    if (isOfficial) {
        // Official status
        statusBadge.className = 'badge bg-success fs-6 px-3 py-2';
        statusBadge.innerHTML = '<i class="bi bi-check-circle me-1"></i>Publicerad';
        btnMarkOfficial.style.display = 'none';
        btnMarkPreliminary.style.display = 'inline-block';
    } else {
        // Preliminary status
        statusBadge.className = 'badge bg-warning fs-6 px-3 py-2';
        statusBadge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Preliminär';
        btnMarkOfficial.style.display = 'inline-block';
        btnMarkPreliminary.style.display = 'none';
    }
}

async function markResultsOfficial(event) {
    if (event) event.stopPropagation();
    
    if (!confirm('Vill du markera resultatlistan som officiell?\n\nDetta kommer att göra resultaten synliga för alla.')) {
        return;
    }

    const competitionId = $('.competition-results-management').data('competition-id');
    const button = event?.target?.closest('button');
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...';
    button.disabled = true;

    try {
        const response = await fetch('/umbraco/surface/CompetitionResults/ToggleResultsOfficial', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ competitionId: parseInt(competitionId), isOfficial: true })
        });

        const data = await response.json();

        if (data.success) {
            showSaveMessage(data.message, 'success');
            updateResultsListStatus(data.isOfficial);
        } else {
            alert('Fel: ' + (data.message || 'Okänt fel'));
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid uppdatering av status.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

async function markResultsPreliminary(event) {
    if (event) event.stopPropagation();
    
    if (!confirm('Vill du återställa resultatlistan till preliminär status?')) {
        return;
    }

    const competitionId = $('.competition-results-management').data('competition-id');
    const button = event?.target?.closest('button');
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...';
    button.disabled = true;

    try {
        const response = await fetch('/umbraco/surface/CompetitionResults/ToggleResultsOfficial', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ competitionId: parseInt(competitionId), isOfficial: false })
        });

        const data = await response.json();

        if (data.success) {
            showSaveMessage(data.message, 'success');
            updateResultsListStatus(data.isOfficial);
        } else {
            alert('Fel: ' + (data.message || 'Okänt fel'));
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid uppdatering av status.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

function openResultsInNewTab(event) {
    if (event) event.stopPropagation();
    
    if (currentResultPageUrl) {
        window.open(currentResultPageUrl, '_blank');
    }
}

// ─── Deltävling (sub-competition) result handlers ──────────────────────────
// Mirror createResultsList / loadResultsList / markResults* but routed to the
// sub-comp slots (subCompetitionOnly=true / isSubCompetition=true). The merge
// modal is shared with the main flow — _subMergeContext tells the existing
// applyMergesAndCreateResults / submitCreateResultsListNoMerges handlers which
// path to take after the user clicks the modal's confirmation button.
let _subMergeContext = false;
let currentSubResultsListData = null;

async function createSubResultsList(event) {
    if (event) event.stopPropagation();

    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) { alert('Ingen tävling vald.'); return; }

    const button = event?.target?.closest('button');
    if (!button) return;
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyserar...';
    button.disabled = true;

    try {
        const resp = await fetch(`/umbraco/surface/CompetitionResults/AnalyzeClassMerges?competitionId=${competitionId}&subCompetitionOnly=true`);
        const data = await resp.json();

        if (!data.success) {
            alert('Fel vid analys: ' + (data.message || 'Okänt fel'));
            return;
        }

        if (!data.classes || data.classes.length === 0) {
            if (confirm('Det finns inga resultat i deltävlingen att bearbeta ännu. Vill du skapa en tom resultatlista?')) {
                submitCreateSubResultsList(competitionId, null);
            }
        } else if (data.suggestions && data.suggestions.length > 0) {
            _subMergeContext = true;
            renderMergeModal(data.classes, data.suggestions);
            new bootstrap.Modal(document.getElementById('classMergeModal')).show();
        } else {
            if (confirm('Alla klasser i deltävlingen har minst 5 deltagare. Vill du skapa/uppdatera deltävlingens resultatlista?')) {
                submitCreateSubResultsList(competitionId, null);
            }
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid analys av deltävlingens klasser.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

function showSubMergeAnalysisModal(event) {
    // Same flow as the toolbar's "Uppdatera" — Sammanslagning is just an alias
    // for re-running the analysis + applying merges in one click.
    createSubResultsList(event);
}

function submitCreateSubResultsList(competitionId, merges) {
    const btn = document.getElementById('btnCreateSubResultsList');
    if (btn) {
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Skapar...';
        btn.disabled = true;
    }

    const body = { competitionId: parseInt(competitionId), isSubCompetition: true };
    if (merges) body.merges = merges;

    fetch('/umbraco/surface/CompetitionResults/CreateResultsList', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify(body)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSaveMessage('Deltävlingens resultatlista har uppdaterats! (' + data.resultsCount + ' deltagare)', 'success');
            loadSubResultsList();
        } else {
            alert('Fel vid skapande av resultatlista: ' + (data.message || 'Okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Ett fel uppstod vid skapande av deltävlingens resultatlista.');
    })
    .finally(() => {
        if (btn) {
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Uppdatera';
            btn.disabled = false;
        }
    });
}

async function loadSubResultsList() {
    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) return;

    try {
        const response = await fetch(`/umbraco/surface/CompetitionResults/GetResultsList?competitionId=${competitionId}&subCompetitionOnly=true`);
        const data = await response.json();

        const section = document.getElementById('subResultsListSection');
        if (!section) return;

        const noResultsMessage = document.getElementById('subNoResultsMessage');
        const resultsDisplay = document.getElementById('subResultsDisplay');
        const statusBadge = document.getElementById('subResultsListStatusBadge');
        const btnMarkOfficial = document.getElementById('btnSubMarkOfficial');
        const btnMarkPreliminary = document.getElementById('btnSubMarkPreliminary');

        if (data.success && data.exists) {
            currentSubResultsListData = data.results;
            section.style.display = 'block';
            if (noResultsMessage) noResultsMessage.style.display = 'none';
            if (resultsDisplay) resultsDisplay.style.display = 'block';
            if (statusBadge) statusBadge.style.display = 'inline-block';
            updateSubResultsListStatus(data.isOfficial);

            if (data.resultPageUrl) {
                const iframe = document.getElementById('subResultsManagementIframe');
                if (iframe) iframe.src = data.resultPageUrl + (data.resultPageUrl.indexOf('?') >= 0 ? '&' : '?') + 'sub=true';
            }

            // Refresh sub-comp Särskjutning card whenever the sub list changes.
            loadShootOffStatus(true);
        } else {
            section.style.display = 'block';
            if (noResultsMessage) noResultsMessage.style.display = 'block';
            if (resultsDisplay) resultsDisplay.style.display = 'none';
            if (statusBadge) statusBadge.style.display = 'none';
            if (btnMarkOfficial) btnMarkOfficial.style.display = 'none';
            if (btnMarkPreliminary) btnMarkPreliminary.style.display = 'none';
        }
    } catch (error) {
        console.error('Error loading sub-comp results list:', error);
    }
}

// ─── Särskjutning (shoot-off) card ───────────────────────────────────────────
// Refreshes the tied-medal-positions card. Always called with isSub=false for the
// main pool and isSub=true for the Deltävling pool. Server returns an empty
// list for non-championship competitions, which keeps the card hidden.

async function loadShootOffStatus(isSub) {
    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) return;

    const sectionId = isSub ? 'subShootOffSection' : 'shootOffSection';
    const bodyId = isSub ? 'subShootOffBody' : 'shootOffBody';
    const badgeId = isSub ? 'subShootOffStatusBadge' : 'shootOffStatusBadge';

    const section = document.getElementById(sectionId);
    const body = document.getElementById(bodyId);
    const badge = document.getElementById(badgeId);
    if (!section || !body) return;

    const url = `/umbraco/surface/CompetitionResults/GetShootOffStatus?competitionId=${competitionId}&subCompetitionOnly=${isSub ? 'true' : 'false'}`;
    try {
        const response = await fetch(url);
        const data = await response.json();
        if (!data.success || !data.classGroups || data.classGroups.length === 0) {
            section.style.display = 'none';
            return;
        }

        section.style.display = 'block';
        // Count contested medal positions across all tied groups. Contested = a medal slot
        // (rank ≤ 3) whose owning shooter has not yet been uniquely separated from their
        // tied opponents. Decided + Contested = total medal slots in tied groups.
        let unresolvedPositions = 0;
        let totalMedalSlots = 0;
        data.classGroups.forEach(cg => {
            (cg.groups || []).forEach(g => {
                const medalSlots = Math.max(0, Math.min(g.lastRank, 3) - g.firstRank + 1);
                const unresolvedShooters = (g.shooters || []).filter(s => !s.isResolved).length;
                // Cap at medalSlots — shooters who'd end up at rank ≥ 4 don't add to medal contests.
                const contestedHere = Math.min(unresolvedShooters, medalSlots);
                unresolvedPositions += contestedHere;
                totalMedalSlots += medalSlots;
            });
        });
        if (badge) {
            if (unresolvedPositions > 0) {
                badge.className = 'badge bg-warning text-dark';
                badge.textContent = `${unresolvedPositions} medaljplats(er) kvar att avgöra`;
            } else {
                badge.className = 'badge bg-success';
                badge.textContent = `${totalMedalSlots} medaljplats(er) avgjorda`;
            }
        }

        body.innerHTML = '';
        data.classGroups.forEach(cg => {
            const cgWrap = document.createElement('div');
            cgWrap.className = 'mb-3';
            cgWrap.innerHTML = `<div class="fw-bold mb-1">Klass ${escapeHtml(cg.className)}</div>`;

            cg.groups.forEach(g => {
                const card = renderShootOffGroup(competitionId, cg.className, g, isSub);
                cgWrap.appendChild(card);
            });
            body.appendChild(cgWrap);
        });
    } catch (e) {
        console.error('Error loading shoot-off status:', e);
        section.style.display = 'none';
    }
}

function renderShootOffGroup(competitionId, className, group, isSub) {
    const wrap = document.createElement('div');
    wrap.className = 'border rounded p-2 mb-2 bg-body-tertiary';

    const tierBadge = group.resolved
        ? `<span class="badge bg-success">${escapeHtml(group.medalTier)} avgjord</span>`
        : `<span class="badge bg-warning text-dark">${escapeHtml(group.medalTier)} – kvar att avgöra</span>`;
    const header = document.createElement('div');
    header.className = 'd-flex justify-content-between align-items-center mb-2';
    header.innerHTML = `${tierBadge} <span class="text-muted small">Lika poäng: ${group.totalScore}</span>`;
    wrap.appendChild(header);

    group.shooters.forEach(s => {
        const row = document.createElement('div');
        row.className = 'd-flex align-items-center gap-2 flex-wrap mb-1';
        const roundsSummary = (s.rounds || [])
            .map(r => `R${r.round}: <strong>${r.total}</strong>${r.xCount ? ` (${r.xCount}X)` : ''}`)
            .join(' · ');
        row.innerHTML = `
            <div style="min-width: 200px;"><strong>${escapeHtml(s.name)}</strong> <span class="text-muted small">${escapeHtml(s.club || '')}</span></div>
            <div class="text-muted small flex-grow-1">${roundsSummary || '<em>Inga särskjutningsskott</em>'}</div>
        `;

        // Progressive resolution per shooter:
        //  - IsResolved → placement decided; show ✓ Avgjord
        //  - NextRound  → must shoot this round; show entry button
        //  - else       → has shot the current round but tied opponents haven't; show "Väntar"
        const actionEl = document.createElement('div');
        actionEl.className = 'd-flex align-items-center gap-2';

        if (s.isResolved) {
            actionEl.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Avgjord</span>`;
        } else if (s.nextRound) {
            const openBtn = document.createElement('button');
            openBtn.className = 'btn btn-outline-primary btn-sm';
            openBtn.innerHTML = `<i class="bi bi-pencil-square me-1"></i>Resultat...`;
            openBtn.addEventListener('click', () => {
                openShootOffEntryModal({
                    competitionId,
                    memberId: s.memberId,
                    shooterName: s.name,
                    shootingClass: s.shootingClass,
                    round: s.nextRound,
                    isSub
                });
            });
            actionEl.appendChild(openBtn);
        } else {
            actionEl.innerHTML = `<span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-hourglass-split me-1"></i>Väntar på övriga</span>`;
        }
        row.appendChild(actionEl);

        wrap.appendChild(row);
    });

    return wrap;
}

async function saveShootOffEntry(competitionId, memberId, shootingClass, round, shots, isSub) {
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const response = await fetch('/umbraco/surface/CompetitionResults/SaveShootOffEntry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({
                competitionId: parseInt(competitionId, 10),
                memberId, shootingClass, round, shots
            })
        });
        const data = await response.json();
        if (!data.Success && !data.success) {
            alert('Kunde inte spara: ' + (data.Message || data.message || 'okänt fel'));
            return false;
        }
        // Refresh the iframe (so badges/footnotes update) and the card itself.
        await (isSub ? loadSubResultsList() : loadResultsList());
        return true;
    } catch (e) {
        alert('Fel: ' + e);
        return false;
    }
}

// ── Särskjutning shot-entry modal ────────────────────────────────────────────
// Mirrors the keypad UX from the regular Resultatinmatning view. Scoped to
// "so-" class names so it doesn't collide with the page's global
// .shot-btn / .shot-placeholder handlers.

// Den lokala CSS-injiceringen togs bort 2026-08-31: sifferpanelen och
// skottrutorna får sitt utseende ur den delade .sp-*-komponenten i
// wwwroot/css/theme.css. Bara .so-shots-grid behövs fortfarande, och den är
// ren layout (flex + gap) som sätts med Bootstrap-klasser i markupen ovan.

const _soModalState = {
    shots: ['', '', '', '', ''],
    // ⚠️ Samma re-entry-spärr som huvudpanelen. Utan den startar varje tryck under
    // det pågående anropet en egen sparning — jfr sparbuggen i resultatinmatningen
    // (rapporterad från banan 2026-08-30). Här stängs inte modalen förrän svaret
    // kommit, så en dubbelsparning såg ut som att knappen inte fungerade.
    saving: false,
    cursor: 0,
    keysBound: false,
    bsModal: null
};

function openShootOffEntryModal(ctx) {
    const modalEl = document.getElementById('shootOffEntryModal');
    if (!modalEl) return;

    document.getElementById('soModalRound').textContent = String(ctx.round);
    document.getElementById('soModalShooter').textContent = ctx.shooterName || '';
    document.getElementById('soModalCompetitionId').value = String(ctx.competitionId);
    document.getElementById('soModalMemberId').value = String(ctx.memberId);
    document.getElementById('soModalClass').value = ctx.shootingClass || '';
    document.getElementById('soModalRoundValue').value = String(ctx.round);
    document.getElementById('soModalIsSub').value = ctx.isSub ? '1' : '0';

    _soModalState.shots = ['', '', '', '', ''];
    _soModalState.cursor = 0;
    renderShootOffModal();

    bindShootOffModalHandlersOnce();

    _soModalState.bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
    _soModalState.bsModal.show();
}

function renderShootOffModal() {
    const placeholders = document.querySelectorAll('#shootOffEntryModal .so-shot-placeholder');
    let total = 0, xCount = 0;
    placeholders.forEach((el, i) => {
        const v = _soModalState.shots[i] || '';
        el.textContent = v || '_';
        el.classList.toggle('filled', !!v);
        el.classList.toggle('active', !v && i === _soModalState.cursor);
        if (v === 'X') { total += 10; xCount += 1; }
        else if (v !== '') { total += parseInt(v, 10) || 0; }
    });
    document.getElementById('soModalTotal').textContent = String(total);
    document.getElementById('soModalXCount').textContent = String(xCount);
    const allFilled = _soModalState.shots.every(s => s !== '');
    // Spärren måste respekteras här också — annars låser en omritning upp knappen
    // mitt i en pågående sparning.
    document.getElementById('soModalSave').disabled = !allFilled || _soModalState.saving;
}

function appendShootOffShot(value) {
    if (_soModalState.cursor >= 5) return;
    _soModalState.shots[_soModalState.cursor] = value;
    _soModalState.cursor++;
    renderShootOffModal();
}

function backspaceShootOffShot() {
    if (_soModalState.cursor > 0) {
        _soModalState.cursor--;
        _soModalState.shots[_soModalState.cursor] = '';
        renderShootOffModal();
    }
}

function clearShootOffShots() {
    _soModalState.shots = ['', '', '', '', ''];
    _soModalState.cursor = 0;
    const saveBtn = document.getElementById('soModalSave');
    if (saveBtn) {
        // Modalen återanvänds mellan rundor: utan detta står "✓ SPARAT" kvar över
        // en tömd panel nästa gång den öppnas.
        saveBtn.classList.remove('is-busy', 'is-done');
        saveBtn.textContent = 'SPARA';
    }
    renderShootOffModal();
}

function bindShootOffModalHandlersOnce() {
    if (_soModalState.keysBound) return;
    _soModalState.keysBound = true;

    // Keypad buttons
    document.querySelectorAll('#shootOffEntryModal .so-key').forEach(btn => {
        btn.addEventListener('click', () => appendShootOffShot(btn.getAttribute('data-value')));
    });
    document.getElementById('soModalClear').addEventListener('click', clearShootOffShots);
    document.getElementById('soModalBackspace').addEventListener('click', backspaceShootOffShot);

    // Save
    document.getElementById('soModalSave').addEventListener('click', async () => {
        if (_soModalState.saving) return;
        if (_soModalState.shots.some(s => !s)) return;

        const saveBtn = document.getElementById('soModalSave');
        _soModalState.saving = true;
        saveBtn.disabled = true;
        saveBtn.classList.add('is-busy');
        saveBtn.textContent = 'SPARAR…';
        try {
            const ok = await saveShootOffEntry(
                parseInt(document.getElementById('soModalCompetitionId').value, 10),
                parseInt(document.getElementById('soModalMemberId').value, 10),
                document.getElementById('soModalClass').value,
                parseInt(document.getElementById('soModalRoundValue').value, 10),
                _soModalState.shots.slice(),
                document.getElementById('soModalIsSub').value === '1'
            );
            if (ok) {
                saveBtn.classList.remove('is-busy');
                saveBtn.classList.add('is-done');
                saveBtn.textContent = '✓ SPARAT';
                if (_soModalState.bsModal) _soModalState.bsModal.hide();
            }
        } finally {
            _soModalState.saving = false;
            saveBtn.classList.remove('is-busy');
            if (!saveBtn.classList.contains('is-done')) saveBtn.textContent = 'SPARA';
            renderShootOffModal();
        }
    });

    // Keyboard support — only when the modal is visible.
    const modalEl = document.getElementById('shootOffEntryModal');
    document.addEventListener('keydown', (e) => {
        if (!modalEl.classList.contains('show')) return;
        const k = e.key;
        // Same mapping as the main keypad above — a ten needs its own key.
        if (/^[0-9]$/.test(k)) { e.preventDefault(); appendShootOffShot(k); return; }
        if (k === '+' || k === '-') { e.preventDefault(); appendShootOffShot('10'); return; }
        if (k === 'x' || k === 'X' || k === '*') { e.preventDefault(); appendShootOffShot('X'); return; }
        if (k === 'Backspace') { e.preventDefault(); backspaceShootOffShot(); return; }
        if (k === 'Enter') {
            e.preventDefault();
            const saveBtn = document.getElementById('soModalSave');
            if (!saveBtn.disabled) saveBtn.click();
        }
    });
}

function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function updateSubResultsListStatus(isOfficial) {
    const statusBadge = document.getElementById('subResultsListStatusBadge');
    const btnMarkOfficial = document.getElementById('btnSubMarkOfficial');
    const btnMarkPreliminary = document.getElementById('btnSubMarkPreliminary');
    if (!statusBadge) return;

    if (isOfficial) {
        statusBadge.className = 'badge bg-success fs-6 px-3 py-2';
        statusBadge.innerHTML = '<i class="bi bi-check-circle me-1"></i>Publicerad';
        if (btnMarkOfficial) btnMarkOfficial.style.display = 'none';
        if (btnMarkPreliminary) btnMarkPreliminary.style.display = 'inline-block';
    } else {
        statusBadge.className = 'badge bg-warning fs-6 px-3 py-2';
        statusBadge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Preliminär';
        if (btnMarkOfficial) btnMarkOfficial.style.display = 'inline-block';
        if (btnMarkPreliminary) btnMarkPreliminary.style.display = 'none';
    }
}

async function markSubResultsOfficial(event) {
    if (event) event.stopPropagation();
    if (!confirm('Vill du markera deltävlingens resultatlista som officiell?')) return;
    await toggleSubResultsOfficial(true, event);
}

async function markSubResultsPreliminary(event) {
    if (event) event.stopPropagation();
    if (!confirm('Vill du återställa deltävlingens resultatlista till preliminär?')) return;
    await toggleSubResultsOfficial(false, event);
}

async function toggleSubResultsOfficial(makeOfficial, event) {
    const competitionId = $('.competition-results-management').data('competition-id');
    const button = event?.target?.closest('button');
    const originalText = button?.innerHTML;
    if (button) { button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...'; button.disabled = true; }

    try {
        const response = await fetch('/umbraco/surface/CompetitionResults/ToggleResultsOfficial', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ competitionId: parseInt(competitionId), isOfficial: makeOfficial, isSubCompetition: true })
        });
        const data = await response.json();
        if (data.success) {
            showSaveMessage(data.message, 'success');
            updateSubResultsListStatus(data.isOfficial);
        } else {
            alert('Fel: ' + (data.message || 'Okänt fel'));
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid uppdatering av status.');
    } finally {
        if (button && originalText !== undefined) { button.innerHTML = originalText; button.disabled = false; }
    }
}

