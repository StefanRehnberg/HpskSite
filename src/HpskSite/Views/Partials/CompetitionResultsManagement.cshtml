@*
 * Competition Results Management Partial View
 * Handles results entry and management for a specific competition
*@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
    var subCompetitionName = ViewData["SubCompetitionName"]?.ToString() ?? "";
    var resultPageUrl = ViewData["ResultPageUrl"]?.ToString() ?? "";

    // Get values from ViewData with appropriate defaults
    var numberOfSeriesOrStations = ViewData["NumberOfSeriesOrStations"] as int?;
    var numberOfFinalSeries = ViewData["NumberOfFinalSeries"] as int?;
    
    // If ViewData is null/0, use sensible defaults (but log it)
    if (!numberOfSeriesOrStations.HasValue || numberOfSeriesOrStations.Value == 0)
    {
        System.Diagnostics.Debug.WriteLine($"WARNING: numberOfSeriesOrStations not set for competition {competitionId}, defaulting to 10");
        numberOfSeriesOrStations = 10;
    }
    
    if (!numberOfFinalSeries.HasValue)
    {
        System.Diagnostics.Debug.WriteLine($"WARNING: numberOfFinalSeries not set for competition {competitionId}, defaulting to 3");
        numberOfFinalSeries = 3;
    }
    
    var hasFinalsRound = numberOfFinalSeries > 0;
    var qualificationSeriesCount = hasFinalsRound ? (numberOfSeriesOrStations.Value - numberOfFinalSeries.Value) : numberOfSeriesOrStations.Value;
    var isStationPage = ViewData["IsStationPage"] != null && (bool)ViewData["IsStationPage"];
    var presetTeamNumber = ViewData["PresetTeamNumber"] as int? ?? 0;
    // Locked phase ("qualification" | "finals") set once by /station from ?phase=…
    // Drives which start list loads + which series rows are visible. No runtime toggle.
    var presetPhase = (ViewData["PresetPhase"] as string) == "finals" ? "finals" : "qualification";
    var isFinalsPhase = presetPhase == "finals";

    // Debug output
    System.Diagnostics.Debug.WriteLine($"CompetitionResultsManagement - Competition: {competitionId}");
    System.Diagnostics.Debug.WriteLine($"  numberOfSeriesOrStations: {numberOfSeriesOrStations}");
    System.Diagnostics.Debug.WriteLine($"  numberOfFinalSeries: {numberOfFinalSeries}");
    System.Diagnostics.Debug.WriteLine($"  hasFinalsRound: {hasFinalsRound}");
    System.Diagnostics.Debug.WriteLine($"  qualificationSeriesCount: {qualificationSeriesCount}");
}

<div class="competition-results-management" data-competition-id="@competitionId" data-preset-phase="@presetPhase">
    @if (!isStationPage)
    {
    <!-- Team Links — navigate to station page for result entry -->
    <div class="card mb-3">
        <div class="card-header py-2">
            <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold small"><i class="bi bi-pencil-square me-2"></i>Resultatinmatning</span>
            </div>
        </div>
        <div class="card-body py-2">
            <div class="d-flex flex-wrap gap-2" id="precisionTeamLinks">
                <span class="text-muted small">Laddar skjutlag...</span>
            </div>
            <!-- Finals skjutlag buttons (only when a finals start list exists) -->
            <div id="precisionFinalsTeamLinksWrapper" class="mt-3" style="display:none">
                <div class="fw-bold small text-muted mb-1"><i class="bi bi-trophy text-warning me-1"></i>Finalsskjutlag</div>
                <div class="d-flex flex-wrap gap-2" id="precisionFinalsTeamLinks"></div>
            </div>
        </div>
    </div>
    <script>
    (function() {
        var cid = '@competitionId';
        fetch('/umbraco/surface/PrecisionStartList/GetOfficialStartList?competitionId=' + cid)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var el = document.getElementById('precisionTeamLinks');
                var ok = data.Success || data.success;
                var sl = data.StartList || data.startList;
                if (!ok || !sl) {
                    el.innerHTML = '<span class="text-muted small">Ingen startlista publicerad. Skapa och publicera en startlista f\u00f6rst.</span>';
                    return;
                }
                // Load the full start list to get team details
                var slId = sl.Id || sl.id;
                return fetch('/umbraco/surface/PrecisionStartList/GetStartListForEditing?startListId=' + slId)
                    .then(function(r) { return r.json(); })
                    .then(function(slData) {
                        var cfg = slData.configuration || slData.Configuration;
                        var teams = cfg?.teams || cfg?.Teams;
                        if (!(slData.success || slData.Success) || !teams) {
                            el.innerHTML = '<span class="text-muted small">Kunde inte ladda skjutlag.</span>';
                            return;
                        }
                        el.innerHTML = '';
                        teams.forEach(function(team) {
                            var teamNum = team.teamNumber || team.TeamNumber;
                            var startTime = team.startTime || team.StartTime || '';
                            var timeStr = startTime;
                            var a = document.createElement('a');
                            a.href = '/station?c=' + cid + '&s=' + teamNum;
                            a.className = 'btn btn-outline-primary btn-sm';
                            a.target = '_blank';
                            a.innerHTML = '<i class="bi bi-people me-1"></i>Lag ' + teamNum + (timeStr ? ' <small class="text-muted">(' + timeStr + ')</small>' : '');
                            el.appendChild(a);
                        });
                    });
            })
            .catch(function() {
                document.getElementById('precisionTeamLinks').innerHTML = '<span class="text-muted small">Kunde inte ladda skjutlag.</span>';
            });

        // Finals skjutlag (only when a finals start list exists). Same shape as qualifying
        // teams (Teams[].TeamNumber/Label/StartTime). The URL appends &phase=finals so the
        // entry partial loads the finals shooter ordering instead of the qualifying one.
        function escapeHtmlInline(s) { return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
        fetch('/umbraco/surface/PrecisionStartList/GetFinalsStartList?competitionId=' + cid)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var ok = data.Success || data.success;
                var exists = data.Exists || data.exists;
                if (!ok || !exists) return;
                var sl = data.StartList || data.startList;
                var teams = sl && (sl.Teams || sl.teams);
                if (!teams || !teams.length) return;

                var wrapper = document.getElementById('precisionFinalsTeamLinksWrapper');
                var el = document.getElementById('precisionFinalsTeamLinks');
                el.innerHTML = '';
                teams.forEach(function(team) {
                    var teamNum = team.teamNumber || team.TeamNumber;
                    var startTime = team.startTime || team.StartTime || '';
                    var label = team.label || team.Label || '';
                    var a = document.createElement('a');
                    a.href = '/station?c=' + cid + '&s=' + teamNum + '&phase=finals';
                    a.className = 'btn btn-outline-warning btn-sm';
                    a.target = '_blank';
                    a.innerHTML = '<i class="bi bi-trophy me-1"></i>Final ' + teamNum
                        + (label ? ' — ' + escapeHtmlInline(label) : '')
                        + (startTime ? ' <small class="text-muted">(' + escapeHtmlInline(startTime) + ')</small>' : '');
                    el.appendChild(a);
                });
                wrapper.style.display = '';
            })
            .catch(function() { /* finals are optional — fail silently */ });
    })();
    </script>
    }

    <!-- Precision Results Entry Section -->
    <div class="card" style="@(!isStationPage ? "display:none" : "")">
        @if (isStationPage)
        {
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-bullseye me-2"></i>Registrera Resultat — <span id="presetTeamLabel">@(isFinalsPhase ? $"Final {presetTeamNumber}" : $"Lag {presetTeamNumber}")</span>
                        @if (isFinalsPhase)
                        {
                            <span class="badge bg-warning text-dark ms-2"><i class="bi bi-trophy me-1"></i>Final</span>
                        }
                    </h5>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resultEntrySettingsModal" title="Inställningar">
                        <i class="bi bi-gear"></i>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="card-header" style="cursor: pointer;" onclick="toggleResultsEntry(event)">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-chevron-down me-2" id="resultsEntryChevron"></i>
                        <h5 class="mb-0"><i class="bi bi-bullseye me-2"></i>Registrera Resultat</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted">
                            <small><i class="bi bi-keyboard me-1"></i>Använd tangentbordet eller klicka på knapparna</small>
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#resultEntrySettingsModal" onclick="event.stopPropagation();" title="Inställningar">
                            <i class="bi bi-gear"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
        <div class="card-body" id="resultsEntryBody">
            @if (hasFinalsRound)
            {
                <!-- Phase indicator banner — drives which series are visible in the scoresheet -->
                <div class="alert @(isFinalsPhase ? "alert-warning" : "alert-primary") py-2 mb-3 small">
                    @if (isFinalsPhase)
                    {
                        <span><i class="bi bi-trophy me-2"></i><strong>Final</strong> &mdash; Serie F1&ndash;F@(numberOfFinalSeries)</span>
                    }
                    else
                    {
                        <span><i class="bi bi-list-ol me-2"></i><strong>Grundomgång</strong> &mdash; Serie 1&ndash;@qualificationSeriesCount</span>
                    }
                </div>
            }

            <!-- The two settings dropdowns moved into #resultEntrySettingsModal (cog button in the card header).
                 They keep their original ids/onchange so existing JS that reads their values still works. -->

            <div id="resultsEntryContainer">
                <div class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
                    <p class="text-muted mt-2">Laddar skyttar...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Results List Section (Collapsible) — hidden on station page -->
    @if (!isStationPage)
    {
    <div class="mt-3" id="resultsListSection">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex align-items-center gap-2" id="resultsListActions">
                <button class="btn btn-outline-primary btn-sm" onclick="createResultsList(event)" id="btnCreateResultsList">
                    <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                </button>
                <span class="badge bg-warning fs-6 px-3 py-2" id="resultsListStatusBadge" style="display: none;">
                    <i class="bi bi-exclamation-triangle me-1"></i>Preliminär
                </span>
                <button class="btn btn-success btn-sm" id="btnMarkOfficial" onclick="markResultsOfficial(event)" style="display: none;">
                    <i class="bi bi-check-circle me-1"></i>Publicera
                </button>
                <button class="btn btn-outline-warning btn-sm" id="btnMarkPreliminary" onclick="markResultsPreliminary(event)" style="display: none;">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Avpublicera
                </button>
                <span class="text-muted" id="resultsListSummary" style="display: none;">
                    <small><i class="bi bi-people me-1"></i><span id="resultsListCount">0</span> deltagare</small>
                </span>
            </div>
        </div>
        <div id="resultsListBody">
            <div id="noResultsMessage" class="text-center py-4" style="display: none;">
                <p class="text-muted">Klicka "Uppdatera" för att skapa en resultatlista.</p>
            </div>
            <div id="resultsDisplay" style="display: none;">
                <div id="resultsIframeContainer">
                    <iframe id="resultsManagementIframe" src="" style="width: 100%; height: 800px; border: 1px solid #dee2e6; border-radius: 0.375rem;"></iframe>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(subCompetitionName))
    {
    <!-- Deltävling Result List Section — mirrors the main Resultatlista section
         (collapsible, same toolbar) but routes every action through the sub-comp
         endpoints (subCompetitionOnly=true / isSubCompetition=true). The body embeds
         /resultat/?sub=true so the admin sees exactly what the public will see. -->
    <div class="mt-3" id="subResultsListSection">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>@subCompetitionName</h5>
            <div class="d-flex align-items-center gap-2" id="subResultsListActions">
                <button class="btn btn-outline-primary btn-sm" onclick="createSubResultsList(event)" id="btnCreateSubResultsList">
                    <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                </button>
                <button class="btn btn-outline-secondary btn-sm" onclick="showSubMergeAnalysisModal(event)" id="btnSubAnalyzeMerges">
                    <i class="bi bi-intersect me-1"></i>Sammanslagning...
                </button>
                <span class="badge bg-warning fs-6 px-3 py-2" id="subResultsListStatusBadge" style="display: none;">
                    <i class="bi bi-exclamation-triangle me-1"></i>Preliminär
                </span>
                <button class="btn btn-success btn-sm" id="btnSubMarkOfficial" onclick="markSubResultsOfficial(event)" style="display: none;">
                    <i class="bi bi-check-circle me-1"></i>Publicera
                </button>
                <button class="btn btn-outline-warning btn-sm" id="btnSubMarkPreliminary" onclick="markSubResultsPreliminary(event)" style="display: none;">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Avpublicera
                </button>
            </div>
        </div>
        <div id="subResultsListBody">
            <div id="subNoResultsMessage" class="text-center py-4" style="display: none;">
                <p class="text-muted">Klicka "Uppdatera" för att skapa en resultatlista för deltävlingen.</p>
            </div>
            <div id="subResultsDisplay" style="display: none;">
                <div id="subResultsIframeContainer">
                    <iframe id="subResultsManagementIframe" src="" style="width: 100%; height: 800px; border: 1px solid #dee2e6; border-radius: 0.375rem;"></iframe>
                </div>
            </div>
        </div>
    </div>
    }

    <!-- Särskjutning section — auto-populates for Championship competitions where any
         class has a tied total score at medal positions 1–3. The server-side gate runs
         in CompetitionResultsController.CalculateFinalResults using
         CompetitionScopeHelper.IsChampionshipScope, so this card stays hidden for
         non-championship competitions even though the markup is always rendered. -->
    <div class="mt-3" id="shootOffSection" style="display: none;">
        <div class="card border-info">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span class="fw-bold small"><i class="bi bi-bullseye me-2"></i>Särskjutning</span>
                <span class="badge bg-info-subtle text-info-emphasis" id="shootOffStatusBadge">Inga oavgjorda medaljplatser</span>
            </div>
            <div class="card-body py-3" id="shootOffBody">
                <div class="text-muted small">Laddar...</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(subCompetitionName))
    {
    <div class="mt-3" id="subShootOffSection" style="display: none;">
        <div class="card border-info">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span class="fw-bold small"><i class="bi bi-bullseye me-2"></i>Särskjutning – @subCompetitionName</span>
                <span class="badge bg-info-subtle text-info-emphasis" id="subShootOffStatusBadge">Inga oavgjorda medaljplatser</span>
            </div>
            <div class="card-body py-3" id="subShootOffBody">
                <div class="text-muted small">Laddar...</div>
            </div>
        </div>
    </div>
    }
    } @* end if !isStationPage *@
</div>

<!-- Change Shooter Class Modal -->
<div class="modal fade" id="changeClassModal" tabindex="-1" aria-labelledby="changeClassModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changeClassModalLabel">Ändra vapenklass</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="changeClassMemberId" />
                <input type="hidden" id="changeClassOldClass" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Skytt</label>
                    <div id="changeClassShooterName" class="form-control-plaintext"></div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Nuvarande klass</label>
                    <div><span id="changeClassCurrentBadge" class="badge bg-secondary fs-6"></span></div>
                </div>

                <div class="mb-3">
                    <label for="changeClassNewSelect" class="form-label fw-bold">Ny klass</label>
                    <select class="form-select" id="changeClassNewSelect">
                        <option value="">-- Välj ny klass --</option>
                        @foreach (var sc in HpskSite.Models.ShootingClasses.All)
                        {
                            <option value="@sc.Name" data-weapon="@sc.Weapon">@sc.Name - @sc.Description</option>
                        }
                    </select>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="changeClassShowAll" onchange="filterChangeClassOptions()">
                    <label class="form-check-label" for="changeClassShowAll">Visa alla vapenklasser</label>
                </div>

                <div class="alert alert-info small">
                    <i class="bi bi-info-circle me-1"></i>
                    Ändringen uppdaterar resultatrader i databasen, startlistan och anmälan. Resultatlistan omberäknas automatiskt.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-warning" id="btnConfirmChangeClass" onclick="confirmChangeShooterClass()">
                    <i class="bi bi-pencil-square me-1"></i>Ändra klass
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Särskjutning Shot Entry Modal — mirrors the keypad UX used in the regular Resultatinmatning
     view but scoped to "so-" class names so it doesn't collide with the global .shot-btn /
     .shot-placeholder handlers defined further down this partial. -->
<div class="modal fade" id="shootOffEntryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-bullseye me-2"></i>
                    Särskjutning runda <span id="soModalRound"></span> — <span id="soModalShooter"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="soModalCompetitionId" />
                <input type="hidden" id="soModalMemberId" />
                <input type="hidden" id="soModalClass" />
                <input type="hidden" id="soModalRoundValue" />
                <input type="hidden" id="soModalIsSub" />

                <div class="d-flex align-items-center justify-content-center gap-3 mb-3">
                    <div class="so-shots-grid">
                        <span class="so-shot-placeholder" data-shot="0">_</span>
                        <span class="so-shot-placeholder" data-shot="1">_</span>
                        <span class="so-shot-placeholder" data-shot="2">_</span>
                        <span class="so-shot-placeholder" data-shot="3">_</span>
                        <span class="so-shot-placeholder" data-shot="4">_</span>
                    </div>
                    <div class="d-flex align-items-center">
                        <span class="fw-bold me-2">=</span>
                        <span class="fs-5 fw-bold" id="soModalTotal">0</span>
                        <span class="ms-3 fw-bold">X:</span>
                        <span class="fs-5 fw-bold ms-1" id="soModalXCount">0</span>
                    </div>
                </div>

                <div class="so-keypad">
                    <div class="row g-2">
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="X">X</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="10">10</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="9">9</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="8">8</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="7">7</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="6">6</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="5">5</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="4">4</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="3">3</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="2">2</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="1">1</button></div>
                        <div class="col-4"><button type="button" class="btn btn-primary w-100 so-key" data-value="0">0</button></div>
                        <div class="col-6"><button type="button" class="btn btn-outline-danger w-100" id="soModalClear">RENSA</button></div>
                        <div class="col-6"><button type="button" class="btn btn-outline-secondary w-100" id="soModalBackspace"><i class="bi bi-backspace"></i> Ta bort</button></div>
                    </div>
                </div>

                <div class="text-muted small mt-2 text-center">Tangentbord: 0–9 / X för värde · Backspace för att ta bort · Enter för Spara · Esc för Avbryt</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-success" id="soModalSave" disabled>
                    <i class="bi bi-check-circle me-1"></i>Spara skott
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Result entry settings modal — Ordning + traversal mode. Same select ids/onchange
     as the inline controls they replace, so existing JS reading their values is unchanged. -->
<div class="modal fade" id="resultEntrySettingsModal" tabindex="-1" aria-labelledby="resultEntrySettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resultEntrySettingsModalLabel">
                    <i class="bi bi-gear me-2"></i>Inställningar
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="entryOrderSelect" class="form-label small">Ordning</label>
                    <select class="form-select form-select-sm" id="entryOrderSelect" onchange="changeEntryOrder()">
                        @if (isStationPage)
                        {
                            <option value="registration">Anmälningsordning (klass/namn)</option>
                            <option value="startlist" selected>Startlisteordning (lag/tid)</option>
                        }
                        else
                        {
                            <option value="registration" selected>Anmälningsordning (klass/namn)</option>
                            <option value="startlist">Startlisteordning (lag/tid)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="traversalModeSelect" class="form-label small">Efter Enter flytta till</label>
                    <select class="form-select form-select-sm" id="traversalModeSelect">
                        <option value="nextShooter">Nästa Skytt</option>
                        <option value="nextSeries">Nästa Serie</option>
                        <option value="stay">Stanna kvar</option>
                    </select>
                </div>
                <div class="mb-0">
                    <label class="form-label small">Mitt intervall</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Plats</span>
                        <input type="number" min="1" class="form-control" id="officerRangeStart" placeholder="från">
                        <span class="input-group-text">till</span>
                        <input type="number" min="1" class="form-control" id="officerRangeEnd" placeholder="till">
                        <button class="btn btn-outline-secondary" type="button" id="officerRangeClearBtn" title="Rensa intervall">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <small class="text-muted">Visa endast skyttar i detta platsintervall. Sparas i din webbläsare och gäller alla skjutlag i tävlingen.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Class Merge Analysis Modal -->
<div class="modal fade" id="classMergeModal" tabindex="-1" aria-labelledby="classMergeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="classMergeModalLabel">
                    <i class="bi bi-arrows-collapse me-2"></i>Klasssammanslagning
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Klasser med färre än 5 deltagare kan slås samman med närmaste klass. Avmarkera för att behålla klassen separat.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle" id="classMergeTable">
                        <thead>
                            <tr>
                                <th>Klass</th>
                                <th class="text-center">Antal</th>
                                <th>Sammanslagning</th>
                                <th>Om ej sammanslagen</th>
                            </tr>
                        </thead>
                        <tbody id="classMergeTableBody">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Avbryt
                </button>
                <button type="button" class="btn btn-outline-primary" onclick="submitCreateResultsListNoMerges()">
                    <i class="bi bi-arrow-clockwise me-1"></i>Skapa utan sammanslagning
                </button>
                <button type="button" class="btn btn-primary" onclick="applyMergesAndCreateResults()">
                    <i class="bi bi-check-circle me-1"></i>Skapa med sammanslagning
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// Results Management JavaScript

// Toggle results entry section
function toggleResultsEntry(event) {
    // Prevent clicks on child elements from bubbling
    if (event && event.target !== event.currentTarget && !event.target.closest('.card-header')) {
        return;
    }
    
    const body = document.getElementById('resultsEntryBody');
    const chevron = document.getElementById('resultsEntryChevron');
    
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

async function createResultsList(event) {
    if (event) event.stopPropagation();

    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) { alert('Ingen tävling vald.'); return; }

    const button = event?.target?.closest('button');
    if (!button) return;
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyserar...';
    button.disabled = true;

    try {
        // Step 1: Analyze classes for merge suggestions
        const resp = await fetch(`/umbraco/surface/CompetitionResults/AnalyzeClassMerges?competitionId=${competitionId}`);
        const data = await resp.json();

        if (!data.success) {
            alert('Fel vid analys: ' + (data.message || 'Okänt fel'));
            return;
        }

        if (!data.classes || data.classes.length === 0) {
            // No results data yet
            if (confirm('Det finns inga resultat att bearbeta ännu. Vill du skapa en tom resultatlista?')) {
                submitCreateResultsList(competitionId, null);
            }
        } else if (data.suggestions && data.suggestions.length > 0) {
            // Show merge modal
            renderMergeModal(data.classes, data.suggestions);
            new bootstrap.Modal(document.getElementById('classMergeModal')).show();
        } else {
            // No merges needed — proceed directly
            if (confirm('Alla klasser har minst 5 deltagare. Vill du skapa/uppdatera resultatlistan?')) {
                submitCreateResultsList(competitionId, null);
            }
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid analys av klasser.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

function renderMergeModal(classes, suggestions) {
    const tbody = document.getElementById('classMergeTableBody');
    tbody.innerHTML = '';

    // Build a lookup for quick access
    const suggestionMap = {};
    suggestions.forEach(s => { suggestionMap[s.sourceClass] = s; });

    // Also track which classes are targets of other merges (to show "(ingår i sammanslagning ovan)")
    const mergeTargets = new Set();
    suggestions.forEach(s => {
        if (s.defaultTarget) mergeTargets.add(s.defaultTarget);
    });

    classes.forEach(cls => {
        const suggestion = suggestionMap[cls.className];
        const isMergeTarget = mergeTargets.has(cls.className) && !suggestion;
        const row = document.createElement('tr');

        if (cls.belowThreshold) {
            row.classList.add('table-warning');
        }

        // Class name
        const tdClass = document.createElement('td');
        tdClass.innerHTML = `<strong>${escapeHtml(cls.className)}</strong>`;
        row.appendChild(tdClass);

        // Count
        const tdCount = document.createElement('td');
        tdCount.className = 'text-center';
        if (cls.belowThreshold) {
            tdCount.innerHTML = `<span class="badge bg-warning text-dark">${cls.participantCount}</span>`;
        } else {
            tdCount.textContent = cls.participantCount;
        }
        row.appendChild(tdCount);

        // Merge action
        const tdMerge = document.createElement('td');
        if (suggestion) {
            const checkId = `merge_${cls.className.replace(/\s/g, '_')}`;
            let mergeHtml = `<div class="form-check d-inline-block">`;
            mergeHtml += `<input class="form-check-input merge-checkbox" type="checkbox" id="${checkId}" checked `;
            mergeHtml += `data-source="${escapeAttr(cls.className)}" `;

            if (suggestion.requiresAdminChoice) {
                // Dropdown for admin-choice classes
                mergeHtml += `data-requires-choice="true">`;
                mergeHtml += `<label class="form-check-label" for="${checkId}">Slå samman med </label>`;
                mergeHtml += `</div>`;
                mergeHtml += `<select class="form-select form-select-sm d-inline-block ms-1 merge-target-select" style="width: auto;" data-source="${escapeAttr(cls.className)}">`;
                suggestion.possibleTargets.forEach((t, i) => {
                    mergeHtml += `<option value="${escapeAttr(t)}">${escapeHtml(t)}</option>`;
                });
                mergeHtml += `</select>`;
            } else {
                // Fixed target
                mergeHtml += `data-target="${escapeAttr(suggestion.defaultTarget)}">`;
                mergeHtml += `<label class="form-check-label" for="${checkId}">Slå samman med <strong>${escapeHtml(suggestion.defaultTarget)}</strong></label>`;
                mergeHtml += `</div>`;
            }

            tdMerge.innerHTML = mergeHtml;
        } else {
            tdMerge.innerHTML = '<span class="text-muted">—</span>';
        }
        row.appendChild(tdMerge);

        // Medal impact
        const tdMedal = document.createElement('td');
        if (cls.medalImpact) {
            const isJunior = cls.className.includes('Jun');
            const badgeClass = isJunior ? 'bg-info' : (cls.participantCount <= 2 ? 'bg-danger' : 'bg-warning text-dark');
            tdMedal.innerHTML = `<span class="badge ${badgeClass} small">${escapeHtml(cls.medalImpact)}</span>`;
        } else {
            tdMedal.innerHTML = '<span class="text-muted">—</span>';
        }
        row.appendChild(tdMedal);

        tbody.appendChild(row);
    });
}

function collectMergeConfig() {
    const merges = [];
    document.querySelectorAll('.merge-checkbox:checked').forEach(cb => {
        const source = cb.dataset.source;
        let target;
        if (cb.dataset.requiresChoice === 'true') {
            const select = document.querySelector(`.merge-target-select[data-source="${source}"]`);
            target = select ? select.value : null;
        } else {
            target = cb.dataset.target;
        }
        if (source && target) {
            merges.push({ sourceClass: source, targetClass: target });
        }
    });
    return merges;
}

function applyMergesAndCreateResults() {
    const competitionId = $('.competition-results-management').data('competition-id');
    const merges = collectMergeConfig();
    bootstrap.Modal.getInstance(document.getElementById('classMergeModal')).hide();
    submitCreateResultsList(competitionId, merges.length > 0 ? merges : null);
}

function submitCreateResultsListNoMerges() {
    const competitionId = $('.competition-results-management').data('competition-id');
    bootstrap.Modal.getInstance(document.getElementById('classMergeModal')).hide();
    submitCreateResultsList(competitionId, null);
}

function submitCreateResultsList(competitionId, merges) {
    const btn = document.getElementById('btnCreateResultsList');
    if (btn) {
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Skapar...';
        btn.disabled = true;
    }

    const body = { competitionId: parseInt(competitionId) };
    if (merges) body.merges = merges;

    fetch('/umbraco/surface/CompetitionResults/CreateResultsList', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify(body)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSaveMessage('Resultatlistan har skapats/uppdaterats! (' + data.resultsCount + ' deltagare)', 'success');
            loadResultsList();
        } else {
            alert('Fel vid skapande av resultatlista: ' + (data.message || 'Okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Ett fel uppstod vid skapande av resultatlista.');
    })
    .finally(() => {
        if (btn) {
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Uppdatera';
            btn.disabled = false;
        }
    });
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

function escapeAttr(str) {
    return str.replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

// Global variables
let currentResultsListData = null;
let currentResultPageUrl = null;

async function loadResultsList() {
    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) {
        console.error('No competition ID');
        return;
    }

    console.log('Loading results list for competition:', competitionId);

    try {
        const response = await fetch(`/umbraco/surface/CompetitionResults/GetResultsList?competitionId=${competitionId}`);
        const data = await response.json();

        console.log('Results list response:', data);

        const section = document.getElementById('resultsListSection');
        const body = document.getElementById('resultsListBody');
        const chevron = document.getElementById('resultsListChevron');
        const noResultsMessage = document.getElementById('noResultsMessage');
        const resultsDisplay = document.getElementById('resultsDisplay');
        const statusBadge = document.getElementById('resultsListStatusBadge');
        const summary = document.getElementById('resultsListSummary');
        const btnMarkOfficial = document.getElementById('btnMarkOfficial');
        const btnMarkPreliminary = document.getElementById('btnMarkPreliminary');

        if (data.success && data.exists) {
            currentResultsListData = data.results;

            // Show results list section (unless hidden by d-none class on station page)
            if (section && !section.classList.contains('d-none')) {
                section.style.display = 'block';

                // Auto-expand the section
                if (body && chevron) {
                    body.style.display = 'block';
                    chevron.classList.remove('bi-chevron-right');
                    chevron.classList.add('bi-chevron-down');
                    console.log('Results list section expanded');
                }
            }

            // Show results display, hide no-results message
            if (noResultsMessage) noResultsMessage.style.display = 'none';
            if (resultsDisplay) resultsDisplay.style.display = 'block';

            // Show status badge, summary, and action buttons
            if (statusBadge) statusBadge.style.display = 'inline-block';
            if (summary) summary.style.display = 'inline-block';
            if (btnMarkOfficial || btnMarkPreliminary) {
                updateResultsListStatus(data.isOfficial);
            }

            // Update summary
            const totalShooters = data.results.classGroups.reduce((sum, group) => sum + group.shooters.length, 0);
            const resultsCountEl = document.getElementById('resultsListCount');
            if (resultsCountEl) resultsCountEl.textContent = totalShooters;

            // Load the result page in iframe using the URL from API
            if (data.resultPageUrl) {
                currentResultPageUrl = data.resultPageUrl;
                const iframe = document.getElementById('resultsManagementIframe');
                if (iframe) {
                    iframe.src = currentResultPageUrl;
                }
            }

            // Refresh the Särskjutning card whenever the main result list changes.
            loadShootOffStatus(false);
        } else {
            console.log('No results list exists yet - success:', data.success, 'exists:', data.exists);

            // Section stays visible, but show "no results" message
            if (section) section.style.display = 'block';

            // Auto-expand to show the no-results message
            if (body && chevron) {
                body.style.display = 'block';
                chevron.classList.remove('bi-chevron-right');
                chevron.classList.add('bi-chevron-down');
            }

            // Show no-results message, hide results display
            if (noResultsMessage) noResultsMessage.style.display = 'block';
            if (resultsDisplay) resultsDisplay.style.display = 'none';

            // Hide status badge, summary, and action buttons
            if (statusBadge) statusBadge.style.display = 'none';
            if (summary) summary.style.display = 'none';
            if (btnMarkOfficial) btnMarkOfficial.style.display = 'none';
            if (btnMarkPreliminary) btnMarkPreliminary.style.display = 'none';
        }
    } catch (error) {
        console.error('Error loading results list:', error);
    }
}

function toggleResultsList(event) {
    // Prevent clicks on child elements from bubbling
    if (event && event.target !== event.currentTarget && !event.target.closest('.card-header')) {
        return;
    }
    
    const body = document.getElementById('resultsListBody');
    const chevron = document.getElementById('resultsListChevron');
    
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
        
        // Load results if not already loaded
        if (!currentResultsListData) {
            loadResultsList();
        }
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

function updateResultsListStatus(isOfficial) {
    const statusBadge = document.getElementById('resultsListStatusBadge');
    const btnMarkOfficial = document.getElementById('btnMarkOfficial');
    const btnMarkPreliminary = document.getElementById('btnMarkPreliminary');

    if (isOfficial) {
        // Official status
        statusBadge.className = 'badge bg-success fs-6 px-3 py-2';
        statusBadge.innerHTML = '<i class="bi bi-check-circle me-1"></i>Publicerad';
        btnMarkOfficial.style.display = 'none';
        btnMarkPreliminary.style.display = 'inline-block';
    } else {
        // Preliminary status
        statusBadge.className = 'badge bg-warning fs-6 px-3 py-2';
        statusBadge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Preliminär';
        btnMarkOfficial.style.display = 'inline-block';
        btnMarkPreliminary.style.display = 'none';
    }
}

async function markResultsOfficial(event) {
    if (event) event.stopPropagation();
    
    if (!confirm('Vill du markera resultatlistan som officiell?\n\nDetta kommer att göra resultaten synliga för alla.')) {
        return;
    }

    const competitionId = $('.competition-results-management').data('competition-id');
    const button = event?.target?.closest('button');
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...';
    button.disabled = true;

    try {
        const response = await fetch('/umbraco/surface/CompetitionResults/ToggleResultsOfficial', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ competitionId: parseInt(competitionId), isOfficial: true })
        });

        const data = await response.json();

        if (data.success) {
            showSaveMessage(data.message, 'success');
            updateResultsListStatus(data.isOfficial);
        } else {
            alert('Fel: ' + (data.message || 'Okänt fel'));
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid uppdatering av status.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

async function markResultsPreliminary(event) {
    if (event) event.stopPropagation();
    
    if (!confirm('Vill du återställa resultatlistan till preliminär status?')) {
        return;
    }

    const competitionId = $('.competition-results-management').data('competition-id');
    const button = event?.target?.closest('button');
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...';
    button.disabled = true;

    try {
        const response = await fetch('/umbraco/surface/CompetitionResults/ToggleResultsOfficial', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ competitionId: parseInt(competitionId), isOfficial: false })
        });

        const data = await response.json();

        if (data.success) {
            showSaveMessage(data.message, 'success');
            updateResultsListStatus(data.isOfficial);
        } else {
            alert('Fel: ' + (data.message || 'Okänt fel'));
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid uppdatering av status.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

function openResultsInNewTab(event) {
    if (event) event.stopPropagation();
    
    if (currentResultPageUrl) {
        window.open(currentResultPageUrl, '_blank');
    }
}

// ─── Deltävling (sub-competition) result handlers ──────────────────────────
// Mirror createResultsList / loadResultsList / markResults* but routed to the
// sub-comp slots (subCompetitionOnly=true / isSubCompetition=true). The merge
// modal is shared with the main flow — _subMergeContext tells the existing
// applyMergesAndCreateResults / submitCreateResultsListNoMerges handlers which
// path to take after the user clicks the modal's confirmation button.
let _subMergeContext = false;
let currentSubResultsListData = null;

async function createSubResultsList(event) {
    if (event) event.stopPropagation();

    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) { alert('Ingen tävling vald.'); return; }

    const button = event?.target?.closest('button');
    if (!button) return;
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Analyserar...';
    button.disabled = true;

    try {
        const resp = await fetch(`/umbraco/surface/CompetitionResults/AnalyzeClassMerges?competitionId=${competitionId}&subCompetitionOnly=true`);
        const data = await resp.json();

        if (!data.success) {
            alert('Fel vid analys: ' + (data.message || 'Okänt fel'));
            return;
        }

        if (!data.classes || data.classes.length === 0) {
            if (confirm('Det finns inga resultat i deltävlingen att bearbeta ännu. Vill du skapa en tom resultatlista?')) {
                submitCreateSubResultsList(competitionId, null);
            }
        } else if (data.suggestions && data.suggestions.length > 0) {
            _subMergeContext = true;
            renderMergeModal(data.classes, data.suggestions);
            new bootstrap.Modal(document.getElementById('classMergeModal')).show();
        } else {
            if (confirm('Alla klasser i deltävlingen har minst 5 deltagare. Vill du skapa/uppdatera deltävlingens resultatlista?')) {
                submitCreateSubResultsList(competitionId, null);
            }
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Ett fel uppstod vid analys av deltävlingens klasser.');
    } finally {
        button.innerHTML = originalText;
        button.disabled = false;
    }
}

function showSubMergeAnalysisModal(event) {
    // Same flow as the toolbar's "Uppdatera" — Sammanslagning is just an alias
    // for re-running the analysis + applying merges in one click.
    createSubResultsList(event);
}

function submitCreateSubResultsList(competitionId, merges) {
    const btn = document.getElementById('btnCreateSubResultsList');
    if (btn) {
        btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Skapar...';
        btn.disabled = true;
    }

    const body = { competitionId: parseInt(competitionId), isSubCompetition: true };
    if (merges) body.merges = merges;

    fetch('/umbraco/surface/CompetitionResults/CreateResultsList', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify(body)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showSaveMessage('Deltävlingens resultatlista har uppdaterats! (' + data.resultsCount + ' deltagare)', 'success');
            loadSubResultsList();
        } else {
            alert('Fel vid skapande av resultatlista: ' + (data.message || 'Okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Ett fel uppstod vid skapande av deltävlingens resultatlista.');
    })
    .finally(() => {
        if (btn) {
            btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Uppdatera';
            btn.disabled = false;
        }
    });
}

async function loadSubResultsList() {
    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) return;

    try {
        const response = await fetch(`/umbraco/surface/CompetitionResults/GetResultsList?competitionId=${competitionId}&subCompetitionOnly=true`);
        const data = await response.json();

        const section = document.getElementById('subResultsListSection');
        if (!section) return;

        const noResultsMessage = document.getElementById('subNoResultsMessage');
        const resultsDisplay = document.getElementById('subResultsDisplay');
        const statusBadge = document.getElementById('subResultsListStatusBadge');
        const btnMarkOfficial = document.getElementById('btnSubMarkOfficial');
        const btnMarkPreliminary = document.getElementById('btnSubMarkPreliminary');

        if (data.success && data.exists) {
            currentSubResultsListData = data.results;
            section.style.display = 'block';
            if (noResultsMessage) noResultsMessage.style.display = 'none';
            if (resultsDisplay) resultsDisplay.style.display = 'block';
            if (statusBadge) statusBadge.style.display = 'inline-block';
            updateSubResultsListStatus(data.isOfficial);

            if (data.resultPageUrl) {
                const iframe = document.getElementById('subResultsManagementIframe');
                if (iframe) iframe.src = data.resultPageUrl + (data.resultPageUrl.indexOf('?') >= 0 ? '&' : '?') + 'sub=true';
            }

            // Refresh sub-comp Särskjutning card whenever the sub list changes.
            loadShootOffStatus(true);
        } else {
            section.style.display = 'block';
            if (noResultsMessage) noResultsMessage.style.display = 'block';
            if (resultsDisplay) resultsDisplay.style.display = 'none';
            if (statusBadge) statusBadge.style.display = 'none';
            if (btnMarkOfficial) btnMarkOfficial.style.display = 'none';
            if (btnMarkPreliminary) btnMarkPreliminary.style.display = 'none';
        }
    } catch (error) {
        console.error('Error loading sub-comp results list:', error);
    }
}

// ─── Särskjutning (shoot-off) card ───────────────────────────────────────────
// Refreshes the tied-medal-positions card. Always called with isSub=false for the
// main pool and isSub=true for the Deltävling pool. Server returns an empty
// list for non-championship competitions, which keeps the card hidden.

async function loadShootOffStatus(isSub) {
    const competitionId = $('.competition-results-management').data('competition-id');
    if (!competitionId) return;

    const sectionId = isSub ? 'subShootOffSection' : 'shootOffSection';
    const bodyId = isSub ? 'subShootOffBody' : 'shootOffBody';
    const badgeId = isSub ? 'subShootOffStatusBadge' : 'shootOffStatusBadge';

    const section = document.getElementById(sectionId);
    const body = document.getElementById(bodyId);
    const badge = document.getElementById(badgeId);
    if (!section || !body) return;

    const url = `/umbraco/surface/CompetitionResults/GetShootOffStatus?competitionId=${competitionId}&subCompetitionOnly=${isSub ? 'true' : 'false'}`;
    try {
        const response = await fetch(url);
        const data = await response.json();
        if (!data.success || !data.classGroups || data.classGroups.length === 0) {
            section.style.display = 'none';
            return;
        }

        section.style.display = 'block';
        // Count contested medal positions across all tied groups. Contested = a medal slot
        // (rank ≤ 3) whose owning shooter has not yet been uniquely separated from their
        // tied opponents. Decided + Contested = total medal slots in tied groups.
        let unresolvedPositions = 0;
        let totalMedalSlots = 0;
        data.classGroups.forEach(cg => {
            (cg.groups || []).forEach(g => {
                const medalSlots = Math.max(0, Math.min(g.lastRank, 3) - g.firstRank + 1);
                const unresolvedShooters = (g.shooters || []).filter(s => !s.isResolved).length;
                // Cap at medalSlots — shooters who'd end up at rank ≥ 4 don't add to medal contests.
                const contestedHere = Math.min(unresolvedShooters, medalSlots);
                unresolvedPositions += contestedHere;
                totalMedalSlots += medalSlots;
            });
        });
        if (badge) {
            if (unresolvedPositions > 0) {
                badge.className = 'badge bg-warning text-dark';
                badge.textContent = `${unresolvedPositions} medaljplats(er) kvar att avgöra`;
            } else {
                badge.className = 'badge bg-success';
                badge.textContent = `${totalMedalSlots} medaljplats(er) avgjorda`;
            }
        }

        body.innerHTML = '';
        data.classGroups.forEach(cg => {
            const cgWrap = document.createElement('div');
            cgWrap.className = 'mb-3';
            cgWrap.innerHTML = `<div class="fw-bold mb-1">Klass ${escapeHtml(cg.className)}</div>`;

            cg.groups.forEach(g => {
                const card = renderShootOffGroup(competitionId, cg.className, g, isSub);
                cgWrap.appendChild(card);
            });
            body.appendChild(cgWrap);
        });
    } catch (e) {
        console.error('Error loading shoot-off status:', e);
        section.style.display = 'none';
    }
}

function renderShootOffGroup(competitionId, className, group, isSub) {
    const wrap = document.createElement('div');
    wrap.className = 'border rounded p-2 mb-2 bg-body-tertiary';

    const tierBadge = group.resolved
        ? `<span class="badge bg-success">${escapeHtml(group.medalTier)} avgjord</span>`
        : `<span class="badge bg-warning text-dark">${escapeHtml(group.medalTier)} – kvar att avgöra</span>`;
    const header = document.createElement('div');
    header.className = 'd-flex justify-content-between align-items-center mb-2';
    header.innerHTML = `${tierBadge} <span class="text-muted small">Lika poäng: ${group.totalScore}</span>`;
    wrap.appendChild(header);

    group.shooters.forEach(s => {
        const row = document.createElement('div');
        row.className = 'd-flex align-items-center gap-2 flex-wrap mb-1';
        const roundsSummary = (s.rounds || [])
            .map(r => `R${r.round}: <strong>${r.total}</strong>${r.xCount ? ` (${r.xCount}X)` : ''}`)
            .join(' · ');
        row.innerHTML = `
            <div style="min-width: 200px;"><strong>${escapeHtml(s.name)}</strong> <span class="text-muted small">${escapeHtml(s.club || '')}</span></div>
            <div class="text-muted small flex-grow-1">${roundsSummary || '<em>Inga särskjutningsskott</em>'}</div>
        `;

        // Progressive resolution per shooter:
        //  - IsResolved → placement decided; show ✓ Avgjord
        //  - NextRound  → must shoot this round; show entry button
        //  - else       → has shot the current round but tied opponents haven't; show "Väntar"
        const actionEl = document.createElement('div');
        actionEl.className = 'd-flex align-items-center gap-2';

        if (s.isResolved) {
            actionEl.innerHTML = `<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Avgjord</span>`;
        } else if (s.nextRound) {
            const openBtn = document.createElement('button');
            openBtn.className = 'btn btn-outline-primary btn-sm';
            openBtn.innerHTML = `<i class="bi bi-pencil-square me-1"></i>Resultat...`;
            openBtn.addEventListener('click', () => {
                openShootOffEntryModal({
                    competitionId,
                    memberId: s.memberId,
                    shooterName: s.name,
                    shootingClass: s.shootingClass,
                    round: s.nextRound,
                    isSub
                });
            });
            actionEl.appendChild(openBtn);
        } else {
            actionEl.innerHTML = `<span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-hourglass-split me-1"></i>Väntar på övriga</span>`;
        }
        row.appendChild(actionEl);

        wrap.appendChild(row);
    });

    return wrap;
}

async function saveShootOffEntry(competitionId, memberId, shootingClass, round, shots, isSub) {
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const response = await fetch('/umbraco/surface/CompetitionResults/SaveShootOffEntry', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({
                competitionId: parseInt(competitionId, 10),
                memberId, shootingClass, round, shots
            })
        });
        const data = await response.json();
        if (!data.Success && !data.success) {
            alert('Kunde inte spara: ' + (data.Message || data.message || 'okänt fel'));
            return false;
        }
        // Refresh the iframe (so badges/footnotes update) and the card itself.
        await (isSub ? loadSubResultsList() : loadResultsList());
        return true;
    } catch (e) {
        alert('Fel: ' + e);
        return false;
    }
}

