                <div class="sp-idmain">
                    <div class="sp-name">${nameEsc}</div>
                    <div class="sp-sub"><span class="sp-cls">${clsEsc}</span>${clubEsc}<span id="shooterParticipantStatusBadge"></span></div>
                </div>
                <div class="dropdown">
                    <button type="button" class="sp-kebab" data-bs-toggle="dropdown"
                            data-bs-popper-config='{"strategy":"fixed"}'
                            aria-label="Mer om skytten" title="Mer om skytten">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header">Skytt</h6></li>
                        <li><a class="dropdown-item" href="#" onclick="openChangeClassModal(${shooterData.memberId}, '${nameArg}', '${clsAttr}'); return false;">
                            <i class="bi bi-pencil-square me-2"></i>Ändra vapenklass
                        </a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Deltagande</h6></li>
                        <li><a class="dropdown-item" href="#" onclick="resSetParticipantStatus(${shooterData.memberId}, '${clsAttr}', 'DNS'); return false;">
