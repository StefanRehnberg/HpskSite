    // ska läsas upp — och sifferpanelen i tummens räckvidd nederst. Ingen skrollning
    // per skytt. All CSS ligger i theme.css under ".sp-*"; lägg inte tillbaka ett
    // <style>-block här (se minnet razor-partial-styles).
    const nameEsc = escapeHtml(shooterData.name || '');
    const clubEsc = escapeHtml(shooterData.club || '');
    const clsEsc = escapeHtml(shooterData.class || '');
    const clsAttr = escapeAttr(shooterData.class || '');
    // Namnet går in i en onclick-sträng, så apostrofer måste escapas separat från
    // HTML-escapningen ovan.
    const nameArg = String(shooterData.name || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'");
    const pos = shooterData.position || 0;

    let shotCells = '';
    for (let i = 0; i < 5; i++) {
        // .sp-shot ar utseendet (theme.css), .shot-placeholder ar JS-kroken.
        shotCells += `<span class="sp-shot shot-placeholder" data-shot="${i}">_</span>`;
