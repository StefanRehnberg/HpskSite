async function deleteExistingResults() {
    if (!currentShooterData) return;

    // Prepare delete request data
    // IDENTITY-BASED: Include MemberId for future optimization (controller still uses position for now)
    const deleteData = {
        competitionId: competitionData.competitionId,
        seriesNumber: currentSeries,
        memberId: currentShooterData.memberId,  // Identity field (required)
        shootingClass: currentShooterData.class, // Required for multi-class shooters
        teamNumber: parseInt(currentShooterData.teamNumber),  // Informational only
        position: parseInt(currentShooterData.position)  // Informational only
    };

    console.log('Sending delete request:', deleteData);

    // Validate data before sending
    if (!deleteData.competitionId || !deleteData.seriesNumber || !deleteData.memberId) {
        console.error('Missing required data for delete:', deleteData);
        showSaveMessage('Saknar nödvändig data för att ta bort resultat.', 'error');
        return;
    }
    
    // Get anti-forgery token
    const token = $('input[name="__RequestVerificationToken"]').val();
    console.log('Anti-forgery token:', token);
    
    if (!token) {
        console.error('No anti-forgery token found');
        showSaveMessage('Säkerhetstoken saknas. Ladda om sidan och försök igen.', 'error');
        return;
    }
    
    try {
        // Send delete request to the CompetitionResults controller
        const response = await fetch('/umbraco/surface/CompetitionResults/DeleteResult', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(deleteData)
        });
        
        console.log('Delete response status:', response.status);
        const data = await response.json();
        console.log('Delete response data:', data);
        
        if (data.success) {
            // Show success message
            showSaveMessage('Resultat borttaget!', 'success');
            
            // Update overall totals after deletion
            updateOverallTotals();
            
            // Reload the current shooter's results to reflect the deletion
            setTimeout(() => {
                const competitionId = $('.competition-results-management').data('competition-id');
                
                if (currentTeam && currentPosition && currentSeries && competitionId) {
                    // Reload results for this shooter/series combination
                    loadExistingResults(competitionId, currentSeries, currentTeam, currentPosition, currentShooterData);
                }
            }, 500); // Small delay to ensure the success message is visible
        } else {
            console.error('Server returned error:', data);
            showSaveMessage('Fel vid borttagning: ' + data.message, 'error');
        }
    } catch (error) {
        console.error('Error deleting results:', error);
        showSaveMessage('Ett fel uppstod vid borttagning av resultat.', 'error');
    }
}

function saveResults() {
    if (!currentShooterData || currentShooterData.shots.length === 0) {
        alert('Inga skott att spara.');
        return;
    }
    
    // Prepare results data for the new seamless system
    const resultsData = {
        competitionId: competitionData.competitionId,
        seriesNumber: currentSeries,
        teamNumber: parseInt(currentShooterData.teamNumber),
        position: parseInt(currentShooterData.position),
        shots: currentShooterData.shots,
        rangeOfficerId: currentUserId || 1, // Use current user ID or fallback to 1
        shooterMemberId: currentShooterData.memberId, // Include the actual shooter's MemberId
        shooterClass: currentShooterData.class // Include the shooter's class
    };
    
    console.log('Sending results data:', resultsData);
    console.log('competitionData:', competitionData);
    console.log('currentShooterData:', currentShooterData);
    console.log('shooterMemberId being sent:', resultsData.shooterMemberId);
    console.log('currentShooterData.memberId:', currentShooterData.memberId);
    
    // Validate data before sending (allow 0 for teamNumber and position)
    if (!resultsData.competitionId || !resultsData.seriesNumber || resultsData.teamNumber == null || resultsData.position == null) {
        console.error('Missing required data:', {
            competitionId: resultsData.competitionId,
            seriesNumber: resultsData.seriesNumber,
            teamNumber: resultsData.teamNumber,
            position: resultsData.position
        });
        showSaveMessage('Saknar nödvändig data för att spara resultat.', 'error');
        return;
    }
    
    // Get anti-forgery token
    const token = $('input[name="__RequestVerificationToken"]').val();
    console.log('Anti-forgery token:', token);
    
    if (!token) {
        console.error('No anti-forgery token found');
        showSaveMessage('Säkerhetstoken saknas. Ladda om sidan och försök igen.', 'error');
        return;
    }
    
    // Spärren sätts här — efter alla synkrona valideringar, precis före nätanropet.
    spBeginSave();

    // Send to the new CompetitionResults controller (with retry for transient failures)
    saveResultWithRetry('/umbraco/surface/CompetitionResults/SaveResult', resultsData, token);
}

async function saveResultWithRetry(url, data, token, maxRetries = 1) {
    for (let attempt = 0; attempt <= maxRetries; attempt++) {
        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            console.log('Server response data (attempt ' + attempt + '):', result);

            // Reached the server. A rejected save (result.success === false) is still a connected
            // save — the badge answers "is the network up", not "was the data accepted".
            hpskSetConnection(true);

            if (result.success) {
                // Uppdatera cachen med det som just sparades, så serieremsan och
                // lagvyn visar rätt utan ett nytt anrop från banan.
                spCacheSavedSeries(data);

                // Kvitteringen följer med till nästa skärm och namnger vad som
                // sparades — en felmatning syns direkt i stället för att gömmas
                // bakom ett generiskt "Resultat sparade!".
                // Nu ligger serien i databasen — då ska utkastet bort, annars
                // skulle det vinna över det sparade resultatet nästa gång.
                spClearDraft(data.shooterMemberId, data.shooterClass, data.seriesNumber);

                spLastSaved = { idx: currentShooterIndex, series: currentSeries };
                spPendingSaveLine = {
                    text: 'Serie ' + data.seriesNumber + ' sparad på ' + spPosWord() + ' ' + data.position,
                    opts: { undo: true }
                };
                spEndSave(true);
                updateOverallTotals();

                // 1000 ms fanns för att hörnrutan skulle hinna läsas. Kvittot sitter
                // nu i knappen och följer med till nästa skärm, så 200 ms räcker —
                // och en sekunds oförändrad skärm var vad som utlöste dubbeltrycken.
                setTimeout(() => { handleTraversalAfterSave(); }, 200);
                return;
            }

            // On failure, retry once after a short delay
            if (attempt < maxRetries) {
                console.warn('Save failed, retrying in 500ms...', result.message);
                await new Promise(r => setTimeout(r, 500));
                continue;
            }

            console.error('Server returned error after retries:', result);
            spEndSave(false);
            spShowSaveLine('Kunde inte spara: ' + (result.message || 'okänt fel') + ' — skotten ligger kvar, försök igen.', { error: true });
            showSaveMessage('Fel vid sparande: ' + result.message, 'error');
        } catch (error) {
            if (attempt < maxRetries) {
                console.warn('Network error, retrying in 500ms...', error);
                await new Promise(r => setTimeout(r, 500));
                continue;
            }
            // Only after the retries are spent — flagging the first transient miss would make the
            // badge blink red on a save that then succeeded, which is how an indicator stops being read.
            hpskSetConnection(false);
            console.error('Error saving results:', error);
            spEndSave(false);
            spShowSaveLine('Ingen kontakt med servern — skotten ligger kvar, försök igen.', { error: true });
            showSaveMessage('Ett fel uppstod vid sparande av resultat.', 'error');
        }
    }
    // Skyddsnät: en väg ut ur loopen som inte gått via spEndSave får inte lämna
    // panelen låst för resten av tävlingen.
    if (spIsSaving) spEndSave(false);
}

// Lägg in en nyss sparad serie i cachen (samma nyckel som serverns MERGE:
// tävling + medlem + klass + serie).
function spCacheSavedSeries(data) {
    if (!spResultsCache) spResultsCache = [];
    const existing = spResultsCache.find(function (r) {
        return r.memberId === data.shooterMemberId
            && r.shootingClass === data.shooterClass
            && r.seriesNumber === data.seriesNumber;
    });
    const shotsJson = JSON.stringify(data.shots);
    if (existing) {
        existing.shots = shotsJson;
    } else {
        spResultsCache.push({
            memberId: data.shooterMemberId,
            shootingClass: data.shooterClass,
            seriesNumber: data.seriesNumber,
            teamNumber: data.teamNumber,
            position: data.position,
            shots: shotsJson
        });
    }
}

function handleTraversalAfterSave() {
    const traversalMode = document.getElementById('traversalModeSelect').value;

    if (traversalMode === 'nextShooter') {
        // Move to next shooter in list (same series)
        moveToNextShooterNew();
    } else if (traversalMode === 'nextSeries') {
        // Move to next series for current shooter
        moveToNextSeriesNew();
    }
}

// NEW: Move to next shooter using shooter-based navigation
function moveToNextShooterNew() {
    if (currentShooterIndex < shootersData.length - 1) {
        currentShooterIndex++;
        updateShooterDisplay();
        loadCurrentShooterByIndex();
        saveCurrentSession();
        return;
    }

    // Sista skytten i funktionärens lista. Vänd om till FÖRSTA skytten i HANS
    // lista (inte index 0 i hela laget — shootersData är redan filtrerad av
    // applyOfficerRange, så index 0 är hans första plats) och stega serien.
    const range = spPhaseSeriesRange();
    if (currentSeries < range.last) {
        const finished = currentSeries;
        currentSeries = currentSeries + 1;
        currentShooterIndex = 0;
        // Kvitteringen ersätter den tysta nollställningen: funktionären ska aldrig
        // behöva gissa varför skärmen bytte skytt.
        spPendingSaveLine = {
            text: 'Serie ' + finished + ' klar för alla dina platser — börjar om på '
                  + spShooterLabel(0).toLowerCase() + ', serie ' + currentSeries + '.',
            opts: {}
        };
        updateShooterDisplay();
        updateSeriesDisplay();
        loadCurrentShooterByIndex();
        saveCurrentSession();
        return;
    }

    // Fasens sista serie för sista skytten — då finns ingen nästa, och rätt svar
    // är ett tydligt besked, inte en tyst nollställning.
    spShowSaveLine('Klart — alla serier är inmatade för dina platser.', {});
}

// NEW: Move to next series for current shooter
function moveToNextSeriesNew() {
    const nextSeries = currentSeries + 1;

    // Determine maximum series based on phase
    let maxSeries = competitionData.numberOfSeries;
    if (competitionData.hasFinalsRound && competitionData.currentPhase === 'qualification') {
        maxSeries = competitionData.qualificationSeriesCount;
    }

    if (nextSeries <= maxSeries) {
        // Move to next series for same shooter
        currentSeries = nextSeries;
        updateSeriesDisplay();
        loadCurrentShooterByIndex();
        saveCurrentSession();
    } else {
        // Completed all series for this shooter - move to next shooter, reset to series 1
        console.log('Completed all series for shooter', currentShooterIndex);
        if (currentShooterIndex < shootersData.length - 1) {
            currentShooterIndex++;
            currentSeries = 1;
            updateShooterDisplay();
            updateSeriesDisplay();
            loadCurrentShooterByIndex();
            saveCurrentSession();
        } else {
            spShowSaveLine('Klart — alla serier är inmatade för dina platser.', {});
        }
    }
}

