}

// ═══════════════════════════════════════════════════════════════════════════
//  Layout C:s tre nya ytor: serieremsan, bottenlisten och lagvyn.
//  Alla tre läser samma cache av tävlingens resultat (spResultsCache) som
//  loadExistingResults redan hämtar — inga extra anrop från banan.
// ═══════════════════════════════════════════════════════════════════════════

// Alla resultat i tävlingen, senast hämtade. Fylls av loadExistingResults och
// uppdateras efter varje sparning. Före detta gjorde updateOverallTotals ett
// GetCompetitionResults-anrop PER INMATAT SKOTT — fem anrop per serie per skytt
// på mobilnät i ett bergtäktsskjul (jfr minnet station-device-battery-cellular-constraint).
let spResultsCache = null;

// ═══════════════════════════════════════════════════════════════════════════
//  Utkast för OSPARADE skott.
//
//  ⚠️ Skotten levde tidigare bara i currentShooterData.shots, som byggs om från
//  databasen vid varje skyttbyte. En funktionär som matat in fem träffar och
//  råkade trycka "◀ Tavla" i stället för SPARA fick dem raderade — rapporterat
//  från banan 2026-08-31. Exakt samma fel som träningsloggens serier hade, och
//  samma lösning (se minnet training-log-draft-localstorage).
//
//  ⚠️ REGELN DÄRIFRÅN GÄLLER HÄR OCKSÅ: ett tomt formulär får ALDRIG radera
//  utkastet. Utkast skrivs bara när det finns skott, och tas bort bara vid
//  explicit RENSA eller en lyckad sparning.
// ═══════════════════════════════════════════════════════════════════════════

const SP_DRAFT_MAX_AGE_MS = 48 * 60 * 60 * 1000; // en tävlingshelg

function spDraftStorageKey() {
    const compId = competitionData.competitionId
        || $('.competition-results-management').data('competition-id') || '0';
    const phase = (competitionData.currentPhase === 'finals') ? 'finals' : 'qualification';
    return 'hpsk_entry_drafts_' + compId + '_' + phase;
}

// Nyckeln är (medlem, klass, serie) — samma nyckel som serverns MERGE, så ett
// utkast kan aldrig hamna på fel skytt eller fel klass för en flerklasskytt.
function spDraftKey(memberId, shootingClass, series) {
    return memberId + '|' + (shootingClass || '') + '|' + series;
}

function spReadDrafts() {
    try {
        const raw = localStorage.getItem(spDraftStorageKey());
        if (!raw) return {};
        const parsed = JSON.parse(raw) || {};
        // Rensa gamla utkast vid läsning, inte med en timer.
        const now = Date.now();
        let changed = false;
        for (const k of Object.keys(parsed)) {
            if (!parsed[k] || !parsed[k].at || (now - parsed[k].at) > SP_DRAFT_MAX_AGE_MS) {
                delete parsed[k]; changed = true;
            }
        }
        if (changed) localStorage.setItem(spDraftStorageKey(), JSON.stringify(parsed));
        return parsed;
    } catch (e) { return {}; }
}

function spWriteDrafts(drafts) {
    try { localStorage.setItem(spDraftStorageKey(), JSON.stringify(drafts)); } catch (e) { /* full/avstängd */ }
}

// Spara utkast för den skytt och serie som visas just nu.
function spSaveDraft() {
    if (!currentShooterData) return;
    const shots = currentShooterData.shots || [];
    // Tomt formulär raderar inte utkastet — se regeln ovan.
    if (shots.length === 0) return;
    const drafts = spReadDrafts();
    drafts[spDraftKey(currentShooterData.memberId, currentShooterData.class, currentSeries)] =
        { shots: shots.slice(), at: Date.now() };
    spWriteDrafts(drafts);
}

function spClearDraft(memberId, shootingClass, series) {
    const drafts = spReadDrafts();
    const k = spDraftKey(memberId, shootingClass, series);
    if (k in drafts) { delete drafts[k]; spWriteDrafts(drafts); }
}

function spGetDraft(memberId, shootingClass, series) {
    const d = spReadDrafts()[spDraftKey(memberId, shootingClass, series)];
    return (d && Array.isArray(d.shots) && d.shots.length) ? d.shots : null;
}

// Finns ett osparat utkast för (skytt, serie)? Används av serieremsan och lagvyn
// så funktionären SER att något ligger och väntar.
function spHasDraft(memberId, shootingClass, series) {
    return spGetDraft(memberId, shootingClass, series) !== null;
}

// Ordet för skyttens plats. Bara när inmatningen följer en publicerad startlista
// motsvarar numret en fysisk tavla; i anmälningsordning är det ett löpnummer vi
// själva satt (position = index + 1), och då får det inte kallas tavla.
function spPosWord() {
    return (currentEntryOrder === 'startlist' && hasStartList) ? 'tavla' : 'nr';
}
function spPosWordCap() {
    const w = spPosWord();
    return w.charAt(0).toUpperCase() + w.slice(1);
}

function spPhaseSeriesRange() {
    // Vilka serier som hör till den låsta fasen. Samma tak som moveToNextSeriesNew
    // räknar ut — grundomgången får ALDRIG mata rakt in i finalserierna.
    const total = competitionData.numberOfSeries || 0;
    const qual = competitionData.qualificationSeriesCount || total;
    if (competitionData.hasFinalsRound && competitionData.currentPhase === 'finals') {
        return { first: qual + 1, last: total };
    }
    if (competitionData.hasFinalsRound) {
        return { first: 1, last: qual };
    }
    return { first: 1, last: total };
}

// Serienummer som har ett sparat resultat för en given (medlem, klass).
function spSavedSeriesFor(memberId, shootingClass) {
    const out = {};
    if (!spResultsCache) return out;
    for (const r of spResultsCache) {
        if (r.memberId === memberId && r.shootingClass === shootingClass) {
            out[r.seriesNumber] = true;
        }
    }
    return out;
}

function spRenderSeriesStrip() {
    const strip = document.getElementById('spSeriesStrip');
    if (!strip || !currentShooterData) return;

    const range = spPhaseSeriesRange();
    const saved = spSavedSeriesFor(currentShooterData.memberId, currentShooterData.class);
    const isFinals = competitionData.hasFinalsRound && competitionData.currentPhase === 'finals';
    const qual = competitionData.qualificationSeriesCount || 0;

    let html = '<span class="sp-series-lbl">serie</span>';
    for (let s = range.first; s <= range.last; s++) {
        const label = isFinals ? ('F' + (s - qual)) : String(s);
        const draft = spHasDraft(currentShooterData.memberId, currentShooterData.class, s);
        let cls = 'sp-sn';
        if (s === currentSeries) cls += ' is-now';
        else if (saved[s]) cls += ' is-done';
        // En serie med osparade skott får en streckad ram — funktionären ska kunna
        // SE att något ligger och väntar även när han står på en annan serie.
        if (draft) cls += ' is-draft';
        const note = draft ? ' — OSPARADE skott' : (saved[s] ? ' — inmatad' : '');
        html += `<button type="button" class="${cls} sp-series-btn" data-series="${s}"
                   title="Serie ${label}${note}">${label}</button>`;
    }
    strip.innerHTML = html;
}

function spShooterLabel(idx) {
    const s = shootersData[idx];
    if (!s) return '';
    const pos = s.position || (idx + 1);
    return spPosWordCap() + ' ' + pos;
}

function spRenderFootbar() {
    const prev = document.getElementById('spPrevBtn');
    const next = document.getElementById('spNextBtn');
    const pick = document.getElementById('spPickBtn');
    if (!prev || !next || !pick) return;

    // Namngivna steg: knappen säger VART man hamnar, inte bara att något händer.
    if (currentShooterIndex > 0) {
        prev.disabled = false;
        prev.innerHTML = '<span><i class="bi bi-chevron-left"></i> ' + escapeHtml(spShooterLabel(currentShooterIndex - 1)) + '</span>';
    } else {
        prev.disabled = true;
        prev.innerHTML = '<span><i class="bi bi-chevron-left"></i> Första</span>';
    }

    if (currentShooterIndex < shootersData.length - 1) {
        next.disabled = false;
        next.innerHTML = '<span>' + escapeHtml(spShooterLabel(currentShooterIndex + 1)) + ' <i class="bi bi-chevron-right"></i></span>';
    } else {
        next.disabled = true;
        next.innerHTML = '<span>Sista <i class="bi bi-chevron-right"></i></span>';
    }

    const range = spPhaseSeriesRange();
    const isFinals = competitionData.hasFinalsRound && competitionData.currentPhase === 'finals';
    const qual = competitionData.qualificationSeriesCount || 0;
    const seriesLabel = isFinals ? ('F' + (currentSeries - qual)) : String(currentSeries);
    const teamPart = (currentShooterData && currentShooterData.teamNumber)
        ? 'Lag ' + currentShooterData.teamNumber + ' · ' : '';
    const openLabel = document.getElementById('spPicker') && !document.getElementById('spPicker').classList.contains('d-none');
    pick.innerHTML = escapeHtml(teamPart + 'serie ' + seriesLabel) +
        ' <i class="bi bi-chevron-' + (openLabel ? 'down' : 'up') + '"></i>';
    pick.setAttribute('aria-expanded', openLabel ? 'true' : 'false');
    pick.title = 'Visa hela skjutlaget';
}

function spTogglePicker() {
    const el = document.getElementById('spPicker');
    const root = document.querySelector('.precision-results-entry');
    if (!el) return;
    if (el.classList.contains('d-none')) {
        spRenderPicker();
        el.classList.remove('d-none');
        // ⚠️ Lagvyn ar en EGEN skarm. Forsoket att visa den MELLAN den pinnade
        // toppen och den pinnade botten gjorde raderna omojliga att trycka pa
        // (Playwright: ".sp-top subtree intercepts pointer events") — tre
        // regioner ryms inte i 740 px. Sifferpanelen och skottraden goms
        // darfor medan vyn ar oppen, precis som i mockupen.
        if (root) root.classList.add('sp-picking');
    } else {
        el.classList.add('d-none');
        if (root) root.classList.remove('sp-picking');
    }
    spRenderFootbar();
}

function spClosePicker() {
    const el = document.getElementById('spPicker');
    const root = document.querySelector('.precision-results-entry');
    if (el) el.classList.add('d-none');
    if (root) root.classList.remove('sp-picking');
    spRenderFootbar();
}

// Hela skjutlaget som lista: en rad per tavla, en prick per serie.
// Fylld = inmatad, tom = inte inmatad än, RÖD RING = överhoppad (en serie utan
// resultat som har inmatade serier EFTER sig). Överhoppade serier syntes inte
// någonstans på skärmen tidigare.
function spRenderPicker() {
    const el = document.getElementById('spPicker');
    if (!el) return;

    const range = spPhaseSeriesRange();
    const isFinals = competitionData.hasFinalsRound && competitionData.currentPhase === 'finals';
    const qual = competitionData.qualificationSeriesCount || 0;

    const teamLabel = (currentShooterData && currentShooterData.teamNumber)
        ? 'Lag ' + currentShooterData.teamNumber : 'Laget';

    let rows = `
        <div class="sp-picker-bar">
            <span class="sp-picker-title">${escapeHtml(teamLabel)} — tryck på en rad eller en serie</span>
            <button type="button" class="sp-fb" id="spPickerCloseBtn" aria-label="Stäng lagvyn">Stäng</button>
        </div>
        <div class="sp-prow sp-prow-head">
            <span class="sp-pt">${spPosWordCap()}</span>
            <span class="sp-pn">Skytt</span>
            <span class="sp-ps">Serier</span>
        </div>`;

    let gapNote = '';

    shootersData.forEach(function (s, idx) {
        const saved = spSavedSeriesFor(s.memberId, s.shootingClass);
        let lastSaved = 0;
        for (let n = range.first; n <= range.last; n++) { if (saved[n]) lastSaved = n; }

        let dots = '';
        let hasGap = false;
        for (let n = range.first; n <= range.last; n++) {
            let dcls = 'sp-dt';
            const label = isFinals ? ('F' + (n - qual)) : String(n);
            let dtitle = 'Serie ' + label;
            const nDraft = spHasDraft(s.memberId, s.shootingClass, n);
            if (nDraft) { dcls += ' is-draft'; dtitle += ' — OSPARADE skott'; }
            else if (saved[n]) { dcls += ' is-ok'; dtitle += ' — inmatad'; }
            else if (n < lastSaved) { dcls += ' is-miss'; hasGap = true; dtitle += ' — SAKNAS'; }
            else if (idx === currentShooterIndex && n === currentSeries) { dcls += ' is-half'; dtitle += ' — pågår'; }
            dots += `<button type="button" class="${dcls} sp-dot-btn" data-idx="${idx}" data-series="${n}" title="${escapeAttr(dtitle)}" aria-label="${escapeAttr(dtitle)}"></button>`;
        }

        if (hasGap && !gapNote) {
            gapNote = spPosWordCap() + ' ' + (s.position || (idx + 1)) + ' saknar en serie — tryck på den röda ringen för att gå dit.';
        }

        let rcls = 'sp-prow sp-prow-btn';
        if (idx === currentShooterIndex) rcls += ' is-now';
        else if (hasGap) rcls += ' has-gap';

        rows += `
        <button type="button" class="${rcls}" data-idx="${idx}">
            <span class="sp-pt">${s.position || (idx + 1)}</span>
            <span class="sp-pn">
                <span class="sp-pn-name">${escapeHtml(s.name || '')}</span>
                <span class="sp-pn-meta">${escapeHtml(s.shootingClass || '')} · ${escapeHtml(s.club || '')}</span>
            </span>
            <span class="sp-ps">${dots}</span>
        </button>`;
    });

    if (gapNote) {
        rows += `<div class="sp-pnote"><span class="sp-dt is-miss"></span>${escapeHtml(gapNote)}</div>`;
    }

    // "Visa hela laget" lyfter platsfiltret tillfälligt utan att skriva om
    // funktionärens sparade intervall.
    if (officerRangeStart != null && officerRangeEnd != null) {
        rows += `
        <div class="sp-footbar">
            <button type="button" class="sp-fb sp-fb-wide" id="spClearRangeBtn">Visa hela laget (plats ${officerRangeStart}–${officerRangeEnd} valt)</button>
        </div>`;
    }

    el.innerHTML = rows;
}

// Gå till en bestämd skytt (index i shootersData) och valfritt en bestämd serie.
function spGoTo(idx, series) {
    if (idx < 0 || idx >= shootersData.length) return;
    currentShooterIndex = idx;
    if (series != null) {
        const range = spPhaseSeriesRange();
        if (series >= range.first && series <= range.last) currentSeries = series;
    }
    spClosePicker();
    updateShooterDisplay();
    updateSeriesDisplay();
    loadCurrentShooterByIndex();
    saveCurrentSession();
}

// Sparkvitteringen — en smal rad direkt över panelen, där blicken redan är.
// Ersätter showSaveMessage()-rutan i skärmens motsatta hörn för inmatningen;
// den funktionen finns kvar för resten av sidan.
function spShowSaveLine(text, opts) {
    opts = opts || {};
    const line = document.getElementById('spSaveLine');
    const txt = document.getElementById('spSaveLineText');
    const icon = document.getElementById('spSaveLineIcon');
    const undo = document.getElementById('spUndoBtn');
    if (!line || !txt) return;
    txt.textContent = text;
    line.classList.remove('d-none');
    line.classList.toggle('is-error', !!opts.error);
    line.classList.toggle('is-warn', !!opts.warn);
    if (icon) icon.innerHTML = (opts.error || opts.warn)
        ? '<i class="bi bi-exclamation-triangle"></i>'
        : '<i class="bi bi-check-lg"></i>';
    if (undo) undo.classList.toggle('d-none', !opts.undo);
}


function initializeShooterResultsEntry(shooterData, existingResult = null) {
    // Initialize shooter data
    let shots = [];
    let total = 0;
    let xCount = 0;
    let isComplete = false;
    
    // ⚠️ Utkastet vinner över det sparade resultatet. Kommer man tillbaka till en
    // serie man var mitt i ska man se sina egna osparade skott, inte den äldre
    // sparade versionen — annars är arbetet borta igen, bara tystare.
    const draftShots = spGetDraft(shooterData.memberId, shooterData.class, currentSeries);
    let restoredFromDraft = false;

    if (draftShots) {
        shots = draftShots.slice();
        const t = calculateTotalsFromShots(shots);
        total = t.total;
        xCount = t.xCount;
        isComplete = shots.length === 5;
        restoredFromDraft = true;
    }
    else if (existingResult) {
        // Parse existing shots from JSON
        try {
            shots = JSON.parse(existingResult.shots);
            // Calculate totals from shots instead of using stored values
            const calculatedTotals = calculateTotalsFromShots(shots);
            total = calculatedTotals.total;
            xCount = calculatedTotals.xCount;
            isComplete = shots.length === 5;
            
            // Show confirmation dialog if trying to edit existing results
            // showExistingResultsWarning(existingResult);
        } catch (error) {
            console.error('Error parsing existing shots:', error);
        }
    }
    
    currentShooterData = {
        id: shooterData.id,
        memberId: shooterData.memberId, // Add memberId for server requests
        name: shooterData.name,
        club: shooterData.club,
        class: shooterData.class,
        teamNumber: shooterData.teamNumber,
        position: shooterData.position,
        shots: shots, // Now stores strings directly: ["X", "10", "9", "8", "7"]
        total: total,
        xCount: xCount,
        isComplete: isComplete,
        hasExistingResults: !!existingResult,
        enteredByName: existingResult ? (existingResult.enteredByName || '') : ''
    };
    
    // Set up event listeners
    initializeShooterEventListeners();
    
    // We've removed the existingResultsBadge display
    
    // Update display
    updateShooterDisplay();
    updateButtonStates();

    // Kvitteringen från föregående sparning/vändning hör till DEN HÄR skärmen —
    // den köades innan omritningen eftersom DOM:en byts ut asynkront.
    if (spPendingSaveLine) {
        spShowSaveLine(spPendingSaveLine.text, spPendingSaveLine.opts || {});
        spPendingSaveLine = null;
    }
    else if (restoredFromDraft) {
        // Säg att skotten är återställda och INTE sparade. Utan det här skulle en
        // återställd serie se ut som en sparad, och funktionären kunde gå vidare
        // och tro att den låg i databasen.
        spShowSaveLine(shots.length === 5
            ? 'Återställd — 5 skott inmatade men INTE sparade. Tryck SPARA.'
            : 'Återställd — ' + shots.length + ' av 5 skott inmatade, inte sparade.',
            { warn: true });
    }
}

// Global variables for results entry
let currentShooterData = null;

// Helper function to calculate totals from shots array
function calculateTotalsFromShots(shots) {
    let total = 0;
    let xCount = 0;
    
    shots.forEach(shot => {
        if (shot.toUpperCase() === 'X') {
            total += 10;
            xCount++;
        } else {
            const value = parseInt(shot);
            if (!isNaN(value) && value >= 0 && value <= 10) {
                total += value;
            }
        }
    });
    
    return { total, xCount };
}


function initializeShooterEventListeners() {
    // Remove existing listeners
    document.removeEventListener('click', handleShooterClick);
    document.removeEventListener('keydown', handleShooterKeydown);
    
    // Add new listeners
    document.addEventListener('click', handleShooterClick);
    document.addEventListener('keydown', handleShooterKeydown);
    
    // OLD: Dropdown event listeners removed - no longer needed with button navigation
}

function handleShooterClick(e) {
    // Handle button clicks - check both the button and its children (like icons)
    const button = e.target.closest('button');
    
    if (!button) return;
    
    // ── Layout C:s nya kontroller ─────────────────────────────────────────
    // Hanteras före listan nedan eftersom flera av dem ligger inuti varandra
    // (en serieprick inuti en lagrad) och closest('button') ger den innersta.
    if (button.classList.contains('sp-dot-btn')) {
        e.preventDefault();
        spGoTo(parseInt(button.dataset.idx, 10), parseInt(button.dataset.series, 10));
        return;
    }
    if (button.classList.contains('sp-prow-btn')) {
        e.preventDefault();
        spGoTo(parseInt(button.dataset.idx, 10), null);
        return;
    }
    if (button.classList.contains('sp-series-btn')) {
        e.preventDefault();
        spGoTo(currentShooterIndex, parseInt(button.dataset.series, 10));
        return;
    }
    if (button.classList.contains('sp-fb-pick')) {
        e.preventDefault();
        spTogglePicker();
        return;
    }
    if (button.id === 'spPickerCloseBtn') {
        e.preventDefault();
        spClosePicker();
        return;
    }
    if (button.id === 'spUndoBtn') {
        e.preventDefault();
        // "Rätta" NAVIGERAR tillbaka till den serie som just sparades — den tar
        // inte bort något. Att kalla den "Ångra" hade lovat en radering som inte
        // sker; funktionären rättar genom att mata om serien och spara igen.
        if (spLastSaved) spGoTo(spLastSaved.idx, spLastSaved.series);
        return;
    }
    if (button.id === 'spClearRangeBtn') {
        e.preventDefault();
        // Lyfter platsfiltret för resten av sessionen utan att skriva om det
        // sparade intervallet i localStorage — funktionären får tillbaka sitt
        // intervall nästa gång han öppnar laget.
        officerRangeStart = null;
        officerRangeEnd = null;
        loadShooters(currentEntryOrder);
        return;
    }

    // Check if this is one of our buttons
    const isOurButton = button.classList.contains('shot-btn') ||
                        button.classList.contains('enter-btn') ||
                        button.classList.contains('clear-btn') ||
                        button.classList.contains('first-shooter-btn') ||
                        button.classList.contains('prev-shooter-btn') ||
                        button.classList.contains('next-shooter-btn') ||
                        button.classList.contains('prev-series-btn') ||
                        button.classList.contains('next-series-btn') ||
                        button.classList.contains('prev-team-btn') ||
                        button.classList.contains('next-team-btn');
    
    if (!isOurButton) return;
    
    // Prevent default behavior for all our buttons
    e.preventDefault();
    e.stopPropagation();
    
    if (button.classList.contains('shot-btn')) {
        const value = button.getAttribute('data-value');
        addShot(value);
    } else if (button.classList.contains('enter-btn')) {
        handleEnter();
    } else if (button.classList.contains('clear-btn')) {
        clearShots();
    } else if (button.classList.contains('prev-team-btn')) {
        navigateToPreviousTeam();
    } else if (button.classList.contains('next-team-btn')) {
        navigateToNextTeam();
    } else if (button.classList.contains('first-shooter-btn')) {
        firstShooter();
    } else if (button.classList.contains('prev-shooter-btn')) {
        navigateToPreviousPosition();
    } else if (button.classList.contains('next-shooter-btn')) {
        // Navigate to next position (shooter)
        navigateToNextPosition();
    } else if (button.classList.contains('prev-series-btn')) {
        navigateToPreviousSeries();
    } else if (button.classList.contains('next-series-btn')) {
        navigateToNextSeries();
    }
}

function handleShooterKeydown(e) {
    // Don't hijack keystrokes when the user is typing in an editable field
    // (e.g. the "Mitt intervall" boxes in the settings modal). Without this
    // guard the scoring keypad swallows every digit before it reaches the input.
    const t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable)) {
        return;
    }
    // Handle number keys, ten and X
    // ⚠️ Keep this mapping identical to the other three keypads (TrainingScoreEntry,
    // TrainingMatchScoreEntry, and the särskjutning modal below). A ten has no digit of its own, so it
    // needs a key of its own — requested 2026-08-29 by an organiser entering results at the desk on a
    // laptop. '+' and '-' are both reachable with and without a numeric keypad; '*' is the numpad twin
    // of 'x'.
    if (e.key >= '0' && e.key <= '9') {
        e.preventDefault();
        addShot(e.key);
    } else if (e.key === '+' || e.key === '-') {
        e.preventDefault();
        addShot('10');
    } else if (e.key.toLowerCase() === 'x' || e.key === '*') {
        e.preventDefault();
        addShot('X');
    } else if (e.key === 'Enter') {
        e.preventDefault();
        handleEnter();
    } else if (e.key === 'Escape') {
        e.preventDefault();
        clearShots();
    }
}

async function addShot(value) {
    if (!currentShooterData) return;
    
    // If there are existing results and we're trying to add a new shot, require confirmation
    if (currentShooterData.hasExistingResults && currentShooterData.shots.length === 0) {
        const confirmed = await confirmClearExistingResults();
        if (!confirmed) return;
        
        // Clear existing results
        currentShooterData.hasExistingResults = false;
    }
    
    if (currentShooterData.shots.length >= 5) return;
    
    // Store the shot value as a string
    currentShooterData.shots.push(value);
    
    // Calculate numeric value for totals
    currentShooterData.isComplete = currentShooterData.shots.length === 5;
    
    // Calculate totals from shots
    const { total, xCount } = calculateTotalsFromShots(currentShooterData.shots);
    currentShooterData.total = total;
    currentShooterData.xCount = xCount;

    // Utkastet skrivs vid VARJE skott, inte vid navigering — en funktionär som
    // tappar telefonen eller får sidan omladdad mitt i serien ska inte förlora
    // något heller.
    spSaveDraft();

    updateShooterDisplay();
    updateButtonStates();
}

// ⚠️ EN sparning i taget. Sätts precis före anropet i saveResults() och släpps i
// dess finally — täcker även återförsöken i saveResultWithRetry(). Utan den här
// flaggan köade varje tryck en egen framflyttning (rapporterat från banan
// 2026-08-30: fyra tryck = fyra skyttar framåt). Gäller BÅDE knapp och Enter,
// eftersom Enter på en laptop är precis lika lätt att upprepa.
let spIsSaving = false;

// Meddelande som ska visas på NÄSTA renderade skärm. Skärmen byggs om asynkront
// efter en framflyttning, så en text som skrivs före bytet skulle hamna i DOM:en
// som just ska kastas. initializeShooterResultsEntry plockar upp den här.
let spPendingSaveLine = null;

// Vad som senast sparades, så "Rätta" kan ta funktionären tillbaka dit.
let spLastSaved = null;

function handleEnter() {
    if (spIsSaving) return;                     // re-entry-spärr
    if (!currentShooterData) return;
    if (currentShooterData.shots.length < 5) return;
    saveResults();
}

function spBeginSave() {
    spIsSaving = true;
    const btn = document.querySelector('.enter-btn');
    if (btn) {
        btn.disabled = true;
        btn.classList.add('is-busy');
        btn.classList.remove('is-done');
        btn.textContent = 'SPARAR…';
    }
    document.querySelectorAll('.shot-btn, .clear-btn').forEach(function (b) { b.disabled = true; });
}

function spEndSave(ok) {
    spIsSaving = false;
    const btn = document.querySelector('.enter-btn');
    if (btn) {
        btn.classList.remove('is-busy');
        if (ok) {
            // Knappen ÄR kvittot. Den behåller sin gröna yta så den inte "slocknar",
            // vilket lästes som "inget hände" och var halva orsaken till dubbeltrycken.
            btn.classList.add('is-done');
            btn.textContent = '✓ SPARAT';
        }
    }
    if (!ok) {
        // Vid fel: lås upp allt igen så funktionären kan försöka om.
        document.querySelectorAll('.shot-btn, .clear-btn').forEach(function (b) { b.disabled = false; });
        updateButtonStates();
    }
}

// Etikett som säger VART sparningen går, inte bara att den sparar.
function spSaveButtonLabel() {
    const modeEl = document.getElementById('traversalModeSelect');
    const mode = modeEl ? modeEl.value : 'nextShooter';
    if (mode === 'nextShooter') {
        if (currentShooterIndex < shootersData.length - 1) {
            return 'SPARA → ' + spShooterLabel(currentShooterIndex + 1).toUpperCase();
        }
        const range = spPhaseSeriesRange();
        if (currentSeries < range.last) return 'SPARA → SERIE ' + (currentSeries + 1);
        return 'SPARA — SISTA SERIEN';
    }
    const range2 = spPhaseSeriesRange();
    if (currentSeries < range2.last) return 'SPARA → SERIE ' + (currentSeries + 1);
    return 'SPARA';
}

async function clearShots() {
    if (!currentShooterData) return;
    
    // If there are existing results, require confirmation
    if (currentShooterData.hasExistingResults) {
        const confirmed = await confirmClearExistingResults();
        if (!confirmed) return;
        
        // Delete existing results from database
        await deleteExistingResults();
    }
    
    // RENSA är den enda handling utom en lyckad sparning som tar bort utkastet.
    spClearDraft(currentShooterData.memberId, currentShooterData.class, currentSeries);

    // Reset shooter data
    currentShooterData.shots = [];
    currentShooterData.isComplete = false;
    currentShooterData.hasExistingResults = false;
    
    // Calculate totals from shots (will be 0 for empty array)
    const { total, xCount } = calculateTotalsFromShots(currentShooterData.shots);
    currentShooterData.total = total;
    currentShooterData.xCount = xCount;
    
    updateShooterDisplay();
    updateButtonStates();
}

function updateShooterDisplay() {
    if (!currentShooterData) return;
    
    // Update shot placeholders
    const placeholders = document.querySelectorAll('.shot-placeholder');
    placeholders.forEach((placeholder, index) => {
        if (index < currentShooterData.shots.length) {
            // Shots are now stored as strings, so display them directly
            // Ingen värdefärgning: en gul X och en grön tia var en fjärde färgkod
            // på en yta som redan bär tangentblå, seriemarkering och statusgrönt
            // (Stefan 2026-08-31). Skottet läses som text — ett X är redan ett X.
            placeholder.textContent = String(currentShooterData.shots[index]);
            placeholder.classList.add('filled');
        } else {
            placeholder.textContent = '_';
            placeholder.classList.remove('filled');
        }
    });
    
    // Update series totals (current series)
    const seriesTotalElement = document.querySelector('.series-total');
    const seriesXCountElement = document.querySelector('.series-xcount');
    
    if (seriesTotalElement) seriesTotalElement.textContent = currentShooterData.total;
    if (seriesXCountElement) seriesXCountElement.textContent = currentShooterData.xCount;

    // "Inmatat av X" — visible only while the existing saved data is on screen
    const enteredByDisplay = document.querySelector('.entered-by-display');
    const enteredByNameEl = document.querySelector('.entered-by-name');
    if (enteredByDisplay && enteredByNameEl) {
        const showEnteredBy = currentShooterData.hasExistingResults && !!currentShooterData.enteredByName;
        if (showEnteredBy) {
            enteredByNameEl.textContent = currentShooterData.enteredByName;
            enteredByDisplay.style.display = '';
        } else {
            enteredByDisplay.style.display = 'none';
        }
    }

    // Nästa ruta att fylla får en streckad ram — en nedräkning som inte tar plats.
    placeholders.forEach((p, i) => {
        p.classList.toggle('is-next', i === currentShooterData.shots.length && i < 5);
    });

    // De tre nya ytorna i layout C.
    spRenderSeriesStrip();
    spRenderFootbar();
    const openPicker = document.getElementById('spPicker');
    if (openPicker && !openPicker.classList.contains('d-none')) spRenderPicker();

    // Update overall totals (all series for this shooter)
    updateOverallTotals();
}

async function updateOverallTotals() {
    if (!currentShooterData) return;

    const competitionId = $('.competition-results-management').data('competition-id');

    try {
        // ⚠️ Läs ur cachen. Den här funktionen anropas från updateShooterDisplay,
        // alltså EN GÅNG PER INMATAT SKOTT, och hämtade tidigare hela tävlingens
        // resultat varje gång — fem anrop per serie och skytt över mobilnät vid
        // skjutvallen (se minnet station-device-battery-cellular-constraint).
        // Cachen fylls av loadExistingResults vid varje skyttbyte och uppdateras
        // av spCacheSavedSeries efter varje sparning, så den är aldrig äldre än
        // funktionärens egen senaste åtgärd.
        let results = spResultsCache;
        if (!results) {
            const response = await fetch(`/umbraco/surface/CompetitionResults/GetCompetitionResults?competitionId=${competitionId}`, {
                method: 'GET',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await response.json();
            if ((data.Success || data.success) && (data.results || data.Results)) {
                results = data.results || data.Results;
                spResultsCache = results;
            }
        }

        let overallTotal = 0;
        let overallXCount = 0;

        if (results) {

            // Filter results for this specific shooter and class
            // Must include shootingClass to distinguish multi-class shooters
            const shooterResults = results.filter(result => {
                return result.memberId === currentShooterData.memberId &&
                       result.shootingClass === currentShooterData.class;
            });
            
            // Sum up all series totals by calculating from shots
            shooterResults.forEach(result => {
                if (result.shots) {
                    try {
                        const shots = JSON.parse(result.shots);
                        const calculatedTotals = calculateTotalsFromShots(shots);
                        overallTotal += calculatedTotals.total;
                        overallXCount += calculatedTotals.xCount;
                    } catch (error) {
                        console.error('Error parsing shots for overall total:', error);
                    }
                }
            });
        }
        
        // Update overall total elements
        const overallTotalElement = document.querySelector('.shooter-overall-total');
        const overallXCountElement = document.querySelector('.shooter-overall-xcount');
        
        if (overallTotalElement) overallTotalElement.textContent = overallTotal;
        if (overallXCountElement) overallXCountElement.textContent = overallXCount;
        
    } catch (error) {
        console.error('Error updating overall totals:', error);
    }
}

function updateButtonStates() {
    if (!currentShooterData) return;

    // Rör ingenting medan en sparning pågår — spBeginSave/spEndSave äger
    // knapparnas tillstånd då, och en omritning härifrån skulle låsa upp dem.
    if (spIsSaving) return;

    const n = currentShooterData.shots.length;

    document.querySelectorAll('.shot-btn').forEach(btn => { btn.disabled = n >= 5; });
    document.querySelectorAll('.clear-btn').forEach(btn => { btn.disabled = false; });

    const enterButton = document.querySelector('.enter-btn');
    if (enterButton) {
        // ⚠️ Före detta var SPARA aktiv redan vid ETT skott, men handleEnter()
        // krävde fem och returnerade tyst — ett dött tryck som såg ut som att
        // knappen inte fungerade. Nu står det hur många skott som saknas.
        enterButton.disabled = n < 5;
        enterButton.classList.remove('is-busy', 'is-done');
        enterButton.textContent = (n < 5) ? (n + ' AV 5 SKOTT') : spSaveButtonLabel();
    }
}



