// Officer position-range filter (inside the settings modal). Range survives reload via
// localStorage and applies on top of the team filter so officers handling positions 1-5
// only see those 5 shooters when they open any team in the competition.
(function() {
    function reapplyOfficerRangeAndReload() {
        // Re-run the shooter load so applyOfficerRange() filters with the new bounds.
        // Same code path the page uses on initial mount.
        if (competitionData.currentPhase === 'finals') {
            loadFinalsStartList();
        } else {
            loadShooters(currentEntryOrder);
        }
    }
    function onRangeInputChange() {
        var startEl = document.getElementById('officerRangeStart');
        var endEl = document.getElementById('officerRangeEnd');
        var sVal = startEl.value.trim();
        var eVal = endEl.value.trim();
        var s = sVal === '' ? null : parseInt(sVal, 10);
        var e = eVal === '' ? null : parseInt(eVal, 10);
        // Only apply when both are valid and start <= end. Otherwise clear.
        if (Number.isFinite(s) && Number.isFinite(e) && s >= 1 && e >= s) {
            officerRangeStart = s;
            officerRangeEnd = e;
        } else {
            officerRangeStart = null;
            officerRangeEnd = null;
        }
        saveOfficerRangeToStorage();
        reapplyOfficerRangeAndReload();
    }
    function onClearClick() {
        officerRangeStart = null;
        officerRangeEnd = null;
        document.getElementById('officerRangeStart').value = '';
        document.getElementById('officerRangeEnd').value = '';
        saveOfficerRangeToStorage();
        reapplyOfficerRangeAndReload();
    }
    // When the modal is shown, refresh the inputs from current state (covers the case
    // where storage was modified in another tab or competition phase changed).
    var modalEl = document.getElementById('resultEntrySettingsModal');
    if (modalEl) {
        modalEl.addEventListener('show.bs.modal', function() {
            loadOfficerRangeFromStorage();
            var sEl = document.getElementById('officerRangeStart');
            var eEl = document.getElementById('officerRangeEnd');
            if (sEl) sEl.value = officerRangeStart != null ? officerRangeStart : '';
            if (eEl) eEl.value = officerRangeEnd != null ? officerRangeEnd : '';
        });
    }
    var startEl = document.getElementById('officerRangeStart');
    var endEl = document.getElementById('officerRangeEnd');
    var clearBtn = document.getElementById('officerRangeClearBtn');
    if (startEl) startEl.addEventListener('change', onRangeInputChange);
    if (endEl) endEl.addEventListener('change', onRangeInputChange);
    if (clearBtn) clearBtn.addEventListener('click', onClearClick);
})();

// Show warning when existing results are loaded
function showExistingResultsWarning(existingResult) {
    const shots = JSON.parse(existingResult.shots);
    const shotDisplay = shots.map(shot => shot === 'X' ? 'X' : shot).join(', ');
    
    // Create a subtle notification instead of blocking dialog
    const notification = document.createElement('div');
    notification.className = 'alert alert-warning alert-dismissible fade show position-fixed';
    notification.style.cssText = 'top: 20px; right: 20px; z-index: 1050; max-width: 400px;';
    notification.innerHTML = `
        <strong>Befintliga resultat hittades</strong><br>
        Nuvarande poäng: ${shotDisplay} (Totalt: ${existingResult.total}, X: ${existingResult.xCount})<br>
        <small class="text-muted">Klicka RENSA för att börja om, eller fortsätt redigera.</small>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    
    document.body.appendChild(notification);
    
    // Auto-remove after 5 seconds
    setTimeout(() => {
        if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
        }
    }, 5000);
}

// Confirmation dialog for clearing existing results
async function confirmClearExistingResults() {
    return new Promise((resolve) => {
        const modal = document.createElement('div');
        modal.className = 'modal fade';
        modal.innerHTML = `
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Rensa befintliga resultat</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p>Denna skytt har redan registrerade resultat. Är du säker på att du vill rensa dem och börja om?</p>
                        <div class="alert alert-warning">
                            <strong>Varning:</strong> Åtgärden kan inte ångras.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <button type="button" class="btn btn-danger" id="confirmClearBtn">Ja, rensa resultat</button>
                    </div>
                </div>
            </div>
        `;
        
        document.body.appendChild(modal);
        
        const bsModal = new bootstrap.Modal(modal);
        bsModal.show();
        
        document.getElementById('confirmClearBtn').addEventListener('click', () => {
            bsModal.hide();
            document.body.removeChild(modal);
            resolve(true);
        });
        
        modal.addEventListener('hidden.bs.modal', () => {
            document.body.removeChild(modal);
            resolve(false);
        });
    });
}

// Helper functions for new navigation system

function restoreLastSession() {
    const competitionId = $('.competition-results-management').data('competition-id');
    const storageKey = `competition_${competitionId}_last_selection`;

    const lastSelection = localStorage.getItem(storageKey);

    if (lastSelection) {
        try {
            const selection = JSON.parse(lastSelection);

            // New shooter-based navigation - restore shooter index and series
            if (selection.shooterIndex !== undefined && selection.shooterIndex < shootersData.length) {
                currentShooterIndex = selection.shooterIndex;
            } else if (selection.memberId) {
                // Try to find shooter by memberId (fallback for old sessions)
                const idx = shootersData.findIndex(s => s.memberId === selection.memberId);
                currentShooterIndex = idx >= 0 ? idx : 0;
            } else {
                currentShooterIndex = 0;
            }

            currentSeries = selection.seriesNumber || 1;

            // Legacy support
            currentTeam = selection.teamNumber || 1;
            currentPosition = selection.position || 1;
        } catch (e) {
            // Use defaults
            currentShooterIndex = 0;
            currentSeries = 1;
            currentTeam = 1;
            currentPosition = 1;
        }
    }
}

function saveCurrentSession() {
    const competitionId = $('.competition-results-management').data('competition-id');
    const storageKey = `competition_${competitionId}_last_selection`;

    const shooter = shootersData[currentShooterIndex];

    const selection = {
        // New shooter-based navigation
        shooterIndex: currentShooterIndex,
        memberId: shooter ? shooter.memberId : null,
        seriesNumber: currentSeries,
        entryOrder: currentEntryOrder,
        // Legacy support
        teamNumber: currentTeam,
        position: currentPosition,
        timestamp: new Date().toISOString()
    };

    localStorage.setItem(storageKey, JSON.stringify(selection));
}

function updateNavigationDisplays() {
    // NEW: Update shooter display instead of team display
    updateShooterDisplay();
    updateSeriesDisplay();
}

// Legacy function - redirect to new shooter-based loading
function loadCurrentShooter() {
    // Use new shooter-based navigation
    loadCurrentShooterByIndex();
}

