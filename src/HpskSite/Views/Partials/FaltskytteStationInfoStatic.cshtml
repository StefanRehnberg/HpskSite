@using HpskSite.CompetitionTypes.Faltskytte.Models
@using System.Globalization
@*
    Read-only Förutsättningar + static per-figure visibility timeline for one
    Fältskytte station. Rendered server-side by StationPage.cshtml's ?t=<token>
    branch (QR-1 on the station card) — public, no login, non-enumerable.
    Bands use inline styles (no top-level <style> in a partial — see project
    notes) and InvariantCulture percentages (CSS needs '.' not ',').
*@
@functions {
    // C# port of tmrFigBands (FaltskytteStationEntry.cshtml): static visible windows
    // in [0, shootSec]. Each band is int[]{from, to} (plain arrays — named tuples are
    // fragile inside Razor @@functions/ternaries).
    static List<int[]> FigBands(FaltskytteFigure fig, int shootSec)
    {
        var bands = new List<int[]>();
        var b = fig.Behavior ?? "Fast";
        if (b == "Framsvängande")
        {
            int delay = fig.DelayBeforeShowSec ?? 0;
            int dur = fig.ShowTimeSec ?? 8;
            if (dur <= 0) return bands;
            int from = Math.Max(0, Math.Min(shootSec, delay));
            int to = Math.Max(from, Math.Min(shootSec, delay + dur));
            if (from < to) bands.Add(new[] { from, to });
            return bands;
        }
        if (b == "Bortsvängande")
        {
            int hideAt = fig.HideAfterSec ?? 8;
            int reappear = fig.ReappearSec ?? 0;
            if (hideAt > 0) bands.Add(new[] { 0, Math.Min(shootSec, hideAt) });
            if (reappear > 0 && reappear < shootSec) bands.Add(new[] { reappear, shootSec });
            return bands;
        }
        bands.Add(new[] { 0, shootSec }); // Fast / static → visible the whole time
        return bands;
    }
    static string Pct(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    static string FigTiming(FaltskytteFigure fig)
    {
        var b = fig.Behavior ?? "Fast";
        if (b == "Framsvängande") return $"Framsvängande (fram {fig.DelayBeforeShowSec ?? 0} s, syns {fig.ShowTimeSec ?? 8} s)";
        if (b == "Bortsvängande") { var r = fig.ReappearSec ?? 0; return $"Bortsvängande (ut {fig.HideAfterSec ?? 8} s{(r > 0 ? $", åter {r} s" : "")})"; }
        return b;
    }
}
@{
    var competitionName = ViewData["CompetitionName"] as string ?? "";
    var stationNumber = (int)(ViewData["StationNumber"] ?? 0);
    var scoringMode = ViewData["ScoringMode"] as string ?? "Normal";
    var stationsByWc = ViewData["StationsByWeaponClass"] as Dictionary<string, FaltskytteStationConfig> ?? new();
    var wcOrder = new[] { "C", "B", "A", "A_Opt", "R", "L", "M" };
    var orderedWcs = stationsByWc.Keys
        .OrderBy(k => { var i = Array.IndexOf(wcOrder, k); return i < 0 ? 99 : i; })
        .ToList();
    var firstWc = orderedWcs.FirstOrDefault();
    var primary = firstWc != null ? stationsByWc[firstWc] : null;
    var shootSec = primary?.ShootingTimeSec ?? 0;
    var anyMin = stationsByWc.Values.Any(s => s.MinShotsPerFigure > 0);
    var anyMaxLimited = stationsByWc.Values.Any(s => s.MaxShotsPerFigure < 6);
    // Compact mode (printed station card): Förutsättningar only — figures + timeline
    // are revealed only when scanning the QR, never on the printed card.
    var compact = ViewData["CompactNoTargets"] is true;
}

<div class="container py-3" style="max-width:820px">
    <h3 class="border-bottom pb-2 mb-3">
        <i class="bi bi-geo-alt-fill me-2"></i>Station @stationNumber@(string.IsNullOrEmpty(competitionName) ? "" : " — " + competitionName)
    </h3>

    @if (primary == null)
    {
        <div class="alert alert-warning">Stationens förutsättningar kunde inte läsas.</div>
    }
    else
    {
        <div class="card mb-3">
            <div class="card-header fw-bold py-2">Förutsättningar</div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Vapenklass</th>
                            <th>Skjuttid</th>
                            <th>Utgångsläge</th>
                            <th>Vapenläge</th>
                            <th>Stödhand</th>
                            @if (anyMin) { <th>Min träff/fig</th> }
                            @if (anyMaxLimited) { <th>Max träff/fig</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var wc in orderedWcs)
                        {
                            var st = stationsByWc[wc];
                            <tr>
                                <td class="fw-bold">@wc</td>
                                <td>@st.ShootingTimeSec s</td>
                                <td>@st.ShooterStartPosition</td>
                                <td>@st.WeaponStartPosition</td>
                                <td>@st.SupportHand</td>
                                @if (anyMin) { <td>@(st.MinShotsPerFigure > 0 ? st.MinShotsPerFigure.ToString() : "—")</td> }
                                @if (anyMaxLimited) { <td>@(st.MaxShotsPerFigure < 6 ? st.MaxShotsPerFigure.ToString() : "—")</td> }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (compact)
        {
            <p class="text-muted small mb-0"><i class="bi bi-qr-code-scan me-1"></i>Skanna QR-koden vid stationen för figurer och tidslinje.</p>
        }
        else if (primary.IsShootOffOnly)
        {
            <div class="alert alert-info"><i class="bi bi-bullseye me-2"></i>Station @stationNumber är en särskjutningsstation.</div>
        }
        else
        {
            if (orderedWcs.Count > 1)
            {
                <p class="text-muted small mb-2"><i class="bi bi-info-circle me-1"></i>Tidslinjen nedan visar vapenklass <strong>@firstWc</strong> (@shootSec s skjuttid). Andra klasser kan ha annan skjuttid — se tabellen ovan.</p>
            }

            foreach (var tg in primary.TargetGroups)
            {
                var letter = (char)(64 + tg.Group);
                <div class="card mb-2">
                    <div class="card-header py-2 fw-bold">Målgrupp @letter</div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(tg.Description))
                        {
                            <p class="fst-italic small mb-2">@tg.Description</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(tg.ImageUrl))
                        {
                            <div class="text-center mb-2"><img src="@tg.ImageUrl" alt="Målgrupp @letter" style="max-width:80%;max-height:200px;border-radius:6px" /></div>
                        }
                        @foreach (var fig in tg.Figures)
                        {
                            var bands = shootSec > 0 ? FigBands(fig, shootSec) : new List<int[]>();
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <div style="width:170px;flex-shrink:0;font-size:.8rem;line-height:1.15">
                                    <strong>Fig @fig.FigureNumber</strong>@(fig.IsPoangmal ? " ★" : "")@(fig.TargetsPerFigure > 1 ? $" ({fig.TargetsPerFigure} mål)" : "")
                                    <div class="text-muted">@FigTiming(fig)</div>
                                </div>
                                <div style="flex-grow:1;position:relative;height:18px;background:#e9ecef;border-radius:3px;overflow:hidden">
                                    @foreach (var band in bands)
                                    {
                                        var left = (double)band[0] / shootSec * 100;
                                        var width = (double)(band[1] - band[0]) / shootSec * 100;
                                        <div style="position:absolute;top:0;bottom:0;left:@(Pct(left))%;width:@(Pct(width))%;background:#198754"></div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <p class="text-muted small mt-2">★ = poängmål. Gröna fält visar när figuren är synlig under skjuttiden (0–@shootSec s).</p>
        }
    }
</div>
