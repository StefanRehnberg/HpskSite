@* Snabblänkdokumenten: utloggad = eget kort med publika dokument; inloggad = platshållaren inuti Snabblänkar (fylls av skriptet). *@
@model HpskSite.Services.SitePages.SitePanelContext
@if (!Model.LoggedIn)
{
    <div id="publicQuickLinkDocumentsCard" class="card mb-4" style="display: none;">
        <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Dokument</h5>
        </div>
        <div class="list-group list-group-flush" id="publicQuickLinkDocuments"></div>
    </div>
}
else
{
    <div id="clubQuickLinkDocuments"></div>
}
