@{
    var feeRegionId = ViewBag.regionContentId as int? ?? 0;
    // Läsläge för styrelsen och revisorn på ekonomisidan: samma lista, inga knappar.
    var feeReadOnly = ViewData["feesReadOnly"] as bool? ?? false;
}
@*
    KRETSAVGIFTEN — kretsens årsavgift till sina klubbar. Bor på ekonomisidan (rälsposten Kretsavgift).

    ⚠️⚠️ SAJTENS EGET FORMSPRÅK, INGA EGNA MÖNSTER (Stefan 2026-09-23: "jag gillar inte att det
    grafiska språket har ändrats"). En tidigare utsåga hade understrukna klickbara tal, en
    "Ändra"-länk för inställningen och knappar UNDER listan — inget av det finns någon annanstans.
    Husets form, samma som Klubbvapen och Anmälningar:
      - EN blå Åtgärder uppe till höger (btn-primary shadow, bi-sliders) med grupperade rubriker —
        den agerar på hela listan: Skicka, Påminn, och Inställningar (avgiften för året).
      - Per rad: [Betald] och en liten grå Åtgärder. Ändringar öppnas i en DIALOG, aldrig inline.
      - Inställningen är en DIALOG bakom Åtgärder; på sidan står bara vad avgiften är, som text.

    ⚠️⚠️ RADEN SER LIKADAN UT FÖRE OCH EFTER UTSKICKET (Ove, 70). Bara Status ändras:
    Inte skickad → Skickad 23 sep → ✓ Betald 23 sep. Allt går att göra FÖRE utskicket; därför
    skapas avgiften (oskickad) när kretsen rör raden: EnsureRegionCharge.

    Samma motor som klubbens medlemsavgift: samma tabell, samma betalsida, samma MarkPaid.
    Knapparna bär id:n och läses med en delegerad lyssnare — aldrig ett klubbnamn i ett onclick.
*@
<style>
    #rfRoot td, #rfRoot th { vertical-align: middle; }
    #rfRoot .rf-total td { border-top: 2px solid var(--bs-border-color); font-weight: 600; }
    /* Ett belopp får aldrig brytas mitt i ("200 / kr"). */
    #rfRoot .rf-n { white-space: nowrap; }
    @@media (max-width: 575.98px) { #rfRoot tr.rf-main td { border-bottom: 0; padding-bottom: 0; } }
    /* Starter och tävlingar syns bara när kretsen tar betalt för dem. */
    #rfRoot.rf-nocomp .rf-cc { display: none !important; }
    #rfModal .rf-series { border-top: 1px solid var(--bs-border-color); padding-top: .5rem; margin-top: .75rem; }
    #rfModal .rf-series:first-child { border-top: 0; margin-top: 0; padding-top: 0; }
    #rfModal .rf-complist { max-height: 55vh; overflow-y: auto; }
</style>

<div id="rfRoot">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <div class="fw-semibold" id="rfRateLine"></div>
            <div class="small text-muted" id="rfSummary"></div>
            <span id="rfTitleYear" class="d-none"></span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select id="rfYear" class="form-select" style="width:auto" aria-label="År"></select>
            @if (!feeReadOnly)
            {
            @* Sidnivåns Åtgärder: blå och stor, samma form som Klubbvapen och Anmälningar — den agerar
               på HELA listan. Radernas menyer är små och grå. *@
            <div class="dropdown">
                <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="rfPageMenu">
                    <i class="bi bi-sliders me-2"></i>Åtgärder
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width:280px">
                    <li><h6 class="dropdown-header">Skicka</h6></li>
                    <li><button class="dropdown-item" type="button" id="rfSend"><i class="bi bi-envelope me-2"></i><span></span></button></li>
                    <li><button class="dropdown-item" type="button" id="rfRemind"><i class="bi bi-bell me-2"></i><span></span></button></li>
                    <li><span class="dropdown-item-text small text-muted d-none" id="rfNothingToSend">Alla klubbar har fått avgiften.</span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Inställningar</h6></li>
                    <li><button class="dropdown-item" type="button" id="rfEditRate"><i class="bi bi-cash-coin me-2"></i><span>Avgiften</span></button></li>
                    <li><button class="dropdown-item" type="button" id="rfEditComps"><i class="bi bi-trophy me-2"></i><span>Tävlingar som ingår…</span></button></li>
                </ul>
            </div>
            }
        </div>
    </div>

    <div class="alert alert-danger d-none" id="rfError"></div>
    <div class="alert alert-success d-none" id="rfOk"></div>

    @* Ingen avgift bestämd för året: säg det, och erbjud att bestämma den. *@
    <div class="text-center py-4 d-none" id="rfNoRate">
        <p class="mb-3" id="rfNoRateText"></p>
        @if (!feeReadOnly)
        {
        <button type="button" class="btn btn-primary" id="rfNoRateBtn">Bestäm avgiften</button>
        }
    </div>

    <div id="rfListWrap" class="d-none">
        <div class="table-responsive">
            <table class="table align-middle mb-2">
                <thead><tr>
                    <th>Klubb</th>
                    <th class="d-none d-md-table-cell">E-post</th>
                    <th class="text-end"><span class="d-none d-sm-inline">Medlemmar</span><span class="d-sm-none" title="Medlemmar">Medl.</span></th>
                    <th class="text-end rf-cc d-none d-md-table-cell">Starter</th>
                    <th class="text-end rf-cc d-none d-md-table-cell">Tävlingar</th>
                    <th class="text-end">Att betala</th>
                    <th class="d-none d-sm-table-cell">Status</th>
                    <th class="text-end d-none d-sm-table-cell"><span class="visually-hidden">Åtgärder</span></th>
                </tr></thead>
                <tbody id="rfRows"></tbody>
            </table>
        </div>
    </div>
</div>

@* EN dialog för alla ändringar — avgiften, antal, belopp, en ny rad. Samma form som resten av sajtens
   dialoger: rubrik, fält, Avbryt och en blå sparknapp. *@
<div class="modal fade" id="rfModal" tabindex="-1" aria-hidden="true" aria-labelledby="rfModalTitle">
    <div class="modal-dialog" id="rfModalDialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rfModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div id="rfModalBody"></div>
                <div class="alert alert-danger d-none mt-3 mb-0" id="rfModalError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="rfModalSave">Spara</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    if (window.__regionFeeInit) return;
    window.__regionFeeInit = true;

    var REGION_ID = @feeRegionId;
    var READONLY = @(feeReadOnly ? "true" : "false");
    var F = '/umbraco/surface/MembershipFeeAdmin/';
    var data = null;
    var MONTHS = ['jan','feb','mar','apr','maj','jun','jul','aug','sep','okt','nov','dec'];

    function $(id) { return document.getElementById(id); }
    function esc(s) {
        return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function kr(n) { return (Math.round((n || 0) * 100) / 100).toLocaleString('sv-SE', { maximumFractionDigits: 2 }) + ' kr'; }
    function day(iso) { if (!iso) return ''; var p = iso.split('-'); return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1]; }
    function year() { return parseInt($('rfYear').value, 10); }
    function show(el, on) { if (el) el.classList.toggle('d-none', !on); }
    // En ruta för positiva besked (grön, eller gul när något inte gick fram), en för fel.
    function msg(ok, text, kind) {
        $('rfOk').className = 'alert ' + (kind === 'warn' ? 'alert-warning' : 'alert-success');
        show($('rfOk'), ok && !!text); show($('rfError'), !ok && !!text);
        $(ok ? 'rfOk' : 'rfError').textContent = text || '';
    }

    async function token() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        if (el && el.value) return el.value;
        return (await (await fetch('/umbraco/surface/Club/GetFormToken', { cache: 'no-store' })).json()).token;
    }
    async function post(url, body) {
        var r = await fetch(F + url, { method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': await token() },
            body: JSON.stringify(body) });
        var t = await r.text();
        try { return JSON.parse(t); } catch (e) { return { success: false, message: 'Något gick fel (' + r.status + ').' }; }
    }
    async function postForm(url, fields) {
        var fd = new FormData();
        Object.keys(fields).forEach(function (k) { fd.append(k, fields[k]); });
        fd.append('__RequestVerificationToken', await token());
        return (await fetch(F + url, { method: 'POST', body: fd })).json();
    }

    function rowOf(clubId) { return (data.rows || []).find(function (r) { return r.clubId === clubId; }); }

    // ⚠️ Varje handling på en rad börjar här: klubbens avgift skapas OSKICKAD om den inte finns. Det
    //    är det som gör att raden kan bete sig likadant före och efter utskicket.
    async function chargeIdFor(clubId) {
        var r = rowOf(clubId);
        if (r && r.charge) return r.charge.id;
        var e = await post('EnsureRegionCharge', { regionId: REGION_ID, year: year(), clubId: clubId });
        if (!e.success) { msg(false, e.message); return null; }
        return e.chargeId;
    }

    // Vad taxan ger för ett antal — speglar RegionFeeCalculator. Bara för att avgöra om ett inskrivet
    // belopp är "eget"; servern räknar det riktiga beloppet.
    function byRate(count, starts, comps) {
        var r = data.rate, b = r.baseAmount || 0, p = r.perMember || 0, ps = r.perStart || 0, pc = r.perCompetition || 0;
        return (b > 0 ? b : 0) + (p > 0 && count > 0 ? Math.round(p * count * 100) / 100 : 0)
             + (ps > 0 && starts > 0 ? Math.round(ps * starts * 100) / 100 : 0)
             + (pc > 0 && comps > 0 ? Math.round(pc * comps * 100) / 100 : 0);
    }
    function usesComps(r) { return (r.perStart || 0) > 0 || (r.perCompetition || 0) > 0; }
    // ⚠️ En mening, i klartext — samma som förut, plus starter och tävlingar när de finns. Tomt = ingen taxa.
    function rateSentence(r) {
        var parts = [];
        if ((r.baseAmount || 0) > 0) parts.push(kr(r.baseAmount));
        if ((r.perMember || 0) > 0) parts.push(kr(r.perMember) + ' per medlem');
        if ((r.perStart || 0) > 0) parts.push(kr(r.perStart) + ' per start');
        if ((r.perCompetition || 0) > 0) parts.push(kr(r.perCompetition) + ' per tävling');
        if (parts.length === 0) return '';
        var last = parts.pop();
        return 'Varje klubb betalar ' + (parts.length ? parts.join(', ') + ' och ' + last : last) + '.';
    }
    function compsSentence() {
        if (!usesComps(data.rate)) return '';
        var n = (data.competitions || []).length;
        return n === 0
            ? 'Inga tävlingar är valda än — välj dem under Åtgärder → Tävlingar som ingår.'
            : 'Starter och tävlingar räknas i ' + n + (n === 1 ? ' vald tävling' : ' valda tävlingar') + ' ur pistol.nu.';
    }
    function qty(lines, kind) {
        var l = lines.find(function (x) { return x.kind === kind; });
        return l ? l.quantity : 0;
    }

    // Radens läge, en gång, så att render, knapparna och summeringen läser samma sak.
    function stateOf(r) {
        var c = r.charge;
        var lines = c ? (c.lines || []) : [];
        return {
            c: c,
            paid: !!c && c.status === 'Paid',
            sent: !!c && !!c.requestSentDate,
            claimed: !!c && !!c.paymentSentDate,
            amount: c ? c.amount : r.proposedAmount,
            count: c ? c.memberCount : r.proposedCount,
            // Det som debiteras: raden om avgiften finns, annars pistol.nu:s förslag.
            starts: c ? (c.startCount != null ? c.startCount : qty(lines, 'per-start')) : r.proposedStarts,
            comps: c ? (c.competitionCount != null ? c.competitionCount : qty(lines, 'per-competition')) : r.proposedCompetitions,
            countsOwn: !!c && (c.startCount != null || c.competitionCount != null),
            manual: lines.some(function (l) { return l.kind === 'manual'; }),
            extras: lines.filter(function (l) { return l.kind === 'extra'; })
        };
    }

    // ⚠️ Status som på resten av sajten (Anmälningar, Fakturor): en BRICKA, datum intill i grått.
    //    Betald = grön, Väntande = gul (skickad, inte betald), Inte skickad = grå.
    function badge(cls, text, note) {
        return '<span class="badge ' + cls + '">' + text + '</span>' + (note ? ' <span class="small text-muted">' + note + '</span>' : '');
    }
    function statusCell(r, s) {
        if (s.paid) return badge('bg-success', 'Betald', s.c.paidDate ? day(s.c.paidDate) : '');
        if (s.claimed) return badge('bg-info text-dark', 'Uppgett betald', day(s.c.paymentSentDate));
        if (s.amount <= 0) return badge('bg-light text-dark border', 'Ingen avgift');
        if (s.sent) return badge('bg-warning text-dark', 'Väntande', 'skickad ' + day(s.c.requestSentDate));
        return badge('bg-secondary', 'Inte skickad');
    }
    // Vart avgiften mejlas. Saknas adress står det i listan — inte i en text under den.
    function emailCell(r) {
        if (!r.hasEmail) return '<span class="badge bg-danger-subtle text-danger-emphasis border">Ingen e-post</span>';
        return '<span class="small">' + esc(r.email) + '</span>';
    }

    function item(act, clubId, text, extra) {
        return '<li><button type="button" class="dropdown-item' + (extra || '') + '" data-rf-act="' + act
             + '" data-rf-id="' + clubId + '">' + text + '</button></li>';
    }

    // ⚠️ SAMMA meny före och efter utskicket. Grupperad som husets radmenyer, destruktivt sist i rött.
    function actionsCell(r, s) {
        if (READONLY) return '';
        var id = r.clubId, items = [];
        if (s.paid) {
            items.push(item('unpaid', id, 'Ångra betald'));
        } else {
            // Betald ligger i menyn som allt annat på raden — samma form som resten av sajten.
            if (s.amount > 0) {
                items.push('<li><h6 class="dropdown-header">Betalning</h6></li>');
                items.push(item('paid', id, 'Markera som betald'));
                items.push('<li><hr class="dropdown-divider"></li>');
            }
            items.push('<li><h6 class="dropdown-header">Avgiften</h6></li>');
            items.push(item('count', id, 'Ändra antal medlemmar…'));
            if (usesComps(data.rate)) items.push(item('comp-counts', id, 'Ändra antal starter och tävlingar…'));
            if (!s.sent) items.push(item('amount', id, 'Ändra beloppet…'));
            items.push(item('line', id, 'Lägg till en rad, t.ex. lagavgift…'));
            s.extras.forEach(function (l) {
                items.push('<li><button type="button" class="dropdown-item" data-rf-act="line-remove" data-rf-id="' + id
                    + '" data-rf-line="' + l.id + '">Ta bort raden: ' + esc(l.description) + '</button></li>');
            });
            items.push('<li><hr class="dropdown-divider"></li>');
            items.push('<li><h6 class="dropdown-header">Mejlet</h6></li>');
            items.push(item('preview', id, 'Visa mejlet'));
            if (r.hasEmail && s.amount > 0) items.push(item('send-one', id, s.sent ? 'Skicka mejlet igen' : 'Skicka mejlet nu'));
            items.push(item('link', id, 'Kopiera betallänk'));
            items.push(item('email', id, 'E-post för avgiften…'));
            if (s.c && !s.claimed) {
                items.push('<li><hr class="dropdown-divider"></li>');
                items.push(s.sent ? item('delete', id, 'Ta bort avgiften', ' text-danger')
                                  : item('zero', id, 'Ingen avgift för klubben i år', ' text-danger'));
            }
        }
        // ⚠️ strategy:fixed — tabellen ligger i .table-responsive, vars overflow annars klipper menyn.
        return '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" '
             + 'data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\'>Åtgärder</button>'
             + '<ul class="dropdown-menu dropdown-menu-end">' + items.join('') + '</ul></div>';
    }

    function render() {
        $('rfTitleYear').textContent = data.year;
        var sentence = rateSentence(data.rate);
        var hasRate = sentence !== '';

        $('rfRateLine').textContent = hasRate ? sentence : '';
        $('rfRoot').classList.toggle('rf-nocomp', !usesComps(data.rate));
        var cs = compsSentence();
        show($('rfNoRate'), !hasRate);
        $('rfNoRateText').textContent = 'Kretsen har inte bestämt avgiften för ' + data.year + ' än.';
        show($('rfListWrap'), hasRate);
        if ($('rfEditRate')) $('rfEditRate').querySelector('span').textContent = 'Avgiften för ' + data.year + '…';

        var rows = data.rows || [];
        var html = '', total = 0, billed = 0, paidCount = 0, paidSum = 0, toSend = 0, noMail = 0, toRemind = 0;

        rows.forEach(function (r) {
            var s = stateOf(r);
            total += s.amount;
            if (s.amount > 0) billed++;
            if (s.paid) { paidCount++; paidSum += s.amount; }
            if (!s.paid && !s.sent && s.amount > 0) { if (r.hasEmail) toSend++; else noMail++; }
            if (!s.paid && s.sent) toRemind++;

            var countLabel = s.count == null ? '—' : s.count;
            var own = s.countsOwn ? '<div class="small text-muted">ändrat</div>' : '';
            html += '<tr class="rf-main"><td>' + esc(r.clubName)
                  + (s.extras.length ? '<div class="small text-muted">inkl. ' + s.extras.map(function (l) {
                        return esc(l.description.toLowerCase()) + ' ' + kr(l.amount); }).join(', ') + '</div>' : '')
                  // Mindre skärmar: antalen under klubbens namn i stället för i egna kolumner.
                  + (usesComps(data.rate) ? '<div class="small text-muted d-md-none">' + s.starts + ' starter · ' + s.comps + ' tävlingar</div>' : '')
                  + '</td>'
                  + '<td class="d-none d-md-table-cell">' + emailCell(r) + '</td>'
                  + '<td class="text-end rf-n">' + esc(countLabel) + '</td>'
                  + '<td class="text-end rf-n rf-cc d-none d-md-table-cell">' + s.starts + own + '</td>'
                  + '<td class="text-end rf-n rf-cc d-none d-md-table-cell">' + s.comps + '</td>'
                  + '<td class="text-end rf-n">' + kr(s.amount) + (s.manual ? '<div class="small text-muted">eget belopp</div>' : '') + '</td>'
                  + '<td class="small rf-status d-none d-sm-table-cell">' + statusCell(r, s) + '</td>'
                  + '<td class="text-end rf-n rf-actions d-none d-sm-table-cell">' + actionsCell(r, s) + '</td></tr>'
                  // På telefon ryms inte fem kolumner: status och knappar får en egen rad under klubben.
                  + '<tr class="rf-mrow d-sm-none"><td colspan="3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">'
                  + '<span>' + statusCell(r, s) + (r.hasEmail ? '' : ' ' + emailCell(r)) + '</span>' + actionsCell(r, s) + '</div></td></tr>';
        });

        html += '<tr class="rf-total"><td>Totalt</td><td class="d-none d-md-table-cell"></td><td></td>'
              + '<td class="rf-cc d-none d-md-table-cell"></td><td class="rf-cc d-none d-md-table-cell"></td>'
              + '<td class="text-end rf-n">' + kr(total) + '</td><td class="d-none d-sm-table-cell"></td><td class="d-none d-sm-table-cell"></td></tr>';
        $('rfRows').innerHTML = html;

        $('rfSummary').textContent = (hasRate
            ? paidCount + ' av ' + billed + ' klubbar har betalat · ' + kr(paidSum) + ' av ' + kr(total) : '')
            + (cs ? (hasRate ? ' · ' : '') + cs : '');

        // Sidans Åtgärder: skicka och påminn visas bara när det finns något att göra.
        if ($('rfSend')) {
            $('rfSend').querySelector('span').textContent = 'Skicka avgiften till ' + toSend + (toSend === 1 ? ' klubb' : ' klubbar');
            $('rfRemind').querySelector('span').textContent = 'Påminn ' + toRemind + (toRemind === 1 ? ' klubb' : ' klubbar') + ' som inte betalat';
            show($('rfSend').parentElement, hasRate && toSend > 0);
            show($('rfRemind').parentElement, hasRate && toRemind > 0);
            show($('rfNothingToSend'), !(hasRate && (toSend > 0 || toRemind > 0)));
            $('rfNothingToSend').textContent = hasRate ? 'Alla klubbar har fått avgiften.' : 'Bestäm avgiften först.';
        }

    }

    // ⚠️ load() rör INTE beskedet. Den körs direkt efter Skicka, och ett tömt besked betyder att
    //    kassören aldrig får veta vad som hände.
    // ⚠️ Ett svar som kommer efter ett årsbyte gäller fel år och får INTE skriva över listan —
    //    annars står förra årets siffror under det nya året. Varje laddning bär sitt nummer.
    var loadSeq = 0;
    async function load() {
        var mine = ++loadSeq;
        var d = await (await fetch(F + 'GetRegionOverview?regionId=' + REGION_ID + '&year=' + year(), { cache: 'no-store' })).json();
        if (mine !== loadSeq) return;
        if (!d.success) { msg(false, d.message || 'Kretsavgiften gick inte att läsa.'); return; }
        data = d;
        render();
    }
    window.hpskLoadRegionFees = load;

    // ── Dialogen ─────────────────────────────────────────────────────────────────────────
    var modalSave = null;
    function field(id, label, value, suffix, type) {
        return '<div class="mb-3"><label class="form-label" for="' + id + '">' + label + '</label>'
             + '<div class="input-group"><input id="' + id + '" type="' + (type || 'number') + '" '
             + (type === 'text' ? 'maxlength="200"' : 'min="0" step="1"') + ' class="form-control" autocomplete="off" value="' + esc(value == null ? '' : value) + '">'
             + (suffix ? '<span class="input-group-text">' + suffix + '</span>' : '') + '</div></div>';
    }
    function openForm(title, bodyHtml, onSave, wide) {
        // Tävlingslistan behöver bredd; övriga dialoger är vanliga.
        $('rfModalDialog').className = 'modal-dialog' + (wide ? ' modal-lg modal-dialog-scrollable' : '');
        $('rfModalTitle').textContent = title;
        $('rfModalBody').innerHTML = bodyHtml;
        show($('rfModalError'), false);
        modalSave = onSave;
        var m = bootstrap.Modal.getOrCreateInstance($('rfModal'));
        m.show();
        setTimeout(function () { var f = $('rfModalBody').querySelector('input'); if (f) { f.focus(); f.select(); } }, 300);
    }
    function num(id) { var v = parseFloat(($(id) || {}).value); return isNaN(v) ? 0 : Math.max(0, v); }
    $('rfModalSave').addEventListener('click', async function () {
        if (!modalSave) return;
        var btn = this; btn.disabled = true;
        var error = await modalSave();
        btn.disabled = false;
        // ⚠️ Dialogen stängs INTE vid fel — annars får man börja om för att läsa vad som gick snett.
        if (error) { $('rfModalError').textContent = error; show($('rfModalError'), true); return; }
        bootstrap.Modal.getOrCreateInstance($('rfModal')).hide();
        msg(true, '');
        load();
    });
    $('rfModal').addEventListener('keydown', function (ev) {
        if (ev.key === 'Enter' && ev.target.tagName === 'INPUT') { ev.preventDefault(); $('rfModalSave').click(); }
    });

    function textField(id, label, value) {
        return '<div class="mb-3"><label class="form-label" for="' + id + '">' + label + '</label>'
             + '<input id="' + id + '" type="text" maxlength="60" class="form-control" autocomplete="off" value="' + esc(value || '') + '"></div>';
    }
    function openRateForm() {
        var r0 = data.rate;
        openForm('Avgiften för ' + data.year,
            '<p class="text-muted small">Hur mycket ska klubbarna betala? Fyll i det som gäller, resten lämnar du tomt.</p>'
            + field('rfBase', 'Fast belopp per klubb', r0.baseAmount || '', 'kr')
            + field('rfPer', 'Per medlem', r0.perMember || '', 'kr')
            + '<h6 class="mt-4">Kretsens tävlingar</h6>'
            + '<p class="text-muted small">pistol.nu räknar varje klubbs starter i de tävlingar kretsen väljer. '
            + 'En skytt som skjuter två klasser har två starter. Antalet går att ändra för varje klubb.</p>'
            + '<div class="row g-2"><div class="col-sm-5">' + field('rfPerStart', 'Per start', r0.perStart || '', 'kr') + '</div>'
            + '<div class="col-sm-7">' + textField('rfStartLabel', 'Radens namn på räkningen', r0.startLabel) + '</div></div>'
            + '<div class="row g-2"><div class="col-sm-5">' + field('rfPerComp', 'Per tävling klubben deltog i', r0.perCompetition || '', 'kr') + '</div>'
            + '<div class="col-sm-7">' + textField('rfCompLabel', 'Radens namn på räkningen', r0.competitionLabel) + '</div></div>'
            + '<p class="text-muted small mb-0">Avgifter som redan skickats ändras inte.</p>',
            async function () {
                var b = num('rfBase'), p = num('rfPer'), ps = num('rfPerStart'), pc = num('rfPerComp');
                if (b <= 0 && p <= 0 && ps <= 0 && pc <= 0) return 'Fyll i ett belopp.';
                var r = await post('SaveRegionRate', { regionId: REGION_ID, year: year(), baseAmount: b, perMember: p,
                    perStart: ps, perCompetition: pc, startLabel: $('rfStartLabel').value, competitionLabel: $('rfCompLabel').value });
                if (!r.success) return r.message;
                // Nyss valt att ta betalt per start men inga tävlingar valda: nästa steg är valet.
                if ((ps > 0 || pc > 0) && (data.competitions || []).length === 0)
                    setTimeout(openCompsForm, 400);
                return null;
            });
    }
    if ($('rfEditRate')) $('rfEditRate').addEventListener('click', openRateForm);

    // ── Tävlingar som ingår ───────────────────────────────────────────────────────────────
    // ⚠️ Listan byggs ur kretsens tävlingar det året (både kretsens egna och klubbarnas), grupperad per
    //    serie. En hel serie väljs med en ruta — Hallandsserien är sju till tio omgångar.
    async function openCompsForm() {
        var d = await (await fetch(F + 'GetRegionFeeCompetitions?regionId=' + REGION_ID + '&year=' + year(), { cache: 'no-store' })).json();
        if (!d.success) { msg(false, d.message || 'Tävlingarna gick inte att läsa.'); return; }
        var groups = [], bySeries = {};
        (d.competitions || []).forEach(function (c) {
            var key = c.series || '';
            if (!bySeries[key]) { bySeries[key] = []; groups.push(key); }
            bySeries[key].push(c);
        });
        var html = '<p class="text-muted small">Välj de tävlingar under ' + d.year + ' som kretsens avgift ska räknas på. '
                 + 'Saknas en tävling på pistol.nu ändrar du antalet för klubben i stället.</p>';
        if (d.missing > 0) html += '<div class="alert alert-warning small">' + d.missing + ' tidigare vald' + (d.missing === 1 ? '' : 'a')
                 + ' tävling' + (d.missing === 1 ? ' finns' : 'ar finns') + ' inte längre och räknas inte. Spara för att ta bort den ur valet.</div>';
        if (groups.length === 0) html += '<p class="mb-0">Kretsen har inga tävlingar på pistol.nu under ' + d.year + '.</p>';
        html += '<div class="rf-complist">';
        groups.forEach(function (g, gi) {
            var list = bySeries[g];
            html += '<div class="rf-series"><div class="form-check"><input class="form-check-input" type="checkbox" id="rfSer' + gi
                  + '" data-rf-series="' + gi + '"' + (list.every(function (c) { return c.selected; }) ? ' checked' : '') + '>'
                  + '<label class="form-check-label fw-semibold" for="rfSer' + gi + '">' + esc(g || 'Tävlingar utanför en serie')
                  + ' <span class="text-muted fw-normal small">(' + list.length + ')</span></label></div>';
            list.forEach(function (c) {
                html += '<div class="form-check ms-4"><input class="form-check-input" type="checkbox" id="rfC' + c.id + '" value="' + c.id
                      + '" data-rf-comp="' + gi + '"' + (c.selected ? ' checked' : '') + '>'
                      + '<label class="form-check-label" for="rfC' + c.id + '">' + esc(c.name)
                      + ' <span class="text-muted small">' + day(c.date) + ' · ' + esc(c.type) + ' · ' + esc(c.host) + '</span>'
                      + (c.takesFee ? ' <span class="badge bg-warning-subtle text-warning-emphasis border" title="Skyttarna betalar redan en anmälningsavgift på pistol.nu. Kontrollera att starten inte tas betalt för två gånger.">tar anmälningsavgift</span>' : '')
                      + '</label></div>';
            });
            html += '</div>';
        });
        html += '</div>';
        openForm('Tävlingar som ingår — ' + d.year, html, async function () {
            var ids = Array.prototype.map.call($('rfModalBody').querySelectorAll('input[data-rf-comp]:checked'),
                function (i) { return parseInt(i.value, 10); });
            var r = await post('SaveRegionFeeCompetitions', { regionId: REGION_ID, year: year(), competitionIds: ids });
            if (r.success) msg(true, r.message);
            return r.success ? null : r.message;
        }, true);
    }
    // Seriens ruta styr sina tävlingar, och speglar dem.
    $('rfModalBody').addEventListener('change', function (ev) {
        var t = ev.target;
        if (t.hasAttribute('data-rf-series')) {
            $('rfModalBody').querySelectorAll('input[data-rf-comp="' + t.getAttribute('data-rf-series') + '"]')
                .forEach(function (i) { i.checked = t.checked; });
        } else if (t.hasAttribute('data-rf-comp')) {
            var g = t.getAttribute('data-rf-comp'), all = $('rfModalBody').querySelectorAll('input[data-rf-comp="' + g + '"]');
            var ser = $('rfModalBody').querySelector('input[data-rf-series="' + g + '"]');
            if (ser) ser.checked = Array.prototype.every.call(all, function (i) { return i.checked; });
        }
    });
    if ($('rfEditComps')) $('rfEditComps').addEventListener('click', openCompsForm);
    if ($('rfNoRateBtn')) $('rfNoRateBtn').addEventListener('click', openRateForm);

    // ── Klick i listan ───────────────────────────────────────────────────────────────────
    $('rfRoot').addEventListener('click', async function (ev) {
        var a = ev.target.closest('[data-rf-act]');
        if (!a) return;
        var act = a.getAttribute('data-rf-act'), clubId = parseInt(a.getAttribute('data-rf-id'), 10);
        var row = rowOf(clubId), s = stateOf(row), r, id;

        if (act === 'count') {
            openForm('Antal medlemmar — ' + row.clubName,
                field('rfFormCount', 'Antal medlemmar', s.count == null ? row.proposedCount : s.count)
                + '<p class="text-muted small mb-0">Registret säger ' + row.proposedCount + '. Beloppet räknas om.</p>',
                async function () {
                    var cid = await chargeIdFor(clubId); if (!cid) return 'Avgiften kunde inte skapas.';
                    var x = await post('SetRegionChargeMemberCount', { chargeId: cid, memberCount: Math.round(num('rfFormCount')) });
                    return x.success ? null : x.message;
                });
            return;
        }
        if (act === 'comp-counts') {
            // Underlaget per tävling, så att kretsen ser VAR talet kommer ifrån innan det rättas.
            var names = {};
            (data.competitions || []).forEach(function (c) { names[c.id] = c; });
            var basis = (row.startsByCompetition || []).slice().sort(function (x, y) {
                var a = (names[x.competitionId] || {}).date || '', b = (names[y.competitionId] || {}).date || '';
                return a < b ? -1 : a > b ? 1 : 0;
            }).map(function (b) {
                var c = names[b.competitionId];
                return '<li>' + esc(c ? c.name : 'Tävling ' + b.competitionId) + (c ? ' <span class="text-muted">' + day(c.date) + '</span>' : '')
                     + ': ' + b.starts + (b.starts === 1 ? ' start' : ' starter') + '</li>';
            }).join('');
            var cur = s.c || {};
            openForm('Starter och tävlingar — ' + row.clubName,
                '<p class="small mb-1">pistol.nu räknar <strong>' + row.proposedStarts + ' starter</strong> i <strong>'
                + row.proposedCompetitions + ' av ' + (data.competitions || []).length + ' tävlingar</strong>.</p>'
                + (basis ? '<ul class="small text-muted mb-3">' + basis + '</ul>' : '<p class="small text-muted">Klubben har inga starter i de valda tävlingarna.</p>')
                + field('rfFormStarts', 'Antal starter att debitera', cur.startCount != null ? cur.startCount : '')
                + field('rfFormComps', 'Antal tävlingar att debitera', cur.competitionCount != null ? cur.competitionCount : '')
                + '<p class="text-muted small mb-0">Lämna ett fält tomt för att följa pistol.nu:s räkning. '
                + 'Ett tal du skriver står kvar även om tävlingarna eller resultaten ändras.</p>',
                async function () {
                    function val(id) { var v = $(id).value.trim(); return v === '' ? null : Math.max(0, Math.round(parseFloat(v))); }
                    var sc = val('rfFormStarts'), cc = val('rfFormComps');
                    if ((sc !== null && isNaN(sc)) || (cc !== null && isNaN(cc))) return 'Skriv ett heltal, eller lämna fältet tomt.';
                    var cid = await chargeIdFor(clubId); if (!cid) return 'Avgiften kunde inte skapas.';
                    var x = await post('SetRegionChargeCompetitionCounts', { chargeId: cid, startCount: sc, competitionCount: cc });
                    return x.success ? null : x.message;
                });
            $('rfFormStarts').placeholder = row.proposedStarts + ' enligt pistol.nu';
            $('rfFormComps').placeholder = row.proposedCompetitions + ' enligt pistol.nu';
            return;
        }
        if (act === 'amount') {
            var formula = byRate(s.count == null ? row.proposedCount : s.count, s.starts, s.comps);
            openForm('Belopp — ' + row.clubName,
                field('rfFormAmount', 'Att betala', s.amount, 'kr')
                + '<p class="text-muted small mb-0">Taxan ger ' + kr(formula) + '. Skriv det beloppet för att följa taxan igen.</p>',
                async function () {
                    var v = num('rfFormAmount');
                    var cid = await chargeIdFor(clubId); if (!cid) return 'Avgiften kunde inte skapas.';
                    // Samma belopp som taxan ger = inget eget belopp.
                    var x = await post('SetRegionChargeManualAmount', { chargeId: cid, manualAmount: v === formula ? null : v });
                    return x.success ? null : x.message;
                });
            return;
        }
        if (act === 'line') {
            openForm('Lägg till en rad — ' + row.clubName,
                field('rfFormLineText', 'Vad gäller det?', '', '', 'text')
                + field('rfFormLineAmount', 'Belopp', '', 'kr'),
                async function () {
                    var cid = await chargeIdFor(clubId); if (!cid) return 'Avgiften kunde inte skapas.';
                    var x = await post('AddRegionChargeLine', { chargeId: cid, description: $('rfFormLineText').value, amount: num('rfFormLineAmount') });
                    return x.success ? null : x.message;
                });
            return;
        }
        if (act === 'email') {
            // Kretsens eget adressregister: kassörens adress är sällan klubbens allmänna.
            openForm('E-post för avgiften — ' + row.clubName,
                field('rfFormEmail', 'Skicka kretsavgiften till', row.emailIsOwn ? row.email : '', '', 'email')
                + '<p class="text-muted small mb-0">' + (row.defaultEmail
                    ? 'Lämna tomt för att använda klubbens vanliga adress (' + esc(row.defaultEmail) + ').'
                    : 'Klubben har ingen vanlig adress på pistol.nu.') + ' Klubbens egen adress ändras inte.</p>',
                async function () {
                    var x = await postForm('SetFeeEmail', { issuerType: 1, issuerId: REGION_ID, payerId: clubId, email: $('rfFormEmail').value });
                    return x.success ? null : x.message;
                });
            return;
        }
        if (act === 'preview') {
            // ⚠️ Fönstret öppnas FÖRE await — en webbläsare blockerar ett window.open efter en väntan.
            var w = window.open('about:blank', '_blank');
            id = await chargeIdFor(clubId);
            if (!id) { if (w) w.close(); return; }
            if (w) w.location = F + 'PreviewRegionPaymentRequest?chargeId=' + id;
            if (!row.charge) load();
            return;
        }
        if (act === 'link') {
            id = await chargeIdFor(clubId); if (!id) return;
            r = await (await fetch(F + 'GetPaymentLink?chargeId=' + id, { cache: 'no-store' })).json();
            if (!r.success) { msg(false, r.message); return; }
            try { await navigator.clipboard.writeText(r.url); msg(true, 'Betallänken för ' + row.clubName + ' är kopierad. Klistra in den i ett mejl eller sms till klubben.'); }
            catch (x) { msg(true, 'Betallänk för ' + row.clubName + ': ' + r.url); }
            load();
            return;
        }
        if (act === 'send-one') {
            id = await chargeIdFor(clubId); if (!id) return;
            r = await post('SendRegionPaymentRequests', { regionId: REGION_ID, year: year(), chargeIds: [id] });
            report(r);
            load();
            return;
        }

        a.disabled = true;
        if (act === 'paid') {
            id = await chargeIdFor(clubId);
            r = id ? await postForm('MarkPaid', { chargeId: id }) : null;
        } else if (act === 'unpaid') {
            r = await postForm('MarkUnpaid', { chargeId: row.charge.id });
        } else if (act === 'line-remove') {
            r = await post('RemoveRegionChargeLine', { chargeId: row.charge.id, lineId: parseInt(a.getAttribute('data-rf-line'), 10) });
        } else if (act === 'zero') {
            r = await post('SetRegionChargeManualAmount', { chargeId: row.charge.id, manualAmount: 0 });
        } else if (act === 'delete') {
            if (!window.confirm('Ta bort avgiften för ' + row.clubName + '? Klubben har redan fått ett mejl om den.')) { a.disabled = false; return; }
            r = await post('DeleteRegionCharge', { chargeId: row.charge.id });
        } else { a.disabled = false; return; }

        if (!r || !r.success) { if (r) msg(false, r.message); a.disabled = false; if (!row.charge) load(); return; }
        msg(true, '');
        load();
    });

    // ── Skicka och påminn (sidans Åtgärder) ──────────────────────────────────────────────
    if ($('rfSend')) $('rfSend').addEventListener('click', async function () {
        var list = (data.rows || []).filter(function (r) { var s = stateOf(r); return !s.paid && !s.sent && s.amount > 0 && r.hasEmail; });
        if (list.length === 0) return;
        var sum = list.reduce(function (a, r) { return a + stateOf(r).amount; }, 0);
        if (!window.confirm('Mejla kretsavgiften ' + data.year + ' till ' + list.length + ' klubbar, totalt ' + kr(sum) + '?')) return;

        // Klubbar som ingen rört har ingen avgift än — den skapas nu, med registrets antal.
        var missing = (data.rows || []).filter(function (r) { return !r.charge && r.proposedAmount > 0; });
        if (missing.length > 0) {
            var g = await post('GenerateRegionCharges', { regionId: REGION_ID, year: year(),
                clubs: missing.map(function (r) { return { clubId: r.clubId, memberCount: r.proposedCount }; }) });
            if (!g.success) { msg(false, g.message); return; }
        }
        report(await post('SendRegionPaymentRequests', { regionId: REGION_ID, year: year(), mode: 'unsent' }));
        load();
    });

    if ($('rfRemind')) $('rfRemind').addEventListener('click', async function () {
        if (!window.confirm('Mejla en påminnelse till klubbarna som inte betalat?')) return;
        report(await post('SendRegionPaymentRequests', { regionId: REGION_ID, year: year(), mode: 'reminder' }));
        load();
    });

    // ⚠️ Beskedet säger vad som FAKTISKT hände. Ett "skickat" om ett mejl som aldrig gick är en lögn.
    function report(s) {
        if (!s || !s.success) { msg(false, 'Mejlen gick inte att skicka. ' + ((s && s.message) || '')); return; }
        var parts = [s.sent + (s.sent === 1 ? ' klubb fick' : ' klubbar fick') + ' ett mejl.'];
        var missed = (s.noEmail || []).concat(s.failed || []);
        if (missed.length > 0) parts.push('Inget mejl gick till ' + missed.join(', ') + '. Välj Åtgärder → Kopiera betallänk på raden och skicka länken själv.');
        msg(true, parts.join(' '), missed.length > 0 ? 'warn' : 'ok');
    }

    // Åren: nästa, i år och tre bakåt.
    var now = new Date().getFullYear();
    for (var y = now + 1; y >= now - 3; y--) {
        var o = document.createElement('option');
        o.value = y; o.textContent = y; if (y === now) o.selected = true;
        $('rfYear').appendChild(o);
    }
    $('rfYear').addEventListener('change', function () { msg(true, ''); load(); });
})();
</script>
