@{
    var feeRegionId = ViewBag.regionContentId as int? ?? 0;
    // Läsläge för styrelsen och revisorn på ekonomisidan: samma lista, inga knappar.
    var feeReadOnly = ViewData["feesReadOnly"] as bool? ?? false;
}
@*
    KRETSAVGIFTEN — kretsens årsavgift till sina klubbar.

    ⚠️⚠️ SIDAN ÄR BYGGD FÖR OVE, 70, LEKMANNAKASSÖR. Tre utsågor underkändes (Stefan 2026-09-23):
    "obegripliga, röriga, för mycket text", och sedan: "sidan blir helt förändrad så fort jag skickat
    mejl — först DÅ dyker en konstig symbol och en Betald-knapp upp; varför fanns de inte innan?"
    Därför:
      - ⚠️⚠️ RADEN SER LIKADAN UT FÖRE OCH EFTER UTSKICKET. Varje rad har alltid samma två knappar,
        [Betald] och [Åtgärder]. Det enda som ändras när mejlet gått är texten i Status-kolumnen:
        Inte skickad → Skickad 23 sep → ✓ Betald 23 sep. Allt som går att göra med en klubb går att
        göra INNAN den fått sin räkning — lägga till en lagavgift, titta på mejlet, markera betald.
        Det är skälet att avgiften skapas (oskickad) så fort kretsen rör raden: EnsureRegionCharge.
      - Knappen heter "Åtgärder" i klartext, aldrig en symbol. En symbol är obegriplig för Ove.
      - Taxan är EN MENING. Fälten syns bara när den sätts eller ändras.
      - Ett tal ändras genom att man klickar på det (eller via Åtgärder).
      - "Skicka avgiften till N klubbar" skickar de som inte gått ut; "Påminn" de som gått ut men
        inte betalats. Två knappar, två frågor.
      - En rad förklarande text. Lägg inte tillbaka en steglista.

    Samma motor som klubbens medlemsavgift: samma tabell, samma betalsida, samma MarkPaid.
    Knapparna bär id:n och läses med en delegerad lyssnare — aldrig ett klubbnamn i ett onclick.
*@
<style>
    #rfRoot .rf-num { border: 0; background: none; padding: 0 2px; color: inherit;
                      border-bottom: 1px dashed var(--bs-secondary-color); cursor: pointer; }
    #rfRoot .rf-num:hover { color: var(--bs-primary); border-bottom-color: var(--bs-primary); }
    #rfRoot .rf-num-input { width: 6rem; display: inline-block; }
    #rfRoot td, #rfRoot th { vertical-align: middle; }
    #rfRoot .rf-total td { border-top: 2px solid var(--bs-border-color); font-weight: 600; }
    /* Ett belopp får aldrig brytas mitt i ("200 / kr"). */
    #rfRoot .rf-n { white-space: nowrap; }
    @@media (max-width: 575.98px) { #rfRoot tr.rf-main td { border-bottom: 0; padding-bottom: 0; } }
</style>

<div id="rfRoot">
    @* Rubriken "Kretsavgift" står på ekonomisidan ovanför; här bara året. rfTitleYear finns kvar
       (dold) — sviten och render() läser vilket år som visas. *@
    <div class="d-flex align-items-center gap-2 mb-2">
        <label class="form-label mb-0 fw-bold" for="rfYear">År</label>
        <select id="rfYear" class="form-select form-select-sm" style="width:auto"></select>
        <span id="rfTitleYear" class="d-none"></span>
    </div>

    <div class="alert alert-danger d-none" id="rfError"></div>
    <div class="alert alert-success d-none" id="rfOk"></div>

    @* Taxan: en mening när den finns, två fält när den ska sättas. *@
    <p class="mb-3" id="rfRateLine"></p>
    <div class="card mb-3 d-none" id="rfRateForm">
        <div class="card-body">
            <div class="fw-semibold mb-2" id="rfRateQuestion">Hur mycket ska klubbarna betala?</div>
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-0" for="rfBase">Fast belopp per klubb</label>
                    <div class="input-group input-group-sm">
                        <input id="rfBase" type="number" min="0" step="1" class="form-control" autocomplete="off">
                        <span class="input-group-text">kr</span>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label small mb-0" for="rfPer">Per medlem</label>
                    <div class="input-group input-group-sm">
                        <input id="rfPer" type="number" min="0" step="1" class="form-control" autocomplete="off">
                        <span class="input-group-text">kr</span>
                    </div>
                </div>
                <div class="col-12 col-md-auto d-flex gap-2">
                    <button type="button" class="btn btn-primary btn-sm" id="rfSaveRate">Spara</button>
                    <button type="button" class="btn btn-link btn-sm d-none" id="rfCancelRate">Avbryt</button>
                </div>
            </div>
            <div class="small text-muted mt-2">Lämna ett av fälten tomt om det inte används.</div>
        </div>
    </div>

    <div id="rfListWrap" class="d-none">
        <div class="small text-muted mb-1" id="rfSummary"></div>
        <div class="table-responsive">
            <table class="table align-middle mb-2">
                <thead><tr>
                    <th>Klubb</th>
                    <th class="text-end"><span class="d-none d-sm-inline">Medlemmar</span><span class="d-sm-none" title="Medlemmar">Medl.</span></th>
                    <th class="text-end">Att betala</th>
                    <th class="d-none d-sm-table-cell">Status</th>
                    <th class="text-end d-none d-sm-table-cell"><span class="visually-hidden">Åtgärder</span></th>
                </tr></thead>
                <tbody id="rfRows"></tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" class="btn btn-primary" id="rfSend"></button>
            <button type="button" class="btn btn-outline-secondary d-none" id="rfRemind"></button>
        </div>
        <div class="small text-muted mt-2" id="rfHint"></div>
    </div>
</div>

<script>
(function () {
    if (window.__regionFeeInit) return;
    window.__regionFeeInit = true;

    var REGION_ID = @feeRegionId;
    var READONLY = @(feeReadOnly ? "true" : "false");
    var F = '/umbraco/surface/MembershipFeeAdmin/';
    var data = null;
    var editing = null;   // { kind: 'count'|'amount'|'line', id: clubId }
    var MONTHS = ['jan','feb','mar','apr','maj','jun','jul','aug','sep','okt','nov','dec'];

    function $(id) { return document.getElementById(id); }
    function esc(s) {
        return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function kr(n) { return (Math.round((n || 0) * 100) / 100).toLocaleString('sv-SE', { maximumFractionDigits: 2 }) + ' kr'; }
    function day(iso) { if (!iso) return ''; var p = iso.split('-'); return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1]; }
    function year() { return parseInt($('rfYear').value, 10); }
    function show(el, on) { if (el) el.classList.toggle('d-none', !on); }
    // En ruta för positiva besked (grön, eller gul när något inte gick fram), en för fel.
    function msg(ok, text, kind) {
        $('rfOk').className = 'alert ' + (kind === 'warn' ? 'alert-warning' : 'alert-success');
        show($('rfOk'), ok && !!text); show($('rfError'), !ok && !!text);
        $(ok ? 'rfOk' : 'rfError').textContent = text || '';
    }

    async function token() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        if (el && el.value) return el.value;
        return (await (await fetch('/umbraco/surface/Club/GetFormToken', { cache: 'no-store' })).json()).token;
    }
    async function post(url, body) {
        var r = await fetch(F + url, { method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': await token() },
            body: JSON.stringify(body) });
        var t = await r.text();
        try { return JSON.parse(t); } catch (e) { return { success: false, message: 'Något gick fel (' + r.status + ').' }; }
    }
    async function postForm(url, fields) {
        var fd = new FormData();
        Object.keys(fields).forEach(function (k) { fd.append(k, fields[k]); });
        fd.append('__RequestVerificationToken', await token());
        return (await fetch(F + url, { method: 'POST', body: fd })).json();
    }

    function rowOf(clubId) { return (data.rows || []).find(function (r) { return r.clubId === clubId; }); }

    // ⚠️ Varje handling på en rad börjar här: klubbens avgift skapas OSKICKAD om den inte finns. Det
    //    är det som gör att raden kan bete sig likadant före och efter utskicket.
    async function chargeIdFor(clubId) {
        var r = rowOf(clubId);
        if (r && r.charge) return r.charge.id;
        var e = await post('EnsureRegionCharge', { regionId: REGION_ID, year: year(), clubId: clubId });
        if (!e.success) { msg(false, e.message); return null; }
        return e.chargeId;
    }

    // Vad taxan ger för ett antal — speglar RegionFeeCalculator. Bara för att avgöra om ett inskrivet
    // belopp är "eget"; servern räknar det riktiga beloppet.
    function byRate(count) {
        var b = data.rate.baseAmount || 0, p = data.rate.perMember || 0;
        return (b > 0 ? b : 0) + (p > 0 && count > 0 ? Math.round(p * count * 100) / 100 : 0);
    }
    function rateSentence(r) {
        var b = r.baseAmount || 0, p = r.perMember || 0;
        if (b > 0 && p > 0) return 'Varje klubb betalar ' + kr(b) + ' + ' + kr(p) + ' per medlem.';
        if (b > 0) return 'Varje klubb betalar ' + kr(b) + '.';
        if (p > 0) return 'Varje klubb betalar ' + kr(p) + ' per medlem.';
        return '';
    }

    // Radens läge, en gång, så att render, knapparna och summeringen läser samma sak.
    function stateOf(r) {
        var c = r.charge;
        var lines = c ? (c.lines || []) : [];
        var manual = lines.some(function (l) { return l.kind === 'manual'; });
        return {
            c: c,
            paid: !!c && c.status === 'Paid',
            sent: !!c && !!c.requestSentDate,
            claimed: !!c && !!c.paymentSentDate,
            amount: c ? c.amount : r.proposedAmount,
            count: c ? c.memberCount : r.proposedCount,
            manual: manual,
            extras: lines.filter(function (l) { return l.kind === 'extra'; })
        };
    }

    function numButton(kind, clubId, value, label, title) {
        if (editing && editing.kind === kind && editing.id === clubId)
            return '<input type="number" min="0" step="1" class="form-control form-control-sm rf-num-input text-end" '
                 + 'data-rf-input="' + kind + '" data-rf-id="' + clubId + '" value="' + esc(value) + '" autocomplete="off">';
        return '<button type="button" class="rf-num" data-rf-edit="' + kind + '" data-rf-id="' + clubId + '" title="' + title + '">'
             + esc(label) + '</button>';
    }

    function statusCell(r, s) {
        if (s.paid) return '<span class="text-success">✓ Betald' + (s.c.paidDate ? ' ' + day(s.c.paidDate) : '') + '</span>';
        if (s.claimed) return '<span>Klubben säger att de betalat</span>';
        if (s.amount <= 0) return '<span class="text-muted">Ingen avgift</span>';
        if (s.sent) return '<span>Skickad ' + day(s.c.requestSentDate) + '</span>';
        return '<span class="text-muted">Inte skickad' + (r.hasEmail ? '' : ' · ingen e-post') + '</span>';
    }

    function item(act, clubId, text, extra) {
        return '<li><button type="button" class="dropdown-item' + (extra || '') + '" data-rf-act="' + act
             + '" data-rf-id="' + clubId + '">' + text + '</button></li>';
    }

    // ⚠️ SAMMA meny före och efter utskicket — det enda som byter ord är "Skicka mejlet" / "igen".
    function actionsCell(r, s) {
        if (READONLY) return '';
        var id = r.clubId, items = [];
        if (s.paid) {
            items.push(item('unpaid', id, 'Ångra betald'));
        } else {
            items.push(item('count', id, 'Ändra antal medlemmar'));
            if (!s.sent) items.push(item('amount', id, 'Ändra beloppet'));
            items.push(item('line', id, 'Lägg till en rad, t.ex. lagavgift'));
            s.extras.forEach(function (l) {
                items.push('<li><button type="button" class="dropdown-item" data-rf-act="line-remove" data-rf-id="' + id
                    + '" data-rf-line="' + l.id + '">Ta bort raden: ' + esc(l.description) + '</button></li>');
            });
            items.push('<li><hr class="dropdown-divider"></li>');
            items.push(item('preview', id, 'Visa mejlet'));
            if (r.hasEmail && s.amount > 0) items.push(item('send-one', id, s.sent ? 'Skicka mejlet igen' : 'Skicka mejlet nu'));
            items.push(item('link', id, 'Kopiera betallänk'));
            if (s.c && !s.claimed) {
                items.push('<li><hr class="dropdown-divider"></li>');
                items.push(s.sent ? item('delete', id, 'Ta bort avgiften', ' text-danger')
                                  : item('zero', id, 'Ingen avgift för klubben i år', ' text-danger'));
            }
        }
        // ⚠️ strategy:fixed — tabellen ligger i .table-responsive, vars overflow annars klipper menyn.
        return '<div class="d-inline-flex gap-1 align-items-center">'
             + (s.paid ? '' : '<button type="button" class="btn btn-sm btn-outline-success" data-rf-act="paid" data-rf-id="' + id + '">Betald</button>')
             + '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" '
             + 'data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\'>Åtgärder</button>'
             + '<ul class="dropdown-menu dropdown-menu-end">' + items.join('') + '</ul></div></div>';
    }

    function lineEditorRow(clubId) {
        return '<tr class="table-light"><td colspan="5"><div class="d-flex flex-wrap gap-2 align-items-center">'
             + '<input type="text" maxlength="200" class="form-control form-control-sm" style="max-width:18rem" id="rfLineText" placeholder="Vad gäller det? t.ex. Lagavgift" autocomplete="off">'
             + '<div class="input-group input-group-sm" style="width:9rem"><input type="number" min="0" step="1" class="form-control" id="rfLineAmount" placeholder="Belopp" autocomplete="off"><span class="input-group-text">kr</span></div>'
             + '<button type="button" class="btn btn-sm btn-primary" data-rf-act="line-save" data-rf-id="' + clubId + '">Lägg till</button>'
             + '<button type="button" class="btn btn-sm btn-link" data-rf-act="cancel" data-rf-id="' + clubId + '">Avbryt</button></div></td></tr>';
    }

    function render() {
        $('rfTitleYear').textContent = data.year;

        var sentence = rateSentence(data.rate);
        var hasRate = sentence !== '';
        $('rfRateLine').innerHTML = hasRate
            ? esc(sentence) + (READONLY ? '' : ' <button type="button" class="btn btn-link btn-sm p-0 align-baseline" id="rfEditRate">Ändra</button>')
            : (READONLY ? 'Kretsen har inte bestämt någon avgift för ' + data.year + ' än.' : '');
        show($('rfRateLine'), hasRate || READONLY);
        if (!hasRate && !READONLY) openRateForm(false);
        show($('rfListWrap'), hasRate);
        if (!hasRate) return;

        var rows = data.rows || [];
        var html = '', total = 0, billed = 0, paidCount = 0, paidSum = 0, toSend = 0, noMail = 0, toRemind = 0;

        rows.forEach(function (r) {
            var s = stateOf(r);
            total += s.amount;
            if (s.amount > 0) billed++;
            if (s.paid) { paidCount++; paidSum += s.amount; }
            if (!s.paid && !s.sent && s.amount > 0) { if (r.hasEmail) toSend++; else noMail++; }
            if (!s.paid && s.sent) toRemind++;

            var editable = !s.paid && !READONLY;
            var countLabel = s.count == null ? '—' : s.count;
            var count = editable
                ? numButton('count', r.clubId, s.count == null ? r.proposedCount : s.count, countLabel, 'Ändra antal medlemmar')
                : esc(countLabel);
            var amount = editable && !s.sent
                ? numButton('amount', r.clubId, s.amount, kr(s.amount), 'Ändra beloppet för den här klubben')
                : kr(s.amount);

            html += '<tr class="rf-main"><td>' + esc(r.clubName)
                  + (s.extras.length ? '<div class="small text-muted">inkl. ' + s.extras.map(function (l) {
                        return esc(l.description.toLowerCase()) + ' ' + kr(l.amount); }).join(', ') + '</div>' : '')
                  + '</td>'
                  + '<td class="text-end rf-n">' + count
                  + (s.count != null && s.count !== r.proposedCount ? '<div class="small text-muted">registret: ' + r.proposedCount + '</div>' : '')
                  + '</td>'
                  + '<td class="text-end rf-n">' + amount + (s.manual ? '<div class="small text-muted">eget belopp</div>' : '') + '</td>'
                  + '<td class="small d-none d-sm-table-cell">' + statusCell(r, s) + '</td>'
                  + '<td class="text-end rf-n rf-actions d-none d-sm-table-cell">' + actionsCell(r, s) + '</td></tr>'
                  // På telefon ryms inte fem kolumner: status och knappar får en egen rad under klubben.
                  + '<tr class="rf-mrow d-sm-none"><td colspan="3"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">'
                  + statusCell(r, s) + actionsCell(r, s) + '</div></td></tr>';
            if (editing && editing.kind === 'line' && editing.id === r.clubId) html += lineEditorRow(r.clubId);
        });

        html += '<tr class="rf-total"><td>Totalt</td><td></td><td class="text-end rf-n">' + kr(total) + '</td><td class="d-none d-sm-table-cell"></td><td class="d-none d-sm-table-cell"></td></tr>';
        $('rfRows').innerHTML = html;

        // Samma rad hela året: hur många av klubbarna som betalat, av vad kretsen ska ha in.
        $('rfSummary').textContent = paidCount + ' av ' + billed + ' klubbar har betalat · ' + kr(paidSum) + ' av ' + kr(total);

        show($('rfSend'), toSend > 0 && !READONLY);
        $('rfSend').textContent = 'Skicka avgiften till ' + toSend + (toSend === 1 ? ' klubb' : ' klubbar');
        show($('rfRemind'), toRemind > 0 && !READONLY);
        $('rfRemind').textContent = 'Påminn ' + toRemind + (toRemind === 1 ? ' klubb' : ' klubbar') + ' som inte betalat';

        // ⚠️ EN rad text, och bara det som behövs för att komma vidare.
        $('rfHint').textContent = noMail === 0 || READONLY ? ''
            : noMail + (noMail === 1 ? ' klubb har' : ' klubbar har') + ' ingen e-postadress. Välj Åtgärder → Kopiera betallänk och skicka länken själv.';

        var input = document.querySelector('[data-rf-input]');
        if (input) { input.focus(); input.select(); }
    }

    function openRateForm(cancelable) {
        show($('rfRateForm'), true);
        show($('rfCancelRate'), cancelable);
        $('rfRateQuestion').textContent = 'Hur mycket ska klubbarna betala ' + data.year + '?';
        $('rfBase').value = data.rate.baseAmount || '';
        $('rfPer').value = data.rate.perMember || '';
    }

    // ⚠️ load() rör INTE beskedet. Den körs direkt efter Skicka, och ett tömt besked betyder att
    //    Ove aldrig får veta vad som hände när han tryckte.
    async function load() {
        var d = await (await fetch(F + 'GetRegionOverview?regionId=' + REGION_ID + '&year=' + year(), { cache: 'no-store' })).json();
        if (!d.success) { msg(false, d.message || 'Kretsavgiften gick inte att läsa.'); return; }
        data = d;
        show($('rfRateForm'), false);
        render();
    }
    window.hpskLoadRegionFees = load;

    // ── Klick ────────────────────────────────────────────────────────────────────────────
    $('rfRoot').addEventListener('click', async function (ev) {
        if (ev.target.id === 'rfEditRate') { openRateForm(true); return; }

        var e = ev.target.closest('[data-rf-edit]');
        if (e) { editing = { kind: e.getAttribute('data-rf-edit'), id: parseInt(e.getAttribute('data-rf-id'), 10) }; render(); return; }

        var a = ev.target.closest('[data-rf-act]');
        if (!a) return;
        var act = a.getAttribute('data-rf-act'), clubId = parseInt(a.getAttribute('data-rf-id'), 10);
        var row = rowOf(clubId), r, id;

        if (act === 'cancel') { editing = null; render(); return; }
        if (act === 'line') { editing = { kind: 'line', id: clubId }; render(); var t = $('rfLineText'); if (t) t.focus(); return; }
        if (act === 'count' || act === 'amount') { editing = { kind: act, id: clubId }; render(); return; }

        if (act === 'preview') {
            // ⚠️ Fönstret öppnas FÖRE await — en webbläsare blockerar ett window.open efter en väntan.
            var w = window.open('about:blank', '_blank');
            id = await chargeIdFor(clubId);
            if (!id) { if (w) w.close(); return; }
            if (w) w.location = F + 'PreviewRegionPaymentRequest?chargeId=' + id;
            if (!row.charge) load();
            return;
        }
        if (act === 'link') {
            id = await chargeIdFor(clubId); if (!id) return;
            r = await (await fetch(F + 'GetPaymentLink?chargeId=' + id, { cache: 'no-store' })).json();
            if (!r.success) { msg(false, r.message); return; }
            try { await navigator.clipboard.writeText(r.url); msg(true, 'Betallänken för ' + row.clubName + ' är kopierad. Klistra in den i ett mejl eller sms till klubben.'); }
            catch (x) { msg(true, 'Betallänk för ' + row.clubName + ': ' + r.url); }
            load();
            return;
        }
        if (act === 'send-one') {
            id = await chargeIdFor(clubId); if (!id) return;
            r = await post('SendRegionPaymentRequests', { regionId: REGION_ID, year: year(), chargeIds: [id] });
            report(r);
            load();
            return;
        }

        a.disabled = true;
        if (act === 'paid') {
            id = await chargeIdFor(clubId);
            r = id ? await postForm('MarkPaid', { chargeId: id }) : null;
        } else if (act === 'unpaid') {
            r = await postForm('MarkUnpaid', { chargeId: row.charge.id });
        } else if (act === 'line-save') {
            id = await chargeIdFor(clubId);
            r = id ? await post('AddRegionChargeLine', { chargeId: id, description: $('rfLineText').value, amount: parseFloat($('rfLineAmount').value) || 0 }) : null;
            if (r && r.success) editing = null;
        } else if (act === 'line-remove') {
            r = await post('RemoveRegionChargeLine', { chargeId: row.charge.id, lineId: parseInt(a.getAttribute('data-rf-line'), 10) });
        } else if (act === 'zero') {
            r = await post('SetRegionChargeManualAmount', { chargeId: row.charge.id, manualAmount: 0 });
        } else if (act === 'delete') {
            if (!window.confirm('Ta bort avgiften för ' + row.clubName + '? Klubben har redan fått ett mejl om den.')) { a.disabled = false; return; }
            r = await post('DeleteRegionCharge', { chargeId: row.charge.id });
        } else { a.disabled = false; return; }

        if (!r || !r.success) { if (r) msg(false, r.message); a.disabled = false; if (!row.charge) load(); return; }
        msg(true, '');
        load();
    });

    // ── Ändra ett tal: Enter eller klick utanför sparar, Escape ångrar ─────────────────────
    async function commitInput(input) {
        var kind = input.getAttribute('data-rf-input'), clubId = parseInt(input.getAttribute('data-rf-id'), 10);
        var v = Math.max(0, parseFloat(input.value) || 0);
        var s = stateOf(rowOf(clubId));
        editing = null;
        render();

        var id = await chargeIdFor(clubId);
        if (!id) { load(); return; }
        var r;
        if (kind === 'count') {
            r = await post('SetRegionChargeMemberCount', { chargeId: id, memberCount: Math.round(v) });
        } else {
            // Samma belopp som taxan ger = inget eget belopp. Annars står "eget belopp" på en klubb
            // som bara klickade och tryckte Enter.
            var formula = byRate(s.count == null ? rowOf(clubId).proposedCount : s.count);
            r = await post('SetRegionChargeManualAmount', { chargeId: id, manualAmount: v === formula ? null : v });
        }
        // ⚠️ Går sparningen inte igenom SÄGS det — annars står ett tal på skärmen som inte finns.
        if (!r.success) msg(false, 'Ändringen kunde inte sparas. ' + (r.message || ''));
        load();
    }
    $('rfRoot').addEventListener('keydown', function (ev) {
        var input = ev.target.closest('[data-rf-input]');
        if (!input) return;
        if (ev.key === 'Enter') { ev.preventDefault(); commitInput(input); }
        if (ev.key === 'Escape') { editing = null; render(); }
    });
    $('rfRoot').addEventListener('focusout', function (ev) {
        var input = ev.target.closest('[data-rf-input]');
        if (input && editing) commitInput(input);
    });

    // ── Taxan ────────────────────────────────────────────────────────────────────────────
    $('rfSaveRate').addEventListener('click', async function () {
        var b = parseFloat($('rfBase').value) || 0, p = parseFloat($('rfPer').value) || 0;
        if (b <= 0 && p <= 0) { msg(false, 'Fyll i ett belopp.'); return; }
        var r = await post('SaveRegionRate', { regionId: REGION_ID, year: year(), baseAmount: b, perMember: p });
        if (!r.success) { msg(false, r.message); return; }
        load();
    });
    $('rfCancelRate').addEventListener('click', function () { show($('rfRateForm'), false); });

    // ── Skicka och påminn ────────────────────────────────────────────────────────────────
    $('rfSend').addEventListener('click', async function () {
        var btn = this;
        var list = (data.rows || []).filter(function (r) { var s = stateOf(r); return !s.paid && !s.sent && s.amount > 0 && r.hasEmail; });
        if (list.length === 0) return;
        var sum = list.reduce(function (a, r) { return a + stateOf(r).amount; }, 0);
        if (!window.confirm('Mejla kretsavgiften ' + data.year + ' till ' + list.length + ' klubbar, totalt ' + kr(sum) + '?')) return;

        btn.disabled = true;
        // Klubbar som ingen rört har ingen avgift än — den skapas nu, med registrets antal.
        var missing = (data.rows || []).filter(function (r) { return !r.charge && r.proposedAmount > 0; });
        if (missing.length > 0) {
            var g = await post('GenerateRegionCharges', { regionId: REGION_ID, year: year(),
                clubs: missing.map(function (r) { return { clubId: r.clubId, memberCount: r.proposedCount }; }) });
            if (!g.success) { btn.disabled = false; msg(false, g.message); return; }
        }
        var s = await post('SendRegionPaymentRequests', { regionId: REGION_ID, year: year(), mode: 'unsent' });
        btn.disabled = false;
        report(s);
        load();
    });

    $('rfRemind').addEventListener('click', async function () {
        var btn = this;
        if (!window.confirm('Mejla en påminnelse till klubbarna som inte betalat?')) return;
        btn.disabled = true;
        var s = await post('SendRegionPaymentRequests', { regionId: REGION_ID, year: year(), mode: 'reminder' });
        btn.disabled = false;
        report(s);
        load();
    });

    // ⚠️ Beskedet säger vad som FAKTISKT hände. Ett "skickat" om ett mejl som aldrig gick är en lögn.
    function report(s) {
        if (!s || !s.success) { msg(false, 'Mejlen gick inte att skicka. ' + ((s && s.message) || '')); return; }
        var parts = [s.sent + (s.sent === 1 ? ' klubb fick' : ' klubbar fick') + ' ett mejl.'];
        var missed = (s.noEmail || []).concat(s.failed || []);
        if (missed.length > 0) parts.push('Inget mejl gick till ' + missed.join(', ') + '. Välj Åtgärder → Kopiera betallänk och skicka länken själv.');
        msg(true, parts.join(' '), missed.length > 0 ? 'warn' : 'ok');
    }

    // Åren: nästa, i år och tre bakåt.
    var now = new Date().getFullYear();
    for (var y = now + 1; y >= now - 3; y--) {
        var o = document.createElement('option');
        o.value = y; o.textContent = y; if (y === now) o.selected = true;
        $('rfYear').appendChild(o);
    }
    $('rfYear').addEventListener('change', function () { editing = null; msg(true, ''); load(); });
})();
</script>
