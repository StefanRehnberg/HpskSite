@*
 * Fältskytte Station Configurator Modal
 * Per-weapon-class station config with Förutsättningar, Målgrupper, and print support.
 * Opened from the competition wizard.
 * Architecture: Model-first — faltCfgData is the single source of truth.
 * All form controls update the model directly via onchange handlers.
 *@

@await Html.PartialAsync("FaltskytteTargetPickerModal")

<div class="modal fade" id="faltStationConfigModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true" style="z-index:1060">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title me-3 mb-0"><i class="bi bi-gear me-2"></i>Stationskonfigurator</h5>
                <!-- Mode toggle. Simple = one shared shape per station + per-class param matrix.
                     Advanced = the original per-class tabs with linking. Persisted as _mode in the
                     stored config; defaults to advanced for back-compat. -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Konfigurationsläge">
                    <input type="radio" class="btn-check" name="faltCfgModeRadio" id="faltCfgMode_simple" value="simple" onchange="faltCfgRequestMode('simple')">
                    <label class="btn btn-outline-primary" for="faltCfgMode_simple" title="Bygg stationen en gång; sätt skjuttid m.m. per klass">Enkelt läge</label>
                    <input type="radio" class="btn-check" name="faltCfgModeRadio" id="faltCfgMode_advanced" value="advanced" checked onchange="faltCfgRequestMode('advanced')">
                    <label class="btn btn-outline-primary" for="faltCfgMode_advanced" title="Per-klass-flikar med länkning">Avancerat läge</label>
                </div>
                <button type="button" class="btn-close ms-auto" onclick="faltCfgTryClose()"></button>
            </div>
            <div class="modal-body">

                <!-- Station count -->
                <div class="row mb-3 align-items-end">
                    <div class="col-auto">
                        <label class="form-label fw-bold">Antal stationer</label>
                        <input type="number" class="form-control" id="faltCfg_stationCount" min="2" max="12" value="8" style="width:80px" onchange="faltCfgUpdateStations()">
                    </div>
                    <div class="col-auto">
                        <label class="form-label fw-bold d-block">Mörkerfältskjutning</label>
                        <div class="form-check form-switch" title="Tävlingen genomförs i mörker. Lägger till 30 % i föreslagna skjuttider och bör kombineras med större figurgrupp eller kortare avstånd.">
                            <input class="form-check-input" type="checkbox" role="switch" id="faltCfg_morker" onchange="faltCfgToggleMorker(this.checked)">
                            <label class="form-check-label small" for="faltCfg_morker">Aktivera mörker-tillägg</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <span id="faltCfgSimpleNote" class="text-muted small fst-italic" style="display:none">
                            <i class="bi bi-info-circle me-1"></i>Enkelt läge: bygg målgrupper en gång &mdash; skjuttid och övriga parametrar sätts per klass per station.
                        </span>
                    </div>
                    <div class="col-auto" id="faltCfgSimpleLinkButton" style="display:none">
                        <button class="btn btn-outline-primary btn-sm" onclick="faltCfgLinkInSimpleMode()" title="Länka vapenklasser så de delar Skjuttid och övriga förutsättningar">
                            <i class="bi bi-link-45deg me-1"></i>Länka klasser...
                        </button>
                    </div>
                </div>

                <!-- Weapon class tabs (advanced mode only) -->
                <ul class="nav nav-tabs mb-3" id="faltCfgWeaponTabs" role="tablist">
                </ul>

                <!-- Link / Copy controls (advanced mode only) -->
                <div class="mb-3 d-flex flex-wrap gap-3 align-items-end" id="faltCfgLinkAndCopyControls">
                    <div class="d-flex gap-2 align-items-center">
                        <span class="text-muted small">Kopiera från:</span>
                        <select class="form-select form-select-sm" id="faltCfg_copySource" style="width:auto">
                            <option value="">Välj...</option>
                        </select>
                        <div class="input-group input-group-sm" style="width:auto">
                            <span class="input-group-text" title="Tidsskillnad per station (sek)">&#916;sek</span>
                            <input type="number" class="form-control form-control-sm" id="faltCfg_copyTimeOffset" value="0" style="width:60px" title="Tidsskillnad (sek). T.ex. +5 ger 5 sek längre skjuttid.">
                        </div>
                        <button class="btn btn-outline-secondary btn-sm" onclick="faltCfgCopyFrom()">Kopiera</button>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        <button class="btn btn-outline-primary btn-sm" onclick="faltCfgLinkTab()" id="faltCfg_linkBtn" title="Länka den aktiva fliken med en annan vapenklass">
                            <i class="bi bi-link-45deg me-1"></i>Länka...
                        </button>
                        <button class="btn btn-outline-warning btn-sm" onclick="faltCfgUnlinkTab()" id="faltCfg_unlinkBtn" style="display:none" title="Avlänka den aktiva fliken">
                            <i class="bi bi-x-circle me-1"></i>Avlänka
                        </button>
                    </div>
                </div>

                <!-- Tab content -->
                <div class="tab-content" id="faltCfgTabContent">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="faltCfgTryClose()">
                    <i class="bi bi-x-circle me-1"></i>Stäng
                </button>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_FaltskytteConfiguratorSuggestionModal")

@await Html.PartialAsync("_FaltskytteConfiguratorScript")
