@{
    var feeClubId = ViewBag.clubId as int? ?? 0;
    // Läsläge för styrelsen och revisorn på ekonomisidan: samma listor, inga knappar.
    var feeReadOnly = ViewData["feesReadOnly"] as bool? ?? false;
}
@* Medlemsavgifter — klubbens avgift till sina medlemmar. See Documentation/MEMBER_DATABASE.md §4.
   Endpoints: /umbraco/surface/MembershipFeeAdmin/... Reuses the club's Swish number.

   ⚠️ BOR PÅ EKONOMISIDAN (/ekonomi, rälsposten Medlemsavgifter) sedan 2026-09-23 — tidigare en
   modal i klubbens adminpanel. Det är kassörens arbete, och ekonomisidan har rätt behörighet:
   kassören skriver, styrelsen och revisorn läser (feesReadOnly). Adminpanelen länkar hit.
   ⚠️ Inga alert()/prompt(): en blockerande dialog har redan rapporterats som att sidan "frös".
   Beskeden står i #feeActionMsg. *@
<div id="clubFeeRoot">
    <div class="d-flex align-items-center gap-2 mb-3">
        <label class="form-label mb-0 fw-bold" for="feeYear">År</label>
        <select id="feeYear" class="form-select form-select-sm" style="width:auto;"></select>
    </div>

    <div class="alert alert-info d-none small" id="feeActionMsg" role="status"></div>

    <h6 class="text-primary">Avgiftskategorier</h6>
    <p class="text-muted small">Sätts av klubben (årsmötet). En kategori per medlemstyp och år.</p>
    <div class="table-responsive mb-2">
        <table class="table table-sm align-middle">
            <thead><tr><th>Medlemstyp</th><th>Etikett</th><th>Belopp (kr)</th><th></th></tr></thead>
            <tbody id="feeCategoryRows"></tbody>
        </table>
    </div>
    @if (!feeReadOnly)
    {
    <div class="row g-2 align-items-end mb-4">
        <div class="col-md-3">
            <label class="form-label small mb-0" for="feeCatType">Medlemstyp</label>
            <select id="feeCatType" class="form-select form-select-sm">
                <option>Senior</option><option>Pensionär</option><option>Junior</option><option>Familj</option>
                <option>Hedersmedlem</option><option>Ständig</option><option>Stödjande</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small mb-0" for="feeCatLabel">Etikett (valfri)</label>
            <input id="feeCatLabel" class="form-control form-control-sm" placeholder="t.ex. Seniormedlem" autocomplete="off">
        </div>
        <div class="col-md-3">
            <label class="form-label small mb-0" for="feeCatAmount">Belopp (kr)</label>
            <input id="feeCatAmount" type="number" min="0" step="1" class="form-control form-control-sm" autocomplete="off">
        </div>
        <div class="col-md-2">
            <button type="button" class="btn btn-success btn-sm w-100" onclick="feeSaveCategory()">Lägg till</button>
        </div>
    </div>

    <hr>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <button type="button" class="btn btn-primary btn-sm" onclick="feeGenerate()">
            <i class="bi bi-people me-1"></i>Generera avgifter för alla medlemmar
        </button>
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="feeSendRequests()">
            <i class="bi bi-envelope me-1"></i>Skicka betalningsbegäran (e-post)
        </button>
    </div>
    }

    <h6 class="text-danger">Ej betalda <span id="feeUnpaidCount" class="badge bg-danger"></span></h6>
    <div class="table-responsive mb-3">
        <table class="table table-sm align-middle">
            <thead><tr><th>Medlem</th><th>Belopp</th><th>Status</th><th>@(feeReadOnly ? "" : "Åtgärder")</th></tr></thead>
            <tbody id="feeUnpaidRows"></tbody>
        </table>
    </div>

    <h6 class="text-success">Betalda <span id="feePaidCount" class="badge bg-success"></span></h6>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>Medlem</th><th>Belopp</th><th>Betald</th><th></th></tr></thead>
            <tbody id="feePaidRows"></tbody>
        </table>
    </div>
</div>

<script>
(function () {
    if (window.__clubFeeInit) return;
    window.__clubFeeInit = true;

    var FEE_CLUB_ID = @feeClubId;
    var READONLY = @(feeReadOnly ? "true" : "false");

    async function feeToken() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        if (el && el.value) return el.value;
        return (await (await fetch('/umbraco/surface/Club/GetFormToken', { cache: 'no-store' })).json()).token;
    }
    function feeYearVal() { return document.getElementById('feeYear').value; }
    function feeEsc(s) {
        return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function feeMsg(text, bad) {
        var m = document.getElementById('feeActionMsg');
        m.className = 'alert small ' + (bad ? 'alert-danger' : 'alert-info') + (text ? '' : ' d-none');
        m.textContent = text || '';
    }
    async function feeForm(action, fields) {
        var fd = new FormData();
        Object.keys(fields).forEach(function (k) { fd.append(k, fields[k]); });
        fd.append('__RequestVerificationToken', await feeToken());
        var r = await fetch('/umbraco/surface/MembershipFeeAdmin/' + action, { method: 'POST', body: fd });
        try { return await r.json(); } catch (e) { return { success: false, message: 'Något gick fel (' + r.status + ').' }; }
    }

    function feeInitYears() {
        var sel = document.getElementById('feeYear');
        if (sel.options.length) return;
        var now = new Date().getFullYear();
        for (var y = now + 1; y >= now - 3; y--) {
            var o = document.createElement('option');
            o.value = y; o.textContent = y;
            if (y === now) o.selected = true;
            sel.appendChild(o);
        }
        sel.addEventListener('change', function () { feeMsg(''); feeLoadOverview(); });
    }

    window.feeLoadOverview = function () {
        fetch('/umbraco/surface/MembershipFeeAdmin/GetOverview?clubId=' + FEE_CLUB_ID + '&year=' + feeYearVal(), { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) { feeMsg(d.message || 'Medlemsavgifterna gick inte att läsa.', true); return; }
                feeRenderCategories(d.categories || []);
                feeRenderCharges('feeUnpaidRows', d.unpaid || [], false);
                feeRenderCharges('feePaidRows', d.paid || [], true);
                document.getElementById('feeUnpaidCount').textContent = (d.unpaid || []).length;
                document.getElementById('feePaidCount').textContent = (d.paid || []).length;
            });
    };

    function feeRenderCategories(cats) {
        var html = cats.map(function (c) {
            return '<tr><td>' + feeEsc(c.membershipType) + '</td><td>' + feeEsc(c.label) + '</td><td>' +
                feeEsc(c.amount) + '</td><td>' + (READONLY ? '' : '<button class="btn btn-outline-danger btn-sm" onclick="feeDeleteCategory(' +
                c.id + ')" title="Ta bort kategorin"><i class="bi bi-trash"></i></button>') + '</td></tr>';
        }).join('');
        document.getElementById('feeCategoryRows').innerHTML = html || '<tr><td colspan="4" class="text-muted small">Inga kategorier ännu.</td></tr>';
    }

    function feeRenderCharges(targetId, charges, paid) {
        var html = charges.map(function (c) {
            var actions;
            if (paid) {
                actions = READONLY ? '' : '<button class="btn btn-outline-secondary btn-sm" onclick="feeMarkUnpaid(' + c.id + ')">Ångra betald</button>';
                return '<tr><td>' + feeEsc(c.memberName) + '</td><td>' + feeEsc(c.amount) + ' kr</td><td>' +
                    feeEsc(c.paidDate || '') + '</td><td>' + actions + '</td></tr>';
            }
            if (c.covered) {
                // Familjeavgift: covered by the household's primary member — no separate fee.
                return '<tr class="text-muted"><td>' + feeEsc(c.memberName) + '</td><td>0 kr</td>' +
                    '<td><span class="badge bg-info text-dark">Ingår i familj</span></td><td></td></tr>';
            }
            var claim = c.paymentSentDate ? '<span class="badge bg-warning text-dark" title="Medlem har uppgett betalning ' +
                feeEsc(c.paymentSentDate) + '">Uppgett betald</span> ' : '';
            actions = READONLY ? '' :
                '<button class="btn btn-success btn-sm me-1" onclick="feeMarkPaid(' + c.id + ')">Markera betald</button>' +
                '<button class="btn btn-outline-primary btn-sm" onclick="feeCopyLink(' + c.id + ')">Kopiera länk</button>';
            return '<tr><td>' + feeEsc(c.memberName) + (c.hasEmail ? '' : ' <i class="bi bi-envelope-slash text-muted" title="Saknar e-post"></i>') +
                '</td><td>' + feeEsc(c.amount) + ' kr</td><td>' + claim + '</td><td>' + actions + '</td></tr>';
        }).join('');
        document.getElementById(targetId).innerHTML = html || '<tr><td colspan="4" class="text-muted small">Inga poster.</td></tr>';
    }

    window.feeSaveCategory = async function () {
        var d = await feeForm('SaveCategory', {
            id: 0, clubId: FEE_CLUB_ID, year: feeYearVal(),
            membershipType: document.getElementById('feeCatType').value,
            label: document.getElementById('feeCatLabel').value,
            amount: document.getElementById('feeCatAmount').value || '0'
        });
        if (!d.success) { feeMsg(d.message || 'Kategorin kunde inte sparas.', true); return; }
        document.getElementById('feeCatAmount').value = ''; document.getElementById('feeCatLabel').value = '';
        feeMsg(''); feeLoadOverview();
    };

    window.feeDeleteCategory = async function (id) {
        var d = await feeForm('DeleteCategory', { id: id, clubId: FEE_CLUB_ID });
        if (!d.success) feeMsg(d.message || 'Kategorin kunde inte tas bort.', true);
        feeLoadOverview();
    };

    window.feeGenerate = async function () {
        feeMsg('Genererar…');
        var d = await feeForm('GenerateCharges', { clubId: FEE_CLUB_ID, year: feeYearVal() });
        feeMsg(d.success ? (d.created + ' nya avgifter skapade.') : (d.message || 'Avgifterna kunde inte skapas.'), !d.success);
        feeLoadOverview();
    };

    window.feeSendRequests = async function () {
        if (!confirm('Skicka betalningsbegäran via e-post till alla med obetald avgift?')) return;
        feeMsg('Skickar…');
        var d = await feeForm('SendPaymentRequests', { clubId: FEE_CLUB_ID, year: feeYearVal() });
        feeMsg(d.success ? (d.sent + ' e-post skickade.') : (d.message || 'Mejlen kunde inte skickas.'), !d.success);
    };

    window.feeMarkPaid = function (chargeId) { feePost('MarkPaid', chargeId); };
    window.feeMarkUnpaid = function (chargeId) { feePost('MarkUnpaid', chargeId); };
    async function feePost(action, chargeId) {
        var d = await feeForm(action, { chargeId: chargeId });
        if (!d.success) feeMsg(d.message || 'Det gick inte.', true);
        feeLoadOverview();
    }

    window.feeCopyLink = function (chargeId) {
        fetch('/umbraco/surface/MembershipFeeAdmin/GetPaymentLink?chargeId=' + chargeId, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(async function (d) {
                if (!d.success) { feeMsg(d.message || 'Betallänken gick inte att hämta.', true); return; }
                try { await navigator.clipboard.writeText(d.url); feeMsg('Betallänken är kopierad.'); }
                catch (e) { feeMsg('Betallänk: ' + d.url); }
            });
    };

    // Laddas lat när ekonomisidans rälspost öppnas.
    window.hpskLoadClubFees = function () { feeInitYears(); window.feeLoadOverview(); };
})();
</script>
