@{
    var feeClubId = ViewBag.clubId as int? ?? 0;
    // Läsläge för styrelsen och revisorn på ekonomisidan: samma lista, inga knappar.
    var feeReadOnly = ViewData["feesReadOnly"] as bool? ?? false;
}
@*
    MEDLEMSAVGIFTER — klubbens årsavgift till sina medlemmar. Bor på ekonomisidan (rälsposten
    Medlemsavgifter). See Documentation/MEMBER_DATABASE.md §4.

    ⚠️⚠️ SAMMA FORM SOM KRETSAVGIFTEN, OCH SAJTENS FORMSPRÅK (Stefan 2026-09-23). Den gamla ytan
    började med en helsida inställningar och en knapp "Generera avgifter…" som ingen förstod — Ove
    vill bara skicka ut uppmaningen att betala. Därför:
      - Listan ÄR sidan: en rad per medlem, vad hen ska betala och Status.
      - "Generera" finns inte som begrepp. Avgiften skapas när den skickas (eller när raden rörs),
        ur SAMMA regel som listan visar (ClubFeeProposal).
      - Avgiften per medlemstyp är en INSTÄLLNING — en dialog bakom sidans Åtgärder.
      - EN blå Åtgärder uppe till höger: Skicka, Påminn, Inställningar. Per rad [Betald] + grå Åtgärder.
      - Raden ser likadan ut före och efter utskicket; bara Status ändras.
    ⚠️ Inga alert()/prompt(): en blockerande dialog har redan rapporterats som att sidan "frös".
*@
<style>
    #cfRoot td, #cfRoot th { vertical-align: middle; }
    #cfRoot .cf-total td { border-top: 2px solid var(--bs-border-color); font-weight: 600; }
    #cfRoot .cf-n { white-space: nowrap; }
    @@media (max-width: 575.98px) { #cfRoot tr.cf-main td { border-bottom: 0; padding-bottom: 0; } }
</style>

<div id="cfRoot">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <div class="fw-semibold" id="cfRateLine"></div>
            <div class="small text-muted" id="cfSummary"></div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select id="cfYear" class="form-select" style="width:auto" aria-label="År"></select>
            @if (!feeReadOnly)
            {
            <div class="dropdown">
                <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="cfPageMenu">
                    <i class="bi bi-sliders me-2"></i>Åtgärder
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width:280px">
                    <li><h6 class="dropdown-header">Skicka</h6></li>
                    <li><button class="dropdown-item" type="button" id="cfSend"><i class="bi bi-envelope me-2"></i><span></span></button></li>
                    <li><button class="dropdown-item" type="button" id="cfRemind"><i class="bi bi-bell me-2"></i><span></span></button></li>
                    <li><span class="dropdown-item-text small text-muted d-none" id="cfNothingToSend"></span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Inställningar</h6></li>
                    <li><button class="dropdown-item" type="button" id="cfEditRates"><i class="bi bi-cash-coin me-2"></i><span>Avgift per medlemstyp</span></button></li>
                </ul>
            </div>
            }
        </div>
    </div>

    <div class="alert alert-danger d-none" id="cfError"></div>
    <div class="alert alert-success d-none" id="cfOk"></div>

    <div class="text-center py-4 d-none" id="cfNoRate">
        <p class="mb-3" id="cfNoRateText"></p>
        @if (!feeReadOnly)
        {
        <button type="button" class="btn btn-primary" id="cfNoRateBtn">Bestäm avgiften</button>
        }
    </div>

    <div id="cfListWrap" class="d-none">
        <div class="table-responsive">
            <table class="table align-middle mb-2">
                <thead><tr>
                    <th>Medlem</th>
                    <th class="d-none d-sm-table-cell">Medlemstyp</th>
                    <th class="d-none d-md-table-cell">E-post</th>
                    <th class="text-end">Att betala</th>
                    <th class="d-none d-sm-table-cell">Status</th>
                    <th class="text-end d-none d-sm-table-cell"><span class="visually-hidden">Åtgärder</span></th>
                </tr></thead>
                <tbody id="cfRows"></tbody>
            </table>
        </div>
    </div>
</div>

@* Inställningen: avgift per medlemstyp. Ändringar sparas direkt; "Klar" stänger. *@
<div class="modal fade" id="cfRatesModal" tabindex="-1" aria-hidden="true" aria-labelledby="cfRatesTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfRatesTitle">Avgift per medlemstyp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Årsmötet bestämmer avgiften. Varje medlem betalar avgiften för sin medlemstyp.
                    En familj betalar en gång, via huvudmedlemmen.</p>
                <table class="table table-sm align-middle">
                    <thead><tr><th>Medlemstyp</th><th class="text-end">Avgift</th><th></th></tr></thead>
                    <tbody id="cfRatesRows"></tbody>
                </table>
                <div class="row g-2 align-items-end">
                    <div class="col-6">
                        <label class="form-label small mb-0" for="cfNewType">Medlemstyp</label>
                        <select id="cfNewType" class="form-select form-select-sm">
                            <option>Senior</option><option>Pensionär</option><option>Junior</option><option>Familj</option>
                            <option>Hedersmedlem</option><option>Ständig</option><option>Stödjande</option>
                        </select>
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-0" for="cfNewAmount">Avgift</label>
                        <input id="cfNewAmount" type="number" min="0" step="1" class="form-control form-control-sm" autocomplete="off">
                    </div>
                    <div class="col-3">
                        <button type="button" class="btn btn-primary btn-sm w-100" id="cfAddRate">Lägg till</button>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">Avgifter som redan skickats ändras inte.</p>
                <div class="alert alert-danger d-none mt-3 mb-0" id="cfRatesError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Klar</button>
            </div>
        </div>
    </div>
</div>

@* Vart medlemmens avgift ska mejlas — t.ex. förälderns adress för en junior. *@
<div class="modal fade" id="cfEmailModal" tabindex="-1" aria-hidden="true" aria-labelledby="cfEmailTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfEmailTitle">E-post för avgiften</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="cfEmailInput">Skicka medlemsavgiften till</label>
                <input id="cfEmailInput" type="email" class="form-control" autocomplete="off">
                <p class="text-muted small mt-2 mb-0" id="cfEmailHelp"></p>
                <div class="alert alert-danger d-none mt-3 mb-0" id="cfEmailError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="cfEmailSave">Spara</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    if (window.__clubFeeInit) return;
    window.__clubFeeInit = true;

    var CLUB_ID = @feeClubId;
    var READONLY = @(feeReadOnly ? "true" : "false");
    var F = '/umbraco/surface/MembershipFeeAdmin/';
    var data = null, dirty = false;
    var MONTHS = ['jan','feb','mar','apr','maj','jun','jul','aug','sep','okt','nov','dec'];

    function $(id) { return document.getElementById(id); }
    function esc(s) {
        return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function kr(n) { return (Math.round((n || 0) * 100) / 100).toLocaleString('sv-SE', { maximumFractionDigits: 2 }) + ' kr'; }
    function day(iso) { if (!iso) return ''; var p = iso.split('-'); return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1]; }
    function year() { return parseInt($('cfYear').value, 10); }
    function show(el, on) { if (el) el.classList.toggle('d-none', !on); }
    function msg(ok, text, kind) {
        $('cfOk').className = 'alert ' + (kind === 'warn' ? 'alert-warning' : 'alert-success');
        show($('cfOk'), ok && !!text); show($('cfError'), !ok && !!text);
        $(ok ? 'cfOk' : 'cfError').textContent = text || '';
    }
    async function token() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        if (el && el.value) return el.value;
        return (await (await fetch('/umbraco/surface/Club/GetFormToken', { cache: 'no-store' })).json()).token;
    }
    async function form(action, fields) {
        var fd = new FormData();
        Object.keys(fields).forEach(function (k) { fd.append(k, fields[k]); });
        fd.append('__RequestVerificationToken', await token());
        var r = await fetch(F + action, { method: 'POST', body: fd });
        try { return await r.json(); } catch (e) { return { success: false, message: 'Något gick fel (' + r.status + ').' }; }
    }

    function rowOf(memberId) { return (data.rows || []).find(function (r) { return r.memberId === memberId; }); }
    var BILLABLE = { Individual: true, HouseholdPrimary: true };

    // ⚠️ Varje handling på en rad börjar här: avgiften skapas oskickad om den inte finns.
    async function chargeIdFor(memberId) {
        var r = rowOf(memberId);
        if (r && r.charge) return r.charge.id;
        var e = await form('EnsureClubCharge', { clubId: CLUB_ID, year: year(), memberId: memberId });
        if (!e.success) { msg(false, e.message); return null; }
        return e.chargeId;
    }

    function stateOf(r) {
        var c = r.charge;
        return {
            c: c,
            paid: !!c && c.status === 'Paid',
            sent: !!c && !!c.requestSentDate,
            claimed: !!c && !!c.paymentSentDate,
            covered: r.kind === 'Covered' || (!!c && c.covered),
            billable: !!c ? (!c.covered && c.amount > 0) : (BILLABLE[r.kind] && r.proposedAmount > 0),
            amount: c ? c.amount : r.proposedAmount
        };
    }

    // ⚠️ Status som på resten av sajten (Anmälningar, Fakturor): en BRICKA, datum intill i grått.
    function badge(cls, text, note) {
        return '<span class="badge ' + cls + '">' + text + '</span>' + (note ? ' <span class="small text-muted">' + note + '</span>' : '');
    }
    function statusCell(r, s) {
        if (s.covered) return badge('bg-light text-dark border', 'Ingår i familjen', r.coveredBy ? esc(r.coveredBy) + ' betalar' : '');
        if (s.paid) return badge('bg-success', 'Betald', s.c.paidDate ? day(s.c.paidDate) : '');
        if (s.claimed) return badge('bg-info text-dark', 'Uppgett betald', day(s.c.paymentSentDate));
        if (!s.c && r.kind === 'NoType') return badge('bg-light text-dark border', 'Ingen medlemstyp', 'ange den under Medlemmar');
        if (!s.c && r.kind === 'NoCategory') return badge('bg-light text-dark border', 'Ingen avgift', 'för ' + esc(r.membershipType));
        if (s.amount <= 0) return badge('bg-light text-dark border', 'Ingen avgift');
        if (s.sent) return badge('bg-warning text-dark', 'Väntande', 'skickad ' + day(s.c.requestSentDate));
        return badge('bg-secondary', 'Inte skickad');
    }
    // Vart avgiften mejlas. Saknas adress står det i listan — inte i en text under den.
    function emailCell(r) {
        if (!r.hasEmail) return '<span class="badge bg-danger-subtle text-danger-emphasis border">Ingen e-post</span>';
        return '<span class="small">' + esc(r.email) + '</span>';
    }

    function item(act, id, text, extra) {
        return '<li><button type="button" class="dropdown-item' + (extra || '') + '" data-cf-act="' + act
             + '" data-cf-id="' + id + '">' + text + '</button></li>';
    }
    function actionsCell(r, s) {
        if (READONLY || s.covered) return '';
        var id = r.memberId, items = [];
        if (s.paid) items.push(item('unpaid', id, 'Ångra betald'));
        else if (s.billable) {
            // Betald ligger i menyn som allt annat på raden — samma form som resten av sajten.
            items.push('<li><h6 class="dropdown-header">Betalning</h6></li>');
            items.push(item('paid', id, 'Markera som betald'));
            items.push('<li><hr class="dropdown-divider"></li>');
            items.push('<li><h6 class="dropdown-header">Mejlet</h6></li>');
            items.push(item('preview', id, 'Visa mejlet'));
            if (r.hasEmail) items.push(item('send-one', id, s.sent ? 'Skicka mejlet igen' : 'Skicka mejlet nu'));
            items.push(item('link', id, 'Kopiera betallänk'));
        } else if (r.kind === 'NoCategory') items.push(item('rates', id, 'Avgift per medlemstyp…'));
        // E-postadressen går att sätta för alla — en förälder som betalar juniorens avgift.
        if (!s.paid) items.push(item('email', id, 'E-post för avgiften…'));
        return '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" '
             + 'data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\'>Åtgärder</button>'
             + '<ul class="dropdown-menu dropdown-menu-end">' + items.join('') + '</ul></div>';
    }

    function render() {
        var cats = data.categories || [];
        var hasRate = cats.length > 0;
        var yr = year();
        $('cfRateLine').textContent = hasRate
            ? 'Avgiften ' + yr + ': ' + cats.map(function (c) { return c.membershipType + ' ' + kr(c.amount); }).join(' · ') : '';
        show($('cfNoRate'), !hasRate);
        $('cfNoRateText').textContent = 'Klubben har inte bestämt medlemsavgiften för ' + yr + ' än.';
        show($('cfListWrap'), hasRate);
        if ($('cfEditRates')) $('cfEditRates').querySelector('span').textContent = 'Avgift per medlemstyp ' + yr + '…';

        var rows = data.rows || [];
        var html = '', total = 0, billed = 0, paidCount = 0, paidSum = 0, toSend = 0, noMail = 0, toRemind = 0;
        rows.forEach(function (r) {
            var s = stateOf(r);
            if (s.billable) { total += s.amount; billed++; }
            if (s.paid && s.billable) { paidCount++; paidSum += s.amount; }
            if (s.billable && !s.paid && !s.sent) { if (r.hasEmail) toSend++; else noMail++; }
            if (s.billable && !s.paid && s.sent) toRemind++;

            var amount = s.covered ? '<span class="text-muted">—</span>' : (s.billable || s.paid ? kr(s.amount) : '<span class="text-muted">—</span>');
            html += '<tr class="cf-main"><td>' + esc(r.name) + '<div class="small text-muted d-sm-none">' + esc(r.membershipType || '') + '</div></td>'
                  + '<td class="d-none d-sm-table-cell">' + esc(r.membershipType || '') + '</td>'
                  + '<td class="d-none d-md-table-cell">' + emailCell(r) + '</td>'
                  + '<td class="text-end cf-n">' + amount + '</td>'
                  + '<td class="small d-none d-sm-table-cell">' + statusCell(r, s) + '</td>'
                  + '<td class="text-end cf-n cf-actions d-none d-sm-table-cell">' + actionsCell(r, s) + '</td></tr>'
                  + '<tr class="cf-mrow d-sm-none"><td colspan="2"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">'
                  + '<span>' + statusCell(r, s) + (r.hasEmail ? '' : ' ' + emailCell(r)) + '</span>' + actionsCell(r, s) + '</div></td></tr>';
        });
        html += '<tr class="cf-total"><td>Totalt</td><td class="d-none d-sm-table-cell"></td><td class="d-none d-md-table-cell"></td><td class="text-end cf-n">' + kr(total)
              + '</td><td class="d-none d-sm-table-cell"></td><td class="d-none d-sm-table-cell"></td></tr>';
        $('cfRows').innerHTML = html;

        $('cfSummary').textContent = hasRate
            ? paidCount + ' av ' + billed + ' medlemmar har betalat · ' + kr(paidSum) + ' av ' + kr(total) : '';

        if ($('cfSend')) {
            $('cfSend').querySelector('span').textContent = 'Skicka avgiften till ' + toSend + (toSend === 1 ? ' medlem' : ' medlemmar');
            $('cfRemind').querySelector('span').textContent = 'Påminn ' + toRemind + (toRemind === 1 ? ' medlem' : ' medlemmar') + ' som inte betalat';
            show($('cfSend').parentElement, hasRate && toSend > 0);
            show($('cfRemind').parentElement, hasRate && toRemind > 0);
            show($('cfNothingToSend'), !(hasRate && (toSend > 0 || toRemind > 0)));
            $('cfNothingToSend').textContent = hasRate ? 'Alla medlemmar har fått avgiften.' : 'Bestäm avgiften först.';
        }

        renderRates();
    }

    function renderRates() {
        var cats = (data && data.categories) || [];
        $('cfRatesTitle').textContent = 'Avgift per medlemstyp ' + year();
        $('cfRatesRows').innerHTML = cats.map(function (c) {
            return '<tr><td>' + esc(c.membershipType) + '</td><td class="text-end">' + kr(c.amount) + '</td>'
                 + '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" data-cf-delrate="' + c.id
                 + '" title="Ta bort">Ta bort</button></td></tr>';
        }).join('') || '<tr><td colspan="3" class="text-muted small">Ingen avgift bestämd ännu.</td></tr>';
    }

    // ⚠️ load() rör INTE beskedet — det körs direkt efter Skicka.
    // ⚠️ Ett svar som kommer efter ett årsbyte gäller fel år och får INTE skriva över listan.
    var loadSeq = 0;
    async function load() {
        var mine = ++loadSeq;
        var d = await (await fetch(F + 'GetOverview?clubId=' + CLUB_ID + '&year=' + year(), { cache: 'no-store' })).json();
        if (mine !== loadSeq) return;
        if (!d.success) { msg(false, d.message || 'Medlemsavgifterna gick inte att läsa.'); return; }
        data = d;
        render();
    }

    // ── Inställningen ───────────────────────────────────────────────────────────────────
    function openRates() {
        show($('cfRatesError'), false);
        renderRates();
        bootstrap.Modal.getOrCreateInstance($('cfRatesModal')).show();
    }
    if ($('cfEditRates')) $('cfEditRates').addEventListener('click', openRates);
    if ($('cfNoRateBtn')) $('cfNoRateBtn').addEventListener('click', openRates);
    function ratesError(t) { $('cfRatesError').textContent = t || ''; show($('cfRatesError'), !!t); }
    $('cfAddRate').addEventListener('click', async function () {
        var amount = parseFloat($('cfNewAmount').value);
        if (isNaN(amount) || amount < 0) { ratesError('Fyll i en avgift.'); return; }
        var type = $('cfNewType').value;
        var existing = (data.categories || []).find(function (c) { return c.membershipType === type; });
        var d = await form('SaveCategory', { id: existing ? existing.id : 0, clubId: CLUB_ID, year: year(),
                                             membershipType: type, label: type, amount: amount });
        if (!d.success) { ratesError(d.message || 'Avgiften kunde inte sparas.'); return; }
        ratesError(''); $('cfNewAmount').value = ''; dirty = true;
        await load();
    });
    $('cfRatesRows').addEventListener('click', async function (ev) {
        var b = ev.target.closest('[data-cf-delrate]');
        if (!b) return;
        var d = await form('DeleteCategory', { id: b.getAttribute('data-cf-delrate'), clubId: CLUB_ID });
        if (!d.success) { ratesError(d.message || 'Avgiften kunde inte tas bort.'); return; }
        dirty = true;
        await load();
    });
    $('cfRatesModal').addEventListener('hidden.bs.modal', function () { if (dirty) { dirty = false; msg(true, ''); } });

    // ── E-post för avgiften ─────────────────────────────────────────────────────────────
    var emailFor = 0;
    $('cfEmailSave').addEventListener('click', async function () {
        var d = await form('SetFeeEmail', { issuerType: 0, issuerId: CLUB_ID, payerId: emailFor, email: $('cfEmailInput').value });
        // ⚠️ Dialogen stängs INTE vid fel — annars får man börja om för att läsa vad som gick snett.
        if (!d.success) { $('cfEmailError').textContent = d.message || 'Adressen kunde inte sparas.'; show($('cfEmailError'), true); return; }
        bootstrap.Modal.getOrCreateInstance($('cfEmailModal')).hide();
        msg(true, '');
        load();
    });

    // ── Klick i listan ──────────────────────────────────────────────────────────────────
    $('cfRoot').addEventListener('click', async function (ev) {
        var a = ev.target.closest('[data-cf-act]');
        if (!a) return;
        var act = a.getAttribute('data-cf-act'), memberId = parseInt(a.getAttribute('data-cf-id'), 10);
        var row = rowOf(memberId), r, id;

        if (act === 'rates') { openRates(); return; }
        if (act === 'email') {
            emailFor = memberId;
            $('cfEmailTitle').textContent = 'E-post för avgiften — ' + row.name;
            $('cfEmailInput').value = row.emailIsOwn ? row.email : '';
            $('cfEmailHelp').textContent = (row.defaultEmail
                ? 'Lämna tomt för att använda medlemmens egen adress (' + row.defaultEmail + ').'
                : 'Medlemmen har ingen egen adress på pistol.nu.') + ' Medlemmens egen adress ändras inte.';
            show($('cfEmailError'), false);
            bootstrap.Modal.getOrCreateInstance($('cfEmailModal')).show();
            return;
        }
        if (act === 'preview') {
            // ⚠️ Fönstret öppnas FÖRE await — ett window.open efter en väntan blockeras.
            var w = window.open('about:blank', '_blank');
            id = await chargeIdFor(memberId);
            if (!id) { if (w) w.close(); return; }
            if (w) w.location = F + 'PreviewClubPaymentRequest?chargeId=' + id;
            if (!row.charge) load();
            return;
        }
        if (act === 'link') {
            id = await chargeIdFor(memberId); if (!id) return;
            r = await (await fetch(F + 'GetPaymentLink?chargeId=' + id, { cache: 'no-store' })).json();
            if (!r.success) { msg(false, r.message); return; }
            try { await navigator.clipboard.writeText(r.url); msg(true, 'Betallänken för ' + row.name + ' är kopierad.'); }
            catch (x) { msg(true, 'Betallänk för ' + row.name + ': ' + r.url); }
            load();
            return;
        }
        if (act === 'send-one') {
            id = await chargeIdFor(memberId); if (!id) return;
            report(await form('SendPaymentRequests', { clubId: CLUB_ID, year: year(), chargeIds: String(id) }));
            load();
            return;
        }

        a.disabled = true;
        if (act === 'paid') {
            id = await chargeIdFor(memberId);
            r = id ? await form('MarkPaid', { chargeId: id }) : null;
        } else if (act === 'unpaid') {
            r = await form('MarkUnpaid', { chargeId: row.charge.id });
        } else { a.disabled = false; return; }

        if (!r || !r.success) { if (r) msg(false, r.message); a.disabled = false; if (!row.charge) load(); return; }
        msg(true, '');
        load();
    });

    // ── Skicka och påminn ───────────────────────────────────────────────────────────────
    if ($('cfSend')) $('cfSend').addEventListener('click', async function () {
        var list = (data.rows || []).filter(function (r) { var s = stateOf(r); return s.billable && !s.paid && !s.sent && r.hasEmail; });
        if (list.length === 0) return;
        var sum = list.reduce(function (a, r) { return a + stateOf(r).amount; }, 0);
        if (!window.confirm('Mejla medlemsavgiften ' + year() + ' till ' + list.length + ' medlemmar, totalt ' + kr(sum) + '?')) return;
        // Medlemmar som ingen rört har ingen avgift än — den skapas nu, ur samma regel som listan visar.
        var g = await form('GenerateCharges', { clubId: CLUB_ID, year: year() });
        if (!g.success) { msg(false, g.message); return; }
        report(await form('SendPaymentRequests', { clubId: CLUB_ID, year: year(), mode: 'unsent' }));
        load();
    });
    if ($('cfRemind')) $('cfRemind').addEventListener('click', async function () {
        if (!window.confirm('Mejla en påminnelse till medlemmarna som inte betalat?')) return;
        report(await form('SendPaymentRequests', { clubId: CLUB_ID, year: year(), mode: 'reminder' }));
        load();
    });

    // ⚠️ Beskedet säger vad som FAKTISKT hände.
    function report(s) {
        if (!s || !s.success) { msg(false, 'Mejlen gick inte att skicka. ' + ((s && s.message) || '')); return; }
        var parts = [s.sent + (s.sent === 1 ? ' medlem fick' : ' medlemmar fick') + ' ett mejl.'];
        var missed = (s.noEmail || []).concat(s.failed || []);
        if (missed.length > 0) parts.push('Inget mejl gick till ' + missed.join(', ') + '. Välj Åtgärder → Kopiera betallänk på raden och skicka länken själv.');
        msg(true, parts.join(' '), missed.length > 0 ? 'warn' : 'ok');
    }

    var now = new Date().getFullYear();
    for (var y = now + 1; y >= now - 3; y--) {
        var o = document.createElement('option');
        o.value = y; o.textContent = y; if (y === now) o.selected = true;
        $('cfYear').appendChild(o);
    }
    $('cfYear').addEventListener('change', function () { msg(true, ''); load(); });

    // Laddas lat när ekonomisidans rälspost öppnas.
    window.hpskLoadClubFees = load;
})();
</script>
