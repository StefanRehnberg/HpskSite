@{
    var feeClubId = ViewBag.clubId as int? ?? 0;
    // Läsläge för styrelsen och revisorn på ekonomisidan: samma lista, inga knappar.
    var feeReadOnly = ViewData["feesReadOnly"] as bool? ?? false;
}
@*
    MEDLEMSAVGIFTER — klubbens årsavgift till sina medlemmar. Bor på ekonomisidan (rälsposten
    Medlemsavgifter). See Documentation/MEMBER_DATABASE.md §4.

    ⚠️⚠️ SAMMA FORM SOM KRETSAVGIFTEN, OCH SAJTENS FORMSPRÅK (Stefan 2026-09-23). Den gamla ytan
    började med en helsida inställningar och en knapp "Generera avgifter…" som ingen förstod — Ove
    vill bara skicka ut uppmaningen att betala. Därför:
      - Listan ÄR sidan: en rad per medlem, vad hen ska betala och Status.
      - "Generera" finns inte som begrepp. Avgiften skapas när den skickas (eller när raden rörs),
        ur SAMMA regel som listan visar (ClubFeeProposal).
      - Avgiften per medlemstyp är en INSTÄLLNING — en dialog bakom sidans Åtgärder.
      - EN blå Åtgärder uppe till höger: Skicka, Påminn, Inställningar. Per rad [Betald] + grå Åtgärder.
      - Raden ser likadan ut före och efter utskicket; bara Status ändras.
    ⚠️ Inga alert()/prompt(): en blockerande dialog har redan rapporterats som att sidan "frös".
*@
<style>
    #cfRoot td, #cfRoot th { vertical-align: middle; }
    #cfRoot .cf-total td { border-top: 2px solid var(--bs-border-color); font-weight: 600; }
    #cfRoot .cf-n { white-space: nowrap; }
    @@media (max-width: 575.98px) { #cfRoot tr.cf-main td { border-bottom: 0; padding-bottom: 0; } }
</style>

<div id="cfRoot">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <div class="fw-semibold" id="cfRateLine"></div>
            <div class="small text-muted" id="cfSummary"></div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <select id="cfYear" class="form-select" style="width:auto" aria-label="År"></select>
            @if (!feeReadOnly)
            {
            <div class="dropdown">
                <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="cfPageMenu">
                    <i class="bi bi-sliders me-2"></i>Åtgärder
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width:280px">
                    <li><h6 class="dropdown-header">Skicka</h6></li>
                    <li><button class="dropdown-item" type="button" id="cfSend"><i class="bi bi-envelope me-2"></i><span></span></button></li>
                    <li><button class="dropdown-item" type="button" id="cfRemind"><i class="bi bi-bell me-2"></i><span></span></button></li>
                    <li><span class="dropdown-item-text small text-muted d-none" id="cfNothingToSend"></span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Inställningar</h6></li>
                    <li><button class="dropdown-item" type="button" id="cfEditRates"><i class="bi bi-cash-coin me-2"></i><span>Avgift per medlemstyp</span></button></li>
                    <li><button class="dropdown-item" type="button" id="cfEditTypes"><i class="bi bi-people me-2"></i><span>Medlemstyper och åldersgränser…</span></button></li>
                    <li class="d-none" id="cfAgeItemLi"><button class="dropdown-item" type="button" id="cfAgeItem"><i class="bi bi-arrow-left-right me-2"></i><span>Åldersförslag…</span></button></li>
                </ul>
            </div>
            }
        </div>
    </div>

    <div class="alert alert-danger d-none" id="cfError"></div>
    <div class="alert alert-success d-none" id="cfOk"></div>

    @* Medlemmar utan typ får ingen avgift. Gul varning, inte ett fel (Stefan 2026-11-25). *@
    <div class="alert alert-warning d-none" id="cfUntyped">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <span><span id="cfUntypedText"></span> <span class="small">Ange typen under Medlemmar, i importen eller här.</span></span>
            @if (!feeReadOnly)
            {
            <button type="button" class="btn btn-sm btn-outline-secondary" id="cfSetUntyped">Sätt typ på alla…</button>
            }
        </div>
    </div>
    @* Läsrollerna (styrelse, revisor) har ingen Åtgärder-meny men ska kunna läsa förslagslistan. *@
    @if (feeReadOnly)
    {
    <div class="small mb-2 d-none" id="cfAgeLink"><button type="button" class="btn btn-link btn-sm p-0" id="cfAgeLinkBtn"></button></div>
    }

    <div class="text-center py-4 d-none" id="cfNoRate">
        <p class="mb-3" id="cfNoRateText"></p>
        @if (!feeReadOnly)
        {
        <button type="button" class="btn btn-primary" id="cfNoRateBtn">Bestäm avgiften</button>
        }
    </div>

    <div id="cfListWrap" class="d-none">
        <div class="table-responsive">
            <table class="table align-middle mb-2">
                <thead><tr>
                    <th>Medlem</th>
                    <th class="d-none d-sm-table-cell">Medlemstyp</th>
                    <th class="d-none d-md-table-cell">E-post</th>
                    <th class="text-end">Att betala</th>
                    <th class="d-none d-sm-table-cell">Status</th>
                    <th class="text-end d-none d-sm-table-cell"><span class="visually-hidden">Åtgärder</span></th>
                </tr></thead>
                <tbody id="cfRows"></tbody>
            </table>
        </div>
    </div>
</div>

@* Inställningen: avgift per medlemstyp. Ändringar sparas direkt; "Klar" stänger. *@
<div class="modal fade" id="cfRatesModal" tabindex="-1" aria-hidden="true" aria-labelledby="cfRatesTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfRatesTitle">Avgift per medlemstyp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Årsmötet bestämmer avgiften. Varje medlem betalar avgiften för sin medlemstyp.
                    En familj betalar en gång, via huvudmedlemmen.</p>
                <p class="text-muted small"><strong>Medlemmen kan välja</strong> — medlemmen får välja den här medlemstypen själv
                    på betalsidan, till exempel om hen blivit pensionär. Du ser i listan när en medlem valt själv.
                    Familj, hedersmedlem och ständig medlem är avstängda från början.</p>
                <table class="table table-sm align-middle">
                    <thead><tr><th>Medlemstyp</th><th class="text-end">Avgift</th><th class="text-center">Medlemmen kan välja</th><th></th></tr></thead>
                    <tbody id="cfRatesRows"></tbody>
                </table>
                <div class="row g-2 align-items-end">
                    <div class="col-6">
                        <label class="form-label small mb-0" for="cfNewType">Medlemstyp</label>
                        <select id="cfNewType" class="form-select form-select-sm"></select>
                    </div>
                    <div class="col-3">
                        <label class="form-label small mb-0" for="cfNewAmount">Avgift</label>
                        <input id="cfNewAmount" type="number" min="0" step="1" class="form-control form-control-sm" autocomplete="off">
                    </div>
                    <div class="col-3">
                        <button type="button" class="btn btn-primary btn-sm w-100" id="cfAddRate">Lägg till</button>
                    </div>
                </div>
                <p class="text-muted small mt-3 mb-0">Avgifter som redan skickats ändras inte.</p>
                <div class="alert alert-danger d-none mt-3 mb-0" id="cfRatesError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Klar</button>
            </div>
        </div>
    </div>
</div>

@* Medlemstyper och åldersgränser. Typerna sparas direkt; åldersgränserna sparas som HELA stegen med knappen. *@
<div class="modal fade" id="cfTypesModal" tabindex="-1" aria-hidden="true" aria-labelledby="cfTypesTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfTypesTitle">Medlemstyper och åldersgränser</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Medlemstyperna är klubbens egna. Ange <strong>från ålder</strong> för de typer som hör till en ålder,
                    så föreslår vi byten när medlemmar byter åldersgrupp — kassören godkänner en lista, inget byts av sig självt.
                    Medlemmen kan inte heller välja en typ utanför sin åldersgrupp på betalsidan.</p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-2">
                        <thead><tr><th>Medlemstyp</th><th class="text-end d-none d-sm-table-cell">Medlemmar</th><th>Från ålder</th><th><span class="visually-hidden">Åtgärder</span></th></tr></thead>
                        <tbody id="cfTypeRows"></tbody>
                    </table>
                </div>
                <div class="mb-3"><button type="button" class="btn btn-sm btn-outline-secondary" id="cfNewTypeBtn"><i class="bi bi-plus-lg me-1"></i>Ny medlemstyp…</button></div>
                <div class="fw-semibold small" id="cfAgeSummary"></div>
                <div class="small text-muted mt-1 d-none" id="cfAgeSuggest">
                    <span>Förslag efter SHB: junior till och med det år man fyller 20 (Senior från 21) och veteran från 60.
                        SHB gäller tävlingsklass, inte avgift — klubben bestämmer själv.</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" id="cfAgeFill">Fyll i förslaget</button>
                </div>
                <div class="alert alert-danger d-none mt-3 mb-0" id="cfTypesError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
                <button type="button" class="btn btn-primary" id="cfAgeSave" disabled>Spara åldersgränser</button>
            </div>
        </div>
    </div>
</div>

@* Förslagslistan: vilka medlemmar som bör byta medlemstyp efter ålder. Sparas aldrig; godkänns som en lista. *@
<div class="modal fade" id="cfAgeModal" tabindex="-1" aria-hidden="true" aria-labelledby="cfAgeTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfAgeTitle">Åldersförslag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="cfAgeBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
                @if (!feeReadOnly)
                {
                <button type="button" class="btn btn-primary" id="cfAgeApply" disabled>Godkänn valda</button>
                }
            </div>
        </div>
    </div>
</div>

@* EN liten dialog för alla bekräftelser och namnfrågor (ingen window.confirm — den har rapporterats som att sidan "frös"). *@
<div class="modal fade" id="cfSubModal" tabindex="-1" aria-hidden="true" aria-labelledby="cfSubTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfSubTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div id="cfSubBody"></div>
                <div class="alert alert-danger d-none mt-3 mb-0" id="cfSubError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="cfSubOk">Spara</button>
            </div>
        </div>
    </div>
</div>

@* Vart medlemmens avgift ska mejlas — t.ex. förälderns adress för en junior. *@
<div class="modal fade" id="cfEmailModal" tabindex="-1" aria-hidden="true" aria-labelledby="cfEmailTitle">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cfEmailTitle">E-post för avgiften</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="cfEmailInput">Skicka medlemsavgiften till</label>
                <input id="cfEmailInput" type="email" class="form-control" autocomplete="off">
                <p class="text-muted small mt-2 mb-0" id="cfEmailHelp"></p>
                <div class="alert alert-danger d-none mt-3 mb-0" id="cfEmailError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="cfEmailSave">Spara</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    if (window.__clubFeeInit) return;
    window.__clubFeeInit = true;

    var CLUB_ID = @feeClubId;
    var READONLY = @(feeReadOnly ? "true" : "false");
    var CLUB_URL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["clubUrl"] as string ?? ""));
    var F = '/umbraco/surface/MembershipFeeAdmin/';
    var data = null, dirty = false;
    var MONTHS = ['jan','feb','mar','apr','maj','jun','jul','aug','sep','okt','nov','dec'];

    function $(id) { return document.getElementById(id); }
    function esc(s) {
        return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function kr(n) { return (Math.round((n || 0) * 100) / 100).toLocaleString('sv-SE', { maximumFractionDigits: 2 }) + ' kr'; }
    function day(iso) { if (!iso) return ''; var p = iso.split('-'); return parseInt(p[2], 10) + ' ' + MONTHS[parseInt(p[1], 10) - 1]; }
    function year() { return parseInt($('cfYear').value, 10); }
    function show(el, on) { if (el) el.classList.toggle('d-none', !on); }
    function msg(ok, text, kind) {
        $('cfOk').className = 'alert ' + (kind === 'warn' ? 'alert-warning' : 'alert-success');
        show($('cfOk'), ok && !!text); show($('cfError'), !ok && !!text);
        $(ok ? 'cfOk' : 'cfError').textContent = text || '';
    }
    async function token() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        if (el && el.value) return el.value;
        return (await (await fetch('/umbraco/surface/Club/GetFormToken', { cache: 'no-store' })).json()).token;
    }
    async function form(action, fields) {
        var fd = new FormData();
        Object.keys(fields).forEach(function (k) {
            var v = fields[k];
            if (Array.isArray(v)) v.forEach(function (x) { fd.append(k, x); }); else fd.append(k, v);
        });
        fd.append('__RequestVerificationToken', await token());
        var r = await fetch(F + action, { method: 'POST', body: fd });
        try { return await r.json(); } catch (e) { return { success: false, message: 'Något gick fel (' + r.status + ').' }; }
    }

    // ── Medlemstyper: nyckel + klubbens namn. Visa ALLTID namnet, aldrig nyckeln (en egen typ har nyckeln x-…). ──
    var types = [], untyped = 0, ageRules = { enabled: false, error: null };
    var NEVER_AGE = { 'familj': 1, 'hedersmedlem': 1, 'ständig': 1, 'stödjande': 1 };
    function typeOf(key) { var k = (key || '').toLowerCase(); return types.find(function (t) { return (t.key || '').toLowerCase() === k; }); }
    function typeName(key) { if (!key) return ''; var t = typeOf(key); return t ? t.name : key; }
    function neverAge(key) { return !!NEVER_AGE[(key || '').toLowerCase()]; }

    function rowOf(memberId) { return (data.rows || []).find(function (r) { return r.memberId === memberId; }); }
    var BILLABLE = { Individual: true, HouseholdPrimary: true };

    // ⚠️ Varje handling på en rad börjar här: avgiften skapas oskickad om den inte finns.
    async function chargeIdFor(memberId) {
        var r = rowOf(memberId);
        if (r && r.charge) return r.charge.id;
        var e = await form('EnsureClubCharge', { clubId: CLUB_ID, year: year(), memberId: memberId });
        if (!e.success) { msg(false, e.message); return null; }
        return e.chargeId;
    }

    function stateOf(r) {
        var c = r.charge;
        return {
            c: c,
            paid: !!c && c.status === 'Paid',
            sent: !!c && !!c.requestSentDate,
            claimed: !!c && !!c.paymentSentDate,
            covered: r.kind === 'Covered' || (!!c && c.covered),
            billable: !!c ? (!c.covered && c.amount > 0) : (BILLABLE[r.kind] && r.proposedAmount > 0),
            // Medlemmen saknar medlemstyp och väljer den på betalsidan — mejlet gäller valet, inte ett belopp.
            choose: !!c ? !!c.needsTypeChoice : r.kind === 'ChooseType',
            amount: c ? c.amount : r.proposedAmount
        };
    }

    // ⚠️ Status som på resten av sajten (Anmälningar, Fakturor): en BRICKA, datum intill i grått.
    function badge(cls, text, note) {
        return '<span class="badge ' + cls + '">' + text + '</span>' + (note ? ' <span class="small text-muted">' + note + '</span>' : '');
    }
    function statusCell(r, s) {
        if (s.covered) return badge('bg-light text-dark border', 'Ingår i familjen', r.coveredBy ? esc(r.coveredBy) + ' betalar' : '');
        if (s.paid) return badge('bg-success', 'Betald', s.c.paidDate ? day(s.c.paidDate) : '');
        if (s.claimed) return badge('bg-info text-dark', 'Uppgett betald', day(s.c.paymentSentDate));
        if (s.choose) return badge('bg-info text-dark', 'Väljer medlemstyp', s.sent ? 'skickad ' + day(s.c.requestSentDate) : 'på betalsidan');
        if (!s.c && r.kind === 'NoType') return badge('bg-light text-dark border', 'Ingen medlemstyp', 'ange den under Medlemmar');
        if (!s.c && r.kind === 'NoCategory') return badge('bg-light text-dark border', 'Ingen avgift', 'för ' + esc(typeName(r.membershipType)));
        if (s.amount <= 0) return badge('bg-light text-dark border', 'Ingen avgift');
        if (s.sent) return badge('bg-warning text-dark', 'Väntande', 'skickad ' + day(s.c.requestSentDate));
        return badge('bg-secondary', 'Inte skickad');
    }
    // Medlemstypen — och om MEDLEMMEN valt den själv. Kassören ska se det: ett förtroendesystem, inte ett osynligt.
    function typeCell(r, s) {
        var t = esc(typeName(r.membershipType));
        if (s.choose) return '<span class="text-muted">väljer själv</span>';
        if (s.c && s.c.memberChosenType)
            t += ' <span class="badge bg-light text-dark border" title="Medlemmen valde medlemstypen själv på betalsidan'
               + (s.c.memberChosenAt ? ' ' + day(s.c.memberChosenAt) : '') + '">vald av medlemmen</span>';
        return t;
    }
    // Vart avgiften mejlas. Saknas adress står det i listan — inte i en text under den.
    function emailCell(r) {
        if (!r.hasEmail) return '<span class="badge bg-danger-subtle text-danger-emphasis border">Ingen e-post</span>';
        return '<span class="small">' + esc(r.email) + '</span>';
    }

    function item(act, id, text, extra) {
        return '<li><button type="button" class="dropdown-item' + (extra || '') + '" data-cf-act="' + act
             + '" data-cf-id="' + id + '">' + text + '</button></li>';
    }
    function actionsCell(r, s) {
        if (READONLY || s.covered) return '';
        var id = r.memberId, items = [];
        if (s.paid) items.push(item('unpaid', id, 'Ångra betald'));
        else if (s.billable || s.choose) {
            // Betald ligger i menyn som allt annat på raden — samma form som resten av sajten.
            // En medlem som väljer medlemstyp har inget belopp än, och kan inte markeras betald.
            if (!s.choose) {
                items.push('<li><h6 class="dropdown-header">Betalning</h6></li>');
                items.push(item('paid', id, 'Markera som betald'));
                items.push('<li><hr class="dropdown-divider"></li>');
            }
            items.push('<li><h6 class="dropdown-header">Mejlet</h6></li>');
            items.push(item('preview', id, 'Visa mejlet'));
            if (r.hasEmail) items.push(item('send-one', id, s.sent ? 'Skicka mejlet igen' : 'Skicka mejlet nu'));
            items.push(item('link', id, 'Kopiera betallänk'));
        } else if (r.kind === 'NoCategory') items.push(item('rates', id, 'Avgift per medlemstyp…'));
        // E-postadressen går att sätta för alla — en förälder som betalar juniorens avgift.
        if (!s.paid) items.push(item('email', id, 'E-post för avgiften…'));
        return '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" '
             + 'data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\'>Åtgärder</button>'
             + '<ul class="dropdown-menu dropdown-menu-end">' + items.join('') + '</ul></div>';
    }

    function render() {
        var cats = data.categories || [];
        var hasRate = cats.length > 0;
        var yr = year();
        $('cfRateLine').textContent = hasRate
            ? 'Avgiften ' + yr + ': ' + cats.map(function (c) { return typeName(c.membershipType) + ' ' + kr(c.amount); }).join(' · ') : '';
        show($('cfNoRate'), !hasRate);
        $('cfNoRateText').textContent = 'Klubben har inte bestämt medlemsavgiften för ' + yr + ' än.';
        show($('cfListWrap'), hasRate);
        if ($('cfEditRates')) $('cfEditRates').querySelector('span').textContent = 'Avgift per medlemstyp ' + yr + '…';

        var rows = data.rows || [];
        var html = '', total = 0, billed = 0, paidCount = 0, paidSum = 0, toSend = 0, noMail = 0, toRemind = 0;
        rows.forEach(function (r) {
            var s = stateOf(r);
            if (s.billable) { total += s.amount; billed++; }
            if (s.paid && s.billable) { paidCount++; paidSum += s.amount; }
            if ((s.billable || s.choose) && !s.paid && !s.sent) { if (r.hasEmail) toSend++; else noMail++; }
            if (s.billable && !s.paid && s.sent) toRemind++;

            var amount = s.covered ? '<span class="text-muted">—</span>' : (s.billable || s.paid ? kr(s.amount) : '<span class="text-muted">—</span>');
            html += '<tr class="cf-main"><td>' + esc(r.name) + '<div class="small text-muted d-sm-none">' + typeCell(r, s) + '</div></td>'
                  + '<td class="d-none d-sm-table-cell">' + typeCell(r, s) + '</td>'
                  + '<td class="d-none d-md-table-cell">' + emailCell(r) + '</td>'
                  + '<td class="text-end cf-n">' + amount + '</td>'
                  + '<td class="small d-none d-sm-table-cell">' + statusCell(r, s) + '</td>'
                  + '<td class="text-end cf-n cf-actions d-none d-sm-table-cell">' + actionsCell(r, s) + '</td></tr>'
                  + '<tr class="cf-mrow d-sm-none"><td colspan="2"><div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">'
                  + '<span>' + statusCell(r, s) + (r.hasEmail ? '' : ' ' + emailCell(r)) + '</span>' + actionsCell(r, s) + '</div></td></tr>';
        });
        html += '<tr class="cf-total"><td>Totalt</td><td class="d-none d-sm-table-cell"></td><td class="d-none d-md-table-cell"></td><td class="text-end cf-n">' + kr(total)
              + '</td><td class="d-none d-sm-table-cell"></td><td class="d-none d-sm-table-cell"></td></tr>';
        $('cfRows').innerHTML = html;

        $('cfSummary').textContent = hasRate
            ? paidCount + ' av ' + billed + ' medlemmar har betalat · ' + kr(paidSum) + ' av ' + kr(total) : '';

        if ($('cfSend')) {
            $('cfSend').querySelector('span').textContent = 'Skicka avgiften till ' + toSend + (toSend === 1 ? ' medlem' : ' medlemmar');
            $('cfRemind').querySelector('span').textContent = 'Påminn ' + toRemind + (toRemind === 1 ? ' medlem' : ' medlemmar') + ' som inte betalat';
            show($('cfSend').parentElement, hasRate && toSend > 0);
            show($('cfRemind').parentElement, hasRate && toRemind > 0);
            show($('cfNothingToSend'), !(hasRate && (toSend > 0 || toRemind > 0)));
            $('cfNothingToSend').textContent = hasRate ? 'Alla medlemmar har fått avgiften.' : 'Bestäm avgiften först.';
        }

        renderRates();
        renderUntyped();
    }

    // Gul varning: aktiva medlemmar utan typ får ingen avgift.
    function renderUntyped() {
        show($('cfUntyped'), untyped > 0);
        $('cfUntypedText').textContent = untyped === 1 ? '1 medlem saknar medlemstyp.' : untyped + ' medlemmar saknar medlemstyp.';
    }

    function renderRates() {
        var cats = (data && data.categories) || [];
        $('cfRatesTitle').textContent = 'Avgift per medlemstyp ' + year();
        // Typväljaren: klubbens aktiva typer (namn), värdet är nyckeln.
        var sel = $('cfNewType'), keep = sel.value;
        sel.innerHTML = types.filter(function (t) { return t.isActive; })
            .map(function (t) { return '<option value="' + esc(t.key) + '">' + esc(t.name) + '</option>'; }).join('');
        if (keep) sel.value = keep;
        $('cfRatesRows').innerHTML = cats.map(function (c) {
            return '<tr><td>' + esc(typeName(c.membershipType)) + '</td><td class="text-end">' + kr(c.amount) + '</td>'
                 + '<td class="text-center"><div class="form-check form-switch d-inline-block m-0">'
                 + '<input class="form-check-input" type="checkbox" role="switch" data-cf-selrate="' + c.id + '"'
                 + (c.memberSelectable ? ' checked' : '') + ' aria-label="Medlemmen kan välja ' + esc(typeName(c.membershipType)) + '"></div></td>'
                 + '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" data-cf-delrate="' + c.id
                 + '" title="Ta bort">Ta bort</button></td></tr>';
        }).join('') || '<tr><td colspan="4" class="text-muted small">Ingen avgift bestämd ännu.</td></tr>';
    }

    // ⚠️ load() rör INTE beskedet — det körs direkt efter Skicka.
    // ⚠️ Ett svar som kommer efter ett årsbyte gäller fel år och får INTE skriva över listan.
    var loadSeq = 0;
    async function load() {
        var mine = ++loadSeq;
        var both = await Promise.all([
            fetch(F + 'GetOverview?clubId=' + CLUB_ID + '&year=' + year(), { cache: 'no-store' }).then(function (r) { return r.json(); }),
            fetch(F + 'GetMemberTypes?clubId=' + CLUB_ID, { cache: 'no-store' }).then(function (r) { return r.json(); }).catch(function () { return null; })
        ]);
        var d = both[0], t = both[1];
        if (mine !== loadSeq) return;
        if (!d.success) { msg(false, d.message || 'Medlemsavgifterna gick inte att läsa.'); return; }
        // Typerna är namnen på sidan. Går de inte att läsa visas nycklarna (standardtyperna är läsbara ändå) — aldrig en tom lista.
        if (t && t.success) { types = t.types || []; untyped = t.untyped || 0; ageRules = t.ageRules || { enabled: false, error: null }; }
        data = d;
        render();
        refreshAgeCount();
    }

    // ── Inställningen ───────────────────────────────────────────────────────────────────
    function openRates() {
        show($('cfRatesError'), false);
        renderRates();
        bootstrap.Modal.getOrCreateInstance($('cfRatesModal')).show();
    }
    if ($('cfEditRates')) $('cfEditRates').addEventListener('click', openRates);
    if ($('cfNoRateBtn')) $('cfNoRateBtn').addEventListener('click', openRates);
    function ratesError(t) { $('cfRatesError').textContent = t || ''; show($('cfRatesError'), !!t); }
    $('cfAddRate').addEventListener('click', async function () {
        var amount = parseFloat($('cfNewAmount').value);
        if (isNaN(amount) || amount < 0) { ratesError('Fyll i en avgift.'); return; }
        var type = $('cfNewType').value;
        var existing = (data.categories || []).find(function (c) { return c.membershipType === type; });
        var d = await form('SaveCategory', { id: existing ? existing.id : 0, clubId: CLUB_ID, year: year(),
                                             membershipType: type, label: typeName(type), amount: amount });
        if (!d.success) { ratesError(d.message || 'Avgiften kunde inte sparas.'); return; }
        ratesError(''); $('cfNewAmount').value = ''; dirty = true;
        await load();
    });
    $('cfRatesRows').addEventListener('click', async function (ev) {
        var b = ev.target.closest('[data-cf-delrate]');
        if (!b) return;
        var d = await form('DeleteCategory', { id: b.getAttribute('data-cf-delrate'), clubId: CLUB_ID });
        if (!d.success) { ratesError(d.message || 'Avgiften kunde inte tas bort.'); return; }
        dirty = true;
        await load();
    });
    // "Medlemmen kan välja" — sparas direkt, som resten av dialogen.
    $('cfRatesRows').addEventListener('change', async function (ev) {
        var cb = ev.target.closest('[data-cf-selrate]');
        if (!cb) return;
        var id = parseInt(cb.getAttribute('data-cf-selrate'), 10);
        var c = (data.categories || []).find(function (x) { return x.id === id; });
        if (!c) return;
        cb.disabled = true;
        var d = await form('SaveCategory', { id: c.id, clubId: CLUB_ID, year: year(), membershipType: c.membershipType,
                                             label: typeName(c.membershipType), amount: c.amount, memberSelectable: cb.checked ? '1' : '0' });
        if (!d.success) { ratesError(d.message || 'Inställningen kunde inte sparas.'); cb.checked = !cb.checked; cb.disabled = false; return; }
        ratesError(''); dirty = true;
        await load();
    });
    $('cfRatesModal').addEventListener('hidden.bs.modal', function () { if (dirty) { dirty = false; msg(true, ''); } });

    // ── E-post för avgiften ─────────────────────────────────────────────────────────────
    var emailFor = 0;
    $('cfEmailSave').addEventListener('click', async function () {
        var d = await form('SetFeeEmail', { issuerType: 0, issuerId: CLUB_ID, payerId: emailFor, email: $('cfEmailInput').value });
        // ⚠️ Dialogen stängs INTE vid fel — annars får man börja om för att läsa vad som gick snett.
        if (!d.success) { $('cfEmailError').textContent = d.message || 'Adressen kunde inte sparas.'; show($('cfEmailError'), true); return; }
        bootstrap.Modal.getOrCreateInstance($('cfEmailModal')).hide();
        msg(true, '');
        load();
    });

    // ── Klick i listan ──────────────────────────────────────────────────────────────────
    $('cfRoot').addEventListener('click', async function (ev) {
        var a = ev.target.closest('[data-cf-act]');
        if (!a) return;
        var act = a.getAttribute('data-cf-act'), memberId = parseInt(a.getAttribute('data-cf-id'), 10);
        var row = rowOf(memberId), r, id;

        if (act === 'rates') { openRates(); return; }
        if (act === 'email') {
            emailFor = memberId;
            $('cfEmailTitle').textContent = 'E-post för avgiften — ' + row.name;
            $('cfEmailInput').value = row.emailIsOwn ? row.email : '';
            $('cfEmailHelp').textContent = (row.defaultEmail
                ? 'Lämna tomt för att använda medlemmens egen adress (' + row.defaultEmail + ').'
                : 'Medlemmen har ingen egen adress på pistol.nu.') + ' Medlemmens egen adress ändras inte.';
            show($('cfEmailError'), false);
            bootstrap.Modal.getOrCreateInstance($('cfEmailModal')).show();
            return;
        }
        if (act === 'preview') {
            // ⚠️ Fönstret öppnas FÖRE await — ett window.open efter en väntan blockeras.
            var w = window.open('about:blank', '_blank');
            id = await chargeIdFor(memberId);
            if (!id) { if (w) w.close(); return; }
            if (w) w.location = F + 'PreviewClubPaymentRequest?chargeId=' + id;
            if (!row.charge) load();
            return;
        }
        if (act === 'link') {
            id = await chargeIdFor(memberId); if (!id) return;
            r = await (await fetch(F + 'GetPaymentLink?chargeId=' + id, { cache: 'no-store' })).json();
            if (!r.success) { msg(false, r.message); return; }
            try { await navigator.clipboard.writeText(r.url); msg(true, 'Betallänken för ' + row.name + ' är kopierad.'); }
            catch (x) { msg(true, 'Betallänk för ' + row.name + ': ' + r.url); }
            load();
            return;
        }
        if (act === 'send-one') {
            id = await chargeIdFor(memberId); if (!id) return;
            report(await form('SendPaymentRequests', { clubId: CLUB_ID, year: year(), chargeIds: String(id) }));
            load();
            return;
        }

        a.disabled = true;
        if (act === 'paid') {
            id = await chargeIdFor(memberId);
            r = id ? await form('MarkPaid', { chargeId: id }) : null;
        } else if (act === 'unpaid') {
            r = await form('MarkUnpaid', { chargeId: row.charge.id });
        } else { a.disabled = false; return; }

        if (!r || !r.success) { if (r) msg(false, r.message); a.disabled = false; if (!row.charge) load(); return; }
        msg(true, '');
        load();
    });

    // ── Skicka och påminn ───────────────────────────────────────────────────────────────
    if ($('cfSend')) $('cfSend').addEventListener('click', async function () {
        var list = (data.rows || []).filter(function (r) { var s = stateOf(r); return (s.billable || s.choose) && !s.paid && !s.sent && r.hasEmail; });
        if (list.length === 0) return;
        var sum = list.reduce(function (a, r) { return a + stateOf(r).amount; }, 0);
        var choosing = list.filter(function (r) { return stateOf(r).choose; }).length;        openSub({
            title: 'Skicka medlemsavgiften ' + year(), ok: 'Skicka',
            body: '<p class="mb-2">Mejla medlemsavgiften ' + year() + ' till <strong>' + list.length + (list.length === 1 ? ' medlem' : ' medlemmar')
                + '</strong>, totalt <strong>' + kr(sum) + '</strong>.</p>'
                + (choosing ? '<p class="small text-muted mb-2">' + choosing + ' saknar medlemstyp och får välja den själva på betalsidan.</p>' : '')
                + '<div id="cfSendWarn"></div>',
            onOk: async function () {
                // Medlemmar som ingen rört har ingen avgift än — den skapas nu, ur samma regel som listan visar.
                var g = await form('GenerateCharges', { clubId: CLUB_ID, year: year() });
                if (!g.success) return g.message || 'Avgifterna kunde inte skapas.';
                report(await form('SendPaymentRequests', { clubId: CLUB_ID, year: year(), mode: 'unsent' }));
                load();
                return null;
            }
        });
        // Gul varning (spärrar inte): förslag efter ålder som ingen godkänt. Går de inte att räkna visas ingenting.
        var pending = await fetchAge();
        var box = $('cfSendWarn');
        if (box && subCfg && pending && ageProposalCount(pending) > 0) {
            var n = ageProposalCount(pending);
            box.innerHTML = '<div class="alert alert-warning mb-0 small">' + n + (n === 1 ? ' medlem har' : ' medlemmar har')
                + ' ett förslag på ny medlemstyp efter ålder som ingen godkänt. Avgiften skickas med den typ de har nu. '
                + '<button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-cf-open-age="1">Granska förslagen</button></div>';
        }
    });
    if ($('cfRemind')) $('cfRemind').addEventListener('click', function () {
        var n = (data.rows || []).filter(function (r) { var s = stateOf(r); return s.billable && !s.paid && s.sent; }).length;
        openSub({
            title: 'Påminn medlemmarna', ok: 'Skicka påminnelse',
            body: '<p class="mb-0">Mejla en påminnelse till <strong>' + n + (n === 1 ? ' medlem' : ' medlemmar') + '</strong> som inte betalat.</p>',
            onOk: async function () {
                report(await form('SendPaymentRequests', { clubId: CLUB_ID, year: year(), mode: 'reminder' }));
                load();
                return null;
            }
        });
    });

    // ── Dialoger ────────────────────────────────────────────────────────────────────────
    // showModal(till, från): har man en dialog öppen stängs den först — Bootstrap staplar inte dialoger.
    function showModal(to, from) {
        var t = bootstrap.Modal.getOrCreateInstance($(to));
        var f = from ? $(from) : null;
        if (!f || !f.classList.contains('show')) { t.show(); return; }
        f.addEventListener('hidden.bs.modal', function once() { f.removeEventListener('hidden.bs.modal', once); t.show(); });
        bootstrap.Modal.getOrCreateInstance(f).hide();
    }

    // EN dialog för bekräftelser och namnfrågor. onOk returnerar ett felmeddelande, eller null när det gick.
    // cfg: { title, body (html), ok, danger, from (dialogen som öppnade, öppnas igen vid stängning), after (körs vid stängning), onOk }
    var subCfg = null;
    function openSub(cfg) {
        subCfg = cfg;
        cfg.back = cfg.back || cfg.from;
        $('cfSubTitle').textContent = cfg.title;
        $('cfSubBody').innerHTML = cfg.body;
        $('cfSubOk').textContent = cfg.ok || 'Spara';
        $('cfSubOk').className = 'btn ' + (cfg.danger ? 'btn-danger' : 'btn-primary');
        $('cfSubOk').disabled = false;
        show($('cfSubError'), false);
        showModal('cfSubModal', cfg.from);
    }
    $('cfSubOk').addEventListener('click', async function () {
        if (!subCfg) return;
        var btn = this; btn.disabled = true;
        var err = null;
        try { err = await subCfg.onOk(); } catch (e) { err = 'Något gick fel. Försök igen.'; }
        btn.disabled = false;
        if (err) { $('cfSubError').textContent = err; show($('cfSubError'), true); return; }
        bootstrap.Modal.getOrCreateInstance($('cfSubModal')).hide();
    });
    $('cfSubBody').addEventListener('keydown', function (ev) { if (ev.key === 'Enter' && ev.target.tagName === 'INPUT') { ev.preventDefault(); $('cfSubOk').click(); } });
    $('cfSubBody').addEventListener('click', function (ev) {
        if (ev.target.closest('[data-cf-open-age]') && subCfg) { subCfg.after = openAge; bootstrap.Modal.getOrCreateInstance($('cfSubModal')).hide(); }
    });
    $('cfSubModal').addEventListener('shown.bs.modal', function () { var i = $('cfSubBody').querySelector('input,select'); if (i) i.focus(); });
    $('cfSubModal').addEventListener('hidden.bs.modal', function () {
        var c = subCfg; subCfg = null;
        if (!c) return;
        if (c.after) c.after(); else if (c.back) bootstrap.Modal.getOrCreateInstance($(c.back)).show();
    });

    // ── Medlemstyper och åldersgränser ──────────────────────────────────────────────────
    var ageEdit = {};
    function savedAge(t) { return t.fromAge == null ? '' : String(t.fromAge); }
    function typesNote(ok, text) {
        var el = $('cfTypesError');
        el.className = 'alert ' + (ok ? 'alert-success' : 'alert-danger') + ' mt-3 mb-0' + (text ? '' : ' d-none');
        el.textContent = text || '';
    }
    function editedSteps() {
        var out = [];
        types.forEach(function (t) {
            if (!t.isActive || neverAge(t.key)) return;
            var v = (ageEdit[t.key] || '').trim(); if (v === '') return;
            var n = parseInt(v, 10); if (isNaN(n)) return;
            out.push({ key: t.key, name: t.name, from: n });
        });
        out.sort(function (a, b) { return a.from - b.from; });
        return out;
    }
    function ageDirty() {
        return types.some(function (t) { return !neverAge(t.key) && ((ageEdit[t.key] || '').trim()) !== savedAge(t); });
    }
    // Luckor och överlapp syns som text: "Junior 0–20 · Senior 21–59 · Veteran 60+".
    function renderAgeSummary() {
        var steps = editedSteps(), el = $('cfAgeSummary');
        if (!steps.length) {
            el.className = 'small text-muted';
            el.textContent = 'Ingen åldersgräns är satt. Då görs inga åldersförslag, och medlemmen väljer fritt på betalsidan.';
        } else {
            el.className = 'fw-semibold small';
            el.innerHTML = 'Åldersgrupper: ' + steps.map(function (s, i) {
                var next = steps[i + 1];
                return esc(s.name) + ' ' + (next ? s.from + '–' + (next.from - 1) : s.from + '+');
            }).join(' · ')
            + (steps[0].from > 0 ? '<div class="text-danger fw-normal">Den yngsta gruppen måste börja på 0 år.</div>' : '');
        }
        $('cfAgeSave').disabled = !ageDirty();
        show($('cfAgeSuggest'), !ageRules.enabled && !steps.length);
    }
    function typeMenu(t) {
        var key = esc(t.key), its = [];
        if (!/^familj$/i.test(t.key)) {
            its.push('<li><button type="button" class="dropdown-item" data-cf-tact="rename" data-cf-tkey="' + key + '">Byt namn…</button></li>');
            its.push('<li><button type="button" class="dropdown-item" data-cf-tact="' + (t.isActive ? 'hide' : 'unhide') + '" data-cf-tkey="' + key + '">'
                   + (t.isActive ? 'Dölj' : 'Visa') + '</button></li>');
        }
        if (t.isCustom) its.push('<li><button type="button" class="dropdown-item text-danger" data-cf-tact="delete" data-cf-tkey="' + key + '">Ta bort…</button></li>');
        if (!its.length) return '';
        return '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" '
             + 'data-bs-popper-config=\'{"strategy":"fixed"}\'>Åtgärder</button><ul class="dropdown-menu dropdown-menu-end">' + its.join('') + '</ul></div>';
    }
    function renderTypes() {
        $('cfTypeRows').innerHTML = types.map(function (t) {
            var never = neverAge(t.key);
            var nameCell = esc(t.name) + (t.isActive ? '' : ' <span class="badge bg-light text-dark border">Dold</span>')
                + (!t.isCustom && t.name !== t.key ? '<div class="small text-muted">Standardtyp: ' + esc(t.key) + '</div>' : '')
                + '<div class="small text-muted d-sm-none">' + (t.members || 0) + (t.members === 1 ? ' medlem' : ' medlemmar') + '</div>';
            var from = (never || !t.isActive) ? '<span class="text-muted small">—</span>'
                : '<input type="number" min="0" max="120" step="1" class="form-control form-control-sm" style="width:5.5rem" autocomplete="off" '
                + 'data-cf-from="' + esc(t.key) + '" aria-label="Från ålder, ' + esc(t.name) + '" value="' + esc(ageEdit[t.key] || '') + '">';
            return '<tr><td>' + nameCell + '</td><td class="text-end d-none d-sm-table-cell">' + (t.members || 0) + '</td><td>' + from + '</td><td class="text-end">' + typeMenu(t) + '</td></tr>';
        }).join('') || '<tr><td colspan="4" class="text-muted small">Inga medlemstyper.</td></tr>';
        renderAgeSummary();
    }
    function openTypes(from) {
        ageEdit = {};
        types.forEach(function (t) { ageEdit[t.key] = savedAge(t); });
        typesNote(false, '');
        renderTypes();
        showModal('cfTypesModal', typeof from === 'string' ? from : null);
    }
    // Efter varje ändring: läs om (namnen står överallt) men behåll det som skrivits i åldersfälten.
    async function reloadTypes() { await load(); renderTypes(); }
    function nameField(value) {
        return '<label class="form-label" for="cfTypeNameInput">Namn</label>'
             + '<input id="cfTypeNameInput" class="form-control" maxlength="50" autocomplete="off" value="' + esc(value || '') + '">'
             + '<p class="text-muted small mt-2 mb-0">Namnet visas överallt: i listan, på betalsidan och i mejlen.</p>';
    }
    async function saveType(key, name, active) {
        var d = await form('SaveMemberType', { clubId: CLUB_ID, year: year(), key: key, name: name, isActive: active ? '1' : '0' });
        if (!d.success) return d.message || 'Medlemstypen kunde inte sparas.';
        await reloadTypes();
        return null;
    }
    if ($('cfEditTypes')) $('cfEditTypes').addEventListener('click', function () { openTypes(); });
    $('cfNewTypeBtn').addEventListener('click', function () {
        openSub({ title: 'Ny medlemstyp', ok: 'Lägg till', from: 'cfTypesModal', body: nameField(''),
                  onOk: function () { return saveType('', $('cfTypeNameInput').value, true); } });
    });
    $('cfTypeRows').addEventListener('input', function (ev) {
        var inp = ev.target.closest('[data-cf-from]'); if (!inp) return;
        ageEdit[inp.getAttribute('data-cf-from')] = inp.value;
        renderAgeSummary();
    });
    $('cfTypeRows').addEventListener('click', function (ev) {
        var b = ev.target.closest('[data-cf-tact]'); if (!b) return;
        var key = b.getAttribute('data-cf-tkey'), act = b.getAttribute('data-cf-tact'), t = typeOf(key);
        if (!t) return;
        typesNote(false, '');
        if (act === 'rename') {
            openSub({ title: 'Byt namn på ' + t.name, ok: 'Spara', from: 'cfTypesModal', body: nameField(t.name),
                      onOk: function () { return saveType(t.key, $('cfTypeNameInput').value, t.isActive); } });
        } else if (act === 'unhide') {
            saveType(t.key, t.name, true).then(function (err) { if (err) typesNote(false, err); });
        } else if (act === 'hide') {
            var others = types.filter(function (x) { return x.isActive && x.key !== t.key && !/^familj$/i.test(x.key); });
            var move = t.members > 0
                ? '<p class="mb-2">' + t.members + (t.members === 1 ? ' medlem har' : ' medlemmar har') + ' typen ' + esc(t.name) + '. Flytta dem till en annan typ innan den döljs, annars står de kvar på en dold typ.</p>'
                  + '<label class="form-label" for="cfMoveTo">Flytta medlemmarna till</label><select id="cfMoveTo" class="form-select">'
                  + '<option value="">Flytta inte</option>' + others.map(function (x) { return '<option value="' + esc(x.key) + '">' + esc(x.name) + '</option>'; }).join('') + '</select>'
                : '<p class="mb-0">Typen ' + esc(t.name) + ' har inga medlemmar. En dold typ kan inte väljas men kan visas igen.</p>';
            openSub({ title: 'Dölj ' + t.name, ok: 'Dölj', from: 'cfTypesModal', body: move,
                onOk: async function () {
                    var to = $('cfMoveTo') ? $('cfMoveTo').value : '';
                    if (to) {
                        var m = await form('SetMembersType', { clubId: CLUB_ID, year: year(), toKey: to, fromKey: t.key });
                        if (!m.success) return m.message || 'Medlemmarna kunde inte flyttas.';
                    }
                    return await saveType(t.key, t.name, false);
                } });
        } else if (act === 'delete') {
            openSub({ title: 'Ta bort ' + t.name, ok: 'Ta bort', danger: true, from: 'cfTypesModal',
                body: '<p class="mb-0">Ta bort den egna medlemstypen ' + esc(t.name) + '? Det går bara om ingen medlem, avgift eller åldersgräns använder den.</p>',
                onOk: async function () {
                    var d = await form('DeleteMemberType', { clubId: CLUB_ID, key: t.key });
                    if (!d.success) return d.message || 'Typen kunde inte tas bort.';
                    await reloadTypes();
                    return null;
                } });
        }
    });
    $('cfAgeFill').addEventListener('click', function () {
        // Förslag, inte sanning: SHB:s åldrar gäller tävlingsklass. Fylls bara i i fälten — sparas med knappen.
        var found = [['Junior', 0], ['Senior', 21], ['Veteran', 60]].filter(function (c) { var t = typeOf(c[0]); return t && t.isActive; });
        if (!found.length) { typesNote(false, 'Klubben har varken Junior, Senior eller Veteran bland sina aktiva typer.'); return; }
        types.forEach(function (t) { if (!neverAge(t.key)) ageEdit[t.key] = ''; });
        found.forEach(function (c) { ageEdit[typeOf(c[0]).key] = String(c[1]); });
        ageEdit[typeOf(found[0][0]).key] = '0'; // den yngsta gruppen börjar alltid på 0
        typesNote(false, '');
        renderTypes();
    });
    $('cfAgeSave').addEventListener('click', async function () {
        var steps = editedSteps(), btn = this;
        btn.disabled = true;
        var d = await form('SaveAgeLimits', { clubId: CLUB_ID, typeKeys: steps.map(function (s) { return s.key; }),
                                              fromAges: steps.map(function (s) { return String(s.from); }) });
        if (!d.success) { typesNote(false, d.message || 'Åldersgränserna kunde inte sparas.'); btn.disabled = false; return; }
        await load();
        ageEdit = {}; types.forEach(function (t) { ageEdit[t.key] = savedAge(t); });
        renderTypes();
        typesNote(true, steps.length ? 'Åldersgränserna är sparade.' : 'Åldersgränserna är borttagna.');
    });

    // ── Sätt typ på alla som saknar ─────────────────────────────────────────────────────
    if ($('cfSetUntyped')) $('cfSetUntyped').addEventListener('click', function () {
        var opts = types.filter(function (t) { return t.isActive && !/^familj$/i.test(t.key); });
        openSub({ title: 'Sätt medlemstyp på alla som saknar', ok: 'Sätt typ',
            body: '<p class="mb-2">' + untyped + (untyped === 1 ? ' medlem saknar' : ' medlemmar saknar') + ' medlemstyp. De får den typ du väljer; du kan ändra enskilda medlemmar efteråt.</p>'
                + '<label class="form-label" for="cfUntypedSel">Medlemstyp</label><select id="cfUntypedSel" class="form-select">'
                + opts.map(function (t) { return '<option value="' + esc(t.key) + '"' + (/^senior$/i.test(t.key) ? ' selected' : '') + '>' + esc(t.name) + '</option>'; }).join('')
                + '</select>',
            onOk: async function () {
                var to = $('cfUntypedSel').value;
                var d = await form('SetMembersType', { clubId: CLUB_ID, year: year(), toKey: to, fromUntyped: '1' });
                if (!d.success) return d.message || 'Medlemstypen kunde inte sättas.';
                var n = d.data && d.data.changed;
                await load();
                msg(true, (n === 1 ? '1 medlem fick' : n + ' medlemmar fick') + ' medlemstypen ' + typeName(to) + '.');
                return null;
            } });
    });

    // ── Åldersförslag ───────────────────────────────────────────────────────────────────
    var ageCur = null, ageAll = {}, ageResult = null, ageNames = {}, ageSeq = 0, CAP = 15;
    async function fetchAge() {
        try {
            var d = await (await fetch(F + 'GetAgeProposals?clubId=' + CLUB_ID + '&year=' + year(), { cache: 'no-store' })).json();
            return d && d.success ? d : null;
        } catch (e) { return null; }
    }
    function ageProposalCount(d) { return (d.rows || []).filter(function (r) { return (r.kind === 'Change' || r.kind === 'Untyped') && r.toKey; }).length; }
    // Antalet i menyn (och för läsrollerna en länk). Går det inte att räkna visas ingenting.
    async function refreshAgeCount() {
        var li = $('cfAgeItemLi'), link = $('cfAgeLink');
        if (!ageRules.enabled) { show(li, false); show(link, false); return; }
        var mine = ++ageSeq, d = await fetchAge();
        if (mine !== ageSeq) return;
        if (!d || !d.enabled) { show(li, false); show(link, false); return; }
        var n = ageProposalCount(d);
        if (li) { show(li, true); $('cfAgeItem').querySelector('span').textContent = 'Åldersförslag' + (n ? ' (' + n + ')' : '') + '…'; }
        if (link) { show(link, n > 0); $('cfAgeLinkBtn').textContent = n + (n === 1 ? ' medlem har ett förslag på ny medlemstyp efter ålder' : ' medlemmar har förslag på ny medlemstyp efter ålder') + ' — visa'; }
    }
    if ($('cfAgeItem')) $('cfAgeItem').addEventListener('click', function () { openAge(); });
    if ($('cfAgeLinkBtn')) $('cfAgeLinkBtn').addEventListener('click', function () { openAge(); });

    async function openAge() {
        ageResult = null; ageAll = {};
        $('cfAgeTitle').textContent = 'Åldersförslag ' + year();
        $('cfAgeBody').innerHTML = '<p class="text-muted mb-0">Räknar…</p>';
        if ($('cfAgeApply')) { $('cfAgeApply').disabled = true; $('cfAgeApply').textContent = 'Godkänn valda'; }
        showModal('cfAgeModal');
        await reloadAge();
    }
    async function reloadAge() { ageCur = await fetchAge(); renderAge(); }

    function feeDelta(r) {
        if (r.noCategory) return '<span class="text-danger">Klubben har ingen avgift för ' + esc(r.toName) + ' ' + year() + ' — lägg till den först.</span>';
        if (r.feeBefore == null || r.feeAfter == null) return '';
        var d = r.feeAfter - r.feeBefore;
        if (Math.abs(d) < 0.005) return 'Avgiften blir oförändrad (' + kr(r.feeAfter) + ')';
        return (d > 0 ? '↑ +' : '↓ −') + kr(Math.abs(d)) + ' (' + kr(r.feeBefore) + ' → ' + kr(r.feeAfter) + ')';
    }
    function ageMenu(act, label, id) {
        return '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" '
             + 'data-bs-popper-config=\'{"strategy":"fixed"}\'>Åtgärder</button><ul class="dropdown-menu dropdown-menu-end"><li><button type="button" class="dropdown-item" '
             + 'data-cf-age-act="' + act + '" data-cf-age-id="' + id + '">' + label + '</button></li></ul></div>';
    }
    function section(kind, title, hint, rows, build) {
        if (!rows.length) return '';
        var shown = ageAll[kind] ? rows : rows.slice(0, CAP);
        return '<h6 class="mt-3 mb-1">' + title + ' <span class="text-muted fw-normal">(' + rows.length + ')</span></h6>'
            + (hint ? '<p class="small text-muted mb-2">' + hint + '</p>' : '')
            + '<div class="table-responsive"><table class="table table-sm align-middle mb-1"><tbody>' + shown.map(build).join('') + '</tbody></table></div>'
            + (rows.length > shown.length ? '<button type="button" class="btn btn-link btn-sm p-0" data-cf-age-all="' + kind + '">Visa alla ' + rows.length + '</button>' : '');
    }
    function resultHtml() {
        var r = ageResult;
        if (r.error) return '<div class="alert alert-danger">' + esc(r.error) + '</div>';
        var h = '';
        if (r.undone != null) h += '<div class="alert alert-secondary">Ångrade ' + r.undone + (r.undone === 1 ? ' byte.' : ' byten.') + '</div>';
        else {
            h += '<div class="alert alert-success"><div>' + r.applied + (r.applied === 1 ? ' medlem fick ny medlemstyp.' : ' medlemmar fick ny medlemstyp.')
               + (r.cleared ? ' ' + r.cleared + (r.cleared === 1 ? ' oskickad avgift räknas om' : ' oskickade avgifter räknas om') + ' vid utskicket.' : '') + '</div>'
               + '<div class="small mt-1">Redan skickade eller betalda avgifter behåller sin typ och sitt belopp — bytet gäller först nästa avgift.</div>'
               + (r.ids.length && !READONLY ? '<button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-cf-age-undo="1">Ångra</button>' : '') + '</div>';
        }
        if ((r.skipped || []).length)
            h += '<div class="alert alert-warning small"><strong>Hoppades över:</strong><ul class="mb-0">' + r.skipped.map(function (s) {
                return '<li>' + esc(ageNames[s.memberId] || ('Medlem ' + s.memberId)) + ' — ' + esc(s.reason) + '</li>'; }).join('') + '</ul></div>';
        return h;
    }
    function renderAge() {
        var h = ageResult ? resultHtml() : '';
        if (!ageCur) h += '<div class="alert alert-danger mb-0">Förslagslistan kunde inte räknas fram. Försök igen om en stund.</div>';
        else if (!ageCur.enabled) {
            h += '<p class="mb-0">Ingen åldersgräns är satt, så det finns inga förslag. '
               + (READONLY ? '' : '<button type="button" class="btn btn-link btn-sm p-0 align-baseline" data-cf-open-types="1">Ange åldersgränser</button>') + '</p>';
        } else {
            var rows = ageCur.rows || [];
            rows.forEach(function (r) { ageNames[r.memberId] = r.name; });
            var can = !READONLY && ageCur.canApply;
            h += '<p class="small text-muted">Åldern räknas som avgiftsåret ' + ageCur.year + ' minus födelseåret. Inget byts förrän ' + (READONLY ? 'kassören godkänner' : 'du godkänner')
               + ' — och typen ändras aldrig av sig själv.'
               + (ageCur.canApply ? '' : ' Avgiftsår före innevarande år går att läsa men inte godkänna.') + '</p>';
            var by = function (k) { return rows.filter(function (r) { return r.kind === k; }); };
            var change = by('Change'), untypedRows = by('Untyped'), cannot = by('CannotPlace'), house = by('Household'), kept = by('Kept');
            var rowCheck = function (r, checked) {
                var ok = can && !r.noCategory && r.toKey;
                return '<td style="width:2rem">' + (can ? '<input class="form-check-input" type="checkbox" data-cf-age-sel="' + r.memberId + ':' + esc(r.fromKey) + '"'
                    + (checked && ok ? ' checked' : '') + (ok ? '' : ' disabled') + ' aria-label="Välj ' + esc(r.name) + '">' : '') + '</td>';
            };
            var line = function (r) {
                return '<td>' + esc(r.name) + '<div class="small text-muted">' + esc(r.fromName || 'ingen typ') + ' → <strong>' + esc(r.toName) + '</strong>'
                     + (r.age != null ? ' · ' + r.age + ' år' : '') + '</div><div class="small text-muted">' + feeDelta(r) + '</div></td>';
            };
            h += section('Change', 'Byter medlemstyp', 'Förbockade rader byts när du godkänner.', change, function (r) {
                return '<tr>' + rowCheck(r, true) + line(r) + '<td class="text-end">' + (can ? ageMenu('keep', 'Behåll typen', r.memberId) : '') + '</td></tr>'; });
            h += section('Untyped', 'Saknar medlemstyp — förslag efter ålder', 'En gissning efter ålder, därför inte förbockad.', untypedRows, function (r) {
                return '<tr>' + rowCheck(r, false) + line(r) + '<td></td></tr>'; });
            h += section('CannotPlace', 'Kan inte placeras', 'Inget byts för dessa. ' + (CLUB_URL ? '<a href="' + esc(CLUB_URL) + '#clubAdmin/members">Komplettera personnummer under Medlemmar</a> eller importera födelsedatum.' : 'Komplettera personnummer under Medlemmar.'),
                cannot, function (r) { return '<tr><td>' + esc(r.name) + '<div class="small text-muted">' + esc(r.reason || '') + '</div></td></tr>'; });
            h += section('Household', 'Ingår i ett familjemedlemskap', 'Rörs aldrig här — bara information.', house, function (r) {
                return '<tr><td>' + esc(r.name) + (r.reason ? '<div class="small text-muted">' + esc(r.reason) + '</div>' : '') + '</td></tr>'; });
            if (kept.length) {
                h += '<details class="mt-3 text-muted"><summary class="small">Behåller sin typ (' + kept.length + ')</summary>'
                   + '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><tbody>' + kept.map(function (r) {
                        return '<tr><td>' + esc(r.name) + '<div class="small">Behåller ' + esc(r.fromName || 'ingen typ') + '</div></td><td class="text-end">'
                             + (can ? ageMenu('unlock', 'Lås upp', r.memberId) : '') + '</td></tr>'; }).join('') + '</tbody></table></div></details>';
            }
            if (!change.length && !untypedRows.length && !cannot.length && !house.length && !kept.length)
                h += '<p class="mb-0">Alla medlemmar har redan rätt medlemstyp för sin ålder.</p>';
        }
        $('cfAgeBody').innerHTML = h;
        updateApply();
    }
    function updateApply() {
        var b = $('cfAgeApply'); if (!b) return;
        var n = $('cfAgeBody').querySelectorAll('[data-cf-age-sel]:checked').length;
        b.disabled = n === 0;
        b.textContent = n ? 'Godkänn valda (' + n + ')' : 'Godkänn valda';
    }
    $('cfAgeModal').addEventListener('change', function (ev) { if (ev.target.closest('[data-cf-age-sel]')) updateApply(); });
    $('cfAgeModal').addEventListener('click', async function (ev) {
        var t;
        if ((t = ev.target.closest('[data-cf-age-all]'))) { ageAll[t.getAttribute('data-cf-age-all')] = true; renderAge(); return; }
        if (ev.target.closest('[data-cf-open-types]')) { openTypes('cfAgeModal'); return; }
        if ((t = ev.target.closest('[data-cf-age-act]'))) {
            var keep = t.getAttribute('data-cf-age-act') === 'keep';
            var d = await form('SetAgeRuleOptOut', { clubId: CLUB_ID, year: year(), memberId: t.getAttribute('data-cf-age-id'), keep: keep ? '1' : '0' });
            ageResult = d.success ? null : { error: d.message || 'Det gick inte att spara.' };
            await reloadAge(); refreshAgeCount();
            return;
        }
        if (ev.target.closest('[data-cf-age-undo]')) {
            var ids = (ageResult && ageResult.ids) || [];
            var u = await form('UndoAgeProposals', { clubId: CLUB_ID, year: year(), memberIds: ids.map(String) });
            ageResult = u.success ? { undone: u.undone, skipped: u.skipped } : { error: u.message || 'Det gick inte att ångra.' };
            await reloadAge(); load();
            return;
        }
    });
    if ($('cfAgeApply')) $('cfAgeApply').addEventListener('click', async function () {
        var items = Array.prototype.map.call($('cfAgeBody').querySelectorAll('[data-cf-age-sel]:checked'), function (b) { return b.getAttribute('data-cf-age-sel'); });
        if (!items.length) return;
        this.disabled = true;
        var d = await form('ApplyAgeProposals', { clubId: CLUB_ID, year: year(), items: items });
        if (!d.success) ageResult = { error: d.message || 'Typbytena kunde inte godkännas.' };
        else {
            var skipped = d.skipped || [], skippedIds = skipped.map(function (s) { return s.memberId; });
            var ids = items.map(function (i) { return parseInt(i.split(':')[0], 10); }).filter(function (id) { return skippedIds.indexOf(id) < 0; });
            ageResult = { applied: d.applied, skipped: skipped, ids: ids, cleared: d.chargesCleared };
        }
        await reloadAge(); load();
    });

    // ⚠️ Beskedet säger vad som FAKTISKT hände.
    function report(s) {
        if (!s || !s.success) { msg(false, 'Mejlen gick inte att skicka. ' + ((s && s.message) || '')); return; }
        var parts = [s.sent + (s.sent === 1 ? ' medlem fick' : ' medlemmar fick') + ' ett mejl.'];
        var missed = (s.noEmail || []).concat(s.failed || []);
        if (missed.length > 0) parts.push('Inget mejl gick till ' + missed.join(', ') + '. Välj Åtgärder → Kopiera betallänk på raden och skicka länken själv.');
        msg(true, parts.join(' '), missed.length > 0 ? 'warn' : 'ok');
    }

    var now = new Date().getFullYear();
    for (var y = now + 1; y >= now - 3; y--) {
        var o = document.createElement('option');
        o.value = y; o.textContent = y; if (y === now) o.selected = true;
        $('cfYear').appendChild(o);
    }
    $('cfYear').addEventListener('change', function () { msg(true, ''); load(); });

    // Laddas lat när ekonomisidans rälspost öppnas.
    window.hpskLoadClubFees = load;
})();
</script>
