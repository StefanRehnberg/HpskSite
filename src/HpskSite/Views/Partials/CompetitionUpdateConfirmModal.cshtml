<!-- Update Registration Confirmation Modal -->
<div class="modal fade" id="updateRegistrationConfirmModal" tabindex="-1" aria-labelledby="updateRegistrationConfirmModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-warning text-dark">
				<h5 class="modal-title" id="updateRegistrationConfirmModalLabel">
					<i class="bi bi-exclamation-triangle"></i> Uppdatera anmälan?
				</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<p id="updateRegistrationMessage">
					Du har redan en anmälan till denna tävling. Vill du uppdatera den?
				</p>
				<div class="alert alert-info mb-0">
					<small><i class="bi bi-info-circle"></i> Om du fortsätter ersätts din befintliga anmälan med de val som visas i formuläret.</small>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="cancelUpdateBtn">
					<i class="bi bi-x-circle"></i> Avbryt
				</button>
				<button type="button" class="btn btn-warning" id="confirmUpdateBtn">
					<i class="bi bi-arrow-repeat"></i> Uppdatera
				</button>
			</div>
		</div>
	</div>
</div>
