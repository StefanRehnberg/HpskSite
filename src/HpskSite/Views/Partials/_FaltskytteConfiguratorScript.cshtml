<script>
// Station Configurator State
let faltCfgData = {}; // { "C": { stations: [...] }, "A": { ... } }
let faltCfgWeaponClasses = ["C"]; // Active weapon classes
let faltCfgActiveTab = "C";
let faltCfgStationCount = 8;
let faltCfgExpandedStation = null; // Track which station card is open. Null = all collapsed initially.
let faltCfgDirtyStations = new Set(); // Stations with unsaved changes
let faltCfgLinkedGroups = []; // e.g. [["A","R"], ["B","C"]] — linked weapon classes share configs
let faltCfgMode = "advanced"; // "simple" | "advanced". Simple = shared shape + per-class param matrix.
let faltCfgSimpleDistanceClass = null; // simple-mode picker: which class's distance the sliders edit
let faltCfgMorker = false; // competition-level mörkerfältskjutning flag
const faltCfgScoringMode = () => document.getElementById('wizard_scoringMode')?.value || 'Normal';

// Reserved metadata keys stored in faltCfgData alongside weapon classes. When iterating
// weapon-class entries, skip these. Add new keys here (with leading underscore) instead
// of polluting the iteration sites.
const FALT_CFG_META_KEYS = new Set(['_linkedGroups', '_mode', '_morker', '_attachedConfigId']);
function faltCfgIsMetaKey(k) { return FALT_CFG_META_KEYS.has(k); }

// Scale a figure's four timing fields by `ratio`, in place. Same clamp
// pattern the advanced-mode "Kopiera från … Δsek" copy uses.
function faltCfgScaleFigureTimings(fig, ratio) {
    if (!fig || ratio === 1) return;
    if (fig.delayBeforeShowSec) fig.delayBeforeShowSec = Math.max(0, Math.round(fig.delayBeforeShowSec * ratio));
    if (fig.showTimeSec)        fig.showTimeSec        = Math.max(1, Math.round(fig.showTimeSec        * ratio));
    if (fig.hideAfterSec)       fig.hideAfterSec       = Math.max(1, Math.round(fig.hideAfterSec       * ratio));
    if (fig.reappearSec)        fig.reappearSec        = Math.max(0, Math.round(fig.reappearSec        * ratio));
}

// Mirror SHAPE (target groups + figures, including images / descriptions /
// behavior) from srcWc to all other weapon classes. Timing fields scale
// proportionally to each destination class's shootingTimeSec relative to
// the source — so a 30s canonical with an 8s show window becomes ~6s in a
// 22s class. Per-class params (shootingTimeSec, positions, support hand,
// max shots) live on the destination station object and stay untouched.
function faltCfgSyncShape(srcWc) {
    var src = faltCfgData[srcWc];
    if (!src || !src.stations) return;
    faltCfgWeaponClasses.forEach(function (wc) {
        if (wc === srcWc) return;
        if (!faltCfgData[wc]) faltCfgData[wc] = { stations: [] };
        var srcStations = src.stations;
        var destStations = faltCfgData[wc].stations || [];
        // Make sure dest has the same number of stations as src
        while (destStations.length < srcStations.length) {
            destStations.push(createDefaultStation(destStations.length + 1));
        }
        srcStations.forEach(function (srcSt, i) {
            var destSt = destStations[i];
            destSt.station = srcSt.station;
            // Distance is a per-class param (like shootingTimeSec). Capture it
            // before the shape overwrite so each class keeps its own slider value.
            var savedDistances = (destSt.targetGroups || []).map(function(tg) { return tg.distance; });
            destSt.targetGroups = JSON.parse(JSON.stringify(srcSt.targetGroups || []));
            destSt.targetGroups.forEach(function(tg, gi) {
                if (gi < savedDistances.length && savedDistances[gi] != null) tg.distance = savedDistances[gi];
            });
            // Scale timings into dest's shootingTimeSec budget. Skip the walk
            // when times match exactly to avoid pointless rounding drift.
            var srcTime = srcSt.shootingTimeSec || 30;
            var destTime = destSt.shootingTimeSec || srcTime;
            if (srcTime > 0 && destTime > 0 && srcTime !== destTime) {
                var ratio = destTime / srcTime;
                destSt.targetGroups.forEach(function (tg) {
                    (tg.figures || []).forEach(function (fig) {
                        faltCfgScaleFigureTimings(fig, ratio);
                    });
                });
            }
        });
        if (destStations.length > srcStations.length) destStations.length = srcStations.length;
        faltCfgData[wc].stations = destStations;
    });
}

// Structural equality: two stations have the same target groups, figures,
// images, descriptions, and behaviors. Per-class params (Skjuttid, positions,
// max shots) AND figure timings (delay/show/hide/reappear) are intentionally
// ignored — both are allowed to differ per class in simple mode (timings get
// scaled proportionally by faltCfgSyncShape).
function faltCfgShapeEqual(a, b) {
    if (!a || !b) return false;
    var ga = a.targetGroups || [], gb = b.targetGroups || [];
    if (ga.length !== gb.length) return false;
    for (var g = 0; g < ga.length; g++) {
        var tga = ga[g], tgb = gb[g];
        if ((tga.imageUrl || '') !== (tgb.imageUrl || '')) return false;
        if ((tga.description || '') !== (tgb.description || '')) return false;
        var fa = tga.figures || [], fb = tgb.figures || [];
        if (fa.length !== fb.length) return false;
        for (var i = 0; i < fa.length; i++) {
            var x = fa[i], y = fb[i];
            if (!!x.isPoangmal !== !!y.isPoangmal) return false;
            if ((x.behavior || 'Fast') !== (y.behavior || 'Fast')) return false;
            if ((x.targetName || '') !== (y.targetName || '')) return false;
            if ((x.targetColor || '') !== (y.targetColor || '')) return false;
            if ((x.imageUrl || '') !== (y.imageUrl || '')) return false;
            if ((x.targetsPerFigure || 1) !== (y.targetsPerFigure || 1)) return false;
        }
    }
    return true;
}

// Returns true if every weapon class has the same shape per station (Skjuttid etc. may
// still differ). When false, switching to simple mode is a destructive merge that needs
// confirmation.
function faltCfgAllClassesShareShape() {
    var classes = faltCfgWeaponClasses;
    if (classes.length <= 1) return true;
    var first = faltCfgData[classes[0]];
    if (!first || !first.stations) return true;
    for (var i = 1; i < classes.length; i++) {
        var other = faltCfgData[classes[i]];
        if (!other || !other.stations) return false;
        if (first.stations.length !== other.stations.length) return false;
        for (var s = 0; s < first.stations.length; s++) {
            if (!faltCfgShapeEqual(first.stations[s], other.stations[s])) return false;
        }
    }
    return true;
}

// Toggle visibility of advanced-mode chrome (tabs + link/copy controls) and the simple-
// mode info banner. Called on mode change and after open.
function faltCfgRenderModeChrome() {
    var tabsEl = document.getElementById('faltCfgWeaponTabs');
    var linkCopyEl = document.getElementById('faltCfgLinkAndCopyControls');
    var simpleNote = document.getElementById('faltCfgSimpleNote');
    var advancedNote = document.getElementById('faltCfgAdvancedNote');
    var simpleLinkBtn = document.getElementById('faltCfgSimpleLinkButton');
    var simpleRadio = document.getElementById('faltCfgMode_simple');
    var advancedRadio = document.getElementById('faltCfgMode_advanced');

    if (faltCfgMode === 'simple') {
        if (tabsEl) tabsEl.style.display = 'none';
        if (linkCopyEl) linkCopyEl.style.display = 'none';
        if (simpleNote) simpleNote.style.display = '';
        if (advancedNote) advancedNote.style.display = 'none';
        if (simpleLinkBtn) simpleLinkBtn.style.display = '';
        if (simpleRadio) simpleRadio.checked = true;
    } else {
        if (tabsEl) tabsEl.style.display = '';
        if (linkCopyEl) linkCopyEl.style.display = '';
        if (simpleNote) simpleNote.style.display = 'none';
        if (advancedNote) advancedNote.style.display = '';
        if (simpleLinkBtn) simpleLinkBtn.style.display = 'none';
        if (advancedRadio) advancedRadio.checked = true;
    }
}

// Returns the linked group array that contains wc, or null
function faltCfgGetLinkedGroup(wc) {
    return faltCfgLinkedGroups.find(function(g) { return g.indexOf(wc) >= 0; }) || null;
}

// Returns the display label for a tab (e.g. "A, R" if linked)
function faltCfgTabLabel(wc) {
    var grp = faltCfgGetLinkedGroup(wc);
    return grp ? grp.join(', ') : wc;
}

// Propagate data from wc to all its linked siblings
function faltCfgSyncLinked(wc) {
    var grp = faltCfgGetLinkedGroup(wc);
    if (!grp) return;
    var src = JSON.stringify(faltCfgData[wc]);
    grp.forEach(function(other) {
        if (other !== wc) faltCfgData[other] = JSON.parse(src);
    });
}

const SHOOTER_POSITIONS = ["Stående", "Knästående", "Sittande", "Liggande", "Valfri"];
const WEAPON_POSITIONS = ["45 grader", "Riktning tillåten"];
const SUPPORT_HAND = ["Ej stödhand", "Stödhand tillåten"];
const TARGET_BEHAVIORS = ["Fast", "Framsvängande", "Bortsvängande", "Rörligt"];

// ─── SHB shoot-time suggestion ──────────────────────────────────────
// Max distance per (sizeGroup, SHB weapon-diagram). Lines in diagrams 1-3
// (SHB 2026 pp. 120-122) all pass through origin; max distance corresponds
// to the diagram's max time/shot (AR=2,0 s, B=1,75 s, C=1,5 s).
// Values verified against SHB pp. 100-109 (Fältskyttefigurer).
const SHB_MAX_DISTANCES = {
    0:  { AR: 80, B: 90, C: 100 },
    1:  { AR: 70, B: 80, C: 90 },
    2:  { AR: 60, B: 65, C: 75 },
    3:  { AR: 50, B: 55, C: 65 },
    4:  { AR: 45, B: 50, C: 55 },
    5:  { AR: 40, B: 45, C: 50 },
    6:  { AR: 35, B: 40, C: 45 },
    7:  { AR: 30, B: 35, C: 40 },
    8:  { AR: 27, B: 32, C: 36 },
    9:  { AR: 24, B: 27, C: 30 },
    10: { AR: 20, B: 22, C: 25 },
    11: { AR: 16, B: 18, C: 20 },
    12: { AR: 14, B: 16, C: 18 },
    13: { AR: 12, B: 14, C: 16 },
    14: { AR: 7,  B: 8,  C: 9  }
    // SizeGroup 15 is reserved (no SHB row); treated as "unset" → no bound.
};
const SHB_MAX_TIME_PER_SHOT = { AR: 2.0, B: 1.75, C: 1.5 };
const SHB_TILLAGG_WEAPON_45 = 2;     // Vapenläge 45 grader → +2 sek
const SHB_TILLAGG_OMRIKTNING = 2;    // per omriktning mellan målgrupper (n-1)
const SHB_MORKER_MULTIPLIER = 1.30;  // Mörkerfältskjutning → +30 % på total
const SLIDER_MIN_DISTANCE = 5;       // m — practical floor regardless of figurgrupp
const FALT_STATION_SHOTS = 6;        // SHB-konvention: alltid 6 skott per fältskyttestation

// Maps any weapon-class code (A, A_Opt, A_M, A_P, A_G, B, C, R) to the SHB
// diagram bucket (AR / B / C). All A-family + R share Diagram 1.
function faltShbBucket(wc) {
    if (!wc) return 'AR';
    if (wc === 'B') return 'B';
    if (wc === 'C') return 'C';
    return 'AR';
}

// Max shooting distance (m) for a figure given its sizeGroup + the weapon
// class. Returns null when sizeGroup is unset (0 with no figure picked yet)
// or outside the SHB table.
function faltFigureMaxDistance(sizeGroup, wc) {
    if (sizeGroup == null) return null;
    var row = SHB_MAX_DISTANCES[sizeGroup];
    if (!row) return null;
    return row[faltShbBucket(wc)] || null;
}

// Distance bounds for a målgrupp = {min: 5, max: tightest figure max}.
// Returns null when no figure has a usable sizeGroup yet.
function faltTargetGroupBounds(tg, wc) {
    var figs = (tg && tg.figures) || [];
    var maxes = [];
    for (var i = 0; i < figs.length; i++) {
        // Skip figures with no picked target or sizeGroup 0 (treated as "not set").
        var sg = figs[i].sizeGroup;
        if (sg == null || sg === 0) continue;
        var m = faltFigureMaxDistance(sg, wc);
        if (m != null) maxes.push(m);
    }
    if (maxes.length === 0) return null;
    return { min: SLIDER_MIN_DISTANCE, max: Math.min.apply(null, maxes) };
}

// Computes SHB-suggested skjuttid for a station for one weapon class.
// SHB fältskytte = 6 skott per station, fördelas av skytten på målgrupper.
// Värsta fall: alla 6 skott på den mest krävande figuren. Den figurens
// per-skott-tid sätter därför skjuttidsgrunden:
//
//     grund = 6 × max över alla figurer av (D / maxD × maxTime)
//
// där D är respektive målgrupps avstånd och maxD beror på figurens
// storleksgrupp + vapengrupp (SHB diagram 1–3, pp 120–122).
//
// Returns { totalSec, breakdown: [{label, sec, info?}] } or null when no
// figure in any målgrupp has a usable sizeGroup (suggestion not applicable).
function faltSuggestShootingTime(station, wc, morker) {
    if (!station || !station.targetGroups || station.targetGroups.length === 0) return null;
    var bucket = faltShbBucket(wc);
    var maxTime = SHB_MAX_TIME_PER_SHOT[bucket];
    var lines = [];
    var anyApplicable = false;
    var worstPerShot = 0;
    var worstLabel = '';

    // Informational per-målgrupp lines + global max per-shot scan.
    station.targetGroups.forEach(function(tg, gi) {
        var letter = String.fromCharCode(65 + gi); // A, B, C, ...
        // Effective distance = stored value if set, otherwise the slider's default
        // (tightest figure max). Same fallback the UI shows, so the breakdown agrees
        // with the slider position before the operator touches it.
        var bounds = faltTargetGroupBounds(tg, wc);
        var effectiveDistance = tg.distance != null ? tg.distance : (bounds ? bounds.max : null);
        var groupPerShot = 0;
        var groupLimitingFig = '';
        (tg.figures || []).forEach(function(f) {
            if (!f.sizeGroup) return;
            var maxD = faltFigureMaxDistance(f.sizeGroup, wc);
            if (!maxD) return;
            anyApplicable = true;
            var d = effectiveDistance != null ? effectiveDistance : maxD;
            var t = (d / maxD) * maxTime;
            if (t > groupPerShot) { groupPerShot = t; groupLimitingFig = 'storleksgrupp ' + f.sizeGroup; }
            if (t > worstPerShot) { worstPerShot = t; worstLabel = 'Målgrupp ' + letter + ', storleksgrupp ' + f.sizeGroup + ' @@ ' + d + ' m'; }
        });
        if (groupPerShot === 0) {
            lines.push({ label: 'Målgrupp ' + letter + ' — storleksgrupp saknas', sec: 0 });
        } else {
            lines.push({
                label: 'Målgrupp ' + letter + ' (' + (effectiveDistance != null ? effectiveDistance : '?') + ' m, ' + groupLimitingFig + ')',
                sec: 0,
                info: groupPerShot.toFixed(2).replace('.', ',') + ' sek/skott (info)'
            });
        }
    });

    if (!anyApplicable) return null;

    var grund = Math.ceil(FALT_STATION_SHOTS * worstPerShot);
    var sumSec = grund;
    lines.push({
        label: FALT_STATION_SHOTS + ' skott × ' + worstPerShot.toFixed(2).replace('.', ',') + ' sek/skott (' + worstLabel + ')',
        sec: grund
    });

    if (station.weaponStartPosition === '45 grader') {
        sumSec += SHB_TILLAGG_WEAPON_45;
        lines.push({ label: 'Vapenläge 45 grader', sec: SHB_TILLAGG_WEAPON_45 });
    }
    var omriktningCount = Math.max(0, station.targetGroups.length - 1);
    if (omriktningCount > 0) {
        var omr = omriktningCount * SHB_TILLAGG_OMRIKTNING;
        sumSec += omr;
        lines.push({ label: 'Omriktning mellan målgrupper (×' + omriktningCount + ')', sec: omr });
    }
    if (morker) {
        var morkerExtra = Math.ceil(sumSec * SHB_MORKER_MULTIPLIER) - sumSec;
        sumSec += morkerExtra;
        lines.push({ label: 'Mörker-tillägg (+30 %)', sec: morkerExtra });
    }
    return { totalSec: sumSec, breakdown: lines };
}

// ─── Model-update helpers ───────────────────────────────────────────
// Every form control calls one of these on change. The model is always current.

function faltCfgMarkDirty(wc, stationNum) {
    if (faltCfgMode === 'simple') {
        // Order matters: faltCfgSyncLinked first so any linked siblings of wc
        // pick up its updated per-class params (Skjuttid, positions, …);
        // faltCfgSyncShape then re-derives every non-canonical class's shape +
        // scaled timings against canonical's now-correct shootingTimeSec.
        var canonical = faltCfgGetCanonicalClass();
        faltCfgSyncLinked(wc);
        faltCfgSyncShape(canonical);
        faltCfgWeaponClasses.forEach(function (c) {
            faltCfgDirtyStations.add(c + '_' + stationNum);
        });
        var ds = document.getElementById('faltCfgSimpleDirty_' + stationNum);
        var ss = document.getElementById('faltCfgSimpleSaved_' + stationNum);
        if (ds) ds.style.display = '';
        if (ss) ss.style.display = 'none';
        return;
    }
    // Sync linked classes and mark them all dirty
    faltCfgSyncLinked(wc);
    var grp = faltCfgGetLinkedGroup(wc);
    var classes = grp || [wc];
    classes.forEach(function(c) {
        faltCfgDirtyStations.add(c + '_' + stationNum);
    });
    var d = document.getElementById('faltCfgDirty_' + wc + '_' + stationNum);
    var s = document.getElementById('faltCfgSaved_' + wc + '_' + stationNum);
    if (d) d.style.display = '';
    if (s) s.style.display = 'none';
}

function faltCfgUpdateStation(wc, stationNum, field, value) {
    var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
    if (!station) return;
    // Simple mode: editing this class's shootingTimeSec re-fits its moving-
    // figure timings to the new total. Without it, dropping a class from 25 →
    // 20 sek would leave 8s show windows in a 20s budget. Advanced mode skips
    // this — the operator has the explicit "Kopiera från … Δsek" button when
    // they want proportional scaling.
    if (field === 'shootingTimeSec' && faltCfgMode === 'simple') {
        var oldVal = station.shootingTimeSec || 0;
        var newVal = value || 0;
        if (oldVal > 0 && newVal > 0 && oldVal !== newVal) {
            var ratio = newVal / oldVal;
            (station.targetGroups || []).forEach(function (tg) {
                (tg.figures || []).forEach(function (fig) {
                    faltCfgScaleFigureTimings(fig, ratio);
                });
            });
        }
    }
    station[field] = value;
    // "IsShootOffOnly" is a station-level decision (the same station number is
    // either a regular station or shoot-off-only for everyone). Propagate the
    // flag to every weapon class's instance of this station number so the
    // filter behaves consistently regardless of which class's row was edited.
    if (field === 'isShootOffOnly') {
        Object.keys(faltCfgData).forEach(function(otherWc) {
            if (otherWc === wc) return;
            var other = faltCfgData[otherWc]?.stations?.find(function(s) { return s.station === stationNum; });
            if (other) { other.isShootOffOnly = value; faltCfgMarkDirty(otherWc, stationNum); }
        });
    }
    faltCfgMarkDirty(wc, stationNum);
    // weaponStartPosition feeds into the suggested-skjuttid calc (+2 sek for
    // "45 grader"). Refresh the Föreslaget badge live so the operator sees the
    // change without re-opening the station card.
    if (field === 'weaponStartPosition') faltCfgRefreshSuggestion(stationNum);
}

function faltCfgUpdateGroup(wc, stationNum, tgIdx, field, value) {
    var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
    if (station && station.targetGroups[tgIdx]) { station.targetGroups[tgIdx][field] = value; faltCfgMarkDirty(wc, stationNum); }
}

function faltCfgUpdateFigure(wc, stationNum, tgIdx, fIdx, field, value) {
    var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
    var fig = station?.targetGroups[tgIdx]?.figures[fIdx];
    if (fig) { fig[field] = value; faltCfgMarkDirty(wc, stationNum); }
}

// ─── Initialization ─────────────────────────────────────────────────

function faltCfgOpen(weaponClasses, existingConfig) {
    faltCfgWeaponClasses = weaponClasses || ["C"];
    faltCfgData = existingConfig || {};
    faltCfgDirtyStations = new Set();

    // Handle wrapped format from server: { WeaponConfigs: { C: {...} } } or { weaponConfigs: { C: {...} } }
    if (faltCfgData.WeaponConfigs || faltCfgData.weaponConfigs) {
        var wc = faltCfgData.WeaponConfigs || faltCfgData.weaponConfigs;
        var linked = faltCfgData._linkedGroups;
        var mode = faltCfgData._mode;
        var morker = faltCfgData._morker;
        faltCfgData = {};
        Object.keys(wc).forEach(function(k) { faltCfgData[k] = wc[k]; });
        if (linked) faltCfgData._linkedGroups = linked;
        if (mode) faltCfgData._mode = mode;
        if (morker) faltCfgData._morker = morker;
    }

    faltCfgLinkedGroups = faltCfgData._linkedGroups || [];
    faltCfgMode = faltCfgData._mode === 'simple' ? 'simple' : 'advanced';
    faltCfgMorker = !!faltCfgData._morker;
    var morkerEl = document.getElementById('faltCfg_morker');
    if (morkerEl) morkerEl.checked = faltCfgMorker;
    faltCfgStationCount = parseInt(document.getElementById('faltCfg_stationCount').value) || 8;

    // Detect station count from existing config (handle both camelCase and PascalCase)
    for (const wc of Object.keys(faltCfgData)) {
        if (faltCfgIsMetaKey(wc)) continue;
        var st = faltCfgData[wc]?.stations || faltCfgData[wc]?.Stations;
        if (st?.length > 0) {
            faltCfgStationCount = st.length;
            document.getElementById('faltCfg_stationCount').value = faltCfgStationCount;
            break;
        }
    }

    // Ensure each weapon class has a config
    faltCfgWeaponClasses.forEach(wc => {
        if (!faltCfgData[wc]) faltCfgData[wc] = { stations: [] };
        ensureStations(wc);
    });

    buildTabs();
    faltCfgActiveTab = faltCfgGetVisibleTabs()[0] || faltCfgWeaponClasses[0];
    faltCfgUpdateLinkButtons();
    faltCfgRenderModeChrome();
    renderActiveTab();

    // Only the legacy in-competition surface mounts faltStationConfigModal.
    // The standalone /faltkonfig editor renders the configurator inline, so the
    // element is absent — skip the show() call to avoid a Bootstrap NRE.
    var legacyModalEl = document.getElementById('faltStationConfigModal');
    if (legacyModalEl) bootstrap.Modal.getOrCreateInstance(legacyModalEl).show();
}

// Returns the list of "visible" tab weapon classes (one per linked group, plus unlinked)
function faltCfgGetVisibleTabs() {
    var seen = new Set();
    var tabs = [];
    faltCfgWeaponClasses.forEach(function(wc) {
        if (seen.has(wc)) return;
        var grp = faltCfgGetLinkedGroup(wc);
        if (grp) {
            tabs.push(grp[0]); // first in group is the "representative"
            grp.forEach(function(g) { seen.add(g); });
        } else {
            tabs.push(wc);
            seen.add(wc);
        }
    });
    return tabs;
}

function ensureStations(wc) {
    // Handle both camelCase and PascalCase from server
    if (!faltCfgData[wc].stations && faltCfgData[wc].Stations) {
        faltCfgData[wc].stations = faltCfgData[wc].Stations;
        delete faltCfgData[wc].Stations;
    }
    const existing = faltCfgData[wc].stations || [];
    const stations = [];
    for (let i = 1; i <= faltCfgStationCount; i++) {
        const ex = existing.find(s => s.station || s.Station ? (s.station || s.Station) === i : false);
        stations.push(ex || createDefaultStation(i));
    }
    faltCfgData[wc].stations = stations;
}

function createDefaultStation(num) {
    return {
        station: num,
        shootingTimeSec: 30,
        shooterStartPosition: "Stående",
        weaponStartPosition: "45 grader",
        supportHand: "Ej stödhand",
        maxShotsPerFigure: 2,
        targetGroups: [{ group: 1, figures: [createDefaultFigure(1)] }]
    };
}

function createDefaultFigure(num) {
    return { figureNumber: num, isPoangmal: false, behavior: "Fast", sizeGroup: 0 };
}

function faltCfgUpdateStations() {
    faltCfgStationCount = parseInt(document.getElementById('faltCfg_stationCount').value) || 8;
    faltCfgWeaponClasses.forEach(wc => ensureStations(wc));
    renderActiveTab();
}

function buildTabs() {
    const tabsEl = document.getElementById('faltCfgWeaponTabs');
    const copySelect = document.getElementById('faltCfg_copySource');
    tabsEl.innerHTML = '';
    copySelect.innerHTML = '<option value="">Välj...</option>';

    var visibleTabs = faltCfgGetVisibleTabs();
    visibleTabs.forEach((wc, idx) => {
        var label = faltCfgTabLabel(wc);
        const li = document.createElement('li');
        li.className = 'nav-item';
        li.innerHTML = `<button class="nav-link ${idx === 0 ? 'active' : ''}" onclick="faltCfgSwitchTab('${wc}', this)">${label}</button>`;
        tabsEl.appendChild(li);
    });

    // Copy source: show all individual weapon classes (not grouped)
    faltCfgWeaponClasses.forEach(function(wc) {
        const opt = document.createElement('option');
        opt.value = wc;
        opt.textContent = wc;
        copySelect.appendChild(opt);
    });
}

function faltCfgSwitchTab(wc, btn) {
    faltCfgActiveTab = wc;
    document.querySelectorAll('#faltCfgWeaponTabs .nav-link').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    faltCfgUpdateLinkButtons();
    renderActiveTab();
}

function faltCfgUpdateLinkButtons() {
    var linkBtn = document.getElementById('faltCfg_linkBtn');
    var unlinkBtn = document.getElementById('faltCfg_unlinkBtn');
    var wc = faltCfgActiveTab;
    var grp = faltCfgGetLinkedGroup(wc);
    // Link button stays available as long as there are still unlinked classes to
    // add — that way an existing 2-way group (A ↔ A_Opt) can be extended to 3 or
    // more without having to unlink first. Unlink button shows whenever this tab
    // is part of any group.
    var hasUnlinkedOthers = faltCfgWeaponClasses.some(function (c) {
        return c !== wc && !faltCfgGetLinkedGroup(c);
    });
    if (linkBtn) linkBtn.style.display = hasUnlinkedOthers ? '' : 'none';
    if (unlinkBtn) unlinkBtn.style.display = grp ? '' : 'none';
}

function faltCfgLinkTab() {
    var wc = faltCfgActiveTab;
    // Build list of other unlinked weapon classes
    var others = faltCfgWeaponClasses.filter(function(c) {
        return c !== wc && !faltCfgGetLinkedGroup(c);
    });
    if (others.length === 0) { alert('Inga tillgängliga vapenklasser att länka med.'); return; }
    var choice = prompt('Länka ' + wc + ' med vilken vapenklass?\n' +
        'Tillgängliga: ' + others.join(', ') +
        '\n\nDu kan ange flera klasser separerade med komma (t.ex. "A_Opt, R").\n' +
        'De kommer dela samma konfiguration. ' + wc + ':s konfiguration används.');
    if (!choice) return;

    // Accept comma- or whitespace-separated input so the operator can link several
    // classes in one go (e.g. "A_Opt, R"). Match each entry case-insensitively
    // against the canonical list so casing typos don't bite — A_Opt is the only
    // mixed-case class so this is the realistic mistake to guard against.
    var entries = choice.split(/[,\s]+/)
        .map(function (e) { return e.trim(); })
        .filter(function (e) { return e.length > 0; });
    if (entries.length === 0) return;

    var matched = [];
    var unmatched = [];
    entries.forEach(function (e) {
        var c = others.find(function (o) { return o.toUpperCase() === e.toUpperCase(); });
        if (c) {
            if (matched.indexOf(c) < 0) matched.push(c);
        } else {
            unmatched.push(e);
        }
    });

    if (unmatched.length > 0) {
        alert('Följande vapenklasser kunde inte länkas: ' + unmatched.join(', '));
        return;
    }
    if (matched.length === 0) return;

    // Add all matched classes to wc's existing group (or create a new one).
    var existingGrp = faltCfgGetLinkedGroup(wc);
    if (existingGrp) {
        matched.forEach(function (c) { existingGrp.push(c); });
    } else {
        faltCfgLinkedGroups.push([wc].concat(matched));
    }
    // Copy wc's config to each newly-linked class so the linked tabs start in sync.
    matched.forEach(function (c) {
        faltCfgData[c] = JSON.parse(JSON.stringify(faltCfgData[wc]));
    });
    faltCfgSaveLinkedGroups();
    buildTabs();
    faltCfgUpdateLinkButtons();
    renderActiveTab();
}

function faltCfgUnlinkTab() {
    var wc = faltCfgActiveTab;
    var grp = faltCfgGetLinkedGroup(wc);
    if (!grp) return;
    if (!confirm('Avlänka ' + wc + ' från ' + grp.join(', ') + '? ' + wc + ' behåller en kopia av konfigurationen.')) return;

    // Remove wc from its group
    var idx = grp.indexOf(wc);
    if (idx >= 0) grp.splice(idx, 1);
    // If group has only 1 left, remove the group entirely
    if (grp.length <= 1) {
        faltCfgLinkedGroups = faltCfgLinkedGroups.filter(function(g) { return g.length > 1; });
    }
    faltCfgSaveLinkedGroups();
    buildTabs();
    faltCfgUpdateLinkButtons();
    renderActiveTab();
}

function faltCfgSaveLinkedGroups() {
    // Store in data so it persists with the config JSON
    if (faltCfgLinkedGroups.length > 0) {
        faltCfgData._linkedGroups = faltCfgLinkedGroups;
    } else {
        delete faltCfgData._linkedGroups;
    }
    if (faltCfgMode === 'simple') {
        faltCfgData._mode = 'simple';
    } else {
        delete faltCfgData._mode;
    }
    if (faltCfgMorker) {
        faltCfgData._morker = true;
    } else {
        delete faltCfgData._morker;
    }
}

function faltCfgCopyFrom() {
    const source = document.getElementById('faltCfg_copySource').value;
    if (!source || source === faltCfgActiveTab) return;
    var offset = parseInt(document.getElementById('faltCfg_copyTimeOffset').value) || 0;
    var label = offset ? ' med ' + (offset > 0 ? '+' : '') + offset + ' sek tidsskillnad' : '';
    if (!confirm('Kopiera all konfiguration från ' + source + ' till ' + faltCfgTabLabel(faltCfgActiveTab) + label + '? Befintlig konfiguration skrivs över.')) return;

    var copy = JSON.parse(JSON.stringify(faltCfgData[source]));
    if (offset && copy.stations) {
        copy.stations.forEach(function(st) {
            var origTime = st.shootingTimeSec || 30;
            var newTime = Math.max(1, origTime + offset);
            var ratio = origTime > 0 ? newTime / origTime : 1;
            st.shootingTimeSec = newTime;
            // Scale figure timing proportionally to the new station time
            (st.targetGroups || []).forEach(function(tg) {
                (tg.figures || []).forEach(function(fig) {
                    if (fig.delayBeforeShowSec) fig.delayBeforeShowSec = Math.max(0, Math.round(fig.delayBeforeShowSec * ratio));
                    if (fig.showTimeSec) fig.showTimeSec = Math.max(1, Math.round(fig.showTimeSec * ratio));
                    if (fig.hideAfterSec) fig.hideAfterSec = Math.max(1, Math.round(fig.hideAfterSec * ratio));
                    if (fig.reappearSec) fig.reappearSec = Math.max(0, Math.round(fig.reappearSec * ratio));
                });
            });
        });
    }
    faltCfgData[faltCfgActiveTab] = copy;
    faltCfgSyncLinked(faltCfgActiveTab);
    // Mark all stations dirty
    (copy.stations || []).forEach(function(st) { faltCfgMarkDirty(faltCfgActiveTab, st.station); });
    renderActiveTab();
}

function faltCfgCopyStation(stationNum, wc) {
    var others = faltCfgWeaponClasses.filter(function(c) { return c !== wc; });
    if (others.length === 0) return;
    var choice = prompt('Kopiera station ' + stationNum + ' från vilken vapenklass?\nTillgängliga: ' + others.join(', '));
    if (!choice) return;
    choice = choice.trim().toUpperCase();
    if (others.indexOf(choice) < 0) { alert('"' + choice + '" är inte tillgänglig.'); return; }
    var srcStation = faltCfgData[choice]?.stations?.find(function(s) { return s.station === stationNum; });
    if (!srcStation) { alert('Station ' + stationNum + ' finns inte för ' + choice + '.'); return; }
    var copy = JSON.parse(JSON.stringify(srcStation));
    var stations = faltCfgData[wc].stations;
    var idx = stations.findIndex(function(s) { return s.station === stationNum; });
    if (idx >= 0) stations[idx] = copy; else stations.push(copy);
    faltCfgMarkDirty(wc, stationNum);
    faltCfgExpandedStation = stationNum;
    renderActiveTab();
}

// ─── Rendering ──────────────────────────────────────────────────────

function renderActiveTab() {
    if (faltCfgMode === 'simple') return faltCfgRenderSimpleMode();
    const container = document.getElementById('faltCfgTabContent');
