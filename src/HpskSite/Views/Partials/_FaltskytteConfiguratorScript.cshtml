    container.innerHTML = html;

    // Track which station the user expands manually
    container.querySelectorAll('.collapse').forEach(el => {
        el.addEventListener('shown.bs.collapse', function() {
            const card = this.closest('.card[data-station]');
            if (card) faltCfgExpandedStation = parseInt(card.dataset.station);
        });
    });

    // Restore dirty/saved badge state after re-render
    stations.forEach(st => {
        const key = `${wc}_${st.station}`;
        const dirtyBadge = document.getElementById(`faltCfgDirty_${wc}_${st.station}`);
        if (faltCfgDirtyStations.has(key)) {
            if (dirtyBadge) dirtyBadge.style.display = '';
        }
    });
}

// Distance writer used by the målgrupp slider + numeric input. Marks dirty,
// updates the inline displays (per-target-group spacing hint + station-level
// Föreslaget skjuttid) without re-rendering the whole tab so the slider stays
// smooth while dragging.
function faltCfgSetDistance(wc, stationNum, tgIdx, value, opts) {
    var v = parseInt(value, 10);
    if (isNaN(v)) return;
    if (v < SLIDER_MIN_DISTANCE) v = SLIDER_MIN_DISTANCE;
    var station = faltCfgData[wc] && faltCfgData[wc].stations
        ? faltCfgData[wc].stations.find(function(s) { return s.station === stationNum; }) : null;
    if (!station || !station.targetGroups || !station.targetGroups[tgIdx]) return;
    station.targetGroups[tgIdx].distance = v;

    // Mirror to both controls (slider may have driven this; sync the number, or vice versa).
    var slider = document.getElementById('faltCfgDistSlider_' + wc + '_' + stationNum + '_' + tgIdx);
    var num = document.getElementById('faltCfgDistNum_' + wc + '_' + stationNum + '_' + tgIdx);
    if (slider && slider.value !== String(v)) slider.value = v;
    if (num && num.value !== String(v)) num.value = v;
    var hint = document.getElementById('faltCfgSpacingHint_' + wc + '_' + stationNum + '_' + tgIdx);
    if (hint) hint.textContent = faltSpacingHintText(v);

    // Föreslaget skjuttid display: for advanced mode, one per (wc, station);
    // for simple mode, one per class per station row in the params table.
    faltCfgRefreshSuggestion(stationNum);

    if (!opts || !opts.skipDirty) faltCfgMarkDirty(wc, stationNum);
}

function faltSpacingHintText(distanceM) {
    var spacing = Math.round((distanceM - 5) / 2);
    if (spacing < 5) return 'Rek. avstånd mellan figurer: minst 5 cm (regelminimum).';
    if (spacing > 40) return 'Rek. avstånd mellan figurer: högst 40 cm (regelmaximum).';
    return 'Rek. avstånd mellan figurer i målgruppen: ' + spacing + ' cm.';
}

// Re-render all Föreslaget-skjuttid badges for one station across every class.
// Advanced mode renders one in the per-station header (current tab only).
// Simple mode renders one per row in the per-class params table.
function faltCfgRefreshSuggestion(stationNum) {
    faltCfgWeaponClasses.forEach(function(wc) {
        var station = faltCfgData[wc] && faltCfgData[wc].stations
            ? faltCfgData[wc].stations.find(function(s) { return s.station === stationNum; }) : null;
        if (!station) return;
        var sugg = faltSuggestShootingTime(station, wc, faltCfgMorker);
        var el = document.getElementById('faltCfgSuggTime_' + wc + '_' + stationNum);
        if (el) el.textContent = sugg ? (sugg.totalSec + ' sek') : '—';
        var applyBtn = document.getElementById('faltCfgSuggApply_' + wc + '_' + stationNum);
        if (applyBtn) applyBtn.disabled = !sugg;
    });
}

function faltCfgShowSuggestionDetails(wc, stationNum) {
    var station = faltCfgData[wc] && faltCfgData[wc].stations
        ? faltCfgData[wc].stations.find(function(s) { return s.station === stationNum; }) : null;
    var sugg = station ? faltSuggestShootingTime(station, wc, faltCfgMorker) : null;
    var ctxEl = document.getElementById('faltCfgSuggDetailsContext');
    var bodyEl = document.getElementById('faltCfgSuggDetailsBody');
    var footEl = document.getElementById('faltCfgSuggDetailsFoot');
    if (!ctxEl || !bodyEl || !footEl) return;
    ctxEl.textContent = 'Station ' + stationNum + ' — vapenklass ' + wc + ' (diagram ' + faltShbBucket(wc) + ', max ' + SHB_MAX_TIME_PER_SHOT[faltShbBucket(wc)] + ' sek/skott)';
    if (!sugg) {
        bodyEl.innerHTML = '<tr><td colspan="2" class="text-muted">Kalkyl saknas — ingen figur har en giltig storleksgrupp.</td></tr>';
        footEl.innerHTML = '';
    } else {
        bodyEl.innerHTML = sugg.breakdown.map(function(b) {
            if (b.info) {
                // Informational row (per-målgrupp per-shot time, no sek contribution).
                return '<tr class="text-muted small"><td>' + b.label + '</td><td class="text-end text-nowrap">' + b.info + '</td></tr>';
            }
            var prefix = b.sec > 0 ? '+' : '';
            return '<tr><td>' + b.label + '</td><td class="text-end text-nowrap">' + prefix + b.sec + ' sek</td></tr>';
        }).join('');
        footEl.innerHTML = '<tr class="fw-bold"><td>Föreslaget skjuttid</td><td class="text-end">' + sugg.totalSec + ' sek</td></tr>';
    }
    bootstrap.Modal.getOrCreateInstance(document.getElementById('faltCfgSuggDetailsModal')).show();
}

function faltCfgApplySuggestion(wc, stationNum) {
    var station = faltCfgData[wc] && faltCfgData[wc].stations
        ? faltCfgData[wc].stations.find(function(s) { return s.station === stationNum; }) : null;
    if (!station) return;
    var sugg = faltSuggestShootingTime(station, wc, faltCfgMorker);
    if (!sugg) return;
    faltCfgUpdateStation(wc, stationNum, 'shootingTimeSec', sugg.totalSec);
    renderActiveTab();
}

// Returns the weapon class used for slider bounds + distance read/write in
// the current render context. Advanced: the tab's wc. Simple: the picker's
// chosen class, defaulting to canonical.
function faltCfgEffectiveDistanceClass(wc) {
    if (faltCfgMode !== 'simple') return wc;
    if (faltCfgSimpleDistanceClass && faltCfgWeaponClasses.indexOf(faltCfgSimpleDistanceClass) >= 0) {
        return faltCfgSimpleDistanceClass;
    }
    return faltCfgGetCanonicalClass();
}

function renderTargetGroup(tg, tgIdx, stationNum, wc, isPoang, isLastGroup) {
    var figures = tg.figures || [];
    var figuresHtml = '';
    var tgLetter = String.fromCharCode(64 + tg.group);

    figures.forEach(function(fig, fIdx) {
        var isLastFig = figures.length <= 1;
        var imgHtml = '';
        if (fig.imageUrl) {
            imgHtml = '<img src="' + fig.imageUrl + '" style="height:28px;border-radius:3px" alt="">' +
                (fig.targetName ? '<span class="small text-truncate" style="max-width:80px" title="' + fig.targetName + '">' + fig.targetName + '<\/span>' : '') +
                '<button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="faltCfgRemoveFigImage(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ',' + fIdx + ')" title="Ta bort bild"><i class="bi bi-trash"><\/i><\/button>';
        } else {
            imgHtml = '<button class="btn btn-outline-primary btn-sm py-0 mb-0" title="Figurkatalog" onclick="faltCfgPickTarget(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ',' + fIdx + ')">' +
                '<i class="bi bi-search"><\/i><\/button>' +
                '<button class="btn btn-outline-secondary btn-sm py-0 mb-0" title="Ladda upp bild"' +
                ' onclick="faltCfgChooseFigPhoto(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ',' + fIdx + ')">' +
                '<i class="bi bi-upload"><\/i><\/button>';
        }

        var figLabel = fig.figureNumber;
        figuresHtml += '<div class="d-flex align-items-center gap-2 fig-row ' + (fIdx > 0 ? 'mt-1' : '') + '">' +
            (!isLastFig ? '<button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="faltCfgRemoveFigure(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ',' + fIdx + ')" title="Ta bort figur"><i class="bi bi-trash"><\/i><\/button>' : '') +
            '<span class="text-muted small text-nowrap" style="width:55px">Figur ' + figLabel + '<\/span>' +
            '<div class="form-check mb-0"><input class="form-check-input" type="checkbox"' + (fig.isPoangmal ? ' checked' : '') +
                ' onchange="faltCfgUpdateFigure(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + fIdx + ',' + "'isPoangmal'" + ',this.checked)">' +
                '<label class="form-check-label small text-nowrap">Po\u00e4ngr\u00e4kning<\/label><\/div>' +
            '<div class="d-flex align-items-center gap-1">' +
                '<label class="small text-muted text-nowrap mb-0">M\u00e5l<\/label>' +
                '<input type="number" class="form-control form-control-sm" min="1" max="6" value="' + (fig.targetsPerFigure || 1) + '" style="width:45px"' +
                    ' onchange="faltCfgUpdateFigure(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + fIdx + ',' + "'targetsPerFigure'" + ',parseInt(this.value)||1)" title="Antal m\u00e5l i figuren"><\/div>' +
            '<select class="form-select form-select-sm" style="width:auto"' +
                ' onchange="faltCfgUpdateFigure(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + fIdx + ',' + "'behavior'" + ',this.value); faltCfgToggleFigBehavior(this)">' +
                TARGET_BEHAVIORS.map(function(b) { return '<option' + (b === fig.behavior ? ' selected' : '') + '>' + b + '<\/option>'; }).join('') +
            '<\/select>' +
            '<span class="fig-framCol" style="display:' + (fig.behavior === 'Framsv\u00e4ngande' ? '' : 'none') + '">' +
                '<input type="number" class="form-control form-control-sm d-inline-block" min="0" max="60" value="' + (fig.delayBeforeShowSec || 0) + '" style="width:50px" title="Fram efter (sek)"' +
                    ' onchange="faltCfgUpdateFigure(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + fIdx + ',' + "'delayBeforeShowSec'" + ',parseInt(this.value)||0)">' +
                '<input type="number" class="form-control form-control-sm d-inline-block" min="1" max="60" value="' + (fig.showTimeSec || 8) + '" style="width:50px" title="Visas (sek)"' +
                    ' onchange="faltCfgUpdateFigure(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + fIdx + ',' + "'showTimeSec'" + ',parseInt(this.value)||8)"><\/span>' +
            '<span class="fig-bortCol" style="display:' + (fig.behavior === 'Bortsv\u00e4ngande' ? '' : 'none') + '">' +
                '<input type="number" class="form-control form-control-sm d-inline-block" min="1" max="60" value="' + (fig.hideAfterSec || 8) + '" style="width:50px" title="Bort efter (sek)"' +
                    ' onchange="faltCfgUpdateFigure(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + fIdx + ',' + "'hideAfterSec'" + ',parseInt(this.value)||8)">' +
                '<input type="number" class="form-control form-control-sm d-inline-block" min="0" max="60" value="' + (fig.reappearSec || 0) + '" style="width:50px" title="Igen (sek)"' +
                    ' onchange="faltCfgUpdateFigure(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + fIdx + ',' + "'reappearSec'" + ',parseInt(this.value)||0)"><\/span>' +
            '<div class="d-flex align-items-center gap-1 border rounded px-1 bg-body-secondary" style="height:30px">' + imgHtml + '<\/div>' +
        '<\/div>';
    });

    // Group photo
    var groupImgHtml = '';
    if (tg.imageUrl) {
        groupImgHtml = '<div class="text-center"><img src="' + tg.imageUrl + '" style="max-height:120px;max-width:100%;border-radius:6px" alt="">' +
            '<div class="mt-1"><button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="faltCfgRemoveGroupImage(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ')" title="Ta bort foto"><i class="bi bi-trash me-1"><\/i>Foto<\/button><\/div><\/div>';
    } else {
        groupImgHtml = '<div class="text-center"><button class="btn btn-outline-secondary btn-sm mb-0" title="Ladda upp foto av m\u00e5lgruppen"' +
            ' onclick="faltCfgChooseGroupPhoto(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ')">' +
            '<i class="bi bi-camera me-1"><\/i>Foto<\/button><\/div>';
    }

    var descVal = (tg.description || '').replace(/"/g, '&quot;').replace(/\n/g, '&#10;');

    // Distance slider \u2014 bounds derived from figures' sizeGroups for the active
    // distance class (advanced: wc; simple: faltCfgSimpleDistanceClass / canonical).
    var distWc = faltCfgEffectiveDistanceClass(wc);
    var distTg = (faltCfgMode === 'simple' && distWc !== wc)
        ? (faltCfgData[distWc] && faltCfgData[distWc].stations
            ? (faltCfgData[distWc].stations.find(function(s) { return s.station === stationNum; }) || {}).targetGroups
            : null)
        : null;
    var distSourceTg = distTg ? distTg[tgIdx] : tg;
    var bounds = faltTargetGroupBounds(tg, distWc);
    var currentDist = distSourceTg && distSourceTg.distance != null ? distSourceTg.distance : (bounds ? bounds.max : SLIDER_MIN_DISTANCE);
    if (bounds && currentDist > bounds.max) currentDist = bounds.max;
    if (currentDist < SLIDER_MIN_DISTANCE) currentDist = SLIDER_MIN_DISTANCE;

    var idBase = distWc + '_' + stationNum + '_' + tgIdx;
    var sliderHtml;
    if (!bounds) {
        sliderHtml = '<div class="form-text small text-muted">' +
            'V\u00e4lj figurer ur Figurkatalogen (med Storleksgrupp) f\u00f6r att aktivera avst\u00e5ndsf\u00f6rslag.' +
            '<\/div>';
    } else {
        var distLabel = faltCfgMode === 'simple' ? ('Avst\u00e5nd (vapenklass ' + distWc + ')') : 'Avst\u00e5nd';
        sliderHtml =
            '<div class="d-flex gap-2 align-items-center mt-2">' +
                '<label class="form-label small mb-0 text-nowrap fw-bold">' + distLabel + '<\/label>' +
                '<span class="text-muted small">' + bounds.min + ' m<\/span>' +
                '<input type="range" class="form-range" id="faltCfgDistSlider_' + idBase + '"' +
                    ' min="' + bounds.min + '" max="' + bounds.max + '" value="' + currentDist + '"' +
                    ' oninput="faltCfgSetDistance(\'' + distWc + '\',' + stationNum + ',' + tgIdx + ',this.value,{skipDirty:true})"' +
                    ' onchange="faltCfgSetDistance(\'' + distWc + '\',' + stationNum + ',' + tgIdx + ',this.value)">' +
                '<span class="text-muted small">' + bounds.max + ' m<\/span>' +
                '<input type="number" class="form-control form-control-sm" id="faltCfgDistNum_' + idBase + '"' +
                    ' min="' + bounds.min + '" max="' + bounds.max + '" value="' + currentDist + '" style="width:75px"' +
                    ' onchange="faltCfgSetDistance(\'' + distWc + '\',' + stationNum + ',' + tgIdx + ',this.value)">' +
                '<span class="text-muted small">m<\/span>' +
            '<\/div>' +
            '<div class="form-text small" id="faltCfgSpacingHint_' + idBase + '">' + faltSpacingHintText(currentDist) + '<\/div>';
    }

    return '<div class="border rounded p-2 mb-2 bg-body-tertiary tg-row" data-tg="' + tgIdx + '">' +
        '<div class="d-flex justify-content-between align-items-center mb-1">' +
            '<span class="fw-bold small">M\u00e5lgrupp ' + tgLetter + '<\/span>' +
            (!isLastGroup ? '<button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="faltCfgRemoveTargetGroup(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ')" title="Ta bort m\u00e5lgrupp"><i class="bi bi-trash"><\/i><\/button>' : '') +
        '<\/div>' +
        '<div class="d-flex gap-2">' +
            '<div class="flex-grow-1">' +
                figuresHtml +
                '<button class="btn btn-outline-primary btn-sm py-0 px-1 mt-1" onclick="faltCfgAddFigure(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ')"><i class="bi bi-plus me-1"><\/i>Figur<\/button>' +
            '<\/div>' +
            '<div class="flex-shrink-0" style="width:140px">' + groupImgHtml + '<\/div>' +
        '<\/div>' +
        sliderHtml +
        '<div class="d-flex gap-1 mt-2 align-items-start">' +
            '<textarea class="form-control form-control-sm" rows="3" placeholder="Beskrivning av m\u00e5lgruppen..." autocomplete="off" data-1p-ignore="true"' +
                ' oninput="faltCfgUpdateGroup(' + "'" + wc + "'" + ',' + stationNum + ',' + tgIdx + ',' + "'description'" + ',this.value)">' + descVal + '<\/textarea>' +
            '<button class="btn btn-outline-secondary btn-sm text-nowrap" onclick="faltCfgAutoDescription(' + stationNum + ',' + "'" + wc + "'" + ',' + tgIdx + ')" title="Generera beskrivning"><i class="bi bi-magic me-1"><\/i>Auto<\/button>' +
        '<\/div>' +
    '<\/div>';
}

// ─── Figure behavior toggle (visual only) ───────────────────────────

function faltCfgToggleFigBehavior(selectEl) {
    var row = selectEl.closest('.fig-row');
    var val = selectEl.value;
    row.querySelector('.fig-framCol').style.display = val === 'Framsvängande' ? '' : 'none';
    row.querySelector('.fig-bortCol').style.display = val === 'Bortsvängande' ? '' : 'none';
}

// ─── Add / Remove figures and groups ────────────────────────────────

function faltCfgAddFigure(stationNum, wc, tgIdx) {
    faltCfgExpandedStation = stationNum;
    var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
    if (!station) return;
    var tg = station.targetGroups[tgIdx];
    if (!tg) return;
    tg.figures.push(createDefaultFigure(tg.figures.length + 1));
    faltCfgMarkDirty(wc, stationNum);
    renderActiveTab();
}

function faltCfgRemoveFigure(stationNum, wc, tgIdx, fIdx) {
    faltCfgExpandedStation = stationNum;
    var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
    if (!station) return;
    var tg = station.targetGroups[tgIdx];
    if (!tg || tg.figures.length <= 1) return;
    tg.figures.splice(fIdx, 1);
    tg.figures.forEach(function(f, i) { f.figureNumber = i + 1; });
    faltCfgMarkDirty(wc, stationNum);
    renderActiveTab();
}

function faltCfgAddTargetGroup(stationNum, wc) {
    faltCfgExpandedStation = stationNum;
    const station = faltCfgData[wc]?.stations?.find(s => s.station === stationNum);
    if (!station) return;
    station.targetGroups.push({
        group: station.targetGroups.length + 1,
        figures: [createDefaultFigure(1)]
    });
    faltCfgMarkDirty(wc, stationNum);
    renderActiveTab();
}

function faltCfgRemoveTargetGroup(stationNum, wc, tgIdx) {
    faltCfgExpandedStation = stationNum;
    const station = faltCfgData[wc]?.stations?.find(s => s.station === stationNum);
    if (!station || station.targetGroups.length <= 1) return;
    station.targetGroups.splice(tgIdx, 1);
    station.targetGroups.forEach((tg, i) => tg.group = i + 1);
    faltCfgMarkDirty(wc, stationNum);
    renderActiveTab();
}

// ─── Target picker ──────────────────────────────────────────────────

function faltCfgPickTarget(stationNum, wc, tgIdx, fIdx) {
    faltCfgExpandedStation = stationNum;

    // Open picker on top of configurator (no hide/show needed)
    faltPickerOpen(wc, function(result) {
        // Apply selection to figure
        var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
        if (station && station.targetGroups[tgIdx] && station.targetGroups[tgIdx].figures[fIdx]) {
            var fig = station.targetGroups[tgIdx].figures[fIdx];
            fig.imageUrl = result.imageUrl;
            fig.targetName = result.targetName;
            fig.targetColor = result.targetColor;
            if (result.targetsPerFigure > 1) fig.targetsPerFigure = result.targetsPerFigure;
            // Carry the catalog's SizeGroup onto the figure so distance-slider bounds
            // and the suggested-time formula can read it without re-fetching the catalog.
            fig.sizeGroup = result.sizeGroup || 0;
        }
        faltCfgMarkDirty(wc, stationNum);
        renderActiveTab();
    });
}

// ─── File chooser (dynamic input — avoids label/hidden-input browser issues) ─

function faltCfgChooseGroupPhoto(stationNum, wc, tgIdx) {
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = function() { faltCfgUploadGroupImage(input, stationNum, wc, tgIdx); };
    input.click();
}

function faltCfgChooseFigPhoto(stationNum, wc, tgIdx, fIdx) {
    var input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = function() { faltCfgUploadFigImage2(input, stationNum, wc, tgIdx, fIdx); };
    input.click();
}

// ─── Image upload / remove ──────────────────────────────────────────

async function faltCfgUploadGroupImage(inputEl, stationNum, wc, tgIdx) {
    var file = inputEl.files[0];
    if (!file) return;

    var compId = faltCfgGetCompetitionId() || ('temp_' + Date.now());
    var formData = new FormData();
    formData.append('file', file);
    formData.append('competitionId', compId);
    formData.append('weaponClass', wc);
    formData.append('stationNumber', stationNum);
    formData.append('groupNumber', tgIdx + 1);
    try {
        var resp = await fetch('/umbraco/surface/Faltskytte/UploadTargetGroupImage', { method: 'POST', body: formData });
        var data = await resp.json();
        if (data.success) {
            var station = faltCfgData[wc]?.stations?.find(function(s){return s.station===stationNum;});
            if (station && station.targetGroups[tgIdx]) {
                station.targetGroups[tgIdx].imageUrl = data.imageUrl;
            }
            faltCfgMarkDirty(wc, stationNum);
            faltCfgExpandedStation = stationNum;
            renderActiveTab();
        }
    } catch(e) { console.error(e); }
}

function faltCfgRemoveGroupImage(stationNum, wc, tgIdx) {
    var station = faltCfgData[wc]?.stations?.find(function(s){return s.station===stationNum;});
    if (station && station.targetGroups[tgIdx]) station.targetGroups[tgIdx].imageUrl = null;
    faltCfgMarkDirty(wc, stationNum);
    faltCfgExpandedStation = stationNum;
    renderActiveTab();
}

function faltCfgAutoDescription(stationNum, wc, tgIdx) {
    var station = faltCfgData[wc]?.stations?.find(function(s){return s.station===stationNum;});
    if (!station) return;
    var tg = station.targetGroups[tgIdx];
    if (!tg) return;
    var figs = tg.figures || [];
    var desc = figs.length + ' figur' + (figs.length > 1 ? 'er' : '') + '. ';
    figs.forEach(function(fig) {
        desc += 'Figur ' + fig.figureNumber;
        if (fig.targetName) desc += ' (' + fig.targetName + (fig.targetColor ? ', ' + fig.targetColor : '') + ')';
        desc += ': ' + fig.behavior;
        if (fig.behavior === 'Framsv\u00e4ngande') {
            if (fig.delayBeforeShowSec) desc += ', sv\u00e4nger fram efter ' + fig.delayBeforeShowSec + ' sek';
            if (fig.showTimeSec) desc += ' och visas i ' + fig.showTimeSec + ' sek';
        } else if (fig.behavior === 'Bortsv\u00e4ngande') {
            if (fig.hideAfterSec) desc += ', sv\u00e4nger bort efter ' + fig.hideAfterSec + ' sek';
            if (fig.reappearSec) desc += ', visar igen efter ' + fig.reappearSec + ' sek';
        }
        if (fig.isPoangmal) desc += ', po\u00e4ngr\u00e4kning';
        desc += '. ';
    });
    tg.description = desc.trim();
    faltCfgMarkDirty(wc, stationNum);
    faltCfgExpandedStation = stationNum;
    renderActiveTab();
}

function faltCfgRemoveFigImage(stationNum, wc, tgIdx, fIdx) {
    faltCfgExpandedStation = stationNum;
    var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
    if (station && station.targetGroups[tgIdx] && station.targetGroups[tgIdx].figures[fIdx]) {
        station.targetGroups[tgIdx].figures[fIdx].imageUrl = null;
        station.targetGroups[tgIdx].figures[fIdx].targetName = null;
        station.targetGroups[tgIdx].figures[fIdx].targetColor = null;
    }
    faltCfgMarkDirty(wc, stationNum);
    renderActiveTab();
}

async function faltCfgUploadFigImage2(inputEl, stationNum, wc, tgIdx, fIdx) {
    var file = inputEl.files[0];
    if (!file) return;

    var compId = faltCfgGetCompetitionId() || ('temp_' + Date.now());

    var formData = new FormData();
    formData.append('file', file);
    formData.append('competitionId', compId);
    formData.append('weaponClass', wc);
    formData.append('stationNumber', stationNum);
    formData.append('groupNumber', (tgIdx + 1) * 100 + (fIdx + 1));

    try {
        var resp = await fetch('/umbraco/surface/Faltskytte/UploadTargetGroupImage', {
            method: 'POST',
            body: formData
        });
        if (!resp.ok) return;
        var data = await resp.json();
        if (data.success) {
            var station = faltCfgData[wc]?.stations?.find(function(s) { return s.station === stationNum; });
            if (station && station.targetGroups[tgIdx] && station.targetGroups[tgIdx].figures[fIdx]) {
                station.targetGroups[tgIdx].figures[fIdx].imageUrl = data.imageUrl;
            }
            faltCfgMarkDirty(wc, stationNum);
            faltCfgExpandedStation = stationNum;
            renderActiveTab();
        }
    } catch(err) { console.error(err); }
}

// ─── Simple mode ────────────────────────────────────────────────────
// In simple mode all weapon classes share the same shape (target groups +
// figures + images + descriptions + behaviour timing), but each class can
// have its own Skjuttid / Utgångsläge / Vapenläge / Stödhand / Max skott.
// Wire format is unchanged — the mode is purely a UX layer over the same
// per-class storage. The shared shape is canonicalised on the first weapon
// class in faltCfgWeaponClasses; faltCfgMarkDirty mirrors it to the others.

function faltCfgGetCanonicalClass() {
    return faltCfgWeaponClasses[0] || 'C';
}

function faltCfgPickDistanceClass(wc) {
    faltCfgSimpleDistanceClass = wc;
    renderActiveTab();
}

// Returns true if any station in any weapon class has at least one figure
// with picked content (sizeGroup, image, or name). Used to decide whether
// the mörker toggle has anything worth persisting.
function faltCfgHasAnyConfiguredStation() {
    var classes = Object.keys(faltCfgData).filter(function(k) { return !faltCfgIsMetaKey(k); });
    for (var i = 0; i < classes.length; i++) {
        var stations = (faltCfgData[classes[i]] && faltCfgData[classes[i]].stations) || [];
        for (var s = 0; s < stations.length; s++) {
            var tgs = stations[s].targetGroups || [];
            for (var g = 0; g < tgs.length; g++) {
                var figs = tgs[g].figures || [];
                for (var f = 0; f < figs.length; f++) {
                    var fig = figs[f];
                    if ((fig.sizeGroup && fig.sizeGroup > 0) || fig.imageUrl || fig.targetName) return true;
                }
            }
        }
    }
    return false;
}

// Competition-level mörker flag. Affects suggested-time calculations across
// every station + class. Stored on faltCfgData._morker so it round-trips with
// the config blob — needs the whole blob to be saved to actually persist.
//
// If any station has configuration, confirm save-all; on confirm, faltCfgSaveAll
// writes everything (mörker + all stations) in one call. If no station is
// configured yet there's nothing to save and we silently update the in-memory
// flag — it'll piggyback on the operator's first real station save.
async function faltCfgToggleMorker(checked) {
    faltCfgMorker = !!checked;
    faltCfgSaveLinkedGroups();
    renderActiveTab();

    if (!faltCfgHasAnyConfiguredStation()) return;

    var msg = 'Mörkerfältskjutning är nu ' + (faltCfgMorker ? 'PÅ' : 'AV') + '.\n\n' +
              'Inställningen sparas tillsammans med stationskonfigurationen och ' +
              'påverkar föreslagen skjuttid för alla stationer.\n\n' +
              'Spara alla stationer nu?\n' +
              '(Klicka Avbryt för att spara senare via valfri station.)';
    if (!confirm(msg)) return;
    await faltCfgSaveAll();
    renderActiveTab();
}

function faltCfgRenderSimpleMode() {
    var container = document.getElementById('faltCfgTabContent');
    var canonical = faltCfgGetCanonicalClass();
    var stations = faltCfgData[canonical]?.stations || [];
    var isPoang = faltCfgScoringMode() === 'Poang';
    var html = '';
    stations.forEach(function (st) {
        var collapseId = 'faltCfgStationSimple_' + st.station;
        var anyDirty = faltCfgWeaponClasses.some(function (c) {
            return faltCfgDirtyStations.has(c + '_' + st.station);
        });

        // Per-class param matrix — one row per visible group. Linked classes
        // collapse into a single row labelled "A, R" (etc.); edits propagate
        // to all linked siblings via faltCfgSyncLinked in faltCfgMarkDirty.
        var matrixRows = '';
        faltCfgGetVisibleTabs().forEach(function (wc) {
            var wst = faltCfgData[wc]?.stations?.find(function (s) { return s.station === st.station; });
            if (!wst) return;
            var grp = faltCfgGetLinkedGroup(wc);
            var label = grp ? grp.join(', ') : wc;
            var unlinkBtn = grp
                ? ' <button class="btn btn-outline-warning btn-sm py-0 px-1 ms-1" onclick="faltCfgUnlinkInSimpleMode(\'' + wc + '\')" title="Avlänka"><i class="bi bi-x-circle"></i></button>'
                : '';
            var sugg = faltSuggestShootingTime(wst, wc, faltCfgMorker);
            matrixRows +=
                '<tr>' +
                  '<td class="fw-bold">' + label + unlinkBtn + '</td>' +
                  '<td><input type="number" class="form-control form-control-sm" min="5" max="120" value="' + wst.shootingTimeSec + '" style="width:80px"' +
                    " onchange=\"faltCfgUpdateStation('" + wc + "'," + st.station + ",'shootingTimeSec',parseInt(this.value)||30)\"></td>" +
                  '<td><div class="d-flex gap-1 align-items-center">' +
                    '<span class="badge bg-info text-dark" id="faltCfgSuggTime_' + wc + '_' + st.station + '">' + (sugg ? sugg.totalSec + ' sek' : '—') + '</span>' +
                    '<button type="button" class="btn btn-outline-info btn-sm py-0 px-1" onclick="faltCfgShowSuggestionDetails(\'' + wc + '\',' + st.station + ')" title="Visa uppdelning"><i class="bi bi-info-circle"></i></button>' +
                    '<button type="button" class="btn btn-outline-primary btn-sm py-0 px-1" id="faltCfgSuggApply_' + wc + '_' + st.station + '"' + (sugg ? '' : ' disabled') + ' onclick="faltCfgApplySuggestion(\'' + wc + '\',' + st.station + ')" title="Kopiera värdet till Skjuttid">Använd</button>' +
                  '</div></td>' +
                  '<td><select class="form-select form-select-sm"' +
                    " onchange=\"faltCfgUpdateStation('" + wc + "'," + st.station + ",'shooterStartPosition',this.value)\">" +
                    SHOOTER_POSITIONS.map(function (p) { return '<option' + (p === wst.shooterStartPosition ? ' selected' : '') + '>' + p + '</option>'; }).join('') +
                  '</select></td>' +
                  '<td><select class="form-select form-select-sm"' +
                    " onchange=\"faltCfgUpdateStation('" + wc + "'," + st.station + ",'weaponStartPosition',this.value)\">" +
                    WEAPON_POSITIONS.map(function (p) { return '<option' + (p === wst.weaponStartPosition ? ' selected' : '') + '>' + p + '</option>'; }).join('') +
                  '</select></td>' +
                  '<td><select class="form-select form-select-sm"' +
                    " onchange=\"faltCfgUpdateStation('" + wc + "'," + st.station + ",'supportHand',this.value)\">" +
                    SUPPORT_HAND.map(function (p) { return '<option' + (p === wst.supportHand ? ' selected' : '') + '>' + p + '</option>'; }).join('') +
                  '</select></td>' +
                  (!isPoang ? '<td><input type="number" class="form-control form-control-sm" min="1" max="6" value="' + (wst.maxShotsPerFigure || 6) + '" style="width:65px"' +
                    " onchange=\"faltCfgUpdateStation('" + wc + "'," + st.station + ",'maxShotsPerFigure',parseInt(this.value)||6)\"></td>" : '') +
                '</tr>';
        });

        // Target groups — rendered once against the canonical class. Edits flow
        // through faltCfgMarkDirty → faltCfgSyncShape which mirrors them to all
        // other classes before the next render. Distance sliders are scoped to
        // the picked class via faltCfgSimpleDistanceClass (defaults to canonical).
        var visibleClasses = faltCfgGetVisibleTabs();
        var pickedDistClass = faltCfgEffectiveDistanceClass(canonical);
        var distancePicker = '';
        if (visibleClasses.length > 1) {
            distancePicker =
                '<div class="d-flex align-items-center gap-2 mb-2">' +
                  '<span class="small text-muted">Visa avstånd för:</span>' +
                  '<div class="btn-group btn-group-sm" role="group">' +
                    visibleClasses.map(function(c) {
                        var label = faltCfgGetLinkedGroup(c) ? faltCfgGetLinkedGroup(c).join(',') : c;
                        var checked = c === pickedDistClass ? 'checked' : '';
                        var id = 'faltCfgDistPick_' + st.station + '_' + c;
                        return '<input type="radio" class="btn-check" name="faltCfgDistPick_' + st.station + '" id="' + id + '" autocomplete="off" ' + checked +
                               ' onchange="faltCfgPickDistanceClass(\'' + c + '\')">' +
                               '<label class="btn btn-outline-primary" for="' + id + '">' + label + '</label>';
                    }).join('') +
                  '</div>' +
                '</div>';
        }
        var tgsHtml = '';
        (st.targetGroups || []).forEach(function (tg, tgIdx) {
            var isLastGroup = (st.targetGroups || []).length <= 1;
            tgsHtml += renderTargetGroup(tg, tgIdx, st.station, canonical, isPoang, isLastGroup);
        });

        html +=
            '<div class="card mb-2" data-station="' + st.station + '">' +
              '<div class="card-header py-2" role="button" data-bs-toggle="collapse" data-bs-target="#' + collapseId + '">' +
                '<div class="d-flex justify-content-between align-items-center">' +
                  '<span><strong>Station ' + st.station + '</strong>' +
                    '<span id="faltCfgSimpleSaved_' + st.station + '" class="badge bg-success ms-2" style="display:none">Sparad</span>' +
                    '<span id="faltCfgSimpleDirty_' + st.station + '" class="badge bg-warning text-dark ms-2"' + (anyDirty ? '' : ' style="display:none"') + '>Osparad</span>' +
                  '</span>' +
                  '<span class="d-flex align-items-center gap-2">' +
                    '<span class="text-muted small">' + (st.targetGroups || []).length + ' målgr.</span>' +
                    '<button class="btn btn-success btn-sm" onclick="event.stopPropagation(); faltCfgSimpleSaveStation(' + st.station + ')">' +
                      '<i class="bi bi-check-lg me-1"></i>Spara stationen' +
                    '</button>' +
                    '<button class="btn btn-outline-info btn-sm" onclick="event.stopPropagation(); faltCfgPrintStation(' + st.station + ',\'' + canonical + '\')" title="Skriv ut stationskort">' +
                      '<i class="bi bi-printer"></i>' +
                    '</button>' +
                  '</span>' +
                '</div>' +
              '</div>' +
              '<div id="' + collapseId + '" class="collapse ' + (st.station === faltCfgExpandedStation ? 'show' : '') + '">' +
                '<div class="card-body">' +
                  '<label class="form-label small fw-bold mb-1">Förutsättningar (per vapenklass)</label>' +
                  '<div class="table-responsive mb-3">' +
                    '<table class="table table-sm table-bordered align-middle mb-0">' +
                      '<thead><tr>' +
                        '<th>Vapenklass</th>' +
                        '<th>Skjuttid (sek)</th>' +
                        '<th>Föreslaget</th>' +
                        '<th>Utgångsläge</th>' +
                        '<th>Vapenläge</th>' +
                        '<th>Stödhand</th>' +
                        (!isPoang ? '<th>Max träff/fig</th>' : '') +
                      '</tr></thead>' +
                      '<tbody>' + matrixRows + '</tbody>' +
                    '</table>' +
                  '</div>' +
                  '<label class="form-label small fw-bold mb-1">Målgrupper (delas mellan alla vapenklasser)</label>' +
                  distancePicker +
                  '<div class="tg-container">' + tgsHtml + '</div>' +
                  '<button class="btn btn-outline-secondary btn-sm mt-2" onclick="faltCfgAddTargetGroup(' + st.station + ',\'' + canonical + '\')">' +
                    '<i class="bi bi-plus-lg me-1"></i>Lägg till målgrupp' +
                  '</button>' +
                '</div>' +
              '</div>' +
            '</div>';
    });

    container.innerHTML = html;

    // Track which station the user expands manually
    container.querySelectorAll('.collapse').forEach(function (el) {
        el.addEventListener('shown.bs.collapse', function () {
            var card = this.closest('.card[data-station]');
            if (card) faltCfgExpandedStation = parseInt(card.dataset.station);
        });
    });
}

// Simple-mode linking: classes in a linked group share per-class params
// (Skjuttid, positions, support hand, max shots) AND show as a single row in
// the per-class param matrix. Shape is already shared via faltCfgSyncShape,
// so linking only adds param sharing on top.
function faltCfgLinkInSimpleMode() {
    var available = faltCfgWeaponClasses.filter(function (c) { return !faltCfgGetLinkedGroup(c); });
    if (available.length < 2) {
        alert('Behöver minst två olänkade vapenklasser för att kunna länka.');
        return;
    }
    var choice = prompt(
        'Vilka vapenklasser ska länkas? Länkade klasser delar Skjuttid och ' +
        'övriga förutsättningar och visas på samma rad i tabellen.\n\n' +
        'Tillgängliga: ' + available.join(', ') + '\n\n' +
        'Separera med komma, t.ex. "A, R" eller "A, A_Opt, R":');
    if (!choice) return;
    var entries = choice.split(/[,\s]+/)
        .map(function (e) { return e.trim(); })
        .filter(function (e) { return e.length > 0; });
    if (entries.length < 2) { alert('Ange minst två klasser.'); return; }

    var matched = [];
    var unmatched = [];
    entries.forEach(function (e) {
        var c = available.find(function (o) { return o.toUpperCase() === e.toUpperCase(); });
        if (c) {
            if (matched.indexOf(c) < 0) matched.push(c);
        } else {
            unmatched.push(e);
        }
    });
    if (unmatched.length > 0) {
        alert('Följande är inte tillgängliga eller redan länkade: ' + unmatched.join(', '));
        return;
    }
    if (matched.length < 2) return;

    // First matched class becomes the group representative; copy its data to
    // siblings so they start with identical per-class params.
    faltCfgLinkedGroups.push(matched);
    var srcKey = matched[0];
    matched.slice(1).forEach(function (c) {
        faltCfgData[c] = JSON.parse(JSON.stringify(faltCfgData[srcKey]));
    });
    faltCfgSaveLinkedGroups();
    renderActiveTab();
}

function faltCfgUnlinkInSimpleMode(repClass) {
    var grp = faltCfgGetLinkedGroup(repClass);
    if (!grp) return;
    if (!confirm('Avlänka ' + grp.join(', ') + '? Varje klass behåller sina nuvarande förutsättningar.')) return;
    faltCfgLinkedGroups = faltCfgLinkedGroups.filter(function (g) { return g !== grp; });
    faltCfgSaveLinkedGroups();
    renderActiveTab();
}

function faltCfgRequestMode(newMode) {
    if (newMode === faltCfgMode) return;
    if (newMode === 'simple') {
        // Switching from advanced → simple is a destructive merge if classes
        // don't already share a shape per station: figures unique to one class
        // would be lost. Warn, let the operator confirm; bail back to advanced
        // if they cancel.
        if (!faltCfgAllClassesShareShape()) {
            var canonical = faltCfgGetCanonicalClass();
            var ok = confirm(
                'Vapenklasserna har olika målgrupper / figurer per station. ' +
                'I enkelt läge delas formen mellan alla klasser, så ' + canonical +
                ':s konfiguration används och övriga klassers särfall försvinner.\n\n' +
                'Vill du fortsätta?');
            if (!ok) {
                document.getElementById('faltCfgMode_advanced').checked = true;
                return;
            }
            faltCfgSyncShape(canonical);
            (faltCfgData[canonical]?.stations || []).forEach(function (st) {
                faltCfgWeaponClasses.forEach(function (c) {
                    faltCfgDirtyStations.add(c + '_' + st.station);
                });
            });
        }
        // Linked groups are preserved across the mode switch — in simple mode
        // they collapse to a single matrix row, sharing per-class params.
    }
    faltCfgMode = newMode;
    faltCfgSaveLinkedGroups(); // also persists _mode flag
    faltCfgRenderModeChrome();
    if (faltCfgMode === 'advanced') {
        buildTabs();
        faltCfgActiveTab = faltCfgGetVisibleTabs()[0] || faltCfgWeaponClasses[0];
        faltCfgUpdateLinkButtons();
    }
    renderActiveTab();
}

async function faltCfgSimpleSaveStation(stationNum) {
    // Shape is already kept in sync via markDirty; per-class params are stored
    // on each class's station object. Just flush JSON like advanced save does.
    faltCfgSaveLinkedGroups();
    var json = JSON.stringify(faltCfgData);
    var _fldEl = document.getElementById(faltCfgGetTargetFieldId()); if (_fldEl) _fldEl.value = json;

    if (faltCfgIsEditMode()) {
        var ok = await faltCfgSaveToServer(json);
        if (!ok) return;
    }
    faltCfgWeaponClasses.forEach(function (c) {
        faltCfgDirtyStations.delete(c + '_' + stationNum);
    });
    var savedBadge = document.getElementById('faltCfgSimpleSaved_' + stationNum);
    var dirtyBadge = document.getElementById('faltCfgSimpleDirty_' + stationNum);
    if (savedBadge) savedBadge.style.display = '';
    if (dirtyBadge) dirtyBadge.style.display = 'none';
}

// ─── Save / Close ───────────────────────────────────────────────────

function faltCfgGetTargetFieldId() {
    return window._faltCfgTargetField || 'wizard_faltStationConfigJson';
}

function faltCfgGetCompetitionId() {
    // For edit mode: read from edit modal's hidden field
    var el = document.getElementById('editCompetitionId');
    if (el && el.value && el.value !== '0') return parseInt(el.value);
    // Try from currentCompetitionData
    if (window.currentCompetitionData?.id) return window.currentCompetitionData.id;
    return null;
}

function faltCfgIsEditMode() {
    if (window._faltCfgEditorMode === 'configuration') return true;
    return window._faltCfgTargetField === 'edit_faltStationConfigJson' && faltCfgGetCompetitionId();
}

// True when this configurator instance is editing a standalone FaltskytteConfiguration
// (the /faltkonfig/{id}/redigera page). Routes save calls to a different endpoint.
function faltCfgIsStandaloneEditor() {
    return window._faltCfgEditorMode === 'configuration';
}

async function faltCfgSaveStation(stationNum, wc) {
    faltCfgSyncLinked(wc);
    faltCfgSaveLinkedGroups();
    var json = JSON.stringify(faltCfgData);
    var _fldEl = document.getElementById(faltCfgGetTargetFieldId()); if (_fldEl) _fldEl.value = json;

    // In edit mode: save to server immediately
    if (faltCfgIsEditMode()) {
        var ok = await faltCfgSaveToServer(json);
        if (!ok) return;
    }

    // Clear dirty for this station on all linked classes
    var grp = faltCfgGetLinkedGroup(wc);
    (grp || [wc]).forEach(function(c) { faltCfgDirtyStations.delete(c + '_' + stationNum); });
    var savedBadge = document.getElementById(`faltCfgSaved_${wc}_${stationNum}`);
    var dirtyBadge = document.getElementById(`faltCfgDirty_${wc}_${stationNum}`);
    if (savedBadge) savedBadge.style.display = '';
    if (dirtyBadge) dirtyBadge.style.display = 'none';
}

async function faltCfgSaveAll() {
    // Sync all linked groups before saving
    faltCfgLinkedGroups.forEach(function(grp) {
        if (grp.length > 1) faltCfgSyncLinked(grp[0]);
    });
    faltCfgSaveLinkedGroups();
    var json = JSON.stringify(faltCfgData);
    var _fldEl = document.getElementById(faltCfgGetTargetFieldId()); if (_fldEl) _fldEl.value = json;

    if (faltCfgIsEditMode()) {
        await faltCfgSaveToServer(json);
    }

    faltCfgDirtyStations.clear();
}

async function faltCfgSaveToServer(json) {
    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    // Standalone configuration editor: save to FaltskytteConfiguration table.
    if (faltCfgIsStandaloneEditor()) {
        var configId = window._faltCfgConfigurationId;
        if (!configId) return false;
        try {
            var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/Update', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ id: configId, jsonBlob: json })
            });
            var data = await resp.json();
            if (!data.success) {
                alert('Kunde inte spara: ' + (data.message || 'Okänt fel'));
                return false;
            }
            return true;
        } catch (err) {
            alert('Nätverksfel vid sparande.');
            console.error(err);
            return false;
        }
    }

    // Legacy competition save path.
    var compId = faltCfgGetCompetitionId();
    if (!compId) return false;
    try {
        var resp = await fetch('/umbraco/surface/Faltskytte/SaveStationConfig', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId: compId, stationConfigJson: json })
        });
        var data = await resp.json();
        if (!data.success) {
            alert('Kunde inte spara: ' + (data.message || 'Okänt fel'));
            return false;
        }
        return true;
    } catch(err) {
        alert('Nätverksfel vid sparande.');
        console.error(err);
        return false;
    }
}

async function faltCfgTryClose() {
    if (faltCfgDirtyStations.size > 0) {
        var choice = prompt('Du har osparade \u00e4ndringar p\u00e5 ' + faltCfgDirtyStations.size + ' station(er).\n\nSkriv "spara" f\u00f6r att spara och st\u00e4nga, eller "st\u00e4ng" f\u00f6r att st\u00e4nga utan att spara.\nAvbryt f\u00f6r att g\u00e5 tillbaka.', 'spara');
        if (choice === null) return; // Cancel — stay in modal
        if (choice.toLowerCase().indexOf('spara') >= 0) {
            await faltCfgSaveAll();
        }
        // "stäng" or anything else — close without saving
    }
    faltCfgClose();
}

function faltCfgClose() {
    var cfgEl = document.getElementById('faltStationConfigModal');
    var returnToEdit = window._faltCfgReturnToEditModal;
    var returnToWizard = !returnToEdit && !window._faltCfgReturnToEditModal;

    window._faltCfgTargetField = null;
    window._faltCfgReturnToEditModal = false;

    if (returnToEdit) {
        // Just close configurator — edit modal is still open underneath
        bootstrap.Modal.getInstance(cfgEl)?.hide();
    } else {
        // Return to wizard
        var onCfgHidden = function() {
            cfgEl.removeEventListener('hidden.bs.modal', onCfgHidden);
            window._wizardSkipReset = true;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('competitionWizardModal')).show();
        };
        cfgEl.addEventListener('hidden.bs.modal', onCfgHidden);
        bootstrap.Modal.getInstance(cfgEl)?.hide();
    }
}

// ─── Print ──────────────────────────────────────────────────────────

function faltDescribeBehavior(tg) {
    if (tg.behavior === 'Framsv\u00e4ngande') {
        var s = 'Framsv\u00e4ngande';
        if (tg.delayBeforeShowSec > 0) s += ', fram efter ' + tg.delayBeforeShowSec + ' sek';
        if (tg.showTimeSec > 0) s += ', visas i ' + tg.showTimeSec + ' sek';
        return s;
    }
    if (tg.behavior === 'Bortsv\u00e4ngande') {
        var s = 'Bortsv\u00e4ngande';
        if (tg.hideAfterSec > 0) s += ', bort efter ' + tg.hideAfterSec + ' sek';
        if (tg.reappearSec > 0) s += ', visar igen efter ' + tg.reappearSec + ' sek';
        return s;
    }
    if (tg.behavior === 'R\u00f6rligt') {
        return 'R\u00f6rligt';
    }
    return 'Fast';
}

// Compare two station configs ignoring timing fields. Returns true if structure is identical.
function faltCfgStationsStructurallyEqual(a, b) {
    if (!a || !b) return false;
    if (a.shooterStartPosition !== b.shooterStartPosition) return false;
    if (a.weaponStartPosition !== b.weaponStartPosition) return false;
    if (a.supportHand !== b.supportHand) return false;
    if (a.maxShotsPerFigure !== b.maxShotsPerFigure) return false;
    if ((a.targetGroups||[]).length !== (b.targetGroups||[]).length) return false;
    for (var g = 0; g < a.targetGroups.length; g++) {
        var ga = a.targetGroups[g], gb = b.targetGroups[g];
        if ((ga.figures||[]).length !== (gb.figures||[]).length) return false;
        for (var f = 0; f < ga.figures.length; f++) {
            var fa = ga.figures[f], fb = gb.figures[f];
            if (fa.isPoangmal !== fb.isPoangmal) return false;
            if (fa.behavior !== fb.behavior) return false;
        }
    }
    return true;
}

function faltCfgPrintStation(stationNum, wc) {
    var station = faltCfgData[wc]?.stations?.find(function(s){return s.station===stationNum;});
    if (!station) return;

    // Combine classes that share STRUCTURE — figures, behaviours, images. In
    // simple mode per-class params (Skjuttid, positions, Stödhand, Max skott)
    // are intentionally allowed to differ, so we use shape-equal there;
    // advanced mode keeps the stricter structural check (params must also
    // match) so its existing print behaviour is unchanged.
    var equalityFn = (faltCfgMode === 'simple') ? faltCfgShapeEqual : faltCfgStationsStructurallyEqual;
    var combinedClasses = {};  // { wc: stationConfig }
    faltCfgWeaponClasses.forEach(function(c) {
        var st = faltCfgData[c]?.stations?.find(function(s){return s.station===stationNum;});
        if (st && equalityFn(station, st)) combinedClasses[c] = st;
    });
    var classKeys = Object.keys(combinedClasses);
    var isCombined = classKeys.length > 1;

    // Group classes by the value of `field`. When all classes share the
    // same value, prefixes are dropped ("16 sek" instead of "A,B,C: 16 sek").
    function groupByField(classes, field, suffix) {
        suffix = suffix || '';
        var groups = {};
        var order = [];
        classes.forEach(function(c) {
            var val = combinedClasses[c][field];
            var key = (val == null || val === '') ? '—' : String(val);
            if (!groups[key]) { groups[key] = []; order.push(key); }
            groups[key].push(c);
        });
        if (order.length === 1) return order[0] + suffix;
        return order.map(function(k) { return groups[k].join(',') + ': ' + k + suffix; }).join(' &nbsp;|&nbsp; ');
    }

    var w = window.open('', '_blank');
    w.document.write('<html><head><title>Station ' + stationNum + (isCombined ? '' : ' \u2014 ' + wc) + '<' + '/title>');
    w.document.write('<style>');
    w.document.write('body{font-family:sans-serif;margin:30px;max-width:210mm}');
    w.document.write('h1{font-size:1.8em;border-bottom:3px solid #333;padding-bottom:8px}');
    w.document.write('.rules{background:#f0f0f0;padding:12px;border-radius:6px;margin:15px 0;font-size:0.95em}');
    w.document.write('.rules-shared{margin-bottom:4px}');
    w.document.write('.rules-tbl{border-collapse:collapse;margin-top:4px;font-size:0.95em}');
    w.document.write('.rules-tbl th,.rules-tbl td{padding:1px 10px 1px 0;text-align:left}');
    w.document.write('.rules-tbl th{font-weight:600;border-bottom:1px solid #888}');
    w.document.write('.rules-tbl td{border-bottom:1px solid #ddd}');
    w.document.write('.rules-tbl tr:last-child td{border-bottom:none}');
    w.document.write('.tg{border:2px solid #666;border-radius:8px;padding:15px;margin:20px 0;page-break-inside:avoid}');
    w.document.write('.tg h3{margin:0 0 10px;font-size:1.2em}');
    w.document.write('.tg-desc{font-style:italic;margin:10px 0;font-size:0.95em;line-height:1.4}');
    w.document.write('.tg-img{text-align:center;margin:10px 0}');
    w.document.write('.tg-img img{max-width:80%;max-height:200px;border-radius:6px}');
    w.document.write('.fig{margin:8px 0;padding:8px;background:#fafafa;border-radius:4px;display:flex;align-items:center;gap:12px}');
    w.document.write('.fig img{height:50px;border-radius:4px}');
    w.document.write('.fig-info{flex:1}');
    w.document.write('.pm-badge{background:#ffc107;color:#000;padding:2px 8px;border-radius:4px;font-weight:bold;font-size:0.85em}');
    w.document.write('.time-variants{margin:2px 0 2px 20px;font-size:0.9em;color:#444}');
    w.document.write('@@media print{body{margin:15mm}}');
    w.document.write('<' + '/style><' + '/head><body>');

    // Header
    if (isCombined) {
        w.document.write('<h1>Station ' + stationNum + '<' + '/h1>');
    } else {
        w.document.write('<h1>Station ' + stationNum + ' \u2014 Vapenklass ' + wc + '<' + '/h1>');
    }

    // Förutsättningar
    w.document.write('<div class="rules">');
    if (isCombined) {
        // Compact table layout: pull params that all classes share into a
        // single line above (saves vertical space + reduces visual noise),
        // and tabulate the varying ones with rows merged by full signature
        // so e.g. A,A_Opt,R collapse onto one row when their entire param
        // set matches.
        var fields = [
            { key: 'shootingTimeSec', label: 'Skjuttid', suffix: ' sek' },
            { key: 'shooterStartPosition', label: 'Utg\u00e5ngsl\u00e4ge' },
            { key: 'weaponStartPosition', label: 'Vapenl\u00e4ge' },
            { key: 'supportHand', label: 'St\u00f6dhand', descriptive: true }
        ];
        // Max skott column only when any class actually limits it (< 6).
        var anyMaxLimited = classKeys.some(function (c) {
            var v = combinedClasses[c].maxShotsPerFigure;
            return v && v < 6;
        });
        if (anyMaxLimited) fields.push({ key: 'maxShotsPerFigure', label: 'Max träff/fig' });

        var sharedFields = [];
        var varyingFields = [];
        fields.forEach(function (f) {
            var firstVal = combinedClasses[classKeys[0]][f.key];
            var allSame = classKeys.every(function (c) { return combinedClasses[c][f.key] === firstVal; });
            (allSame ? sharedFields : varyingFields).push(f);
        });

        if (sharedFields.length > 0) {
            var parts = sharedFields.map(function (f) {
                var v = combinedClasses[classKeys[0]][f.key];
                if (f.descriptive) return '<strong>' + v + '<' + '/strong>';
                return '<strong>' + f.label + ':<' + '/strong> ' + v + (f.suffix || '');
            });
            w.document.write('<div class="rules-shared">' + parts.join(' &nbsp;|&nbsp; ') + '<' + '/div>');
        }

        if (varyingFields.length > 0) {
            // Group classes by their full varying-field signature
            var sigGroups = {};
            var sigOrder = [];
            classKeys.forEach(function (c) {
                var sig = varyingFields.map(function (f) { return String(combinedClasses[c][f.key]); }).join('|');
                if (!sigGroups[sig]) { sigGroups[sig] = []; sigOrder.push(sig); }
                sigGroups[sig].push(c);
            });
            w.document.write('<table class="rules-tbl"><thead><tr><th>Vapenklass<' + '/th>');
            varyingFields.forEach(function (f) { w.document.write('<th>' + f.label + '<' + '/th>'); });
            w.document.write('<' + '/tr><' + '/thead><tbody>');
            sigOrder.forEach(function (sig) {
                w.document.write('<tr><td>' + sigGroups[sig].join(', ') + '<' + '/td>');
                varyingFields.forEach(function (f) {
                    var v = combinedClasses[sigGroups[sig][0]][f.key];
                    var cell = (v == null ? '' : v) + (f.suffix || '');
                    w.document.write('<td>' + cell + '<' + '/td>');
                });
                w.document.write('<' + '/tr>');
            });
            w.document.write('<' + '/tbody><' + '/table>');
        }
    } else {
        w.document.write('<strong>Skjuttid:<' + '/strong> ' + station.shootingTimeSec + ' sek');
        w.document.write(' &nbsp;|&nbsp; <strong>Utg\u00e5ngsl\u00e4ge:<' + '/strong> ' + station.shooterStartPosition);
        w.document.write(' &nbsp;|&nbsp; <strong>Vapenl\u00e4ge:<' + '/strong> ' + station.weaponStartPosition);
        w.document.write(' &nbsp;|&nbsp; <strong>' + station.supportHand + '<' + '/strong>');
        if (station.maxShotsPerFigure && station.maxShotsPerFigure < 6) w.document.write('<br><strong>Max träff/fig:<' + '/strong> ' + station.maxShotsPerFigure);
    }
    w.document.write('<' + '/div>');

    // Target groups and figures
    (station.targetGroups || []).forEach(function(tg, tgIdx) {
        var tgLetter = String.fromCharCode(64 + tg.group);
        w.document.write('<div class="tg">');
        w.document.write('<h3>M\u00e5lgrupp ' + tgLetter + '<' + '/h3>');
        if (tg.description) w.document.write('<div class="tg-desc">' + tg.description.replace(/\n/g, '<br>') + '<' + '/div>');
        if (tg.imageUrl) w.document.write('<div class="tg-img"><img src="' + tg.imageUrl + '" alt="M\u00e5lgrupp ' + tgLetter + '"><' + '/div>');
        (tg.figures || []).forEach(function(fig, fIdx) {
            w.document.write('<div class="fig">');
            if (fig.imageUrl) w.document.write('<img src="' + fig.imageUrl + '" alt="">');
            w.document.write('<div class="fig-info">');
            w.document.write('<strong>Figur ' + fig.figureNumber + '<' + '/strong>');
            if (fig.isPoangmal) w.document.write(' <span class="pm-badge">Po\u00e4ngr\u00e4kning<' + '/span>');

            // For moving figures in combined mode: show per-class timing
            if (isCombined && fig.behavior !== 'Fast') {
                w.document.write(' \u2014 ' + fig.behavior);
                // Group classes by their timing for this figure
                var timingGroups = {};
                classKeys.forEach(function(c) {
                    var cFig = combinedClasses[c].targetGroups[tgIdx].figures[fIdx];
                    var desc = faltDescribeBehavior(cFig);
                    // Strip the behavior name prefix since we already printed it
                    desc = desc.replace(/^(Framsv\u00e4ngande|Bortsv\u00e4ngande|R\u00f6rligt)/, '').replace(/^,\s*/, '');
                    if (!timingGroups[desc]) timingGroups[desc] = [];
                    timingGroups[desc].push(c);
                });
                var tKeys = Object.keys(timingGroups);
                if (tKeys.length === 1) {
                    // All classes have same timing — show once
                    if (tKeys[0]) w.document.write(', ' + tKeys[0]);
                } else {
                    // Different timing per class group
                    w.document.write('<br>');
                    tKeys.forEach(function(desc) {
                        w.document.write('<div class="time-variants">' + timingGroups[desc].join(',') + ': ' + (desc || 'inga tider') + '<' + '/div>');
                    });
                }
            } else {
                w.document.write(' \u2014 ' + faltDescribeBehavior(fig));
            }

            w.document.write('<' + '/div><' + '/div>');
        });
        w.document.write('<' + '/div>');
    });

    // QR code for station page
    var compId = faltCfgGetCompetitionId();
    if (compId) {
        var stationUrl = window.location.origin + '/station?c=' + compId + '&s=' + stationNum;
        var qrSrc = '/umbraco/surface/Faltskytte/GenerateQrCode?url=' + encodeURIComponent(stationUrl);
        w.document.write('<div style="margin-top:20px;text-align:center;page-break-inside:avoid">');
        w.document.write('<img src="' + qrSrc + '" alt="QR" style="width:120px;height:120px">');
        w.document.write('<div style="font-size:0.8em;color:#666;margin-top:4px">Skanna f\u00f6r stationsinfo<' + '/div>');
        w.document.write('<' + '/div>');
    }

    w.document.write('<' + '/body><' + '/html>');
    w.document.close();
    faltCfgPrintWhenReady(w);
}

function faltCfgPrintWhenReady(w) {
    var imgs = w.document.querySelectorAll('img');
    if (imgs.length === 0) { w.print(); return; }
    var remaining = imgs.length;
    function done() { remaining--; if (remaining <= 0) w.print(); }
    imgs.forEach(function(img) {
        if (img.complete) { done(); }
        else { img.onload = done; img.onerror = done; }
    });
}
</script>
