@*
 * Fältskytte Results Management
 * Admin overview: station entry + result list generation.
 *@

@* hpskEsc() — shooter and club names are member-supplied and are rendered into innerHTML
   and into document.write print windows here. Included by the PARTIAL rather than by the
   host page so the helper travels with the code that needs it and cannot be forgotten when
   this partial is added to a new surface. Guarded, so a double include is harmless. *@
@await Html.PartialAsync("_HtmlEscape")

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
    var competitionName = ViewData["CompetitionName"]?.ToString() ?? "Tävling";
    var subCompetitionName = ViewData["SubCompetitionName"]?.ToString() ?? "";
    var resultPageUrl = ViewData["ResultPageUrl"]?.ToString() ?? "";
}

<div class="faltskytte-results-management" data-competition-id="@competitionId" data-result-page-url="@resultPageUrl">

    <!-- Result List Card -->
    <div class="card mb-3">
        <div class="card-header" role="button" onclick="toggleFaltSection('faltResultBody', 'faltResultChevron')">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 d-inline"><i class="bi bi-trophy me-2"></i>Resultatlista</h5>
                    <span class="badge ms-2" id="faltResultStatusBadge">Preliminär</span>
                    <div class="text-muted small mt-1" id="faltResultMeta" style="display:none"></div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary btn-sm" onclick="faltRefreshResults(event)">
                        <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="faltShowMergeConfig(event)">
                        <i class="bi bi-intersect me-1"></i>Sammanslagning...
                    </button>
                    <button class="btn btn-outline-info btn-sm" onclick="faltPrintResultList(event)">
                        <i class="bi bi-printer me-1"></i>Skriv ut
                    </button>
                    <button class="btn btn-success btn-sm" id="faltPublishResultsBtn" style="display:none" onclick="faltPublishResults(true, event)">
                        <i class="bi bi-globe me-1"></i>Officiell
                    </button>
                    <button class="btn btn-outline-warning btn-sm" id="faltUnpublishResultsBtn" style="display:none" onclick="faltPublishResults(false, event)">
                        <i class="bi bi-eye-slash me-1"></i>Preliminär
                    </button>
                    <i class="bi bi-chevron-down" id="faltResultChevron"></i>
                </div>
            </div>
        </div>
        <div id="faltResultBody">
            <div class="card-body p-0">
                <div id="faltResultContent">
                    @if (!string.IsNullOrEmpty(resultPageUrl))
                    {
                        <iframe id="faltResultIframe"
                                src="@resultPageUrl"
                                title="Resultatlista"
                                style="width:100%; height:75vh; border:0; display:block"></iframe>
                    }
                    else
                    {
                        <div class="alert alert-info m-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Inga publicerade resultat ännu.</strong>
                            När resultaten är klara, klicka <strong>Officiell</strong> (eller <strong>Preliminär</strong>) här ovan för att publicera resultatlistan. Då skapas <code>/resultat/</code>-sidan och den visas här.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(subCompetitionName))
    {
    <!-- Sub-Competition Results — mirrors the main card's layout so the cashier / admin
         gets the same toolbar (Sammanslagning, Officiell/Preliminär, collapsible) for the
         Deltävling subset. Rendered inline (not via iframe like the main) because the
         backend already returns a fully-formed result payload with medals + merges, and
         the public /resultat/?sub=true page handles the equivalent for end users. -->
    <div class="card mt-3">
        <div class="card-header" role="button" onclick="toggleFaltSection('faltSubResultBody', 'faltSubResultChevron')">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 d-inline"><i class="bi bi-trophy me-2"></i>@subCompetitionName</h5>
                    <span class="badge ms-2" id="faltSubResultStatusBadge">Preliminär</span>
                    <div class="text-muted small mt-1" id="faltSubResultMeta" style="display:none"></div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary btn-sm" onclick="faltRefreshSubResults(event)">
                        <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="faltShowSubMergeConfig(event)">
                        <i class="bi bi-intersect me-1"></i>Sammanslagning...
                    </button>
                    <button class="btn btn-outline-info btn-sm" onclick="faltPrintSubCompResultList(event)">
                        <i class="bi bi-printer me-1"></i>Skriv ut
                    </button>
                    <button class="btn btn-success btn-sm" id="faltPublishSubResultsBtn" style="display:none" onclick="faltPublishSubResults(true, event)">
                        <i class="bi bi-globe me-1"></i>Officiell
                    </button>
                    <button class="btn btn-outline-warning btn-sm" id="faltUnpublishSubResultsBtn" style="display:none" onclick="faltPublishSubResults(false, event)">
                        <i class="bi bi-eye-slash me-1"></i>Preliminär
                    </button>
                    <i class="bi bi-chevron-down" id="faltSubResultChevron"></i>
                </div>
            </div>
        </div>
        <div id="faltSubResultBody">
            <div class="card-body p-0">
                <div id="faltSubCompResultContent">
                    @if (!string.IsNullOrEmpty(resultPageUrl))
                    {
                        <iframe id="faltSubResultIframe"
                                src="@(resultPageUrl + "?sub=true")"
                                title="Deltävlingsresultat"
                                style="width:100%; height:75vh; border:0; display:block"></iframe>
                    }
                    else
                    {
                        <div class="alert alert-info m-3 mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Inga publicerade resultat ännu.</strong>
                            Klicka <strong>Officiell</strong> ovan på huvudresultaten eller deltävlingen för att skapa <code>/resultat/</code>-sidan. Då visas deltävlingen här via iframe.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    }

    <!-- Särskjutning (shoot-off) section — auto-populates only when GetFaltskytteShootOffStatus
         returns tied medal-tier groups (championship + tied score at gold/silver/brons). Hidden
         for non-championship competitions and for classes without ties. -->
    <div class="mt-3" id="faltShootOffSection" style="display: none;">
        <div class="card border-info">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span class="fw-bold small"><i class="bi bi-bullseye me-2"></i>Särskjutning</span>
                <span class="badge bg-info-subtle text-info-emphasis" id="faltShootOffStatusBadge">Inga oavgjorda medaljplatser</span>
            </div>
            <div class="card-body py-3">
                <div class="mb-3 d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="faltOpenShootOffConfig()">
                        <i class="bi bi-gear me-1"></i>Konfigurera särskjutnings-stationer
                    </button>
                    <span class="text-muted small" id="faltShootOffConfigStatus">Inga särskjutnings-stationer konfigurerade ännu.</span>
                </div>
                <div id="faltShootOffBody">
                    <div class="text-muted small">Laddar...</div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(subCompetitionName))
    {
    <div class="mt-3" id="faltSubShootOffSection" style="display: none;">
        <div class="card border-info">
            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                <span class="fw-bold small"><i class="bi bi-bullseye me-2"></i>Särskjutning – @subCompetitionName</span>
                <span class="badge bg-info-subtle text-info-emphasis" id="faltSubShootOffStatusBadge">Inga oavgjorda medaljplatser</span>
            </div>
            <div class="card-body py-3">
                <div class="mb-3 d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="faltOpenShootOffConfig(true)">
                        <i class="bi bi-gear me-1"></i>Konfigurera särskjutnings-stationer
                    </button>
                    <span class="text-muted small" id="faltSubShootOffConfigStatus">Inga särskjutnings-stationer konfigurerade ännu.</span>
                </div>
                <div id="faltSubShootOffBody">
                    <div class="text-muted small">Laddar...</div>
                </div>
            </div>
        </div>
    </div>
    }
</div>

<!-- Särskjutning shot entry modal (Normal/Poäng = hits + figures + optional poängmål; Magnum = poängmål-only) -->
<div class="modal fade" id="faltShootOffEntryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-bullseye me-2"></i>
                    Särskjutning runda <span id="faltSoModalRound"></span> — <span id="faltSoModalShooter"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="faltSoModalBody">
                <input type="hidden" id="faltSoCompetitionId" />
                <input type="hidden" id="faltSoMemberId" />
                <input type="hidden" id="faltSoShootingClass" />
                <input type="hidden" id="faltSoRound" />
                <input type="hidden" id="faltSoIsSub" />
                <input type="hidden" id="faltSoVariation" />
                <div id="faltSoEntryRoot"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-success" id="faltSoSaveBtn">
                    <i class="bi bi-check-circle me-1"></i>Spara skott
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Särskjutning station-config modal -->
<div class="modal fade" id="faltShootOffConfigModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-gear me-2"></i>Konfigurera särskjutnings-stationer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="faltSoCfgIsSub" />
                <div class="alert alert-info small mb-3">
                    Välj en eller flera av tävlingens stationer som ska användas vid särskjutning.
                    Vid inmatning av varje runda väljer du sedan vilken station som användes för just den rundan.
                </div>

                <h6 class="mb-2">Valda särskjutnings-stationer</h6>
                <ul id="faltSoCfgList" class="list-group mb-3"></ul>

                <div class="d-flex gap-2 align-items-end">
                    <div class="flex-grow-1">
                        <label class="form-label mb-1">Lägg till station från tävlingen</label>
                        <select id="faltSoCfgAddSelect" class="form-select form-select-sm"></select>
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="faltSoCfgAddStation()">
                        <i class="bi bi-plus-circle me-1"></i>Lägg till
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="faltSoCfgSave()">Spara</button>
            </div>
        </div>
    </div>
</div>

<script>
function toggleFaltSection(bodyId, chevronId) {
    const body = document.getElementById(bodyId);
    const chevron = document.getElementById(chevronId);
    if (body.style.display === 'none') {
        body.style.display = '';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-up');
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-up');
        chevron.classList.add('bi-chevron-down');
    }
}

var _faltMergeConfig = null; // Current merge config JSON string
var _faltLastResults = null; // Last loaded results for printing

// Restore the iframe view in the result container after a merge-config UI session.
function faltRestoreIframe() {
    var container = document.getElementById('faltResultContent');
    if (!container) return;
    var url = document.querySelector('.faltskytte-results-management')?.dataset.resultPageUrl || '';
    if (!url) {
        // No /resultat/ page yet — keep the friendly "publicera först"-info that
        // was rendered server-side. (Don't overwrite it with an error.)
        return;
    }
    // Bust cache so the iframe reflects the latest official/preliminary state and any new merge config.
    var sep = url.indexOf('?') >= 0 ? '&' : '?';
    container.innerHTML = '<iframe id="faltResultIframe" src="' + url + sep + 't=' + Date.now() + '" title="Resultatlista" style="width:100%; height:75vh; border:0; display:block"></iframe>';
}

// Simple refresh — reload the embedded /resultat/ page.
async function faltRefreshResults(event) {
    if (event) event.stopPropagation();
    faltRestoreIframe();
    // Also pull current status (Officiell/Preliminär) so the badge stays in sync.
    var compId = document.querySelector('.faltskytte-results-management')?.dataset.competitionId;
    if (!compId) return;
    try {
        var resp = await fetch('/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=' + compId);
        var data = await resp.json();
        if (data && data.success && data.results) {
            faltUpdateResultStatus(!!data.results.isOfficial);
            faltUpdateResultMeta(data.results);
            _faltLastResults = data.results;
        }
    } catch (e) { /* status sync is best-effort */ }
    // Refresh the Särskjutning card after a result refresh.
    faltLoadShootOffStatus(false);
}

// Opens merge configuration flow
async function faltShowMergeConfig(event) {
    if (event) event.stopPropagation();
    const compId = document.querySelector('.faltskytte-results-management')?.dataset.competitionId;
    const container = document.getElementById('faltResultContent');

    container.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div> Analyserar klasser...</div>';
    document.getElementById('faltResultBody').style.display = '';

    try {
        var mergeResp = await fetch('/umbraco/surface/Faltskytte/AnalyzeFaltskytteMerges?competitionId=' + compId);
        var mergeData = await mergeResp.json();

        if (mergeData.success && mergeData.analysis) {
            _faltMergeConfig = mergeData.savedConfig || null;
            if (mergeData.analysis.suggestions && mergeData.analysis.suggestions.length > 0) {
                faltShowMergeModal(mergeData.analysis, mergeData.savedConfig);
            } else {
                container.innerHTML = '<div class="alert alert-info m-3">Alla klasser har 5 eller fler deltagare — ingen sammanslagning behövs.</div>';
                setTimeout(function() { faltRestoreIframe(); }, 1500);
            }
        }
    } catch (err) {
        container.innerHTML = '<div class="alert alert-danger">Nätverksfel.</div>';
        console.error(err);
    }
}

function faltShowMergeModal(analysis, savedConfig) {
    var savedActions = [];
    if (savedConfig) try { savedActions = JSON.parse(savedConfig); } catch(e) {}
    var savedMap = {};
    savedActions.forEach(function(a) { savedMap[a.sourceClass] = a.targetClass; });

    var html = '<div class="mb-3"><p class="small text-muted">Följande klasser har färre än 5 deltagare och kan slås samman:</p></div>';
    analysis.suggestions.forEach(function(s) {
        var checked = savedMap[s.sourceClass] ? ' checked' : '';
        var targetVal = savedMap[s.sourceClass] || s.defaultTarget || '';
        var targetHtml = '';
        if (s.requiresAdminChoice && s.possibleTargets && s.possibleTargets.length > 0) {
            targetHtml = '<select class="form-select form-select-sm d-inline-block falt-merge-target" data-source="' + s.sourceClass + '" style="width:auto">';
            s.possibleTargets.forEach(function(t) {
                targetHtml += '<option value="' + t + '"' + (t === targetVal ? ' selected' : '') + '>' + t + '</option>';
            });
            targetHtml += '</select>';
        } else {
            targetHtml = '<strong>' + (s.defaultTarget || '') + '</strong>';
        }
        html += '<div class="form-check mb-2">' +
            '<input class="form-check-input falt-merge-check" type="checkbox" value="' + s.sourceClass + '"' +
            ' data-target="' + targetVal + '"' + checked + '>' +
            '<label class="form-check-label">' +
            '<strong>' + s.sourceClass + '</strong> (' + s.sourceCount + ' st) → ' + targetHtml +
            '<br><small class="text-muted">' + s.reason + '</small></label></div>';
    });

    // Show classes info
    html += '<div class="mt-3 small"><table class="table table-sm"><thead><tr><th>Klass</th><th>Antal</th><th>Medaljer</th></tr></thead><tbody>';
    analysis.classes.forEach(function(c) {
        html += '<tr class="' + (c.belowThreshold ? 'table-warning' : '') + '">' +
            '<td>' + c.className + '</td><td>' + c.participantCount + '</td><td>' + (c.medalImpact || 'Alla') + '</td></tr>';
    });
    html += '</tbody></table></div>';

    var container = document.getElementById('faltResultContent');
    container.innerHTML = '<div class="card"><div class="card-header"><strong>Sammanslagning av klasser</strong></div>' +
        '<div class="card-body">' + html +
        '<div class="d-flex gap-2 mt-3">' +
        '<button class="btn btn-primary" onclick="faltApplyMerges()"><i class="bi bi-check-lg me-1"></i>Skapa med sammanslagning</button>' +
        '<button class="btn btn-outline-secondary" onclick="faltSkipMerges()">Skapa utan sammanslagning</button>' +
        '</div></div></div>';
}

window.faltApplyMerges = async function() {
    var actions = [];
    document.querySelectorAll('.falt-merge-check:checked').forEach(function(cb) {
        var source = cb.value;
        // Check if there's a dropdown for this source (admin choice)
        var dropdown = document.querySelector('.falt-merge-target[data-source="' + source + '"]');
        var target = dropdown ? dropdown.value : cb.dataset.target;
        if (target) actions.push({ sourceClass: source, targetClass: target });
    });
    _faltMergeConfig = actions.length > 0 ? JSON.stringify(actions) : null;

    // Save merge config to competition
    var compId = document.querySelector('.faltskytte-results-management')?.dataset.competitionId;
    if (_faltMergeConfig) {
        await fetch('/umbraco/surface/Faltskytte/SaveMergeConfig', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
            body: JSON.stringify({ competitionId: parseInt(compId), mergeConfig: _faltMergeConfig })
        });
    }

    faltRestoreIframe();
    await faltRefreshResults();
};

window.faltSkipMerges = async function() {
    _faltMergeConfig = null;
    var compId = document.querySelector('.faltskytte-results-management')?.dataset.competitionId;
    // Clear saved merge config
    await fetch('/umbraco/surface/Faltskytte/SaveMergeConfig', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
        body: JSON.stringify({ competitionId: parseInt(compId), mergeConfig: '' })
    });
    faltRestoreIframe();
    await faltRefreshResults();
};

async function faltLoadResults(compId, container) {
    container.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div> Genererar...</div>';
    try {
        var url = '/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=' + compId;
        if (_faltMergeConfig) url += '&mergeConfig=' + encodeURIComponent(_faltMergeConfig);
        const resp = await fetch(url);
        const data = await resp.json();

        if (!data.success) {
            container.innerHTML = '<div class="alert alert-warning">' + (data.message || 'Inga resultat.') + '</div>';
            faltUpdateResultStatus(false);
            return;
        }

        _faltLastResults = data.results;
        faltUpdateResultStatus(data.results.isOfficial);
        faltUpdateResultMeta(data.results);
        renderFaltResultList(data.results, container);
    } catch (err) {
        container.innerHTML = '<div class="alert alert-danger">Nätverksfel vid hämtning av resultat.</div>';
        console.error(err);
    }
}

function faltUpdateResultMeta(results) {
    var el = document.getElementById('faltResultMeta');
    if (!el) return;
    var parts = [];
    if (results.competitionName) parts.push(results.competitionName);
    if (results.competitionDate) parts.push(results.competitionDate);
    if (results.organizerName) parts.push(results.organizerName);
    if (parts.length === 0) { el.style.display = 'none'; return; }
    el.textContent = parts.join(' · ');
    el.style.display = '';
}

function faltUpdateResultStatus(isOfficial) {
    var badge = document.getElementById('faltResultStatusBadge');
    var pubBtn = document.getElementById('faltPublishResultsBtn');
    var unpubBtn = document.getElementById('faltUnpublishResultsBtn');
    if (isOfficial) {
        badge.className = 'badge bg-success ms-2'; badge.textContent = 'Officiell';
        pubBtn.style.display = 'none'; unpubBtn.style.display = '';
    } else {
        badge.className = 'badge bg-warning text-dark ms-2'; badge.textContent = 'Preliminär';
        pubBtn.style.display = ''; unpubBtn.style.display = 'none';
    }
}

async function faltPublishResults(official, event) {
    if (event) event.stopPropagation();
    var msg = official ? 'Markera resultatlistan som officiell?' : 'Ändra resultatlistan till preliminär?';
    if (!confirm(msg)) return;
    var compId = document.querySelector('.faltskytte-results-management')?.dataset.competitionId;
    try {
        var resp = await fetch('/umbraco/surface/Faltskytte/PublishResults', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
            body: JSON.stringify({ competitionId: parseInt(compId), isOfficial: official })
        });
        var data = await resp.json();
        if (data.success) {
            faltUpdateResultStatus(official);
            // First publish creates the /resultat/ page node on the server, which means
            // the data-result-page-url attribute is still empty client-side. A full
            // reload picks up the new URL and swaps the inline info-message for the
            // iframe. Subsequent publishes just refresh the existing iframe to update
            // the Officiell/Preliminär badge inside it.
            var hadUrl = !!document.querySelector('.faltskytte-results-management')?.dataset.resultPageUrl;
            if (hadUrl) {
                faltRestoreIframe();
            } else {
                window.location.reload();
            }
        }
        else alert('Fel: ' + (data.message || 'Okänt fel'));
    } catch(e) { alert('Nätverksfel.'); }
}

function faltExtractStationConfigs(results) {
    // Build station configs array from the full config object
    var configs = [];
    var wc = results.config?.weaponConfigs || results.config?.WeaponConfigs || {};
    var firstWc = Object.values(wc)[0];
    if (firstWc) {
        (firstWc.stations || firstWc.Stations || []).forEach(function(st) {
            var stNum = st.station || st.Station;
            var hasPm = false;
            (st.targetGroups || st.TargetGroups || []).forEach(function(tg) {
                (tg.figures || tg.Figures || []).forEach(function(fig) {
                    if (fig.isPoangmal || fig.IsPoangmal) hasPm = true;
                });
            });
            configs.push({ station: stNum, hasPoangmal: hasPm });
        });
    }
    return configs;
}

function renderFaltResultList(results, container) {
    const isPoang = results.scoringMode === 'Poang';
    const stationConfigs = faltExtractStationConfigs(results);
    let html = '';

    results.classGroups.forEach(group => {
        html += `<h5 class="mt-4 mb-2">${group.className} (${group.shooters.length} deltagare)</h5>`;
        html += '<div class="table-responsive"><table class="table table-sm table-striped">';
        html += '<thead><tr><th>Plats</th><th>Namn</th><th>Förening</th><th>Klass</th>';

        // Station headers
        for (let i = 1; i <= results.stationCount; i++) {
            const cfg = stationConfigs.find(s => s.station === i);
            html += `<th class="text-center">${i}${cfg?.hasPoangmal ? '*' : ''}</th>`;
        }

        if (isPoang) {
            html += '<th class="text-center fw-bold">Poäng</th>';
        } else {
            html += '<th class="text-center fw-bold">Träff/Fig</th>';
        }
        html += '<th class="text-center">Pm</th><th class="text-center">Std</th></tr></thead><tbody>';

        group.shooters.forEach((shooter, idx) => {
            html += `<tr>
                <td class="text-center">${idx + 1}</td>
                <td>${hpskEsc(shooter.name)}</td>
                <td>${hpskEsc(shooter.club)}</td>
                <td class="text-center">${shooter.shootingClass}</td>`;

            // Station results
            for (let i = 1; i <= results.stationCount; i++) {
                const st = shooter.stations.find(s => s.stationNumber === i);
                if (st) {
                    let cellText = `${st.hits}/${st.figures}`;
                    if (st.tiebreakerScore != null) cellText += ` <small class="text-muted">${st.tiebreakerScore}p</small>`;
                    html += `<td class="text-center">${cellText}</td>`;
                } else {
                    html += '<td class="text-center text-muted">-</td>';
                }
            }

            // Total
            if (isPoang) {
                html += `<td class="text-center fw-bold">${shooter.totalPoints}</td>`;
            } else {
                html += `<td class="text-center fw-bold">${shooter.totalHits}/${shooter.totalFigures}</td>`;
            }

            // Poångmål total
            html += `<td class="text-center">${shooter.totalTiebreakerScore || ''}</td>`;
            // Standard medal
            var stdMedal = shooter.standardMedal || '';
            html += `<td class="text-center fw-bold${stdMedal === 'S' ? ' text-primary' : stdMedal === 'B' ? ' text-warning' : ''}">${stdMedal}</td>`;
            html += '</tr>';
        });

        html += '</tbody></table></div>';
    });

    if (!html) html = '<div class="alert alert-info">Inga resultat att visa.</div>';
    container.innerHTML = html;
}

function faltPrintResultList(event) {
    if (event) event.stopPropagation();
    var results = _faltLastResults;
    if (!results || !results.classGroups || results.classGroups.length === 0) {
        alert('Inga resultat att skriva ut. Klicka Uppdatera först.');
        return;
    }

    var isPoang = results.scoringMode === 'Poang';
    var stationConfigs = faltExtractStationConfigs(results);
    var statusText = results.isOfficial ? 'Officiell' : 'Preliminär';
    var awardingMedals = results.isAwardingStandardMedals === true;

    // Build a proper header — competition name as the main title, then a meta
    // line with date / organiser / "Resultatlista" / status, mirroring what the
    // Precision result page surfaces. Falls back gracefully if any field is
    // missing (older cached responses, locally unset organiser, etc.).
    var compName = results.competitionName || '';
    var compDate = results.competitionDate || '';
    var organizer = results.organizerName || '';
    var metaParts = [];
    if (compDate) metaParts.push(compDate);
    if (organizer) metaParts.push(organizer);
    metaParts.push('Resultatlista');
    metaParts.push(statusText);
    var metaLine = metaParts.join(' · ');

    var pad2 = function(n) { return n < 10 ? '0' + n : n; };
    var now = new Date();
    var printedAt = now.getFullYear() + '-' + pad2(now.getMonth() + 1) + '-' + pad2(now.getDate())
        + ' ' + pad2(now.getHours()) + ':' + pad2(now.getMinutes());

    var titleText = compName ? compName + ' — Resultatlista' : 'Resultatlista';

    var w = window.open('', '_blank');
