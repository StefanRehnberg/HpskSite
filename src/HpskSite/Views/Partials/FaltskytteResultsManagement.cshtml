    w.document.write('th,td{padding:2px 4px;text-align:center;border:1px solid #ddd;white-space:nowrap}');
    w.document.write('th{background:#f0f0f0;font-size:0.9em}');
    w.document.write('td:nth-child(2),td:nth-child(3){text-align:left}');
    w.document.write('th:nth-child(2),th:nth-child(3){text-align:left}');
    w.document.write('.medal-s{color:#0d6efd;font-weight:bold}');
    w.document.write('.medal-b{color:#ffc107;font-weight:bold}');
    w.document.write('.print-footer{margin-top:18px;font-size:0.8em;color:#666;border-top:1px solid #ccc;padding-top:6px;text-align:right}');
    w.document.write('@@media print{body{margin:10mm}h2{page-break-after:avoid}table{page-break-inside:avoid}}');
    w.document.write('<' + '/style><' + '/head><body>');
    w.document.write('<h1>' + (compName || 'Resultatlista') + '<' + '/h1>');
    w.document.write('<div class="meta">' + metaLine + '<' + '/div>');

    results.classGroups.forEach(function(group) {
        // className can carry an admin-edited override (classNameOverrides), so it is user text too.
        w.document.write('<h2>' + hpskEsc(group.className) + ' (' + group.shooters.length + ' deltagare)</h2>');
        w.document.write('<table><thead><tr><th>Pl</th><th>Namn</th><th>F\u00f6rening</th><th>Klass</th>');
        for (var i = 1; i <= results.stationCount; i++) {
            var cfg = stationConfigs.find(function(s){return s.station===i;});
            w.document.write('<th>' + i + (cfg && cfg.hasPoangmal ? '*' : '') + '</th>');
        }
        w.document.write(isPoang ? '<th><b>Po\u00e4ng</b></th>' : '<th><b>Tot</b></th>');
        w.document.write('<th>Pm</th>');
        if (awardingMedals) w.document.write('<th>Std</th>');
        w.document.write('</tr></thead><tbody>');

        group.shooters.forEach(function(shooter, idx) {
            w.document.write('<tr><td>' + (idx+1) + '</td>');
            w.document.write('<td>' + hpskEsc(shooter.name) + '</td>');
            w.document.write('<td>' + hpskEsc(shooter.club) + '</td>');
            w.document.write('<td>' + hpskEsc(shooter.shootingClass) + '</td>');
            for (var i = 1; i <= results.stationCount; i++) {
                var st = shooter.stations.find(function(s){return s.stationNumber===i;});
                if (st) {
                    var cell = st.hits + '/' + st.figures;
                    if (st.tiebreakerScore != null) cell += ' ' + st.tiebreakerScore + 'p';
                    w.document.write('<td>' + cell + '</td>');
                } else {
                    w.document.write('<td>-</td>');
                }
            }
            w.document.write(isPoang
                ? '<td><b>' + shooter.totalPoints + '</b></td>'
                : '<td><b>' + shooter.totalHits + '/' + shooter.totalFigures + '</b></td>');
            w.document.write('<td>' + (shooter.totalTiebreakerScore || '') + '</td>');
            if (awardingMedals) {
                var sm = shooter.standardMedal || '';
                w.document.write('<td class="' + (sm==='S'?'medal-s':sm==='B'?'medal-b':'') + '">' + sm + '</td>');
            }
            w.document.write('</tr>');
        });

        w.document.write('</tbody></table>');
    });

    w.document.write('<div class="print-footer">Utskriven: ' + printedAt + '<' + '/div>');
    w.document.write('<' + '/body><' + '/html>');
    w.document.close();
    w.print();
}

// On page load: the iframe loads /resultat/ on its own, so we only need to sync the
// status badge + meta line (Officiell/Preliminär, comp date etc.) and the sub-comp panel.
(function() {
    var compId = document.querySelector('.faltskytte-results-management')?.dataset.competitionId;
    if (compId) {
        fetch('/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=' + compId)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success && data.results) {
                    faltUpdateResultStatus(!!data.results.isOfficial);
                    faltUpdateResultMeta(data.results);
                    _faltLastResults = data.results;
                }
            })
            .catch(function() { /* best-effort */ });
        // Also populate the Särskjutning card so it appears on initial load when the
        // competition is a championship and tied medal positions already exist —
        // without this, the card only shows after the admin clicks Uppdatera.
        faltLoadShootOffStatus(false);
    }
    // Auto-sync sub-competition status badge if configured. The iframe loads its own
    // content from /resultat/?sub=true; we only need the JSON to keep the badge + meta
    // in sync and to populate _faltSubCompResults for the Skriv ut button.
    if (compId && document.getElementById('faltSubResultStatusBadge')) {
        fetch('/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=' + compId + '&subCompetitionOnly=true')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data && data.success && data.results) {
                    faltUpdateSubResultStatus(!!data.results.isOfficial);
                    faltUpdateSubResultMeta(data.results);
                    _faltSubCompResults = data.results;
                }
            })
            .catch(function() { /* best-effort */ });
        faltLoadShootOffStatus(true);
    }
})();

