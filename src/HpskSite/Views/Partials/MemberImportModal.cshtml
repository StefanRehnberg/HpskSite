@*
 * Member Import Modal (Svenska Lag → pistol.nu)
 * Two-step: upload+preview (column mapping) → import (commit).
 * Self-contained Bootstrap modal + vanilla JS. Uses the club id set via
 * openMemberImportModal(clubId, clubName). @Html.Partial this into a club-admin page,
 * and ensure @Html.AntiForgeryToken() is rendered somewhere on that page.
 *@

<div class="modal fade" id="memberImportModal" tabindex="-1" aria-labelledby="memberImportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="memberImportModalLabel">
                    <i class="bi bi-upload me-2"></i>Importera medlemmar
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="mi_clubId" value="0">

                <!-- Step 1: Upload -->
                <div id="mi_step_upload">
                    <p class="mb-3">
                        Ladda upp en export från exempelvis Svenska Lag (<strong>.xlsx</strong> eller <strong>.csv</strong>) för
                        <strong id="mi_clubName"></strong>. Kolumnerna matchas automatiskt — du kan justera innan import.
                    </p>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-envelope me-1"></i><strong>E-post krävs för varje medlem</strong> — det är medlemmens inloggning.
                        Rader utan giltig e-post kan bara uppdatera befintliga medlemmar (matchade via personnummer), inte skapa nya.
                        Se till att exporten innehåller kolumnen "E-post".
                    </p>
                    <div class="mb-3">
                        <label for="mi_file" class="form-label">Välj fil</label>
                        <input type="file" class="form-control" id="mi_file" accept=".xlsx,.csv">
                        <small class="form-text text-muted">Max 15 MB. Tips: bocka i "Personnummer" som Ordinarie fält i Svenska Lag-exporten.</small>
                    </div>
                    <button type="button" class="btn btn-primary" id="mi_previewBtn" onclick="miPreview()">
                        <i class="bi bi-search me-1"></i>Ladda upp &amp; förhandsgranska
                    </button>
                </div>

                <!-- Step 2: Mapping -->
                <div id="mi_step_mapping" style="display:none;">
                    <div class="alert alert-info d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-info-circle me-1"></i><strong id="mi_totalRows">0</strong> rader hittades. Kontrollera kolumnmatchningen nedan.</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="miResetToUpload()">
                            <i class="bi bi-arrow-left me-1"></i>Välj annan fil
                        </button>
                    </div>
                    <div id="mi_emailReport" class="alert small" style="display:none;"></div>
                    <div id="mi_targetHint" class="alert alert-info small" style="display:none;"></div>
                    @* Blocking browser dialogs (alert/confirm) freeze the tab and read as a hang,
                       so every warning that needs an answer is rendered here instead. *@
                    <div id="mi_confirmPanel" class="alert alert-danger" style="display:none;">
                        <h6 class="mb-2"><i class="bi bi-exclamation-octagon me-1"></i>Kontrollera innan du fortsätter</h6>
                        <div id="mi_confirmText" class="mb-3 small"></div>
                        <button type="button" class="btn btn-sm btn-danger" id="mi_confirmProceed">
                            <i class="bi bi-check2 me-1"></i>Importera ändå
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="miHideConfirm()">
                            Avbryt
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead>
                                <tr>
                                    <th style="min-width:180px;">Kolumn i filen</th>
                                    <th>Exempelvärde</th>
                                    <th style="min-width:220px;">Importera till fält</th>
                                </tr>
                            </thead>
                            <tbody id="mi_mappingBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- Step 3: Result -->
                <div id="mi_step_result" style="display:none;">
                    <div id="mi_resultSummary"></div>
                    <div id="mi_resultErrors"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Stäng
                </button>
                <button type="button" class="btn btn-success" id="mi_importBtn" style="display:none;" onclick="miCommit()">
                    <i class="bi bi-download me-1"></i>Importera
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    // Parsed-file state kept between Preview and Commit.
    var miState = {
        headers: [],
        rows: [],
        sampleRows: [],
        suggestedMapping: {},
        targetFields: []
    };

    function miToken() {
        if (typeof getAntiForgeryToken === 'function') {
            try { return getAntiForgeryToken(); } catch (e) { /* fall through */ }
        }
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function miEl(id) { return document.getElementById(id); }

    function miEscape(s) {
        if (s === null || s === undefined) return '';
        return String(s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    window.openMemberImportModal = function (clubId, clubName) {
        miEl('mi_clubId').value = clubId;
        miEl('mi_clubName').textContent = clubName || '';
        miEl('mi_file').value = '';
        miResetToUpload();
        var modal = new bootstrap.Modal(miEl('memberImportModal'));
        modal.show();
    };

    window.miResetToUpload = function () {
        miEl('mi_step_upload').style.display = '';
        miEl('mi_step_mapping').style.display = 'none';
        miEl('mi_step_result').style.display = 'none';
        miEl('mi_importBtn').style.display = 'none';
        miEl('mi_mappingBody').innerHTML = '';
        miHideConfirm();
    };

    window.miPreview = function () {
        var fileInput = miEl('mi_file');
        if (!fileInput.files || fileInput.files.length === 0) {
            alert('Välj en fil att ladda upp.');
            return;
        }
        var file = fileInput.files[0];
        if (file.size > 15 * 1024 * 1024) {
            alert('Filen är för stor. Max 15 MB.');
            return;
        }

        var fd = new FormData();
        fd.append('clubId', miEl('mi_clubId').value);
        fd.append('file', file);

        var btn = miEl('mi_previewBtn');
        var orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Läser in...';

        fetch('/umbraco/surface/MemberImport/Preview', {
            method: 'POST',
            headers: { 'RequestVerificationToken': miToken() },
            body: fd
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            btn.disabled = false;
            btn.innerHTML = orig;
            if (!data.success) {
                alert('Fel: ' + (data.message || 'Okänt fel'));
                return;
            }
            miState.headers = data.headers || [];
            miState.rows = data.rows || [];
            miState.sampleRows = data.sampleRows || [];
            miState.suggestedMapping = data.suggestedMapping || {};
            miState.targetFields = data.targetFields || [];
            miRenderMapping(data.totalRows || miState.rows.length);
        })
        .catch(function (err) {
            btn.disabled = false;
            btn.innerHTML = orig;
            console.error('Preview error:', err);
            alert('Fel vid inläsning: ' + err.message);
        });
    };

    function miSampleValue(header) {
        for (var r = 0; r < miState.sampleRows.length; r++) {
            var v = miState.sampleRows[r][header];
            if (v !== undefined && v !== null && String(v).trim() !== '') {
                return String(v);
            }
        }
        return '';
    }

    function miBuildSelect(header) {
        var selected = miState.suggestedMapping[header] || '';
        var html = '<select class="form-select form-select-sm mi-map-select" onchange="miOnMappingChange()" data-header="' + miEscape(header) + '">';
        for (var i = 0; i < miState.targetFields.length; i++) {
            var tf = miState.targetFields[i];
            var isSel = (tf.alias === selected) ? ' selected' : '';
            html += '<option value="' + miEscape(tf.alias) + '"' + isSel + '>' + miEscape(tf.label) + '</option>';
        }
        html += '</select>';
        return html;
    }

    function miRenderMapping(totalRows) {
        miEl('mi_totalRows').textContent = totalRows;

        var body = miEl('mi_mappingBody');
        var rowsHtml = '';
        for (var i = 0; i < miState.headers.length; i++) {
            var header = miState.headers[i];
            var sample = miSampleValue(header);
            rowsHtml += '<tr>' +
                '<td><strong>' + miEscape(header) + '</strong></td>' +
                '<td class="text-muted"><small>' + miEscape(sample) + '</small></td>' +
                '<td>' + miBuildSelect(header) + '</td>' +
                '</tr>';
        }
        body.innerHTML = rowsHtml;

        miEl('mi_step_upload').style.display = 'none';
        miEl('mi_step_mapping').style.display = '';
        miEl('mi_step_result').style.display = 'none';
        miEl('mi_importBtn').style.display = '';
        miOnMappingChange(); // reflect any auto-suggested Guldmärke mapping in the hint
    }

    // Contextual explanation of the two-part Guldmärke mapping (number vs award date/year).
    window.miOnMappingChange = function () {
        var hint = miEl('mi_targetHint');
        if (!hint) return;
        var selects = document.querySelectorAll('#mi_mappingBody .mi-map-select');
        var hasNumber = false, hasDate = false;
        selects.forEach(function (s) {
            if (s.value === 'guldmarkeNumber') hasNumber = true;
            if (s.value === 'guldmarkeAwarded') hasDate = true;
        });
        var msg = '';
        if (hasNumber && hasDate) {
            msg = '<strong>Guldmärke:</strong> både numret och tilldelningsår/datum är mappade — ett riktigt Guldmärke skapas i medlemmens märkesregister (med guldnummer och år).';
        } else if (hasNumber) {
            msg = '<strong>Guldmärke:</strong> bara numret är mappat — det sparas som en <em>anteckning</em> på klubbmedlemskapet. Inget märke skapas, eftersom systemet behöver ett tilldelningsår (för Guldfodring/årtalsmärke). Mappa även en kolumn med år eller datum för att skapa ett riktigt Guldmärke.';
        } else if (hasDate) {
            msg = '<strong>Guldmärke tilldelad (år/datum):</strong> mappa även kolumnen med guldmärkesnumret — datum utan nummer gör ingenting.';
        }
        if (msg) {
            hint.innerHTML = '<i class="bi bi-info-circle me-1"></i>' + msg;
            hint.style.display = '';
        } else {
            hint.style.display = 'none';
        }

        miUpdateEmailReport();
    };

    // Keep in sync with NormalizeEmail() in MemberImportController.cs — strips wrapping
    // quotes/angle brackets and leading/trailing list punctuation. A trailing ';' inside the
    // quoted cell ("a@@b.se;") is what broke the 2026-08-21 import: it matched no existing
    // member, so everyone was created again as a duplicate.
    function miNormalizeEmail(s) {
        var v = String(s == null ? '' : s).trim();
        if (v.length >= 2) {
            var f = v.charAt(0), l = v.charAt(v.length - 1);
            if ((f === '"' && l === '"') || (f === "'" && l === "'") || (f === '<' && l === '>')) {
                v = v.substring(1, v.length - 1).trim();
            }
        }
        // Trim the same character set as String.Trim(';', ',', ':', '.', '"', '\'', '<', '>', ' ', '\t').
        return v.replace(/^[;,:."'<>\s]+/, '').replace(/[;,:."'<>\s]+$/, '');
    }

    // Keep in sync with IsValidEmail() + EmailForbiddenChars in MemberImportController.cs.
    // Run on the NORMALIZED value. A separator still left in the middle ("a@@b.se;c@@d.se")
    // is intentionally invalid rather than guessed at.
    // NB: in this .cshtml the literal at-sign must be doubled (@@) so Razor does not
    // read it as a code transition; it renders to a single at-sign in the output JS.
    function miIsValidEmail(s) {
        return /^[^@@\s;,:"<>()\[\]\\]+@@[^@@\s;,:"<>()\[\]\\]+\.[^@@\s;,:"<>()\[\]\\]+$/
            .test(String(s).trim());
    }

    // First non-blank value across the email-mapped column(s) for a row.
    function miEmailForRow(row, headers) {
        for (var i = 0; i < headers.length; i++) {
            var v = row[headers[i]];
            if (v !== undefined && v !== null && String(v).trim() !== '') {
                return String(v).trim();
            }
        }
        return '';
    }

    // Banner summarising how many rows lack a valid email (= login) before import.
    window.miUpdateEmailReport = function () {
        var el = miEl('mi_emailReport');
        if (!el) return;

        var emailHeaders = [];
        var selects = document.querySelectorAll('#mi_mappingBody .mi-map-select');
        selects.forEach(function (s) {
            if (s.value === 'email') emailHeaders.push(s.getAttribute('data-header'));
        });

        if (emailHeaders.length === 0) {
            el.className = 'alert alert-warning small';
            el.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>' +
                '<strong>Ingen kolumn är mappad till E-post.</strong> E-post är medlemmens inloggning och krävs för att ' +
                'skapa nya medlemmar. Utan e-post kan bara befintliga medlemmar (matchade via personnummer) uppdateras.';
            el.style.display = '';
            return;
        }

        var total = miState.rows.length;
        var missing = 0, invalid = 0, cleaned = 0, cleanedExample = '';
        for (var i = 0; i < miState.rows.length; i++) {
            var raw = miEmailForRow(miState.rows[i], emailHeaders);
            var val = miNormalizeEmail(raw);
            if (raw !== '' && val !== raw) {
                cleaned++;
                if (!cleanedExample) cleanedExample = raw;
            }
            if (val === '') { missing++; }
            else if (!miIsValidEmail(val)) { invalid++; }
        }

        // Surfaced on its own: a cell needing cleanup is the signature of the export bug that
        // caused 141 duplicates. Cleaning makes the match work, but the admin should still see it.
        var cleanedNote = '';
        if (cleaned > 0) {
            cleanedNote = '<div class="mt-2"><i class="bi bi-scissors me-1"></i>' +
                '<strong>' + cleaned + '</strong> e-postcell' + (cleaned === 1 ? '' : 'er') +
                ' har extra tecken runt adressen (t.ex. <code>' + miEscape(cleanedExample) + '</code>). ' +
                'De städas automatiskt före matchningen.</div>';
        }

        var bad = missing + invalid;
        if (bad === 0) {
            el.className = cleaned > 0 ? 'alert alert-info small' : 'alert alert-success small';
            el.innerHTML = '<i class="bi bi-check-circle me-1"></i>Alla <strong>' + total +
                '</strong> rader har en giltig e-postadress.' + cleanedNote;
            el.style.display = '';
            return;
        }

        var parts = [];
        if (missing > 0) parts.push('<strong>' + missing + '</strong> saknar e-post');
        if (invalid > 0) parts.push('<strong>' + invalid + '</strong> har ogiltig e-post');
        el.className = 'alert alert-warning small';
        el.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>' +
            parts.join(' och ') + ' (av <strong>' + total + '</strong> rader). ' +
            'E-post är inloggningen — dessa rader kan <strong>inte skapas som nya medlemmar</strong> och hoppas över. ' +
            'Rader som matchar en befintlig medlem via personnummer uppdateras ändå.' + cleanedNote;
        el.style.display = '';
    };

    // In-modal confirmation. onProceed runs when the admin accepts.
    function miShowConfirm(html, onProceed) {
        var panel = miEl('mi_confirmPanel');
        miEl('mi_confirmText').innerHTML = html;
        var btn = miEl('mi_confirmProceed');
        // Replace the node so a previous handler can never fire for a new question.
        var fresh = btn.cloneNode(true);
        btn.parentNode.replaceChild(fresh, btn);
        fresh.addEventListener('click', function () {
            miHideConfirm();
            onProceed();
        });
        panel.style.display = '';
        panel.scrollIntoView({ block: 'nearest' });
    }

    window.miHideConfirm = function () {
        miEl('mi_confirmPanel').style.display = 'none';
        miEl('mi_confirmProceed').style.display = '';
    };

    // Same panel, no way forward — for a failure the admin can't override.
    function miShowConfirmError(message) {
        var panel = miEl('mi_confirmPanel');
        miEl('mi_confirmText').innerHTML =
            '<strong>Importen kunde inte genomföras.</strong><br>' + miEscape(message);
        miEl('mi_confirmProceed').style.display = 'none';
        panel.style.display = '';
        panel.scrollIntoView({ block: 'nearest' });
    }

    function miCollectMapping() {
        var mapping = {};
        var selects = document.querySelectorAll('#mi_mappingBody .mi-map-select');
        selects.forEach(function (sel) {
            var header = sel.getAttribute('data-header');
            mapping[header] = sel.value || '';
        });
        return mapping;
    }

    window.miCommit = function (force) {
        var mapping = miCollectMapping();

        // Sanity: require at least an email OR personnummer target so rows can be resolved.
        var aliases = Object.keys(mapping).map(function (k) { return mapping[k]; });
        if (!force && aliases.indexOf('email') === -1 && aliases.indexOf('personNumber') === -1) {
            miShowConfirm(
                'Ingen kolumn är mappad till <strong>E-post</strong> eller <strong>Personnummer</strong>. ' +
                'Utan någon av dem kan raderna inte kopplas till en person, så inga nya medlemmar kan skapas.',
                function () { miCommit(true); });
            return;
        }

        miHideConfirm();
        var btn = miEl('mi_importBtn');
        var orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Importerar...';

        var fd = new FormData();
        fd.append('clubId', miEl('mi_clubId').value);
        fd.append('mappingJson', JSON.stringify(mapping));
        fd.append('rowsJson', JSON.stringify(miState.rows));
        fd.append('force', force ? 'true' : 'false');

        fetch('/umbraco/surface/MemberImport/Commit', {
            method: 'POST',
            headers: { 'RequestVerificationToken': miToken() },
            body: fd
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            btn.disabled = false;
            btn.innerHTML = orig;
            if (!data.success) {
                // Pre-flight stop: nothing was written. Let the admin decide, in the modal.
                if (data.requiresConfirmation) {
                    miShowConfirm(miEscape(data.message || ''), function () { miCommit(true); });
                    return;
                }
                miShowConfirmError(data.message || 'Okänt fel');
                return;
            }
            miRenderResult(data);
        })
        .catch(function (err) {
            btn.disabled = false;
            btn.innerHTML = orig;
            console.error('Commit error:', err);
            miShowConfirmError(err.message);
        });
    };

    function miRenderResult(data) {
        var summary =
            '<div class="alert alert-success">' +
            '<h6 class="mb-2"><i class="bi bi-check-circle me-1"></i>Import klar</h6>' +
            '<ul class="mb-0">' +
            '<li><strong>' + data.created + '</strong> nya medlemmar skapade</li>' +
            '<li><strong>' + data.updated + '</strong> befintliga medlemmar uppdaterade</li>' +
            '<li><strong>' + data.skipped + '</strong> rader överhoppade</li>' +
            '<li><strong>' + data.pnrIncompleteCount + '</strong> med ofullständigt personnummer (flaggade)</li>' +
            '</ul></div>';
        miEl('mi_resultSummary').innerHTML = summary;

        var errorsHtml = '';
        if (data.errors && data.errors.length > 0) {
            errorsHtml = '<div class="alert alert-warning"><strong>Meddelanden:</strong><ul class="mb-0">';
            for (var i = 0; i < data.errors.length; i++) {
                errorsHtml += '<li>' + miEscape(data.errors[i]) + '</li>';
            }
            errorsHtml += '</ul></div>';
        }
        miEl('mi_resultErrors').innerHTML = errorsHtml;

        miEl('mi_step_upload').style.display = 'none';
        miEl('mi_step_mapping').style.display = 'none';
        miEl('mi_step_result').style.display = '';
        miEl('mi_importBtn').style.display = 'none';

        // Refresh the club member list if the host page exposes a loader.
        if (typeof loadClubMembers === 'function') {
            try { loadClubMembers(); } catch (e) { /* ignore */ }
        }
    }
})();
</script>
