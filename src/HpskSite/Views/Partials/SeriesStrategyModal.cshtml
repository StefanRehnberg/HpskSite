@*
 * Series Strategy Configuration Modal
 * Dedicated two-panel modal for selecting and configuring series calculation strategies.
 * Opened from SeriesEditModal via "Konfigurera strategi" button.
 * Writes results back to hidden fields in the series edit form.
*@

<!-- Dark mode support for strategy modal -->
<style>
#strategyModal .strategy-card {
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
}
#strategyModal .strategy-card:hover {
    border-color: var(--bs-primary);
}
#strategyModal .strategy-card.active {
    border-color: var(--bs-primary);
    box-shadow: 0 0 0 0.2rem rgba(var(--bs-primary-rgb), 0.25);
}
#strategyModal .strategy-card .bi {
    font-size: 1.2rem;
}
#strategyModal .strategy-detail-example {
    background-color: var(--bs-tertiary-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 0.375rem;
    padding: 0.75rem;
    font-size: 0.875rem;
}
#strategyModal .strategy-detail-example code {
    font-size: 0.85em;
}
#strategyModal .strategy-list-panel {
    border-right: 1px solid var(--bs-border-color);
    max-height: 70vh;
    overflow-y: auto;
}
#strategyModal .strategy-detail-panel {
    max-height: 70vh;
    overflow-y: auto;
}
#strategyModal .strategy-group-header {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--bs-secondary-color);
    padding: 0.5rem 0;
    margin-top: 0.5rem;
}
#strategyModal .strategy-group-header:first-child {
    margin-top: 0;
}
</style>

<div class="modal fade" id="strategyModal" tabindex="-1" role="dialog" aria-labelledby="strategyModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="strategyModalLabel">
                    <i class="bi bi-bar-chart me-2"></i>Konfigurera beräkningsstrategi
                </h5>
                <button type="button" class="btn-close" onclick="cancelStrategyModal()"></button>
            </div>

            <!-- Body: Two-column layout -->
            <div class="modal-body p-0">
                <div class="row g-0">
                    <!-- Left panel: Strategy list -->
                    <div class="col-md-4 strategy-list-panel p-3">
                        <div id="strategyListContainer">
                            <!-- Rendered by JS -->
                        </div>
                    </div>

                    <!-- Right panel: Detail / parameters -->
                    <div class="col-md-8 strategy-detail-panel p-3">
                        <div id="strategyDetailContainer">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-arrow-left-circle" style="font-size: 2rem;"></i>
                                <p class="mt-3">Välj en strategi från listan till vänster för att se beskrivning och inställningar.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="cancelStrategyModal()">Avbryt</button>
                <button type="button" class="btn btn-primary" id="confirmStrategyBtn" onclick="confirmStrategySelection()">
                    <i class="bi bi-check-circle me-1"></i>Använd strategi
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// ── Rich metadata for each strategy (Swedish descriptions, examples, icons, category) ──
const strategyMeta = {
    IndividualSumAll: {
        icon: 'bi-calculator',
        category: 'individual',
        detailedDescription: 'Summerar alla deltävlingsresultat för varje skytt. Alla tävlingar räknas — ingen stryks. ' +
            'Kan kombineras med placeringspoäng (fasta eller dynamiska) istället för råresultat.',
        example: 'Exempel: 5 deltävlingar med resultat 245, 238, 251, 240, 247\n' +
            'Totalsumma: 245 + 238 + 251 + 240 + 247 = 1221 poäng',
        paramHelp: {
            placementPoints: 'Bestämmer hur varje deltävlingsresultat omvandlas till seriepoäng:\n' +
                '• Av — skyttens råpoäng (t.ex. 245) summeras direkt.\n' +
                '• Dynamisk — skytten får poäng efter placering: 1:a = antal deltagare i klassen, 2:a = antal minus 1, osv. Rättvisare vid varierande deltagarantal.\n' +
                '• Fast poängtabell — skytten får fasta poäng beroende på placering (t.ex. 25, 20, 16...). Välj en fördefinierad tabell eller ange en egen.',
            pointsTable: 'Välj en fördefinierad poängtabell, eller "Egen" för att ange egna värden.',
            customPointsTable: 'Ange poäng per placering, kommaseparerat (t.ex. "25, 20, 16, 13, 11, 10"). Placering utanför listan får 0 poäng.'
        }
    },
    IndividualBestOf: {
        icon: 'bi-trophy',
        category: 'individual',
        detailedDescription: 'Väljer de N bästa resultaten per skytt — resterande visas genomstrukna i resultatlistan. ' +
            'Bra för serier där inte alla kan delta i varje deltävling.',
        example: 'Exempel: 6 deltävlingar, bästa 4 räknas\n' +
            'Resultat: 245, 238, 251, 240, 247, 230\n' +
            'Bästa 4: 251 + 247 + 245 + 240 = 983 (238, 230 strykresultat)',
        paramHelp: {
            bestOf: 'Antal bästa resultat som räknas per skytt.',
            placementPoints: 'Bestämmer hur varje deltävlingsresultat omvandlas till seriepoäng:\n' +
                '• Av — skyttens råpoäng (t.ex. 245) summeras direkt.\n' +
                '• Dynamisk — skytten får poäng efter placering: 1:a = antal deltagare i klassen, 2:a = antal minus 1, osv. Rättvisare vid varierande deltagarantal.\n' +
                '• Fast poängtabell — skytten får fasta poäng beroende på placering (t.ex. 25, 20, 16...). Välj en fördefinierad tabell eller ange en egen.',
            pointsTable: 'Välj en fördefinierad poängtabell, eller "Egen" för att ange egna värden.',
            customPointsTable: 'Ange poäng per placering, kommaseparerat (t.ex. "25, 20, 16, 13, 11, 10"). Placering utanför listan får 0 poäng.'
        }
    },
    IndividualWinsCount: {
        icon: 'bi-1-circle',
        category: 'individual',
        detailedDescription: 'Räknar antal 1:a-platser per skytt i varje skytteklass. ' +
            'Den skytt med flest segrar vinner serien. Vid lika avgör totala poäng.',
        example: 'Exempel: 5 deltävlingar\n' +
            'Skytt A: 1:a, 3:e, 1:a, 2:a, 1:a → 3 segrar\n' +
            'Skytt B: 2:a, 1:a, 2:a, 1:a, 2:a → 2 segrar\n' +
            'Skytt A vinner serien.',
        paramHelp: {}
    },
    IndividualFixedPoints: {
        icon: 'bi-list-ol',
        category: 'individual',
        detailedDescription: 'Tilldelar fasta poäng baserat på placering i varje deltävling — samma poängskala oavsett antal deltagare. ' +
            'Liknande Formel 1-poäng. Välj en fördefinierad tabell eller skapa en egen.',
        example: 'Exempel med tabell 25-20-16-13-11-10:\n' +
            'Skytt A: 1:a(25p) + 3:e(16p) + 2:a(20p) = 61p\n' +
            'Skytt B: 2:a(20p) + 1:a(25p) + 4:e(13p) = 58p',
        paramHelp: {
            pointsTable: 'Välj en fördefinierad poängtabell, eller "Egen" för att ange egna värden.',
            customPointsTable: 'Ange poäng per placering, kommaseparerat (t.ex. "25, 20, 16, 13, 11, 10"). Placering utanför listan får 0 poäng.'
        }
    },
    IndividualDynamicPoints: {
        icon: 'bi-people',
        category: 'individual',
        detailedDescription: 'Poäng baserat på antal deltagare i klassen. 1:a platsen får lika många poäng som det finns deltagare, ' +
            '2:a platsen ett mindre, och så vidare. Sista platsen får alltid 1 poäng. ' +
            'Rättvisare vid varierande deltagarantal mellan tävlingar.',
        example: 'Exempel: 12 deltagare i klassen\n' +
            '1:a plats → 12p, 2:a → 11p, 3:e → 10p, ..., 12:e → 1p\n\n' +
            'Nästa tävling med 8 deltagare:\n' +
            '1:a plats → 8p, 2:a → 7p, ..., 8:e → 1p',
        paramHelp: {}
    },
    ClubTeamBestOf: {
        icon: 'bi-people-fill',
        category: 'club',
        detailedDescription: 'Klubblagstävling där varje klubbs bästa X skyttar räknas per deltävling. ' +
            'Lagets poäng är summan av de bästa skyttarnas resultat. ' +
            'Kan kombineras med att räkna bästa N deltävlingar för laget.',
        example: 'Exempel: 3 bästa skyttar per klubb\n' +
            'Klubb A: Skytt1(251) + Skytt2(247) + Skytt3(245) = 743\n' +
            'Klubb B: Skytt1(248) + Skytt2(246) + Skytt3(242) = 736\n' +
            'Klubb A vinner deltävlingen.',
