<div class="modal fade" id="stfRequestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-send me-2"></i>Skicka funktionärsförfrågan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-muted small mb-2" id="stfReqAudience"></div>
                <div class="mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="stfReqMode" id="stfReqRelay" value="Relay" checked onchange="stfReqModeChanged()">
                        <label class="form-check-label" for="stfReqRelay"><strong>Till klubb-/kretsansvariga</strong> — de distribuerar vidare <span class="badge bg-light text-dark border" id="stfReqRelayCount"></span></label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="stfReqMode" id="stfReqDirect" value="Direct" onchange="stfReqModeChanged()">
                        <label class="form-check-label" for="stfReqDirect"><strong>Direkt till medlemmar</strong> (push + e-post) <span class="badge bg-light text-dark border" id="stfReqDirectCount"></span></label>
                        <div class="form-text" id="stfReqDirectNote"></div>
                    </div>
                </div>
