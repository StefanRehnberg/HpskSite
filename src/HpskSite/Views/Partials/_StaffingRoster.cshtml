                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="stfReqSendBtn" onclick="stfSendRequest()"><i class="bi bi-send me-1"></i>Skicka</button>
            </div>
        </div>
