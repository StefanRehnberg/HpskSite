</div>

<script>
(function () {
    var compId = @competitionId;
    var TOKEN = '@stfToken';
    var REFRESH = 12000;
    var timer = null;
    var roles = [];        // role metadata from the roster response
    var groups = [];       // current roster groups
    var modal = null;
    var searchTimer = null;
    var collapsedGroups = {};  // roleKey -> true when a role group is manually collapsed (survives polls)

    var STATUS_LABEL = { Planned: 'Planerad', Invited: 'Inbjuden', Accepted: 'Accepterad', Declined: 'Avböjt', Confirmed: 'Bekräftad' };
    var STATUS_CLS = { Planned: 'bg-secondary', Invited: 'bg-info text-dark', Accepted: 'bg-primary', Declined: 'bg-danger', Confirmed: 'bg-success' };
    var SCOPE_KEY_LABEL = { Skjutlag: 'Skjutlag nr', Station: 'Station nr', Klass: 'Klass', Patrull: 'Patrull nr', Bana: 'Bana' };

    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function roleByKey(k) { for (var i = 0; i < roles.length; i++) if (roles[i].roleKey === k) return roles[i]; return null; }
    // Long Swedish date for a yyyy-MM-dd string, e.g. "Fredag 21 Augusti 2026" (raw string if unparseable).
    function longDate(dateStr) {
        try {
            var d = new Date(dateStr + 'T00:00:00');
            if (isNaN(d.getTime())) return dateStr;
            var cap = function (s) { return s.charAt(0).toUpperCase() + s.slice(1); };
            return cap(d.toLocaleDateString('sv-SE', { weekday: 'long' })) + ' ' + d.getDate() + ' '
                + cap(d.toLocaleDateString('sv-SE', { month: 'long' })) + ' ' + d.getFullYear();
        } catch (e) { return dateStr; }
    }

    // ---- roster filtering + group collapse (keeps 100+ funktionärer manageable) ----
    function activeFilter() {
        function v(id) { var el = document.getElementById(id); return el ? el.value : ''; }
        return { q: v('stfFilter').trim().toLowerCase(), role: v('stfFilterRole'), pass: v('stfFilterPass'), status: v('stfFilterStatus') };
    }
    function filterActive(f) { return !!(f.q || f.role || f.pass || f.status); }
    function matchesFilter(a, g, f) {
        if (f.role && g.roleKey !== f.role) return false;
        if (f.pass && String(a.passId || '') !== f.pass) return false;
        if (f.status && a.status !== f.status) return false;
        if (f.q) {
            var hay = ((a.displayName || '') + ' ' + (a.functionTitle || '') + ' ' + (a.scopeLabel || '') + ' '
                + (a.note || '') + ' ' + (a.phone || '') + ' ' + (a.passLabel || '') + ' ' + (g.roleName || '')).toLowerCase();
            if (hay.indexOf(f.q) === -1) return false;
        }
        return true;
    }
    function populateFilterSelects() {
        var rsel = document.getElementById('stfFilterRole');
        if (rsel) { var cur = rsel.value; rsel.innerHTML = '<option value="">Alla roller</option>' + roles.map(function (g) { return '<option value="' + g.roleKey + '">' + esc(g.roleName) + '</option>'; }).join(''); rsel.value = cur; }
        var psel = document.getElementById('stfFilterPass');
        if (psel) { var curp = psel.value; psel.innerHTML = '<option value="">Alla skift</option>' + passes.map(function (p) { return '<option value="' + p.id + '">' + esc(p.displayLabel) + '</option>'; }).join(''); psel.value = curp; }
    }
    window.stfToggleGroup = function (key) { if (!key) return; collapsedGroups[key] = !collapsedGroups[key]; renderRoster(); };
    window.stfExpandAll = function (expand) { groups.forEach(function (g) { if (g.roleKey) collapsedGroups[g.roleKey] = !expand; }); renderRoster(); };
    window.stfClearFilter = function () {
        ['stfFilter', 'stfFilterRole', 'stfFilterPass', 'stfFilterStatus'].forEach(function (id) { var el = document.getElementById(id); if (el) el.value = ''; });
        renderRoster();
    };

    // "Vad behövs" — the kit/briefing checklist for a role (P2 item 7), shown per role group + in the dialog.
    function needsHtml(g, isCatchAll) {
        if (isCatchAll || !g.needs || !g.needs.length) return '';
        var chips = g.needs.map(function (n) { return '<span class="badge bg-light text-secondary border fw-normal">' + esc(n) + '</span>'; }).join(' ');
        return '<div class="mb-2 d-flex flex-wrap align-items-center gap-1"><span class="text-muted small"><i class="bi bi-check2-square me-1"></i>Vad behövs:</span>' + chips + '</div>';
    }

    /// The role catalog, loaded on its own. It used to arrive as a by-product of the (now retired) Roller
    /// view, so retiring that view left the add-funktionär dialog with an empty role list — the button
    /// opened something unusable. A dialog's data must not depend on a screen nobody opens any more.
    async function loadRoles() {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetRoles?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) return;
            roles = (d.roles || []).map(function (x) {
                return {
                    roleKey: x.key, roleName: x.name, rolePlural: x.plural,
                    defaultScopeType: x.defaultScopeType, supportsTargetRange: x.supportsTargetRange,
                    supportsFunctionTitle: x.supportsFunctionTitle, description: x.description,
                    needs: x.needs || [], assignments: []
                };
            });
            populateRoleSelect();
            populateFilterSelects();
            populatePeopleFilterSelects();
            renderNeedsEditor();
        } catch (e) { /* the dialog degrades to whatever it already had */ }
    }

    async function loadRoster() {
        // The Roller view is retired as a destination; its markup only survives because the add/edit
        // dialog and a dozen helpers still bind to its ids. Nothing reads it, so don't pay for it.
        var host = document.getElementById('bem-roster');
        if (!host || host.style.display === 'none') return;
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetRoster?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { document.getElementById('stfRoster').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kunde inte läsa bemanningen.') + '</div>'; return; }
            groups = d.groups || [];
            roles = groups.filter(function (g) { return g.roleKey && g.roleKey.charAt(0) !== '_'; })
                          .map(function (g) { return g; });
            renderRoster();
            populateRoleSelect();
            populateFilterSelects();
            renderNeedsEditor();   // roles now known → (re)render the crew-needs inputs
            populatePeopleFilterSelects();
            loadCoverage();        // keep coverage live as assignments change
            loadScheduleQuality(); // ...and re-check missing times / clashes after every roster change
        } catch (e) {
            document.getElementById('stfRoster').innerHTML = '<div class="alert alert-warning">Kunde inte läsa bemanningen.</div>';
        }
    }

    // ======================================================================================
    // THE PEOPLE LAYER (tab 1). One row per human, unioned server-side across the roster,
    // self-sign-ups, availability and prep ownership — so this tab and every other one agree
    // about what a given person is doing. See CompetitionPeopleService.
    // ======================================================================================
    var people = [];
    var peopleMeta = {};
    var expandedPeople = {};      // person key -> true when their detail row is open (survives polls)
    var peopleShown = 0;          // progressive render cap; "visa fler" raises it
    var PEOPLE_PAGE = 100;        // never paint more than this at once — hundreds of DOM rows is the old bug

    var STATE_CLS = {
        'Anmäld': 'bg-warning text-dark', 'Avböjt': 'bg-danger', 'Inbjuden': 'bg-info text-dark',
        'Planerad': 'bg-secondary', 'Accepterad': 'bg-primary', 'Bekräftad': 'bg-success',
        'Förberedelser': 'bg-light text-dark border'
    };

    async function loadPeople() {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetPeople?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) {
                document.getElementById('stfPeopleBody').innerHTML = '<tr><td colspan="6" class="text-muted py-3">' + esc(d.message || 'Kunde inte läsa personerna.') + '</td></tr>';
                return;
            }
            people = d.people || [];
            peopleMeta = d;
            renderPeople();
            renderQueueBanner();
            renderHelpTally();
        } catch (e) {
            document.getElementById('stfPeopleBody').innerHTML = '<tr><td colspan="6" class="text-muted py-3">Kunde inte läsa personerna.</td></tr>';
        }
    }

    function personByKey(k) { for (var i = 0; i < people.length; i++) if (people[i].key === k) return people[i]; return null; }

    function pplFilter() {
        function v(id) { var el = document.getElementById(id); return el ? el.value : ''; }
        return { q: v('stfPplFilter').trim().toLowerCase(), view: v('stfPplView'), role: v('stfPplRole'), pass: v('stfPplPass') };
    }

    function pplMatches(p, f) {
        // Mirror of CompetitionPeopleService.UnassignedVolunteerCount — offered to help, holds no uppdrag.
        if (f.view === 'queue' && !((p.volunteer || (p.availabilityLabels || []).length) && (p.assignments || []).length === 0)) return false;
        if (f.view === 'assigned' && (p.assignments || []).length === 0) return false;
        if (f.view === 'invited' && !(p.assignments || []).some(function (a) { return a.status === 'Invited'; })) return false;
        if (f.view === 'declined' && !(p.assignments || []).some(function (a) { return a.status === 'Declined'; })) return false;
        if (f.view === 'prep' && !(p.prep || []).length) return false;
        if (f.view === 'external' && !p.isExternal) return false;
        if (f.role && !(p.assignments || []).some(function (a) { return a.roleKey === f.role; })) return false;
        if (f.pass && !(p.assignments || []).some(function (a) { return String(a.passId || '') === f.pass; })) return false;
        if (f.q) {
            var hay = ((p.displayName || '') + ' ' + (p.clubName || '') + ' ' + (p.roleLabels || []).join(' ')
                + ' ' + (p.state || '') + ' ' + (p.phone || '')
                + ' ' + ((p.volunteer && p.volunteer.comment) || '')
                + ' ' + (p.prep || []).map(function (x) { return (x.areaName || '') + ' ' + (x.itemTitle || ''); }).join(' ')).toLowerCase();
            if (hay.indexOf(f.q) === -1) return false;
        }
        return true;
    }

    function renderPeople() {
        // In person mode the same data drives a card, not the table. Rendering the table underneath is
        // what made a single person look like a filtered list.
        if (personKey) { renderPerson(); return; }
        var body = document.getElementById('stfPeopleBody');
        if (!body) return;
        var f = pplFilter();
        var matching = people.filter(function (p) { return pplMatches(p, f); });
        if (!peopleShown || peopleShown < PEOPLE_PAGE) peopleShown = PEOPLE_PAGE;
        var slice = matching.slice(0, peopleShown);

        body.innerHTML = slice.length
            ? slice.map(personRowHtml).join('')
            : '<tr><td colspan="6" class="text-muted text-center py-4"><i class="bi bi-people me-1"></i>'
              + (people.length ? 'Ingen person matchar filtret.' : 'Ingen är kopplad till tävlingen än. Lägg till en funktionär, eller öppna för självanmälan under Värvning.')
              + '</td></tr>';

        var more = document.getElementById('stfPeopleMore');
        if (more) {
            more.innerHTML = matching.length > slice.length
                ? '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfShowMorePeople()">Visa ' + Math.min(PEOPLE_PAGE, matching.length - slice.length) + ' fler (' + (matching.length - slice.length) + ' kvar)</button>'
                : '';
        }
        var cnt = document.getElementById('stfPplCount');
        if (cnt) cnt.textContent = matching.length === people.length
            ? (people.length + ' personer')
            : ('Visar ' + matching.length + ' av ' + people.length);
        var clr = document.getElementById('stfPplClear');
        if (clr) clr.style.display = (f.q || f.view || f.role || f.pass) ? '' : 'none';

        var sum = document.getElementById('stfPeopleSummary');
        if (sum) {
            var t = new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' });
            sum.innerHTML = '<span class="text-muted"><i class="bi bi-people me-1"></i>'
                + '<strong>' + (peopleMeta.totalPeople || 0) + '</strong> personer · '
                + (peopleMeta.assignedCount || 0) + ' med uppdrag'
                + ((peopleMeta.needsResponseCount || 0) ? ' · ' + peopleMeta.needsResponseCount + ' väntar på svar' : '')
                + ((peopleMeta.externalCount || 0) ? ' · ' + peopleMeta.externalCount + ' externa' : '')
                + ' · uppdaterad ' + t + '</span>';
        }
        var badge = document.getElementById('stfPeopleBadge');
        if (badge) { if (peopleMeta.totalPeople) { badge.textContent = peopleMeta.totalPeople; badge.style.display = ''; } else badge.style.display = 'none'; }
        var qb = document.getElementById('stfQueueBadge');
        if (qb) { if (peopleMeta.unassignedVolunteerCount) { qb.textContent = peopleMeta.unassignedVolunteerCount; qb.style.display = ''; } else qb.style.display = 'none'; }
    }

    window.stfShowMorePeople = function () { peopleShown += PEOPLE_PAGE; renderPeople(); };

    // Person keys are passed through inline handlers URL-ENCODED, never HTML-escaped. A free-text helper
    // called O'Brien produces the key "n:o'brien"; html-escaping it yields &#39;, which the browser decodes
    // back to a quote BEFORE the JS is parsed — breaking the handler with "missing ) after argument list".
    // encodeURIComponent alone is NOT enough: it deliberately leaves ! ' ( ) * unencoded, so the apostrophe
    // survives and still closes the JS string. Encode the quote explicitly; decodeURIComponent restores it.
    function keyArg(key) { return encodeURIComponent(key).replace(/'/g, '%27'); }
    function fromKeyArg(a) { try { return decodeURIComponent(a); } catch (e) { return a; } }

    function personRowHtml(p) {
        var open = !!expandedPeople[p.key];
        var keyEsc = keyArg(p.key);
        var asg = p.assignments || [];

        // Uppdrag: at most two chips inline, the rest behind "+N" — keeps the row one line high.
        var chips = asg.slice(0, 2).map(function (a) {
            return '<span class="badge bg-light text-dark border fw-normal me-1">'
                + (a.isResponsible ? '<i class="bi bi-star-fill text-warning me-1"></i>' : '')
                + esc(a.roleName) + (a.scopeLabel && a.scopeLabel !== 'Hela tävlingen' ? ' <span class="text-muted">· ' + esc(a.scopeLabel) + '</span>' : '')
                + '</span>';
        }).join('');
        if (asg.length > 2) chips += '<span class="badge bg-secondary-subtle text-secondary-emphasis border fw-normal">+' + (asg.length - 2) + '</span>';
        if (!asg.length) {
            chips = p.volunteer
                ? '<span class="text-warning-emphasis small"><i class="bi bi-hand-thumbs-up me-1"></i>Anmäld — inget uppdrag än</span>'
                : ((p.availabilityLabels || []).length
                    ? '<span class="text-warning-emphasis small"><i class="bi bi-calendar-week me-1"></i>Har angett tider — inget uppdrag än</span>'
                    : ((p.prep || []).length ? '<span class="text-muted small">Endast förberedelser</span>' : '<span class="text-muted small">—</span>'));
        }

        // Tid: pass/shift labels, deduped. A person on three markörpass in the same skift shows it once.
        var times = {};
        asg.forEach(function (a) { var t = a.passLabel || a.shiftLabel; if (t) times[t] = 1; });
        var timeHtml = Object.keys(times).length
            ? Object.keys(times).slice(0, 2).map(function (t) { return '<span class="badge bg-primary-subtle text-primary-emphasis border fw-normal me-1">' + esc(t) + '</span>'; }).join('')
              + (Object.keys(times).length > 2 ? '<span class="text-muted small">+' + (Object.keys(times).length - 2) + '</span>' : '')
            : (asg.length ? '<span class="text-muted small" title="Personen ser bara &quot;Heldag&quot; i sitt schema">Heldag</span>' : '');

        var prepCell = (p.prep || []).length
            ? '<span class="badge ' + (p.prepOverdueCount ? 'bg-danger' : (p.prepOpenCount ? 'bg-warning text-dark' : 'bg-success')) + '" title="' + esc((p.prep || []).map(function (x) { return x.isAreaLead ? ('Ansvarig: ' + x.areaName) : x.itemTitle; }).join(' · ')) + '">'
              + (p.prep.length - p.prepOpenCount) + '/' + p.prep.length + '</span>'
            : '<span class="text-muted">—</span>';

        var stateBadge = '<span class="badge ' + (STATE_CLS[p.state] || 'bg-secondary') + '">' + esc(p.state) + '</span>';
        var adminBadge = p.hasAdminAccess ? ' <i class="bi bi-shield-lock text-warning" title="Kan hantera tävlingen i pistol.nu"></i>' : '';
        var extBadge = p.isExternal ? ' <span class="badge bg-light text-secondary border fw-normal" title="Extern hjälpare utan konto">extern</span>' : '';

        var actions = '';
        if (!p.readOnly) {
            actions += '<button type="button" class="btn btn-sm btn-outline-primary" onclick="stfAssignPerson(\'' + keyEsc + '\')" title="Ge ett uppdrag"><i class="bi bi-plus-lg"></i></button>';
            if (p.memberId || p.email) actions += '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfNotifyPerson(\'' + keyEsc + '\')" title="Bjud in / notifiera"><i class="bi bi-envelope"></i></button>';
        }
        if (p.phone) actions += '<a class="btn btn-sm btn-outline-success" href="tel:' + esc(p.phone) + '" title="Ring"><i class="bi bi-telephone"></i></a>';

        var main = '<tr class="' + (open ? 'table-active' : '') + '">'
            + '<td style="cursor:pointer" onclick="stfTogglePerson(\'' + keyEsc + '\')">'
            + '<i class="bi bi-chevron-' + (open ? 'down' : 'right') + ' text-muted small me-1"></i>'
            + '<span class="fw-semibold">' + esc(p.displayName) + '</span>' + adminBadge + extBadge
            + (p.clubName ? '<div class="text-muted small ms-3">' + esc(p.clubName) + '</div>' : '')
            + '</td>'
            + '<td>' + chips + '</td>'
            + '<td>' + timeHtml + '</td>'
            + '<td class="text-center">' + prepCell + '</td>'
            + '<td>' + stateBadge + '</td>'
            + '<td class="text-end"><div class="d-flex gap-1 justify-content-end">' + actions + '</div></td>'
            + '</tr>';

        return open ? main + personDetailHtml(p, keyEsc) : main;
    }

    // The expanded row is where the cross-surface picture lives: every uppdrag (editable), what they
    // volunteered for, when they said they're available, and what they own in Förberedelser.
    function personDetailHtml(p, keyEsc) {
        var h = '<tr class="table-active"><td colspan="6" class="pt-0">';

        // Identity actions do NOT live here. They belong to the person card (stfOpenPerson), where there
        // is room to edit a name in place and search for a member — a row of four buttons crammed into an
        // expanded table row, each opening a prompt(), was worse than not having them.
        h += '<div class="py-2 border-bottom mb-2">'
            + '<button type="button" class="btn btn-sm btn-outline-primary" onclick="stfOpenPerson(\'' + keyEsc + '\')">'
            + '<i class="bi bi-person-lines-fill me-1"></i>Öppna ' + esc(p.displayName) + '</button></div>';

        h += '<div class="row g-3 py-2">';

        // --- uppdrag (editable rows) ---
        h += '<div class="col-lg-6"><div class="fw-semibold small mb-1"><i class="bi bi-person-badge me-1"></i>Uppdrag på tävlingen</div>';
        if ((p.assignments || []).length) {
            h += (p.assignments).map(function (a) {
                var acts = a.readOnly
                    ? '<span class="badge bg-secondary-subtle text-secondary-emphasis border" title="Tilldelad på Stationer-fliken">' + esc(p.sourceLabel || 'annan flik') + '</span>'
                    : '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfEdit(' + a.id + ')" title="Redigera"><i class="bi bi-pencil"></i></button>'
                      + '<button type="button" class="btn btn-sm btn-outline-danger" onclick="stfDeletePersonAssignment(' + a.id + ',\'' + keyEsc + '\')" title="Ta bort"><i class="bi bi-trash"></i></button>';
                return '<div class="d-flex justify-content-between align-items-center border-top py-1 gap-2">'
                    + '<div class="small">' + esc(a.label)
                    + ' <span class="badge ' + (STATUS_CLS[a.status] || 'bg-secondary') + '">' + esc(STATUS_LABEL[a.status] || a.status) + '</span>'
                    + (a.hasAdminAccess ? ' <i class="bi bi-shield-lock text-warning" title="Kan hantera tävlingen i pistol.nu"></i>' : '')
                    + '</div><div class="d-flex gap-1 flex-shrink-0">' + acts + '</div></div>';
            }).join('');
        } else {
            h += '<div class="text-muted small fst-italic">Inget uppdrag än.</div>';
        }
        h += '<button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="stfAssignPerson(\'' + keyEsc + '\')"><i class="bi bi-plus-lg me-1"></i>Ge ett uppdrag</button>';
        h += '</div>';

        // --- what they offered (sign-up + availability) ---
        h += '<div class="col-lg-6">';
        if (p.volunteer) {
            h += '<div class="fw-semibold small mb-1"><i class="bi bi-hand-thumbs-up me-1"></i>Anmäld till <span class="text-muted fw-normal">· ' + esc(p.volunteer.updated) + '</span></div>';
            h += (p.volunteer.slots || []).length
                ? '<ul class="small mb-1">' + p.volunteer.slots.map(function (s) {
                    return '<li>' + esc(s.label) + (s.timesText ? ' — <span class="text-primary">' + esc(s.timesText) + '</span>' : ' <span class="text-muted">(hela passet)</span>') + '</li>';
                  }).join('') + '</ul>'
                : '<div class="text-muted small">Inga pass valda.</div>';
            if (p.volunteer.comment) h += '<div class="small border-start border-2 ps-2 mb-1"><i class="bi bi-chat-left-text me-1"></i>' + esc(p.volunteer.comment) + '</div>';
        }
        if ((p.availabilityLabels || []).length) {
            h += '<div class="text-success small mb-1"><i class="bi bi-calendar-week me-1"></i>Tillgänglig: ' + p.availabilityLabels.map(esc).join(' · ') + '</div>';
        }
        if ((p.prep || []).length) {
            h += '<div class="fw-semibold small mb-1 mt-2"><i class="bi bi-list-check me-1"></i>Förberedelser</div><ul class="small mb-0">'
                + p.prep.map(function (x) {
                    return '<li>' + (x.isAreaLead ? '<strong>Ansvarig: ' + esc(x.areaName) + '</strong>' : esc(x.itemTitle) + ' <span class="text-muted">(' + esc(x.areaName) + ')</span>')
                        + (x.dueDate ? ' <span class="text-muted">· senast ' + esc(x.dueDate) + '</span>' : '')
                        + (x.isOverdue ? ' <span class="badge bg-danger">försenad</span>' : '')
                        + '</li>';
                }).join('') + '</ul>';
        }
        if (!p.volunteer && !(p.availabilityLabels || []).length && !(p.prep || []).length) {
            h += '<div class="text-muted small fst-italic">Har inte anmält sig och äger inga förberedelser.</div>';
        }
        h += '</div></div></td></tr>';
        return h;
    }

    // NB: handlers receive the URL-encoded key (see keyArg) — always decode before comparing to p.key.
    window.stfTogglePerson = function (k) { var key = fromKeyArg(k); expandedPeople[key] = !expandedPeople[key]; renderPeople(); };
    window.stfPplClearFilter = function () {
        ['stfPplFilter', 'stfPplView', 'stfPplRole', 'stfPplPass'].forEach(function (id) { var el = document.getElementById(id); if (el) el.value = ''; });
        peopleShown = PEOPLE_PAGE; renderPeople();
    };
    window.stfGoToPeople = function (ev) {
        if (ev) ev.preventDefault();
        if (window.stfOpenPeople) window.stfOpenPeople('queue');
    };

    // The organiser's queue, stated as an action rather than buried in a list.
    function renderQueueBanner() {
        var host = document.getElementById('stfQueueBanner'); if (!host) return;
        var n = peopleMeta.unassignedVolunteerCount || 0;
        var declined = peopleMeta.declinedCount || 0;
        var html = '';
        if (n > 0) {
            html += '<div class="alert alert-warning py-2 mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">'
                + '<div><i class="bi bi-hand-thumbs-up me-1"></i><strong>' + n + ' ' + (n === 1 ? 'person har' : 'personer har') + ' anmält sig utan att få ett uppdrag.</strong> '
                + 'De väntar på att du fördelar rollerna.</div>'
                + '<button type="button" class="btn btn-sm btn-warning" onclick="stfFilterQueue()">Visa dem</button></div>';
        }
        if (declined > 0) {
            html += '<div class="alert alert-danger py-2 mb-0 small"><i class="bi bi-x-circle me-1"></i>'
                + declined + ' ' + (declined === 1 ? 'person har' : 'personer har') + ' avböjt ett uppdrag — platsen behöver fyllas.'
                + ' <a href="#" onclick="stfFilterDeclined(event)">Visa</a></div>';
        }
        host.innerHTML = html;
    }
    window.stfFilterQueue = function () { var s = document.getElementById('stfPplView'); if (s) { s.value = 'queue'; peopleShown = PEOPLE_PAGE; renderPeople(); } };
    window.stfFilterDeclined = function (ev) { if (ev) ev.preventDefault(); var s = document.getElementById('stfPplView'); if (s) { s.value = 'declined'; peopleShown = PEOPLE_PAGE; renderPeople(); } };

    // Värvning tab: the tally only — the people themselves live under Personer.
    function renderHelpTally() {
        var host = document.getElementById('stfHelpTally'); if (!host) return;
        var total = people.filter(function (p) { return !!p.volunteer; }).length;
        var un = peopleMeta.unassignedVolunteerCount || 0;
        if (!total) { host.innerHTML = '<div class="text-muted small fst-italic">Ingen har anmält sig ännu.</div>'; return; }
        host.innerHTML = '<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 border-top pt-2">'
            + '<div class="small"><i class="bi bi-people me-1"></i><strong>' + total + '</strong> har anmält sig'
            + (un ? ' — <span class="text-warning-emphasis fw-semibold">' + un + ' väntar på uppdrag</span>' : ' — alla har fått uppdrag')
            + '</div>'
            + '<button type="button" class="btn btn-sm btn-outline-primary" onclick="stfGoToPeople()"><i class="bi bi-arrow-right me-1"></i>Hantera under Personer</button></div>';
    }

    function populatePeopleFilterSelects() {
        var rsel = document.getElementById('stfPplRole');
        if (rsel) { var cur = rsel.value; rsel.innerHTML = '<option value="">Alla roller</option>' + roles.map(function (g) { return '<option value="' + g.roleKey + '">' + esc(g.roleName) + '</option>'; }).join(''); rsel.value = cur; }
        var psel = document.getElementById('stfPplPass');
        if (psel) { var curp = psel.value; psel.innerHTML = '<option value="">Alla skift</option>' + passes.map(function (p) { return '<option value="' + p.id + '">' + esc(p.displayLabel) + '</option>'; }).join(''); psel.value = curp; }
    }

    // Give a person an uppdrag straight from their row: the dialog opens pre-filled AND showing what they
    // already have, so "is this person already booked?" is answered before you pick a role, not after.
    window.stfAssignPerson = function (k) {
        var p = personByKey(fromKeyArg(k));
        if (!p) return;
        stfOpenAdd('');
        document.getElementById('stfMemberId').value = p.memberId || 0;
        document.getElementById('stfName').value = p.displayName || '';
        document.getElementById('stfMemberSearch').value = p.displayName || '';
        if (p.phone) document.getElementById('stfPhone').value = p.phone;
        // Prefill the pass from what they volunteered for, when the sign-up slot maps to exactly one skift.
        var sug = (p.volunteer && (p.volunteer.slots || []).map(function (s) { return s.suggestedPassId; }).filter(Boolean)) || [];
        if (sug.length) { var sel = document.getElementById('stfPass'); if (sel) sel.value = String(sug[0]); }
        renderExistingPanel(p);
    };

    window.stfNotifyPerson = function (k) {
        var p = personByKey(fromKeyArg(k));
        if (!p) return;
        var target = (p.assignments || []).filter(function (a) { return !a.readOnly; })[0];
        if (!target) { alert('Ge personen ett uppdrag först — notisen handlar om ett uppdrag.'); return; }
        stfNotify(target.id, p.displayName);
    };

    // Delete one of a person's uppdrag from their expanded detail row. Keyed rather than name-passed so a
    // name containing an apostrophe can't break the inline handler.
    window.stfDeletePersonAssignment = function (id, k) {
        var p = personByKey(fromKeyArg(k));
        stfDelete(id, p ? p.displayName : 'funktionären');
    };

    // The "already has" panel inside the add/edit dialog.
    function renderExistingPanel(p) {
        var host = document.getElementById('stfExisting');
        if (!host) return;
        if (!p || (!(p.assignments || []).length && !p.volunteer)) { host.style.display = 'none'; host.innerHTML = ''; return; }
        var h = '<div class="border rounded p-2 bg-body-tertiary">';
        h += '<div class="fw-semibold small mb-1">' + esc(p.displayName) + ' på den här tävlingen</div>';
        if ((p.assignments || []).length) {
            h += '<div class="small mb-1"><i class="bi bi-person-badge me-1"></i>Har redan: '
                + p.assignments.map(function (a) { return '<span class="badge bg-light text-dark border fw-normal me-1">' + esc(a.label) + '</span>'; }).join('')
                + '</div>';
        } else {
            h += '<div class="small text-muted mb-1">Inget uppdrag än.</div>';
        }
        if (p.volunteer) {
            h += '<div class="small text-success"><i class="bi bi-hand-thumbs-up me-1"></i>Anmäld till: ' + esc(p.volunteer.slotsSummary || '—') + '</div>';
            if (p.volunteer.comment) h += '<div class="small text-muted fst-italic">"' + esc(p.volunteer.comment) + '"</div>';
        }
        if ((p.prep || []).length) {
            h += '<div class="small text-muted"><i class="bi bi-list-check me-1"></i>' + p.prep.length + ' uppgift(er) i Förberedelser</div>';
        }
        h += '</div>';
        host.innerHTML = h;
        host.style.display = '';
    }

    function renderRoster() {
        var host = document.getElementById('stfRoster');
        var f = activeFilter();
        var isFiltering = filterActive(f);
        var total = 0, shown = 0, shownGroups = 0;
        var html = groups.map(function (g) {
            var isCatchAll = g.roleKey && g.roleKey.charAt(0) === '_';
            var allItems = g.assignments || [];
            total += allItems.length;
            var items = allItems.filter(function (a) { return matchesFilter(a, g, f); });
            // While filtering, hide role groups with no matching rows so the result set is tight.
            if (isFiltering && !items.length) return '';
            shown += items.length; shownGroups++;
            var collapsed = !isFiltering && !!collapsedGroups[g.roleKey];   // filtering forces groups open
            var chevron = '<i class="bi bi-chevron-' + (collapsed ? 'right' : 'down') + ' me-1 text-muted small"></i>';
            var addBtn = isCatchAll ? '' :
                '<button type="button" class="btn btn-outline-primary btn-sm" onclick="event.stopPropagation();stfOpenAdd(\'' + g.roleKey + '\')"><i class="bi bi-plus-lg me-1"></i>Lägg till ' + esc(g.roleName.toLowerCase()) + '</button>';
            var countBadge = (isFiltering && items.length !== allItems.length) ? (items.length + '/' + allItems.length) : String(allItems.length);
            var body = items.length
                ? items.map(rowHtml).join('')
                : '<div class="text-muted small py-2">Ingen tilldelad ännu.</div>';
            return '<div class="card mb-3">'
                + '<div class="card-header d-flex justify-content-between align-items-center py-2" style="cursor:pointer" onclick="stfToggleGroup(\'' + g.roleKey + '\')" title="Klicka för att fälla ihop/expandera">'
                + '<span class="fw-semibold">' + chevron + esc(g.rolePlural || g.roleName) + ' <span class="badge bg-light text-dark ms-1">' + countBadge + '</span></span>'
                + addBtn
                + '</div>'
                + '<div class="card-body py-2"' + (collapsed ? ' style="display:none"' : '') + '>'
                + (g.description && !isCatchAll ? '<div class="text-muted small mb-1">' + esc(g.description) + '</div>' : '')
                + needsHtml(g, isCatchAll)
                + body
                + '</div></div>';
        }).join('');
        if (isFiltering && !shownGroups) html = '<div class="text-muted py-4 text-center"><i class="bi bi-search me-1"></i>Inga funktionärer matchar filtret.</div>';
        host.innerHTML = html || '<div class="text-muted">Inga roller för denna gren.</div>';
        var c = document.getElementById('stfCount');
        if (c) {
            var t = new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' });
            c.innerHTML = '<span title="Flera kan bemanna samtidigt — uppdateras automatiskt"><i class="bi bi-people me-1"></i>'
                + (total > 0 ? (total + ' tilldelade · ') : '') + 'uppdaterad ' + t + '</span>';
        }
        var badge = document.getElementById('stfRosterBadge');
        if (badge) { if (total > 0) { badge.textContent = total; badge.style.display = ''; } else { badge.style.display = 'none'; } }
        var fc = document.getElementById('stfFilterCount');
        if (fc) fc.textContent = isFiltering ? ('Visar ' + shown + ' av ' + total) : '';
        var clr = document.getElementById('stfFilterClear');
        if (clr) clr.style.display = isFiltering ? '' : 'none';
    }

    function rowHtml(a) {
        var star = a.isResponsible ? '<i class="bi bi-star-fill text-warning me-1" title="Ansvarig"></i>' : '';
        var adminBadge = a.hasAdminAccess ? '<span class="badge bg-warning text-dark ms-1" title="Kan hantera tävlingen i pistol.nu"><i class="bi bi-shield-lock"></i> Behörighet</span>' : '';
        var statusBadge = '<span class="badge ' + (STATUS_CLS[a.status] || 'bg-secondary') + ' ms-1">' + esc(STATUS_LABEL[a.status] || a.status) + '</span>';
        var fn = a.functionTitle ? '<span class="text-muted"> · ' + esc(a.functionTitle) + '</span>' : '';
        var scope = a.scopeLabel ? '<span class="badge bg-light text-dark border"><i class="bi bi-geo-alt me-1"></i>' + esc(a.scopeLabel) + '</span>' : '';
        var shift = a.shiftLabel ? '<span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>' + esc(a.shiftLabel) + '</span>' : '';
        var pass = a.passLabel ? '<span class="badge bg-primary-subtle text-primary-emphasis border"><i class="bi bi-calendar2-week me-1"></i>' + esc(a.passLabel) + '</span>' : '';
        var phone = a.phone ? '<a class="btn btn-sm btn-outline-success" href="tel:' + esc(a.phone) + '" title="Ring"><i class="bi bi-telephone"></i></a>' : '';
        var nameEsc = esc(a.displayName).replace(/'/g, "\\'");
        var notifyBtn = (a.memberId || a.email)
            ? '<button type="button" class="btn btn-sm btn-outline-primary" onclick="stfNotify(' + a.id + ',\'' + nameEsc + '\')" title="Bjud in / notifiera (e-post + push)"><i class="bi bi-envelope"></i></button>'
            : '';
        // External (non-member) helper: offer a copyable accept/decline link to send manually (SMS etc.).
        var linkBtn = (!a.memberId && !a.readOnly)
            ? '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfCopyInviteLink(' + a.id + ')" title="Kopiera svarslänk (för SMS m.m.)"><i class="bi bi-link-45deg"></i></button>'
            : '';
        var note = a.note ? '<div class="text-muted small mt-1"><i class="bi bi-chat-left-text me-1"></i>' + esc(a.note) + '</div>' : '';
        var avail = (a.availabilityLabels && a.availabilityLabels.length)
            ? '<div class="text-success small mt-1"><i class="bi bi-calendar-week me-1"></i>Tillgänglig: ' + a.availabilityLabels.map(esc).join(' · ') + '</div>'
            : '';
        // Read-only mirror row (e.g. Fält station chief from the Stationer tab): source badge, no edit/notify.
        var srcBadge = (a.readOnly && a.sourceLabel)
            ? '<span class="badge bg-secondary-subtle text-secondary-emphasis border ms-1" title="Tilldelad på Stationer-fliken. Lägg till här om du vill hantera i planeringen."><i class="bi bi-diagram-2 me-1"></i>' + esc(a.sourceLabel) + '</span>'
            : '';
        var actions = a.readOnly
            ? phone
            : (phone + notifyBtn + linkBtn
                + '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfEdit(' + a.id + ')" title="Redigera"><i class="bi bi-pencil"></i></button>'
                + '<button type="button" class="btn btn-sm btn-outline-danger" onclick="stfDelete(' + a.id + ',\'' + nameEsc + '\')" title="Ta bort"><i class="bi bi-trash"></i></button>');
        return '<div class="d-flex justify-content-between align-items-start border-top py-2 gap-2" style="border-color:var(--bs-border-color)">'
            + '<div class="flex-grow-1">'
            + '<div>' + star + '<span class="fw-semibold">' + esc(a.displayName) + '</span>' + fn + statusBadge + adminBadge + srcBadge + '</div>'
            + '<div class="d-flex flex-wrap gap-1 mt-1">' + scope + pass + shift + '</div>'
            + avail
            + note
            + '</div>'
            + '<div class="d-flex gap-1 flex-shrink-0">' + actions + '</div>'
            + '</div>';
    }

    function findAssignment(id) {
        for (var i = 0; i < groups.length; i++) {
            var items = groups[i].assignments || [];
            for (var j = 0; j < items.length; j++) if (items[j].id === id) return items[j];
        }
        return null;
    }

    // ---- role select + field visibility ----

    function populateRoleSelect() {
        var sel = document.getElementById('stfRole');
        sel.innerHTML = roles.map(function (g) { return '<option value="' + g.roleKey + '">' + esc(g.roleName) + '</option>'; }).join('');
    }

    function applyRoleFields() {
        var role = roleByKey(document.getElementById('stfRole').value);
        var desc = document.getElementById('stfRoleDesc');
        desc.textContent = role ? (role.description || '') : '';
        var needs = document.getElementById('stfRoleNeeds');
        if (needs) {
            needs.innerHTML = (role && role.needs && role.needs.length)
                ? '<i class="bi bi-check2-square me-1"></i>Vad behövs: ' + role.needs.map(esc).join(' · ')
                : '';
        }
        document.getElementById('stfFunctionTitleWrap').style.display = (role && role.supportsFunctionTitle) ? '' : 'none';
        document.getElementById('stfTargetWrap').style.display = (role && role.supportsTargetRange) ? '' : 'none';
        // App access is offered for EVERY role — a sekretariat- or kassaansvarig needs the management page
        // just as much as the tävlingsledare. The only requirement is a real pistol.nu member to grant it to.
        syncAdminAccessAvailability();
    }

    // The grant targets a login, so it needs a picked member. Free-text helper rows can't carry it —
    // say so in place instead of silently dropping the flag server-side.
    var ADMIN_ACCESS_HELP = document.getElementById('stfAdminAccessHelp').innerHTML;
    function syncAdminAccessAvailability() {
        var box = document.getElementById('stfAdminAccess');
        var help = document.getElementById('stfAdminAccessHelp');
        var mid = parseInt(document.getElementById('stfMemberId').value, 10) || 0;
        if (mid > 0) {
            box.disabled = false;
            help.innerHTML = ADMIN_ACCESS_HELP;
        } else {
            box.disabled = true;
            box.checked = false;
            help.innerHTML = 'Behörighet kan bara ges till en vald pistol.nu-medlem — sök upp personen i fältet ovan.';
        }
    }

    function applyScopeFields() {
        var st = document.getElementById('stfScopeType').value;
        var keyWrap = document.getElementById('stfScopeKeyWrap');
        if (st === 'All' || !st) { keyWrap.style.display = 'none'; }
        else {
            keyWrap.style.display = '';
            document.getElementById('stfScopeKeyLabel').textContent = SCOPE_KEY_LABEL[st] || 'Nummer';
        }
    }

    document.getElementById('stfRole').addEventListener('change', function () {
        var role = roleByKey(this.value);
        if (role && role.defaultScopeType) {
            document.getElementById('stfScopeType').value = role.defaultScopeType;
        }
        applyRoleFields();
        applyScopeFields();
    });
    document.getElementById('stfScopeType').addEventListener('change', applyScopeFields);

    // ---- member search ----

    var searchBox = document.getElementById('stfMemberSearch');
    searchBox.addEventListener('input', function () {
        var q = this.value.trim();
        if (searchTimer) clearTimeout(searchTimer);
        if (q.length < 2) { hideResults(); return; }
        searchTimer = setTimeout(function () { doSearch(q); }, 220);
    });
    document.addEventListener('click', function (e) {
        if (!e.target.closest('#stfMemberResults') && e.target !== searchBox) hideResults();
    });

    async function doSearch(q) {
        try {
            var r = await fetch('/umbraco/surface/Staffing/SearchMembers?competitionId=' + compId + '&query=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { hideResults(); return; }
            var box = document.getElementById('stfMemberResults');
            var list = d.members || [];
            if (!list.length) { box.innerHTML = '<div class="list-group-item small text-muted">Inga träffar</div>'; box.style.display = 'block'; return; }
            box.innerHTML = list.map(function (m) {
                return '<button type="button" class="list-group-item list-group-item-action" '
                    + 'data-id="' + m.memberId + '" data-name="' + esc(m.memberName) + '" data-phone="' + esc(m.phone || '') + '">'
                    + esc(m.memberName) + (m.clubName ? ' <span class="text-muted small">· ' + esc(m.clubName) + '</span>' : '') + '</button>';
            }).join('');
            box.style.display = 'block';
            box.querySelectorAll('button').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.getElementById('stfMemberId').value = this.getAttribute('data-id');
                    document.getElementById('stfName').value = this.getAttribute('data-name');
                    var ph = this.getAttribute('data-phone');
                    if (ph) document.getElementById('stfPhone').value = ph;
                    searchBox.value = this.getAttribute('data-name');
                    hideResults();
                    syncAdminAccessAvailability();
                    showExistingForPicked();   // "har redan …" before a role is chosen, not after saving
                });
            });
        } catch (e) { hideResults(); }
    }
    function hideResults() { var b = document.getElementById('stfMemberResults'); if (b) b.style.display = 'none'; }

    // If the admin edits the name manually after picking, treat it as free text (drop the member link).
    document.getElementById('stfName').addEventListener('input', function () {
        document.getElementById('stfMemberId').value = '0';
        syncAdminAccessAvailability();
    });

    // ---- open / edit / save / delete ----

    function ensureModal() {
        if (!modal) modal = new bootstrap.Modal(document.getElementById('stfModal'));
        return modal;
    }

    function resetForm() {
        document.getElementById('stfId').value = '0';
        document.getElementById('stfMemberId').value = '0';
        document.getElementById('stfMemberSearch').value = '';
        document.getElementById('stfName').value = '';
        document.getElementById('stfPhone').value = '';
        document.getElementById('stfFunctionTitle').value = '';
        document.getElementById('stfScopeKey').value = '';
        document.getElementById('stfTargetFrom').value = '';
        document.getElementById('stfTargetTo').value = '';
        document.getElementById('stfStartsAt').value = '';
        document.getElementById('stfEndsAt').value = '';
        document.getElementById('stfPass').value = '';
        document.getElementById('stfStatus').value = 'Planned';
        document.getElementById('stfResponsible').checked = false;
        document.getElementById('stfAdminAccess').checked = false;
        document.getElementById('stfNote').value = '';
        document.getElementById('stfError').textContent = '';
        var ex = document.getElementById('stfExisting');
        if (ex) { ex.style.display = 'none'; ex.innerHTML = ''; }
        hideResults();
    }

    /// Look the picked person up in the people layer and show what they already hold.
    function showExistingForPicked() {
        var mid = parseInt(document.getElementById('stfMemberId').value, 10) || 0;
        var name = document.getElementById('stfName').value.trim();
        var key = mid > 0 ? ('m:' + mid) : ('n:' + name.toLowerCase());
        renderExistingPanel(personByKey(key));
    }

    window.stfOpenAdd = function (roleKey) {
        if (!roles.length) return;
        resetForm();
        document.getElementById('stfModalTitle').textContent = 'Lägg till funktionär';
        var sel = document.getElementById('stfRole');
        if (roleKey) sel.value = roleKey;
        var role = roleByKey(sel.value);
        document.getElementById('stfScopeType').value = (role && role.defaultScopeType) ? role.defaultScopeType : 'All';
        if (role) document.getElementById('stfResponsible').checked = false;
        applyRoleFields();
        applyScopeFields();
        ensureModal().show();
    };

    window.stfEdit = function (id) {
        var a = findAssignment(id);
        if (!a) return;
        resetForm();
        document.getElementById('stfModalTitle').textContent = 'Redigera funktionär';
        document.getElementById('stfId').value = a.id;
        document.getElementById('stfMemberId').value = a.memberId || 0;
        document.getElementById('stfName').value = a.displayName || '';
        document.getElementById('stfMemberSearch').value = a.displayName || '';
        document.getElementById('stfPhone').value = a.phone || '';
        document.getElementById('stfRole').value = a.roleKey;
        document.getElementById('stfFunctionTitle').value = a.functionTitle || '';
        document.getElementById('stfScopeType').value = a.scopeType || 'All';
        document.getElementById('stfScopeKey').value = a.scopeKey || '';
        document.getElementById('stfTargetFrom').value = a.targetFrom || '';
        document.getElementById('stfTargetTo').value = a.targetTo || '';
        document.getElementById('stfStatus').value = a.status || 'Planned';
        document.getElementById('stfPass').value = a.passId || '';
        document.getElementById('stfResponsible').checked = !!a.isResponsible;
        document.getElementById('stfAdminAccess').checked = !!a.hasAdminAccess;
        document.getElementById('stfNote').value = a.note || '';
        // shift label back into time fields is best-effort; the picker keeps raw text
        if (a.shiftLabel && a.shiftLabel.indexOf('–') > -1) {
            var parts = a.shiftLabel.split('–');
            document.getElementById('stfStartsAt').value = parts[0].replace('från ', '').trim();
            document.getElementById('stfEndsAt').value = (parts[1] || '').trim();
        }
        applyRoleFields();
        applyScopeFields();
        renderExistingPanel(personByKey(a.memberId ? ('m:' + a.memberId) : ('n:' + (a.displayName || '').trim().toLowerCase())));
        ensureModal().show();
    };

    window.stfSave = async function () {
        var err = document.getElementById('stfError');
        err.textContent = '';
        var scopeType = document.getElementById('stfScopeType').value;
        var payload = {
            id: parseInt(document.getElementById('stfId').value, 10) || 0,
            competitionId: compId,
            memberId: parseInt(document.getElementById('stfMemberId').value, 10) || 0,
            displayName: document.getElementById('stfName').value.trim(),
            phone: document.getElementById('stfPhone').value.trim(),
            roleKey: document.getElementById('stfRole').value,
            functionTitle: document.getElementById('stfFunctionTitle').value.trim(),
            scopeType: scopeType,
            scopeKey: scopeType === 'All' ? '' : document.getElementById('stfScopeKey').value.trim(),
            targetFrom: parseInt(document.getElementById('stfTargetFrom').value, 10) || 0,
            targetTo: parseInt(document.getElementById('stfTargetTo').value, 10) || 0,
            passId: parseInt(document.getElementById('stfPass').value, 10) || 0,
            startsAt: document.getElementById('stfStartsAt').value.trim(),
            endsAt: document.getElementById('stfEndsAt').value.trim(),
            isResponsible: document.getElementById('stfResponsible').checked,
            hasAdminAccess: document.getElementById('stfAdminAccess').checked,
            status: document.getElementById('stfStatus').value,
            note: document.getElementById('stfNote').value.trim()
        };
        if (!payload.displayName) { err.textContent = 'Ange en person (sök medlem eller skriv namn).'; return; }
        var btn = document.getElementById('stfSaveBtn');
        btn.disabled = true;
        try {
            var r = await fetch('/umbraco/surface/Staffing/SaveAssignment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify(payload)
            });
            var d = await r.json();
            // Server refused a same-person/same-role/same-scope/same-pass duplicate. Ask once, then repeat
            // the save with the override — silently creating the second row is what produced people listed
            // twice on one skjutlag.
            if (!d.success && d.duplicate) {
                btn.disabled = false;
                if (!confirm(d.message)) { err.textContent = ''; return; }
                payload.allowDuplicate = true;
                btn.disabled = true;
                r = await fetch('/umbraco/surface/Staffing/SaveAssignment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                    body: JSON.stringify(payload)
                });
                d = await r.json();
            }
            if (!d.success) { err.textContent = d.message || 'Kunde inte spara.'; btn.disabled = false; return; }
            ensureModal().hide();
            await Promise.all([loadRoster(), loadPeople()]);
        } catch (e) { err.textContent = 'Nätverksfel.'; }
        btn.disabled = false;
    };

    window.stfNotify = async function (id, name) {
        if (!confirm('Skicka en förfrågan/notis till ' + name + ' (e-post + push om möjligt)?')) return;
        try {
            var r = await fetch('/umbraco/surface/Staffing/NotifyAssignment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ id: id, competitionId: compId })
            });
            var d = await r.json();
            if (d.success) {
                var ch = []; if (d.email) ch.push('e-post'); if (d.push) ch.push('push');
                alert('Skickat' + (ch.length ? ' (' + ch.join(' + ') + ')' : '') + '. Status satt till Inbjuden.');
                await loadRoster();
            } else alert(d.message || 'Kunde inte skicka.');
        } catch (e) { alert('Nätverksfel.'); }
    };

    // ---- sourcing scope: open the comp for member self-sign-up (Phase 3) ----
    async function loadScopes() {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetSourceScopes?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            renderScopes((d && d.success) ? (d.scopes || []) : []);
        } catch (e) { /* leave as-is */ }
    }
    function renderScopes(scopes) {
        var body = document.getElementById('stfSourceBody');
        if (!body) return;
        var chips = scopes.map(function (s) {
            return '<span class="badge bg-success-subtle text-success-emphasis border d-inline-flex align-items-center gap-1" style="font-weight:500">'
                + '<i class="bi bi-unlock me-1"></i>' + esc(s.label)
                + '<button type="button" class="btn-close" style="font-size:.6rem" title="Stäng för anmälan" onclick="stfRemoveScope(' + s.id + ')"></button></span>';
        }).join(' ');
        body.innerHTML = '<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">'
            + '<div><div class="fw-semibold mb-1"><i class="bi bi-people-fill me-1"></i>Öppen för självanmälan</div>'
            + (chips || '<span class="text-muted small">Ingen — bara inbjudna kan bemanna. Öppna för klubbens/kretsens medlemmar så kan de anmäla sig själva.</span>')
            + '</div>'
            + '<div class="d-flex gap-1 flex-wrap">'
            + '<button type="button" class="btn btn-sm btn-outline-success" onclick="stfAddScope(\'Club\')"><i class="bi bi-plus-lg me-1"></i>Arrangörsklubben</button>'
            + '<button type="button" class="btn btn-sm btn-outline-success" onclick="stfAddScope(\'Region\')"><i class="bi bi-plus-lg me-1"></i>Kretsen</button>'
            + (scopes.length ? '<button type="button" class="btn btn-sm btn-primary" onclick="stfOpenRequest()"><i class="bi bi-send me-1"></i>Skicka förfrågan</button>' : '')
            + '</div></div>';
    }
    window.stfAddScope = async function (type) {
        try {
            var r = await fetch('/umbraco/surface/Staffing/AddSourceScope', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ competitionId: compId, scopeType: type, scopeKey: 'self' })
            });
            var d = await r.json();
            if (d.success) await loadScopes(); else alert(d.message || 'Kunde inte öppna.');
        } catch (e) { alert('Nätverksfel.'); }
    };
    window.stfRemoveScope = async function (id) {
        try {
            var r = await fetch('/umbraco/surface/Staffing/DeleteSourceScope', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ id: id, competitionId: compId })
            });
            var d = await r.json();
            if (d.success) await loadScopes();
        } catch (e) { }
    };

    // ---- pass, bemanningsbehov & täckning ----
    var passModal = null, passes = [], crewNeeds = [];

    async function loadPasses() {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetPasses?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            passes = (d && d.success) ? (d.passes || []) : [];
        } catch (e) { passes = []; }
        renderPassList();
        populatePassSelect();
        populateFilterSelects();
        populatePeopleFilterSelects();
        await loadNeeds();
        await loadCoverage();
    }

    function renderPassList() {
        var host = document.getElementById('stfPassList'); if (!host) return;
        if (!passes.length) { host.innerHTML = '<span class="text-muted small fst-italic">Inga skift ännu. Lägg till skift (t.ex. Lör FM 06–13, Lör EM 13–20).</span>'; return; }
        var badges = passes.map(function (p) {
            return '<span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 me-1 mb-1" style="font-weight:500">'
                + '<i class="bi bi-calendar2-week me-1"></i>' + esc(p.displayLabel)
                + '<button type="button" class="btn btn-sm btn-link p-0 ms-1 text-secondary" onclick="stfOpenPass(' + p.id + ')" title="Redigera"><i class="bi bi-pencil"></i></button>'
                + '<button type="button" class="btn-close" style="font-size:.55rem" title="Ta bort" onclick="stfDeletePass(' + p.id + ')"></button></span>';
        }).join('');
        // Copy the crew of one pass to another (e.g. Day 1 → Day 2) — the bulk shortcut.
        var copyCtl = '';
        if (passes.length >= 2) {
            var opts = passes.map(function (p) { return '<option value="' + p.id + '">' + esc(p.displayLabel) + '</option>'; }).join('');
            copyCtl = '<div class="input-group input-group-sm mt-1" style="max-width:520px" title="Kopiera bemanningen från ett skift till ett annat">'
                + '<span class="input-group-text">Kopiera bemanning</span>'
                + '<select class="form-select" id="stfCopyFrom">' + opts + '</select>'
                + '<span class="input-group-text">→</span>'
                + '<select class="form-select" id="stfCopyTo">' + opts + '</select>'
                + '<button class="btn btn-outline-primary" type="button" onclick="stfCopyPass()"><i class="bi bi-files me-1"></i>Kopiera</button></div>';
        }
        host.innerHTML = badges + copyCtl;
    }

    window.stfCopyPass = async function () {
        var from = parseInt(document.getElementById('stfCopyFrom').value, 10) || 0;
        var to = parseInt(document.getElementById('stfCopyTo').value, 10) || 0;
        if (!from || !to || from === to) { alert('Välj två olika skift.'); return; }
        if (!confirm('Kopiera bemanningen till det andra skiftet? Personer som redan finns där hoppas över.')) return;
        var r = await fetch('/umbraco/surface/Staffing/CopyPassAssignments', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify({ competitionId: compId, fromPassId: from, toPassId: to }) });
        var d = await r.json();
        if (d.success) { alert(d.copied + ' personer kopierade.'); await loadRoster(); await loadCoverage(); }
        else alert(d.message || 'Kunde inte kopiera.');
    };

    function populatePassSelect() {
        var sel = document.getElementById('stfPass'); if (!sel) return;
        var cur = sel.value;
        sel.innerHTML = '<option value="">— inget pass —</option>' + passes.map(function (p) { return '<option value="' + p.id + '">' + esc(p.displayLabel) + '</option>'; }).join('');
        sel.value = cur;
    }

    window.stfOpenPass = function (id) {
        if (!passModal) passModal = new bootstrap.Modal(document.getElementById('stfPassModal'));
        var p = id ? passes.find(function (x) { return x.id === id; }) : null;
        document.getElementById('stfPassId').value = p ? p.id : 0;
        document.getElementById('stfPassDate').value = p ? p.date : '';
        document.getElementById('stfPassFrom').value = p && p.startTime ? p.startTime : '';
        document.getElementById('stfPassTo').value = p && p.endTime ? p.endTime : '';
        document.getElementById('stfPassLabel').value = p ? p.label : '';
        document.getElementById('stfPassError').textContent = '';
        passModal.show();
        if (typeof flatpickr !== 'undefined') {
            flatpickr('#stfPassDate', { locale: 'sv', dateFormat: 'Y-m-d' });
            flatpickr('#stfPassFrom', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true });
            flatpickr('#stfPassTo', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true });
        }
    };

    window.stfSavePass = async function () {
        var payload = {
            id: parseInt(document.getElementById('stfPassId').value, 10) || 0, competitionId: compId,
            date: document.getElementById('stfPassDate').value.trim(), startTime: document.getElementById('stfPassFrom').value.trim(),
            endTime: document.getElementById('stfPassTo').value.trim(), label: document.getElementById('stfPassLabel').value.trim()
        };
        if (!payload.date) { document.getElementById('stfPassError').textContent = 'Ange ett datum.'; return; }
        var r = await fetch('/umbraco/surface/Staffing/SavePass', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify(payload) });
        var d = await r.json();
        if (d.success) { passModal.hide(); await loadPasses(); } else document.getElementById('stfPassError').textContent = d.message || 'Kunde inte spara.';
    };

    window.stfDeletePass = async function (id) {
        if (!confirm('Ta bort skiftet? Personer kopplade till skiftet blir opasslagda.')) return;
        var r = await fetch('/umbraco/surface/Staffing/DeletePass', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify({ id: id, competitionId: compId }) });
        var d = await r.json();
        if (d.success) { await loadPasses(); await loadRoster(); }
    };

    async function loadNeeds() {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetCrewNeeds?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            crewNeeds = (d && d.success) ? (d.needs || []) : [];
        } catch (e) { crewNeeds = []; }
        renderNeedsEditor();
    }

    function needCount(kind, roleKey) { var n = crewNeeds.find(function (x) { return x.scopeKind === kind && x.roleKey === roleKey; }); return n ? n.count : 0; }

    function renderNeedsEditor() {
        var host = document.getElementById('stfNeedsEditor'); if (!host || !roles.length) return;
        // The 12s roster poll calls this. Don't rebuild while the user is editing inside it — that
        // would reset unsaved values to the last-saved number (and steal focus mid-typing).
        if (host.querySelector('.stf-need') && host.contains(document.activeElement)) return;
        // Belt & suspenders: keep whatever is currently on screen across a rebuild, not just the saved value.
        var live = {};
        host.querySelectorAll('.stf-need').forEach(function (inp) { live[inp.getAttribute('data-kind') + '|' + inp.getAttribute('data-role')] = inp.value; });
        function cur(kind, roleKey) { var k = kind + '|' + roleKey; return (k in live) ? live[k] : needCount(kind, roleKey); }
        var stationRoles = roles.filter(function (g) { return g.defaultScopeType === 'Station'; });
        var otherRoles = roles.filter(function (g) { return g.defaultScopeType !== 'Station'; });
        function inputRow(kind, g) {
            return '<div class="d-flex align-items-center gap-2 mb-1"><span style="min-width:180px" class="small">' + esc(g.roleName) + '</span>'
                + '<input type="number" min="0" class="form-control form-control-sm stf-need" data-kind="' + kind + '" data-role="' + esc(g.roleKey) + '" value="' + cur(kind, g.roleKey) + '" style="max-width:80px"></div>';
        }
        var html = '<div class="border rounded p-2"><div class="small text-muted mb-1">Bemanningsbehov (antal per roll) — driver täckningen nedan:</div>';
        if (stationRoles.length) html += '<div class="fw-semibold small mt-1">Per station</div>' + stationRoles.map(function (g) { return inputRow('Station', g); }).join('');
        html += '<div class="fw-semibold small mt-2">Totalt (hela tävlingen)</div>' + otherRoles.map(function (g) { return inputRow('All', g); }).join('');
        html += '<button type="button" class="btn btn-sm btn-outline-primary mt-2" onclick="stfSaveNeeds()"><i class="bi bi-save me-1"></i>Spara behov</button></div>';
        host.innerHTML = html;
    }

    window.stfSaveNeeds = async function () {
        var needs = [];
        document.querySelectorAll('.stf-need').forEach(function (inp) {
            var c = parseInt(inp.value, 10) || 0;
            if (c > 0) needs.push({ scopeKind: inp.getAttribute('data-kind'), roleKey: inp.getAttribute('data-role'), count: c });
        });
        var r = await fetch('/umbraco/surface/Staffing/SaveCrewNeeds', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify({ competitionId: compId, needs: needs }) });
        var d = await r.json();
        if (d.success) { crewNeeds = needs.slice(); await loadCoverage(); }
    };

    async function loadCoverage() {
        var host = document.getElementById('stfCoverage'); if (!host) return;
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetCoverage?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { host.innerHTML = '<div class="text-muted small">Kunde inte läsa täckning.</div>'; return; }
            renderCoverage(d);
        } catch (e) { host.innerHTML = '<div class="text-muted small">Kunde inte läsa täckning.</div>'; }
    }

    // Schemakvalitet — see the #stfQuality block above for why this lives on the roster tab.
    async function loadScheduleQuality() {
        var host = document.getElementById('stfQuality'); if (!host) return;
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetScheduleQuality?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { host.innerHTML = ''; return; }

            var html = '';
            if (d.untimed > 0) {
                html += '<div class="alert alert-light border py-2 mb-2 small">'
                    + '<i class="bi bi-clock-history me-1"></i>'
                    + '<strong>' + d.untimed + ' av ' + d.total + ' uppdrag saknar tid.</strong> '
                    + 'De funktionärerna ser bara "Heldag" i sitt schema. Sätt ett skift eller ett arbetspass '
                    + 'så vet de när de ska vara på plats.'
                    + '</div>';
            }
            if ((d.clashes || []).length) {
                html += '<div class="alert alert-warning py-2 mb-0 small">'
                    + '<i class="bi bi-exclamation-triangle-fill me-1"></i>'
                    + '<strong>' + d.clashes.length + ' krock' + (d.clashes.length === 1 ? '' : 'ar')
                    + ' i bemanningen</strong> — samma person är bokad på två håll samtidigt:'
                    + '<ul class="mb-0 mt-1">'
                    + d.clashes.map(function (c) {
                        return '<li>' + esc(c.name) + ': ' + esc(c.a) + ' &amp; ' + esc(c.b) + '</li>';
                    }).join('')
                    + '</ul></div>';
            }
            host.innerHTML = html;
        } catch (e) { host.innerHTML = ''; }
    }

    function covClass(filled, needed) {
        if (filled >= needed && needed > 0) return 'bg-success-subtle text-success-emphasis';
        if (filled > 0) return 'bg-warning-subtle text-warning-emphasis';
        return 'bg-danger-subtle text-danger-emphasis';
    }

    // Glanceable staffing status shown on the Funktionärer tab. Pure info — no navigation link
    // (the "Behov & täckning" tab already does that; a link here just duplicates it).
    function renderCovSummary(d) {
        var sum = document.getElementById('stfCovSummary'); if (!sum) return;
        if (d && d.hasNeeds && (d.passes || []).length && d.totalNeeded > 0) {
            var cls = (d.totalFilled >= d.totalNeeded) ? 'text-success' : (d.totalFilled > 0 ? 'text-warning-emphasis' : 'text-danger');
            sum.innerHTML = '<i class="bi bi-people-fill me-1"></i>Bemannat <span class="fw-semibold ' + cls + '">' + d.totalFilled + '/' + d.totalNeeded + '</span> mot behovet';
        } else {
            sum.innerHTML = '';
        }
    }

    function renderCoverage(d) {
        renderCovSummary(d);
        var host = document.getElementById('stfCoverage');
        if (!(d.passes || []).length) { host.innerHTML = '<div class="text-muted small fst-italic">Lägg till skift för att se täckning.</div>'; return; }
        if (!d.hasNeeds) { host.innerHTML = '<div class="text-muted small fst-italic">Sätt bemanningsbehov ovan för att se täckning per skift.</div>'; return; }
        var html = '<div class="small mb-2">Totalt bemannat: <strong>' + d.totalFilled + '/' + d.totalNeeded + '</strong></div>';
        d.passes.forEach(function (p) {
            html += '<div class="mb-3"><div class="fw-semibold">' + esc(p.label || p.date) + (p.timeLabel ? ' <span class="text-muted">' + esc(p.timeLabel) + '</span>' : '') + ' <span class="badge bg-light text-dark border">' + p.filled + '/' + p.needed + '</span></div>';
            if ((p.stations || []).length && (p.stations[0].roles || []).length) {
                var cols = p.stations[0].roles.map(function (r) { return r.roleName; });
                html += '<div class="table-responsive"><table class="table table-sm table-bordered mb-1" style="width:auto"><thead><tr><th class="small">Station</th>'
                    + cols.map(function (rn) { return '<th class="text-center small">' + esc(rn) + '</th>'; }).join('') + '</tr></thead><tbody>';
                p.stations.forEach(function (u) {
                    html += '<tr><td class="fw-semibold">' + esc(u.scopeKey) + '</td>'
                        + (u.roles || []).map(function (r) { return '<td class="text-center ' + covClass(r.filled, r.needed) + '">' + r.filled + '/' + r.needed + '</td>'; }).join('') + '</tr>';
                });
                html += '</tbody></table></div>';
            }
            if ((p.general || []).length) {
                html += '<div class="d-flex flex-wrap gap-1">' + p.general.map(function (r) {
                    return '<span class="badge border ' + covClass(r.filled, r.needed) + '">' + esc(r.roleName) + ' ' + r.filled + '/' + r.needed + '</span>';
                }).join('') + '</div>';
            }
            html += '</div>';
        });
        host.innerHTML = html;
    }

    // ---- mail-out: "sök funktionärer" ----
    var requestModal = null, reqPreview = null;
    window.stfOpenRequest = async function () {
        if (!requestModal) requestModal = new bootstrap.Modal(document.getElementById('stfRequestModal'));
        document.getElementById('stfReqError').textContent = '';
        document.getElementById('stfReqMessage').value = '';
        document.getElementById('stfReqAudience').textContent = 'Laddar…';
        requestModal.show();
        try {
            var r = await fetch('/umbraco/surface/Staffing/PreviewStaffRequest?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            reqPreview = await r.json();
            if (!reqPreview.success) { document.getElementById('stfReqError').textContent = reqPreview.message || 'Kunde inte läsa.'; return; }
            document.getElementById('stfReqAudience').innerHTML = 'Mottagare: ' + ((reqPreview.audienceLabels || []).map(esc).join(', ') || '—');
            document.getElementById('stfReqRelayCount').textContent = (reqPreview.relayCount || 0) + ' e-post';
            document.getElementById('stfReqDirectCount').textContent = (reqPreview.directCount || 0) + ' medlemmar';
            document.getElementById('stfReqDirectNote').textContent = reqPreview.directAvailable
                ? 'E-post skickas via Brevo (klubbens nyckel), push till de som tillåtit det.'
                : 'Ingen Brevo-nyckel på klubben → endast push når medlemmar direkt. Rekommenderat: skicka till ansvariga.';
            document.getElementById('stfReqLastSent').textContent = reqPreview.lastSent ? ('Senast skickat: ' + reqPreview.lastSent) : '';
            stfReqModeChanged();
        } catch (e) { document.getElementById('stfReqError').textContent = 'Nätverksfel.'; }
    };
    window.stfReqModeChanged = function () {
        // (hook for future per-mode UI hints; counts already shown per option)
    };
    window.stfSendRequest = async function () {
        var mode = document.querySelector('input[name="stfReqMode"]:checked').value;
        var btn = document.getElementById('stfReqSendBtn'); btn.disabled = true;
        try {
            var r = await fetch('/umbraco/surface/Staffing/SendStaffRequest', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ competitionId: compId, mode: mode, message: document.getElementById('stfReqMessage').value.trim() })
            });
            var d = await r.json();
            btn.disabled = false;
            if (d.success) {
                requestModal.hide();
                alert('Skickat: ' + d.sent + ' e-post' + (d.push ? ' + ' + d.push + ' push' : '') + ' (' + d.recipients + ' mottagare).');
                loadScopes();
            } else document.getElementById('stfReqError').textContent = d.message || 'Kunde inte skicka.';
        } catch (e) { btn.disabled = false; document.getElementById('stfReqError').textContent = 'Nätverksfel.'; }
    };

    // ---- självanmälan: pass-konfiguration + anmälda + förhandsgranskning ----
    var slotModal = null, helpSlots = [];
    (function () { var b = document.getElementById('stfPreviewBtn'); if (b) b.href = '/bemanna?c=' + compId + '&preview=1'; })();

    // Only the organiser's slot configuration lives here now. The volunteers themselves are rendered from
    // the people layer (loadPeople → renderHelpTally), so there is no second list to fall out of sync.
    async function loadHelp() {
        try {
            var rs = await fetch('/umbraco/surface/Staffing/GetHelpSlots?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var ds = await rs.json();
            helpSlots = (ds && ds.success) ? (ds.slots || []) : [];
            renderHelpSlots();
        } catch (e) { }
    }

    function renderHelpSlots() {
        var host = document.getElementById('stfHelpSlots');
        if (!host) return;
        if (!helpSlots.length) { host.innerHTML = '<div class="text-muted small fst-italic">Inga pass ännu. Lägg till minst ett pass så kan medlemmar anmäla sig.</div>'; return; }
        var html = '', lastDate = null;
        helpSlots.forEach(function (s) {
            if (s.date !== lastDate) { html += '<div class="fw-semibold small mt-2"><i class="bi bi-calendar-event me-1"></i>' + esc(longDate(s.date)) + '</div>'; lastDate = s.date; }
            var tr = (s.startTime || s.endTime) ? ' <span class="text-muted">(' + esc(s.startTime || '') + '–' + esc(s.endTime || '') + ')</span>' : '';
            html += '<div class="d-flex justify-content-between align-items-start border-bottom py-1 gap-2">'
                + '<div><span class="fw-semibold">' + esc(s.headline) + '</span>' + tr + (s.description ? '<div class="text-muted small">' + esc(s.description) + '</div>' : '') + '</div>'
                + '<div class="d-flex gap-1 flex-shrink-0">'
                + '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfOpenSlot(' + s.id + ')"><i class="bi bi-pencil"></i></button>'
                + '<button type="button" class="btn btn-sm btn-outline-danger" onclick="stfDeleteSlot(' + s.id + ')"><i class="bi bi-trash"></i></button>'
                + '</div></div>';
        });
        host.innerHTML = html;
    }

    window.stfOpenSlot = function (id) {
        if (!slotModal) slotModal = new bootstrap.Modal(document.getElementById('stfSlotModal'));
        var s = id ? helpSlots.find(function (x) { return x.id === id; }) : null;
        document.getElementById('stfSlotId').value = s ? s.id : 0;
        document.getElementById('stfSlotDate').value = s ? s.date : '';
        document.getElementById('stfSlotFrom').value = s && s.startTime ? s.startTime : '';
        document.getElementById('stfSlotTo').value = s && s.endTime ? s.endTime : '';
        document.getElementById('stfSlotHeadline').value = s ? s.headline : '';
        document.getElementById('stfSlotDesc').value = s && s.description ? s.description : '';
        document.getElementById('stfSlotError').textContent = '';
        document.getElementById('stfSlotTitle').textContent = s ? 'Redigera pass' : 'Lägg till pass';
        slotModal.show();
        if (typeof flatpickr !== 'undefined') {
            flatpickr('#stfSlotDate', { locale: 'sv', dateFormat: 'Y-m-d' });
            flatpickr('#stfSlotFrom', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true });
            flatpickr('#stfSlotTo', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true });
        }
    };

    window.stfSaveSlot = async function () {
        var payload = {
            id: parseInt(document.getElementById('stfSlotId').value, 10) || 0,
            competitionId: compId,
            date: document.getElementById('stfSlotDate').value.trim(),
            startTime: document.getElementById('stfSlotFrom').value.trim(),
            endTime: document.getElementById('stfSlotTo').value.trim(),
            headline: document.getElementById('stfSlotHeadline').value.trim(),
            description: document.getElementById('stfSlotDesc').value.trim()
        };
        if (!payload.date || !payload.headline) { document.getElementById('stfSlotError').textContent = 'Ange datum och rubrik.'; return; }
        var r = await fetch('/umbraco/surface/Staffing/SaveHelpSlot', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify(payload) });
        var d = await r.json();
        if (d.success) { slotModal.hide(); await loadHelp(); } else document.getElementById('stfSlotError').textContent = d.message || 'Kunde inte spara.';
    };

    window.stfDeleteSlot = async function (id) {
        if (!confirm('Ta bort passet? Anmälningar till det tas bort ur medlemmarnas val.')) return;
        var r = await fetch('/umbraco/surface/Staffing/DeleteHelpSlot', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify({ id: id, competitionId: compId }) });
        var d = await r.json();
        if (d.success) await loadHelp();
    };

    window.stfCopyInviteLink = async function (id) {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetInviteLink?competitionId=' + compId + '&id=' + id, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { alert(d.message || 'Kunde inte hämta länken.'); return; }
            try { await navigator.clipboard.writeText(d.url); alert('Svarslänk kopierad:\n' + d.url); }
            catch (e) { prompt('Kopiera svarslänken och skicka till hjälparen:', d.url); }
        } catch (e) { alert('Nätverksfel.'); }
    };

    window.stfDelete = async function (id, name) {
        if (!confirm('Ta bort ' + name + ' från bemanningen?')) return;
        try {
            var r = await fetch('/umbraco/surface/Staffing/DeleteAssignment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify({ id: id, competitionId: compId })
            });
            var d = await r.json();
            if (d.success) await Promise.all([loadRoster(), loadPeople()]);
            else alert(d.message || 'Kunde inte ta bort.');
        } catch (e) { alert('Nätverksfel.'); }
    };

    // Live refresh so several people can build the roster in parallel (planning meeting) and see each
    // other's assignments. Skip while a modal is open (don't disrupt an in-progress edit) or the tab is
    // hidden. Assignments are independent rows, so parallel edits to different roles never clobber.
    // Poll only what is on screen. Personer and Roller are two projections of the same server-side data, so
    // refreshing both every 12 s doubles the DB work for no visible benefit — and GetPeople is the heavier of
    // the two (it also builds the prep breakdown for the "Förb." column). Both are still loaded once at init
    // so the filter selects and role list are populated whichever tab you land on.
    // The grid is always on screen, so it is always what we refresh. An open panel refreshes too, because
    // that is what the user is reading right now.
    function panelOpen(id) {
        var el = document.getElementById(id);
        return !!el && el.classList.contains('show');
    }
    function poll() {
        if (document.hidden) return;
        if (document.querySelector('.modal.show')) return;
        // The grid must NOT be re-rendered while a cell editor is open — that would blow away the
        // half-typed name and the focus with it.
        if (window.grdLoad && !window.grdBusy) window.grdLoad();
        if (panelOpen('bemPersonerPanel')) loadPeople();
        else if (panelOpen('bemBehovPanel')) loadCoverage();
    }
    function startTimer() { if (!timer) timer = setInterval(poll, REFRESH); }
    function stopTimer() { if (timer) { clearInterval(timer); timer = null; } }
    document.addEventListener('visibilitychange', function () { if (document.hidden) stopTimer(); else { poll(); startTimer(); } });

    // Flatpickr time pickers for the shift fields (loaded elsewhere on the page).
    function initPickers() {
        if (typeof flatpickr === 'undefined') return;
        ['#stfStartsAt', '#stfEndsAt'].forEach(function (sel) {
            flatpickr(sel, { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true });
        });
    }
    initPickers();

    // Live-filter the roster as the admin types/picks (toolbar is static, so bind once).
    ['stfFilter', 'stfFilterRole', 'stfFilterPass', 'stfFilterStatus'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) { el.addEventListener('input', renderRoster); el.addEventListener('change', renderRoster); }
    });
    // Same for the people table. Any filter change resets the progressive-render cap so a narrow filter
    // doesn't hide matches behind a "visa fler" left over from a wider one.
    ['stfPplFilter', 'stfPplView', 'stfPplRole', 'stfPplPass'].forEach(function (id) {
        var el = document.getElementById(id);
        if (!el) return;
        var h = function () { peopleShown = PEOPLE_PAGE; renderPeople(); };
        el.addEventListener('input', h); el.addEventListener('change', h);
    });

    // ---- the panels (opened from the grid, not navigated to) ----------------------------------
    // Each loads on show, so nothing is fetched for a panel nobody opened. That is also why the heavy
    // GetPeople call no longer runs on every page load.

    function panel(id) {
        var el = document.getElementById(id);
        return el ? bootstrap.Offcanvas.getOrCreateInstance(el) : null;
    }

    /// Open the people list, optionally filtered ("queue" = volunteers with no assignment yet).
    window.stfOpenPeople = function (view) {
        var sel = document.getElementById('stfPplView');
        if (sel) { sel.value = view || ''; peopleShown = PEOPLE_PAGE; }
        var f = document.getElementById('stfPplFilter'); if (f) f.value = '';
        personKey = null;
        document.getElementById('stfPanelTitle').innerHTML = '<i class="bi bi-people-fill me-2"></i>Personer';
        setMode(false);
        var p = panel('bemPersonerPanel'); if (p) p.show();
        loadPeople();
    };

    // ---- ONE PERSON: a card, not the list filtered to one row --------------------------------------

    var personKey = null;   // non-null = person mode

    function setMode(person) {
        document.getElementById('stfPersonMode').style.display = person ? '' : 'none';
        document.getElementById('stfListMode').style.display = person ? 'none' : '';
        document.getElementById('stfBackBtn').style.display = person ? '' : 'none';
    }

    window.stfBackToList = function () {
        personKey = null;
        document.getElementById('stfPanelTitle').innerHTML = '<i class="bi bi-people-fill me-2"></i>Personer';
        setMode(false);
        loadPeople();
    };

    /// What a name in the grid opens. The people layer already groups every row a human holds, so this
    /// answers "what is this person doing, and can we reach them?" in one place.
    window.stfOpenPerson = async function (key) {
        var p = panel('bemPersonerPanel'); if (p) p.show();
        personKey = key;
        setMode(true);
        document.getElementById('stfPersonMode').innerHTML =
            '<div class="text-muted small py-4"><div class="spinner-border spinner-border-sm"></div> Laddar…</div>';
        if (!people.length) await loadPeople();
        renderPerson();
    };

    function findPerson() {
        if (!personKey) return null;
        return people.find(function (x) { return x.key === personKey; })
            || people.find(function (x) { return (x.displayName || '').toLowerCase() === String(personKey).replace(/^n:/, ''); })
            || null;
    }

    function renderPerson() {
        if (!personKey) return;
        var host = document.getElementById('stfPersonMode');
        var p = findPerson();
        if (!p) { host.innerHTML = '<div class="alert alert-warning">Personen finns inte kvar på tävlingen.</div>'; return; }
        personKey = p.key;
        // The name is an editable field two lines below — printing it in the header too just reads as a
        // duplicate.
        document.getElementById('stfPanelTitle').innerHTML = '<i class="bi bi-person me-2"></i>Person';

        var asg = p.assignments || [];
        var h = '';

        // --- identity ---------------------------------------------------------------------------
        h += '<div class="d-flex align-items-start gap-2 mb-1">'
            + '<div class="flex-grow-1">'
            + '<input type="text" class="form-control form-control-lg fw-semibold border-0 px-0" id="stfPName"'
            + ' value="' + esc(p.displayName) + '" aria-label="Namn">'
            + '<div class="text-muted small">'
            + (p.clubName ? esc(p.clubName) + ' · ' : '')
            + (p.memberId
                ? '<span class="text-success"><i class="bi bi-person-check me-1"></i>Medlem på pistol.nu</span>'
                : '<span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>Saknar konto</span>')
            + '</div></div></div>'
            + '<div class="form-text mb-2">Ändra namnet och tryck Enter — det gäller alla '
            + asg.length + (asg.length === 1 ? ' uppdrag.' : ' uppdrag.') + '</div>';

        // A link overwrites the typed name with the register's spelling. Usually right, occasionally wrong,
        // and it used to happen silently and irreversibly — a person was renamed and nothing said so.
        var orig = (asg.find(function (a) { return a.originalName; }) || {}).originalName;
        if (orig && orig !== p.displayName) {
            h += '<div class="alert alert-secondary py-2 small d-flex align-items-center gap-2 flex-wrap mb-3">'
                + '<i class="bi bi-info-circle"></i>'
                + '<span class="flex-grow-1">Hette <strong>' + esc(orig) + '</strong> i planen.</span>'
                + '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfPersonUndo()">'
                + '<i class="bi bi-arrow-counterclockwise me-1"></i>Ångra</button></div>';
        }

        // --- reachability: the whole reason the plan is in pistol.nu at all -----------------------
        if (!p.memberId) {
            h += '<div class="border rounded p-2 mb-3 bg-body-tertiary">'
                + '<div class="fw-semibold small mb-1">Hur når vi ' + esc(p.displayName.split(' ')[0]) + '?</div>'
                + '<div class="small text-muted mb-2">Utan konto får hen inget personligt schema och inga '
                + 'påminnelser. Med e-post går det åtminstone att skicka förfrågan.</div>'
                + '<label class="form-label small mb-1">Är det här en medlem?</label>'
                + '<div class="position-relative mb-2">'
                + '<input type="text" class="form-control form-control-sm" id="stfPLink" autocomplete="off"'
                + ' placeholder="Sök medlem…" value="' + esc(p.displayName) + '">'
                + '<div class="list-group position-absolute w-100 shadow" id="stfPLinkResults" style="z-index:5;display:none"></div>'
                + '</div>'
                + '<label class="form-label small mb-1">…eller bara e-post</label>'
                + '<div class="input-group input-group-sm">'
                + '<input type="email" class="form-control" id="stfPEmail" placeholder="namn@exempel.se" value="' + esc(p.email || '') + '">'
                + '<button class="btn btn-outline-secondary" type="button" onclick="stfPersonSaveEmail()">Spara</button>'
                + '</div></div>';
        }

        // --- assignments ---------------------------------------------------------------------------
        h += '<div class="fw-semibold small text-uppercase text-muted mb-1">Uppdrag (' + asg.length + ')</div>';
        h += asg.length
            ? '<div class="list-group mb-2">' + asg.map(function (a) {
                return '<div class="list-group-item d-flex align-items-center gap-2 py-2">'
                    + '<div class="flex-grow-1">'
                    + '<div class="fw-semibold">' + esc(a.roleName)
                    + (a.functionTitle ? ' <span class="fw-normal text-muted">· ' + esc(a.functionTitle) + '</span>' : '')
                    + (a.isResponsible ? ' <i class="bi bi-star-fill text-warning" title="Ansvarig"></i>' : '') + '</div>'
                    + '<div class="small text-muted">'
                    + (a.dayLabel ? '<span class="text-body">' + esc(a.dayLabel) + '</span> · ' : '')
                    + (a.scopeLabel && a.scopeLabel !== 'Hela tävlingen' ? esc(a.scopeLabel) + ' · ' : '')
                    + esc(a.shiftLabel || a.passLabel || 'Heldag') + '</div></div>'
                    + '<span class="badge ' + (STATE_CLS[SV_STATUS[a.status] || ''] || 'bg-secondary') + '">'
                    + esc(SV_STATUS[a.status] || a.status) + '</span>'
                    + (a.readOnly ? '' :
                        // Splitting only means something on a row with real from–to times.
                        (a.shiftLabel && a.shiftLabel.indexOf('–') > 0
                            ? '<button type="button" class="btn btn-sm btn-outline-warning" onclick="stfSplitOpen(' + a.id + ')" title="Dela passet — någon annan tar resten"><i class="bi bi-scissors"></i></button>'
                            : '')
                      + '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="stfEdit(' + a.id + ')" title="Ändra"><i class="bi bi-pencil"></i></button>'
                      + '<button type="button" class="btn btn-sm btn-outline-danger" onclick="stfDelete(' + a.id + ')" title="Ta bort"><i class="bi bi-trash"></i></button>')
                    + '</div>'
                    + '<div class="list-group-item py-2 bg-body-tertiary" id="stfSplit' + a.id + '" style="display:none">'
                    + '<div class="small fw-semibold mb-1">Dela passet ' + esc(a.shiftLabel || '') + '</div>'
                    + '<div class="d-flex gap-2 align-items-start flex-wrap">'
                    + '<div><label class="form-label small mb-0">Från kl</label>'
                    + '<input type="text" class="form-control form-control-sm" id="stfSplitAt' + a.id + '" placeholder="09:00" style="width:90px"></div>'
                    + '<div class="flex-grow-1 position-relative" style="min-width:200px">'
                    + '<label class="form-label small mb-0">tar över</label>'
                    + '<input type="text" class="form-control form-control-sm" id="stfSplitWho' + a.id + '" placeholder="Sök person…" autocomplete="off">'
                    + '<div class="list-group position-absolute w-100 shadow" id="stfSplitRes' + a.id + '" style="z-index:5;display:none"></div>'
                    + '</div></div>'
                    + '<div class="form-text">Den som tar över står som Planerad tills hen tackat ja.</div>'
                    + '</div>';
            }).join('') + '</div>'
            : '<div class="text-muted small mb-2">Inga uppdrag än.</div>';

        h += '<button type="button" class="btn btn-sm btn-outline-primary mb-3" onclick="stfOpenAdd(\'\')">'
            + '<i class="bi bi-plus-lg me-1"></i>Ge ett uppdrag</button>';

        // --- context (only what exists) --------------------------------------------------------------
        var extras = [];
        if (p.volunteer) extras.push('<i class="bi bi-hand-thumbs-up me-1"></i>Har anmält sig: '
            + esc(p.volunteer.slotsSummary || '—') + (p.volunteer.comment ? ' — "' + esc(p.volunteer.comment) + '"' : ''));
        (p.availabilityLabels || []).forEach(function (l) { extras.push('<i class="bi bi-calendar-week me-1"></i>Kan: ' + esc(l)); });
        (p.prep || []).forEach(function (x) {
            extras.push('<i class="bi bi-list-check me-1"></i>' + (x.isAreaLead ? 'Ansvarig: ' + esc(x.areaName) : esc(x.itemTitle || '')));
        });
        if (extras.length) {
            h += '<div class="fw-semibold small text-uppercase text-muted mb-1">Övrigt</div>'
                + '<ul class="list-unstyled small text-muted mb-3">'
                + extras.map(function (e) { return '<li class="mb-1">' + e + '</li>'; }).join('') + '</ul>';
        }

        // --- replacement, last and visually separate: it is the destructive one ----------------------
        h += '<hr>'
            + '<div class="fw-semibold small mb-1">Kan hen inte längre?</div>'
            + '<div class="small text-muted mb-2">Lämna över alla ' + asg.length + ' uppdrag till någon annan. '
            + 'Svaren följer inte med — den nya personen står som Planerad tills hen tackat ja.</div>'
            + '<div class="position-relative" style="max-width:420px">'
            + '<input type="text" class="form-control form-control-sm" id="stfPReplace" autocomplete="off" placeholder="Sök vem som tar över…">'
            + '<div class="list-group position-absolute w-100 shadow" id="stfPReplaceResults" style="z-index:5;display:none"></div>'
            + '</div>';

        host.innerHTML = h;
        wirePersonCard(p);
    }

    var SV_STATUS = { Planned: 'Planerad', Invited: 'Inbjuden', Accepted: 'Accepterad', Declined: 'Avböjt', Confirmed: 'Bekräftad' };

    function wirePersonCard(p) {
        var nameEl = document.getElementById('stfPName');
        if (nameEl) {
            nameEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); nameEl.blur(); } });
            nameEl.addEventListener('blur', async function () {
                var v = nameEl.value.trim();
                if (!v || v === p.displayName) { nameEl.value = p.displayName; return; }
                var r = await stfPersonPost({ competitionId: compId, personKey: p.key, newName: v });
                if (!r.success) { alert(r.message || 'Kunde inte byta namn.'); nameEl.value = p.displayName; return; }
                personKey = 'n:' + v.toLowerCase();
                await loadPeople(); renderPerson(); if (window.grdLoad) window.grdLoad();
            });
        }
        wireMemberPicker('stfPLink', 'stfPLinkResults', async function (m) {
            var r = await stfPersonPost({ competitionId: compId, personKey: p.key, memberId: m.memberId });
            if (!r.success) { alert(r.message || 'Kunde inte koppla.'); return; }
            personKey = 'm:' + m.memberId;
            await loadPeople(); renderPerson(); if (window.grdLoad) window.grdLoad();
        });
        wireMemberPicker('stfPReplace', 'stfPReplaceResults', async function (m) {
            if (!confirm('Lämna över alla uppdrag från ' + p.displayName + ' till ' + m.memberName + '?')) return;
            var r = await stfPersonPost({ competitionId: compId, personKey: p.key, memberId: m.memberId, isReplacement: true });
            if (!r.success) { alert(r.message || 'Kunde inte ersätta.'); return; }
            personKey = 'm:' + m.memberId;
            await loadPeople(); renderPerson(); if (window.grdLoad) window.grdLoad();
        }, true);
    }

    /// A live member search under an input — the same gesture as the grid cell. Replaces the numbered
    /// prompt() lists, which asked the organiser to read a menu and type a number back.
    function wireMemberPicker(inputId, resultsId, onPick, allowFreeText) {
        var input = document.getElementById(inputId);
        var box = document.getElementById(resultsId);
        if (!input || !box) return;
        var t = null;
        function hide() { box.style.display = 'none'; box.innerHTML = ''; }
        input.addEventListener('input', function () {
            clearTimeout(t);
            var q = input.value.trim();
            if (q.length < 2) { hide(); return; }
            t = setTimeout(async function () {
                try {
                    var r = await fetch('/umbraco/surface/Staffing/SearchMembers?competitionId=' + compId + '&query=' + encodeURIComponent(q),
                        { headers: { 'Accept': 'application/json' } });
                    var d = await r.json();
                    var list = (d && d.members) ? d.members : [];
                    if (!list.length) {
                        box.innerHTML = '<div class="list-group-item small text-muted">Ingen medlem matchar'
                            + (allowFreeText ? ' — tryck Enter för att spara som fritext' : '') + '</div>';
                        box.style.display = 'block'; return;
                    }
                    box.innerHTML = list.slice(0, 7).map(function (m, i) {
                        return '<button type="button" class="list-group-item list-group-item-action py-1 small" data-i="' + i + '">'
                            + esc(m.memberName) + (m.clubName ? ' <span class="text-muted">' + esc(m.clubName) + '</span>' : '')
                            + '</button>';
                    }).join('');
                    box.style.display = 'block';
                    box.querySelectorAll('button[data-i]').forEach(function (btn) {
                        btn.addEventListener('click', function () { hide(); onPick(list[parseInt(btn.dataset.i, 10)]); });
                    });
                } catch (e) { hide(); }
            }, 200);
        });
        input.addEventListener('blur', function () { setTimeout(hide, 200); });
    }

    window.stfPersonUndo = async function () {
        var p = findPerson(); if (!p) return;
        var r = await stfPersonPost({ competitionId: compId, personKey: p.key }, 'UndoPersonIdentity');
        if (!r.success) { alert(r.message || 'Kunde inte ångra.'); return; }
        personKey = null;   // the key changes back to the free-text name
        await loadPeople();
        var back = people.find(function (x) { return (x.assignments || []).some(function (a) { return true; }); });
        stfBackToList();
        if (window.grdLoad) window.grdLoad();
    };

    /// "Han blev sjuk en timme in i passet." Cut here, someone else takes the rest — one action instead of
    /// two edits with nothing tying them together and a silent hole between them.
    window.stfSplitOpen = function (id) {
        var box = document.getElementById('stfSplit' + id);
        if (!box) return;
        var open = box.style.display !== 'none';
        box.style.display = open ? 'none' : '';
        if (open) return;
        document.getElementById('stfSplitAt' + id).focus();
        wireMemberPicker('stfSplitWho' + id, 'stfSplitRes' + id, async function (m) {
            await stfSplitDo(id, m.memberId, m.memberName);
        }, true);
        var who = document.getElementById('stfSplitWho' + id);
        who.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); stfSplitDo(id, 0, who.value.trim()); }
        });
    };

    async function stfSplitDo(id, memberId, name) {
        var at = (document.getElementById('stfSplitAt' + id).value || '').trim();
        if (!at) { alert('Ange klockslaget där passet delas.'); return; }
        if (!memberId && !name) { alert('Ange vem som tar över.'); return; }
        var r = await stfPersonPost({ competitionId: compId, id: id, at: at, memberId: memberId, newName: memberId ? null : name },
            'SplitAssignment');
        if (!r.success) { alert(r.message || 'Kunde inte dela passet.'); return; }
        await loadPeople(); renderPerson(); if (window.grdLoad) window.grdLoad();
    }

    window.stfPersonSaveEmail = async function () {
        var p = findPerson(); if (!p) return;
        var v = (document.getElementById('stfPEmail').value || '').trim();
        var r = await stfPersonPost({ competitionId: compId, personKey: p.key, email: v });
        if (!r.success) { alert(r.message || 'Kunde inte spara.'); return; }
        await loadPeople(); renderPerson(); if (window.grdLoad) window.grdLoad();
    };

    // ---- person identity ------------------------------------------------------------------------

    var matchRows = [];

    window.stfOpenMatch = function () {
        var p = panel('bemMatchPanel'); if (p) p.show();
        stfLoadMatches();
    };

    window.stfLoadMatches = async function () {
        var host = document.getElementById('stfMatchList');
        host.innerHTML = '<div class="text-muted small">Laddar…</div>';
        try {
            var r = await fetch('/umbraco/surface/Staffing/SuggestPersonMatches?competitionId=' + compId,
                { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { host.innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kunde inte läsa.') + '</div>'; return; }
            matchRows = d.people || [];
            var sum = document.getElementById('stfMatchSummary');
            if (sum) sum.textContent = matchRows.length
                ? (matchRows.length + ' utan koppling · ' + d.confident + ' säkra förslag · ' + d.unmatched + ' utan träff')
                : 'Alla personer är kopplade till medlemmar.';
            var btn = document.getElementById('stfMatchAllBtn');
            if (btn) btn.style.display = d.confident ? '' : 'none';
            renderMatches();
        } catch (e) {
            host.innerHTML = '<div class="alert alert-warning">Kunde inte läsa förslagen.</div>';
        }
    };

    function renderMatches() {
        var host = document.getElementById('stfMatchList');
        if (!matchRows.length) {
            host.innerHTML = '<div class="alert alert-success mb-0"><i class="bi bi-check2-circle me-1"></i>'
                + 'Alla på tävlingen är kopplade till en medlem.</div>';
            return;
        }
        host.innerHTML = matchRows.map(function (m, i) {
            var head = '<div class="fw-semibold">' + esc(m.name)
                + ' <span class="text-muted fw-normal small">' + m.rowCount + (m.rowCount === 1 ? ' uppdrag' : ' uppdrag') + '</span>'
                + (m.confident ? ' <span class="badge bg-success-subtle text-success-emphasis border fw-normal">säkert förslag</span>' : '')
                + '</div>';

            if (m.looksLikeTwoPeople) {
                return '<div class="border rounded p-2 mb-2">' + head
                    + '<div class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>'
                    + 'Ser ut som två personer i samma ruta. Dela upp den i två uppdrag först.</div></div>';
            }
            // Written twice in the same plan — the commonest typo, and the member register can't see it.
            var dup = (m.inPlan || []).length
                ? '<div class="small mt-1 text-warning-emphasis"><i class="bi bi-files me-1"></i>'
                  + 'Finns redan i planen som '
                  + m.inPlan.map(function (x, j) {
                      return '<button type="button" class="btn btn-sm btn-link p-0 align-baseline fw-semibold" onclick="stfMergeInPlan(' + i + ',' + j + ')">'
                          + esc(x.name) + '</button> <span class="text-muted">(' + x.rowCount + ' uppdrag, ' + esc(x.reason) + ')</span>';
                  }).join(', ') + ' — samma person?</div>'
                : '';

            if (!(m.candidates || []).length) {
                return '<div class="border rounded p-2 mb-2">' + head + dup
                    + '<div class="small text-muted">Ingen medlem liknar namnet. '
                    + '<button type="button" class="btn btn-sm btn-link p-0 align-baseline" onclick="stfOpenPerson(\'' + pkey(m.key) + '\')">Öppna personen</button>'
                    + ' och lägg till e-post, så kan hen åtminstone bjudas in.</div></div>';
            }

            var opts = m.candidates.map(function (c, j) {
                return '<option value="' + c.memberId + '"' + (j === 0 && m.confident ? ' selected' : '') + '>'
                    + esc(c.name) + (c.clubName ? ' — ' + esc(c.clubName) : '') + ' (' + esc(c.reason) + ')</option>';
            }).join('');
            return '<div class="border rounded p-2 mb-2">' + head + dup
                + '<div class="d-flex gap-2 align-items-center flex-wrap mt-1">'
                + '<select class="form-select form-select-sm" id="stfMatchSel' + i + '" style="max-width:420px">'
                + '<option value="">— välj medlem —</option>' + opts + '</select>'
                + '<button type="button" class="btn btn-sm btn-primary" onclick="stfLinkOne(' + i + ')">Koppla</button>'
                + '</div></div>';
        }).join('');
    }

    function pkey(s) { return encodeURIComponent(s == null ? '' : s).replace(/'/g, '%27'); }
    function unpkey(s) { try { return decodeURIComponent(s); } catch (e) { return s; } }

    /// Merge a misspelling into the spelling already used elsewhere in the plan. A RENAME, not a link —
    /// and it links too when the target is already tied to a member.
    window.stfMergeInPlan = async function (i, j) {
        var m = matchRows[i]; if (!m) return;
        var t = (m.inPlan || [])[j]; if (!t) return;
        if (!confirm('Är "' + m.name + '" samma person som "' + t.name + '"?\n\n'
            + m.rowCount + ' uppdrag byter namn till ' + t.name + '.')) return;
        var r = await stfPersonPost({
            competitionId: compId, personKey: m.key, newName: t.name,
            memberId: t.memberId > 0 ? t.memberId : 0
        });
        if (!r.success) { alert(r.message || 'Kunde inte slå ihop.'); return; }
        await stfLoadMatches();
        if (window.grdLoad) window.grdLoad();
    };

    window.stfLinkOne = async function (i) {
        var m = matchRows[i]; if (!m) return;
        var sel = document.getElementById('stfMatchSel' + i);
        var id = sel ? parseInt(sel.value, 10) : 0;
        if (!id) { alert('Välj en medlem först.'); return; }
        var r = await stfPersonPost({ competitionId: compId, personKey: m.key, memberId: id });
        if (!r.success) { alert(r.message || 'Kunde inte koppla.'); return; }
        await stfLoadMatches();
        if (window.grdLoad) window.grdLoad();
    };

    /// Only the ones with a single clear winner. Everything ambiguous still needs a human.
    window.stfLinkAllConfident = async function () {
        var todo = matchRows.filter(function (m) { return m.confident && (m.candidates || []).length; });
        if (!todo.length) return;
        if (!confirm('Koppla ' + todo.length + ' personer till de föreslagna medlemmarna?\n\n'
            + todo.slice(0, 12).map(function (m) { return '· ' + m.name + ' → ' + m.candidates[0].name; }).join('\n')
            + (todo.length > 12 ? '\n… och ' + (todo.length - 12) + ' till' : ''))) return;
        var ok = 0;
        for (var k = 0; k < todo.length; k++) {
            var r = await stfPersonPost({ competitionId: compId, personKey: todo[k].key, memberId: todo[k].candidates[0].memberId });
            if (r.success) ok++;
        }
        alert('Kopplade ' + ok + ' av ' + todo.length + '.');
        await stfLoadMatches();
        if (window.grdLoad) window.grdLoad();
    };

    async function stfPersonPost(body, action) {
        try {
            var r = await fetch('/umbraco/surface/Staffing/' + (action || 'ApplyPersonIdentity'), {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN },
                body: JSON.stringify(body)
            });
            return await r.json();
        } catch (e) { return { success: false, message: 'Nätverksfel.' }; }
    }

    // The prompt()-driven rename/link/replace helpers that used to live here are gone. They asked the
    // organiser to read a numbered menu in a browser dialog and type a number back, which is worse than
    // no feature. The person card does all four inline: editable name, live member search, e-mail field,
    // and a separate hand-over search. See renderPerson().

    window.stfOpenBehov = function () {
        var p = panel('bemBehovPanel'); if (p) p.show();
        loadPasses();
    };
    window.stfOpenVarvning = function () {
        var p = panel('bemVarvningPanel'); if (p) p.show();
        loadScopes(); loadHelp();
    };

    // Only the grid and the role catalog load up front — the catalog because the add-funktionär dialog
    // needs it the moment it opens. Everything else waits until someone opens it.
    if (window.grdLoad) window.grdLoad();
    loadRoles();
    startTimer();
})();
</script>
