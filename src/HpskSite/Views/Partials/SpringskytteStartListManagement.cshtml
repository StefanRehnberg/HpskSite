@*
 * Springskytte Multi-Start-List Designer
 * Supports multiple start lists per competition, each covering different class groupings.
 * Each list stored as a separate precisionStartList child node.
 *@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
}

<div class="springskytte-startlist-management" data-competition-id="@competitionId">
    <!-- Designer Controls -->
    <div class="card mb-3">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ol me-2"></i>Startlistor (Springskytte)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="springAddNewList()">
                        <i class="bi bi-plus-lg me-1"></i>Ny startlista
                    </button>
                    <button class="btn btn-success btn-sm" onclick="springRenumberAll()" id="springRenumberBtn" style="display:none" title="Tilldela löpande startnummer per vapengrupp över alla listor">
                        <i class="bi bi-sort-numeric-down me-1"></i>Numrera startnummer
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="springResetNumbers()" id="springResetBtn" style="display:none" title="Återställ till listnumrering (1, 2, 3... per lista)">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Återställ
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body" id="springListCardsContainer">
            <div class="text-center py-4" id="springLoadingIndicator">
                <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Laddar...</span></div>
                <p class="mt-2 text-muted">Laddar startlistor...</p>
            </div>
        </div>
    </div>
</div>

<!-- Flatpickr for time picker -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<style>
    .spring-list-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        margin-bottom: 1rem;
    }
    .spring-list-card .card-header {
        background: var(--bs-tertiary-bg);
    }
    .spring-class-checkbox label {
        cursor: pointer;
        font-size: 0.9rem;
    }
    .spring-class-checkbox .disabled-class {
        opacity: 0.5;
        text-decoration: line-through;
    }
    .spring-class-group-header {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--bs-secondary-color);
        margin-bottom: 0.25rem;
        margin-top: 0.5rem;
    }
    .spring-starters-table th, .spring-starters-table td {
        font-size: 0.85rem;
        padding: 0.3rem 0.5rem;
    }
    .spring-status-badge {
        font-size: 0.75rem;
    }
</style>

<script>
const springCompId = parseInt('@competitionId');
let springAvailableClasses = []; // loaded from server
let springExistingLists = []; // loaded from server
let springLocalCards = []; // client-side card state: { tempId, nodeId, listName, coveredClasses, firstStartTime, defaultInterval, breakAfterEvery, breakDuration, starters, generatedDate }

document.addEventListener('DOMContentLoaded', () => {
    springLoadAll();
});

async function springLoadAll() {
    try {
        const [classesRes, listsRes] = await Promise.all([
            fetch(`/umbraco/surface/Springskytte/GetSpringskytteAvailableClasses?competitionId=${springCompId}`).then(r => r.json()),
            fetch(`/umbraco/surface/Springskytte/GetSpringskytteStartLists?competitionId=${springCompId}`).then(r => r.json())
        ]);

        if (classesRes.success) {
            springAvailableClasses = classesRes.classes;
        }

        springLocalCards = [];
        if (listsRes.success && listsRes.lists?.length > 0) {
            springExistingLists = listsRes.lists;
            for (const list of listsRes.lists) {
                springLocalCards.push({
                    tempId: 'node_' + list.nodeId,
                    nodeId: list.nodeId,
                    listName: list.listName,
                    coveredClasses: list.coveredClasses || [],
                    firstStartTime: list.firstStartTime,
                    defaultInterval: list.defaultInterval,
                    breakAfterEvery: list.breakAfterEvery,
                    breakDuration: list.breakDuration,
                    starters: list.starters || [],
                    generatedDate: list.generatedDate
                });
            }
        }

        springRenderCards();
    } catch (err) {
        console.error('Error loading start list data:', err);
        document.getElementById('springListCardsContainer').innerHTML =
            '<div class="alert alert-danger">Kunde inte ladda startlistor.</div>';
    }
}

function springRenderCards() {
    const container = document.getElementById('springListCardsContainer');
    document.getElementById('springLoadingIndicator')?.remove();

    if (springLocalCards.length === 0) {
        container.innerHTML = `
            <div class="text-center py-4" id="springEmptyState">
                <i class="bi bi-list-ol display-4 text-muted"></i>
                <p class="mt-2 text-muted">Inga startlistor skapade. Klicka "+ Ny startlista" för att skapa en.</p>
            </div>`;
        return;
    }

    // Build all assigned classes for disabling across cards
    const assignedMap = {}; // classId -> tempId of card that owns it
    for (const card of springLocalCards) {
        for (const cls of (card.coveredClasses || [])) {
            assignedMap[cls] = card.tempId;
        }
    }

    let html = '';
    for (const card of springLocalCards) {
        html += springRenderOneCard(card, assignedMap);
    }
    container.innerHTML = html;

    // Initialize flatpickr on new time inputs
    for (const card of springLocalCards) {
        flatpickr(`#springFirstStart_${card.tempId}`, {
            locale: 'sv', enableTime: true, noCalendar: true,
            dateFormat: 'H:i', time_24hr: true, defaultHour: 10, defaultMinute: 0
        });
    }

    springUpdateTopButtons();
}

function springRenderOneCard(card, assignedMap) {
    const isGenerated = card.starters && card.starters.length > 0;
    const statusBadge = isGenerated
        ? `<span class="badge bg-success spring-status-badge"><i class="bi bi-check-circle me-1"></i>Genererad (${card.starters.length} startande${card.generatedDate ? ', ' + card.generatedDate : ''})</span>`
        : `<span class="badge bg-warning text-dark spring-status-badge"><i class="bi bi-exclamation-circle me-1"></i>Ej genererad</span>`;

    // Group available classes by weapon class
    const weaponGroups = {};
    for (const cls of springAvailableClasses) {
        const wc = cls.weaponClass;
        if (!weaponGroups[wc]) weaponGroups[wc] = [];
        weaponGroups[wc].push(cls);
    }

    let classCheckboxesHtml = '';
    for (const [wc, classes] of Object.entries(weaponGroups).sort()) {
        classCheckboxesHtml += `<div class="spring-class-group-header">Vapengrupp ${wc}</div><div class="d-flex flex-wrap gap-2 mb-1">`;
        for (const cls of classes) {
            const isOwned = (card.coveredClasses || []).includes(cls.classId);
            const assignedTo = assignedMap[cls.classId];
            const isOtherCard = assignedTo && assignedTo !== card.tempId;
            const disabled = isOtherCard ? 'disabled' : '';
            const labelClass = isOtherCard ? 'disabled-class' : '';
            const checked = isOwned ? 'checked' : '';
            const otherName = isOtherCard ? ` (${springLocalCards.find(c => c.tempId === assignedTo)?.listName || '?'})` : '';

            classCheckboxesHtml += `
                <div class="form-check form-check-inline spring-class-checkbox">
                    <input class="form-check-input" type="checkbox" id="cls_${card.tempId}_${cls.classId.replace(/\s/g,'_')}"
                        value="${cls.classId}" ${checked} ${disabled}
                        onchange="springToggleClass('${card.tempId}', '${cls.classId}', this.checked)">
                    <label class="form-check-label ${labelClass}" for="cls_${card.tempId}_${cls.classId.replace(/\s/g,'_')}">
                        ${cls.classId} <small class="text-muted">(${cls.count})</small>${otherName}
                    </label>
                </div>`;
        }
        classCheckboxesHtml += '</div>';
    }

    // Starters table
    let startersHtml = '';
    if (isGenerated) {
        startersHtml = springBuildStartersTable(card);
    }

    return `
    <div class="card spring-list-card" id="springCard_${card.tempId}">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <input type="text" class="form-control form-control-sm" style="width:250px;font-weight:600"
                    value="${escapeHtml(card.listName)}"
                    onchange="springUpdateCardName('${card.tempId}', this.value)"
                    placeholder="Listnamn...">
                ${statusBadge}
            </div>
            <button class="btn btn-outline-danger btn-sm" onclick="springDeleteList('${card.tempId}')" title="Ta bort startlista">
                <i class="bi bi-trash"></i>
            </button>
        </div>
        <div class="card-body">
            <!-- Class checkboxes -->
            <div class="mb-3">
                <label class="form-label fw-bold small">Klasser i denna lista:</label>
                ${classCheckboxesHtml}
            </div>

            <!-- Time parameters -->
            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Första starttid</label>
                    <input type="text" class="form-control form-control-sm" id="springFirstStart_${card.tempId}"
                        value="${card.firstStartTime || '10:00'}" placeholder="HH:MM">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Intervall (MM:SS)</label>
                    <input type="text" class="form-control form-control-sm" id="springInterval_${card.tempId}"
                        value="${card.defaultInterval || '01:00'}" placeholder="MM:SS">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Paus efter antal</label>
                    <input type="number" class="form-control form-control-sm" id="springBreakAfter_${card.tempId}"
                        value="${card.breakAfterEvery || 10}" min="3" max="30">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Pauslängd (MM:SS)</label>
                    <input type="text" class="form-control form-control-sm" id="springBreakDur_${card.tempId}"
                        value="${card.breakDuration || '05:00'}" placeholder="MM:SS">
                </div>
            </div>

            <!-- Action buttons -->
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-primary btn-sm" onclick="springGenerateList('${card.tempId}')" id="springGenBtn_${card.tempId}">
                    <i class="bi bi-arrow-clockwise me-1"></i>${isGenerated ? 'Regenerera' : 'Generera'}
                </button>
            </div>

            <!-- Generated starters -->
            ${startersHtml}
        </div>
    </div>`;
}

function springBuildStartersTable(card) {
    if (!card.starters || card.starters.length === 0) return '';

    const interval = card.defaultInterval || '01:00';
    let html = `
        <div class="table-responsive" style="max-height:400px;overflow-y:auto">
            <table class="table table-sm table-striped table-hover spring-starters-table mb-0">
                <thead class="table-light" style="position:sticky;top:0;z-index:1">
                    <tr><th>#</th><th>Starttid</th><th>Namn</th><th>Klubb</th><th>Vapen</th><th>Klass</th></tr>
                </thead>
                <tbody>`;

    let prevTime = null;
    for (const s of card.starters) {
        if (prevTime && s.startTime) {
            const gap = springParseTimeDiff(prevTime, s.startTime);
            const normalInterval = springParseTimeMM(interval);
            if (gap > normalInterval * 1.5) {
                html += `<tr class="table-warning"><td colspan="6" class="text-center small fw-bold py-1">
                    <i class="bi bi-pause-circle me-1"></i>Paus</td></tr>`;
            }
        }
        html += `<tr>
            <td>${s.startOrder}</td>
            <td class="fw-bold" style="font-family:monospace">${s.startTime}</td>
            <td>${escapeHtml(s.name)}</td>
            <td>${escapeHtml(s.club)}</td>
            <td><span class="badge bg-secondary">${s.weaponClass}</span></td>
            <td>${s.ageGenderClass}</td>
        </tr>`;
        prevTime = s.startTime;
    }

    html += '</tbody></table></div>';
    return html;
}

// ===== Card state management =====

let springTempIdCounter = 0;

function springAddNewList() {
    const tempId = 'new_' + (++springTempIdCounter);
    springLocalCards.push({
        tempId,
        nodeId: null,
        listName: 'Ny startlista',
        coveredClasses: [],
        firstStartTime: '10:00',
        defaultInterval: '01:00',
        breakAfterEvery: 10,
        breakDuration: '05:00',
        starters: [],
        generatedDate: ''
    });
    springRenderCards();
}

function springUpdateCardName(tempId, name) {
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (card) card.listName = name;
}

function springToggleClass(tempId, classId, checked) {
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (!card) return;
    if (checked) {
        if (!card.coveredClasses.includes(classId)) {
            card.coveredClasses.push(classId);
        }
    } else {
        card.coveredClasses = card.coveredClasses.filter(c => c !== classId);
    }
    // Re-render to update disabled states across all cards
    springRenderCards();
}

// ===== Generate & Delete =====

async function springGenerateList(tempId) {
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (!card) return;

    // Read current UI values
    card.listName = document.querySelector(`#springCard_${tempId} input[type="text"]`)?.value || card.listName;
    card.firstStartTime = document.getElementById(`springFirstStart_${tempId}`)?.value || '10:00';
    card.defaultInterval = document.getElementById(`springInterval_${tempId}`)?.value || '01:00';
    card.breakAfterEvery = parseInt(document.getElementById(`springBreakAfter_${tempId}`)?.value) || 10;
    card.breakDuration = document.getElementById(`springBreakDur_${tempId}`)?.value || '05:00';

    if (card.coveredClasses.length === 0) {
        alert('Välj minst en klass för denna startlista.');
        return;
    }

    const btn = document.getElementById(`springGenBtn_${tempId}`);
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Genererar...';

    try {
        const requestData = {
            competitionId: springCompId,
            firstStartTime: card.firstStartTime,
            defaultInterval: card.defaultInterval,
            breakAfterEvery: card.breakAfterEvery,
            breakDuration: card.breakDuration,
            coveredClasses: card.coveredClasses,
            listName: card.listName,
            existingNodeId: card.nodeId
        };

        const response = await fetch('/umbraco/surface/Springskytte/GenerateSpringskytteStartList', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(requestData)
        });
        const data = await response.json();

        if (data.success) {
            card.nodeId = data.nodeId;
            card.starters = data.starters || [];
            card.generatedDate = new Date().toISOString().slice(0, 16).replace('T', ' ');
            card.tempId = 'node_' + data.nodeId; // Normalize tempId
            springRenderCards();
        } else {
            alert(data.message || 'Fel vid generering.');
        }
    } catch (err) {
        console.error('Error generating start list:', err);
        alert('Ett fel uppstod vid generering av startlista.');
    } finally {
        const btnEl = document.getElementById(`springGenBtn_${tempId}`);
        if (btnEl) {
            btnEl.disabled = false;
            btnEl.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Generera';
        }
    }
}

async function springDeleteList(tempId) {
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (!card) return;

    if (!confirm(`Ta bort startlistan "${card.listName}"?`)) return;

    if (card.nodeId) {
        // Delete from server
        try {
            const response = await fetch('/umbraco/surface/Springskytte/DeleteSpringskytteStartList', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ competitionId: springCompId, nodeId: card.nodeId })
            });
            const data = await response.json();
            if (!data.success) {
                alert(data.message || 'Fel vid borttagning.');
                return;
            }
        } catch (err) {
            console.error('Error deleting start list:', err);
            alert('Ett fel uppstod vid borttagning.');
            return;
        }
    }

    // Remove from local state
    springLocalCards = springLocalCards.filter(c => c.tempId !== tempId);
    springRenderCards();
}

// ===== Renumber & Reset =====

async function springRenumberAll() {
    if (!confirm('Tilldela löpande startnummer per vapengrupp över alla genererade listor?')) return;

    const btn = document.getElementById('springRenumberBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Numrerar...';

    try {
        const response = await fetch('/umbraco/surface/Springskytte/RenumberSpringskytteStartLists', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(springCompId)
        });
        const data = await response.json();
        if (data.success) {
            alert(data.message);
            await springLoadAll();
        } else {
            alert(data.message || 'Fel vid numrering.');
        }
    } catch (err) {
        console.error('Error renumbering:', err);
        alert('Ett fel uppstod.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-sort-numeric-down me-1"></i>Numrera startnummer';
    }
}

async function springResetNumbers() {
    if (!confirm('Återställ alla startnummer till listnumrering (1, 2, 3... per lista)?')) return;

    const btn = document.getElementById('springResetBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Återställer...';

    try {
        const response = await fetch('/umbraco/surface/Springskytte/ResetSpringskytteStartNumbers', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(springCompId)
        });
        const data = await response.json();
        if (data.success) {
            alert(data.message);
            await springLoadAll();
        } else {
            alert(data.message || 'Fel vid återställning.');
        }
    } catch (err) {
        console.error('Error resetting:', err);
        alert('Ett fel uppstod.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Återställ';
    }
}

function springUpdateTopButtons() {
    const hasGenerated = springLocalCards.some(c => c.starters && c.starters.length > 0);
    const hasMultiple = springLocalCards.filter(c => c.starters && c.starters.length > 0).length > 1;
    document.getElementById('springRenumberBtn').style.display = hasGenerated ? '' : 'none';
    document.getElementById('springResetBtn').style.display = hasGenerated ? '' : 'none';
}

// ===== Helpers =====

function springParseTimeDiff(t1, t2) {
    const toSec = t => {
        const p = t.split(':').map(Number);
        return p.length === 3 ? p[0]*3600+p[1]*60+p[2] : p[0]*3600+p[1]*60;
    };
    return toSec(t2) - toSec(t1);
}

function springParseTimeMM(mmss) {
    if (!mmss) return 60;
    const p = mmss.split(':').map(Number);
    return p.length === 2 ? p[0]*60+p[1] : p[0]*60;
}

function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}
</script>
