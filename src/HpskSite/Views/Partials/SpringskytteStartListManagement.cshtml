@*
 * Springskytte Multi-Start-List Designer
 * Supports multiple start lists per competition, each covering different class groupings.
 * Each list stored as a separate precisionStartList child node.
 * Per-list settings (classes + times) live in a settings modal (opened by "Ny startlista"
 * or the cog in each card header) so the list cards stay clean and un-intimidating.
 *@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
}

<div class="springskytte-startlist-management" data-competition-id="@competitionId">
    <!-- Designer Controls -->
    <div class="card mb-3">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-list-ol me-2"></i>Startlistor (Springskytte)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="springAddNewList()">
                        <i class="bi bi-plus-lg me-1"></i>Ny startlista
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" id="springNumberingBtn" style="display:none"
                        onclick="springOpenRenumberModal()" title="Sätt startnummer per lista — välj var varje lista börjar eller låt den fortsätta på föregående">
                        <i class="bi bi-sort-numeric-down me-1"></i>Numrera om
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Duplicate start-number warning: a number must be unique across the whole competition. -->
            <div class="alert alert-danger d-flex justify-content-between align-items-center d-none" id="springDupWarn">
                <span id="springDupWarnText"></span>
                <button class="btn btn-danger btn-sm ms-3" onclick="springOpenRenumberModal()"><i class="bi bi-sort-numeric-down me-1"></i>Numrera om nu</button>
            </div>
            <div id="springListCardsContainer">
                <div class="text-center py-4" id="springLoadingIndicator">
                    <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">Laddar...</span></div>
                    <p class="mt-2 text-muted">Laddar startlistor...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Settings modal: per-list classes + time parameters (kept out of the card to reduce clutter) -->
<div class="modal fade" id="springSettingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-gear me-2"></i><span id="springSettingsTitle">Startlisteinställningar</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <!-- Section A: name + date. Saved on its own — never rebuilds the start list,
                     so it's safe to rename / redate a published list. -->
                <div class="border rounded p-3 mb-3">
                    <div class="fw-bold small mb-2"><i class="bi bi-card-text me-1"></i>Namn &amp; datum</div>
                    <div class="mb-2">
                        <label class="form-label small" for="springSet_name">Listnamn</label>
                        <input type="text" class="form-control" id="springSet_name" placeholder="T.ex. Seniorer lördag" maxlength="80">
                        <div class="form-text">Namnet blir startlistans webbadress och måste vara unikt.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small" for="springSet_date">Datum <span class="text-muted">(för flerdagarstävlingar)</span></label>
                        <input type="text" class="form-control form-control-sm" id="springSet_date" placeholder="ÅÅÅÅ-MM-DD" style="max-width:220px">
                    </div>
                    <div class="alert alert-danger py-2 mb-2 d-none" id="springMetaError"></div>
                    <div class="d-flex align-items-center gap-2" id="springMetaSaveRow" style="display:none!important">
                        <button type="button" class="btn btn-primary btn-sm" id="springSaveMetaBtn" onclick="springSaveMeta()">
                            <i class="bi bi-check-lg me-1"></i>Spara namn &amp; datum
                        </button>
                        <span class="small" id="springMetaSavedMsg"></span>
                    </div>
                </div>

                <!-- Section B: classes + times. Saving here REBUILDS the list (reshuffles start
                     numbers + times) — guarded, especially when the list is published. -->
                <div class="border rounded p-3">
                    <div class="fw-bold small mb-2"><i class="bi bi-arrow-clockwise me-1"></i>Klasser &amp; tider</div>
                    <div class="mb-3">
                        <label class="form-label small">Klasser i denna lista</label>
                        <div id="springSettingsClasses"></div>
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-md-3">
                            <label class="form-label small">Första starttid</label>
                            <input type="text" class="form-control form-control-sm" id="springSet_firstStart" placeholder="HH:MM">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Intervall (MM:SS)</label>
                            <input type="text" class="form-control form-control-sm" id="springSet_interval" placeholder="MM:SS">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Paus efter antal</label>
                            <input type="number" class="form-control form-control-sm" id="springSet_breakAfter" min="3" max="30">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">Pauslängd (MM:SS)</label>
                            <input type="text" class="form-control form-control-sm" id="springSet_breakDur" placeholder="MM:SS">
                        </div>
                    </div>
                    <div class="alert alert-warning py-2 mb-2 d-none" id="springRebuildWarn">
                        <i class="bi bi-exclamation-triangle me-1"></i><span id="springRebuildWarnText"></span>
                    </div>
                    <div class="alert alert-danger py-2 mb-2 d-none" id="springSettingsError"></div>
                    <button type="button" class="btn btn-primary" id="springSettingsGenBtn" onclick="springGenerateFromModal()">
                        <i class="bi bi-play-fill me-1"></i>Generera startlista
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit starter modal (items 3 & 4: change start number + start time without regenerating) -->
<div class="modal fade" id="springEditStarterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Redigera startande</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3"><strong id="springEditStarterName">–</strong>
                    <span class="text-muted" id="springEditStarterClass"></span></p>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Startnummer</label>
                        <input type="number" class="form-control" id="springEditStarterOrder" min="0">
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Starttid (ledig lucka)</label>
                        <select class="form-select" id="springEditStarterSlot"></select>
                    </div>
                </div>
                <div class="form-text">Endast lediga tider går att välja. Övriga skyttars startnummer och tider påverkas inte.</div>
                <hr>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="springEditStarterDns">
                    <label class="form-check-label" for="springEditStarterDns">DNS – skytten startar inte (frigör starttiden)</label>
                </div>
                <div class="alert alert-danger mt-3 mb-0 py-2 d-none" id="springEditStarterError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="springEditStarterSaveBtn" onclick="springSaveStarterEdit()">
                    <i class="bi bi-check-lg me-1"></i>Spara
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Renumber modal: per-list start number + follow-on, with a live preview of the resulting ranges. -->
<div class="modal fade" id="springRenumberModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-sort-numeric-down me-2"></i>Numrera om startlistor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    <strong>Bara listor du bockar i <em>Numrera om</em> ändras.</strong> Övriga listor behåller
                    sina startnummer precis som de är. Sätt vilket startnummer en ikryssad lista börjar på, eller
                    bocka i <em>Fortsätt från föregående</em> så fortsätter den på numret efter föregående lista.
                    <strong>Varje vapengrupp numreras för sig</strong> — A kan gå 1–4 medan C går 1–20.
                    Numren är unika inom vapengruppen; krockar en plan med en lista du lämnat orörd får du
                    ett felmeddelande i stället för dubbla nummer. Listor som är numrerade för hand är
                    omarkerade från början.
                </p>
                <div id="springRenumberRows">
                    <div class="text-center py-3 text-muted">
                        <div class="spinner-border spinner-border-sm" role="status"></div> Laddar…
                    </div>
                </div>
                <div class="alert alert-danger mt-2 mb-0 py-2 d-none" id="springRenumberError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="springRenumberApplyBtn" onclick="springApplyRenumber()">
                    <i class="bi bi-check-lg me-1"></i>Tilldela startnummer
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Flatpickr for time picker -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<style>
    .spring-list-card {
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        margin-bottom: 1rem;
    }
    .spring-list-card .card-header {
        background: var(--bs-tertiary-bg);
    }
    .spring-class-checkbox label {
        cursor: pointer;
        font-size: 0.9rem;
    }
    .spring-class-checkbox .disabled-class {
        opacity: 0.5;
        text-decoration: line-through;
    }
    .spring-class-group-header {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--bs-secondary-color);
        margin-bottom: 0.25rem;
        margin-top: 0.5rem;
    }
    .spring-settings-summary {
        font-size: 0.85rem;
        color: var(--bs-secondary-color);
    }
    .spring-settings-summary .badge {
        font-weight: 500;
    }
    .spring-starters-table th, .spring-starters-table td {
        font-size: 0.85rem;
        padding: 0.3rem 0.5rem;
    }
    .spring-status-badge {
        font-size: 0.75rem;
    }
    @@keyframes springCardFlash {
        0%   { box-shadow: 0 0 0 0 rgba(13,110,253,0.55); }
        100% { box-shadow: 0 0 0 8px rgba(13,110,253,0); }
    }
    .spring-card-flash {
        animation: springCardFlash 1.3s ease-out;
        border-color: var(--bs-primary) !important;
    }
    @@media (prefers-reduced-motion: reduce) {
        .spring-card-flash { animation: none; }
    }
</style>

<script>
// Format Springskytte age class with age span (e.g. "H 50" → "H 50-59")
function formatAgeSpan(cls) {
    if (!cls) return cls;
    var inline = {'21':'21-34','35':'35-49','50':'50-59','60':'60-64','65':'65-69','70':'70+'};
    var parens = {'15':'-15 år','18':'16-18 år','jun':'15-20 år'};
    for (var code in inline) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls.substring(0, cls.length - code.length) + inline[code];
    }
    for (var code in parens) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls + ' (' + parens[code] + ')';
    }
    return cls;
}

const springCompId = parseInt('@competitionId');
let springAvailableClasses = []; // loaded from server
let springExistingLists = []; // loaded from server
let _springHasResults = false;

// Check if results exist
fetch('/umbraco/surface/Springskytte/HasResults?competitionId=' + springCompId)
    .then(function(r) { return r.json(); })
    .then(function(d) { _springHasResults = d.hasResults || false; })
    .catch(function() {});

function confirmIfResultsExist(action) {
    if (!_springHasResults) return true;
    return confirm('OBS! Det finns redan registrerade resultat för denna tävling.\n\nÄndring av startlistan kan påverka pågående tävling.\n\nVill du fortsätta med: ' + action + '?');
}
let springLocalCards = []; // client-side card state: { tempId, nodeId, listName, coveredClasses, firstStartTime, defaultInterval, breakAfterEvery, breakDuration, starters, generatedDate }
let springFocusNameNodeId = null; // node id to focus its name field after the next render (freshly created list)

document.addEventListener('DOMContentLoaded', () => {
    springLoadAll();
    // When the settings modal closes without generating a brand-new list, drop the orphan temp card.
    const modalEl = document.getElementById('springSettingsModal');
    if (modalEl) modalEl.addEventListener('hidden.bs.modal', springOnSettingsHidden);
});

async function springLoadAll() {
    try {
        const [classesRes, listsRes] = await Promise.all([
            fetch(`/umbraco/surface/Springskytte/GetSpringskytteAvailableClasses?competitionId=${springCompId}`).then(r => r.json()),
            fetch(`/umbraco/surface/Springskytte/GetSpringskytteStartLists?competitionId=${springCompId}`).then(r => r.json())
        ]);

        if (classesRes.success) {
            springAvailableClasses = classesRes.classes;
        }

        springLocalCards = [];
        if (listsRes.success && listsRes.lists?.length > 0) {
            springExistingLists = listsRes.lists;
            for (const list of listsRes.lists) {
                springLocalCards.push({
                    tempId: 'node_' + list.nodeId,
                    nodeId: list.nodeId,
                    listName: list.listName,
                    slug: list.slug || '',
                    listDate: list.listDate || '',
                    coveredClasses: list.coveredClasses || [],
                    firstStartTime: list.firstStartTime,
                    defaultInterval: list.defaultInterval,
                    breakAfterEvery: list.breakAfterEvery,
                    breakDuration: list.breakDuration,
                    starters: list.starters || [],
                    generatedDate: list.generatedDate,
                    isOfficial: list.isOfficial === true
                });
            }
        }

        springRenderCards();
    } catch (err) {
        console.error('Error loading start list data:', err);
        document.getElementById('springListCardsContainer').innerHTML =
            '<div class="alert alert-danger">Kunde inte ladda startlistor.</div>';
    }
}

function springRenderCards() {
    const container = document.getElementById('springListCardsContainer');
    document.getElementById('springLoadingIndicator')?.remove();

    if (springLocalCards.length === 0) {
        container.innerHTML = `
            <div class="text-center py-4" id="springEmptyState">
                <i class="bi bi-list-ol display-4 text-muted"></i>
                <p class="mt-2 text-muted">Inga startlistor skapade. Klicka "+ Ny startlista" för att skapa en.</p>
            </div>`;
        springUpdateTopButtons();
        return;
    }

    let html = '';
    for (const card of springLocalCards) {
        html += springRenderOneCard(card);
    }
    container.innerHTML = html;

    springUpdateTopButtons();

    // Focus the name of a freshly generated list so it can be renamed immediately.
    if (springFocusNameNodeId) {
        const el = document.getElementById(`springCard_node_${springFocusNameNodeId}`);
        if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.add('spring-card-flash');
            setTimeout(() => el.classList.remove('spring-card-flash'), 1500);
            const nameInput = el.querySelector('input[type="text"]');
            if (nameInput) { nameInput.focus(); nameInput.select(); }
        }
        springFocusNameNodeId = null;
    }
}

function springRenderOneCard(card) {
    const isGenerated = card.starters && card.starters.length > 0;
    const statusBadge = isGenerated
        ? `<span class="badge bg-success spring-status-badge"><i class="bi bi-check-circle me-1"></i>Genererad (${card.starters.length} startande${card.generatedDate ? ', ' + card.generatedDate : ''})</span>`
        : `<span class="badge bg-warning text-dark spring-status-badge"><i class="bi bi-exclamation-circle me-1"></i>Ej genererad</span>`;

    // Body: a compact read-only summary of the settings, then the generated starters (or a hint).
    const summaryHtml = springBuildSettingsSummary(card);
    const bodyHtml = isGenerated
        ? summaryHtml + springBuildStartersTable(card)
        : `${summaryHtml}<div class="text-muted small py-2">
               <i class="bi bi-gear me-1"></i>Öppna inställningar (kugghjulet) för att välja klasser och tider och generera startlistan.</div>`;

    return `
    <div class="card spring-list-card" id="springCard_${card.tempId}">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold" style="font-size:1rem">${escapeHtml(card.listName) || '<span class="text-muted fst-italic">Namnlös lista</span>'}</span>
                ${statusBadge}
                ${card.nodeId ? (card.isOfficial
                    ? '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Officiell</span>'
                    : '<span class="badge bg-secondary"><i class="bi bi-hourglass-split me-1"></i>Preliminär</span>') : ''}
            </div>
            <div class="d-flex align-items-center gap-2">
                ${(card.nodeId && card.slug)
                    ? `<a class="btn btn-outline-primary btn-sm" href="/startlista/${springCompId}/${encodeURIComponent(card.slug)}" target="_blank" rel="noopener" title="Öppna startlistan för visning och utskrift"><i class="bi bi-printer me-1"></i>Visa / skriv ut</a>`
                    : ''}
                <button class="btn btn-outline-secondary btn-sm" onclick="springOpenSettings('${card.tempId}')" title="Inställningar (klasser & tider)">
                    <i class="bi bi-gear"></i>
                </button>
                ${card.nodeId ? (card.isOfficial
                    ? `<button class="btn btn-outline-secondary btn-sm" onclick="springToggleOfficial('${card.tempId}', false)" title="Gör startlistan preliminär igen"><i class="bi bi-arrow-counterclockwise me-1"></i>Gör preliminär</button>`
                    : `<button class="btn btn-success btn-sm" onclick="springToggleOfficial('${card.tempId}', true)" title="Publicera som officiell startlista"><i class="bi bi-check-circle me-1"></i>Publicera officiell</button>`) : ''}
                <button class="btn btn-outline-danger btn-sm" onclick="springDeleteList('${card.tempId}')" title="Ta bort startlista">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            ${bodyHtml}
        </div>
    </div>`;
}

// Compact, read-only summary of a card's settings (shown on the card; edited in the modal).
function springBuildSettingsSummary(card) {
    const classes = (card.coveredClasses || []);
    const classText = classes.length
        ? classes.map(c => `<span class="badge bg-light text-dark border me-1">${formatAgeSpan(c)}</span>`).join('')
        : '<span class="text-muted fst-italic">Inga klasser valda</span>';
    return `
        <div class="spring-settings-summary mb-3">
            <div class="mb-1">${classText}</div>
            <div>
                ${card.listDate ? `<i class="bi bi-calendar-event me-1"></i>${escapeHtml(card.listDate)} · ` : ''}
                <i class="bi bi-clock me-1"></i>Start ${escapeHtml(card.firstStartTime || '10:00')}
                · Intervall ${escapeHtml(card.defaultInterval || '01:00')}
                · Paus ${escapeHtml(card.breakDuration || '05:00')} efter ${card.breakAfterEvery || 10}
            </div>
        </div>`;
}

function springBuildStartersTable(card) {
    if (!card.starters || card.starters.length === 0) return '';

    const interval = card.defaultInterval || '01:00';
    const normalInterval = springParseTimeMM(interval);
    const breakSec = springParseTimeMM(card.breakDuration || '05:00');
    const canEdit = !!card.nodeId; // only persisted lists can be edited per-shooter
    const colCount = canEdit ? 7 : 6;
    let html = `
        <div class="table-responsive" style="max-height:400px;overflow-y:auto">
            <table class="table table-sm table-striped table-hover spring-starters-table mb-0">
                <thead class="table-light" style="position:sticky;top:0;z-index:1">
                    <tr><th>#</th><th>Starttid</th><th>Namn</th><th>Klubb</th><th>Vapen</th><th>Klass</th>${canEdit ? '<th></th>' : ''}</tr>
                </thead>
                <tbody>`;

    let prevTime = null;
    for (const s of card.starters) {
        if (prevTime && s.startTime) {
            const gap = springParseTimeDiff(prevTime, s.startTime);
            if (gap > normalInterval * 1.5) {
                // Distinguish a configured pause (≈ break duration, 3-5 min) from an open slot
                // (a single missing interval, e.g. a shooter moved away) — different styling.
                const isPause = breakSec > 0 ? (gap - normalInterval) >= breakSec * 0.75 : gap >= normalInterval * 4;
                if (isPause) {
                    html += `<tr class="table-warning"><td colspan="${colCount}" class="text-center small fw-bold py-1">
                        <i class="bi bi-pause-circle me-1"></i>Paus</td></tr>`;
                } else {
                    const steps = Math.round(gap / normalInterval) - 1;
                    const prevSec = springHmsToSec(prevTime);
                    for (let k = 1; k <= steps; k++) {
                        const slot = springSecToHms(prevSec + k * normalInterval);
                        html += `<tr style="background:#fafbfc"><td></td>
                            <td style="font-family:monospace;color:#8a94a0">${slot}</td>
                            <td colspan="${colCount - 2}" class="small fst-italic text-muted"><i class="bi bi-dash-circle me-1"></i>Ledig tid</td></tr>`;
                    }
                }
            }
        }
        const editCell = canEdit
            ? `<td class="text-end"><button class="btn btn-outline-primary btn-sm py-0 px-1"
                   onclick="springEditStarter('${card.tempId}', ${s.memberId}, '${s.weaponClass}')"
                   title="Redigera startnummer och starttid"><i class="bi bi-pencil"></i></button></td>`
            : '';
        html += `<tr>
            <td>${s.startOrder}</td>
            <td class="fw-bold" style="font-family:monospace">${s.startTime}</td>
            <td>${escapeHtml(s.name)}</td>
            <td>${escapeHtml(s.club)}</td>
            <td><span class="badge bg-secondary">${s.weaponClass}</span></td>
            <td>${formatAgeSpan(s.ageGenderClass)}</td>
            ${editCell}
        </tr>`;
        prevTime = s.startTime;
    }

    html += '</tbody></table></div>';
    return html;
}

// ===== Settings modal (classes + times) =====
let springModalCtx = null; // { tempId, isNew, generated }

function springOpenSettings(tempId) {
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (!card) return;
    const isExisting = !!card.nodeId;
    springModalCtx = { tempId, isNew: !isExisting, generated: false };

    document.getElementById('springSettingsTitle').textContent = isExisting
        ? `Inställningar – ${card.listName || 'startlista'}`
        : 'Ny startlista';

    // Section A (name & date) gets its own save only for an existing list — a new list is
    // created by the generate button, so there's nothing to "save separately" yet.
    document.getElementById('springMetaSaveRow').style.display = isExisting ? 'flex' : 'none';
    const metaMsg = document.getElementById('springMetaSavedMsg'); if (metaMsg) metaMsg.innerHTML = '';
    const metaErr = document.getElementById('springMetaError'); metaErr.classList.add('d-none'); metaErr.textContent = '';

    // Section B (classes & times) is the rebuild action.
    document.getElementById('springSettingsGenBtn').innerHTML = isExisting
        ? '<i class="bi bi-arrow-clockwise me-1"></i>Generera om startlistan'
        : '<i class="bi bi-play-fill me-1"></i>Generera startlista';

    // Warn before rebuilding an existing list (reshuffles numbers/times); extra-strong if published.
    const warn = document.getElementById('springRebuildWarn');
    const warnText = document.getElementById('springRebuildWarnText');
    if (isExisting && card.isOfficial) {
        warnText.textContent = 'Denna startlista är PUBLICERAD som officiell. Att generera om ger alla skyttar nya startnummer och tider och skriver över eventuella manuella ändringar. Ändra bara namn/datum ovan om det är det du vill.';
        warn.classList.remove('d-none');
    } else if (isExisting) {
        warnText.textContent = 'Att generera om ger alla skyttar nya startnummer och tider och skriver över eventuella manuella ändringar. Vill du bara byta namn eller datum använder du "Spara namn & datum" ovan.';
        warn.classList.remove('d-none');
    } else {
        warn.classList.add('d-none');
    }

    const err = document.getElementById('springSettingsError');
    err.classList.add('d-none'); err.textContent = '';

    // List name
    document.getElementById('springSet_name').value = card.listName || '';

    // Time fields
    document.getElementById('springSet_date').value = card.listDate || '';
    document.getElementById('springSet_firstStart').value = card.firstStartTime || '10:00';
    document.getElementById('springSet_interval').value = card.defaultInterval || '01:00';
    document.getElementById('springSet_breakAfter').value = card.breakAfterEvery || 10;
    document.getElementById('springSet_breakDur').value = card.breakDuration || '05:00';

    // Class checkboxes (working copy so Avbryt discards changes)
    springModalCtx.coveredClasses = [...(card.coveredClasses || [])];
    springRenderSettingsClasses();

    bootstrap.Modal.getOrCreateInstance(document.getElementById('springSettingsModal')).show();

    flatpickr('#springSet_firstStart', {
        locale: 'sv', enableTime: true, noCalendar: true,
        dateFormat: 'H:i', time_24hr: true, defaultHour: 10, defaultMinute: 0
    });
    flatpickr('#springSet_date', { locale: 'sv', dateFormat: 'Y-m-d', allowInput: true });
}

function springRenderSettingsClasses() {
    if (!springModalCtx) return;
    const card = springLocalCards.find(c => c.tempId === springModalCtx.tempId);

    // Which classes are already owned by OTHER lists (can't be picked here).
    const assignedMap = {}; // classId -> owning list name
    for (const c of springLocalCards) {
        if (c.tempId === springModalCtx.tempId) continue;
        for (const cls of (c.coveredClasses || [])) assignedMap[cls] = c.listName || '?';
    }

    // Group by weapon class
    const weaponGroups = {};
    for (const cls of springAvailableClasses) {
        (weaponGroups[cls.weaponClass] ||= []).push(cls);
    }

    let html = '';
    for (const [wc, classes] of Object.entries(weaponGroups).sort()) {
        html += `<div class="spring-class-group-header">Vapengrupp ${wc}</div><div class="d-flex flex-wrap gap-2 mb-1">`;
        for (const cls of classes) {
            const owned = springModalCtx.coveredClasses.includes(cls.classId);
            const otherOwner = assignedMap[cls.classId];
            const disabled = otherOwner ? 'disabled' : '';
            const labelClass = otherOwner ? 'disabled-class' : '';
            const checked = owned ? 'checked' : '';
            const otherName = otherOwner ? ` (${escapeHtml(otherOwner)})` : '';
            const safeId = 'setcls_' + cls.classId.replace(/\s/g, '_');
            html += `
                <div class="form-check form-check-inline spring-class-checkbox">
                    <input class="form-check-input" type="checkbox" id="${safeId}"
                        value="${cls.classId}" ${checked} ${disabled}
                        onchange="springToggleModalClass('${cls.classId}', this.checked)">
                    <label class="form-check-label ${labelClass}" for="${safeId}">
                        ${formatAgeSpan(cls.classId)} <small class="text-muted">(${cls.count})</small>${otherName}
                    </label>
                </div>`;
        }
        html += '</div>';
    }
    document.getElementById('springSettingsClasses').innerHTML = html
        || '<div class="text-muted small">Inga klasser tillgängliga för denna tävling.</div>';
}

function springToggleModalClass(classId, checked) {
    if (!springModalCtx) return;
    if (checked) {
        if (!springModalCtx.coveredClasses.includes(classId)) springModalCtx.coveredClasses.push(classId);
    } else {
        springModalCtx.coveredClasses = springModalCtx.coveredClasses.filter(c => c !== classId);
    }
}

// Shared name validation — required, valid slug, unique among the OTHER lists (slug drives the URL).
// Returns an error string, or null if OK.
function springNameSlugError(name, selfTempId) {
    if (!name) return 'Ange ett listnamn.';
    const slug = springSlugify(name);
    if (!slug) return 'Ogiltigt listnamn — använd bokstäver eller siffror.';
    const clash = springLocalCards.some(c => {
        if (c.tempId === selfTempId) return false;
        const otherSlug = c.slug || springSlugify(c.listName || '');
        return otherSlug && otherSlug === slug;
    });
    if (clash) return `Namnet "${name}" (eller ett namn som ger samma webbadress) används redan. Välj ett unikt namn.`;
    return null;
}

// Save ONLY name + date (section A) — never rebuilds the list, so it's safe on a published list.
async function springSaveMeta() {
    if (!springModalCtx) return;
    const card = springLocalCards.find(c => c.tempId === springModalCtx.tempId);
    if (!card || !card.nodeId) return;

    const err = document.getElementById('springMetaError');
    const msg = document.getElementById('springMetaSavedMsg');
    err.classList.add('d-none'); err.textContent = ''; if (msg) msg.innerHTML = '';
    const showErr = (m) => { err.textContent = m; err.classList.remove('d-none'); };

    const newName = (document.getElementById('springSet_name').value || '').trim();
    const newDate = (document.getElementById('springSet_date').value || '').trim();
    const nameErr = springNameSlugError(newName, card.tempId);
    if (nameErr) { showErr(nameErr); return; }

    const btn = document.getElementById('springSaveMetaBtn');
    btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...';
    try {
        const data = await fetch('/umbraco/surface/Springskytte/SaveSpringskytteStartListMeta', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value },
            body: JSON.stringify({ competitionId: springCompId, nodeId: card.nodeId, listName: newName, listDate: newDate })
        }).then(r => r.json());
        if (data.success) {
            card.listName = data.listName || newName;
            card.listDate = data.listDate || newDate;
            if (data.slug) card.slug = data.slug;
            springRenderCards(); // reflect the new name/date/URL on the card behind the modal
            document.getElementById('springSettingsTitle').textContent = `Inställningar – ${card.listName}`;
            if (msg) msg.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Sparat</span>';
        } else {
            showErr(data.message || 'Kunde inte spara.');
        }
    } catch (e) {
        showErr('Ett fel uppstod.');
    } finally {
        btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Spara namn & datum';
    }
}

async function springGenerateFromModal() {
    if (!springModalCtx) return;
    const card = springLocalCards.find(c => c.tempId === springModalCtx.tempId);
    if (!card) return;
    const wasExisting = !!card.nodeId;

    const err = document.getElementById('springSettingsError');
    err.classList.add('d-none'); err.textContent = '';
    const showErr = (m) => { err.textContent = m; err.classList.remove('d-none'); };

    // Read modal fields into the card
    const newName = (document.getElementById('springSet_name').value || '').trim();
    const nameErr = springNameSlugError(newName, card.tempId);
    if (nameErr) { showErr(nameErr); return; }
    if (springModalCtx.coveredClasses.length === 0) { showErr('Välj minst en klass för denna startlista.'); return; }

    // Guard the destructive rebuild. Published list = extra-strong confirm.
    if (wasExisting) {
        const warn = card.isOfficial
            ? `"${card.listName}" är PUBLICERAD som officiell. Att generera om ger ALLA skyttar nya startnummer och tider och skriver över manuella ändringar.\n\nÄr du helt säker?`
            : `Generera om "${card.listName}"? Alla skyttar får nya startnummer och tider och manuella ändringar skrivs över.`;
        if (!confirm(warn)) return;
    }
    if (!confirmIfResultsExist(wasExisting ? 'Generera om startlista' : 'Generera startlista')) return;

    card.listName = newName;
    card.listDate = (document.getElementById('springSet_date').value || '').trim();
    card.firstStartTime = document.getElementById('springSet_firstStart').value || '10:00';
    card.defaultInterval = document.getElementById('springSet_interval').value || '01:00';
    card.breakAfterEvery = parseInt(document.getElementById('springSet_breakAfter').value) || 10;
    card.breakDuration = document.getElementById('springSet_breakDur').value || '05:00';
    card.coveredClasses = [...springModalCtx.coveredClasses];

    const btn = document.getElementById('springSettingsGenBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Genererar...';

    try {
        const requestData = {
            competitionId: springCompId,
            firstStartTime: card.firstStartTime,
            defaultInterval: card.defaultInterval,
            breakAfterEvery: card.breakAfterEvery,
            breakDuration: card.breakDuration,
            coveredClasses: card.coveredClasses,
            listName: card.listName,
            listDate: card.listDate || '',
            existingNodeId: card.nodeId
        };
        const data = await fetch('/umbraco/surface/Springskytte/GenerateSpringskytteStartList', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(requestData)
        }).then(r => r.json());

        if (data.success) {
            springModalCtx.generated = true;
            if (!wasExisting) springFocusNameNodeId = data.nodeId; // focus the new list's name after reload
            bootstrap.Modal.getOrCreateInstance(document.getElementById('springSettingsModal')).hide();
            await springLoadAll();
        } else {
            err.textContent = data.message || 'Fel vid generering.';
            err.classList.remove('d-none');
        }
    } catch (e) {
        console.error('Error generating start list:', e);
        err.textContent = 'Ett fel uppstod vid generering av startlista.';
        err.classList.remove('d-none');
    } finally {
        btn.disabled = false;
        btn.innerHTML = wasExisting
            ? '<i class="bi bi-arrow-clockwise me-1"></i>Generera om startlistan'
            : '<i class="bi bi-play-fill me-1"></i>Generera startlista';
    }
}

// If a brand-new list's settings modal is dismissed without generating, drop the orphan temp card.
function springOnSettingsHidden() {
    if (!springModalCtx) return;
    const ctx = springModalCtx;
    springModalCtx = null;
    if (ctx.isNew && !ctx.generated) {
        const card = springLocalCards.find(c => c.tempId === ctx.tempId);
        if (card && !card.nodeId) {
            springLocalCards = springLocalCards.filter(c => c.tempId !== ctx.tempId);
            springRenderCards();
        }
    }
}

// ===== Publish toggle: preliminary <-> official (per list, independent) =====
async function springToggleOfficial(tempId, makeOfficial) {
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (!card || !card.nodeId) return;
    try {
        const r = await fetch('/umbraco/surface/Springskytte/SetSpringskytteStartListOfficial', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify({ competitionId: parseInt(springCompId, 10), nodeId: card.nodeId, isOfficial: makeOfficial })
        });
        const d = await r.json();
        if (d.success) { card.isOfficial = makeOfficial; springRenderCards(); }
        else alert(d.message || 'Kunde inte ändra status.');
    } catch (e) { alert('Ett fel uppstod.'); }
}

// ===== Per-shooter edit (items 3 & 4): move to a FREE slot (no collisions) + DNS =====
let springEditCtx = null;

const springTokenEl = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value;

async function springEditStarter(tempId, memberId, weaponClass) {
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (!card || !card.nodeId) return;
    const s = (card.starters || []).find(x => x.memberId === memberId && x.weaponClass === weaponClass);
    if (!s) return;

    springEditCtx = { tempId, nodeId: card.nodeId, memberId, weaponClass, currentTime: s.startTime || '', currentOrder: s.startOrder, wasDns: false };
    document.getElementById('springEditStarterName').textContent = s.name || ('#' + s.startOrder);
    document.getElementById('springEditStarterClass').textContent = `${s.weaponClass} · ${formatAgeSpan(s.ageGenderClass)}`;
    document.getElementById('springEditStarterOrder').value = s.startOrder;
    const errEl = document.getElementById('springEditStarterError');
    errEl.classList.add('d-none'); errEl.textContent = '';

    // Fetch competition-wide free slots + this shooter's DNS state in one call.
    const slotSel = document.getElementById('springEditStarterSlot');
    slotSel.innerHTML = `<option value="${s.startTime || ''}">Behåll ${((s.startTime||'').substring(0,8)) || '—'}</option>`;
    try {
        const st = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteStarterState?competitionId=${springCompId}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
        if (st.success) {
            // Only offer free slots of the SAME weapon class — classes are never mixed.
            (st.freeSlots || []).filter(f => f.weaponClass === weaponClass).forEach(f => {
                const kind = f.kind === 'dns' ? ('ledig – ' + (f.freedFrom || 'DNS')) : (f.kind === 'efter' ? 'efter sista' : 'paus');
                const opt = document.createElement('option');
                opt.value = f.time; opt.textContent = `${(f.time||'').substring(0,5)} – ${kind}`;
                slotSel.appendChild(opt);
            });
            const me = (st.starters || []).find(x => x.memberId === memberId && x.weaponClass === weaponClass);
            springEditCtx.wasDns = !!(me && me.isDns);
        }
    } catch (e) { /* keep the "behåll" option only */ }
    document.getElementById('springEditStarterDns').checked = springEditCtx.wasDns;

    bootstrap.Modal.getOrCreateInstance(document.getElementById('springEditStarterModal')).show();
}

async function springSaveStarterEdit() {
    if (!springEditCtx) return;
    const btn = document.getElementById('springEditStarterSaveBtn');
    const errEl = document.getElementById('springEditStarterError');
    const fail = (m) => { errEl.textContent = m; errEl.classList.remove('d-none'); btn.disabled = false; };
    errEl.classList.add('d-none'); errEl.textContent = '';

    const startOrder = parseInt(document.getElementById('springEditStarterOrder').value, 10);
    const startTime = document.getElementById('springEditStarterSlot').value || springEditCtx.currentTime;
    const makeDns = document.getElementById('springEditStarterDns').checked;
    if (isNaN(startOrder) || startOrder < 0) { fail('Ogiltigt startnummer.'); return; }

    // Client-side duplicate-number guard: numbers are GLOBALLY unique across all lists (server also enforces).
    if (startOrder !== springEditCtx.currentOrder) {
        const dup = springLocalCards.some(c => (c.starters || []).some(x =>
            !(x.memberId === springEditCtx.memberId && x.weaponClass === springEditCtx.weaponClass)
            && x.startOrder === startOrder));
        if (dup) { fail(`Startnummer ${startOrder} används redan i tävlingen.`); return; }
    }

    btn.disabled = true;
    try {
        // DNS change first (if any).
        if (makeDns !== springEditCtx.wasDns) {
            const dnsResp = await fetch('/umbraco/surface/Springskytte/SetSpringskytteDns', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': springTokenEl() },
                body: JSON.stringify({ competitionId: parseInt(springCompId, 10), memberId: springEditCtx.memberId, weaponClass: springEditCtx.weaponClass, isDns: makeDns })
            }).then(r => r.json());
            if (!dnsResp.success) { fail(dnsResp.message || 'Kunde inte ändra DNS.'); return; }
        }
        // Number/time update — skip when marking DNS (their slot is being freed anyway).
        if (!makeDns) {
            const resp = await fetch('/umbraco/surface/Springskytte/UpdateSpringskytteStarter', {
                method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': springTokenEl() },
                body: JSON.stringify({ competitionId: parseInt(springCompId, 10), nodeId: springEditCtx.nodeId, memberId: springEditCtx.memberId, weaponClass: springEditCtx.weaponClass, startOrder, startTime })
            }).then(r => r.json());
            if (!resp.success) { fail(resp.message || 'Kunde inte spara.'); return; }
        }
        bootstrap.Modal.getOrCreateInstance(document.getElementById('springEditStarterModal')).hide();
        await springLoadAll(); // refresh cards (status + times)
    } catch (e) {
        fail('Ett fel uppstod.');
    } finally {
        btn.disabled = false;
    }
}

// ===== Card state management =====

let springTempIdCounter = 0;

function springAddNewList() {
    if (!confirmIfResultsExist('Lägg till startlista')) return;
    const tempId = 'new_' + (++springTempIdCounter);
    springLocalCards.push({
        tempId,
        nodeId: null,
        listName: '',
        listDate: '',
        coveredClasses: [],
        firstStartTime: '10:00',
        defaultInterval: '01:00',
        breakAfterEvery: 10,
        breakDuration: '05:00',
        starters: [],
        generatedDate: ''
    });
    springRenderCards();
    // Open the settings modal straight away — configuring the new list happens there, not on the card.
    springOpenSettings(tempId);
}

// ===== Delete =====

async function springDeleteList(tempId) {
    if (!confirmIfResultsExist('Ta bort startlista')) return;
    const card = springLocalCards.find(c => c.tempId === tempId);
    if (!card) return;

    if (!confirm(`Ta bort startlistan "${card.listName}"?`)) return;

    if (card.nodeId) {
        // Delete from server
        try {
            const response = await fetch('/umbraco/surface/Springskytte/DeleteSpringskytteStartList', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                },
                body: JSON.stringify({ competitionId: springCompId, nodeId: card.nodeId })
            });
            const data = await response.json();
            if (!data.success) {
                alert(data.message || 'Fel vid borttagning.');
                return;
            }
        } catch (err) {
            console.error('Error deleting start list:', err);
            alert('Ett fel uppstod vid borttagning.');
            return;
        }
    }

    // Remove from local state
    springLocalCards = springLocalCards.filter(c => c.tempId !== tempId);
    springRenderCards();
}

// ===== Renumber & Reset =====

// Per-list numbering: each list either starts at its own number or continues on the previous one.
// The modal shows every list in numbering order (by first start time) with a live range preview.
let springRenumberPlan = [];

async function springOpenRenumberModal() {
    const rowsEl = document.getElementById('springRenumberRows');
    const errEl = document.getElementById('springRenumberError');
    errEl.classList.add('d-none'); errEl.textContent = '';
    rowsEl.innerHTML = '<div class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm" role="status"></div> Laddar…</div>';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('springRenumberModal')).show();
    // The cards BEHIND this modal were rendered when the page loaded, while the plan below is fetched
    // fresh — so if the lists changed since (another functionary, another tab, a regenerate) the two
    // contradicted each other on screen, which reads as "the renumbering is wrong". Refresh the cards
    // first so they can't disagree. Skipped while an unsaved "Ny startlista" card is open, because
    // reloading would discard it.
    try {
        if (!(springLocalCards || []).some(c => !c.nodeId)) await springLoadAll();
    } catch (e) { /* stale cards are not worth blocking the modal for */ }
    try {
        const d = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteRenumberPlan?competitionId=${springCompId}`).then(r => r.json());
        if (!d.success) { rowsEl.innerHTML = `<div class="alert alert-warning mb-0">${escapeHtml(d.message) || 'Kunde inte ladda listor.'}</div>`; return; }
        springRenumberPlan = d.lists || [];
        if (!springRenumberPlan.length) { rowsEl.innerHTML = '<div class="alert alert-info mb-0">Inga genererade startlistor att numrera.</div>'; return; }
        springRenderRenumberRows();
    } catch (err) {
        console.error('Error loading renumber plan:', err);
        rowsEl.innerHTML = '<div class="alert alert-danger mb-0">Ett fel uppstod.</div>';
    }
}

function springRenderRenumberRows() {
    const rowsEl = document.getElementById('springRenumberRows');
    rowsEl.innerHTML = springRenumberPlan.map((l, idx) => {
        const meta = [];
        if (l.firstStartTime) meta.push('första start ' + escapeHtml(String(l.firstStartTime).substring(0, 5)));
        meta.push((l.starterCount || 0) + ' starter');
        meta.push('nu: ' + escapeHtml((l.weaponClasses && l.weaponClasses.length
            ? l.weaponClasses.map(c => (c.weaponClass ? c.weaponClass + ' ' : '') + (c.currentNumbers || '—')).join(' · ')
            : (l.currentNumbers || '—'))));
        const cont = idx > 0 && l.continueFromPrevious;
        // A list whose numbers were typed in by hand stays UNTICKED by default — the whole point of
        // this screen after the SM rehearsal is that nothing overwrites those numbers by surprise.
        const sel = !l.manualNumbering;
        const hist = (l.history || []).map(h =>
            `<div>${escapeHtml(h.at)} · ${escapeHtml(springRnActionLabel(h.action))}${h.by ? ' · ' + escapeHtml(h.by) : ''} · ${escapeHtml(h.detail)}</div>`).join('');
        return `
        <div class="border rounded p-2 mb-2 ${l.manualNumbering ? 'border-warning' : ''}">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="form-check mb-0" style="min-width:150px">
                    <input class="form-check-input" type="checkbox" id="springRnDo_${l.nodeId}" ${sel ? 'checked' : ''} onchange="springRenumberRecalc()">
                    <label class="form-check-label small fw-bold" for="springRnDo_${l.nodeId}">Numrera om</label>
                </div>
                <div class="flex-grow-1" style="min-width:180px">
                    <div class="fw-bold">${escapeHtml(l.listName)}${l.listDate ? ' <span class="text-muted small">– ' + escapeHtml(l.listDate) + '</span>' : ''}
                        ${l.manualNumbering ? '<span class="badge bg-warning text-dark ms-1" title="Startnumren är ändrade för hand">Manuellt numrerad</span>' : ''}</div>
                    <div class="text-muted small">${meta.join(' · ')}</div>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <label class="small mb-0 me-1">Startnr</label>
                    <input type="number" min="1" class="form-control form-control-sm" style="width:88px"
                        id="springRnBase_${l.nodeId}" value="${l.startNumberBase || 1}" oninput="springRenumberRecalc()" ${cont ? 'disabled' : ''}>
                </div>
                ${idx > 0 ? `
                <div class="form-check form-switch mb-0" style="min-width:190px">
                    <input class="form-check-input" type="checkbox" id="springRnCont_${l.nodeId}" ${cont ? 'checked' : ''} onchange="springRenumberRecalc()">
                    <label class="form-check-label small" for="springRnCont_${l.nodeId}">Fortsätt från föregående</label>
                </div>` : '<div class="text-muted small fst-italic" style="min-width:190px">Första listan</div>'}
                <span class="badge bg-secondary" id="springRnRange_${l.nodeId}" style="min-width:64px">—</span>
            </div>
            ${hist ? `<div class="mt-2"><a class="small text-decoration-none" data-bs-toggle="collapse" href="#springRnHist_${l.nodeId}">
                        <i class="bi bi-clock-history me-1"></i>Historik för startnummer</a>
                      <div class="collapse" id="springRnHist_${l.nodeId}">
                        <div class="text-muted small font-monospace mt-1">${hist}</div></div></div>` : ''}
        </div>`;
    }).join('');
    springRenumberRecalc();
}

function springRnActionLabel(a) {
    switch (a) {
        case 'generate': return 'genererad';
        case 'regenerate': return 'omgenererad';
        case 'manual': return 'ändrad för hand';
        case 'renumber': return 'numrerad om';
        case 'reset': return 'återställd';
        case 'walk-in': return 'efteranmälan';
        default: return a || '';
    }
}

// Walk the lists in order, ONE SEQUENCE PER WEAPON CLASS (A and C are numbered independently, so A can
// run 1–4 while C runs 1–20). A ticked list gets fresh numbers per class (from its own base, or following
// on from wherever the previous list ends in that class); an unticked list is shown with the numbers it
// already has and is left alone by the server.
function springRenumberRecalc() {
    const running = {};   // weapon class -> last number handed out
    springRenumberPlan.forEach((l, idx) => {
        const doEl = document.getElementById('springRnDo_' + l.nodeId);
        const contEl = document.getElementById('springRnCont_' + l.nodeId);
        const baseEl = document.getElementById('springRnBase_' + l.nodeId);
        const rangeEl = document.getElementById('springRnRange_' + l.nodeId);
        const selected = !doEl || doEl.checked;
        const cont = selected && idx > 0 && contEl && contEl.checked;
        if (contEl) contEl.disabled = !selected;
        if (baseEl) baseEl.disabled = !selected || cont;
        const classes = (l.weaponClasses && l.weaponClasses.length)
            ? l.weaponClasses
            : [{ weaponClass: '', starterCount: l.starterCount || 0, currentNumbers: l.currentNumbers }];

        if (!selected) {
            // Keeps what it has; it still occupies those numbers in its own class.
            if (rangeEl) {
                rangeEl.textContent = classes.map(c => springRnClassLabel(c.weaponClass) + (c.currentNumbers || '—')).join(' · ');
                rangeEl.className = 'badge bg-light text-muted border';
            }
            classes.forEach(c => {
                const nums = String(c.currentNumbers || '').match(/\d+/g);
                if (nums) running[c.weaponClass] = Math.max(running[c.weaponClass] || 0, ...nums.map(Number));
            });
            return;
        }

        const parts = [];
        let lowest = null;
        classes.forEach(c => {
            const run = running[c.weaponClass] || 0;
            const base = cont ? run + 1 : Math.max(1, parseInt(baseEl && baseEl.value, 10) || 1);
            const count = c.starterCount || 0;
            const last = count > 0 ? base + count - 1 : base;
            parts.push(springRnClassLabel(c.weaponClass) + (count > 0 ? (count === 1 ? String(base) : `${base}–${last}`) : '—'));
            if (count > 0) {
                running[c.weaponClass] = last;
                lowest = lowest === null ? base : Math.min(lowest, base);
            }
        });
        // The base field shows the lowest number this list will actually start at.
        if (cont && baseEl && lowest !== null) baseEl.value = lowest;
        if (rangeEl) { rangeEl.textContent = parts.join(' · ') || '—'; rangeEl.className = 'badge bg-secondary'; }
    });
}

// "A: " prefix per weapon class. Goes into textContent, so no escaping (and it's only A/B/C/R).
function springRnClassLabel(wc) { return wc ? wc + ': ' : ''; }

async function springApplyRenumber() {
    if (!confirmIfResultsExist('Numrera om startlistor')) return;
    const btn = document.getElementById('springRenumberApplyBtn');
    const errEl = document.getElementById('springRenumberError');
    errEl.classList.add('d-none'); errEl.textContent = '';

    const lists = springRenumberPlan.map((l, idx) => {
        const doEl = document.getElementById('springRnDo_' + l.nodeId);
        const contEl = document.getElementById('springRnCont_' + l.nodeId);
        const baseEl = document.getElementById('springRnBase_' + l.nodeId);
        return {
            nodeId: l.nodeId,
            renumber: !doEl || doEl.checked,
            startNumberBase: Math.max(1, parseInt(baseEl && baseEl.value, 10) || 1),
            continueFromPrevious: idx > 0 && !!(contEl && contEl.checked)
        };
    });

    const picked = lists.filter(x => x.renumber);
    if (!picked.length) {
        errEl.textContent = 'Markera minst en lista att numrera om.'; errEl.classList.remove('d-none');
        return;
    }
    // Overwriting hand-typed numbers is exactly the surprise this screen exists to prevent — so say it.
    const manual = springRenumberPlan.filter(l => l.manualNumbering && picked.some(x => x.nodeId === l.nodeId));
    if (manual.length && !confirm('Följande listor är numrerade för hand och skrivs över:\n\n'
        + manual.map(l => `• ${l.listName} (nu ${l.currentNumbers || '—'})`).join('\n')
        + '\n\nFortsätt?')) return;

    btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Numrerar...';
    try {
        const response = await fetch('/umbraco/surface/Springskytte/RenumberSpringskytteStartLists', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': springTokenEl() },
            body: JSON.stringify({ competitionId: parseInt(springCompId, 10), lists })
        });
        const data = await response.json();
        if (data.success) {
            bootstrap.Modal.getOrCreateInstance(document.getElementById('springRenumberModal')).hide();
            await springLoadAll();
        } else {
            errEl.textContent = data.message || 'Fel vid numrering.'; errEl.classList.remove('d-none');
        }
    } catch (err) {
        console.error('Error renumbering:', err);
        errEl.textContent = 'Ett fel uppstod.'; errEl.classList.remove('d-none');
    } finally {
        btn.disabled = false; btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Tilldela startnummer';
    }
}

async function springResetNumbers() {
    if (!confirmIfResultsExist('Återställ startnummer')) return;
    if (!confirm('Återställ alla startnummer till en löpande följd (1, 2, 3… genom alla listor)?')) return;

    const btn = document.getElementById('springNumberingBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Återställer...'; }

    try {
        const response = await fetch('/umbraco/surface/Springskytte/ResetSpringskytteStartNumbers', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(springCompId)
        });
        const data = await response.json();
        if (data.success) {
            alert(data.message);
            await springLoadAll();
        } else {
            alert(data.message || 'Fel vid återställning.');
        }
    } catch (err) {
        console.error('Error resetting:', err);
        alert('Ett fel uppstod.');
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-sort-numeric-down me-1"></i>Numrera om'; }
    }
}

function springUpdateTopButtons() {
    const hasGenerated = springLocalCards.some(c => c.starters && c.starters.length > 0);
    const btn = document.getElementById('springNumberingBtn');
    if (btn) btn.style.display = hasGenerated ? '' : 'none';
    springCheckDuplicateNumbers();
}

// Start numbers must be unique across the whole competition. Warn loudly if data has duplicates
// (e.g. legacy per-weapon-class numbering where C#1 and A#1 both exist).
async function springCheckDuplicateNumbers() {
    const warn = document.getElementById('springDupWarn');
    if (!warn) return;
    try {
        const d = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteStartNumberIssues?competitionId=${springCompId}`).then(r => r.json());
        const dups = (d.success && d.duplicates) ? d.duplicates : [];
        if (dups.length) {
            const parts = dups.map(x => `nr ${x.startOrder} (${x.count} skyttar)`);
            document.getElementById('springDupWarnText').innerHTML =
                `<i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Dubbla startnummer!</strong> ${parts.join(', ')}. Startnummer måste vara unika i tävlingen — klicka "Numrera om nu".`;
            warn.classList.remove('d-none');
        } else {
            warn.classList.add('d-none');
        }
    } catch (e) { /* non-critical */ }
}

// ===== Helpers =====

function springParseTimeDiff(t1, t2) {
    const toSec = t => {
        const p = t.split(':').map(Number);
        return p.length === 3 ? p[0]*3600+p[1]*60+p[2] : p[0]*3600+p[1]*60;
    };
    return toSec(t2) - toSec(t1);
}

function springParseTimeMM(mmss) {
    if (!mmss) return 60;
    const p = mmss.split(':').map(Number);
    return p.length === 2 ? p[0]*60+p[1] : p[0]*60;
}
function springHmsToSec(t) {
    if (!t) return 0;
    const p = t.split(':').map(Number);
    return p.length === 3 ? p[0]*3600+p[1]*60+p[2] : p[0]*3600+p[1]*60;
}
function springSecToHms(s) {
    s = Math.max(0, s);
    return String(Math.floor(s/3600)).padStart(2,'0') + ':' + String(Math.floor((s%3600)/60)).padStart(2,'0') + ':' + String(s%60).padStart(2,'0');
}

function escapeHtml(str) {
    if (!str) return '';
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
}

// Mirror of server SlugHelper.Slugify — keep in sync so the client uniqueness check matches
// the URL the public /startlista/{comp}/{slug} page and the server guard use.
function springSlugify(input) {
    if (!input) return '';
    let s = '';
    for (const raw of input.trim().toLowerCase()) {
        switch (raw) {
            case 'å': case 'ä': s += 'a'; break;
            case 'ö': s += 'o'; break;
            case 'é': case 'è': case 'ê': s += 'e'; break;
            case 'ü': s += 'u'; break;
            case ' ': case '_': case '-': case '/': s += '-'; break;
            default:
                if ((raw >= 'a' && raw <= 'z') || (raw >= '0' && raw <= '9')) s += raw;
        }
    }
    return s.replace(/-{2,}/g, '-').replace(/^-+|-+$/g, '');
}
