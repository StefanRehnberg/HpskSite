@*
    Underhållsfönstret för sajtstrukturen (anmälningar och händelser ur Umbraco-trädet till egna
    tabeller). Bara sajtadministratör. Kör stegen i ordning: torrkörning → flytt (frys, flytta,
    jämför, byt, släpp frysningen) → avpublicering av de gamla noderna, gärna några dagar senare.

    Panelen anropar samma endpoints som verifieringssviterna (RegistrationMigration/* och
    ClubEventMigration/*), men skapar inga testdata. Flytten stannar vid första fel och lämnar då
    nodlagringen gällande och frysningen släppt, så sajten fungerar som förut.

    Tas bort i contract-steget (fas 1e/2), när nodlagringen tas bort.
*@
<div id="ssmPanel">
    @Html.AntiForgeryToken()
    <h5 class="mb-1"><i class="bi bi-arrow-left-right me-2"></i>Underhållsfönstret: anmälningar, händelser, resultatlistor, startlistor och tävlingar till egna tabeller</h5>
    <p class="text-body-secondary mb-3" style="max-width:75ch">
        Gör flytten en kväll när ingen anmäler sig och ingen tävling pågår. Under flytten (några sekunder per del)
        svarar anmälan, redigering av händelser och uppdatering av resultat- och startlistor att underhåll pågår. Börja med <strong>Torrkör</strong>; den skriver ingenting.
        Stannar flytten på ett fel gäller de gamla noderna som förut och ingenting har ändrats för besökarna.
    </p>

    <div class="row g-3">
        @foreach (var part in new[] { ("reg", "Anmälningar", "/umbraco/surface/RegistrationMigration"), ("ev", "Händelser", "/umbraco/surface/ClubEventMigration"), ("res", "Resultatlistor", "/umbraco/surface/CompetitionResultMigration"), ("sl", "Startlistor", "/umbraco/surface/StartListMigration"), ("comp", "Tävlingar och serier", "/umbraco/surface/CompetitionMigration") })
        {
            <div class="col-12 col-xl-6">
                <div class="card h-100 ssm-part" data-part="@part.Item1" data-base="@part.Item3" data-label="@part.Item2">
                    <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                        <strong>@part.Item2</strong>
                        <span class="ssm-state small text-body-secondary">Läser läget…</span>
                    </div>
                    <div class="card-body d-grid gap-3">
                        <div class="d-flex gap-2 flex-wrap">
                            <button type="button" class="btn btn-outline-primary btn-sm" data-ssm="preview">1. Torrkör</button>
                            <button type="button" class="btn btn-primary btn-sm" data-ssm="migrate">2. Flytta till tabellen</button>
                            @if (part.Item1 == "comp")
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-ssm="invoiceArchive"
                                        title="Flyttar de gamla fakturamapparna från tävlingsnoderna till fakturaarkivet. Krävs före avpubliceringen.">Fakturamapparna till arkivet</button>
                            }
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-ssm="unpublish">3. Avpublicera de gamla noderna</button>
                            @if (part.Item1 == "ev")
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" data-ssm="deleteNodes"
                                        title="Arkiverar och raderar händelsenoderna för gott. Bara när varje händelse finns i tabellen. Kör utanför trafiktid.">4. Radera de gamla noderna</button>
                            }
                            @if (part.Item1 == "comp")
                            {
                                <button type="button" class="btn btn-outline-danger btn-sm" data-ssm="deleteNodes"
                                        title="Raderar tävlings- och serienoderna för gott, med allt under dem. Bara när allt finns i tabellerna och arkivet. Kör utanför trafiktid.">4. Radera de gamla noderna</button>
                            }
                            @if (part.Item1 == "reg")
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-ssm="cleanup"
                                        title="Tar bort de gamla anmälnings- och lagnoderna för gott. Bara noder som finns i tabellen; lagfakturorna får först sin klubb.">4. Ta bort de gamla noderna</button>
                            }
                            <button type="button" class="btn btn-outline-danger btn-sm ms-auto" data-ssm="rollback">Tillbaka till noderna</button>
                            <button type="button" class="btn btn-outline-danger btn-sm d-none" data-ssm="clear"
                                    title="Tömmer tabellen inför ett nytt försök. Det som skapats efter flytten försvinner.">Töm tabellen</button>
                        </div>
                        <div class="ssm-out small" style="min-width:0"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <p class="small text-body-secondary mt-3 mb-0" style="max-width:75ch">
        <strong>Tillbaka till noderna</strong> fungerar så länge de gamla noderna inte är avpublicerade, men allt som
        anmälts eller ändrats efter flytten finns bara i tabellen. Avpublicera därför först när ni är säkra, gärna
        efter några dagar. Ska flytten göras om efter en återgång: tryck <strong>Töm tabellen</strong> först.
    </p>
</div>

<script>
(function () {
    if (window.__ssmInit) return; window.__ssmInit = true;
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]; }); }
    function token() { var t = document.querySelector('#ssmPanel input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
    async function get(base, action) {
        var r = await fetch(base + '/' + action, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        if (!r.ok) throw new Error((window.hpskRequestFailureMessage && window.hpskRequestFailureMessage(r.status).msg) || ('HTTP ' + r.status));
        return r.json();
    }
    async function post(base, action, form) {
        var fd = new FormData();
        Object.keys(form || {}).forEach(function (k) { fd.append(k, form[k]); });
        fd.append('__RequestVerificationToken', token());
        var r = await fetch(base + '/' + action, { method: 'POST', body: fd, headers: { 'RequestVerificationToken': token(), 'X-Requested-With': 'XMLHttpRequest' } });
        if (!r.ok) throw new Error((window.hpskRequestFailureMessage && window.hpskRequestFailureMessage(r.status).msg) || ('HTTP ' + r.status));
        return r.json();
    }
    // Svaren skiljer sig något mellan delarna: anmälningarnas Run bär "result", händelsernas fälten i roten.
    function runInfo(d) { var r = d.result || d; return { ok: !!d.success, inserted: r.inserted, message: r.message, errors: r.errors || [] }; }

    function lines(card, html, cls) {
        var out = card.querySelector('.ssm-out');
        out.innerHTML += '<div class="' + (cls || '') + '">' + html + '</div>';
    }
    function clear(card) { card.querySelector('.ssm-out').innerHTML = ''; }
    function busy(card, on) { card.querySelectorAll('[data-ssm]').forEach(function (b) { b.disabled = on; }); }

    async function refreshState(card) {
        var el = card.querySelector('.ssm-state');
        // Anmälningarnas torrkörning läser alla noder och tar några sekunder — säg att läget läses.
        el.textContent = 'Läser läget…';
        try {
            var d = await get(card.dataset.base, 'Preview');
            var p = d.preview || {};
            var store = p.store || p.Store;
            var frozen = p.writeFrozen != null ? p.writeFrozen : p.WriteFrozen;
            var inTable = p.rowsAlreadyInTable != null ? p.rowsAlreadyInTable : p.RowsAlreadyInTable;
            el.innerHTML = (store === 'table'
                    ? '<span class="badge bg-success">Tabellen gäller</span>'
                    : '<span class="badge bg-secondary">De gamla noderna gäller</span>')
                + (frozen ? ' <span class="badge bg-warning text-dark">Fryst</span>' : '')
                + ' <span class="ms-1">' + inTable + ' rader i tabellen</span>';
            card.dataset.store = store;
            // "Töm tabellen" behövs bara för ett nytt försök: när noderna gäller och tabellen har rader.
            var clearBtn = card.querySelector('[data-ssm="clear"]');
            if (clearBtn) clearBtn.classList.toggle('d-none', !(store !== 'table' && inTable > 0));
            return p;
        } catch (e) { el.textContent = 'Läget gick inte att läsa: ' + e.message; return null; }
    }

    function previewHtml(part, p) {
        var g = function (a, b) { return p[a] != null ? p[a] : p[b]; };
        var rows = [];
        if ((g('missingSchema', 'MissingSchema') || []).length)
            rows.push('<div class="text-danger">Tabeller saknas: ' + esc(g('missingSchema', 'MissingSchema').join(', ')) + '. Kör migreringsskripten först.</div>');
        if (part === 'reg') {
            rows.push('Noder: <strong>' + g('nodes', 'Nodes') + '</strong> i ' + g('competitions', 'Competitions') + ' tävlingar → '
                + '<strong>' + g('rowsToWrite', 'RowsToWrite') + '</strong> rader.');
            rows.push('Dubbletter som slås ihop: ' + g('mergedNodes', 'MergedNodes') + ' · inaktiva rader: ' + g('deactivatedRows', 'DeactivatedRows')
                + ' · klubb från gammal text: ' + g('clubFromLegacyText', 'ClubFromLegacyText'));
            var unk = g('unknownClasses', 'UnknownClasses') || [];
            if (unk.length) rows.push('Klasser som inte känns igen (lagras som de är): ' + esc(unk.join(', ')));
        } else if (part === 'res') {
            rows.push('Resultatnoder: <strong>' + g('nodes') + '</strong> i ' + g('competitions') + ' tävlingar → '
                + '<strong>' + g('competitions') + '</strong> rader · med beräknad lista: ' + g('withResultData')
                + ' · publicerade: ' + g('official'));
            var dupes = g('duplicates') || [];
            if (dupes.length) rows.push('<details><summary>Tävlingar med fler än en resultatnod (' + dupes.length + ')</summary><ul class="mb-0">'
                + dupes.slice(0, 100).map(function (n) { return '<li>' + esc(n) + '</li>'; }).join('') + '</ul></details>');
        } else if (part === 'sl') {
            rows.push('Startlistenoder: <strong>' + g('nodes') + '</strong> i ' + g('competitions') + ' tävlingar → '
                + '<strong>' + (g('qualifying') + g('finals')) + '</strong> rader · grundomgång: ' + g('qualifying')
                + ' · final: ' + g('finals') + ' · officiella: ' + g('official'));
            rows.push('Under den gamla hubben: ' + g('legacyHub') + ' · utkast som skiljer sig från det publicerade: '
                + g('draftAhead') + ' · utan tävling (flyttas inte): ' + g('orphans'));
        } else if (part === 'comp') {
            rows.push('Tävlingar: <strong>' + g('competitions') + '</strong> · serier: <strong>' + g('series') + '</strong>'
                + ' · publicerade: ' + g('published') + ' · i papperskorgen: ' + g('trashed')
                + ' (flyttas som raderade, syns inte)');
            [['unpublished', 'Opublicerade — flyttas som raderade'], ['draftAhead', 'Sparade ändringar som inte publicerats — det publicerade flyttas, utkastet bara till arkivet'],
             ['withoutAddress', 'Publicerade utan adress — ingen sida i tabelläget förrän en värd sätts'], ['unreadable', 'Värden som inte går att läsa — blir standardvärdet'], ['unpublishBlockers', 'Avpubliceringen av noderna väntar på']]
                .forEach(function (k) {
                    var list = g(k[0]) || [];
                    if (list.length) rows.push('<details><summary>' + esc(k[1]) + ' (' + list.length + ')</summary><ul class="mb-0">'
                        + list.slice(0, 200).map(function (n) { return '<li>' + esc(n) + '</li>'; }).join('') + '</ul></details>');
                });
        } else {
            rows.push('Händelser: <strong>' + g('nodes') + '</strong> → <strong>' + g('rowsToWrite') + '</strong> rader'
                + ' · flyttade till träningar (hoppas över): ' + g('skippedMovedToTraining')
                + ' · opublicerade: ' + g('unpublished'));
            rows.push('Gamla adresser som skickas vidare: ' + g('withLegacyUrl') + ' · namnkrockar (får -2): ' + g('slugCollisions')
                + ' · med innehållsblock: ' + g('withLandingPage'));
        }
        rows.push('Redan i tabellen: ' + g('rowsAlreadyInTable', 'RowsAlreadyInTable'));
        var notes = g('notes', 'Notes') || [];
        if (notes.length) rows.push('<details><summary>Anteckningar (' + notes.length + ')</summary><ul class="mb-0">'
            + notes.slice(0, 100).map(function (n) { return '<li>' + esc(n) + '</li>'; }).join('') + '</ul></details>');
        return rows.map(function (r) { return '<div>' + r + '</div>'; }).join('');
    }

    async function doPreview(card) {
        clear(card); busy(card, true);
        try {
            var p = await refreshState(card);
            if (p) lines(card, previewHtml(card.dataset.part, p));
        } finally { busy(card, false); }
    }

    // Frys → flytta → jämför → byt → släpp frysningen. Stannar vid första fel och släpper frysningen.
    async function doMigrate(card) {
        clear(card); busy(card, true);
        var base = card.dataset.base, frozen = false;
        var step = function (t) { lines(card, '<i class="bi bi-check2 text-success me-1"></i>' + t); };
        var stop = function (t) { lines(card, '<i class="bi bi-x-circle text-danger me-1"></i><strong>' + t + '</strong>', 'text-danger'); };
        try {
            var p = await refreshState(card);
            if (!p) return;
            if ((p.store || p.Store) === 'table') { stop('Tabellen gäller redan — ingenting att flytta.'); return; }
            if ((p.missingSchema || p.MissingSchema || []).length) { stop('Tabeller saknas. Kör migreringsskripten först.'); return; }

            var f = await post(base, 'Freeze', { on: '1' });
            if (!f.writeFrozen) { stop('Frysningen gick inte att slå på.'); return; }
            frozen = true; step('Skrivningar frysta.');

            var r = runInfo(await post(base, 'Run'));
            if (!r.ok) { stop('Flytten misslyckades: ' + esc(r.message || '') + (r.errors.length ? '<br>' + esc(r.errors.slice(0, 5).join(' | ')) : '')); return; }
            step('Flyttat: ' + r.inserted + ' rader.');

            var v = await get(base, 'Verify');
            if (v.mismatches > 0) {
                stop(v.mismatches + ' avvikelser mellan noder och tabell — bytet görs inte.');
                lines(card, '<ul class="mb-0">' + (v.problems || []).slice(0, 30).map(function (x) { return '<li>' + esc(x) + '</li>'; }).join('') + '</ul>');
                return;
            }
            step('Jämfört: ' + v.compared + ' utan avvikelser.');

            var s = await post(base, 'Switch', { store: 'table' });
            if (!s.success) { stop('Bytet vägrades: ' + esc(s.message || '')); return; }
            step(esc(s.message || 'Tabellen gäller nu.'));
        } catch (e) {
            stop('Avbrutet: ' + esc(e.message));
        } finally {
            if (frozen) {
                try { await post(base, 'Freeze', { on: '0' }); step('Frysningen släppt.'); }
                catch (e) { stop('Frysningen kunde inte släppas: ' + esc(e.message) + ' — tryck Tillbaka till noderna eller försök igen.'); }
            }
            await refreshState(card);
            busy(card, false);
        }
    }

    async function doInvoiceArchive(card) {
        clear(card); busy(card, true);
        try {
            var total = 0;
            for (var i = 0; i < 100; i++) {
                var d = await post(card.dataset.base, 'InvoiceArchiveRun', { batch: '50' });
                total += d.moved || 0;
                card.querySelector('.ssm-out').innerHTML = '<div>Flyttade: ' + total + ' · kvar: ' + (d.remaining || 0) + '</div>';
                if (!d.success || !d.remaining || !d.moved) {
                    lines(card, esc(d.message || ''), d.success ? '' : 'text-danger');
                    (d.errors || []).slice(0, 10).forEach(function (x) { lines(card, esc(x), 'text-danger'); });
                    break;
                }
            }
        } catch (e) { lines(card, 'Avbrutet: ' + esc(e.message), 'text-danger'); }
        finally { busy(card, false); }
    }

    async function doUnpublish(card) {
        clear(card); busy(card, true);
        try {
            if (card.dataset.store !== 'table') { lines(card, 'Avpubliceringen görs först när tabellen gäller.', 'text-danger'); return; }
            var total = 0;
            for (var i = 0; i < 200; i++) {
                var d = await post(card.dataset.base, 'Unpublish', { batch: '50' });
                if (d.success === false) { lines(card, esc(d.message || 'Avpubliceringen vägrades.'), 'text-danger'); break; }
                total += d.unpublished || 0;
                card.querySelector('.ssm-out').innerHTML = '<div>Avpublicerade: ' + total + ' · kvar: ' + d.remaining + '</div>';
                if (!d.remaining || !d.unpublished) { lines(card, esc(d.message || '')); break; }
            }
        } catch (e) { lines(card, 'Avbrutet: ' + esc(e.message), 'text-danger'); }
        finally { busy(card, false); }
    }

    function cleanupHtml(s) {
        s = s || {};
        var g = function (a, b) { return s[a] != null ? s[a] : (s[b] != null ? s[b] : 0); };
        var html = 'Kvar att ta bort: <strong>' + g('migratedRegistrationNodes', 'MigratedRegistrationNodes') + '</strong> anmälningsnoder · '
            + g('teamMirrorNodes', 'TeamMirrorNodes') + ' lagnoder · ' + g('emptyRegistrationHubs', 'EmptyRegistrationHubs') + ' tomma mappar · '
            + g('teamInvoicesToBackfill', 'TeamInvoicesToBackfill') + ' lagfakturor att komplettera.';
        var un = g('unmigratedRegistrationNodes', 'UnmigratedRegistrationNodes');
        if (un > 0) html += '<br><span class="text-warning-emphasis">' + un + ' anmälningsnoder finns inte i tabellen och lämnas orörda.</span>';
        return '<div>' + html + '</div>';
    }

    // Först ett läsande anrop som visar vad som skulle tas bort; borttagningen sker i portioner.
    async function doCleanup(card) {
        clear(card); busy(card, true);
        try {
            if (card.dataset.store !== 'table') { lines(card, 'Borttagningen görs först när tabellen gäller.', 'text-danger'); return; }
            var total = 0, last = null;
            for (var i = 0; i < 500; i++) {
                var d = await post(card.dataset.base, 'Cleanup', { batch: '50' });
                total += d.done || 0; last = d;
                card.querySelector('.ssm-out').innerHTML = '<div>Åtgärder: ' + total + '</div>' + cleanupHtml(d.state);
                if (!d.done || /^Klart/.test(d.message || '') || /kunde inte/.test(d.message || '')) break;
            }
            if (last) lines(card, esc(last.message || ''), /kunde inte/.test(last.message || '') ? 'text-danger' : '');
        } catch (e) { lines(card, 'Avbrutet: ' + esc(e.message), 'text-danger'); }
        finally { busy(card, false); }
    }

    function deleteStateHtml(s) {
        s = s || {};
        var html = s.events != null
            ? 'Att radera: <strong>' + s.events + '</strong> händelsenoder'
                + (s.movedToTraining ? ', varav ' + s.movedToTraining + ' flyttade till träningar' : '')
                + (s.trashed ? ' och ' + s.trashed + ' i papperskorgen' : '') + '. Varje nod arkiveras först.'
            : 'Att radera: <strong>' + (s.competitions || 0) + '</strong> tävlingsnoder · ' + (s.series || 0) + ' serienoder · '
                + (s.emptySeasons || 0) + ' tomma årsmappar, med ' + (s.descendants || 0) + ' noder under dem.';
        if (s.redirectsToCopy) html += '<br>' + s.redirectsToCopy + ' gamla omdirigeringar kopieras först.';
        if ((s.blockers || []).length)
            html += '<div class="text-danger mt-1"><strong>Spärrat:</strong><ul class="mb-0">' + s.blockers.map(function (b) { return '<li>' + esc(b) + '</li>'; }).join('') + '</ul></div>';
        return '<div>' + html + '</div>';
    }

    // Raderingen i omgångar (högst 20 sekunder per anrop) tills inget återstår eller något går fel.
    async function doDeleteNodes(card) {
        clear(card); busy(card, true);
        try {
            var total = 0;
            for (var i = 0; i < 400; i++) {
                var d = await post(card.dataset.base, 'DeleteNodes', { batch: '25' });
                total += d.deleted || 0;
                card.querySelector('.ssm-out').innerHTML = '<div>Raderade: ' + total + ' · kvar: ' + (d.remaining || 0) + '</div>';
                (d.errors || []).slice(0, 10).forEach(function (x) { lines(card, esc(x), 'text-danger'); });
                if (!d.success || !d.remaining || !d.deleted) { lines(card, esc(d.message || ''), d.success ? '' : 'text-danger'); break; }
            }
        } catch (e) { lines(card, 'Avbrutet: ' + esc(e.message), 'text-danger'); }
        finally { busy(card, false); }
    }

    async function doRollback(card) {
        clear(card); busy(card, true);
        try {
            var s = await post(card.dataset.base, 'Switch', { store: 'node' });
            lines(card, esc(s.message || (s.success ? 'De gamla noderna gäller igen.' : 'Bytet misslyckades.')), s.success ? '' : 'text-danger');
            await post(card.dataset.base, 'Freeze', { on: '0' });
        } catch (e) { lines(card, 'Avbrutet: ' + esc(e.message), 'text-danger'); }
        finally { await refreshState(card); busy(card, false); }
    }

    async function doClear(card) {
        clear(card); busy(card, true);
        try {
            var d = await post(card.dataset.base, 'Clear');
            lines(card, esc(d.message || ''), d.success ? '' : 'text-danger');
        } catch (e) { lines(card, 'Avbrutet: ' + esc(e.message), 'text-danger'); }
        finally { await refreshState(card); busy(card, false); }
    }

    // Bekräftelse i sidan, aldrig confirm(): ett andra klick inom några sekunder krävs.
    // ms: hur länge knappen står beväpnad. Knappar som först visar en förhandsgranskning får en minut — sex sekunder
    // räckte inte för att läsa den, och nästa tryck visade då bara läget igen (prod 2026-10-19).
    function armed(btn, text, ms) {
        if (btn.dataset.armed === '1') { btn.dataset.armed = ''; btn.textContent = btn.dataset.label; return true; }
        btn.dataset.label = btn.textContent; btn.dataset.armed = '1'; btn.textContent = text;
        setTimeout(function () { if (btn.dataset.armed === '1') { btn.dataset.armed = ''; btn.textContent = btn.dataset.label; } }, ms || 6000);
        return false;
    }

    document.addEventListener('click', function (e) {
        var btn = e.target.closest && e.target.closest('#ssmPanel [data-ssm]');
        if (!btn) return;
        var card = btn.closest('.ssm-part');
        var a = btn.dataset.ssm;
        if (a === 'preview') doPreview(card);
        else if (a === 'migrate') { if (armed(btn, 'Tryck igen för att flytta')) doMigrate(card); }
        else if (a === 'unpublish') { if (armed(btn, 'Tryck igen för att avpublicera')) doUnpublish(card); }
        else if (a === 'cleanup') {
            if (btn.dataset.armed === '1') { armed(btn); doCleanup(card); return; }
            // Första trycket: visa vad som skulle tas bort, beväpna knappen.
            armed(btn, 'Tryck igen — noderna tas bort för gott', 60000);
            clear(card);
            get(card.dataset.base, 'CleanupPreview').then(function (d) { lines(card, cleanupHtml(d.state)); })
                .catch(function (err) { lines(card, 'Läget gick inte att läsa: ' + esc(err.message), 'text-danger'); });
        }
        else if (a === 'deleteNodes') {
            if (btn.dataset.armed === '1') { armed(btn); doDeleteNodes(card); return; }
            // Första trycket: visa vad som raderas och vad som spärrar; beväpna bara när inget spärrar.
            clear(card);
            get(card.dataset.base, 'DeleteNodesPreview').then(function (d) {
                lines(card, deleteStateHtml(d.state));
                var s = d.state || {};
                if ((s.blockers || []).length) return;
                if (!s.competitions && !s.series && !s.emptySeasons && !s.events) { lines(card, 'Det finns inga noder kvar att radera.'); return; }
                armed(btn, 'Tryck igen — noderna raderas för gott', 60000);
                lines(card, '<strong>Tryck på knappen en gång till (inom en minut) för att radera.</strong>');
            }).catch(function (err) { lines(card, 'Läget gick inte att läsa: ' + esc(err.message), 'text-danger'); });
        }
        else if (a === 'invoiceArchive') {
            if (btn.dataset.armed === '1') { armed(btn); doInvoiceArchive(card); return; }
            // Första trycket: visa vad som skulle flyttas, beväpna knappen.
            clear(card);
            get(card.dataset.base, 'InvoiceArchivePreview').then(function (d) {
                if (!d.tableExists) { lines(card, 'Arkivtabellen saknas — kör Migrations/create-competition-tables.sql först.', 'text-danger'); return; }
                if (!d.toMove) { lines(card, 'Inga fakturamappar ligger under tävlingsnoderna' + (d.alreadyArchived ? ' — ' + d.alreadyArchived + ' ligger i arkivet.' : '.')); return; }
                lines(card, '<strong>' + d.toMove + '</strong> fakturamappar med <strong>' + d.invoices + '</strong> fakturor flyttas oförändrade till arkivet'
                    + (d.archiveFolderId ? '' : ' (arkivet skapas under tävlingsnavet)') + '.'
                    + (d.emptyHubs ? ' ' + d.emptyHubs + ' av dem är tomma.' : '')
                    + (d.withoutCompetitionId ? ' ' + d.withoutCompetitionId + ' fakturor saknar tävlingens id — arkivet bär det åt dem.' : ''));
                armed(btn, 'Tryck igen för att flytta mapparna', 60000);
            }).catch(function (err) { lines(card, 'Läget gick inte att läsa: ' + esc(err.message), 'text-danger'); });
        }
        else if (a === 'rollback') { if (armed(btn, 'Tryck igen — tillbaka till noderna')) doRollback(card); }
        else if (a === 'clear') { if (armed(btn, 'Tryck igen — det som skapats efter flytten försvinner')) doClear(card); }
    });

    function init() { document.querySelectorAll('#ssmPanel .ssm-part').forEach(refreshState); }
    var tab = document.getElementById('underhall-tab');
    if (tab) tab.addEventListener('shown.bs.tab', init, { once: true });
})();
</script>
