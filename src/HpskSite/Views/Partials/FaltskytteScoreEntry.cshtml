@*
    Fältskytte Score Entry Modal — self-entered external comps.
    Separate from TrainingScoreEntry.cshtml because the data shape is different
    (no series, no shot-by-shot; just träff/figurer aggregates + placement + medal).
*@

<div class="modal fade" id="addFaltskytteScoreModal" tabindex="-1" aria-labelledby="addFaltskytteScoreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addFaltskytteScoreModalLabel">
                    <i class="bi bi-plus-circle"></i> Lägg in Fältskytte-resultat
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <form id="faltskytteScoreForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="faltEntryId" value="">

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="faltDate" class="form-label">Datum <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="faltDate" required>
                        </div>
                        <div class="col-md-6">
                            <label for="faltCompetitionName" class="form-label">Tävling / plats <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="faltCompetitionName" placeholder="t.ex. Värmlandsfältet" required>
                        </div>

                        <div class="col-md-4">
                            <label for="faltShootingClass" class="form-label">Skytteklass <span class="text-danger">*</span></label>
                            <select class="form-select" id="faltShootingClass" required>
                                <option value="">Välj klass...</option>
                                <optgroup label="C — Kal. 22">
                                    <option value="C1">C1</option>
                                    <option value="C2">C2</option>
                                    <option value="C3">C3</option>
                                    <option value="C_Vet_Y">C Vet Y</option>
                                    <option value="C_Vet_A">C Vet Ä</option>
                                    <option value="C_Jun">C Jun</option>
                                    <option value="C1_Dam">C1 Dam</option>
                                    <option value="C2_Dam">C2 Dam</option>
                                    <option value="C3_Dam">C3 Dam</option>
                                </optgroup>
                                <optgroup label="A — Tjänstevapen">
                                    <option value="A1">A1</option>
                                    <option value="A2">A2</option>
                                    <option value="A3">A3</option>
                                </optgroup>
                                <optgroup label="A Opt — Optisk">
                                    <option value="A_opt_1">A Opt 1</option>
                                    <option value="A_opt_2">A Opt 2</option>
                                    <option value="A_opt_3">A Opt 3</option>
                                </optgroup>
                                <optgroup label="B — Kal. 32-45">
                                    <option value="B1">B1</option>
                                    <option value="B2">B2</option>
                                    <option value="B3">B3</option>
                                </optgroup>
                                <optgroup label="R — Revolver">
                                    <option value="R1">R1</option>
                                    <option value="R2">R2</option>
                                    <option value="R3">R3</option>
                                </optgroup>
                                <optgroup label="M — Magnum">
                                    <option value="M1">M1</option>
                                    <option value="M2">M2</option>
                                    <option value="M3">M3</option>
                                    <option value="M4">M4</option>
                                    <option value="M5">M5</option>
                                    <option value="M6">M6</option>
                                    <option value="M7">M7</option>
                                    <option value="M8">M8</option>
                                    <option value="M9">M9</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="faltMode" class="form-label">Typ <span class="text-danger">*</span></label>
                            <select class="form-select" id="faltMode" required>
                                <option value="Normalfalt" selected>Normalfält</option>
                                <option value="Poangfalt">Poängfält</option>
                            </select>
                            <div class="form-text">Styr bara visningen: <code>32/22</code> vs <code>54 p</code>.</div>
                        </div>
                        <div class="col-md-4">
                            <label for="faltStationCount" class="form-label">Antal stationer <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="faltStationCount" min="1" max="16" value="8" required>
                            <div class="form-text">Max träff = <span id="faltMaxHitsHint">48</span> (stationer × 6).</div>
                        </div>

                        <div class="col-md-6">
                            <label for="faltHits" class="form-label">Antal träff <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="faltHits" min="0" required>
                                <span class="input-group-text" id="faltMaxHitsSuffix">av 48</span>
                            </div>
                            <div class="form-text">Första värdet i resultatnotationen (<code>32/22</code>).</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Träffade figurer <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="faltFigures" min="0" required>
                                <span class="input-group-text">av</span>
                                <input type="number" class="form-control" id="faltFiguresMax" min="1" placeholder="t.ex. 32" required>
                            </div>
                            <div class="form-text">Andra värdet i resultatnotationen.</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Placering <span class="text-muted">(valfritt)</span></label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="faltPlacement" min="1">
                                <span class="input-group-text">av</span>
                                <input type="number" class="form-control" id="faltParticipants" min="1">
                            </div>
                            <div class="form-text">Inom din klass. Används för placeringskortet och topp-%.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="faltMedal" class="form-label">Standardmedalj</label>
                            <select class="form-select" id="faltMedal">
                                <option value="" selected>Ingen</option>
                                <option value="S">Silver</option>
                                <option value="B">Brons</option>
                            </select>
                        </div>

                        @* Proof of standard medal — same tools as the Precision result modal. *@
                        <div class="col-12">
                            <div id="faltMedalProofBlock" style="display: none;" class="p-3 border rounded bg-body">
                                <label for="faltMedalProofFile" class="form-label">
                                    <i class="bi bi-paperclip"></i> Bevis för standardmedalj <span class="text-muted">(frivilligt)</span>
                                </label>
                                <div id="faltMedalProofCurrent" class="small mb-2"></div>
                                <div id="faltMedalProofDrop" class="border border-2 rounded text-center text-muted py-3 px-2 mb-2" style="border-style: dashed !important; cursor: pointer;">
                                    <i class="bi bi-clipboard-plus"></i> Klistra in en skärmdump (Ctrl/Cmd+V), släpp en bild här, eller välj fil nedan
                                </div>
                                <input type="file" class="form-control" id="faltMedalProofFile" accept=".pdf,image/*" capture="environment">
                                <div id="faltMedalProofPreview" class="small mt-2"></div>
                                <div class="mt-2">
                                    <select class="form-select form-select-sm" id="faltMedalProofReuse">
                                        <option value="">— eller återanvänd ett tidigare uppladdat bevis —</option>
                                    </select>
                                    <div id="faltMedalProofReuseInfo" class="small text-success mt-1" style="display: none;"></div>
                                </div>
                                <div class="form-text">
                                    Ladda upp resultatlistan eller ett foto (PDF, JPG, PNG, WEBP – max 10 MB). En ny fil <strong>ersätter</strong> ett tidigare bevis.
                                    Samma resultatlista kan återanvändas för flera resultat från samma tävling. Utan bevis registreras medaljen som <strong>overifierad</strong>.
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="faltNotes" class="form-label">Anteckningar</label>
                            <input type="text" class="form-control" id="faltNotes" placeholder="t.ex. byig vind, ny ammunition">
                        </div>
                    </div>

                    <div id="faltPreview" class="alert alert-secondary py-2 small mb-0 d-none">
                        <strong>Förhandsvisning:</strong>
                        <span id="faltPreviewHeadline" class="ms-1"></span>
                        &nbsp;·&nbsp; <span id="faltPreviewHitPct"></span>
                        &nbsp;·&nbsp; <span id="faltPreviewFigurePct"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="faltSaveBtn" onclick="saveFaltskytteScore()">
                    <i class="bi bi-save"></i> Spara
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        // Run when the partial parses — Flatpickr is already loaded by TrainingScoreEntry.cshtml.
        function initFalt() {
            if (typeof flatpickr === 'undefined') { return setTimeout(initFalt, 100); }
            flatpickr('#faltDate', { locale: 'sv', dateFormat: 'Y-m-d', maxDate: 'today' });
        }
        initFalt();

        function recomputePreview() {
            var stations = parseInt(document.getElementById('faltStationCount').value, 10) || 0;
            var maxHits = Math.max(0, stations * 6);
            document.getElementById('faltMaxHitsHint').textContent = maxHits;
            document.getElementById('faltMaxHitsSuffix').textContent = 'av ' + maxHits;
            document.getElementById('faltHits').max = maxHits;

            var hits = parseInt(document.getElementById('faltHits').value, 10);
            var figures = parseInt(document.getElementById('faltFigures').value, 10);
            var figuresMax = parseInt(document.getElementById('faltFiguresMax').value, 10);
            var mode = document.getElementById('faltMode').value;
            var preview = document.getElementById('faltPreview');

            if (Number.isFinite(hits) && Number.isFinite(figures) && figuresMax > 0 && maxHits > 0) {
                var headline = mode === 'Poangfalt' ? (hits + figures) + ' p' : (hits + '/' + figures);
                document.getElementById('faltPreviewHeadline').textContent = headline;
                document.getElementById('faltPreviewHitPct').textContent = 'Träff ' + Math.round(1000 * hits / maxHits) / 10 + ' %';
                document.getElementById('faltPreviewFigurePct').textContent = 'Figur ' + Math.round(1000 * figures / figuresMax) / 10 + ' %';
                preview.classList.remove('d-none');
            } else {
                preview.classList.add('d-none');
            }
        }

        ['faltStationCount', 'faltHits', 'faltFigures', 'faltFiguresMax', 'faltMode'].forEach(function (id) {
            document.getElementById(id).addEventListener('input', recomputePreview);
            document.getElementById(id).addEventListener('change', recomputePreview);
        });

        // ── Standardmedalj proof tools (mirror of the Precision result modal) ──
        var medalSel = document.getElementById('faltMedal');
        if (medalSel) {
            medalSel.addEventListener('change', function () {
                faltToggleProofBlock();
                if (this.value) {
                    var idVal = document.getElementById('faltEntryId').value;
                    if (idVal) faltLoadProofState(idVal);
                    faltLoadReusableProofs();
                }
            });
        }

        var proofFileInput = document.getElementById('faltMedalProofFile');
        if (proofFileInput) {
            proofFileInput.addEventListener('change', function () {
                if (this.files && this.files.length > 0) { faltClearProofReuse(); faltShowProofPreview(this.files[0]); }
                else { faltShowProofPreview(null); }
            });
        }

        var proofReuse = document.getElementById('faltMedalProofReuse');
        if (proofReuse) {
            proofReuse.addEventListener('change', function () {
                var block = document.getElementById('faltMedalProofBlock');
                var info = document.getElementById('faltMedalProofReuseInfo');
                if (this.value) {
                    if (block) block.dataset.reuseRef = this.value;
                    var fi = document.getElementById('faltMedalProofFile'); if (fi) fi.value = '';
                    faltShowProofPreview(null);
                    if (info) {
                        info.style.display = 'block';
                        info.innerHTML = '<i class="bi bi-recycle"></i> Återanvänder: ' + faltMpEsc(this.options[this.selectedIndex] ? this.options[this.selectedIndex].textContent : 'tidigare bevis');
                    }
                } else { faltClearProofReuse(); }
            });
        }

        var proofDrop = document.getElementById('faltMedalProofDrop');
        if (proofDrop) {
            proofDrop.addEventListener('click', function () {
                var fi = document.getElementById('faltMedalProofFile'); if (fi && !fi.disabled) fi.click();
            });
            ['dragover', 'dragenter'].forEach(function (ev) { proofDrop.addEventListener(ev, function (e) { e.preventDefault(); proofDrop.classList.add('border-primary', 'text-primary'); }); });
            ['dragleave', 'drop'].forEach(function (ev) { proofDrop.addEventListener(ev, function (e) { e.preventDefault(); proofDrop.classList.remove('border-primary', 'text-primary'); }); });
            proofDrop.addEventListener('drop', function (e) {
                var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
                if (f && (f.type.startsWith('image/') || f.type === 'application/pdf')) faltSetProofFile(f);
            });
        }

        // Paste a screenshot while the fält modal + proof block are open.
        document.addEventListener('paste', function (e) {
            var modal = document.getElementById('addFaltskytteScoreModal');
            var block = document.getElementById('faltMedalProofBlock');
            if (!modal || !modal.classList.contains('show')) return;
            if (!block || block.style.display === 'none') return;
            var items = (e.clipboardData && e.clipboardData.items) || [];
            for (var i = 0; i < items.length; i++) {
                var it = items[i];
                if (it.kind === 'file' && it.type.startsWith('image/')) {
                    var f = it.getAsFile();
                    if (f) { faltSetProofFile(f); e.preventDefault(); break; }
                }
            }
        });
    })();

    // ── Standardmedalj proof helpers (fält-scoped twins of the Precision modal helpers) ──
    function faltMpEsc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
    }
    // Show the proof block only when a medal is selected.
    function faltToggleProofBlock() {
        var block = document.getElementById('faltMedalProofBlock');
        if (!block) return;
        var medal = document.getElementById('faltMedal').value;
        block.style.display = medal ? 'block' : 'none';
    }
    function faltResetProof() {
        var block = document.getElementById('faltMedalProofBlock');
        var fi = document.getElementById('faltMedalProofFile');
        if (fi) { fi.value = ''; fi.disabled = false; }
        var cur = document.getElementById('faltMedalProofCurrent'); if (cur) cur.innerHTML = '';
        var prev = document.getElementById('faltMedalProofPreview'); if (prev) prev.innerHTML = '';
        faltClearProofReuse();
        if (block) delete block.dataset.reuseRef;
    }
    function faltClearProofReuse() {
        var block = document.getElementById('faltMedalProofBlock');
        var sel = document.getElementById('faltMedalProofReuse');
        var info = document.getElementById('faltMedalProofReuseInfo');
        if (block) delete block.dataset.reuseRef;
        if (sel) sel.value = '';
        if (info) { info.style.display = 'none'; info.innerHTML = ''; }
    }
    function faltSetProofFile(file) {
        var fi = document.getElementById('faltMedalProofFile');
        if (!fi || fi.disabled || !file) return;
        var dt = new DataTransfer(); dt.items.add(file); fi.files = dt.files;
        faltClearProofReuse();          // a chosen/pasted file wins over a reused one
        faltShowProofPreview(file);
    }
    function faltShowProofPreview(file) {
        var el = document.getElementById('faltMedalProofPreview');
        if (!el) return;
        if (!file) { el.innerHTML = ''; return; }
        var thumb = (file.type && file.type.startsWith('image/'))
            ? '<img src="' + URL.createObjectURL(file) + '" alt="" style="max-height:48px;border-radius:4px;margin-right:6px;vertical-align:middle;">'
            : '<i class="bi bi-file-earmark-pdf me-1"></i>';
        el.innerHTML = '<span class="text-success">' + thumb + 'Bild bifogad' + (file.name ? ': ' + faltMpEsc(file.name) : '') + '.</span>';
    }
    // Populate the "current proof" line for an existing medal award.
    function faltLoadProofState(trainingScoreId) {
        var el = document.getElementById('faltMedalProofCurrent');
        var fileInput = document.getElementById('faltMedalProofFile');
        if (!el) return;
        el.innerHTML = '';
        fetch('/umbraco/surface/StandardMedal/GetMedalForTrainingScore?trainingScoreId=' + trainingScoreId)
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success || !d.hasAward) {
                    el.innerHTML = '<span class="text-muted">Ingen registrerad medalj ännu — välj medalj och ladda gärna upp bevis.</span>';
                    return;
                }
                if (d.inGold) {
                    el.innerHTML = '<span class="text-warning"><i class="bi bi-lock"></i> Medaljen ingår i en guldmedaljansökan och kan inte ändras.</span>';
                    if (fileInput) fileInput.disabled = true;
                    return;
                }
                if (fileInput) fileInput.disabled = false;
                if (d.hasProofFile) {
                    el.innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Bevis uppladdat.</span> '
                        + '<a href="/umbraco/surface/StandardMedal/GetProof?awardId=' + d.awardId + '" target="_blank" rel="noopener">Visa</a>'
                        + ' <span class="text-muted">— ladda upp en ny fil nedan för att ersätta.</span>';
                } else {
                    el.innerHTML = '<span class="text-muted"><i class="bi bi-exclamation-circle"></i> Inget bevis uppladdat — medaljen är overifierad tills ett bevis finns.</span>';
                }
            })
            .catch(function () { el.innerHTML = ''; });
    }
    function faltLoadReusableProofs() {
        var sel = document.getElementById('faltMedalProofReuse');
        if (!sel) return;
        fetch('/umbraco/surface/StandardMedal/GetMyReusableProofs')
            .then(function (r) { return r.json(); })
            .then(function (d) {
                sel.innerHTML = '<option value="">— eller återanvänd ett tidigare uppladdat bevis —</option>';
                if (!d.success || !d.proofs) return;
                d.proofs.forEach(function (p) {
                    var date = p.competitionDate ? new Date(p.competitionDate).toLocaleDateString('sv-SE') : '';
                    var opt = document.createElement('option');
                    opt.value = p.proofRef;
                    opt.textContent = (p.competitionName || 'Tävling') + (date ? ' (' + date + ')' : '');
                    sel.appendChild(opt);
                });
            })
            .catch(function () { });
    }
    // Resolve the proof reference to save: a newly uploaded/pasted file, a reused list, or
    // undefined (leave the current proof untouched).
    function faltResolveProofRef(token) {
        var medal = document.getElementById('faltMedal').value;
        if (!medal) return Promise.resolve(undefined);
        var fileInput = document.getElementById('faltMedalProofFile');
        var block = document.getElementById('faltMedalProofBlock');
        if (fileInput && !fileInput.disabled && fileInput.files && fileInput.files.length > 0) {
            var fd = new FormData(); fd.append('file', fileInput.files[0]);
            return fetch('/umbraco/surface/StandardMedal/UploadProof', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                body: fd
            })
            .then(function (r) { return r.json(); })
            .then(function (res) { if (res.success) return res.fileRef; throw new Error(res.message || 'Kunde inte ladda upp bevis.'); });
        }
        if (block && block.dataset.reuseRef) return Promise.resolve(block.dataset.reuseRef);
        return Promise.resolve(undefined);
    }

    // Open empty for "new" entry. openFaltskytteScoreModalForEdit(row) prefills.
    function openFaltskytteScoreModal() {
        document.getElementById('faltskytteScoreForm').reset();
        document.getElementById('faltEntryId').value = '';
        document.getElementById('faltStationCount').value = 8;
        document.getElementById('faltMaxHitsHint').textContent = 48;
        document.getElementById('faltMaxHitsSuffix').textContent = 'av 48';
        document.getElementById('faltPreview').classList.add('d-none');
        faltResetProof();
        faltToggleProofBlock();
        document.getElementById('addFaltskytteScoreModalLabel').innerHTML = '<i class="bi bi-plus-circle"></i> Lägg in Fältskytte-resultat';
        new bootstrap.Modal(document.getElementById('addFaltskytteScoreModal')).show();
    }

    function openFaltskytteScoreModalForEdit(row) {
        document.getElementById('faltskytteScoreForm').reset();
        document.getElementById('faltEntryId').value = row.trainingScoreId || '';
        document.getElementById('faltDate')._flatpickr.setDate(row.date);
        document.getElementById('faltCompetitionName').value = row.competitionName || '';
        document.getElementById('faltShootingClass').value = row.shootingClass || '';
        document.getElementById('faltMode').value = row.mode || 'Normalfalt';
        document.getElementById('faltStationCount').value = row.stationCount || 8;
        document.getElementById('faltHits').value = row.totalHits ?? '';
        document.getElementById('faltFigures').value = row.totalFigures ?? '';
        document.getElementById('faltFiguresMax').value = row.maxFigures ?? '';
        document.getElementById('faltPlacement').value = row.placement ?? '';
        document.getElementById('faltParticipants').value = row.participants ?? '';
        document.getElementById('faltMedal').value = row.standardMedal || '';
        document.getElementById('faltNotes').value = row.notes || '';
        document.getElementById('addFaltskytteScoreModalLabel').innerHTML = '<i class="bi bi-pencil-square"></i> Redigera Fältskytte-resultat';
        var maxHits = (parseInt(row.stationCount, 10) || 0) * 6;
        document.getElementById('faltMaxHitsHint').textContent = maxHits;
        document.getElementById('faltMaxHitsSuffix').textContent = 'av ' + maxHits;
        // Proof tools: reset, then reveal + load current state when a medal is present.
        faltResetProof();
        faltToggleProofBlock();
        if (row.standardMedal) {
            if (row.trainingScoreId) faltLoadProofState(row.trainingScoreId);
            faltLoadReusableProofs();
        }
        new bootstrap.Modal(document.getElementById('addFaltskytteScoreModal')).show();
    }

    async function saveFaltskytteScore() {
        var btn = document.getElementById('faltSaveBtn');
        var idVal = document.getElementById('faltEntryId').value;
        var isEdit = !!idVal;

        // Collect & validate locally before posting.
        var payload = {
            id: isEdit ? parseInt(idVal, 10) : null,
            date: document.getElementById('faltDate').value,
            competitionName: document.getElementById('faltCompetitionName').value.trim(),
            shootingClass: document.getElementById('faltShootingClass').value,
            mode: document.getElementById('faltMode').value,
            stationCount: parseInt(document.getElementById('faltStationCount').value, 10),
            hits: parseInt(document.getElementById('faltHits').value, 10),
            figures: parseInt(document.getElementById('faltFigures').value, 10),
            figuresMax: parseInt(document.getElementById('faltFiguresMax').value, 10),
            placement: document.getElementById('faltPlacement').value ? parseInt(document.getElementById('faltPlacement').value, 10) : null,
            participants: document.getElementById('faltParticipants').value ? parseInt(document.getElementById('faltParticipants').value, 10) : null,
            standardMedal: document.getElementById('faltMedal').value || null,
            notes: document.getElementById('faltNotes').value.trim()
        };

        var missing = [];
        if (!payload.date) missing.push('Datum');
        if (!payload.competitionName) missing.push('Tävling');
        if (!payload.shootingClass) missing.push('Skytteklass');
        if (!Number.isFinite(payload.stationCount)) missing.push('Antal stationer');
        if (!Number.isFinite(payload.hits)) missing.push('Antal träff');
        if (!Number.isFinite(payload.figures)) missing.push('Träffade figurer');
        if (!Number.isFinite(payload.figuresMax)) missing.push('Totalt antal figurer');
        if (missing.length) {
            alert('Följande fält saknas eller är ogiltiga: ' + missing.join(', '));
            return;
        }

        var token = document.querySelector('#faltskytteScoreForm input[name="__RequestVerificationToken"]').value;
        btn.disabled = true;
        try {
            // Resolve proof (new upload, pasted screenshot, or a reused list) first, then save.
            var proofRef = await faltResolveProofRef(token);
            if (proofRef) payload.medalProofFileRef = proofRef;

            var endpoint = isEdit
                ? '/umbraco/surface/TrainingScoring/UpdateFaltskytteScore'
                : '/umbraco/surface/TrainingScoring/RecordFaltskytteScore';
            var resp = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify(payload)
            });
            var data = await resp.json();
            if (!data.success) {
                alert(data.message || 'Något gick fel.');
                return;
            }
            bootstrap.Modal.getInstance(document.getElementById('addFaltskytteScoreModal')).hide();
            if (typeof loadResults === 'function') loadResults();
            if (typeof loadDashboard === 'function') loadDashboard();
        } catch (err) {
            alert('Något gick fel: ' + err.message);
        } finally {
            btn.disabled = false;
        }
    }

    async function deleteFaltskytteScore(id) {
        if (!confirm('Är du säker på att du vill ta bort detta Fältskytte-resultat?')) return;
        try {
            var resp = await fetch('/umbraco/surface/TrainingScoring/DeleteFaltskytteScore?id=' + id, { method: 'DELETE' });
            var data = await resp.json();
            if (!data.success) {
                alert(data.message || 'Kunde inte ta bort.');
                return;
            }
            if (typeof loadResults === 'function') loadResults();
            if (typeof loadDashboard === 'function') loadDashboard();
        } catch (err) {
            alert('Något gick fel: ' + err.message);
        }
    }
</script>
