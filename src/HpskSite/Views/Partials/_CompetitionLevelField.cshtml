@model string
@using HpskSite.CompetitionTypes.Common
@inject Umbraco.Cms.Core.Services.IContentTypeService LevelContentTypeService
@*
    TÄVLINGSNIVÅ — vad tävlingen är godkänd som (SHB C.3.1), delad av
    tävlingsguiden, redigeringsmodalen och Springskyttemodalen. Modellen är dialogens
    id-prefix (wizard_ / edit_ / springEdit_). Renderas i avsnittet/steget
    "Nivå och mästerskap", tillsammans med isClubOnly, mästerskapet, standardmedaljer och
    hederspriser — de fälten ägs av dialogen, den här partialen äger bara valet och reglerna.

    ⚠️⚠️ KATEGORIN ÄR INTE "VEM FÅR ANMÄLA SIG" — se CompetitionLevel. Vilka som får anmäla
    sig är bara isClubOnly-rutan.

    REGLERNA, i klienten och på servern (CompetitionLevel.ConsistencyError):
      - Bara en föreningstävling kan vara stängd för klubbens egna medlemmar. Annan
        kategori kryssar ur och stänger isClubOnly-rutan.
      - En föreningstävling ger inga standardmedaljer: rutan kryssas ur och stängs.
      - En föreningstävling kräver en klubb som arrangör.

    ⚠️ Värden, etiketter, förklaringar och mästerskapskartan kommer ur CompetitionLevel (C#).
    Förslagsregeln finns i JS av nödvändighet (den följer dialogens val medan man fyller i),
    men läser SAMMA karta som servern.

    ⚠️ SAKNAS EGENSKAPEN competitionLevel visas en förklaring och inga regler tillämpas —
    SetValue på en saknad egenskap är en TYST no-op.

    ⚠️ EN BEKRÄFTAD KATEGORI ÄNDRAS ALDRIG AV SIG SJÄLV, och ett FÖRSLAG får aldrig stänga av
    standardmedaljer: en standardmedaljsgrundande tävling föreslås som kretstävling.
*@
@{
    var prefix = Model ?? "";
    var levelPropertyExists = false;
    try
    {
        levelPropertyExists = LevelContentTypeService.Get("competition")?.PropertyTypeExists(CompetitionLevel.PropertyAlias) ?? false;
    }
    catch { levelPropertyExists = false; }
    var selectId = prefix + CompetitionLevel.PropertyAlias;
    var scriptIncluded = Context.Items.ContainsKey("hpskCompetitionLevelScript");
    Context.Items["hpskCompetitionLevelScript"] = true;
}

<div class="mb-3 hpsk-level-block" id="@(prefix)competitionLevelBlock"
     data-level-prefix="@prefix" data-level-property="@(levelPropertyExists ? "1" : "0")">
    <label for="@selectId" class="form-label fw-semibold mb-0">Tävlingsnivå</label>
    <div class="form-text mt-0 mb-1">Vad tävlingen är godkänd som (SHB C.3.1) — vem som gav sitt medgivande.</div>
    @if (levelPropertyExists)
    {
        <select class="form-select" id="@selectId" name="@CompetitionLevel.PropertyAlias">
            @foreach (var o in CompetitionLevel.All)
            {
                <option value="@o.Value">@o.Label</option>
            }
        </select>
        <div class="form-text" id="@(prefix)competitionLevelExplain"></div>
        @* ⚠️ Ett FÖRSLAG ser annars ut som ett sparat värde — bangranskningen säger då "saknas" om en
           tävling vars dialog visar Kretstävling. Rutan säger rakt ut att inget är sparat. *@
        <div class="alert alert-warning py-2 px-3 small mt-2 mb-0 d-none" id="@(prefix)competitionLevelSuggested">
            <i class="bi bi-exclamation-circle me-1"></i><strong>Inte sparad än.</strong> Tävlingsnivån är ett förslag utifrån arrangör, mästerskap och
            standardmedaljer. Kontrollera att det stämmer och tryck <strong>Spara</strong> — först då är tävlingsnivån satt.
        </div>
        <div class="small text-danger mt-1 d-none" id="@(prefix)competitionLevelWarning"></div>
    }
    else
    {
        <div class="small text-muted border rounded p-2">
            <i class="bi bi-info-circle me-1"></i>Kategorin kan inte sparas ännu: egenskapen
            <code>@CompetitionLevel.PropertyAlias</code> saknas på dokumenttypen <code>competition</code>.
        </div>
    }
</div>

@if (!scriptIncluded)
{
    <script>
    (function () {
        'use strict';
        if (window.hpskLevelLoaded) return;
        window.hpskLevelLoaded = true;

        // Ur CompetitionLevel (C#) — inte avskrivet.
        var LEVELS = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            CompetitionLevel.All.Select(o => new { value = o.Value, label = o.Label, explanation = o.Explanation, requiresClub = o.RequiresClub })));
        var SCOPE_TO_LEVEL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(CompetitionLevel.ScopeSuggestions));
        var FORENING = '@CompetitionLevel.Forening', KRETS = '@CompetitionLevel.Krets', NATIONELL = '@CompetitionLevel.Nationell';

        function el(prefix, name) { return document.getElementById(prefix + name); }
        function level(v) { for (var i = 0; i < LEVELS.length; i++) if (LEVELS[i].value === v) return LEVELS[i]; return null; }
        function hasProperty(prefix) { var b = el(prefix, 'competitionLevelBlock'); return !!b && b.dataset.levelProperty === '1'; }
        // Redigeringsmodalens tips saknar prefix (befintligt id), de andra har det.
        function medalHint(prefix) {
            return document.getElementById(prefix === 'edit_' ? 'standardMedalsClubOnlyHint' : prefix + 'standardMedalsClubOnlyHint');
        }

        // Klubblistan laddas asynkront; dialogerna lägger det kommande värdet i dataset.
        function hasClub(prefix) {
            var s = el(prefix, 'clubId');
            if (!s) return false;
            var v = (s.value || '').trim();
            if (v && v !== '0') return true;
            var pending = (s.dataset.currentValue || s.dataset.pendingValue || '').trim();
            return !!pending && pending !== '0' && !(s.options.length > 1);
        }
        function hasRegion(prefix) {
            var s = el(prefix, 'regionalFederation');
            if (!s) return false;
            return !!((s.value || '').trim() || (!(s.options.length > 1) && (s.dataset.currentValue || '').trim()));
        }
        function scopeValue(prefix) {
            var s = el(prefix, 'competitionScope');
            var v = s ? (s.value || '').trim() : '';
            if (v.charAt(0) === '[' && v.charAt(v.length - 1) === ']') v = v.slice(1, -1).trim().replace(/^"|"$/g, '');
            return v;
        }

        // Speglar CompetitionLevel.Suggest — samma ordning, samma mästerskapskarta.
        function suggest(prefix) {
            var cb = el(prefix, 'isClubOnly');
            var medals = el(prefix, 'isAwardingStandardMedals');
            var club = hasClub(prefix);
            if (cb && cb.checked && club) return FORENING;
            var result;
            var fromScope = SCOPE_TO_LEVEL[scopeValue(prefix)];
            if (fromScope) result = (fromScope === FORENING && !club) ? KRETS : fromScope;
            else if (club) result = FORENING;
            else if (hasRegion(prefix)) result = KRETS;
            else result = NATIONELL;
            return (result === FORENING && medals && medals.checked) ? KRETS : result;
        }

        var busy = {};
        function setChecked(box, value) {
            if (!box || box.checked === value) return;
            box.checked = value;
            box.dispatchEvent(new Event('change', { bubbles: true }));
        }

        function refresh(prefix) {
            var sel = el(prefix, 'competitionLevel');
            if (!sel || !hasProperty(prefix) || busy[prefix]) return;
            busy[prefix] = true;
            try {
                var club = hasClub(prefix);
                var locked = sel.dataset.confirmed === '1' || sel.dataset.touched === '1';
                if (!locked) sel.value = suggest(prefix);

                for (var i = 0; i < sel.options.length; i++) {
                    var o = level(sel.options[i].value);
                    sel.options[i].disabled = !!(o && o.requiresClub && !club && sel.options[i].value !== sel.value);
                }

                var cur = level(sel.value);
                var explain = el(prefix, 'competitionLevelExplain');
                if (explain) explain.textContent = cur ? cur.explanation : '';
                var sugg = el(prefix, 'competitionLevelSuggested');
                if (sugg) sugg.classList.toggle('d-none', locked);
                var warn = el(prefix, 'competitionLevelWarning');
                if (warn) {
                    var msg = (cur && cur.requiresClub && !club)
                        ? 'En föreningstävling kräver att en klubb är arrangör. Välj en klubb eller en annan tävlingsnivå.'
                        : '';
                    warn.textContent = msg;
                    warn.classList.toggle('d-none', !msg);
                }

                var isForening = sel.value === FORENING;

                // Bara en föreningstävling kan vara stängd för klubbens egna medlemmar.
                var cb = el(prefix, 'isClubOnly');
                if (cb && !isForening) {
                    setChecked(cb, false);
                    cb.disabled = true;
                    cb.dataset.levelLocked = '1';
                } else if (cb && cb.dataset.levelLocked === '1') {
                    // Släpp bara det VI stängde — utan klubb står den stängd av dialogens egen regel.
                    cb.dataset.levelLocked = '';
                    cb.disabled = !club;
                }
                var cbNote = el(prefix, 'clubOnlyLevelNote');
                if (cbNote) cbNote.classList.toggle('d-none', isForening);

                // En föreningstävling ger inga standardmedaljer (SHB C.5.1.1, Stefans beslut 2026-10-01).
                var medals = el(prefix, 'isAwardingStandardMedals');
                if (medals) {
                    if (isForening) {
                        setChecked(medals, false);
                        medals.disabled = true;
                    } else if (!(cb && cb.checked)) {
                        medals.disabled = false;
                    }
                }
                var hint = medalHint(prefix);
                if (hint) hint.style.display = (isForening || (cb && cb.checked)) ? '' : 'none';
            } finally {
                busy[prefix] = false;
            }
        }

        /** Fyller valet ur lagrat värde. Tomt = ej bekräftad, förslaget visas. */
        function fill(prefix, stored) {
            var sel = el(prefix, 'competitionLevel');
            if (!sel || !hasProperty(prefix)) return;
            var v = stored && level(stored) ? stored : '';
            sel.dataset.touched = '';
            sel.dataset.confirmed = v ? '1' : '';
            if (v) sel.value = v;
            refresh(prefix);
        }

        function init(block) {
            var prefix = block.dataset.levelPrefix || '';
            if (block.dataset.levelInit === '1') return;
            block.dataset.levelInit = '1';
            if (!hasProperty(prefix)) return;

            var sel = el(prefix, 'competitionLevel');
            sel.addEventListener('change', function () {
                sel.dataset.touched = '1';
                refresh(prefix);
            });
            ['clubId', 'regionalFederation', 'competitionScope', 'isClubOnly', 'isAwardingStandardMedals'].forEach(function (n) {
                var e = el(prefix, n);
                if (e) e.addEventListener('change', function () { refresh(prefix); });
            });

            // Varje öppning börjar om; redigeringsdialogerna fyller sedan i lagrat värde.
            var modal = block.closest('.modal');
            if (modal) modal.addEventListener('show.bs.modal', function () { fill(prefix, ''); });
            fill(prefix, '');
        }

        function initAll() {
            document.querySelectorAll('.hpsk-level-block').forEach(init);
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll);
        else initAll();

        window.hpskLevelFill = function (prefix, stored) {
            var b = el(prefix, 'competitionLevelBlock');
            if (b) init(b);
            fill(prefix, stored || '');
        };
        window.hpskLevelRefresh = function (prefix) {
            var b = el(prefix, 'competitionLevelBlock');
            if (b) init(b);
            refresh(prefix);
        };
    })();
    </script>
}
