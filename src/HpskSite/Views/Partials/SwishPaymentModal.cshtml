@* Swish Payment Modal - Reusable partial for displaying Swish QR code payment *@
<div class="modal fade" id="swishPaymentModal" tabindex="-1" aria-labelledby="swishPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="swishPaymentModalLabel">
                    <i class="bi bi-qr-code"></i> Betala med Swish
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center" id="swishPaymentModalBody">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Laddar QR-kod...</span>
                </div>
            </div>
            <div class="modal-footer flex-wrap">
                <div id="swishMarkPaidByMeInfo" class="me-auto small text-muted text-start d-none" style="flex-basis:100%;"></div>
                <button type="button" id="swishMarkPaidByMeBtn" class="btn btn-success d-none">
                    <i class="bi bi-check2-circle"></i> <span id="swishMarkPaidByMeLabel">Jag har betalat</span>
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Stäng
                </button>
            </div>
        </div>
    </div>
</div>

@* Payer-side "payment sent" claim button. Hidden by default; a caller that knows the viewer is
   a legitimate payer (the shooter on their own invoice, or a club admin) calls
   window.swishModalSetPaymentSent({invoiceId, label, alreadySent}) after rendering the QR.
   Clicking posts to InvoiceAdmin/MarkPaymentSent — a CLAIM only; it never sets the organizer's
   authoritative "received" (Paid) state. *@
<script>
(function () {
    if (window._swishPaidBtnBound) return;   // partial may be on a page only once, but guard anyway
    window._swishPaidBtnBound = true;

    function showSentState() {
        const btn = document.getElementById('swishMarkPaidByMeBtn');
        const info = document.getElementById('swishMarkPaidByMeInfo');
        const label = document.getElementById('swishMarkPaidByMeLabel');
        if (!btn) return;
        btn.disabled = true;
        btn.classList.remove('d-none', 'btn-success');
        btn.classList.add('btn-outline-success');
        if (label) label.textContent = 'Betalning anmäld';
        if (info) {
            info.classList.remove('d-none');
            info.textContent = 'Arrangören har meddelats att betalning är gjord och bekräftar när den är mottagen.';
        }
    }

    // Public API used by callers to enable/disable the button for the current invoice.
    window.swishModalSetPaymentSent = function (opts) {
        const btn = document.getElementById('swishMarkPaidByMeBtn');
        const info = document.getElementById('swishMarkPaidByMeInfo');
        const label = document.getElementById('swishMarkPaidByMeLabel');
        if (!btn) return;
        if (!opts || !opts.invoiceId) {           // null/clear -> hide (default for organizer contexts)
            btn.classList.add('d-none');
            btn.disabled = false;
            if (info) info.classList.add('d-none');
            return;
        }
        btn.dataset.invoiceId = opts.invoiceId;
        if (opts.alreadySent) { showSentState(); return; }
        btn.disabled = false;
        btn.classList.remove('d-none', 'btn-outline-success');
        btn.classList.add('btn-success');
        if (label) label.textContent = opts.label || 'Jag har betalat';
        if (info) {
            info.classList.remove('d-none');
            info.textContent = 'Detta meddelar arrangören att du har betalat. Arrangören bekräftar när betalningen är mottagen.';
        }
    };

    document.addEventListener('click', function (e) {
        const btn = e.target.closest('#swishMarkPaidByMeBtn');
        if (!btn || btn.disabled) return;
        const invoiceId = parseInt(btn.dataset.invoiceId, 10);
        if (!invoiceId) return;
        btn.disabled = true;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        fetch('/umbraco/surface/InvoiceAdmin/MarkPaymentSent', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            credentials: 'include',
            body: JSON.stringify({ invoiceId: invoiceId })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showSentState();
                if (typeof window.onSwishPaymentSent === 'function') window.onSwishPaymentSent(invoiceId);
            } else {
                btn.disabled = false;
                alert(data.message || 'Kunde inte spara betalningsanmälan.');
            }
        })
        .catch(err => { btn.disabled = false; alert('Nätverksfel: ' + err.message); });
    });

    // Reset to hidden when the modal closes so state never leaks to the next invoice.
    const modalEl = document.getElementById('swishPaymentModal');
    if (modalEl) modalEl.addEventListener('hidden.bs.modal', function () { window.swishModalSetPaymentSent(null); });

    // ── Bankgiro alternative ────────────────────────────────────────────────────────────────────
    // Clubs and kretsar usually pay invoices by bankgiro rather than Swish, so every payment dialog
    // offers both. One renderer here means the block can't drift between the six surfaces that show
    // a payment dialog. `data` is the JSON from a QR endpoint (bgNumber / bgReference / payeeName /
    // amount). Returns '' when the organisation has no bankgiro, so callers can concatenate blindly.
    window.renderBankgiroBlock = function (data, opts) {
        if (!data || !data.bgNumber) return '';
        const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c =>
            ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const hasQr = !!(data.qrCodeBase64 || (opts && opts.hasSwish));
        const amount = data.amount ? `${esc(data.amount)} kr` : '';
        return `
            <div class="border rounded p-3 mt-3 text-start">
                <div class="fw-bold mb-2">
                    <i class="bi bi-bank me-1"></i>${hasQr ? 'Eller betala via bankgiro' : 'Betala via bankgiro'}
                </div>
                <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="text-muted">Bankgiro</span>
                    <span class="fw-bold user-select-all">${esc(data.bgNumber)}</span>
                </div>
                ${data.payeeName ? `
                <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="text-muted">Mottagare</span>
                    <span>${esc(data.payeeName)}</span>
                </div>` : ''}
                ${amount ? `
                <div class="d-flex justify-content-between border-bottom py-1">
                    <span class="text-muted">Belopp</span>
                    <span class="fw-bold">${amount}</span>
                </div>` : ''}
                ${data.bgReference ? `
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Referens (OCR/meddelande)</span>
                    <span class="fw-bold user-select-all">${esc(data.bgReference)}</span>
                </div>` : ''}
                <div class="small text-muted mt-2">
                    Ange referensen så att arrangören kan matcha betalningen mot rätt faktura.
                    Betalningen bekräftas av arrangören när den är mottagen.
                </div>
            </div>`;
    };
})();
</script>
