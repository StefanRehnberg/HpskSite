@* Partial view for displaying upcoming (scheduled) training matches *@

<div class="upcoming-matches-container">
    <!-- Loading State -->
    <div id="upcomingMatchesLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Laddar...</span>
        </div>
        <p class="mt-2 text-muted">Hämtar kommande matcher...</p>
    </div>

    <!-- Empty State -->
    <div id="upcomingMatchesEmpty" class="text-center py-5" style="display: none;">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <h5 class="mt-3">Inga schemalagda matcher</h5>
        <p class="text-muted">Det finns inga kommande träningsmatcher schemalagda.<br>Skapa en egen match med ett framtida startdatum.</p>
    </div>

    <!-- Matches List -->
    <div id="upcomingMatchesList" class="row g-3" style="display: none;">
        <!-- Matches will be rendered here by JavaScript -->
    </div>
</div>

<style>
    .upcoming-matches-container {
        min-height: 150px;
    }

    /* Reuse styles from ongoing matches - they share the same list design */
    /* Compact match list item */
    .match-list-item {
        padding: 0.625rem 0.75rem;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .match-list-item:hover {
        background-color: var(--bs-tertiary-bg);
    }

    /* Weapon class dot indicator */
    .weapon-dot {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
        color: white;
        flex-shrink: 0;
    }

    .weapon-dot.bg-purple {
        background-color: #7c3aed;
    }

    /* Match name */
    .match-name {
        font-weight: 500;
        font-size: 0.9rem;
    }

    /* Match meta info */
    .match-meta {
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
        margin-top: 2px;
    }

    /* Compact avatars */
    .match-avatar {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 1.5px solid var(--bs-body-bg);
        object-fit: cover;
        position: relative;
    }

    .match-avatar-initials {
        background: var(--bs-primary);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.55rem;
        font-weight: 600;
    }

    /* Small badge */
    .badge-sm {
        font-size: 0.65rem;
        padding: 0.15rem 0.35rem;
        font-weight: 500;
    }

    /* Action buttons */
    .match-action-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
    }

    .match-actions {
        flex-shrink: 0;
    }

    .min-width-0 {
        min-width: 0;
    }
</style>
