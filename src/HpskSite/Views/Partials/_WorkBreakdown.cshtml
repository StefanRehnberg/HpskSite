@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Förberedelser — the preparation work-breakdown (WorkArea → WorkItem). Områden with an
    // områdesansvarig; uppgifter with assignee (from the same people pool), deadline and status;
    // per-område progress + overdue flag. Independent of start lists — pure planning. Seedable from
    // built-in size templates (klubb/krets/SM). See COMPETITION_STAFFING_SYSTEM.md §4, §6 Phase 1b.
    var competitionId = ViewData["CompetitionId"];
    var wbToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
    <p class="text-muted small mb-0" style="max-width:640px">
        Förberedelserna inför tävlingen — materiel, mark &amp; bana, inköp, sekretariat… Varje uppgift har
        en ansvarig, en deadline och en status. Ju större tävling, desto mer att planera.
    </p>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <div class="btn-group">
            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-magic me-1"></i>Fyll i från mall
            </button>
            <ul class="dropdown-menu dropdown-menu-end" id="wbTemplateMenu">
                <li><h6 class="dropdown-header">Standardmallar</h6></li>
                <li><button class="dropdown-item" type="button" onclick="wbSeed('klubb')">Klubbtävling</button></li>
                <li><button class="dropdown-item" type="button" onclick="wbSeed('krets')">Kretstävling</button></li>
                <li><button class="dropdown-item" type="button" onclick="wbSeed('sm')">Mästerskap (SM)</button></li>
            </ul>
        </div>
        <span id="wbStationSeedSlot"></span>
        <button type="button" class="btn btn-outline-warning btn-sm" onclick="wbRemindOverdue()" title="Skicka en påminnelse till alla med försenade uppgifter">
            <i class="bi bi-bell me-1"></i>Påminn försenade
        </button>
        <a class="btn btn-outline-secondary btn-sm" href="/tavlingsplanering/blad?c=@competitionId&amp;vy=forberedelser" target="_blank" rel="noopener">
            <i class="bi bi-printer me-1"></i>Skriv ut
        </a>
        <button type="button" class="btn btn-primary btn-sm" onclick="wbOpenArea(0)">
            <i class="bi bi-folder-plus me-1"></i>Lägg till område
        </button>
    </div>
</div>

<div id="wbContext" class="mb-2"></div>

@*
    Tävlingsledning — a READ-THROUGH of the Bemanning roster, not a second place to appoint people.
    The roster's tävlingsledning rows are what mirror into the competition's competitionManagers (i.e. they
    are what actually grants access), so they are the single source of truth. Before this, the prep list
    carried its own unconnected "Tävlingsledning" område whose "Utse tävlingsledare"-task sat unassigned
    even after a Tävlingsledare had been appointed under Bemanning — two answers to one question.
*@
<div id="wbLeadership" class="mb-3"></div>

<div id="wbCompDocs" class="mb-3"></div>

<div id="wbAreas">
    <div class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm" role="status"></div> Laddar…</div>
</div>

<!-- Område modal -->
<div class="modal fade" id="wbAreaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="wbAreaModalTitle">Lägg till område</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="wbAreaId" value="0">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Områdesnamn</label>
                    <input type="text" class="form-control" id="wbAreaName" placeholder="t.ex. Materiel">
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold">Områdesansvarig (valfritt)</label>
                    <input type="hidden" id="wbAreaRespId" value="0">
                    <div class="position-relative">
                        <input type="text" class="form-control" id="wbAreaRespSearch" placeholder="Sök medlem…" autocomplete="off">
                        <div id="wbAreaRespResults" class="list-group position-absolute w-100 shadow" style="z-index:1080; display:none; max-height:220px; overflow:auto;"></div>
                    </div>
                    <input type="text" class="form-control mt-1" id="wbAreaRespName" placeholder="eller fritt namn">
                </div>
                <div class="text-danger small mt-2" id="wbAreaError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="wbSaveArea()">Spara</button>
            </div>
        </div>
    </div>
</div>

<!-- Uppgift modal -->
<div class="modal fade" id="wbItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="wbItemModalTitle">Lägg till uppgift</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="wbItemId" value="0">
                <input type="hidden" id="wbItemAreaId" value="0">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Uppgift</label>
                    <input type="text" class="form-control" id="wbItemTitle" placeholder="t.ex. Beställa tavlor">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Beskrivning (valfritt)</label>
                    <textarea class="form-control" id="wbItemDesc" rows="2"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tilldelad (valfritt)</label>
                    <input type="hidden" id="wbItemAssignId" value="0">
                    <div class="position-relative">
                        <input type="text" class="form-control" id="wbItemAssignSearch" placeholder="Sök medlem…" autocomplete="off">
                        <div id="wbItemAssignResults" class="list-group position-absolute w-100 shadow" style="z-index:1080; display:none; max-height:220px; overflow:auto;"></div>
                    </div>
                    <input type="text" class="form-control mt-1" id="wbItemAssignName" placeholder="eller fritt namn">
                </div>
                <div class="row g-2">
                    <div class="col-sm-6 mb-2">
                        <label class="form-label fw-semibold">Deadline (valfritt)</label>
                        <input type="text" class="form-control" id="wbItemDue" placeholder="Ingen">
                    </div>
                    <div class="col-sm-6 mb-2">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" id="wbItemStatus">
                            <option value="Planerad">Planerad</option>
                            <option value="Pagar">Pågår</option>
                            <option value="Blockerad">Blockerad</option>
                            <option value="Klar">Klar</option>
                        </select>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-sm-6 mb-2">
                        <label class="form-label fw-semibold">Koppla till (valfritt)</label>
                        <select class="form-select" id="wbItemScopeType">
                            <option value="">—</option>
                            <option value="Station">Station</option>
                            <option value="Skjutlag">Skjutlag</option>
                            <option value="Klass">Klass</option>
                            <option value="Patrull">Patrull</option>
                            <option value="Bana">Bana</option>
                        </select>
                    </div>
                    <div class="col-sm-6 mb-2" id="wbItemScopeKeyWrap" style="display:none">
                        <label class="form-label fw-semibold" id="wbItemScopeKeyLabel">Nummer</label>
                        <input type="text" class="form-control" id="wbItemScopeKey" placeholder="t.ex. 3">
                    </div>
                </div>
                <div class="form-text mb-1" style="margin-top:-.4rem">Koppla t.ex. en bygguppgift till <strong>Station 3</strong> — då länkas den till Fältkonfiguratorn.</div>
                <div class="row g-2">
                    <div class="col-sm-6 mb-2">
                        <label class="form-label fw-semibold">Budget (kr)</label>
                        <input type="number" min="0" step="1" class="form-control" id="wbItemEstCost" placeholder="valfritt">
                    </div>
                    <div class="col-sm-6 mb-2">
                        <label class="form-label fw-semibold">Utfall (kr)</label>
                        <input type="number" min="0" step="1" class="form-control" id="wbItemActCost" placeholder="valfritt">
                    </div>
                </div>
                <div class="text-danger small mt-2" id="wbItemError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="wbSaveItem()">Spara</button>
            </div>
        </div>
    </div>
</div>

<!-- Dokument/länk modal (shared: competition-level, per-område, per-uppgift) -->
<div class="modal fade" id="wbLinkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="wbLinkModalTitle">Lägg till dokument / länk</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="wbLinkAreaId" value="0">
                <input type="hidden" id="wbLinkItemId" value="0">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Namn (valfritt)</label>
                    <input type="text" class="form-control" id="wbLinkTitle" placeholder="t.ex. Inbjudan, Sanktionsbeslut, Ban-ritning">
                </div>
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item"><button class="nav-link active" id="wbLinkUrlTab" data-bs-toggle="tab" data-bs-target="#wbLinkUrlPane" type="button"><i class="bi bi-link-45deg me-1"></i>Länk</button></li>
                    <li class="nav-item"><button class="nav-link" id="wbLinkFileTab" data-bs-toggle="tab" data-bs-target="#wbLinkFilePane" type="button"><i class="bi bi-upload me-1"></i>Fil</button></li>
                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="wbLinkUrlPane">
                        <input type="url" class="form-control" id="wbLinkUrl" placeholder="https://…">
                        <div class="form-text">Publicerad inbjudan, Google Drive, SHB-referens…</div>
                    </div>
                    <div class="tab-pane fade" id="wbLinkFilePane">
                        <input type="file" class="form-control" id="wbLinkFile">
                        <div class="form-text">PDF, bild, Word, Excel, PowerPoint eller text (max 25 MB).</div>
                    </div>
                </div>
                <div class="text-danger small mt-2" id="wbLinkError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="wbLinkSaveBtn" onclick="wbSaveLink()">Spara</button>
            </div>
        </div>
    </div>
</div>

<!-- Tråd modal: kommentarer/logg + beroenden ("blockeras av") per uppgift -->
<div class="modal fade" id="wbThreadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-chat-dots me-2"></i><span id="wbThreadTitle">Uppgift</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="wbThreadItemId" value="0">

                <h6 class="fw-semibold"><i class="bi bi-diagram-3 me-1"></i>Beroenden</h6>
                <div class="text-muted small mb-2">Uppgifter som måste vara klara innan den här kan göras.</div>
                <div id="wbThreadBlockers" class="mb-2"></div>
                <div class="input-group input-group-sm mb-3">
                    <select class="form-select" id="wbThreadBlockerSelect"><option value="">Välj uppgift som blockerar…</option></select>
                    <button class="btn btn-outline-primary" type="button" onclick="wbAddDependency()"><i class="bi bi-plus-lg"></i> Lägg till</button>
                </div>

                <h6 class="fw-semibold"><i class="bi bi-chat-left-text me-1"></i>Kommentarer &amp; logg</h6>
                <div id="wbThreadComments" class="mb-2"><div class="text-muted small">Laddar…</div></div>
                <div class="input-group">
                    <textarea class="form-control" id="wbThreadCommentBox" rows="2" placeholder="Skriv en kommentar…"></textarea>
                    <button class="btn btn-primary" type="button" id="wbThreadCommentBtn" onclick="wbAddComment()">Kommentera</button>
                </div>
                <div class="text-danger small mt-2" id="wbThreadError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Hantera mallar modal (Phase 1.5) -->
<div class="modal fade" id="wbTemplateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-collection me-2"></i>Sparade mallar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Klubbens/kretsens egna planeringsmallar. Använd en för att fylla på förberedelserna, eller ta bort en du inte behöver. Spara nuvarande förberedelser som en ny mall via "Fyll i från mall → Spara nuvarande som mall".</p>
                <div id="wbTemplateList"><div class="text-muted small">Laddar…</div></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Materielberäkning modal (general Beställningslista) -->
<div class="modal fade" id="wbMaterielModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content" id="wbMaterielPrint">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-box-seam me-2"></i>Materielberäkning</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Uppskattad materiel utifrån antal deltagare, klasser och serier. Detta är en <strong>uppskattning</strong> — justera efter behov innan beställning.</p>
                <div id="wbMaterielBody"><div class="text-muted small">Laddar…</div></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Skriv ut</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var compId = @competitionId;
    var TOKEN = '@wbToken';
    var REFRESH = 12000;
    var timer = null;
    var lastUpdated = '';
    var areas = [];
    var templates = [];
    var compLinks = [];
    var leadership = [];   // tävlingsledning rows read through from the Bemanning roster (never written here)
    var ctx = { discipline: '', compDate: null, daysUntilComp: null, stationSeed: null, totalEstimatedCost: 0, totalActualCost: 0 };
    var areaModal = null, itemModal = null, linkModal = null, threadModal = null, templateModal = null;

    var STATUS_LABEL = { Planerad: 'Planerad', Pagar: 'Pågår', Blockerad: 'Blockerad', Klar: 'Klar' };
    var STATUS_CLS = { Planerad: 'bg-secondary', Pagar: 'bg-primary', Blockerad: 'bg-danger', Klar: 'bg-success' };
    var SCOPE_KEY_LABEL = { Station: 'Station nr', Skjutlag: 'Skjutlag nr', Klass: 'Klass', Patrull: 'Patrull nr', Bana: 'Bana' };

    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function q(id) { return document.getElementById(id); }
    function fmtKr(n) { return (Math.round(Number(n) || 0)).toLocaleString('sv-SE') + ' kr'; }
    // Budget/utfall chip for an item or an område sum. Shows budget, and utfall when set.
    function costBadge(est, act) {
        est = Number(est) || 0; act = Number(act) || 0;
        if (est <= 0 && act <= 0) return '';
        var parts = [];
        if (est > 0) parts.push('budget ' + fmtKr(est));
        if (act > 0) parts.push('utfall ' + fmtKr(act));
        var over = (est > 0 && act > est);
        return '<span class="badge ' + (over ? 'bg-danger-subtle text-danger-emphasis' : 'bg-light text-dark') + ' border" title="Kostnad"><i class="bi bi-cash-coin me-1"></i>' + parts.join(' · ') + '</span>';
    }

    async function load() {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetWorkBreakdown?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { q('wbAreas').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kunde inte läsa förberedelserna.') + '</div>'; return; }
            areas = d.areas || [];
            compLinks = d.compLinks || [];
            leadership = d.leadership || [];
            crewCache = null;   // roster may have changed → re-fetch the crew list on the next picker focus
            ctx = { discipline: d.discipline || '', compDate: d.compDate || null, daysUntilComp: d.daysUntilComp, stationSeed: d.stationSeed || null, totalEstimatedCost: d.totalEstimatedCost || 0, totalActualCost: d.totalActualCost || 0 };
            lastUpdated = new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' });
            render();
        } catch (e) { q('wbAreas').innerHTML = '<div class="alert alert-warning">Kunde inte läsa förberedelserna.</div>'; }
    }

    // Live refresh so several people can plan in parallel and see each other's changes. Skip while a
    // modal is open (don't disrupt an in-progress edit) or while the tab is hidden. Different områden/
    // uppgifter are independent rows, so parallel edits to different parts never clobber each other.
    function poll() {
        if (document.hidden) return;
        if (document.querySelector('.modal.show')) return;   // someone is mid-edit — leave their form alone
        load();
    }
    function startTimer() { if (!timer) timer = setInterval(poll, REFRESH); }
    function stopTimer() { if (timer) { clearInterval(timer); timer = null; } }
    document.addEventListener('visibilitychange', function () { if (document.hidden) stopTimer(); else { poll(); startTimer(); } });

    function render() {
        renderContext();
        renderLeadership();
        renderStationSeedBtn();
        renderCompDocs();
        if (!areas.length) {
            q('wbAreas').innerHTML = '<div class="text-center text-muted py-4">Inga områden ännu. Lägg till ett område, eller fyll i från en mall.</div>';
            return;
        }
        q('wbAreas').innerHTML = areas.map(areaHtml).join('');
    }

    function renderContext() {
        var host = q('wbContext');
        var parts = [];
        if (ctx.compDate) {
            var days = ctx.daysUntilComp;
            var when = (days == null) ? '' :
                (days > 0 ? (days + ' dagar kvar') : (days === 0 ? 'idag' : (Math.abs(days) + ' dagar sedan')));
            var cls = (days != null && days < 0) ? 'text-muted' : (days != null && days <= 14 ? 'text-danger-emphasis' : '');
            parts.push('<span class="badge bg-light text-dark border ' + cls + '"><i class="bi bi-calendar-event me-1"></i>Tävlingsdatum: ' + esc(ctx.compDate) + (when ? ' · ' + when : '') + '</span>');
        }
        if ((ctx.totalEstimatedCost || 0) > 0 || (ctx.totalActualCost || 0) > 0) {
            var cb = costBadge(ctx.totalEstimatedCost, ctx.totalActualCost);
            parts.push('<span title="Total budget / utfall för tävlingen">' + cb.replace('bi-cash-coin me-1', 'bi-wallet2 me-1') + '</span>');
        }
        // Live-collab hint: several people can plan in parallel; the list refreshes so everyone sees changes.
        parts.push('<span class="text-muted small" id="wbUpdated" title="Uppdateras automatiskt — flera kan planera samtidigt"><i class="bi bi-people me-1"></i>Flera kan arbeta samtidigt' + (lastUpdated ? ' · uppdaterad ' + lastUpdated : '') + '</span>');
        host.innerHTML = '<div class="d-flex flex-wrap align-items-center gap-2">' + parts.join('') + '</div>';
    }

    // Who leads this competition, read from the Bemanning roster. Editing happens there — this card only
    // reports, so the two surfaces can never disagree about who the Tävlingsledare is.
    function renderLeadership() {
        var host = q('wbLeadership'); if (!host) return;
        var bem = '/tavlingsplanering?c=' + compId;
        if (!leadership.length) {
            host.innerHTML = '<div class="alert alert-light border py-2 mb-0 small d-flex justify-content-between align-items-center flex-wrap gap-2">'
                + '<div><i class="bi bi-person-badge me-1"></i><strong>Ingen tävlingsledning utsedd än.</strong> '
                + 'Tävlingsledare, säkerhetschef och sekreterare läggs till under <strong>Bemanning</strong>. '
                + 'Där ger du också behörighet att hantera tävlingen i pistol.nu — till vilken funktionär '
                + 'som helst, t.ex. sekretariat eller kassa.</div>'
                + '<button type="button" class="btn btn-sm btn-outline-primary" onclick="wbGoToBemanning()">'
                + '<i class="bi bi-person-plus me-1"></i>Utse tävlingsledning</button></div>';
            return;
        }
        // NAME first — this card answers "who leads this competition", so the person, then their function.
        var rows = leadership.map(function (a) {
            return '<li>'
                + (a.isResponsible ? '<i class="bi bi-star-fill text-warning me-1" title="Ansvarig"></i>' : '')
                + '<strong>' + esc(a.personName || '(namn saknas)') + '</strong>'
                + ' <span class="text-muted">· ' + esc(a.functionTitle || a.roleName) + '</span>'
                + (a.hasAdminAccess ? ' <span class="badge bg-warning text-dark" title="Kan hantera tävlingen i pistol.nu">behörighet</span>' : '')
                + '</li>';
        }).join('');
        host.innerHTML = '<div class="card border-primary-subtle"><div class="card-header py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">'
            + '<span class="fw-semibold"><i class="bi bi-person-badge me-1"></i>Tävlingsledning <span class="badge bg-light text-dark ms-1">' + leadership.length + '</span></span>'
            + '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="wbGoToBemanning()" title="Tävlingsledningen hanteras under Bemanning">'
            + '<i class="bi bi-pencil me-1"></i>Hantera under Bemanning</button>'
            + '</div><div class="card-body py-2">'
            + '<ul class="small mb-0">' + rows + '</ul>'
            + '</div></div>';
    }

    // Same page — just switch to the Bemanning pill (and its Personer sub-tab).
    window.wbGoToBemanning = function () {
        var t = document.getElementById('plan-bemanning-tab');
        if (t && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(t).show(); return; }
        window.location = '/tavlingsplanering?c=' + compId;
    };

    function renderStationSeedBtn() {
        var slot = q('wbStationSeedSlot');
        if (!slot) return;
        var s = ctx.stationSeed;
        if (s && s.available) {
            slot.innerHTML =
                '<a class="btn btn-outline-primary btn-sm" href="/faltskytte/materiel/' + compId + '" target="_blank" rel="noopener" title="Materiellista från stationskonfigurationen"><i class="bi bi-box-seam me-1"></i>Materiellista</a> '
                + '<button type="button" class="btn btn-outline-primary btn-sm" onclick="wbSeedStations()" title="Skapa en bygguppgift per station"><i class="bi bi-geo-alt me-1"></i>Skapa stationsuppgifter (' + s.stationCount + ')</button>';
        } else {
            // Non-Fält: a general materiel estimate (Beställningslista) from participant/class/series counts.
            slot.innerHTML = '<button type="button" class="btn btn-outline-primary btn-sm" onclick="wbOpenMateriel()" title="Uppskattad materiel från antal deltagare/klasser/serier"><i class="bi bi-box-seam me-1"></i>Materielberäkning</button>';
        }
    }

    function renderCompDocs() {
        var host = q('wbCompDocs');
        var chips = linkChips(compLinks);
        host.innerHTML = '<div class="card"><div class="card-header d-flex justify-content-between align-items-center py-2">'
            + '<span class="fw-semibold"><i class="bi bi-folder2-open me-1"></i>Dokument &amp; länkar</span>'
            + '<button type="button" class="btn btn-sm btn-outline-primary" onclick="wbOpenLink(0,0)"><i class="bi bi-plus-lg me-1"></i>Lägg till</button>'
            + '</div><div class="card-body py-2">'
            + (chips || '<div class="text-muted small">Inga dokument ännu. Lägg sanktion, inbjudan, säkerhetsplan, ban-ritning, bokningar här.</div>')
            + '</div></div>';
    }

    // Renders a link/file chip row (used at comp level + per uppgift). Each chip opens the URL/download; a
    // small × deletes it.
    function linkChips(links) {
        if (!links || !links.length) return '';
        return '<div class="d-flex flex-wrap gap-1">' + links.map(function (l) {
            var icon = l.isFile ? 'bi-paperclip' : 'bi-link-45deg';
            return '<span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1" style="font-weight:500">'
                + '<a href="' + esc(l.url) + '" target="_blank" rel="noopener" class="text-decoration-none"><i class="bi ' + icon + ' me-1"></i>' + esc(l.title) + '</a>'
                + '<button type="button" class="btn-close" style="font-size:.6rem" title="Ta bort" onclick="wbDeleteLink(' + l.id + ')"></button>'
                + '</span>';
        }).join('') + '</div>';
    }

    function areaHtml(a) {
        var pct = a.totalCount > 0 ? Math.round((a.doneCount / a.totalCount) * 100) : 0;
        var overdue = a.overdueCount > 0 ? '<span class="badge bg-danger ms-1" title="Försenade">' + a.overdueCount + ' försenade</span>' : '';
        var areaCost = costBadge(a.estimatedCostSum, a.actualCostSum);
        var areaCostWrap = areaCost ? ' ' + areaCost : '';
        var resp = a.responsibleName ? '<span class="text-muted small ms-2"><i class="bi bi-person me-1"></i>' + esc(a.responsibleName) + '</span>' : '';
        var items = (a.items || []).map(itemHtml).join('') || '<div class="text-muted small py-2">Inga uppgifter ännu.</div>';
        return '<div class="card mb-3">'
            + '<div class="card-header d-flex justify-content-between align-items-center py-2 flex-wrap gap-1">'
            + '<span><span class="fw-semibold">' + esc(a.name) + '</span> <span class="badge bg-light text-dark">' + a.doneCount + '/' + a.totalCount + ' klara</span>' + overdue + areaCostWrap + resp + '</span>'
            + '<span class="d-flex gap-1">'
            + '<button type="button" class="btn btn-sm btn-outline-primary" onclick="wbOpenItem(' + a.id + ',0)"><i class="bi bi-plus-lg me-1"></i>Uppgift</button>'
            + '<button type="button" class="btn btn-sm btn-outline-secondary" onclick="wbOpenArea(' + a.id + ')" title="Redigera område"><i class="bi bi-pencil"></i></button>'
            + '<button type="button" class="btn btn-sm btn-outline-danger" onclick="wbDeleteArea(' + a.id + ',\'' + esc(a.name).replace(/'/g, "\\'") + '\')" title="Ta bort område"><i class="bi bi-trash"></i></button>'
            + '</span>'
            + '</div>'
            + '<div class="card-body py-2">'
            + '<div class="progress mb-2" style="height:6px"><div class="progress-bar bg-success" style="width:' + pct + '%"></div></div>'
            + items
            + '</div></div>';
    }

    function itemHtml(i) {
        var done = i.status === 'Klar';
        var due = i.dueDate ? '<span class="badge ' + (i.isOverdue ? 'bg-danger' : 'bg-light text-dark border') + '"><i class="bi bi-calendar-event me-1"></i>' + esc(i.dueDate) + '</span>' : '';
        var who = i.assignedName ? '<span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>' + esc(i.assignedName) + '</span>' : '<span class="badge bg-light text-secondary border">otilldelad</span>';
        var statusBadge = '<span class="badge ' + (STATUS_CLS[i.status] || 'bg-secondary') + '">' + esc(STATUS_LABEL[i.status] || i.status) + '</span>';
        var scope = scopeBadge(i);
        var blockedBadge = i.isBlocked ? '<span class="badge bg-danger-subtle text-danger-emphasis border" title="Väntar på en annan uppgift"><i class="bi bi-slash-circle me-1"></i>Blockerad</span>' : '';
        var titleCls = done ? 'text-decoration-line-through text-muted' : '';
        var links = (i.links && i.links.length) ? ('<div class="mt-1 ms-4">' + linkChips(i.links) + '</div>') : '';
        var blockLine = blockedByLine(i);
        var titleEsc = esc(i.title).replace(/'/g, "\\'");
        // Five icon-only buttons per uppgift, on a list that runs to dozens of rows. One menu
        // instead — and the comment COUNT moves up into the badge line, because that is
        // information about the task, not an action, and it must stay readable at a glance.
        var commentBadge = i.commentCount
            ? '<span class="badge bg-light text-dark border" title="Kommentarer"><i class="bi bi-chat-dots me-1"></i>' + i.commentCount + '</span>'
            : '';
        var notifyItem = i.assignedMemberId
            ? '<li><button class="dropdown-item" type="button" onclick="wbNotifyItem(' + i.id + ',\'' + titleEsc + '\')"><i class="bi bi-bell me-2 text-primary"></i>Notifiera tilldelad medlem</button></li>'
            : '';
        var actionsMenu = '<div class="dropdown">'
            + '<button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\' aria-expanded="false" title="Åtgärder för ' + esc(i.title) + '">'
            + '<i class="bi bi-sliders me-2"></i>Åtgärder</button>'
            + '<ul class="dropdown-menu dropdown-menu-end">'
            + '<li><button class="dropdown-item" type="button" onclick="wbOpenThread(' + i.id + ',\'' + titleEsc + '\')"><i class="bi bi-chat-dots me-2 text-secondary"></i>Kommentarer, logg &amp; beroenden' + (i.commentCount ? ' (' + i.commentCount + ')' : '') + '</button></li>'
            + notifyItem
            + '<li><button class="dropdown-item" type="button" onclick="wbOpenLink(0,' + i.id + ')"><i class="bi bi-paperclip me-2 text-secondary"></i>Bifoga dokument eller länk</button></li>'
            + '<li><button class="dropdown-item" type="button" onclick="wbOpenItem(' + i.workAreaId + ',' + i.id + ')"><i class="bi bi-pencil me-2 text-primary"></i>Redigera uppgiften</button></li>'
            + '<li><hr class="dropdown-divider"></li>'
            + '<li><button class="dropdown-item text-danger" type="button" onclick="wbDeleteItem(' + i.id + ',\'' + titleEsc + '\')"><i class="bi bi-trash me-2"></i>Ta bort uppgiften</button></li>'
            + '</ul></div>';
        return '<div class="d-flex justify-content-between align-items-start border-top py-2 gap-2" style="border-color:var(--bs-border-color)">'
            + '<div class="flex-grow-1">'
            + '<div class="form-check">'
            + '<input class="form-check-input" type="checkbox" ' + (done ? 'checked' : '') + ' onchange="wbToggle(' + i.id + ',this.checked)">'
            + '<label class="form-check-label ' + titleCls + '">' + esc(i.title) + '</label>'
            + '</div>'
            + (i.description ? '<div class="text-muted small ms-4">' + esc(i.description) + '</div>' : '')
            + '<div class="d-flex flex-wrap gap-1 mt-1 ms-4">' + who + due + statusBadge + blockedBadge + scope + costBadge(i.estimatedCost, i.actualCost) + commentBadge + '</div>'
            + blockLine
            + links
            + '</div>'
            + '<div class="flex-shrink-0">' + actionsMenu + '</div>'
            + '</div>';
    }

    // Scope badge; a Station scope links to the attached Fältkonfigurator when we have its id.
    function scopeBadge(i) {
        if (!i.scopeType) return '';
        var label = i.scopeType + (i.scopeKey ? ' ' + i.scopeKey : '');
        var cfg = ctx.stationSeed && ctx.stationSeed.attachedConfigId;
        if (i.scopeType === 'Station' && cfg) {
            return '<a class="badge bg-info-subtle text-info-emphasis border text-decoration-none" href="/faltkonfig/' + cfg + '/redigera" target="_blank" rel="noopener" title="Öppna i Fältkonfiguratorn"><i class="bi bi-geo-alt me-1"></i>' + esc(label) + ' <i class="bi bi-box-arrow-up-right"></i></a>';
        }
        return '<span class="badge bg-info-subtle text-info-emphasis border"><i class="bi bi-geo-alt me-1"></i>' + esc(label) + '</span>';
    }

    // Compact "blockeras av …" line under an item (full mgmt is in the thread modal).
    function blockedByLine(i) {
        var bb = i.blockedBy || [];
        if (!bb.length) return '';
        var lead = i.isBlocked
            ? '<span class="text-danger"><i class="bi bi-slash-circle me-1"></i>Blockeras av:</span> '
            : '<span class="text-muted"><i class="bi bi-check2-all me-1"></i>Var blockerad av:</span> ';
        var names = bb.map(function (b) {
            return '<span class="' + (b.done ? 'text-muted text-decoration-line-through' : '') + '">' + esc(b.title) + '</span>';
        }).join(', ');
        return '<div class="small mt-1 ms-4">' + lead + names + '</div>';
    }

    function findArea(id) { for (var i = 0; i < areas.length; i++) if (areas[i].id === id) return areas[i]; return null; }
    function findItem(id) {
        for (var i = 0; i < areas.length; i++) { var its = areas[i].items || []; for (var j = 0; j < its.length; j++) if (its[j].id === id) return its[j]; }
        return null;
    }

    // ---- member search (used by both modals) ----
    // The competition's OWN crew is offered first (from the people layer), then a site-wide search. Prep
    // owners used to be picked purely out of a global member list with no reference to the roster, which is
    // how someone could own half the preparation while never appearing among the funktionärer.
    var crewCache = null;
    async function loadCrew() {
        if (crewCache) return crewCache;
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetCrewCandidates?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            crewCache = (d && d.success) ? (d.members || []) : [];
        } catch (e) { crewCache = []; }
        return crewCache;
    }

    function memberButtonHtml(m, isCrew) {
        return '<button type="button" class="list-group-item list-group-item-action" data-id="' + m.memberId + '" data-name="' + esc(m.memberName) + '">'
            + esc(m.memberName)
            + (m.clubName ? ' <span class="text-muted small">· ' + esc(m.clubName) + '</span>' : '')
            + (isCrew && m.roleSummary ? '<div class="text-muted small">' + esc(m.roleSummary) + '</div>' : '')
            + (isCrew && !m.roleSummary && m.state ? '<div class="text-muted small">' + esc(m.state) + '</div>' : '')
            + '</button>';
    }

    function wireSearch(searchId, resultsId, idField, nameField) {
        var box = q(searchId), results = q(resultsId);
        var timer = null;

        function bindPicks() {
            results.querySelectorAll('button[data-id]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    q(idField).value = this.getAttribute('data-id');
                    q(nameField).value = this.getAttribute('data-name');
                    box.value = this.getAttribute('data-name');
                    results.style.display = 'none';
                });
            });
        }

        // Focusing the empty box shows the crew — no typing needed to pick someone already involved.
        box.addEventListener('focus', async function () {
            if (this.value.trim().length >= 2) return;
            var crew = await loadCrew();
            if (!crew.length) return;
            results.innerHTML = '<div class="list-group-item small text-muted fw-semibold bg-body-tertiary">'
                + '<i class="bi bi-people me-1"></i>Funktionärer på den här tävlingen</div>'
                + crew.map(function (m) { return memberButtonHtml(m, true); }).join('')
                + '<div class="list-group-item small text-muted">Skriv för att söka bland alla medlemmar…</div>';
            results.style.display = 'block';
            bindPicks();
        });

        box.addEventListener('input', function () {
            var val = this.value.trim();
            if (timer) clearTimeout(timer);
            if (val.length < 2) { results.style.display = 'none'; return; }
            timer = setTimeout(function () { run(val); }, 220);
        });
        document.addEventListener('click', function (e) {
            if (!e.target.closest('#' + resultsId) && e.target !== box) results.style.display = 'none';
        });
        async function run(val) {
            try {
                var crew = (await loadCrew()).filter(function (m) {
                    return (m.memberName || '').toLowerCase().indexOf(val.toLowerCase()) > -1;
                });
                var r = await fetch('/umbraco/surface/Staffing/SearchMembers?competitionId=' + compId + '&query=' + encodeURIComponent(val), { headers: { 'Accept': 'application/json' } });
                var d = await r.json();
                if (!d.success) { results.style.display = 'none'; return; }
                var crewIds = {};
                crew.forEach(function (m) { crewIds[m.memberId] = 1; });
                var others = (d.members || []).filter(function (m) { return !crewIds[m.memberId]; });
                if (!crew.length && !others.length) { results.innerHTML = '<div class="list-group-item small text-muted">Inga träffar</div>'; results.style.display = 'block'; return; }
                var html = '';
                if (crew.length) {
                    html += '<div class="list-group-item small text-muted fw-semibold bg-body-tertiary"><i class="bi bi-people me-1"></i>Redan på tävlingen</div>'
                        + crew.map(function (m) { return memberButtonHtml(m, true); }).join('');
                }
                if (others.length) {
                    html += '<div class="list-group-item small text-muted fw-semibold bg-body-tertiary"><i class="bi bi-search me-1"></i>Övriga medlemmar</div>'
                        + others.map(function (m) { return memberButtonHtml(m, false); }).join('');
                }
                results.innerHTML = html;
                results.style.display = 'block';
                bindPicks();
            } catch (e) { results.style.display = 'none'; }
        }
        q(nameField).addEventListener('input', function () { q(idField).value = '0'; });
    }
    wireSearch('wbAreaRespSearch', 'wbAreaRespResults', 'wbAreaRespId', 'wbAreaRespName');
    wireSearch('wbItemAssignSearch', 'wbItemAssignResults', 'wbItemAssignId', 'wbItemAssignName');

    // ---- område ----
    window.wbOpenArea = function (id) {
        if (!areaModal) areaModal = new bootstrap.Modal(q('wbAreaModal'));
        q('wbAreaError').textContent = '';
        var a = id ? findArea(id) : null;
        q('wbAreaId').value = a ? a.id : 0;
        q('wbAreaName').value = a ? a.name : '';
        q('wbAreaRespId').value = a && a.responsibleMemberId ? a.responsibleMemberId : 0;
        q('wbAreaRespName').value = a && a.responsibleName ? a.responsibleName : '';
        q('wbAreaRespSearch').value = a && a.responsibleName ? a.responsibleName : '';
        q('wbAreaModalTitle').textContent = a ? 'Redigera område' : 'Lägg till område';
        areaModal.show();
    };

    window.wbSaveArea = async function () {
        var name = q('wbAreaName').value.trim();
        if (!name) { q('wbAreaError').textContent = 'Ange ett namn.'; return; }
        var payload = {
            id: parseInt(q('wbAreaId').value, 10) || 0,
            competitionId: compId,
            name: name,
            responsibleMemberId: parseInt(q('wbAreaRespId').value, 10) || 0,
            responsibleName: q('wbAreaRespName').value.trim()
        };
        var d = await post('/umbraco/surface/Staffing/SaveWorkArea', payload);
        if (d.success) { areaModal.hide(); await load(); }
        else q('wbAreaError').textContent = d.message || 'Kunde inte spara.';
    };

    window.wbDeleteArea = async function (id, name) {
        if (!confirm('Ta bort området "' + name + '" och alla dess uppgifter?')) return;
        var d = await post('/umbraco/surface/Staffing/DeleteWorkArea', { id: id, competitionId: compId });
        if (d.success) await load(); else alert(d.message || 'Kunde inte ta bort.');
    };

    // ---- uppgift ----
    window.wbOpenItem = function (areaId, itemId) {
        if (!itemModal) itemModal = new bootstrap.Modal(q('wbItemModal'));
        q('wbItemError').textContent = '';
        var i = itemId ? findItem(itemId) : null;
        q('wbItemId').value = i ? i.id : 0;
        q('wbItemAreaId').value = areaId;
        q('wbItemTitle').value = i ? i.title : '';
        q('wbItemDesc').value = i && i.description ? i.description : '';
        q('wbItemAssignId').value = i && i.assignedMemberId ? i.assignedMemberId : 0;
        q('wbItemAssignName').value = i && i.assignedName ? i.assignedName : '';
        q('wbItemAssignSearch').value = i && i.assignedName ? i.assignedName : '';
        q('wbItemDue').value = i && i.dueDate ? i.dueDate : '';
        q('wbItemStatus').value = i ? i.status : 'Planerad';
        q('wbItemScopeType').value = i && i.scopeType ? i.scopeType : '';
        q('wbItemScopeKey').value = i && i.scopeKey ? i.scopeKey : '';
        q('wbItemEstCost').value = i && i.estimatedCost != null ? i.estimatedCost : '';
        q('wbItemActCost').value = i && i.actualCost != null ? i.actualCost : '';
        applyItemScope();
        q('wbItemModalTitle').textContent = i ? 'Redigera uppgift' : 'Lägg till uppgift';
        itemModal.show();
    };

    function applyItemScope() {
        var st = q('wbItemScopeType').value;
        var wrap = q('wbItemScopeKeyWrap');
        if (!st) { wrap.style.display = 'none'; }
        else { wrap.style.display = ''; q('wbItemScopeKeyLabel').textContent = SCOPE_KEY_LABEL[st] || 'Nummer'; }
    }
    q('wbItemScopeType').addEventListener('change', applyItemScope);

    window.wbSaveItem = async function () {
        var title = q('wbItemTitle').value.trim();
        if (!title) { q('wbItemError').textContent = 'Ange en uppgift.'; return; }
        var st = q('wbItemScopeType').value;
        var payload = {
            id: parseInt(q('wbItemId').value, 10) || 0,
            competitionId: compId,
            workAreaId: parseInt(q('wbItemAreaId').value, 10) || 0,
            title: title,
            description: q('wbItemDesc').value.trim(),
            assignedMemberId: parseInt(q('wbItemAssignId').value, 10) || 0,
            assignedName: q('wbItemAssignName').value.trim(),
            dueDate: q('wbItemDue').value.trim(),
            status: q('wbItemStatus').value,
            scopeType: st,
            scopeKey: st ? q('wbItemScopeKey').value.trim() : '',
            estimatedCost: q('wbItemEstCost').value === '' ? null : parseFloat(q('wbItemEstCost').value),
            actualCost: q('wbItemActCost').value === '' ? null : parseFloat(q('wbItemActCost').value)
        };
        var d = await post('/umbraco/surface/Staffing/SaveWorkItem', payload);
        if (d.success) { itemModal.hide(); await load(); }
        else q('wbItemError').textContent = d.message || 'Kunde inte spara.';
    };

    window.wbDeleteItem = async function (id, title) {
        if (!confirm('Ta bort uppgiften "' + title + '"?')) return;
        var d = await post('/umbraco/surface/Staffing/DeleteWorkItem', { id: id, competitionId: compId });
        if (d.success) await load(); else alert(d.message || 'Kunde inte ta bort.');
    };

    window.wbToggle = async function (id, checked) {
        var d = await post('/umbraco/surface/Staffing/SetWorkItemStatus', { id: id, competitionId: compId, status: checked ? 'Klar' : 'Planerad' });
        if (d.success) await load();
    };

    // ---- materiel estimate (general Beställningslista) ----
    var materielModal = null;
    window.wbOpenMateriel = async function () {
        if (!materielModal) materielModal = new bootstrap.Modal(q('wbMaterielModal'));
        q('wbMaterielBody').innerHTML = '<div class="text-muted small">Laddar…</div>';
        materielModal.show();
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetMaterielEstimate?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { q('wbMaterielBody').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kunde inte beräkna.') + '</div>'; return; }
            var counts = '<div class="mb-2 small text-muted">Underlag: <strong>' + d.participantCount + '</strong> deltagare · <strong>' + d.startCount + '</strong> starter · <strong>' + d.classCount + '</strong> klasser'
                + (d.series > 0 ? ' · <strong>' + d.series + '</strong> serier' : '') + '</div>';
            var rows = (d.rows || []).map(function (row) {
                return '<tr><td>' + esc(row.category) + '</td><td>' + esc(row.item) + '</td>'
                    + '<td class="text-end">' + (row.quantity != null ? row.quantity + (row.unit ? ' ' + esc(row.unit) : '') : '<span class="text-muted">efter behov</span>') + '</td>'
                    + '<td class="text-muted small">' + esc(row.basis) + '</td></tr>';
            }).join('') || '<tr><td colspan="4" class="text-muted">Inga poster.</td></tr>';
            q('wbMaterielBody').innerHTML = counts
                + '<table class="table table-sm"><thead><tr><th>Kategori</th><th>Materiel</th><th class="text-end">Antal</th><th>Underlag</th></tr></thead><tbody>' + rows + '</tbody></table>'
                + '<p class="text-muted small mb-0">Deltagarantal räknas från anmälningarna. Fler antal fylls på när fler anmäler sig.</p>';
        } catch (e) { q('wbMaterielBody').innerHTML = '<div class="alert alert-warning">Nätverksfel.</div>'; }
    };

    // ---- editable per-club/region templates (Phase 1.5) ----
    async function loadTemplates() {
        try {
            var r = await fetch('/umbraco/surface/Staffing/ListTemplates?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            templates = (d && d.success) ? (d.templates || []) : [];
        } catch (e) { templates = []; }
        renderTemplateMenu();
    }

    function renderTemplateMenu() {
        var menu = q('wbTemplateMenu');
        if (!menu) return;
        var html = '<li><h6 class="dropdown-header">Standardmallar</h6></li>'
            + '<li><button class="dropdown-item" type="button" onclick="wbSeed(\'klubb\')">Klubbtävling</button></li>'
            + '<li><button class="dropdown-item" type="button" onclick="wbSeed(\'krets\')">Kretstävling</button></li>'
            + '<li><button class="dropdown-item" type="button" onclick="wbSeed(\'sm\')">Mästerskap (SM)</button></li>';
        if (templates.length) {
            html += '<li><hr class="dropdown-divider"></li><li><h6 class="dropdown-header">Klubbens/kretsens mallar</h6></li>';
            html += templates.map(function (t) {
                return '<li><button class="dropdown-item" type="button" onclick="wbSeedTemplate(' + t.id + ',\'' + esc(t.name).replace(/'/g, "\\'") + '\')">' + esc(t.name) + ' <span class="text-muted small">· ' + t.areaCount + ' områden</span></button></li>';
            }).join('');
        }
        html += '<li><hr class="dropdown-divider"></li>'
            + '<li><button class="dropdown-item" type="button" onclick="wbSaveAsTemplate()"><i class="bi bi-save me-1"></i>Spara nuvarande som mall…</button></li>'
            + '<li><button class="dropdown-item" type="button" onclick="wbOpenTemplates()"><i class="bi bi-collection me-1"></i>Hantera mallar…</button></li>';
        menu.innerHTML = html;
    }

    window.wbSeedTemplate = async function (id, name) {
        if (!confirm('Fyll i förberedelser från mallen "' + name + '"? Områden med samma namn hoppas över.')) return;
        var d = await post('/umbraco/surface/Staffing/SeedPrepTemplate', { competitionId: compId, templateId: id });
        if (d.success) await load(); else alert(d.message || 'Kunde inte fylla i mallen.');
    };

    window.wbSaveAsTemplate = async function () {
        var name = prompt('Namn på mallen (sparas för klubben/kretsen så ni kan återanvända den):');
        if (!name || !name.trim()) return;
        var d = await post('/umbraco/surface/Staffing/SaveAsTemplate', { competitionId: compId, name: name.trim() });
        if (d.success) { await loadTemplates(); alert('Mallen "' + name.trim() + '" sparad.'); }
        else alert(d.message || 'Kunde inte spara mallen.');
    };

    window.wbOpenTemplates = function () {
        if (!templateModal) templateModal = new bootstrap.Modal(q('wbTemplateModal'));
        renderTemplateList();
        templateModal.show();
    };

    function renderTemplateList() {
        var host = q('wbTemplateList');
        if (!host) return;
        if (!templates.length) { host.innerHTML = '<div class="text-muted small fst-italic">Inga sparade mallar ännu.</div>'; return; }
        host.innerHTML = templates.map(function (t) {
            var nm = esc(t.name).replace(/'/g, "\\'");
            return '<div class="d-flex justify-content-between align-items-center border rounded px-2 py-2 mb-2">'
                + '<div><span class="fw-semibold">' + esc(t.name) + '</span> <span class="badge bg-light text-dark border">' + (t.ownerType === 'Region' ? 'Krets' : 'Klubb') + '</span>'
                + '<div class="text-muted small">' + t.areaCount + ' områden · ' + t.itemCount + ' uppgifter' + (t.staffRowCount ? ' · ' + t.staffRowCount + ' rollrader' : '') + '</div></div>'
                + '<div class="d-flex gap-1">'
                + '<button type="button" class="btn btn-sm btn-outline-primary" onclick="wbSeedTemplate(' + t.id + ',\'' + nm + '\')">Använd</button>'
                + '<button type="button" class="btn btn-sm btn-outline-danger" onclick="wbDeleteTemplate(' + t.id + ',\'' + nm + '\')" title="Ta bort"><i class="bi bi-trash"></i></button>'
                + '</div></div>';
        }).join('');
    }

    window.wbDeleteTemplate = async function (id, name) {
        if (!confirm('Ta bort mallen "' + name + '"?')) return;
        var d = await post('/umbraco/surface/Staffing/DeleteTemplate', { competitionId: compId, templateId: id });
        if (d.success) { await loadTemplates(); renderTemplateList(); } else alert(d.message || 'Kunde inte ta bort.');
    };

    window.wbSeed = async function (size) {
        var label = size === 'sm' ? 'Mästerskap (SM)' : (size === 'krets' ? 'Kretstävling' : 'Klubbtävling');
        if (!confirm('Fyll i förberedelsemallen för ' + label + '? Befintliga områden med samma namn hoppas över.')) return;
        var d = await post('/umbraco/surface/Staffing/SeedPrepTemplate', { competitionId: compId, size: size });
        if (d.success) { await load(); }
        else alert(d.message || 'Kunde inte fylla i mallen.');
    };

    window.wbSeedStations = async function () {
        var s = ctx.stationSeed;
        if (!s || !s.available) return;
        if (!confirm('Skapa en "Bygg station N"-uppgift för var och en av de ' + s.stationCount + ' stationerna? Befintliga stationsuppgifter hoppas över.')) return;
        var d = await post('/umbraco/surface/Staffing/SeedStationTasks', { competitionId: compId });
        if (d.success) { await load(); }
        else alert(d.message || 'Kunde inte skapa stationsuppgifter.');
    };

    // ---- dokument & länkar ----
    window.wbOpenLink = function (areaId, itemId) {
        if (!linkModal) linkModal = new bootstrap.Modal(q('wbLinkModal'));
        q('wbLinkError').textContent = '';
        q('wbLinkAreaId').value = areaId || 0;
        q('wbLinkItemId').value = itemId || 0;
        q('wbLinkTitle').value = '';
        q('wbLinkUrl').value = '';
        q('wbLinkFile').value = '';
        // default to the Länk tab
        new bootstrap.Tab(q('wbLinkUrlTab')).show();
        var where = itemId ? 'uppgiften' : (areaId ? 'området' : 'tävlingen');
        q('wbLinkModalTitle').textContent = 'Lägg till dokument / länk för ' + where;
        linkModal.show();
    };

    window.wbSaveLink = async function () {
        var err = q('wbLinkError'); err.textContent = '';
        var areaId = parseInt(q('wbLinkAreaId').value, 10) || 0;
        var itemId = parseInt(q('wbLinkItemId').value, 10) || 0;
        var title = q('wbLinkTitle').value.trim();
        var url = q('wbLinkUrl').value.trim();
        var file = q('wbLinkFile').files[0];
        var btn = q('wbLinkSaveBtn'); btn.disabled = true;
        try {
            var d;
            if (file) {
                var fd = new FormData();
                fd.append('competitionId', compId);
                if (areaId) fd.append('workAreaId', areaId);
                if (itemId) fd.append('workItemId', itemId);
                if (title) fd.append('title', title);
                fd.append('file', file);
                var r = await fetch('/umbraco/surface/Staffing/UploadWorkDocument', { method: 'POST', headers: { 'RequestVerificationToken': TOKEN }, body: fd });
                d = await r.json();
            } else if (url) {
                d = await post('/umbraco/surface/Staffing/SaveWorkLink', { competitionId: compId, workAreaId: areaId, workItemId: itemId, title: title, url: url });
            } else {
                err.textContent = 'Ange en länk eller välj en fil.'; btn.disabled = false; return;
            }
            if (d.success) { linkModal.hide(); await load(); }
            else err.textContent = d.message || 'Kunde inte spara.';
        } catch (e) { err.textContent = 'Nätverksfel.'; }
        btn.disabled = false;
    };

    window.wbDeleteLink = async function (id) {
        if (!confirm('Ta bort dokumentet/länken?')) return;
        var d = await post('/umbraco/surface/Staffing/DeleteWorkLink', { id: id, competitionId: compId });
        if (d.success) await load(); else alert(d.message || 'Kunde inte ta bort.');
    };

    // ---- notiser & påminnelser ----
    window.wbNotifyItem = async function (id, title) {
        if (!confirm('Skicka en påminnelse till den tilldelade medlemmen för "' + title + '"?')) return;
        var d = await post('/umbraco/surface/Staffing/NotifyWorkItem', { id: id, competitionId: compId });
        if (d.success) {
            var ch = []; if (d.email) ch.push('e-post'); if (d.push) ch.push('push');
            alert('Skickat' + (ch.length ? ' (' + ch.join(' + ') + ')' : '') + '.'); await load();
        } else alert(d.message || 'Kunde inte skicka.');
    };

    window.wbRemindOverdue = async function () {
        if (!confirm('Skicka en påminnelse till alla som har försenade uppgifter?')) return;
        var d = await post('/umbraco/surface/Staffing/RemindOverdue', { competitionId: compId });
        if (d.success) {
            alert(d.message || ('Påminnelser skickade till ' + d.notified + ' person(er) · ' + d.items + ' uppgift(er).'));
            await load();
        } else alert(d.message || 'Kunde inte skicka.');
    };

    // ---- tråd: kommentarer/logg + beroenden ----
    window.wbOpenThread = function (itemId, title) {
        if (!threadModal) threadModal = new bootstrap.Modal(q('wbThreadModal'));
        q('wbThreadItemId').value = itemId;
        q('wbThreadTitle').textContent = title || 'Uppgift';
        q('wbThreadError').textContent = '';
        q('wbThreadCommentBox').value = '';
        q('wbThreadBlockers').innerHTML = '<div class="text-muted small">Laddar…</div>';
        q('wbThreadComments').innerHTML = '<div class="text-muted small">Laddar…</div>';
        threadModal.show();
        loadThread(itemId);
    };

    async function loadThread(itemId) {
        try {
            var r = await fetch('/umbraco/surface/Staffing/GetWorkItemThread?competitionId=' + compId + '&workItemId=' + itemId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { q('wbThreadComments').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kunde inte läsa tråden.') + '</div>'; return; }
            renderBlockers(d.blockedBy || [], d.candidates || []);
            renderComments(d.comments || []);
        } catch (e) { q('wbThreadComments').innerHTML = '<div class="alert alert-warning">Nätverksfel.</div>'; }
    }

    function renderBlockers(list, candidates) {
        var host = q('wbThreadBlockers');
        host.innerHTML = list.length ? list.map(function (b) {
            var badge = b.done ? '<span class="badge bg-success ms-1">Klar</span>' : '<span class="badge bg-secondary ms-1">' + esc(b.status || 'Ej klar') + '</span>';
            var icon = b.done ? '<i class="bi bi-check2-circle text-success me-1"></i>' : '<i class="bi bi-slash-circle text-danger me-1"></i>';
            return '<div class="d-flex justify-content-between align-items-center border rounded px-2 py-1 mb-1">'
                + '<span>' + icon + esc(b.title) + badge + '</span>'
                + '<button type="button" class="btn btn-sm btn-outline-danger" onclick="wbRemoveDependency(' + b.dependencyId + ')" title="Ta bort beroende"><i class="bi bi-x-lg"></i></button>'
                + '</div>';
        }).join('') : '<div class="text-muted small fst-italic mb-1">Inga beroenden.</div>';
        var sel = q('wbThreadBlockerSelect');
        sel.innerHTML = '<option value="">Välj uppgift som blockerar…</option>' + candidates.map(function (c) {
            return '<option value="' + c.id + '">' + esc(c.title) + (c.area ? ' (' + esc(c.area) + ')' : '') + '</option>';
        }).join('');
    }

    function renderComments(list) {
        var host = q('wbThreadComments');
        if (!list.length) { host.innerHTML = '<div class="text-muted small fst-italic">Inga kommentarer eller händelser ännu.</div>'; return; }
        host.innerHTML = list.map(function (c) {
            var who = esc(c.authorName || (c.kind === 'audit' ? 'System' : 'Okänd'));
            if (c.kind === 'audit') {
                return '<div class="small text-muted fst-italic py-1"><i class="bi bi-clock-history me-1"></i>' + who + ' ' + esc(c.body) + ' · ' + esc(c.createdDate) + '</div>';
            }
            return '<div class="border rounded px-2 py-1 mb-1">'
                + '<div class="d-flex justify-content-between align-items-center"><span class="fw-semibold small">' + who + '</span>'
                + '<span class="d-flex align-items-center gap-2"><span class="text-muted small">' + esc(c.createdDate) + '</span>'
                + '<button type="button" class="btn-close" style="font-size:.6rem" title="Ta bort" onclick="wbDeleteComment(' + c.id + ')"></button></span></div>'
                + '<div class="small" style="white-space:pre-wrap">' + esc(c.body) + '</div>'
                + '</div>';
        }).join('');
    }

    window.wbAddComment = async function () {
        var itemId = parseInt(q('wbThreadItemId').value, 10) || 0;
        var body = q('wbThreadCommentBox').value.trim();
        if (!body || !itemId) return;
        var btn = q('wbThreadCommentBtn'); btn.disabled = true;
        var d = await post('/umbraco/surface/Staffing/AddWorkItemComment', { competitionId: compId, workItemId: itemId, body: body });
        btn.disabled = false;
        if (d.success) { q('wbThreadCommentBox').value = ''; await loadThread(itemId); await load(); }
        else q('wbThreadError').textContent = d.message || 'Kunde inte spara.';
    };

    window.wbDeleteComment = async function (id) {
        if (!confirm('Ta bort kommentaren?')) return;
        var itemId = parseInt(q('wbThreadItemId').value, 10) || 0;
        var d = await post('/umbraco/surface/Staffing/DeleteWorkItemComment', { id: id, competitionId: compId });
        if (d.success) { await loadThread(itemId); await load(); }
    };

    window.wbAddDependency = async function () {
        var itemId = parseInt(q('wbThreadItemId').value, 10) || 0;
        var blockedBy = parseInt(q('wbThreadBlockerSelect').value, 10) || 0;
        if (!itemId || !blockedBy) { q('wbThreadError').textContent = 'Välj en uppgift.'; return; }
        q('wbThreadError').textContent = '';
        var d = await post('/umbraco/surface/Staffing/AddWorkItemDependency', { competitionId: compId, workItemId: itemId, blockedByItemId: blockedBy });
        if (d.success) { await loadThread(itemId); await load(); }
        else q('wbThreadError').textContent = d.message || 'Kunde inte lägga till.';
    };

    window.wbRemoveDependency = async function (depId) {
        var itemId = parseInt(q('wbThreadItemId').value, 10) || 0;
        var d = await post('/umbraco/surface/Staffing/RemoveWorkItemDependency', { id: depId, competitionId: compId });
        if (d.success) { await loadThread(itemId); await load(); }
    };

    async function post(url, payload) {
        try {
            var r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify(payload) });
            return await r.json();
        } catch (e) { return { success: false, message: 'Nätverksfel.' }; }
    }

    function initPickers() {
        if (typeof flatpickr === 'undefined') return;
        flatpickr('#wbItemDue', { locale: 'sv', dateFormat: 'Y-m-d' });
    }
    initPickers();

    load();
    loadTemplates();
    startTimer();
})();
</script>
