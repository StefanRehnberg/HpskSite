@{
    var regionContentId = ViewBag.regionContentId as int? ?? 0;
    var regionName = ViewBag.regionName as string ?? "Krets";
}

<!-- Flatpickr Date/Time Picker -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<!-- CKEditor 5 Rich Text Editor -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js"></script>

<!-- Region Event Create/Edit Modal -->
<div class="modal fade" id="regionEventModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="regionEventModalTitle">Ny Händelse</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="regionEventForm">
                    <input type="hidden" id="regionEventId" name="eventId">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Händelsenamn *</label>
                            <input type="text" class="form-control" id="regionEventName" name="eventName" required oninput="updateRegionEventUrlPreview()">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Typ *</label>
                            <select class="form-select" id="regionEventType" required onchange="onRegionEventTypeChange()">
                                <option value="Träning">Träning</option>
                                <option value="Städning">Städning</option>
                                <option value="Möte">Möte</option>
                                <option value="Socialt">Socialt</option>
                                <option value="Nyhet">Nyhet</option>
                                <option value="Annat">Annat...</option>
                            </select>
                            <input type="text" class="form-control mt-2" id="regionEventCustomType" placeholder="Ange typ, t.ex. Workshop" style="display: none;" oninput="syncRegionEventTypeValue(); checkRegionCompetitionTypeWarning()">
                            <div class="alert alert-info py-1 px-2 mt-2 small" id="regionCompetitionTypeWarning" style="display: none;">
                                <i class="bi bi-info-circle me-1"></i>Tävlingar skapas under fliken <strong>Tävlingar</strong> på den arrangerande klubbens adminsida, inte som en händelse.
                            </div>
                            <input type="hidden" id="regionEventTypeValue" name="eventType">
                        </div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted">
                            <i class="bi bi-link-45deg me-1"></i>URL: <span id="regionEventUrlPreview" class="font-monospace"></span>
                            <a href="#" id="regionEventPageNameToggle" class="ms-2" onclick="toggleRegionEventPageName(event)">Ändra sidnamn</a>
                        </small>
                    </div>
                    <div class="mb-3" id="regionEventPageNameGroup" style="display: none;">
                        <label class="form-label">Sidnamn (URL)</label>
                        <input type="text" class="form-control" id="regionEventPageName" name="pageName" oninput="updateRegionEventUrlPreview()">
                        <small class="form-text">Kortare namn för en renare URL. Lämna tomt för att använda händelsenamnet.</small>
                    </div>
                    <div class="mb-3" id="regionEventDateGroup">
                        <label class="form-label" id="regionEventDateLabel">Datum *</label>
                        <input type="text" class="form-control" id="regionEventDate" name="eventDate" required>
                        <small class="form-text" id="regionEventDateHint" style="display: none;">Valfritt för nyheter. Lämna tomt för att visa utan datum.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Plats</label>
                        <input type="text" class="form-control" id="regionEventVenue" name="venue">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Beskrivning</label>
                        <textarea class="form-control" id="regionEventDescription" name="description" rows="3"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Kontaktperson</label>
                            <input type="text" class="form-control" id="regionEventContactPerson" name="contactPerson">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Kontakt E-post</label>
                            <input type="email" class="form-control" id="regionEventContactEmail" name="contactEmail">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Kontakt Telefon</label>
                            <input type="tel" class="form-control" id="regionEventContactPhone" name="contactPhone">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="saveRegionEvent()">
                    <i class="bi bi-save me-2"></i>Spara
                </button>
            </div>
        </div>
    </div>
</div>

<div class="regional-admin-panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="alert alert-info mb-0 flex-grow-1 me-3">
            <i class="bi bi-shield-check me-2"></i>
            <strong>Kretsadministration</strong> - Du kan hantera dokument, texter och bilder för @regionName här.
        </div>
        <button class="btn btn-info text-white" onclick="showRegionEmailModal()">
            <i class="bi bi-envelope me-2"></i>Skicka mail
        </button>
    </div>

    <!-- Admin Sub-Tabs -->
    <ul class="nav nav-tabs mb-3" id="regionAdminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="regionDocuments-tab" data-bs-toggle="tab" data-bs-target="#regionDocumentsTab" type="button">
                <i class="bi bi-file-earmark-text me-2"></i>Dokument
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionEvents-tab" data-bs-toggle="tab" data-bs-target="#regionEventsTab" type="button">
                <i class="bi bi-calendar-event me-2"></i>Händelser
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionAdminCompetitions-tab" data-bs-toggle="tab" data-bs-target="#regionAdminCompetitionsTab" type="button"
                    data-region-code="@(ViewBag.regionCode as string ?? "")">
                <i class="bi bi-trophy me-2"></i>Tävlingar
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionSettings-tab" data-bs-toggle="tab" data-bs-target="#regionSettingsTab" type="button">
                <i class="bi bi-gear me-2"></i>Inställningar
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionBoardAdmin-tab" data-bs-toggle="tab" data-bs-target="#regionBoardAdminTab" type="button">
                <i class="bi bi-award me-2"></i>Roller
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionMeetings-tab" data-bs-toggle="tab" data-bs-target="#regionMeetingsTab" type="button">
                <i class="bi bi-calendar-event me-2"></i>Styrelsemöten
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionCertifications-tab" data-bs-toggle="tab" data-bs-target="#regionCertificationsTab" type="button">
                <i class="bi bi-mortarboard me-2"></i>Certifieringar
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionChampions-tab" data-bs-toggle="tab" data-bs-target="#regionChampionsTab" type="button">
                <i class="bi bi-trophy-fill me-2"></i>Mästare
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionStats-tab" data-bs-toggle="tab" data-bs-target="#regionStatsTab" type="button">
                <i class="bi bi-graph-up me-2"></i>Statistik
            </button>
        </li>
    </ul>

    <!-- Sub-Tab Content -->
    <div class="tab-content" id="regionAdminTabContent">
        <!-- Documents Sub-Tab -->
        <div class="tab-pane fade show active" id="regionDocumentsTab">
            @{ ViewBag.DocumentOwnerType = 1; ViewBag.DocumentOwnerId = regionContentId; }
            @await Html.PartialAsync("ClubDocumentAdmin")
        </div>

        <!-- Events Sub-Tab -->
        <div class="tab-pane fade" id="regionEventsTab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Kretshändelser</h5>
                <button class="btn btn-primary" onclick="showCreateRegionEventModal()">
                    <i class="bi bi-plus-circle me-2"></i>Ny Händelse
                </button>
            </div>
            <div id="regionEventsTableContainer">
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Laddar händelser...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Competitions Sub-Tab -->
        <div class="tab-pane fade" id="regionAdminCompetitionsTab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Kretstävlingar</h5>
                <button class="btn btn-primary" onclick="showCreateRegionCompetitionModal()">
                    <i class="bi bi-plus-circle me-2"></i>Ny Tävling
                </button>
            </div>

            <!-- Filter Section -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label for="regionCompYearFilter" class="form-label">År</label>
                            <select class="form-select" id="regionCompYearFilter" onchange="onRegionCompYearFilterChange()">
                                <!-- Populated by JavaScript -->
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="regionCompTypeFilter" class="form-label">Tävlingstyp</label>
                            <select class="form-select" id="regionCompTypeFilter" onchange="onRegionCompTypeFilterChange()">
                                <option value="">Alla typer</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="regionCompShowCompleted" onchange="onRegionCompShowCompletedChange()">
                                <label class="form-check-label" for="regionCompShowCompleted">
                                    Visa avslutade tävlingar
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-outline-secondary w-100" onclick="clearRegionCompFilters()">
                                <i class="bi bi-x-circle me-1"></i>Rensa filter
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="regionAdminCompetitionsTableContainer">
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Laddar tävlingar...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Settings Sub-Tab -->
        <div class="tab-pane fade" id="regionSettingsTab">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi bi-gear me-2"></i>Kretsinställningar
                    </h5>
                    <form id="regionSettingsForm">
                        <!-- Texts Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-card-text me-2"></i>Texter
                        </h6>
                        <div class="mb-3">
                            <label class="form-label">Välkomsttitel</label>
                            <input type="text" class="form-control" id="regionWelcomeTitle" name="welcomeTitle" placeholder="T.ex. Välkommen till @regionName">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Välkomsttext</label>
                            <textarea class="form-control" id="regionWelcomeText" name="welcomeText" rows="4" placeholder="Kort välkomsttext som visas i bannern"></textarea>
                            <small class="text-muted">Visas i hero-bannern på kretssidan. Stöder grundläggande HTML-formatering.</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Om kretsen</label>
                            <textarea class="form-control" id="regionAboutRegion" name="aboutRegion" rows="6" placeholder="Utförlig information om kretsen"></textarea>
                            <small class="text-muted">Visas under "Om @regionName" på kretssidan. Stöder grundläggande HTML-formatering.</small>
                        </div>

                        <hr class="my-4">

                        <!-- Contact Information Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-person-lines-fill me-2"></i>Kontaktinformation
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kontaktperson</label>
                                <input type="text" class="form-control" id="regionContactPerson" name="contactPerson" placeholder="Namn på kontaktperson">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kontakt E-post</label>
                                <input type="email" class="form-control" id="regionContactEmail" name="contactEmail" placeholder="kontakt@krets.se">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kontakt Telefon</label>
                                <input type="tel" class="form-control" id="regionContactPhone" name="contactPhone" placeholder="+46 70 123 45 67">
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Organisation & Address Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-geo-alt-fill me-2"></i>Organisation &amp; adress
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Organisationsnummer</label>
                                <input type="text" class="form-control" id="regionOrgNumber" name="orgNumber" placeholder="802345-6789">
                                <small class="text-muted">Visas på kvitton (t.ex. för friskvårdsbidrag)</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Gatuadress</label>
                                <input type="text" class="form-control" id="regionAddress" name="address" placeholder="Gatugatan 123">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Postnummer</label>
                                <input type="text" class="form-control" id="regionPostalCode" name="postalCode" placeholder="123 45">
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Ort</label>
                                <input type="text" class="form-control" id="regionCity" name="city" placeholder="Stockholm">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">E-post på kvitto</label>
                                <input type="email" class="form-control" id="regionReceiptEmail" name="receiptEmail" placeholder="kvitto@krets.se">
                                <small class="text-muted">Visas på kvitton. Lämna tom för att använda kontakt-e-posten.</small>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Brevo Email Integration -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-envelope me-2"></i>E-postutskick (Brevo)
                            <button type="button" class="btn btn-sm btn-outline-info ms-2" onclick="showBrevoSetupGuide()">
                                <i class="bi bi-question-circle me-1"></i>Hjälp med Brevo
                            </button>
                        </h6>
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Brevo API-nyckel <small class="text-muted">(valfritt)</small></label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="regionBrevoApiKey" name="brevoApiKey" placeholder="xkeysib-..." autocomplete="off">
                                    <button class="btn btn-outline-secondary" type="button" onclick="toggleRegionBrevoKeyVisibility()">
                                        <i class="bi bi-eye" id="regionBrevoKeyToggleIcon"></i>
                                    </button>
                                    <button class="btn btn-outline-success" type="button" onclick="testRegionBrevoApiKey()">
                                        <i class="bi bi-check-circle me-1"></i>Testa
                                    </button>
                                </div>
                                <small class="text-muted">Aktiverar "Skicka via Brevo" i e-postmodalen.</small>
                                <div id="regionBrevoKeyTestResult" class="mt-1 d-none"></div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Images Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-image me-2"></i>Bilder
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Logotyp</label>
                                <div id="regionLogoPreview" class="mb-2" style="display: none;">
                                    <img id="regionLogoImg" src="" alt="Logo" class="img-thumbnail" style="max-height: 100px; max-width: 200px;">
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="removeRegionImage('logo')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <input type="file" class="form-control" id="regionLogoFile" accept="image/jpeg,image/png,image/gif,image/webp" onchange="uploadRegionImage('logo', this)">
                                <small class="text-muted">JPG, PNG, GIF eller WebP. Max 5 MB.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Bannerbild</label>
                                <div id="regionBannerPreview" class="mb-2" style="display: none;">
                                    <img id="regionBannerImg" src="" alt="Banner" class="img-thumbnail" style="max-height: 100px; max-width: 300px;">
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="removeRegionImage('bannerImage')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <input type="file" class="form-control" id="regionBannerFile" accept="image/jpeg,image/png,image/gif,image/webp" onchange="uploadRegionImage('bannerImage', this)">
                                <small class="text-muted">JPG, PNG, GIF eller WebP. Max 5 MB. Rekommenderad storlek: 1200x300 px.</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-save me-2"></i>Spara Inställningar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Board Roles Admin Sub-Tab -->
        <div class="tab-pane fade" id="regionBoardAdminTab">
            @{
                ViewBag.BoardOwnerType = 1;
                ViewBag.BoardOwnerId = regionContentId;
            }
            @await Html.PartialAsync("BoardRolesManagement")
        </div>

        <!-- Board Meetings Sub-Tab -->
        <div class="tab-pane fade" id="regionMeetingsTab">
            @{
                ViewBag.BoardOwnerType = 1;
                ViewBag.BoardOwnerId = regionContentId;
            }
            @await Html.PartialAsync("BoardMeetingsManagement")
        </div>

        <!-- Certifieringar Sub-Tab -->
        <div class="tab-pane fade" id="regionCertificationsTab">
            @{
                var regCertVD = new ViewDataDictionary(ViewData);
                regCertVD["CertScopeType"] = "Region";
                regCertVD["CertScopeId"] = ViewBag.regionCode as string ?? "";
            }
            @await Html.PartialAsync("CertificationManagementPanel", null, regCertVD)
        </div>

        <!-- Mästare Sub-Tab -->
        <div class="tab-pane fade" id="regionChampionsTab">
            @{
                var regChampAdminVD = new ViewDataDictionary(ViewData);
                regChampAdminVD["ChampionsScopeType"] = "Region";
                regChampAdminVD["ChampionsScopeId"] = ViewBag.regionCode as string ?? "";
                regChampAdminVD["ChampionsScopeName"] = ViewBag.regionName as string ?? "";
                regChampAdminVD["ChampionsCanEdit"] = true;
                regChampAdminVD["ChampionsShowAllYears"] = true;
            }
            @await Html.PartialAsync("ReigningChampionsPanel", null, regChampAdminVD)
        </div>

        <!-- Statistik Sub-Tab -->
        <div class="tab-pane fade" id="regionStatsTab">
            @await Html.PartialAsync("RegionalStatistics")
        </div>
    </div>
</div>

<!-- Region Email Modal -->
@{
    ViewBag.regionContentId = regionContentId;
}
@await Html.PartialAsync("RegionEmailModal")
@await Html.PartialAsync("BrevoSetupGuide")

<script>
(function() {
    var regionContentId = @regionContentId;
    var welcomeTextEditor = null;
    var aboutRegionEditor = null;
    var allRegionEvents = [];

    var eventTypeColors = {
        'Tävling': '#0d6efd',
        'Träning': '#198754',
        'Städning': '#d63384',
        'Möte': '#fd7e14',
        'Socialt': '#0dcaf0',
        'Nyhet': '#6610f2',
        'Annat': '#6c757d',
        'default': '#6c757d'
    };

    function getAntiForgeryToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    // Initialize Flatpickr for region event date
    flatpickr('#regionEventDate', {
        locale: 'sv',
        enableTime: true,
        time_24hr: true,
        dateFormat: 'Y-m-d H:i'
    });

    // Load region events when events tab is shown
    document.getElementById('regionEvents-tab').addEventListener('shown.bs.tab', function () {
        loadRegionEvents();
    });

    function loadRegionEvents() {
        fetch('/umbraco/surface/Club/GetRegionEvents?regionId=' + regionContentId)
            .then(function(response) { return response.json(); })
            .then(function(data) {
                if (data.success) {
                    displayRegionEvents(data.data);
                } else {
                    document.getElementById('regionEventsTableContainer').innerHTML =
                        '<div class="alert alert-warning">Inga händelser hittades.</div>';
                }
            })
            .catch(function(error) {
                console.error('Error loading events:', error);
                document.getElementById('regionEventsTableContainer').innerHTML =
                    '<div class="alert alert-danger">Fel vid laddning av händelser.</div>';
            });
    }

    function displayRegionEvents(events) {
        var container = document.getElementById('regionEventsTableContainer');
        allRegionEvents = events || [];

        if (!events || events.length === 0) {
            container.innerHTML = '<div class="alert alert-info">Inga händelser har skapats ännu.</div>';
            return;
        }

        var html = '<div class="table-responsive"><table class="table table-striped">';
        html += '<thead><tr><th>Namn</th><th>Typ</th><th>Datum</th><th>Plats</th><th>Åtgärder</th></tr></thead><tbody>';

        events.forEach(function(event) {
            var dateObj = event.date ? new Date(event.date) : null;
            var date = (dateObj && dateObj.getFullYear() > 1900) ? dateObj.toLocaleString('sv-SE') : '-';
            var color = eventTypeColors[event.type] || eventTypeColors['default'];
            html += '<tr>'
                + '<td><strong>' + event.name + '</strong></td>'
                + '<td><span class="badge" style="background-color: ' + color + '">' + event.type + '</span></td>'
                + '<td>' + date + '</td>'
                + '<td>' + (event.venue || '-') + '</td>'
                + '<td>'
                + '<button class="btn btn-sm btn-outline-primary me-1" onclick="editRegionEvent(' + event.id + ')"><i class="bi bi-pencil"></i></button>'
                + '<button class="btn btn-sm btn-outline-danger" onclick="deleteRegionEvent(' + event.id + ', \'' + event.name.replace(/'/g, "\\'") + '\')"><i class="bi bi-trash"></i></button>'
                + '</td></tr>';
        });

        html += '</tbody></table></div>';
        container.innerHTML = html;
    }

    function slugify(text) {
        return text.toLowerCase()
            .replace(/å/g, 'a').replace(/ä/g, 'a').replace(/ö/g, 'o')
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/\s+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-|-$/g, '');
    }

    window.updateRegionEventUrlPreview = function() {
        var pageNameInput = document.getElementById('regionEventPageName');
        var nameInput = document.getElementById('regionEventName');
        var preview = document.getElementById('regionEventUrlPreview');
        var source = (pageNameInput.value || nameInput.value || '').trim();
        var slug = slugify(source) || '...';
        preview.textContent = '/' + slug;
    };

    window.toggleRegionEventPageName = function(e) {
        if (e) e.preventDefault();
        var group = document.getElementById('regionEventPageNameGroup');
        var toggle = document.getElementById('regionEventPageNameToggle');
        if (group.style.display === 'none') {
            group.style.display = '';
            toggle.textContent = 'Dölj sidnamn';
        } else {
            group.style.display = 'none';
            document.getElementById('regionEventPageName').value = '';
            updateRegionEventUrlPreview();
            toggle.textContent = 'Ändra sidnamn';
        }
    };

    window.showCreateRegionEventModal = function() {
        document.getElementById('regionEventModalTitle').textContent = 'Ny Händelse';
        document.getElementById('regionEventForm').reset();
        document.getElementById('regionEventId').value = '';
        document.getElementById('regionEventCustomType').style.display = 'none';
        document.getElementById('regionEventCustomType').required = false;
        document.getElementById('regionEventCustomType').value = '';
        document.getElementById('regionEventPageNameGroup').style.display = 'none';
        document.getElementById('regionEventPageNameToggle').textContent = 'Ändra sidnamn';
        syncRegionEventTypeValue();
        toggleRegionEventDateRequired();
        updateRegionEventUrlPreview();
        new bootstrap.Modal(document.getElementById('regionEventModal')).show();
    };

    window.editRegionEvent = function(eventId) {
        var event = allRegionEvents.find(function(e) { return e.id === eventId; });
        if (!event) {
            alert('Händelse hittades inte');
            return;
        }

        document.getElementById('regionEventModalTitle').textContent = 'Redigera Händelse';
        document.getElementById('regionEventId').value = event.id;
        document.getElementById('regionEventName').value = event.name || '';

        // Set event type — if not a known type, select "Annat" and populate custom field
        var typeVal = event.type || 'Träning';
        if (knownRegionEventTypes.indexOf(typeVal) >= 0) {
            document.getElementById('regionEventType').value = typeVal;
            document.getElementById('regionEventCustomType').style.display = 'none';
            document.getElementById('regionEventCustomType').required = false;
            document.getElementById('regionEventCustomType').value = '';
        } else {
            document.getElementById('regionEventType').value = 'Annat';
            document.getElementById('regionEventCustomType').style.display = '';
            document.getElementById('regionEventCustomType').required = true;
            document.getElementById('regionEventCustomType').value = typeVal;
        }
        syncRegionEventTypeValue();
        toggleRegionEventDateRequired();
        document.getElementById('regionEventDescription').value = event.description || '';
        document.getElementById('regionEventVenue').value = event.venue || '';
        document.getElementById('regionEventContactPerson').value = event.contactPerson || '';
        document.getElementById('regionEventContactEmail').value = event.contactEmail || '';
        document.getElementById('regionEventContactPhone').value = event.contactPhone || '';

        // Page name (URL slug)
        if (event.pageName) {
            document.getElementById('regionEventPageName').value = event.pageName;
            document.getElementById('regionEventPageNameGroup').style.display = '';
            document.getElementById('regionEventPageNameToggle').textContent = 'Dölj sidnamn';
        } else {
            document.getElementById('regionEventPageName').value = '';
            document.getElementById('regionEventPageNameGroup').style.display = 'none';
            document.getElementById('regionEventPageNameToggle').textContent = 'Ändra sidnamn';
        }
        updateRegionEventUrlPreview();

        if (event.date) {
            var eventDate = new Date(event.date);
            if (eventDate.getFullYear() > 1900) {
                var fp = document.getElementById('regionEventDate')._flatpickr;
                if (fp) {
                    fp.setDate(eventDate);
                }
            }
        }

        new bootstrap.Modal(document.getElementById('regionEventModal')).show();
    };

    window.saveRegionEvent = function() {
        syncRegionEventTypeValue();
        var resolvedType = document.getElementById('regionEventTypeValue').value;
        if (!resolvedType || !resolvedType.trim()) {
            document.getElementById('regionEventCustomType').focus();
            alert('Ange en händelsetyp.');
            return;
        }
        var form = document.getElementById('regionEventForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        var saveBtn = document.querySelector('#regionEventModal .modal-footer .btn-primary');
        if (!saveBtn) return;
        var originalBtnText = saveBtn.innerHTML;
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sparar...';

        var formData = new FormData(form);
        var eventId = formData.get('eventId');
        var url = eventId
            ? '/umbraco/surface/Club/EditRegionEvent'
            : '/umbraco/surface/Club/CreateRegionEvent';

        formData.append('regionId', regionContentId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        fetch(url, {
            method: 'POST',
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('regionEventModal')).hide();
                loadRegionEvents();
                alert('Händelse sparad!');
            } else {
                alert('Fel: ' + data.message);
            }
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalBtnText;
        })
        .catch(function(error) {
            console.error('Error saving event:', error);
            alert('Fel vid sparande av händelse.');
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalBtnText;
        });
    };

    window.deleteRegionEvent = function(eventId, eventName) {
        if (!confirm('Är du säker på att du vill ta bort händelsen "' + eventName + '"?')) return;

        var formData = new FormData();
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        fetch('/umbraco/surface/Club/DeleteRegionEvent?eventId=' + eventId, {
            method: 'POST',
            body: formData
        })
        .then(function(response) { return response.json(); })
        .then(function(data) {
            if (data.success) {
                loadRegionEvents();
                alert('Händelse raderad!');
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(function(error) {
            console.error('Error deleting event:', error);
            alert('Fel vid radering av händelse.');
        });
    };

    var knownRegionEventTypes = ['Träning', 'Städning', 'Möte', 'Socialt', 'Nyhet'];

    window.onRegionEventTypeChange = function() {
        var select = document.getElementById('regionEventType');
        var customInput = document.getElementById('regionEventCustomType');
        if (select.value === 'Annat') {
            customInput.style.display = '';
            customInput.required = true;
            customInput.focus();
        } else {
            customInput.style.display = 'none';
            customInput.required = false;
            customInput.value = '';
            document.getElementById('regionCompetitionTypeWarning').style.display = 'none';
        }
        syncRegionEventTypeValue();
        toggleRegionEventDateRequired();
    };

    window.syncRegionEventTypeValue = function() {
        var select = document.getElementById('regionEventType');
        var customInput = document.getElementById('regionEventCustomType');
        var hidden = document.getElementById('regionEventTypeValue');
        hidden.value = select.value === 'Annat' ? customInput.value : select.value;
    };

    window.checkRegionCompetitionTypeWarning = function() {
        var customInput = document.getElementById('regionEventCustomType');
        var warning = document.getElementById('regionCompetitionTypeWarning');
        var val = customInput.value.toLowerCase();
        warning.style.display = val.indexOf('tävling') >= 0 ? '' : 'none';
    };

    window.toggleRegionEventDateRequired = function() {
        var resolvedType = document.getElementById('regionEventTypeValue').value || document.getElementById('regionEventType').value;
        var isNyhet = resolvedType === 'Nyhet';
        var dateInput = document.getElementById('regionEventDate');
        var dateLabel = document.getElementById('regionEventDateLabel');
        var dateHint = document.getElementById('regionEventDateHint');
        dateInput.required = !isNyhet;
        dateLabel.textContent = isNyhet ? 'Datum (valfritt)' : 'Datum *';
        dateHint.style.display = isNyhet ? '' : 'none';
    };

    // Load region info when settings tab is shown
    document.getElementById('regionSettings-tab').addEventListener('shown.bs.tab', function () {
        loadRegionInfo();

        // Initialize CKEditor for welcomeText
        if (!welcomeTextEditor) {
            ClassicEditor
                .create(document.querySelector('#regionWelcomeText'), {
                    toolbar: ['bold', 'italic', 'link', '|', 'undo', 'redo']
                })
                .then(function(editor) {
                    welcomeTextEditor = editor;
                })
                .catch(function(error) {
                    console.error('Error initializing CKEditor for welcomeText:', error);
                });
        }

        // Initialize CKEditor for aboutRegion
        if (!aboutRegionEditor) {
            ClassicEditor
                .create(document.querySelector('#regionAboutRegion'), {
                    toolbar: ['heading', '|', 'bold', 'italic', 'link', 'bulletedList', 'numberedList', '|', 'blockQuote', 'undo', 'redo']
                })
                .then(function(editor) {
                    aboutRegionEditor = editor;
                })
                .catch(function(error) {
                    console.error('Error initializing CKEditor for aboutRegion:', error);
                });
        }
    });

    // Brevo API key toggle/test for regional settings
    window.toggleRegionBrevoKeyVisibility = function() {
        var input = document.getElementById('regionBrevoApiKey');
        var icon = document.getElementById('regionBrevoKeyToggleIcon');
        if (input.type === 'password') { input.type = 'text'; icon.className = 'bi bi-eye-slash'; }
        else { input.type = 'password'; icon.className = 'bi bi-eye'; }
    };

    window.testRegionBrevoApiKey = function() {
        var apiKey = document.getElementById('regionBrevoApiKey').value.trim();
        var resultEl = document.getElementById('regionBrevoKeyTestResult');
        if (!apiKey) {
            resultEl.className = 'mt-1 alert alert-warning py-1 small';
            resultEl.textContent = 'Ange en API-nyckel först';
            resultEl.classList.remove('d-none');
            return;
        }
        resultEl.className = 'mt-1 text-muted small';
        resultEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Testar...';
        resultEl.classList.remove('d-none');

        fetch('/umbraco/surface/ClubEmail/TestBrevoApiKey', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getAntiForgeryToken() },
            body: 'apiKey=' + encodeURIComponent(apiKey)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            resultEl.className = data.success ? 'mt-1 alert alert-success py-1 small' : 'mt-1 alert alert-danger py-1 small';
            resultEl.textContent = data.message;
        })
        .catch(function() {
            resultEl.className = 'mt-1 alert alert-danger py-1 small';
            resultEl.textContent = 'Nätverksfel vid test';
        });
    };

    function loadRegionInfo() {
        fetch('/umbraco/surface/Club/GetRegionInfo?contentId=' + regionContentId)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success && data.data) {
                    document.getElementById('regionWelcomeTitle').value = data.data.welcomeTitle || '';
                    document.getElementById('regionContactPerson').value = data.data.contactPerson || '';
                    document.getElementById('regionContactEmail').value = data.data.contactEmail || '';
                    document.getElementById('regionContactPhone').value = data.data.contactPhone || '';
                    document.getElementById('regionOrgNumber').value = data.data.orgNumber || '';
                    document.getElementById('regionAddress').value = data.data.address || '';
                    document.getElementById('regionPostalCode').value = data.data.postalCode || '';
                    document.getElementById('regionCity').value = data.data.city || '';
                    document.getElementById('regionReceiptEmail').value = data.data.receiptEmail || '';

                    // Brevo API key
                    var brevoField = document.getElementById('regionBrevoApiKey');
                    if (brevoField) brevoField.value = data.data.brevoApiKey || '';

                    // Set CKEditor content or textarea fallback
                    var welcomeTextContent = data.data.welcomeText || '';
                    if (welcomeTextEditor) {
                        welcomeTextEditor.setData(welcomeTextContent);
                    } else {
                        document.getElementById('regionWelcomeText').value = welcomeTextContent;
                    }

                    var aboutRegionContent = data.data.aboutRegion || '';
                    if (aboutRegionEditor) {
                        aboutRegionEditor.setData(aboutRegionContent);
                    } else {
                        document.getElementById('regionAboutRegion').value = aboutRegionContent;
                    }

                    // Logo preview
                    if (data.data.logoUrl) {
                        document.getElementById('regionLogoImg').src = data.data.logoUrl;
                        document.getElementById('regionLogoPreview').style.display = '';
                    } else {
                        document.getElementById('regionLogoPreview').style.display = 'none';
                    }

                    // Banner preview
                    if (data.data.bannerImageUrl) {
                        document.getElementById('regionBannerImg').src = data.data.bannerImageUrl;
                        document.getElementById('regionBannerPreview').style.display = '';
                    } else {
                        document.getElementById('regionBannerPreview').style.display = 'none';
                    }
                }
            })
            .catch(function(err) {
                console.error('Error loading region info:', err);
            });
    }

    // Save region settings
    document.getElementById('regionSettingsForm').addEventListener('submit', function(e) {
        e.preventDefault();

        // Sync CKEditor content
        if (welcomeTextEditor) {
            document.getElementById('regionWelcomeText').value = welcomeTextEditor.getData();
        }
        if (aboutRegionEditor) {
            document.getElementById('regionAboutRegion').value = aboutRegionEditor.getData();
        }

        var formData = new FormData(this);
        formData.append('contentId', regionContentId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        var saveBtn = this.querySelector('button[type="submit"]');
        var originalText = saveBtn.innerHTML;
        saveBtn.disabled = true;
        saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sparar...';

        fetch('/umbraco/surface/Club/UpdateRegionInfo', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                alert('Inställningar sparade!');
            } else {
                alert('Fel: ' + data.message);
            }
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalText;
        })
        .catch(function(err) {
            console.error('Error saving region settings:', err);
            alert('Fel vid sparande av inställningar.');
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalText;
        });
    });

    // Upload region image
    window.uploadRegionImage = function(imageType, input) {
        if (!input.files || !input.files[0]) return;

        var file = input.files[0];

        // Validate file size (5 MB max)
        if (file.size > 5 * 1024 * 1024) {
            alert('Filen är för stor. Max 5 MB tillåtet.');
            input.value = '';
            return;
        }

        var formData = new FormData();
        formData.append('contentId', regionContentId);
        formData.append('imageType', imageType);
        formData.append('imageFile', file);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        // Show loading
        var previewId = imageType === 'logo' ? 'regionLogoPreview' : 'regionBannerPreview';
        var imgId = imageType === 'logo' ? 'regionLogoImg' : 'regionBannerImg';

        fetch('/umbraco/surface/Club/UploadRegionImage', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                document.getElementById(imgId).src = data.imageUrl;
                document.getElementById(previewId).style.display = '';
                alert('Bild uppladdad!');
            } else {
                alert('Fel: ' + data.message);
            }
            input.value = '';
        })
        .catch(function(err) {
            console.error('Error uploading image:', err);
            alert('Fel vid uppladdning av bild.');
            input.value = '';
        });
    };

    // Remove region image (clear the property)
    window.removeRegionImage = function(imageType) {
        if (!confirm('Är du säker på att du vill ta bort denna bild?')) return;

        var formData = new FormData();
        formData.append('contentId', regionContentId);
        formData.append('imageType', imageType);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        fetch('/umbraco/surface/Club/RemoveRegionImage', {
            method: 'POST',
            body: formData
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                var previewId = imageType === 'logo' ? 'regionLogoPreview' : 'regionBannerPreview';
                document.getElementById(previewId).style.display = 'none';
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(function(err) {
            console.error('Error removing image:', err);
            alert('Fel vid borttagning av bild.');
        });
    };
})();
</script>

@* ============================================================
   Tävlingar sub-tab — admin of competitions in the region.
   Reuses CompetitionWizardModal / CompetitionEditModal / CompetitionAdvertEditModal
   (rendered on RegionalPage.cshtml). Endpoints honour regional admin auth.
   ============================================================ *@
<script>
(function() {
    var _rcTabBtn = document.getElementById('regionAdminCompetitions-tab');
    var regionCode = (_rcTabBtn && _rcTabBtn.getAttribute('data-region-code')) || '';

    function rcGetAntiForgeryToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    function rcEscapeHtml(text) {
        if (!text) return '';
        var d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
    }

    var regionCompFilters = {
        year: new Date().getFullYear(),
        includeCompleted: false,
        type: ''
    };
    var regionCompTypesCache = [];
    var regionCompLoaded = false;

    function populateRegionCompYearFilter() {
        var sel = document.getElementById('regionCompYearFilter');
        if (!sel) return;
        var currentYear = new Date().getFullYear();
        if (sel.options.length > 0) return;
        sel.innerHTML = '';
        for (var y = currentYear + 1; y >= 2024; y--) {
            var opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            if (y === regionCompFilters.year) opt.selected = true;
            sel.appendChild(opt);
        }
    }

    window.onRegionCompYearFilterChange = function() {
        var v = document.getElementById('regionCompYearFilter').value;
        regionCompFilters.year = v ? parseInt(v) : null;
        loadRegionCompetitions();
    };
    window.onRegionCompTypeFilterChange = function() {
        regionCompFilters.type = document.getElementById('regionCompTypeFilter').value;
        loadRegionCompetitions();
    };
    window.onRegionCompShowCompletedChange = function() {
        regionCompFilters.includeCompleted = document.getElementById('regionCompShowCompleted').checked;
        loadRegionCompetitions();
    };
    window.clearRegionCompFilters = function() {
        regionCompFilters = { year: new Date().getFullYear(), includeCompleted: false, type: '' };
        document.getElementById('regionCompYearFilter').value = regionCompFilters.year;
        document.getElementById('regionCompTypeFilter').value = '';
        document.getElementById('regionCompShowCompleted').checked = false;
        loadRegionCompetitions();
    };

    function populateRegionCompTypeFilter(comps) {
        var typeSet = new Set();
        comps.forEach(function(c) { if (c.type) typeSet.add(c.type); });
        var types = Array.from(typeSet).sort();
        regionCompTypesCache = types;
        var sel = document.getElementById('regionCompTypeFilter');
        var current = regionCompFilters.type || '';
        sel.innerHTML = '<option value="">Alla typer</option>';
        types.forEach(function(t) {
            var opt = document.createElement('option');
            opt.value = t;
            opt.textContent = t;
            if (t === current) opt.selected = true;
            sel.appendChild(opt);
        });
    }

    function getRegionCompetitionStatusBadge(status) {
        var badges = {
            'Draft': '<span class="badge bg-secondary">Utkast</span>',
            'Scheduled': '<span class="badge bg-info">Schemalagd</span>',
            'Active': '<span class="badge bg-success">Aktiv</span>',
            'Completed': '<span class="badge bg-dark">Avslutad</span>'
        };
        return badges[status] || '<span class="badge bg-secondary">-</span>';
    }

    function loadRegionCompetitions() {
        var container = document.getElementById('regionAdminCompetitionsTableContainer');
        container.innerHTML = '<div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar tävlingar...</span></div></div>';

        populateRegionCompYearFilter();

        var params = [];
        if (regionCompFilters.year) params.push('year=' + regionCompFilters.year);
        params.push('includeCompleted=' + regionCompFilters.includeCompleted);
        if (regionCompFilters.type) params.push('type=' + encodeURIComponent(regionCompFilters.type));
        if (regionCode) params.push('region=' + encodeURIComponent(regionCode));
        var url = '/umbraco/surface/CompetitionAdmin/GetCompetitionsList?' + params.join('&');

        fetch(url)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.success) {
                    container.innerHTML = '<div class="alert alert-warning">Kunde inte ladda tävlingar.</div>';
                    return;
                }
                // Hide isClubOnly comps — these are private to a specific club's
                // members; managed by that club's admin, not at the regional level.
                var comps = (data.data || []).filter(function(c) { return !c.isClubOnly; });
                if (!regionCompFilters.type && regionCompTypesCache.length === 0) {
                    populateRegionCompTypeFilter(comps);
                }
                displayRegionCompetitions(comps);
            })
            .catch(function(err) {
                console.error('Error loading region competitions:', err);
                container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av tävlingar.</div>';
            });
    }

    function displayRegionCompetitions(competitions) {
        var container = document.getElementById('regionAdminCompetitionsTableContainer');
        if (!competitions || competitions.length === 0) {
            container.innerHTML = '<div class="alert alert-info">Inga tävlingar i kretsen för valda filter.</div>';
            return;
        }

        var html = '<div class="table-responsive"><table class="table table-striped">';
        html += '<thead><tr><th>Namn</th><th>Typ</th><th>Startdatum</th><th>Status</th><th>Anmälningar</th><th class="text-end">Åtgärder</th></tr></thead><tbody>';

        competitions.forEach(function(comp) {
            var startDate = comp.startDate ? new Date(comp.startDate).toLocaleDateString('sv-SE') : '-';
            var statusBadge = getRegionCompetitionStatusBadge(comp.status);
            var nameEsc = rcEscapeHtml(comp.name);
            var typeEsc = rcEscapeHtml(comp.type);
            var externalBadge = comp.isExternal
                ? '<span class="badge bg-info ms-2"><i class="bi bi-box-arrow-up-right me-1"></i>Extern</span>'
                : '';
            // Host badge: club-hosted (invitation) vs krets-hosted vs national.
            var scopeBadge;
            if (comp.clubId && comp.clubId > 0) {
                scopeBadge = '<span class="badge bg-primary ms-2"><i class="bi bi-building me-1"></i>Klubb</span>';
            } else if (comp.regionalFederation) {
                scopeBadge = '<span class="badge bg-info text-dark ms-2"><i class="bi bi-diagram-3 me-1"></i>Krets</span>';
            } else {
                scopeBadge = '<span class="badge bg-dark ms-2"><i class="bi bi-globe me-1"></i>Nationell</span>';
            }
            var uploadBtns = '';
            if (comp.isExternal) {
                uploadBtns =
                    '<button class="btn btn-sm btn-outline-success" onclick="openUploadInvitationModal(' + comp.id + ', \'' + nameEsc.replace(/'/g, "\\'") + '\')" title="Ladda upp inbjudan"><i class="bi bi-file-earmark-arrow-up"></i></button>' +
                    ' <button class="btn btn-sm btn-outline-warning" onclick="openUploadResultListModal(' + comp.id + ', \'' + nameEsc.replace(/'/g, "\\'") + '\')" title="Ladda upp resultatlista"><i class="bi bi-file-earmark-bar-graph"></i></button>';
            }

            html +=
                '<tr>' +
                  '<td><strong>' + nameEsc + '</strong>' + externalBadge + scopeBadge + '</td>' +
                  '<td><span class="badge bg-secondary">' + typeEsc + '</span></td>' +
                  '<td>' + startDate + '</td>' +
                  '<td>' + statusBadge + '</td>' +
                  '<td><span class="badge bg-info">' + (comp.registrationCount || 0) + '</span></td>' +
                  '<td class="text-end">' +
                    '<a href="/competitions/' + comp.id + '/" class="btn btn-sm btn-outline-secondary" title="Öppna" target="_blank"><i class="bi bi-eye"></i></a> ' +
                    '<button class="btn btn-sm btn-outline-primary" onclick="editRegionCompetition(' + comp.id + ', ' + (comp.isExternal ? 'true' : 'false') + ', \'' + typeEsc.replace(/'/g, "\\'") + '\')" title="Redigera"><i class="bi bi-pencil"></i></button> ' +
                    '<button class="btn btn-sm btn-outline-info" onclick="copyRegionCompetition(' + comp.id + ')" title="Kopiera"><i class="bi bi-files"></i></button> ' +
                    '<a href="/competitionmanagement?competitionId=' + comp.id + '" class="btn btn-sm btn-outline-info" title="Hantera tävling"><i class="bi bi-gear"></i></a> ' +
                    uploadBtns + ' ' +
                    '<button class="btn btn-sm btn-outline-danger" onclick="deleteRegionCompetition(' + comp.id + ', \'' + nameEsc.replace(/'/g, "\\'") + '\')" title="Radera"><i class="bi bi-trash"></i></button>' +
                  '</td>' +
                '</tr>';
        });

        html += '</tbody></table></div>';
        container.innerHTML = html;
    }

    // Expose loadCompetitionsList globally so the wizard / edit modal callbacks refresh the list
    window.loadCompetitionsList = window.loadCompetitionsList || function() { loadRegionCompetitions(); };

    window.showCreateRegionCompetitionModal = function() {
        var modalElement = document.getElementById('competitionWizardModal');
        if (!modalElement) {
            alert('Tävlingsguide kunde inte hittas. Kontakta administratören.');
            return;
        }
        var modal = window.competitionWizardModalInstance || new bootstrap.Modal(modalElement);
        window.competitionWizardModalInstance = modal;
        modal.show();
        if (typeof window.resetWizard === 'function') {
            window.resetWizard();
        }
        window.onCompetitionSaved = function() { loadRegionCompetitions(); };
    };

    window.editRegionCompetition = function(competitionId, isExternal, competitionType) {
        if (typeof window.openAdminEditModal === 'function') {
            window.openAdminEditModal(competitionId, isExternal, competitionType);
            window.onCompetitionSaved = function() { loadRegionCompetitions(); };
        } else {
            alert('Redigeringsfunktion kunde inte hittas. Kontakta administratören.');
        }
    };

    window.copyRegionCompetition = function(competitionId) {
        if (!confirm('Kopiera tävlingen? Datum flyttas fram ett år.')) return;
        var token = rcGetAntiForgeryToken();
        fetch('/umbraco/surface/CompetitionAdmin/CopyCompetition', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ sourceCompetitionId: competitionId })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                alert('✅ Tävlingen har kopierats! Datum har flyttats fram ett år.');
                loadRegionCompetitions();
            } else {
                alert('❌ Kunde inte kopiera: ' + (data.message || 'Okänt fel'));
            }
        })
        .catch(function(err) {
            console.error('Error copying competition:', err);
            alert('❌ Fel vid kopiering av tävling');
        });
    };

    window.deleteRegionCompetition = function(competitionId, competitionName) {
        if (typeof window.showDeleteConfirmation === 'function') {
            window.showDeleteConfirmation(competitionName, function() {
                doDeleteRegionCompetition(competitionId);
            });
        } else if (confirm('Radera tävlingen "' + competitionName + '"?')) {
            doDeleteRegionCompetition(competitionId);
        }
    };

    function doDeleteRegionCompetition(competitionId) {
        var token = rcGetAntiForgeryToken();
        fetch('/umbraco/surface/CompetitionAdmin/DeleteCompetition', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            credentials: 'include',
            body: JSON.stringify({ competitionId: competitionId })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                loadRegionCompetitions();
                alert('Tävling raderad!');
            } else {
                alert('Fel: ' + (data.message || 'Kunde inte radera tävlingen'));
            }
        })
        .catch(function(err) {
            console.error('Error deleting competition:', err);
            alert('Fel vid radering.');
        });
    }

    function ensureRegionCompetitionsLoaded() {
        if (!regionCompLoaded) {
            regionCompLoaded = true;
            loadRegionCompetitions();
        }
    }

    var compTabBtn = document.getElementById('regionAdminCompetitions-tab');
    if (compTabBtn) {
        // Bind to click rather than shown.bs.tab — the Bootstrap transition event
        // doesn't reliably reach addEventListener here (the symmetric Events tab
        // works fine with shown.bs.tab, but this one didn't in prod).
        compTabBtn.addEventListener('click', ensureRegionCompetitionsLoaded);

        // If the sub-tab is already active when the partial loads (URL hash etc.),
        // trigger immediately.
        if (compTabBtn.classList.contains('active')) {
            ensureRegionCompetitionsLoaded();
        }
    }
})();
</script>

