@* ============================================================
   Tävlingar sub-tab — admin of competitions in the region.
   Reuses CompetitionWizardModal / CompetitionEditModal / CompetitionAdvertEditModal
   (rendered on RegionalPage.cshtml). Endpoints honour regional admin auth.
   ============================================================ *@
<script>
(function() {
    var _rcTabBtn = document.getElementById('regionAdminCompetitions-tab');
    var regionCode = (_rcTabBtn && _rcTabBtn.getAttribute('data-region-code')) || '';

    function rcGetAntiForgeryToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }

    function rcEscapeHtml(text) {
        if (!text) return '';
        var d = document.createElement('div');
        d.textContent = text;
        return d.innerHTML;
    }

    var regionCompFilters = {
        year: new Date().getFullYear(),
        includeCompleted: false,
        type: '',
        // Klubbinterna are hidden by default (they belong to the club's own admin page), but the
        // krets can now choose to see them - or to hide club-hosted competitions entirely.
        clubScope: 'noInternal'
    };
    var regionCompTypesCache = [];
    var regionCompLoaded = false;

    function populateRegionCompYearFilter() {
        var sel = document.getElementById('regionCompYearFilter');
        if (!sel) return;
        var currentYear = new Date().getFullYear();
        if (sel.options.length > 0) return;
        sel.innerHTML = '';
        for (var y = currentYear + 1; y >= 2024; y--) {
            var opt = document.createElement('option');
            opt.value = y;
            opt.textContent = y;
            if (y === regionCompFilters.year) opt.selected = true;
            sel.appendChild(opt);
        }
    }

    window.onRegionCompYearFilterChange = function() {
        var v = document.getElementById('regionCompYearFilter').value;
        regionCompFilters.year = v ? parseInt(v) : null;
        loadRegionCompetitions();
    };
    window.onRegionCompTypeFilterChange = function() {
        regionCompFilters.type = document.getElementById('regionCompTypeFilter').value;
        loadRegionCompetitions();
    };
    window.onRegionCompClubScopeFilterChange = function() {
        regionCompFilters.clubScope = document.getElementById('regionCompClubScopeFilter').value;
        loadRegionCompetitions();
    };
    window.onRegionCompShowCompletedChange = function() {
        regionCompFilters.includeCompleted = document.getElementById('regionCompShowCompleted').checked;
        loadRegionCompetitions();
    };
    window.clearRegionCompFilters = function() {
        regionCompFilters = { year: new Date().getFullYear(), includeCompleted: false, type: '', clubScope: 'noInternal' };
        document.getElementById('regionCompYearFilter').value = regionCompFilters.year;
        document.getElementById('regionCompTypeFilter').value = '';
        document.getElementById('regionCompClubScopeFilter').value = 'noInternal';
        document.getElementById('regionCompShowCompleted').checked = false;
        loadRegionCompetitions();
    };

    function populateRegionCompTypeFilter() {
        // Shared catalogue - see _CompetitionTypeCatalogue.cshtml. Built from the full discipline
        // list, not from the loaded rows, so a discipline the krets hasn't run this year is still
        // selectable.
        regionCompTypesCache = window.hpskCompetitionTypes.map(function(t) { return t.id; });
        window.hpskFillCompetitionTypeSelect(document.getElementById('regionCompTypeFilter'), regionCompFilters.type || '');
    }


    function loadRegionCompetitions() {
        var container = document.getElementById('regionAdminCompetitionsTableContainer');
        container.innerHTML = '<div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar tävlingar...</span></div></div>';

        populateRegionCompYearFilter();
        window.hpskLoadCompetitionTypes().then(populateRegionCompTypeFilter);

        var params = [];
        if (regionCompFilters.year) params.push('year=' + regionCompFilters.year);
        params.push('includeCompleted=' + regionCompFilters.includeCompleted);
        if (regionCompFilters.type) params.push('type=' + encodeURIComponent(regionCompFilters.type));
        if (regionCompFilters.clubScope && regionCompFilters.clubScope !== 'all') {
            params.push('clubScope=' + encodeURIComponent(regionCompFilters.clubScope));
        }
        if (regionCode) params.push('region=' + encodeURIComponent(regionCode));
        var url = '/umbraco/surface/CompetitionAdmin/GetCompetitionsList?' + params.join('&');

        fetch(url)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (!data.success) {
                    container.innerHTML = '<div class="alert alert-warning">Kunde inte ladda tävlingar.</div>';
                    return;
                }
                // Klubbinterna used to be dropped here unconditionally; the Klubbtävlingar
                // filter now decides, and the server applies it (so the empty state is honest).
                displayRegionCompetitions(data.data || []);
            })
            .catch(function(err) {
                console.error('Error loading region competitions:', err);
                container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av tävlingar.</div>';
            });
    }


    function displayRegionCompetitions(competitions) {
        var container = document.getElementById('regionAdminCompetitionsTableContainer');
        if (!competitions || competitions.length === 0) {
            container.innerHTML = '<div class="alert alert-info">Inga tävlingar i kretsen för valda filter.</div>';
            return;
        }
        // Table, rows and badges come from _CompetitionListRenderer.cshtml, shared with the
        // site-admin and klubb lists.
        container.innerHTML = window.hpskRenderCompetitionTable(competitions, {
            kind: 'krets',
            edit: 'editRegionCompetition',
            copy: 'copyRegionCompetition',
            del: 'deleteRegionCompetition'
        });
    }

    // Expose loadCompetitionsList globally so the wizard / edit modal callbacks refresh the list
    window.loadCompetitionsList = window.loadCompetitionsList || function() { loadRegionCompetitions(); };

    window.showCreateRegionCompetitionModal = function() {
        var modalElement = document.getElementById('competitionWizardModal');
        if (!modalElement) {
            alert('Tävlingsguide kunde inte hittas. Kontakta administratören.');
            return;
        }
        var modal = window.competitionWizardModalInstance || new bootstrap.Modal(modalElement);
        window.competitionWizardModalInstance = modal;
        modal.show();
        if (typeof window.resetWizard === 'function') {
            window.resetWizard();
        }
        window.onCompetitionSaved = function() { loadRegionCompetitions(); };
    };

    window.editRegionCompetition = function(competitionId, isExternal, competitionType) {
        if (typeof window.openAdminEditModal === 'function') {
            window.openAdminEditModal(competitionId, isExternal, competitionType);
            window.onCompetitionSaved = function() { loadRegionCompetitions(); };
        } else {
            alert('Redigeringsfunktion kunde inte hittas. Kontakta administratören.');
        }
    };

    window.copyRegionCompetition = function(competitionId) {
        if (!confirm('Kopiera tävlingen? Datum flyttas fram ett år.')) return;
        var token = rcGetAntiForgeryToken();
        fetch('/umbraco/surface/CompetitionAdmin/CopyCompetition', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ sourceCompetitionId: competitionId })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                alert('✅ Tävlingen har kopierats! Datum har flyttats fram ett år.');
                loadRegionCompetitions();
            } else {
                alert('❌ Kunde inte kopiera: ' + (data.message || 'Okänt fel'));
            }
        })
        .catch(function(err) {
            console.error('Error copying competition:', err);
            alert('❌ Fel vid kopiering av tävling');
        });
    };

    window.deleteRegionCompetition = function(competitionId, competitionName) {
        if (typeof window.showDeleteConfirmation === 'function') {
            window.showDeleteConfirmation(competitionName, function() {
                doDeleteRegionCompetition(competitionId);
            });
        } else if (confirm('Radera tävlingen "' + competitionName + '"?')) {
            doDeleteRegionCompetition(competitionId);
        }
    };

    function doDeleteRegionCompetition(competitionId) {
        var token = rcGetAntiForgeryToken();
        fetch('/umbraco/surface/CompetitionAdmin/DeleteCompetition', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            credentials: 'include',
            body: JSON.stringify({ competitionId: competitionId })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                loadRegionCompetitions();
                alert('Tävling raderad!');
            } else {
                alert('Fel: ' + (data.message || 'Kunde inte radera tävlingen'));
            }
        })
        .catch(function(err) {
            console.error('Error deleting competition:', err);
            alert('Fel vid radering.');
        });
    }

    function ensureRegionCompetitionsLoaded() {
        if (!regionCompLoaded) {
            regionCompLoaded = true;
            loadRegionCompetitions();
        }
    }

    var compTabBtn = document.getElementById('regionAdminCompetitions-tab');
    if (compTabBtn) {
        // Bind to click rather than shown.bs.tab — the Bootstrap transition event
        // doesn't reliably reach addEventListener here (the symmetric Events tab
        // works fine with shown.bs.tab, but this one didn't in prod).
        compTabBtn.addEventListener('click', ensureRegionCompetitionsLoaded);

        // If the sub-tab is already active when the partial loads (URL hash etc.),
        // trigger immediately.
        if (compTabBtn.classList.contains('active')) {
            ensureRegionCompetitionsLoaded();
        }
    }
})();

// Small-screen section picker <-> Bootstrap tabs (the rail is hidden < lg).
(function () {
    var sel = document.getElementById('regionAdminTabMobileSelect');
    if (!sel) return;
    // What the picker is showing before the user changes it, so an ACTION option can put it back —
    // otherwise the picker would sit on "Skicka mail…" while the pane behind it is something else.
    var lastPane = sel.value;
    sel.addEventListener('change', function () {
        // An ACTION option runs something and restores the picker; it is not a destination.
        if (sel.value.indexOf('action:') === 0) {
            var action = sel.value.slice('action:'.length);
            sel.value = lastPane;
            if (action === 'email' && typeof showRegionEmailModal === 'function') showRegionEmailModal();
            return;
        }
        // A URL-valued option (Styrelsearbete) navigates away instead of switching a pane.
        if (sel.value && sel.value.charAt(0) !== '#') { window.location.href = sel.value; return; }
        lastPane = sel.value;
        var btn = document.querySelector('#regionAdminTabs [data-bs-target="' + sel.value + '"]');
        if (!btn) return;
        // ⚠️ click(), not bootstrap.Tab.show(). Bootstrap's delegated handler switches the tab either
        // way, but the Tävlingar loader binds to CLICK rather than shown.bs.tab (see the comment
        // above — the event did not reach it reliably in prod). Showing the tab programmatically
        // would switch the pane and never load the competitions on a phone.
        btn.click();
    });
    // Keep the picker in sync when a tab is shown any other way.
    document.querySelectorAll('#regionAdminTabs [data-bs-toggle="tab"]').forEach(function (b) {
        b.addEventListener('shown.bs.tab', function (e) {
            var target = e.target.getAttribute('data-bs-target');
            if (target) { lastPane = target; if (sel.value !== target) sel.value = target; }
        });
    });
})();
</script>

<style>
/* Grouped vertical admin navigation rail (≥ lg) — same rules as ClubAdminPanel's, scoped to this
   panel. Kept as a copy rather than lifted into theme.css: both are panel-local styling today, and
   moving them is a separate change that would touch two working pages at once. If a third admin
   surface ever needs the rail, extract then. */
.regional-admin-panel .admin-rail {
    position: sticky;
    top: 1rem;
    gap: 2px;
    /* Fixed width so the rail doesn't keep growing with a wide col-lg-auto on large screens. */
    width: 250px;
    /* Its own surface, so it reads as a panel rather than floating text. */
    background-color: var(--bs-tertiary-bg);
    border: 1px solid var(--bs-border-color);
    border-radius: 0.5rem;
    padding: 8px;
}
.regional-admin-panel .admin-rail-group {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bs-secondary-color);
    padding: 14px 12px 4px;
}
.regional-admin-panel .admin-rail-group:first-child {
    padding-top: 2px;
}
.regional-admin-panel .admin-rail .nav-link {
    text-align: left;
    color: var(--bs-body-color);
    border-radius: 8px;
    padding: 8px 12px;
    border-left: 3px solid transparent;
}
.regional-admin-panel .admin-rail .nav-link:hover {
    /* One step up from the rail's own tertiary surface so hover stays visible. */
    background-color: var(--bs-secondary-bg);
}
.regional-admin-panel .admin-rail .nav-link.active {
    /* -text-emphasis on -bg-subtle is Bootstrap's contrast-safe pairing in BOTH themes. */
    background-color: var(--bs-primary-bg-subtle);
    color: var(--bs-primary-text-emphasis);
    font-weight: 600;
    border-left-color: var(--bs-primary);
}
/* Actions live below the sections. Same geometry as a rail item so the column stays even, but it
   never takes the active state — it opens a dialog rather than selecting a section. */
.regional-admin-panel .admin-rail-sep {
    margin: 10px 6px 6px;
    opacity: 0.25;
}
.regional-admin-panel .admin-rail-action {
    display: block;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    border-left: 3px solid transparent;
    border-radius: 8px;
    padding: 8px 12px;
    color: var(--bs-body-color);
}
.regional-admin-panel .admin-rail-action:hover {
    background-color: var(--bs-secondary-bg);
}
.regional-admin-panel .admin-rail-action:focus-visible {
    outline: 2px solid var(--bs-primary);
    outline-offset: -2px;
}

.regional-admin-panel .nav-tabs .nav-link {
    color: var(--bs-secondary-color);
}

.regional-admin-panel .nav-tabs .nav-link:hover {
    color: var(--bs-body-color);
}

.regional-admin-panel .nav-tabs .nav-link.active {
    color: var(--bs-primary);
    border-bottom: 3px solid var(--bs-primary);
    background-color: transparent;
}

/* CKEditor dark mode support */
[data-bs-theme="dark"] .regional-admin-panel .ck.ck-editor__main > .ck-editor__editable {
    background-color: var(--bs-body-bg);
    color: var(--bs-body-color);
    border-color: var(--bs-border-color);
}

[data-bs-theme="dark"] .regional-admin-panel .ck.ck-toolbar {
    background-color: var(--bs-tertiary-bg);
    border-color: var(--bs-border-color);
}

[data-bs-theme="dark"] .regional-admin-panel .ck.ck-toolbar .ck-button {
    color: var(--bs-body-color);
}

[data-bs-theme="dark"] .regional-admin-panel .ck.ck-toolbar .ck-button:hover {
    background-color: var(--bs-secondary-bg);
}

[data-bs-theme="dark"] .regional-admin-panel .ck.ck-editor__editable.ck-focused {
    border-color: var(--bs-primary);
}
</style>

@* ===== Serier (kretsserier) =====
   Mirrors the Serier tab on the club admin page (ClubAdminPanel.cshtml): the shared
   Series* modals do the editing, this block only lists the series this krets owns and
   locks the organizer fields to the krets so a kretsadmin cannot accidentally hand a
   series to a club or to another krets. The openers the row buttons call from their onclick
   attributes are put on window on purpose — the shared modals look them up by name. *@
<script>
(function () {
    var regionSeriesCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.regionCode as string ?? ""));
    var regionSeriesName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(regionName));
    var regionSeriesLoaded = false;

    function regionSeriesToken() {
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    function regionSeriesEscapeHtml(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function regionSeriesFormatDateForInput(dateStr) {
        if (!dateStr) return '';
        var d = new Date(dateStr);
        return d.toISOString().split('T')[0];
    }

    // Only this krets's own series. GetSeriesList also returns national series (no club, no
    // krets) to everyone, so filtering on the krets code is what keeps the list honest.
    function isThisRegionsSeries(s) {
        var comp = (s.regionalFederation || '').toLowerCase();
        return (!s.clubId || s.clubId === 0) && comp === regionSeriesCode.toLowerCase();
    }

    function loadRegionSeriesList() {
        var spinner = document.getElementById('regionSeriesLoadingSpinner');
        var tableContainer = document.getElementById('regionSeriesTableContainer');
        var tbody = document.getElementById('regionSeriesTableBody');
        var errorAlert = document.getElementById('regionSeriesErrorAlert');
        var errorMessage = document.getElementById('regionSeriesErrorMessage');
        var noSeriesAlert = document.getElementById('noRegionSeriesAlert');

        spinner.classList.remove('d-none');
        errorAlert.classList.add('d-none');
        noSeriesAlert.classList.add('d-none');

        var url = '/umbraco/surface/CompetitionAdmin/GetSeriesList';
        if (regionSeriesCode) url += '?region=' + encodeURIComponent(regionSeriesCode);

        fetch(url, {
            method: 'GET',
            headers: { 'RequestVerificationToken': regionSeriesToken() },
            credentials: 'include'
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            spinner.classList.add('d-none');

            if (!data.success) {
                errorMessage.textContent = data.message || 'Kunde inte ladda serier';
                errorAlert.classList.remove('d-none');
                tbody.innerHTML = '<tr class="text-muted"><td colspan="5" class="text-center py-4">Fel vid laddning av serier</td></tr>';
                return;
            }

            var regionSeries = (data.data || []).filter(isThisRegionsSeries);

            if (regionSeries.length === 0) {
                tableContainer.classList.add('d-none');
                noSeriesAlert.classList.remove('d-none');
                tbody.innerHTML = '';
            } else {
                tableContainer.classList.remove('d-none');
                noSeriesAlert.classList.add('d-none');
                renderRegionSeries(regionSeries);
            }
        })
        .catch(function (error) {
            spinner.classList.add('d-none');
            errorMessage.textContent = error.message || 'Nätverksfel';
            errorAlert.classList.remove('d-none');
        });
    }

    function renderRegionSeries(seriesList) {
        var tbody = document.getElementById('regionSeriesTableBody');
        tbody.innerHTML = seriesList.map(function (series) {
            var statusBadge = (series.isActive === true || series.isActive === 'true')
                ? '<span class="badge bg-success">Aktiv</span>'
                : '<span class="badge bg-secondary">Inaktiv</span>';
            var strategyBadge = series.seriesCalculationStrategy
                ? ' <span class="badge bg-info ms-1" title="Serieresultat konfigurerad"><i class="bi bi-bar-chart"></i></span>'
                : '';
            var start = series.startDate ? new Date(series.startDate).toLocaleDateString('sv-SE') : '-';
            var end = series.endDate ? new Date(series.endDate).toLocaleDateString('sv-SE') : '-';
            var dateRange = (start === '-' && end === '-') ? '-'
                : (start !== '-' && end !== '-') ? (start + ' - ' + end)
                : (start !== '-') ? ('Från ' + start) : ('Till ' + end);
            var shortDesc = series.shortDescription ? regionSeriesEscapeHtml(series.shortDescription) : '<em>Ingen beskrivning</em>';
            var count = series.competitionCount || 0;

            return '<tr data-series-id="' + series.id + '">' +
                '<td><strong>' + regionSeriesEscapeHtml(series.name) + strategyBadge + '</strong><br><small class="text-muted">' + shortDesc + '</small></td>' +
                '<td><strong>' + dateRange + '</strong></td>' +
                '<td>' + statusBadge + '</td>' +
                '<td class="text-center"><span class="badge bg-info">' + count + '</span></td>' +
                '<td class="text-end">' + window.hpskSeriesActionsMenu(series) + '</td></tr>';
        }).join('');
    }

    // Lock the organizer to this krets: no club, this krets, neither changeable. The select is
    // disabled but still read on save (SeriesEditModal reads the value, not the disabled flag).
    function lockSeriesOrganizerToRegion() {
        var clubSelect = document.getElementById('seriesClubId');
        var regionSelect = document.getElementById('seriesRegionalFederation');
        if (clubSelect) {
            clubSelect.value = '';
            clubSelect.disabled = true;
        }
        if (regionSelect) {
            // The region options load asynchronously; make sure ours exists before selecting it.
            if (!Array.prototype.some.call(regionSelect.options, function (o) { return o.value === regionSeriesCode; })) {
                var opt = document.createElement('option');
                opt.value = regionSeriesCode;
                opt.textContent = regionSeriesName;
                regionSelect.appendChild(opt);
            }
            regionSelect.value = regionSeriesCode;
            regionSelect.disabled = true;
        }
        var helpText = document.getElementById('seriesOrganizerHelpText');
        if (helpText) {
            helpText.textContent = 'Serien arrangeras av ' + regionSeriesName + ' och kan inte flyttas härifrån.';
        }
    }

    window.openCreateRegionSeriesModal = function () {
        document.getElementById('seriesId').value = '0';
        document.getElementById('seriesName').value = '';
        document.getElementById('seriesShortDescription').value = '';
        document.getElementById('seriesDescription').value = '';
        document.getElementById('seriesStartDate').value = '';
        document.getElementById('seriesEndDate').value = '';
        document.getElementById('showInMenu').checked = false;
        document.getElementById('isActive').value = 'true';

        if (typeof populateSeriesStrategy === 'function') {
            populateSeriesStrategy('', '');
        }

        document.getElementById('seriesEditModalLabel').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Ny serie';

        var modalElement = document.getElementById('seriesEditModal');
        var modal = window.seriesEditModalInstance || new bootstrap.Modal(modalElement);
        window.seriesEditModalInstance = modal;
        modal.show();

        lockSeriesOrganizerToRegion();
    };

    window.openSeriesEditModal = function (seriesId) {
        var url = '/umbraco/surface/CompetitionAdmin/GetSeriesList';
        if (regionSeriesCode) url += '?region=' + encodeURIComponent(regionSeriesCode);

        fetch(url, {
            method: 'GET',
            headers: { 'RequestVerificationToken': regionSeriesToken() },
            credentials: 'same-origin'
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.success || !data.data) return;
            var series = data.data.find(function (s) { return s.id === seriesId; });
            if (!series) return;

            window.currentSeriesData = series;
            document.getElementById('seriesId').value = series.id;
            document.getElementById('seriesName').value = series.name || '';
            document.getElementById('seriesShortDescription').value = series.shortDescription || '';

            var descriptionContent = series.description || '';
            if (descriptionContent && descriptionContent.charAt(0) === '{') {
                try {
                    var parsed = JSON.parse(descriptionContent);
                    descriptionContent = parsed.markup || descriptionContent;
                } catch (e) { }
            }
            document.getElementById('seriesDescription').value = descriptionContent;

            if (series.startDate) {
                var startInput = document.getElementById('seriesStartDate');
                var startFormatted = regionSeriesFormatDateForInput(series.startDate);
                startInput.value = startFormatted;
                if (startInput._flatpickr) startInput._flatpickr.setDate(startFormatted);
            }
            if (series.endDate) {
                var endInput = document.getElementById('seriesEndDate');
                var endFormatted = regionSeriesFormatDateForInput(series.endDate);
                endInput.value = endFormatted;
                if (endInput._flatpickr) endInput._flatpickr.setDate(endFormatted);
            }

            document.getElementById('showInMenu').checked = series.showInMenu;
            document.getElementById('isActive').value = series.isActive ? 'true' : 'false';

            if (typeof populateSeriesStrategy === 'function') {
                populateSeriesStrategy(series.seriesCalculationStrategy || '', series.seriesCalculationConfig || '');
            }

            document.getElementById('seriesEditModalLabel').innerHTML = '<i class="bi bi-pencil me-2"></i>Redigera serie';

            var modalElement = document.getElementById('seriesEditModal');
            var modal = window.seriesEditModalInstance || new bootstrap.Modal(modalElement);
            window.seriesEditModalInstance = modal;
            modal.show();

            lockSeriesOrganizerToRegion();
        })
        .catch(function (error) {
            console.error('Error loading series:', error);
        });
    };

    window.openSeriesCopyModal = function (seriesId) {
        var token = regionSeriesToken();
        var listUrl = '/umbraco/surface/CompetitionAdmin/GetSeriesList';
        if (regionSeriesCode) listUrl += '?region=' + encodeURIComponent(regionSeriesCode);

        fetch(listUrl, {
            method: 'GET',
            headers: { 'RequestVerificationToken': token },
            credentials: 'same-origin'
        })
        .then(function (r) { return r.json(); })
        .then(function (seriesData) {
            if (!seriesData.success || !seriesData.data) return;
            var series = seriesData.data.find(function (s) { return s.id === seriesId; });
            if (!series) return;

            return fetch('/umbraco/surface/CompetitionAdmin/GetSeriesCompetitions?seriesId=' + seriesId, {
                method: 'GET',
                headers: { 'RequestVerificationToken': token },
                credentials: 'same-origin'
            })
            .then(function (r) { return r.json(); })
            .then(function (competitionsData) {
                if (!competitionsData.success) return;

                window.currentSeriesDataForCopy = {
                    seriesId: seriesId,
                    seriesName: series.name,
                    competitions: competitionsData.data || []
                };

                var modalElement = document.getElementById('seriesCopyModal');
                if (!modalElement || typeof populateCopyModal !== 'function') return;

                populateCopyModal(seriesId, window.currentSeriesDataForCopy.competitions);
                var modal = window.seriesCopyModalInstance || new bootstrap.Modal(modalElement);
                window.seriesCopyModalInstance = modal;
                modal.show();
            });
        })
        .catch(function (error) {
            console.error('Error loading series for copy:', error);
        });
    };

    window.openSeriesDeleteModal = function (seriesId, seriesName, competitionCount) {
        window.deleteSeriesId = seriesId;
        var modal = new bootstrap.Modal(document.getElementById('seriesDeleteConfirmModal'));
        document.getElementById('deleteSeriesName').textContent = seriesName;

        var errorAlert = document.getElementById('seriesDeleteErrorAlert');
        errorAlert.classList.add('d-none');

        if (competitionCount > 0) {
            errorAlert.classList.remove('d-none');
            document.getElementById('seriesDeleteErrorMessage').textContent =
                'Denna serie innehåller ' + competitionCount + ' tävling(ar) och kan inte tas bort. Ta bort tävlingarna först.';
            document.getElementById('deleteSeriesBtn').disabled = true;
        } else {
            document.getElementById('deleteSeriesBtn').disabled = false;
        }

        modal.show();
    };

    // The shared modals call these after a save/copy/delete.
    window.loadSeriesList = loadRegionSeriesList;
    window.reloadSeriesList = loadRegionSeriesList;
    window.addSeriesToTable = function () { loadRegionSeriesList(); };
    window.removeSeriesFromTable = function () { loadRegionSeriesList(); };

    function ensureRegionSeriesLoaded() {
        if (!regionSeriesLoaded) {
            regionSeriesLoaded = true;
            loadRegionSeriesList();
        }
    }

    // Bound to click, not shown.bs.tab — same reason as the Tävlingar tab above: the Bootstrap
    // transition event did not reliably reach a listener on this page in prod.
    var seriesTabBtn = document.getElementById('regionSeries-tab');
    if (seriesTabBtn) {
        seriesTabBtn.addEventListener('click', ensureRegionSeriesLoaded);
        if (seriesTabBtn.classList.contains('active')) {
            ensureRegionSeriesLoaded();
        }
    }

    var seriesEditModalEl = document.getElementById('seriesEditModal');
    if (seriesEditModalEl) {
        seriesEditModalEl.addEventListener('shown.bs.modal', lockSeriesOrganizerToRegion);
    }
})();
</script>
