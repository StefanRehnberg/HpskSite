@*
    Site-admin Riksinstruktör panel: per-area list with target counts (Syd/Vast/Ost = 2,
    Nord = 3) and a grant + appoint flow. Uses the CertificationController endpoints.
    Site-admin only — already gated by AdminPage.
*@

<!-- Flatpickr Date Picker (sv-SE) — AdminPage doesn't load it globally, so include here -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<div class="riksinstruktor-admin">
    <div class="d-flex align-items-center mb-3">
        <h5 class="mb-0"><i class="bi bi-mortarboard-fill me-2"></i>Riksinstruktörer</h5>
        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto me-2" id="riksRefreshBtn">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
        <button type="button" class="btn btn-sm btn-success" id="riksAddBtn">
            <i class="bi bi-plus-circle me-1"></i>Tilldela ny
        </button>
    </div>

    <div class="alert alert-info small">
        Riksinstruktörer utbildar kretsinstruktörer och är källan till sanning för regelverk.
        Mål: 2 per område (Syd, Väst, Öst) och 3 i Nord. Granter:s sker enbart av siteadmin.
    </div>

    <div id="riksLoading" class="text-center py-3">
        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
        <span class="ms-2 small text-muted">Laddar...</span>
    </div>

    <div id="riksContent" style="display:none;" class="row g-3"></div>
</div>

<!-- Grant modal -->
<div class="modal fade" id="riksGrantModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="riksGrantTitle">Tilldela Riksinstruktör</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Område *</label>
                    <select class="form-select" id="riksGrantArea">
                        <option value="Syd">Syd</option>
                        <option value="Vast">Väst</option>
                        <option value="Ost">Öst</option>
                        <option value="Nord">Nord</option>
                    </select>
                </div>

                <!-- Nytilldelning: sök fram medlemmen. Vid redigering är medlemmen låst. -->
                <div class="mb-3" id="riksMemberSearchWrap">
                    <label class="form-label">Medlem *</label>
                    <div class="position-relative">
                        <input type="text" class="form-control" id="riksMemberSearch"
                               placeholder="Sök medlem (namn eller e-post)…" autocomplete="off">
                        <div id="riksMemberResults" class="list-group position-absolute w-100 shadow"
                             style="z-index:1056; display:none; max-height:280px; overflow:auto;"></div>
                    </div>
                    <div class="form-text" id="riksMemberChosen"></div>
                </div>
                <div class="mb-3 d-none" id="riksMemberLockedWrap">
                    <label class="form-label">Medlem</label>
                    <input type="text" class="form-control" id="riksMemberLocked" disabled>
                </div>

                <div class="mb-3">
                    <label class="form-label">Certifierad datum *</label>
                    <input type="text" class="form-control" id="riksGrantCertifiedAt" placeholder="ÅÅÅÅ-MM-DD">
                </div>
                <div class="mb-3">
                    <label class="form-label">Förfaller (frivilligt)</label>
                    <input type="text" class="form-control" id="riksGrantExpiresAt" placeholder="ÅÅÅÅ-MM-DD">
                </div>
                <div class="mb-3">
                    <label class="form-label">Certifikatnummer (frivilligt)</label>
                    <input type="text" class="form-control" id="riksGrantNumber" maxlength="100">
                </div>
                <div class="mb-2">
                    <label class="form-label">Anteckningar (frivilligt)</label>
                    <textarea class="form-control" id="riksGrantNotes" rows="2"></textarea>
                </div>
                <div class="alert alert-danger d-none" id="riksGrantError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="riksGrantSubmit">
                    <i class="bi bi-save me-1"></i>Spara
                </button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var areas = [
        { code: 'Syd',  label: 'Syd',  target: 2 },
        { code: 'Vast', label: 'Väst', target: 2 },
        { code: 'Ost',  label: 'Öst',  target: 2 },
        { code: 'Nord', label: 'Nord', target: 3 }
    ];

    var fpRiksCertifiedAt = null;
    var fpRiksExpiresAt = null;
    function initRiksFlatpickrs() {
        if (typeof flatpickr === 'undefined') return;
        if (!fpRiksCertifiedAt) {
            fpRiksCertifiedAt = flatpickr('#riksGrantCertifiedAt', {
                locale: 'sv', dateFormat: 'Y-m-d', allowInput: true
            });
        }
        if (!fpRiksExpiresAt) {
            fpRiksExpiresAt = flatpickr('#riksGrantExpiresAt', {
                locale: 'sv', dateFormat: 'Y-m-d', allowInput: true
            });
        }
    }

    function getToken() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    function escapeHtml(str) { var d = document.createElement('div'); d.textContent = str || ''; return d.innerHTML; }
    // För data-attribut i enkla citattecken: JSON-nyttolasten innehåller " som inte får bryta ut.
    function escapeAttr(str) { return escapeHtml(str).replace(/'/g, '&#39;'); }

    function loadAll() {
        var loading = document.getElementById('riksLoading');
        loading.innerHTML = '<div class="spinner-border spinner-border-sm text-primary" role="status"></div>'
                          + '<span class="ms-2 small text-muted">Laddar...</span>';
        loading.style.display = '';
        document.getElementById('riksContent').style.display = 'none';

        // Fetch all members + filter to those with Riksinstruktor_<area> roles client-side.
        // For a v1 this is fine; the data set is small (handful of Riksinstruktörer total).
        Promise.all(areas.map(function (a) {
            return fetch('/umbraco/surface/Certification/ListForArea?areaCode=' + encodeURIComponent(a.code))
                .then(function (r) { return r.json(); })
                .then(function (resp) { return { area: a, resp: resp }; });
        })).then(function (results) {
            var content = document.getElementById('riksContent');
            content.innerHTML = '';
            results.forEach(function (entry) {
                var a = entry.area;
                var resp = entry.resp;
                var persons = (resp && resp.success) ? (resp.data || []) : [];

                var listItems;
                if (persons.length === 0) {
                    listItems = '<li class="list-group-item text-muted small">Ingen utsedd</li>';
                } else {
                    listItems = persons.map(function (p) {
                        var meta = '';
                        if (p.cert) {
                            var pieces = [];
                            if (p.cert.certifiedAt) pieces.push('Cert ' + escapeHtml(p.cert.certifiedAt));
                            if (p.cert.expiresAt) pieces.push('förfaller ' + escapeHtml(p.cert.expiresAt));
                            if (p.cert.certificateNumber) pieces.push('nr ' + escapeHtml(p.cert.certificateNumber));
                            meta = pieces.join(' · ');
                        }
                        return '<li class="list-group-item d-flex justify-content-between align-items-center">'
                             + '<div><strong>' + escapeHtml(p.name) + '</strong>'
                             + (meta ? '<div class="small text-muted">' + meta + '</div>' : '')
                             + '</div>'
                             + (p.cert
                                  ? '<div>'
                                    + '<button type="button" class="btn btn-sm btn-outline-primary riks-edit-btn me-1"'
                                    + ' data-cert=\'' + escapeAttr(JSON.stringify(p.cert)) + '\''
                                    + ' data-member-id="' + p.memberId + '"'
                                    + ' data-area="' + escapeHtml(a.code) + '"'
                                    + ' data-name="' + escapeHtml(p.name) + '" title="Redigera">'
                                    + '<i class="bi bi-pencil"></i></button>'
                                    + '<button type="button" class="btn btn-sm btn-outline-warning riks-unappoint-btn me-1"'
                                    + ' data-member-id="' + p.memberId + '" data-area="' + escapeHtml(a.code) + '" data-name="' + escapeHtml(p.name) + '" title="Ta bort utnämning">'
                                    + '<i class="bi bi-person-dash"></i></button>'
                                    + '<button type="button" class="btn btn-sm btn-outline-danger riks-revoke-btn"'
                                    + ' data-cert-id="' + p.cert.id + '" data-name="' + escapeHtml(p.name) + '" title="Återkalla cert">'
                                    + '<i class="bi bi-x-circle"></i></button>'
                                    + '</div>'
                                  : '')
                             + '</li>';
                    }).join('');
                }

                var statusBadge = (persons.length >= a.target)
                    ? '<span class="badge bg-success">Mål nått</span>'
                    : '<span class="badge bg-warning text-dark">Under mål</span>';

                content.insertAdjacentHTML('beforeend',
                    '<div class="col-md-6">'
                  + '<div class="card h-100">'
                  + '<div class="card-body">'
                  + '<div class="d-flex justify-content-between align-items-center mb-2">'
                  + '<h6 class="mb-0">' + escapeHtml(a.label) + '</h6>'
                  + '<span class="small text-muted">' + persons.length + ' / ' + a.target + ' ' + statusBadge + '</span>'
                  + '</div>'
                  + '<ul class="list-group list-group-flush">' + listItems + '</ul>'
                  + '</div></div></div>');
            });
            document.getElementById('riksLoading').style.display = 'none';
            document.getElementById('riksContent').style.display = '';
        }).catch(function (e) {
            // Utan den här slutade snurran aldrig snurra — ett fel blev tyst evig laddning.
            console.error('Riksinstruktörer: kunde inte ladda', e);
            loading.innerHTML = '<div class="alert alert-danger small mb-0">'
                              + 'Kunde inte hämta listan. Försök igen med uppdateringsknappen.'
                              + '</div>';
        });
    }

    // ── Medlemssökning ──────────────────────────────────────────────────────
    // Tidigare hämtades HELA medlemsregistret hit för att fylla en rullgardin,
    // vilket tog för lång tid. Nu söker vi på namn/e-post medan man skriver.
    var riksSearchTimer = null;
    var riksSelectedMemberId = null;

    function clearMemberSearch() {
        riksSelectedMemberId = null;
        document.getElementById('riksMemberSearch').value = '';
        document.getElementById('riksMemberChosen').textContent = '';
        var res = document.getElementById('riksMemberResults');
        res.innerHTML = ''; res.style.display = 'none';
    }

    function initMemberSearch() {
        var inp = document.getElementById('riksMemberSearch');
        var res = document.getElementById('riksMemberResults');
        if (inp.dataset.bound) return;
        inp.dataset.bound = '1';

        inp.addEventListener('input', function () {
            clearTimeout(riksSearchTimer);
            // Skriver man om efter ett val gäller inte valet längre.
            riksSelectedMemberId = null;
            document.getElementById('riksMemberChosen').textContent = '';

            var q = inp.value.trim();
            if (q.length < 2) { res.style.display = 'none'; res.innerHTML = ''; return; }

            riksSearchTimer = setTimeout(function () {
                fetch('/umbraco/surface/Certification/SearchMembers?query=' + encodeURIComponent(q))
                    .then(function (r) { return r.json(); })
                    .then(function (d) {
                        if (!d.success) {
                            res.innerHTML = '<div class="list-group-item small text-danger">'
                                          + escapeHtml(d.message || 'Sökningen misslyckades') + '</div>';
                            res.style.display = 'block';
                            return;
                        }
                        if (!d.members.length) {
                            res.innerHTML = '<div class="list-group-item small text-muted">Inga träffar</div>';
                            res.style.display = 'block';
                            return;
                        }
                        res.innerHTML = d.members.map(function (m) {
                            var sub = [m.club, m.email].filter(function (x) { return x; }).join(' · ');
                            return '<button type="button" class="list-group-item list-group-item-action riks-member-hit"'
                                 + ' data-member-id="' + m.memberId + '" data-name="' + escapeHtml(m.name) + '">'
                                 + escapeHtml(m.name)
                                 + (sub ? ' <span class="text-muted small">' + escapeHtml(sub) + '</span>' : '')
                                 + '</button>';
                        }).join('');
                        res.style.display = 'block';
                    })
                    .catch(function (e) {
                        console.error('Riksinstruktörer: medlemssökning misslyckades', e);
                        res.innerHTML = '<div class="list-group-item small text-danger">Nätverksfel</div>';
                        res.style.display = 'block';
                    });
            }, 250);
        });

        res.addEventListener('click', function (ev) {
            var hit = ev.target.closest('.riks-member-hit');
            if (!hit) return;
            riksSelectedMemberId = parseInt(hit.dataset.memberId, 10);
            inp.value = hit.dataset.name;
            document.getElementById('riksMemberChosen').textContent = 'Vald: ' + hit.dataset.name;
            res.style.display = 'none'; res.innerHTML = '';
        });

        document.addEventListener('click', function (ev) {
            if (!inp.contains(ev.target) && !res.contains(ev.target)) res.style.display = 'none';
        });
    }

    document.getElementById('riksRefreshBtn').addEventListener('click', loadAll);

    // Redigeringsläge: satt till { certId, memberId, area } när pennan öppnade modalen.
    var riksEditing = null;

    function setDate(fp, inputId, value) {
        if (fp) { if (value) { fp.setDate(value, true); } else { fp.clear(); } }
        else { document.getElementById(inputId).value = value || ''; }
    }

    document.getElementById('riksAddBtn').addEventListener('click', function () {
        riksEditing = null;
        initRiksFlatpickrs();
        initMemberSearch();

        document.getElementById('riksGrantTitle').textContent = 'Tilldela Riksinstruktör';
        document.getElementById('riksGrantArea').value = 'Syd';
        document.getElementById('riksMemberSearchWrap').classList.remove('d-none');
        document.getElementById('riksMemberLockedWrap').classList.add('d-none');
        clearMemberSearch();

        setDate(fpRiksCertifiedAt, 'riksGrantCertifiedAt', new Date().toISOString().slice(0, 10));
        setDate(fpRiksExpiresAt, 'riksGrantExpiresAt', '');
        document.getElementById('riksGrantNumber').value = '';
        document.getElementById('riksGrantNotes').value = '';
        document.getElementById('riksGrantError').classList.add('d-none');

        new bootstrap.Modal(document.getElementById('riksGrantModal')).show();
    });

    function openEdit(btn) {
        var cert;
        try { cert = JSON.parse(btn.dataset.cert); }
        catch (e) { alert('Kunde inte läsa certifieringen.'); return; }

        riksEditing = { certId: cert.id, memberId: parseInt(btn.dataset.memberId, 10), area: btn.dataset.area };
        initRiksFlatpickrs();
        initMemberSearch();

        document.getElementById('riksGrantTitle').textContent = 'Redigera Riksinstruktör';
        document.getElementById('riksGrantArea').value = btn.dataset.area;
        document.getElementById('riksMemberSearchWrap').classList.add('d-none');
        document.getElementById('riksMemberLockedWrap').classList.remove('d-none');
        document.getElementById('riksMemberLocked').value = btn.dataset.name;
        clearMemberSearch();

        setDate(fpRiksCertifiedAt, 'riksGrantCertifiedAt', cert.certifiedAt || '');
        setDate(fpRiksExpiresAt, 'riksGrantExpiresAt', cert.expiresAt || '');
        document.getElementById('riksGrantNumber').value = cert.certificateNumber || '';
        document.getElementById('riksGrantNotes').value = cert.notes || '';
        document.getElementById('riksGrantError').classList.add('d-none');

        new bootstrap.Modal(document.getElementById('riksGrantModal')).show();
    }

    function postJson(url, payload) {
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
            body: JSON.stringify(payload)
        }).then(function (r) { return r.json(); });
    }

    document.getElementById('riksGrantSubmit').addEventListener('click', function () {
        var btn = this;
        var area = document.getElementById('riksGrantArea').value;
        var certifiedAt = document.getElementById('riksGrantCertifiedAt').value || null;
        var expiresAt = document.getElementById('riksGrantExpiresAt').value || null;
        var num = document.getElementById('riksGrantNumber').value.trim() || null;
        var notes = document.getElementById('riksGrantNotes').value.trim() || null;
        var err = document.getElementById('riksGrantError');
        err.classList.add('d-none');

        var memberId = riksEditing ? riksEditing.memberId : riksSelectedMemberId;

        function fail(msg) {
            err.textContent = msg;
            err.classList.remove('d-none');
            btn.disabled = false;
        }

        if (!area || !memberId || !certifiedAt) {
            fail(riksEditing ? 'Fyll i område och datum.' : 'Välj område, sök fram en medlem och fyll i datum.');
            return;
        }

        btn.disabled = true;

        function finish() {
            bootstrap.Modal.getInstance(document.getElementById('riksGrantModal')).hide();
            btn.disabled = false;
            loadAll();
        }

        if (riksEditing) {
            // Redigering: uppdatera certifieringen, och flytta utnämningen om området bytts.
            var areaChanged = area !== riksEditing.area;
            postJson('/umbraco/surface/Certification/UpdateMeta', {
                certId: riksEditing.certId,
                certifiedAt: certifiedAt,
                expiresAt: expiresAt,
                certificateNumber: num,
                notes: notes
            }).then(function (resp) {
                if (!resp.success) { fail(resp.message || 'Kunde inte spara'); return; }
                if (!areaChanged) { finish(); return; }

                return postJson('/umbraco/surface/Certification/Unappoint', {
                    memberId: memberId, certificationType: 'Riksinstruktor', scopeId: riksEditing.area
                }).then(function () {
                    return postJson('/umbraco/surface/Certification/Appoint', {
                        memberId: memberId, certificationType: 'Riksinstruktor', scopeId: area
                    });
                }).then(function (resp2) {
                    if (resp2 && resp2.success === false) { fail(resp2.message || 'Kunde inte byta område'); return; }
                    finish();
                });
            }).catch(function (e) {
                console.error('Riksinstruktörer: kunde inte spara', e);
                fail('Nätverksfel — inget sparades.');
            });
            return;
        }

        // Nytilldelning, två steg: utfärda cert, utse sedan till område.
        postJson('/umbraco/surface/Certification/Grant', {
            memberId: memberId,
            certificationType: 'Riksinstruktor',
            certifiedAt: certifiedAt,
            expiresAt: expiresAt,
            certificateNumber: num,
            notes: notes
        }).then(function (resp) {
            if (!resp.success) { fail(resp.message || 'Kunde inte spara'); return; }
            return postJson('/umbraco/surface/Certification/Appoint', {
                memberId: memberId, certificationType: 'Riksinstruktor', scopeId: area
            }).then(function (resp2) {
                if (resp2 && resp2.success === false) { fail(resp2.message || 'Certet skapades men utnämningen misslyckades'); return; }
                finish();
            });
        }).catch(function (e) {
            console.error('Riksinstruktörer: kunde inte spara', e);
            fail('Nätverksfel — kontrollera listan innan du försöker igen.');
        });
    });

    document.body.addEventListener('click', function (ev) {
        var edit = ev.target.closest('.riks-edit-btn');
        if (edit) { ev.preventDefault(); openEdit(edit); return; }

        var revoke = ev.target.closest('.riks-revoke-btn');
        if (revoke) {
            ev.preventDefault();
            if (!confirm('Återkalla Riksinstruktör-certifieringen för ' + revoke.dataset.name + '?')) return;
            var reason = prompt('Anledning (frivilligt):') || null;
            fetch('/umbraco/surface/Certification/Revoke', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({ certId: parseInt(revoke.dataset.certId, 10), reason: reason })
            }).then(function (r) { return r.json(); }).then(function (resp) {
                if (!resp.success) alert(resp.message || 'Kunde inte återkalla');
                loadAll();
            });
            return;
        }
        var unappoint = ev.target.closest('.riks-unappoint-btn');
        if (unappoint) {
            ev.preventDefault();
            if (!confirm('Ta bort utnämningen som Riksinstruktör för ' + unappoint.dataset.name + ' i område ' + unappoint.dataset.area + '? Certifieringen behålls.')) return;
            fetch('/umbraco/surface/Certification/Unappoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
                body: JSON.stringify({
                    memberId: parseInt(unappoint.dataset.memberId, 10),
                    certificationType: 'Riksinstruktor',
                    scopeId: unappoint.dataset.area
                })
            }).then(function (r) { return r.json(); }).then(function (resp) {
                if (!resp.success) alert(resp.message || 'Kunde inte ta bort utnämningen');
                loadAll();
            });
        }
    });

    loadAll();
})();
</script>
