@{
    var clubId = ViewBag.clubId as int? ?? 0;
}
@*
    Klubbkalendern. ⚠️ SAMMA FORM SOM KRETSKALENDERN (Stefan 2026-10-05): rubrikrad med ‹ månad ›
    och I dag, segmentknappen Månad | Lista, filtren som switchar, färgrutor som förklaring, tätt
    rutnät med en etikett per händelse, dagvy under rutnätet och listvy över tolv månader. Stilen och
    helgdagarna bor i _CalendarShared och delas med _KretsCalendar — skriv inte en egen kopia här.

    Id:n bär prefixet "cc" så att de aldrig krockar med kretskalendern (kc/kcp/kcc), som kan stå
    på samma sida (klubbens adminpanel → Kretskalender).

    Data: Club/GetUpcomingEvents (klubbens händelser, träningar, tävlingar och kretsens händelser),
    filtrerat i webbläsaren per sort (scope). En träning har url "#training-{id}", som
    _TrainingPanelModal fångar och öppnar i panelen.
*@
@await Html.PartialAsync("_HtmlEscape")
@await Html.PartialAsync("_EventBadges")
@await Html.PartialAsync("_TrainingPanelModal")
@await Html.PartialAsync("_CalendarShared")

<style>
    /* Lägg in träningar: dagarna går att klicka på för att lägga in en kopia. */
    .cal-copy-mode .kc-day:not(.cc-past) { cursor: copy; }
    .cal-copy-mode .kc-day:not(.cc-past):hover { outline: 2px solid var(--bs-primary); outline-offset: -2px; }
    .cc-day-card .cc-row { padding: .5rem 0; border-top: 1px solid var(--bs-border-color); }
    .cc-day-card .cc-row:first-of-type { border-top: 0; }
</style>

<div class="club-calendar kc-wrap" id="ccRoot" data-club-id="@clubId">
    <div class="kc-head">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="ccPrev" aria-label="Föregående"><i class="bi bi-chevron-left"></i></button>
        <h3 id="ccTitle" aria-live="polite"></h3>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="ccNext" aria-label="Nästa"><i class="bi bi-chevron-right"></i></button>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="ccToday">I dag</button>
        <div class="btn-group btn-group-sm ms-auto" role="group" aria-label="Visning">
            <button type="button" class="btn btn-outline-primary active" id="ccMonthBtn">Månad</button>
            <button type="button" class="btn btn-outline-primary" id="ccListBtn">Lista</button>
        </div>
        <div class="form-check form-switch ms-2 mb-0">
            <input class="form-check-input" type="checkbox" role="switch" id="ccHolidays">
            <label class="form-check-label small" for="ccHolidays">Visa helgdagar</label>
        </div>
    </div>

    @* Vad kalendern visar. Varje sort är en switch med sin färg intill — förklaringen och filtret
       är samma rad, så en sort som är avslagen syns som avslagen där man läser vad färgen betyder. *@
    <div class="kc-legend mb-2 d-flex flex-wrap align-items-center gap-1" id="ccScopeBar" aria-label="Visa i kalendern">
        <div class="form-check form-switch mb-0 me-2">
            <input class="form-check-input" type="checkbox" role="switch" id="ccScope-training" data-cal-scope="training">
            <label class="form-check-label small" for="ccScope-training"><i class="sw kc-s-traning me-1"></i>Träningar</label>
        </div>
        <div class="form-check form-switch mb-0 me-2">
            <input class="form-check-input" type="checkbox" role="switch" id="ccScope-competition" data-cal-scope="competition">
            <label class="form-check-label small" for="ccScope-competition"><i class="sw kc-s-tavling me-1"></i>Tävlingar</label>
        </div>
        <div class="form-check form-switch mb-0 me-2">
            <input class="form-check-input" type="checkbox" role="switch" id="ccScope-club" data-cal-scope="club">
            <label class="form-check-label small" for="ccScope-club"><i class="sw kc-s-handelse me-1"></i>Övrigt i klubben</label>
        </div>
        <div class="form-check form-switch mb-0 me-2">
            <input class="form-check-input" type="checkbox" role="switch" id="ccScope-outside" data-cal-scope="outside">
            <label class="form-check-label small" for="ccScope-outside" title="Kretsens händelser och andra klubbars öppna tävlingar"><i class="sw kc-s-utanfor me-1"></i>Utanför klubben</label>
        </div>
        <span class="small text-muted ms-auto" id="calHiddenNote"></span>
    </div>

    <!-- Lägg in träningar dag för dag (klubbadmin, från träningens meny under Admin → Träningar) -->
    <div class="alert alert-primary d-none" id="calCopyBar" role="region" aria-label="Lägg in träningar">
        <div class="fw-semibold mb-1"><i class="bi bi-calendar-plus me-1"></i>Lägg in träningar dag för dag</div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <label class="small mb-0" for="calCopySource">Träning att kopiera</label>
            <select class="form-select form-select-sm w-auto" id="calCopySource"></select>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="calCopyUndo" disabled>Ångra senaste</button>
            <button type="button" class="btn btn-sm btn-primary ms-auto" id="calCopyDone">Klar</button>
        </div>
        <div class="small mt-2">Klicka på en dag i kalendern så läggs träningen in där. Varje klick sparas direkt — allt utom datumet kommer från träningen du valt.</div>
        <div class="small mt-1 fw-semibold" id="calCopyMsg" aria-live="polite"></div>
    </div>

    <div id="ccBody"><div class="text-muted small">Hämtar…</div></div>
    <div id="ccDay" class="mt-3"></div>
</div>

<script>
(function () {
    const root = document.getElementById('ccRoot');
    if (!root || root.dataset.ccInit) return;
    root.dataset.ccInit = '1';
    const CLUB_ID = parseInt(root.dataset.clubId, 10) || 0;
    const $ = id => document.getElementById(id);
    const esc = s => window.hpskEsc(s == null ? '' : String(s));
    const MONTHS = ['januari', 'februari', 'mars', 'april', 'maj', 'juni', 'juli', 'augusti', 'september', 'oktober', 'november', 'december'];
    const DOW = ['Mån', 'Tis', 'Ons', 'Tor', 'Fre', 'Lör', 'Sön'];
    const pad = n => String(n).padStart(2, '0');
    const key = d => d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    const cap = s => s.charAt(0).toUpperCase() + s.slice(1);

    const pref = (k, d) => { try { return localStorage.getItem('cc_' + k) ?? d; } catch (e) { return d; } };
    const setPref = (k, v) => { try { localStorage.setItem('cc_' + k, v); } catch (e) { } };

    // På en smal skärm får en dagruta inte plats med ett namn — där är listan förvald, tills
    // medlemmen själv väljer vy.
    let view = pref('view', window.innerWidth < 768 ? 'list' : 'month') === 'list' ? 'list' : 'month';
    // Beskrivningen är formaterad text (RTE). Visa den som REN text: DOMParser kör varken skript
    // eller händelseattribut, till skillnad från innerHTML på ett lösryckt element.
    const plain = html => {
        if (!html) return '';
        try { return (new DOMParser().parseFromString(String(html), 'text/html').body.textContent || '').trim(); }
        catch (e) { return String(html); }
    };
    let cursor = new Date(); cursor.setDate(1);
    let all = null;          // allt servern skickade
    let shown = [];          // efter filtret
    let selectedDay = null;
    $('ccHolidays').checked = pref('holidays', '0') === '1';

    const holidayOn = k => $('ccHolidays').checked ? (window.hpskSwedishHolidays(parseInt(k.slice(0, 4), 10))[k] || '') : '';

    // ── Filtret ─────────────────────────────────────────────────────────────────────────────
    // ⚠️ Valet sparas under samma nyckel som förut, så en medlem behåller sitt val. Strängarna
    // speglar CalendarScope* i ClubController. Förval = allt i egna klubben.
    const SCOPE_KEY = 'hpsk_cal_scopes';
    const SCOPE_DEFAULT = ['training', 'competition', 'club'];
    function readScopes() {
        try { const v = JSON.parse(localStorage.getItem(SCOPE_KEY)); if (Array.isArray(v)) return new Set(v); } catch (e) { }
        return new Set(SCOPE_DEFAULT);
    }
    const scopeOf = e => e.scope || (e.type === 'Tävling' ? 'competition' : 'club');
    function applyScopes() {
        const scopes = readScopes();
        root.querySelectorAll('[data-cal-scope]').forEach(c => { c.checked = scopes.has(c.dataset.calScope); });
        shown = (all || []).filter(e => scopes.has(scopeOf(e)));
        updateHiddenNote();
    }
    // Ett filter som tyst gömmer saker läses som "min tävling är borta" — säg hur många som döljs.
    function updateHiddenNote() {
        const note = $('calHiddenNote');
        if (!note || !all) return;
        const [f, t] = range();
        const inRange = list => list.filter(e => e.k >= key(f) && e.k <= key(t)).length;
        const hidden = inRange(all) - inRange(shown);
        note.textContent = hidden > 0 ? hidden + ' dold' + (hidden === 1 ? '' : 'a') + ' av filtret' : '';
    }

    // ── Data ────────────────────────────────────────────────────────────────────────────────
    // API:t skickar datumet utan tidszon ("2026-10-03T18:30:00") — de tio första tecknen är dagen.
    // `new Date(...).toISOString()` går via UTC och flyttar en svensk midnatt till dagen innan.
    function dateKeyOf(raw) {
        if (typeof raw === 'string' && /^\d{4}-\d{2}-\d{2}/.test(raw)) return raw.slice(0, 10);
        return key(new Date(raw));
    }
    function timeOf(raw) {
        const m = typeof raw === 'string' ? raw.match(/T(\d{2}):(\d{2})/) : null;
        return m && !(m[1] === '00' && m[2] === '00') ? m[1] + ':' + m[2] : '';
    }
    function load() {
        if (!(CLUB_ID > 0)) return Promise.resolve();
        return fetch('/umbraco/surface/Club/GetUpcomingEvents?clubId=' + CLUB_ID + '&allYears=true', { credentials: 'same-origin' })
            .then(r => r.json())
            .then(d => {
                if (!d.success) { $('ccBody').innerHTML = '<div class="text-danger small">Kalendern kunde inte hämtas.</div>'; return; }
                all = (d.data || []).map(e => ({
                    ...e,
                    // Kretsens händelser bär sin ägare i namnet, annars ser de ut som klubbens egna.
                    name: e.owner ? (e.name || e.type) + ' (' + e.owner + ')' : (e.name || e.type),
                    k: dateKeyOf(e.date),
                    time: timeOf(e.date)
                })).sort((a, b) => (a.k + a.time).localeCompare(b.k + b.time));
                window.allCalendarEvents = all;
                applyScopes();
                render();
            })
            .catch(() => { $('ccBody').innerHTML = '<div class="text-danger small">Kalendern kunde inte hämtas.</div>'; });
    }
    window.loadCalendarData = load;   // dag-för-dag-läget läser om efter varje kopia

    function range() {
        if (view === 'list') return [new Date(cursor.getFullYear(), cursor.getMonth(), 1), new Date(cursor.getFullYear(), cursor.getMonth() + 12, 0)];
        const first = new Date(cursor.getFullYear(), cursor.getMonth(), 1);
        const start = new Date(first); start.setDate(first.getDate() - ((first.getDay() + 6) % 7));
        const last = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0);
        const end = new Date(last); end.setDate(last.getDate() + (6 - ((last.getDay() + 6) % 7)));
        return [start, end];
    }

    // ── Ritning ─────────────────────────────────────────────────────────────────────────────
    const statusClass = e => {
        const s = scopeOf(e);
        return s === 'training' ? 'kc-s-traning' : s === 'competition' ? 'kc-s-tavling' : s === 'outside' ? 'kc-s-utanfor' : 'kc-s-handelse';
    };
    // ⚠️ VARJE ETIKETT ÄR SIN EGEN LÄNK. Rapporterat flera gånger som "kalendern är trasig": ett
    // klick på händelsen i rutan fällde bara ut dagen längre ner. Etiketten ser klickbar ut, så den
    // är en länk — och klicket stannar där (dagrutans lyssnare hoppar över länkar).
    function chip(e) {
        const mand = e.isMandatory ? '<i class="bi bi-exclamation-triangle-fill text-warning me-1" aria-hidden="true"></i>' : '';
        const label = (e.time ? e.time + ' ' : '') + e.name;
        const title = (e.isMandatory ? 'Obligatorisk: ' : '') + label + (e.type ? ' · ' + e.type : '');
        const cls = 'kc-chip ' + statusClass(e) + (e.isCancelled ? ' kc-cancelled' : '');
        return e.url
            ? '<a class="' + cls + '" href="' + esc(e.url) + '" title="' + esc(title) + '">' + mand + esc(label) + '</a>'
            : '<span class="' + cls + '" title="' + esc(title) + '">' + mand + esc(label) + '</span>';
    }
    function render() {
        $('ccTitle').textContent = view === 'list'
            ? 'Från ' + MONTHS[cursor.getMonth()] + ' ' + cursor.getFullYear()
            : cap(MONTHS[cursor.getMonth()]) + ' ' + cursor.getFullYear();
        if (!all) return;
        updateHiddenNote();
        view === 'list' ? renderList() : renderMonth();
    }
    function renderMonth() {
        const [f, t] = range();
        const today = key(new Date());
        let html = '<div class="kc-grid" id="ccGrid">' + DOW.map(d => '<div class="kc-dow">' + d + '</div>').join('');
        for (let d = new Date(f); d <= t; d.setDate(d.getDate() + 1)) {
            const k = key(d);
            const items = shown.filter(e => e.k === k);
            const other = d.getMonth() !== cursor.getMonth();
            const hol = holidayOn(k);
            html += '<div class="kc-day' + (other ? ' kc-other' : '') + (k === today ? ' kc-today' : '') + (k < today ? ' cc-past' : '')
                + (hol ? ' kc-holiday' : '') + (k === selectedDay ? ' kc-selected' : '')
                + '" tabindex="0" role="button" data-cc-day="' + k + '" aria-label="' + d.getDate() + ' ' + MONTHS[d.getMonth()]
                + (hol ? ', ' + esc(hol) : '') + (items.length ? ', ' + items.length + ' poster' : '') + '">'
                + '<span class="kc-num">' + d.getDate() + '</span>'
                + (hol ? '<span class="kc-hol" title="' + esc(hol) + '">' + esc(hol) + '</span>' : '')
                + items.slice(0, 3).map(chip).join('')
                + (items.length > 3 ? '<span class="kc-chip">+' + (items.length - 3) + ' till</span>' : '')
                + '</div>';
        }
        $('ccBody').innerHTML = html + '</div>';
    }
    function details(e) {
        const name = e.url ? '<a href="' + esc(e.url) + '">' + esc(e.name) + '</a>' : esc(e.name);
        const meta = [e.time, e.venue ? '<i class="bi bi-geo-alt me-1"></i>' + esc(e.venue) : '', e.contactPerson ? '<i class="bi bi-person me-1"></i>' + esc(e.contactPerson) : '']
            .filter(Boolean).join(' · ');
        return '<div><span class="kc-chip ' + statusClass(e) + ' d-inline-block me-1">' + esc(e.type || '') + '</span>' + name
            + (typeof window.hpskEventBadges === 'function' ? window.hpskEventBadges(e) : '') + '</div>'
            + (meta ? '<div class="small text-muted">' + meta + '</div>' : '')
            + (plain(e.description) ? '<div class="small text-muted mt-1">' + esc(plain(e.description)) + '</div>' : '');
    }
    function renderList() {
        const [f, t] = range();
        const items = shown.filter(e => e.k >= key(f) && e.k <= key(t)).map(e => ({ ...e }));
        if ($('ccHolidays').checked) {
            for (let y = f.getFullYear(); y <= t.getFullYear(); y++)
                Object.entries(window.hpskSwedishHolidays(y)).forEach(([k, name]) => {
                    if (k >= key(f) && k <= key(t)) items.push({ holiday: true, k: k, name: name, time: '' });
                });
        }
        items.sort((a, b) => (a.k + a.time).localeCompare(b.k + b.time));
        if (!items.length) { $('ccBody').innerHTML = '<div class="text-muted">Inget i kalendern de kommande tolv månaderna.</div>'; return; }
        let html = '', lastMonth = '';
        items.forEach(e => {
            const m = e.k.slice(0, 7);
            if (m !== lastMonth) {
                const [y, mo] = m.split('-');
                html += '<div class="kc-list-month">' + cap(MONTHS[parseInt(mo, 10) - 1]) + ' ' + y + '</div>';
                lastMonth = m;
            }
            const d = new Date(e.k + 'T12:00:00');
            const dateText = d.toLocaleDateString('sv-SE', { weekday: 'short', day: 'numeric', month: 'short' }).replace(/\.$/, '');
            html += e.holiday
                ? '<div class="kc-list-row kc-holiday-row"><div class="kc-list-date">' + esc(dateText) + '</div><div class="flex-grow-1"><i class="bi bi-flag me-1"></i>' + esc(e.name) + '</div></div>'
                : '<div class="kc-list-row"><div class="kc-list-date">' + esc(dateText) + '</div><div class="flex-grow-1">' + details(e) + '</div></div>';
        });
        $('ccBody').innerHTML = '<div id="ccList">' + html + '</div>';
    }
    function showDay(k) {
        if (window.hpskCalCopyActive && window.hpskCalCopyActive()) { window.hpskCalCopyToDay(k); return; }
        const items = shown.filter(e => e.k === k);
        const [y, mo, d] = k.split('-');
        const hol = holidayOn(k);
        let html = '<div class="card border-primary cc-day-card"><div class="card-body"><h4 class="h6 mb-2">'
            + cap(new Date(k + 'T12:00:00').toLocaleDateString('sv-SE', { weekday: 'long' })) + ' ' + parseInt(d, 10) + ' ' + MONTHS[parseInt(mo, 10) - 1] + ' ' + y
            + (hol ? ' <span class="small fw-normal kc-hol d-inline">— ' + esc(hol) + '</span>' : '') + '</h4>';
        html += items.length ? items.map(e => '<div class="cc-row">' + details(e) + '</div>').join('') : '<div class="text-muted small">Inget den dagen.</div>';
        $('ccDay').innerHTML = html + '</div></div>';
        selectedDay = k;
        root.querySelectorAll('.kc-day.kc-selected').forEach(x => x.classList.remove('kc-selected'));
        const cell = root.querySelector('[data-cc-day="' + k + '"]');
        if (cell) cell.classList.add('kc-selected');
        // ⚠️ Dagvyn står under rutnätet, ofta nedanför skärmkanten — utan rullningen ser ett klick
        // på en dag ut att inte göra någonting.
        const card = $('ccDay').firstElementChild;
        if (card) {
            const r = card.getBoundingClientRect();
            if (r.top < 0 || r.bottom > window.innerHeight) card.scrollIntoView({ behavior: 'smooth', block: r.height > window.innerHeight ? 'start' : 'nearest' });
        }
    }

    // ── Händelser ───────────────────────────────────────────────────────────────────────────
    root.addEventListener('click', function (e) {
        if (e.target.closest('a')) return;   // etiketten är en egen länk
        const day = e.target.closest('[data-cc-day]');
        if (day) showDay(day.dataset.ccDay);
    });
    root.addEventListener('keydown', function (e) {
        const day = e.target.closest && e.target.closest('[data-cc-day]');
        if (day && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); showDay(day.dataset.ccDay); }
    });
    root.addEventListener('change', function (e) {
        const c = e.target.closest('[data-cal-scope]');
        if (!c) return;
        const scopes = readScopes();
        if (c.checked) scopes.add(c.dataset.calScope); else scopes.delete(c.dataset.calScope);
        try { localStorage.setItem(SCOPE_KEY, JSON.stringify([...scopes])); } catch (err) { }
        applyScopes();
        $('ccDay').innerHTML = ''; selectedDay = null;
        render();
    });
    $('ccPrev').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() - 1); render(); });
    $('ccNext').addEventListener('click', () => { cursor.setMonth(cursor.getMonth() + 1); render(); });
    $('ccToday').addEventListener('click', () => { cursor = new Date(); cursor.setDate(1); render(); });
    function setView(v, remember) {
        view = v;
        if (remember !== false) setPref('view', v);
        $('ccMonthBtn').classList.toggle('active', v === 'month');
        $('ccListBtn').classList.toggle('active', v === 'list');
        $('ccDay').innerHTML = ''; selectedDay = null;
        render();
    }
    window.hpskClubCalendarSetView = setView;
    $('ccMonthBtn').addEventListener('click', () => setView('month'));
    $('ccListBtn').addEventListener('click', () => setView('list'));
    // Helgdagarna räknas i webbläsaren — ingen ny hämtning, bara en ny ritning.
    $('ccHolidays').addEventListener('change', () => {
        setPref('holidays', $('ccHolidays').checked ? '1' : '0');
        render();
        if (selectedDay && $('ccDay').innerHTML) showDay(selectedDay);
    });

    setView(view, false);   // förvalet sparas inte — bara medlemmens eget val
    load();
})();

// ── Lägg in träningar dag för dag ─────────────────────────────────────────────────────────────
// Klubbadmin väljer en träning och klickar på dagar; varje klick skapar en kopia i samma serie
// (ClubTraining/CopyToDates). Startas från träningens meny under Admin → Träningar
// (window.hpskCalendarCopyMode) — kalendern har ingen egen knapp för det (Stefan 2026-10-05).
(function () {
    const root = document.getElementById('ccRoot');
    if (!root) return;
    const clubId = parseInt(root.dataset.clubId, 10) || 0;
    const calCopy = { on: false, sources: null, created: [] };
    const pad = n => String(n).padStart(2, '0');
    const today = () => { const d = new Date(); return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); };
    function token() { const el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
    function post(url, body) {
        return fetch(url, { method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() }, body: JSON.stringify(body) })
            .then(r => r.text()).then(t => { try { return JSON.parse(t); } catch (e) { return { success: false, message: 'Sidan har varit öppen för länge — ladda om och försök igen.' }; } });
    }
    function label(t) {
        const d = new Date(t.date + 'T12:00:00');
        // Seriens namn först: två serier kan ha träningar med samma namn.
        return (t.seriesName ? t.seriesName + ' — ' : '') + t.name + ' (' + d.toLocaleDateString('sv-SE', { weekday: 'short' }) + (t.startTime ? ' ' + t.startTime : '') + ')';
    }
    function loadSources() {
        return fetch('/umbraco/surface/ClubTraining/CopySources?clubId=' + clubId, { credentials: 'same-origin' })
            .then(r => r.ok ? r.json() : { success: false }).catch(() => ({ success: false }))
            .then(d => (calCopy.sources = (d && d.success) ? (d.trainings || []) : null));
    }
    function start(sourceId, scheduleId) {
        // Hämtas alltid på nytt — träningen kan just ha lagts in under Admin.
        loadSources().then(list => {
            if (!list || !list.length) { alert('Lägg först in en träning under Admin → Träningar. Den kopierar du sedan till fler dagar.'); return; }
            const sel = document.getElementById('calCopySource');
            sel.innerHTML = list.map(t => '<option value="' + t.id + '">' + window.hpskEsc(label(t)) + '</option>').join('');
            // Listan har en rad per serie (seriens senaste tillfälle) — matcha på id, annars på serien.
            const hit = list.find(t => t.id === sourceId) || (scheduleId ? list.find(t => t.scheduleId === scheduleId) : null);
            if (hit) sel.value = String(hit.id);
            calCopy.on = true; calCopy.created = [];
            document.getElementById('calCopyUndo').disabled = true;
            document.getElementById('calCopyMsg').textContent = '';
            document.getElementById('calCopyBar').classList.remove('d-none');
            root.classList.add('cal-copy-mode');
            if (window.hpskClubCalendarSetView) window.hpskClubCalendarSetView('month', false);
            document.getElementById('calCopyBar').scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    }
    function stop() {
        calCopy.on = false;
        document.getElementById('calCopyBar').classList.add('d-none');
        root.classList.remove('cal-copy-mode');
        if (typeof window.hpskLoadClubTrainings === 'function') window.hpskLoadClubTrainings();
    }
    function toDay(dateStr) {
        const msgEl = document.getElementById('calCopyMsg');
        if (dateStr < today()) { msgEl.textContent = 'Välj en dag från i dag och framåt.'; return; }
        const sourceId = parseInt(document.getElementById('calCopySource').value, 10) || 0;
        // "okt." bär redan en punkt — ta bort den så att meningen inte får två.
        const lbl = new Date(dateStr + 'T12:00:00').toLocaleDateString('sv-SE', { weekday: 'short', day: 'numeric', month: 'short' }).replace(/\.$/, '');
        msgEl.textContent = 'Lägger in ' + lbl + '…';
        post('/umbraco/surface/ClubTraining/CopyToDates', { sourceId: sourceId, dates: [dateStr] }).then(d => {
            if (d.success) {
                (d.createdIds || []).forEach(id => calCopy.created.push({ id: id, label: lbl }));
                document.getElementById('calCopyUndo').disabled = calCopy.created.length === 0;
                msgEl.textContent = 'Inlagd ' + lbl + '. Klicka på nästa dag, eller på Klar.';
                if (window.loadCalendarData) window.loadCalendarData();
            } else {
                msgEl.textContent = (d.skippedDates && d.skippedDates.length) ? 'Träningen finns redan ' + lbl + '.' : (d.message || 'Det gick inte att lägga in träningen.');
            }
        });
    }
    function undo() {
        const last = calCopy.created.pop();
        if (!last) return;
        const msgEl = document.getElementById('calCopyMsg');
        post('/umbraco/surface/ClubTraining/Delete', { trainingId: last.id }).then(d => {
            if (!d.success) { calCopy.created.push(last); msgEl.textContent = d.message || 'Det gick inte att ångra.'; return; }
            msgEl.textContent = 'Borttagen ' + last.label + '.';
            document.getElementById('calCopyUndo').disabled = calCopy.created.length === 0;
            if (window.loadCalendarData) window.loadCalendarData();
        });
    }
    // ⚠️ I läget betyder ett klick var som helst i dagrutan "lägg in här" — även på en etikett. Annars
    // öppnar ett klick på en dag som redan har en träning träningspanelen i stället. Panelens lyssnare
    // sitter i fångstfasen på document, så läget fångar klicket före den, på window.
    window.addEventListener('click', function (e) {
        if (!calCopy.on) return;
        const day = e.target.closest && e.target.closest('#ccRoot [data-cc-day]');
        if (!day) return;
        e.preventDefault();
        e.stopPropagation();
        toDay(day.dataset.ccDay);
    }, true);
    window.hpskCalCopyActive = () => calCopy.on;
    window.hpskCalCopyToDay = toDay;
    // Admin-panelens "Kopiera dag för dag i kalendern…" byter till kalenderfliken och startar läget.
    window.hpskCalendarCopyMode = function (trainingId, scheduleId) {
        const tabBtn = document.querySelector('[data-bs-target="#clubCalendar"]');
        if (tabBtn && window.bootstrap) bootstrap.Tab.getOrCreateInstance(tabBtn).show();
        start(trainingId, scheduleId);
    };
    document.getElementById('calCopyDone').addEventListener('click', stop);
    document.getElementById('calCopyUndo').addEventListener('click', undo);
})();
</script>
