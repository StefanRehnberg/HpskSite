// ========== MEMBER EDIT FUNCTIONS ==========

// Store data for edit modal
let editMemberAvailableClubs = [];
let editMemberAvailableGroups = [];
let editMemberCurrentMemberId = null;
let editMemberIsSiteAdmin = false;
let editMemberPreservedAdminGroups = []; // Preserve ClubAdmin_* and RegionalAdmin_* groups on save

// Initialize edit member data (load clubs and groups)
async function initEditMemberData() {
    // Load clubs and member groups in parallel for faster loading
    // Use GetClubsForRegistration (public) so club admins can populate the club dropdown
    const [clubsResult, groupsResult] = await Promise.allSettled([
        fetch('/umbraco/surface/ClubAdmin/GetClubsForRegistration').then(r => r.json()),
        fetch('/umbraco/surface/MemberAdmin/GetMemberGroups').then(r => r.json())
    ]);

    // Process clubs result
    if (clubsResult.status === 'fulfilled' && clubsResult.value.success) {
        editMemberAvailableClubs = clubsResult.value.clubs || [];
    } else {
        console.error('Error loading clubs:', clubsResult.reason || 'Failed');
        editMemberAvailableClubs = [];
    }

    // Process groups result (may fail for non-site-admins, that's OK)
    if (groupsResult.status === 'fulfilled' && groupsResult.value.success) {
        editMemberAvailableGroups = groupsResult.value.data || [];
    } else {
        editMemberAvailableGroups = [];
    }
}

// Pre-load edit member data when page loads (runs in background)
document.addEventListener('DOMContentLoaded', function() {
    // Delay slightly to not block initial page render
    setTimeout(() => initEditMemberData(), 500);

    // Set up precision collapse event listeners once (not per member)
    const precisionCollapse = document.getElementById('editMemberPrecisionCollapse');
    const collapseIcon = document.getElementById('editMemberPrecisionCollapseIcon');

    if (precisionCollapse) {
        // Load handicap when expanded (only if not already loaded for this member)
        precisionCollapse.addEventListener('shown.bs.collapse', function() {
            if (precisionCollapse.dataset.handicapLoaded !== 'true' && editMemberCurrentMemberId) {
                precisionCollapse.dataset.handicapLoaded = 'true';
                loadEditMemberHandicapInfo(editMemberCurrentMemberId);
            }
        });

        // Update collapse icon
        precisionCollapse.addEventListener('show.bs.collapse', () => {
            collapseIcon.classList.remove('bi-chevron-right');
            collapseIcon.classList.add('bi-chevron-down');
        });
        precisionCollapse.addEventListener('hide.bs.collapse', () => {
            collapseIcon.classList.remove('bi-chevron-down');
            collapseIcon.classList.add('bi-chevron-right');
        });
    }
});

// Show/hide loading overlay
function showEditMemberLoading(show) {
    const overlay = document.getElementById('editMemberLoadingOverlay');
    overlay.style.display = show ? 'flex' : 'none';
    overlay.style.setProperty('display', show ? 'flex' : 'none', 'important');
}

// Main edit function
async function editClubMember(memberId) {
    editMemberCurrentMemberId = memberId;

    const modalEl = document.getElementById('editClubMemberModal');
    // Use getOrCreateInstance to avoid creating duplicate modal instances
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    // Reset form and show loading state
    document.getElementById('editClubMemberForm').reset();
    document.getElementById('editMemberId').value = memberId;
    showEditMemberLoading(true);
    modal.show();

    try {
        // Run member fetch and init data in parallel for faster loading
        const needsInit = editMemberAvailableClubs.length === 0;
        const memberPromise = fetch(`/umbraco/surface/MemberAdmin/GetMember?id=${memberId}`).then(r => {
            if (!r.ok) throw new Error(`HTTP error: ${r.status}`);
            return r.json();
        });

        // Wait for both in parallel if init is needed, otherwise just member
        if (needsInit) {
            await Promise.all([initEditMemberData(), memberPromise]);
        }

        const result = await memberPromise;

        showEditMemberLoading(false);

        if (result.success) {
            editMemberIsSiteAdmin = result.isSiteAdmin || false;
            populateEditMemberForm(result.data);
        } else {
            alert('Fel vid laddning av medlem: ' + (result.message || 'Okänt fel'));
            modal.hide();
        }
    } catch (error) {
        showEditMemberLoading(false);
        console.error('Error loading member:', error);
        alert('Kunde inte ladda medlemsdata: ' + error.message);
        modal.hide();
    }
}

// Populate form with member data
function populateEditMemberForm(member) {
    // Basic fields
    document.getElementById('editMemberId').value = member.id;
    document.getElementById('editMemberFirstName').value = member.firstName || '';
    document.getElementById('editMemberLastName').value = member.lastName || '';
    document.getElementById('editMemberEmail').value = member.email || '';
    document.getElementById('editMemberPhoneNumber').value = member.phoneNumber || '';
    document.getElementById('editMemberShooterIdNumber').value = member.shooterIdNumber || '';
    document.getElementById('editMemberAddress').value = member.address || '';
    document.getElementById('editMemberPostalCode').value = member.postalCode || '';
    document.getElementById('editMemberCity').value = member.city || '';
    document.getElementById('editMemberPersonNumber').value = member.personNumber || '';
    document.getElementById('editMemberMemberSince').value = member.memberSince || '';
    document.getElementById('editMemberIsApproved').checked = member.isApproved;

    // Profile picture
    updateEditMemberProfilePicture(member.profilePictureUrl, member.firstName, member.lastName);

    // Primary club dropdown
    renderEditMemberPrimaryClub(member.primaryClubId);

    // Additional clubs
    renderEditMemberAdditionalClubs(member.additionalClubIds || []);

    // Preserve ClubAdmin_* and RegionalAdmin_* groups - these are filtered from the UI
    // but must be preserved when saving to prevent accidental removal of admin rights
    const memberGroups = member.groups || [];
    editMemberPreservedAdminGroups = memberGroups.filter(g =>
        g.startsWith('ClubAdmin_') || g.startsWith('RegionalAdmin_')
    );

    // Member groups (site admin only)
    if (editMemberIsSiteAdmin) {
        document.getElementById('editMemberGroupsSection').style.display = 'block';
        renderEditMemberGroups(memberGroups);
    } else {
        document.getElementById('editMemberGroupsSection').style.display = 'none';
    }

    // Show/hide site admin only features (delete button)
    document.getElementById('editMemberDeleteBtn').style.display = editMemberIsSiteAdmin ? 'block' : 'none';

    // Shooter class
    const shooterClassRadios = document.querySelectorAll('input[name="editMemberShooterClass"]');
    shooterClassRadios.forEach(radio => radio.checked = false);
    if (member.precisionShooterClass) {
        const radio = document.querySelector(`input[name="editMemberShooterClass"][value="${member.precisionShooterClass}"]`);
        if (radio) radio.checked = true;
    }

    // Reset precision collapse section - close it and clear old data
    const precisionCollapse = document.getElementById('editMemberPrecisionCollapse');
    const bsCollapse = bootstrap.Collapse.getInstance(precisionCollapse);
    if (bsCollapse) {
        bsCollapse.hide();
    }
    // Reset collapse icon
    const collapseIcon = document.getElementById('editMemberPrecisionCollapseIcon');
    collapseIcon.classList.remove('bi-chevron-down');
    collapseIcon.classList.add('bi-chevron-right');

    // Clear old handicap data
    document.getElementById('editMemberHandicapInfoContainer').innerHTML =
        '<div class="text-muted small">Expandera för att visa handicapinformation.</div>';

    // Mark that handicap needs to be loaded for this member
    precisionCollapse.dataset.handicapLoaded = 'false';
}

// Profile picture functions
