    const val = document.getElementById('deleteMemberConfirmInput').value.trim();
    document.getElementById('deleteMemberConfirmBtn').disabled = (val !== 'RADERA');
}

// Actually perform the irreversible delete (member + all related data).
async function confirmDeleteMemberPermanently() {
    const memberId = document.getElementById('editMemberId').value;
    if (!memberId) return;
    if (document.getElementById('deleteMemberConfirmInput').value.trim() !== 'RADERA') return;

    const btn = document.getElementById('deleteMemberConfirmBtn');
    const orig = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Raderar...';

    try {
        const formData = new FormData();
        formData.append('memberId', memberId); // MemberAdmin/DeleteMember binds "memberId", not "id"
        const token = getAntiForgeryToken();
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        const response = await fetch('/umbraco/surface/MemberAdmin/DeleteMember', {
            method: 'POST',
            body: formData
        });
        const result = await response.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('deleteMemberConfirmModal'))?.hide();
            bootstrap.Modal.getInstance(document.getElementById('editClubMemberModal'))?.hide();
            loadClubMembers();
            alert('Medlem och all kopplad data raderad.');
        } else {
            btn.disabled = false;
            btn.innerHTML = orig;
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        btn.disabled = false;
        btn.innerHTML = orig;
        console.error('Delete error:', error);
        alert('Kunde inte ta bort medlem: ' + error.message);
    }
}

