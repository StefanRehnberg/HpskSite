}

async function editClubTrainingGroup(groupId) {
    const group = clubTrainingGroups.find(g => g.id === groupId);
    if (!group) return;

    document.getElementById('clubTrainingGroupModalTitle').textContent = 'Redigera Träningsgrupp';
    document.getElementById('clubTgId').value = groupId;
    document.getElementById('clubTgName').value = group.name;
    document.getElementById('clubTgDescription').value = group.description || '';
    document.getElementById('clubTgIsActiveGroup').classList.remove('d-none');
    document.getElementById('clubTgIsActive').checked = group.isActive;
    const fpInstance = document.getElementById('clubTgStartDate')._flatpickr;
    if (fpInstance) fpInstance.setDate(group.startDate);
    new bootstrap.Modal(document.getElementById('clubTrainingGroupModal')).show();
}

async function submitClubTrainingGroup() {
    const id = document.getElementById('clubTgId').value;
    const name = document.getElementById('clubTgName').value.trim();
    const description = document.getElementById('clubTgDescription').value.trim();
    const startDate = document.getElementById('clubTgStartDate').value;

    if (!name) { alert('Namn krävs'); return; }
    if (!startDate) { alert('Startdatum krävs'); return; }

    const token = getAntiForgeryToken();
    const formData = new FormData();
    formData.append('__RequestVerificationToken', token);
    formData.append('name', name);
    formData.append('description', description);
    formData.append('startDate', startDate);

    try {
        let url;
        if (id) {
            formData.append('trainingGroupId', id);
            formData.append('isActive', document.getElementById('clubTgIsActive').checked);
            url = '/umbraco/surface/TrainingGroup/UpdateTrainingGroup';
        } else {
            formData.append('clubId', clubId);
            url = '/umbraco/surface/TrainingGroup/CreateTrainingGroup';
        }

        const response = await fetch(url, { method: 'POST', body: formData });
        const result = await response.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('clubTrainingGroupModal')).hide();
            loadClubTrainingGroups();
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Error saving training group:', error);
        alert('Ett fel uppstod');
    }
}

async function deactivateClubTrainingGroup(groupId, groupName) {
    if (!confirm(`Vill du ta bort träningsgruppen "${groupName}"?`)) return;

    const token = getAntiForgeryToken();
    const formData = new FormData();
    formData.append('__RequestVerificationToken', token);
    formData.append('trainingGroupId', groupId);

    try {
        const response = await fetch('/umbraco/surface/TrainingGroup/DeactivateTrainingGroup', {
            method: 'POST', body: formData
        });
        const result = await response.json();

        if (result.success) {
            expandedClubTgId = null;
            loadClubTrainingGroups();
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Error deactivating training group:', error);
        alert('Ett fel uppstod');
    }
}

function showAddClubTgMemberModal(groupId) {
    document.getElementById('clubTgAddGroupId').value = groupId;
    document.getElementById('clubTgMemberSearch').value = '';
    document.getElementById('clubTgMemberSearchResults').innerHTML = '';
    document.getElementById('clubTgSelectedMember').classList.add('d-none');
    document.getElementById('clubTgSelectedMemberId').value = '';
    document.getElementById('clubTgMemberRole').value = 'Member';
    document.getElementById('clubTgSendEmail').checked = false;
    new bootstrap.Modal(document.getElementById('clubTgAddMemberModal')).show();
}

function searchClubTgMembers() {
    clearTimeout(clubTgSearchTimeout);
    const query = document.getElementById('clubTgMemberSearch').value.trim();
    const resultsContainer = document.getElementById('clubTgMemberSearchResults');

    if (query.length < 2) {
        resultsContainer.innerHTML = '';
        return;
    }

    clubTgSearchTimeout = setTimeout(async () => {
        try {
            const response = await fetch(`/umbraco/surface/TrainingGroup/SearchMembers?query=${encodeURIComponent(query)}&clubId=${clubId}`);
            const result = await response.json();

            if (!result.success || !result.data || result.data.length === 0) {
                resultsContainer.innerHTML = '<div class="list-group-item text-muted small">Inga resultat</div>';
                return;
            }

            resultsContainer.innerHTML = result.data.map(m => `
                <button type="button" class="list-group-item list-group-item-action py-1" onclick="selectClubTgMember(${m.memberId}, '${(m.memberName || '').replace(/'/g, "\\'")}')">
                    <div class="d-flex justify-content-between">
                        <span>${m.memberName}</span>
                        <small class="text-muted">${m.clubName || ''}</small>
                    </div>
                    <small class="text-muted">${m.email || ''}</small>
                </button>
            `).join('');
        } catch (error) {
            console.error('Error searching members:', error);
            resultsContainer.innerHTML = '<div class="list-group-item text-danger small">Sökfel</div>';
        }
    }, 300);
}

function selectClubTgMember(memberId, memberName) {
    document.getElementById('clubTgSelectedMemberId').value = memberId;
    document.getElementById('clubTgSelectedMemberName').textContent = memberName;
    document.getElementById('clubTgSelectedMember').classList.remove('d-none');
    document.getElementById('clubTgMemberSearchResults').innerHTML = '';
