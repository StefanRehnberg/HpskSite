function renderClubMarken(members) {
    const content = document.getElementById('clubMarkenContent');
    if (members.length === 0) {
        content.innerHTML = '<div class="text-muted text-center py-4"><i class="bi bi-patch-check d-block" style="font-size:2rem;opacity:.4;"></i>Inga märken registrerade för valt år än. Skyttar dyker upp här när de skickat in serier (validera dem i kön ovan) eller när du tilldelat ett grundmärke via Detaljer.</div>';
        return;
    }
    let html = `<div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr>
            <th>Medlem</th><th>Grundmärke</th><th>Guldnr</th>
            <th class="text-center">Guldfodringar</th><th>Årtalsmärke</th><th class="text-center">Årets status</th><th></th>
        </tr></thead><tbody>`;
    members.forEach(m => {
        let statusCell;
        if (m.pending > 0) statusCell = `<span class="badge bg-warning text-dark" title="Väntar på signering">${m.pending} att signera</span>`;
        else if (m.thisYearFulfilled) statusCell = '<span class="badge bg-success-subtle text-success">Signerad</span>';
        else if ((m.qualifyingSeries || 0) > 0 || (m.speedSeries || 0) > 0)
            statusCell = `<span class="badge bg-info-subtle text-info" title="Framsteg mot årets guldfodring (godkända serier)">${m.qualifyingSeries || 0}/3 guldserier · ${m.speedSeries || 0}/3 snabb</span>`;
        else statusCell = '<span class="text-muted small">–</span>';
        const top = m.topLevel ? `<span class="badge bg-warning text-dark">${escapeMedalHtml(m.topLevel)}</span>` : '<span class="text-muted small">–</span>';
        html += `<tr>
            <td>${escapeMedalHtml(m.name)}</td>
            <td>${top}</td>
            <td>${escapeMedalHtml(m.guldNumber) || '<span class="text-muted small">–</span>'}</td>
            <td class="text-center">${m.fulfilledYears}</td>
            <td class="small">${escapeMedalHtml(m.artalsmarke) || '<span class="text-muted">–</span>'}</td>
            <td class="text-center">${statusCell}</td>
            <td class="text-end"><button class="btn btn-sm btn-outline-primary" onclick="openMemberMarkenDetail(${m.memberId}, '${escapeMedalAttr(m.name)}')"><i class="bi bi-list-ul me-1"></i>Detaljer</button></td>
        </tr>`;
    });
    html += '</tbody></table></div>';
    content.innerHTML = html;
}

function openMemberMarkenDetail(memberId, name) {
