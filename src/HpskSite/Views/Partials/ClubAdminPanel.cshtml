// Copy club competition using CopyCompetition endpoint (server-side copy with +1 year dates)
function copyClubCompetition(competitionId, competitionType) {
    if (!confirm('Kopiera tävlingen? Datum flyttas fram ett år.')) return;

    const token = getAntiForgeryToken();

    fetch('/umbraco/surface/CompetitionAdmin/CopyCompetition', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({ sourceCompetitionId: competitionId })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('✅ Tävlingen har kopierats! Datum har flyttats fram ett år.');
            loadClubCompetitions();
        } else {
            alert('❌ Kunde inte kopiera: ' + (data.message || 'Okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error copying competition:', error);
        alert('❌ Fel vid kopiering av tävling');
    });
}

// Delete club competition
function deleteClubCompetition(competitionId, competitionName) {
    showDeleteConfirmation(competitionName, () => {
        const token = getAntiForgeryToken();
        const payload = {
            competitionId: competitionId
        };

        fetch('/umbraco/surface/CompetitionAdmin/DeleteCompetition', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            credentials: 'include',
            body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadClubCompetitions();
                alert('Tävling raderad!');
            } else {
                alert('Fel: ' + (data.message || 'Kunde inte radera tävlingen'));
            }
        })
        .catch(error => {
            console.error('Error deleting competition:', error);
            alert('Fel vid radering av tävling.');
        });
    });
}

