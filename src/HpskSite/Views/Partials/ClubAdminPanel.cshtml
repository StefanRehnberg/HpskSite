    if (query.length < 2) {
        resultsContainer.innerHTML = '';
        return;
    }

    clubTgSearchTimeout = setTimeout(async () => {
        try {
            const response = await fetch(`/umbraco/surface/TrainingGroup/SearchMembers?query=${encodeURIComponent(query)}&clubId=${clubId}`);
            const result = await response.json();

            if (!result.success || !result.data || result.data.length === 0) {
                resultsContainer.innerHTML = '<div class="list-group-item text-muted small">Inga resultat</div>';
                return;
