// ========== KLUBBADMINS MANAGEMENT ==========
// Mirrors the Skjutledare flow above. Distinct from skjutledare because the
// underlying group is ClubAdmin_{clubId} rather than Skjutledare_{clubId} —
// and because removing the *last* admin would orphan the club, so we guard
// against that both client- and server-side.

let clubAdminsCache = []; // last loaded admin list — used for the last-admin guard

function showClubAdminsModal() {
    const modalElement = document.getElementById('clubAdminsModal');
    const modal = new bootstrap.Modal(modalElement);
    modal.show();
    loadClubAdmins();
}

async function loadClubAdmins() {
    const listEl = document.getElementById('clubAdminsList');
    try {
        const res = await fetch(`/umbraco/surface/ClubAdmin/GetClubAdmins?clubId=${clubId}`);
        const data = await res.json();
        if (!data.success) {
            listEl.innerHTML = '<div class="text-danger">Kunde inte ladda klubbadmins</div>';
            return;
        }
        // GetClubAdmins returns { success, admins: [...] } — different shape from
        // GetSkjutledare which uses { success, data: [...] }.
        const admins = data.admins || [];
        clubAdminsCache = admins;

        if (admins.length === 0) {
            listEl.innerHTML = '<div class="text-warning">Inga klubbadmins tilldelade — klubben kan inte hanteras förrän någon utses.</div>';
        } else {
            listEl.innerHTML = admins.map(a => {
                // Disable the remove button when this is the last admin standing.
                const isLast = admins.length === 1;
                const removeBtn = isLast
                    ? `<button class="btn btn-sm btn-outline-secondary py-0 px-2" disabled title="Minst en klubbadmin måste finnas — lägg till en annan först">
                           <i class="bi bi-x-lg"></i>
                       </button>`
                    : `<button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeClubAdmin(${a.id}, ${JSON.stringify(a.name)})">
                           <i class="bi bi-x-lg"></i>
                       </button>`;
                return `
                    <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                        <div>
                            <i class="bi bi-person-gear text-warning me-2"></i>
                            <strong>${a.name}</strong>
                            <span class="text-muted ms-2 small">${a.email}</span>
                        </div>
                        ${removeBtn}
                    </div>
                `;
            }).join('');
        }
        loadClubAdminDropdown(admins.map(a => a.id));
    } catch (error) {
        console.error('Error loading club admins:', error);
        listEl.innerHTML = '<div class="text-danger">Fel vid laddning</div>';
    }
}

async function loadClubAdminDropdown(existingIds) {
    const select = document.getElementById('clubAdminSelect');
    try {
        // Scope to current club's members only — same pattern as Skjutledare's
        // GetClubMembers, but using the dedicated endpoint which also filters
        // out members who are already admins of this club.
        const res = await fetch(`/umbraco/surface/ClubAdmin/GetAvailableMembersForClubAdmin?clubId=${clubId}&filterClubId=${clubId}`);
        const data = await res.json();
        if (data.success && data.members) {
            select.innerHTML = '<option value="">Välj medlem...</option>';
            data.members.forEach(m => {
                if (!existingIds.includes(m.id)) {
                    const label = `${m.name || (m.firstName + ' ' + m.lastName)} (${m.email})`;
                    select.innerHTML += `<option value="${m.id}">${label}</option>`;
                }
            });
        }
    } catch (error) {
        console.error('Error loading members for club admin dropdown:', error);
    }
}

async function assignClubAdmin() {
    const select = document.getElementById('clubAdminSelect');
    const memberId = select.value;
    if (!memberId) {
        alert('Välj en medlem först');
        return;
    }
    try {
        const formData = new FormData();
        formData.append('memberId', memberId);
        formData.append('clubId', clubId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        const res = await fetch('/umbraco/surface/ClubAdmin/AssignClubAdmin', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (data.success) {
            loadClubAdmins();
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error assigning club admin:', error);
        alert('Ett fel uppstod');
    }
}

async function removeClubAdmin(memberId, name) {
    // Client-side guard: can't remove the last admin. (Mirrored server-side
    // for safety; this prompt just keeps the user honest before the round-trip.)
    if (clubAdminsCache.length <= 1) {
        alert('Minst en klubbadmin måste finnas — lägg till en annan först.');
        return;
    }
    if (!confirm(`Ta bort ${name} som klubbadmin?`)) return;
    try {
        const formData = new FormData();
        formData.append('memberId', memberId);
        formData.append('clubId', clubId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        const res = await fetch('/umbraco/surface/ClubAdmin/RemoveClubAdmin', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (data.success) {
            loadClubAdmins();
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error removing club admin:', error);
        alert('Ett fel uppstod');
    }
}

// ── Personuppgiftsbiträdesavtal (DPA) acceptance gate ─────────────────────────
async function loadDpaGate() {
    const gate = document.getElementById('dpaGate');
    if (!gate || !clubId) return;
    try {
        const res = await fetch(`/umbraco/surface/Dpa/GetDpaStatus?clubId=${clubId}`);
        const data = await res.json();
        if (!data.success) { gate.style.display = 'none'; return; }

        if (data.accepted) {
            // Approved: don't show a banner block. Populate the status dialog and reveal the
            // "Personuppgiftsbiträdesavtal" item in the Medlemmar → Åtgärder menu instead.
            gate.style.display = 'none';
            gate.innerHTML = '';
            const body = document.getElementById('dpaStatusModalBody');
            if (body) {
                body.innerHTML =
                    '<p class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>' +
                    'Personuppgiftsbiträdesavtalet (v' + escapeDpaHtml(data.acceptedVersion) + ') är godkänt' +
                    (data.acceptedDate ? ' ' + escapeDpaHtml(data.acceptedDate) : '') +
                    (data.acceptedByName ? ' av ' + escapeDpaHtml(data.acceptedByName) : '') + '.</p>' +
                    '<p class="mb-0 text-muted small">Avtalet reglerar hur Pistol.nu behandlar era medlemmars ' +
                    'personuppgifter åt klubben (GDPR art. 28).</p>';
            }
            document.querySelectorAll('.dpa-menu-el').forEach(el => el.style.display = '');
        } else {
            document.querySelectorAll('.dpa-menu-el').forEach(el => el.style.display = 'none');
            gate.className = 'alert alert-warning mb-4';
            gate.innerHTML =
                '<h6 class="mb-2"><i class="bi bi-exclamation-triangle me-2"></i>Godkänn personuppgiftsbiträdesavtalet</h6>' +
                '<p class="mb-2 small">Som administratör behöver du godkänna personuppgiftsbiträdesavtalet ' +
                '(GDPR art. 28) på klubbens vägnar. Det reglerar hur Pistol.nu behandlar era medlemmars ' +
                'personuppgifter åt klubben.</p>' +
                '<p class="mb-2 small text-muted">Genom att godkänna intygar du att du har behörighet att ' +
                'ingå avtalet för föreningens räkning. Det är föreningens ansvar att rätt person godkänner ' +
                '(t.ex. efter styrelsebeslut).</p>' +
                '<button type="button" class="btn btn-sm btn-outline-info me-2" data-bs-toggle="modal" data-bs-target="#dpaInfoModal">' +
                '<i class="bi bi-info-circle me-1"></i>Vad är detta?</button>' +
                '<a href="/personuppgiftsbitradesavtal" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-2">' +
                '<i class="bi bi-file-earmark-text me-1"></i>Granska avtalet</a>' +
                '<button type="button" class="btn btn-sm btn-primary" id="dpaAcceptBtn">' +
                '<i class="bi bi-check2-circle me-1"></i>Godkänn för klubben</button>';
            gate.style.display = '';
            const btn = document.getElementById('dpaAcceptBtn');
            if (btn) btn.addEventListener('click', acceptDpa);
        }
    } catch (e) {
        console.error('Error loading DPA gate:', e);
        gate.style.display = 'none';
    }
}

function escapeDpaHtml(s) {
    const d = document.createElement('div');
    d.textContent = s == null ? '' : String(s);
    return d.innerHTML;
}

async function acceptDpa() {
    const btn = document.getElementById('dpaAcceptBtn');
    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sparar...'; }
    try {
        const res = await fetch('/umbraco/surface/Dpa/AcceptDpa', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
            body: JSON.stringify({ clubId: clubId })
        });
        const data = await res.json();
        if (data.success) {
            loadDpaGate();
        } else {
            alert('Kunde inte godkänna avtalet: ' + (data.message || 'okänt fel'));
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Godkänn för klubben'; }
        }
    } catch (e) {
        console.error('Error accepting DPA:', e);
        alert('Ett fel uppstod');
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Godkänn för klubben'; }
    }
}

function showDpaStatusModal() {
    new bootstrap.Modal(document.getElementById('dpaStatusModal')).show();
}

// Small-screen section picker <-> Bootstrap tabs (rail is hidden < lg).
(function () {
    var sel = document.getElementById('adminTabMobileSelect');
    if (!sel) return;
    sel.addEventListener('change', function () {
        // A URL-valued option (e.g. Styrelsearbete) navigates away instead of switching a pane.
        if (sel.value && sel.value.charAt(0) !== '#') { window.location.href = sel.value; return; }
        var btn = document.querySelector('#adminTabs [data-bs-target="' + sel.value + '"]');
        if (btn && window.bootstrap) bootstrap.Tab.getOrCreateInstance(btn).show();
    });
    // Keep the picker's value in sync when a tab is shown any other way.
    document.querySelectorAll('#adminTabs [data-bs-toggle="tab"]').forEach(function (b) {
        b.addEventListener('shown.bs.tab', function (e) {
            var target = e.target.getAttribute('data-bs-target');
            if (target && sel.value !== target) sel.value = target;
        });
    });
})();

document.addEventListener('DOMContentLoaded', loadDpaGate);
</script>

