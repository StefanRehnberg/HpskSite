// Load Events
function loadEvents() {
    fetch(`/umbraco/surface/Club/GetClubEvents?clubId=${clubId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                displayEvents(data.data);
            } else {
                document.getElementById('eventsTableContainer').innerHTML =
                    '<div class="alert alert-warning">Inga händelser hittades.</div>';
            }
        })
        .catch(error => {
            console.error('Error loading events:', error);
            document.getElementById('eventsTableContainer').innerHTML =
                '<div class="alert alert-danger">Fel vid laddning av händelser.</div>';
        });
}

function displayEvents(events) {
    const container = document.getElementById('eventsTableContainer');

    // Store events globally for editing
    allEvents = events || [];

    if (!events || events.length === 0) {
        container.innerHTML = '<div class="alert alert-info">Inga händelser har skapats ännu.</div>';
        return;
    }

    let html = '<div class="table-responsive"><table class="table table-striped">';
    html += '<thead><tr><th>Namn</th><th>Typ</th><th>Datum</th><th>Plats</th><th>Åtgärder</th></tr></thead><tbody>';

    events.forEach(event => {
        const dateObj = event.date ? new Date(event.date) : null;
        const date = (dateObj && dateObj.getFullYear() > 1900) ? dateObj.toLocaleString('sv-SE') : '-';
        const color = eventTypeColors[event.type] || eventTypeColors.default;
        html += `
            <tr>
                <td><strong>${event.name}</strong></td>
                <td><span class="badge" style="background-color: ${color}">${event.type}</span>${hpskEventBadges(event)}</td>
                <td>${date}</td>
                <td>${event.venue || '-'}</td>
                <td class="text-end">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}'
                                aria-expanded="false" title="Åtgärder för ${event.name}">
                            <i class="bi bi-sliders me-2"></i>Åtgärder
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            ${event.url ? `<li><a class="dropdown-item" href="${event.url}">
                                <i class="bi bi-box-arrow-up-right me-2 text-secondary"></i>Gå till händelsen</a></li>` : ''}
                            <li><button class="dropdown-item" type="button" onclick="hpskOpenEventRoster(${event.id})">
                                <i class="bi bi-people me-2 text-success"></i>Deltagare och upprop</button></li>
                            <li><button class="dropdown-item" type="button" onclick="editEvent(${event.id})">
                                <i class="bi bi-pencil me-2 text-primary"></i>Redigera händelsen</button></li>
                            <li><button class="dropdown-item" type="button" onclick="copyEvent(${event.id})">
                                <i class="bi bi-copy me-2 text-info"></i>Kopiera till nästa vecka</button></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><button class="dropdown-item text-danger" type="button" onclick="deleteEvent(${event.id}, '${event.name}')">
                                <i class="bi bi-trash me-2"></i>Ta bort händelsen</button></li>
                        </ul>
                    </div>
                </td>
            </tr>
        `;
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
}

// Load Club Settings
function loadClubSettings() {
    fetch(`/umbraco/surface/Club/GetClubInfo?clubId=${clubId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.data) {
                // Contact Information
                document.getElementById('contactPerson').value = data.data.contactPerson || '';
                document.getElementById('contactEmail').value = data.data.contactEmail || '';
                document.getElementById('contactPhone').value = data.data.contactPhone || '';
                document.getElementById('webSite').value = data.data.webSite || '';

                // Address
                document.getElementById('address').value = data.data.address || '';
                document.getElementById('city').value = data.data.city || '';
                document.getElementById('postalCode').value = data.data.postalCode || '';
                document.getElementById('orgNumber').value = data.data.orgNumber || '';
                document.getElementById('receiptEmail').value = data.data.receiptEmail || '';

                // Betalningsuppgifter (Swish + bankgiro shown on the club's invoices)
                var clubSwishField = document.getElementById('clubSwishNumber');
                if (clubSwishField) clubSwishField.value = data.data.swishNumber || '';
                var clubBgField = document.getElementById('clubBgNumber');
                if (clubBgField) clubBgField.value = data.data.bgNumber || '';

                // Description
                document.getElementById('club_description').value = data.data.description || '';

                // Set About Club content - use CKEditor if initialized, otherwise textarea
                const aboutClubContent = data.data.aboutClub || '';
                if (aboutClubEditor) {
                    aboutClubEditor.setData(aboutClubContent);
                } else {
                    document.getElementById('aboutClub').value = aboutClubContent;
                }

                // Brevo API key
                var brevoField = document.getElementById('brevoApiKey');
                if (brevoField) brevoField.value = data.data.brevoApiKey || '';

                // Logo preview
                if (data.data.logoUrl) {
                    document.getElementById('clubLogoImg').src = data.data.logoUrl;
                    document.getElementById('clubLogoPreview').style.display = '';
                } else {
                    document.getElementById('clubLogoPreview').style.display = 'none';
                }

                // Banner preview
                if (data.data.bannerImageUrl) {
                    document.getElementById('clubBannerImg').src = data.data.bannerImageUrl;
                    document.getElementById('clubBannerPreview').style.display = '';
                } else {
                    document.getElementById('clubBannerPreview').style.display = 'none';
                }
            }
        })
        .catch(error => {
            console.error('Error loading club settings:', error);
        });
}

// Event Modal Functions
function slugify(text) {
    return text.toLowerCase()
        .replace(/å/g, 'a').replace(/ä/g, 'a').replace(/ö/g, 'o')
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
}

function updateEventUrlPreview() {
    var pageNameInput = document.getElementById('eventPageName');
    var nameInput = document.getElementById('eventName');
    var preview = document.getElementById('eventUrlPreview');
    var source = (pageNameInput.value || nameInput.value || '').trim();
    var slug = slugify(source) || '...';
    preview.textContent = '/' + slug;
}

function toggleEventPageName(e) {
    if (e) e.preventDefault();
    var group = document.getElementById('eventPageNameGroup');
    var toggle = document.getElementById('eventPageNameToggle');
    if (group.style.display === 'none') {
        group.style.display = '';
        toggle.textContent = 'Dölj sidnamn';
    } else {
        group.style.display = 'none';
        document.getElementById('eventPageName').value = '';
        updateEventUrlPreview();
        toggle.textContent = 'Ändra sidnamn';
    }
}

var knownEventTypes = ['Träning', 'Städning', 'Möte', 'Socialt', 'Nyhet'];

function onEventTypeChange() {
    var select = document.getElementById('eventType');
    var customInput = document.getElementById('eventCustomType');
    if (select.value === 'Annat') {
        customInput.style.display = '';
