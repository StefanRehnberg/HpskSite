@{
    var clubId = ViewBag.clubId as int? ?? 0;
    var clubName = ViewBag.clubName as string ?? "Club";
}

<!-- Flatpickr Date/Time Picker -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
@await Html.PartialAsync("_EventBadges")
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

@await Html.PartialAsync("_CompetitionTypeCatalogue")
@await Html.PartialAsync("_CompetitionListRenderer")
@* Delad renderare för aktivitetssammanställningen (medlemsdialogens intygsunderlag). *@
@await Html.PartialAsync("_MemberActivitySummary")

<div class="club-admin-panel">
    <!-- Personuppgiftsbiträdesavtal (DPA) acceptance gate — populated by loadDpaGate().
         Shown only while the DPA is NOT yet accepted. Once accepted, this stays hidden and the
         status moves into the Medlemmar → Åtgärder menu (#dpaStatusModal). -->
    <div id="dpaGate" class="mb-4" style="display:none;"></div>

    <!-- Plain-language "what is this" explanation for the DPA banner -->
    <div class="modal fade" id="dpaInfoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-info-circle me-2"></i>Vad är personuppgiftsbiträdesavtalet?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                </div>
                <div class="modal-body">
                    <p>Pistol.nu sparar uppgifter om er klubbs medlemmar – till exempel namn, e-post och tävlingsresultat – åt er.</p>
                    <p>Avtalet är vårt löfte om hur vi sköter de uppgifterna: vi använder dem bara för att få klubben att fungera, vi håller dem säkra, och vi säljer dem aldrig vidare.</p>
                    <p>Lagen (GDPR) säger att klubben måste ha ett sådant avtal med oss. När du klickar <strong>Godkänn</strong> säger du att klubben är okej med det. Det kostar inget och tar en sekund.</p>
                    <p class="mb-0 text-muted small">Bra att veta: det är klubbens ansvar att rätt person godkänner – helst någon i styrelsen.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- DPA status dialog — reached from Medlemmar → Åtgärder once the avtal is godkänt.
         Body is populated by loadDpaGate() with the current approval details. -->
    <div class="modal fade" id="dpaStatusModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-shield-check text-success me-2"></i>Personuppgiftsbiträdesavtal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                </div>
                <div class="modal-body" id="dpaStatusModalBody">
                    <!-- populated by loadDpaGate() -->
                </div>
                <div class="modal-footer">
                    <a href="/personuppgiftsbitradesavtal" target="_blank" rel="noopener" class="btn btn-outline-secondary">
                        <i class="bi bi-file-earmark-text me-1"></i>Läs avtalet
                    </a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Admin navigation — grouped vertical rail (≥lg) / grouped section picker (phones + tablets).
         Both drive the SAME Bootstrap tabs below; ids + data-bs-target are unchanged so all the
         existing shown.bs.tab lazy-loaders keep working. -->
    <div class="row g-3 admin-nav-layout">

        <!-- Small screens (< lg): full-width grouped section picker -->
        <div class="col-12 d-lg-none">
            <label for="adminTabMobileSelect" class="form-label small text-muted mb-1">Välj sektion</label>
            <select class="form-select" id="adminTabMobileSelect" aria-label="Välj adminsektion">
                <optgroup label="Kalender &amp; tävlingar">
                    <option value="#eventsTab" selected>Händelser</option>
                    <option value="#competitionsTab">Tävlingar</option>
                    <option value="#clubSeriesTab">Serier</option>
                </optgroup>
                <optgroup label="Medlemmar">
                    <option value="#membersTab">Medlemmar</option>
                    <option value="#clubActivityTab">Aktivitet &amp; Intyg</option>
                    <option value="#trainingGroupsTab">Träningsgrupper</option>
                    <option value="#certificationsTab">Certifieringar</option>
                </optgroup>
                <optgroup label="Utmärkelser">
                    <option value="#clubChampionsTab">Mästare</option>
                    <option value="#standardMedalsTab">Standardmedaljer</option>
                    <option value="#markenTab">Märken</option>
                </optgroup>
                <optgroup label="Klubben">
                    <option value="/styrelse?type=0&id=@clubId">Styrelsearbete ↗</option>
                    <option value="#invoicesTab">Fakturor</option>
                    <option value="#settingsTab">Inställningar</option>
                    <option value="#documentsTab">Dokument</option>
                    <option value="#clubStatsTab">Statistik</option>
                </optgroup>
            </select>
        </div>

        <!-- Large screens (≥ lg): grouped vertical rail -->
        <div class="col-lg-auto d-none d-lg-block">
            <nav class="nav nav-pills flex-column admin-rail" id="adminTabs" role="tablist" aria-orientation="vertical">
                <div class="admin-rail-group">Kalender &amp; tävlingar</div>
                <button class="nav-link active" id="events-tab" data-bs-toggle="tab" data-bs-target="#eventsTab" type="button" role="tab" aria-controls="eventsTab" aria-selected="true">
                    <i class="bi bi-calendar-event me-2"></i>Händelser
                </button>
                <button class="nav-link" id="competitions-tab" data-bs-toggle="tab" data-bs-target="#competitionsTab" type="button" role="tab" aria-controls="competitionsTab" aria-selected="false">
                    <i class="bi bi-trophy me-2"></i>Tävlingar
                </button>
                <button class="nav-link" id="clubseries-tab" data-bs-toggle="tab" data-bs-target="#clubSeriesTab" type="button" role="tab" aria-controls="clubSeriesTab" aria-selected="false">
                    <i class="bi bi-collection me-2"></i>Serier
                </button>

                <div class="admin-rail-group">Medlemmar</div>
                <button class="nav-link" id="members-tab" data-bs-toggle="tab" data-bs-target="#membersTab" type="button" role="tab" aria-controls="membersTab" aria-selected="false">
                    <i class="bi bi-people me-2"></i>Medlemmar
                </button>
                @* Direkt efter Medlemmar: det ar dar arbetet borjar (valj en medlem) och dit
                   medlemsmodalen lamnar over. *@
                <button class="nav-link" id="clubActivity-tab" data-bs-toggle="tab" data-bs-target="#clubActivityTab" type="button" role="tab" aria-controls="clubActivityTab" aria-selected="false">
                    <i class="bi bi-clipboard-check me-2"></i>Aktivitet &amp; Intyg
                </button>
                <button class="nav-link" id="traininggroups-tab" data-bs-toggle="tab" data-bs-target="#trainingGroupsTab" type="button" role="tab" aria-controls="trainingGroupsTab" aria-selected="false">
                    <i class="bi bi-people-fill me-2"></i>Träningsgrupper
                </button>
                <button class="nav-link" id="certifications-tab" data-bs-toggle="tab" data-bs-target="#certificationsTab" type="button" role="tab" aria-controls="certificationsTab" aria-selected="false">
                    <i class="bi bi-mortarboard me-2"></i>Certifieringar
                </button>

                <div class="admin-rail-group">Utmärkelser</div>
                <button class="nav-link" id="clubChampions-tab" data-bs-toggle="tab" data-bs-target="#clubChampionsTab" type="button" role="tab" aria-controls="clubChampionsTab" aria-selected="false">
                    <i class="bi bi-trophy-fill me-2"></i>Mästare
                </button>
                <button class="nav-link" id="standardMedals-tab" data-bs-toggle="tab" data-bs-target="#standardMedalsTab" type="button" role="tab" aria-controls="standardMedalsTab" aria-selected="false">
                    <i class="bi bi-award me-2"></i>Standardmedaljer
                </button>
                <button class="nav-link" id="marken-tab" data-bs-toggle="tab" data-bs-target="#markenTab" type="button" role="tab" aria-controls="markenTab" aria-selected="false">
                    <i class="bi bi-patch-check me-2"></i>Märken
                </button>

                <div class="admin-rail-group">Klubben</div>
                <a class="nav-link d-flex align-items-center" href="/styrelse?type=0&id=@clubId">
                    <i class="bi bi-clipboard-check me-2"></i>Styrelsearbete
                    <i class="bi bi-box-arrow-up-right ms-auto small opacity-75" title="Öppnar styrelsesidan"></i>
                </a>
                <button class="nav-link" id="invoices-tab" data-bs-toggle="tab" data-bs-target="#invoicesTab" type="button" role="tab" aria-controls="invoicesTab" aria-selected="false">
                    <i class="bi bi-receipt me-2"></i>Fakturor
                </button>
                <button class="nav-link" id="settings-tab" data-bs-toggle="tab" data-bs-target="#settingsTab" type="button" role="tab" aria-controls="settingsTab" aria-selected="false">
                    <i class="bi bi-gear me-2"></i>Inställningar
                </button>
                <button class="nav-link" id="documents-tab" data-bs-toggle="tab" data-bs-target="#documentsTab" type="button" role="tab" aria-controls="documentsTab" aria-selected="false">
                    <i class="bi bi-file-earmark-text me-2"></i>Dokument
                </button>
                <button class="nav-link" id="clubstats-tab" data-bs-toggle="tab" data-bs-target="#clubStatsTab" type="button" role="tab" aria-controls="clubStatsTab" aria-selected="false">
                    <i class="bi bi-graph-up me-2"></i>Statistik
                </button>
            </nav>
        </div>

        <!-- Tab Content -->
        <div class="col-lg">
            <div class="tab-content" id="adminTabContent">
        <!-- Events Tab -->
        <div class="tab-pane fade show active" id="eventsTab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Klubbhändelser</h5>
                <button class="btn btn-primary" onclick="showCreateEventModal()">
                    <i class="bi bi-plus-circle me-2"></i>Ny Händelse
                </button>
            </div>

            <div id="eventsTableContainer">
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Laddar händelser...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Competitions Tab -->
        <div class="tab-pane fade" id="competitionsTab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Klubbtävlingar</h5>
                <button class="btn btn-primary" onclick="showCreateClubCompetitionModal()">
                    <i class="bi bi-plus-circle me-2"></i>Ny Tävling
                </button>
            </div>

            <!-- Filter Section -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label for="clubYearFilter" class="form-label">År</label>
                            <select class="form-select" id="clubYearFilter" onchange="onClubYearFilterChange()">
                                <!-- Populated by JavaScript -->
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="clubTypeFilter" class="form-label">Tävlingstyp</label>
                            <select class="form-select" id="clubTypeFilter" onchange="onClubTypeFilterChange()">
                                <option value="">Alla typer</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="clubShowCompleted" onchange="onClubShowCompletedChange()">
                                <label class="form-check-label" for="clubShowCompleted">
                                    Visa avslutade tävlingar
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <button class="btn btn-outline-secondary w-100" onclick="clearClubCompetitionFilters()">
                                <i class="bi bi-x-circle me-1"></i>Rensa filter
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div id="competitionsTableContainer">
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Laddar tävlingar...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Series Tab -->
        <div class="tab-pane fade" id="clubSeriesTab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Klubbserier</h5>
                <button class="btn btn-primary" onclick="openCreateClubSeriesModal()">
                    <i class="bi bi-plus-circle me-2"></i>Ny Serie
                </button>
            </div>

            <!-- Loading State -->
            <div class="spinner-border text-primary d-none" id="clubSeriesLoadingSpinner" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>

            <!-- Series Table -->
            <div class="table-responsive" id="clubSeriesTableContainer">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Namn</th>
                            <th>Period</th>
                            <th>Status</th>
                            <th class="text-center">Tävlingar</th>
                            <th class="text-end">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody id="clubSeriesTableBody">
                        <tr class="text-muted">
                            <td colspan="5" class="text-center py-4">Laddar serier...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div class="alert alert-info d-none text-center" id="noClubSeriesAlert">
                <i class="bi bi-inbox me-2"></i>
                Inga serier hittades. <a href="#" onclick="openCreateClubSeriesModal(); return false;">Skapa en nu</a>
            </div>

            <!-- Error Alert -->
            <div class="alert alert-danger d-none" id="clubSeriesErrorAlert" role="alert">
                <strong>Fel:</strong> <span id="clubSeriesErrorMessage"></span>
            </div>
        </div>

        <!-- Members Tab -->
        <div class="tab-pane fade" id="membersTab">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h5 class="mb-0">Klubbmedlemmar <span class="fw-normal small text-muted" id="clubMemberCount"></span></h5>
                <div class="d-flex align-items-center justify-content-end flex-wrap gap-2 ms-auto">
                <!-- Search filters the already-loaded list in the browser; no reload, so it
                     stays instant even for a club with a couple of thousand members. -->
                <div class="input-group input-group-sm club-member-search">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" class="form-control" id="clubMemberSearch" placeholder="Sök namn, e-post, telefon"
                           aria-label="Sök bland klubbens medlemmar" oninput="renderClubMembers()">
                </div>
                <div class="dropdown">
                    <button class="btn btn-primary dropdown-toggle" type="button" id="memberActionsMenu" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-sliders me-2"></i>Åtgärder
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="memberActionsMenu" style="min-width: 260px;">
                        <li><h6 class="dropdown-header">Medlemmar</h6></li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="showAddClubMemberModal()">
                                <i class="bi bi-person-plus-fill me-2 text-success"></i>Lägg till klubbmedlem
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Kommunikation &amp; avgifter</h6></li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="showClubEmailModal()">
                                <i class="bi bi-envelope me-2 text-info"></i>Skicka mail
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="new bootstrap.Modal(document.getElementById('clubFeeModal')).show()">
                                <i class="bi bi-cash-coin me-2 text-primary"></i>Medlemsavgifter
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Listor</h6></li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="openMemberImportModal(@clubId, @(System.Text.Json.JsonSerializer.Serialize(clubName)))">
                                <i class="bi bi-upload me-2 text-secondary"></i>Importera medlemmar
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="exportClubMembersCsv()">
                                <i class="bi bi-download me-2 text-secondary"></i>Exportera lista
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="openMemberMergeModal(@clubId, @(System.Text.Json.JsonSerializer.Serialize(clubName)))">
                                <i class="bi bi-people me-2 text-warning"></i>Hitta dubbletter
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Register</h6></li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="showClubKeysModal()">
                                <i class="bi bi-key me-2 text-warning"></i>Nycklar &amp; koder
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Behörigheter</h6></li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="showSkjutledareModal()">
                                <i class="bi bi-shield-check me-2 text-success"></i>Skjutledare
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="showClubAdminsModal()">
                                <i class="bi bi-person-gear me-2 text-warning"></i>Klubbadmins
                            </button>
                        </li>
                        <!-- DPA status — revealed by loadDpaGate() only once the avtal is godkänt -->
                        <li class="dpa-menu-el" style="display:none;"><hr class="dropdown-divider"></li>
                        <li class="dpa-menu-el" style="display:none;">
                            <button class="dropdown-item" type="button" onclick="showDpaStatusModal()">
                                <i class="bi bi-shield-lock me-2 text-success"></i>Personuppgiftsbiträdesavtal
                            </button>
                        </li>
                    </ul>
                </div>
                </div>
            </div>

            <div id="clubMembersTableContainer">
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Laddar medlemmar...</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Invoices Tab -->
        <div class="tab-pane fade" id="invoicesTab">
            @await Html.PartialAsync("ClubAdminInvoicesList")
        </div>

        <!-- Documents Tab -->
        <div class="tab-pane fade" id="documentsTab">
            @{ ViewBag.DocumentOwnerType = 0; ViewBag.DocumentOwnerId = clubId; }
            @await Html.PartialAsync("ClubDocumentAdmin")
        </div>

        <!-- Aktivitet & Intyg Tab -->
        <div class="tab-pane fade" id="clubActivityTab">
            @await Html.PartialAsync("ClubAdminActivityIntyg")
        </div>

        <!-- Training Groups Tab -->
        <div class="tab-pane fade" id="trainingGroupsTab">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Träningsgrupper</h5>
                <button class="btn btn-success" onclick="showCreateClubTrainingGroupModal()">
                    <i class="bi bi-plus-circle me-2"></i>Ny Träningsgrupp
                </button>
            </div>
            <div id="clubTrainingGroupList">
                <div class="text-center py-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Laddar...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Settings Tab -->
        <div class="tab-pane fade" id="settingsTab">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-4">
                        <i class="bi bi-gear me-2"></i>Klubbinställningar
                    </h5>
                    <form id="clubSettingsForm">
                        <!-- Contact Information Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-person-lines-fill me-2"></i>Kontaktinformation
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kontaktperson</label>
                                <input type="text" class="form-control" id="contactPerson" name="contactPerson" placeholder="Namn på kontaktperson">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kontakt Telefon</label>
                                <input type="tel" class="form-control" id="contactPhone" name="contactPhone" placeholder="+46 70 123 45 67">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kontakt E-post</label>
                                <input type="email" class="form-control" id="contactEmail" name="contactEmail" placeholder="kontakt@klubb.se">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Webbplats</label>
                                <input type="url" class="form-control" id="webSite" name="webSite" placeholder="https://www.klubb.se">
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Address Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-geo-alt-fill me-2"></i>Adress
                        </h6>
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Gatuadress</label>
                                <input type="text" class="form-control" id="address" name="address" placeholder="Gatugatan 123">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Postnummer</label>
                                <input type="text" class="form-control" id="postalCode" name="postalCode" placeholder="123 45">
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Stad</label>
                                <input type="text" class="form-control" id="city" name="city" placeholder="Stockholm">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Organisationsnummer</label>
                                <input type="text" class="form-control" id="orgNumber" name="orgNumber" placeholder="802345-6789">
                                <small class="text-muted">Visas på kvitton (t.ex. för friskvårdsbidrag)</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">E-post på kvitto</label>
                                <input type="email" class="form-control" id="receiptEmail" name="receiptEmail" placeholder="kvitto@klubb.se">
                                <small class="text-muted">Visas på kvitton. Lämna tom för att använda kontakt-e-posten.</small>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Betalningsuppgifter: shown on the club's invoices so a payer can choose
                             Swish or bankgiro. Bankgiro is what other clubs and kretsar normally use. -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-credit-card me-2"></i>Betalningsuppgifter
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Swish-nummer <small class="text-muted">(valfritt)</small></label>
                                <input type="text" class="form-control" id="clubSwishNumber" name="swishNumber" placeholder="1231234567">
                                <small class="text-muted">Klubbens Swish för medlemsavgifter. Tävlingar har eget Swish-nummer i tävlingsinställningarna.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Bankgiro <small class="text-muted">(valfritt)</small></label>
                                <input type="text" class="form-control" id="clubBgNumber" name="bgNumber" placeholder="123-4567">
                                <small class="text-muted">Visas som betalningsalternativ på klubbens fakturor och kvitton. Fakturanummer används som referens.</small>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Description Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-card-text me-2"></i>Om Klubben
                        </h6>
                        <div class="mb-3">
                            <label class="form-label">Kort Beskrivning</label>
                            <textarea class="form-control" id="club_description" name="description" rows="3" placeholder="En kort beskrivning av klubben (används för SEO och sammanfattning)"></textarea>
                            <small class="text-muted">Används som kort sammanfattning i sökresultat och listor</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Utförlig Information (Om Klubben)</label>
                            <textarea class="form-control" id="aboutClub" name="aboutClub" rows="8" placeholder="Utförlig information om klubben, historia, verksamhet, etc. (kan innehålla HTML)"></textarea>
                            <small class="text-muted">Visas på klubbsidan under "Om Klubben". Stöder grundläggande HTML-formatering.</small>
                        </div>

                        <hr class="my-4">

                        <!-- Brevo Email Integration -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-envelope me-2"></i>E-postutskick (Brevo)
                            <button type="button" class="btn btn-sm btn-outline-info ms-2" onclick="showBrevoSetupGuide()">
                                <i class="bi bi-question-circle me-1"></i>Hjälp med Brevo
                            </button>
                        </h6>
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Brevo API-nyckel <small class="text-muted">(valfritt)</small></label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="brevoApiKey" name="brevoApiKey" placeholder="xkeysib-..." autocomplete="off">
                                    <button class="btn btn-outline-secondary" type="button" onclick="toggleBrevoKeyVisibility()">
                                        <i class="bi bi-eye" id="brevoKeyToggleIcon"></i>
                                    </button>
                                    <button class="btn btn-outline-success" type="button" onclick="testBrevoApiKey()">
                                        <i class="bi bi-check-circle me-1"></i>Testa
                                    </button>
                                </div>
                                <small class="text-muted">Aktiverar "Skicka via Brevo" i e-postmodalen. Varje klubb använder sin egen Brevo-nyckel.</small>
                                <div id="brevoKeyTestResult" class="mt-1 d-none"></div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Images Section -->
                        <h6 class="text-muted mb-3">
                            <i class="bi bi-image me-2"></i>Bilder
                        </h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Logotyp</label>
                                <div id="clubLogoPreview" class="mb-2" style="display: none;">
                                    <img id="clubLogoImg" src="" alt="Logo" class="img-thumbnail" style="max-height: 100px; max-width: 200px;">
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="removeClubImage('logo')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <input type="file" class="form-control" id="clubLogoFile" accept="image/jpeg,image/png,image/gif,image/webp" onchange="uploadClubImage('logo', this)">
                                <small class="text-muted">JPG, PNG, GIF eller WebP. Max 5 MB.</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Bannerbild</label>
                                <div id="clubBannerPreview" class="mb-2" style="display: none;">
                                    <img id="clubBannerImg" src="" alt="Banner" class="img-thumbnail" style="max-height: 100px; max-width: 300px;">
                                    <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="removeClubImage('bannerImage')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                                <input type="file" class="form-control" id="clubBannerFile" accept="image/jpeg,image/png,image/gif,image/webp" onchange="uploadClubImage('bannerImage', this)">
                                <small class="text-muted">JPG, PNG, GIF eller WebP. Max 5 MB. Rekommenderad storlek: 1200x300 px.</small>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-save me-2"></i>Spara Inställningar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Certifieringar Tab -->
        <div class="tab-pane fade" id="certificationsTab">
            @{
                var clubCertVD = new ViewDataDictionary(ViewData);
                clubCertVD["CertScopeType"] = "Club";
                clubCertVD["CertScopeId"] = clubId;
            }
            @await Html.PartialAsync("CertificationManagementPanel", null, clubCertVD)
        </div>

        <!-- Mästare Tab -->
        <div class="tab-pane fade" id="clubChampionsTab">
            @{
                var clubChampAdminVD = new ViewDataDictionary(ViewData);
                clubChampAdminVD["ChampionsScopeType"] = "Club";
                clubChampAdminVD["ChampionsScopeId"] = clubId.ToString();
                clubChampAdminVD["ChampionsScopeName"] = clubName;
                clubChampAdminVD["ChampionsCanEdit"] = true;
                clubChampAdminVD["ChampionsShowAllYears"] = true;
            }
            @await Html.PartialAsync("ReigningChampionsPanel", null, clubChampAdminVD)
        </div>

        <!-- Standardmedaljer Tab -->
        <div class="tab-pane fade" id="standardMedalsTab">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="mb-1"><i class="bi bi-award text-warning me-2"></i>Standardmedaljer</h5>
                    <p class="text-muted small mb-0">
                        Medlemmar som tagit standardmedaljer (silver = 2 p, brons = 1 p). Egenrapporterade
                        medaljer kan behöva verifieras innan de rapporteras till förbundet.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="medalYearFilter" class="small text-muted mb-0">År:</label>
                    <select id="medalYearFilter" class="form-select form-select-sm" style="width:auto;" onchange="loadClubMedals()"></select>
                    <button class="btn btn-sm btn-outline-secondary" onclick="exportClubMedals()" title="Exportera årets medaljer som CSV">
                        <i class="bi bi-download me-1"></i>Exportera
                    </button>
                </div>
            </div>
            <div id="clubMedalsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Laddar...</span></div>
                </div>
            </div>
        </div>

        <!-- Märken Tab -->
        <div class="tab-pane fade" id="markenTab">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="mb-1"><i class="bi bi-patch-check text-warning me-2"></i>Pistolskyttemärket</h5>
                    <p class="text-muted small mb-0">
                        Skyttar skickar in guldserier/snabbserier som valideras nedan. Årets guldfodring
                        blir klar automatiskt när 3 godkända guldserier + snabbskyttedelen finns.
                        Validering görs av styrelsemedlem <span id="markenSkjutledareHint"></span>.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="markenYearFilter" class="small text-muted mb-0">År:</label>
                    <select id="markenYearFilter" class="form-select form-select-sm" style="width:auto;" onchange="loadClubMarken(); markenOrderYearChanged();"></select>
                    <button class="btn btn-sm btn-outline-secondary" onclick="exportClubMarken()" title="Exportera som CSV (för MAP)">
                        <i class="bi bi-download me-1"></i>Exportera
                    </button>
                </div>
            </div>

            @* Årets beställnings- och utdelningslista — märken OCH standardmedaljer i en lista.
               Ligger högt upp för att den ska gå att hitta i januari när beställningen till förbundet
               ska in, men kollapsad så den inte trycker ner valideringskön, som är det dagliga arbetet.
               Läses in först när den öppnas (den räknar över hela året och alla familjer). *@
            <div id="markenOrderCard" class="card mb-3 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                        <h6 class="card-title mb-0">
                            <i class="bi bi-box-seam text-warning me-1"></i>Att beställa och dela ut
                            <span id="markenOrderYearLabel" class="text-muted fw-normal"></span>
                        </h6>
                        <button class="btn btn-sm btn-outline-warning" type="button" id="markenOrderToggleBtn" onclick="toggleMarkenOrder()">Visa listan</button>
                    </div>
                    <p class="text-muted small mb-0">
                        Årets förvärvade märken: antal per valör att beställa från förbundet, och vad
                        varje medlem ska få. Beställningen ska in i januari. Byt år med årsväljaren ovan.
                        <em>Standardmedaljer räknas för sig, på fliken Standardmedaljer.</em>
                    </p>
                    <div id="markenOrderBody" style="display:none;" class="mt-3">
                        <div id="markenOrderContent">
                            <div class="text-center py-3">
                                <div class="spinner-border spinner-border-sm text-warning" role="status"><span class="visually-hidden">Laddar...</span></div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 flex-wrap mt-2" id="markenOrderActions" style="display:none;">
                            <button class="btn btn-sm btn-outline-secondary" type="button" onclick="printMarkenOrder()"><i class="bi bi-printer me-1"></i>Skriv ut båda listorna</button>
                            <button class="btn btn-sm btn-outline-secondary" type="button" onclick="exportMarkenOrder('order')"><i class="bi bi-download me-1"></i>Beställningslista (CSV)</button>
                            <button class="btn btn-sm btn-outline-secondary" type="button" onclick="exportMarkenOrder('handout')"><i class="bi bi-download me-1"></i>Utdelningslista (CSV)</button>
                        </div>
                    </div>
                </div>
            </div>

            @* Sign-off authority — club setting (visible to club admins only). *@
            <div id="markenSettingsCard" class="card mb-3 border-0 bg-body-tertiary" style="display:none;">
                <div class="card-body py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="fw-semibold"><i class="bi bi-shield-check me-1"></i>Vem får validera märken?</span>
                        <div class="form-text mb-0">Styrelsemedlemmar kan alltid validera. Slå på detta för att även låta klubbens skjutledare validera och signera.</div>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="markenSkjutledareToggle" onchange="saveMarkenSettings()">
                        <label class="form-check-label small" for="markenSkjutledareToggle">Tillåt skjutledare</label>
                    </div>
                </div>
                @* Witnessing requirement. Deliberately a per-club choice rather than a site-wide rule:
                   at a range without coverage a hard requirement means no guldserie can be recorded
                   at all, so the club decides which risk it would rather carry. *@
                <div class="card-body py-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="fw-semibold"><i class="bi bi-qr-code-scan me-1"></i>Måste serier bevittnas på plats?</span>
                        <div class="form-text mb-0" id="markenWitnessHelp">Av: en serie kan skickas in hemifrån och godkännas i kön i efterhand. På: serien godkänns bara genom att en funktionär skannar skyttens QR-kod vid banan.</div>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" id="markenWitnessToggle" onchange="saveMarkenSettings()">
                        <label class="form-check-label small" for="markenWitnessToggle">Kräv bevittning</label>
                    </div>
                </div>
            </div>

            @* Validation queue — submitted series awaiting a functionary's Godkänn/Avvisa. *@
            <div id="clubMarkenQueueCard" class="card mb-3 border-info" style="display:none;">
                <div class="card-body">
                    <h6 class="card-title mb-2"><i class="bi bi-clipboard-check text-info me-1"></i>Serier att validera <span id="clubMarkenQueueCount" class="text-muted fw-normal"></span></h6>
                    <div id="clubMarkenQueueContent"></div>
                </div>
            </div>

            @* Backlog entry — bulk-register historical series from a paper ledger (functionaries only). *@
            <div id="markenBacklogCard" class="card mb-3 border-secondary" style="display:none;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
                        <h6 class="card-title mb-0"><i class="bi bi-journal-plus text-secondary me-1"></i>Historiska serier från klubbliggare</h6>
                        <button class="btn btn-sm btn-outline-secondary" type="button" id="markenBacklogToggleBtn" onclick="toggleMarkenBacklog()">Lägg till serier</button>
                    </div>
                    <div id="markenBacklogBody" style="display:none;">
                        <p class="text-muted small mb-2">Registrera tidigare skjutna guldserier/snabbserier (t.ex. från en pappersliggare). Varje rad valideras direkt och räknas mot guldfodringen. Poäng under guldkravet sparas men markeras som ej kvalificerande.</p>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-2">
                                <thead><tr>
                                    <th style="min-width:150px;">Medlem</th>
                                    <th>Typ</th>
                                    <th>Datum</th>
                                    <th>Vapengrupp</th>
                                    <th>Poäng / mål</th>
                                    <th></th>
                                </tr></thead>
                                <tbody id="markenBacklogRows"></tbody>
                            </table>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-primary" type="button" onclick="addMarkenBacklogRow()"><i class="bi bi-plus-lg me-1"></i>Lägg till rad</button>
                            <button class="btn btn-sm btn-success" type="button" onclick="saveMarkenBacklog()"><i class="bi bi-save me-1"></i>Spara alla</button>
                        </div>
                        <div id="markenBacklogResult" class="small mt-2"></div>
                    </div>
                </div>
            </div>

            @* Open any club member's Märken detail — needed to award a base grundmärke (e.g. Brons)
               to a shooter who hasn't submitted any series yet, so isn't in the summary table below.
               Functionary-only (same gate as the backlog card). *@
            <div id="markenMemberPickerCard" class="card mb-3 border-0 bg-body-tertiary" style="display:none;">
                <div class="card-body py-2 d-flex align-items-center gap-2 flex-wrap">
                    <label for="markenMemberPicker" class="small fw-semibold mb-0"><i class="bi bi-person-plus me-1"></i>Öppna skytt / tilldela märke:</label>
                    <select id="markenMemberPicker" class="form-select form-select-sm" style="max-width:280px;"></select>
                    <button class="btn btn-sm btn-outline-primary" type="button" onclick="openMarkenMemberPicker()">Öppna</button>
                    <span class="form-text mb-0">Här hittar du även skyttar som ännu inte skickat in några serier.</span>
                </div>
            </div>

            <div id="clubMarkenContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Laddar...</span></div>
                </div>
            </div>
        </div>

        <!-- Statistik Tab -->
        <div class="tab-pane fade" id="clubStatsTab">
            @await Html.PartialAsync("ClubStatistics")
        </div>
            </div><!-- /#adminTabContent -->
        </div><!-- /.col-lg-9 -->
    </div><!-- /.admin-nav-layout row -->
</div>

