// False until a read confirms the club doctype actually carries `markenRequireOnSiteWitness`.
// Everything that touches that switch keys off this, so a missing property disables it in one place
// instead of being re-derived from the help text.
let markenWitnessAvailable = false;

// Sign-off authority toggle — only club admins get a successful read, so the card stays hidden for
// plain functionaries (skjutledare). Keeps the intro hint in sync with the actual setting.
function loadMarkenSettings() {
    fetch(`/umbraco/surface/Marken/GetMarkenClubSettings?clubId=${clubId}`)
        .then(r => r.json())
        .then(d => {
            const card = document.getElementById('markenSettingsCard');
            if (!d.success) { if (card) card.style.display = 'none'; return; }
            const toggle = document.getElementById('markenSkjutledareToggle');
            if (toggle) toggle.checked = !!d.skjutledareSignoff;
            const witness = document.getElementById('markenWitnessToggle');
            if (witness) witness.checked = !!d.requireOnSiteWitness;
            if (card) card.style.display = 'block';
            markenSyncHint(!!d.skjutledareSignoff);
            if (!d.propertyExists) {
                const ft = card ? card.querySelector('.form-text') : null;
                if (ft) ft.innerHTML = '<span class="text-warning">Egenskapen saknas på klubbtypen i Umbraco — kontakta en administratör innan inställningen kan sparas.</span>';
            }
            // Say so up front rather than letting the switch appear to work and silently revert:
            // SetValue on a missing property is a no-op, so the server refuses that save.
            markenWitnessAvailable = !!d.witnessPropertyExists;
            if (!markenWitnessAvailable) {
                if (witness) witness.disabled = true;
                const wh = document.getElementById('markenWitnessHelp');
                if (wh) wh.innerHTML = '<span class="text-warning">Egenskapen \'markenRequireOnSiteWitness\' saknas på klubbtypen i Umbraco — kontakta en administratör innan inställningen kan användas.</span>';
            }
        })
        .catch(() => {});
}

function markenSyncHint(enabled) {
    const hint = document.getElementById('markenSkjutledareHint');
    if (hint) hint.textContent = enabled ? '(eller skjutledare — aktiverat för klubben)' : '';
}

// Both switches post through here — one endpoint, one save. Each remembers the value it had so a
// refusal can put the switch that failed back where it was.
function saveMarkenSettings() {
    const toggle = document.getElementById('markenSkjutledareToggle');
    const witness = document.getElementById('markenWitnessToggle');
    const enabled = toggle.checked;
    toggle.disabled = true;
    if (witness && markenWitnessAvailable) witness.disabled = true;
    const body = { clubId: clubId, skjutledareSignoff: enabled };
    // Omit the field entirely when the doctype property is missing — the server reads a missing field
    // as "leave it alone", so sending it would make the server refuse the skjutledare half too.
    if (witness && markenWitnessAvailable) body.requireOnSiteWitness = witness.checked;
    fetch('/umbraco/surface/Marken/SetMarkenClubSettings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify(body)
    })
    .then(r => r.json())
    .then(d => {
        toggle.disabled = false;
        if (witness) witness.disabled = !markenWitnessAvailable;
        if (!d.success) {
            alert(d.message || 'Kunde inte spara.');
            // Re-read rather than guess which half failed — the server saves them together.
            loadMarkenSettings();
            return;
        }
        markenSyncHint(enabled);
        loadClubMarkenQueue(); // re-evaluate who can validate, and re-render the bevittning hints
    })
    .catch(() => {
        toggle.disabled = false;
        if (witness) witness.disabled = !markenWitnessAvailable;
        alert('Något gick fel.');
        loadMarkenSettings();
    });
}

function exportClubMarken() {
    const year = document.getElementById('markenYearFilter')?.value || new Date().getFullYear();
