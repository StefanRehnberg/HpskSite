            <th class="text-center">Tränare</th>
            <th></th>
        </tr></thead><tbody>`;

        clubTrainingGroups.forEach(g => {
            const inactiveClass = g.isActive ? '' : ' class="table-secondary text-muted"';
            html += `
                <tr${inactiveClass} style="cursor: pointer;" onclick="expandClubTrainingGroup(${g.id})">
                    <td>
                        <span class="fw-bold">${g.name}</span>
                        ${!g.isActive ? ' <span class="badge bg-secondary">Inaktiv</span>' : ''}
