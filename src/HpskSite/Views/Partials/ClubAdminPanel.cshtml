// Club selection functions
function renderEditMemberPrimaryClub(selectedClubId) {
    const select = document.getElementById('editMemberPrimaryClub');
    select.innerHTML = '<option value="">-- Ingen primär klubb --</option>';

    editMemberAvailableClubs.forEach(club => {
        const option = document.createElement('option');
        option.value = club.id;
        option.textContent = club.name;
        if (club.id === selectedClubId) option.selected = true;
        select.appendChild(option);
    });
}

function renderEditMemberAdditionalClubs(selectedClubIds) {
    const menu = document.getElementById('editMemberAdditionalClubsDropdownMenu');
    menu.innerHTML = '';

    editMemberAvailableClubs.forEach(club => {
        const checked = selectedClubIds.includes(club.id) ? 'checked' : '';
        menu.innerHTML += `
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="editMemberAdditionalClubs"
                       value="${club.id}" id="editMemberClub_${club.id}" ${checked}
                       onchange="updateEditMemberSelectedClubsDisplay()">
                <label class="form-check-label" for="editMemberClub_${club.id}">${escapeHtml(club.name)}</label>
            </div>
        `;
    });

    updateEditMemberSelectedClubsDisplay();
}

function updateEditMemberSelectedClubsDisplay() {
    const checkboxes = document.querySelectorAll('input[name="editMemberAdditionalClubs"]:checked');
    const count = checkboxes.length;
    const textEl = document.getElementById('editMemberSelectedClubsText');
    const countEl = document.getElementById('editMemberSelectedClubsCount');

    if (count === 0) {
        textEl.textContent = 'Välj klubbar';
        countEl.textContent = 'Inga ytterligare klubbar valda';
    } else {
        const names = Array.from(checkboxes).map(cb => {
            const club = editMemberAvailableClubs.find(c => c.id == cb.value);
            return club ? club.name : cb.value;
        });
        textEl.textContent = names.length <= 2 ? names.join(', ') : `${names.length} klubbar valda`;
        countEl.textContent = `${count} klubb(ar) valda`;
    }
}

// Member groups functions
function renderEditMemberGroups(selectedGroups) {
    const menu = document.getElementById('editMemberGroupsDropdownMenu');
    menu.innerHTML = '';

    // editMemberAvailableGroups is an array of group name strings (not objects)
    // Filter out ClubAdmin groups from display
    const displayGroups = (editMemberAvailableGroups || []).filter(groupName =>
        typeof groupName === 'string' && !groupName.startsWith('ClubAdmin_')
    );

    if (displayGroups.length === 0) {
        menu.innerHTML = '<div class="text-muted small">Inga grupper tillgängliga</div>';
        updateEditMemberSelectedGroupsDisplay();
        return;
    }

    displayGroups.forEach((groupName, index) => {
        const checked = selectedGroups.includes(groupName) ? 'checked' : '';
        menu.innerHTML += `
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="editMemberGroups"
                       value="${escapeHtml(groupName)}" id="editMemberGroup_${index}" ${checked}
                       onchange="updateEditMemberSelectedGroupsDisplay()">
                <label class="form-check-label" for="editMemberGroup_${index}">${escapeHtml(groupName)}</label>
            </div>
        `;
    });

    updateEditMemberSelectedGroupsDisplay();
}

function updateEditMemberSelectedGroupsDisplay() {
    const checkboxes = document.querySelectorAll('input[name="editMemberGroups"]:checked');
    const count = checkboxes.length;
    const textEl = document.getElementById('editMemberSelectedGroupsText');
    const countEl = document.getElementById('editMemberSelectedGroupsCount');

    if (count === 0) {
        textEl.textContent = 'Välj grupper';
        countEl.textContent = 'Inga grupper valda';
    } else {
        const names = Array.from(checkboxes).map(cb => cb.value);
        textEl.textContent = names.length <= 2 ? names.join(', ') : `${names.length} grupper valda`;
        countEl.textContent = `${count} grupp(er) valda`;
    }
}

