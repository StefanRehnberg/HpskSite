<script>
// Club context - clubId is declared by parent page (Club.cshtml) as const clubId
// We only set window.currentClubId if it wasn't already set by the parent
// DO NOT declare clubId here - it would conflict with parent's const declaration
if (typeof window.currentClubId === 'undefined') {
    window.currentClubId = @clubId;
}

// Global variables to store loaded data
let allEvents = [];
let aboutClubEditor = null; // CKEditor instance for About Club field

// Note: eventTypeColors is declared in Club.cshtml parent page

// Helper function to get anti-forgery token
function getAntiForgeryToken() {
    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
    return tokenInput ? tokenInput.value : '';
}

// Load events when tabs are clicked
document.getElementById('events-tab').addEventListener('shown.bs.tab', function () {
    loadEvents();
});

// Standardmedaljer tab
let medalYearInitialized = false;
document.getElementById('standardMedals-tab').addEventListener('shown.bs.tab', function () {
    if (!medalYearInitialized) {
        const sel = document.getElementById('medalYearFilter');
        const now = new Date().getFullYear();
        for (let y = now; y >= now - 6; y--) {
            const opt = document.createElement('option');
            opt.value = y; opt.textContent = y;
            sel.appendChild(opt);
        }
        medalYearInitialized = true;
    }
    loadClubMedals();
});

function exportClubMedals() {
    const year = document.getElementById('medalYearFilter')?.value || new Date().getFullYear();
    window.location = `/umbraco/surface/StandardMedal/ExportClubMedals?clubId=${clubId}&year=${year}`;
}

function loadClubMedals() {
    const year = document.getElementById('medalYearFilter')?.value || new Date().getFullYear();
    const content = document.getElementById('clubMedalsContent');
    content.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
    fetch(`/umbraco/surface/StandardMedal/GetClubMedalSummary?clubId=${clubId}&year=${year}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) { content.innerHTML = `<div class="alert alert-danger">${data.message || 'Kunde inte ladda.'}</div>`; return; }
            renderClubMedals(data.members || []);
        })
        .catch(() => { content.innerHTML = '<div class="alert alert-danger">Fel vid inläsning.</div>'; });
}

function renderClubMedals(members) {
    const content = document.getElementById('clubMedalsContent');
    if (members.length === 0) {
        content.innerHTML = '<div class="text-muted text-center py-4"><i class="bi bi-award d-block" style="font-size:2rem;opacity:.4;"></i>Inga standardmedaljer registrerade för valt år.</div>';
        return;
    }
    let html = `<div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr>
            <th>Medlem</th><th class="text-center">Poäng</th><th class="text-center">Silver</th>
            <th class="text-center">Brons</th><th class="text-center">Status</th><th></th>
        </tr></thead><tbody>`;
    members.forEach(m => {
        const status = m.unverified > 0
            ? `<span class="badge bg-warning text-dark" title="Egenrapporterade som väntar på verifiering">${m.unverified} att verifiera</span>`
            : '<span class="badge bg-success-subtle text-success">Klar</span>';
        html += `<tr>
            <td>${escapeMedalHtml(m.name)}</td>
            <td class="text-center fw-semibold">${m.points} p</td>
            <td class="text-center">${m.silver}</td>
            <td class="text-center">${m.brons}</td>
            <td class="text-center">${status}</td>
            <td class="text-end"><button class="btn btn-sm btn-outline-primary" onclick="openMemberMedalDetail(${m.memberId}, '${escapeMedalAttr(m.name)}')"><i class="bi bi-list-ul me-1"></i>Detaljer</button></td>
        </tr>`;
    });
    html += '</tbody></table></div>';
    content.innerHTML = html;
}

function openMemberMedalDetail(memberId, name) {
    document.getElementById('memberMedalDetailName').textContent = name;
    const body = document.getElementById('memberMedalDetailBody');
    body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
    const modalEl = document.getElementById('memberMedalDetailModal');
    bootstrap.Modal.getOrCreateInstance(modalEl).show();
    const year = document.getElementById('medalYearFilter')?.value || new Date().getFullYear();
    fetch(`/umbraco/surface/StandardMedal/GetMemberMedalDetail?memberId=${memberId}&year=${year}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) { body.innerHTML = `<div class="alert alert-danger">${data.message || 'Kunde inte ladda.'}</div>`; return; }
            renderMemberMedalDetail(data);
        })
        .catch(() => { body.innerHTML = '<div class="alert alert-danger">Fel vid inläsning.</div>'; });
}

function renderMemberMedalDetail(data) {
    const body = document.getElementById('memberMedalDetailBody');
    const awards = data.awards || [];
    if (awards.length === 0) { body.innerHTML = '<p class="text-muted">Inga medaljer för valt år.</p>'; return; }
    let html = `<div class="table-responsive"><table class="table table-sm align-middle"><thead><tr>
        <th>Tävling</th><th>Gren</th><th>Klass</th><th>Medalj</th><th>Källa</th><th>Bevis</th><th>Status</th><th></th>
    </tr></thead><tbody>`;
    awards.forEach(a => {
        const date = a.competitionDate ? new Date(a.competitionDate).toLocaleDateString('sv-SE') : '';
        const compCell = `${escapeMedalHtml(a.competitionName || '–')}${a.location ? ' <span class="text-muted small">(' + escapeMedalHtml(a.location) + ')</span>' : ''}${date ? '<div class="text-muted small">' + date + '</div>' : ''}`;
        const medalBadge = a.medalType === 'S'
            ? '<span class="badge" style="background-color:#9ca3af;">Silver (2p)</span>'
            : '<span class="badge" style="background-color:#cd7f32;">Brons (1p)</span>';
        // Self-reported/admin medals can be corrected (e.g. shooter entered S instead of B).
        // pistol.nu medals follow the result list and gold-locked ones can't change.
        const medalCell = a.editable
            ? `<select class="form-select form-select-sm" style="width:auto;display:inline-block;" onchange="updateAwardMedal(${a.id}, this.value, ${data.memberId}, '${escapeMedalAttr(data.memberName)}')">
                   <option value="S"${a.medalType === 'S' ? ' selected' : ''}>Silver (2p)</option>
                   <option value="B"${a.medalType === 'B' ? ' selected' : ''}>Brons (1p)</option>
               </select>`
            : medalBadge;
        let source;
        if (a.source === 'OnSite') source = '<span class="text-success" title="Resultat från pistol.nu-tävling"><i class="bi bi-check-circle-fill"></i> pistol.nu</span>';
        else if (a.source === 'SelfReported') source = '<span title="Egenrapporterad av skytten"><i class="bi bi-person"></i> Egen</span>';
        else source = '<span><i class="bi bi-pencil"></i> Admin</span>';

        let proof;
        if (a.source === 'OnSite') proof = '<span class="text-muted small">Resultatlista</span>';
        else if (a.hasProofFile) proof = `<a href="/umbraco/surface/StandardMedal/GetProof?awardId=${a.id}" target="_blank" rel="noopener"><i class="bi bi-paperclip"></i> Visa</a>`;
        else proof = '<span class="text-muted small">Intygat</span>';

        let statusBadge;
        if (a.status === 'Verified') statusBadge = '<span class="badge bg-success">Verifierad</span>';
        else if (a.status === 'Rejected') statusBadge = '<span class="badge bg-danger">Avvisad</span>';
        else statusBadge = '<span class="badge bg-warning text-dark">Ej verifierad</span>';

        let actions = '';
        if (a.source !== 'OnSite') {
            if (a.status !== 'Verified') actions += `<button class="btn btn-sm btn-success me-1" title="Verifiera" onclick="setMedalStatus(${a.id}, true, ${data.memberId}, '${escapeMedalAttr(data.memberName)}')"><i class="bi bi-check-lg"></i></button>`;
            if (a.status !== 'Rejected') actions += `<button class="btn btn-sm btn-outline-danger" title="Avvisa" onclick="setMedalStatus(${a.id}, false, ${data.memberId}, '${escapeMedalAttr(data.memberName)}')"><i class="bi bi-x-lg"></i></button>`;
        }

        html += `<tr>
            <td>${compCell}</td>
            <td>${escapeMedalHtml(a.discipline)}</td>
            <td>${escapeMedalHtml(a.shootingClass || '–')}</td>
            <td>${medalCell}</td>
            <td>${source}</td>
            <td>${proof}</td>
            <td>${statusBadge}</td>
            <td class="text-end text-nowrap">${actions}</td>
        </tr>`;
    });
    const totalPts = awards.filter(a => a.status !== 'Rejected').reduce((s, a) => s + a.points, 0);
    const verifiedPts = awards.filter(a => a.status === 'Verified').reduce((s, a) => s + a.points, 0);
    html += `</tbody><tfoot><tr class="fw-semibold"><td colspan="3">Summa (ej avvisade)</td><td colspan="5">${totalPts} p <span class="fw-normal text-muted">varav ${verifiedPts} p verifierade</span></td></tr></tfoot></table></div>`;
    body.innerHTML = '<div id="memberGoldSection" class="mb-3"></div>' + html;
    loadMemberGold(data.memberId, data.memberName);
}

// Guldmedalj section inside the member detail modal.
function loadMemberGold(memberId, memberName) {
    const section = document.getElementById('memberGoldSection');
    if (!section) return;
    fetch(`/umbraco/surface/StandardMedal/GetMemberGoldStatus?memberId=${memberId}`)
        .then(r => r.json())
        .then(data => { if (data.success) renderMemberGold(data, memberName); })
        .catch(() => {});
}

function renderMemberGold(data, memberName) {
    const section = document.getElementById('memberGoldSection');
    if (!section) return;
    const g = data.gold || {};
    const apps = data.applications || [];
    const pct = Math.min(100, Math.round(((g.available || 0) / 50) * 100));

    let appsHtml = '';
    if (apps.length > 0) {
        appsHtml = '<ul class="list-group list-group-flush small mt-2">' + apps.map(a => {
            let badge, actions = '';
            if (a.status === 'Approved') badge = '<span class="badge bg-success">Godkänd</span>';
            else if (a.status === 'Rejected') badge = '<span class="badge bg-secondary">Avbruten</span>';
            else badge = '<span class="badge bg-warning text-dark">Inskickad</span>';
            if (a.status === 'Applied') {
                actions = `<button class="btn btn-sm btn-success me-1" onclick="goldAction(${a.id}, true, ${data.memberId}, '${escapeMedalAttr(memberName)}')">Markera godkänd</button>`
                        + `<button class="btn btn-sm btn-outline-danger" onclick="goldAction(${a.id}, false, ${data.memberId}, '${escapeMedalAttr(memberName)}')">Avbryt</button>`;
            }
            if (a.status !== 'Rejected') {
                actions += ` <a class="btn btn-sm btn-outline-secondary" href="/umbraco/surface/StandardMedal/ExportGoldApplication?applicationId=${a.id}" title="Ladda ner underlag (CSV)"><i class="bi bi-download"></i></a>`;
            }
            const dt = a.approvedAt ? new Date(a.approvedAt).toLocaleDateString('sv-SE')
                     : (a.appliedAt ? new Date(a.appliedAt).toLocaleDateString('sv-SE') : '');
            return `<li class="list-group-item d-flex justify-content-between align-items-center px-0 flex-wrap gap-1">
                <span>Guldmedalj #${a.sequenceNumber} ${badge} <span class="text-muted">${dt}</span></span>
                <span>${actions}</span></li>`;
        }).join('') + '</ul>';
    }

    const applyBtn = g.canApply
        ? `<button class="btn btn-warning btn-sm" onclick="createGold(${data.memberId}, '${escapeMedalAttr(memberName)}')"><i class="bi bi-trophy-fill me-1"></i>Ansök om guldmedalj (50 p)</button>`
        : '';

    section.innerHTML = `
        <div class="card border-warning-subtle">
          <div class="card-body py-2">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span><i class="bi bi-trophy-fill text-warning"></i> <strong>Guldmedalj</strong>
                <span class="text-muted small">${g.available || 0} / 50 verifierade p tillgängliga${g.goldsAwarded > 0 ? ' · ' + g.goldsAwarded + ' godkända' : ''}</span>
              </span>
              ${applyBtn}
            </div>
            <div class="progress mt-1" style="height:6px;"><div class="progress-bar bg-warning" style="width:${pct}%"></div></div>
            ${appsHtml}
          </div>
        </div>`;
}

function createGold(memberId, memberName) {
    if (!confirm('Skapa en guldmedaljsansökan? 50 verifierade poäng reserveras (äldsta först).')) return;
    fetch('/umbraco/surface/StandardMedal/CreateGoldApplication', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ memberId })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte skapa ansökan.')); return; }
        openMemberMedalDetail(memberId, memberName);
        loadClubMedals();
    })
    .catch(() => alert('Kunde inte skapa ansökan.'));
}

function goldAction(applicationId, approve, memberId, memberName) {
    if (!approve && !confirm('Avbryt ansökan? De reserverade poängen frigörs.')) return;
    const url = approve ? '/umbraco/surface/StandardMedal/ApproveGoldApplication' : '/umbraco/surface/StandardMedal/RejectGoldApplication';
    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ applicationId })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte uppdatera ansökan.')); return; }
        openMemberMedalDetail(memberId, memberName);
        loadClubMedals();
    })
    .catch(() => alert('Kunde inte uppdatera ansökan.'));
}

function updateAwardMedal(awardId, medalType, memberId, memberName) {
    fetch('/umbraco/surface/StandardMedal/UpdateAwardMedal', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ awardId, medalType })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte ändra medaljen.')); }
        openMemberMedalDetail(memberId, memberName); // reload (also resets the select on failure)
        loadClubMedals();
    })
    .catch(() => alert('Kunde inte ändra medaljen.'));
}

function setMedalStatus(awardId, verify, memberId, memberName) {
    const url = verify ? '/umbraco/surface/StandardMedal/VerifyAward' : '/umbraco/surface/StandardMedal/RejectAward';
    if (!verify && !confirm('Avvisa denna medalj? Den räknas då inte med i rapporten.')) return;
    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ awardId })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte uppdatera.')); return; }
        openMemberMedalDetail(memberId, memberName); // reload detail
        loadClubMedals();                              // refresh summary counts
    })
    .catch(() => alert('Kunde inte uppdatera medaljstatus.'));
}

// Local HTML escapers (self-reported competition names/locations are member input)
function escapeMedalHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function escapeMedalAttr(s) {
    return escapeMedalHtml(s);
}

// ── Märken (Pistolskyttemärket) tab ───────────────────────────────────
let markenYearInitialized = false;
document.getElementById('marken-tab').addEventListener('shown.bs.tab', function () {
    if (!markenYearInitialized) {
        const sel = document.getElementById('markenYearFilter');
        const now = new Date().getFullYear();
        for (let y = now; y >= now - 6; y--) {
            const opt = document.createElement('option');
            opt.value = y; opt.textContent = y;
            sel.appendChild(opt);
        }
        const hint = document.getElementById('markenSkjutledareHint');
        if (hint) hint.textContent = '(eller skjutledare om klubben aktiverat det i inställningarna)';
        markenYearInitialized = true;
    }
    loadClubMarkenQueue();
    loadClubMarken();
});

function exportClubMarken() {
    const year = document.getElementById('markenYearFilter')?.value || new Date().getFullYear();
    window.location = `/umbraco/surface/Marken/ExportClubMarken?clubId=${clubId}&year=${year}`;
}

function loadClubMarken() {
    const year = document.getElementById('markenYearFilter')?.value || new Date().getFullYear();
    const content = document.getElementById('clubMarkenContent');
    content.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
    fetch(`/umbraco/surface/Marken/GetClubMarkenSummary?clubId=${clubId}&year=${year}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) { content.innerHTML = `<div class="alert alert-danger">${data.message || 'Kunde inte ladda.'}</div>`; return; }
            renderClubMarken(data.members || []);
        })
        .catch(() => { content.innerHTML = '<div class="alert alert-danger">Fel vid inläsning.</div>'; });
}

function renderClubMarken(members) {
    const content = document.getElementById('clubMarkenContent');
    if (members.length === 0) {
        content.innerHTML = '<div class="text-muted text-center py-4"><i class="bi bi-patch-check d-block" style="font-size:2rem;opacity:.4;"></i>Inga märken registrerade för valt år än. Skyttar dyker upp här när de skickat in serier (validera dem i kön ovan) eller när du tilldelat ett grundmärke via Detaljer.</div>';
        return;
    }
    let html = `<div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr>
            <th>Medlem</th><th>Grundmärke</th><th>Guldnr</th>
            <th class="text-center">Guldfodringar</th><th>Årtalsmärke</th><th class="text-center">Årets status</th><th></th>
        </tr></thead><tbody>`;
    members.forEach(m => {
        let statusCell;
        if (m.pending > 0) statusCell = `<span class="badge bg-warning text-dark" title="Väntar på signering">${m.pending} att signera</span>`;
        else if (m.thisYearFulfilled) statusCell = '<span class="badge bg-success-subtle text-success">Signerad</span>';
        else statusCell = '<span class="text-muted small">–</span>';
        const top = m.topLevel ? `<span class="badge bg-warning text-dark">${escapeMedalHtml(m.topLevel)}</span>` : '<span class="text-muted small">–</span>';
        html += `<tr>
            <td>${escapeMedalHtml(m.name)}</td>
            <td>${top}</td>
            <td>${escapeMedalHtml(m.guldNumber) || '<span class="text-muted small">–</span>'}</td>
            <td class="text-center">${m.fulfilledYears}</td>
            <td class="small">${escapeMedalHtml(m.artalsmarke) || '<span class="text-muted">–</span>'}</td>
            <td class="text-center">${statusCell}</td>
            <td class="text-end"><button class="btn btn-sm btn-outline-primary" onclick="openMemberMarkenDetail(${m.memberId}, '${escapeMedalAttr(m.name)}')"><i class="bi bi-list-ul me-1"></i>Detaljer</button></td>
        </tr>`;
    });
    html += '</tbody></table></div>';
    content.innerHTML = html;
}

function openMemberMarkenDetail(memberId, name) {
    document.getElementById('memberMarkenDetailName').textContent = name;
    const body = document.getElementById('memberMarkenDetailBody');
    body.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('memberMarkenDetailModal')).show();
    const year = document.getElementById('markenYearFilter')?.value || new Date().getFullYear();
    fetch(`/umbraco/surface/Marken/GetMemberMarkenDetail?memberId=${memberId}&year=${year}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) { body.innerHTML = `<div class="alert alert-danger">${data.message || 'Kunde inte ladda.'}</div>`; return; }
            renderMemberMarkenDetail(data);
        })
        .catch(() => { body.innerHTML = '<div class="alert alert-danger">Fel vid inläsning.</div>'; });
}

function renderMemberMarkenDetail(data) {
    const body = document.getElementById('memberMarkenDetailBody');
    const d = data.detail || {};
    const canSign = !!data.canSignOff;
    const memberId = d.memberId;
    const name = d.memberName || '';
    const badges = d.badges || [];
    const art = d.artalsmarke || {};
    const gf = d.guldfodring || {};
    const year = d.year;

    const heldByLevel = {};
    badges.forEach(b => heldByLevel[b.level] = b);

    // ── Grundmärken (B/S/G) ──
    let badgeRows = '';
    ['Brons', 'Silver', 'Guld'].forEach(level => {
        const held = heldByLevel[level];
        let right;
        if (held) {
            const yr = held.achievedYear ? ` <span class="text-muted small">(${held.achievedYear})</span>` : '';
            const src = held.source === 'Skyttetrappan' ? ' <span class="badge bg-info-subtle text-info border border-info-subtle">Skyttetrappan</span>' : '';
            if (level === 'Guld') {
                const num = held.uniqueNumber ? escapeMedalAttr(held.uniqueNumber) : '';
                right = `<span class="text-success me-2"><i class="bi bi-check-circle-fill"></i> Tilldelat${yr}${src}</span>
                    <span class="input-group input-group-sm" style="width:auto;display:inline-flex;vertical-align:middle;">
                      <span class="input-group-text">Nr</span>
                      <input type="text" class="form-control" id="guldNr_${held.id}" value="${num}" style="width:120px;" placeholder="registreringsnr">
                      <button class="btn btn-outline-secondary" onclick="setMarkenGuldNumber(${held.id}, ${memberId}, '${escapeMedalAttr(name)}')">Spara</button>
                    </span>`;
            } else {
                right = `<span class="text-success"><i class="bi bi-check-circle-fill"></i> Tilldelat${yr}${src}</span>`;
            }
        } else if (canSign) {
            right = `<button class="btn btn-sm btn-outline-warning" onclick="awardMarkenBadge(${memberId}, '${level}', '${escapeMedalAttr(name)}')">Tilldela ${level.toLowerCase()}</button>`;
        } else {
            right = '<span class="text-muted small">Ej tilldelat</span>';
        }
        badgeRows += `<li class="list-group-item d-flex justify-content-between align-items-center px-0 flex-wrap gap-2">
            <span><span class="badge bg-warning text-dark me-1">${level}</span></span><span>${right}</span></li>`;
    });

    // ── Årtalsmärke ──
    const artLine = (art.fulfilledYears || 0) > 0 || badges.some(b => b.isGuld)
        ? `<strong>${escapeMedalHtml(art.current) || 'Inget årtalsmärke än'}</strong>
           <span class="text-muted">— ${art.fulfilledYears || 0} godkända guldfodringar</span>`
        : '<span class="text-muted">Kräver guldmärke först.</span>';

    // ── Guldfodring (this year) ──
    const p = gf.persisted;
    const signed = p && p.signedOff;
    const part1 = gf.part1Met || (p && p.part1Met);
    const part2 = gf.part2Met || (p && p.part2Met);
    const seriesRows = (gf.bestSeries || []).map(s =>
        `<li>${escapeMedalHtml(s.weaponGroup)}: <strong>${s.score}</strong> (krav ${s.threshold})${s.source ? ' <span class="text-muted">' + escapeMedalHtml(s.source === 'Tävling' ? (s.label || 'tävling') : 'guldserie') + '</span>' : ''}</li>`).join('');

    // Read-only status — the year completes automatically when both parts are validated.
    const bothDone = gf.candidateBothMet || (p && p.fulfilled);
    let gfStatus;
    if (bothDone) {
        gfStatus = `<span class="badge bg-success"><i class="bi bi-check2-all me-1"></i>Guldfodring ${year} klar</span>`;
    } else {
        const need = [];
        if (!part1) need.push(`${gf.qualifyingSeriesCount || 0}/${gf.requiredSeries} guldserier`);
        if (!part2) need.push('snabbskyttedel');
        gfStatus = `<span class="text-muted small">Återstår: ${need.join(' + ')}. Blir klar automatiskt när delarna validerats.</span>`;
    }

    const partLine = (label, met, detail) =>
        `<div class="d-flex justify-content-between"><span>${met ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-circle text-muted"></i>'} ${label}</span><span class="text-muted small">${detail || ''}</span></div>`;

    body.innerHTML = `
        <h6 class="text-muted">Grundmärken</h6>
        <ul class="list-group list-group-flush mb-3">${badgeRows}</ul>

        <h6 class="text-muted">Årtalsmärke</h6>
        <p class="mb-3"><i class="bi bi-calendar-check text-warning"></i> ${artLine}</p>

        <h6 class="text-muted">Guldfodring ${year}</h6>
        <div class="card border-warning-subtle mb-2"><div class="card-body py-2">
            ${partLine('Precisionsdel (3 godkända guldserier)', part1, `${gf.qualifyingSeriesCount || 0}/${gf.requiredSeries} serier`)}
            ${seriesRows ? `<ul class="small text-muted mt-1 mb-1">${seriesRows}</ul>` : ''}
            <hr class="my-2">
            ${partLine('Snabbskyttedel (3 godkända snabbserier)', part2, gf.part2ViaFalt ? escapeMedalHtml(gf.part2Detail || 'fältmedalj') : `${gf.part2SeriesCount || 0}/${gf.part2Required || 3} serier`)}
            <div class="mt-2">${gfStatus}</div>
        </div></div>
        <p class="text-muted small">Precisionsdelen byggs av validerade guldserier och resultat från hemmatävlingar. Serier valideras i kön högst upp på fliken (eller via QR).</p>

        <h6 class="text-muted">Mästarmärket</h6>
        <div id="memberMastarBlock" class="mb-2"><div class="text-muted small">Laddar…</div></div>`;

    loadMemberMastar(memberId);
}

// Mästarmärket detail in the secretary per-member panel — auto-qualifying years (silver fält +
// silver precision same year) plus a functionary add/remove for years earned before the system.
function loadMemberMastar(memberId) {
    const block = document.getElementById('memberMastarBlock');
    if (!block) return;
    fetch(`/umbraco/surface/Marken/GetMemberMastar?memberId=${memberId}`)
        .then(r => r.json())
        .then(d => {
            if (!d.success) { block.innerHTML = ''; return; }
            const m = d.mastar || {};
            const canEdit = !!d.canEdit;
            const held = m.earnedLevel
                ? `<span class="badge bg-success"><i class="bi bi-check-lg"></i> ${escapeMedalHtml(m.levelDisplay || m.earnedLevel)}</span>`
                : '<span class="badge bg-secondary">Ej taget</span>';
            const years = (m.qualifyingYearList || []);
            const yearChips = years.length
                ? years.map(y => `<span class="badge bg-light text-dark border me-1 mb-1">${y}${canEdit ? ` <a href="#" onclick="setMastarYear(${memberId}, ${y}, false);return false;" class="text-danger text-decoration-none" title="Ta bort">×</a>` : ''}</span>`).join('')
                : '<span class="text-muted small">Inga kvalificerande år registrerade.</span>';
            const adder = canEdit
                ? `<div class="input-group input-group-sm mt-2" style="max-width:260px;">
                     <span class="input-group-text">Lägg till år</span>
                     <input type="number" class="form-control" id="mastarYearInput_${memberId}" min="1950" max="2099" placeholder="${new Date().getFullYear()}">
                     <button class="btn btn-outline-warning" onclick="addMastarYear(${memberId})">Lägg till</button>
                   </div>
                   <div class="form-text">Kvalificerande år = standardmedalj i silver i både fält och precision samma år. Auto-hämtas; lägg till äldre år manuellt här.</div>`
                : '';
            block.innerHTML = `
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-1">
                    <span>${escapeMedalHtml(m.statusText || '')}</span>${held}
                </div>
                <div>${yearChips}</div>${adder}`;
        })
        .catch(() => { block.innerHTML = ''; });
}

function setMastarYear(memberId, year, qualified) {
    fetch('/umbraco/surface/Marken/SetMastarQualifyingYear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryTokenMedal() },
        body: JSON.stringify({ memberId: memberId, year: year, qualified: qualified })
    }).then(r => r.json()).then(d => { if (d.success) loadMemberMastar(memberId); else alert(d.message || 'Fel'); });
}
function addMastarYear(memberId) {
    const input = document.getElementById('mastarYearInput_' + memberId);
    const year = parseInt(input && input.value) || 0;
    if (year < 1950) { alert('Ange ett giltigt år.'); return; }
    setMastarYear(memberId, year, true);
}

// ── Series validation queue (club admin tab) ──────────────────────
function loadClubMarkenQueue() {
    const card = document.getElementById('clubMarkenQueueCard');
    const content = document.getElementById('clubMarkenQueueContent');
    if (!card || !content) return;
    fetch(`/umbraco/surface/Marken/GetClubPendingSeries?clubId=${clubId}`)
        .then(r => r.json())
        .then(d => {
            const list = (d.items || []);
            if (!d.success || list.length === 0) { card.style.display = 'none'; return; }
            card.style.display = 'block';
            document.getElementById('clubMarkenQueueCount').textContent = `(${list.length})`;
            content.innerHTML = list.map(s => renderClubQueueItem(s, d.canValidate)).join('');
        })
        .catch(() => { card.style.display = 'none'; });
}

function markenEvidenceDescAdmin(s) {
    if (s.kind === 'stormastar') {
        return `Stormästar – ${escapeMedalHtml(s.scopeName)} ${s.year}${s.competitionName ? ' (' + escapeMedalHtml(s.competitionName) + ')' : ''}: <strong>${s.points} p</strong> <span class="text-muted">(${s.participants} dlt, plac ${s.place})</span>`;
    }
    if (s.kind === 'comp') {
        const lvl = s.reachedLevel
            ? ` <span class="badge bg-light text-dark border">${escapeMedalHtml(s.reachedLevel)}</span>`
            : ' <span class="text-warning small">under krav</span>';
        return `${escapeMedalHtml(s.familyName)} – ${escapeMedalHtml(s.competitionName)}: <strong>${s.total}</strong> <span class="text-muted">(${escapeMedalHtml(s.weaponGroup)})</span>${lvl}`;
    }
    switch (s.discipline) {
        case 'Precision':
            return `Precisionsserie <strong>${s.total} p</strong> <span class="text-muted">(${escapeMedalHtml(s.weaponGroup)})</span>${s.qualifies ? '' : ' <span class="text-warning small">under guldkrav</span>'}`;
        case 'Air':
            return `Luftpistolserie <strong>${s.total} p</strong> <span class="text-muted">(nivå ${escapeMedalHtml(s.claimedLevel)})</span>`;
        case 'Snabbpistol':
            return `Snabbpistolserie <strong>${s.total} p</strong> <span class="text-muted">(nivå ${escapeMedalHtml(s.claimedLevel)})</span>`;
        default: // Tillämpning
            return `Snabbserie (tillämpning) ${escapeMedalHtml(s.claimedLevel)} <span class="text-muted">(${escapeMedalHtml(s.targetName)})</span>`;
    }
}

function renderClubQueueItem(s, canValidate) {
    const shots = (s.kind !== 'comp' && s.seriesType === 'Precision' && s.shots) ? `<div class="small text-muted">${s.shots.map(escapeMedalHtml).join(' · ')}</div>` : '';
    const photoUrl = s.kind === 'comp' ? `/umbraco/surface/Marken/GetCompResultPhoto?id=${s.id}`
        : s.kind === 'stormastar' ? `/umbraco/surface/Marken/GetStormastarPhoto?id=${s.id}`
        : `/umbraco/surface/Marken/GetSeriePhoto?id=${s.id}`;
    const photo = s.hasPhoto ? ` <a href="${photoUrl}" target="_blank" rel="noopener" title="Foto"><i class="bi bi-camera"></i></a>` : '';
    const buttons = canValidate
        ? `<div class="text-nowrap mt-1">
             <button class="btn btn-sm btn-success" onclick="clubQueueAct('${s.kind}', ${s.id}, true)"><i class="bi bi-check-lg me-1"></i>Godkänn</button>
             <button class="btn btn-sm btn-outline-danger" onclick="clubQueueAct('${s.kind}', ${s.id}, false)"><i class="bi bi-x-lg me-1"></i>Avvisa</button>
           </div>`
        : '<div class="small text-muted mt-1">Endast styrelse/skjutledare kan validera.</div>';
    return `<div class="border-bottom py-2">
        <div><strong>${escapeMedalHtml(s.memberName)}</strong></div>
        <div>${markenEvidenceDescAdmin(s)}${photo}</div>${shots}${buttons}</div>`;
}

function clubQueueAct(kind, id, approve) {
    if (!approve && !confirm('Avvisa?')) return;
    const url = approve ? '/umbraco/surface/Marken/VerifyEvidence' : '/umbraco/surface/Marken/RejectEvidence';
    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ kind, id })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte uppdatera.')); return; }
        loadClubMarkenQueue();
        loadClubMarken(); // a validation may complete a member's guldfodring
    })
    .catch(() => alert('Något gick fel.'));
}

function awardMarkenBadge(memberId, level, name) {
    let uniqueNumber = null;
    if (level === 'Guld') {
        uniqueNumber = prompt('Tilldela guldmärket. Ange registreringsnummer från förbundet (kan lämnas tomt och fyllas i senare):', '');
        if (uniqueNumber === null) return;
    } else if (!confirm(`Tilldela ${level.toLowerCase()}märket till ${name}?`)) {
        return;
    }
    fetch('/umbraco/surface/Marken/AwardBadge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ memberId, level, year: 0, uniqueNumber })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte tilldela.')); return; }
        openMemberMarkenDetail(memberId, name);
        loadClubMarken();
    })
    .catch(() => alert('Kunde inte tilldela märket.'));
}

function setMarkenGuldNumber(badgeId, memberId, name) {
    const input = document.getElementById('guldNr_' + badgeId);
    const uniqueNumber = input ? input.value.trim() : '';
    fetch('/umbraco/surface/Marken/SetBadgeUniqueNumber', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ badgeId, uniqueNumber })
    })
    .then(r => r.json())
    .then(res => {
        alert(res.message || (res.success ? 'Sparat.' : 'Kunde inte spara.'));
        if (res.success) loadClubMarken();
    })
    .catch(() => alert('Kunde inte spara registreringsnummer.'));
}

