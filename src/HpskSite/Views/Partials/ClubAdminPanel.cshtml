// ===== SERIES TAB =====
let clubSeriesLoaded = false;
let clubSeriesClubLookup = {};

document.getElementById('clubseries-tab').addEventListener('shown.bs.tab', function () {
    if (!clubSeriesLoaded) {
        loadClubSeriesClubLookup();
        loadClubSeriesList();
        clubSeriesLoaded = true;
    }
});

function loadClubSeriesClubLookup() {
    fetch('/umbraco/surface/ClubAdmin/GetClubsForRegistration')
        .then(r => r.json())
        .then(data => {
            if (data.success && data.clubs) {
                data.clubs.forEach(c => { clubSeriesClubLookup[c.id] = c.name; });
            }
        })
        .catch(err => console.error('Error loading clubs for series lookup:', err));
}

function loadClubSeriesList() {
    const spinner = document.getElementById('clubSeriesLoadingSpinner');
    const tableContainer = document.getElementById('clubSeriesTableContainer');
    const tbody = document.getElementById('clubSeriesTableBody');
    const errorAlert = document.getElementById('clubSeriesErrorAlert');
    const errorMessage = document.getElementById('clubSeriesErrorMessage');
    const noSeriesAlert = document.getElementById('noClubSeriesAlert');

    spinner.classList.remove('d-none');
    errorAlert.classList.add('d-none');
    noSeriesAlert.classList.add('d-none');

    const token = getAntiForgeryToken();

    fetch('/umbraco/surface/CompetitionAdmin/GetSeriesList', {
        method: 'GET',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        credentials: 'include'
    })
    .then(r => r.json())
    .then(data => {
        spinner.classList.add('d-none');

        if (!data.success) {
            errorMessage.textContent = data.message || 'Kunde inte ladda serier';
            errorAlert.classList.remove('d-none');
            tbody.innerHTML = '<tr class="text-muted"><td colspan="5" class="text-center py-4">Fel vid laddning av serier</td></tr>';
            return;
        }

        // Filter to only this club's series (server already filters for club admins, but double-check)
        const clubSeries = (data.data || []).filter(s => s.clubId === @clubId);

        if (clubSeries.length === 0) {
            tableContainer.classList.add('d-none');
            noSeriesAlert.classList.remove('d-none');
            tbody.innerHTML = '';
        } else {
            tableContainer.classList.remove('d-none');
            noSeriesAlert.classList.add('d-none');
            renderClubSeries(clubSeries);
        }
    })
    .catch(error => {
        spinner.classList.add('d-none');
        errorMessage.textContent = error.message || 'Nätverksfel';
        errorAlert.classList.remove('d-none');
    });
}

function renderClubSeries(seriesList) {
    const tbody = document.getElementById('clubSeriesTableBody');
    tbody.innerHTML = seriesList.map(series => {
        const statusBadge = (series.isActive === true || series.isActive === 'true')
            ? '<span class="badge bg-success">Aktiv</span>'
            : '<span class="badge bg-secondary">Inaktiv</span>';
        const strategyBadge = series.seriesCalculationStrategy
            ? ' <span class="badge bg-info ms-1" title="Serieresultat konfigurerad"><i class="bi bi-bar-chart"></i></span>'
            : '';
        const start = series.startDate ? new Date(series.startDate).toLocaleDateString('sv-SE') : '-';
        const end = series.endDate ? new Date(series.endDate).toLocaleDateString('sv-SE') : '-';
        const dateRange = (start === '-' && end === '-') ? '-'
            : (start !== '-' && end !== '-') ? `${start} - ${end}`
            : (start !== '-') ? `Från ${start}` : `Till ${end}`;
        const shortDesc = series.shortDescription ? clubSeriesEscapeHtml(series.shortDescription) : '<em>Ingen beskrivning</em>';
        const nameEscaped = clubSeriesEscapeHtml(series.name).replace(/'/g, "\\'");

        return `<tr data-series-id="${series.id}">
            <td><strong>${clubSeriesEscapeHtml(series.name)}${strategyBadge}</strong><br><small class="text-muted">${shortDesc}</small></td>
            <td><strong>${dateRange}</strong></td>
            <td>${statusBadge}</td>
            <td class="text-center"><span class="badge bg-info">${series.competitionCount || 0}</span></td>
            <td class="text-end">
                <button class="btn btn-sm btn-outline-primary" onclick="openSeriesEditModal(${series.id})" title="Redigera"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-sm btn-outline-info" onclick="openSeriesCopyModal(${series.id})" title="Kopiera"><i class="bi bi-files"></i></button>
                <button class="btn btn-sm btn-outline-danger" onclick="openSeriesDeleteModal(${series.id}, '${nameEscaped}', ${series.competitionCount || 0})" title="Ta bort"><i class="bi bi-trash"></i></button>
            </td>
        </tr>`;
    }).join('');
}

function clubSeriesEscapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// ---- Series modal opener functions (normally in AdminSeriesList.cshtml) ----

function clubSeriesFormatDateForInput(dateStr) {
    if (!dateStr) return '';
    const date = new Date(dateStr);
    return date.toISOString().split('T')[0];
}

function lockSeriesOrganizerToClub() {
    const clubSelect = document.getElementById('seriesClubId');
    const regionSelect = document.getElementById('seriesRegionalFederation');
    if (clubSelect) {
        clubSelect.value = '@clubId';
        clubSelect.disabled = true;
    }
    if (regionSelect) {
        regionSelect.value = '';
        regionSelect.disabled = true;
    }
}

// Create series modal
function openCreateClubSeriesModal() {
    document.getElementById('seriesId').value = '0';
    document.getElementById('seriesName').value = '';
    document.getElementById('seriesShortDescription').value = '';
    document.getElementById('seriesDescription').value = '';
    document.getElementById('seriesStartDate').value = '';
    document.getElementById('seriesEndDate').value = '';
    document.getElementById('showInMenu').checked = false;
    document.getElementById('isActive').value = 'true';

    // Reset strategy fields
    if (typeof populateSeriesStrategy === 'function') {
        populateSeriesStrategy('', '');
    }

    document.getElementById('seriesEditModalLabel').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Ny serie';

    const modalElement = document.getElementById('seriesEditModal');
    const modal = window.seriesEditModalInstance || new bootstrap.Modal(modalElement);
    window.seriesEditModalInstance = modal;
    modal.show();

    // Lock organizer after modal renders
    lockSeriesOrganizerToClub();
}

// Edit series modal
window.openSeriesEditModal = function(seriesId) {
    const token = getAntiForgeryToken();

    fetch('/umbraco/surface/CompetitionAdmin/GetSeriesList', {
        method: 'GET',
        headers: { 'RequestVerificationToken': token },
        credentials: 'same-origin'
    })
    .then(r => r.json())
    .then(data => {
        if (data.success && data.data) {
            const series = data.data.find(s => s.id === seriesId);
            if (series) {
                window.currentSeriesData = series;
                document.getElementById('seriesId').value = series.id;
                document.getElementById('seriesName').value = series.name || '';
                document.getElementById('seriesShortDescription').value = series.shortDescription || '';

                let descriptionContent = series.description || '';
                if (descriptionContent && descriptionContent.startsWith('{')) {
                    try {
                        const parsed = JSON.parse(descriptionContent);
                        descriptionContent = parsed.markup || descriptionContent;
                    } catch (e) { }
                }
                document.getElementById('seriesDescription').value = descriptionContent;

                if (series.startDate) {
                    const startDateInput = document.getElementById('seriesStartDate');
                    const formatted = clubSeriesFormatDateForInput(series.startDate);
                    startDateInput.value = formatted;
                    if (startDateInput._flatpickr) startDateInput._flatpickr.setDate(formatted);
                }
                if (series.endDate) {
                    const endDateInput = document.getElementById('seriesEndDate');
                    const formatted = clubSeriesFormatDateForInput(series.endDate);
                    endDateInput.value = formatted;
                    if (endDateInput._flatpickr) endDateInput._flatpickr.setDate(formatted);
                }

                document.getElementById('showInMenu').checked = series.showInMenu;
                document.getElementById('isActive').value = series.isActive ? 'true' : 'false';

                if (typeof populateSeriesStrategy === 'function') {
                    populateSeriesStrategy(
                        series.seriesCalculationStrategy || '',
                        series.seriesCalculationConfig || ''
                    );
                }

                document.getElementById('seriesEditModalLabel').innerHTML = '<i class="bi bi-pencil me-2"></i>Redigera serie';

                const modalElement = document.getElementById('seriesEditModal');
                const modal = window.seriesEditModalInstance || new bootstrap.Modal(modalElement);
                window.seriesEditModalInstance = modal;
                modal.show();

                // Lock organizer after modal renders
                lockSeriesOrganizerToClub();
            }
        }
    })
    .catch(error => {
        console.error('Error loading series:', error);
