    color: var(--bs-body-color);
    border-radius: 8px;
    padding: 8px 12px;
    border-left: 3px solid transparent;
}
.club-admin-panel .admin-rail .nav-link:hover {
    /* One step up from the rail's own tertiary surface so hover stays visible. */
    background-color: var(--bs-secondary-bg);
}
.club-admin-panel .admin-rail .nav-link.active {
    /* -text-emphasis on -bg-subtle is Bootstrap's contrast-safe pairing in BOTH themes
       (dark-navy text on pale blue in light; light-blue text on dark navy in dark). */
    background-color: var(--bs-primary-bg-subtle);
    color: var(--bs-primary-text-emphasis);
    font-weight: 600;
    border-left-color: var(--bs-primary);
}

.club-admin-panel .table {
    margin-top: 1rem;
}

.club-admin-panel .modal-header.bg-danger {
    border-bottom: none;
}

/* Member Avatar Styling */
.member-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: bold;
    color: white;
    background-color: var(--bs-primary);
    overflow: hidden;
    flex-shrink: 0;
}

.member-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.member-name-cell {
    display: flex;
    align-items: center;
    gap: 10px;
}

/* CKEditor dark mode support */
[data-bs-theme="dark"] .club-admin-panel .ck.ck-editor__main > .ck-editor__editable {
    background-color: var(--bs-body-bg);
    color: var(--bs-body-color);
    border-color: var(--bs-border-color);
}

[data-bs-theme="dark"] .club-admin-panel .ck.ck-toolbar {
    background-color: var(--bs-tertiary-bg);
    border-color: var(--bs-border-color);
}

[data-bs-theme="dark"] .club-admin-panel .ck.ck-toolbar .ck-button {
    color: var(--bs-body-color);
}

[data-bs-theme="dark"] .club-admin-panel .ck.ck-toolbar .ck-button:hover {
    background-color: var(--bs-secondary-bg);
}

[data-bs-theme="dark"] .club-admin-panel .ck.ck-editor__editable.ck-focused {
    border-color: var(--bs-primary);
}

/* Members table: clickable sort headers + the search box on the heading row */
.club-admin-panel .club-member-sort {
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
}

.club-admin-panel .club-member-sort:hover {
    color: var(--bs-primary);
}

.club-admin-panel .club-member-search {
    width: 260px;
}

/* Doubled at-sign below on purpose: Razor reads a bare at-sign as C#, even inside style. */
@@media (max-width: 575.98px) {
    .club-admin-panel .club-member-search {
        width: 100%;
    }
}
</style>

<script>
// Club admin's "remove from club": sets this club's membership to Utträdd (person + data kept).
async function endClubMembership() {
    var memberId = window._editMemberId;
    if (!memberId) return;
    if (!confirm('Avsluta medlemskapet i klubben?\n\nMedlemmen sätts som "Utträdd" och försvinner från aktiva listor. Personen, inloggningen och all data finns kvar (och ev. medlemskap i andra klubbar) — det går att återaktivera senare.')) return;
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('memberId', memberId);
    fd.append('clubId', @clubId);
    try {
        var r = await fetch('/umbraco/surface/ClubMembership/EndMembership', { method: 'POST', body: fd });
        var d = await r.json();
        if (d.success) {
            var statusSel = document.getElementById('editMembershipStatus');
            if (statusSel) statusSel.value = 'Utträdd';
            if (d.memberUntil) { var mu = document.getElementById('editMembershipMemberUntil'); if (mu) mu.value = d.memberUntil; }
            if (typeof loadClubMembers === 'function') loadClubMembers();
            alert('Medlemskapet i klubben har avslutats.');
        } else {
            alert('Fel: ' + (d.message || 'Kunde inte avsluta medlemskap'));
        }
    } catch (e) {
        alert('Kunde inte avsluta medlemskap: ' + e.message);
    }
}

// ---- Member keys + föreningsintyg (member-database expansion) ----
function meToken() {
    var el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}
function meEsc(s) {
    return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

// ---- Per-club membership (ClubMembership) ----
// Cached club-member list for the family multi-select [{id, name}].
var _clubMemberOptions = null;
function ensureClubMemberOptions() {
    if (_clubMemberOptions) return Promise.resolve(_clubMemberOptions);
    return fetch('/umbraco/surface/ClubAdmin/GetClubMembersForClubAdmin?clubId=' + @clubId)
        .then(function (r) { return r.json(); })
        .then(function (resp) {
            _clubMemberOptions = (resp && resp.success ? resp.data : []).map(function (m) {
                return { id: m.id, name: ((m.firstName || '') + ' ' + (m.lastName || '')).trim() || m.email || ('#' + m.id) };
            });
            return _clubMemberOptions;
        })
        .catch(function () { _clubMemberOptions = []; return _clubMemberOptions; });
}

function loadClubMembership(memberId) {
    fetch('/umbraco/surface/ClubMembership/GetMembership?memberId=' + memberId + '&clubId=' + @clubId)
        .then(function (r) { return r.json(); })
        .then(function (resp) {
            var d = (resp && resp.success) ? resp.data : {};
            // Default membership type = Senior when none set yet.
            document.getElementById('editMembershipType').value = d.membershipType || 'Senior';
            document.getElementById('editMembershipStatus').value = d.membershipStatus || 'Aktiv';
            document.getElementById('editMembershipMemberSince').value = d.memberSince || '';
            document.getElementById('editMembershipMemberUntil').value = d.memberUntil || '';
            document.getElementById('editMembershipEndReason').value = d.endReason || '';
            document.getElementById('editMembershipBgDate').value = d.backgroundCheckDate || '';
            document.getElementById('editMembershipBgApproved').checked = !!d.backgroundCheckApproved;
            document.getElementById('editMembershipFederations').value = d.federations || '';
            document.getElementById('editMembershipInMap').checked = !!d.registeredInMap;
            document.getElementById('editMembershipNotes').value = d.memberNotes || '';
            renderFamilyBlock(memberId, d);
        });
}

function renderFamilyBlock(memberId, d) {
    var coveredBlock = document.getElementById('editFamilyCoveredBlock');
    var primaryBlock = document.getElementById('editFamilyPrimaryBlock');
    // A covered (non-primary) family member: show read-only note, hide the picker.
    if (d.inHousehold && !d.isHouseholdPrimary && d.householdMainMemberId) {
        document.getElementById('editFamilyMainName').textContent = d.householdMainMemberName || 'okänd';
        coveredBlock.style.display = '';
        primaryBlock.style.display = 'none';
        return;
    }
    coveredBlock.style.display = 'none';
    primaryBlock.style.display = '';
    var selectedIds = (d.householdMemberIds || []).map(Number);
    ensureClubMemberOptions().then(function (opts) {
        var sel = document.getElementById('editFamilyMembers');
        sel.innerHTML = opts
            .filter(function (o) { return o.id !== memberId; })
            .map(function (o) {
                var chosen = selectedIds.indexOf(o.id) !== -1 ? ' selected' : '';
                return '<option value="' + o.id + '"' + chosen + '>' + meEsc(o.name) + '</option>';
            }).join('');
    });
}

// Saves the membership scalar fields; returns the fetch promise. Called by the main modal Save.
function saveClubMembership() {
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('memberId', window._editMemberId);
    fd.append('clubId', @clubId);
    fd.append('membershipType', document.getElementById('editMembershipType').value);
    fd.append('membershipStatus', document.getElementById('editMembershipStatus').value);
    fd.append('memberSince', document.getElementById('editMembershipMemberSince').value);
    fd.append('memberUntil', document.getElementById('editMembershipMemberUntil').value);
    fd.append('endReason', document.getElementById('editMembershipEndReason').value);
    fd.append('backgroundCheckApproved', document.getElementById('editMembershipBgApproved').checked);
    fd.append('backgroundCheckDate', document.getElementById('editMembershipBgDate').value);
    fd.append('registeredInMap', document.getElementById('editMembershipInMap').checked);
    fd.append('federations', document.getElementById('editMembershipFederations').value);
    fd.append('memberNotes', document.getElementById('editMembershipNotes').value);
    return fetch('/umbraco/surface/ClubMembership/SaveMembership', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); });
}

// Applies the family multi-select (this member becomes Huvudmedlem). Skipped for covered members.
function saveClubHousehold() {
    var primaryBlock = document.getElementById('editFamilyPrimaryBlock');
    if (!primaryBlock || primaryBlock.style.display === 'none') return Promise.resolve({ success: true });
    var sel = document.getElementById('editFamilyMembers');
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('primaryMemberId', window._editMemberId);
    fd.append('clubId', @clubId);
    Array.from(sel.selectedOptions).forEach(function (o) { fd.append('memberIds', o.value); });
    return fetch('/umbraco/surface/ClubMembership/SetHousehold', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); });
}

function loadMemberKeys(memberId) {
    var box = document.getElementById('memberKeysList');
    if (!box) return;
    box.textContent = 'Laddar…';
    fetch('/umbraco/surface/MemberAccessKey/ListForMember?memberId=' + memberId)
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.success) { box.textContent = d.message || 'Kunde inte ladda'; return; }
            if (!d.data || !d.data.length) { box.innerHTML = '<span class="text-muted">Inga nycklar registrerade.</span>'; return; }
            box.innerHTML = d.data.map(function (k) {
                var dep = (k.deposit != null && k.deposit !== '') ? (' · ' + meEsc(k.deposit) + ' kr') : '';
                var issued = k.issuedDate ? (' · ' + meEsc(k.issuedDate)) : '';
                var ret = k.returnedDate ? (' · återlämnad ' + meEsc(k.returnedDate)) : '';
                return '<div class="d-flex justify-content-between align-items-center border-bottom py-1">' +
                    '<span><span class="badge bg-secondary me-1">' + meEsc(k.keyType) + '</span>' + meEsc(k.identifier) + dep + issued + ret + '</span>' +
                    '<button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteMemberKey(' + k.id + ')"><i class="bi bi-trash"></i></button></div>';
            }).join('');
        });
}
function addMemberKey() {
    var memberId = window._editMemberId;
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('id', 0);
    fd.append('memberId', memberId);
    fd.append('keyType', document.getElementById('newKeyType').value);
    fd.append('identifier', document.getElementById('newKeyIdentifier').value);
    fd.append('deposit', document.getElementById('newKeyDeposit').value);
    fd.append('issuedDate', document.getElementById('newKeyIssued').value);
    fd.append('returnedDate', '');
    fd.append('notes', '');
    fetch('/umbraco/surface/MemberAccessKey/SaveKey', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.success) { alert(d.message || 'Kunde inte spara'); return; }
            document.getElementById('newKeyIdentifier').value = '';
            document.getElementById('newKeyDeposit').value = '';
            document.getElementById('newKeyIssued').value = '';
            loadMemberKeys(memberId);
        });
}
function deleteMemberKey(id) {
    if (!confirm('Ta bort nyckeln?')) return;
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('id', id);
    fetch('/umbraco/surface/MemberAccessKey/DeleteKey', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); }).then(function () { loadMemberKeys(window._editMemberId); });
}

// ---- Club-wide keys / codes register (overview + CRUD) ----
var _clubKeys = [];

function showClubKeysModal() {
    ckResetForm();
    document.getElementById('ckSearch').value = '';
    // Populate the member picker (cached), then show + load.
    ensureClubMemberOptions().then(function (opts) {
        var sel = document.getElementById('ckMember');
        sel.innerHTML = '<option value="">– välj medlem –</option>' +
            opts.slice().sort(function (a, b) { return a.name.localeCompare(b.name, 'sv'); })
                .map(function (m) { return '<option value="' + m.id + '">' + meEsc(m.name) + '</option>'; }).join('');
    });
    new bootstrap.Modal(document.getElementById('clubKeysModal')).show();
    loadClubKeys();
}

function loadClubKeys() {
    var body = document.getElementById('ckTableBody');
    body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Laddar…</td></tr>';
    fetch('/umbraco/surface/MemberAccessKey/ListForClub?clubId=' + @clubId)
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.success) { body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">' + meEsc(d.message || 'Kunde inte ladda') + '</td></tr>'; return; }
            _clubKeys = d.data || [];
            ckRenderTable();
        })
        .catch(function () { body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Ett fel uppstod.</td></tr>'; });
}

function ckRenderTable() {
    var body = document.getElementById('ckTableBody');
    var q = (document.getElementById('ckSearch').value || '').toLowerCase().trim();
    var rows = _clubKeys.filter(function (k) {
        if (!q) return true;
        return ((k.memberName || '') + ' ' + (k.identifier || '') + ' ' + (k.keyType || '')).toLowerCase().indexOf(q) !== -1;
    });
    if (!rows.length) {
        body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">' +
            (_clubKeys.length ? 'Inga poster matchar sökningen.' : 'Inga nycklar eller koder registrerade.') + '</td></tr>';
        return;
    }
    body.innerHTML = rows.map(function (k) {
        var returned = !!k.returnedDate;
        var dep = (k.deposit != null && k.deposit !== '') ? (meEsc(k.deposit) + ' kr') : '';
        var badge = returned
            ? '<span class="badge bg-secondary ms-1">Återlämnad</span>'
            : '<span class="badge bg-success ms-1">Utestående</span>';
        return '<tr class="' + (returned ? 'text-muted' : '') + '">' +
            '<td>' + meEsc(k.memberName || ('#' + k.memberId)) + '</td>' +
            '<td>' + meEsc(k.keyType) + '</td>' +
            '<td><strong>' + meEsc(k.identifier) + '</strong>' + badge + '</td>' +
            '<td class="text-end">' + dep + '</td>' +
            '<td>' + meEsc(k.issuedDate || '') + '</td>' +
            '<td>' + meEsc(k.returnedDate || '') + '</td>' +
            '<td>' + meEsc(k.notes || '') + '</td>' +
            '<td class="text-end text-nowrap">' +
                '<button type="button" class="btn btn-outline-primary btn-sm me-1" onclick="editClubKey(' + k.id + ')" title="Redigera"><i class="bi bi-pencil"></i></button>' +
                '<button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteClubKey(' + k.id + ')" title="Ta bort"><i class="bi bi-trash"></i></button>' +
            '</td></tr>';
    }).join('');
}

function ckResetForm() {
    document.getElementById('ckId').value = '0';
    document.getElementById('ckMember').value = '';
    document.getElementById('ckMember').disabled = false;
    document.getElementById('ckType').value = 'Nyckel';
    document.getElementById('ckIdentifier').value = '';
    document.getElementById('ckDeposit').value = '';
    document.getElementById('ckIssued').value = '';
    document.getElementById('ckReturned').value = '';
    document.getElementById('ckNotes').value = '';
    document.getElementById('ckFormTitle').innerHTML = '<i class="bi bi-plus-circle me-2"></i>Lägg till post';
    document.getElementById('ckSaveBtn').innerHTML = '<i class="bi bi-check2-circle me-2"></i>Lägg till post';
    document.getElementById('ckCancelEditBtn').classList.add('d-none');
}

function editClubKey(id) {
    var k = _clubKeys.find(function (x) { return x.id === id; });
    if (!k) return;
    document.getElementById('ckId').value = k.id;
    // A key belongs to a fixed member — lock the picker while editing.
    var sel = document.getElementById('ckMember');
    sel.value = String(k.memberId);
    sel.disabled = true;
    document.getElementById('ckType').value = k.keyType || 'Nyckel';
    document.getElementById('ckIdentifier').value = k.identifier || '';
    document.getElementById('ckDeposit').value = (k.deposit != null ? k.deposit : '');
    document.getElementById('ckIssued').value = k.issuedDate || '';
    document.getElementById('ckReturned').value = k.returnedDate || '';
    document.getElementById('ckNotes').value = k.notes || '';
    document.getElementById('ckFormTitle').innerHTML = '<i class="bi bi-pencil me-2"></i>Redigera post';
    document.getElementById('ckSaveBtn').innerHTML = '<i class="bi bi-check2-circle me-2"></i>Spara ändringar';
    document.getElementById('ckCancelEditBtn').classList.remove('d-none');
    document.getElementById('ckMember').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function saveClubKey() {
    var id = document.getElementById('ckId').value || '0';
    var memberId = document.getElementById('ckMember').value;
    var identifier = document.getElementById('ckIdentifier').value.trim();
    if (!memberId) { alert('Välj en medlem.'); return; }
    if (!identifier) { alert('Ange en identifierare (t.ex. nyckelnummer eller kod).'); return; }

    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('id', id);
    fd.append('memberId', memberId);
    fd.append('keyType', document.getElementById('ckType').value);
    fd.append('identifier', identifier);
    fd.append('deposit', document.getElementById('ckDeposit').value);
    fd.append('issuedDate', document.getElementById('ckIssued').value);
    fd.append('returnedDate', document.getElementById('ckReturned').value);
    fd.append('notes', document.getElementById('ckNotes').value);

    var btn = document.getElementById('ckSaveBtn');
    btn.disabled = true;
    fetch('/umbraco/surface/MemberAccessKey/SaveKey', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            btn.disabled = false;
            if (!d.success) { alert(d.message || 'Kunde inte spara'); return; }
            ckResetForm();
            loadClubKeys();
        })
        .catch(function () { btn.disabled = false; alert('Ett fel uppstod.'); });
}

function deleteClubKey(id) {
    var k = _clubKeys.find(function (x) { return x.id === id; });
    var label = k ? (k.keyType + ' ' + k.identifier + ' (' + (k.memberName || '') + ')') : 'posten';
    if (!confirm('Ta bort ' + label + '?')) return;
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('id', id);
    fetch('/umbraco/surface/MemberAccessKey/DeleteKey', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.success) { alert(d.message || 'Kunde inte ta bort'); return; }
            loadClubKeys();
        });
}

// ── Överlämning från medlemsmodalen till fliken Aktivitet & Intyg ────────
// Aktiviteten och intygsloggen bor på egen flik. Härifrån går bara vägen dit — med medlemmen
// förvald, så den som stod i modalen inte hamnar på en tom sida och får leta upp personen igen.
function openActivityIntygForEditedMember() {
    var memberId = window._editMemberId;
    if (!memberId || typeof window.hpskOpenActivityForMember !== 'function') return;
    var modalEl = document.getElementById('editClubMemberModal');
    var modal = modalEl && window.bootstrap ? bootstrap.Modal.getInstance(modalEl) : null;
    // ⚠️ Vänta in att modalen är STÄNGD innan flikbytet. Bootstrap tar bort backdrop och
    // `overflow:hidden` på <body> i sin hide-animation; byter man flik mitt i den blir sidan
    // kvar olåsbar eller med en grå hinna över det man just navigerade till.
    if (modal) {
        modalEl.addEventListener('hidden.bs.modal', function once() {
            modalEl.removeEventListener('hidden.bs.modal', once);
            window.hpskOpenActivityForMember(memberId);
        });
        modal.hide();
    } else {
        window.hpskOpenActivityForMember(memberId);
    }
}

function loadMemberIntyg(memberId) {
    var box = document.getElementById('memberIntygList');
    if (!box) return;
    box.textContent = 'Laddar…';
    fetch('/umbraco/surface/Foreningsintyg/ListForMember?memberId=' + memberId)
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.success) { box.textContent = d.message || 'Kunde inte ladda'; return; }
            if (!d.data || !d.data.length) { box.innerHTML = '<span class="text-muted">Inga utfärdade föreningsintyg.</span>'; return; }
            box.innerHTML = d.data.map(function (i) {
                var desc = i.description ? (' – ' + meEsc(i.description)) : '';
                var by = i.issuedByName ? (' · ' + meEsc(i.issuedByName)) : '';
                return '<div class="d-flex justify-content-between align-items-center border-bottom py-1">' +
                    '<span><strong>' + meEsc(i.issuedDate) + '</strong> · ' + meEsc(i.purpose) + desc + by + '</span>' +
                    '<button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteMemberIntyg(' + i.id + ')"><i class="bi bi-trash"></i></button></div>';
            }).join('');
        });
}
function addMemberIntyg() {
    // ⚠️ _activityMemberId, INTE _editMemberId. Sedan intygsloggen flyttade till egen flik betyder
    // de två olika saker: den ena är "medlemmen fliken står på", den andra "medlemmen
    // redigeringsmodalen står på". Läses fel skrivs intyget på en annan person än den som visas.
    var memberId = window._activityMemberId;
    if (!memberId) { alert('Välj en medlem först.'); return; }
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('memberId', memberId);
    fd.append('issuedDate', document.getElementById('newIntygDate').value);
    fd.append('purpose', document.getElementById('newIntygPurpose').value);
    fd.append('description', document.getElementById('newIntygDescription').value);
    fd.append('notes', '');
    fetch('/umbraco/surface/Foreningsintyg/AddIntyg', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.success) { alert(d.message || 'Kunde inte spara'); return; }
            document.getElementById('newIntygPurpose').value = '';
            document.getElementById('newIntygDescription').value = '';
            loadMemberIntyg(memberId);
        });
}
function deleteMemberIntyg(id) {
    if (!confirm('Ta bort intyget ur loggen?')) return;
    var fd = new FormData();
    fd.append('__RequestVerificationToken', meToken());
    fd.append('id', id);
    fetch('/umbraco/surface/Foreningsintyg/DeleteIntyg', { method: 'POST', body: fd })
        .then(function (r) { return r.json(); }).then(function () { loadMemberIntyg(window._activityMemberId); });
}
</script>
