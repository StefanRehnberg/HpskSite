function editEvent(eventId) {
    const event = allEvents.find(e => e.id === eventId);
    if (!event) {
        alert('Händelse hittades inte');
        return;
    }

    // Update modal title
    document.getElementById('eventModalTitle').textContent = 'Redigera Händelse';

    // Populate form fields
    document.getElementById('eventId').value = event.id;
    document.getElementById('eventName').value = event.name || '';

    // Set event type — if not a known type, select "Annat" and populate custom field
    var typeVal = event.type || 'Träning';
    if (knownEventTypes.indexOf(typeVal) >= 0) {
        document.getElementById('eventType').value = typeVal;
        document.getElementById('eventCustomType').style.display = 'none';
        document.getElementById('eventCustomType').required = false;
        document.getElementById('eventCustomType').value = '';
    } else {
        document.getElementById('eventType').value = 'Annat';
        document.getElementById('eventCustomType').style.display = '';
        document.getElementById('eventCustomType').required = true;
        document.getElementById('eventCustomType').value = typeVal;
    }
    syncEventTypeValue();
    toggleEventDateRequired();
    document.getElementById('eventDescription').value = event.description || '';
    document.getElementById('event_venue').value = event.venue || '';
    document.getElementById('eventContactPerson').value = event.contactPerson || '';
    document.getElementById('eventContactEmail').value = event.contactEmail || '';
    document.getElementById('eventContactPhone').value = event.contactPhone || '';

    // Page name (URL slug)
    if (event.pageName) {
        document.getElementById('eventPageName').value = event.pageName;
        document.getElementById('eventPageNameGroup').style.display = '';
        document.getElementById('eventPageNameToggle').textContent = 'Dölj sidnamn';
    } else {
        document.getElementById('eventPageName').value = '';
        document.getElementById('eventPageNameGroup').style.display = 'none';
        document.getElementById('eventPageNameToggle').textContent = 'Ändra sidnamn';
    }
    updateEventUrlPreview();

    // Format date for datetime-local input
    if (event.date) {
        const eventDate = new Date(event.date);
        if (eventDate.getFullYear() > 1900) {
            const fp = document.getElementById('eventDate')._flatpickr;
            if (fp) {
                fp.setDate(eventDate);
            } else {
                document.getElementById('eventDate').value = eventDate.toISOString().slice(0, 16);
            }
        }
    }

    hpskEventRegFill('clubEvent', event);

    // Show modal
    new bootstrap.Modal(document.getElementById('eventModal')).show();
}

function saveEvent() {
    syncEventTypeValue();
    var resolvedType = document.getElementById('eventTypeValue').value;
    if (!resolvedType || !resolvedType.trim()) {
        document.getElementById('eventCustomType').focus();
        alert('Ange en händelsetyp.');
        return;
    }
    const form = document.getElementById('eventForm');
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    // Disable button and show loading state
    const saveBtn = document.querySelector('#eventModal .modal-footer .btn-primary');
    if (!saveBtn) return;
    const originalBtnText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sparar...';

    const formData = new FormData(form);
    const eventId = formData.get('eventId');
    const url = eventId ? '/umbraco/surface/Club/EditClubEvent' : '/umbraco/surface/Club/CreateClubEvent';

    // Add clubId and anti-forgery token
    formData.append('clubId', clubId);
    hpskEventRegAppend('clubEvent', formData);
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    postFormWithTokenRetry(url, formData)
    .then(res => {
        let data = null;
        try { data = JSON.parse(res.text); } catch (e) { /* not JSON — server error page */ }
        if (data && data.success) {
            bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide();
            loadEvents();
            alert('Händelse sparad!');
        } else if (data) {
            alert('Fel: ' + data.message);
        } else if (res.status === 400 || res.status === 401 || res.status === 403) {
            alert('Din inloggning verkar ha gått ut. Ladda om sidan (F5), logga in igen och spara på nytt '
                + '— dina uppgifter i formuläret försvinner då, så kopiera gärna texten först.');
        } else {
            // Non-JSON response (timeout, proxy error) — show the status so the admin can
            // report something actionable instead of a bare "det gick fel".
            alert('Fel vid sparande av händelse (HTTP ' + res.status + '). Försök igen om en liten stund. '
                + 'Om felet återkommer, rapportera koden ovan.');
        }
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
    })
    .catch(error => {
        console.error('Error saving event:', error);
        alert('Fel vid sparande av händelse: ' + (error && error.message ? error.message : 'nätverksfel')
            + '. Kontrollera din uppkoppling och försök igen.');
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
    });
}

function deleteEvent(eventId, eventName) {
    showDeleteConfirmation(eventName, () => {
        const formData = new FormData();
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        fetch(`/umbraco/surface/Club/DeleteClubEvent?eventId=${eventId}`, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadEvents();
                alert('Händelse raderad!');
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error deleting event:', error);
            alert('Fel vid radering av händelse.');
        });
    });
}

// Copy Event
var copyEventFlatpickr = null;

function copyEvent(eventId) {
    const event = allEvents.find(e => e.id === eventId);
    if (!event) { alert('Händelse hittades inte'); return; }

    document.getElementById('copyEventSourceId').value = eventId;
    document.getElementById('copyEventName').value = event.name || '';

    // Init flatpickr on first use
    if (!copyEventFlatpickr) {
        copyEventFlatpickr = flatpickr('#copyEventDate', {
            locale: 'sv',
            enableTime: true,
            time_24hr: true,
            dateFormat: 'Y-m-d H:i'
        });
    }

    // Default to source date + 7 days
    if (event.date) {
        const newDate = new Date(event.date);
        newDate.setDate(newDate.getDate() + 7);
        copyEventFlatpickr.setDate(newDate);
    } else {
        copyEventFlatpickr.clear();
    }

    new bootstrap.Modal(document.getElementById('copyEventModal')).show();
}

function saveCopyEvent() {
    const sourceId = parseInt(document.getElementById('copyEventSourceId').value);
    const event = allEvents.find(e => e.id === sourceId);
    if (!event) { alert('Källhändelse hittades inte'); return; }

    const newDate = document.getElementById('copyEventDate').value;
    if (!newDate) { alert('Ange ett datum'); return; }

    const saveBtn = document.querySelector('#copyEventModal .modal-footer .btn-primary');
    const originalBtnText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kopierar...';

    const formData = new FormData();
    formData.append('clubId', clubId);
    formData.append('eventName', document.getElementById('copyEventName').value || event.name || '');
    formData.append('eventType', event.type || 'Träning');
    formData.append('eventDate', newDate);
    formData.append('venue', event.venue || '');
    formData.append('description', event.description || '');
    formData.append('contactPerson', event.contactPerson || '');
    formData.append('contactEmail', event.contactEmail || '');
    formData.append('contactPhone', event.contactPhone || '');
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    fetch('/umbraco/surface/Club/CreateClubEvent', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('copyEventModal')).hide();
            loadEvents();
            alert('Händelse kopierad!');
        } else {
            alert('Fel: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error copying event:', error);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
        alert('Fel vid kopiering av händelse.');
    });
}

