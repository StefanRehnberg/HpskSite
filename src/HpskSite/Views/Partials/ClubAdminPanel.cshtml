        return;
    }

    const formData = new FormData(form);
    formData.append('clubId', clubId);
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    fetch('/umbraco/surface/ClubAdmin/AddClubMember', {
        method: 'POST',
