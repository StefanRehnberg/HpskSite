function renderMarkenOrder(d) {
    const content = document.getElementById('markenOrderContent');
    if (!content) return;

    let html = '';

    // Warnings first: a Guld with no registration number cannot be ordered, and an unverified
    // self-report is something the club may want to look at before ordering on it.
    (d.warnings || []).forEach(w => {
        html += `<div class="alert alert-warning py-2 px-3 small mb-2">${escapeHtml(w)}</div>`;
    });

    // ── Att beställa ──
    html += '<h6 class="small text-uppercase text-muted mb-1">Att beställa</h6>';
    if (!d.order || d.order.length === 0) {
        // Tomma listan måste förklara sig när det SAMTIDIGT står namn under "Att dela ut" — annars
        // ser de två halvorna ut att säga emot varandra, vilket var precis vad som hände.
        const hasHandout = (d.handout || []).length > 0;
        html += `<p class="text-muted small">Inga märken att beställa för ${escapeHtml(String(d.year))}.`
             +  (hasHandout
                    ? ' Namnen under <em>Att dela ut</em> är årsprestationer utan föremål att beställa — se noteringen på varje rad.'
                    : '')
             +  '</p>';
    } else {
        html += '<div class="table-responsive"><table class="table table-sm align-middle mb-3">';
        html += '<thead><tr><th>Grupp</th><th>Artikel</th><th class="text-end" style="width:5rem;">Antal</th><th>Notering</th></tr></thead><tbody>';
        d.order.forEach(l => {
            html += `<tr><td class="text-muted">${escapeHtml(l.group)}</td>`
                 +  `<td>${escapeHtml(l.item)}</td>`
                 +  `<td class="text-end fw-semibold">${l.count}</td>`
                 +  `<td class="text-muted small">${escapeHtml(l.note || '')}</td></tr>`;
        });
        html += `<tr class="table-light"><td class="fw-semibold">Totalt</td><td></td>`
             +  `<td class="text-end fw-semibold">${d.totalItems}</td><td></td></tr>`;
        html += '</tbody></table></div>';
    }

    // ── Att dela ut ──
    html += '<h6 class="small text-uppercase text-muted mb-1">Att dela ut</h6>';
    if (!d.handout || d.handout.length === 0) {
        html += `<p class="text-muted small mb-0">Ingen medlem tog märke eller medalj under ${escapeHtml(String(d.year))}.</p>`;
    } else {
        html += '<div class="table-responsive"><table class="table table-sm align-middle mb-0">';
        html += '<thead><tr><th style="min-width:150px;">Medlem</th><th>Utmärkelse</th><th>Detalj</th></tr></thead><tbody>';
        d.handout.forEach(h => {
            (h.items || []).forEach((i, idx) => {
                // Gruppen står som prefix för att en valör ("Guld") är obegriplig utan sin familj —
                // men inte när posten redan börjar med gruppnamnet, vilket gav "Guldfodring
                // Guldfodring 2026 uppfylld".
                const showGroup = !i.item.toLowerCase().startsWith(i.group.toLowerCase());
                let item = (showGroup ? `<span class="text-muted">${escapeHtml(i.group)}</span> ` : '')
                         + escapeHtml(i.item);
                // Say which rows carry no physical badge — otherwise the two lists look like they
                // disagree about the count, and the count is what you order by.
                if (!i.orderable) item += ' <span class="badge bg-secondary-subtle text-secondary-emphasis">inget märke</span>';
                if (i.unverified) item += ' <span class="badge bg-warning-subtle text-warning-emphasis">ej granskad</span>';
                html += `<tr><td>${idx === 0 ? escapeHtml(h.name) : ''}</td>`
                     +  `<td>${item}</td>`
                     +  `<td class="text-muted small">${escapeHtml(i.detail || '')}</td></tr>`;
            });
        });
        html += '</tbody></table></div>';
    }

    content.innerHTML = html;
}

