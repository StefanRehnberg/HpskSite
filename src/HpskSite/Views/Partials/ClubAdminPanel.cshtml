                    </td>
                    <td>${g.startDate}</td>
                    <td class="text-center"><span class="badge bg-primary">${g.memberCount}</span></td>
                    <td class="text-center"><span class="badge bg-info">${g.trainerCount}</span></td>
                    <td class="text-end">
