function renderMemberMarkenDetail(data) {
    const body = document.getElementById('memberMarkenDetailBody');
    const d = data.detail || {};
    const canSign = !!data.canSignOff;
    const memberId = d.memberId;
    const name = d.memberName || '';
    const badges = d.badges || [];
    const art = d.artalsmarke || {};
    const gf = d.guldfodring || {};
    const year = d.year;

    const heldByLevel = {};
    badges.forEach(b => heldByLevel[b.level] = b);

    // ── Grundmärken (B/S/G) ──
    let badgeRows = '';
    ['Brons', 'Silver', 'Guld'].forEach(level => {
        const held = heldByLevel[level];
        let right;
        if (held) {
            const yr = held.achievedYear ? ` <span class="text-muted small">(${held.achievedYear})</span>` : '';
            const src = held.source === 'Skyttetrappan' ? ' <span class="badge bg-info-subtle text-info border border-info-subtle">Skyttetrappan</span>' : '';
            if (level === 'Guld') {
                const num = held.uniqueNumber ? escapeMedalAttr(held.uniqueNumber) : '';
                right = `<span class="text-success me-2"><i class="bi bi-check-circle-fill"></i> Tilldelat${src}</span>
                    <span class="input-group input-group-sm" style="width:auto;display:inline-flex;vertical-align:middle;">
                      <span class="input-group-text">År</span>
                      <input type="number" class="form-control" id="guldYear_${held.id}" value="${held.achievedYear || ''}" style="width:88px;" placeholder="ÅÅÅÅ" title="Året guldmärket erövrades — styr när elitprov får börja räknas">
                      <span class="input-group-text">Nr</span>
                      <input type="text" class="form-control" id="guldNr_${held.id}" value="${num}" style="width:120px;" placeholder="registreringsnr">
                      <button class="btn btn-outline-secondary" onclick="setMarkenGuldNumber(${held.id}, ${memberId}, '${escapeMedalAttr(name)}')">Spara</button>
                    </span>`;
            } else if (canSign) {
                // Brons/Silver: editable achieved-year so a functionary can record when it was taken.
                right = `<span class="text-success me-2"><i class="bi bi-check-circle-fill"></i> Tilldelat${src}</span>
                    <span class="input-group input-group-sm" style="width:auto;display:inline-flex;vertical-align:middle;">
                      <span class="input-group-text">År</span>
                      <input type="number" class="form-control" id="badgeYear_${held.id}" value="${held.achievedYear || ''}" style="width:88px;" placeholder="ÅÅÅÅ" title="Året märket erövrades">
                      <button class="btn btn-outline-secondary" onclick="setMarkenBadgeYear(${held.id}, ${memberId}, '${escapeMedalAttr(name)}')">Spara</button>
                    </span>`;
            } else {
                right = `<span class="text-success"><i class="bi bi-check-circle-fill"></i> Tilldelat${yr}${src}</span>`;
            }
        } else if (canSign) {
            right = `<button class="btn btn-sm btn-outline-warning" onclick="awardMarkenBadge(${memberId}, '${level}', '${escapeMedalAttr(name)}')">Tilldela ${level.toLowerCase()}</button>`;
        } else {
            right = '<span class="text-muted small">Ej tilldelat</span>';
        }
        badgeRows += `<li class="list-group-item d-flex justify-content-between align-items-center px-0 flex-wrap gap-2">
            <span><span class="badge bg-warning text-dark me-1">${level}</span></span><span>${right}</span></li>`;
    });

    // ── Årtalsmärke ──
    const artBlock = renderMarkenArtalsmarke(art, canSign, memberId, name);
    // (guldserieledger renderas av renderMarkenSeriesLedger, definierad längre ned)

    // ── Guldfodring (this year) ──
    const p = gf.persisted;
    const signed = p && p.signedOff;
    const part1 = gf.part1Met || (p && p.part1Met);
    const part2 = gf.part2Met || (p && p.part2Met);
    // The date answers "when was this shot?" — a club admin validating a Guldfodring needs it to
    // tell this year's series apart and to spot a serie entered under the wrong date.
    // Every precision series of the year, counted or not — the whole point is that a duplicate is
    // visible next to the series it duplicates, and that an excluded series can be put back.
    const seriesRows = renderMarkenSeriesLedger(gf.allPrecisionSeries || gf.bestSeries || [], canSign, memberId, name);

    // Read-only status — the year completes automatically when both parts are validated.
    const bothDone = gf.candidateBothMet || (p && p.fulfilled);
    let gfStatus;
    if (bothDone) {
        gfStatus = `<span class="badge bg-success"><i class="bi bi-check2-all me-1"></i>Guldfodring ${year} klar</span>`;
    } else {
        const need = [];
        if (!part1) need.push(`${gf.qualifyingSeriesCount || 0}/${gf.requiredSeries} guldserier`);
        if (!part2) need.push('snabbskyttedel');
        gfStatus = `<span class="text-muted small">Återstår: ${need.join(' + ')}. Blir klar automatiskt när delarna validerats.</span>`;
    }

    const partLine = (label, met, detail) =>
        `<div class="d-flex justify-content-between"><span>${met ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-circle text-muted"></i>'} ${label}</span><span class="text-muted small">${detail || ''}</span></div>`;

    body.innerHTML = `
        <h6 class="text-muted">Grundmärken</h6>
        <ul class="list-group list-group-flush mb-3">${badgeRows}</ul>

        <h6 class="text-muted">Årtalsmärke</h6>
        ${artBlock}

        <h6 class="text-muted">Guldfodring ${year}</h6>
        <div class="card border-warning-subtle mb-2"><div class="card-body py-2">
            ${partLine('Precisionsdel (3 godkända guldserier)', part1, `${gf.qualifyingSeriesCount || 0}/${gf.requiredSeries} serier`)}
            ${seriesRows ? `<ul class="small text-muted mt-1 mb-1">${seriesRows}</ul>` : ''}
            <hr class="my-2">
            ${partLine('Snabbskyttedel (3 godkända snabbserier)', part2, gf.part2ViaFalt ? escapeMedalHtml(gf.part2Detail || 'fältmedalj') : `${gf.part2SeriesCount || 0}/${gf.part2Required || 3} serier`)}
            <div class="mt-2">${gfStatus}</div>
        </div></div>
        <p class="text-muted small">Precisionsdelen byggs av validerade guldserier. Serier som skjutits på en
        tävling här på pistol.nu läggs in automatiskt och behöver inte skickas in — märks med tävlingens namn
        ovan. Har samma serie hamnat här två gånger: välj <em>Räkna inte</em> på den ena, så ligger den kvar i
        historiken men räknas bara en gång. Övriga serier valideras i kön högst upp på fliken (eller via QR).</p>

        ${renderMarkenFamiliesBlock(data.families, data.stormastar, canSign, memberId, name)}

        <h6 class="text-muted">Mästarmärket</h6>
        <div id="memberMastarBlock" class="mb-2"><div class="text-muted small">Laddar…</div></div>`;

    loadMemberMastar(memberId);
}

// One line per guldserie of the year, whichever way it got here. A series shot at a hosted
// competition is materialised into the same ledger as a hand-submitted one, so this list is where a
// duplicate becomes visible — and where it is resolved.
//
// Two different controls on purpose:
//   · "Räkna inte" / "Räkna med" works for BOTH kinds and is reversible. It is the only thing that
//     lasts on a competition series: deleting one is futile, the next reconciliation recreates it.
//   · "Ta bort" only appears on a hand-entered series, which is the only kind that can be a genuine
//     mis-entry rather than a consequence of a result.
function renderMarkenSeriesLedger(list, canSign, memberId, name) {
    if (!list || !list.length) return '';
    return list.map(s => {
        const sd = s.date ? new Date(s.date).toLocaleDateString('sv-SE') : '';
        const dateHtml = sd ? `<span class="text-nowrap">${escapeMedalHtml(sd)}</span> · ` : '';
        const src = s.fromCompetition
            ? `<span class="badge bg-light text-dark border ms-1" title="Kommer från ett inmatat tävlingsresultat">${escapeMedalHtml(s.competitionName || 'tävling')}</span>`
            : (s.source === 'Tävling'
                ? `<span class="text-muted ms-1">${escapeMedalHtml(s.label || 'tävling')}</span>`
                : '<span class="text-muted ms-1">guldserie</span>');
        // `counts` is undefined on the legacy bestSeries shape; only an explicit false means excluded.
        const excluded = s.counts === false;
        const pending = s.status && s.status !== 'Verified';
        const flags = (excluded ? ' <span class="badge bg-secondary">räknas inte</span>' : '')
            + (pending ? ' <span class="badge bg-warning text-dark">väntar på validering</span>' : '')
            + (s.qualifies === false ? ' <span class="badge bg-light text-dark border">under kravet</span>' : '');
        let actions = '';
        if (canSign && s.id) {
            actions += ` <a href="#" class="text-decoration-none ms-2" title="${excluded ? 'Räkna med serien igen' : 'Räkna inte den här serien mot guldfodringen'}"
                            onclick="setMarkenSeriesCounts(${s.id}, ${excluded ? 'true' : 'false'}, ${memberId}, '${escapeMedalAttr(name)}');return false;">${excluded ? 'Räkna med' : 'Räkna inte'}</a>`;
            if (!s.fromCompetition) {
                actions += ` <a href="#" class="text-danger text-decoration-none ms-2" title="Ta bort en serie som lagts in av misstag"
                                onclick="deleteMarkenSeries(${s.id}, ${memberId}, '${escapeMedalAttr(name)}');return false;">Ta bort</a>`;
            }
        }
        return `<li class="${excluded ? 'text-decoration-line-through text-muted' : ''}">${dateHtml}${escapeMedalHtml(s.weaponGroup)}: `
             + `<strong>${s.score}</strong> (krav ${s.threshold})${src}${flags}${actions}</li>`;
    }).join('');
}

function setMarkenSeriesCounts(seriesId, counts, memberId, name) {
    fetch('/umbraco/surface/Marken/SetSeriesCountsToward', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ id: seriesId, counts })
    })
    .then(r => r.json())
    .then(d => {
        if (!d.success) { alert(d.message || 'Kunde inte uppdatera.'); return; }
        openMemberMarkenDetail(memberId, name); // the Guldfodring may have completed or un-completed
        loadClubMarken();
    })
    .catch(() => alert('Något gick fel.'));
}

function deleteMarkenSeries(seriesId, memberId, name) {
    if (!confirm('Ta bort den här guldserien helt?\n\nAnvänd "Räkna inte" i stället om serien verkligen sköts men inte ska räknas.')) return;
    fetch('/umbraco/surface/Marken/DeleteSeriesAsFunctionary', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ id: seriesId })
    })
    .then(r => r.json())
    .then(d => {
        if (!d.success) { alert(d.message || 'Kunde inte ta bort.'); return; }
        openMemberMarkenDetail(memberId, name);
        loadClubMarken();
    })
    .catch(() => alert('Något gick fel.'));
}

// Other badge families (Elit, Fält, Precision, Milsnabb, Nat.helmatch, Luftpistol) + Stormästar,
// shown read-only in the secretary detail so functionaries see the member's full standing.
function renderMarkenFamiliesBlock(families, stormastar, canSign, memberId, name) {
    families = families || [];
    const rows = families.map(f => {
        const earned = f.earnedLevel
            ? `<span class="badge bg-warning text-dark">${escapeMedalHtml(f.earnedLevel)}</span>`
            : '<span class="text-muted small">–</span>';
        const art = (f.artalsmarke && f.artalsmarke.fulfilledYears > 0)
            ? ` <span class="text-muted small">· ${escapeMedalHtml(f.artalsmarke.current)}</span>` : '';
        const prereq = f.prereqText ? `<div class="small text-warning">${escapeMedalHtml(f.prereqText)}</div>` : '';
        // Manual award control (functionary only) — for badges earned before the system / off
        // pistol.nu where the underlying series/competition evidence can't be reconstructed.
        let actions = '';
        if (canSign) {
            const famAttr = escapeMedalAttr(f.family);
            const selId = 'famLvl_' + String(f.family).replace(/[^A-Za-z0-9_]/g, '');
            const defLvl = f.nextLevel || f.earnedLevel || 'Brons';
            const opts = ['Brons', 'Silver', 'Guld'].map(l => `<option value="${l}"${l === defLvl ? ' selected' : ''}>${l}</option>`).join('');
            const delBtn = f.earnedLevel
                ? `<button class="btn btn-outline-danger" title="Ta bort märket" onclick="deleteMarkenFamily(${memberId}, '${famAttr}', '${escapeMedalAttr(name)}', '${escapeMedalAttr(f.displayName)}')"><i class="bi bi-trash"></i></button>`
                : '';
            actions = `<div class="input-group input-group-sm mt-1" style="max-width:300px;">
                <select class="form-select" id="${selId}">${opts}</select>
                <button class="btn btn-outline-warning" onclick="awardMarkenFamilyBadge(${memberId}, '${famAttr}', '${escapeMedalAttr(name)}', '${escapeMedalAttr(f.displayName)}', document.getElementById('${selId}').value)">${f.earnedLevel ? 'Ändra' : 'Tilldela'}</button>
                ${delBtn}
              </div>`;
        }
        return `<li class="list-group-item px-0">
            <div class="d-flex justify-content-between align-items-start gap-2">
              <span><strong>${escapeMedalHtml(f.displayName)}</strong> ${earned}${art}
              <div class="small text-muted">${escapeMedalHtml(f.statusText || '')}</div>${prereq}</span>
            </div>${actions}</li>`;
    }).join('');
    let storm = '';
    if (stormastar) {
        const eligible = stormastar.eligible ? ' <span class="badge bg-success">Behörig</span>' : '';
        const pend = stormastar.pendingPoints ? ` (+${stormastar.pendingPoints} väntar)` : '';
        storm = `<li class="list-group-item px-0">
            <span><strong>${escapeMedalHtml(stormastar.displayName)}</strong>${eligible}</span>
            <div class="small text-muted">${stormastar.verifiedPoints || 0}/${stormastar.eligibleAt || 30} inteckningspoäng${pend}</div></li>`;
    }
    if (!rows && !storm) return '';
    return `<h6 class="text-muted">Andra märken</h6>
        <ul class="list-group list-group-flush mb-3">${rows}${storm}</ul>`;
}

// Mästarmärket detail in the secretary per-member panel — auto-qualifying years (silver fält +
// silver precision same year) plus a functionary add/remove for years earned before the system.
function loadMemberMastar(memberId) {
    const block = document.getElementById('memberMastarBlock');
    if (!block) return;
    fetch(`/umbraco/surface/Marken/GetMemberMastar?memberId=${memberId}`)
        .then(r => r.json())
        .then(d => {
            if (!d.success) { block.innerHTML = ''; return; }
            const m = d.mastar || {};
            const canEdit = !!d.canEdit;
            const held = m.earnedLevel
                ? `<span class="badge bg-success"><i class="bi bi-check-lg"></i> ${escapeMedalHtml(m.levelDisplay || m.earnedLevel)}</span>`
                : '<span class="badge bg-secondary">Ej taget</span>';
            const years = (m.qualifyingYearList || []);
            const yearChips = years.length
                ? years.map(y => `<span class="badge bg-light text-dark border me-1 mb-1">${y}${canEdit ? ` <a href="#" onclick="setMastarYear(${memberId}, ${y}, false);return false;" class="text-danger text-decoration-none" title="Ta bort">×</a>` : ''}</span>`).join('')
                : '<span class="text-muted small">Inga kvalificerande år registrerade.</span>';
            const adder = canEdit
                ? `<div class="input-group input-group-sm mt-2" style="max-width:260px;">
                     <span class="input-group-text">Lägg till år</span>
                     <input type="number" class="form-control" id="mastarYearInput_${memberId}" min="1950" max="2099" placeholder="${new Date().getFullYear()}">
                     <button class="btn btn-outline-warning" onclick="addMastarYear(${memberId})">Lägg till</button>
                   </div>
                   <div class="form-text">Kvalificerande år = standardmedalj i silver i både fält och precision samma år. Auto-hämtas; lägg till äldre år manuellt här.</div>`
                : '';
            block.innerHTML = `
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-1">
                    <span>${escapeMedalHtml(m.statusText || '')}</span>${held}
                </div>
                <div>${yearChips}</div>${adder}`;
        })
        .catch(() => { block.innerHTML = ''; });
}

// ── Årtalsmärke (Pistolskyttemärket): functionary add/remove of fulfilled Guldfodring-years ──
// Each fulfilled year is one step of 3 toward the next årtalsmärke. System-derived years (from
// validated guldserier) are shown read-only; manually-asserted historical years get a remove ×.
function renderMarkenArtalsmarke(art, canSign, memberId, name) {
    art = art || {};
    const years = art.yearList || [];
    const count = art.fulfilledYears || 0;
    const current = escapeMedalHtml(art.current) || 'Inget årtalsmärke än';

    let progress;
    if (art.nextAtYears > 0) {
        const remain = Math.max(0, art.nextAtYears - count);
        progress = `<span class="text-muted">— ${count} godkända guldfodringar · nästa (${escapeMedalHtml(art.next)}) om ${remain} till (vid ${art.nextAtYears} totalt)</span>`;
    } else if (count > 0) {
        progress = `<span class="text-muted">— ${count} godkända guldfodringar</span>`;
    } else {
        progress = '<span class="text-muted">— inga godkända guldfodringar än</span>';
    }

    const chips = years.length
        ? years.map(y => `<span class="badge bg-light text-dark border me-1 mb-1" title="${y.manual ? 'Manuellt registrerat år' : 'Härlett från validerade guldserier'}">${y.year}${y.manual && canSign ? ` <a href="#" onclick="setGuldfodringYear(${memberId}, ${y.year}, false, '${escapeMedalAttr(name)}');return false;" class="text-danger text-decoration-none" title="Ta bort">×</a>` : (y.manual ? '' : ' <i class="bi bi-lock-fill text-muted" style="font-size:.7em;"></i>')}</span>`).join('')
        : '<span class="text-muted small">Inga godkända guldfodringar registrerade.</span>';

    const adder = canSign
        ? `<div class="input-group input-group-sm mt-2" style="max-width:280px;">
             <span class="input-group-text">Lägg till år</span>
             <input type="number" class="form-control" id="guldfodringYearInput_${memberId}" min="1950" max="${new Date().getFullYear() + 1}" placeholder="${new Date().getFullYear()}">
             <button class="btn btn-outline-warning" onclick="addGuldfodringYear(${memberId}, '${escapeMedalAttr(name)}')">Lägg till</button>
           </div>
           <div class="form-text">Lägg till äldre uppfyllda guldfodringsår manuellt (t.ex. från klubbliggaren). Aktuella år hämtas automatiskt från validerade guldserier.</div>`
        : '';

    return `<p class="mb-1"><i class="bi bi-calendar-check text-warning"></i> <strong>${current}</strong> ${progress}</p>
            <div class="mb-3"><div>${chips}</div>${adder}</div>`;
}

function setGuldfodringYear(memberId, year, fulfilled, name) {
    fetch('/umbraco/surface/Marken/SetGuldfodringYear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ memberId: memberId, year: year, fulfilled: fulfilled })
    }).then(r => r.json()).then(d => {
        if (!d.success) { alert(d.message || 'Fel'); return; }
        openMemberMarkenDetail(memberId, name);
        loadClubMarken();
    }).catch(() => alert('Något gick fel.'));
}
function addGuldfodringYear(memberId, name) {
    const input = document.getElementById('guldfodringYearInput_' + memberId);
    const year = parseInt(input && input.value) || 0;
    if (year < 1950) { alert('Ange ett giltigt år.'); return; }
    setGuldfodringYear(memberId, year, true, name);
}

// Save an edited achieved-year on a Brons/Silver grundmärke (reuses SetBadgeUniqueNumber, which
// sets AchievedYear for any valör; the registration number only applies to Guld).
function setMarkenBadgeYear(badgeId, memberId, name) {
    const yearEl = document.getElementById('badgeYear_' + badgeId);
    const year = yearEl ? (parseInt(yearEl.value) || null) : null;
    if (!year) { alert('Ange ett giltigt år.'); return; }
    fetch('/umbraco/surface/Marken/SetBadgeUniqueNumber', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ badgeId, year })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte spara.')); return; }
        openMemberMarkenDetail(memberId, name);
        loadClubMarken();
    })
    .catch(() => alert('Kunde inte spara året.'));
}

function setMastarYear(memberId, year, qualified) {
    fetch('/umbraco/surface/Marken/SetMastarQualifyingYear', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryTokenMedal() },
        body: JSON.stringify({ memberId: memberId, year: year, qualified: qualified })
    }).then(r => r.json()).then(d => { if (d.success) loadMemberMastar(memberId); else alert(d.message || 'Fel'); });
}
function addMastarYear(memberId) {
    const input = document.getElementById('mastarYearInput_' + memberId);
    const year = parseInt(input && input.value) || 0;
    if (year < 1950) { alert('Ange ett giltigt år.'); return; }
    setMastarYear(memberId, year, true);
}

// ── Series validation queue (club admin tab) ──────────────────────
function loadClubMarkenQueue() {
    const card = document.getElementById('clubMarkenQueueCard');
    const content = document.getElementById('clubMarkenQueueContent');
    if (!card || !content) return;
    fetch(`/umbraco/surface/Marken/GetClubPendingSeries?clubId=${clubId}`)
        .then(r => r.json())
        .then(d => {
            // Backlog entry card + member picker are for functionaries (sign-off authority),
            // shown regardless of queue size.
            const canFunc = !!(d.success && d.canValidate);
            const backlog = document.getElementById('markenBacklogCard');
            if (backlog) backlog.style.display = canFunc ? 'block' : 'none';
            const pickerCard = document.getElementById('markenMemberPickerCard');
            if (pickerCard) {
                pickerCard.style.display = canFunc ? 'block' : 'none';
                if (canFunc) populateMarkenMemberPicker();
            }
            const list = (d.items || []);
            if (!d.success || list.length === 0) { card.style.display = 'none'; return; }
            card.style.display = 'block';
            document.getElementById('clubMarkenQueueCount').textContent = `(${list.length})`;
            content.innerHTML = list.map(s => renderClubQueueItem(s, d.canValidate)).join('');
        })
        .catch(() => { card.style.display = 'none'; });
}

// ── Backlog entry: bulk-register historical series from a paper ledger ──
let markenBacklogMembers = null;
let markenBacklogIdx = 0;

function ensureMarkenBacklogMembers() {
    if (markenBacklogMembers) return Promise.resolve(markenBacklogMembers);
    return fetch(`/umbraco/surface/ClubAdmin/GetClubMembers?clubId=${clubId}`)
        .then(r => r.json())
        .then(d => {
            const items = Array.isArray(d.data) ? d.data : (d.data && d.data.items) || [];
            markenBacklogMembers = items
                .map(m => ({ id: m.id, name: ((m.firstName || '') + ' ' + (m.lastName || '')).trim() || m.email || ('Medlem ' + m.id) }))
                .sort((a, b) => a.name.localeCompare(b.name, 'sv'));
            return markenBacklogMembers;
        })
        .catch(() => { markenBacklogMembers = []; return markenBacklogMembers; });
}

function markenBacklogMemberOptions(selectedId) {
    let opts = '<option value="">— välj medlem —</option>';
    (markenBacklogMembers || []).forEach(m => {
        opts += `<option value="${m.id}"${m.id == selectedId ? ' selected' : ''}>${escapeMedalHtml(m.name)}</option>`;
    });
    return opts;
}

function toggleMarkenBacklog() {
    const body = document.getElementById('markenBacklogBody');
    const open = body.style.display === 'none';
    body.style.display = open ? '' : 'none';
    document.getElementById('markenBacklogToggleBtn').textContent = open ? 'Dölj' : 'Lägg till serier';
    if (open) {
        ensureMarkenBacklogMembers().then(() => {
            if (!document.querySelectorAll('#markenBacklogRows tr').length) addMarkenBacklogRow();
        });
    }
}

function addMarkenBacklogRow() {
    const idx = ++markenBacklogIdx;
    const prev = document.querySelector('#markenBacklogRows tr:last-child .mb-member');
    const prevMember = prev ? prev.value : '';
    const tr = document.createElement('tr');
    tr.dataset.idx = idx;
    tr.innerHTML = `
        <td><select class="form-select form-select-sm mb-member">${markenBacklogMemberOptions(prevMember)}</select></td>
        <td><select class="form-select form-select-sm mb-type" style="width:auto;" onchange="markenBacklogRenderDetail(${idx})">
                <option value="Precision">Guldserie</option>
                <option value="Speed">Snabbserie</option>
            </select></td>
        <td><input type="text" class="form-control form-control-sm mb-date" placeholder="ÅÅÅÅ-MM-DD" style="width:120px;"></td>
        <td class="mb-wg"></td>
        <td class="mb-detail"></td>
        <td class="text-end"><button class="btn btn-sm btn-outline-danger" type="button" onclick="this.closest('tr').remove()" title="Ta bort rad"><i class="bi bi-trash"></i></button></td>`;
    document.getElementById('markenBacklogRows').appendChild(tr);
    markenBacklogRenderDetail(idx);
    if (window.flatpickr) flatpickr(tr.querySelector('.mb-date'), { locale: 'sv', dateFormat: 'Y-m-d', maxDate: 'today', allowInput: true });
}

function markenBacklogRenderDetail(idx) {
    const tr = document.querySelector(`#markenBacklogRows tr[data-idx="${idx}"]`);
    if (!tr) return;
    const type = tr.querySelector('.mb-type').value;
    tr.querySelector('.mb-wg').innerHTML =
        `<select class="form-select form-select-sm mb-group" style="width:75px;"><option>C</option><option>A</option><option>B</option><option>R</option></select>`;
    const detail = tr.querySelector('.mb-detail');
    if (type === 'Speed') {
        detail.innerHTML = `
            <select class="form-select form-select-sm mb-target d-inline-block" style="width:auto;" onchange="markenBacklogRenderSpeed(${idx})">
                <option value="C30_25m">Tillämpning C30 (25m)</option>
                <option value="B100_50m">Tillämpning B100 (50m)</option>
                <option value="Snabbpistol_25m">Snabbpistol (25m)</option>
            </select> <span class="mb-speed-extra"></span>`;
        markenBacklogRenderSpeed(idx);
    } else {
        detail.innerHTML = `<input type="number" min="0" max="50" class="form-control form-control-sm mb-total d-inline-block" style="width:90px;" placeholder="poäng"> <span class="text-muted small">/ 50</span>`;
    }
}

function markenBacklogRenderSpeed(idx) {
    const tr = document.querySelector(`#markenBacklogRows tr[data-idx="${idx}"]`);
    if (!tr) return;
    const extra = tr.querySelector('.mb-speed-extra');
    if (tr.querySelector('.mb-target').value === 'Snabbpistol_25m') {
        extra.innerHTML = `<input type="number" min="0" max="50" class="form-control form-control-sm mb-total d-inline-block" style="width:90px;" placeholder="poäng">`;
    } else {
        extra.innerHTML = `<select class="form-select form-select-sm mb-level d-inline-block" style="width:auto;"><option value="Guld">Guld</option><option value="Silver">Silver</option><option value="Brons">Brons</option></select>`;
    }
}

function saveMarkenBacklog() {
    const box = document.getElementById('markenBacklogResult');
    const entries = [];
    document.querySelectorAll('#markenBacklogRows tr').forEach(tr => {
        const memberId = parseInt(tr.querySelector('.mb-member').value) || 0;
        const date = tr.querySelector('.mb-date').value.trim();
        const type = tr.querySelector('.mb-type').value;
        const groupEl = tr.querySelector('.mb-group');
        const entry = { memberId, seriesType: type, seriesDate: date, weaponGroup: groupEl ? groupEl.value : 'C' };
        if (type === 'Speed') {
            entry.target = tr.querySelector('.mb-target').value;
            const totalEl = tr.querySelector('.mb-total');
            const levelEl = tr.querySelector('.mb-level');
            if (totalEl) entry.total = parseInt(totalEl.value) || 0;
            if (levelEl) entry.claimedLevel = levelEl.value;
        } else {
            const totalEl = tr.querySelector('.mb-total');
            entry.total = totalEl ? (parseInt(totalEl.value) || 0) : 0;
        }
        if (memberId && date) entries.push(entry);
    });
    if (entries.length === 0) { box.innerHTML = '<span class="text-danger">Fyll i minst medlem och datum på en rad.</span>'; return; }

    box.innerHTML = '<span class="text-muted">Sparar…</span>';
    fetch('/umbraco/surface/Marken/AddBacklogSeries', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ clubId, entries })
    })
    .then(r => r.json())
    .then(res => {
        const warn = (res.errors && res.errors.length) ? `<div class="text-warning mt-1">${res.errors.map(escapeMedalHtml).join('<br>')}</div>` : '';
        if (!res.success) { box.innerHTML = `<span class="text-danger">${escapeMedalHtml(res.message || 'Kunde inte spara.')}</span>${warn}`; return; }
        box.innerHTML = `<span class="text-success">${escapeMedalHtml(res.message)}</span>${warn}`;
        document.getElementById('markenBacklogRows').innerHTML = '';
        addMarkenBacklogRow();
        loadClubMarken(); // backlog may complete guldfodringar / årtalsmärken
    })
    .catch(() => { box.innerHTML = '<span class="text-danger">Något gick fel.</span>'; });
}

function markenEvidenceDescAdmin(s) {
    if (s.kind === 'stormastar') {
        return `Stormästar – ${escapeMedalHtml(s.scopeName)} ${s.year}${s.competitionName ? ' (' + escapeMedalHtml(s.competitionName) + ')' : ''}: <strong>${s.points} p</strong> <span class="text-muted">(${s.participants} dlt, plac ${s.place})</span>`;
    }
    if (s.kind === 'comp') {
        const lvl = s.reachedLevel
            ? ` <span class="badge bg-light text-dark border">${escapeMedalHtml(s.reachedLevel)}</span>`
            : ' <span class="text-warning small">under krav</span>';
        return `${escapeMedalHtml(s.familyName)} – ${escapeMedalHtml(s.competitionName)}: <strong>${s.total}</strong> <span class="text-muted">(${escapeMedalHtml(s.weaponGroup)})</span>${lvl}`;
    }
    switch (s.discipline) {
        case 'Precision':
            return `Precisionsserie <strong>${s.total} p</strong> <span class="text-muted">(${escapeMedalHtml(s.weaponGroup)})</span>${s.qualifies ? '' : ' <span class="text-warning small">under guldkrav</span>'}`;
        case 'Air':
            return `Luftpistolserie <strong>${s.total} p</strong> <span class="text-muted">(nivå ${escapeMedalHtml(s.claimedLevel)})</span>`;
        case 'Snabbpistol':
            return `Snabbpistolserie <strong>${s.total} p</strong> <span class="text-muted">(nivå ${escapeMedalHtml(s.claimedLevel)})</span>`;
        default: // Tillämpning
            return `Snabbserie (tillämpning) ${escapeMedalHtml(s.claimedLevel)} <span class="text-muted">(${escapeMedalHtml(s.targetName)})</span>`;
    }
}

// The person clicking Godkänn is signing off on something they may not have watched, so the row
// carries the DATE, the shooter's own note and the club's witnessing rule — a name plus five digits
// leaves them nothing to judge it by.
function renderClubQueueItem(s, canValidate) {
    const shots = (s.kind !== 'comp' && s.seriesType === 'Precision' && s.shots) ? `<div class="small text-muted">${s.shots.map(escapeMedalHtml).join(' · ')}</div>` : '';
    const photoUrl = s.kind === 'comp' ? `/umbraco/surface/Marken/GetCompResultPhoto?id=${s.id}`
        : s.kind === 'stormastar' ? `/umbraco/surface/Marken/GetStormastarPhoto?id=${s.id}`
        : `/umbraco/surface/Marken/GetSeriePhoto?id=${s.id}`;
    const photo = s.hasPhoto ? ` <a href="${photoUrl}" target="_blank" rel="noopener" title="Foto"><i class="bi bi-camera"></i></a>` : '';
    // On-site witnessing: say it BEFORE the click, rather than letting the server refuse afterwards.
    const onSite = (s.kind !== 'comp' && s.kind !== 'stormastar' && s.requiresOnSiteWitness)
        ? `<div class="small text-warning-emphasis mt-1"><i class="bi bi-qr-code-scan me-1"></i>Klubben kräver bevittning på plats — godkänn genom att skanna skyttens QR-kod.</div>`
        : '';
    const buttons = canValidate
        ? `<div class="text-nowrap mt-1">
             <button class="btn btn-sm btn-success" onclick="clubQueueAct('${s.kind}', ${s.id}, true)"><i class="bi bi-check-lg me-1"></i>Godkänn</button>
             <button class="btn btn-sm btn-outline-danger" onclick="clubQueueAct('${s.kind}', ${s.id}, false)"><i class="bi bi-x-lg me-1"></i>Avvisa</button>
           </div>`
        : '<div class="small text-muted mt-1">Endast styrelse/skjutledare kan validera.</div>';
    return `<div class="border-bottom py-2">
        <div><strong>${escapeMedalHtml(s.memberName)}</strong>${markenQueueDate(s)}</div>
        <div>${markenEvidenceDescAdmin(s)}${photo}</div>${shots}${markenQueueNote(s)}${onSite}${buttons}</div>`;
}

// ⚠️ A competition result carries `competitionDate`, a series carries `seriesDate` — reading only one
// of them leaves half the queue undated.
function markenQueueDate(s) {
    const raw = s.kind === 'comp' ? s.competitionDate : s.seriesDate;
    if (!raw) return ' <span class="text-muted small">datum saknas</span>';
    return ` <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>${escapeMedalHtml(new Date(raw).toLocaleDateString('sv-SE'))}</span>`;
}

function markenQueueNote(s) {
    return s.notes
        ? `<div class="small text-muted fst-italic"><i class="bi bi-chat-left-text me-1"></i>${escapeMedalHtml(s.notes)}</div>`
        : '';
}

function clubQueueAct(kind, id, approve) {
    if (!approve && !confirm('Avvisa?')) return;
    const url = approve ? '/umbraco/surface/Marken/VerifyEvidence' : '/umbraco/surface/Marken/RejectEvidence';
    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ kind, id })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte uppdatera.')); return; }
        loadClubMarkenQueue();
        loadClubMarken(); // a validation may complete a member's guldfodring
    })
    .catch(() => alert('Något gick fel.'));
}

function awardMarkenBadge(memberId, level, name) {
    let uniqueNumber = null;
    let year = 0;
    if (level === 'Guld') {
        uniqueNumber = prompt('Tilldela guldmärket. Ange registreringsnummer från förbundet (kan lämnas tomt och fyllas i senare):', '');
        if (uniqueNumber === null) return;
        const yStr = prompt('Årtal då guldmärket erövrades (styr när elitprov får börja räknas — året efter):', new Date().getFullYear());
        if (yStr === null) return;
        year = parseInt(yStr) || new Date().getFullYear();
    } else {
        const yStr = prompt(`Tilldela ${level.toLowerCase()}märket till ${name}.\nÅrtal då märket erövrades:`, new Date().getFullYear());
        if (yStr === null) return;
        year = parseInt(yStr) || new Date().getFullYear();
    }
    fetch('/umbraco/surface/Marken/AwardBadge', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
        body: JSON.stringify({ memberId, level, year, uniqueNumber })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte tilldela.')); return; }
        openMemberMarkenDetail(memberId, name);
        loadClubMarken();
    })
    .catch(() => alert('Kunde inte tilldela märket.'));
}

