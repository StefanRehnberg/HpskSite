// The full member list as loaded from the server. Search and sorting work on this
// copy in the browser, so neither costs a round trip.
let clubMembersData = [];
let clubMemberSort = { key: 'name', dir: 1 };

// Load Club Members
function loadClubMembers() {
    const container = document.getElementById('clubMembersTableContainer');
    container.innerHTML = '<div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar medlemmar...</span></div></div>';

    fetch(`/umbraco/surface/ClubAdmin/GetClubMembers?clubId=${clubId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                displayClubMembers(data.data || []);
            } else {
                container.innerHTML = '<div class="alert alert-warning">Kunde inte ladda medlemmar.</div>';
            }
        })
        .catch(error => {
            console.error('Error loading club members:', error);
            container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av medlemmar.</div>';
        });
}

function exportClubMembersCsv() {
    fetch(`/umbraco/surface/ClubAdmin/GetClubMembers?clubId=${clubId}`)
        .then(response => response.json())
        .then(data => {
            if (!data.success || !data.data || data.data.length === 0) {
                alert('Inga medlemmar att exportera.');
                return;
            }
            const members = data.data;
            const rows = [['Namn', 'E-post', 'Telefon']];
            members.forEach(m => {
                const name = `${m.firstName || ''} ${m.lastName || ''}`.trim();
                const email = m.email || '';
                const phone = m.phone || '';
                rows.push([name, email, phone]);
            });
            const csv = rows.map(r => r.map(v => '"' + v.replace(/"/g, '""') + '"').join(',')).join('\n');
            const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'medlemmar.csv';
            a.click();
            URL.revokeObjectURL(url);
        })
        .catch(error => {
            console.error('Error exporting members:', error);
            alert('Fel vid export av medlemmar.');
        });
}

function getInitials(firstName, lastName) {
    let initials = '';
    if (firstName) initials += firstName.charAt(0).toUpperCase();
    if (lastName) initials += lastName.charAt(0).toUpperCase();
    return initials || '?';
}

function renderMemberAvatar(member) {
    const fullName = `${member.firstName || ''} ${member.lastName || ''}`.trim();
    if (member.profilePictureUrl) {
        return `<span class="member-avatar"><img src="${escapeHtml(member.profilePictureUrl)}" alt="${escapeHtml(fullName)}"></span>`;
    } else {
        return `<span class="member-avatar">${getInitials(member.firstName, member.lastName)}</span>`;
    }
}

function displayClubMembers(members) {
    clubMembersData = members || [];
    renderClubMembers();
}

// Sortable columns. `sort` returns the value we order on: a string for the text
// columns, a number for the two "senast aktiv" columns (which carry a unix
// timestamp from the server, so "5 min sedan" sorts before "3 dagar sedan").
const CLUB_MEMBER_COLUMNS = [
    { key: 'name',   label: 'Namn',    sort: m => `${m.firstName || ''} ${m.lastName || ''}`.trim().toLowerCase() },
    { key: 'email',  label: 'E-post',  sort: m => (m.email || '').toLowerCase() },
    { key: 'phone',  label: 'Telefon', sort: m => (m.phoneNumber || '').toLowerCase() },
    { key: 'web',    label: 'Webb',    thClass: 'text-nowrap', sort: m => m.lastActiveSortValue || 0 },
    { key: 'app',    label: 'App',     thClass: 'text-nowrap', sort: m => m.lastMobileActiveSortValue || 0 },
    { key: 'status', label: 'Status',  sort: m => (m.isApproved ? 1 : 0) }
];

function sortClubMembers(key) {
    if (clubMemberSort.key === key) {
        clubMemberSort.dir = -clubMemberSort.dir;
    } else {
        clubMemberSort = { key: key, dir: 1 };
    }
    renderClubMembers();
}

function matchesClubMemberSearch(member, needle) {
    const haystack = [
        member.firstName, member.lastName, member.email,
        member.phoneNumber, member.shooterIdNumber
    ].join(' ').toLowerCase();
    // Every word has to match somewhere, so "anna sund" finds Anna Sundberg no
    // matter which order the admin types the name in.
    return needle.split(/\s+/).every(word => haystack.includes(word));
}

function renderClubMembers() {
    const container = document.getElementById('clubMembersTableContainer');
    if (!container) return;

    const searchBox = document.getElementById('clubMemberSearch');
    const needle = (searchBox ? searchBox.value : '').trim().toLowerCase();
    const rows = needle
        ? clubMembersData.filter(m => matchesClubMemberSearch(m, needle))
        : clubMembersData.slice();

    const countLabel = document.getElementById('clubMemberCount');
    if (countLabel) {
        countLabel.textContent = !clubMembersData.length ? ''
            : needle ? `(${rows.length} av ${clubMembersData.length})`
            : `(${clubMembersData.length})`;
    }

    if (!clubMembersData.length) {
        container.innerHTML = '<div class="alert alert-info">Inga medlemmar har lagts till ännu för denna klubb.</div>';
        return;
    }

    const column = CLUB_MEMBER_COLUMNS.find(c => c.key === clubMemberSort.key) || CLUB_MEMBER_COLUMNS[0];
    rows.sort((a, b) => {
        const va = column.sort(a), vb = column.sort(b);
        if (typeof va === 'string') {
            // Blank cells always land at the bottom, whichever way we sort.
            if (!va !== !vb) return !va ? 1 : -1;
            return va.localeCompare(vb, 'sv') * clubMemberSort.dir;
        }
        return (va - vb) * clubMemberSort.dir;
    });

    let html = '<div class="table-responsive"><table class="table table-striped">';
    html += '<thead><tr>';
    CLUB_MEMBER_COLUMNS.forEach(col => {
        const active = col.key === clubMemberSort.key;
        const icon = active
            ? (clubMemberSort.dir === 1 ? 'bi-caret-up-fill' : 'bi-caret-down-fill')
            : 'bi-arrow-down-up opacity-25';
        const ariaSort = active ? (clubMemberSort.dir === 1 ? 'ascending' : 'descending') : 'none';
        html += `<th class="club-member-sort ${col.thClass || ''}" aria-sort="${ariaSort}" role="button" tabindex="0"`
             + ` title="Sortera efter ${col.label}" onclick="sortClubMembers('${col.key}')"`
             + ` onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();sortClubMembers('${col.key}');}">`
             + `${col.label} <i class="bi ${icon} small"></i></th>`;
    });
    html += '<th>Åtgärder</th></tr></thead><tbody>';

    if (!rows.length) {
        html += `<tr><td colspan="${CLUB_MEMBER_COLUMNS.length + 1}" class="text-center text-muted py-4">`
             + 'Ingen medlem matchar sökningen.</td></tr>';
    }

    rows.forEach(member => {
        const fullName = `${member.firstName || ''} ${member.lastName || ''}`.trim() || 'Okänt namn';
        const statusBadge = member.isApproved
            ? '<span class="badge bg-success">Godkänd</span>'
            : '<span class="badge bg-warning text-dark">Väntande</span>';

        const webDisplay = member.lastActiveDisplay || 'Aldrig';
        const webClass = webDisplay === 'Aldrig' ? 'text-muted' : '';
        const mobileDisplay = member.lastMobileActiveDisplay || 'Aldrig';
        const mobileClass = mobileDisplay === 'Aldrig' ? 'text-muted' : '';

        html += `
            <tr>
                <td>
                    <div class="member-name-cell">
                        ${renderMemberAvatar(member)}
                        <strong>${escapeHtml(fullName)}</strong>
                    </div>
                </td>
                <td>${escapeHtml(member.email || '-')}</td>
                <td>${escapeHtml(member.phoneNumber || '-')}</td>
                <td class="${webClass} text-nowrap small">${escapeHtml(webDisplay)}</td>
                <td class="${mobileClass} text-nowrap small">${escapeHtml(mobileDisplay)}</td>
                <td>${statusBadge}</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary me-1" onclick="editClubMember(${member.id})" title="Redigera">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="showSecurityModal(${member.id})" title="Säkerhet (lås upp, lösenord, inbjudan)">
                        <i class="bi bi-shield-lock"></i>
                    </button>
                </td>
            </tr>
        `;
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
}

