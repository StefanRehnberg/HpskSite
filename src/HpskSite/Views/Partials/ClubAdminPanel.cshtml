async function loadEditMemberHandicapInfo(memberId) {
    const container = document.getElementById('editMemberHandicapInfoContainer');
    container.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Laddar...</span></div></div>';

    try {
        const response = await fetch(`/umbraco/surface/Member/GetHandicapProfileForMember?memberId=${memberId}`);
        const result = await response.json();

        if (result.success && result.data) {
            renderEditMemberHandicapInfo(result.data);
        } else {
            container.innerHTML = '<div class="alert alert-info small">Ingen handicapdata tillgänglig.</div>';
        }
    } catch (error) {
