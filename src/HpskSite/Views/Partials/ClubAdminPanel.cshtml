// Load Events
function loadEvents() {
    fetch(`/umbraco/surface/Club/GetClubEvents?clubId=${clubId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                displayEvents(data.data);
            } else {
                document.getElementById('eventsTableContainer').innerHTML =
                    '<div class="alert alert-warning">Inga händelser hittades.</div>';
            }
        })
        .catch(error => {
            console.error('Error loading events:', error);
            document.getElementById('eventsTableContainer').innerHTML =
                '<div class="alert alert-danger">Fel vid laddning av händelser.</div>';
        });
}

function displayEvents(events) {
    const container = document.getElementById('eventsTableContainer');

    // Store events globally for editing
    allEvents = events || [];

    if (!events || events.length === 0) {
        container.innerHTML = '<div class="alert alert-info">Inga händelser har skapats ännu.</div>';
        return;
    }

    let html = '<div class="table-responsive"><table class="table table-striped">';
    html += '<thead><tr><th>Namn</th><th>Typ</th><th>Datum</th><th>Plats</th><th>Åtgärder</th></tr></thead><tbody>';

    events.forEach(event => {
        const dateObj = event.date ? new Date(event.date) : null;
        const date = (dateObj && dateObj.getFullYear() > 1900) ? dateObj.toLocaleString('sv-SE') : '-';
        const color = eventTypeColors[event.type] || eventTypeColors.default;
        html += `
            <tr>
                <td><strong>${event.name}</strong></td>
                <td><span class="badge" style="background-color: ${color}">${event.type}</span></td>
                <td>${date}</td>
                <td>${event.venue || '-'}</td>
                <td>
                    <button class="btn btn-sm btn-outline-primary" onclick="editEvent(${event.id})" title="Redigera">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="copyEvent(${event.id})" title="Kopiera (+1 vecka)">
                        <i class="bi bi-copy"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteEvent(${event.id}, '${event.name}')" title="Ta bort">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    });

    html += '</tbody></table></div>';
    container.innerHTML = html;
}

// Load Club Settings
function loadClubSettings() {
    fetch(`/umbraco/surface/Club/GetClubInfo?clubId=${clubId}`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.data) {
                // Contact Information
                document.getElementById('contactPerson').value = data.data.contactPerson || '';
                document.getElementById('contactEmail').value = data.data.contactEmail || '';
                document.getElementById('contactPhone').value = data.data.contactPhone || '';
                document.getElementById('webSite').value = data.data.webSite || '';

                // Address
                document.getElementById('address').value = data.data.address || '';
                document.getElementById('city').value = data.data.city || '';
                document.getElementById('postalCode').value = data.data.postalCode || '';

                // Description
                document.getElementById('club_description').value = data.data.description || '';

                // Set About Club content - use CKEditor if initialized, otherwise textarea
                const aboutClubContent = data.data.aboutClub || '';
                if (aboutClubEditor) {
                    aboutClubEditor.setData(aboutClubContent);
                } else {
                    document.getElementById('aboutClub').value = aboutClubContent;
                }

                // Brevo API key
                var brevoField = document.getElementById('brevoApiKey');
                if (brevoField) brevoField.value = data.data.brevoApiKey || '';

                // Logo preview
                if (data.data.logoUrl) {
                    document.getElementById('clubLogoImg').src = data.data.logoUrl;
                    document.getElementById('clubLogoPreview').style.display = '';
                } else {
                    document.getElementById('clubLogoPreview').style.display = 'none';
                }

                // Banner preview
                if (data.data.bannerImageUrl) {
                    document.getElementById('clubBannerImg').src = data.data.bannerImageUrl;
                    document.getElementById('clubBannerPreview').style.display = '';
                } else {
                    document.getElementById('clubBannerPreview').style.display = 'none';
                }
            }
        })
        .catch(error => {
            console.error('Error loading club settings:', error);
        });
}

// Event Modal Functions
function slugify(text) {
    return text.toLowerCase()
        .replace(/å/g, 'a').replace(/ä/g, 'a').replace(/ö/g, 'o')
        .replace(/[^a-z0-9\s-]/g, '')
        .replace(/\s+/g, '-')
        .replace(/-+/g, '-')
        .replace(/^-|-$/g, '');
}

function updateEventUrlPreview() {
    var pageNameInput = document.getElementById('eventPageName');
    var nameInput = document.getElementById('eventName');
    var preview = document.getElementById('eventUrlPreview');
    var source = (pageNameInput.value || nameInput.value || '').trim();
    var slug = slugify(source) || '...';
    preview.textContent = '/' + slug;
}

function toggleEventPageName(e) {
    if (e) e.preventDefault();
    var group = document.getElementById('eventPageNameGroup');
    var toggle = document.getElementById('eventPageNameToggle');
    if (group.style.display === 'none') {
        group.style.display = '';
        toggle.textContent = 'Dölj sidnamn';
    } else {
        group.style.display = 'none';
        document.getElementById('eventPageName').value = '';
        updateEventUrlPreview();
        toggle.textContent = 'Ändra sidnamn';
    }
}

var knownEventTypes = ['Träning', 'Städning', 'Möte', 'Socialt', 'Nyhet'];

function onEventTypeChange() {
    var select = document.getElementById('eventType');
    var customInput = document.getElementById('eventCustomType');
    if (select.value === 'Annat') {
        customInput.style.display = '';
        customInput.required = true;
        customInput.focus();
    } else {
        customInput.style.display = 'none';
        customInput.required = false;
        customInput.value = '';
        document.getElementById('competitionTypeWarning').style.display = 'none';
    }
    syncEventTypeValue();
    toggleEventDateRequired();
}

function syncEventTypeValue() {
    var select = document.getElementById('eventType');
    var customInput = document.getElementById('eventCustomType');
    var hidden = document.getElementById('eventTypeValue');
    hidden.value = select.value === 'Annat' ? customInput.value : select.value;
}

function checkCompetitionTypeWarning() {
    var customInput = document.getElementById('eventCustomType');
    var warning = document.getElementById('competitionTypeWarning');
    var val = customInput.value.toLowerCase();
    warning.style.display = val.indexOf('tävling') >= 0 ? '' : 'none';
}

function toggleEventDateRequired() {
    const resolvedType = document.getElementById('eventTypeValue').value || document.getElementById('eventType').value;
    const isNyhet = resolvedType === 'Nyhet';
    const dateInput = document.getElementById('eventDate');
    const dateLabel = document.getElementById('eventDateLabel');
    const dateHint = document.getElementById('eventDateHint');
    dateInput.required = !isNyhet;
    dateLabel.textContent = isNyhet ? 'Datum (valfritt)' : 'Datum *';
    dateHint.style.display = isNyhet ? '' : 'none';
}

function showCreateEventModal() {
    document.getElementById('eventModalTitle').textContent = 'Ny Händelse';
    document.getElementById('eventForm').reset();
    document.getElementById('eventId').value = '';
    document.getElementById('eventCustomType').style.display = 'none';
    document.getElementById('eventCustomType').required = false;
    document.getElementById('eventCustomType').value = '';
    document.getElementById('eventPageNameGroup').style.display = 'none';
    document.getElementById('eventPageNameToggle').textContent = 'Ändra sidnamn';
    syncEventTypeValue();
    toggleEventDateRequired();
    updateEventUrlPreview();
    new bootstrap.Modal(document.getElementById('eventModal')).show();
}

function editEvent(eventId) {
    const event = allEvents.find(e => e.id === eventId);
    if (!event) {
        alert('Händelse hittades inte');
        return;
    }

    // Update modal title
    document.getElementById('eventModalTitle').textContent = 'Redigera Händelse';

    // Populate form fields
    document.getElementById('eventId').value = event.id;
    document.getElementById('eventName').value = event.name || '';

    // Set event type — if not a known type, select "Annat" and populate custom field
    var typeVal = event.type || 'Träning';
    if (knownEventTypes.indexOf(typeVal) >= 0) {
        document.getElementById('eventType').value = typeVal;
        document.getElementById('eventCustomType').style.display = 'none';
        document.getElementById('eventCustomType').required = false;
        document.getElementById('eventCustomType').value = '';
    } else {
        document.getElementById('eventType').value = 'Annat';
        document.getElementById('eventCustomType').style.display = '';
        document.getElementById('eventCustomType').required = true;
        document.getElementById('eventCustomType').value = typeVal;
    }
    syncEventTypeValue();
    toggleEventDateRequired();
    document.getElementById('eventDescription').value = event.description || '';
    document.getElementById('event_venue').value = event.venue || '';
    document.getElementById('eventContactPerson').value = event.contactPerson || '';
    document.getElementById('eventContactEmail').value = event.contactEmail || '';
    document.getElementById('eventContactPhone').value = event.contactPhone || '';

    // Page name (URL slug)
    if (event.pageName) {
        document.getElementById('eventPageName').value = event.pageName;
        document.getElementById('eventPageNameGroup').style.display = '';
        document.getElementById('eventPageNameToggle').textContent = 'Dölj sidnamn';
    } else {
        document.getElementById('eventPageName').value = '';
        document.getElementById('eventPageNameGroup').style.display = 'none';
        document.getElementById('eventPageNameToggle').textContent = 'Ändra sidnamn';
    }
    updateEventUrlPreview();

    // Format date for datetime-local input
    if (event.date) {
        const eventDate = new Date(event.date);
        if (eventDate.getFullYear() > 1900) {
            const fp = document.getElementById('eventDate')._flatpickr;
            if (fp) {
                fp.setDate(eventDate);
            } else {
                document.getElementById('eventDate').value = eventDate.toISOString().slice(0, 16);
            }
        }
    }

    // Show modal
    new bootstrap.Modal(document.getElementById('eventModal')).show();
}

function saveEvent() {
    syncEventTypeValue();
    var resolvedType = document.getElementById('eventTypeValue').value;
    if (!resolvedType || !resolvedType.trim()) {
        document.getElementById('eventCustomType').focus();
        alert('Ange en händelsetyp.');
        return;
    }
    const form = document.getElementById('eventForm');
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    // Disable button and show loading state
    const saveBtn = document.querySelector('#eventModal .modal-footer .btn-primary');
    if (!saveBtn) return;
    const originalBtnText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Sparar...';

    const formData = new FormData(form);
    const eventId = formData.get('eventId');
    const url = eventId ? '/umbraco/surface/Club/EditClubEvent' : '/umbraco/surface/Club/CreateClubEvent';

    // Add clubId and anti-forgery token
    formData.append('clubId', clubId);
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    fetch(url, {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('eventModal')).hide();
            loadEvents();
            alert('Händelse sparad!');
            // Reset button (modal will close, so this is cleanup)
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalBtnText;
        } else {
            alert('Fel: ' + data.message);
            // Re-enable button on error
            saveBtn.disabled = false;
            saveBtn.innerHTML = originalBtnText;
        }
    })
    .catch(error => {
        console.error('Error saving event:', error);
        alert('Fel vid sparande av händelse.');
        // Re-enable button on error
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
    });
}

function deleteEvent(eventId, eventName) {
    showDeleteConfirmation(eventName, () => {
        const formData = new FormData();
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        fetch(`/umbraco/surface/Club/DeleteClubEvent?eventId=${eventId}`, {
            method: 'POST',
            body: formData
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadEvents();
                alert('Händelse raderad!');
            } else {
                alert('Fel: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error deleting event:', error);
            alert('Fel vid radering av händelse.');
        });
    });
}

// Copy Event
var copyEventFlatpickr = null;

function copyEvent(eventId) {
    const event = allEvents.find(e => e.id === eventId);
    if (!event) { alert('Händelse hittades inte'); return; }

    document.getElementById('copyEventSourceId').value = eventId;
    document.getElementById('copyEventName').value = event.name || '';

    // Init flatpickr on first use
    if (!copyEventFlatpickr) {
        copyEventFlatpickr = flatpickr('#copyEventDate', {
            locale: 'sv',
            enableTime: true,
            time_24hr: true,
            dateFormat: 'Y-m-d H:i'
        });
    }

    // Default to source date + 7 days
    if (event.date) {
        const newDate = new Date(event.date);
        newDate.setDate(newDate.getDate() + 7);
        copyEventFlatpickr.setDate(newDate);
    } else {
        copyEventFlatpickr.clear();
    }

    new bootstrap.Modal(document.getElementById('copyEventModal')).show();
}

function saveCopyEvent() {
    const sourceId = parseInt(document.getElementById('copyEventSourceId').value);
    const event = allEvents.find(e => e.id === sourceId);
    if (!event) { alert('Källhändelse hittades inte'); return; }

    const newDate = document.getElementById('copyEventDate').value;
    if (!newDate) { alert('Ange ett datum'); return; }

    const saveBtn = document.querySelector('#copyEventModal .modal-footer .btn-primary');
    const originalBtnText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Kopierar...';

    const formData = new FormData();
    formData.append('clubId', clubId);
    formData.append('eventName', document.getElementById('copyEventName').value || event.name || '');
    formData.append('eventType', event.type || 'Träning');
    formData.append('eventDate', newDate);
    formData.append('venue', event.venue || '');
    formData.append('description', event.description || '');
    formData.append('contactPerson', event.contactPerson || '');
    formData.append('contactEmail', event.contactEmail || '');
    formData.append('contactPhone', event.contactPhone || '');
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    fetch('/umbraco/surface/Club/CreateClubEvent', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('copyEventModal')).hide();
            loadEvents();
            alert('Händelse kopierad!');
        } else {
            alert('Fel: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error copying event:', error);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalBtnText;
        alert('Fel vid kopiering av händelse.');
    });
}

