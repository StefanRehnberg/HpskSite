async function toggleClubTgMemberRole(groupId, memberId, currentRole) {
    const newRole = currentRole === 'Trainer' ? 'Member' : 'Trainer';

    const token = getAntiForgeryToken();
    const formData = new FormData();
    formData.append('__RequestVerificationToken', token);
    formData.append('trainingGroupId', groupId);
    formData.append('memberId', memberId);
    formData.append('role', newRole);

    try {
        const response = await fetch('/umbraco/surface/TrainingGroup/SetTrainingGroupMemberRole', {
            method: 'POST', body: formData
        });
        const result = await response.json();

        if (result.success) {
            loadClubTrainingGroupMembers(groupId);
            loadClubTrainingGroups();
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Error toggling role:', error);
        alert('Ett fel uppstod');
    }
}

async function removeClubTgMember(groupId, memberId, memberName) {
    if (!confirm(`Ta bort ${memberName} från träningsgruppen?`)) return;

    const token = getAntiForgeryToken();
    const formData = new FormData();
    formData.append('__RequestVerificationToken', token);
    formData.append('trainingGroupId', groupId);
    formData.append('memberId', memberId);

    try {
        const response = await fetch('/umbraco/surface/TrainingGroup/RemoveTrainingGroupMember', {
            method: 'POST', body: formData
        });
        const result = await response.json();

        if (result.success) {
            loadClubTrainingGroupMembers(groupId);
            loadClubTrainingGroups();
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Error removing member:', error);
        alert('Ett fel uppstod');
    }
}

// ========== BREVO API KEY ==========

function toggleBrevoKeyVisibility() {
    const input = document.getElementById('brevoApiKey');
    const icon = document.getElementById('brevoKeyToggleIcon');
    if (input.type === 'password') {
        input.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        input.type = 'password';
        icon.className = 'bi bi-eye';
    }
}

function testBrevoApiKey() {
    const apiKey = document.getElementById('brevoApiKey').value.trim();
    const resultEl = document.getElementById('brevoKeyTestResult');
    if (!apiKey) {
        resultEl.className = 'mt-1 alert alert-warning py-1 small';
        resultEl.textContent = 'Ange en API-nyckel först';
        resultEl.classList.remove('d-none');
        return;
    }

    resultEl.className = 'mt-1 text-muted small';
    resultEl.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Testar...';
    resultEl.classList.remove('d-none');

    const token = getAntiForgeryToken();
    fetch('/umbraco/surface/ClubEmail/TestBrevoApiKey', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: `apiKey=${encodeURIComponent(apiKey)}`
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            resultEl.className = 'mt-1 alert alert-success py-1 small';
            resultEl.textContent = data.message;
        } else {
            resultEl.className = 'mt-1 alert alert-danger py-1 small';
            resultEl.textContent = data.message;
        }
    })
    .catch(() => {
        resultEl.className = 'mt-1 alert alert-danger py-1 small';
        resultEl.textContent = 'Nätverksfel vid test';
    });
}

// ========== SKJUTLEDARE MANAGEMENT ==========

function showSkjutledareModal() {
    const modalElement = document.getElementById('skjutledareModal');
    const modal = new bootstrap.Modal(modalElement);
    modal.show();
    loadSkjutledare();
}

async function loadSkjutledare() {
    const listEl = document.getElementById('skjutledareList');
    try {
        const res = await fetch(`/umbraco/surface/ClubAdmin/GetSkjutledare?clubId=${clubId}`);
        const data = await res.json();
        if (!data.success) {
            listEl.innerHTML = '<div class="text-danger">Kunde inte ladda skjutledare</div>';
            return;
        }
        if (data.data.length === 0) {
            listEl.innerHTML = '<div class="text-muted small">Inga skjutledare tilldelade.</div>';
        } else {
            listEl.innerHTML = data.data.map(s => `
                <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                    <div>
                        <i class="bi bi-shield-check text-success me-2"></i>
                        <strong>${s.name}</strong>
                        <span class="text-muted ms-2 small">${s.email}</span>
                    </div>
                    <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeSkjutledare(${s.id}, '${s.name}')">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            `).join('');
        }
        // Load available members for dropdown
        loadSkjutledareDropdown(data.data.map(s => s.id));
    } catch (error) {
        console.error('Error loading skjutledare:', error);
        listEl.innerHTML = '<div class="text-danger">Fel vid laddning</div>';
    }
}

async function loadSkjutledareDropdown(existingIds) {
    const select = document.getElementById('skjutledareSelect');
    try {
        const res = await fetch(`/umbraco/surface/ClubAdmin/GetClubMembers?clubId=${clubId}`);
        const data = await res.json();
        if (data.success && data.data) {
            select.innerHTML = '<option value="">Välj medlem...</option>';
            data.data
                .filter(m => !existingIds.includes(m.id))
                .forEach(m => {
                    select.innerHTML += `<option value="${m.id}">${m.memberName} (${m.email})</option>`;
                });
        }
    } catch (error) {
        console.error('Error loading members for skjutledare dropdown:', error);
    }
}

async function assignSkjutledare() {
    const select = document.getElementById('skjutledareSelect');
    const memberId = select.value;
    if (!memberId) {
        alert('Välj en medlem först');
        return;
    }
    try {
        const formData = new FormData();
        formData.append('memberId', memberId);
        formData.append('clubId', clubId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        const res = await fetch('/umbraco/surface/ClubAdmin/AssignSkjutledare', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (data.success) {
            loadSkjutledare();
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error assigning skjutledare:', error);
        alert('Ett fel uppstod');
    }
}

async function removeSkjutledare(memberId, name) {
    if (!confirm(`Ta bort ${name} som skjutledare?`)) return;
    try {
        const formData = new FormData();
        formData.append('memberId', memberId);
        formData.append('clubId', clubId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        const res = await fetch('/umbraco/surface/ClubAdmin/RemoveSkjutledare', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (data.success) {
            loadSkjutledare();
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error removing skjutledare:', error);
        alert('Ett fel uppstod');
    }
}

// ========== KLUBBADMINS MANAGEMENT ==========
// Mirrors the Skjutledare flow above. Distinct from skjutledare because the
// underlying group is ClubAdmin_{clubId} rather than Skjutledare_{clubId} —
// and because removing the *last* admin would orphan the club, so we guard
// against that both client- and server-side.

let clubAdminsCache = []; // last loaded admin list — used for the last-admin guard

function showClubAdminsModal() {
    const modalElement = document.getElementById('clubAdminsModal');
    const modal = new bootstrap.Modal(modalElement);
    modal.show();
    loadClubAdmins();
}

async function loadClubAdmins() {
    const listEl = document.getElementById('clubAdminsList');
    try {
        const res = await fetch(`/umbraco/surface/ClubAdmin/GetClubAdmins?clubId=${clubId}`);
        const data = await res.json();
        if (!data.success) {
            listEl.innerHTML = '<div class="text-danger">Kunde inte ladda klubbadmins</div>';
            return;
        }
        // GetClubAdmins returns { success, admins: [...] } — different shape from
        // GetSkjutledare which uses { success, data: [...] }.
        const admins = data.admins || [];
        clubAdminsCache = admins;

        if (admins.length === 0) {
            listEl.innerHTML = '<div class="text-warning">Inga klubbadmins tilldelade — klubben kan inte hanteras förrän någon utses.</div>';
        } else {
            listEl.innerHTML = admins.map(a => {
                // Disable the remove button when this is the last admin standing.
                const isLast = admins.length === 1;
                const removeBtn = isLast
                    ? `<button class="btn btn-sm btn-outline-secondary py-0 px-2" disabled title="Minst en klubbadmin måste finnas — lägg till en annan först">
                           <i class="bi bi-x-lg"></i>
                       </button>`
                    : `<button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeClubAdmin(${a.id}, ${JSON.stringify(a.name)})">
                           <i class="bi bi-x-lg"></i>
                       </button>`;
                return `
                    <div class="d-flex align-items-center justify-content-between py-1 border-bottom">
                        <div>
                            <i class="bi bi-person-gear text-warning me-2"></i>
                            <strong>${a.name}</strong>
                            <span class="text-muted ms-2 small">${a.email}</span>
                        </div>
                        ${removeBtn}
                    </div>
                `;
            }).join('');
        }
        loadClubAdminDropdown(admins.map(a => a.id));
    } catch (error) {
        console.error('Error loading club admins:', error);
        listEl.innerHTML = '<div class="text-danger">Fel vid laddning</div>';
    }
}

async function loadClubAdminDropdown(existingIds) {
    const select = document.getElementById('clubAdminSelect');
    try {
        // Scope to current club's members only — same pattern as Skjutledare's
        // GetClubMembers, but using the dedicated endpoint which also filters
        // out members who are already admins of this club.
        const res = await fetch(`/umbraco/surface/ClubAdmin/GetAvailableMembersForClubAdmin?clubId=${clubId}&filterClubId=${clubId}`);
        const data = await res.json();
        if (data.success && data.members) {
            select.innerHTML = '<option value="">Välj medlem...</option>';
            data.members.forEach(m => {
                if (!existingIds.includes(m.id)) {
                    const label = `${m.name || (m.firstName + ' ' + m.lastName)} (${m.email})`;
                    select.innerHTML += `<option value="${m.id}">${label}</option>`;
                }
            });
        }
    } catch (error) {
        console.error('Error loading members for club admin dropdown:', error);
    }
}

async function assignClubAdmin() {
    const select = document.getElementById('clubAdminSelect');
    const memberId = select.value;
    if (!memberId) {
        alert('Välj en medlem först');
        return;
    }
    try {
        const formData = new FormData();
        formData.append('memberId', memberId);
        formData.append('clubId', clubId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        const res = await fetch('/umbraco/surface/ClubAdmin/AssignClubAdmin', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (data.success) {
            loadClubAdmins();
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error assigning club admin:', error);
        alert('Ett fel uppstod');
    }
}

async function removeClubAdmin(memberId, name) {
    // Client-side guard: can't remove the last admin. (Mirrored server-side
    // for safety; this prompt just keeps the user honest before the round-trip.)
    if (clubAdminsCache.length <= 1) {
        alert('Minst en klubbadmin måste finnas — lägg till en annan först.');
        return;
    }
    if (!confirm(`Ta bort ${name} som klubbadmin?`)) return;
    try {
        const formData = new FormData();
        formData.append('memberId', memberId);
        formData.append('clubId', clubId);
        formData.append('__RequestVerificationToken', getAntiForgeryToken());

        const res = await fetch('/umbraco/surface/ClubAdmin/RemoveClubAdmin', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();
        if (data.success) {
            loadClubAdmins();
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error removing club admin:', error);
        alert('Ett fel uppstod');
    }
}
