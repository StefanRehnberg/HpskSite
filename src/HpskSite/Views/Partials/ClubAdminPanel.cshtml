// Load Club Competitions
function loadClubCompetitions() {
    const container = document.getElementById('competitionsTableContainer');
    container.innerHTML = '<div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar tävlingar...</span></div></div>';

    populateClubYearFilter();
    window.hpskLoadCompetitionTypes().then(populateClubTypeFilter);

    // Build URL with server-side filters
    const params = [];
    if (clubCompetitionsFilters.year) params.push(`year=${clubCompetitionsFilters.year}`);
    params.push(`includeCompleted=${clubCompetitionsFilters.includeCompleted}`);
    if (clubCompetitionsFilters.type) params.push(`type=${encodeURIComponent(clubCompetitionsFilters.type)}`);
    const url = '/umbraco/surface/CompetitionAdmin/GetCompetitionsList?' + params.join('&');

    fetch(url)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Filter for competitions belonging to this club (regardless of isClubOnly setting)
                // Club admins need to manage all their club's competitions
                const clubCompetitions = (data.data || []).filter(comp =>
                    comp.clubId === clubId
                );
                // Comps this user manages that have NO club (krets/nationell). They never show
                // under any club page — surfacing the count stops the "I created it but can't
                // find it" confusion when a regional admin mis-scoped the Arrangör.
                // Suppressed for site admins: they receive every no-club comp site-wide, so the
                // count would be noise unrelated to this club (they use the main admin page).
                const noClubComps = data.isSiteAdmin
                    ? []
                    : (data.data || []).filter(comp => !comp.clubId || comp.clubId <= 0);
                displayClubCompetitions(clubCompetitions, noClubComps);
            } else {
                container.innerHTML = '<div class="alert alert-warning">Kunde inte ladda tävlingar.</div>';
            }
        })
        .catch(error => {
            console.error('Error loading club competitions:', error);
            container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av tävlingar.</div>';
        });
}


function displayClubCompetitions(competitions, noClubComps) {
    const container = document.getElementById('competitionsTableContainer');

    // Hint: comps the user manages that have no club (krets/nationell) don't appear in this
    // club list. Point them to where those are managed instead.
    let noClubHint = '';
    if (noClubComps && noClubComps.length > 0) {
        noClubHint = '<div class="alert alert-info py-2 small">' +
            '<i class="bi bi-info-circle me-1"></i>Du hanterar även <strong>' + noClubComps.length +
            '</strong> tävling' + (noClubComps.length === 1 ? '' : 'ar') + ' utan klubb (krets-/nationell nivå). ' +
            'De visas inte här — öppna kretsens regionsida eller den allmänna administrationssidan för att hantera dem.' +
            '</div>';
    }

    if (!competitions || competitions.length === 0) {
        container.innerHTML = noClubHint + '<div class="alert alert-info">Inga tävlingar har skapats ännu för denna klubb.</div>';
        return;
    }

    // Table, rows and badges come from _CompetitionListRenderer.cshtml, shared with the
    // site-admin and krets lists. editClubCompetition/copyClubCompetition take (id, type).
    container.innerHTML = noClubHint + window.hpskRenderCompetitionTable(competitions, {
        kind: 'klubb',
        edit: 'editClubCompetition',
        editArgs: 'typeOnly',
        copy: 'copyClubCompetition',
        copyArgs: 'idAndType',
        del: 'deleteClubCompetition'
    });
}


function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Create new club competition using wizard
function showCreateClubCompetitionModal() {
    // Check if the wizard modal exists
    const modalElement = document.getElementById('competitionWizardModal');
    if (!modalElement) {
        alert('Tävlingsguide kunde inte hittas. Kontakta administratören.');
        return;
    }

    // Show the wizard modal
    const modal = window.competitionWizardModalInstance || new bootstrap.Modal(modalElement);
    window.competitionWizardModalInstance = modal;
    modal.show();

    // Reset wizard to step 0 when opened
    if (typeof window.resetWizard === 'function') {
        window.resetWizard();
    }

    // Set callback to reload competitions list after save
    window.onCompetitionSaved = function() {
