function renderEditMemberHandicapInfo(data) {
    const container = document.getElementById('editMemberHandicapInfoContainer');

    if (!data.weaponClasses || data.weaponClasses.length === 0) {
        container.innerHTML = '<div class="alert alert-info small mb-0">Ingen statistik tillgänglig ännu.</div>';
        return;
    }

    let html = '';
    data.weaponClasses.forEach(wc => {
        const provBadge = wc.isProvisional ? '<span class="badge bg-warning text-dark ms-1">(P)</span>' : '';
        const handicap = wc.handicapPerSeries >= 0 ? '+' + wc.handicapPerSeries.toFixed(2) : wc.handicapPerSeries.toFixed(2);

        html += `
            <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                <span><strong>${wc.weaponClass}</strong> (${wc.weaponClassName})</span>
                <span>
                    <strong>${handicap}</strong>${provBadge}
                    <small class="text-muted ms-2">${wc.completedMatches}/${wc.requiredMatches} matcher</small>
                </span>
            </div>
        `;
    });

    container.innerHTML = html;
}

async function recalculateEditMemberHandicap() {
    const memberId = document.getElementById('editMemberId').value;
    if (!memberId) return;

    const btn = document.getElementById('editMemberRecalculateHandicapBtn');
    const originalContent = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
    btn.disabled = true;

    try {
        const token = getAntiForgeryToken();
        const payload = { MemberId: parseInt(memberId) };

        const response = await fetch('/umbraco/surface/Member/RecalculateHandicapForMember', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            credentials: 'include',
            body: JSON.stringify(payload)
        });
        const result = await response.json();

        if (result.success) {
            await loadEditMemberHandicapInfo(memberId);
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Recalculate error:', error);
        alert('Fel vid omberäkning av handicap');
    } finally {
        btn.innerHTML = originalContent;
        btn.disabled = false;
    }
}

// Save member
async function saveEditClubMember() {
    const memberId = document.getElementById('editMemberId').value;

    const formData = new FormData();
    formData.append('id', memberId);
    formData.append('firstName', document.getElementById('editMemberFirstName').value);
    formData.append('lastName', document.getElementById('editMemberLastName').value);
    formData.append('email', document.getElementById('editMemberEmail').value);
    formData.append('phoneNumber', document.getElementById('editMemberPhoneNumber').value);
    formData.append('shooterIdNumber', document.getElementById('editMemberShooterIdNumber').value);
    formData.append('address', document.getElementById('editMemberAddress').value);
    formData.append('postalCode', document.getElementById('editMemberPostalCode').value);
    formData.append('city', document.getElementById('editMemberCity').value);
    formData.append('personNumber', document.getElementById('editMemberPersonNumber').value);
    formData.append('memberSince', document.getElementById('editMemberMemberSince').value);
    formData.append('primaryClubId', document.getElementById('editMemberPrimaryClub').value);
    formData.append('isApproved', document.getElementById('editMemberIsApproved').checked);
    // Note: person-level expansion fields (birthDate, guardians, etc.) are edited by the
    // member on Min sida. Club-membership fields are saved separately via saveClubMembership().

    // Additional clubs
    const additionalClubs = Array.from(document.querySelectorAll('input[name="editMemberAdditionalClubs"]:checked'))
        .map(cb => cb.value);
    formData.append('additionalClubIds', additionalClubs.join(','));

    // Member groups - include checked groups from UI
    const selectedGroups = Array.from(document.querySelectorAll('input[name="editMemberGroups"]:checked'))
        .map(cb => cb.value);

    // IMPORTANT: Add back preserved admin groups (ClubAdmin_*, RegionalAdmin_*)
    // These are filtered from the UI but must be preserved to prevent accidental removal
    const allGroups = [...new Set([...selectedGroups, ...editMemberPreservedAdminGroups])];
    allGroups.forEach(g => formData.append('groups', g));

    // Shooter class
    const shooterClassRadio = document.querySelector('input[name="editMemberShooterClass"]:checked');
    formData.append('precisionShooterClass', shooterClassRadio ? shooterClassRadio.value : '');

    // Anti-forgery token
    const token = getAntiForgeryToken();
    if (token) {
        formData.append('__RequestVerificationToken', token);
    }

    try {
        const response = await fetch('/umbraco/surface/MemberAdmin/SaveMember', {
            method: 'POST',
            body: formData
        });
        const result = await response.json();

        if (result.success) {
            // Also persist the per-club membership fields + family linking (same Save button).
            try {
                const memResult = await saveClubMembership();
                if (memResult && memResult.success === false) {
                    alert('Personuppgifter sparade, men klubbmedlemskap kunde inte sparas: ' + (memResult.message || ''));
                }
                await saveClubHousehold();
            } catch (e) {
                console.error('Membership save error:', e);
                alert('Personuppgifter sparade, men klubbmedlemskap kunde inte sparas.');
            }
            bootstrap.Modal.getInstance(document.getElementById('editClubMemberModal')).hide();
            loadClubMembers();
            alert('Medlem sparad!');
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Save error:', error);
        alert('Kunde inte spara medlem: ' + error.message);
    }
}

