// ===== COMPETITIONS TAB FUNCTIONS =====

// Make loadClubCompetitions available as loadCompetitionsList for CompetitionEditModal's save callback
window.loadCompetitionsList = window.loadCompetitionsList || function() { loadClubCompetitions(); };

// Filter state for club competitions (defaults: current year, hide completed)
let clubCompetitionsFilters = {
    year: new Date().getFullYear(),
    includeCompleted: false,
    type: ''
};
let clubCompetitionTypesCache = [];
let clubYearFilterInitialized = false;

function populateClubYearFilter() {
    if (clubYearFilterInitialized) return;
    const select = document.getElementById('clubYearFilter');
    if (!select) return;
    const currentYear = new Date().getFullYear();
    let html = '<option value="">Alla år</option>';
    for (let year = 2024; year <= currentYear + 1; year++) {
        const selected = year === currentYear ? 'selected' : '';
        html += `<option value="${year}" ${selected}>${year}</option>`;
    }
    select.innerHTML = html;
    clubYearFilterInitialized = true;
}

function onClubYearFilterChange() {
    const v = document.getElementById('clubYearFilter').value;
    clubCompetitionsFilters.year = v ? parseInt(v) : null;
    loadClubCompetitions();
}

function onClubTypeFilterChange() {
    clubCompetitionsFilters.type = document.getElementById('clubTypeFilter').value;
    loadClubCompetitions();
}

function onClubShowCompletedChange() {
    clubCompetitionsFilters.includeCompleted = document.getElementById('clubShowCompleted').checked;
    loadClubCompetitions();
}

function clearClubCompetitionFilters() {
    const currentYear = new Date().getFullYear();
    document.getElementById('clubYearFilter').value = currentYear.toString();
    document.getElementById('clubTypeFilter').value = '';
    document.getElementById('clubShowCompleted').checked = false;
    clubCompetitionsFilters = { year: currentYear, includeCompleted: false, type: '' };
    loadClubCompetitions();
}

function populateClubTypeFilter(competitions) {
    const select = document.getElementById('clubTypeFilter');
    if (!select) return;
    const types = [...new Set((competitions || []).map(c => c.type).filter(t => t))].sort();
    clubCompetitionTypesCache = types;
    const current = clubCompetitionsFilters.type || '';
    select.innerHTML = '<option value="">Alla typer</option>' +
        types.map(t => `<option value="${escapeHtml(t)}" ${t === current ? 'selected' : ''}>${escapeHtml(t)}</option>`).join('');
}

// Load Club Competitions
function loadClubCompetitions() {
    const container = document.getElementById('competitionsTableContainer');
    container.innerHTML = '<div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar tävlingar...</span></div></div>';

    populateClubYearFilter();

    // Build URL with server-side filters
    const params = [];
    if (clubCompetitionsFilters.year) params.push(`year=${clubCompetitionsFilters.year}`);
    params.push(`includeCompleted=${clubCompetitionsFilters.includeCompleted}`);
    if (clubCompetitionsFilters.type) params.push(`type=${encodeURIComponent(clubCompetitionsFilters.type)}`);
    const url = '/umbraco/surface/CompetitionAdmin/GetCompetitionsList?' + params.join('&');

    fetch(url)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Filter for competitions belonging to this club (regardless of isClubOnly setting)
                // Club admins need to manage all their club's competitions
                const clubCompetitions = (data.data || []).filter(comp =>
                    comp.clubId === clubId
                );
                // Populate type dropdown from full club result on first load (when no type filter active)
                if (!clubCompetitionsFilters.type && clubCompetitionTypesCache.length === 0) {
                    populateClubTypeFilter(clubCompetitions);
                }
                displayClubCompetitions(clubCompetitions);
            } else {
                container.innerHTML = '<div class="alert alert-warning">Kunde inte ladda tävlingar.</div>';
            }
        })
        .catch(error => {
            console.error('Error loading club competitions:', error);
            container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av tävlingar.</div>';
        });
}

function displayClubCompetitions(competitions) {
