// Personnummer validation
function validateSwedishPersonnummer(value) {
    if (!value || value.trim() === '') {
        return true; // Empty is allowed (not required)
    }

    // Remove any spaces
    value = value.replace(/\s/g, '');

    // Check format: YYYYMMDD-XXXX or YYYYMMDDXXXX
    const regex = /^(19|20)\d{6}[-]?\d{4}$/;
    if (!regex.test(value)) {
        return false;
    }

    // Normalize to 12 digits (remove hyphen if present)
    const digits = value.replace('-', '');

    // Extract date parts
    const year = parseInt(digits.substring(0, 4));
    const month = parseInt(digits.substring(4, 6));
    const day = parseInt(digits.substring(6, 8));

    // Validate date
    const date = new Date(year, month - 1, day);
    if (date.getFullYear() !== year || date.getMonth() !== month - 1 || date.getDate() !== day) {
        return false;
    }

    // Luhn algorithm checksum validation
    const checkDigits = digits.substring(2); // Use last 10 digits for Luhn
    let sum = 0;
    for (let i = 0; i < 10; i++) {
        let digit = parseInt(checkDigits[i]);
        if (i % 2 === 0) {
            digit *= 2;
            if (digit > 9) digit -= 9;
        }
        sum += digit;
    }

    return sum % 10 === 0;
}

// Add validation on blur and before save
document.getElementById('editMemberPersonNumber').addEventListener('blur', function() {
    const isValid = validateSwedishPersonnummer(this.value);
    if (!isValid && this.value.trim() !== '') {
        this.classList.add('is-invalid');
    } else {
        this.classList.remove('is-invalid');
    }
});

// ========== TRAINING GROUPS TAB ==========

let clubTrainingGroups = [];
let clubTgSearchTimeout = null;
let expandedClubTgId = null;

async function loadClubTrainingGroups() {
    const container = document.getElementById('clubTrainingGroupList');
    container.innerHTML = `
        <div class="text-center py-4">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>`;

    try {
        const response = await fetch('/umbraco/surface/TrainingGroup/GetTrainingGroups');
        const result = await response.json();

        if (!result.success) {
            container.innerHTML = `<div class="alert alert-warning">${result.message || 'Kunde inte ladda träningsgrupper'}</div>`;
            return;
        }

        // Filter to only show groups for this club
        clubTrainingGroups = (result.data || []).filter(g => g.clubId === clubId);

        if (clubTrainingGroups.length === 0) {
            container.innerHTML = `
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>Inga träningsgrupper ännu. Skapa en ny träningsgrupp för att komma igång.
                </div>`;
            return;
        }

        let html = '<div class="table-responsive"><table class="table table-hover">';
        html += `<thead><tr>
            <th>Namn</th>
            <th>Startdatum</th>
            <th class="text-center">Medlemmar</th>
            <th class="text-center">Tränare</th>
            <th></th>
        </tr></thead><tbody>`;

        clubTrainingGroups.forEach(g => {
            const inactiveClass = g.isActive ? '' : ' class="table-secondary text-muted"';
            html += `
                <tr${inactiveClass} style="cursor: pointer;" onclick="expandClubTrainingGroup(${g.id})">
                    <td>
                        <span class="fw-bold">${g.name}</span>
                        ${!g.isActive ? ' <span class="badge bg-secondary">Inaktiv</span>' : ''}
                        ${g.description ? `<br><small class="text-muted">${g.description}</small>` : ''}
                    </td>
                    <td>${g.startDate}</td>
                    <td class="text-center"><span class="badge bg-primary">${g.memberCount}</span></td>
                    <td class="text-center"><span class="badge bg-info">${g.trainerCount}</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" onclick="event.stopPropagation(); editClubTrainingGroup(${g.id})" title="Redigera">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </td>
                </tr>
                <tr id="clubTgDetail_${g.id}" style="display: none;">
                    <td colspan="5" class="bg-body-tertiary">
                        <div id="clubTgMembers_${g.id}" class="p-2">
                            <div class="text-center py-2">
                                <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                            </div>
                        </div>
                    </td>
                </tr>`;
        });

        html += '</tbody></table></div>';
        container.innerHTML = html;

        // Re-expand if there was one expanded
        if (expandedClubTgId) {
            const detailRow = document.getElementById(`clubTgDetail_${expandedClubTgId}`);
            if (detailRow) {
                detailRow.style.display = '';
                loadClubTrainingGroupMembers(expandedClubTgId);
            }
        }
    } catch (error) {
        console.error('Error loading training groups:', error);
        container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av träningsgrupper.</div>';
    }
}

async function expandClubTrainingGroup(groupId) {
    const detailRow = document.getElementById(`clubTgDetail_${groupId}`);
    if (!detailRow) return;

    // Toggle visibility
    if (detailRow.style.display !== 'none' && expandedClubTgId === groupId) {
        detailRow.style.display = 'none';
        expandedClubTgId = null;
        return;
    }

    // Collapse others
    clubTrainingGroups.forEach(g => {
        const el = document.getElementById(`clubTgDetail_${g.id}`);
        if (el) el.style.display = 'none';
    });

    detailRow.style.display = '';
    expandedClubTgId = groupId;
    loadClubTrainingGroupMembers(groupId);
}

async function loadClubTrainingGroupMembers(groupId) {
    const container = document.getElementById(`clubTgMembers_${groupId}`);
    if (!container) return;

    try {
        const response = await fetch(`/umbraco/surface/TrainingGroup/GetTrainingGroup?trainingGroupId=${groupId}`);
        const result = await response.json();

        if (!result.success) {
            container.innerHTML = `<div class="alert alert-warning">${result.message}</div>`;
            return;
        }

        const group = result.data;
        const members = group.members || [];

        let html = `
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong>Medlemmar (${members.length})</strong>
                <button class="btn btn-sm btn-outline-success" onclick="event.stopPropagation(); showAddClubTgMemberModal(${groupId})">
                    <i class="bi bi-person-plus me-1"></i>Lägg till medlem
                </button>
            </div>`;

        if (members.length === 0) {
            html += '<p class="text-muted small">Inga medlemmar i gruppen ännu.</p>';
        } else {
            html += '<div class="table-responsive"><table class="table table-sm mb-0">';
            html += '<thead><tr><th>Namn</th><th>Klubb</th><th>Roll</th><th>Tillagd</th><th></th></tr></thead><tbody>';

            // Sort: trainers first
            const sorted = [...members].sort((a, b) => {
                if (a.role === 'Trainer' && b.role !== 'Trainer') return -1;
                if (a.role !== 'Trainer' && b.role === 'Trainer') return 1;
                return 0;
            });

            sorted.forEach(m => {
                html += `
                    <tr>
                        <td>${m.memberName}</td>
                        <td class="text-muted">${m.clubName || '-'}</td>
                        <td>
                            <span class="badge ${m.isTrainer ? 'bg-info' : 'bg-secondary'}">${m.isTrainer ? 'Tränare' : 'Medlem'}</span>
                        </td>
                        <td class="text-muted small">${m.joinedDate}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary py-0 px-1" onclick="event.stopPropagation(); toggleClubTgMemberRole(${groupId}, ${m.memberId}, '${m.role}')" title="${m.role === 'Trainer' ? 'Gör till medlem' : 'Gör till tränare'}">
                                <i class="bi bi-arrow-left-right"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="event.stopPropagation(); removeClubTgMember(${groupId}, ${m.memberId}, '${m.memberName.replace(/'/g, "\\'")}')" title="Ta bort">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>`;
            });

            html += '</tbody></table></div>';
        }

        container.innerHTML = html;
    } catch (error) {
        console.error('Error loading training group members:', error);
        container.innerHTML = '<div class="alert alert-danger">Fel vid laddning</div>';
    }
}

