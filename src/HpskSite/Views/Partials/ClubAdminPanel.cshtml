async function recalculateEditMemberHandicap() {
    const memberId = document.getElementById('editMemberId').value;
    if (!memberId) return;

    const btn = document.getElementById('editMemberRecalculateHandicapBtn');
    const originalContent = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span>';
    btn.disabled = true;

    try {
        const token = getAntiForgeryToken();
        const payload = { MemberId: parseInt(memberId) };

        const response = await fetch('/umbraco/surface/Member/RecalculateHandicapForMember', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            credentials: 'include',
            body: JSON.stringify(payload)
        });
        const result = await response.json();

        if (result.success) {
            await loadEditMemberHandicapInfo(memberId);
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Recalculate error:', error);
        alert('Fel vid omberäkning av handicap');
    } finally {
        btn.innerHTML = originalContent;
        btn.disabled = false;
    }
}

