function loadMarkenOrder() {
    const content = document.getElementById('markenOrderContent');
    const actions = document.getElementById('markenOrderActions');
    const year = markenOrderYear();
    const label = document.getElementById('markenOrderYearLabel');
    if (label) label.textContent = year;
