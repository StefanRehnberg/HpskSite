function saveClubMember() {
    const form = document.getElementById('addClubMemberForm');
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const formData = new FormData(form);
    formData.append('clubId', clubId);
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    fetch('/umbraco/surface/ClubAdmin/AddClubMember', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('addClubMemberModal')).hide();
            loadClubMembers();
            alert('Medlem tillagd! Du kan nu skicka en inbjudan till medlemmen.');
        } else {
            alert('Fel: ' + data.message);
        }
    })
    .catch(error => {
        console.error('Error adding club member:', error);
        alert('Fel vid tillägg av medlem.');
    });
}

// Upload club image (logo or banner)
function uploadClubImage(imageType, input) {
    if (!input.files || !input.files[0]) return;

    var file = input.files[0];

    // Validate file size (5 MB max)
    if (file.size > 5 * 1024 * 1024) {
        alert('Filen är för stor. Max 5 MB tillåtet.');
        input.value = '';
        return;
    }

    var formData = new FormData();
    formData.append('clubId', clubId);
    formData.append('imageType', imageType);
    formData.append('imageFile', file);
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    var previewId = imageType === 'logo' ? 'clubLogoPreview' : 'clubBannerPreview';
    var imgId = imageType === 'logo' ? 'clubLogoImg' : 'clubBannerImg';

    fetch('/umbraco/surface/Club/UploadClubImage', {
        method: 'POST',
        body: formData
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            document.getElementById(imgId).src = data.imageUrl;
            document.getElementById(previewId).style.display = '';
            alert('Bild uppladdad!');
        } else {
            alert('Fel: ' + data.message);
        }
        input.value = '';
    })
    .catch(function(err) {
        console.error('Error uploading image:', err);
        alert('Fel vid uppladdning av bild.');
        input.value = '';
    });
}

// Remove club image (clear the property)
function removeClubImage(imageType) {
    if (!confirm('Är du säker på att du vill ta bort denna bild?')) return;

    var formData = new FormData();
    formData.append('clubId', clubId);
    formData.append('imageType', imageType);
    formData.append('__RequestVerificationToken', getAntiForgeryToken());

    fetch('/umbraco/surface/Club/RemoveClubImage', {
        method: 'POST',
        body: formData
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            var previewId = imageType === 'logo' ? 'clubLogoPreview' : 'clubBannerPreview';
            document.getElementById(previewId).style.display = 'none';
        } else {
            alert('Fel: ' + data.message);
        }
    })
    .catch(function(err) {
        console.error('Error removing image:', err);
        alert('Fel vid borttagning av bild.');
    });
}

