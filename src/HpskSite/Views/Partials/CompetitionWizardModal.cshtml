<script>
// Wizard State
let wizardCurrentStep = 0;
let wizardContext = {
    isClubPage: false,
    clubId: null,
    clubName: null
};

// Handle competition type dropdown change - show/hide custom input + apply type-specific defaults
function onCompetitionTypeChange() {
    const typeSelect = document.getElementById('wizard_competitionType');

    // Apply type-specific series defaults
    applySeriesDefaults();

    // Filter visible class sections and clear incompatible selections
    filterClassSections();

    // Show/hide Springskytte-specific stafett option
    const isSpringskytte = typeSelect.value === 'Springskytte';
    const stafettGroup = document.getElementById('wizard_stafettFeeGroup');
    if (stafettGroup) {
        stafettGroup.classList.toggle('d-none', !isSpringskytte);
        if (!isSpringskytte) {
            document.getElementById('wizard_allowStafett').checked = false;
            onWizardAllowStafettChange();
        }
    }

    // Show/hide Egenbokning (only for precision-family types)
    const excludedTypes = ['Springskytte', 'Faltskytte', 'MagnumFalt'];
    const dpAccordion = document.getElementById('wizardAccordionDirektplacering');
    if (dpAccordion) {
        const hideEgenbokning = excludedTypes.includes(typeSelect.value);
        dpAccordion.style.display = hideEgenbokning ? 'none' : '';
        if (hideEgenbokning) {
            document.getElementById('wizard_enableDirektplacering').checked = false;
            document.getElementById('direktplaceringConfigSection').style.display = 'none';
        }
    }
}

// Show/hide class sections in the overlay based on competition type.
// MagnumPrecision only allows M-classes; other types show all sections.
function filterClassSections() {
    const typeId = document.getElementById('wizard_competitionType').value;
    const isSpringskytte = (typeId === 'Springskytte');

    // Toggle between standard and Springskytte class selection panels
    document.getElementById('wizard_standardClassSelection').style.display = isSpringskytte ? 'none' : '';
    document.getElementById('wizard_springskytteClassSelection').style.display = isSpringskytte ? '' : 'none';

    if (isSpringskytte) {
        // Clear standard class selections when switching to Springskytte
        document.querySelectorAll('.class-checkbox:checked').forEach(cb => { cb.checked = false; });
        springClassUpdateSelection();
        return;
    }

    // Clear Springskytte selections when switching away
    document.querySelectorAll('.spring-weapon-cb:checked, .spring-age-cb:checked').forEach(cb => { cb.checked = false; });

    const allSections = ['A', 'B', 'C', 'R', 'L', 'M'];
    const allowedSections = typeId === 'MagnumPrecision' ? ['M'] : allSections;

    allSections.forEach(section => {
        const el = document.getElementById('classSection_' + section);
        if (!el) return;
        const isAllowed = allowedSections.includes(section);
        el.style.display = isAllowed ? '' : 'none';

        if (!isAllowed) {
            el.querySelectorAll('.class-checkbox:checked').forEach(cb => { cb.checked = false; });
        }
    });

    const stillChecked = Array.from(document.querySelectorAll('.class-checkbox:checked')).map(cb => cb.value);
    document.getElementById('wizard_shootingClassIds').value = stillChecked.join(',');
    updateClassSelectionDisplay();
    updateOverlayClassCount();
}

// Apply series/finals defaults based on selected competition type
function applySeriesDefaults() {
    const typeId = document.getElementById('wizard_competitionType').value;
    const seriesInput = document.getElementById('wizard_numberOfSeries');
    const finalsInput = document.getElementById('wizard_finalSeries');
    const seriesButtons = document.getElementById('wizard_seriesButtons');
    const finalsGroup = document.getElementById('wizard_finalsGroup');
    const milsnabbNote = document.getElementById('wizard_milsnabbSeriesNote');
    const standardSection = document.getElementById('wizard_standardSeriesSection');
    const springSection = document.getElementById('wizard_springskytteSeriesSection');
    const isLocked = (typeId === 'Milsnabb' || typeId === 'NationellHelmatch');
    // Standardpistol/Sportpistol: 12 serier som FÖRVAL, inte låst. Se kommentaren i
    // PrecisionFamily.Facts — serieantalet är gängse format, inte en regel jag kunnat verifiera.
    const suggests12 = (typeId === 'Standardpistol' || typeId === 'Sportpistol');
    const isSpringskytte = (typeId === 'Springskytte');
    const isFaltskytte = (typeId === 'Faltskytte' || typeId === 'MagnumFalt');
    const faltSection = document.getElementById('wizard_faltskytteSection');

    // Toggle standard vs Springskytte vs Fältskytte series sections
    standardSection.style.display = (isSpringskytte || isFaltskytte) ? 'none' : '';
    springSection.style.display = isSpringskytte ? '' : 'none';
    faltSection.style.display = isFaltskytte ? '' : 'none';

    // Toggle special feature checkboxes irrelevant for Springskytte/Fältskytte
    document.getElementById('wizard_dualCClassGroup').style.display = (isSpringskytte || isFaltskytte) ? 'none' : '';
    document.getElementById('wizard_selfReportingGroup').style.display = (isSpringskytte || isFaltskytte) ? 'none' : '';

    if (isFaltskytte) {
        // Fältskytte: set defaults
        seriesInput.value = 8;
        finalsInput.value = 0;
        // Set max reshoots default based on subtype
        var maxReshootsInput = document.getElementById('wizard_maxReshoots');
        if (maxReshootsInput) {
            maxReshootsInput.value = (typeId === 'MagnumFalt') ? 0 : 1;
        }
    } else if (isSpringskytte) {
        // Show/hide class A series dropdown based on whether A is selected
        const hasA = document.getElementById('springWeapon_A')?.checked;
        document.getElementById('wizard_springskytteClassASeriesGroup').style.display = hasA ? '' : 'none';
        // Set series value: use class A series if A selected, otherwise 6 (class C default)
        const aSeries = document.getElementById('wizard_springskytteClassASeries').value;
        seriesInput.value = hasA ? aSeries : 6;
        finalsInput.value = 0;
    } else if (isLocked) {
        seriesInput.value = 12;
        seriesInput.readOnly = true;
        finalsInput.value = 0;
        finalsInput.readOnly = true;
        seriesButtons.classList.add('d-none');
        finalsGroup.style.opacity = '0.5';
        finalsGroup.querySelectorAll('button').forEach(b => b.disabled = true);
        milsnabbNote.classList.remove('d-none');
    } else if (suggests12) {
        // Förvalt men redigerbart: fälten låses INTE och finalgruppen lämnas öppen.
        seriesInput.value = 12;
        finalsInput.value = 0;
        seriesInput.readOnly = false;
        finalsInput.readOnly = false;
        seriesButtons.classList.remove('d-none');
        finalsGroup.style.opacity = '';
        finalsGroup.querySelectorAll('button').forEach(b => b.disabled = false);
        milsnabbNote.classList.add('d-none');
    } else {
        seriesInput.readOnly = false;
        finalsInput.readOnly = false;
        seriesButtons.classList.remove('d-none');
        finalsGroup.style.opacity = '';
        finalsGroup.querySelectorAll('button').forEach(b => b.disabled = false);
        milsnabbNote.classList.add('d-none');
    }
}

function springSeriesChanged() {
    const seriesInput = document.getElementById('wizard_numberOfSeries');
    seriesInput.value = document.getElementById('wizard_springskytteClassASeries').value;
}

// Initialize wizard when modal opens
document.getElementById('competitionWizardModal').addEventListener('show.bs.modal', function() {
    // Skip reset when re-opening from station configurator (preserves wizard data)
    if (window._wizardSkipReset) {
        window._wizardSkipReset = false;
        return;
    }
    wizardCurrentStep = 0;
    resetWizard();
    detectContext();
    loadClubsForWizard();
    loadRegionsForWizard();
    loadSeriesForWizard();
    updateWizardUI();

    // Initialize Flatpickr on first show
    setTimeout(() => {
        initializeWizardDatePickers();
    }, 100);

    // Initialize Bootstrap tooltips for info icons
    document.querySelectorAll('#competitionWizardModal [data-bs-toggle="tooltip"]').forEach(el => {
        bootstrap.Tooltip.getOrCreateInstance(el);
    });

    // Hydrate the Fältskytte saved-configuration picker (no-op if not visible).
    if (typeof faltPickerInit === 'function') faltPickerInit('wizard_');
    // Sync the Tävlingstyp display with the (default-or-attached) hidden value.
    if (typeof faltUpdateScoringModeDisplay === 'function') faltUpdateScoringModeDisplay('wizard_');
});

// Detect if we're on a club page or admin page
function detectContext() {
    // The parent page (Club.cshtml / ClubAdminPanel.cshtml) sets window.currentClubId
    // when the wizard is rendered on a club-specific page. Use that as the reliable signal
    // rather than checking the URL path (which varies with regional page structure).
    const clubId = window.currentClubId || null;
    wizardContext.isClubPage = !!clubId;
    wizardContext.clubId = clubId;
}

// Reset wizard to initial state
function resetWizard() {
    document.getElementById('competitionWizardForm').reset();
    document.getElementById('wizard_shootingClassIds').value = '';
    updateClassSelectionDisplay();

    // Reset step visibility
    document.querySelectorAll('.wizard-step').forEach((step, index) => {
        if (index === 0) {
            step.classList.remove('d-none');
        } else {
            step.classList.add('d-none');
        }
    });

    // Reset type-specific UI state (readOnly, disabled, etc.)
    applySeriesDefaults();

    // Reset team fee disabled state
    document.getElementById('wizard_teamRegistrationFee').disabled = true;
    const wizardTeamSeries = document.getElementById('wizard_teamResultSeriesCount');
    if (wizardTeamSeries) { wizardTeamSeries.disabled = true; wizardTeamSeries.value = ''; }

    // Reset stafett state
    document.getElementById('wizard_stafettRegistrationFee').disabled = true;
    document.getElementById('wizard_stafettFeeGroup').classList.add('d-none');
}

// Initialize Flatpickr date pickers
function initializeWizardDatePickers() {
    flatpickr('#wizard_competitionDate', {
        enableTime: true,
        dateFormat: 'Y-m-d H:i',
        time_24hr: true,
        locale: 'sv',
        onChange: function(selectedDates) {
            if (selectedDates.length > 0) {
                suggestRegistrationDates(selectedDates[0]);
            }
        }
    });

    flatpickr('#wizard_registrationOpenDate', {
        enableTime: true,
        dateFormat: 'Y-m-d H:i',
        time_24hr: true,
        locale: 'sv'
    });

    flatpickr('#wizard_registrationCloseDate', {
        enableTime: true,
        dateFormat: 'Y-m-d H:i',
        time_24hr: true,
        locale: 'sv'
    });

    flatpickr('#wizard_competitionEndDate', {
        dateFormat: 'Y-m-d',
        locale: 'sv'
    });

    // Set default registration open date to now
    const now = new Date();
    document.getElementById('wizard_registrationOpenDate').value =
        now.getFullYear() + '-' +
        String(now.getMonth() + 1).padStart(2, '0') + '-' +
        String(now.getDate()).padStart(2, '0') + ' ' +
        String(now.getHours()).padStart(2, '0') + ':' +
        String(now.getMinutes()).padStart(2, '0');
}

// Suggest registration dates based on competition date
function suggestRegistrationDates(competitionDate) {
    // Registration close: Competition date - 1 day at 23:59
    const closeDate = new Date(competitionDate);
    closeDate.setDate(closeDate.getDate() - 1);
    closeDate.setHours(23, 59, 0, 0);

    document.getElementById('wizard_registrationCloseDate').value =
        closeDate.getFullYear() + '-' +
        String(closeDate.getMonth() + 1).padStart(2, '0') + '-' +
        String(closeDate.getDate()).padStart(2, '0') + ' ' +
        String(closeDate.getHours()).padStart(2, '0') + ':' +
        String(closeDate.getMinutes()).padStart(2, '0');
}

// Module-level variables for role-aware wizard club management
let wizardUserRole = '';
let wizardManagedClubIds = [];

// Populate club dropdown and apply default club-page behavior
function populateWizardClubs(clubs) {
    const select = document.getElementById('wizard_clubId');
    select.innerHTML = '<option value="">-- Ingen klubb --</option>';

    clubs.forEach(club => {
        const option = document.createElement('option');
        option.value = club.id;
        option.textContent = club.name;
        select.appendChild(option);
    });

    // On club pages: pre-select club and lock by default (unlocked later for admins)
    if (wizardContext.isClubPage && wizardContext.clubId) {
        select.value = wizardContext.clubId;

        const origOption = select.options[select.selectedIndex];
        wizardContext.clubName = origOption ? origOption.textContent : '';

        // Default: lock dropdown (will be unlocked by applyClubPageContext if admin)
        select.disabled = true;
        document.getElementById('wizard_regionalFederation').disabled = true;

        const clubName = origOption ? origOption.textContent : '';
        const lockedInfo = document.getElementById('wizard_clubLockedInfo');
        const lockedName = document.getElementById('wizard_clubLockedName');
        if (lockedInfo && lockedName) {
            lockedName.textContent = clubName;
            lockedInfo.classList.remove('d-none');
        }

        document.getElementById('wizard_organizerHelpText').classList.remove('d-none');
        document.getElementById('wizard_isClubOnly').checked = true;
        onWizardIsClubOnlyChange();
    }
}

// Load clubs for dropdown
function loadClubsForWizard() {
    // Use public endpoint for club list (always available)
    fetch('/umbraco/surface/ClubAdmin/GetClubsForRegistration')
        .then(response => response.json())
        .then(data => {
            if (data.success && data.clubs) {
                populateWizardClubs(data.clubs);
            }
        })
        .catch(error => console.error('Error loading clubs:', error));

    // Separately fetch role info (optional — enhances behavior on club pages)
    fetch('/umbraco/surface/CompetitionAdmin/GetClubsForCompetitionAdmin')
        .then(response => {
            if (!response.ok) return null;
            return response.json();
        })
        .then(data => {
            if (data && data.success) {
                wizardUserRole = data.role || '';
                wizardManagedClubIds = data.managedClubIds || [];
                // Re-apply context now that we know the role
                applyClubPageContext();
            }
        })
        .catch(() => { /* Admin endpoint unavailable — default behavior is fine */ });
}

// Apply club page context (lock/unlock based on role)
function applyClubPageContext() {
    if (!wizardContext.isClubPage || !wizardContext.clubId) return;

    const select = document.getElementById('wizard_clubId');
    select.value = wizardContext.clubId;

    const origOption = select.options[select.selectedIndex];
    wizardContext.clubName = origOption ? origOption.textContent : '';

    if (wizardUserRole === 'admin') {
        // Site admin: keep enabled
        select.disabled = false;
        document.getElementById('wizard_regionalFederation').disabled = false;
        document.getElementById('wizard_organizerHelpText').classList.remove('d-none');

        const lockedInfo = document.getElementById('wizard_clubLockedInfo');
        if (lockedInfo) lockedInfo.classList.add('d-none');
    }
    // Non-admin lock is already applied by populateWizardClubs
    updateWizardDestinationSummary();
}

// Load regions for dropdown
function loadRegionsForWizard() {
    fetch('/umbraco/surface/RegionalAdmin/GetAllRegions')
        .then(response => response.json())
        .then(data => {
            if (data.success && data.regions) {
                const select = document.getElementById('wizard_regionalFederation');
                select.innerHTML = '<option value="">-- Ingen krets --</option>';

                data.regions.forEach(region => {
                    const option = document.createElement('option');
                    option.value = region.id;
                    option.textContent = region.name;
                    select.appendChild(option);
                });
            }
        })
        .catch(error => console.error('Error loading regions:', error));
}

// Handle club selection change - disable region if club is selected
function onWizardClubChange() {
    const clubSelect = document.getElementById('wizard_clubId');
    const regionSelect = document.getElementById('wizard_regionalFederation');

    if (clubSelect.value) {
        // Club selected - disable region dropdown and clear its value
        regionSelect.value = '';
        regionSelect.disabled = true;
    } else {
        // No club - enable region dropdown
        regionSelect.disabled = false;
    }

    syncWizardClubOnlyAvailability();
    updateWizardMismatchWarning();
    updateWizardDestinationSummary();

    // Refresh the range picker's "Klubbens banor" quick-pick for the chosen club.
    if (typeof compRangeLoadClubRanges === 'function') compRangeLoadClubRanges('wizard_', clubSelect.value);
}

// "Endast för vald klubb" only makes sense when an actual club is selected.
// With no club, the visibility filter (clubId == myClub) would hide the comp
// everywhere — so we force-uncheck and disable the checkbox in that state.
function syncWizardClubOnlyAvailability() {
    const clubSelect = document.getElementById('wizard_clubId');
    const cb = document.getElementById('wizard_isClubOnly');
    if (!cb) return;
    const hasClub = !!(clubSelect && clubSelect.value);
    if (!hasClub) {
        if (cb.checked) cb.checked = false;
        cb.disabled = true;
        // Cascade so standardmedal checkbox is re-enabled when isClubOnly is forced off.
        onWizardIsClubOnlyChange();
    } else {
        cb.disabled = false;
    }
}

// Handle region selection change
function onWizardRegionChange() {
    syncWizardClubOnlyAvailability();
    updateWizardMismatchWarning();
    updateWizardDestinationSummary();
}

function onWizardAllowTeamsChange() {
    const checked = document.getElementById('wizard_allowTeams').checked;
    const feeInput = document.getElementById('wizard_teamRegistrationFee');
    feeInput.disabled = !checked;
    if (!checked) feeInput.value = '0';
    const seriesInput = document.getElementById('wizard_teamResultSeriesCount');
    if (seriesInput) {
        seriesInput.disabled = !checked;
        if (!checked) seriesInput.value = '';
    }
}

function onWizardIsClubOnlyChange() {
    // Standard medals may not be awarded at club competitions (BR-PS.1.3).
    const clubOnly = document.getElementById('wizard_isClubOnly')?.checked || false;
    const medalCb = document.getElementById('wizard_isAwardingStandardMedals');
    const hint = document.getElementById('wizard_standardMedalsClubOnlyHint');
    if (medalCb) {
        if (clubOnly) {
            medalCb.checked = false;
            medalCb.disabled = true;
        } else {
            medalCb.disabled = false;
        }
    }
    if (hint) {
        hint.style.display = clubOnly ? '' : 'none';
    }
    updateWizardDestinationSummary();
}

function onWizardAllowStafettChange() {
    const checked = document.getElementById('wizard_allowStafett').checked;
    const feeInput = document.getElementById('wizard_stafettRegistrationFee');
    feeInput.disabled = !checked;
    if (!checked) feeInput.value = '0';
}

// Show/hide mismatch warning in wizard (only relevant on club pages)
function updateWizardMismatchWarning() {
    const warningDiv = document.getElementById('wizard_clubMismatchWarning');
    const warningText = document.getElementById('wizard_clubMismatchText');

    // Only show warnings on club pages
    if (!wizardContext.isClubPage || !wizardContext.clubId) {
        warningDiv.classList.add('d-none');
        return;
    }

    const clubSelect = document.getElementById('wizard_clubId');
    const regionSelect = document.getElementById('wizard_regionalFederation');
    const newClubId = clubSelect.value || '';
    const newRegion = regionSelect.disabled ? '' : (regionSelect.value || '');
    const origClub = String(wizardContext.clubId);
    const origClubName = wizardContext.clubName || 'denna klubb';

    let message = '';

    if (newClubId && newClubId !== origClub) {
        // Changed to a different club
        const selectedOption = clubSelect.options[clubSelect.selectedIndex];
        const newClubName = selectedOption ? selectedOption.textContent : 'den valda klubben';
        message = '<strong>Varning!</strong> Tävlingen kommer att visas och hanteras på <strong>' + newClubName + '</strong>s administrationssida — inte på <strong>' + origClubName + '</strong>s sida.';
    } else if (!newClubId && newRegion) {
        // Club removed, region set
        message = '<strong>Varning!</strong> Tävlingen kopplas till en krets istället för <strong>' + origClubName + '</strong>. Den kommer inte att visas i någon klubbs tävlingslista — den hanteras istället från <strong>kretsens regionsida</strong>.';
    } else if (!newClubId && !newRegion) {
        // Both cleared — national competition
        message = '<strong>Varning!</strong> Tävlingen skapas utan klubb eller krets och blir nationell. Den kommer inte att visas i <strong>' + origClubName + '</strong>s tävlingslista — den hanteras från den allmänna <strong>administrationssidan</strong> (eller kretsens regionsida).';
    }

    if (message) {
        warningText.innerHTML = message;
        warningDiv.classList.remove('d-none');
    } else {
        warningDiv.classList.add('d-none');
    }
}

// Live "Var hamnar tävlingen?" summary — neutral, always-on plain-language statement of
// where the competition will be managed/shown, based on the current Arrangör + visibility
// choices. Shown in ALL contexts (club page, regional page, general admin) so a user who
// ticks a club "because the club arranges it" immediately sees the visibility consequence.
function updateWizardDestinationSummary() {
    const textEl = document.getElementById('wizard_destinationText');
    if (!textEl) return;

    const clubSelect = document.getElementById('wizard_clubId');
    const regionSelect = document.getElementById('wizard_regionalFederation');
    const clubVal = clubSelect ? (clubSelect.value || '') : '';
    const regionVal = regionSelect ? (regionSelect.value || '') : '';
    const clubOnly = document.getElementById('wizard_isClubOnly')?.checked || false;

    // Before clubs have loaded the dropdown only has its placeholder — stay neutral.
    if (clubSelect && clubSelect.options.length <= 1 && !regionVal) {
        textEl.innerHTML = 'Välj klubb eller krets ovan.';
        return;
    }

    const clubName = (clubVal && clubSelect.selectedIndex >= 0)
        ? clubSelect.options[clubSelect.selectedIndex].textContent : '';
    const regionName = (regionVal && regionSelect.selectedIndex >= 0)
        ? regionSelect.options[regionSelect.selectedIndex].textContent : '';

    let msg;
    if (clubVal) {
        if (clubOnly) {
            msg = 'Visas <strong>endast för ' + clubName + 's medlemmar</strong>, på ' + clubName + 's sida. Hanteras från <strong>' + clubName + 's administrationssida</strong>.';
        } else {
            msg = 'Visas på <strong>' + clubName + 's sida</strong> och i kretsens inbjudningslista. Hanteras från <strong>' + clubName + 's administrationssida</strong>.';
        }
    } else if (regionVal) {
        msg = 'Visas på <strong>kretsens (' + regionName + ') regionsida</strong> — inte under någon klubb. Hanteras från <strong>regionsidan</strong>.';
    } else {
        msg = '<strong>Nationell tävling</strong> — syns för alla. Hanteras endast från den allmänna <strong>administrationssidan</strong>.';
    }
    textEl.innerHTML = msg;
}

// Load series for dropdown
function loadSeriesForWizard() {
    const cacheBuster = new Date().getTime();
    fetch(`/umbraco/surface/CompetitionAdmin/GetSeriesList?_=${cacheBuster}`)
        .then(response => response.json())
        .then(data => {
            if (data.success && data.data && data.data.length > 0) {
                const select = document.getElementById('wizard_seriesId');
                select.innerHTML = '<option value="">Ingen serie</option>';
                // On club pages, only show series belonging to this club
                const clubFilter = typeof window.currentClubId !== 'undefined' ? window.currentClubId : null;
                data.data
                    .filter(series => !clubFilter || series.clubId === clubFilter)
                    .forEach(series => {
                        const option = document.createElement('option');
                        option.value = series.id;
                        option.textContent = series.name;
                        select.appendChild(option);
                    });
            }
        })
        .catch(error => console.error('Error loading series:', error));
}

// Navigation: Next Step
function wizardNextStep() {
    if (!validateCurrentStep()) {
        return;
    }

    if (wizardCurrentStep < 6) {
        wizardCurrentStep++;
        updateWizardUI();
    }
}

// Navigation: Previous Step
function wizardPrevStep() {
    if (wizardCurrentStep > 0) {
        wizardCurrentStep--;
        updateWizardUI();
    }
}

// Update wizard UI based on current step
function updateWizardUI() {
    // Update step visibility
    document.querySelectorAll('.wizard-step').forEach((step, index) => {
        if (index === wizardCurrentStep) {
            step.classList.remove('d-none');
            // Auto-focus first input (skip on organizer step — focus Next button instead)
            if (wizardCurrentStep === 1) {
                setTimeout(() => document.getElementById('wizard_btnNext').focus(), 100);
            } else {
                const firstInput = step.querySelector('input:not([type="hidden"]), select, textarea');
                if (firstInput) {
                    setTimeout(() => firstInput.focus(), 100);
                }
            }
        } else {
            step.classList.add('d-none');
        }
    });

    // Apply type-specific series constraints when entering step 4 (Serier & Kontakt)
    if (wizardCurrentStep === 4) {
        applySeriesDefaults();
    }

    // Show/hide Egenbokning on step 6 based on competition type
    if (wizardCurrentStep === 6) {
        const selectedType = document.getElementById('wizard_competitionType').value;
        const dpExcluded = ['Springskytte', 'Faltskytte', 'MagnumFalt'];
        const dpAccordion = document.getElementById('wizardAccordionDirektplacering');
        if (dpAccordion) {
            dpAccordion.style.display = dpExcluded.includes(selectedType) ? 'none' : '';
        }
    }

    // Update progress dots
    document.querySelectorAll('.wizard-dot').forEach((dot, index) => {
        if (index <= wizardCurrentStep) {
            dot.classList.add('active');
        } else {
            dot.classList.remove('active');
        }
    });

    // Update step label
    const stepLabels = [
        'Steg 1 av 7: Tävlingstyp',
        'Steg 2 av 7: Arrangör',
        'Steg 3 av 7: Anmälan',
        document.getElementById('wizard_competitionType').value === 'Springskytte'
            ? 'Steg 4 av 7: Vapengrupper & Åldersklasser'
            : 'Steg 4 av 7: Skytteklasser',
        'Steg 5 av 7: Serier & Kontakt',
        'Steg 6 av 7: Betalningar',
        'Steg 7 av 7: Avancerat'
    ];
    document.getElementById('wizardStepLabel').textContent = stepLabels[wizardCurrentStep];

    // Update buttons
    const btnBack = document.getElementById('wizard_btnBack');
    const btnNext = document.getElementById('wizard_btnNext');
    const btnCreate = document.getElementById('wizard_btnCreate');

    // Back button: Show on all steps except first
    btnBack.style.display = wizardCurrentStep > 0 ? 'inline-block' : 'none';

    // Next/Create buttons based on step
    if (wizardCurrentStep < 6) {
        btnNext.style.display = 'inline-block';
        btnCreate.style.display = 'none';
    } else { // Step 6
        btnNext.style.display = 'none';
        btnCreate.style.display = 'inline-block';
    }
}

// Validate current step
function validateCurrentStep() {
    const currentStepEl = document.querySelector(`.wizard-step[data-step="${wizardCurrentStep}"]`);
    const requiredFields = currentStepEl.querySelectorAll('[required]');

    let isValid = true;
    requiredFields.forEach(field => {
        if (!field.value || field.value.trim() === '') {
            isValid = false;
            field.classList.add('is-invalid');
        } else {
            field.classList.remove('is-invalid');
        }
    });

    // Special validation for Step 3 (classes)
    if (wizardCurrentStep === 3) {
        const classIds = document.getElementById('wizard_shootingClassIds').value;
        if (!classIds || classIds.trim() === '') {
            const typeId = document.getElementById('wizard_competitionType').value;
            if (typeId === 'Springskytte') {
                alert('Välj minst en vapengrupp och minst en åldersklass');
            } else {
                alert('Vänligen välj minst en skytteklass');
            }
            return false;
        }
    }

    if (!isValid) {
        alert('Vänligen fyll i alla obligatoriska fält (markerade med *)');
    }

    return isValid;
}

// Class Selection Overlay
function openClassSelectionOverlay() {
    const overlay = document.getElementById('classSelectionOverlay');
    overlay.classList.add('active');

    // Filter sections based on competition type before restoring selections
    filterClassSections();

    // Restore current selections
    restoreClassSelections();
    updateOverlayClassCount();

    // Add ESC key handler for closing overlay
    document.addEventListener('keydown', handleOverlayEscKey);

    // Add backdrop click handler for desktop (click outside modal)
    overlay.addEventListener('click', handleOverlayBackdropClick);
}

function closeClassSelectionOverlay() {
    const overlay = document.getElementById('classSelectionOverlay');
    overlay.classList.remove('active');

    // Remove event listeners
    document.removeEventListener('keydown', handleOverlayEscKey);
    overlay.removeEventListener('click', handleOverlayBackdropClick);
}

// Handle ESC key to close overlay
function handleOverlayEscKey(e) {
    if (e.key === 'Escape') {
        closeClassSelectionOverlay();
    }
}

// Handle backdrop click (only on desktop - click outside the content area)
function handleOverlayBackdropClick(e) {
    // Only close if clicking the overlay itself (backdrop), not its children
    if (e.target.id === 'classSelectionOverlay') {
        closeClassSelectionOverlay();
    }
}

function restoreClassSelections() {
    const currentIds = document.getElementById('wizard_shootingClassIds').value;
    const selectedArray = currentIds ? currentIds.split(',') : [];

    document.querySelectorAll('.class-checkbox').forEach(checkbox => {
        checkbox.checked = selectedArray.includes(checkbox.value);
    });
}

function confirmClassSelection() {
    const selected = Array.from(document.querySelectorAll('.class-checkbox:checked'))
        .map(cb => cb.value);

    if (selected.length === 0) {
        alert('Välj minst en klass');
        return;
    }

    document.getElementById('wizard_shootingClassIds').value = selected.join(',');
    updateClassSelectionDisplay();
    closeClassSelectionOverlay();
}

function updateClassSelectionDisplay() {
    const classIds = document.getElementById('wizard_shootingClassIds').value;
    const selectedArray = classIds ? classIds.split(',') : [];

    if (selectedArray.length > 0) {
        document.getElementById('wizard_noClassesText').style.display = 'none';
        document.getElementById('wizard_selectedClassesDisplay').classList.remove('d-none');
        document.getElementById('wizard_classCount').textContent = selectedArray.length;
        document.getElementById('wizard_classList').textContent = selectedArray.join(', ');
        document.getElementById('wizard_selectClassesButtonText').textContent = 'Ändra val';
    } else {
        document.getElementById('wizard_noClassesText').style.display = 'block';
        document.getElementById('wizard_selectedClassesDisplay').classList.add('d-none');
        document.getElementById('wizard_selectClassesButtonText').textContent = 'Välj skytteklasser';
    }
}

function updateOverlayClassCount() {
    const selected = document.querySelectorAll('.class-checkbox:checked');
    const count = selected.length;
    const classList = Array.from(selected).map(cb => cb.value).join(', ');

    document.getElementById('overlay_classCount').textContent = count;
    document.getElementById('overlay_classList').textContent = classList || 'Inga klasser valda';

    const btnConfirm = document.getElementById('overlay_btnConfirm');
    if (count > 0) {
        btnConfirm.disabled = false;
        btnConfirm.classList.remove('btn-secondary');
        btnConfirm.classList.add('btn-primary');
    } else {
        btnConfirm.disabled = true;
        btnConfirm.classList.remove('btn-primary');
        btnConfirm.classList.add('btn-secondary');
    }
}

// Springskytte class selection: build weapon×age combinations and store in shootingClassIds
function springClassUpdateSelection() {
    const weapons = Array.from(document.querySelectorAll('.spring-weapon-cb:checked')).map(cb => cb.value);
    const ages = Array.from(document.querySelectorAll('.spring-age-cb:checked')).map(cb => cb.value);

    const combinations = [];
    weapons.forEach(w => ages.forEach(a => combinations.push(`${w}-${a}`)));

    document.getElementById('wizard_shootingClassIds').value = combinations.join(',');

    // Update summary
    const summaryDiv = document.getElementById('springClassSummary');
    const badgesDiv = document.getElementById('springClassSummaryBadges');
    if (combinations.length > 0) {
        summaryDiv.style.display = '';
        badgesDiv.innerHTML = combinations.map(c =>
            `<span class="badge bg-success px-2 py-1">${c}</span>`
        ).join('');
    } else {
        summaryDiv.style.display = 'none';
        badgesDiv.innerHTML = '';
    }

    // Update class A series visibility on step 5
    const hasA = weapons.includes('A');
    const classAGroup = document.getElementById('wizard_springskytteClassASeriesGroup');
    if (classAGroup) classAGroup.style.display = hasA ? '' : 'none';
}

function springClassToggleAll(checked) {
    document.querySelectorAll('.spring-age-cb').forEach(cb => { cb.checked = checked; });
    springClassUpdateSelection();
}

// Add event listeners to all class checkboxes
document.querySelectorAll('.class-checkbox').forEach(checkbox => {
    checkbox.addEventListener('change', updateOverlayClassCount);
});

// Swish-number format validation now lives in the shared partial _SwishNumberValidation.cshtml,
// included at the end of this file. It was moved because the edit modal calls it too, and the two
// partials are NOT always rendered together (CompetitionManagement includes only the edit modal).

function toggleClassSection(section) {
    const checkboxes = document.querySelectorAll(`.class-${section}`);
    const allChecked = Array.from(checkboxes).every(cb => cb.checked);

    checkboxes.forEach(cb => {
        cb.checked = !allChecked;
    });

    updateOverlayClassCount();
}

// Preset buttons for series
