}

// Submit wizard
function submitWizard() {
    // Validate all required steps (0-4)
    for (let i = 0; i <= 4; i++) {
        wizardCurrentStep = i;
        if (!validateCurrentStep()) {
            updateWizardUI();
            return;
        }
    }
    wizardCurrentStep = 6; // Restore to last step

    // "Pick at least one" — clubId OR regionalFederation OR competitionScope must be set.
    // Without any of them the URL provider can't produce a pretty URL (the competition
    // would render under the legacy /competitions/{series}/{comp}/ shape).
    const clubIdVal = (document.getElementById('wizard_clubId')?.value || '').trim();
    const regFedVal = (document.getElementById('wizard_regionalFederation')?.value || '').trim();
    const scopeVal = (document.getElementById('wizard_competitionScope')?.value || '').trim();
    const hasClub = clubIdVal !== '' && parseInt(clubIdVal, 10) > 0;
    if (!hasClub && !regFedVal && !scopeVal) {
        // Jump back to Step 1 where the Klubb/Krets fields live, then alert.
        wizardCurrentStep = 1;
        updateWizardUI();
        alert('Välj antingen ansvarig klubb, krets eller mästerskapstyp (Avancerat-steget) — annars går det inte att skapa en lättläst URL för tävlingen.');
        return;
    }

    // Delad fältinsamling (_CompetitionFormSave) — samma slinga som redigeringsmodalerna.
    // Listan här motsvarar exakt guidens sju kryssrutor.
    //
    // ⚠️ extractSeriesId sätts MEDVETET INTE. Guiden ska skicka seriesId KVAR i
    // payloaden — det är så CreateCompetition skapar tävlingen som BARN till serien.
    // Redigeringsmodalerna plockar tvärtom ut den (serien sätts via Move efter sparning).
    //
    // Guidens VALIDERING delas inte: den har egen stegvalidering som byter till rätt STEG,
    // vilket redan löser det flikbytet löser i modalerna.
    const WIZARD_BOOLS = ['allowDualCClass', 'showLiveResults', 'isClubOnly',
                          'allowSelfReporting', 'isAwardingStandardMedals',
                          'allowTeams', 'allowStafett'];
    const fields = hpskCollectCompetitionFields(
        document.getElementById('competitionWizardForm'),
        { boolKeys: WIZARD_BOOLS, forceFalseKeys: WIZARD_BOOLS }
    ).fields;

    // Team result series count: empty = auto (send 0 so the int property stores cleanly)
    if (!('teamResultSeriesCount' in fields) || String(fields.teamResultSeriesCount).trim() === '') {
        fields.teamResultSeriesCount = 0;
    } else {
        fields.teamResultSeriesCount = parseInt(fields.teamResultSeriesCount, 10) || 0;
    }

    // Competition type
    const typeSelect = document.getElementById('wizard_competitionType');
    fields.competitionType = typeSelect.value || 'Precision';

    // Add defaults
    fields.isActive = true;

    // Use actual dropdown values (user may have changed them)
    // For disabled dropdowns, FormData won't include them, so read directly
    const clubSelect = document.getElementById('wizard_clubId');
    const regionSelect = document.getElementById('wizard_regionalFederation');
    fields.clubId = clubSelect.value || '';
    fields.regionalFederation = regionSelect.value || '';

    // Add Fältskytte-specific fields
    const isFaltType = (fields.competitionType === 'Faltskytte' || fields.competitionType === 'MagnumFalt');
    if (isFaltType) {
        fields.scoringMode = document.getElementById('wizard_scoringMode').value;
        fields.stationConfig = document.getElementById('wizard_faltStationConfigJson').value || '{}';
        fields.maxReshoots = document.getElementById('wizard_maxReshoots').value;
        var rsEnabled = document.getElementById('wizard_rollingStart').checked;
        fields.rollingStart = rsEnabled ? JSON.stringify({ enabled: true, patrolSize: parseInt(document.getElementById('wizard_patrolSize').value) || 2 }) : '';
        var ssEl = document.getElementById('wizard_faltskytteSelfServiceResults');
        fields.faltskytteSelfServiceResults = !!(ssEl && ssEl.checked);
    }

    // Add Direktplacering config
    if (document.getElementById('wizard_enableDirektplacering').checked) {
        fields.direktplaceringConfig = JSON.stringify(collectDirektplaceringConfig());
    }

    const requestBody = { fields: fields };

    // Show loading state
    const btnCreate = document.getElementById('wizard_btnCreate');
    const originalText = btnCreate.innerHTML;
    btnCreate.disabled = true;
    btnCreate.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skapar...';

    // Submit to backend
    fetch('/umbraco/surface/CompetitionAdmin/CreateCompetition', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: JSON.stringify(requestBody)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Reset button state BEFORE closing modal
            btnCreate.disabled = false;
            btnCreate.innerHTML = originalText;

            // Close wizard
            const modal = bootstrap.Modal.getInstance(document.getElementById('competitionWizardModal'));
            modal.hide();

            // Reload competitions list
            if (typeof reloadCompetitionsList === 'function') {
                reloadCompetitionsList();
            }

            // Call onCompetitionSaved callback if set (for club pages)
            if (typeof window.onCompetitionSaved === 'function') {
                window.onCompetitionSaved();
            }

            // Show success message naming WHERE the competition landed, so a user who
            // mis-scoped it (e.g. picked a krets/national instead of their club) knows
            // where to look instead of reporting "I can't find it".
            const _cName = (clubIdVal && clubSelect.selectedIndex >= 0) ? clubSelect.options[clubSelect.selectedIndex].textContent : '';
            const _rName = (regFedVal && regionSelect.selectedIndex >= 0) ? regionSelect.options[regionSelect.selectedIndex].textContent : '';
            const _clubOnly = document.getElementById('wizard_isClubOnly')?.checked || false;
            let _where;
            if (clubIdVal) {
                _where = _clubOnly
                    ? 'Den visas endast för ' + _cName + 's medlemmar och hanteras på ' + _cName + 's administrationssida.'
                    : 'Den hanteras på ' + _cName + 's administrationssida och syns i kretsens inbjudningslista.';
            } else if (regFedVal) {
                _where = 'Den ligger på kretsens (' + _rName + ') regionsida — inte under någon klubb.';
            } else {
                _where = 'Den är nationell och hanteras via den allmänna administrationssidan.';
            }
            alert('Tävling skapad!\n\n' + _where);
        } else {
            alert('Fel vid skapande av tävling: ' + (data.message || 'Okänt fel'));
            btnCreate.disabled = false;
            btnCreate.innerHTML = originalText;
        }
    })
    .catch(error => {
        console.error('Error creating competition:', error);
        alert('Fel vid skapande av tävling: ' + error.message);
        btnCreate.disabled = false;
        btnCreate.innerHTML = originalText;
    });
}

// Reset wizard to initial state
window.resetWizard = function() {
    // Reset button state
    const btnCreate = document.getElementById('wizard_btnCreate');
    if (btnCreate) {
        btnCreate.disabled = false;
        btnCreate.innerHTML = '<i class="bi bi-check-circle me-1"></i>Skapa tävling';
    }

    // Reset to step 0
    wizardCurrentStep = 0;

    // Clear the form
    const form = document.getElementById('competitionWizardForm');
    if (form) {
        form.reset();
    }

    // Clear shooting class selection
    document.getElementById('wizard_shootingClassIds').value = '';
    updateClassSelectionDisplay();

    // Uncheck all class checkboxes
    document.querySelectorAll('.class-checkbox').forEach(checkbox => {
        checkbox.checked = false;
    });
    updateOverlayClassCount();

    // Clear Springskytte class selections and reset series
    document.querySelectorAll('.spring-weapon-cb, .spring-age-cb').forEach(cb => { cb.checked = false; });
    document.getElementById('springClassSummary').style.display = 'none';
    document.getElementById('springClassSummaryBadges').innerHTML = '';
    document.getElementById('wizard_standardClassSelection').style.display = '';
    document.getElementById('wizard_springskytteClassSelection').style.display = 'none';
    document.getElementById('wizard_standardSeriesSection').style.display = '';
    document.getElementById('wizard_springskytteSeriesSection').style.display = 'none';
    document.getElementById('wizard_springskytteClassASeries').value = '2';
    document.getElementById('wizard_dualCClassGroup').style.display = '';
    document.getElementById('wizard_selfReportingGroup').style.display = '';

    // Remove validation errors
    document.querySelectorAll('.is-invalid').forEach(field => {
        field.classList.remove('is-invalid');
    });

    // Re-detect context (club page vs admin page)
    detectContext();

    // Reset dropdowns to enabled state (will be disabled again if on club page)
    document.getElementById('wizard_clubId').disabled = false;
    document.getElementById('wizard_regionalFederation').disabled = false;

    // Reset locked info banner and mismatch warning
    const lockedInfo = document.getElementById('wizard_clubLockedInfo');
    if (lockedInfo) lockedInfo.classList.add('d-none');
    const mismatchWarning = document.getElementById('wizard_clubMismatchWarning');
    if (mismatchWarning) mismatchWarning.classList.add('d-none');
    const helpText = document.getElementById('wizard_organizerHelpText');
    if (helpText) {
        helpText.classList.remove('d-none');
        helpText.classList.add('alert-info');
        helpText.innerHTML = '<i class="bi bi-geo-alt me-1"></i><strong>Var hamnar tävlingen?</strong>' +
            '<span id="wizard_destinationText" class="d-block mt-1">Välj klubb eller krets ovan.</span>';
    }

    // Auto-check "isClubOnly" checkbox if on club page
    if (wizardContext.isClubPage) {
        document.getElementById('wizard_isClubOnly').checked = true;
    }
    onWizardIsClubOnlyChange();
    // Disable the checkbox when no club is selected (e.g. region-hosted or national comp).
    syncWizardClubOnlyAvailability();

    // Reset the shooting-range picker (clear selection, wire search, load the club's ranges).
    if (typeof compRangeInit === 'function') compRangeInit('wizard_', { clubId: document.getElementById('wizard_clubId')?.value });

    // Reset Egenbokning section
    document.getElementById('wizard_enableDirektplacering').checked = false;
    document.getElementById('direktplaceringConfigSection').style.display = 'none';
    document.getElementById('direktplaceringTeamList').innerHTML = '';
    document.getElementById('wizard_allowMixedClasses').checked = true;
    dpTeamCounter = 0;

    // Re-initialize date pickers with defaults
    initializeWizardDatePickers();

    // Update UI to show step 0
    updateWizardUI();

    console.log('Wizard reset to initial state');
};

// ============================================================================
// Direktplacering Team Configurator
// ============================================================================

let dpTeamCounter = 0;

function toggleDirektplaceringConfig() {
    const section = document.getElementById('direktplaceringConfigSection');
    const enabled = document.getElementById('wizard_enableDirektplacering').checked;
    section.style.display = enabled ? 'block' : 'none';
    if (enabled && dpTeamCounter === 0) {
        addDirektplaceringTeam(); // Add first team automatically
    }
}

function addDirektplaceringTeam() {
    dpTeamCounter++;
    const teamNum = dpTeamCounter;
    const container = document.getElementById('direktplaceringTeamList');

    // Auto-calculate start time from previous team's end time
    let defaultStart = '09:00';
    let defaultEnd = '11:00';
    const existingCards = container.querySelectorAll('.dp-team-card');
    if (existingCards.length > 0) {
        const lastCard = existingCards[existingCards.length - 1];
        const lastEnd = lastCard.querySelector('.dp-end-time')?.value;
        if (lastEnd) {
            defaultStart = lastEnd;
            // Add 2 hours for default end time
            const parts = lastEnd.split(':');
            const h = parseInt(parts[0]) + 2;
            defaultEnd = `${String(h).padStart(2, '0')}:${parts[1]}`;
        }
    }

    const card = document.createElement('div');
    card.className = 'card mb-2 dp-team-card';
    card.dataset.teamNumber = teamNum;
    card.innerHTML = `
        <div class="card-body py-2 px-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong class="dp-team-header">Skjutlag: ${teamNum} - Tid: ${defaultStart}-${defaultEnd} (30 st)</strong>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeDirektplaceringTeam(this)">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small mb-0">Starttid</label>
                    <input type="text" class="form-control form-control-sm dp-start-time" value="${defaultStart}" placeholder="09:00">
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">Sluttid</label>
                    <input type="text" class="form-control form-control-sm dp-end-time" value="${defaultEnd}" placeholder="11:00">
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">Antal platser</label>
                    <input type="number" class="form-control form-control-sm dp-positions" value="30" min="1">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Plats</label>
                    <input type="text" class="form-control form-control-sm dp-label" placeholder="T.ex. Hall 1">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Vapengrupper</label>
                    <select class="form-select form-select-sm dp-weapon-classes" ${document.getElementById('wizard_allowMixedClasses').checked ? 'multiple' : ''} form="dp-no-form">
                        <option value="A">A</option>
                        <option value="A_Opt">A Opt</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="R">R</option>
                        <option value="L">L</option>
                        <option value="M">M</option>
                    </select>
                    <small class="form-text text-muted" style="font-size:0.7rem;">Ingen markerad = alla</small>
                </div>
            </div>
        </div>
    `;
    container.appendChild(card);

    // Initialize Flatpickr time pickers
    const startInput = card.querySelector('.dp-start-time');
    const endInput = card.querySelector('.dp-end-time');
    flatpickr(startInput, { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, static: true, defaultDate: defaultStart });
    flatpickr(endInput, { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, static: true, defaultDate: defaultEnd });

    // Add change listeners for live header update
    [startInput, endInput, card.querySelector('.dp-positions'), card.querySelector('.dp-label')].forEach(input => {
        input.addEventListener('change', () => updateDpTeamHeader(card));
        input.addEventListener('input', () => updateDpTeamHeader(card));
    });
}

function removeDirektplaceringTeam(btn) {
    const card = btn.closest('.dp-team-card');
    card.remove();
    renumberDpTeams();
}

function renumberDpTeams() {
    const cards = document.querySelectorAll('#direktplaceringTeamList .dp-team-card');
    cards.forEach((card, idx) => {
        card.dataset.teamNumber = idx + 1;
        updateDpTeamHeader(card);
    });
    dpTeamCounter = cards.length;
}

function updateDpTeamHeader(card) {
    const teamNum = card.dataset.teamNumber;
    const start = card.querySelector('.dp-start-time')?.value || '??:??';
    const end = card.querySelector('.dp-end-time')?.value || '??:??';
    const positions = card.querySelector('.dp-positions')?.value || '?';
    const label = card.querySelector('.dp-label')?.value || '';
    const labelSuffix = label ? ` - ${label}` : '';
    const header = card.querySelector('.dp-team-header');
    if (header) {
        header.textContent = `Skjutlag: ${teamNum} - Tid: ${start}-${end} (${positions} st)${labelSuffix}`;
    }
}

function onWizardMixedClassesChanged() {
    const allowMultiple = document.getElementById('wizard_allowMixedClasses').checked;
    document.querySelectorAll('#direktplaceringTeamList .dp-weapon-classes').forEach(select => {
        const selected = Array.from(select.selectedOptions).map(o => o.value);
        select.multiple = allowMultiple;
        if (!allowMultiple && selected.length > 1) {
            Array.from(select.options).forEach(o => o.selected = (o.value === selected[0]));
        }
    });
}

function collectDirektplaceringConfig() {
    const teams = [];
    document.querySelectorAll('#direktplaceringTeamList .dp-team-card').forEach((card, idx) => {
        const selectedClasses = Array.from(card.querySelector('.dp-weapon-classes').selectedOptions).map(o => o.value);
        teams.push({
            teamNumber: idx + 1,
            startTime: card.querySelector('.dp-start-time')?.value || '',
            endTime: card.querySelector('.dp-end-time')?.value || '',
            positions: parseInt(card.querySelector('.dp-positions')?.value) || 30,
            label: card.querySelector('.dp-label')?.value || '',
            allowedWeaponClasses: selectedClasses
        });
    });
    return {
        enabled: true,
        allowMixedClasses: document.getElementById('wizard_allowMixedClasses').checked,
        teams: teams
    };
}
</script>

