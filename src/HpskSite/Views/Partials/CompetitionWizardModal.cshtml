@*
 * Competition Creation Wizard Modal
 * 6-step wizard for creating competitions
 * Mobile-optimized with context-aware behavior
*@

<!-- Competition Wizard Modal -->
<div class="modal fade" id="competitionWizardModal" tabindex="-1" aria-labelledby="wizardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <!-- Modal Header -->
            <div class="modal-header">
                <h5 class="modal-title" id="wizardModalLabel">
                    <i class="bi bi-plus-circle me-2"></i>Skapa Ny Tävling
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>

            <!-- Progress Indicator -->
            <div class="wizard-progress p-3" style="background-color: var(--bs-tertiary-bg);">
                <div class="d-flex justify-content-center align-items-center">
                    <span class="wizard-dot" data-step="0"></span>
                    <span class="wizard-line"></span>
                    <span class="wizard-dot" data-step="1"></span>
                    <span class="wizard-line"></span>
                    <span class="wizard-dot" data-step="2"></span>
                    <span class="wizard-line"></span>
                    <span class="wizard-dot" data-step="3"></span>
                    <span class="wizard-line"></span>
                    <span class="wizard-dot" data-step="4"></span>
                    <span class="wizard-line"></span>
                    <span class="wizard-dot" data-step="5"></span>
                    <span class="wizard-line"></span>
                    <span class="wizard-dot" data-step="6"></span>
                </div>
                <div class="text-center mt-2">
                    <small id="wizardStepLabel" class="text-muted"></small>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="modal-body">
                <form id="competitionWizardForm">

                    <!-- Step 0: Tävlingstyp & Grunduppgifter -->
                    <div class="wizard-step" data-step="0">
                        <h6 class="mb-3 text-primary"><i class="bi bi-trophy me-1"></i>Tävlingstyp & Grunduppgifter</h6>

                        <div class="mb-3">
                            <label for="wizard_competitionType" class="form-label">Tävlingstyp <span class="text-danger">*</span></label>
                            <select class="form-select" id="wizard_competitionType" name="competitionType" required onchange="onCompetitionTypeChange()">
                                <option value="Precision" selected>Precision</option>
                                <option value="Milsnabb">Milsnabb</option>
                                <option value="Duell">Duell</option>
                                <option value="NationellHelmatch">Nationell Helmatch</option>
                                <option value="Springskytte">Springskytte</option>
                                <option value="Faltskytte">Fältskytte</option>
                                <option value="MagnumPrecision">Magnum Precision</option>
                                <option value="MagnumFalt">Magnum Fältskytte</option>
                                <option value="Standardpistol">Standardpistol</option>
                                <option value="Sportpistol">Sportpistol</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="wizard_competitionName" class="form-label">Tävlingsnamn <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="wizard_competitionName" name="competitionName" required>
                        </div>

                        <div class="mb-3">
                            <label for="wizard_competitionDate" class="form-label">Tävlingsdatum <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="wizard_competitionDate" name="competitionDate" required>
                        </div>

                    </div>

                    <!-- Step 1: Arrangör / Synlighet -->
                    <div class="wizard-step d-none" data-step="1">
                        <h6 class="mb-3 text-primary"><i class="bi bi-building me-1"></i>Arrangör / Synlighet</h6>

                        <p class="text-muted small mb-3">
                            Välj <strong>klubb</strong> om tävlingen arrangeras av en specifik klubb.
                            Välj <strong>krets</strong> om tävlingen arrangeras av en krets (t.ex. Hemmabana).
                            Lämna båda tomma för nationella tävlingar som ska synas överallt.
                        </p>

                        <div class="alert alert-info d-none" id="wizard_clubLockedInfo">
                            <i class="bi bi-lock me-1"></i>
                            Tävlingen skapas för <strong id="wizard_clubLockedName"></strong>.
                            Arrangören kan inte ändras härifrån.
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="wizard_clubId" class="form-label">Ansvarig klubb <span class="text-danger">*</span></label>
                                    <select class="form-select" id="wizard_clubId" name="clubId" onchange="onWizardClubChange()">
                                        <option value="">-- Ingen klubb --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="wizard_regionalFederation" class="form-label">Krets (endast om ingen klubb) <span class="text-danger">*</span></label>
                                    <select class="form-select" id="wizard_regionalFederation" name="regionalFederation" onchange="onWizardRegionChange()">
                                        <option value="">-- Ingen krets --</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-text text-muted small mb-3" style="margin-top:-0.5rem">
                            Välj minst ett av: klubb, krets eller mästerskapstyp (Avancerat-steget). Behövs för att tävlingen ska få en lättläst URL.
                        </div>

                        <div class="alert alert-warning py-2 d-none" id="wizard_clubMismatchWarning">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <span id="wizard_clubMismatchText"></span>
                        </div>

                        <div class="mb-3 form-check mt-3">
                            <input type="checkbox" class="form-check-input" id="wizard_isClubOnly" name="isClubOnly" onchange="onWizardIsClubOnlyChange()">
                            <label class="form-check-label" for="wizard_isClubOnly">
                                Endast för vald klubb
                            </label>
                            <small class="form-text text-muted d-block">Tävlingen visas bara för den valda klubbens medlemmar</small>
                        </div>

                        <div class="alert alert-info py-2 mb-0" id="wizard_organizerHelpText">
                            <i class="bi bi-geo-alt me-1"></i><strong>Var hamnar tävlingen?</strong>
                            <span id="wizard_destinationText" class="d-block mt-1">Välj klubb eller krets ovan.</span>
                        </div>
                    </div>

                    <!-- Step 2: Anmälan & Beskrivning -->
                    <div class="wizard-step d-none" data-step="2">
                        <h6 class="mb-3 text-primary"><i class="bi bi-calendar-check me-1"></i>Anmälan & Beskrivning</h6>

                        <div class="mb-3">
                            <label for="wizard_venue" class="form-label">Plats <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="wizard_venue" name="venue" required>
                        </div>

                        @* Optional link to a shooting range in the Skjutbanedatabas — club list / search / map *@
                        @await Html.PartialAsync("_CompetitionRangePicker", "wizard_")

                        <div class="mb-3">
                            <label for="wizard_registrationOpenDate" class="form-label">Anmälan öppnar <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="wizard_registrationOpenDate" name="registrationOpenDate" required>
                            <small class="form-text text-muted">Förslag baserat på dagens datum och tid</small>
                        </div>

                        <div class="mb-3">
                            <label for="wizard_registrationCloseDate" class="form-label">Anmälan stänger <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="wizard_registrationCloseDate" name="registrationCloseDate" required>
                            <small class="form-text text-muted">Förslag baserat på tävlingsdatum</small>
                        </div>

                        <div class="mb-3">
                            <label for="wizard_description" class="form-label">Beskrivning (valfritt)</label>
                            <textarea class="form-control" id="wizard_description" name="description" rows="3"></textarea>
                        </div>
                    </div>

                    <!-- Step 3: Skytteklasser -->
                    <div class="wizard-step d-none" data-step="3">
                        <!-- Standard shooting class selection (non-Springskytte) -->
                        <div id="wizard_standardClassSelection">
                            <h6 class="mb-3 text-primary"><i class="bi bi-bullseye me-1"></i>Skytteklasser</h6>

                            <div class="mb-3">
                                <label class="form-label">Vilka klasser ska tävlingen ha? <span class="text-danger">*</span></label>

                                <!-- Class Selection Display -->
                                <div class="card" id="wizard_classSelectionCard">
                                    <div class="card-body text-center">
                                        <p class="text-muted mb-3" id="wizard_noClassesText">Inga klasser valda ännu</p>
                                        <div class="d-none" id="wizard_selectedClassesDisplay">
                                            <p class="mb-2"><strong>Valda klasser: <span id="wizard_classCount">0</span></strong></p>
                                            <p class="mb-3" id="wizard_classList"></p>
                                        </div>
                                        <button type="button" class="btn btn-primary" onclick="openClassSelectionOverlay()">
                                            <i class="bi bi-ui-checks me-1"></i><span id="wizard_selectClassesButtonText">Välj skytteklasser</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Springskytte class selection -->
                        <div id="wizard_springskytteClassSelection" style="display: none;">
                            <h6 class="mb-3 text-primary"><i class="bi bi-bullseye me-1"></i>Vapengrupper & Åldersklasser</h6>

                            <!-- Weapon Classes -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Vapengrupper <span class="text-danger">*</span></label>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input spring-weapon-cb" type="checkbox" value="A" id="springWeapon_A" onchange="springClassUpdateSelection()">
                                        <label class="form-check-label" for="springWeapon_A">
                                            <span class="badge bg-primary fs-6 px-3 py-2">A</span>
                                            <small class="d-block text-muted mt-1">Tavla (ring 1-4)</small>
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input spring-weapon-cb" type="checkbox" value="C" id="springWeapon_C" onchange="springClassUpdateSelection()">
                                        <label class="form-check-label" for="springWeapon_C">
                                            <span class="badge bg-primary fs-6 px-3 py-2">C</span>
                                            <small class="d-block text-muted mt-1">Fallmål</small>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Age/Gender Classes -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Ålders-/könsklasser <span class="text-danger">*</span></label>
                                <div class="mb-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="springClassToggleAll(true)">Välj alla</button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="springClassToggleAll(false)">Avmarkera alla</button>
                                </div>

                                <div class="card">
                                    <div class="card-body py-2">
                                        <small class="text-muted fw-bold">Junior</small>
                                        <div class="row g-1 mb-2">
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 15" id="springAge_D15" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D15">D 15 <small class="text-muted">(–15 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 15" id="springAge_H15" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H15">H 15 <small class="text-muted">(–15 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 18" id="springAge_D18" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D18">D 18 <small class="text-muted">(16–18 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 18" id="springAge_H18" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H18">H 18 <small class="text-muted">(16–18 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D jun" id="springAge_Djun" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_Djun">D jun <small class="text-muted">(15–20 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H jun" id="springAge_Hjun" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_Hjun">H jun <small class="text-muted">(15–20 år)</small></label></div></div>
                                        </div>

                                        <small class="text-muted fw-bold">Senior</small>
                                        <div class="row g-1 mb-2">
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 21" id="springAge_D21" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D21">D 21 <small class="text-muted">(21–34 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 21" id="springAge_H21" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H21">H 21 <small class="text-muted">(21–34 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 35" id="springAge_D35" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D35">D 35 <small class="text-muted">(35–49 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 35" id="springAge_H35" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H35">H 35 <small class="text-muted">(35–49 år)</small></label></div></div>
                                        </div>

                                        <small class="text-muted fw-bold">Veteran</small>
                                        <div class="row g-1">
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 50" id="springAge_D50" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D50">D 50 <small class="text-muted">(50–59 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 50" id="springAge_H50" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H50">H 50 <small class="text-muted">(50–59 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 60" id="springAge_D60" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D60">D 60 <small class="text-muted">(60–64 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 60" id="springAge_H60" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H60">H 60 <small class="text-muted">(60–64 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 65" id="springAge_D65" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D65">D 65 <small class="text-muted">(65–69 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 65" id="springAge_H65" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H65">H 65 <small class="text-muted">(65–69 år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="D 70" id="springAge_D70" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_D70">D 70 <small class="text-muted">(70+ år)</small></label></div></div>
                                            <div class="col-6"><div class="form-check"><input class="form-check-input spring-age-cb" type="checkbox" value="H 70" id="springAge_H70" onchange="springClassUpdateSelection()"><label class="form-check-label" for="springAge_H70">H 70 <small class="text-muted">(70+ år)</small></label></div></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Summary -->
                            <div id="springClassSummary" class="mb-3" style="display: none;">
                                <label class="form-label fw-bold">Valda klasser:</label>
                                <div id="springClassSummaryBadges" class="d-flex flex-wrap gap-1"></div>
                            </div>
                        </div>

                        <!-- Hidden input to store selected classes -->
                        <input type="hidden" id="wizard_shootingClassIds" name="shootingClassIds">
                    </div>

                    <!-- Step 4: Serier & Kontakt -->
                    <div class="wizard-step d-none" data-step="4">
                        <h6 class="mb-3 text-primary"><i class="bi bi-list-ol me-1"></i>Serier & Kontakt</h6>

                        <!-- Standard series selection (non-Springskytte) -->
                        <div id="wizard_standardSeriesSection">
                            <div class="mb-3" id="wizard_seriesGroup">
                                <label for="wizard_numberOfSeries" class="form-label">Antal serier/stationer <span class="text-danger">*</span></label>
                                <div class="btn-group mb-2" role="group" id="wizard_seriesButtons">
                                    <button type="button" class="btn btn-outline-primary" onclick="setSeriesCount(6)">6</button>
                                    <button type="button" class="btn btn-outline-primary" onclick="setSeriesCount(7)">7</button>
                                    <button type="button" class="btn btn-outline-primary" onclick="setSeriesCount(10)">10</button>
                                </div>
                                <input type="number" class="form-control" id="wizard_numberOfSeries" name="numberOfSeriesOrStations" min="1" max="50" value="6" required>
                            </div>

                            <div class="mb-3" id="wizard_finalsGroup">
                                <label for="wizard_finalSeries" class="form-label">Varav finalserier</label>
                                <div class="btn-group mb-2" role="group">
                                    <button type="button" class="btn btn-outline-secondary" onclick="setFinalSeries(0)">0</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="setFinalSeries(3)">3</button>
                                </div>
                                <input type="number" class="form-control" id="wizard_finalSeries" name="numberOfFinalSeries" min="0" max="10" value="0">
                            </div>

                            <div class="alert alert-info d-none" id="wizard_milsnabbSeriesNote">
                                <i class="bi bi-info-circle me-1"></i>
                                Milsnabb och Nationell Helmatch har alltid 12 serier (3 grupper om 4 serier) och inga finalserier.
                            </div>
                        </div>

                        <!-- Springskytte series section -->
                        <div id="wizard_springskytteSeriesSection" style="display: none;">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Klass C – Stationer (fallmål)</label>
                                <p class="text-muted mb-1">Klass C har alltid 6 stationer.</p>
                                <input type="number" class="form-control" value="6" disabled style="max-width: 100px;">
                            </div>

                            <div class="mb-3" id="wizard_springskytteClassASeriesGroup" style="display: none;">
                                <label for="wizard_springskytteClassASeries" class="form-label fw-bold">Klass A – Antal serier (tavla)</label>
                                <p class="text-muted mb-1">Välj antal serier för klass A (1–6).</p>
                                <select class="form-select" id="wizard_springskytteClassASeries" style="max-width: 100px;" onchange="springSeriesChanged()">
                                    <option value="1">1</option>
                                    <option value="2" selected>2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                    <option value="5">5</option>
                                    <option value="6">6</option>
                                </select>
                            </div>
                        </div>

                        <!-- Fältskytte station config section -->
                        <div id="wizard_faltskytteSection" style="display: none;">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Tävlingstyp</label>
                                <div class="d-flex align-items-center gap-2">
                                    <input type="hidden" id="wizard_scoringMode" value="Normal" onchange="faltUpdateScoringModeDisplay('wizard_')">
                                    <span id="wizard_scoringMode_display" class="badge bg-info text-dark fs-6">Normal</span>
                                </div>
                                <div class="form-text small">Sätts från den anslutna stationskonfigurationen. Ändra via <em>Fältkonfiguratorn</em> på den aktuella konfigurationen.</div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-auto">
                                    <label for="wizard_maxReshoots" class="form-label fw-bold">Max omskjutningar</label>
                                    <input type="number" class="form-control" id="wizard_maxReshoots" min="0" max="10" value="2" style="max-width: 100px;">
                                </div>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="wizard_rollingStart" onchange="document.getElementById('wizard_rollingStartSettings').style.display = this.checked ? '' : 'none'">
                                <label class="form-check-label fw-bold" for="wizard_rollingStart">Rullande start</label>
                                <div class="form-text small mt-1">Anmälan och patrulltilldelning sker på plats vid tävlingen. Patruller skapas automatiskt allt eftersom skyttar anmäls. Används typiskt vid banfält och klubbtävlingar med drop-in.</div>
                            </div>
                            <div id="wizard_rollingStartSettings" style="display:none" class="ms-4 mb-3">
                                <label for="wizard_patrolSize" class="form-label small">Patrullstorlek</label>
                                <input type="number" class="form-control form-control-sm" id="wizard_patrolSize" min="2" max="12" value="2" style="max-width: 80px;">
                                <div class="form-text small">Antal skyttar per patrull. Ny patrull skapas automatiskt när föregående är full.</div>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="wizard_faltskytteSelfServiceResults">
                                <label class="form-check-label fw-bold" for="wizard_faltskytteSelfServiceResults">Tillåt skyttar i laget att fylla i resultat (självservice)</label>
                                <div class="form-text small mt-1">
                                    Lämpligt för mindre tävlingar utan stationschefer. Skyttar i en patrull kan logga in och
                                    fylla i resultat för sin egen patrull. Funktionärer har alltid full åtkomst.
                                </div>
                            </div>

                            @await Html.PartialAsync("_FaltskytteCompetitionPicker", "wizard_")
                        </div>

                        <hr class="my-4">

                        <div class="mb-3">
                            <label for="wizard_competitionDirector" class="form-label">Tävlingsledare <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="wizard_competitionDirector" name="competitionDirector" required>
                        </div>

                        <div class="mb-3">
                            <label for="wizard_contactEmail" class="form-label">Kontakt e-post <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="wizard_contactEmail" name="contactEmail" required>
                        </div>

                        <div class="mb-3">
                            <label for="wizard_contactPhone" class="form-label">Kontakt telefon</label>
                            <input type="tel" class="form-control" id="wizard_contactPhone" name="contactPhone">
                        </div>
                    </div>

