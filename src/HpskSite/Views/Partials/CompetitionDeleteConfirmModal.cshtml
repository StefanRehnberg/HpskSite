@*
 * Competition Delete Confirmation Modal
 * Modal for confirming deletion of a competition
*@

<div class="modal fade" id="competitionDeleteConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger bg-opacity-10">
                <h5 class="modal-title text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>Ta bort tävlingen
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="mb-3">
                    Vill du ta bort tävlingen
                </p>
                <p class="text-danger fw-bold ms-3 mb-4">
                    <span id="deleteCompetitionName">-</span>
                </p>

                <div class="alert alert-warning mb-3" role="alert">
                    <small>
                        <i class="bi bi-info-circle me-1"></i>
                        Tävlingen läggs i papperskorgen och kan läggas tillbaka av en sajtadministratör.
                        Den går inte att ta bort så länge den har anmälningar, lag, resultat, avgifter eller
                        funktionärer.
                    </small>
                </div>

                <!-- Error Alert (if deletion fails due to registrations) -->
                <div class="alert alert-danger d-none" id="deleteErrorAlert" role="alert">
                    <strong>Tävlingen kan inte tas bort</strong>
                    <p id="deleteErrorMessage" class="mb-0 mt-2 small"></p>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteCompetition()">
                    <i class="bi bi-trash me-1"></i>Ta bort
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function confirmDeleteCompetition() {
    const competitionId = window.deleteCompetitionId;

    if (!competitionId) {
        alert('Ingen tävling vald.');
        return;
    }

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const button = event.target;
    const deleteErrorAlert = document.getElementById('deleteErrorAlert');
    const deleteErrorMessage = document.getElementById('deleteErrorMessage');

    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Tar bort…';
    deleteErrorAlert.classList.add('d-none');

    const payload = {
        competitionId: competitionId
    };

    fetch('/umbraco/surface/CompetitionAdmin/DeleteCompetition', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        credentials: 'include',
        body: JSON.stringify(payload)
    })
        .then(response => response.json())
        .then(data => {
            button.disabled = false;
            button.innerHTML = '<i class="bi bi-trash me-1"></i>Ta bort';

            if (data.success) {
                alert(data.message || 'Tävlingen ligger nu i papperskorgen.');
                bootstrap.Modal.getInstance(document.getElementById('competitionDeleteConfirmModal')).hide();

                // OPTIMIZED: Remove from table instead of full reload
                if (typeof window.removeCompetitionFromTable === 'function') {
                    window.removeCompetitionFromTable(window.deleteCompetitionId);
                } else {
                    window.reloadCompetitionsList();
                }
            } else {
                // Show error message
                deleteErrorMessage.textContent = data.message || 'Tävlingen kunde inte tas bort.';
                deleteErrorAlert.classList.remove('d-none');
            }
        })
        .catch(error => {
            button.disabled = false;
            button.innerHTML = '<i class="bi bi-trash me-1"></i>Ta bort';
            deleteErrorMessage.textContent = error.message || 'Kontakten med servern bröts. Försök igen.';
            deleteErrorAlert.classList.remove('d-none');
        });
}
</script>
