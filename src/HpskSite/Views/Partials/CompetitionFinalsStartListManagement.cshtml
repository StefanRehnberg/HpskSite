@using Umbraco.Cms.Core.Models.PublishedContent
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var competitionId = ViewData["CompetitionId"] as int? ?? 0;
}

@* Publiceringstillstandet: EN form och ETT ordpar over Resultat, Startlistor och
   Finalstartlistor. Inkluderas av partialen sjalv, samma husregel som _HtmlEscape. *@
@await Html.PartialAsync("_PublishState")

@*
    FINALSTARTLISTOR — EN PER VAPENGRUPP (omarbetad 2026-09-08)

    ⚠️ En vapengrupps final är EN skjutsession: eget datum, egen starttid, egen publicering.
    På SSM 2026 skjuts C med final på lördagseftermiddagen, A med final på söndag förmiddag
    och B på söndag eftermiddag. Med EN lista för hela tävlingen gick det inte att ha C:s
    lista publicerad medan A:s var ett utkast, och varje omgenerering nollade
    publiceringsflaggan — så att lägga till A på söndagen AVPUBLICERADE C:s lista tyst.

    Mellan korten går VAPENGRUPPEN. Inuti ett kort går MÄSTERSKAPSKATEGORIN (C öppen, Dam C,
    Vet Y C, Vet Ä C, Jun C), som avgör vem som tävlar om vilken medalj — klasserna 1–3 är
    skicklighetsklasser och delar medalj. Se CompetitionTypes/Common/ChampionshipCategory.

    ⚠️ Varför en per-klass-tabell och inte bara en knapp: den vanligaste frågan är "jag har en
    finalstartlista för C och vill nu skapa A-finalen", och den gick inte att svara på från
    skärmen — den enda vägen hette "Skapa om / byt metod", vilket läser som att man förlorar
    det man har. Nu står varje kategori på en rad med sitt eget tillstånd och sin egen åtgärd.

    Ren vy → runtime-kompilerad, så SIDLADDNINGEN är kompileringskontrollen.
*@

@await Html.PartialAsync("_HtmlEscape")

<style>
    #finalsWizardRoot .wizard-progress { display: flex; gap: .5rem; margin-bottom: 1rem; flex-wrap: wrap; }
    #finalsWizardRoot .wizard-progress .step {
        flex: 1 1 0; min-width: 140px; padding: .4rem .6rem; border: 1px solid var(--bs-border-color);
        border-radius: .375rem; font-size: .85rem; color: var(--bs-secondary-color); background: var(--bs-tertiary-bg);
    }
    #finalsWizardRoot .wizard-progress .step.active {
        background: var(--bs-primary-bg-subtle); border-color: var(--bs-primary);
        color: var(--bs-primary-text-emphasis); font-weight: 600;
    }
    #finalsWizardRoot .wizard-progress .step.done {
        background: var(--bs-success-bg-subtle); border-color: var(--bs-success); color: var(--bs-success-text-emphasis);
    }
    #finalsWizardRoot .step-pane { display: none; }
    #finalsWizardRoot .step-pane.active { display: block; }
    .fn-group-card { border-left: 3px solid var(--bs-warning); }
    .fn-group-card.fn-missing { border-left-color: var(--bs-border-color); }
    .fn-group-card.fn-published { border-left-color: var(--bs-success); }
</style>

<div class="competition-finals-start-list-management mt-4" data-competition-id="@competitionId">

    <div class="card">
        @*
            ⚠️ Rubriken står ALLTID kvar, även ihopfälld. En datorovan arrangör ska aldrig få
            något att försvinna — sortera, göm inte. Ihopfällt visas en sammanfattning per
            vapengrupp i rubrikraden, så det går att se läget utan att fälla ut.
        *@
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-trophy me-2 text-warning"></i>Startlistor – final
                </h5>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span id="fnHeaderSummary" class="small"></span>
                    <button class="btn btn-sm btn-outline-secondary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#fnSectionBody"
                            aria-expanded="true" aria-controls="fnSectionBody">
                        <i class="bi bi-chevron-expand me-1"></i>Visa/dölj
                    </button>
                </div>
            </div>
        </div>

        <div class="collapse show" id="fnSectionBody">
            <div class="card-body">

                <div class="alert alert-secondary d-flex align-items-start gap-2 mb-3">
                    <i class="bi bi-info-circle mt-1"></i>
                    <div class="small mb-0">
                        <strong>En finalstartlista per vapengrupp.</strong>
                        Den bestämmer i vilken ordning skyttarna står när finalens resultat matas in
                        (serie F1 och framåt), och den publiceras för sig — så C:s final kan vara
                        publicerad på lördagen medan A:s ännu är ett utkast.
                        <span class="d-block mt-1">
                            Inuti en vapengrupp har varje mästerskapsklass sina egna finalister:
                            Dam C, Veteran C och Junior C tävlar om egna medaljer, medan klasserna
                            1, 2 och 3 är skicklighetsklasser som delar medalj.
                        </span>
                    </div>
                </div>

                @* Kvitto på senaste åtgärden. ⚠️ INTE en alert(): en modal dialogruta
                   blockerar hela sidan (och varje automatiserad kontroll) tills någon
                   klickar OK, och den försvinner utan spår. Notisen står kvar tills nästa
                   åtgärd, så texten "listan var publicerad och uppdaterades direkt på den
                   publika sidan" går att läsa i efterhand. Fel visas fortfarande som
                   alert — ett fel MÅSTE bekräftas. *@
                <div id="fnNotice" class="alert alert-success alert-dismissible fade show d-none" role="status">
                    <span id="fnNoticeText"></span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Stäng"></button>
                </div>

                <div id="fnLoading" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    <small class="ms-2 text-muted">Laddar finalstartlistor...</small>
                </div>

                <div id="fnGroups" class="d-flex flex-column gap-3"></div>

                <div id="fnNoGroups" class="alert alert-warning small d-none mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>Inga klasser med resultat hittades än.</strong>
                    Finalisterna räknas fram ur grundomgångens resultat, så mata in resultat på
                    fliken <strong>Resultat</strong> först. Har du redan gjort det: klicka
                    <strong>Uppdatera</strong> där, så att resultatlistan (med eventuella
                    klassammanslagningar) finns att räkna på.
                </div>

            </div>
        </div>
    </div>

    <!-- =====================================================================
         Guide för mästerskapsfinal — SCOPAD TILL EN VAPENGRUPP.
         Lås kategorier → konfigurera skjutlag → generera.
         ===================================================================== -->
    <div class="modal fade" id="generateFinalsStartListModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-fullscreen-md-down">
            <div class="modal-content" id="finalsWizardRoot">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-trophy me-2 text-warning"></i>Mästerskapsfinal –
                        <span id="wizardGroupLabel">vapengrupp</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                </div>
                <div class="modal-body">

                    <div class="wizard-progress">
                        <div class="step active" data-step="1">1. Lås kvalresultat</div>
                        <div class="step" data-step="2">2. Konfigurera skjutlag</div>
                        <div class="step" data-step="3">3. Generera</div>
                    </div>

                    <!-- STEG 1 — lås per kategori -->
                    <div class="step-pane active" data-step="1">
                        <p class="text-muted small mb-3">
                            Lås kvalresultatet för varje klass i den här vapengruppen när dess
                            grundomgång är klar. Låsningen fryser rangordningen, så att en rättelse
                            i efterhand inte tyst flyttar vem som gick till final. Grupperna kommer
                            från resultatlistan — har du slagit ihop klasser där räknas de som en
                            grupp här också.
                        </p>
                        <div id="noResultListMsg" class="alert alert-warning small d-none">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Resultatlistan måste genereras först.</strong> Gå till fliken
                            "Resultat", klicka "Uppdatera", och kom sedan tillbaka hit.
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Klass</th>
                                        <th>Skyttar</th>
                                        <th>Låsstatus</th>
                                        <th class="text-end">Åtgärd</th>
                                    </tr>
                                </thead>
                                <tbody id="freezeTableBody">
                                    <tr><td colspan="4" class="text-muted text-center">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- STEG 2 — konfigurera skjutlag -->
                    <div class="step-pane" data-step="2">
                        <p class="text-muted small mb-3">
                            För varje låst klass: vilket skjutlag den ska ligga i, och om flera
                            klasser delar skjutlag — i vilken ordning. <strong>Den som leder en
                            klass hamnar alltid först i sitt block.</strong> Exempel: C öppen
                            (skjutlag 1, ordning 0) får platserna 1–10, C Vet Y (skjutlag 1,
                            ordning 1) får 11–17.
                        </p>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" id="configTable">
                                <thead>
                                    <tr>
                                        <th>Klass</th>
                                        <th>Skjutlag #</th>
                                        <th>Ordning i skjutlag</th>
                                        <th>Antal finalister</th>
                                        <th>Alla skjuter</th>
                                        <th>Hoppa över</th>
                                        <th>Förhandsvisning</th>
                                    </tr>
                                </thead>
                                <tbody id="configTableBody">
                                    <tr><td colspan="7" class="text-muted text-center">Lås minst en klass i steg 1 först.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- STEG 3 — generera -->
                    <div class="step-pane" data-step="3">
                        <p class="text-muted small mb-3">
                            Generera finalstartlistan för den här vapengruppen ur de låsta klasserna.
                        </p>
                        <div class="alert alert-warning small d-none" id="wizardGateMsg">
                            <i class="bi bi-lock me-1"></i>
                            Lås minst en klass i <strong>steg 1</strong> innan du kan generera.
                        </div>
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-auto">
                                <label class="form-label small mb-0">Finaldag</label>
                                <input type="text" class="form-control form-control-sm" id="finalsDate"
                                       placeholder="åååå-mm-dd" style="max-width:140px">
                                <div class="form-text">Tom = tävlingens datum</div>
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Första starttid</label>
                                <input type="text" class="form-control form-control-sm" id="finalsFirstStartTime" value="10:00" style="max-width:120px">
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Intervall (h:mm)</label>
                                <input type="text" class="form-control form-control-sm" id="finalsStartInterval" value="1:45" style="max-width:100px">
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Max skyttar/skjutlag</label>
                                <input type="number" class="form-control form-control-sm" id="finalsMaxShootersPerTeam" value="20" min="1" max="60" style="max-width:100px">
                            </div>
                        </div>
                        <div class="alert alert-warning small d-none" id="generateOverwriteWarning">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Vapengruppen har redan en finalstartlista. Generering bygger om den ur
                            de låsta klasserna, så manuella ändringar i skjutlagen skrivs över.
                            <span class="d-block mt-1">Andra vapengruppers listor berörs inte.</span>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary me-auto" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn btn-outline-secondary" id="wizardBackBtn" disabled>
                        <i class="bi bi-arrow-left me-1"></i>Tillbaka
                    </button>
                    <button type="button" class="btn btn-primary" id="wizardNextBtn">
                        Nästa <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                    <button type="button" class="btn btn-success d-none" id="wizardGenerateBtn">
                        <i class="bi bi-lightning me-1"></i>Generera
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const root = document.querySelector('.competition-finals-start-list-management');
    if (!root) return;
    const competitionId = parseInt(root.dataset.competitionId, 10);
    if (!competitionId) return;

    const esc = window.hpskEsc || function (s) { return String(s == null ? '' : s); };

    // ---- helpers ----
    function token() { const el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
    function jpost(url, body) {
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        }).then(async r => {
            if (!r.ok) {
                const text = await r.text().catch(() => '');
                console.error('[finals] POST failed', url, r.status, text);
                alert(`Begäran misslyckades (${r.status}). Se konsollen för detaljer.`);
                return { success: false, message: `HTTP ${r.status}` };
            }
            try { return await r.json(); } catch (e) {
                console.error('[finals] response not JSON', url, e);
                return { success: false, message: 'Ogiltigt svar.' };
            }
        }).catch(err => {
            console.error('[finals] network error', url, err);
            return { success: false, message: err.message };
        });
    }
    function jget(url) {
        return fetch(url).then(async r => {
            if (!r.ok) { console.error('[finals] GET failed', url, r.status); return { success: false }; }
            try { return await r.json(); } catch (e) { console.error('[finals] GET not JSON', url, e); return { success: false }; }
        }).catch(err => { console.error('[finals] GET network error', url, err); return { success: false }; });
    }
    function ok(d) { return d && (d.Success ?? d.success); }
    function msg(d) { return (d && (d.Message ?? d.message)) || ''; }

    // Kvitto på skärmen i stället för en blockerande alert(). Anropas efter refreshAll(),
    // eftersom omritningen inte rör notisen.
    function notice(text) {
        if (!text) return;
        const box = document.getElementById('fnNotice');
        const span = document.getElementById('fnNoticeText');
        if (!box || !span) return;
        span.textContent = text;
        box.classList.remove('d-none');
    }

    // ---- state ----
    let finalsLists = [];        // GetFinalsStartList → Lists
    let perClassState = [];      // GetQualifyingSnapshot → perClass (bär weaponGroup)
    let hasResultList = false;
    let editorOpenForFinalsId = null;

    // Guidens tillstånd är scopat till EN vapengrupp åt gången.
    let wizardGroup = '';
    let perClassConfig = {};
    let currentStep = 1;

    function listForGroup(group) {
        return finalsLists.find(L => (L.weaponGroup || L.WeaponGroup || '') === group) || null;
    }
    function classesForGroup(group) {
        return perClassState.filter(s => (s.weaponGroup || '') === group);
    }

    // Vilka klasser i gruppen som FAKTISKT står i listan. ⚠️ Läses ur listans skyttar,
    // aldrig ur konfigurationen: konfigurationen beskriver vad som SKULLE genereras, och
    // efter en manuell redigering är den inte längre sann om vad som står i listan.
    //
    // ⚠️ Returnerar NULL när listan inte bär någon kategoriinformation alls. Det är
    // fallet för "fortsätt i samma ordning": den kopierar kvalstartlistan, vars skyttar
    // saknar ChampionshipClass. En tom mängd hade då lästs som "ingen klass är med" och
    // visat "Lägg till i finalen" på varje rad i en lista där alla redan står.
    // Null betyder "vet inte per klass" och renderas som just det.
    function classesInList(L) {
        const sl = L && (L.startList || L.StartList);
        const teams = (sl && (sl.Teams || sl.teams)) || [];
        const out = new Set();
        let sawAnyShooter = false;
        teams.forEach(t => (t.Shooters || t.shooters || []).forEach(sh => {
            sawAnyShooter = true;
            const c = sh.ChampionshipClass || sh.championshipClass || '';
            if (c) out.add(c);
        }));
        if (sawAnyShooter && out.size === 0) return null;
        return out;
    }

    // ---- ladda allt ----
    async function refreshAll() {
        document.getElementById('fnLoading').classList.remove('d-none');
        const [finals, readiness] = await Promise.all([
            jget(`/umbraco/surface/PrecisionStartList/GetFinalsStartList?competitionId=${competitionId}`),
            jget(`/umbraco/surface/PrecisionStartList/GetQualifyingSnapshot?competitionId=${competitionId}`)
        ]);

        hasResultList = !!(readiness && readiness.hasResultList);
        perClassState = (readiness && readiness.perClass) || [];
        finalsLists = (finals && (finals.Lists || finals.lists)) || [];

        document.getElementById('fnLoading').classList.add('d-none');
        renderGroups();
    }
    // Bakåtkompatibelt namn — redigerarens stängningskrok anropar det.
    async function loadFinalsStartList() { await refreshAll(); }

    // ---- rendering ----
    function groupOrder() {
        // Vapengrupper som har klasser med resultat, plus grupper som redan har en lista
        // (en klass kan ha låsts och sedan tagits ur resultatlistan). Heltävlingslistor
        // (tom grupp) hamnar sist och får en egen förklaring.
        const set = new Set();
        perClassState.forEach(s => { if (s.weaponGroup) set.add(s.weaponGroup); });
        finalsLists.forEach(L => { const g = L.weaponGroup || L.WeaponGroup || ''; if (g) set.add(g); });
        const groups = Array.from(set).sort((a, b) => a.localeCompare(b, 'sv'));
        if (finalsLists.some(L => !(L.weaponGroup || L.WeaponGroup))) groups.push('');
        return groups;
    }

    // ⚠️ EN form och ETT ordpar, delat med Resultat och Startlistor (_PublishState.cshtml).
    // Den här ytan bar en FJÄRDE variant: `badge bg-success` respektive
    // `badge bg-warning text-dark`, alltså mindre än de andras `fs-6 px-3 py-2` — samma
    // tillstånd såg olika ut beroende på vilken flik man stod på.
    function statusBadge(L) {
        if (!L) return hpskNoListPill('Ingen lista');
        const isOfficial = L.isOfficial || L.IsOfficial;
        return hpskStatePill(!!isOfficial, 'Finalstartlistan');
    }

    function renderHeaderSummary(groups) {
        const parts = groups.map(g => {
            const L = listForGroup(g);
            const label = g || 'hela tävlingen';
            if (!L) return `<span class="badge bg-secondary-subtle text-secondary-emphasis">${esc(label)}: ingen lista</span>`;
            const isOfficial = L.isOfficial || L.IsOfficial;
            const cls = isOfficial ? 'bg-success-subtle text-success-emphasis' : 'bg-warning-subtle text-warning-emphasis';
            const word = isOfficial ? 'publicerad' : 'preliminär';
            return `<span class="badge ${cls}">${esc(label)}: ${word}</span>`;
        });
        document.getElementById('fnHeaderSummary').innerHTML = parts.join(' ');
    }

    function renderGroups() {
        const host = document.getElementById('fnGroups');
        const groups = groupOrder();
        renderHeaderSummary(groups);

        document.getElementById('fnNoGroups').classList.toggle('d-none', groups.length > 0);
        if (!groups.length) { host.innerHTML = ''; return; }

        host.innerHTML = groups.map(renderGroupCard).join('');

        // ⚠️ Delegerade lyssnare på data-attribut — ALDRIG en JS-literal byggd av
        // klassnamnet i ett onclick. Klassnamn kan vara admin-omdöpta (classNameOverrides)
        // och alltså bära vilken text som helst; ett dubbelfnutt avslutar attributet.
        host.querySelectorAll('[data-fn-action]').forEach(btn => {
            btn.addEventListener('click', onGroupAction);
        });
    }

    function renderGroupCard(group) {
        const L = listForGroup(group);
        const classes = classesForGroup(group);
        const label = group ? `Vapengrupp ${group}` : 'Hela tävlingen (äldre lista)';
        const cardCls = !L ? 'fn-missing' : ((L.isOfficial || L.IsOfficial) ? 'fn-published' : '');

        const finalists = L ? (L.totalFinalists || L.TotalFinalists || 0) : 0;
        const teamCount = L ? (L.teamCount || L.TeamCount || 0) : 0;
        const finalsDate = L ? (L.finalsDate || L.FinalsDate || '') : '';
        const firstStart = L ? (L.firstStartTime || L.FirstStartTime || '') : '';
        const fmt = L ? (L.teamFormat || L.TeamFormat || '') : '';
        const fmtLabel = fmt === 'Final' ? 'samma ordning som kvalet' : 'rangordnad efter kvalresultat';
        const inList = L ? classesInList(L) : new Set();

        let body;
        if (!L) {
            body = renderCreateBlock(group, classes);
        } else {
            body = `
                <div class="d-flex flex-wrap gap-3 small text-muted mb-3">
                    <span><i class="bi bi-people me-1"></i>${finalists} finalister</span>
                    <span><i class="bi bi-grid me-1"></i>${teamCount} skjutlag</span>
                    ${finalsDate ? `<span><i class="bi bi-calendar-event me-1"></i>${esc(finalsDate)}</span>` : ''}
                    ${firstStart ? `<span><i class="bi bi-clock me-1"></i>första start ${esc(firstStart)}</span>` : ''}
                    <span><i class="bi bi-sort-numeric-down me-1"></i>${esc(fmtLabel)}</span>
                </div>
                ${renderClassTable(group, classes, inList)}
                ${renderGroupActions(group, L)}`;
        }

        return `
            <div class="card fn-group-card ${cardCls}">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                    <span class="fw-bold"><i class="bi bi-trophy me-2 text-warning"></i>${esc(label)}</span>
                    ${statusBadge(L)}
                </div>
                <div class="card-body">${body}</div>
            </div>`;
    }

    // Ingen lista än — visa de tre metoderna, scopade till gruppen.
    function renderCreateBlock(group, classes) {
        const withResults = classes.filter(c => c.hasResults);
        if (!group) {
            return `<p class="text-muted small mb-0">
                Den här listan täcker hela tävlingen och skapades innan finalerna delades per
                vapengrupp. Skapa en lista per vapengrupp i korten ovan — den första
                genereringen tar över den här listan.</p>`;
        }
        if (!withResults.length) {
            return `<p class="text-muted small mb-0">
                Inga resultat i vapengrupp ${esc(group)} än. Finalisterna räknas ur
                grundomgångens resultat, så mata in dem på fliken Resultat först.</p>`;
        }
        const shooters = withResults.reduce((n, c) => n + (c.totalShooters || 0), 0);
        return `
            <p class="small mb-3">
                <strong>Ingen finalstartlista för vapengrupp ${esc(group)} än.</strong>
                ${withResults.length} ${withResults.length === 1 ? 'klass' : 'klasser'} med
                resultat, ${shooters} skyttar. Välj hur finalen ska ställas upp:
            </p>
            <div class="row g-2">
                <div class="col-md-4">
                    <button class="btn btn-outline-success btn-sm w-100 h-100 text-start"
                            data-fn-action="clone" data-fn-group="${esc(group)}">
                        <i class="bi bi-arrow-right-circle me-1"></i><strong>Fortsätt i samma ordning</strong>
                        <span class="d-block small text-muted">Samma skjutlag och platser som i grundomgången.</span>
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-primary btn-sm w-100 h-100 text-start"
                            data-fn-action="rerank" data-fn-group="${esc(group)}">
                        <i class="bi bi-sort-numeric-down me-1"></i><strong>Placera om efter resultat</strong>
                        <span class="d-block small text-muted">Alla med resultat, bäst först. Ingen gallring.</span>
                    </button>
                </div>
                <div class="col-md-4">
                    <button class="btn btn-outline-warning btn-sm w-100 h-100 text-start"
                            data-fn-action="wizard" data-fn-group="${esc(group)}">
                        <i class="bi bi-trophy me-1"></i><strong>Mästerskapsfinal</strong>
                        <span class="d-block small text-muted">Gallring till de bästa, per mästerskapsklass.</span>
                    </button>
                </div>
            </div>`;
    }

    // Per-klass-tabellen: DET som gör att "jag vill lägga till A-finalen" går att besvara
    // från skärmen. En rad per mästerskapsklass i gruppen, med sitt eget tillstånd.
    function renderClassTable(group, classes, inList) {
        if (!classes.length) {
            return `<p class="text-muted small mb-3">Inga klasser med resultat i den här vapengruppen.</p>`;
        }
        // Listan saknar kategoriinformation (kopierad kvalordning) — säg det i klartext i
        // stället för att låtsas veta per klass.
        if (inList === null) {
            const withRes = classes.filter(c => c.hasResults);
            return `
                <div class="alert alert-info small py-2 mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Listan följer grundomgångens ordning, så <strong>alla
                    ${withRes.length} ${withRes.length === 1 ? 'klass' : 'klasser'} i vapengruppen
                    ingår</strong> — ingen gallring är gjord.
                    Vill du gallra till de bästa per mästerskapsklass: välj
                    <strong>Mästerskapsfinal</strong> i Åtgärder nedan.
                </div>
                <div class="table-responsive mb-3">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Mästerskapsklass</th><th>Skyttar i grundomgången</th></tr></thead>
                        <tbody>${withRes.map(c => `<tr><td><strong>${esc(c.groupName || c.championshipClass || '')}</strong></td><td>${c.totalShooters || 0}</td></tr>`).join('')}</tbody>
                    </table>
                </div>`;
        }

        const rows = classes.map((c, i) => {
            const name = c.groupName || c.championshipClass || '';
            const isIn = inList.has(name);
            let state, action;

            if (isIn) {
                state = '<span class="badge bg-success-subtle text-success-emphasis">I finalstartlistan</span>';
                if (c.stale) {
                    state += ' <span class="badge bg-danger ms-1">Resultaten har ändrats</span>';
                    action = `<button class="btn btn-outline-primary btn-sm" data-fn-action="relock"
                                data-fn-group="${esc(group)}" data-fn-class-index="${i}">
                                <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera</button>`;
                } else {
                    action = `<button class="btn btn-outline-danger btn-sm" data-fn-action="remove"
                                data-fn-group="${esc(group)}" data-fn-class-index="${i}">
                                <i class="bi bi-x-circle me-1"></i>Ta bort ur finalen</button>`;
                }
            } else if (!c.hasResults) {
                state = '<span class="text-muted small">Inga resultat</span>';
                action = '';
            } else {
                state = '<span class="badge bg-secondary-subtle text-secondary-emphasis">Inte i finalstartlistan</span>';
                action = `<button class="btn btn-primary btn-sm" data-fn-action="add"
                            data-fn-group="${esc(group)}" data-fn-class-index="${i}">
                            <i class="bi bi-plus-circle me-1"></i>Lägg till i finalen</button>`;
            }

            const lockInfo = c.frozen
                ? `<i class="bi bi-lock-fill text-success" title="Kvalresultatet är låst"></i> <span class="text-muted">${c.frozenShooterCount || 0} skyttar låsta</span>`
                : '<span class="text-muted">Inte låst</span>';

            return `<tr>
                <td><strong>${esc(name)}</strong></td>
                <td>${c.totalShooters || 0}</td>
                <td class="small">${lockInfo}</td>
                <td class="small">${state}</td>
                <td class="text-end">${action}</td>
            </tr>`;
        }).join('');

        return `
            <div class="table-responsive mb-3">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Mästerskapsklass</th>
                            <th>Skyttar i grundomgången</th>
                            <th>Kvalresultat</th>
                            <th>Final</th>
                            <th class="text-end">Åtgärd</th>
                        </tr>
                    </thead>
                    <tbody>${rows}</tbody>
                </table>
            </div>`;
    }

    function renderGroupActions(group, L) {
        const id = L.finalsStartListId || L.FinalsStartListId;
        const isOfficial = L.isOfficial || L.IsOfficial;
        return `
            <div class="d-flex justify-content-end flex-wrap gap-2">
                ${isOfficial
                    ? `<button class="btn btn-outline-secondary btn-sm" data-fn-action="unpublish" data-fn-group="${esc(group)}">
                         <i class="bi bi-arrow-counterclockwise me-1"></i>Avpublicera</button>`
                    : `<button class="btn btn-success btn-sm" data-fn-action="publish" data-fn-group="${esc(group)}">
                         <i class="bi bi-check-circle me-1"></i>Publicera</button>`}
                @* ⚠️ BARA PUBLICERINGSVERBET STÅR SYNLIGT — samma regel som på Resultatfliken:
                   synlig = steget du står på, menyn = allt annat. På en finalstartlista är
                   steget att publicera; Redigera är en tillfällig rättelse och Öppna en
                   förhandsvisning. Fyra knappar i fyra färgvarianter (success, outline-info,
                   outline-primary, outline-secondary) på samma rad var dessutom en del av
                   "olika design överallt". Rapporterat 2026-09-08. *@
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                        <i class="bi bi-sliders me-1"></i>Åtgärder
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><button class="dropdown-item" data-fn-action="edit" data-fn-group="${esc(group)}">
                            <i class="bi bi-pencil-square me-2"></i>Redigera listan</button></li>
                        <li><button class="dropdown-item" data-fn-action="open" data-fn-group="${esc(group)}">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Öppna listan</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Bygg om listan</h6></li>
                        <li><button class="dropdown-item" data-fn-action="wizard" data-fn-group="${esc(group)}">
                            <i class="bi bi-trophy me-2"></i>Mästerskapsfinal (gallring per klass)</button></li>
                        <li><button class="dropdown-item" data-fn-action="clone" data-fn-group="${esc(group)}">
                            <i class="bi bi-arrow-right-circle me-2"></i>Fortsätt i samma ordning</button></li>
                        <li><button class="dropdown-item" data-fn-action="rerank" data-fn-group="${esc(group)}">
                            <i class="bi bi-sort-numeric-down me-2"></i>Placera om efter resultat</button></li>
                    </ul>
                </div>
            </div>
            <div class="form-text mt-2">
                Listans id: ${id}. Publiceringen gäller bara vapengrupp ${esc(group || '—')}; andra
                gruppers listor påverkas inte.
            </div>`;
    }

    // ---- åtgärder ----
    async function onGroupAction(e) {
        const btn = e.currentTarget;
        const action = btn.dataset.fnAction;
        const group = btn.dataset.fnGroup || '';
        const idx = btn.dataset.fnClassIndex != null ? parseInt(btn.dataset.fnClassIndex, 10) : -1;
        const classes = classesForGroup(group);
        const cls = idx >= 0 && idx < classes.length ? classes[idx] : null;
        const clsName = cls ? (cls.groupName || cls.championshipClass || '') : '';

        switch (action) {
            case 'clone':
            case 'rerank':
                await generateSimple(group, action);
                break;
            case 'wizard':
                await openWizard(group);
                break;
            case 'publish':
                await togglePublish(group, true);
                break;
            case 'unpublish':
                await togglePublish(group, false);
                break;
            case 'edit':
                openFinalsEditor(group);
                break;
            case 'open':
                openInNewTab(group);
                break;
            case 'add':
                await addClassToFinal(group, clsName);
                break;
            case 'relock':
                await addClassToFinal(group, clsName, true);
                break;
            case 'remove':
                await removeClassFromFinal(group, clsName);
                break;
        }
    }

    // "Lägg till i finalen" = lås klassens kvalresultat, nolla ett eventuellt hoppa-över,
    // och generera om GRUPPENS lista. ⚠️ Genereringen bygger listan ur de låsta klasserna,
    // så manuella ändringar i just den gruppens skjutlag skrivs över — det sägs innan.
    async function addClassToFinal(group, className, isRelock) {
        if (!className) return;
        const L = listForGroup(group);
        const verb = isRelock ? 'Uppdatera' : 'Lägg till';
        let warn = isRelock
            ? `Uppdatera ${className} i finalen för vapengrupp ${group}?\n\nKvalresultatet låses om med de aktuella resultaten.`
            : `Lägg till ${className} i finalen för vapengrupp ${group}?\n\nKlassens kvalresultat låses och finalstartlistan byggs om.`;
        if (L) warn += '\n\nManuella ändringar i den här gruppens skjutlag skrivs över. Andra vapengrupper påverkas inte.';
        if (!confirm(warn)) return;

        const fz = await jpost('/umbraco/surface/PrecisionStartList/FreezeClassResults',
            { CompetitionId: competitionId, ChampionshipClass: className });
        if (!(fz.success ?? fz.Success)) { alert(msg(fz) || 'Kunde inte låsa kvalresultatet.'); return; }

        // Klassen kan ha varit markerad "hoppa över" av en tidigare generering — annars
        // låses den nu men dyker aldrig upp i listan, vilket ser ut som att knappen
        // inte gjorde något.
        const cfgResp = await jget(`/umbraco/surface/PrecisionStartList/GetFinalsConfig?competitionId=${competitionId}&weaponGroup=${encodeURIComponent(group)}`);
        const cfg = (cfgResp && cfgResp.config) || {};
        if (cfg[className] && cfg[className].skip) {
            cfg[className].skip = false;
            await jpost('/umbraco/surface/PrecisionStartList/SaveFinalsConfig',
                { CompetitionId: competitionId, WeaponGroup: group, Config: cfg });
        }

        await regenerateGroup(group, `${verb.toLowerCase()} ${className}`);
    }

    // "Ta bort ur finalen" = markera klassen som hoppa-över och generera om gruppen.
    // ⚠️ Låsningen tas INTE bort: den är historik om vilka kvalresultat som gällde, och
    // att tappa den vid en ändring av vem som är med hade gjort en återgång svårare.
    async function removeClassFromFinal(group, className) {
        if (!className) return;
        if (!confirm(`Ta bort ${className} ur finalen för vapengrupp ${group}?\n\nKlassens skyttar tas ur finalstartlistan. Deras kvalresultat och låsning ligger kvar.`)) return;

        const cfgResp = await jget(`/umbraco/surface/PrecisionStartList/GetFinalsConfig?competitionId=${competitionId}&weaponGroup=${encodeURIComponent(group)}`);
        const cfg = (cfgResp && cfgResp.config) || {};
        cfg[className] = Object.assign({ skjutlagNumber: 1, orderInSkjutlag: 0 }, cfg[className] || {}, { skip: true });
        const sv = await jpost('/umbraco/surface/PrecisionStartList/SaveFinalsConfig',
            { CompetitionId: competitionId, WeaponGroup: group, Config: cfg });
        if (!(sv.success ?? sv.Success)) { alert(msg(sv) || 'Kunde inte spara.'); return; }

        await regenerateGroup(group, `ta bort ${className}`);
    }

    async function regenerateGroup(group, what) {
        const L = listForGroup(group);
        const body = {
            CompetitionId: competitionId,
            WeaponGroup: group,
            FinalsDate: L ? (L.finalsDate || L.FinalsDate || '') : '',
            FirstStartTime: (L && (L.firstStartTime || L.FirstStartTime)) || '10:00',
            StartInterval: '1:45',
            MaxShootersPerTeam: 20
        };
        const d = await jpost('/umbraco/surface/PrecisionStartList/GenerateFinalsStartList', body);
        if (!ok(d)) { alert(msg(d) || `Kunde inte ${what}.`); await refreshAll(); return; }
        await refreshAll();
        notice(msg(d));
    }

    async function generateSimple(group, mode) {
        const label = mode === 'clone' ? 'samma ordning som kvalet' : 'omplacering efter kvalresultat';
        const L = listForGroup(group);
        if (L && !confirm(`Vapengrupp ${group} har redan en finalstartlista. Bygg om den med ${label}?\n\nManuella ändringar skrivs över. Andra vapengrupper påverkas inte.`)) return;
        const d = await jpost('/umbraco/surface/PrecisionStartList/GenerateSimpleFinalsStartList', {
            CompetitionId: competitionId,
            WeaponGroup: group,
            Mode: mode,
            FinalsDate: L ? (L.finalsDate || L.FinalsDate || '') : '',
            FirstStartTime: '10:00',
            StartInterval: '1:45',
            MaxShootersPerTeam: 20
        });
        if (!ok(d)) { alert(msg(d) || 'Kunde inte skapa finalen.'); await refreshAll(); return; }
        await refreshAll();
        notice(msg(d));
    }

    async function togglePublish(group, makeOfficial) {
        const L = listForGroup(group);
        if (!L) return;
        const id = L.finalsStartListId || L.FinalsStartListId;
        const verb = makeOfficial ? 'Publicera' : 'Avpublicera';
        if (!confirm(`${verb} finalstartlistan för vapengrupp ${group || '—'}?`)) return;
        const d = await jpost('/umbraco/surface/PrecisionStartList/PublishFinalsStartList',
            { FinalsStartListId: id, IsPublished: makeOfficial });
        if (!(d.success ?? d.Success)) { alert(msg(d) || 'Kunde inte ändra status.'); return; }
        await refreshAll();
    }

    function openInNewTab(group) {
        const L = listForGroup(group);
        if (!L) return;
        const id = L.finalsStartListId || L.FinalsStartListId;
        window.open(`/umbraco/Surface/PrecisionStartList/PreviewStartList?competitionId=${competitionId}&startListId=${id}`, '_blank');
    }

    function openFinalsEditor(group) {
        const L = listForGroup(group);
        if (!L) return;
        const id = L.finalsStartListId || L.FinalsStartListId;
        if (typeof window.openStartListEditor !== 'function') {
            alert('Startlistredigeraren är inte tillgänglig. Den initialiseras när Startlistor-fliken läses in.');
            return;
        }
        editorOpenForFinalsId = id;
        window.openStartListEditor(id);
    }

    function attachEditorCloseHook() {
        const editorEl = document.getElementById('startListEditorModal');
        if (!editorEl || editorEl.dataset.finalsHookAttached === '1') return;
        editorEl.dataset.finalsHookAttached = '1';
        editorEl.addEventListener('hidden.bs.modal', function () {
            if (editorOpenForFinalsId) {
                editorOpenForFinalsId = null;
                setTimeout(() => loadFinalsStartList(), 50);
            }
        });
    }

    // ---- guiden, scopad till en vapengrupp ----
    async function openWizard(group) {
        wizardGroup = group;
        currentStep = 1;
        document.getElementById('wizardGroupLabel').textContent = group ? `vapengrupp ${group}` : 'hela tävlingen';
        showStep(1);
        await Promise.all([loadFreezeState(), loadFinalsConfig(group)]);
        const m = bootstrap.Modal.getOrCreateInstance(document.getElementById('generateFinalsStartListModal'));
        m.show();
        updateGenerateWarning();
    }

    function showStep(step) {
        currentStep = step;
        document.querySelectorAll('#finalsWizardRoot .step-pane').forEach(p => {
            p.classList.toggle('active', parseInt(p.dataset.step, 10) === step);
        });
        document.querySelectorAll('#finalsWizardRoot .wizard-progress .step').forEach(s => {
            const n = parseInt(s.dataset.step, 10);
            s.classList.toggle('active', n === step);
            s.classList.toggle('done', n < step);
        });
        document.getElementById('wizardBackBtn').disabled = step === 1;
        const nextBtn = document.getElementById('wizardNextBtn');
        const genBtn = document.getElementById('wizardGenerateBtn');
        if (step === 3) {
            nextBtn.classList.add('d-none');
            genBtn.classList.remove('d-none');
            const frozenCount = classesForGroup(wizardGroup).filter(s => s.frozen).length;
            genBtn.disabled = frozenCount === 0;
            document.getElementById('wizardGateMsg').classList.toggle('d-none', frozenCount > 0);
        } else {
            nextBtn.classList.remove('d-none');
            genBtn.classList.add('d-none');
            genBtn.disabled = false;
        }
    }

    async function loadFreezeState() {
        const d = await jget(`/umbraco/surface/PrecisionStartList/GetQualifyingSnapshot?competitionId=${competitionId}`);
        if (!(d.success ?? d.Success)) return;
        hasResultList = !!d.hasResultList;
        perClassState = d.perClass || [];
        renderFreezeTable();
    }

    function renderFreezeTable() {
        const tbody = document.getElementById('freezeTableBody');
        const noResultListMsg = document.getElementById('noResultListMsg');
        const classes = classesForGroup(wizardGroup);
        noResultListMsg.classList.toggle('d-none', !(!hasResultList && classes.length === 0));

        if (!classes.length) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-muted text-center">Inga klasser i den här vapengruppen — generera resultatlistan först.</td></tr>';
            return;
        }
        tbody.innerHTML = classes.map((s, i) => {
            const groupName = s.groupName || s.championshipClass;
            let stateCell = '<span class="badge bg-secondary"><i class="bi bi-unlock me-1"></i>Inte låst</span>';
            if (s.frozen) {
                const lockedText = `${new Date(s.frozenAt).toLocaleString('sv-SE')} av ${esc(s.frozenBy)}`;
                stateCell = `<span class="badge bg-success"><i class="bi bi-lock-fill me-1"></i>Låst</span> <small class="text-muted ms-2">${lockedText} • ${s.frozenShooterCount} skyttar</small>`;
                if (s.stale) stateCell += ' <span class="badge bg-danger ms-2">Inaktuell — resultaten har ändrats</span>';
            }
            let actionCell;
            if (!s.hasResults && !s.frozen) {
                actionCell = '<span class="text-muted small">Inga resultat</span>';
            } else if (s.frozen) {
                actionCell = `<button class="btn btn-outline-warning btn-sm" data-action="unlock" data-cls-index="${i}"><i class="bi bi-unlock-fill me-1"></i>Lås upp</button>
                              <button class="btn btn-outline-primary btn-sm ms-1" data-action="relock" data-cls-index="${i}"><i class="bi bi-arrow-clockwise me-1"></i>Uppdatera</button>`;
            } else {
                actionCell = `<button class="btn btn-primary btn-sm" data-action="lock" data-cls-index="${i}"><i class="bi bi-lock-fill me-1"></i>Lås</button>`;
            }
            return `<tr>
                        <td><strong>${esc(groupName)}</strong></td>
                        <td>${s.totalShooters}</td>
                        <td>${stateCell}</td>
                        <td class="text-end">${actionCell}</td>
                    </tr>`;
        }).join('');
        tbody.querySelectorAll('button[data-action]').forEach(b => b.addEventListener('click', onFreezeAction));
    }

    async function onFreezeAction(e) {
        const btn = e.currentTarget;
        const action = btn.dataset.action;
        const classes = classesForGroup(wizardGroup);
        const i = parseInt(btn.dataset.clsIndex, 10);
        const s = classes[i];
        if (!s) return;
        const cls = s.groupName || s.championshipClass;

        if (action === 'unlock') {
            if (!confirm(`Lås upp klassen ${cls}?`)) return;
            const d = await jpost('/umbraco/surface/PrecisionStartList/UnfreezeClassResults',
                { CompetitionId: competitionId, ChampionshipClass: cls });
            if (!(d.success ?? d.Success) && msg(d)) alert(msg(d));
        } else {
            const d = await jpost('/umbraco/surface/PrecisionStartList/FreezeClassResults',
                { CompetitionId: competitionId, ChampionshipClass: cls });
            if (!(d.success ?? d.Success) && msg(d)) alert(msg(d));
        }
        await loadFreezeState();
    }

    async function loadFinalsConfig(group) {
        const d = await jget(`/umbraco/surface/PrecisionStartList/GetFinalsConfig?competitionId=${competitionId}&weaponGroup=${encodeURIComponent(group || '')}`);
        if (d.success ?? d.Success) perClassConfig = d.config || {};
    }

    function renderConfigTable() {
        const tbody = document.getElementById('configTableBody');
        const frozen = classesForGroup(wizardGroup).filter(s => s.frozen);
        if (!frozen.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-muted text-center">Lås minst en klass i steg 1 först.</td></tr>';
            return;
        }
        tbody.innerHTML = '';
        let autoSkjutlag = 1;
        frozen.forEach((s, i) => {
            const groupName = s.groupName || s.championshipClass;
            const cfg = perClassConfig[groupName] || {};
            const defaultSkjutlag = cfg.skjutlagNumber || autoSkjutlag++;
            const tr = document.createElement('tr');
            tr.dataset.clsIndex = String(i);
            tr.innerHTML = `
                <td><strong>${esc(groupName)}</strong><br><small class="text-muted">${s.frozenShooterCount} skyttar</small></td>
                <td><input type="number" min="1" max="20" class="form-control form-control-sm cfg-skjutlag" value="${defaultSkjutlag}" style="max-width:80px"></td>
                <td><input type="number" min="0" max="20" class="form-control form-control-sm cfg-order" value="${cfg.orderInSkjutlag || 0}" style="max-width:80px"></td>
                <td><input type="number" min="1" class="form-control form-control-sm cfg-count" placeholder="Auto" value="${cfg.finalistCountOverride != null ? cfg.finalistCountOverride : ''}" style="max-width:90px"></td>
                <td class="text-center"><input type="checkbox" class="form-check-input cfg-all" ${cfg.includeAllShooters ? 'checked' : ''}></td>
                <td class="text-center"><input type="checkbox" class="form-check-input cfg-skip" ${cfg.skip ? 'checked' : ''}></td>
                <td class="preview-cell text-muted">-</td>`;
            tbody.appendChild(tr);
        });
        tbody.querySelectorAll('input').forEach(el => el.addEventListener('change', onConfigChange));
        readConfigFromTable();
        previewBuckets();
    }

    function frozenClassNameAt(i) {
        const frozen = classesForGroup(wizardGroup).filter(s => s.frozen);
        const s = frozen[i];
        return s ? (s.groupName || s.championshipClass) : '';
    }

    function readConfigFromTable() {
        document.querySelectorAll('#configTableBody tr[data-cls-index]').forEach(tr => {
            const group = frozenClassNameAt(parseInt(tr.dataset.clsIndex, 10));
            if (!group) return;
            const countStr = tr.querySelector('.cfg-count').value.trim();
            perClassConfig[group] = {
                skip: tr.querySelector('.cfg-skip').checked,
                skjutlagNumber: parseInt(tr.querySelector('.cfg-skjutlag').value, 10) || 1,
                orderInSkjutlag: parseInt(tr.querySelector('.cfg-order').value, 10) || 0,
                finalistCountOverride: countStr === '' ? null : parseInt(countStr, 10),
                includeAllShooters: tr.querySelector('.cfg-all').checked
            };
        });
    }
    function onConfigChange() { readConfigFromTable(); previewBuckets(); }

    async function previewBuckets() {
        const d = await jpost('/umbraco/surface/PrecisionStartList/PreviewFinalsConfig',
            { CompetitionId: competitionId, WeaponGroup: wizardGroup, Config: perClassConfig });
        if (!(d.success ?? d.Success)) return;
        document.querySelectorAll('#configTableBody tr[data-cls-index]').forEach(tr => {
            const group = frozenClassNameAt(parseInt(tr.dataset.clsIndex, 10));
            const cell = tr.querySelector('.preview-cell');
            const info = group ? d.perClass[group] : null;
            if (!info) { cell.textContent = '-'; return; }
            if (info.skjutlag == null) { cell.innerHTML = '<span class="badge bg-secondary">Hoppas över</span>'; return; }
            cell.innerHTML = `<span class="badge bg-info">Skjutlag ${info.skjutlag}</span> <span class="text-muted small">${info.finalistCount} av ${info.totalInClass}</span>`;
        });
    }

    function updateGenerateWarning() {
        document.getElementById('generateOverwriteWarning').classList.toggle('d-none', !listForGroup(wizardGroup));
    }

    async function doGenerate() {
        const lockedCount = classesForGroup(wizardGroup).filter(s => s.frozen).length;
        if (lockedCount === 0) {
            alert('Inga klasser är låsta. Gå tillbaka till steg 1 och lås minst en klass.');
            return;
        }
        if (listForGroup(wizardGroup) &&
            !confirm(`Vapengrupp ${wizardGroup} har redan en finalstartlista. Bygg om den?\n\nManuella ändringar skrivs över. Andra vapengrupper påverkas inte.`)) return;

        const saveResp = await jpost('/umbraco/surface/PrecisionStartList/SaveFinalsConfig',
            { CompetitionId: competitionId, WeaponGroup: wizardGroup, Config: perClassConfig });
        if (!(saveResp.success ?? saveResp.Success)) { alert('Kunde inte spara konfigurationen: ' + msg(saveResp)); return; }

        const genResp = await jpost('/umbraco/surface/PrecisionStartList/GenerateFinalsStartList', {
            CompetitionId: competitionId,
            WeaponGroup: wizardGroup,
            FinalsDate: document.getElementById('finalsDate').value,
            FirstStartTime: document.getElementById('finalsFirstStartTime').value,
            StartInterval: document.getElementById('finalsStartInterval').value,
            MaxShootersPerTeam: parseInt(document.getElementById('finalsMaxShootersPerTeam').value, 10) || 20
        });
        if (!ok(genResp)) { alert(msg(genResp) || 'Okänt fel'); return; }

        const modalInst = bootstrap.Modal.getInstance(document.getElementById('generateFinalsStartListModal'));
        if (modalInst) modalInst.hide();
        await refreshAll();
        notice(msg(genResp));
    }

    // ---- wiring ----
    document.getElementById('wizardBackBtn').addEventListener('click', () => { if (currentStep > 1) showStep(currentStep - 1); });
    document.getElementById('wizardNextBtn').addEventListener('click', async () => {
        if (currentStep === 1) {
            showStep(2);
            renderConfigTable();
        } else if (currentStep === 2) {
            const saveResp = await jpost('/umbraco/surface/PrecisionStartList/SaveFinalsConfig',
                { CompetitionId: competitionId, WeaponGroup: wizardGroup, Config: perClassConfig });
            if (!(saveResp.success ?? saveResp.Success)) { alert(msg(saveResp) || 'Kunde inte spara.'); return; }
            showStep(3);
            updateGenerateWarning();
        }
    });
    document.getElementById('wizardGenerateBtn').addEventListener('click', doGenerate);

    attachEditorCloseHook();
    setTimeout(attachEditorCloseHook, 500);

    // Exporteras explicit — en funktionsdeklaration i ett block läcker inte till global
    // scope (Annex B:s hoisting gäller inte i block, och inte alls för async), och
    // kvalstartlistans "Till finalen"-knapp behöver kunna fälla ut sektionen.
    window.hpskRefreshFinalsSection = refreshAll;

    // Fäller UT finalsektionen och rullar dit. Att bara rulla hade landat på en ihopfälld
    // rubrik, vilket läser som att sektionen är tom.
    window.hpskGoToFinalsSection = function () {
        const body = document.getElementById('fnSectionBody');
        if (body && typeof bootstrap !== 'undefined') {
            bootstrap.Collapse.getOrCreateInstance(body, { toggle: false }).show();
        }
        root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    refreshAll();
})();
</script>
