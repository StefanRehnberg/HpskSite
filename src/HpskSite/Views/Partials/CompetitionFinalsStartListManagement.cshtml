@*
 * Competition Finals Start List Management
 *
 * Mirrors the visual pattern of CompetitionStartListManagement.cshtml:
 *   - "Skapa ny finalsstartlista" button at the top (always visible)
 *   - Official finals start list card with status badge, Publicera/Avpublicera, info row, Redigera, iframe
 *   - Generation flow lives entirely inside #generateFinalsStartListModal (3-step wizard)
 *   - Editing reuses the standard #startListEditorModal via window.openStartListEditor(finalsId) —
 *     the shared editor is parameterized on window.currentStartListId so the same JS works for
 *     both qualifying and finals lists. The controller's GetStartListForEditing branches on the
 *     doctype alias for the isOfficial flag.
 *
 * Gated by CompetitionManagement.cshtml on `numberOfFinalSeries > 0`.
*@
@{
    var competitionId = ViewData["CompetitionId"] is int cid ? cid : 0;
}

@Html.AntiForgeryToken()

<style>
    #finalsWizardRoot .wizard-progress {
        display: flex;
        gap: .5rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }
    #finalsWizardRoot .wizard-progress .step {
        flex: 1 1 12rem;
        padding: .5rem .75rem;
        border-radius: .375rem;
        background: var(--bs-tertiary-bg);
        border: 1px solid var(--bs-border-color);
        font-size: .85rem;
        color: var(--bs-secondary-color);
    }
    #finalsWizardRoot .wizard-progress .step.active {
        background: var(--bs-primary);
        color: #fff;
        border-color: var(--bs-primary);
    }
    #finalsWizardRoot .wizard-progress .step.done {
        background: var(--bs-success-bg-subtle);
        border-color: var(--bs-success);
        color: var(--bs-success-text-emphasis);
    }
    #finalsWizardRoot .step-pane { display: none; }
    #finalsWizardRoot .step-pane.active { display: block; }
</style>

<div class="competition-finals-start-list-management mt-4" data-competition-id="@competitionId">

    <!-- What this is -->
    <div class="alert alert-secondary d-flex align-items-start gap-2 mb-3">
        <i class="bi bi-info-circle mt-1"></i>
        <div class="small mb-0">
            <strong>Finalsstartlistan bestämmer i vilken ordning skyttarna står när ni matar in finalens resultat</strong>
            (serie F1 och framåt). Välj hur finalen ska ställas upp nedan — för de flesta tävlingar räcker de två
            första valen.
        </div>
    </div>

    <!-- Readiness ladder — always visible; rows injected by JS -->
    <div id="finalsReadiness" class="mb-3"></div>

    <!-- Loading -->
    <div id="finalsStartListLoading" class="text-center py-3 d-none">
        <div class="spinner-border spinner-border-sm" role="status"></div>
        <small class="ms-2 text-muted">Laddar finalsstartlista...</small>
    </div>

    <!-- Mode chooser -->
    <div id="finalsModeChooser" class="mb-3 d-none">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-success">
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title"><i class="bi bi-arrow-right-circle me-1 text-success"></i>Fortsätt i samma ordning</h6>
                        <p class="card-text small text-muted flex-grow-1">
                            Alla skyttar fortsätter i <strong>samma skjutlag och ordning som i kvalet</strong>.
                            Enklast — inget behöver gallras eller frysas.
                        </p>
                        <button type="button" class="btn btn-success btn-sm mt-2" id="btnFinalsModeClone">
                            <i class="bi bi-check2 me-1"></i>Skapa final – samma ordning
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-primary">
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title"><i class="bi bi-sort-numeric-down me-1 text-primary"></i>Placera om efter resultat</h6>
                        <p class="card-text small text-muted flex-grow-1">
                            Skyttarna placeras om efter kvalresultatet — <strong>en final per vapengrupp</strong>
                            (A, B, C … var för sig, bäst poäng först).
                        </p>
                        <button type="button" class="btn btn-primary btn-sm mt-2" id="btnFinalsModeRerank">
                            <i class="bi bi-check2 me-1"></i>Skapa final – efter resultat
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title"><i class="bi bi-trophy me-1 text-warning"></i>Mästerskapsfinal (avancerad)</h6>
                        <p class="card-text small text-muted flex-grow-1">
                            Gallra till final (topp 1/6, minst 10) med <strong>frysning per klass</strong> och egna
                            skjutlag. För mästerskap där bara de bästa går vidare.
                        </p>
                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" id="btnOpenFinalsWizard">
                            <i class="bi bi-sliders me-1"></i>Öppna guiden
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Official finals start list card -->
    <div class="card d-none" id="officialFinalsStartListSection">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0"><i class="bi bi-trophy me-2 text-warning"></i>Finalsstartlista</h5>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="badge bg-warning fs-6 px-3 py-2" id="finalsStartListStatusBadge">
                        <i class="bi bi-exclamation-triangle me-1"></i>Preliminär
                    </span>
                    <button class="btn btn-success btn-sm" id="btnPublishFinalsStartList">
                        <i class="bi bi-check-circle me-1"></i>Publicera
                    </button>
                    <button class="btn btn-outline-warning btn-sm d-none" id="btnUnpublishFinalsStartList">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Avpublicera
                    </button>
                    <span class="text-muted">
                        <small><i class="bi bi-people me-1"></i><span id="finalsStartListFinalistCount">0</span> finalister</small>
                        <small class="ms-2"><i class="bi bi-grid me-1"></i><span id="finalsStartListTeamCount">0</span> skjutlag</small>
                    </span>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="alert alert-info mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <small class="text-muted">Metod:</small>
                        <strong id="finalsStartListFormatLabel">Final</strong>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Genererad:</small>
                        <strong id="finalsStartListGeneratedDate"></strong>
                    </div>
                    <div class="col-md-3">
                        <small class="text-muted">Av:</small>
                        <strong id="finalsStartListGeneratedBy"></strong>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end mb-3 flex-wrap gap-2">
                <button class="btn btn-outline-secondary" id="btnFinalsRedo">
                    <i class="bi bi-arrow-repeat me-1"></i>Skapa om / byt metod
                </button>
                <button class="btn btn-outline-info" id="btnEditFinalsStartList">
                    <i class="bi bi-pencil-square me-1"></i>Redigera
                </button>
                <button class="btn btn-outline-primary" id="btnOpenFinalsStartListNewTab">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Öppna i ny flik
                </button>
            </div>
            <iframe id="finalsStartListIframe" src="" class="border rounded" style="width: 100%; height: 800px; display: none;"></iframe>
        </div>
    </div>

    <!-- =====================================================================
         Wizard modal — Lås grupper → Konfigurera grupper → Generera
         ===================================================================== -->
    <div class="modal fade" id="generateFinalsStartListModal" tabindex="-1" aria-hidden="true" id-root="finalsWizardRoot">
        <div class="modal-dialog modal-xl modal-fullscreen-md-down">
            <div class="modal-content" id="finalsWizardRoot">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-trophy me-2 text-warning"></i>Mästerskapsfinal – guide</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                </div>
                <div class="modal-body">

                    <div class="wizard-progress">
                        <div class="step active" data-step="1">1. Lås kvalresultat</div>
                        <div class="step" data-step="2">2. Konfigurera grupper</div>
                        <div class="step" data-step="3">3. Generera</div>
                    </div>

                    <!-- STEP 1 — Per-group lock -->
                    <div class="step-pane active" data-step="1">
                        <p class="text-muted small mb-3">
                            Lås kvalresultatet för varje grupp i resultatlistan när dess kvalrundor är klara.
                            Grupperna kommer från resultatlistan — om du har slagit ihop klasser där så ses de
                            som <em>en</em> grupp här också. Du kan låsa grupperna i valfri ordning.
                        </p>
                        <div id="noResultListMsg" class="alert alert-warning small" style="display:none">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Resultatlistan måste genereras först.</strong> Gå till fliken "Resultat",
                            klicka "Uppdatera" för att skapa preliminärresultat (med eventuella klass-sammanslagningar),
                            och kom sedan tillbaka hit för att låsa varje grupp inför finalen.
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead>
                                    <tr>
                                        <th>Grupp</th>
                                        <th>Skyttar</th>
                                        <th>Låsstatus</th>
                                        <th class="text-end">Åtgärd</th>
                                    </tr>
                                </thead>
                                <tbody id="freezeTableBody">
                                    <tr><td colspan="4" class="text-muted text-center">Laddar...</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- STEP 2 — Per-group config -->
                    <div class="step-pane" data-step="2">
                        <p class="text-muted small mb-3">
                            För varje låst grupp: välj vilket skjutlag den ska ligga i, och om flera grupper
                            delar ett skjutlag — vilken ordning. <strong>Skytten som leder en grupp hamnar
                            alltid först i sitt gruppblock.</strong> Exempel: C (skjutlag 1, ordning 0) får
                            positioner 1–10, C Vet Y (skjutlag 1, ordning 1) får 11–17.
                        </p>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" id="configTable">
                                <thead>
                                    <tr>
                                        <th>Grupp</th>
                                        <th>Skjutlag #</th>
                                        <th>Ordning i skjutlag</th>
                                        <th>Antal finalister</th>
                                        <th>Alla skjuter</th>
                                        <th>Hoppa över</th>
                                        <th>Förhandsvisning</th>
                                    </tr>
                                </thead>
                                <tbody id="configTableBody">
                                    <tr><td colspan="7" class="text-muted text-center">Lås minst en grupp i Steg 1 först.</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- STEP 3 — Generate settings -->
                    <div class="step-pane" data-step="3">
                        <p class="text-muted small mb-3">
                            Generera finalsstartlistan från de låsta grupperna och din konfiguration.
                        </p>
                        <div class="alert alert-warning small d-none" id="wizardGateMsg">
                            <i class="bi bi-lock me-1"></i>
                            Lås minst en grupp i <strong>Steg 1</strong> innan du kan generera.
                        </div>
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-auto">
                                <label class="form-label small mb-0">Första starttid</label>
                                <input type="text" class="form-control form-control-sm" id="finalsFirstStartTime" value="10:00" style="max-width:120px">
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Intervall (h:mm)</label>
                                <input type="text" class="form-control form-control-sm" id="finalsStartInterval" value="1:45" style="max-width:100px">
                            </div>
                            <div class="col-auto">
                                <label class="form-label small mb-0">Max skyttar/skjutlag</label>
                                <input type="number" class="form-control form-control-sm" id="finalsMaxShootersPerTeam" value="20" min="1" max="60" style="max-width:100px">
                            </div>
                        </div>
                        <div class="alert alert-warning small d-none" id="generateOverwriteWarning">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            En finalsstartlista finns redan. Generering skriver över eventuella manuella ändringar.
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary me-auto" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn btn-outline-secondary" id="wizardBackBtn" disabled>
                        <i class="bi bi-arrow-left me-1"></i>Tillbaka
                    </button>
                    <button type="button" class="btn btn-primary" id="wizardNextBtn">
                        Nästa <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                    <button type="button" class="btn btn-success d-none" id="wizardGenerateBtn">
                        <i class="bi bi-lightning me-1"></i>Generera
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const root = document.querySelector('.competition-finals-start-list-management');
    if (!root) return;
    const competitionId = parseInt(root.dataset.competitionId, 10);
    if (!competitionId) return;

    // ---- helpers ----
    function token() { const el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
    function jpost(url, body) {
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        }).then(async r => {
            if (!r.ok) {
                const text = await r.text().catch(() => '');
                console.error('[finals] POST failed', url, r.status, text);
                alert(`Begäran misslyckades (${r.status}). Se konsollen för detaljer.`);
                return { success: false, message: `HTTP ${r.status}` };
            }
            try { return await r.json(); } catch (e) {
                console.error('[finals] response not JSON', url, e);
                return { success: false, message: 'Ogiltigt svar.' };
            }
        }).catch(err => {
            console.error('[finals] network error', url, err);
            return { success: false, message: err.message };
        });
    }
    function jget(url) {
        return fetch(url).then(async r => {
            if (!r.ok) { console.error('[finals] GET failed', url, r.status); return { success: false }; }
            try { return await r.json(); } catch (e) { console.error('[finals] GET not JSON', url, e); return { success: false }; }
        }).catch(err => { console.error('[finals] GET network error', url, err); return { success: false }; });
    }

    // ---- state ----
    let finalsListInfo = null;   // last GetFinalsStartList response
    let perClassState = [];      // last GetQualifyingSnapshot perClass array
    let perClassConfig = {};     // last GetFinalsConfig config dict (mutated by Step 2)
    let hasResultList = false;
    let currentStep = 1;
    let editorOpenForFinalsId = null;  // tracks when the shared editor is being used for finals

    // ---- card load + render ----
    // Single source of truth: pull the finals list + qualifying readiness together, then
    // render the ladder, the mode chooser (when no list yet) or the official card.
    async function refreshAll() {
        showLoading();
        const [finals, readiness] = await Promise.all([
            jget(`/umbraco/surface/PrecisionStartList/GetFinalsStartList?competitionId=${competitionId}`),
            jget(`/umbraco/surface/PrecisionStartList/GetQualifyingSnapshot?competitionId=${competitionId}`)
        ]);

        hasResultList = !!(readiness && readiness.hasResultList);
        perClassState = (readiness && readiness.perClass) || [];

        const exists = finals && (finals.Exists || finals.exists);
        document.getElementById('finalsStartListLoading').classList.add('d-none');
        if (exists) {
            finalsListInfo = finals;
            renderOfficialCard();
            hideChooser();
        } else {
            finalsListInfo = null;
            document.getElementById('officialFinalsStartListSection').classList.add('d-none');
            showChooser();
        }
        renderReadiness();
    }

    // Back-compat alias — the wizard + editor-close hook call loadFinalsStartList().
    async function loadFinalsStartList() { await refreshAll(); }

    function showLoading() {
        document.getElementById('finalsStartListLoading').classList.remove('d-none');
    }
    function showChooser() { document.getElementById('finalsModeChooser').classList.remove('d-none'); }
    function hideChooser() { document.getElementById('finalsModeChooser').classList.add('d-none'); }

    // ---- readiness ladder ----
    function readinessRow(done, label, hint) {
        const icon = done
            ? '<i class="bi bi-check-circle-fill text-success"></i>'
            : '<i class="bi bi-circle text-muted"></i>';
        const hintHtml = hint ? ` <span class="text-muted">— ${hint}</span>` : '';
        return `<div class="d-flex align-items-center gap-2 py-1 small">${icon}<span>${label}${hintHtml}</span></div>`;
    }
    function renderReadiness() {
        const el = document.getElementById('finalsReadiness');
        if (!el) return;
        const exists = !!finalsListInfo;
        const isOfficial = exists && (finalsListInfo.IsOfficial || finalsListInfo.isOfficial);
        el.innerHTML =
            readinessRow(hasResultList, 'Resultat registrerade',
                hasResultList ? '' : 'mata in kvalresultat på fliken Resultat först') +
            readinessRow(exists, 'Finalsstartlista skapad',
                exists ? '' : 'välj en metod nedan') +
            readinessRow(isOfficial, 'Publicerad',
                (exists && !isOfficial) ? 'klicka Publicera när listan är klar' : '');
    }

    function renderOfficialCard() {
        const card = document.getElementById('officialFinalsStartListSection');
        card.classList.remove('d-none');

        const id = finalsListInfo.FinalsStartListId || finalsListInfo.finalsStartListId;
        const isOfficial = finalsListInfo.IsOfficial || finalsListInfo.isOfficial;
        const total = finalsListInfo.TotalFinalists || finalsListInfo.totalFinalists || 0;
        const gen = finalsListInfo.GeneratedDate || finalsListInfo.generatedDate;
        const fmt = finalsListInfo.TeamFormat || finalsListInfo.teamFormat || '';
        const sl = finalsListInfo.StartList || finalsListInfo.startList;
        const teams = (sl && (sl.Teams || sl.teams)) || [];

        const fmtLabel = fmt === 'Final' ? 'Samma ordning som kvalet' : 'Rangordnad efter kvalresultat';
        document.getElementById('finalsStartListFormatLabel').textContent = fmtLabel;
        document.getElementById('finalsStartListFinalistCount').textContent = total;
        document.getElementById('finalsStartListTeamCount').textContent = teams.length;
        document.getElementById('finalsStartListGeneratedDate').textContent = gen ? new Date(gen).toLocaleString('sv-SE') : '';
        // GeneratedBy isn't always present in the response; leave blank if absent.
        document.getElementById('finalsStartListGeneratedBy').textContent = '';

        const badge = document.getElementById('finalsStartListStatusBadge');
        if (isOfficial) {
            badge.className = 'badge bg-success fs-6 px-3 py-2';
            badge.innerHTML = '<i class="bi bi-check-circle me-1"></i>Publicerad';
        } else {
            badge.className = 'badge bg-warning fs-6 px-3 py-2';
            badge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Preliminär';
        }
        document.getElementById('btnPublishFinalsStartList').classList.toggle('d-none', isOfficial);
        document.getElementById('btnUnpublishFinalsStartList').classList.toggle('d-none', !isOfficial);

        const iframe = document.getElementById('finalsStartListIframe');
        const ts = Date.now();
        iframe.src = `/umbraco/Surface/PrecisionStartList/PreviewStartList?competitionId=${competitionId}&startListId=${id}&t=${ts}`;
        iframe.style.display = 'block';
    }

    // ---- card actions ----
    async function togglePublish(makeOfficial) {
        if (!finalsListInfo) return;
        const id = finalsListInfo.FinalsStartListId || finalsListInfo.finalsStartListId;
        const verb = makeOfficial ? 'Publicera' : 'Avpublicera';
        if (!confirm(`${verb} finalsstartlistan?`)) return;
        const d = await jpost('/umbraco/surface/PrecisionStartList/PublishFinalsStartList',
            { FinalsStartListId: id, IsPublished: makeOfficial });
        if (!d.success) { alert(d.message || 'Kunde inte ändra status.'); return; }
        await loadFinalsStartList();
    }
    function openInNewTab() {
        if (!finalsListInfo) return;
        const id = finalsListInfo.FinalsStartListId || finalsListInfo.finalsStartListId;
        window.open(`/umbraco/Surface/PrecisionStartList/PreviewStartList?competitionId=${competitionId}&startListId=${id}`, '_blank');
    }
    function openFinalsEditor() {
        if (!finalsListInfo) return;
        const id = finalsListInfo.FinalsStartListId || finalsListInfo.finalsStartListId;
        if (typeof window.openStartListEditor !== 'function') {
            alert('Startlistredigeraren är inte tillgänglig. Den initialiseras när Startlistor-fliken läses in.');
            return;
        }
        editorOpenForFinalsId = id;
        window.openStartListEditor(id);
    }

    // ---- one-click modes (no freeze / no cut) ----
    async function generateSimple(mode) {
        const label = mode === 'clone' ? 'samma ordning som kvalet' : 'omplacering efter kvalresultat';
        if (finalsListInfo && !confirm('En finalsstartlista finns redan. Skapa om med ' + label + '?\n\nManuella ändringar i listan skrivs över.')) return;
        showLoading();
        const d = await jpost('/umbraco/surface/PrecisionStartList/GenerateSimpleFinalsStartList', {
            CompetitionId: competitionId,
            Mode: mode,
            FirstStartTime: '10:00',
            StartInterval: '1:45',
            MaxShootersPerTeam: 20
        });
        const ok = d.Success ?? d.success;
        if (!ok) { alert((d.Message ?? d.message) || 'Kunde inte skapa finalen.'); await refreshAll(); return; }
        await refreshAll();
    }

    // Refresh the finals card after the shared editor closes — only if it was opened for finals.
    function attachEditorCloseHook() {
        const editorEl = document.getElementById('startListEditorModal');
        if (!editorEl || editorEl.dataset.finalsHookAttached === '1') return;
        editorEl.dataset.finalsHookAttached = '1';
        editorEl.addEventListener('hidden.bs.modal', function () {
            if (editorOpenForFinalsId) {
                const closedForFinals = editorOpenForFinalsId;
                editorOpenForFinalsId = null;
                // Slight delay so the editor's own state writes settle first.
                setTimeout(() => loadFinalsStartList(), 50);
            }
        });
    }

    // ---- wizard ----
    function openWizard() {
        currentStep = 1;
        showStep(1);
        Promise.all([loadFreezeState(), loadFinalsConfig()]).then(() => {
            const m = bootstrap.Modal.getOrCreateInstance(document.getElementById('generateFinalsStartListModal'));
            m.show();
            updateGenerateWarning();
        });
    }
    function showStep(step) {
        currentStep = step;
        document.querySelectorAll('#finalsWizardRoot .step-pane').forEach(p => {
            p.classList.toggle('active', parseInt(p.dataset.step, 10) === step);
        });
        document.querySelectorAll('#finalsWizardRoot .wizard-progress .step').forEach(s => {
            const n = parseInt(s.dataset.step, 10);
            s.classList.toggle('active', n === step);
            s.classList.toggle('done', n < step);
        });
        document.getElementById('wizardBackBtn').disabled = step === 1;
        const nextBtn = document.getElementById('wizardNextBtn');
        const genBtn = document.getElementById('wizardGenerateBtn');
        if (step === 3) {
            nextBtn.classList.add('d-none');
            genBtn.classList.remove('d-none');
            // Explicit gate: can't generate until at least one group is frozen.
            const frozenCount = perClassState.filter(s => s.frozen).length;
            genBtn.disabled = frozenCount === 0;
            document.getElementById('wizardGateMsg').classList.toggle('d-none', frozenCount > 0);
        } else {
            nextBtn.classList.remove('d-none');
            genBtn.classList.add('d-none');
            genBtn.disabled = false;
        }
    }

    // ---- step 1: per-group freeze ----
    async function loadFreezeState() {
        const d = await jget(`/umbraco/surface/PrecisionStartList/GetQualifyingSnapshot?competitionId=${competitionId}`);
        if (!d.success) return;
        hasResultList = !!d.hasResultList;
        perClassState = d.perClass || [];
        renderFreezeTable();
    }
    function renderFreezeTable() {
        const tbody = document.getElementById('freezeTableBody');
        const noResultListMsg = document.getElementById('noResultListMsg');
        noResultListMsg.style.display = (!hasResultList && perClassState.length === 0) ? '' : 'none';

        if (!perClassState.length) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-muted text-center">Inga grupper hittades — generera resultatlistan först.</td></tr>';
            return;
        }
        tbody.innerHTML = '';
        perClassState.forEach(s => {
            const groupName = s.groupName || s.championshipClass;
            const tr = document.createElement('tr');
            let stateCell = '<span class="badge bg-secondary"><i class="bi bi-unlock me-1"></i>Inte låst</span>';
            if (s.frozen) {
                const lockedText = `${new Date(s.frozenAt).toLocaleString('sv-SE')} av ${s.frozenBy}`;
                stateCell = `<span class="badge bg-success"><i class="bi bi-lock-fill me-1"></i>Låst</span> <small class="text-muted ms-2">${lockedText} • ${s.frozenShooterCount} skyttar</small>`;
                if (s.stale) stateCell += ' <span class="badge bg-danger ms-2">Inaktuell — resultaten har ändrats</span>';
            }
            let actionCell;
            if (!s.hasResults && !s.frozen) {
                actionCell = '<span class="text-muted small">Inga resultat</span>';
            } else if (s.frozen) {
                actionCell = `<button class="btn btn-outline-warning btn-sm" data-action="unlock" data-cls="${groupName}"><i class="bi bi-unlock-fill me-1"></i>Lås upp</button>
                              <button class="btn btn-outline-primary btn-sm ms-1" data-action="relock" data-cls="${groupName}"><i class="bi bi-arrow-clockwise me-1"></i>Uppdatera</button>`;
            } else {
                actionCell = `<button class="btn btn-primary btn-sm" data-action="lock" data-cls="${groupName}"><i class="bi bi-lock-fill me-1"></i>Lås</button>`;
            }
            tr.innerHTML = `<td><strong>${groupName}</strong></td>
                            <td>${s.totalShooters}</td>
                            <td>${stateCell}</td>
                            <td class="text-end">${actionCell}</td>`;
            tbody.appendChild(tr);
        });
        tbody.querySelectorAll('button[data-action]').forEach(b => b.addEventListener('click', onFreezeAction));
    }
    async function onFreezeAction(e) {
        const btn = e.currentTarget;
        const action = btn.dataset.action;
        const cls = btn.dataset.cls;
        if (action === 'unlock') {
            if (!confirm(`Lås upp gruppen ${cls}?`)) return;
            const d = await jpost('/umbraco/surface/PrecisionStartList/UnfreezeClassResults',
                { CompetitionId: competitionId, ChampionshipClass: cls });
            if (!d.success && d.message) alert(d.message);
        } else {
            // 'lock' and 'relock' both call the freeze endpoint (re-locks captures any new results).
            const d = await jpost('/umbraco/surface/PrecisionStartList/FreezeClassResults',
                { CompetitionId: competitionId, ChampionshipClass: cls });
            if (!d.success && d.message) alert(d.message);
        }
        await loadFreezeState();
    }

    // ---- step 2: per-group config ----
    async function loadFinalsConfig() {
        const d = await jget(`/umbraco/surface/PrecisionStartList/GetFinalsConfig?competitionId=${competitionId}`);
        if (d.success) perClassConfig = d.config || {};
    }
    function renderConfigTable() {
        const tbody = document.getElementById('configTableBody');
        const frozen = perClassState.filter(s => s.frozen);
        if (!frozen.length) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-muted text-center">Lås minst en grupp i Steg 1 först.</td></tr>';
            return;
        }
        tbody.innerHTML = '';
        let autoSkjutlag = 1;
        frozen.forEach(s => {
            const groupName = s.groupName || s.championshipClass;
            const cfg = perClassConfig[groupName] || {};
            const defaultSkjutlag = cfg.skjutlagNumber || autoSkjutlag++;
            const tr = document.createElement('tr');
            tr.dataset.cls = groupName;
            tr.innerHTML = `
                <td><strong>${groupName}</strong><br><small class="text-muted">${s.frozenShooterCount} skyttar</small></td>
                <td><input type="number" min="1" max="20" class="form-control form-control-sm cfg-skjutlag" value="${defaultSkjutlag}" style="max-width:80px"></td>
                <td><input type="number" min="0" max="20" class="form-control form-control-sm cfg-order" value="${cfg.orderInSkjutlag || 0}" style="max-width:80px"></td>
                <td><input type="number" min="1" class="form-control form-control-sm cfg-count" placeholder="Auto" value="${cfg.finalistCountOverride != null ? cfg.finalistCountOverride : ''}" style="max-width:90px"></td>
                <td class="text-center"><input type="checkbox" class="form-check-input cfg-all" ${cfg.includeAllShooters ? 'checked' : ''}></td>
                <td class="text-center"><input type="checkbox" class="form-check-input cfg-skip" ${cfg.skip ? 'checked' : ''}></td>
                <td class="preview-cell text-muted">-</td>`;
            tbody.appendChild(tr);
        });
        tbody.querySelectorAll('input').forEach(el => el.addEventListener('change', onConfigChange));
        readConfigFromTable();
        previewBuckets();
    }
    function readConfigFromTable() {
        document.querySelectorAll('#configTableBody tr[data-cls]').forEach(tr => {
            const group = tr.dataset.cls;
            const countStr = tr.querySelector('.cfg-count').value.trim();
            perClassConfig[group] = {
                skip: tr.querySelector('.cfg-skip').checked,
                skjutlagNumber: parseInt(tr.querySelector('.cfg-skjutlag').value, 10) || 1,
                orderInSkjutlag: parseInt(tr.querySelector('.cfg-order').value, 10) || 0,
                finalistCountOverride: countStr === '' ? null : parseInt(countStr, 10),
                includeAllShooters: tr.querySelector('.cfg-all').checked
            };
        });
    }
    function onConfigChange() { readConfigFromTable(); previewBuckets(); }
    async function previewBuckets() {
        const d = await jpost('/umbraco/surface/PrecisionStartList/PreviewFinalsConfig',
            { CompetitionId: competitionId, Config: perClassConfig });
        if (!d.success) return;
        document.querySelectorAll('#configTableBody tr[data-cls]').forEach(tr => {
            const group = tr.dataset.cls;
            const cell = tr.querySelector('.preview-cell');
            const info = d.perClass[group];
            if (!info) { cell.textContent = '-'; return; }
            if (info.skjutlag == null) { cell.innerHTML = '<span class="badge bg-secondary">Hoppas över</span>'; return; }
            cell.innerHTML = `<span class="badge bg-info">Skjutlag ${info.skjutlag}</span> <span class="text-muted small">${info.finalistCount} av ${info.totalInClass}</span>`;
        });
    }

    // ---- step 3: generate ----
    function updateGenerateWarning() {
        document.getElementById('generateOverwriteWarning').classList.toggle('d-none', !finalsListInfo);
    }
    async function doGenerate() {
        const lockedCount = perClassState.filter(s => s.frozen).length;
        if (lockedCount === 0) {
            alert('Inga grupper är låsta. Gå tillbaka till Steg 1 och lås minst en grupp.');
            return;
        }
        if (finalsListInfo && !confirm('En finalsstartlista finns redan. Generera om?\n\nManuella ändringar skrivs över.')) return;

        // Save config (handles the case where Step 2 wasn't touched).
        const saveResp = await jpost('/umbraco/surface/PrecisionStartList/SaveFinalsConfig',
            { CompetitionId: competitionId, Config: perClassConfig });
        if (!saveResp.success) { alert('Kunde inte spara konfigurationen: ' + (saveResp.message || '')); return; }

        const body = {
            CompetitionId: competitionId,
            FirstStartTime: document.getElementById('finalsFirstStartTime').value,
            StartInterval: document.getElementById('finalsStartInterval').value,
            MaxShootersPerTeam: parseInt(document.getElementById('finalsMaxShootersPerTeam').value, 10) || 20
        };
        const genResp = await jpost('/umbraco/surface/PrecisionStartList/GenerateFinalsStartList', body);
        const ok = genResp.Success ?? genResp.success;
        const message = genResp.Message ?? genResp.message ?? (ok ? 'OK' : 'Okänt fel');
        if (!ok) { alert(message); return; }

        // Close modal, refresh card.
        const modalInst = bootstrap.Modal.getInstance(document.getElementById('generateFinalsStartListModal'));
        if (modalInst) modalInst.hide();
        await loadFinalsStartList();
    }

    // ---- wiring ----
    document.getElementById('btnOpenFinalsWizard').addEventListener('click', openWizard);
    document.getElementById('btnFinalsModeClone').addEventListener('click', () => generateSimple('clone'));
    document.getElementById('btnFinalsModeRerank').addEventListener('click', () => generateSimple('rerank'));
    document.getElementById('btnFinalsRedo').addEventListener('click', showChooser);
    document.getElementById('btnPublishFinalsStartList').addEventListener('click', () => togglePublish(true));
    document.getElementById('btnUnpublishFinalsStartList').addEventListener('click', () => togglePublish(false));
    document.getElementById('btnEditFinalsStartList').addEventListener('click', openFinalsEditor);
    document.getElementById('btnOpenFinalsStartListNewTab').addEventListener('click', openInNewTab);
    document.getElementById('wizardBackBtn').addEventListener('click', () => { if (currentStep > 1) showStep(currentStep - 1); });
    document.getElementById('wizardNextBtn').addEventListener('click', async () => {
        if (currentStep === 1) {
            showStep(2);
            renderConfigTable();
        } else if (currentStep === 2) {
            const saveResp = await jpost('/umbraco/surface/PrecisionStartList/SaveFinalsConfig',
                { CompetitionId: competitionId, Config: perClassConfig });
            if (!saveResp.success) { alert(saveResp.message || 'Kunde inte spara.'); return; }
            showStep(3);
            updateGenerateWarning();
        }
    });
    document.getElementById('wizardGenerateBtn').addEventListener('click', doGenerate);

    // Hook editor close once the standard partial has loaded the editor modal.
    attachEditorCloseHook();
    // Retry once after a short delay in case the standard partial JS runs after us.
    setTimeout(attachEditorCloseHook, 500);

    // ---- init ----
    refreshAll();
})();
</script>
