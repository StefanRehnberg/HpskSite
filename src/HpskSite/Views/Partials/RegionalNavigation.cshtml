@{
    var isRegionalAdmin = ViewBag.isRegionalAdmin as bool? ?? false;
    var isLoggedIn = ViewBag.isLoggedIn as bool? ?? false;
}

<ul class="nav nav-tabs mb-4" id="regionPageTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="regionHome-tab" data-bs-toggle="tab" data-bs-target="#regionHome" type="button" role="tab" aria-controls="regionHome" aria-selected="true">
            <i class="bi bi-house-fill me-2"></i>Hem
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="regionAbout-tab" data-bs-toggle="tab" data-bs-target="#regionAbout" type="button" role="tab" aria-controls="regionAbout" aria-selected="false">
            <i class="bi bi-info-circle me-2"></i>Om
        </button>
    </li>
    @if (isLoggedIn)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionDocuments-tab" data-bs-toggle="tab" data-bs-target="#regionDocuments" type="button" role="tab" aria-controls="regionDocuments" aria-selected="false">
                <i class="bi bi-archive me-2"></i>Dokument
            </button>
        </li>
    }
    @if (isRegionalAdmin)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="regionAdmin-tab" data-bs-toggle="tab" data-bs-target="#regionAdmin" type="button" role="tab" aria-controls="regionAdmin" aria-selected="false">
                <i class="bi bi-shield-check me-2"></i>Administration
            </button>
        </li>
        <li class="nav-item ms-auto" role="presentation">
            <button class="btn btn-sm btn-outline-primary align-self-center mt-1" onclick="TutorialHelper.open('tutorial-06')" title="Se instruktionsvideo för kretsadministratörer">
                <i class="bi bi-play-circle me-1"></i>Guide
            </button>
        </li>
    }
</ul>
