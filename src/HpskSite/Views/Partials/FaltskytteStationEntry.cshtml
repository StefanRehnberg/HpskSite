@*
 * Fältskytte Station Entry — Mobile-Optimized
 * Tap-button hit entry, one shooter at a time, large touch targets.
 *@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
}

<style>
    .fse-hit-btn { min-width:44px; min-height:44px; font-size:1.1em; font-weight:bold; }
    .fse-hit-btn.active { background-color:var(--bs-primary); color:white; border-color:var(--bs-primary); }
    .fse-save-btn { height:56px; font-size:1.2em; }
    .fse-nav-btn { min-width:48px; min-height:48px; font-size:1.1em; }
    .fse-patrol-row { min-height:60px; cursor:pointer; }
    .fse-pm-input { height:48px; font-size:1.2em; }
    .fse-figure-card { border:1px solid var(--bs-border-color); border-radius:8px; padding:12px; margin-bottom:8px; background:var(--bs-body-bg); }
    .fse-pm-tap { min-width:60px; min-height:44px; font-size:1.2em; font-weight:bold; }
    #fseKeypad { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:1080; display:none; align-items:center; justify-content:center; }
    #fseKeypad.show { display:flex; }
    #fseKeypad .kp-body { background:var(--bs-body-bg); border-radius:12px; padding:20px; max-width:300px; width:90%; box-shadow:0 8px 32px rgba(0,0,0,0.3); }
    #fseKeypad .kp-display { font-size:2.5em; font-weight:bold; text-align:center; min-height:60px; line-height:60px; border-bottom:2px solid var(--bs-border-color); margin-bottom:12px; }
    #fseKeypad .kp-btn { width:70px; height:60px; font-size:1.5em; font-weight:bold; border-radius:8px; }
</style>

@{
    var presetStation = ViewData["PresetStationNumber"]?.ToString() ?? "";
    var isSelfService = ViewData["IsSelfService"] is bool b && b;
    var presetPatrolId = ViewData["PresetPatrolId"]?.ToString() ?? "";
    var presetPatrolNumber = ViewData["PresetPatrolNumber"]?.ToString() ?? "";
    var presetPatrolWeapon = ViewData["PresetPatrolWeapon"]?.ToString() ?? "";
}
<div class="faltskytte-station-entry"
     data-competition-id="@competitionId"
     data-preset-station="@presetStation"
     data-self-service="@(isSelfService ? "1" : "0")"
     data-preset-patrol-id="@presetPatrolId"
     data-preset-patrol-number="@presetPatrolNumber"
     data-preset-patrol-weapon="@presetPatrolWeapon">

<!-- Numeric keypad overlay for Poängräkning -->
<div id="fseKeypad" onclick="if(event.target===this)fseKeypadCancel()">
    <div class="kp-body">
        <div class="text-center small fw-bold text-muted mb-1">Po&auml;ngr&auml;kning</div>
        <div class="kp-display" id="fseKpDisplay">0</div>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(1)">1</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(2)">2</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(3)">3</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(4)">4</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(5)">5</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(6)">6</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(7)">7</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(8)">8</button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(9)">9</button>
            <button class="btn btn-outline-warning kp-btn" onclick="fseKeypadBackspace()"><i class="bi bi-backspace"></i></button>
            <button class="btn btn-outline-secondary kp-btn" onclick="fseKeypadDigit(0)">0</button>
            <button class="btn btn-success kp-btn" onclick="fseKeypadOk()">OK</button>
        </div>
    </div>
</div>

    <!-- Screen 1: Station + Patrol Selection -->
    <div id="fseSelectScreen">
        <div class="mb-3">
            <label for="fseStationSelect" class="form-label fw-bold fs-5">Station</label>
            <select class="form-select form-select-lg" id="fseStationSelect" onchange="fseLoadStation()">
                <option value="">Välj station...</option>
            </select>
        </div>
        <div id="fsePatrolList"></div>
    </div>

    <!-- Screen 1.5: Roll Call -->
    <div id="fseRollCallScreen" style="display:none">
        <div class="d-flex align-items-center justify-content-between mb-3 p-2 rounded" style="background:var(--bs-warning-bg-subtle); border:2px solid var(--bs-warning-border-subtle)">
            <button class="btn btn-outline-secondary btn-sm" onclick="fseBackFromRollCall()">
                <i class="bi bi-arrow-left me-1"></i>Patrullistan
            </button>
            <span class="fw-bold fs-5" id="fseRcStationLabel"></span>
            <span class="badge bg-info fs-6" id="fseRcPatrolLabel"></span>
        </div>

        <!-- Förutsättningar (shown during roll call for station chief to read aloud) -->
        <div class="card mb-3">
            <div class="card-header py-2">
                <span class="fw-bold small"><i class="bi bi-clipboard-check me-1"></i>Förutsättningar</span>
            </div>
            <div id="fseRcFpBody" class="card-body py-2 small"></div>
        </div>

        <!-- Roll call list -->
        <div class="card mb-3">
            <div class="card-header py-2">
                <span class="fw-bold small"><i class="bi bi-people me-1"></i>Upprop</span>
                <span class="small text-muted ms-2" id="fseRcCount"></span>
            </div>
            <div class="card-body p-0" id="fseRcList"></div>
        </div>

        <button class="btn btn-primary w-100 fse-save-btn" onclick="fseStartEntry()">
            <i class="bi bi-pencil-square me-1"></i>Starta resultatinmatning
        </button>
    </div>

    <!-- Screen 2: Shooter Entry -->
    <div id="fseEntryScreen" style="display:none">

        <!-- Station header + back button -->
        <div class="d-flex align-items-center justify-content-between mb-2 p-2 rounded" style="background:var(--bs-warning-bg-subtle); border:2px solid var(--bs-warning-border-subtle)">
            <button class="btn btn-outline-secondary btn-sm" onclick="fseBackToRollCall()">
                <i class="bi bi-arrow-left me-1"></i>Upprop
            </button>
            <span class="fw-bold fs-5" id="fseStationLabel"></span>
            <span class="badge bg-info fs-6" id="fsePatrolLabel"></span>
        </div>

        <!-- Navigation bar -->
        <div class="mb-2 bg-body-tertiary rounded p-2">
            <div class="mb-2">
                <div class="fw-bold fs-5" id="fseShooterName" style="word-break:break-word"></div>
                <div class="small text-muted" id="fseShooterInfo" style="word-break:break-word"></div>
            </div>
            <div class="d-flex align-items-center">
                <button class="btn btn-outline-secondary fse-nav-btn flex-shrink-0" onclick="fseNavPrev()" id="fsePrevBtn">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span id="fseShooterPosition" class="fw-bold mx-2 flex-shrink-0" style="font-size:2.5em;line-height:1;min-width:40px;text-align:center"></span>
                <span id="fseRunningTotal" class="fw-bold text-nowrap mx-auto" style="font-size:2.5em;line-height:1">0/0</span>
                <span id="fseShooterSavedBadge" class="badge bg-success flex-shrink-0 me-2" style="display:none">Sparad</span>
                <span id="fseShooterDirtyBadge" class="badge bg-warning text-dark flex-shrink-0 me-2" style="display:none">Osparad</span>
                <button class="btn btn-outline-secondary fse-nav-btn flex-shrink-0" onclick="fseNavNext()" id="fseNextBtn">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>

        <!-- Figure entry area -->
        <div id="fseFigureArea"></div>

        <!-- Save button -->
        <button class="btn btn-success w-100 fse-save-btn mb-2" onclick="fseSave()" id="fseSaveBtn">
            <i class="bi bi-check-circle me-1"></i>SPARA RESULTAT
        </button>

        <!-- Reshoot (below save — single toggle button) -->
        <div id="fseReshootArea" class="mt-3" style="display:none">
            <button class="btn w-100" id="fseReshootBtn" onclick="fseChangeReshoot()" style="height:48px"></button>
            <div id="fseReshootInfo" class="small mt-1 text-muted text-center"></div>
        </div>
    </div>
</div>

<script>
(function() {
    var containerEl = document.querySelector('.faltskytte-station-entry');
    var compId = containerEl?.dataset.competitionId;
    var presetStation = parseInt(containerEl?.dataset.presetStation) || 0;
    // Self-service mode flags. When true: scoped to one patrol, roll call is
    // skipped (team self-marks), and the patrol's CurrentStation gates writes.
    var selfService = containerEl?.dataset.selfService === '1';
    var ssPatrolId = parseInt(containerEl?.dataset.presetPatrolId) || 0;
    var ssPatrolNumber = parseInt(containerEl?.dataset.presetPatrolNumber) || 0;
    var ssLocked = false; // computed after GetStationEntryData returns the patrol's CurrentStation
    var competitionConfig = null;
    var maxReshoots = 0;
    var scoringMode = 'Normal';
    var stationData = null;
    var currentPatrol = null;
    var currentPatrolWc = null;
    var currentShooterIdx = 0;
    var shooterHits = {};
    var presentMembers = new Set(); // Members checked as present in roll call

    // Init
    (async function() {
        // Self-service: advance the patrol's cursor to this station before any
        // results UI loads. Re-scanning the same station is a server-side no-op
        // (the UPDATE skips when CurrentStation already matches). Staff visits
        // never reach this branch — the page renders the staff entry surface
        // without setting selfService=true.
        if (selfService && ssPatrolId > 0 && presetStation > 0) {
            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                await fetch('/umbraco/surface/Faltskytte/AdvancePatrolCursor', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({ competitionId: parseInt(compId, 10), patrolId: ssPatrolId, stationNumber: presetStation })
                });
            } catch (e) { /* best effort — server still enforces cursor on save */ }
        }

        var resp = await fetch('/umbraco/surface/Faltskytte/GetStationConfig?competitionId=' + compId);
        var data = await resp.json();
        if (data.success) {
            competitionConfig = data.config;
            maxReshoots = data.maxReshoots || 0;
            scoringMode = data.scoringMode || 'Normal';
            var stationNums = new Set();
            Object.values(competitionConfig.weaponConfigs || {}).forEach(function(wc) {
                (wc.stations || []).forEach(function(s) { stationNums.add(s.station); });
            });
            var select = document.getElementById('fseStationSelect');
            Array.from(stationNums).sort(function(a,b){return a-b;}).forEach(function(n) {
                var opt = document.createElement('option');
                opt.value = n; opt.textContent = 'Station ' + n;
                select.appendChild(opt);
            });

            // Auto-select preset station (from QR code / station page)
            if (presetStation > 0 && stationNums.has(presetStation)) {
                select.value = presetStation;
                fseLoadStation();
            }
        }
    })();

    window.fseLoadStation = async function() {
        var stationNum = parseInt(document.getElementById('fseStationSelect').value);
        var listEl = document.getElementById('fsePatrolList');
        if (!stationNum) { listEl.innerHTML = ''; return; }

        listEl.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>';
        var resp = await fetch('/umbraco/surface/Faltskytte/GetStationEntryData?competitionId=' + compId + '&stationNumber=' + stationNum);
        var data = await resp.json();
        if (!data.success) { listEl.innerHTML = '<div class="alert alert-warning">' + data.message + '</div>'; return; }

        stationData = data.data;
        shooterHits = {}; // Clear local state on station load

        // Self-service: keep only the user's resolved patrol in the list AND
        // jump straight into it — the team should never see other patrols and
        // shouldn't have to tap a list of one.
        if (selfService && ssPatrolNumber > 0 && Array.isArray(stationData.patrols)) {
            stationData.patrols = stationData.patrols.filter(function (p) {
                return p.patrolNumber === ssPatrolNumber;
            });
        }

        var html = '';
        (stationData.patrols || []).forEach(function(p) {
            var total = p.members.length;
            var done = p.completedCount;
            var allDone = done >= total && total > 0;
            var timeStr = p.startTime ? new Date(p.startTime).toLocaleTimeString('sv-SE', { hour:'2-digit', minute:'2-digit' }) : '';

            var lbl = p.label ? ' — ' + p.label.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : '';
            html += '<div class="card mb-2 fse-patrol-row' + (allDone ? ' border-success' : '') + '" onclick="fseSelectPatrol(' + p.patrolNumber + ')">' +
                '<div class="card-body py-3 d-flex align-items-center justify-content-between">' +
                '<div><strong class="fs-5">Patrull ' + p.patrolNumber + lbl + '</strong>' +
                '<span class="badge bg-info ms-2">' + (p.weaponGroup || '') + '</span>' +
                (timeStr ? '<span class="text-muted ms-2">' + timeStr + '</span>' : '') +
                '<span class="text-muted ms-2 small">' + total + ' skyttar</span></div>' +
                (allDone ? '<i class="bi bi-check-circle-fill text-success fs-4"></i>' : '<i class="bi bi-circle text-muted fs-4"></i>') +
                '</div></div>';
        });
        listEl.innerHTML = html || '<p class="text-muted text-center">Inga patruller.</p>';

        // Self-service: auto-select the (single) patrol so the team lands
        // directly on the entry surface without an extra tap.
        if (selfService && ssPatrolNumber > 0 && (stationData.patrols || []).length === 1) {
            fseSelectPatrol(ssPatrolNumber);
        }
    };

    window.fseSelectPatrol = function(patrolNum) {
        currentPatrol = (stationData.patrols || []).find(function(p) { return p.patrolNumber === patrolNum; });
        if (!currentPatrol) return;
        currentPatrolWc = currentPatrol.weaponGroup || 'C';

        // Self-service lock check: only lock when the patrol's cursor is AHEAD
        // of this station — i.e. the patrol has moved past, and this is an old
        // station. Forward motion (cursor null, equal, or behind) is fine — the
        // server auto-advances the cursor on save. Same rule, both sides.
        ssLocked = !!(selfService
            && currentPatrol.currentStation
            && currentPatrol.currentStation > stationData.stationNumber);

        // Self-service mode skips the roll-call screen entirely — the team
        // self-marks attendance by being there. Auto-include every member as
        // present and jump straight into entry. Lock state (if any) is then
        // applied by fseStartEntry / save UI.
        if (selfService) {
            presentMembers = new Set();
            (currentPatrol.members || []).forEach(function (m) { presentMembers.add(m.memberId); });
            fseStartEntry();
            return;
        }

        // Show roll call screen
        document.getElementById('fseRcStationLabel').textContent = 'Station ' + stationData.stationNumber;
        document.getElementById('fseRcPatrolLabel').textContent = 'Patrull ' + currentPatrol.patrolNumber + (currentPatrol.label ? ' — ' + currentPatrol.label : '');

        // Render Förutsättningar on roll call screen
        var wcCfg = stationData.weaponClassStations?.[currentPatrolWc] || Object.values(stationData.weaponClassStations || {})[0];
        if (wcCfg) {
            var fpHtml = wcCfg.shootingTimeSec + 's \u00b7 ' + wcCfg.shooterStartPosition + ' \u00b7 ' + wcCfg.weaponStartPosition + ' \u00b7 ' + wcCfg.supportHand;
            if (scoringMode === 'Normal' && wcCfg.maxShotsPerFigure < 6) fpHtml += ' \u00b7 Max ' + wcCfg.maxShotsPerFigure + ' skott/fig';
            (wcCfg.targetGroups || []).forEach(function(tg) {
                if (tg.description) {
                    var tgLetter = String.fromCharCode(64 + tg.group);
                    fpHtml += '<div class="mt-1 border-top pt-1"><strong>M\u00e5lgrupp ' + tgLetter + ':</strong> ' +
                        tg.description.replace(/</g, '&lt;').replace(/\n/g, '<br>') + '</div>';
                }
            });
            document.getElementById('fseRcFpBody').innerHTML = fpHtml;
        }

        // Render roll call list
        presentMembers = new Set();
        var rcHtml = '';
        (currentPatrol.members || []).forEach(function(m, idx) {
            presentMembers.add(m.memberId);
            rcHtml += '<div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">' +
                '<input type="checkbox" class="form-check-input fse-rc-check" data-member-id="' + m.memberId + '" checked onchange="fseRcToggle(this)">' +
                '<span class="flex-grow-1">' + m.name + ' <span class="text-muted small">(' + m.club + ')</span>' +
                ' <span class="badge bg-body-secondary text-body">' + m.shootingClass + '</span></span>' +
                (m.hasResult ? '<i class="bi bi-check-circle-fill text-success"></i>' : '') +
                '</div>';
        });
        document.getElementById('fseRcList').innerHTML = rcHtml;
        fseUpdateRcCount();

        document.getElementById('fseSelectScreen').style.display = 'none';
        document.getElementById('fseRollCallScreen').style.display = '';
    };

    window.fseRcToggle = function(cb) {
        var memberId = parseInt(cb.dataset.memberId);
        if (cb.checked) presentMembers.add(memberId); else presentMembers.delete(memberId);
        fseUpdateRcCount();
    };

    function fseUpdateRcCount() {
        var total = currentPatrol?.members?.length || 0;
        document.getElementById('fseRcCount').textContent = presentMembers.size + ' av ' + total + ' n\u00e4rvarande';
    }

    window.fseStartEntry = function() {
        if (presentMembers.size === 0) { alert('Minst en skytt m\u00e5ste vara n\u00e4rvarande.'); return; }
        currentShooterIdx = 0;
        // Find first present member
        var members = currentPatrol.members || [];
        while (currentShooterIdx < members.length && !presentMembers.has(members[currentShooterIdx].memberId))
            currentShooterIdx++;

        document.getElementById('fseStationLabel').textContent = 'Station ' + stationData.stationNumber;
        document.getElementById('fsePatrolLabel').textContent = 'Patrull ' + currentPatrol.patrolNumber + (currentPatrol.label ? ' — ' + currentPatrol.label : '');
        fseApplySelfServiceUi();

        document.getElementById('fseRollCallScreen').style.display = 'none';
        document.getElementById('fseEntryScreen').style.display = '';
        fseLoadAndRenderShooter();
    };

    // Self-service: rewire the "Upprop" back button to "Byt patrull" (there's
    // no roll-call screen to return to in this mode) and surface a lock
    // banner / disable save when the team has moved past this station.
    function fseApplySelfServiceUi() {
        if (!selfService) return;

        var backBtn = document.querySelector('#fseEntryScreen button[onclick="fseBackToRollCall()"]');
        if (backBtn) {
            backBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Byt patrull';
            backBtn.setAttribute('onclick', 'fseBytPatrull()');
        }

        var entryScreen = document.getElementById('fseEntryScreen');
        var existing = document.getElementById('fseLockBanner');
        if (existing) existing.remove();
        var saveBtn = document.getElementById('fseSaveBtn');
        if (ssLocked) {
            var banner = document.createElement('div');
            banner.id = 'fseLockBanner';
            banner.className = 'alert alert-warning text-center mb-2';
            banner.innerHTML = '<i class="bi bi-lock-fill me-1"></i><strong>Stationen är låst.</strong> Be en funktionär att ändra resultatet.';
            entryScreen.insertBefore(banner, entryScreen.firstChild);
            if (saveBtn) saveBtn.disabled = true;
        } else if (saveBtn) {
            saveBtn.disabled = false;
        }
    }

    window.fseBytPatrull = function() {
        try { localStorage.removeItem('hpsk_faltselfservice_' + compId); } catch (e) {}
        var url = new URL(window.location.href);
        url.searchParams.delete('p');
        window.location.href = url.toString();
    };

    window.fseBackFromRollCall = function() {
        document.getElementById('fseRollCallScreen').style.display = 'none';
        document.getElementById('fseSelectScreen').style.display = '';
        fseLoadStation(); // Refresh patrol data (updates green checkmarks)
    };

    window.fseBackToRollCall = function() {
        if (!fseCheckUnsaved()) return;
        // Re-render roll call list to update green checkmarks
        var rcHtml = '';
        (currentPatrol.members || []).forEach(function(m) {
            var isPresent = presentMembers.has(m.memberId);
            rcHtml += '<div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">' +
                '<input type="checkbox" class="form-check-input fse-rc-check" data-member-id="' + m.memberId + '"' + (isPresent ? ' checked' : '') + ' onchange="fseRcToggle(this)">' +
                '<span class="flex-grow-1">' + m.name + ' <span class="text-muted small">(' + m.club + ')</span>' +
                ' <span class="badge bg-body-secondary text-body">' + m.shootingClass + '</span></span>' +
                (m.hasResult ? '<i class="bi bi-check-circle-fill text-success"></i>' : '') +
                '</div>';
        });
        document.getElementById('fseRcList').innerHTML = rcHtml;
        fseUpdateRcCount();
        document.getElementById('fseEntryScreen').style.display = 'none';
        document.getElementById('fseRollCallScreen').style.display = '';
    };

    async function fseLoadAndRenderShooter() {
        var members = currentPatrol.members || [];
        var m = members[currentShooterIdx];
        if (!m) return;

        // Load existing result from server if not already cached
        if (!shooterHits[m.memberId]) {
            await fseLoadExistingResult(m);
        }

        fseRenderShooter();
    }

    async function fseLoadExistingResult(member) {
        if (!member.hasResult) {
            // No saved result — init with zeros
            fseInitShooterState(member.memberId);
            return;
        }

        try {
            var resp = await fetch('/umbraco/surface/Faltskytte/GetShooterStationResult?competitionId=' + compId +
                '&stationNumber=' + stationData.stationNumber + '&memberId=' + member.memberId +
                '&shootingClass=' + encodeURIComponent(member.shootingClass));
            var data = await resp.json();
            if (data.success && data.result) {
                var hitDist = data.result.hitDistribution ? JSON.parse(data.result.hitDistribution) : [];
                var wcCfg = stationData.weaponClassStations?.[currentPatrolWc] || Object.values(stationData.weaponClassStations || {})[0];

                // Build pmScores from the saved tiebreakerScore (distributed evenly for now, since we only store total)
                var pmCount = 0;
                (wcCfg?.targetGroups || []).forEach(function(tg) {
                    (tg.figures || []).forEach(function(fig) { if (fig.isPoangmal) pmCount++; });
                });
                var pmScores = new Array(pmCount).fill(0);
                // Load individual pm scores if available
                if (data.result.poangmalScores) {
                    try {
                        var saved = typeof data.result.poangmalScores === 'string'
                            ? JSON.parse(data.result.poangmalScores)
                            : data.result.poangmalScores;
                        for (var pi = 0; pi < Math.min(saved.length, pmCount); pi++) {
                            pmScores[pi] = parseInt(saved[pi]) || 0;
                        }
                    } catch(e) {}
                } else if (data.result.tiebreakerScore && pmCount === 1) {
                    // Fallback for old data without individual scores
                    pmScores[0] = data.result.tiebreakerScore;
                }

                shooterHits[member.memberId] = {
                    figHits: hitDist.map(function(v) { return parseInt(v) || 0; }),
                    pmScores: pmScores,
                    pmTouched: pmScores.map(function(v) { return v > 0; }),
                    reshoots: data.result.reshoots || 0,
                    _dirty: false
                };
            } else {
                fseInitShooterState(member.memberId);
            }
        } catch(e) {
            fseInitShooterState(member.memberId);
        }
    }

    function fseInitShooterState(memberId) {
        var wcCfg = stationData.weaponClassStations?.[currentPatrolWc] || Object.values(stationData.weaponClassStations || {})[0];
        var totalTargets = 0, totalPm = 0;
        (wcCfg?.targetGroups || []).forEach(function(tg) {
            (tg.figures || []).forEach(function(fig) {
                totalTargets += Math.max(1, fig.targetsPerFigure || fig.TargetsPerFigure || 1);
                if (fig.isPoangmal) totalPm++;
            });
        });
        shooterHits[memberId] = { figHits: new Array(totalTargets).fill(null), pmScores: new Array(totalPm).fill(0), pmTouched: new Array(totalPm).fill(false), reshoots: 0, _dirty: false };
    }

    function fseRenderShooter() {
        var members = currentPatrol.members || [];
        if (currentShooterIdx < 0) currentShooterIdx = 0;
        if (currentShooterIdx >= members.length) currentShooterIdx = members.length - 1;
        var m = members[currentShooterIdx];
        var state = shooterHits[m.memberId];
        if (!state) { fseInitShooterState(m.memberId); state = shooterHits[m.memberId]; }

        // Nav
        document.getElementById('fseShooterPosition').textContent = m.position || (currentShooterIdx + 1);
        document.getElementById('fseShooterName').textContent = m.name;
        document.getElementById('fseShooterInfo').textContent = m.shootingClass + ' \u00b7 ' + m.club;
        document.getElementById('fsePrevBtn').disabled = currentShooterIdx === 0;
        document.getElementById('fseNextBtn').disabled = currentShooterIdx >= members.length - 1;
        document.getElementById('fseShooterSavedBadge').style.display = m.hasResult && !state._dirty ? '' : 'none';
        document.getElementById('fseShooterDirtyBadge').style.display = state._dirty ? '' : 'none';

        // Save button state
        var saveBtn = document.getElementById('fseSaveBtn');
        saveBtn.disabled = false;
        saveBtn.className = 'btn btn-success w-100 fse-save-btn mb-2';
        saveBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>SPARA RESULTAT';

        // Station config for figure entry
        var wcCfg = stationData.weaponClassStations?.[currentPatrolWc] || Object.values(stationData.weaponClassStations || {})[0];

        // Build figure entry
        var figArea = document.getElementById('fseFigureArea');
        figArea.innerHTML = '';
        var figIdx = 0;
        var pmIdx = 0;
        var stationMaxShots = wcCfg?.maxShotsPerFigure || 6;
        var maxPerFig = scoringMode === 'Normal' ? stationMaxShots : 6;

        (wcCfg?.targetGroups || []).forEach(function(tg) {
            var tgLabel = 'M\u00e5lgrupp ' + String.fromCharCode(64 + tg.group);
            figArea.insertAdjacentHTML('beforeend', '<div class="fw-bold small text-muted mb-1 mt-2">' + tgLabel + '</div>');

            (tg.figures || []).forEach(function(fig) {
                var targetsInFig = Math.max(1, fig.targetsPerFigure || fig.TargetsPerFigure || 1);
                var figLabel = fig.figureNumber;

                var html = '<div class="fse-figure-card">';
                html += '<div class="d-flex align-items-center mb-2">';
                html += '<span class="fw-bold">Figur ' + figLabel + '</span>';
                if (targetsInFig > 1) html += '<span class="badge bg-secondary ms-1">' + targetsInFig + ' m\u00e5l</span>';
                if (fig.imageUrl || fig.targetName) {
                    html += '<span class="d-flex align-items-center gap-1 mx-auto">';
                    if (fig.imageUrl) html += '<img src="' + fig.imageUrl + '" style="height:32px;border-radius:4px" alt="">';
                    if (fig.targetName) html += '<span class="small text-muted">' + fig.targetName + '</span>';
                    html += '</span>';
                }
                html += '</div>';

                // Render one hit-button row per target in the figure
                for (var t = 0; t < targetsInFig; t++) {
                    var fi = figIdx + t;
                    var currentVal = state.figHits[fi];
                    if (targetsInFig > 1) html += '<div class="small text-muted mb-1">M\u00e5l ' + (t + 1) + '</div>';
                    html += '<div class="d-flex gap-1 flex-wrap' + (t < targetsInFig - 1 ? ' mb-2' : '') + '">';
                    for (var v = 0; v <= Math.min(maxPerFig, 6); v++) {
                        var isActive = v === currentVal;
                        html += '<button class="btn ' + (isActive ? 'btn-primary' : 'btn-outline-secondary') + ' fse-hit-btn flex-fill" ' +
                            'onclick="fseSetHit(' + m.memberId + ',' + fi + ',' + v + ')">' + v + '</button>';
                    }
                    html += '</div>';
                }

                if (fig.isPoangmal) {
                    var pi = pmIdx;
                    var pmVal = state.pmScores[pi] || 0;
                    html += '<div class="d-flex align-items-center gap-2 mt-2">' +
                        '<span class="badge bg-warning text-dark" style="font-size:0.85em">Po\u00e4ngr\u00e4kning</span>' +
                        '<button class="btn btn-outline-primary fse-pm-tap" onclick="fseOpenKeypad(' + m.memberId + ',' + pi + ')">' +
                        (pmVal > 0 ? pmVal : '&mdash;') + '</button></div>';
                    pmIdx++;
                }

                html += '</div>';
                figArea.insertAdjacentHTML('beforeend', html);
                figIdx += targetsInFig;
            });
        });

        fseUpdateTotal(m.memberId);

        // Reshoot buttons
        // Reshoot: load cross-station info then render buttons
        fseRenderReshoots(m.memberId, state);
    }

    window.fseSetHit = function(memberId, figIdx, value) {
        var state = shooterHits[memberId];
        if (!state) return;
        state.figHits[figIdx] = value;
        state._dirty = true;
        fseRenderShooter();
    };

    window.fseSetPm = function(memberId, pmIdx, value) {
        var state = shooterHits[memberId];
        if (!state) return;
        state.pmScores[pmIdx] = parseInt(value) || 0;
        state.pmTouched[pmIdx] = true;
        state._dirty = true;
    };

    // ─── Numeric keypad for Poängräkning ─────────────────────────
    var _kpMemberId = 0, _kpPmIdx = 0, _kpValue = '';
    window.fseOpenKeypad = function(memberId, pmIdx) {
        _kpMemberId = memberId;
        _kpPmIdx = pmIdx;
        var state = shooterHits[memberId];
        var current = state ? (state.pmScores[pmIdx] || 0) : 0;
        _kpValue = current > 0 ? String(current) : '';
        document.getElementById('fseKpDisplay').textContent = _kpValue || '0';
        document.getElementById('fseKeypad').classList.add('show');
    };
    window.fseKeypadDigit = function(d) {
        if (_kpValue.length >= 2) return; // max 2 digits
        _kpValue += String(d);
        var num = parseInt(_kpValue) || 0;
        if (num > 50) { _kpValue = '50'; num = 50; }
        document.getElementById('fseKpDisplay').textContent = _kpValue || '0';
    };
    window.fseKeypadBackspace = function() {
        _kpValue = _kpValue.slice(0, -1);
        document.getElementById('fseKpDisplay').textContent = _kpValue || '0';
    };
    window.fseKeypadOk = function() {
        var val = parseInt(_kpValue) || 0;
        if (val > 50) val = 50;
        fseSetPm(_kpMemberId, _kpPmIdx, val);
        document.getElementById('fseKeypad').classList.remove('show');
        fseRenderShooter();
    };
    window.fseKeypadCancel = function() {
        document.getElementById('fseKeypad').classList.remove('show');
    };

    window.fseSetReshoot = function(memberId, value) {
        var state = shooterHits[memberId];
        if (!state) return;
        state.reshoots = value;
        state._dirty = true;
        fseRenderShooter();
    };

    function fseUpdateTotal(memberId) {
        var state = shooterHits[memberId];
        if (!state) return;
        var totalHits = state.figHits.reduce(function(s,v){return s+(v||0);}, 0);
        var totalFigs = state.figHits.filter(function(v){return v !== null && v > 0;}).length;
        var el = document.getElementById('fseRunningTotal');
        if (totalHits > 6) {
            el.textContent = totalHits + '/' + totalFigs + ' (MAX 6!)';
            el.style.color = 'var(--bs-danger)';
        } else {
            el.textContent = totalHits + '/' + totalFigs;
            el.style.color = '';
        }
    }

    var _fseReshootRemaining = 0;

    async function fseRenderReshoots(memberId, state) {
        var btn = document.getElementById('fseReshootBtn');
        var infoEl = document.getElementById('fseReshootInfo');
        var sectionEl = document.getElementById('fseReshootArea');

        if (maxReshoots <= 0) {
            sectionEl.style.display = 'none';
            return;
        }
        sectionEl.style.display = '';

        // Load cross-station reshoot usage for this weapon class
        var otherReshoots = 0;
        try {
            var m = currentPatrol.members[currentShooterIdx];
            var scParam = m ? '&shootingClass=' + encodeURIComponent(m.shootingClass) : '';
            var resp = await fetch('/umbraco/surface/Faltskytte/GetReshootInfo?competitionId=' + compId + '&memberId=' + memberId + scParam);
            var data = await resp.json();
            if (data.success) {
                otherReshoots = data.info.totalReshoots - (state.reshoots || 0);
                if (otherReshoots < 0) otherReshoots = 0;
            }
        } catch(e) {}

        _fseReshootRemaining = maxReshoots - otherReshoots;
        if (_fseReshootRemaining < 0) _fseReshootRemaining = 0;
        var totalUsed = otherReshoots + (state.reshoots || 0);

        // Button: shows current state, click to change
        if (state.reshoots > 0) {
            btn.className = 'btn btn-warning w-100';
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-2"></i>Omskjutning registrerad (' + state.reshoots + ')';
        } else {
            btn.className = 'btn btn-outline-secondary w-100';
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-2"></i>Registrera omskjutning';
        }

        // Disable if no reshoots remaining and current is 0
        btn.disabled = _fseReshootRemaining <= 0 && state.reshoots === 0;

        // Info text
        if (totalUsed > 0 || _fseReshootRemaining < maxReshoots) {
            var cls = totalUsed >= maxReshoots ? 'text-danger fw-bold' : 'text-muted';
            infoEl.innerHTML = '<span class="' + cls + '">' + totalUsed + ' av ' + maxReshoots + ' omskjutningar anv\u00e4nda f\u00f6r denna vapenklass</span>';
        } else {
            infoEl.innerHTML = '';
        }
    }

    window.fseChangeReshoot = async function() {
        var m = currentPatrol.members[currentShooterIdx];
        var state = shooterHits[m.memberId];
        if (!state) return;

        var current = state.reshoots || 0;
        var newVal;

        if (_fseReshootRemaining <= 1 && current === 0) {
            // Simple case: only 0 or 1 allowed — toggle to 1 with confirm
            if (!confirm('Registrera omskjutning f\u00f6r ' + m.name + ' vid denna station?')) return;
            newVal = 1;
        } else if (current > 0 && _fseReshootRemaining <= current) {
            // At max or only option is to reset — toggle to 0
            if (!confirm('\u00c5terst\u00e4ll omskjutning f\u00f6r ' + m.name + ' vid denna station?')) return;
            newVal = 0;
        } else {
            // Multiple values possible — cycle: current → current+1, or back to 0 if at max
            newVal = current + 1;
            if (newVal > _fseReshootRemaining) newVal = 0;
            var msg = newVal === 0
                ? '\u00c5terst\u00e4ll omskjutning f\u00f6r ' + m.name + '?'
                : 'S\u00e4tt omskjutning till ' + newVal + ' f\u00f6r ' + m.name + ' vid denna station?';
            if (!confirm(msg)) return;
        }

        state.reshoots = newVal;
        state._dirty = true;
        fseRenderReshoots(m.memberId, state);

        // Auto-save immediately
        try {
            await fetch('/umbraco/surface/Faltskytte/SaveStationResult', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify({
                    competitionId: parseInt(compId),
                    stationNumber: stationData.stationNumber,
                    memberId: m.memberId,
                    patrolNumber: currentPatrol.patrolNumber,
                    shootingClass: m.shootingClass,
                    hitsPerFigure: state.figHits.map(function(v){return v||0;}),
                    tiebreakerScore: state.pmScores.some(function(v){return v>0;}) ? state.pmScores.reduce(function(s,v){return s+v;},0) : null,
                    poangmalScores: state.pmScores.some(function(v){return v>0;}) ? state.pmScores : null,
                    reshoots: state.reshoots
                })
            });
            state._dirty = false;
            m.hasResult = true;
        } catch(e) { console.error('Reshoot save failed:', e); }
    };

    window.fseSave = async function() {
        var m = currentPatrol.members[currentShooterIdx];
        var state = shooterHits[m.memberId];
        if (!state) return;

        // Validate: check for unscored figures (still null)
        var unscoredFigs = state.figHits.filter(function(v) { return v === null; }).length;
        if (unscoredFigs > 0) {
            if (!confirm(unscoredFigs + ' figur(er) har inte f\u00e5tt resultat. Spara \u00e4nd\u00e5?')) return;
        }

        // Validate: check for untouched poångmål
        var untouchedPm = 0;
        for (var pi = 0; pi < state.pmTouched.length; pi++) {
            if (!state.pmTouched[pi]) untouchedPm++;
        }
        if (untouchedPm > 0) {
            if (!confirm('Po\u00e4ngr\u00e4kning saknas f\u00f6r ' + untouchedPm + ' figur(er). Spara \u00e4nd\u00e5?')) return;
        }

        var hitsToSave = state.figHits.map(function(v){return v || 0;});
        var totalHits = hitsToSave.reduce(function(s,v){return s+v;}, 0);
        if (totalHits > 6) { alert('Max 6 tr\u00e4ff per station!'); return; }

        var tiebreakerScore = null;
        var hasAnyPm = state.pmScores.some(function(v){return v > 0;});
        if (hasAnyPm) tiebreakerScore = state.pmScores.reduce(function(s,v){return s+v;}, 0);

        var btn = document.getElementById('fseSaveBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sparar...';

        try {
            var resp = await fetch('/umbraco/surface/Faltskytte/SaveStationResult', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify({
                    competitionId: parseInt(compId),
                    stationNumber: stationData.stationNumber,
                    memberId: m.memberId,
                    patrolNumber: currentPatrol.patrolNumber,
                    shootingClass: m.shootingClass,
                    hitsPerFigure: hitsToSave,
                    tiebreakerScore: tiebreakerScore,
                    poangmalScores: state.pmScores.some(function(v){return v>0;}) ? state.pmScores : null,
                    reshoots: state.reshoots
                })
            });
            var data = await resp.json();
            if (data.success) {
                state._dirty = false;
                m.hasResult = true;
                currentPatrol.completedCount = currentPatrol.members.filter(function(mm){return mm.hasResult;}).length;
                document.getElementById('fseShooterSavedBadge').style.display = '';
                document.getElementById('fseShooterDirtyBadge').style.display = 'none';

                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>SPARAD!';

                setTimeout(function() {
                    // Find next present member
                    var members = currentPatrol.members || [];
                    var nextIdx = currentShooterIdx + 1;
                    while (nextIdx < members.length && !presentMembers.has(members[nextIdx].memberId)) nextIdx++;
                    if (nextIdx < members.length) {
                        currentShooterIdx = nextIdx;
                        fseLoadAndRenderShooter();
                    } else {
                        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>ALLA SPARADE';
                        btn.disabled = false;
                    }
                }, 800);
            } else {
                alert('Fel: ' + data.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>SPARA RESULTAT';
            }
        } catch(err) {
            alert('N\u00e4tverksfel.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>SPARA RESULTAT';
        }
    };

    function fseCheckUnsaved() {
        var m = currentPatrol?.members?.[currentShooterIdx];
        if (!m) return true;
        var state = shooterHits[m.memberId];
        if (state && state._dirty) {
            return confirm('Du har osparade \u00e4ndringar. Vill du forts\u00e4tta utan att spara?');
        }
        return true;
    }

    window.fseNavPrev = function() {
        if (!fseCheckUnsaved()) return;
        var members = currentPatrol.members || [];
        var idx = currentShooterIdx - 1;
        while (idx >= 0 && !presentMembers.has(members[idx].memberId)) idx--;
        if (idx >= 0) { currentShooterIdx = idx; fseLoadAndRenderShooter(); }
    };
    window.fseNavNext = function() {
        if (!fseCheckUnsaved()) return;
        var members = currentPatrol.members || [];
        var idx = currentShooterIdx + 1;
        while (idx < members.length && !presentMembers.has(members[idx].memberId)) idx++;
        if (idx < members.length) { currentShooterIdx = idx; fseLoadAndRenderShooter(); }
    };
    window.fseBackToPatrols = function() {
        if (!fseCheckUnsaved()) return;
        document.getElementById('fseEntryScreen').style.display = 'none';
        document.getElementById('fseSelectScreen').style.display = '';
        fseLoadStation();
    };
})();
</script>
