                    if (finishEl._flatpickr) finishEl._flatpickr.setDate(finishTimeStr, true);
                }
            }
        }
    }

    // Recalculate display (this also updates sprint/total from restored finish time)
    if (isClassC) springRecalcClassC(); else springRecalcClassA();

    // Take snapshot for unsaved-changes detection
    springASnapshot = springATakeSnapshot();
}

function springRenderClassCShots() {
    let html = '<div class="row g-2">';
    for (let stop = 1; stop <= 6; stop++) {
        html += `
        <div class="col-md-6 col-lg-4">
            <div class="stop-group">
                <div class="stop-header mb-1">Station ${stop}</div>
                <div class="d-flex gap-1">`;
        for (let shot = 1; shot <= 5; shot++) {
            const id = `shot_${stop}_${shot}`;
            html += `
                    <button type="button" class="btn btn-outline-secondary shot-btn" id="${id}"
                        onclick="springToggleClassCShot(this)" data-stop="${stop}" data-shot="${shot}" data-value="">
                        -
                    </button>`;
        }
        html += `
                    <span class="align-self-center ms-1 small fw-bold" id="stop${stop}Count">0/5</span>
                </div>
            </div>
        </div>`;
    }
    html += '</div>';
    return html;
}

function springRenderClassAShots() {
    const numTargets = springNumberOfSeries || 2;
    const shotsPerTarget = Math.floor(30 / numTargets);
    const extraShots = 30 - (shotsPerTarget * numTargets);
    const zones = ['Ring 1', 'Ring 2', 'Ring 3', 'Ring 4', 'Bom'];
    const zonePoints = [0, 0, 1, 2, 3];

    let html = `<div class="mb-2 small text-muted">${numTargets} mål, ${shotsPerTarget} skott/mål. Ring 1–2 = 0p, Ring 3 = 1p, Ring 4 = 2p, Bom = 3p</div>`;

    for (let t = 1; t <= numTargets; t++) {
        const shotsInTarget = t === numTargets ? shotsPerTarget + extraShots : shotsPerTarget;
        html += `
        <div class="stop-group">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="stop-header">Mål ${t} <small class="text-muted fw-normal">(${shotsInTarget} skott)</small></span>
                <span class="small fw-bold" id="targetA${t}Score">0p</span>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">`;
        for (let z = 0; z < 5; z++) {
            const id = `target_${t}_zone_${z}`;
            html += `
                <div class="text-center">
                    <label class="form-label small mb-0" for="${id}">${zones[z]}</label>
                    <input type="number" class="form-control zone-count-input" id="${id}" min="0" max="${shotsInTarget}"
                        data-target="${t}" data-zone="${z}" placeholder="0"
                        onchange="springRecalcClassA()" oninput="springRecalcClassA()">
                </div>`;
        }
        html += `
                <div class="text-center">
                    <label class="form-label small mb-0">&nbsp;</label>
                    <div class="small fw-bold mt-1" id="targetA${t}ShotCount" style="min-width:40px">0/${shotsInTarget}</div>
                </div>
            </div>
        </div>`;
    }
    return html;
}

// ===== SHOT INTERACTION =====

function springToggleClassCShot(btn) {
    const current = btn.dataset.value;
    if (current === '' || current === undefined) {
        btn.dataset.value = 'H';
        btn.textContent = 'T';
        btn.classList.remove('btn-outline-secondary', 'active-miss');
        btn.classList.add('active-hit');
    } else if (current === 'H') {
        btn.dataset.value = 'B';
        btn.textContent = 'B';
        btn.classList.remove('active-hit');
        btn.classList.add('active-miss');
    } else {
        btn.dataset.value = '';
        btn.textContent = '-';
        btn.classList.remove('active-hit', 'active-miss');
        btn.classList.add('btn-outline-secondary');
    }
    springRecalcClassC();
}

function springRecalcClassC() {
    let totalMisses = 0;
    for (let stop = 1; stop <= 6; stop++) {
        let hits = 0, misses = 0;
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`shot_${stop}_${shot}`);
            if (btn?.dataset.value === 'H') hits++;
            if (btn?.dataset.value === 'B') misses++;
        }
        totalMisses += misses;
        const countEl = document.getElementById(`stop${stop}Count`);
        if (countEl) countEl.textContent = `${hits}/5`;
    }

    const multiplier = parseInt(document.querySelector('input[name="springMultiplier"]:checked')?.value || '1');
    const shootingScore = totalMisses * multiplier;
    const scoreEl = document.getElementById('springShootingScore');
    if (scoreEl) scoreEl.textContent = shootingScore;
    springPaintShotCountBadge('springShotCount', springShotCounts(springCollectClassCShots(), true));
    springUpdateTotalTimeA(shootingScore, multiplier);
}

function springRecalcClassA() {
    let totalScore = 0;
    const numTargets = springNumberOfSeries || 2;
    const shotsPerTarget = Math.floor(30 / numTargets);
    const extraShots = 30 - (shotsPerTarget * numTargets);
    const zonePoints = [0, 0, 1, 2, 3];

    for (let t = 1; t <= numTargets; t++) {
        let targetScore = 0;
        let shotCount = 0;
        const expected = t === numTargets ? shotsPerTarget + extraShots : shotsPerTarget;

        for (let z = 0; z < 5; z++) {
            const input = document.getElementById(`target_${t}_zone_${z}`);
            const val = parseInt(input?.value) || 0;
            shotCount += val;
            targetScore += val * zonePoints[z];
        }
        totalScore += targetScore;

        const scoreEl = document.getElementById(`targetA${t}Score`);
        if (scoreEl) scoreEl.textContent = `${targetScore}p`;
        const countEl = document.getElementById(`targetA${t}ShotCount`);
        if (countEl) {
            countEl.textContent = `${shotCount}/${expected}`;
            countEl.style.color = shotCount === expected ? 'var(--bs-success)' : (shotCount > expected ? 'var(--bs-danger)' : '');
        }
    }

    const scoreEl = document.getElementById('springShootingScore');
    if (scoreEl) scoreEl.textContent = totalScore;
    springPaintShotCountBadge('springShotCount', springShotCounts(null, false));
    springUpdateTotalTimeA(totalScore, 1);
}

function springUpdateTotalTimeA(shootingScore, multiplier) {
    const finishInput = document.getElementById('springFinishTime')?.value;
    const shooter = springFilteredShooters[springCurrentIndex];
    const startTime = shooter?.startTime;

    let sprintSeconds = null;
    if (finishInput && finishInput.trim() && startTime) {
        sprintSeconds = calculateSprintTime(startTime, finishInput);
    }

    const sprintDisplay = document.getElementById('springSprintTimeDisplay');
    if (sprintDisplay) {
        sprintDisplay.textContent = sprintSeconds !== null ? formatSecondsToTime(sprintSeconds) : '-';
    }

    const totalEl = document.getElementById('springTotalTime');
    if (sprintSeconds !== null) {
        const penaltySeconds = shootingScore * multiplier * 60;
        const totalSeconds = sprintSeconds + penaltySeconds;
        if (totalEl) totalEl.textContent = formatSecondsToTime(totalSeconds);
    } else {
        if (totalEl) totalEl.textContent = '-';
    }
}

// Listen for finish time changes
document.addEventListener('input', function(e) {
    if (e.target.id === 'springFinishTime') {
        const shooter = springFilteredShooters[springCurrentIndex];
        if (shooter?.weaponClass === 'C') springRecalcClassC();
        else springRecalcClassA();
    }
});

// Listen for multiplier changes
document.addEventListener('change', function(e) {
    if (e.target.name === 'springMultiplier') springRecalcClassC();
});

// ===== TAB A: SAVE / DELETE =====

async function springSaveResult() {
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) return;

    const isClassC = shooter.weaponClass === 'C';
    const finishInput = document.getElementById('springFinishTime')?.value?.trim() || null;

    // Collect shots. A partial grid saves (see springShotCounts); only an impossible count blocks.
    const shotSeries = isClassC ? springCollectClassCShots() : springCollectClassAShots();
    const counts = springShotCounts(shotSeries, isClassC);
    const overcount = springShotOvercount(counts);
    if (overcount) {
        showSpringMessage(overcount, 'danger');
        return;
    }
    const partialNote = springPartialNote(counts);

    const multiplier = isClassC
        ? parseInt(document.querySelector('input[name="springMultiplier"]:checked')?.value || '1')
        : 1;

    const requestData = {
        competitionId: springCompetitionId,
        memberId: shooter.memberId,
        weaponClass: shooter.weaponClass,
        ageGenderClass: shooter.ageGenderClass,
        finishTimeInput: finishInput,
        shotSeries: shotSeries,
        penaltyMultiplier: multiplier,
        status: null
    };

    try {
        const data = await springFetchWithRetry('/umbraco/surface/Springskytte/SaveSpringskytteResult', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(requestData)
        });

        if (data.success) {
            // Use server-verified data (read-back from DB) — not local copies
            shooter.hasResult = true;
            shooter.existingResult = {
                sprintTimeSeconds: data.sprintTimeSeconds,
                shootingScore: data.shootingScore,
                totalTimeSeconds: data.totalTimeSeconds,
                totalTimeDisplay: data.totalTimeDisplay,
                status: null,
                penaltyMultiplier: data.penaltyMultiplier,
                shots: data.verificationShots || shotSeries
            };

            // Client-side verification: compare sent shots with server-verified shots
            let verifyFailed = false;
            if (data.verificationShots) {
                const sentJson = JSON.stringify(shotSeries);
                const storedJson = JSON.stringify(data.verificationShots);
                if (sentJson !== storedJson) {
                    verifyFailed = true;
                    showSpringMessage('⚠ VARNING: Verifieringsfel — sparade skott skiljer sig från inskickade. Kontrollera resultatet!', 'danger');
                    console.error('Shot verification mismatch!', { sent: shotSeries, stored: data.verificationShots });
                }
            }
            if (!verifyFailed) {
                const verified = data.verificationShots ? '✓ Verifierat och sparat' : 'Sparat';
                if (partialNote) {
                    // Amber, and it names what's missing: skjutpoängen only counts entered shots,
                    // so a half-entered result must never read as a finished one.
                    showSpringMessage(`${verified} som DELRESULTAT: ${partialNote}. Skjutpoängen räknas bara på registrerade skott.`, 'warning');
                } else {
                    showSpringMessage(`${verified}: ${data.totalTimeDisplay || '-'}`, 'success');
                }
            }

            // Re-take snapshot so current state is now the "saved" baseline
            springASnapshot = springATakeSnapshot();
            springPaintShotCountBadge('springShotCount', counts);

            // Only auto-advance on a COMPLETE result — a partial save means the functionary
            // is coming back to this shooter, so jumping away would lose their place.
            if (!partialNote && springCurrentIndex < springFilteredShooters.length - 1) {
                setTimeout(() => { springNextShooter(); }, 500);
            }
        } else {
            showSpringMessage(data.message || 'Fel vid sparning.', 'danger');
        }
    } catch (err) {
        console.error('Error saving result:', err);
        showSpringMessage('Ett fel uppstod vid sparning.', 'danger');
    }
}

function springClearResult() {
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) return;
    if (!confirm(`Rensa skjutresultaten för ${shooter.memberName}?`)) return;

    const isClassC = shooter.weaponClass === 'C';
    if (isClassC) {
        for (let stop = 1; stop <= 6; stop++) {
            for (let shot = 1; shot <= 5; shot++) {
                const btn = document.getElementById(`shot_${stop}_${shot}`);
                if (btn) {
                    btn.dataset.value = '';
                    btn.textContent = '-';
                    btn.classList.remove('active-hit', 'active-miss');
                    btn.classList.add('btn-outline-secondary');
                }
            }
        }
        springRecalcClassC();
    } else {
        const numTargets = springNumberOfSeries || 2;
        for (let t = 1; t <= numTargets; t++) {
            for (let z = 0; z < 5; z++) {
                const input = document.getElementById(`target_${t}_zone_${z}`);
                if (input) input.value = '';
            }
        }
        springRecalcClassA();
    }
    showSpringMessage('Skjutresultaten har rensats.', 'success');
}

function springCollectClassCShots() {
    const series = [];
    for (let stop = 1; stop <= 6; stop++) {
        const stopShots = [];
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`shot_${stop}_${shot}`);
            stopShots.push(btn?.dataset.value || '');
        }
        series.push(stopShots);
    }
    return series;
}

function springCollectClassAShots() {
    const targets = [];
    const numTargets = springNumberOfSeries || 2;

    for (let t = 1; t <= numTargets; t++) {
        const zoneCounts = [];
        for (let z = 0; z < 5; z++) {
            const input = document.getElementById(`target_${t}_zone_${z}`);
            zoneCounts.push(input?.value || '0');
        }
        targets.push(zoneCounts);
    }
    return targets;
}

// ===== TAB C: RANGE OFFICER MODE =====

// Snapshot of Class C state when a shooter is loaded/saved — used to detect unsaved changes
let springCSnapshot = null;

function springCTakeSnapshot() {
    return JSON.stringify({
        shots: springCCollectShots(),
        hands: springCCollectHands(),
        finishTime: document.getElementById('cFinishTime')?.value || '',
        multiplier: springCMultiplier
    });
}

function springCHasUnsavedChanges() {
    if (!springCActiveShooter || !springCSnapshot) return false;
    return springCTakeSnapshot() !== springCSnapshot;
}

async function springCLookup() {
    const input = document.getElementById('springCStartNumber');
    const startNumber = parseInt(input?.value);
    if (!startNumber || isNaN(startNumber)) {
        showSpringCToast('Ange ett startnummer.', 'warning');
        input?.focus();
        return;
    }

    // Each shot toggle auto-saves, so there's no manual-save prompt — just flush any pending
    // auto-save for the current shooter before switching, so nothing in flight is lost.
    const outgoing = springCActiveShooter;
    if (outgoing) {
        clearTimeout(springCAutoSaveTimer);
        if (springCHasUnsavedChanges() || springCAutoSaveInFlight || springCAutoSavePending) {
            await springCAutoSave();
            while (springCAutoSavePending || springCAutoSaveInFlight) { await new Promise(r => setTimeout(r, 100)); }
        }
        springCLogRecent(outgoing);  // record the shooter we're leaving in "Senast registrerade"
    }

    // Find shooter by start order, Class C only
    const shooter = springShooters.find(s => s.startOrder === startNumber && s.weaponClass === 'C');
    if (!shooter) {
        showSpringCToast(`Startnummer ${startNumber} hittades inte (Vapengrupp C).`, 'danger');
        input?.select();
        input?.focus();
        return;
    }

    springCActiveShooter = shooter;
    springCRenderActiveCard(shooter);
    // Empty the picker and keep the caret in it, so the next number can be typed straight away with
    // no deleting. Safe only because the loaded shooter is named in the banner, not read off here.
    // A FAILED lookup keeps its value (selected) so a mistyped number can be corrected.
    if (input) { input.value = ''; input.focus(); }
}

function springCRenderActiveCard(shooter) {
    const card = document.getElementById('springCActiveCard');
    const existing = shooter.existingResult;
    const hasStartTime = !!shooter.startTime;
    const multiplierVal = existing?.penaltyMultiplier || 1;

    let html = `
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">#${shooter.startOrder} — ${shooter.memberName} <small class="opacity-75">(${formatAgeSpan(shooter.registeredClass)})</small></h5>
        </div>
        <div class="card-body">
            <!-- Stations: 6 x 5 shots, large buttons -->
            <h6 class="mb-2"><i class="bi bi-bullseye me-1"></i>Stationer</h6>`;

    for (let stop = 1; stop <= 6; stop++) {
        // Grip starts UNSET — the score-keeper must actively choose. Tapping cycles
        // Fattning? → Enhand → Tvåhand → Fattning?. The dashed outline signals it's a button.
        html += `
            <div class="spring-c-station" id="cStation${stop}">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="spring-c-station-header">Station ${stop} <span class="fw-normal text-muted small" id="cStop${stop}Count">0/5</span></span>
                    <button type="button" class="btn btn-sm btn-outline-primary hand-toggle-btn hand-unset" id="cHand_${stop}"
                        data-stop="${stop}" data-hand="" onclick="springCToggleHand(this)"><i class="bi bi-hand-index-thumb"></i> Fattning?</button>
                </div>
                <div class="d-flex gap-2 flex-wrap" id="cStationShots${stop}">`;
        for (let shot = 1; shot <= 5; shot++) {
            const id = `cShot_${stop}_${shot}`;
            html += `
                    <button type="button" class="btn btn-outline-secondary shot-btn-lg" id="${id}"
                        onclick="springCToggleShot(this)" data-stop="${stop}" data-shot="${shot}" data-value="">
                        -
                    </button>`;
        }
        html += `
                </div>
            </div>`;
    }

    html += `
            <!-- Grip warning: fewer than 3 one-hand stations (waived for age class 65+) -->
            <div id="cHandWarning" class="alert alert-warning py-2 px-3 small mb-3" style="display:none"></div>

            <!-- Shooting score summary + auto-save status (each toggle saves automatically) -->
            <div class="d-flex align-items-center gap-3 my-3 p-2 rounded" style="background: var(--bs-tertiary-bg);">
                <span class="fw-bold">Skjutpoäng: <span id="cTotalMisses" class="text-danger fs-5">0</span></span>
                <span class="fw-bold" data-shotcount-wrap>Skott: <span id="cShotCount" class="fw-bold text-warning">0/30</span></span>
                <span class="ms-auto small" id="cSaveStatus"></span>
            </div>

            <!-- Penalty multiplier -->
            <div class="mb-3">
                <label class="form-label fw-bold">Skjutpoäng per bom</label>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-lg ${multiplierVal !== 2 ? 'btn-primary' : 'btn-outline-secondary'}" id="cMult1"
                        onclick="springCSetMultiplier(1)">x1 Normal</button>
                    <button type="button" class="btn btn-lg ${multiplierVal === 2 ? 'btn-warning' : 'btn-outline-secondary'}" id="cMult2"
                        onclick="springCSetMultiplier(2)">x2 Märkestagning</button>
                </div>
            </div>

            <!-- Straff & tidsavdrag — the range officer at the pad witnesses weapons/safety issues,
                 so they can add penalties/extra time to the same ledger as the timekeeper. -->
            <div class="border rounded p-2 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Straff &amp; tidsavdrag</span>
                    <button class="btn btn-outline-danger btn-sm" onclick="springCOpenAdj()"><i class="bi bi-plus-lg"></i> Lägg till</button>
                </div>
                <div id="springCAdjList"><span class="text-muted small">Inga</span></div>
            </div>

            <!-- Timekeeping (Måltid/Löptid/Sluttid) and DNS/DNF live in the separate
                 "Tidtagning & straff" view — this scoring view is shots only. Each shot toggle
                 auto-saves; just enter the next start number to move on (no "done" button needed). -->
        </div>
    </div>`;

    card.innerHTML = html;
    card.style.display = 'block';
    springRenderCurrentShooterBanner('springCCurrentBanner', shooter);

    // Reset auto-save state for the freshly loaded shooter
    clearTimeout(springCAutoSaveTimer);
    springCAutoSaveInFlight = false;
    springCAutoSavePending = false;
    springCSetSaveStatus('');
    springCLoadAdj();

    // Init Flatpickr for finish time
    if (hasStartTime) {
        flatpickr('#cFinishTime', {
            locale: 'sv',
            enableTime: true,
            noCalendar: true,
            dateFormat: 'H:i:S',
            time_24hr: true,
            enableSeconds: true
        });
    }

    // Init multiplier state
    springCMultiplier = multiplierVal;
    springCLockedStations = new Set();

    // Restore existing data if shooter has result
    if (existing && shooter.hasResult) {
        // Restore previously saved shots. Stations stay editable — every toggle auto-saves,
        // so there's no manual save + lock step any more (re-opening a scored shooter must
        // still allow corrections).
        if (existing.shots && existing.shots.length) {
            for (let stop = 0; stop < existing.shots.length && stop < 6; stop++) {
                const stopShots = existing.shots[stop];
                for (let shot = 0; shot < stopShots.length && shot < 5; shot++) {
                    const btn = document.getElementById(`cShot_${stop + 1}_${shot + 1}`);
                    if (!btn) continue;
                    const val = stopShots[shot];
                    if (val === 'H') {
                        btn.dataset.value = 'H';
                        btn.textContent = 'T';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-hit');
                    } else if (val === 'B') {
                        btn.dataset.value = 'B';
                        btn.textContent = 'B';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-miss');
                    }
                }
            }
        }

        // Restore finish time from start time + sprint time
        if (existing.sprintTimeSeconds != null && hasStartTime) {
            const startSec = parseTimeToSeconds(shooter.startTime);
            if (startSec !== null) {
                const finishSec = startSec + existing.sprintTimeSeconds;
                const finishTimeStr = formatSecondsToHMS(finishSec);
                const finishEl = document.getElementById('cFinishTime');
                if (finishEl) {
                    finishEl.value = finishTimeStr;
                    if (finishEl._flatpickr) finishEl._flatpickr.setDate(finishTimeStr, true);
                }
            }
        }

        // Restore saved per-station grip (falls back to the alternating default set in the markup).
        if (Array.isArray(existing.stationHands) && existing.stationHands.length) {
            for (let stop = 1; stop <= 6; stop++) {
                const hv = existing.stationHands[stop - 1];
                if (hv === '1' || hv === '2') {
                    const hbtn = document.getElementById(`cHand_${stop}`);
                    if (hbtn) springCApplyHandStyle(hbtn, hv);
                }
            }
        }

        // Recalculate station counts, shooting score, sprint/total from restored finish time
        springCRecalc();
    }

    // Evaluate the grip warning for the freshly loaded shooter (defaults are valid, but a restored
    // shooter may already have < 3 one-hand stations recorded).
    springCUpdateHandWarning();

    // Take snapshot of initial state for unsaved-changes detection
    springCSnapshot = springCTakeSnapshot();
}

let springCMultiplier = 1;

function springCSetMultiplier(val) {
    springCMultiplier = val;
    document.getElementById('cMult1').className = `btn btn-lg ${val === 1 ? 'btn-primary' : 'btn-outline-secondary'}`;
    document.getElementById('cMult2').className = `btn btn-lg ${val === 2 ? 'btn-warning' : 'btn-outline-secondary'}`;
    springCRecalc();
    springCScheduleAutoSave();
}

// ===== Per-station grip (unset / one hand / two hands) =====
// Three-state toggle on each station header, stored parallel to the shots as "" / "1" / "2".
// Starts unset so the score-keeper must actively choose (no silent preset).
function springCApplyHandStyle(btn, hand) {
    if (hand === '1') {
        btn.className = 'btn btn-sm hand-toggle-btn hand-one';
        btn.innerHTML = '<i class="bi bi-hand-index"></i> Enhand';
        btn.dataset.hand = '1';
    } else if (hand === '2') {
        btn.className = 'btn btn-sm hand-toggle-btn hand-two';
        btn.innerHTML = '<i class="bi bi-hexagon"></i> Tvåhand';
        btn.dataset.hand = '2';
    } else {
        btn.className = 'btn btn-sm btn-outline-primary hand-toggle-btn hand-unset';
        btn.innerHTML = '<i class="bi bi-hand-index-thumb"></i> Fattning?';
        btn.dataset.hand = '';
    }
}

function springCToggleHand(btn) {
    const cur = btn.dataset.hand || '';
    const next = cur === '' ? '1' : (cur === '1' ? '2' : '');
    springCApplyHandStyle(btn, next);
    springCUpdateHandWarning();
    springCScheduleAutoSave();
}

function springCCollectHands() {
    const hands = [];
    for (let stop = 1; stop <= 6; stop++) {
        const v = document.getElementById(`cHand_${stop}`)?.dataset.hand;
        hands.push(v === '1' ? '1' : (v === '2' ? '2' : ''));
    }
    return hands;
}

// 65+ age classes may shoot two-handed on all stations, so they're exempt from the rule.
function springIsTwoHandExempt(ageOrClass) {
    const m = String(ageOrClass || '').match(/(\d+)/);
    return m ? parseInt(m[1], 10) >= 65 : false;
}

// Rule: at least 3 of 6 stations one-handed ⇔ at most 3 two-handed. So 4+ two-hand stations is a
// definite violation regardless of any still-unset stations — no false alarms from the unset default.
function springCUpdateHandWarning() {
    const el = document.getElementById('cHandWarning');
    if (!el) return;
    const shooter = springCActiveShooter;
    const twoHand = springCCollectHands().filter(h => h === '2').length;
    const exempt = springIsTwoHandExempt(shooter?.ageGenderClass || shooter?.registeredClass);
    if (!exempt && twoHand >= 4) {
        el.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i><strong>${twoHand}</strong> stationer med tvåhandsfattning — högst <strong>3</strong> tillåtet (gäller ej klass 65+).`;
        el.style.display = '';
    } else {
        el.style.display = 'none';
    }
}

function springCToggleShot(btn) {
    const current = btn.dataset.value;
    if (current === '' || current === undefined) {
        btn.dataset.value = 'H';
        btn.textContent = 'T';
        btn.classList.remove('btn-outline-secondary', 'active-miss');
        btn.classList.add('active-hit');
    } else if (current === 'H') {
        btn.dataset.value = 'B';
        btn.textContent = 'B';
        btn.classList.remove('active-hit');
        btn.classList.add('active-miss');
    } else {
        btn.dataset.value = '';
        btn.textContent = '-';
        btn.classList.remove('active-hit', 'active-miss');
        btn.classList.add('btn-outline-secondary');
    }
    springCRecalc();
    springCScheduleAutoSave();
}

// ===== Auto-save (Class C scoring) — each shot/multiplier change saves the current grid.
// Sends shots only (no finish/status) so it never clobbers the timing role's finish time;
// SaveSpringskytteResult preserves the stored sprint. Debounced + coalesced so rapid taps
// collapse into the latest state. Safe for parallel scoring + timing on several devices. =====
let springCAutoSaveTimer = null;
let springCAutoSaveInFlight = false;
let springCAutoSavePending = false;

function springCSetSaveStatus(state) {
    const el = document.getElementById('cSaveStatus');
    if (!el) return;
    if (state === 'pending') el.innerHTML = '<span class="text-muted"><i class="bi bi-pencil"></i> ändrat…</span>';
    else if (state === 'saving') el.innerHTML = '<span class="text-muted"><i class="bi bi-arrow-repeat"></i> sparar…</span>';
    else if (state === 'saved') el.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i> sparat</span>';
    else if (state === 'error') el.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> ej sparat – försök igen</span>';
    else el.innerHTML = '';
}

function springCScheduleAutoSave() {
    springCSetSaveStatus('pending');
    clearTimeout(springCAutoSaveTimer);
    springCAutoSaveTimer = setTimeout(springCAutoSave, 400);
}

async function springCAutoSave() {
    const shooter = springCActiveShooter;
    if (!shooter) return;
    if (springCAutoSaveInFlight) { springCAutoSavePending = true; return; }  // coalesce
    springCAutoSaveInFlight = true;
    springCSetSaveStatus('saving');
    const shotSeries = springCCollectShots();
    const requestData = {
        competitionId: springCompetitionId,
        memberId: shooter.memberId,
        weaponClass: shooter.weaponClass,
        ageGenderClass: shooter.ageGenderClass,
        finishTimeInput: null,   // scoring never touches time — server preserves the timing role's finish
        shotSeries: shotSeries,
        stationHands: springCCollectHands(),
        penaltyMultiplier: springCMultiplier,
        status: null
    };
    try {
        const data = await springFetchWithRetry('/umbraco/surface/Springskytte/SaveSpringskytteResult', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value },
            body: JSON.stringify(requestData)
        });
        const stillActive = springCActiveShooter && springCActiveShooter.memberId === shooter.memberId && springCActiveShooter.weaponClass === shooter.weaponClass;
        if (data.success) {
            shooter.hasResult = true;
            shooter.existingResult = {
                shootingScore: data.shootingScore, totalTimeSeconds: data.totalTimeSeconds,
                totalTimeDisplay: data.totalTimeDisplay, sprintTimeSeconds: data.sprintTimeSeconds,
                status: null, penaltyMultiplier: data.penaltyMultiplier, shots: data.verificationShots || shotSeries
            };
            let ok = true;
            if (data.verificationShots && JSON.stringify(shotSeries) !== JSON.stringify(data.verificationShots)) {
                ok = false; console.error('Auto-save shot verification mismatch', { sent: shotSeries, stored: data.verificationShots });
            }
            // Mark the current grid as saved so we don't later prompt about "unsaved changes".
            if (stillActive && ok) springCSnapshot = springCTakeSnapshot();
            if (stillActive) springCSetSaveStatus(ok ? 'saved' : 'error');
        } else if (stillActive) {
            springCSetSaveStatus('error');
        }
    } catch (err) {
        console.error('Auto-save error:', err);
        springCSetSaveStatus('error');
    } finally {
        springCAutoSaveInFlight = false;
        if (springCAutoSavePending) { springCAutoSavePending = false; springCAutoSave(); }  // flush latest state
    }
}

// Log the outgoing shooter in the "Senast registrerade" list once their score is saved.
function springCLogRecent(shooter) {
    if (!shooter || !shooter.hasResult) return;
    springCRecentEntries.unshift({
        startOrder: shooter.startOrder, name: shooter.memberName, registeredClass: shooter.registeredClass,
        totalTimeDisplay: shooter.existingResult?.totalTimeDisplay, shootingScore: shooter.existingResult?.shootingScore
    });
    if (springCRecentEntries.length > 5) springCRecentEntries.pop();
    springCRenderRecentList();
}

// ===== Straff & tidsavdrag on the scoring pads (same ledger as the timekeeper) =====
async function springRenderAdjBadges(shooter, elId, delFnName) {
    const el = document.getElementById(elId);
    if (!shooter || !el) return;
    try {
        const d = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteAdjustments?competitionId=${springCompetitionId}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
        const list = (d.success ? (d.adjustments || []) : []).filter(a => a.memberId === shooter.memberId && a.weaponClass === shooter.weaponClass);
        el.innerHTML = list.length ? list.map(a => {
            const isPen = a.adjustmentType === 'Penalty'; let label;
            if (isPen) label = '+' + a.points + ' min'; else { const mag = Math.abs(a.seconds); label = '−' + (mag % 60 === 0 ? (mag / 60) + ' min' : mag + ' s'); }
            return `<span class="badge ${isPen ? 'bg-danger' : 'bg-success'} me-1 mb-1" title="${springTimeEsc(a.reason || '')}">${label} <a href="#" class="text-white ms-1" onclick="${delFnName}(${a.id});return false;">&times;</a></span>`;
        }).join('') : '<span class="text-muted small">Inga</span>';
    } catch (e) { }
}
async function springDelAdjGeneric(id, reloadFn) {
    if (!confirm('Ta bort denna post?')) return;
    try {
        await fetch('/umbraco/surface/Springskytte/DeleteSpringskytteAdjustment', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value }, body: JSON.stringify({ id, competitionId: springCompetitionId }) });
        reloadFn();
    } catch (e) { }
}
// Tab C (Vapengrupp C pad)
function springCOpenAdj() {
    const s = springCActiveShooter; if (!s) return;
    springOpenAdjFor({ memberId: s.memberId, weaponClass: s.weaponClass, name: s.memberName, ageGenderClass: s.ageGenderClass }, springCLoadAdj);
}
function springCLoadAdj() { springRenderAdjBadges(springCActiveShooter, 'springCAdjList', 'springCDelAdj'); }
function springCDelAdj(id) { springDelAdjGeneric(id, springCLoadAdj); }
// Tab A (Vapengrupp A pad)
function springAOpenAdj() {
    const s = springFilteredShooters[springCurrentIndex]; if (!s) return;
    springOpenAdjFor({ memberId: s.memberId, weaponClass: s.weaponClass, name: s.memberName, ageGenderClass: s.ageGenderClass }, springALoadAdj);
}
function springALoadAdj() { springRenderAdjBadges(springFilteredShooters[springCurrentIndex], 'springAAdjList', 'springADelAdj'); }
function springADelAdj(id) { springDelAdjGeneric(id, springALoadAdj); }

function springCRecalc() {
    let totalMisses = 0;
    for (let stop = 1; stop <= 6; stop++) {
        let hits = 0, misses = 0;
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`cShot_${stop}_${shot}`);
            if (btn?.dataset.value === 'H') hits++;
            if (btn?.dataset.value === 'B') misses++;
        }
        totalMisses += misses;
        const countEl = document.getElementById(`cStop${stop}Count`);
        if (countEl) countEl.textContent = `${hits}/5`;
    }

    document.getElementById('cTotalMisses').textContent = totalMisses;
    springPaintShotCountBadge('cShotCount', springShotCounts(springCCollectShots(), true));

    const shooter = springCActiveShooter;
    const finishInput = document.getElementById('cFinishTime')?.value;
    const sprintSeconds = shooter?.startTime ? calculateSprintTime(shooter.startTime, finishInput) : null;

    const sprintEl = document.getElementById('cSprintTime');
    if (sprintEl) sprintEl.textContent = sprintSeconds !== null ? formatSecondsToTime(sprintSeconds) : '-';

    const shootingScore = totalMisses * springCMultiplier;
    const totalEl = document.getElementById('cTotalTime');
    if (sprintSeconds !== null) {
        const totalSeconds = sprintSeconds + shootingScore * 60;
        if (totalEl) totalEl.textContent = formatSecondsToTime(totalSeconds);
    } else {
        if (totalEl) totalEl.textContent = '-';
    }
}

// Listen for Class C finish time changes
document.addEventListener('input', function(e) {
    if (e.target.id === 'cFinishTime') springCRecalc();
});

function springCNow() {
    const el = document.getElementById('cFinishTime');
    if (el && el.value.trim() && !confirm('Måltid är redan ifylld. Vill du skriva över med aktuell tid?')) return;

    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    const s = String(now.getSeconds()).padStart(2, '0');
    const timeStr = `${h}:${m}:${s}`;
    if (el) {
        el.value = timeStr;
        if (el._flatpickr) el._flatpickr.setDate(timeStr, true);
    }
    springCRecalc();
}

function springCCollectShots() {
    const series = [];
    for (let stop = 1; stop <= 6; stop++) {
        const stopShots = [];
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`cShot_${stop}_${shot}`);
            stopShots.push(btn?.dataset.value || '');
        }
        series.push(stopShots);
    }
    return series;
}

async function springCSave() {
    const shooter = springCActiveShooter;
    if (!shooter) return;

    const finishInput = document.getElementById('cFinishTime')?.value?.trim() || null;
    const shotSeries = springCCollectShots();

    // A partial grid saves (the pad banks stations as they're shot); only an impossible count blocks.
    const counts = springShotCounts(shotSeries, true);
    const overcount = springShotOvercount(counts);
    if (overcount) {
        showSpringCToast(overcount, 'danger');
        return;
    }
    const partialNote = springPartialNote(counts);

    const requestData = {
        competitionId: springCompetitionId,
        memberId: shooter.memberId,
        weaponClass: shooter.weaponClass,
        ageGenderClass: shooter.ageGenderClass,
        finishTimeInput: finishInput,
        shotSeries: shotSeries,
        stationHands: springCCollectHands(),
        penaltyMultiplier: springCMultiplier,
        status: null
    };

    const saveBtn = document.getElementById('cSaveBtn');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...'; }

    try {
        const data = await springFetchWithRetry('/umbraco/surface/Springskytte/SaveSpringskytteResult', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(requestData)
        });

        if (data.success) {
            // Use server-verified data (read-back from DB)
            shooter.hasResult = true;
            shooter.existingResult = {
                shootingScore: data.shootingScore,
                totalTimeSeconds: data.totalTimeSeconds,
                totalTimeDisplay: data.totalTimeDisplay,
                sprintTimeSeconds: data.sprintTimeSeconds,
                status: null,
                penaltyMultiplier: data.penaltyMultiplier,
                shots: data.verificationShots || shotSeries
            };

            // Client-side verification
            let verifiedMsg = `Sparat: ${shooter.memberName} — ${data.totalTimeDisplay || '-'}`;
            if (data.verificationShots) {
                const sentJson = JSON.stringify(shotSeries);
                const storedJson = JSON.stringify(data.verificationShots);
                if (sentJson !== storedJson) {
                    showSpringCToast('⚠ VARNING: Skottdata verifieringsfel! Kontrollera resultatet.', 'danger');
                    console.error('Shot verification mismatch!', { sent: shotSeries, stored: data.verificationShots });
                    // Don't clear the card — let the user review
                    return;
                }
                verifiedMsg = `✓ Verifierat: ${shooter.memberName} — ${data.totalTimeDisplay || '-'}`;
            }

            // Add to recent entries
            springCRecentEntries.unshift({
                startOrder: shooter.startOrder,
                name: shooter.memberName,
                registeredClass: shooter.registeredClass,
                totalTimeDisplay: data.totalTimeDisplay,
                shootingScore: data.shootingScore
            });
            if (springCRecentEntries.length > 5) springCRecentEntries.pop();
            springCRenderRecentList();

            if (partialNote) {
                showSpringCToast(`${verifiedMsg} — DELRESULTAT: ${partialNote}`, 'warning');
                // Keep the card open: a partial save means this shooter isn't finished.
                springCSnapshot = springCTakeSnapshot();
            } else {
                showSpringCToast(verifiedMsg, 'success');

                // Clear state and refocus
                springCSnapshot = null;
                document.getElementById('springCActiveCard').style.display = 'none';
                springRenderCurrentShooterBanner('springCCurrentBanner', null);
                springCActiveShooter = null;
                const input = document.getElementById('springCStartNumber');
                if (input) { input.value = ''; input.focus(); }
            }
        } else {
            showSpringCToast(data.message || 'Fel vid sparning.', 'danger');
        }
    } catch (err) {
        console.error('Error saving Class C result:', err);
        showSpringCToast('Ett fel uppstod vid sparning.', 'danger');
    } finally {
        if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Spara resultat'; }
    }
}

function springCRenderRecentList() {
    const container = document.getElementById('springCRecentList');
    if (!springCRecentEntries.length) { container.innerHTML = ''; return; }

    let html = '<h6 class="text-muted mb-2"><i class="bi bi-clock-history me-1"></i>Senast registrerade</h6>';
    html += '<div class="list-group">';
    for (const entry of springCRecentEntries) {
        html += `
        <div class="list-group-item list-group-item-action spring-c-recent-item d-flex justify-content-between align-items-center"
            onclick="document.getElementById('springCStartNumber').value='${entry.startOrder}'; springCLookup();">
            <div>
                <span class="fw-bold">#${entry.startOrder}</span> ${entry.name}
                <small class="text-muted ms-1">(${entry.registeredClass})</small>
            </div>
            <div class="text-end">
                <span class="badge bg-success">${entry.totalTimeDisplay || '-'}</span>
                <small class="text-muted ms-1">Skjutp: ${entry.shootingScore}</small>
            </div>
        </div>`;
    }
    html += '</div>';
    container.innerHTML = html;
}

function showSpringCToast(msg, type) {
    const container = document.getElementById('springTabC');
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-2`;
    alertDiv.style.position = 'relative';
    alertDiv.style.zIndex = '20';
    alertDiv.innerHTML = `${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    container.prepend(alertDiv);
    setTimeout(() => alertDiv.remove(), 3000);
}

// ===== DNS / DNF (Ej start / Bröt) =====
// Springskytte stores Status = 'DNS'/'DNF'; the server nulls time+score for those rows and the
// tiebreaker sorts them last. A DNS/DNF save carries empty shots + no time (verification-safe).

function springStatusLabel(status) {
    return status === 'DNS' ? 'Ej start (DNS)' : 'Bröt (DNF)';
}

function springStatusBadge(shooter) {
    const st = shooter.existingResult?.status;
    if (st === 'DNS' || st === 'DNF')
        return `<span class="badge bg-dark">${springStatusLabel(st)}</span>`;
    return shooter.hasResult
        ? '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Har resultat</span>'
        : '<span class="badge bg-secondary">Inget resultat</span>';
}

async function springPostStatus(shooter, status) {
    const requestData = {
        competitionId: springCompetitionId,
        memberId: shooter.memberId,
        weaponClass: shooter.weaponClass,
        ageGenderClass: shooter.ageGenderClass,
        finishTimeInput: null,
        shotSeries: [],
        penaltyMultiplier: 1,
        status: status
    };
    return await springFetchWithRetry('/umbraco/surface/Springskytte/SaveSpringskytteResult', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify(requestData)
    });
}

function springApplyStatusToShooter(shooter, status) {
    shooter.hasResult = true;
    shooter.existingResult = {
        status: status,
        shootingScore: null,
        sprintTimeSeconds: null,
        totalTimeSeconds: null,
        totalTimeDisplay: springStatusLabel(status),
        penaltyMultiplier: 1,
        shots: []
    };
}

// Class A entry (single-shooter navigator)
async function springASetStatus(status) {
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) return;
    if (!confirm(`Markera ${shooter.memberName} som "${springStatusLabel(status)}"? Tid och skjutresultat sparas tomt.`)) return;
    try {
        const data = await springPostStatus(shooter, status);
        if (data.success) {
            springApplyStatusToShooter(shooter, status);
            showSpringMessage(`${shooter.memberName} markerad som ${springStatusLabel(status)}.`, 'success');
            springRenderEntry();
            springASnapshot = springATakeSnapshot();
            if (springCurrentIndex < springFilteredShooters.length - 1) {
                setTimeout(() => { springNextShooter(); }, 500);
            }
        } else {
            showSpringMessage(data.message || 'Fel vid sparning.', 'danger');
        }
    } catch (err) {
        console.error('Error setting DNS/DNF status:', err);
        showSpringMessage('Ett fel uppstod.', 'danger');
    }
}

// Class C entry (range-officer card)
async function springCSetStatus(status) {
    const shooter = springCActiveShooter;
    if (!shooter) return;
    if (!confirm(`Markera ${shooter.memberName} som "${springStatusLabel(status)}"?`)) return;
    try {
        const data = await springPostStatus(shooter, status);
        if (data.success) {
            springApplyStatusToShooter(shooter, status);
            springCRecentEntries.unshift({
                startOrder: shooter.startOrder,
                name: shooter.memberName,
                registeredClass: shooter.registeredClass,
                totalTimeDisplay: springStatusLabel(status),
                shootingScore: '-'
            });
            if (springCRecentEntries.length > 5) springCRecentEntries.pop();
            springCRenderRecentList();
            showSpringCToast(`${shooter.memberName} markerad som ${springStatusLabel(status)}.`, 'success');
            springCSnapshot = null;
            document.getElementById('springCActiveCard').style.display = 'none';
            springRenderCurrentShooterBanner('springCCurrentBanner', null);
            springCActiveShooter = null;
            const input = document.getElementById('springCStartNumber');
            if (input) { input.value = ''; input.focus(); }
        } else {
            showSpringCToast(data.message || 'Fel vid sparning.', 'danger');
        }
    } catch (err) {
        console.error('Error setting DNS/DNF status:', err);
        showSpringCToast('Ett fel uppstod.', 'danger');
    }
}

// ===== RESULTS LIST =====

// A and C are separate lists that finish at different times, so each weapon group is published on its
// own. The header badge summarises ("A publicerad · C preliminär") and the per-class blocks below carry
// the buttons. springPerClassPublish is false on installs missing the doctype property — then the old
// whole-competition buttons in the header are used instead.
let springPerClassPublish = false;
let springOfficialClasses = [];

function springSetResultsStatus(resultsExist, isOfficial, official, classes) {
    const badge = document.getElementById('springResultsStatusBadge');
    const updAll = document.getElementById('springUpdateAllBtn');
    const pub = document.getElementById('springPublishBtn');
    const unpub = document.getElementById('springUnpublishBtn');
    const printBtn = document.getElementById('springPrintBtn');
    if (printBtn) printBtn.style.display = resultsExist ? '' : 'none';

    // "Uppdatera" stays in the header (it's how you calculate the list in the first place). Publish and
    // unpublish live in the per-group blocks whenever there are groups to publish; with no groups yet the
    // whole-competition buttons are the only sensible affordance.
    const perClassBlocks = (classes || []).length > 0;
    if (updAll) updAll.style.display = '';
    if (pub) pub.style.display = (!perClassBlocks && !isOfficial) ? '' : 'none';
    if (unpub) unpub.style.display = (!perClassBlocks && isOfficial) ? '' : 'none';

    if (!badge) return;
    if (!resultsExist) {
        badge.className = 'badge bg-secondary ms-2'; badge.textContent = 'Ej skapad';
        return;
    }
    if (springPerClassPublish && (classes || []).length) {
        const parts = classes.map(wc => (official || []).includes(wc)
            ? `${wc} publicerad` : `${wc} preliminär`);
        badge.className = 'badge ms-2 ' + ((official || []).length === classes.length ? 'bg-success'
            : (official || []).length ? 'bg-info text-dark' : 'bg-warning text-dark');
        badge.textContent = parts.join(' · ');
    } else if (isOfficial) {
        badge.className = 'badge bg-success ms-2'; badge.innerHTML = '<i class="bi bi-check-circle me-1"></i>Publicerad';
    } else {
        badge.className = 'badge bg-warning text-dark ms-2'; badge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Preliminär';
    }
}

// "Uppdatera" — recompute, preserving what is published (never auto-publishes). weaponClass '' = all.
async function springCreateResultsList(event, weaponClass) {
    if (event) event.stopPropagation();
    const btn = event?.target?.closest('button');
    const label = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Uppdaterar...'; }
    try {
        const data = await springResultsPostClass('CalculateSpringskytteFinalResults', weaponClass);
        if (data.success) { showSpringMessage(data.message, 'success'); springLoadResultsList(); }
        else { alert(data.message || 'Fel vid beräkning.'); }
    } catch (err) { alert('Ett fel uppstod.'); }
    finally { if (btn) { btn.disabled = false; btn.innerHTML = label || '<i class="bi bi-arrow-clockwise me-1"></i>Uppdatera'; } }
}

// "Publicera" — recompute AND make it official (public). weaponClass '' = the whole competition.
async function springPublishResults(event, weaponClass) {
    if (event) event.stopPropagation();
    if (!confirm(weaponClass
        ? `Publicera resultatlistan för vapengrupp ${weaponClass}? Den blir synlig publikt på tävlingssidan. Övriga vapengrupper påverkas inte.`
        : 'Publicera resultatlistan? Den blir synlig publikt på tävlingssidan.')) return;
    const btn = event?.target?.closest('button');
    const label = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Publicerar...'; }
    try {
        const data = await springResultsPostClass('PublishSpringskytteResults', weaponClass);
        if (data.success) { showSpringMessage(data.message, 'success'); springLoadResultsList(); }
        else { alert(data.message || 'Fel vid publicering.'); }
    } catch (err) { alert('Ett fel uppstod.'); }
    finally { if (btn) { btn.disabled = false; btn.innerHTML = label || '<i class="bi bi-check-circle me-1"></i>Publicera'; } }
}

// "Gör preliminär" — hide it publicly again (keeps the computed snapshot).
async function springUnpublishResults(event, weaponClass) {
    if (event) event.stopPropagation();
    if (!confirm(weaponClass
        ? `Gör vapengrupp ${weaponClass} preliminär? Den döljs då publikt. Övriga vapengrupper påverkas inte.`
        : 'Gör resultatlistan preliminär? Den döljs då publikt.')) return;
    const btn = event?.target?.closest('button');
    const label = btn ? btn.innerHTML : '';
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>...'; }
    try {
        const data = await springResultsPostClass('SetSpringskytteResultsPreliminary', weaponClass);
        if (data.success) { showSpringMessage(data.message, 'success'); springLoadResultsList(); }
        else { alert(data.message || 'Kunde inte ändra status.'); }
    } catch (err) { alert('Ett fel uppstod.'); }
    finally { if (btn) { btn.disabled = false; btn.innerHTML = label || '<i class="bi bi-eye-slash me-1"></i>Gör preliminär'; } }
}

// Per-class endpoints take {competitionId, weaponClass}; the Deltävling ones still take a bare id.
function springResultsPostClass(action, weaponClass) {
    return fetch('/umbraco/surface/Springskytte/' + action, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify({ competitionId: parseInt(springCompetitionId, 10), weaponClass: weaponClass || '' })
    }).then(r => r.json());
}

function springResultsPost(action) {
    return fetch('/umbraco/surface/Springskytte/' + action, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
        },
        body: JSON.stringify(springCompetitionId)
    }).then(r => r.json());
}

async function springLoadResultsList() {
    try {
        const response = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteResults?competitionId=${springCompetitionId}`);
        const data = await response.json();

        const body = document.getElementById('springResultsBody');
        const content = document.getElementById('springResultsContent');
        if (!content) return; // results list isn't on the chromeless /station scoring page

        springPerClassPublish = data.supportsPerClassPublish === true;
        springOfficialClasses = data.officialWeaponClasses || [];
        // Every weapon class that has results — even one whose list isn't published yet.
        const classesWithResults = (data.weaponClassesWithResults && data.weaponClassesWithResults.length)
            ? data.weaponClassesWithResults
            : [...new Set((data.classGroups || []).map(g => g.weaponClass))].filter(Boolean).sort();
        springSetResultsStatus(data.resultsExist === true, data.resultsOfficial === true,
            springOfficialClasses, classesWithResults);

        if (data.success && data.classGroups?.length > 0) {
            if (body) body.style.display = 'block';
            // Hide the Std column entirely when the competition doesn't award standard
            // medals (or it's a club competition — server already gates the calc itself).
            const awardingMedals = data.isAwardingStandardMedals === true;

            let html = '';

            // Grip check (management alert): shooters who used one hand on fewer than 3 stations.
            // Allowed only for age class 65+, so the server already excludes those from handWarning.
            const flagged = [];
            for (const group of data.classGroups) {
                for (const s of group.shooters) if (s.handWarning) flagged.push(s);
            }
            if (flagged.length) {
                html += `
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    <strong>${flagged.length} skytt${flagged.length === 1 ? '' : 'ar'}</strong> har fler än 3 stationer med tvåhandsfattning (högst 3 tillåtet — undantag klass 65+). Kontrollera fattningen:
                    <div class="mt-1 small">${flagged.map(s => `${springTimeEsc(s.name)}${s.startOrder ? ' (' + s.startOrder + ')' : ''} — ${s.twoHandCount}/6 tvåhand`).join(' · ')}</div>
                </div>`;
            }

            // One block per weapon group, each with its own status + publish actions, so A can be
            // OFFICIELL while C is still being scored. The tables inside are unchanged.
            for (const wc of classesWithResults) {
            const wcGroups = (data.classGroups || []).filter(g => g.weaponClass === wc);
            if (!wcGroups.length) continue;
            const isOff = springOfficialClasses.includes(wc);
            const wcShooters = wcGroups.reduce((n, g) => n + (g.shooters?.length || 0), 0);
            html += `
                <div class="border rounded p-3 mb-4 ${isOff ? 'border-success' : ''}">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <span class="fw-bold fs-6">Vapengrupp ${wc}</span>
                            <span class="badge ${isOff ? 'bg-success' : 'bg-warning text-dark'} ms-2">${isOff ? 'Publicerad' : 'Preliminär'}</span>
                            <span class="text-muted small ms-2">${wcShooters} skyttar i ${wcGroups.length} klasser</span>
                        </div>
                        ${springPerClassPublish ? `
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary btn-sm" onclick="springCreateResultsList(event,'${wc}')"
                                title="Räknar om resultaten. Ändrar inte om listan är publik.">
                                <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                            </button>
                            ${isOff ? `
                            <button class="btn btn-outline-secondary btn-sm" onclick="springUnpublishResults(event,'${wc}')"
                                title="Döljer vapengruppens resultat publikt igen.">
                                <i class="bi bi-eye-slash me-1"></i>Gör preliminär
                            </button>` : `
                            <button class="btn btn-success btn-sm" onclick="springPublishResults(event,'${wc}')"
                                title="Publicerar vapengruppens resultat som officiella. Övriga vapengrupper påverkas inte.">
                                <i class="bi bi-check-circle me-1"></i>Publicera
                            </button>`}
                        </div>` : ''}
                    </div>`;

            for (const group of wcGroups) {
                html += `
                <div class="mb-4">
                    <h6 class="border-bottom pb-1">${group.className}</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped springskytte-results-table">
                            <thead>
                                <tr>
                                    <th>Plats</th>
                                    <th>Namn</th>
                                    <th>Förening</th>
                                    <th class="time-col">Löptid</th>
                                    <th>Skjutp.</th>
                                    <th class="time-col">Tillägg</th>
                                    <th class="time-col fw-bold">Sluttid</th>
                                    ${awardingMedals ? '<th>Std</th>' : ''}
                                </tr>
                            </thead>
                            <tbody>`;
                for (const s of group.shooters) {
                    const medal = s.standardMedal === 'S' ? '<span class="badge bg-secondary">S</span>'
                        : s.standardMedal === 'B' ? '<span class="badge" style="background:#cd7f32;color:#fff;">B</span>'
                        : '';
                    html += `
                                <tr>
                                    <td>${s.status ? s.status : (s.rank || '-')}</td>
                                    <td>${s.name}${s.startOrder ? ' (' + s.startOrder + ')' : ''}${s.handWarning ? ' <span class="badge bg-warning text-dark" title="Fler än 3 stationer med tvåhandsfattning (' + s.twoHandCount + '/6 tvåhand)">⚠ fattning</span>' : ''}</td>
                                    <td title="${s.club}">${s.clubShort || s.club}</td>
                                    <td class="time-col">${s.sprintTimeDisplay}</td>
                                    <td>${s.shootingScore ?? '-'}</td>
                                    <td class="time-col">${s.penaltyTimeDisplay}</td>
                                    <td class="time-col fw-bold">${s.totalTimeDisplay}</td>
                                    ${awardingMedals ? `<td>${medal}</td>` : ''}
                                </tr>`;
                }
                html += `
                            </tbody>
                        </table>
                    </div>
                </div>`;
            }
            html += `</div>`;   // close this weapon group's block
            }  // end weapon-group loop
            content.innerHTML = html;
        } else {
            content.innerHTML = `<div class="text-center py-4 text-muted"><i class="bi bi-list-check fs-3 d-block mb-2"></i>Ingen resultatlista ännu — klicka <strong>Uppdatera</strong> för att räkna ut den, och <strong>Publicera</strong> när den ska bli synlig publikt.</div>`;
        }
    } catch (err) {
        console.error('Error loading results:', err);
    }
}

// ===== DELTÄVLING (SUB-COMPETITION) RESULTS LIST =====
// Mirror of springCreateResultsList / springLoadResultsList but routed to the
// sub-comp endpoints: CalculateSpringskytteSubFinalResults flips
// subCompetitionIsOfficial=true; GetSpringskytteResults?subCompetitionOnly=true
// returns the filtered subset with medals recomputed on it.

// Deltävling status badge + publish-button visibility (mirrors springSetResultsStatus).
function springSetSubResultsStatus(resultsExist, isOfficial) {
    const badge = document.getElementById('springSubResultsStatusBadge');
    const pub = document.getElementById('springSubPublishBtn');
    const unpub = document.getElementById('springSubUnpublishBtn');
    const printBtn = document.getElementById('springSubPrintBtn');
    if (printBtn) printBtn.style.display = resultsExist ? '' : 'none';
    if (!badge) return;
    if (!resultsExist) {
        badge.className = 'badge bg-secondary ms-2'; badge.textContent = 'Ej skapad';
        if (pub) pub.style.display = ''; if (unpub) unpub.style.display = 'none';
    } else if (isOfficial) {
        badge.className = 'badge bg-success ms-2'; badge.innerHTML = '<i class="bi bi-check-circle me-1"></i>Publicerad';
        if (pub) pub.style.display = 'none'; if (unpub) unpub.style.display = '';
    } else {
        badge.className = 'badge bg-warning text-dark ms-2'; badge.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Preliminär';
        if (pub) pub.style.display = ''; if (unpub) unpub.style.display = 'none';
    }
}

// "Uppdatera" (deltävling) — just refresh the admin view; the public deltävling page is always
// recomputed live, so there's no snapshot to rebuild. Publishing is a separate action.
async function springCreateSubResultsList(event) {
    if (event) event.stopPropagation();
    const btn = event?.target?.closest('button');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Uppdaterar...'; }
