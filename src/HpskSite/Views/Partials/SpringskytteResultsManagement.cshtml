                        btn.dataset.value = 'B';
                        btn.textContent = 'B';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-miss');
                    }
                }
            }
            springRecalcClassC();
        } else {
            // Class A zone count format: each target = [ring1, ring2, ring3, ring4, bom]
            for (let t = 0; t < existing.shots.length; t++) {
