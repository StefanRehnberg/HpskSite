function toggleSpringskytteEntry(event) {
    const body = document.getElementById('springEntryBody');
    const chevron = document.getElementById('springEntryChevron');
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

function toggleSpringskytteResultsList(event) {
    const body = document.getElementById('springResultsBody');
    const chevron = document.getElementById('springResultsChevron');
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

// ===== UTILITIES =====

function parseTimeToSeconds(input) {
    if (!input) return null;
    const parts = input.trim().split(':');
    if (parts.length === 2) {
        const m = parseInt(parts[0]), s = parseInt(parts[1]);
        if (!isNaN(m) && !isNaN(s)) return m * 60 + s;
    }
    if (parts.length === 3) {
        const h = parseInt(parts[0]), m = parseInt(parts[1]), s = parseInt(parts[2]);
        if (!isNaN(h) && !isNaN(m) && !isNaN(s)) return h * 3600 + m * 60 + s;
    }
    return null;
}

function formatSecondsToTime(totalSeconds) {
    if (totalSeconds === null || totalSeconds === undefined) return '-';
    const s = Math.round(totalSeconds);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    if (h > 0) return `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
    return `${m}:${String(sec).padStart(2,'0')}`;
}

// ===== Shot-count status =====
// A PARTIAL score must be savable: the functionary at the pad banks the first target/station
// and comes back for the rest (SM dress rehearsal 2026-08-03 — entering only target 1's shots
// was refused, which forced a paper detour). So a missing shot only WARNS.
// The only hard block is an IMPOSSIBLE count — more shots on a target than the target holds —
// because that can't be a work-in-progress, it's a typo that would corrupt the score.
// Returns { per, entered, expected, over, isPartial }.
function springShotCounts(shotSeries, isClassC) {
    const per = [];
    if (isClassC) {
        // Class C: a shot is registered when the button holds 'H' or 'B' (a bom IS a shot).
        for (let i = 0; i < shotSeries.length; i++) {
            let entered = 0;
            for (const s of shotSeries[i]) {
                if (s === 'H' || s === 'B') entered++;
            }
            per.push({ label: `Station ${i + 1}`, entered: entered, expected: 5 });
        }
    } else {
        // Class A zone-count format: each target has 5 zone inputs; their sum is the shot count.
        const numTargets = springNumberOfSeries || 2;
        const shotsPerTarget = Math.floor(30 / numTargets);
        const extraShots = 30 - (shotsPerTarget * numTargets);

        for (let t = 1; t <= numTargets; t++) {
            const expected = t === numTargets ? shotsPerTarget + extraShots : shotsPerTarget;
            let entered = 0;
            for (let z = 0; z < 5; z++) {
                const input = document.getElementById(`target_${t}_zone_${z}`);
                entered += parseInt(input?.value) || 0;
            }
            per.push({ label: `Mål ${t}`, entered: entered, expected: expected });
        }
    }
    const entered = per.reduce((a, x) => a + x.entered, 0);
    const expected = per.reduce((a, x) => a + x.expected, 0);
    const over = per.filter(x => x.entered > x.expected);
    return { per: per, entered: entered, expected: expected, over: over, isPartial: entered < expected };
}

// Hard block: message when a target/station holds more shots than it can. null = OK to save.
function springShotOvercount(counts) {
    if (!counts.over.length) return null;
    const o = counts.over[0];
    return `${o.label}: fler skott än målet rymmer (${o.entered} av ${o.expected}). Rätta innan du sparar.`;
}

// Soft note: short description of what's still missing. null = complete.
function springPartialNote(counts) {
    if (!counts.isPartial) return null;
    const missing = counts.per
        .filter(x => x.entered < x.expected)
        .map(x => `${x.label} ${x.entered}/${x.expected}`)
        .join(', ');
    return `${counts.entered}/${counts.expected} skott — ${missing}`;
}

// Paint the "Skott registrerade" badge on a scoring pad. Amber while partial, red on overcount,
// so a half-entered result is visible on screen rather than hidden behind a refused save.
function springPaintShotCountBadge(elId, counts) {
    const el = document.getElementById(elId);
    if (!el) return;
    el.textContent = `${counts.entered}/${counts.expected}`;
    el.className = counts.over.length ? 'fw-bold text-danger'
        : (counts.isPartial ? 'fw-bold text-warning' : 'fw-bold text-success');
    const wrap = el.closest('[data-shotcount-wrap]');
    if (wrap) {
        wrap.title = counts.over.length ? springShotOvercount(counts)
            : (counts.isPartial ? 'Ofullständigt — kan sparas som delresultat' : 'Alla skott registrerade');
    }
}

// Always HH:MM:SS format (for finish time / clock time restoration)
function formatSecondsToHMS(totalSeconds) {
    if (totalSeconds === null || totalSeconds === undefined) return '';
    const s = Math.round(totalSeconds);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
}

function showSpringMessage(msg, type) {
    const container = document.getElementById('springEntryContainer');
    if (!container) return;
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-2`;
    alertDiv.innerHTML = `${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    container.prepend(alertDiv);
    setTimeout(() => alertDiv.remove(), 3000);
}
</script>

