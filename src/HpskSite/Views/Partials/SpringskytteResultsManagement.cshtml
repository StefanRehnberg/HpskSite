@*
 * Springskytte Results Management Partial View
 * Completely isolated from standard competition results entry.
 * Handles time-based results with stop-by-stop shot recording.
 *
 * Two entry modes:
 *   Tab 1 "Vapengrupp A" — Sequential shooter navigation, finish time → sprint calculation
 *   Tab 2 "Vapengrupp C — Banregistrering" — Mobile-first range officer mode with number pad lookup
 *
 * Class C: 6 stops x 5 shots, each Hit (H) or Miss (B)
 * Class A: Configurable series (1-6), 30 shots total, zone values 0-3
 *@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
    var competitionType = ViewData["CompetitionType"]?.ToString() ?? "Springskytte";
    var numberOfSeries = ViewData["NumberOfSeriesOrStations"] as int? ?? 6;
    var competitionName = ViewData["CompetitionName"]?.ToString() ?? "Springskytte";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<div class="springskytte-results-management" data-competition-id="@competitionId" data-number-of-series="@numberOfSeries">
    <!-- Results Entry Section -->
    <div class="card">
        <div class="card-header" style="cursor: pointer;" onclick="toggleSpringskytteEntry(event)">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="bi bi-chevron-down me-2" id="springEntryChevron"></i>
                    <h5 class="mb-0"><i class="bi bi-stopwatch me-2"></i>Registrera Resultat</h5>
                </div>
                <span class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>Ange måltid och skjutresultat per skytt
                </span>
            </div>
        </div>
        <div class="card-body" id="springEntryBody">
            <!-- Tabs for Class A / Class C -->
            <ul class="nav nav-tabs mb-3" id="springEntryTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="springTabA-tab" data-bs-toggle="tab" data-bs-target="#springTabA"
                        type="button" role="tab" aria-controls="springTabA" aria-selected="true">
                        <i class="bi bi-card-list me-1"></i>Vapengrupp A
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="springTabC-tab" data-bs-toggle="tab" data-bs-target="#springTabC"
                        type="button" role="tab" aria-controls="springTabC" aria-selected="false">
                        <i class="bi bi-phone me-1"></i>Vapengrupp C — Banregistrering
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="springEntryTabContent">
                <!-- ===== TAB 1: CLASS A — Sequential Entry ===== -->
                <div class="tab-pane fade show active" id="springTabA" role="tabpanel" aria-labelledby="springTabA-tab">
                    <!-- Shooter Navigation -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 sticky-top bg-body py-2" style="z-index: 10;">
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springFirstShooter)" title="Forsta skytten">
                            <i class="bi bi-skip-backward-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springPrevShooter)" title="Foregaende skytt">
                            <i class="bi bi-caret-left-fill"></i>
                        </button>
                        <span class="fw-bold" id="springCurrentShooterInfo">Laddar...</span>
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springNextShooter)" title="Nasta skytt">
                            <i class="bi bi-caret-right-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springLastShooter)" title="Sista skytten">
                            <i class="bi bi-skip-forward-fill"></i>
                        </button>
                        <div class="ms-auto">
                            <select class="form-select form-select-sm" id="springShooterFilter" onchange="springFilterShooters()" style="width: auto;">
                                <option value="all">Alla skyttar</option>
                                <option value="noresult">Utan resultat</option>
                                <option value="A">Vapengrupp A</option>
                                <option value="C">Vapengrupp C</option>
                            </select>
                        </div>
                    </div>

                    <!-- Entry Form Container -->
                    <div id="springEntryContainer">
                        <div class="text-center py-4">
                            <div class="spinner-border" role="status"><span class="visually-hidden">Laddar...</span></div>
                            <p class="mt-2 text-muted">Laddar skyttar...</p>
                        </div>
                    </div>
                </div>

                <!-- ===== TAB 2: CLASS C — Range Officer Mode ===== -->
                <div class="tab-pane fade" id="springTabC" role="tabpanel" aria-labelledby="springTabC-tab">
                    <!-- Top bar -->
                    <div class="d-flex justify-content-between align-items-center mb-3 sticky-top bg-body py-2" style="z-index: 10;">
                        <small class="text-muted">@competitionName</small>
                        <button class="btn btn-sm" id="springLockBtn" onclick="springToggleLock()">
                            <i class="bi bi-unlock me-1"></i>Lås skärm
                        </button>
                    </div>

                    <!-- Shooter lookup -->
                    <div class="card mb-3">
                        <div class="card-body">
                            <label class="form-label fw-bold fs-5">Startnummer</label>
                            <div class="d-flex gap-2">
                                <input type="number" class="form-control form-control-lg" id="springCStartNumber"
                                    placeholder="Ange startnummer" inputmode="numeric" min="1"
                                    onkeydown="if(event.key==='Enter'){springCLookup(); event.preventDefault();}">
                                <button class="btn btn-primary btn-lg px-4" onclick="springCLookup()">Hämta</button>
                            </div>
                        </div>
                    </div>

                    <!-- Active shooter card (hidden until lookup) -->
                    <div id="springCActiveCard" style="display:none;"></div>

                    <!-- Recently entered list -->
                    <div id="springCRecentList" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results List Section -->
    <div class="card mt-4">
        <div class="card-header" style="cursor: pointer;" onclick="toggleSpringskytteResultsList(event)">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="bi bi-chevron-right me-2" id="springResultsChevron"></i>
                    <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>Resultatlista</h5>
                </div>
                <div class="d-flex align-items-center gap-2" onclick="event.stopPropagation()">
                    <button class="btn btn-outline-primary btn-sm" onclick="springCreateResultsList(event)">
                        <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                    </button>
                    <span class="badge bg-secondary" id="springResultsStatusBadge" style="display:none;"></span>
                </div>
            </div>
        </div>
        <div class="card-body" id="springResultsBody" style="display: none;">
            <div id="springResultsContent">
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-file-earmark-text display-4"></i>
                    <p class="mt-2">Klicka "Uppdatera" for att skapa resultatlista</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .shot-btn { width: 42px; height: 36px; font-size: 0.85rem; font-weight: 600; padding: 0; }
    .shot-btn.active-hit { background-color: var(--bs-success); border-color: var(--bs-success); color: #fff; }
    .shot-btn.active-miss { background-color: var(--bs-danger); border-color: var(--bs-danger); color: #fff; }
    .zone-input { width: 42px; text-align: center; font-weight: 600; }
    .stop-group { border: 1px solid var(--bs-border-color); border-radius: 0.375rem; padding: 0.5rem; margin-bottom: 0.5rem; }
    .stop-header { font-weight: 600; font-size: 0.85rem; color: var(--bs-secondary-color); }
    .time-display { font-family: monospace; font-size: 1.1rem; font-weight: 700; }
    .result-summary { font-size: 0.9rem; }
    .result-summary .label { color: var(--bs-secondary-color); }
    .shooter-result-badge { font-size: 0.75rem; }
    .springskytte-results-table th { white-space: nowrap; font-size: 0.85rem; }
    .springskytte-results-table td { font-size: 0.85rem; }
    .springskytte-results-table .time-col { font-family: monospace; }

    /* Class C — Range Officer Mode */
    .shot-btn-lg { min-width: 52px; min-height: 52px; font-size: 1.1rem; font-weight: 700; padding: 0; border-radius: 0.5rem; }
    .shot-btn-lg.active-hit { background-color: var(--bs-success); border-color: var(--bs-success); color: #fff; }
    .shot-btn-lg.active-miss { background-color: var(--bs-danger); border-color: var(--bs-danger); color: #fff; }
    .spring-c-station { border: 1px solid var(--bs-border-color); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 0.75rem; }
    .spring-c-station-header { font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; }
    .spring-c-recent-item { cursor: pointer; }
    .spring-c-recent-item:hover { background-color: var(--bs-tertiary-bg); }
    .spring-lock-active { background-color: var(--bs-warning); border-color: var(--bs-warning); color: #000; }
</style>

<script>
// ===== Springskytte Results Management =====
let springShooters = [];
let springFilteredShooters = [];
let springCurrentIndex = 0;
const springCompetitionId = parseInt('@competitionId');
const springNumberOfSeries = parseInt('@numberOfSeries') || 6;

// Class C state
let springCRecentEntries = [];  // last 5 saved entries
let springCActiveShooter = null;
let springScreenLocked = false;

document.addEventListener('DOMContentLoaded', () => {
    springLoadShooters();
    springLoadResultsList();
});

// ===== DATA LOADING =====

async function springLoadShooters() {
    try {
        const response = await fetch(`/umbraco/surface/Springskytte/GetShootersForSpringskytteResults?competitionId=${springCompetitionId}`);
        const data = await response.json();
        if (data.success) {
            springShooters = data.shooters || [];
            springFilterShooters();
            if (springFilteredShooters.length > 0) {
                springCurrentIndex = 0;
                springUpdateNav();
                springRenderEntry();
            } else {
                document.getElementById('springEntryContainer').innerHTML =
                    '<div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Inga anmälda skyttar hittades.</div>';
            }
        } else {
            document.getElementById('springEntryContainer').innerHTML =
                `<div class="alert alert-warning">${data.message || 'Kunde inte ladda skyttar.'}</div>`;
        }
    } catch (err) {
        console.error('Error loading shooters:', err);
        document.getElementById('springEntryContainer').innerHTML =
            '<div class="alert alert-danger">Ett fel uppstod vid laddning av skyttar.</div>';
    }
}

function springFilterShooters() {
    const filter = document.getElementById('springShooterFilter')?.value || 'all';
    springFilteredShooters = springShooters.filter(s => {
        if (filter === 'noresult') return !s.hasResult;
        if (filter === 'A') return s.weaponClass === 'A';
        if (filter === 'C') return s.weaponClass === 'C';
        return true;
    });
    springCurrentIndex = 0;
    springUpdateNav();
    if (springFilteredShooters.length > 0) {
        springRenderEntry();
    } else {
        document.getElementById('springEntryContainer').innerHTML =
            '<div class="text-center py-3 text-muted">Inga skyttar matchar filtret.</div>';
    }
}

// ===== NAVIGATION (Tab A) =====

let springASnapshot = null;

function springATakeSnapshot() {
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) return null;
    const isClassC = shooter.weaponClass === 'C';
    return JSON.stringify({
        shots: isClassC ? springCollectClassCShots() : springCollectClassAShots(),
        finishTime: document.getElementById('springFinishTime')?.value || '',
        manualTime: document.getElementById('springSprintTimeManual')?.value || '',
        status: document.getElementById('springStatus')?.value || '',
        multiplier: document.querySelector('input[name="springMultiplier"]:checked')?.value || '1'
    });
}

function springAHasUnsavedChanges() {
    if (!springASnapshot) return false;
    return springATakeSnapshot() !== springASnapshot;
}

function springANavigate(fn) {
    if (springAHasUnsavedChanges()) {
        const shooter = springFilteredShooters[springCurrentIndex];
        if (!confirm(`${shooter?.memberName || 'Skytten'} har osparade ändringar. Vill du fortsätta utan att spara?`)) return;
    }
    fn();
}

function springFirstShooter() { springCurrentIndex = 0; springUpdateNav(); springRenderEntry(); }
function springPrevShooter() { if (springCurrentIndex > 0) { springCurrentIndex--; springUpdateNav(); springRenderEntry(); } }
function springNextShooter() { if (springCurrentIndex < springFilteredShooters.length - 1) { springCurrentIndex++; springUpdateNav(); springRenderEntry(); } }
function springLastShooter() { springCurrentIndex = springFilteredShooters.length - 1; springUpdateNav(); springRenderEntry(); }

function springUpdateNav() {
    const el = document.getElementById('springCurrentShooterInfo');
    if (!springFilteredShooters.length) { el.textContent = 'Inga skyttar'; return; }
    const s = springFilteredShooters[springCurrentIndex];
    el.textContent = `${springCurrentIndex + 1}/${springFilteredShooters.length}: ${s.memberName} (${s.weaponClass} - ${s.ageGenderClass})`;
}

// ===== SHARED UTILITY =====

function calculateSprintTime(startTimeStr, finishTimeStr) {
    if (!startTimeStr || !finishTimeStr) return null;
    const startSec = parseTimeToSeconds(startTimeStr);
    const finishSec = parseTimeToSeconds(finishTimeStr);
    if (startSec === null || finishSec === null) return null;
    const diff = finishSec - startSec;
    return diff >= 0 ? diff : null;
}

// ===== TAB A: ENTRY FORM RENDERING =====

function springRenderEntry() {
    const container = document.getElementById('springEntryContainer');
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) { container.innerHTML = ''; return; }

    const existing = shooter.existingResult;
    const isClassC = shooter.weaponClass === 'C';
    const statusValue = existing?.status || '';
    const hasStartTime = !!shooter.startTime;
    const startTimeDisplay = shooter.startTime || '';

    let html = `
        <div class="border rounded p-3">
            <!-- Shooter Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0">${shooter.memberName}</h5>
                    <small class="text-muted">${shooter.memberClub} | Vapengrupp ${shooter.weaponClass} | Klass ${shooter.ageGenderClass}${shooter.startOrder ? ' | #' + shooter.startOrder : ''}</small>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    ${shooter.hasResult ? '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Har resultat</span>' : '<span class="badge bg-secondary">Inget resultat</span>'}
                    <select class="form-select form-select-sm" id="springStatus" style="width: auto;" onchange="springStatusChanged()">
                        <option value="" ${!statusValue ? 'selected' : ''}>Normal</option>
                        <option value="DNS" ${statusValue === 'DNS' ? 'selected' : ''}>DNS (Ej start)</option>
                        <option value="DNF" ${statusValue === 'DNF' ? 'selected' : ''}>DNF (Ej fullföljt)</option>
                    </select>
                </div>
            </div>

            <!-- Time Entry -->
            <div id="springResultFields">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold"><i class="bi bi-play-circle me-1"></i>Starttid</label>
                        <div class="form-control-plaintext time-display">${hasStartTime ? startTimeDisplay : '<span class="text-warning small">Saknas</span>'}</div>
                        ${!hasStartTime ? '<div class="form-text text-warning">Generera startlista först</div>' : ''}
                    </div>
                    <div class="col-md-3" id="springFinishTimeCol">
                        <label class="form-label fw-bold"><i class="bi bi-flag me-1"></i>Måltid</label>
                        <input type="text" class="form-control" id="springFinishTime" placeholder="HH:MM:SS"
                            ${!hasStartTime ? 'disabled' : ''}>
                        <div class="form-text">Klockan vid mål</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold"><i class="bi bi-stopwatch me-1"></i>Löptid</label>
                        <div class="time-display text-success" id="springSprintTimeDisplay">
                            ${existing?.sprintTimeSeconds ? formatSecondsToTime(existing.sprintTimeSeconds) : '-'}
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold"><i class="bi bi-clock me-1"></i>Sluttid</label>
                        <div class="time-display text-primary" id="springTotalTime">
                            ${existing?.totalTimeDisplay || '-'}
                        </div>
                    </div>
                </div>

                <!-- Manual sprint time override -->
                <div class="mb-3">
                    <a class="small text-muted" data-bs-toggle="collapse" href="#springManualTime" role="button" id="springManualTimeToggle">
                        <i class="bi bi-wrench me-1"></i>Manuell löptid (backup)
                    </a>
                    <div class="collapse mt-2" id="springManualTime">
                        <div class="row g-2 align-items-end">
                            <div class="col-auto">
                                <label class="form-label small">Löptid (MM:SS)</label>
                                <input type="text" class="form-control form-control-sm" id="springSprintTimeManual" placeholder="MM:SS"
                                    value="${existing?.sprintTimeSeconds ? formatSecondsToTime(existing.sprintTimeSeconds) : ''}">
                            </div>
                            <div class="col-auto">
                                <div class="form-text">Använd vid reservtidtagning. Åsidosätter måltid.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Shooting Score display -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold"><i class="bi bi-crosshair me-1"></i>Skjutpoäng</label>
                        <div class="time-display text-danger" id="springShootingScore">
                            ${existing?.shootingScore ?? 0}
                        </div>
                    </div>
                </div>

                <!-- Penalty Multiplier -->
                ${isClassC ? `
                <div class="mb-3">
                    <label class="form-label small">Skjutpoäng per bom</label>
                    <div class="btn-group btn-group-sm" role="group">
                        <input type="radio" class="btn-check" name="springMultiplier" id="springMult1" value="1" checked>
                        <label class="btn btn-outline-secondary" for="springMult1">1 (Normal)</label>
                        <input type="radio" class="btn-check" name="springMultiplier" id="springMult2" value="2">
                        <label class="btn btn-outline-secondary" for="springMult2">2 (Märkestagning)</label>
                    </div>
                </div>` : ''}

                <!-- Shots -->
                <h6 class="mb-2"><i class="bi bi-bullseye me-1"></i>Skjutresultat</h6>
                ${isClassC ? springRenderClassCShots() : springRenderClassAShots()}
            </div>

            <!-- Save / Delete -->
            <div class="d-flex justify-content-between mt-3">
                <button class="btn btn-danger btn-sm" onclick="springDeleteResult()" ${!shooter.hasResult ? 'disabled' : ''}>
                    <i class="bi bi-trash me-1"></i>Ta bort
                </button>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" onclick="springANavigate(springNextShooter)">
                        Hoppa över <i class="bi bi-skip-forward ms-1"></i>
                    </button>
                    <button class="btn btn-primary" onclick="springSaveResult()">
                        <i class="bi bi-floppy me-1"></i>Spara
                    </button>
                </div>
            </div>
        </div>`;

    container.innerHTML = html;

    // Initialize Flatpickr for finish time
    if (hasStartTime) {
        flatpickr('#springFinishTime', {
            locale: 'sv',
            enableTime: true,
            noCalendar: true,
            dateFormat: 'H:i:S',
            time_24hr: true,
            enableSeconds: true
        });
    }

    springStatusChanged();

    // Restore existing data if shooter has result
    if (existing && shooter.hasResult && existing.shots && existing.shots.length) {
        if (isClassC) {
            for (let stop = 0; stop < existing.shots.length && stop < 6; stop++) {
                const stopShots = existing.shots[stop];
                for (let shot = 0; shot < stopShots.length && shot < 5; shot++) {
                    const btn = document.getElementById(`shot_${stop + 1}_${shot + 1}`);
                    if (!btn) continue;
                    const val = stopShots[shot];
                    if (val === 'H') {
                        btn.dataset.value = 'H';
                        btn.textContent = 'T';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-hit');
                    } else if (val === 'B') {
                        btn.dataset.value = 'B';
                        btn.textContent = 'B';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-miss');
                    }
                }
            }
            springRecalcClassC();
        } else {
            for (let series = 0; series < existing.shots.length; series++) {
                const seriesShots = existing.shots[series];
                for (let shot = 0; shot < seriesShots.length; shot++) {
                    const input = document.getElementById(`zona_${series + 1}_${shot + 1}`);
                    if (input && seriesShots[shot] !== '' && seriesShots[shot] !== '0') {
                        input.value = seriesShots[shot];
                    }
                }
            }
            springRecalcClassA();
        }

        // Restore multiplier for Class C
        if (isClassC && existing.penaltyMultiplier === 2) {
            const mult2 = document.getElementById('springMult2');
            if (mult2) mult2.checked = true;
        }

        // Restore finish time from start time + sprint time
        if (existing.sprintTimeSeconds != null && hasStartTime) {
            const startSec = parseTimeToSeconds(shooter.startTime);
            if (startSec !== null) {
                const finishSec = startSec + existing.sprintTimeSeconds;
                const finishTimeStr = formatSecondsToHMS(finishSec);
                const finishEl = document.getElementById('springFinishTime');
                if (finishEl) {
                    finishEl.value = finishTimeStr;
                    if (finishEl._flatpickr) finishEl._flatpickr.setDate(finishTimeStr, true);
                }
            }
        }
    }

    // Recalculate display (this also updates sprint/total from restored finish time)
    if (isClassC) springRecalcClassC(); else springRecalcClassA();

    // Take snapshot for unsaved-changes detection
    springASnapshot = springATakeSnapshot();
}

function springRenderClassCShots() {
    let html = '<div class="row g-2">';
    for (let stop = 1; stop <= 6; stop++) {
        html += `
        <div class="col-md-6 col-lg-4">
            <div class="stop-group">
                <div class="stop-header mb-1">Station ${stop}</div>
                <div class="d-flex gap-1">`;
        for (let shot = 1; shot <= 5; shot++) {
            const id = `shot_${stop}_${shot}`;
            html += `
                    <button type="button" class="btn btn-outline-secondary shot-btn" id="${id}"
                        onclick="springToggleClassCShot(this)" data-stop="${stop}" data-shot="${shot}" data-value="">
                        -
                    </button>`;
        }
        html += `
                    <span class="align-self-center ms-1 small fw-bold" id="stop${stop}Count">0/5</span>
                </div>
            </div>
        </div>`;
    }
    html += '</div>';
    return html;
}

function springRenderClassAShots() {
    const numSeries = springNumberOfSeries || 2;
    const shotsPerSeries = Math.floor(30 / numSeries);
    const extraShots = 30 - (shotsPerSeries * numSeries);

    let html = `<div class="mb-2 small text-muted">${numSeries} serie(r), ${shotsPerSeries} skott/serie, Zon 0-3 (0=träff ring 1-2, 1=ring 3, 2=ring 4, 3=utanför)</div>`;
    html += '<div class="row g-2">';

    for (let series = 1; series <= numSeries; series++) {
        const shotsInThisSeries = series === numSeries ? shotsPerSeries + extraShots : shotsPerSeries;
        html += `
        <div class="col-12">
            <div class="stop-group">
                <div class="stop-header mb-1">Serie ${series} (${shotsInThisSeries} skott)</div>
                <div class="d-flex flex-wrap gap-1">`;
        for (let shot = 1; shot <= shotsInThisSeries; shot++) {
            const id = `zona_${series}_${shot}`;
            html += `
                    <input type="number" class="form-control zone-input" id="${id}" min="0" max="3"
                        data-series="${series}" data-shot="${shot}" placeholder="-"
                        onchange="springRecalcClassA()" oninput="springRecalcClassA()">`;
        }
        html += `
                    <span class="align-self-center ms-2 small fw-bold" id="seriesA${series}Score">0p</span>
                </div>
            </div>
        </div>`;
    }
    html += '</div>';
    return html;
}

// ===== SHOT INTERACTION =====

function springToggleClassCShot(btn) {
    const current = btn.dataset.value;
    if (current === '' || current === undefined) {
        btn.dataset.value = 'H';
        btn.textContent = 'T';
        btn.classList.remove('btn-outline-secondary', 'active-miss');
        btn.classList.add('active-hit');
    } else if (current === 'H') {
        btn.dataset.value = 'B';
        btn.textContent = 'B';
        btn.classList.remove('active-hit');
        btn.classList.add('active-miss');
    } else {
        btn.dataset.value = '';
        btn.textContent = '-';
        btn.classList.remove('active-hit', 'active-miss');
        btn.classList.add('btn-outline-secondary');
    }
    springRecalcClassC();
}

function springRecalcClassC() {
    let totalMisses = 0;
    for (let stop = 1; stop <= 6; stop++) {
        let hits = 0, misses = 0;
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`shot_${stop}_${shot}`);
            if (btn?.dataset.value === 'H') hits++;
            if (btn?.dataset.value === 'B') misses++;
        }
        totalMisses += misses;
        const countEl = document.getElementById(`stop${stop}Count`);
        if (countEl) countEl.textContent = `${hits}/5`;
    }

    const multiplier = parseInt(document.querySelector('input[name="springMultiplier"]:checked')?.value || '1');
    const shootingScore = totalMisses * multiplier;
    const scoreEl = document.getElementById('springShootingScore');
    if (scoreEl) scoreEl.textContent = shootingScore;
    springUpdateTotalTimeA(shootingScore, multiplier);
}

function springRecalcClassA() {
    let totalScore = 0;
    const numSeries = springNumberOfSeries || 2;
    const shotsPerSeries = Math.floor(30 / numSeries);
    const extraShots = 30 - (shotsPerSeries * numSeries);

    for (let series = 1; series <= numSeries; series++) {
        let seriesScore = 0;
        const shotsInThisSeries = series === numSeries ? shotsPerSeries + extraShots : shotsPerSeries;
        for (let shot = 1; shot <= shotsInThisSeries; shot++) {
            const input = document.getElementById(`zona_${series}_${shot}`);
            if (input && input.value !== '') {
                const val = parseInt(input.value);
                if (!isNaN(val) && val >= 0 && val <= 3) seriesScore += val;
            }
        }
        totalScore += seriesScore;
        const scoreEl = document.getElementById(`seriesA${series}Score`);
        if (scoreEl) scoreEl.textContent = `${seriesScore}p`;
    }

    const scoreEl = document.getElementById('springShootingScore');
    if (scoreEl) scoreEl.textContent = totalScore;
    springUpdateTotalTimeA(totalScore, 1);
}

function springUpdateTotalTimeA(shootingScore, multiplier) {
    // Determine sprint time: manual override > finish time calculation
    const manualInput = document.getElementById('springSprintTimeManual')?.value;
    const finishInput = document.getElementById('springFinishTime')?.value;
    const shooter = springFilteredShooters[springCurrentIndex];
    const startTime = shooter?.startTime;

    let sprintSeconds = null;

    // Manual override takes precedence
    if (manualInput && manualInput.trim()) {
        sprintSeconds = parseTimeToSeconds(manualInput);
    } else if (finishInput && finishInput.trim() && startTime) {
        sprintSeconds = calculateSprintTime(startTime, finishInput);
    }

    const sprintDisplay = document.getElementById('springSprintTimeDisplay');
    if (sprintDisplay) {
        sprintDisplay.textContent = sprintSeconds !== null ? formatSecondsToTime(sprintSeconds) : '-';
    }

    const totalEl = document.getElementById('springTotalTime');
    if (sprintSeconds !== null) {
        const penaltySeconds = shootingScore * multiplier * 60;
        const totalSeconds = sprintSeconds + penaltySeconds;
        if (totalEl) totalEl.textContent = formatSecondsToTime(totalSeconds);
    } else {
        if (totalEl) totalEl.textContent = '-';
    }
}

// Listen for finish time changes
document.addEventListener('input', function(e) {
    if (e.target.id === 'springFinishTime' || e.target.id === 'springSprintTimeManual') {
        const shooter = springFilteredShooters[springCurrentIndex];
        if (shooter?.weaponClass === 'C') springRecalcClassC();
        else springRecalcClassA();
    }
});

// Listen for multiplier changes
document.addEventListener('change', function(e) {
    if (e.target.name === 'springMultiplier') springRecalcClassC();
});

// Disable finish time when manual override is used
document.addEventListener('input', function(e) {
    if (e.target.id === 'springSprintTimeManual') {
        const finishEl = document.getElementById('springFinishTime');
        if (finishEl) {
            finishEl.disabled = !!e.target.value.trim();
        }
    }
});

function springStatusChanged() {
    const status = document.getElementById('springStatus')?.value;
    const fields = document.getElementById('springResultFields');
    if (fields) {
        fields.style.opacity = status ? '0.4' : '1';
        fields.style.pointerEvents = status ? 'none' : 'auto';
    }
}

// ===== TAB A: SAVE / DELETE =====

async function springSaveResult() {
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) return;

    const status = document.getElementById('springStatus')?.value || null;
    const isClassC = shooter.weaponClass === 'C';

    // Determine which time input to send
    const manualInput = document.getElementById('springSprintTimeManual')?.value?.trim() || null;
    const finishInput = document.getElementById('springFinishTime')?.value?.trim() || null;

    // Validate: need either manual time, finish time (with start time), or DNS/DNF
    if (!status && !manualInput && !finishInput) {
        showSpringMessage('Ange måltid, manuell löptid, eller välj DNS/DNF.', 'warning');
        return;
    }

    // Collect shots
    let shotSeries = [];
    if (!status) {
        shotSeries = isClassC ? springCollectClassCShots() : springCollectClassAShots();

        // Validate completeness: every station/series must have all shots filled
        const incomplete = springValidateShotsComplete(shotSeries, isClassC);
        if (incomplete) {
            showSpringMessage(incomplete, 'warning');
            return;
        }
    }

    const multiplier = isClassC
        ? parseInt(document.querySelector('input[name="springMultiplier"]:checked')?.value || '1')
        : 1;

    const requestData = {
        competitionId: springCompetitionId,
        memberId: shooter.memberId,
        weaponClass: shooter.weaponClass,
        ageGenderClass: shooter.ageGenderClass,
        sprintTimeInput: manualInput || null,
        finishTimeInput: (!manualInput && finishInput) ? finishInput : null,
        shotSeries: shotSeries,
        penaltyMultiplier: multiplier,
        status: status
    };

    try {
        const response = await fetch('/umbraco/surface/Springskytte/SaveSpringskytteResult', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(requestData)
        });
        const data = await response.json();

        if (data.success) {
            // Use server-verified data (read-back from DB) — not local copies
            shooter.hasResult = true;
            shooter.existingResult = {
                sprintTimeSeconds: data.sprintTimeSeconds,
                shootingScore: data.shootingScore,
                totalTimeSeconds: data.totalTimeSeconds,
                totalTimeDisplay: data.totalTimeDisplay,
                status: status,
                penaltyMultiplier: data.penaltyMultiplier,
                shots: data.verificationShots || shotSeries
            };

            // Client-side verification: compare sent shots with server-verified shots
            if (data.verificationShots) {
                const sentJson = JSON.stringify(shotSeries);
                const storedJson = JSON.stringify(data.verificationShots);
                if (sentJson !== storedJson) {
                    showSpringMessage('⚠ VARNING: Verifieringsfel — sparade skott skiljer sig från inskickade. Kontrollera resultatet!', 'danger');
                    console.error('Shot verification mismatch!', { sent: shotSeries, stored: data.verificationShots });
                } else {
                    showSpringMessage(`✓ Resultat verifierat och sparat: ${data.totalTimeDisplay || status || '-'}`, 'success');
                }
            } else {
                showSpringMessage(`Resultat sparat: ${data.totalTimeDisplay || status || '-'}`, 'success');
            }

            // Re-take snapshot so current state is now the "saved" baseline
            springASnapshot = springATakeSnapshot();

            if (springCurrentIndex < springFilteredShooters.length - 1) {
                setTimeout(() => { springNextShooter(); }, 500);
            }
        } else {
            showSpringMessage(data.message || 'Fel vid sparning.', 'danger');
        }
    } catch (err) {
        console.error('Error saving result:', err);
        showSpringMessage('Ett fel uppstod vid sparning.', 'danger');
    }
}

async function springDeleteResult() {
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter || !confirm(`Ta bort resultat för ${shooter.memberName}?`)) return;

    try {
        const response = await fetch('/umbraco/surface/Springskytte/DeleteSpringskytteResult', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify({
                competitionId: springCompetitionId,
                memberId: shooter.memberId,
                weaponClass: shooter.weaponClass
            })
        });
        const data = await response.json();
        if (data.success) {
            shooter.hasResult = false;
            shooter.existingResult = null;
            showSpringMessage('Resultat borttaget.', 'success');
            springRenderEntry();
        } else {
            showSpringMessage(data.message || 'Fel vid borttagning.', 'danger');
        }
    } catch (err) {
        showSpringMessage('Ett fel uppstod.', 'danger');
    }
}

function springCollectClassCShots() {
    const series = [];
    for (let stop = 1; stop <= 6; stop++) {
        const stopShots = [];
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`shot_${stop}_${shot}`);
            stopShots.push(btn?.dataset.value || '');
        }
        series.push(stopShots);
    }
    return series;
}

function springCollectClassAShots() {
    const series = [];
    const numSeries = springNumberOfSeries || 2;
    const shotsPerSeries = Math.floor(30 / numSeries);
    const extraShots = 30 - (shotsPerSeries * numSeries);

    for (let s = 1; s <= numSeries; s++) {
        const seriesShots = [];
        const shotsInThisSeries = s === numSeries ? shotsPerSeries + extraShots : shotsPerSeries;
        for (let shot = 1; shot <= shotsInThisSeries; shot++) {
            const input = document.getElementById(`zona_${s}_${shot}`);
            seriesShots.push(input?.value || '0');
        }
        series.push(seriesShots);
    }
    return series;
}

// ===== TAB C: RANGE OFFICER MODE =====

function springToggleLock() {
    springScreenLocked = !springScreenLocked;
    const btn = document.getElementById('springLockBtn');
    if (springScreenLocked) {
        btn.innerHTML = '<i class="bi bi-lock-fill me-1"></i>Låst';
        btn.classList.add('spring-lock-active');
        window.onbeforeunload = function(e) {
            e.preventDefault();
            return '';
        };
    } else {
        btn.innerHTML = '<i class="bi bi-unlock me-1"></i>Lås skärm';
        btn.classList.remove('spring-lock-active');
        window.onbeforeunload = null;
    }
}

// Snapshot of Class C state when a shooter is loaded/saved — used to detect unsaved changes
let springCSnapshot = null;

function springCTakeSnapshot() {
    return JSON.stringify({
        shots: springCCollectShots(),
        finishTime: document.getElementById('cFinishTime')?.value || '',
        multiplier: springCMultiplier
    });
}

function springCHasUnsavedChanges() {
    if (!springCActiveShooter || !springCSnapshot) return false;
    return springCTakeSnapshot() !== springCSnapshot;
}

function springCLookup() {
    const input = document.getElementById('springCStartNumber');
    const startNumber = parseInt(input?.value);
    if (!startNumber || isNaN(startNumber)) {
        showSpringCToast('Ange ett startnummer.', 'warning');
        input?.focus();
        return;
    }

    // Check for unsaved changes on currently loaded shooter
    if (springCHasUnsavedChanges()) {
        if (!confirm(`Skytt #${springCActiveShooter.startOrder} har osparade ändringar. Vill du fortsätta utan att spara?`)) {
            input?.select();
            input?.focus();
            return;
        }
    }

    // Find shooter by start order, Class C only
    const shooter = springShooters.find(s => s.startOrder === startNumber && s.weaponClass === 'C');
    if (!shooter) {
        showSpringCToast(`Startnummer ${startNumber} hittades inte (Vapengrupp C).`, 'danger');
        input?.select();
        input?.focus();
        return;
    }

    springCActiveShooter = shooter;
    springCRenderActiveCard(shooter);
}

function springCRenderActiveCard(shooter) {
    const card = document.getElementById('springCActiveCard');
    const existing = shooter.existingResult;
    const hasStartTime = !!shooter.startTime;
    const multiplierVal = existing?.penaltyMultiplier || 1;

    let html = `
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">#${shooter.startOrder} — ${shooter.memberName} <small class="opacity-75">(${shooter.registeredClass})</small></h5>
        </div>
        <div class="card-body">
            <!-- Stations: 6 x 5 shots, large buttons -->
            <h6 class="mb-2"><i class="bi bi-bullseye me-1"></i>Stationer</h6>`;

    for (let stop = 1; stop <= 6; stop++) {
        html += `
            <div class="spring-c-station" id="cStation${stop}">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="spring-c-station-header">Station ${stop}</span>
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold" id="cStop${stop}Count">0/5</span>
                        <button type="button" class="btn btn-sm btn-outline-success" id="cStationSave${stop}"
                            onclick="springCStationSave(${stop})" title="Spara station ${stop}">
                            <i class="bi bi-floppy"></i>
                        </button>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap" id="cStationShots${stop}">`;
        for (let shot = 1; shot <= 5; shot++) {
            const id = `cShot_${stop}_${shot}`;
            html += `
                    <button type="button" class="btn btn-outline-secondary shot-btn-lg" id="${id}"
                        onclick="springCToggleShot(this)" data-stop="${stop}" data-shot="${shot}" data-value="">
                        -
                    </button>`;
        }
        html += `
                </div>
            </div>`;
    }

    html += `
            <!-- Shooting score summary -->
            <div class="d-flex align-items-center gap-3 my-3 p-2 rounded" style="background: var(--bs-tertiary-bg);">
                <span class="fw-bold">Skjutpoäng: <span id="cTotalMisses" class="text-danger fs-5">0</span></span>
            </div>

            <!-- Penalty multiplier -->
            <div class="mb-3">
                <label class="form-label fw-bold">Skjutpoäng per bom</label>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-lg ${multiplierVal !== 2 ? 'btn-primary' : 'btn-outline-secondary'}" id="cMult1"
                        onclick="springCSetMultiplier(1)">x1 Normal</button>
                    <button type="button" class="btn btn-lg ${multiplierVal === 2 ? 'btn-warning' : 'btn-outline-secondary'}" id="cMult2"
                        onclick="springCSetMultiplier(2)">x2 Märkestagning</button>
                </div>
            </div>

            <!-- Time entry -->
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label fw-bold">Starttid</label>
                    <div class="form-control-plaintext time-display fs-5">${hasStartTime ? shooter.startTime : '<span class="text-warning">Saknas</span>'}</div>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Löptid</label>
                    <div class="time-display text-success fs-5" id="cSprintTime">-</div>
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-8">
                    <label class="form-label fw-bold">Måltid</label>
                    <input type="text" class="form-control form-control-lg" id="cFinishTime" placeholder="HH:MM:SS"
                        ${!hasStartTime ? 'disabled' : ''}>
                </div>
                <div class="col-4 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-lg w-100" onclick="springCNow()" ${!hasStartTime ? 'disabled' : ''}>
                        <i class="bi bi-clock me-1"></i>Nu
                    </button>
                </div>
            </div>

            <!-- Total time -->
            <div class="text-center p-3 rounded mb-3" style="background: var(--bs-tertiary-bg);">
                <div class="small text-muted">Sluttid</div>
                <div class="time-display text-primary fs-3" id="cTotalTime">-</div>
            </div>

            <!-- Save button -->
            <button class="btn btn-success btn-lg w-100 py-3" onclick="springCSave()" id="cSaveBtn">
                <i class="bi bi-check-circle me-1"></i>Spara resultat
            </button>
        </div>
    </div>`;

    card.innerHTML = html;
    card.style.display = 'block';

    // Init Flatpickr for finish time
    if (hasStartTime) {
        flatpickr('#cFinishTime', {
            locale: 'sv',
            enableTime: true,
            noCalendar: true,
            dateFormat: 'H:i:S',
            time_24hr: true,
            enableSeconds: true
        });
    }

    // Init multiplier state
    springCMultiplier = multiplierVal;
    springCLockedStations = new Set();

    // Restore existing data if shooter has result
    if (existing && shooter.hasResult) {
        // Restore shots and lock stations that have data
        if (existing.shots && existing.shots.length) {
            for (let stop = 0; stop < existing.shots.length && stop < 6; stop++) {
                const stopShots = existing.shots[stop];
                let stationHasData = false;
                for (let shot = 0; shot < stopShots.length && shot < 5; shot++) {
                    const btn = document.getElementById(`cShot_${stop + 1}_${shot + 1}`);
                    if (!btn) continue;
                    const val = stopShots[shot];
                    if (val === 'H') {
                        btn.dataset.value = 'H';
                        btn.textContent = 'T';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-hit');
                        stationHasData = true;
                    } else if (val === 'B') {
                        btn.dataset.value = 'B';
                        btn.textContent = 'B';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-miss');
                        stationHasData = true;
                    }
                }
                // Auto-lock stations that have saved data
                if (stationHasData) {
                    springCLockStation(stop + 1);
                }
            }
        }

        // Restore finish time from start time + sprint time
        if (existing.sprintTimeSeconds != null && hasStartTime) {
            const startSec = parseTimeToSeconds(shooter.startTime);
            if (startSec !== null) {
                const finishSec = startSec + existing.sprintTimeSeconds;
                const finishTimeStr = formatSecondsToHMS(finishSec);
                const finishEl = document.getElementById('cFinishTime');
                if (finishEl) {
                    finishEl.value = finishTimeStr;
                    if (finishEl._flatpickr) finishEl._flatpickr.setDate(finishTimeStr, true);
                }
            }
        }

        // Recalculate station counts, shooting score, sprint/total from restored finish time
        springCRecalc();
    }

    // Take snapshot of initial state for unsaved-changes detection
    springCSnapshot = springCTakeSnapshot();
}

let springCMultiplier = 1;
let springCLockedStations = new Set(); // stations that have been saved and are locked

function springCStationSave(stop) {
    // All 5 shots must be entered (H or B)
    let enteredCount = 0;
    for (let shot = 1; shot <= 5; shot++) {
        const btn = document.getElementById(`cShot_${stop}_${shot}`);
        if (btn?.dataset.value === 'H' || btn?.dataset.value === 'B') enteredCount++;
    }
    if (enteredCount < 5) {
        showSpringCToast(`Station ${stop}: alla 5 skott måste registreras (${enteredCount}/5 ifyllda).`, 'warning');
        return;
    }

    // Save full result to server (reuses existing endpoint)
    springCSavePartial(() => {
        // On success: lock the station
        springCLockStation(stop);
    });
}

async function springCSavePartial(onSuccess) {
    const shooter = springCActiveShooter;
    if (!shooter) return;

    const finishInput = document.getElementById('cFinishTime')?.value?.trim() || null;
    const shotSeries = springCCollectShots();

    const requestData = {
        competitionId: springCompetitionId,
        memberId: shooter.memberId,
        weaponClass: shooter.weaponClass,
        ageGenderClass: shooter.ageGenderClass,
        finishTimeInput: finishInput,
        shotSeries: shotSeries,
        penaltyMultiplier: springCMultiplier,
        status: null
    };

    try {
        const response = await fetch('/umbraco/surface/Springskytte/SaveSpringskytteResult', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(requestData)
        });
        const data = await response.json();

        if (data.success) {
            // Use server-verified data (read-back from DB)
            shooter.hasResult = true;
            shooter.existingResult = {
                shootingScore: data.shootingScore,
                totalTimeSeconds: data.totalTimeSeconds,
                totalTimeDisplay: data.totalTimeDisplay,
                sprintTimeSeconds: data.sprintTimeSeconds,
                status: null,
                penaltyMultiplier: data.penaltyMultiplier,
                shots: data.verificationShots || shotSeries
            };

            // Client-side verification
            if (data.verificationShots) {
                const sentJson = JSON.stringify(shotSeries);
                const storedJson = JSON.stringify(data.verificationShots);
                if (sentJson !== storedJson) {
                    showSpringCToast('⚠ VARNING: Skottdata verifieringsfel! Kontrollera resultatet.', 'danger');
                    console.error('Shot verification mismatch!', { sent: shotSeries, stored: data.verificationShots });
                }
            }

            springCSnapshot = springCTakeSnapshot();
            if (onSuccess) onSuccess();
        } else {
            showSpringCToast(data.message || 'Fel vid sparning.', 'danger');
        }
    } catch (err) {
        console.error('Error saving partial result:', err);
        showSpringCToast('Ett fel uppstod vid sparning.', 'danger');
    }
}

function springCLockStation(stop) {
    springCLockedStations.add(stop);
    const shotsContainer = document.getElementById(`cStationShots${stop}`);
    if (shotsContainer) {
        shotsContainer.style.opacity = '0.6';
        shotsContainer.style.pointerEvents = 'none';
    }
    const saveBtn = document.getElementById(`cStationSave${stop}`);
    if (saveBtn) {
        saveBtn.className = 'btn btn-sm btn-secondary';
        saveBtn.innerHTML = '<i class="bi bi-lock-fill"></i>';
        saveBtn.onclick = function() { springCUnlockStation(stop); };
        saveBtn.title = `Lås upp station ${stop}`;
    }
}

function springCUnlockStation(stop) {
    if (!confirm(`Vill du låsa upp station ${stop} för redigering?`)) return;
    springCLockedStations.delete(stop);
    const shotsContainer = document.getElementById(`cStationShots${stop}`);
    if (shotsContainer) {
        shotsContainer.style.opacity = '1';
        shotsContainer.style.pointerEvents = 'auto';
    }
    const saveBtn = document.getElementById(`cStationSave${stop}`);
    if (saveBtn) {
        saveBtn.className = 'btn btn-sm btn-outline-success';
        saveBtn.innerHTML = '<i class="bi bi-floppy"></i>';
        saveBtn.onclick = function() { springCStationSave(stop); };
        saveBtn.title = `Spara station ${stop}`;
    }
}

function springCSetMultiplier(val) {
    springCMultiplier = val;
    document.getElementById('cMult1').className = `btn btn-lg ${val === 1 ? 'btn-primary' : 'btn-outline-secondary'}`;
    document.getElementById('cMult2').className = `btn btn-lg ${val === 2 ? 'btn-warning' : 'btn-outline-secondary'}`;
    springCRecalc();
}

function springCToggleShot(btn) {
    const stop = parseInt(btn.dataset.stop);
    if (springCLockedStations.has(stop)) return;
    const current = btn.dataset.value;
    if (current === '' || current === undefined) {
        btn.dataset.value = 'H';
        btn.textContent = 'T';
        btn.classList.remove('btn-outline-secondary', 'active-miss');
        btn.classList.add('active-hit');
    } else if (current === 'H') {
        btn.dataset.value = 'B';
        btn.textContent = 'B';
        btn.classList.remove('active-hit');
        btn.classList.add('active-miss');
    } else {
        btn.dataset.value = '';
        btn.textContent = '-';
        btn.classList.remove('active-hit', 'active-miss');
        btn.classList.add('btn-outline-secondary');
    }
    springCRecalc();
}

function springCRecalc() {
    let totalMisses = 0;
    for (let stop = 1; stop <= 6; stop++) {
        let hits = 0, misses = 0;
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`cShot_${stop}_${shot}`);
            if (btn?.dataset.value === 'H') hits++;
            if (btn?.dataset.value === 'B') misses++;
        }
        totalMisses += misses;
        const countEl = document.getElementById(`cStop${stop}Count`);
        if (countEl) countEl.textContent = `${hits}/5`;
    }

    document.getElementById('cTotalMisses').textContent = totalMisses;

    const shooter = springCActiveShooter;
    const finishInput = document.getElementById('cFinishTime')?.value;
    const sprintSeconds = shooter?.startTime ? calculateSprintTime(shooter.startTime, finishInput) : null;

    const sprintEl = document.getElementById('cSprintTime');
    if (sprintEl) sprintEl.textContent = sprintSeconds !== null ? formatSecondsToTime(sprintSeconds) : '-';

    const shootingScore = totalMisses * springCMultiplier;
    const totalEl = document.getElementById('cTotalTime');
    if (sprintSeconds !== null) {
        const totalSeconds = sprintSeconds + shootingScore * 60;
        if (totalEl) totalEl.textContent = formatSecondsToTime(totalSeconds);
    } else {
        if (totalEl) totalEl.textContent = '-';
    }
}

// Listen for Class C finish time changes
document.addEventListener('input', function(e) {
    if (e.target.id === 'cFinishTime') springCRecalc();
});

function springCNow() {
    const el = document.getElementById('cFinishTime');
    if (el && el.value.trim() && !confirm('Måltid är redan ifylld. Vill du skriva över med aktuell tid?')) return;

    const now = new Date();
    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    const s = String(now.getSeconds()).padStart(2, '0');
    const timeStr = `${h}:${m}:${s}`;
    if (el) {
        el.value = timeStr;
        if (el._flatpickr) el._flatpickr.setDate(timeStr, true);
    }
    springCRecalc();
}

function springCCollectShots() {
    const series = [];
    for (let stop = 1; stop <= 6; stop++) {
        const stopShots = [];
        for (let shot = 1; shot <= 5; shot++) {
            const btn = document.getElementById(`cShot_${stop}_${shot}`);
            stopShots.push(btn?.dataset.value || '');
        }
        series.push(stopShots);
    }
    return series;
}

async function springCSave() {
    const shooter = springCActiveShooter;
    if (!shooter) return;

    const finishInput = document.getElementById('cFinishTime')?.value?.trim() || null;
    const shotSeries = springCCollectShots();

    // Validate completeness: all 6 stations must have 5 shots each
    const incomplete = springValidateShotsComplete(shotSeries, true);
    if (incomplete) {
        showSpringCToast(incomplete, 'warning');
        return;
    }

    const requestData = {
        competitionId: springCompetitionId,
        memberId: shooter.memberId,
        weaponClass: shooter.weaponClass,
        ageGenderClass: shooter.ageGenderClass,
        finishTimeInput: finishInput,
        shotSeries: shotSeries,
        penaltyMultiplier: springCMultiplier,
        status: null
    };

    const saveBtn = document.getElementById('cSaveBtn');
    if (saveBtn) { saveBtn.disabled = true; saveBtn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Sparar...'; }

    try {
        const response = await fetch('/umbraco/surface/Springskytte/SaveSpringskytteResult', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(requestData)
        });
        const data = await response.json();

        if (data.success) {
            // Use server-verified data (read-back from DB)
            shooter.hasResult = true;
            shooter.existingResult = {
                shootingScore: data.shootingScore,
                totalTimeSeconds: data.totalTimeSeconds,
                totalTimeDisplay: data.totalTimeDisplay,
                sprintTimeSeconds: data.sprintTimeSeconds,
                status: null,
                penaltyMultiplier: data.penaltyMultiplier,
                shots: data.verificationShots || shotSeries
            };

            // Client-side verification
            let verifiedMsg = `Sparat: ${shooter.memberName} — ${data.totalTimeDisplay || '-'}`;
            if (data.verificationShots) {
                const sentJson = JSON.stringify(shotSeries);
                const storedJson = JSON.stringify(data.verificationShots);
                if (sentJson !== storedJson) {
                    showSpringCToast('⚠ VARNING: Skottdata verifieringsfel! Kontrollera resultatet.', 'danger');
                    console.error('Shot verification mismatch!', { sent: shotSeries, stored: data.verificationShots });
                    // Don't clear the card — let the user review
                    return;
                }
                verifiedMsg = `✓ Verifierat: ${shooter.memberName} — ${data.totalTimeDisplay || '-'}`;
            }

            // Add to recent entries
            springCRecentEntries.unshift({
                startOrder: shooter.startOrder,
                name: shooter.memberName,
                registeredClass: shooter.registeredClass,
                totalTimeDisplay: data.totalTimeDisplay,
                shootingScore: data.shootingScore
            });
            if (springCRecentEntries.length > 5) springCRecentEntries.pop();
            springCRenderRecentList();

            showSpringCToast(verifiedMsg, 'success');

            // Clear state and refocus
            springCSnapshot = null;
            document.getElementById('springCActiveCard').style.display = 'none';
            springCActiveShooter = null;
            const input = document.getElementById('springCStartNumber');
            if (input) { input.value = ''; input.focus(); }
        } else {
            showSpringCToast(data.message || 'Fel vid sparning.', 'danger');
        }
    } catch (err) {
        console.error('Error saving Class C result:', err);
        showSpringCToast('Ett fel uppstod vid sparning.', 'danger');
    } finally {
        if (saveBtn) { saveBtn.disabled = false; saveBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Spara resultat'; }
    }
}

function springCRenderRecentList() {
    const container = document.getElementById('springCRecentList');
    if (!springCRecentEntries.length) { container.innerHTML = ''; return; }

    let html = '<h6 class="text-muted mb-2"><i class="bi bi-clock-history me-1"></i>Senast registrerade</h6>';
    html += '<div class="list-group">';
    for (const entry of springCRecentEntries) {
        html += `
        <div class="list-group-item list-group-item-action spring-c-recent-item d-flex justify-content-between align-items-center"
            onclick="document.getElementById('springCStartNumber').value='${entry.startOrder}'; springCLookup();">
            <div>
                <span class="fw-bold">#${entry.startOrder}</span> ${entry.name}
                <small class="text-muted ms-1">(${entry.registeredClass})</small>
            </div>
            <div class="text-end">
                <span class="badge bg-success">${entry.totalTimeDisplay || '-'}</span>
                <small class="text-muted ms-1">Skjutp: ${entry.shootingScore}</small>
            </div>
        </div>`;
    }
    html += '</div>';
    container.innerHTML = html;
}

function showSpringCToast(msg, type) {
    const container = document.getElementById('springTabC');
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-2`;
    alertDiv.style.position = 'relative';
    alertDiv.style.zIndex = '20';
    alertDiv.innerHTML = `${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    container.prepend(alertDiv);
    setTimeout(() => alertDiv.remove(), 3000);
}

// ===== RESULTS LIST =====

async function springCreateResultsList(event) {
    if (event) event.stopPropagation();
    if (!confirm('Vill du skapa/uppdatera resultatlistan?')) return;

    const btn = event?.target?.closest('button');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split me-1"></i>Beräknar...'; }

    try {
        const response = await fetch('/umbraco/surface/Springskytte/CalculateSpringskytteFinalResults', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
            },
            body: JSON.stringify(springCompetitionId)
        });
        const data = await response.json();

        if (data.success) {
            showSpringMessage(data.message, 'success');
            springLoadResultsList();
        } else {
            alert(data.message || 'Fel vid beräkning.');
        }
    } catch (err) {
        alert('Ett fel uppstod.');
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Uppdatera'; }
    }
}

async function springLoadResultsList() {
    try {
        const response = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteResults?competitionId=${springCompetitionId}`);
        const data = await response.json();

        const body = document.getElementById('springResultsBody');
        const chevron = document.getElementById('springResultsChevron');
        const content = document.getElementById('springResultsContent');

        if (data.success && data.classGroups?.length > 0) {
            body.style.display = 'block';
            chevron.classList.remove('bi-chevron-right');
            chevron.classList.add('bi-chevron-down');

            let html = '';
            for (const group of data.classGroups) {
                html += `
                <div class="mb-4">
                    <h6 class="border-bottom pb-1">${group.className}</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-striped springskytte-results-table">
                            <thead>
                                <tr>
                                    <th>Plats</th>
                                    <th>Namn</th>
                                    <th>Förening</th>
                                    <th class="time-col">Löptid</th>
                                    <th>Skjutp.</th>
                                    <th class="time-col">Tillägg</th>
                                    <th class="time-col fw-bold">Sluttid</th>
                                    <th>Medalj</th>
                                </tr>
                            </thead>
                            <tbody>`;
                for (const s of group.shooters) {
                    const medal = s.standardMedal === 'S' ? '<span class="badge bg-secondary">S</span>'
                        : s.standardMedal === 'B' ? '<span class="badge" style="background:#cd7f32;color:#fff;">B</span>'
                        : '';
                    html += `
                                <tr>
                                    <td>${s.status ? s.status : (s.rank || '-')}</td>
                                    <td>${s.name}</td>
                                    <td>${s.club}</td>
                                    <td class="time-col">${s.sprintTimeDisplay}</td>
                                    <td>${s.shootingScore ?? '-'}</td>
                                    <td class="time-col">${s.penaltyTimeDisplay}</td>
                                    <td class="time-col fw-bold">${s.totalTimeDisplay}</td>
                                    <td>${medal}</td>
                                </tr>`;
                }
                html += `
                            </tbody>
                        </table>
                    </div>
                </div>`;
            }
            content.innerHTML = html;
        }
    } catch (err) {
        console.error('Error loading results:', err);
    }
}

function toggleSpringskytteEntry(event) {
    const body = document.getElementById('springEntryBody');
    const chevron = document.getElementById('springEntryChevron');
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

function toggleSpringskytteResultsList(event) {
    const body = document.getElementById('springResultsBody');
    const chevron = document.getElementById('springResultsChevron');
    if (body.style.display === 'none') {
        body.style.display = 'block';
        chevron.classList.remove('bi-chevron-right');
        chevron.classList.add('bi-chevron-down');
    } else {
        body.style.display = 'none';
        chevron.classList.remove('bi-chevron-down');
        chevron.classList.add('bi-chevron-right');
    }
}

// ===== UTILITIES =====

function parseTimeToSeconds(input) {
    if (!input) return null;
    const parts = input.trim().split(':');
    if (parts.length === 2) {
        const m = parseInt(parts[0]), s = parseInt(parts[1]);
        if (!isNaN(m) && !isNaN(s)) return m * 60 + s;
    }
    if (parts.length === 3) {
        const h = parseInt(parts[0]), m = parseInt(parts[1]), s = parseInt(parts[2]);
        if (!isNaN(h) && !isNaN(m) && !isNaN(s)) return h * 3600 + m * 60 + s;
    }
    return null;
}

function formatSecondsToTime(totalSeconds) {
    if (totalSeconds === null || totalSeconds === undefined) return '-';
    const s = Math.round(totalSeconds);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    if (h > 0) return `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
    return `${m}:${String(sec).padStart(2,'0')}`;
}

// Validate that all shots are filled in every station/series.
// Checks DOM elements directly to distinguish empty from valid values.
// Returns error message string if incomplete, null if OK.
function springValidateShotsComplete(shotSeries, isClassC) {
    if (isClassC) {
        // Class C: check button data-value — must be 'H' or 'B'
        for (let i = 0; i < shotSeries.length; i++) {
            const shots = shotSeries[i];
            let filled = 0;
            for (const s of shots) {
                if (s === 'H' || s === 'B') filled++;
            }
            if (filled < 5) {
                return `Station ${i + 1}: alla 5 skott måste registreras (${filled}/5 ifyllda).`;
            }
        }
    } else {
        // Class A: check input DOM elements — value must be non-empty
        const numSeries = springNumberOfSeries || 2;
        const shotsPerSeries = Math.floor(30 / numSeries);
        const extraShots = 30 - (shotsPerSeries * numSeries);

        for (let s = 1; s <= numSeries; s++) {
            const expected = s === numSeries ? shotsPerSeries + extraShots : shotsPerSeries;
            let filled = 0;
            for (let shot = 1; shot <= expected; shot++) {
                const input = document.getElementById(`zona_${s}_${shot}`);
                if (input && input.value !== '' && input.value !== null) filled++;
            }
            if (filled < expected) {
                return `Serie ${s}: alla ${expected} skott måste registreras (${filled}/${expected} ifyllda).`;
            }
        }
    }
    return null;
}

// Always HH:MM:SS format (for finish time / clock time restoration)
function formatSecondsToHMS(totalSeconds) {
    if (totalSeconds === null || totalSeconds === undefined) return '';
    const s = Math.round(totalSeconds);
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}`;
}

function showSpringMessage(msg, type) {
    const container = document.getElementById('springEntryContainer');
    if (!container) return;
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-2`;
    alertDiv.innerHTML = `${msg}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    container.prepend(alertDiv);
    setTimeout(() => alertDiv.remove(), 3000);
}
