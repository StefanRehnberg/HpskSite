                        <span class="fw-bold" id="cStop${stop}Count">0/5</span>
                        <button type="button" class="btn btn-sm btn-outline-success" id="cStationSave${stop}"
                            onclick="springCStationSave(${stop})" title="Spara station ${stop}">
                            <i class="bi bi-floppy"></i>
                        </button>
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap" id="cStationShots${stop}">`;
        for (let shot = 1; shot <= 5; shot++) {
            const id = `cShot_${stop}_${shot}`;
            html += `
                    <button type="button" class="btn btn-outline-secondary shot-btn-lg" id="${id}"
                        onclick="springCToggleShot(this)" data-stop="${stop}" data-shot="${shot}" data-value="">
                        -
                    </button>`;
        }
        html += `
                </div>
            </div>`;
    }

    html += `
            <!-- Shooting score summary -->
            <div class="d-flex align-items-center gap-3 my-3 p-2 rounded" style="background: var(--bs-tertiary-bg);">
                <span class="fw-bold">Skjutpoäng: <span id="cTotalMisses" class="text-danger fs-5">0</span></span>
            </div>

            <!-- Penalty multiplier -->
            <div class="mb-3">
                <label class="form-label fw-bold">Skjutpoäng per bom</label>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-lg ${multiplierVal !== 2 ? 'btn-primary' : 'btn-outline-secondary'}" id="cMult1"
                        onclick="springCSetMultiplier(1)">x1 Normal</button>
                    <button type="button" class="btn btn-lg ${multiplierVal === 2 ? 'btn-warning' : 'btn-outline-secondary'}" id="cMult2"
                        onclick="springCSetMultiplier(2)">x2 Märkestagning</button>
                </div>
            </div>

            <!-- Time entry -->
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label class="form-label fw-bold">Starttid</label>
                    <div class="form-control-plaintext time-display fs-5">${hasStartTime ? shooter.startTime : '<span class="text-warning">Saknas</span>'}</div>
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold">Löptid</label>
                    <div class="time-display text-success fs-5" id="cSprintTime">-</div>
                </div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-8">
                    <label class="form-label fw-bold">Måltid</label>
                    <input type="text" class="form-control form-control-lg" id="cFinishTime" placeholder="HH:MM:SS"
                        ${!hasStartTime ? 'disabled' : ''}>
                </div>
                <div class="col-4 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-lg w-100" onclick="springCNow()" ${!hasStartTime ? 'disabled' : ''}>
                        <i class="bi bi-clock me-1"></i>Nu
                    </button>
                </div>
            </div>

            <!-- Total time -->
            <div class="text-center p-3 rounded mb-3" style="background: var(--bs-tertiary-bg);">
                <div class="small text-muted">Sluttid</div>
                <div class="time-display text-primary fs-3" id="cTotalTime">-</div>
            </div>

            <!-- DNS / DNF -->
            <div class="d-flex gap-2 mb-2">
                <button type="button" class="btn btn-outline-dark w-50" onclick="springCSetStatus('DNS')">
                    Ej start (DNS)
                </button>
                <button type="button" class="btn btn-outline-dark w-50" onclick="springCSetStatus('DNF')">
                    Bröt (DNF)
                </button>
            </div>

            <!-- Save button -->
            <button class="btn btn-success btn-lg w-100 py-3" onclick="springCSave()" id="cSaveBtn">
                <i class="bi bi-check-circle me-1"></i>Spara resultat
            </button>
