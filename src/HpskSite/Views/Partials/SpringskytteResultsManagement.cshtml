    <script>
        (function () {
            if (!window.EventInbox || !springPresetWeaponClass) return;
            var role = springTimingMode ? 'timer' : 'scorer';
            var roleLabel = springTimingMode ? 'Tid & straff ' : 'Poäng ';
            EventInbox.init({
                competitionId: springCompetitionId,
                mountSelector: '#evtMountSpringStation',
                label: roleLabel + springPresetWeaponClass,
                // A and C never run at the same time — one physical line, so messaging is role-based
                // (no per-class scope). Matches the roles + "Alla funktionärer" model of other disciplines.
                fromScope: { type: 'Role', key: role },
                scopes: [
                    { type: 'Role', key: role }
                ],
