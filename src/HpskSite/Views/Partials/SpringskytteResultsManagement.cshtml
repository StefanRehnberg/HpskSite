@*
 * Springskytte Results Management Partial View
 * Completely isolated from standard competition results entry.
 * Handles time-based results with stop-by-stop shot recording.
 *
 * Two entry modes:
 *   Tab 1 "Vapengrupp A" — Sequential shooter navigation, finish time → sprint calculation
 *   Tab 2 "Vapengrupp C — Banregistrering" — Mobile-first range officer mode with number pad lookup
 *
 * Class C: 6 stops x 5 shots, each Hit (H) or Miss (B)
 * Class A: Configurable series (1-6), 30 shots total, zone values 0-3
 *@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
    var competitionType = ViewData["CompetitionType"]?.ToString() ?? "Springskytte";
    var numberOfSeries = ViewData["NumberOfSeriesOrStations"] as int? ?? 6;
    var competitionName = ViewData["CompetitionName"]?.ToString() ?? "Springskytte";
    var isStationPage = ViewData["IsStationPage"] != null && (bool)ViewData["IsStationPage"];
    var presetWeaponClass = ViewData["PresetWeaponClass"]?.ToString() ?? "";
    var isTimingMode = ViewData["IsTimingMode"] != null && (bool)ViewData["IsTimingMode"];
    var subCompetitionName = ViewData["SubCompetitionName"]?.ToString() ?? "";
    var resultPageUrl = ViewData["ResultPageUrl"]?.ToString() ?? "";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<div class="springskytte-results-management" data-competition-id="@competitionId" data-number-of-series="@numberOfSeries">
    @* The role-screen launchers (Poäng / Tid & straff / Startlinje per class) moved to the dedicated
       "Funktionärer" hub tab, alongside the live functionary load view. *@

    <!-- Results Entry Section -->
    <div class="card" style="@(!isStationPage ? "display:none" : "")">
        @if (isStationPage)
        {
            <div class="card-header d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <div>
                @if (isTimingMode)
                {
                    <h5 class="mb-0"><i class="bi bi-stopwatch me-2"></i>Tidtagning &amp; straff — @competitionName
                        @if (presetWeaponClass == "A") { <span class="badge bg-primary ms-2">Vapengrupp A</span> }
                        else if (presetWeaponClass == "C") { <span class="badge bg-primary ms-2">Vapengrupp C</span> }
                    </h5>
                }
                else
                {
                    <h5 class="mb-0"><i class="bi bi-stopwatch me-2"></i>Registrera Resultat — @competitionName
                        @if (presetWeaponClass == "A") { <span class="badge bg-primary ms-2">Vapengrupp A</span> }
                        else if (presetWeaponClass == "C") { <span class="badge bg-primary ms-2">Vapengrupp C</span> }
                    </h5>
                }
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button id="springWakeBtn" class="btn btn-outline-secondary btn-sm" title="Hindra skärmen från att slockna"><i class="bi bi-display me-1"></i>Håll skärmen vaken</button>
                    <span id="evtMountSpringStation"></span>
                </div>
            </div>
        }
        else
        {
            <div class="card-header" style="cursor: pointer;" onclick="toggleSpringskytteEntry(event)">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-chevron-down me-2" id="springEntryChevron"></i>
                        <h5 class="mb-0"><i class="bi bi-stopwatch me-2"></i>Registrera Resultat</h5>
                    </div>
                    <span class="text-muted small">
                        <i class="bi bi-info-circle me-1"></i>Ange måltid och skjutresultat per skytt
                    </span>
                </div>
            </div>
        }
        <div class="card-body" id="springEntryBody">
            <!-- Tabs for Class A / Class C (hidden on station page where only one class is shown,
                 and hidden entirely in timing mode which has its own single pane) -->
            @if (!isTimingMode && (!isStationPage || string.IsNullOrEmpty(presetWeaponClass)))
            {
            <ul class="nav nav-tabs mb-3" id="springEntryTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="springTabA-tab" data-bs-toggle="tab" data-bs-target="#springTabA"
                        type="button" role="tab" aria-controls="springTabA" aria-selected="true">
                        <i class="bi bi-card-list me-1"></i>Vapengrupp A
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="springTabC-tab" data-bs-toggle="tab" data-bs-target="#springTabC"
                        type="button" role="tab" aria-controls="springTabC" aria-selected="false">
                        <i class="bi bi-phone me-1"></i>Vapengrupp C
                    </button>
                </li>
            </ul>
            }

            <div class="tab-content" id="springEntryTabContent">
                @if (isTimingMode)
                {
                <!-- ===== TIMING & PENALTIES pane — same look as the range-officer station,
                     but for the timing role: finish time + manual penalties/reductions + DNS ===== -->
                <div class="tab-pane fade show active" id="springTabTime" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-3 sticky-top bg-body py-2" style="z-index: 10;">
                        <small class="text-muted">@competitionName</small>
                    </div>
                    <div class="card mb-3">
                        <div class="card-body">
                            @* type=text, NOT number: on a laptop the arrow keys used to scroll the page
                               stepped a number input and silently switched the functionary to another
                               shooter (SM rehearsal 2026-08-03). inputmode keeps the numeric keypad on
                               a phone. The shooter actually loaded is shown in the banner below, never
                               read off this field. *@
                            <label class="form-label fw-bold fs-5" for="springTimeStartNumber">Hämta skytt — startnummer</label>
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control form-control-lg" id="springTimeStartNumber"
                                    placeholder="Ange startnummer" inputmode="numeric" pattern="[0-9]*" autocomplete="off"
                                    onkeydown="if(event.key==='Enter'){springTimeLookup(); event.preventDefault();}">
                                <button class="btn btn-primary btn-lg px-4" onclick="springTimeLookup()">Hämta</button>
                            </div>
                            <div id="springTimeLookupMsg" class="small mt-2"></div>
                            <div id="springTimeCurrentBanner" class="mt-2" style="display:none"></div>
                        </div>
                    </div>
                    <div id="springTimeActiveCard" style="display:none;"></div>
                    <div id="springTimeRecentList" class="mt-3"></div>
                </div>
                }
                else
                {
                <!-- ===== TAB 1: CLASS A — Sequential Entry ===== -->
                @if (!(isStationPage && presetWeaponClass == "C"))
                {
                <div class="tab-pane fade @(presetWeaponClass != "C" ? "show active" : "")" id="springTabA" role="tabpanel" aria-labelledby="springTabA-tab">
                    <!-- Shooter Navigation -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3 sticky-top bg-body py-2" style="z-index: 10;">
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springFirstShooter)" title="Forsta skytten">
                            <i class="bi bi-skip-backward-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springPrevShooter)" title="Foregaende skytt">
                            <i class="bi bi-caret-left-fill"></i>
                        </button>
                        <span class="fw-bold" id="springCurrentShooterInfo">Laddar...</span>
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springNextShooter)" title="Nasta skytt">
                            <i class="bi bi-caret-right-fill"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="springANavigate(springLastShooter)" title="Sista skytten">
                            <i class="bi bi-skip-forward-fill"></i>
                        </button>
                        <div class="ms-auto">
                            <select class="form-select form-select-sm" id="springShooterFilter" onchange="springFilterShooters()" style="width: auto;">
                                <option value="all">Alla (Vapengrupp A)</option>
                                <option value="noresult">Utan resultat</option>
                            </select>
                        </div>
                    </div>

                    <!-- Entry Form Container -->
                    <div id="springEntryContainer">
                        <div class="text-center py-4">
                            <div class="spinner-border" role="status"><span class="visually-hidden">Laddar...</span></div>
                            <p class="mt-2 text-muted">Laddar skyttar...</p>
                        </div>
                    </div>
                </div>
                } @* end if not preset C *@

                <!-- ===== TAB 2: CLASS C — Range Officer Mode ===== -->
                @if (!(isStationPage && presetWeaponClass == "A"))
                {
                <div class="tab-pane fade @(presetWeaponClass == "C" ? "show active" : "")" id="springTabC" role="tabpanel" aria-labelledby="springTabC-tab">
                    <!-- Top bar -->
                    <div class="d-flex justify-content-between align-items-center mb-3 sticky-top bg-body py-2" style="z-index: 10;">
                        <small class="text-muted">@competitionName</small>
                    </div>

                    <!-- Shooter lookup -->
                    <div class="card mb-3">
                        <div class="card-body">
                            @* type=text, NOT number — see the note on the timing picker: arrow keys on a
                               number input silently changed shooter. The loaded shooter is the banner below. *@
                            <label class="form-label fw-bold fs-5" for="springCStartNumber">Hämta skytt — startnummer</label>
                            <div class="d-flex gap-2">
                                <input type="text" class="form-control form-control-lg" id="springCStartNumber"
                                    placeholder="Ange startnummer" inputmode="numeric" pattern="[0-9]*" autocomplete="off"
                                    onkeydown="if(event.key==='Enter'){springCLookup(); event.preventDefault();}">
                                <button class="btn btn-primary btn-lg px-4" onclick="springCLookup()">Hämta</button>
                            </div>
                            <div id="springCCurrentBanner" class="mt-2" style="display:none"></div>
                        </div>
                    </div>

                    <!-- Active shooter card (hidden until lookup) -->
                    <div id="springCActiveCard" style="display:none;"></div>

                    <!-- Recently entered list -->
                    <div id="springCRecentList" class="mt-3"></div>
                </div>
                } @* end if not preset A *@
                } @* end else (not timing mode) *@
            </div>
        </div>
    </div>

    @if (!isStationPage)
    {
    <!-- Results List Section -->
    <div class="card mt-4" id="springResultsListSection">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold">
                <i class="bi bi-trophy me-1"></i>Resultatlista
                <span class="badge bg-secondary ms-2" id="springResultsStatusBadge">Ej skapad</span>
            </span>
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(resultPageUrl))
                {
                    <a class="btn btn-outline-secondary btn-sm" id="springPrintBtn" href="@resultPageUrl" target="_blank" rel="noopener" style="display:none"
                        title="Öppna resultatlistan för visning och utskrift">
                        <i class="bi bi-printer me-1"></i>Skriv ut
                    </a>
                }
                @* Each weapon group is calculated and published on its own, so the per-group blocks below
                   (rendered by springLoadResultsList) carry the action buttons. These whole-competition
                   buttons stay as the "no results calculated yet" entry point and for a competition with
                   a single weapon group. *@
                <button class="btn btn-outline-primary btn-sm" id="springUpdateAllBtn" onclick="springCreateResultsList(event)"
                    title="Räknar om resultatlistan från alla registrerade resultat. Ändrar inte om listan är publik.">
                    <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                </button>
                <button class="btn btn-success btn-sm" id="springPublishBtn" style="display:none" onclick="springPublishResults(event)"
                    title="Räknar om och publicerar listan som officiell — den blir synlig publikt på tävlingssidan.">
                    <i class="bi bi-check-circle me-1"></i>Publicera
                </button>
                <button class="btn btn-outline-secondary btn-sm" id="springUnpublishBtn" style="display:none" onclick="springUnpublishResults(event)"
                    title="Döljer resultatlistan publikt igen (gör den preliminär).">
                    <i class="bi bi-eye-slash me-1"></i>Gör preliminär
                </button>
            </div>
        </div>
        <div class="card-body">
            <div id="springResultsBody">
                <div id="springResultsContent">
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-list-check fs-3 d-block mb-2"></i>
                        Ingen resultatlista ännu — klicka <strong>Uppdatera</strong> för att räkna ut den,
                        och <strong>Publicera</strong> när den ska bli synlig publikt.
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(subCompetitionName))
    {
    <!-- Deltävling Result List Section — same structural shape as the main Springskytte
         result list above. Filters to IsSubCompetition shooters, recalculates medals
         over the subset, and publishes via subCompetitionIsOfficial so the public
         competition page can surface its own Visa resultat button. Layout mirrors the
         main section exactly (no extra wrapper headings) — the Deltävling name sits in
         the button row as a small label so the visual rhythm matches. -->
    <div class="card mt-3" id="springSubResultsListSection">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-bold">
                <i class="bi bi-trophy me-1"></i>Deltävling: @subCompetitionName
                <span class="badge bg-secondary ms-2" id="springSubResultsStatusBadge">Ej skapad</span>
            </span>
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(resultPageUrl))
                {
                    <a class="btn btn-outline-secondary btn-sm" id="springSubPrintBtn" href="@(resultPageUrl)?sub=true" target="_blank" rel="noopener" style="display:none"
                        title="Öppna deltävlingens resultatlista för visning och utskrift">
                        <i class="bi bi-printer me-1"></i>Skriv ut
                    </a>
                }
                <button class="btn btn-outline-primary btn-sm" onclick="springCreateSubResultsList(event)"
                    title="Uppdaterar deltävlingens resultatvisning (endast deltävlingsanmälda skyttar). Ändrar inte om den är publik.">
                    <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
                </button>
                <button class="btn btn-success btn-sm" id="springSubPublishBtn" onclick="springPublishSubResults(event)"
                    title="Publicerar deltävlingens resultat som officiella — syns publikt på tävlingssidan.">
                    <i class="bi bi-check-circle me-1"></i>Publicera
                </button>
                <button class="btn btn-outline-secondary btn-sm" id="springSubUnpublishBtn" style="display:none" onclick="springUnpublishSubResults(event)"
                    title="Döljer deltävlingens resultat publikt igen (gör den preliminär).">
                    <i class="bi bi-eye-slash me-1"></i>Gör preliminär
                </button>
            </div>
        </div>
        <div class="card-body">
            <div id="springSubResultsBody">
                <div id="springSubResultsContent">
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-list-check fs-3 d-block mb-2"></i>
                        Ingen deltävlingslista ännu — klicka <strong>Uppdatera</strong>, och
                        <strong>Publicera</strong> när den ska bli synlig publikt.
                    </div>
                </div>
            </div>
        </div>
    </div>
    }
    }
</div>

@if (isStationPage)
{
<div class="modal fade" id="springTimeAdjModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Straff / tidsavdrag</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3"><strong id="springTimeAdjName">–</strong> <span class="text-muted" id="springTimeAdjClass"></span></p>
                <div class="btn-group w-100 mb-3" role="group">
                    <input type="radio" class="btn-check" name="springTimeAdjType" id="springTimeAdjPenalty" value="Penalty" checked onchange="springTimeSyncAdjType()">
                    <label class="btn btn-outline-danger" for="springTimeAdjPenalty">Straff (+ min)</label>
                    <input type="radio" class="btn-check" name="springTimeAdjType" id="springTimeAdjReduction" value="Reduction" onchange="springTimeSyncAdjType()">
                    <label class="btn btn-outline-success" for="springTimeAdjReduction">Tidsavdrag (− tid)</label>
                </div>
                <div id="springTimePenaltyFields">
                    <label class="form-label small fw-bold">Antal straffpoäng (1 poäng = 1 minut)</label>
                    <input type="number" class="form-control mb-2" id="springTimeAdjPoints" value="1" min="1" max="60">
                </div>
                <div id="springTimeReductionFields" style="display:none">
                    <label class="form-label small fw-bold">Tid att dra av (MM:SS)</label>
                    <input type="text" class="form-control mb-2" id="springTimeAdjTime" placeholder="MM:SS">
                </div>
                <label class="form-label small fw-bold">Anledning</label>
                <select class="form-select mb-2" id="springTimeAdjReasonSelect"></select>
                <input type="text" class="form-control" id="springTimeAdjReasonText" placeholder="Egen anledning (valfritt)">
                <div class="alert alert-danger mt-3 mb-0 py-2 d-none" id="springTimeAdjError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="springTimeSaveAdj()"><i class="bi bi-check-lg me-1"></i>Lägg till</button>
            </div>
        </div>
    </div>
</div>
}

<style>
    .shot-btn { width: 42px; height: 36px; font-size: 0.85rem; font-weight: 600; padding: 0; }
    .shot-btn.active-hit { background-color: var(--bs-success); border-color: var(--bs-success); color: #fff; }
    .shot-btn.active-miss { background-color: var(--bs-danger); border-color: var(--bs-danger); color: #fff; }
    .zone-input { width: 42px; text-align: center; font-weight: 600; }
    .zone-count-input { width: 56px; text-align: center; font-weight: 600; }
    .stop-group { border: 1px solid var(--bs-border-color); border-radius: 0.375rem; padding: 0.5rem; margin-bottom: 0.5rem; }
    .stop-header { font-weight: 600; font-size: 0.85rem; color: var(--bs-secondary-color); }
    .time-display { font-family: monospace; font-size: 1.1rem; font-weight: 700; }
    .result-summary { font-size: 0.9rem; }
    .result-summary .label { color: var(--bs-secondary-color); }
    .shooter-result-badge { font-size: 0.75rem; }
    .springskytte-results-table th { white-space: nowrap; font-size: 0.85rem; }
    .springskytte-results-table td { font-size: 0.85rem; }
    .springskytte-results-table .time-col { font-family: monospace; }

    /* Class C — Range Officer Mode */
    .shot-btn-lg { min-width: 52px; min-height: 52px; font-size: 1.1rem; font-weight: 700; padding: 0; border-radius: 0.5rem; }
    .shot-btn-lg.active-hit { background-color: var(--bs-success); border-color: var(--bs-success); color: #fff; }
    .shot-btn-lg.active-miss { background-color: var(--bs-danger); border-color: var(--bs-danger); color: #fff; }
    .spring-c-station { border: 1px solid var(--bs-border-color); border-radius: 0.5rem; padding: 0.75rem; margin-bottom: 0.75rem; }
    .spring-c-station-header { font-weight: 700; font-size: 1rem; margin-bottom: 0.5rem; }
    /* Per-station one/two-hand grip toggle — sits on the station header row (never the shot row) so
       it can't widen the 5-button grid on a phone. Colour-coded so the grip reads at a glance. */
    .hand-toggle-btn { font-size: 0.8rem; font-weight: 600; white-space: nowrap; padding: 0.15rem 0.5rem; }
    /* Unset = a dashed outline prompt so it clearly reads as a button that still needs a choice. */
    .hand-toggle-btn.hand-unset { border-style: dashed; }
    .hand-toggle-btn.hand-one { background-color: var(--bs-primary); border-color: var(--bs-primary); color: #fff; }
    .hand-toggle-btn.hand-two { background-color: var(--bs-warning); border-color: var(--bs-warning); color: #000; }
    .spring-c-recent-item { cursor: pointer; }
    .spring-c-recent-item:hover { background-color: var(--bs-tertiary-bg); }
</style>

<script>
// Format Springskytte age class with age span (e.g. "H 50" → "H 50-59")
function formatAgeSpan(cls) {
    if (!cls) return cls;
    var inline = {'21':'21-34','35':'35-49','50':'50-59','60':'60-64','65':'65-69','70':'70+'};
    var parens = {'15':'-15 år','18':'16-18 år','jun':'15-20 år'};
    for (var code in inline) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls.substring(0, cls.length - code.length) + inline[code];
    }
    for (var code in parens) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls + ' (' + parens[code] + ')';
    }
    return cls;
}

// Retry helper for save operations (handles transient failures from concurrent saves)
async function springFetchWithRetry(url, options, maxRetries = 1) {
    for (let attempt = 0; attempt <= maxRetries; attempt++) {
        try {
            const response = await fetch(url, options);
            const data = await response.json();
            if (data.success || attempt >= maxRetries) return data;
            console.warn('Springskytte save failed, retrying...', data.message);
            await new Promise(r => setTimeout(r, 500));
        } catch (error) {
            if (attempt >= maxRetries) throw error;
            console.warn('Springskytte network error, retrying...', error);
            await new Promise(r => setTimeout(r, 500));
        }
    }
}

// ===== Springskytte Results Management =====
let springShooters = [];
let springFilteredShooters = [];
let springCurrentIndex = 0;
const springCompetitionId = parseInt('@competitionId');
const springNumberOfSeries = parseInt('@numberOfSeries') || 6;
const springTimingMode = @(isTimingMode ? "true" : "false");
const springPresetWeaponClass = '@presetWeaponClass';   // 'A' | 'C' | '' — scopes the timing lookup

// Class C state
let springCRecentEntries = [];  // last 5 saved entries
let springCActiveShooter = null;

document.addEventListener('DOMContentLoaded', () => {
    springWakeInit();  // scorer + timer station screens can opt to keep the screen awake
    if (springTimingMode) { springTimeInit(); return; }   // timing role has its own pane + data
    springLoadShooters();
    springLoadResultsList();
    // Auto-load Deltävling results when the section is present (subCompetitionName configured)
    if (document.getElementById('springSubResultsListSection')) {
        springLoadSubResultsList();
    }
});

// ===== Wake lock — keep the scoring/timing screen awake during a long session (opt-in) =====
let springWakeLock = null, springWakeWanted = false;
function springWakeInit() {
    const btn = document.getElementById('springWakeBtn');
    if (!btn) return;
    btn.addEventListener('click', async () => {
        if (springWakeWanted) { springWakeWanted = false; if (springWakeLock) { try { await springWakeLock.release(); } catch (e) {} springWakeLock = null; } }
        else {
            springWakeWanted = true;
            if (!('wakeLock' in navigator)) { btn.innerHTML = '<i class="bi bi-x me-1"></i>Stöds ej'; springWakeWanted = false; return; }
            await springAcquireWake();
        }
        springRenderWakeBtn();
    });
    document.addEventListener('visibilitychange', async () => { if (springWakeWanted && !springWakeLock && document.visibilityState === 'visible') await springAcquireWake(); });
}
async function springAcquireWake() {
    if (!('wakeLock' in navigator)) return false;
    try { springWakeLock = await navigator.wakeLock.request('screen'); springWakeLock.addEventListener('release', () => { springWakeLock = null; }); return true; }
    catch (e) { return false; }
}
function springRenderWakeBtn() {
    const btn = document.getElementById('springWakeBtn');
    if (!btn) return;
    if (springWakeWanted) { btn.innerHTML = '<i class="bi bi-display-fill me-1"></i>Skärm vaken'; btn.classList.replace('btn-outline-secondary', 'btn-secondary'); }
    else { btn.innerHTML = '<i class="bi bi-display me-1"></i>Håll skärmen vaken'; btn.classList.replace('btn-secondary', 'btn-outline-secondary'); }
}

// ===== TIMING & PENALTIES pane (timing role) — same look as the range-officer station =====
let springTimeStarters = [];
let springTimeFreeSlots = [];   // suggestions when a delay forces a new start time
let springTimeAdjByKey = {};
let springTimeActive = null;
let springTimeRecent = [];
let springTimeFinishPicker = null;
const SPRING_TIME_PEN_REASONS = ['Vapenhantering utanför skjutområde','Oproppat vapen efter skjutning','För tidig start','Otillåten utrustning','Ordningsförseelse','Annat'];
const SPRING_TIME_RED_REASONS = ['Bana blockerad – väntan','Avbrott/incident','Tekniskt fel på bana','Väntan pga föregående skytt','Funktionärsfel','Annat'];

function springTimeToken(){ return document.querySelector('input[name="__RequestVerificationToken"]')?.value; }
function springTimeKey(m,w){ return m+'|'+w; }
function springTimeEsc(s){ return (s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function springTimeHmsToSec(t){ if(!t) return null; const p=String(t).split(':').map(Number); return p.length===3?p[0]*3600+p[1]*60+p[2]:(p.length===2?p[0]*3600+p[1]*60:null); }
function springTimeFmtDur(sec){ if(sec==null||sec<0) return '–'; const m=Math.floor(sec/60),s=sec%60; return m+':'+String(s).padStart(2,'0'); }

async function springTimeInit(){
    await springTimeLoad();
    const el = document.getElementById('springTimeStartNumber');
    if (el) el.focus();
}
async function springTimeLoad(){
    try {
        const [st, adj] = await Promise.all([
            fetch(`/umbraco/surface/Springskytte/GetSpringskytteStarterState?competitionId=${springCompetitionId}`,{headers:{'X-Requested-With':'XMLHttpRequest'}}).then(r=>r.json()),
            fetch(`/umbraco/surface/Springskytte/GetSpringskytteAdjustments?competitionId=${springCompetitionId}`,{headers:{'X-Requested-With':'XMLHttpRequest'}}).then(r=>r.json())
        ]);
        springTimeStarters = st.success ? (st.starters||[]) : [];
        springTimeFreeSlots = st.success ? (st.freeSlots||[]) : [];
        // Scope to the chosen weapon group so start-number lookup is unambiguous (numbers repeat across groups).
        if (springPresetWeaponClass) springTimeStarters = springTimeStarters.filter(s => s.weaponClass === springPresetWeaponClass);
        springTimeAdjByKey = {};
        if (adj.success) for (const a of adj.adjustments){ (springTimeAdjByKey[springTimeKey(a.memberId,a.weaponClass)] ||= []).push(a); }
        if (springTimeActive){ const s = springTimeStarters.find(x=>x.memberId===springTimeActive.memberId && x.weaponClass===springTimeActive.weaponClass); if(s){ springTimeActive=s; springTimeRenderActive(); } }
    } catch(e){ /* keep last */ }
}
async function springTimeLookup(){
    const msg = document.getElementById('springTimeLookupMsg');
    const n = parseInt(document.getElementById('springTimeStartNumber').value,10);
    if (isNaN(n)){ msg.innerHTML='<span class="text-warning">Ange ett startnummer.</span>'; return; }
    msg.textContent='';
    const matches = springTimeStarters.filter(s=>s.startOrder===n);
    if (!matches.length){ msg.innerHTML=`<span class="text-danger">Ingen startande med nummer ${n}.</span>`; return; }
    // Flush any pending måltid save for the shooter we're leaving, then log them in "Nyss sparade".
    if (springTimeActive) {
        await springTimeAutoSaveFinish();
        springTimeLogRecent(springTimeActive);
    }
    if (matches.length===1){ springTimeActive=matches[0]; springTimeRenderActive(); springTimeClearPicker(); return; }
    const card=document.getElementById('springTimeActiveCard'); card.style.display='block';
    card.innerHTML=`<div class="card border-warning"><div class="card-body"><div class="fw-bold mb-2">Flera skyttar med nr ${n} – välj vapengrupp:</div>`+
        matches.map((s,i)=>`<button class="btn btn-outline-primary w-100 mb-2" onclick="springTimePick(${i})">${s.weaponClass} · ${springTimeEsc(s.name)} (${springTimeEsc(s.ageGenderClass)})</button>`).join('')+`</div></div>`;
    window._springTimeMatches=matches;
}
function springTimePick(i){ springTimeActive=window._springTimeMatches[i]; springTimeRenderActive(); springTimeClearPicker(); }
// Empty the picker and keep the caret in it, so the next number can be typed with no deleting.
// Safe only because the loaded shooter is named in the banner rather than read off this field.
function springTimeClearPicker(){
    const el=document.getElementById('springTimeStartNumber');
    if(el){ el.value=''; el.focus(); }
}
function springTimeRenderActive(){
    const s=springTimeActive, card=document.getElementById('springTimeActiveCard');
    springRenderCurrentShooterBanner('springTimeCurrentBanner', s);
    if(!s){ card.style.display='none'; card.innerHTML=''; return; }
    const startSec=springTimeHmsToSec(s.startTime), dns=s.isDns===true;
    // Restore an already-saved måltid so a re-render (e.g. after adding straff) never blanks it.
    const savedFinishStr=(s.sprintTimeSeconds!=null && startSec!=null) ? formatSecondsToHMS(startSec + Number(s.sprintTimeSeconds)) : '';
    card.style.display='block';
    card.innerHTML=`
    <div class="card border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span class="fw-bold">#${s.startOrder} — ${springTimeEsc(s.name)}</span>
            <span>${s.weaponClass} · ${springTimeEsc(s.ageGenderClass)}</span>
        </div>
        <div class="card-body">
            ${dns?'<div class="alert alert-dark py-2"><i class="bi bi-x-octagon me-1"></i>Markerad som <strong>DNS</strong> – startar inte.</div>':''}
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted">Starttid</span>
                <span class="d-flex align-items-center gap-2">
                    <span class="time-display" id="springTimeStartDisplay">${(s.startTime||'–').substring(0,8)}</span>
                    <button class="btn btn-outline-secondary btn-sm" onclick="springTimeToggleStartEdit(true)" title="Ändra starttid"><i class="bi bi-pencil"></i></button>
                </span>
            </div>
            @* A delay means the range officer hand-writes a new start time on the printed list; it has
               to be enterable here, on the timing screen (SM rehearsal 2026-08-03). *@
            <div id="springTimeStartEdit" class="border rounded p-2 mb-2" style="display:none">
                <label class="form-label small fw-bold mb-1" for="springTimeStartInput">Ny starttid (HH:MM:SS)</label>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control time-display" id="springTimeStartInput" list="springTimeFreeSlotList"
                        autocomplete="off" value="${(s.startTime||'').substring(0,8)}"
                        onkeydown="if(event.key==='Enter'){springTimeSaveStart(); event.preventDefault();}">
                    <button class="btn btn-primary" onclick="springTimeSaveStart()">Spara</button>
                    <button class="btn btn-outline-secondary" onclick="springTimeToggleStartEdit(false)">Avbryt</button>
                </div>
                <datalist id="springTimeFreeSlotList">${springTimeFreeSlotOptions(s.weaponClass)}</datalist>
                <div class="small text-muted mt-1" id="springTimeStartMsg">Lediga luckor föreslås i fältet. Löptiden räknas om från den nya starttiden.</div>
            </div>
            <label class="form-label fw-bold mb-1 fs-5">Måltid</label>
            <button class="btn btn-primary w-100 py-3 mb-2 fs-4 fw-bold" onclick="springTimeNow()" ${dns?'disabled':''}><i class="bi bi-stopwatch me-2"></i>Nu – sätt måltid</button>
            <input type="text" class="form-control form-control-lg time-display mb-1" id="springTimeFinish" placeholder="HH:MM:SS (eller ändra manuellt)" value="${savedFinishStr}" ${dns?'disabled':''}>
            <div id="springTimeFinishMsg" class="small mb-2">${savedFinishStr?'<span class="text-success"><i class="bi bi-check-circle-fill"></i> Måltid sparad</span>':''}</div>
            <div class="d-flex justify-content-between align-items-center mb-3"><span class="text-muted">Löptid</span><span class="time-display fs-3" id="springTimeSprint">–</span></div>
            <div class="border rounded p-2 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold">Straff &amp; tidsavdrag</span>
                    <button class="btn btn-outline-primary btn-sm" onclick="springTimeOpenAdj()"><i class="bi bi-plus-lg"></i> Lägg till</button>
                </div>
                <div id="springTimeAdjList">${springTimeAdjBadges(s.memberId,s.weaponClass)}</div>
            </div>
            <div class="d-flex gap-2 mb-3">
                <button class="btn btn-outline-secondary w-50 ${dns?'active':''}" onclick="springTimeSetDns(${dns?'false':'true'})"><i class="bi bi-x-octagon me-1"></i>${dns?'Ångra DNS':'Ej start (DNS)'}</button>
                <button class="btn btn-outline-secondary w-50" onclick="springTimeSetDnf()" ${dns?'disabled':''}><i class="bi bi-flag me-1"></i>Bröt (DNF)</button>
            </div>
            <div class="text-muted small text-center"><i class="bi bi-info-circle me-1"></i>Måltid, straff och tidsavdrag sparas automatiskt. Ange nästa startnummer ovan för nästa skytt.</div>
        </div>
    </div>`;
    const fEl=document.getElementById('springTimeFinish');
    if(fEl && !dns){
        springTimeFinishPicker=flatpickr(fEl,{locale:'sv',enableTime:true,noCalendar:true,enableSeconds:true,dateFormat:'H:i:S',time_24hr:true,allowInput:true});
        if(savedFinishStr) springTimeFinishPicker.setDate(savedFinishStr,false);
        fEl.addEventListener('input',()=>springTimeRecalc(startSec));
        // Persist the måltid the moment it's committed — a saved time can never be lost by a later re-render.
        fEl.addEventListener('change',()=>{ springTimeRecalc(startSec); springTimeAutoSaveFinish(); });
    }
    springTimeRecalc(startSec);
}
function springTimeRecalc(startSec){
    const v=(document.getElementById('springTimeFinish')?.value||'').trim(), fin=springTimeHmsToSec(v), el=document.getElementById('springTimeSprint');
    if(el) el.textContent=(fin!=null&&startSec!=null&&fin>=startSec)?springTimeFmtDur(fin-startSec):'–';
}

// ===== Editing a shooter's start time from the timing screen =====
// Reuses UpdateSpringskytteStarter (which owns the uniqueness/occupied-slot guards and re-anchors an
// already-recorded löptid on the new start time).
function springTimeFreeSlotOptions(wc){
    return (springTimeFreeSlots||[])
        .filter(f => !wc || !f.weaponClass || f.weaponClass === wc)
        .map(f => `<option value="${springTimeEsc((f.time||'').substring(0,8))}"></option>`).join('');
}
function springTimeToggleStartEdit(show){
    const box=document.getElementById('springTimeStartEdit');
    if(!box) return;
    box.style.display = show ? '' : 'none';
    if(show){ const i=document.getElementById('springTimeStartInput'); if(i){ i.focus(); i.select(); } }
}
async function springTimeSaveStart(){
    const s=springTimeActive; if(!s) return;
    const msg=document.getElementById('springTimeStartMsg');
    const val=(document.getElementById('springTimeStartInput')?.value||'').trim();
    if(!/^\d{1,2}:\d{2}(:\d{2})?$/.test(val)){
        if(msg) msg.innerHTML='<span class="text-danger">Ange tiden som HH:MM eller HH:MM:SS.</span>';
        return;
    }
    if(!s.nodeId){
        if(msg) msg.innerHTML='<span class="text-danger">Skytten saknar startlista — starttiden kan inte ändras här.</span>';
        return;
    }
    if(msg) msg.innerHTML='<span class="text-muted"><i class="bi bi-arrow-repeat"></i> Sparar…</span>';
    try{
        const d=await fetch('/umbraco/surface/Springskytte/UpdateSpringskytteStarter',{
            method:'POST',
            headers:{'Content-Type':'application/json','RequestVerificationToken':springTimeToken()},
            body:JSON.stringify({competitionId:springCompetitionId,nodeId:s.nodeId,memberId:s.memberId,weaponClass:s.weaponClass,startTime:val})
        }).then(r=>r.json());
        if(!d.success){
            if(msg) msg.innerHTML=`<span class="text-danger">${springTimeEsc(d.message||'Kunde inte spara starttiden.')}</span>`;
            return;
        }
        // Re-read from the server so starttid, löptid and the free-slot list are all the stored truth.
        await springTimeLoad();
        springTimeToggleStartEdit(false);
        const m2=document.getElementById('springTimeFinishMsg');
        if(m2) m2.innerHTML='<span class="text-success"><i class="bi bi-check-circle-fill"></i> Starttid ändrad – löptiden är omräknad</span>';
    }catch(e){
        if(msg) msg.innerHTML='<span class="text-danger">Kunde inte spara – försök igen.</span>';
    }
}
function springTimeNow(){
    const d=new Date(), t=String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0')+':'+String(d.getSeconds()).padStart(2,'0');
    // setDate(...,false): do NOT fire the change event — springTimeNow saves explicitly below,
    // so triggering change too would fire a second, concurrent save (dup-key race → false error).
    if(springTimeFinishPicker) springTimeFinishPicker.setDate(t,false); else document.getElementById('springTimeFinish').value=t;
    springTimeRecalc(springTimeHmsToSec(springTimeActive?.startTime));
    springTimeAutoSaveFinish();  // "Nu" persists immediately — never held only in the input
}
// Persist the current måltid without leaving the shooter. Serialized through a promise chain so
// overlapping triggers (e.g. the input's blur-change + the explicit call from "Nu") can never run
// two concurrent SaveSpringskytteFinishTime requests — that raced on the insert and surfaced a
// spurious "Ett fel uppstod" even though the row saved. Only a complete, valid HH:MM:SS is sent.
let springTimeFinishSaveChain = Promise.resolve();
function springTimeAutoSaveFinish(){
    springTimeFinishSaveChain = springTimeFinishSaveChain.then(() => springTimeDoFinishSave());
    return springTimeFinishSaveChain;
}
async function springTimeDoFinishSave(){
    if(!springTimeActive) return;
    const val=(document.getElementById('springTimeFinish')?.value||'').trim();
    if(!val || springTimeHmsToSec(val)==null) return;
    const msg=document.getElementById('springTimeFinishMsg');
    if(msg) msg.innerHTML='<span class="text-muted"><i class="bi bi-arrow-repeat"></i> Sparar…</span>';
    const shooter=springTimeActive;
    try{
        const d=await fetch('/umbraco/surface/Springskytte/SaveSpringskytteFinishTime',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':springTimeToken()},body:JSON.stringify({competitionId:springCompetitionId,memberId:shooter.memberId,weaponClass:shooter.weaponClass,finishTimeInput:val})}).then(r=>r.json());
        const stillActive=springTimeActive && springTimeActive.memberId===shooter.memberId && springTimeActive.weaponClass===shooter.weaponClass;
        if(d.success){ shooter.sprintTimeSeconds=d.sprintTimeSeconds; if(stillActive && msg) msg.innerHTML='<span class="text-success"><i class="bi bi-check-circle-fill"></i> Måltid sparad</span>'; }
        else if(stillActive && msg){ msg.innerHTML=`<span class="text-danger">${springTimeEsc(d.message||'Kunde inte spara.')}</span>`; }
    }catch(e){ if(msg) msg.innerHTML='<span class="text-danger">Kunde inte spara – försök igen.</span>'; }
}
function springTimeAdjBadges(m,w){
    const list=springTimeAdjByKey[springTimeKey(m,w)]||[];
    if(!list.length) return '<span class="text-muted small">Inga</span>';
    return list.map(a=>{ const isPen=a.adjustmentType==='Penalty'; let label; if(isPen) label='+'+a.points+' min'; else {const mag=Math.abs(a.seconds); label='−'+(mag%60===0?(mag/60)+' min':mag+' s');}
        return `<span class="badge ${isPen?'bg-danger':'bg-success'} me-1 mb-1" title="${springTimeEsc(a.reason||'')}">${label} <a href="#" class="text-white ms-1" onclick="springTimeDelAdj(${a.id});return false;">&times;</a></span>`; }).join('');
}
// Log a shooter (with a recorded måltid) into the "Nyss sparade" list when we leave them.
// There's no longer a "Spara tid" button — måltid auto-saves, so switching shooter is the cue.
function springTimeLogRecent(s){
    if(!s || s.sprintTimeSeconds == null) return;
    springTimeRecent.unshift({ n:s.startOrder, name:s.name, wc:s.weaponClass, sprint:springTimeFmtDur(Number(s.sprintTimeSeconds)) });
    springTimeRecent = springTimeRecent.slice(0,6);
    springTimeRenderRecent();
}
async function springTimeSetDns(makeDns){
    if(!springTimeActive) return;
    if(makeDns && !confirm('Markera som DNS? Starttiden frigörs.')) return;
    await fetch('/umbraco/surface/Springskytte/SetSpringskytteDns',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':springTimeToken()},body:JSON.stringify({competitionId:springCompetitionId,memberId:springTimeActive.memberId,weaponClass:springTimeActive.weaponClass,isDns:makeDns})});
    await springTimeLoad();
}
async function springTimeSetDnf(){
    if(!springTimeActive) return;
    if(!confirm('Markera som DNF (bröt)?')) return;
    await fetch('/umbraco/surface/Springskytte/SaveSpringskytteFinishTime',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':springTimeToken()},body:JSON.stringify({competitionId:springCompetitionId,memberId:springTimeActive.memberId,weaponClass:springTimeActive.weaponClass,status:'DNF'})});
    springTimeActive=null; const c=document.getElementById('springTimeActiveCard'); c.style.display='none'; c.innerHTML='';
    const sn=document.getElementById('springTimeStartNumber'); sn.value=''; sn.focus();
}
// Straff/tidsavdrag modal is shared by the timing view AND the scoring pads — it targets an
// explicit shooter + an onSaved callback, so both roles use the same ledger.
let springAdjTarget = null;
let springAdjOnSaved = null;
function springOpenAdjFor(target, onSaved){
    if(!target) return;
    springAdjTarget = target; springAdjOnSaved = onSaved || null;
    document.getElementById('springTimeAdjName').textContent = target.name || '';
    document.getElementById('springTimeAdjClass').textContent = target.weaponClass + (target.ageGenderClass ? (' · ' + target.ageGenderClass) : '');
    document.getElementById('springTimeAdjPenalty').checked=true;
    document.getElementById('springTimeAdjPoints').value=1;
    document.getElementById('springTimeAdjTime').value='';
    document.getElementById('springTimeAdjReasonText').value='';
    springTimeSyncAdjType();
    const err=document.getElementById('springTimeAdjError'); err.classList.add('d-none'); err.textContent='';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('springTimeAdjModal')).show();
}
function springTimeOpenAdj(){
    if(!springTimeActive) return;
    springOpenAdjFor(
        { memberId:springTimeActive.memberId, weaponClass:springTimeActive.weaponClass, name:springTimeActive.name, ageGenderClass:springTimeActive.ageGenderClass },
        async () => { await springTimeAutoSaveFinish(); await springTimeLoad(); }  // keep måltid, refresh timing card
    );
}
function springTimeSyncAdjType(){
    const isPen=document.getElementById('springTimeAdjPenalty').checked;
    document.getElementById('springTimePenaltyFields').style.display=isPen?'':'none';
    document.getElementById('springTimeReductionFields').style.display=isPen?'none':'';
    document.getElementById('springTimeAdjReasonSelect').innerHTML=(isPen?SPRING_TIME_PEN_REASONS:SPRING_TIME_RED_REASONS).map(r=>`<option>${springTimeEsc(r)}</option>`).join('');
}
async function springTimeSaveAdj(){
    if(!springAdjTarget) return;
    const err=document.getElementById('springTimeAdjError'); err.classList.add('d-none');
    const isPen=document.getElementById('springTimeAdjPenalty').checked;
    const sel=document.getElementById('springTimeAdjReasonSelect').value;
    const free=(document.getElementById('springTimeAdjReasonText').value||'').trim();
    const reason=free?(sel==='Annat'?free:sel+' – '+free):sel;
    const body={competitionId:springCompetitionId,memberId:springAdjTarget.memberId,weaponClass:springAdjTarget.weaponClass,adjustmentType:isPen?'Penalty':'Reduction',reason};
    if(isPen) body.points=parseInt(document.getElementById('springTimeAdjPoints').value,10);
    else body.timeInput=(document.getElementById('springTimeAdjTime').value||'').trim();
    try{
        const d=await fetch('/umbraco/surface/Springskytte/AddSpringskytteAdjustment',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':springTimeToken()},body:JSON.stringify(body)}).then(r=>r.json());
        if(d.success){ bootstrap.Modal.getOrCreateInstance(document.getElementById('springTimeAdjModal')).hide(); if(springAdjOnSaved) await springAdjOnSaved(); }
        else { err.textContent=d.message||'Kunde inte spara.'; err.classList.remove('d-none'); }
    } catch(e){ err.textContent='Ett fel uppstod.'; err.classList.remove('d-none'); }
}
async function springTimeDelAdj(id){
    if(!confirm('Ta bort denna post?')) return;
    // Persist any entered måltid first so the reload below re-renders with it intact.
    await springTimeAutoSaveFinish();
    await fetch('/umbraco/surface/Springskytte/DeleteSpringskytteAdjustment',{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':springTimeToken()},body:JSON.stringify({id,competitionId:springCompetitionId})});
    await springTimeLoad();
}
function springTimeRenderRecent(){
    const el=document.getElementById('springTimeRecentList');
    if(!springTimeRecent.length){ el.innerHTML=''; return; }
    el.innerHTML=`<div class="fw-bold small text-muted mb-1">Nyss sparade</div><div class="list-group">`+
        springTimeRecent.map(r=>`<div class="list-group-item d-flex justify-content-between py-2"><span>#${r.n} ${springTimeEsc(r.name)} <span class="text-muted">(${r.wc})</span></span><span class="time-display">${r.sprint}</span></div>`).join('')+`</div>`;
}

// ===== DATA LOADING =====

// Tab A's container does NOT exist on the Class-C-only station page (/station?c=..&s=C renders the
// C pad alone). Writing a message into it there threw "Cannot set properties of null", which surfaced
// as a page error on every load of that screen whenever the competition had no Class A shooters.
function springSetEntryMessage(html) {
    const el = document.getElementById('springEntryContainer');
    if (el) el.innerHTML = html;
}

async function springLoadShooters() {
    try {
        const response = await fetch(`/umbraco/surface/Springskytte/GetShootersForSpringskytteResults?competitionId=${springCompetitionId}`);
        const data = await response.json();
        if (data.success) {
            springShooters = data.shooters || [];
            springFilterShooters();
            if (springFilteredShooters.length > 0) {
                springCurrentIndex = 0;
                springUpdateNav();
                springRenderEntry();
            } else {
                springSetEntryMessage('<div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>Inga anmälda skyttar hittades.</div>');
            }
        } else {
            springSetEntryMessage(`<div class="alert alert-warning">${data.message || 'Kunde inte ladda skyttar.'}</div>`);
        }
    } catch (err) {
        console.error('Error loading shooters:', err);
        springSetEntryMessage('<div class="alert alert-danger">Ett fel uppstod vid laddning av skyttar.</div>');
    }
}

function springFilterShooters() {
    const filter = document.getElementById('springShooterFilter')?.value || 'all';
    // Tab A only shows Class A shooters
    springFilteredShooters = springShooters.filter(s => {
        if (s.weaponClass !== 'A') return false;
        if (filter === 'noresult') return !s.hasResult;
        return true;
    });
    springCurrentIndex = 0;
    springUpdateNav();
    if (springFilteredShooters.length > 0) {
        springRenderEntry();
    } else {
        springSetEntryMessage('<div class="text-center py-3 text-muted">Inga skyttar matchar filtret.</div>');
    }
}

// ===== NAVIGATION (Tab A) =====

let springASnapshot = null;

function springATakeSnapshot() {
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) return null;
    const isClassC = shooter.weaponClass === 'C';
    return JSON.stringify({
        shots: isClassC ? springCollectClassCShots() : springCollectClassAShots(),
        finishTime: document.getElementById('springFinishTime')?.value || '',
        multiplier: document.querySelector('input[name="springMultiplier"]:checked')?.value || '1'
    });
}

function springAHasUnsavedChanges() {
    if (!springASnapshot) return false;
    return springATakeSnapshot() !== springASnapshot;
}

function springANavigate(fn) {
    if (springAHasUnsavedChanges()) {
        const shooter = springFilteredShooters[springCurrentIndex];
        if (!confirm(`${shooter?.memberName || 'Skytten'} har osparade ändringar. Vill du fortsätta utan att spara?`)) return;
    }
    fn();
}

function springFirstShooter() { springCurrentIndex = 0; springUpdateNav(); springRenderEntry(); }
function springPrevShooter() { if (springCurrentIndex > 0) { springCurrentIndex--; springUpdateNav(); springRenderEntry(); } }
function springNextShooter() { if (springCurrentIndex < springFilteredShooters.length - 1) { springCurrentIndex++; springUpdateNav(); springRenderEntry(); } }
function springLastShooter() { springCurrentIndex = springFilteredShooters.length - 1; springUpdateNav(); springRenderEntry(); }

function springUpdateNav() {
    const el = document.getElementById('springCurrentShooterInfo');
    if (!el) return; // nav isn't on the chromeless /station scoring page
    if (!springFilteredShooters.length) { el.textContent = 'Inga skyttar'; return; }
    const s = springFilteredShooters[springCurrentIndex];
    el.textContent = `${springCurrentIndex + 1}/${springFilteredShooters.length}: ${s.memberName} (${s.weaponClass} - ${formatAgeSpan(s.ageGenderClass)})`;
}

// ===== SHARED UTILITY =====

// The start number of the shooter CURRENTLY loaded, shown big and separate from the picker input.
// The picker holds what the functionary is typing; this banner holds who they are registering — the
// two must never be confused (SM rehearsal 2026-08-03). Pass null to clear.
function springRenderCurrentShooterBanner(elId, s) {
    const el = document.getElementById(elId);
    if (!el) return;
    if (!s) { el.style.display = 'none'; el.innerHTML = ''; return; }
    const name = s.name || s.memberName || '';
    const cls = formatAgeSpan(s.ageGenderClass || s.registeredClass || '');
    el.style.display = '';
    el.innerHTML = `<div class="alert alert-primary d-flex align-items-center gap-3 py-2 mb-0">
            <span class="badge bg-primary fs-3 px-3" id="${elId}Number">#${s.startOrder ?? '–'}</span>
            <div class="lh-sm">
                <div class="fw-bold fs-5">${springTimeEsc(name)}</div>
                <div class="small">Registrerar nu &middot; Vapengrupp ${springTimeEsc(s.weaponClass || '')}${cls ? ' &middot; ' + springTimeEsc(cls) : ''}</div>
            </div>
        </div>`;
}

function calculateSprintTime(startTimeStr, finishTimeStr) {
    if (!startTimeStr || !finishTimeStr) return null;
    const startSec = parseTimeToSeconds(startTimeStr);
    const finishSec = parseTimeToSeconds(finishTimeStr);
    if (startSec === null || finishSec === null) return null;
    const diff = finishSec - startSec;
    return diff >= 0 ? diff : null;
}

// ===== TAB A: ENTRY FORM RENDERING =====

function springRenderEntry() {
    const container = document.getElementById('springEntryContainer');
    if (!container) return; // Tab A entry form isn't on the chromeless /station scoring page
    const shooter = springFilteredShooters[springCurrentIndex];
    if (!shooter) { container.innerHTML = ''; return; }

    const existing = shooter.existingResult;
    const isClassC = shooter.weaponClass === 'C';
    const hasStartTime = !!shooter.startTime;
    const startTimeDisplay = shooter.startTime || '';

    let html = `
        <div class="border rounded p-3">
            <!-- Shooter Header -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="mb-0">${shooter.memberName}</h5>
                    <small class="text-muted">${shooter.memberClub} | Vapengrupp ${shooter.weaponClass} | Klass ${formatAgeSpan(shooter.ageGenderClass)}${shooter.startOrder ? ' | #' + shooter.startOrder : ''}</small>
                </div>
                ${springStatusBadge(shooter)}
            </div>

            <!-- Timekeeping (Måltid/Löptid/Sluttid) + DNS/DNF live in the separate
                 "Tidtagning & straff" view — this scoring view is shots only. -->

            <!-- Shooting Score display -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold"><i class="bi bi-crosshair me-1"></i>Skjutpoäng</label>
                    <div class="time-display text-danger" id="springShootingScore">
                        ${existing?.shootingScore ?? 0}
                    </div>
                </div>
                <div class="col-md-4" data-shotcount-wrap>
                    <label class="form-label fw-bold"><i class="bi bi-123 me-1"></i>Skott registrerade</label>
                    <div class="time-display"><span id="springShotCount" class="fw-bold text-warning">0/30</span></div>
                </div>
            </div>

            <!-- Penalty Multiplier -->
            ${isClassC ? `
            <div class="mb-3">
                <label class="form-label small">Skjutpoäng per bom</label>
                <div class="btn-group btn-group-sm" role="group">
                    <input type="radio" class="btn-check" name="springMultiplier" id="springMult1" value="1" checked>
                    <label class="btn btn-outline-secondary" for="springMult1">1 (Normal)</label>
                    <input type="radio" class="btn-check" name="springMultiplier" id="springMult2" value="2">
                    <label class="btn btn-outline-secondary" for="springMult2">2 (Märkestagning)</label>
                </div>
            </div>` : ''}

            <!-- Shots -->
            <h6 class="mb-2"><i class="bi bi-bullseye me-1"></i>Skjutresultat</h6>
            ${isClassC ? springRenderClassCShots() : springRenderClassAShots()}

            <!-- Straff & tidsavdrag (same ledger as timekeeper) — the pad officer witnesses safety issues. -->
            <div class="border rounded p-2 mt-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold"><i class="bi bi-exclamation-triangle me-1"></i>Straff &amp; tidsavdrag</span>
                    <button class="btn btn-outline-danger btn-sm" onclick="springAOpenAdj()"><i class="bi bi-plus-lg"></i> Lägg till</button>
                </div>
                <div id="springAAdjList"><span class="text-muted small">Inga</span></div>
            </div>

            <!-- Save / Delete / Status -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-danger btn-sm" onclick="springClearResult()">
                        <i class="bi bi-x-circle me-1"></i>Rensa
                    </button>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" onclick="springANavigate(springNextShooter)">
                        Hoppa över <i class="bi bi-skip-forward ms-1"></i>
                    </button>
                    <button class="btn btn-primary" onclick="springSaveResult()">
                        <i class="bi bi-floppy me-1"></i>Spara
                    </button>
                </div>
            </div>
        </div>`;

    container.innerHTML = html;
    springALoadAdj();

    // Initialize Flatpickr for finish time
    if (hasStartTime) {
        flatpickr('#springFinishTime', {
            locale: 'sv',
            enableTime: true,
            noCalendar: true,
            dateFormat: 'H:i:S',
            time_24hr: true,
            enableSeconds: true
        });
    }

    // Restore existing data if shooter has result
    if (existing && shooter.hasResult && existing.shots && existing.shots.length) {
        if (isClassC) {
            for (let stop = 0; stop < existing.shots.length && stop < 6; stop++) {
                const stopShots = existing.shots[stop];
                for (let shot = 0; shot < stopShots.length && shot < 5; shot++) {
                    const btn = document.getElementById(`shot_${stop + 1}_${shot + 1}`);
                    if (!btn) continue;
                    const val = stopShots[shot];
                    if (val === 'H') {
                        btn.dataset.value = 'H';
                        btn.textContent = 'T';
                        btn.classList.remove('btn-outline-secondary');
                        btn.classList.add('active-hit');
