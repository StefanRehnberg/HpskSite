@using System.Globalization;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var clubsPage = ViewData["clubsPage"] as Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent;
    var clubsUrl = ViewData["clubsUrl"] as string ?? "";
    var clubCount = ViewData["clubCount"] as int? ?? 0;
    var featuredItems = ViewData["featuredItems"] as List<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent> ?? new List<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>();
    var isRegionalAdmin = ViewData["isRegionalAdmin"] as bool? ?? false;
    var regionName = ViewData["regionName"] as string ?? "";
    var aboutRegion = ViewData["aboutRegion"] as string ?? "";
    var contactPerson = ViewData["contactPerson"] as string ?? "";
    var contactEmail = ViewData["contactEmail"] as string ?? "";
    var contactPhone = ViewData["contactPhone"] as string ?? "";
}

<div class="row">
    <!-- Main Content Column -->
    <div class="col-lg-8">
        <!-- Quick Stats Card -->
        @{
            var rootPageForStats = Model.Root();
            var competitionsHub = rootPageForStats?.Children.FirstOrDefault(x => x.ContentType.Alias == "competitionsHub");
            var upcomingCompetitionsCount = 0;

            // Get club IDs for this region
            var regionClubIds = new HashSet<int>();
            if (clubsPage != null)
            {
                foreach (var club in clubsPage.Children.Where(c => c.ContentType.Alias == "club"))
                {
                    regionClubIds.Add(club.Id);
                }
            }

            // Count upcoming competitions for clubs in this region
            if (competitionsHub != null && regionClubIds.Any())
            {
                upcomingCompetitionsCount = competitionsHub.Descendants()
                    .Where(c => c.ContentType.Alias == "competition")
                    .Where(c => c.Value<DateTime>("competitionDate") >= DateTime.Today)
                    .Count(c => regionClubIds.Contains(c.Value<int>("clubId")));
            }
        }
        <div class="card mb-4">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="d-flex flex-column align-items-center">
                            <i class="bi bi-building fs-1 text-primary mb-2"></i>
                            <h3 class="mb-0">@clubCount</h3>
                            <small class="text-muted">Klubbar</small>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <div class="d-flex flex-column align-items-center">
                            <i class="bi bi-geo-alt fs-1 text-primary mb-2"></i>
                            <h3 class="mb-0">@regionName</h3>
                            <small class="text-muted">Krets</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex flex-column align-items-center">
                            <i class="bi bi-trophy fs-1 text-primary mb-2"></i>
                            <h3 class="mb-0">@upcomingCompetitionsCount</h3>
                            <small class="text-muted">Kommande tävlingar</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Events -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-calendar-event me-2"></i>Kommande Händelser
                </h5>
            </div>
            <div class="card-body" id="upcomingEventsContainer">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Laddar händelser...</span>
                </div>
            </div>
        </div>

    </div>

    <!-- Sidebar Column -->
    <div class="col-lg-4">
        <!-- Featured Items (Competitions and Series) -->
        @if (featuredItems.Any() || isRegionalAdmin)
        {
            var featuredItemIds = featuredItems.Select(f => f.Id).ToList();
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-star-fill me-2 text-warning"></i>Utvalda Tävlingar</h5>
                    @if (isRegionalAdmin)
                    {
                        <button class="btn btn-sm btn-outline-secondary" onclick="openFeaturedPicker(@Model.Id, 'regionalPage', [@string.Join(",", featuredItemIds)])" title="Redigera">
                            <i class="bi bi-pencil"></i>
                        </button>
                    }
                </div>
                @if (!featuredItems.Any())
                {
                    <div class="card-body text-center text-muted">
                        <small>Inga utvalda tävlingar. Klicka pennan för att lägga till.</small>
                    </div>
                }
                <div class="list-group list-group-flush">
                    @foreach (var item in featuredItems)
                    {
                        var isSeries = item.ContentType.Alias == "competitionSeries";

                        if (isSeries)
                        {
                            // Series display
                            var seriesName = item.Value<string>("seriesName") ?? item.Name;
                            var seriesDescription = item.Value<string>("shortDescription") ?? "";
                            var competitionCount = item.Children.Count(c => c.ContentType.Alias == "competition");

                            <a href="@item.Url()" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong class="d-block">@seriesName</strong>
                                        @if (!string.IsNullOrEmpty(seriesDescription))
                                        {
                                            <small class="text-muted d-block">@seriesDescription</small>
                                        }
                                        <small class="text-muted">
                                            <i class="bi bi-collection me-1"></i>@competitionCount tävlingar
                                        </small>
                                    </div>
                                    <span class="badge bg-purple" style="background-color: #6f42c1;">Serie</span>
                                </div>
                            </a>
                        }
                        else
                        {
                            // Competition display
                            var compName = item.Value<string>("competitionName") ?? item.Name;
                            var compDate = item.Value<DateTime>("competitionDate");
                            var compEndDate = item.Value<DateTime?>("competitionEndDate");
                            var venue = item.Value<string>("venue") ?? "";
                            var isActive = item.Value<bool>("isActive");
                            var registrationOpenDate = item.Value<DateTime>("registrationOpenDate");
                            var registrationCloseDate = item.Value<DateTime>("registrationCloseDate");

                            // Determine status
                            var now = DateTime.Now;
                            string statusText;
                            string statusBadgeClass;

                            if (!isActive)
                            {
                                statusText = "Inaktiv";
                                statusBadgeClass = "bg-secondary";
                            }
                            else if (now < registrationOpenDate)
                            {
                                statusText = "Anmälan öppnar snart";
                                statusBadgeClass = "bg-info";
                            }
                            else if (now >= registrationOpenDate && now <= registrationCloseDate)
                            {
                                statusText = "Anmälan öppen";
                                statusBadgeClass = "bg-success";
                            }
                            else if (now > registrationCloseDate && now.Date < compDate.Date)
                            {
                                statusText = "Anmälan stängd";
                                statusBadgeClass = "bg-warning text-dark";
                            }
                            else if (now.Date == compDate.Date)
                            {
                                statusText = "Pågår idag";
                                statusBadgeClass = "bg-primary";
                            }
                            else if (now.Date > compDate.Date)
                            {
                                statusText = "Avslutad";
                                statusBadgeClass = "bg-secondary";
                            }
                            else
                            {
                                statusText = "Kommande";
                                statusBadgeClass = "bg-info";
                            }

                            // Check if multi-day
                            var hasValidEndDate = compEndDate.HasValue &&
                                                  compEndDate.Value > DateTime.MinValue &&
                                                  compEndDate.Value.Year > 1900 &&
                                                  compEndDate.Value.Date > compDate.Date;

                            <a href="@item.Url()" class="list-group-item list-group-item-action">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong class="d-block">@compName</strong>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @if (hasValidEndDate)
                                            {
                                                @compDate.ToString("d MMM", CultureInfo.GetCultureInfo("sv-SE"))
                                                <text> - </text>
                                                @compEndDate!.Value.ToString("d MMM", CultureInfo.GetCultureInfo("sv-SE"))
                                            }
                                            else
                                            {
                                                @compDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))
                                            }
                                        </small>
                                        @if (!string.IsNullOrEmpty(venue))
                                        {
                                            <small class="text-muted d-block">
                                                <i class="bi bi-geo-alt me-1"></i>@venue
                                            </small>
                                        }
                                    </div>
                                    <span class="badge @statusBadgeClass">@statusText</span>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
        }

        <!-- Contact Card -->
        @if (!string.IsNullOrEmpty(contactPerson) || !string.IsNullOrEmpty(contactEmail) || !string.IsNullOrEmpty(contactPhone))
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Kontakt</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(contactPerson))
                    {
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-person fs-4 text-primary me-3"></i>
                            <div>
                                <small class="text-muted d-block">Kontaktperson</small>
                                <span>@contactPerson</span>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(contactEmail))
                    {
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-envelope fs-4 text-primary me-3"></i>
                            <div>
                                <small class="text-muted d-block">E-post</small>
                                <a href="mailto:@contactEmail">@contactEmail</a>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(contactPhone))
                    {
                        <div class="d-flex align-items-center">
                            <i class="bi bi-telephone fs-4 text-primary me-3"></i>
                            <div>
                                <small class="text-muted d-block">Telefon</small>
                                <a href="tel:@contactPhone">@contactPhone</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Quick Links Card -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i>Snabblänkar</h5>
            </div>
            <div class="list-group list-group-flush">
                <a href="@clubsUrl" class="list-group-item list-group-item-action d-flex align-items-center">
                    <i class="bi bi-building me-3 text-primary"></i>
                    <div>
                        <strong>Klubbar</strong>
                        <small class="d-block text-muted">Hitta en klubb i @regionName</small>
                    </div>
                </a>
                @{
                    var rootPage = Model.Root();
                    var competitionsPage = rootPage?.Children.FirstOrDefault(x => x.ContentType.Alias == "competitionsHub");
                    var trainingPage = rootPage?.Children.FirstOrDefault(x => x.Url().Contains("skyttetrappan"));
                }
                @if (competitionsPage != null)
                {
                    <a href="@competitionsPage.Url()" class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="bi bi-trophy me-3 text-primary"></i>
                        <div>
                            <strong>Tävlingar</strong>
                            <small class="d-block text-muted">Se kommande tävlingar</small>
                        </div>
                    </a>
                }
                @if (trainingPage != null)
                {
                    <a href="@trainingPage.Url()" class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="bi bi-mortarboard me-3 text-primary"></i>
                        <div>
                            <strong>Träning</strong>
                            <small class="d-block text-muted">Skyttetrappan och mer</small>
                        </div>
                    </a>
                }
                @{
                    var recordsPage = Model.Children.FirstOrDefault(c => c.ContentType.Alias == "recordsPage");
                    var recordsUrl = recordsPage?.Url() ?? $"{Model.Url()}kretsrekord";
                }
                <a href="@recordsUrl" class="list-group-item list-group-item-action d-flex align-items-center">
                    <i class="bi bi-award me-3 text-primary"></i>
                    <div>
                        <strong>Kretsrekord</strong>
                        <small class="d-block text-muted">Rekord i @regionName</small>
                    </div>
                </a>
                <div id="regionQuickLinkDocuments"></div>
            </div>
        </div>
    </div>
</div>
