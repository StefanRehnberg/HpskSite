@* Klubbens/kretsens sidhuvud i de tre alternativa grunddesignerna (Utseende i Hemsidan). Standard ritas av ClubHeader/RegionalPage som förut.
   Innehållet kommer från ägaren (namn, text, logo, bild): allt kodas, utom TaglineHtml som redan är säkrad av RteHelper.SafeMarkup. *@
@model HpskSite.Services.SitePages.SiteHeaderModel
@{
    var m = Model;
    var hasTagline = !string.IsNullOrWhiteSpace(m.Tagline) || !string.IsNullOrWhiteSpace(m.TaglineHtml);
    var fill = HpskSite.Services.SitePages.SiteAppearance.HeaderFill(m.Palette);
}

<header class="site-head site-head--@m.Style" data-site-header="@m.Style">
    @if (m.Style == "banner-utan-logo")
    {
        if (!string.IsNullOrEmpty(m.BannerUrl))
        {
            <div class="site-head-banner" style="background-image: url('@m.BannerUrl');" role="img" aria-label="@m.Name"></div>
        }
        else
        {
            <div class="site-head-banner site-head-banner--fill" style="background: @Html.Raw(fill);" aria-hidden="true"></div>
        }
    }
    <div class="site-head-body">
        @if (!string.IsNullOrEmpty(m.LogoUrl))
        {
            <img src="@m.LogoUrl" alt="" class="site-head-logo">
        }
        else
        {
            <span class="site-head-logo site-head-logo--empty" aria-hidden="true"><i class="bi bi-shield-fill"></i></span>
        }
        <div class="site-head-text">
            <h1 class="site-head-name">@m.Name</h1>
            @if (!string.IsNullOrWhiteSpace(m.TaglineHtml))
            {
                <div class="site-head-tagline">@Html.Raw(m.TaglineHtml)</div>
            }
            else if (!string.IsNullOrWhiteSpace(m.Tagline))
            {
                <p class="site-head-tagline mb-0">@m.Tagline</p>
            }
        </div>
    </div>
</header>

<style>
.site-head { margin-bottom: 1.5rem; }
.site-head-body { display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem 1.5rem; border-radius: .5rem;
    background: var(--bs-primary-bg-subtle); color: var(--bs-body-color); border: 1px solid var(--bs-primary-border-subtle); }
.site-head-logo { width: 88px; height: 88px; object-fit: contain; flex: 0 0 auto; border-radius: .5rem; background: var(--bs-body-bg); padding: .25rem; }
.site-head-logo--empty { display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: var(--bs-primary); border: 1px solid var(--bs-primary-border-subtle); }
.site-head-name { margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--bs-primary-text-emphasis); overflow-wrap: anywhere; }
.site-head-tagline { margin: .25rem 0 0; color: var(--bs-body-color); }
.site-head-tagline > :last-child { margin-bottom: 0; }
.site-head--utan-banner-mitten .site-head-body { flex-direction: column; text-align: center; padding: 1.75rem 1.5rem; }
.site-head--utan-banner-mitten .site-head-logo { width: 104px; height: 104px; }
.site-head-banner { height: 220px; border-radius: .5rem .5rem 0 0; background-size: cover; background-position: center; }
.site-head-banner--fill { height: 120px; }
.site-head--banner-utan-logo .site-head-body { border-radius: 0 0 .5rem .5rem; border-top: 0; }
@@media (max-width: 575.98px) {
  .site-head-body { padding: 1rem; gap: .9rem; }
  .site-head-logo { width: 64px; height: 64px; }
  .site-head-name { font-size: 1.35rem; }
  .site-head-banner { height: 150px; }
  .site-head-banner--fill { height: 80px; }
}
</style>
