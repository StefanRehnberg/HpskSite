@model string
@{
    // Model = the field-id prefix. Pass "wizard_" or "edit_" to scope IDs.
    var prefix = (Model ?? "").ToString();
}
@*
 * Saved-configuration picker for the competition wizard + edit modal.
 * Replaces the legacy inline configurator launcher. Operator either picks an
 * existing saved configuration or sees a CTA to build one on /faltkonfig.
 *
 * The hidden input ${prefix}faltStationConfigJson still holds the resolved
 * JSON blob so all downstream serialization keeps working unchanged.
 *@
<div class="card mb-3 bg-body-tertiary" id="@(prefix)faltConfigPicker">
    <div class="card-body py-2">
        <label class="form-label small fw-bold mb-1"><i class="bi bi-gear me-1"></i>Stationskonfiguration</label>
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div class="flex-grow-1">
                <select class="form-select form-select-sm" id="@(prefix)faltConfigSelect" onchange="faltPickerSelectionChanged('@prefix')">
                    <option value="">Välj sparad konfiguration...</option>
                </select>
            </div>
            <button type="button" class="btn btn-primary btn-sm" id="@(prefix)faltConfigAttachBtn" onclick="faltPickerAttach('@prefix')" disabled>
                <i class="bi bi-link me-1"></i>Anslut
            </button>
            <a href="/faltkonfig" target="_blank" class="btn btn-outline-secondary btn-sm" title="Öppna konfiguratorn i ny flik">
                <i class="bi bi-box-arrow-up-right me-1"></i>Öppna konfiguratorn
            </a>
        </div>
        <div id="@(prefix)faltConfigStatus" class="mt-2 small">
            <span class="text-muted">Ingen konfiguration ansluten.</span>
        </div>
        <div class="form-text small mt-1">
            Konfigurationer byggs på <a href="/faltkonfig" target="_blank">/faltkonfig</a>.
            En ansluten konfiguration kopieras in i tävlingens stationsdata och kan inte ändras härifrån.
        </div>
        <input type="hidden" id="@(prefix)faltStationConfigJson" name="@(prefix == "" ? "stationConfig" : (prefix == "edit_" ? "stationConfig" : ""))" value="" />
        <input type="hidden" id="@(prefix)faltAttachedConfigId" value="" />
    </div>
</div>

<script>
// Idempotent — both wizard + edit-modal partials include this. Subsequent runs no-op.
(function() {
    if (window.faltPickerScriptLoaded) return;
    window.faltPickerScriptLoaded = true;

    window._faltPickerCache = null; // cached ListAccessible result

    // Updates the visual "Tävlingstyp" badge next to the hidden scoringMode
    // input on either the wizard (prefix='wizard_') or edit modal ('edit_').
    // Wired to the hidden input's onchange so picker-driven dispatchEvent('change')
    // updates the display. Should also be called explicitly after wizard reset
    // and edit-modal load (when the value is set without a change event).
    window.faltUpdateScoringModeDisplay = function(prefix) {
        var fld = document.getElementById(prefix + 'scoringMode');
        var dsp = document.getElementById(prefix + 'scoringMode_display');
        if (!fld || !dsp) return;
        var labels = { 'Normal': 'Normal', 'Poang': 'Poängfält' };
        var v = fld.value;
        if (labels[v]) {
            dsp.textContent = labels[v];
            dsp.className = 'badge bg-info text-dark fs-6';
        } else {
            dsp.textContent = '(ej satt)';
            dsp.className = 'badge bg-light text-muted fs-6 border';
        }
    };

    window.faltPickerLoadConfigs = async function(prefix, preserveSelection) {
        var sel = document.getElementById(prefix + 'faltConfigSelect');
        if (!sel) return;
        if (!window._faltPickerCache) {
            try {
                var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/ListAccessible');
                var data = await resp.json();
                if (!data.success) {
                    sel.innerHTML = '<option value="">' + (data.message || 'Kunde inte ladda') + '</option>';
                    return;
                }
                window._faltPickerCache = data.configurations || [];
            } catch (e) {
                sel.innerHTML = '<option value="">Nätverksfel</option>';
                return;
            }
        }
        var prev = preserveSelection ? sel.value : '';
        sel.innerHTML = '<option value="">Välj sparad konfiguration...</option>';
        // Sort Approved configs to the top — they're the safer pick for a competition.
        var sorted = window._faltPickerCache.slice().sort(function(a, b) {
            var sa = a.approvalStatus === 'Approved' ? 0 : 1;
            var sb = b.approvalStatus === 'Approved' ? 0 : 1;
            if (sa !== sb) return sa - sb;
            return (a.name || '').localeCompare(b.name || '', 'sv');
        });
        sorted.forEach(function(c) {
            var prefix2 = c.approvalStatus === 'Approved' ? '✓ ' : (c.approvalStatus === 'PendingApproval' ? '⏳ ' : '');
            var label = prefix2 + c.name + ' (' + c.stationCount + ' stationer, ' + c.ownerMemberName + ')';
            sel.innerHTML += '<option value="' + c.id + '">' + label.replace(/"/g, '&quot;') + '</option>';
        });
        if (prev) sel.value = prev;
        faltPickerSelectionChanged(prefix);
    };

    window.faltPickerSelectionChanged = function(prefix) {
        var sel = document.getElementById(prefix + 'faltConfigSelect');
        var btn = document.getElementById(prefix + 'faltConfigAttachBtn');
        if (!sel || !btn) return;
        btn.disabled = !sel.value;
    };

    window.faltPickerAttach = async function(prefix) {
        var sel = document.getElementById(prefix + 'faltConfigSelect');
        if (!sel || !sel.value) return;
        var configId = parseInt(sel.value);
        var cfg = (window._faltPickerCache || []).find(function(c) { return c.id === configId; });
        if (!cfg) return;
        if (!confirm('Anslut konfigurationen "' + cfg.name + '"?\n\nDe befintliga stationsdata för denna tävling skrivs över.')) return;

        try {
            var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/Get?id=' + configId);
            var data = await resp.json();
            if (!data.success) { alert('Kunde inte hämta konfigurationen: ' + (data.message || 'Fel')); return; }
            var fld = document.getElementById(prefix + 'faltStationConfigJson');
            var idFld = document.getElementById(prefix + 'faltAttachedConfigId');
            // Inject the attached-config-id into the JSON so the edit modal can
            // restore the selection next time without a separate doctype property.
            var jsonBlob = data.configuration.jsonBlob || '{}';
            try {
                var blobObj = JSON.parse(jsonBlob);
                if (typeof blobObj === 'object' && blobObj !== null) {
                    blobObj._attachedConfigId = configId;
                    jsonBlob = JSON.stringify(blobObj);
                }
            } catch (e) { /* malformed source — keep as-is */ }
            if (fld) fld.value = jsonBlob;
            if (idFld) idFld.value = configId;
            // Nyss ansluten, ännu inte sparad: statusraden ska då inte fråga servern om
            // tävlingens (gamla) kopia, utan säga att tävlingen behöver sparas.
            window._faltPickerAttachedNow = window._faltPickerAttachedNow || {};
            window._faltPickerAttachedNow[prefix] = true;
            // Auto-sync ${prefix}numberOfSeries to the attached config's station count.
            // Only the wizard exposes this field; the edit modal doesn't (numberOfSeries
            // there was set at competition creation and shouldn't shift on re-attach).
            var seriesFld = document.getElementById(prefix + 'numberOfSeries');
            if (seriesFld && cfg.stationCount) seriesFld.value = cfg.stationCount;
            // Propagate _scoringMode from the config into the wizard/edit scoringMode
            // dropdown so the competition picks it up on save. The config is the source
            // of truth; the dropdown becomes a derived display. (Phase 2 will hide it
            // entirely; for now it stays for legacy back-compat.)
            try {
                var blobForMode = JSON.parse(jsonBlob);
                var scoringMode = (blobForMode && blobForMode._scoringMode) || 'Normal';
                var smEl = document.getElementById(prefix + 'scoringMode');
                if (smEl) {
                    smEl.value = scoringMode;
                    smEl.dispatchEvent(new Event('change'));
                }
            } catch (e) { /* keep current dropdown value */ }
            faltPickerRenderStatus(prefix, cfg);
        } catch (e) {
            console.error(e);
            alert('Nätverksfel.');
        }
    };

    window.faltPickerRenderStatus = function(prefix, cfg) {
        var status = document.getElementById(prefix + 'faltConfigStatus');
        if (!status) return;
        if (!cfg) {
            var fld = document.getElementById(prefix + 'faltStationConfigJson');
            var hasInline = fld && fld.value && fld.value.length > 2;
            status.innerHTML = hasInline
                ? '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Inline-konfiguration</span> ' +
                  '<span class="text-muted">Den fungerar fortfarande, men kan inte delas. </span>' +
                  '<button type="button" class="btn btn-link btn-sm p-0 align-baseline" onclick="faltPickerConvertInline(\'' + prefix + '\')">' +
                    '<i class="bi bi-arrow-up-circle me-1"></i>Konvertera till sparad konfiguration' +
                  '</button>'
                : '<span class="text-muted">Ingen konfiguration ansluten.</span>';
            return;
        }
        var secretBadge = cfg.isSecret
            ? ' <span class="badge bg-warning text-dark" title="Hemlig fram till ' + cfg.secretUntil + '"><i class="bi bi-shield-lock me-1"></i>Hemlig</span>'
            : '';
        var approvalBadge = '';
        if (cfg.approvalStatus === 'Approved') {
            var aTitle = 'Godkänd' + (cfg.approvedByName ? ' av ' + cfg.approvedByName : '');
            approvalBadge = ' <span class="badge bg-success" title="' + aTitle.replace(/"/g, '&quot;') + '"><i class="bi bi-shield-check me-1"></i>Godkänd</span>';
        } else if (cfg.approvalStatus === 'PendingApproval') {
            approvalBadge = ' <span class="badge bg-warning text-dark" title="Väntar på godkännande"><i class="bi bi-hourglass-split me-1"></i>Väntar</span>';
        }
        var attachedNow = window._faltPickerAttachedNow && window._faltPickerAttachedNow[prefix];
        var compIdFld = document.getElementById(prefix + 'competitionId');
        var compId = compIdFld ? parseInt(compIdFld.value, 10) : 0;
        // ⚠️ Stationsantalet här är KONFIGURATIONENS. För en befintlig tävling ersätts det nedan
        // med tävlingens eget antal — tävlingen bär en kopia som inte följer med när
        // konfigurationen ändras (Michael, tävling 5450: "8 stationer" i tävlingen, "6" här).
        status.innerHTML = '<span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Ansluten</span> ' +
            '<strong>' + (cfg.name || '').replace(/</g, '&lt;') + '</strong>' + secretBadge + approvalBadge +
            ' &middot; <span class="text-muted" id="' + prefix + 'faltConfigCount">' + cfg.stationCount + ' stationer</span>' +
            ' &middot; <a href="/faltkonfig/' + cfg.id + '/redigera" target="_blank">Redigera konfigurationen <i class="bi bi-box-arrow-up-right"></i></a>' +
            '<div id="' + prefix + 'faltConfigStale"></div>';
        var staleEl = document.getElementById(prefix + 'faltConfigStale');
        if (attachedNow) {
            staleEl.innerHTML = '<div class="alert alert-info py-1 px-2 mt-2 mb-0 small">Spara tävlingen för att den ska använda konfigurationen.</div>';
            return;
        }
        if (!compId) return; // guiden — tävlingen finns inte än
        fetch('/umbraco/surface/Faltskytte/GetAttachedConfigState?competitionId=' + compId)
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d || !d.success || !d.attached || d.attachedConfigId !== cfg.id) return;
                var cnt = document.getElementById(prefix + 'faltConfigCount');
                if (cnt) cnt.textContent = 'tävlingen har ' + d.competitionStationCount + ' stationer';
                if (d.stale) {
                    var diff = d.configStationCount !== d.competitionStationCount
                        ? ' Tävlingen använder fortfarande ' + d.competitionStationCount + ' stationer, konfigurationen har nu ' + d.configStationCount + '.'
                        : ' Tävlingen använder fortfarande de gamla stationsuppgifterna.';
                    staleEl.innerHTML = '<div class="alert alert-warning py-1 px-2 mt-2 mb-0 small">' +
                        '<i class="bi bi-exclamation-triangle me-1"></i><strong>Konfigurationen har ändrats sedan den anslöts.</strong>' + diff +
                        ' Ändringar förs inte över automatiskt. Vill du använda dem: klicka <strong>Anslut</strong> och sedan <strong>Spara</strong>.</div>';
                }
            })
            .catch(function () { /* statusraden klarar sig utan */ });
    };

    // Convert the inline JSON on the current competition into a new saved
    // configuration. Doesn't touch the server-side competition record — the
    // operator still needs to click "Spara" on the edit modal afterwards so
    // the updated _attachedConfigId meta key lands in stationConfig.
    window.faltPickerConvertInline = async function(prefix) {
        var fld = document.getElementById(prefix + 'faltStationConfigJson');
        if (!fld || !fld.value || fld.value.length < 3) {
            alert('Det finns ingen inline-konfiguration att konvertera.');
            return;
        }
        var inlineJson = fld.value;

        var name = prompt('Namn på den nya konfigurationen:', '');
        if (!name) return;
        name = name.trim();
        if (!name) { alert('Namn krävs.'); return; }

        try {
            // Strip _attachedConfigId from the inline blob before creating — defensive
            // (shouldn't be set if we got here, but if it somehow is, we want a clean copy).
            // Also seed _scoringMode from the competition's existing scoringMode element
            // so the converted config keeps the Normal/Poang choice instead of defaulting
            // to Normal.
            var blob = JSON.parse(inlineJson);
            if (typeof blob === 'object' && blob !== null) {
                delete blob._attachedConfigId;
                var smEl = document.getElementById(prefix + 'scoringMode');
                if (smEl && smEl.value) blob._scoringMode = smEl.value;
                inlineJson = JSON.stringify(blob);
            }
        } catch (e) { /* keep as-is */ }

        try {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ name: name, visibility: 'Private', jsonBlob: inlineJson })
            });
            var data = await resp.json();
            if (!data.success) {
                alert('Kunde inte konvertera: ' + (data.message || 'Okänt fel'));
                return;
            }
            var newId = data.configurationId;

            // Embed _attachedConfigId in the live hidden field so subsequent loads
            // restore the picker selection. Force a cache invalidation so the
            // new config appears in the dropdown immediately.
            window._faltPickerCache = null;
            try {
                var blobObj = JSON.parse(fld.value);
                if (typeof blobObj === 'object' && blobObj !== null) {
                    blobObj._attachedConfigId = newId;
                    fld.value = JSON.stringify(blobObj);
                }
            } catch (e) { /* ignore */ }
            var idFld = document.getElementById(prefix + 'faltAttachedConfigId');
            if (idFld) idFld.value = newId;

            await faltPickerInit(prefix);
            alert('Konfigurationen "' + name + '" skapades. Glöm inte att spara tävlingen så att kopplingen behålls.');
        } catch (e) {
            console.error(e);
            alert('Nätverksfel.');
        }
    };

    // When the picker is rendered (on modal show), restore status if an id was preserved.
    window.faltPickerInit = async function(prefix) {
        if (window._faltPickerAttachedNow) window._faltPickerAttachedNow[prefix] = false;
        await faltPickerLoadConfigs(prefix, true);
        var idFld = document.getElementById(prefix + 'faltAttachedConfigId');
        var attachedId = idFld && idFld.value ? parseInt(idFld.value) : null;
        var cfg = attachedId && window._faltPickerCache
            ? window._faltPickerCache.find(function(c) { return c.id === attachedId; })
            : null;
        var sel = document.getElementById(prefix + 'faltConfigSelect');
        if (sel && attachedId) sel.value = String(attachedId);
        faltPickerSelectionChanged(prefix);
        faltPickerRenderStatus(prefix, cfg);
    };
})();
</script>
