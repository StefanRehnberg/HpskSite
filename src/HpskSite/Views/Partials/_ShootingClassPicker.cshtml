<script>
// Ägaren av väljaren. Sätts av den som öppnar den; guiden och redigeringen delar
// samma overlägg men skriver till OLIKA dolda fält.
//
// ⚠ Redigeringens fält MÅSTE heta `shootingClassIds` (utan prefix) — det är
// `name`-attributet som hamnar i FormData och därmed i payloaden till
// SaveCompetition. Att prefixa det hade tyst ändrat vad som sparas.
(function () {
    if (window.hpskOpenClassPicker) return;

    var owner = { hiddenId: 'wizard_shootingClassIds', cardPrefix: 'wizard_', type: '' };
    window.hpskClassPickerOwner = function () { return owner; };

    function byId(id) { return document.getElementById(id); }

    window.hpskOpenClassPicker = function (opts) {
        opts = opts || {};
        owner = {
            hiddenId: opts.hiddenId || 'wizard_shootingClassIds',
            cardPrefix: opts.cardPrefix || 'wizard_',
            type: opts.type || ''
        };
        var overlay = byId('classSelectionOverlay');
        if (!overlay) return;

        // ⚠ ÅTERSTÄLL FÖRE FILTRERA. Filtret skriver tillbaka "det som fortfarande är
        // ikryssat" till ägarens fält — körs det först är ingenting ikryssat än, och
        // då TÖMS fältet. Uppmätt: en tävling med tio klasser öppnade väljaren och
        // visade "Valda: 0 klasser", och hade sparats utan klasser.
        // Rätt ordning: kryssa i det som är sparat, låt sedan filtret rensa bort det
        // som den valda grenen inte har.
        hpskRestoreClassSelections();
        hpskFilterClassSections(owner.type);
        hpskUpdateOverlayClassCount();

        // Rubriken kommer fran guiden ("Steg 4: ..."), vilket ar fel ord i en
        // redigering. Agaren far satta den.
        var heading = overlay.querySelector('.wizard-overlay-header button');
        if (heading) {
            heading.innerHTML = '<i class="bi bi-arrow-left me-1"></i>' +
                (opts.title || 'Välj skytteklasser');
        }
        overlay.classList.add('active');
        document.addEventListener('keydown', hpskPickerEsc);
        overlay.addEventListener('click', hpskPickerBackdrop);
    };

    window.hpskCloseClassPicker = function () {
        var overlay = byId('classSelectionOverlay');
        if (!overlay) return;
        overlay.classList.remove('active');
        document.removeEventListener('keydown', hpskPickerEsc);
        overlay.removeEventListener('click', hpskPickerBackdrop);
    };

    function hpskPickerEsc(e) { if (e.key === 'Escape') window.hpskCloseClassPicker(); }
    function hpskPickerBackdrop(e) {
        if (e.target.id === 'classSelectionOverlay') window.hpskCloseClassPicker();
    }

    // Visar bara de sektioner som grenen faktiskt har. MagnumPrecision kor bara
    // M-klasser; Springskytte har inga av de har alls (den har vapen- och
    // aldersklasser i sitt eget block pa kortet).
    window.hpskFilterClassSections = function (typeId) {
        var allSections = ['A', 'B', 'C', 'R', 'L', 'M'];
        var allowed = (typeId === 'MagnumPrecision') ? ['M'] : allSections;
        allSections.forEach(function (s) {
            var el = byId('classSection_' + s);
            if (!el) return;
            var ok = allowed.indexOf(s) !== -1;
            el.style.display = ok ? '' : 'none';
            if (!ok) {
                el.querySelectorAll('.class-checkbox:checked').forEach(function (cb) { cb.checked = false; });
            }
        });

        // ⚠ Skriv TILLBAKA det som fortfarande ar ikryssat. Filtret kan ha bockat ur
        // klasser som inte finns i grenen, och utan den har raden skulle det dolda
        // faltet fortsatta bara dem — alltsa spara klasser som inte gar att valja.
        // Originalet i guiden gjorde detta mot sitt EGET falt; har gar det till agarens.
        var hidden = byId(owner.hiddenId);
        if (hidden) {
            var still = Array.prototype.slice
                .call(document.querySelectorAll('.class-checkbox:checked'))
                .map(function (cb) { return cb.value; });
            hidden.value = still.join(',');
        }
        window.hpskUpdateClassCard(owner.cardPrefix, owner.hiddenId);
        window.hpskUpdateOverlayClassCount();
    };

    window.hpskRestoreClassSelections = function () {
        var hidden = byId(owner.hiddenId);
        var current = hidden ? (hidden.value || '') : '';
        var selected = current ? current.split(',').map(function (s) { return s.trim(); }) : [];
        document.querySelectorAll('.class-checkbox').forEach(function (cb) {
            cb.checked = selected.indexOf(cb.value) !== -1;
        });
    };

    window.hpskConfirmClassSelection = function () {
        var selected = Array.prototype.slice
            .call(document.querySelectorAll('.class-checkbox:checked'))
            .map(function (cb) { return cb.value; });
        if (selected.length === 0) { alert('Välj minst en klass'); return; }
        var hidden = byId(owner.hiddenId);
        if (hidden) {
            hidden.value = selected.join(',');
            // Redigeringens egen kod lyssnar pa andringar i faltet.
            hidden.dispatchEvent(new Event('change', { bubbles: true }));
        }
        window.hpskUpdateClassCard(owner.cardPrefix, owner.hiddenId);
        window.hpskCloseClassPicker();
    };

    window.hpskUpdateClassCard = function (prefix, hiddenId) {
        var hidden = byId(hiddenId);
        var ids = hidden ? (hidden.value || '') : '';
        var arr = ids ? ids.split(',').filter(function (x) { return x.trim(); }) : [];
        var no = byId(prefix + 'noClassesText');
        var disp = byId(prefix + 'selectedClassesDisplay');
        var cnt = byId(prefix + 'classCount');
        var list = byId(prefix + 'classList');
        var btn = byId(prefix + 'selectClassesButtonText');
        if (!no || !disp) return;
        if (arr.length > 0) {
            no.style.display = 'none';
            disp.classList.remove('d-none');
            if (cnt) cnt.textContent = arr.length;
            if (list) list.textContent = arr.join(', ');
            if (btn) btn.textContent = 'Ändra val';
        } else {
            no.style.display = 'block';
            disp.classList.add('d-none');
            if (btn) btn.textContent = 'Välj skytteklasser';
        }
    };

    window.hpskUpdateOverlayClassCount = function () {
        var selected = document.querySelectorAll('.class-checkbox:checked');
        var count = selected.length;
        var el = byId('overlay_classCount');
        if (el) el.textContent = count;
        var listEl = byId('overlay_classList');
        if (listEl) {
            listEl.textContent = Array.prototype.slice.call(selected)
                .map(function (cb) { return cb.value; }).join(', ');
        }
        var btn = byId('overlay_btnConfirm');
        if (btn) btn.disabled = count === 0;
    };

    window.hpskToggleClassSection = function (section) {
        var el = byId('classSection_' + section);
        if (!el) return;
        var boxes = el.querySelectorAll('.class-checkbox');
        var allOn = Array.prototype.slice.call(boxes).every(function (cb) { return cb.checked; });
        boxes.forEach(function (cb) { cb.checked = !allOn; });
        window.hpskUpdateOverlayClassCount();
    };

    // ⚠ Guidens gamla funktionsnamn behalls som tunna omslag. Overlaggets markup ar
    // flyttad ORORD och dess onclick-attribut anropar dem — och guidens ovriga JS
    // gor det ocksa. Att doPa om markupen samtidigt hade gjort en redan stor
    // andring omojlig att A/B:a mot baseline.
    if (!window.closeClassSelectionOverlay) window.closeClassSelectionOverlay = window.hpskCloseClassPicker;
    if (!window.confirmClassSelection) window.confirmClassSelection = window.hpskConfirmClassSelection;
    if (!window.updateOverlayClassCount) window.updateOverlayClassCount = window.hpskUpdateOverlayClassCount;
    if (!window.toggleClassSection) window.toggleClassSection = window.hpskToggleClassSection;
    if (!window.restoreClassSelections) window.restoreClassSelections = window.hpskRestoreClassSelections;
})();
</script>
}
