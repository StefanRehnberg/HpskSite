@*
    Anmälningskortet för ett klubb- eller kretsevenemang (clubSimpleEvent — båda scopen delar
    doctype). Självständig partial: den bär sin egen antiforgery-token och sitt eget skript, så den
    kan monteras på vilken yta som helst utan att värdsidan behöver förberedas. Samma regel som
    _HtmlEscape och _MarkenSerieQuickSubmit.

    ViewData:
      EventId   (int, obligatorisk)  clubSimpleEvent-nodens id
      Accent    (string, valfri)     färg på kortets rubrikrad, för att följa evenemangstypen

    ⚠️ ALLT tillstånd kommer från servern (GetSignupState). Kortet räknar aldrig ut platser eller
    reservordning själv — den ordningen HÄRLEDS ur anmälningstiden i tjänsten, och en andra
    uträkning i JS vore fri att säga emot den.
*@
@{
    var signupEventId = ViewData["EventId"] as int? ?? 0;
    var signupAccent = ViewData["Accent"] as string ?? "";
}

@if (signupEventId > 0)
{
    <div class="card mb-4" id="ces-card" data-event-id="@signupEventId" style="display:none;">
        <div class="card-header @(string.IsNullOrEmpty(signupAccent) ? "bg-primary text-white" : "")"
             style="@(string.IsNullOrEmpty(signupAccent) ? "" : $"background-color:{signupAccent};color:#fff;")">
            <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Anmälan</h5>
        </div>
        <div class="card-body" id="ces-body">
            <div class="text-center py-2">
                <div class="spinner-border spinner-border-sm text-secondary" role="status"><span class="visually-hidden">Laddar...</span></div>
            </div>
        </div>
    </div>

    @Html.AntiForgeryToken()

    <script>
    (function () {
        if (window.cesLoaded) return;
        window.cesLoaded = true;

        const card = document.getElementById('ces-card');
        if (!card) return;
        const eventId = parseInt(card.dataset.eventId, 10);
        const body = document.getElementById('ces-body');

        const esc = s => {
            const d = document.createElement('div');
            d.textContent = s == null ? '' : String(s);
            return d.innerHTML;
        };
        const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        async function post(action, payload) {
            const r = await fetch('/umbraco/surface/ClubEvent/' + action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                body: JSON.stringify(payload)
            });
            // An empty 400 is the stale-antiforgery signature; say so rather than "det gick fel".
            const text = await r.text();
            if (!text) return { success: false, message: 'Sidan har varit öppen för länge — ladda om och försök igen.' };
            try { return JSON.parse(text); } catch { return { success: false, message: 'Oväntat svar från servern.' }; }
        }

        // ── Lånevapen ────────────────────────────────────────────────────────────────────────
        //
        // ⚠️ EN KRYSSRUTA PÅ ETT FORMULÄR SOM REDAN FYLLS I. För nybörjaren är anmälan och lånet
        // samma handling — skiljer vi dem åt får vi personer som är anmälda utan vapen och vapen
        // bokade av folk som inte kommer, vilket är precis det vapenansvarig inte kan lösa i valvet.
        //
        // ⚠️ FORMULÄRET MINNS. Har skytten lånat förut står hens vanliga nummer som förval. Den som
        // skjutit in nr 7 mot sig själv kommer inte om hen inte får just det — och övergången från
        // "vilket som helst" till "just mitt vapen" sker utan att någon bestämmer den, så en fråga
        // om vilket läge man är i vore den obesvarbara frågan igen i nya kläder.
        //
        // ⚠️ ANTALET VAPEN ÄR KLUBBENS SAK, INTE SKYTTENS. Frågan hen ställer är "kan jag låna ett
        // vapen?" — ett ja eller ett nej. "Klubben har 12 lånevapen · 3 lediga" är två siffror att
        // tolka i stället för svaret, och den som räknar fel räknar fel åt fel håll.
        const loanFree = lw => Math.max(0, (lw.loanable || 0) - (lw.occupied || 0));

        function weaponPicker(lw) {
            let h = '<label class="form-label small mb-1" for="ces-loan-firearm">Vilket vapen?</label>';
            h += '<select class="form-select form-select-sm" id="ces-loan-firearm">';
            // ⚠️ "Vilket som helst" FÖRST och som förval för den som aldrig lånat — en
            // nybörjare kan inte svara på frågan, och att kräva ett svar är en tröskel.
            h += '<option value="0">Vilket som helst</option>';
            (lw.weapons || []).forEach(w => {
                const sel = lw.usualFirearmId && w.id === lw.usualFirearmId ? ' selected' : '';
                const label = w.number ? `nr ${w.number}` : esc(w.alias);
                const suffix = lw.usualFirearmId && w.id === lw.usualFirearmId
                    ? ' — som förra gången' : '';
                h += `<option value="${w.id}"${sel}>${label}${suffix}</option>`;
            });
            h += '</select>';

            // ⚠️ Är det vanliga vapnet taget sägs det HÄR, vid bokningen — inte i valvet.
            // Det är nu skytten bestämmer om det är värt att komma.
            if (lw.usualNumber && lw.usualTaken) {
                h += `<div class="small text-warning-emphasis mt-1">`
                  +  `<i class="bi bi-exclamation-triangle me-1"></i>`
                  +  `Nr ${lw.usualNumber}, som du brukar få, är bokat den här dagen.</div>`;
            }
            return h;
        }

        function loanWeaponBlock(d) {
            const lw = d.loanWeapons;
            if (!lw || !lw.offered) return '';

            const kvar = loanFree(lw);
            let h = '<div class="border rounded p-2 mb-2">';
            h += '<div class="form-check mb-1">'
              +  '<input class="form-check-input" type="checkbox" id="ces-loan"'
              +  (kvar === 0 ? ' disabled' : '') + '>'
              +  '<label class="form-check-label fw-semibold" for="ces-loan">'
              +  'Jag behöver låna klubbvapen</label></div>';

            h += '<div class="small text-muted">'
              +  (kvar === 0
                    ? 'Klubbens lånevapen är slut den här dagen.'
                    : 'Det finns lånevapen att boka den här dagen.')
              +  '</div>';

            if (kvar > 0) {
                h += '<div class="mt-2 d-none" id="ces-loan-pick">' + weaponPicker(lw) + '</div>';
            }

            h += '</div>';
            return h;
        }

        // ⚠️ LÅNET MÅSTE SYNAS EFTER ANMÄLAN — I BÅDA LÄGENA. Kortet visade förut ingenting alls
        // för den som inte bokat, vilket läses som "jag bokade nog inget" av den som bokade och som
        // "det ordnar sig" av den som inte gjorde det. Båda kommer till banan utan vapen.
        //
        // Och beskedet måste gå att ÄNDRA: att man behöver låna inser man oftast efter att man
        // anmält sig. Utan knappen vore enda vägen att avboka hela anmälan och göra om den.
        function myLoanBlock(d) {
            const lw = d.loanWeapons;
            if (!lw || !lw.offered) return '';

            let h = '<div class="border rounded p-2 mb-2">';
            if (lw.myBookingId) {
                const nr = lw.myNumber || lw.myWishNumber;
                h += '<div class="small"><i class="bi bi-safe2 text-primary me-1"></i>'
                  +  (nr ? `Lånevapen <strong>nr ${nr}</strong> är reserverat åt dig.`
                         : 'Ett <strong>lånevapen</strong> är reserverat åt dig.')
                  +  '</div>';
                if (d.cancelOpen) {
                    h += '<button type="button" class="btn btn-sm btn-outline-secondary mt-2" id="ces-loan-drop">'
                      +  'Jag behöver inget lånevapen</button>';
                }
            } else {
                h += '<div class="small"><i class="bi bi-safe2 text-muted me-1"></i>'
                  +  'Du har <strong>inte</strong> bokat lånevapen.</div>';
                if (d.cancelOpen && loanFree(lw) > 0) {
                    h += '<div class="mt-2 d-none" id="ces-loan-add-pick">' + weaponPicker(lw)
                      +  '<button type="button" class="btn btn-sm btn-primary mt-2" id="ces-loan-add">'
                      +  'Boka lånevapen</button></div>';
                    h += '<button type="button" class="btn btn-sm btn-outline-primary mt-2" id="ces-loan-open">'
                      +  'Jag behöver låna klubbvapen</button>';
                } else if (loanFree(lw) === 0) {
                    h += '<div class="small text-muted mt-1">Klubbens lånevapen är slut den här dagen.</div>';
                }
            }
            h += '</div>';
            return h;
        }

        // ── Vapenansvarigs siffra ────────────────────────────────────────────────────────────
        //
        // ⚠️ RÄKNAS PÅ TILLFÄLLET, inte på dagen. Det är den här siffran någon plockar fram vapen
        // efter, och dagsfönstrets `occupied` svarar på en annan fråga (finns det plats kvar).
        function adminLoanBlock(d) {
            const lw = d.loanWeapons;
            if (!d.canManage || !lw || !lw.offered) return '';

            // ⚠️ "VET INTE" FÅR ALDRIG BLI EN NOLLA. Svarar servern utan `bookedForEvent` — den
            // är äldre än det här kortet — så sa `|| 0` "inga lånevapen bokade än" på ett
            // tillfälle som hade ett, och den enda som kunde märka det var den som råkade öppna
            // valvet. En siffra som saknas ska synas som saknad, inte som ett besked.
            const n = typeof lw.bookedForEvent === 'number' ? lw.bookedForEvent : null;

            let h = '<div class="border rounded p-2 mb-3 bg-body-tertiary">';
            h += '<div class="small fw-semibold mb-1"><i class="bi bi-safe2 me-1"></i>Lånevapen till det här tillfället</div>';
            h += n === null
                ? '<div class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>'
                  + 'Antalet kunde inte läsas — öppna valvet för att se vad som är bokat.</div>'
                : n === 0
                    ? '<div class="small text-muted">Inga lånevapen bokade än.</div>'
                    : `<div class="small"><strong>${n}</strong> lånevapen ska plockas fram.</div>`;

            if ((lw.bookings || []).length) {
                h += '<ul class="small mb-0 mt-1 ps-3">';
                lw.bookings.forEach(b => {
                    h += `<li>${esc(b.memberName || 'Okänd medlem')} — `
                      +  (b.number ? `nr ${b.number}` : 'vilket som helst')
                      +  (b.statusLabel ? ` <span class="text-muted">(${esc(b.statusLabel)})</span>` : '')
                      +  '</li>';
                });
                h += '</ul>';
            }
            if (lw.clubId) {
                h += `<div class="small mt-2"><a href="/valvet?club=${lw.clubId}" target="_blank" rel="noopener">`
                  +  'Öppna valvet</a></div>';
            }
            h += '</div>';
            return h;
        }

        // ── Sista anmälningsdag ──────────────────────────────────────────────────────────────
        //
        // ⚠️ DAGEN RÄKNAS MED, och det måste stå i klartext. "Sista anmälningsdag 20 september"
        // lästes annars som "stängd den 20:e" av hälften och "öppen till den 21:a" av resten —
        // och servern har bara ett svar (IsSignupOpen). Texten säger samma sak som grinden.
        //
        // Datumet parsas BOKSTAVLIGT ur strängen. new Date('2026-09-20') tolkas som UTC och
        // skrivs ut i lokal tid, vilket flyttar dagen ett steg för den som sitter i sommartid.
        function deadlineDate(s) {
            const m = s ? String(s).match(/^(\d{4})-(\d{2})-(\d{2})/) : null;
            return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
        }
        function deadlineText(d) {
            const dl = deadlineDate(d.event.registrationDeadline);
            if (!dl) return '';
            return dl.toLocaleDateString('sv-SE', { day: 'numeric', month: 'long' });
        }

        function kr(v) { return new Intl.NumberFormat('sv-SE').format(v) + ' kr'; }

        // Prisvalet infor anmalan.
        //
        // ETT pris visas som en upplysning, inte som ett val - det finns inget att valja mellan,
        // och en radioknapp med ett enda alternativ ar en fraga utan innehall.
        // FLERA priser ar ett riktigt val, och INGET ar forvalt: forvaljer vi det billigaste
        // anmaler sig halva klubben som barn av bara farten, och forvaljer vi det dyraste
        // debiterar vi den som inte lasteade. Servern vagrar anmalan utan val.
        function priceBlock(d) {
            const p = d.event.prices || [];
            if (d.event.pricesUnreadable) {
                return '<div class="alert alert-danger py-2 px-3 mb-2 small">'
                     + '<i class="bi bi-exclamation-triangle me-1"></i>Evenemangets priser gar inte att lasa. '
                     + 'Kontakta arrangoren.</div>';
            }
            if (!p.length) return '';
            if (p.length === 1) {
                return '<div class="mb-2 small"><span class="text-muted">Avgift:</span> '
                     + `<strong>${p[0].amount === 0 ? 'Gratis' : kr(p[0].amount)}</strong></div>`;
            }
            let h = '<div class="mb-2"><div class="form-label small text-muted mb-1">Vilket pris galler for dig?</div>';
            p.forEach((row, i) => {
                const id = 'ces-price-' + i;
                h += '<div class="form-check">'
                  +  `<input class="form-check-input" type="radio" name="ces-price" id="${id}" value="${esc(row.id)}">`
                  +  `<label class="form-check-label" for="${id}">`
                  +  `<strong>${row.amount === 0 ? 'Gratis' : kr(row.amount)}</strong> `
                  +  `<span class="text-muted">${esc(row.label)}</span></label></div>`;
            });
            return h + '</div>';
        }

        // Priskarta for gastformularet. Samma rader som medlemmens val, samma regel: ett enda pris
        // ar en upplysning, flera ar ett riktigt val och INGET ar forvalt.
        function guestPriceField(d) {
            const p = d.event.prices || [];
            if (d.event.pricesUnreadable || !p.length) return '';
            if (p.length === 1) {
                return '<div class="small text-muted mb-2">Avgift: '
                     + `<strong>${p[0].amount === 0 ? 'Gratis' : kr(p[0].amount)}</strong></div>`;
            }
            let h = '<select class="form-select form-select-sm mb-2" id="ces-guest-price">'
                  + '<option value="">Valj pris for gasten...</option>';
            p.forEach(row => {
                h += `<option value="${esc(row.id)}">${esc(row.label)} — `
                  +  `${row.amount === 0 ? 'Gratis' : kr(row.amount)}</option>`;
            });
            return h + '</select>';
        }

        // Sallskapet: de hen tagit med, och vad alltihop kostar.
        //
        // ⚠️ Totalen ar summan av radernas SNAPSHOTS, given av servern. Rakna aldrig om den mot
        // d.event.prices har - hojer arrangoren priset efterat skulle kortet visa en annan siffra
        // an den medlemmen sa ja till, och det ar den siffran hen sedan faktureras efter.
        function partyBlock(d) {
            const party = d.party;
            if (!party) return '';

            let h = '';
            if (party.guests.length) {
                h += '<div class="border rounded p-2 mb-2">'
                  +  `<div class="small text-muted mb-1">Du har med dig ${party.guests.length} `
                  +  `${party.guests.length === 1 ? 'person' : 'personer'}</div>`;
                party.guests.forEach(g => {
                    h += '<div class="d-flex align-items-center justify-content-between border-top py-1">'
                      +  `<div><span>${esc(g.name)}</span>`
                      +  (g.isReserve ? ' <span class="badge bg-warning text-dark">reserv</span>' : '')
                      +  (g.feeLabel ? ` <span class="text-muted small">${esc(g.feeLabel)}</span>` : '')
                      +  '</div>'
                      +  '<div class="d-flex align-items-center gap-2">'
                      +  (g.feeAmount === null || g.feeAmount === undefined
                            ? ''
                            : `<span class="small">${g.feeAmount === 0 ? 'Gratis' : kr(g.feeAmount)}</span>`)
                      +  `<button type="button" class="btn btn-sm btn-link text-danger p-0 ces-guest-drop" `
                      +  `data-id="${g.id}" title="Avanmal ${esc(g.name)}">Ta bort</button>`
                      +  '</div></div>';
                });

                // ⚠️ Totalen visas bara nar den ar HELA sanningen. Saknar nagon i sallskapet belopp
                // pa ett evenemang som tar avgift vore en summa ett besked som ser fardigt ut och
                // inte ar det - och det ar pengar.
                if (party.missingPrice) {
                    h += '<div class="border-top pt-1 mt-1 small text-warning-emphasis">'
                      +  '<i class="bi bi-exclamation-triangle me-1"></i>Nagon i sallskapet saknar pris. '
                      +  'Kontakta arrangoren.</div>';
                } else {
                    h += '<div class="border-top pt-1 mt-1 d-flex justify-content-between fw-semibold small">'
                      +  `<span>Totalt for ${party.people} personer</span>`
                      +  `<span>${party.total === 0 ? 'Gratis' : kr(party.total)}</span></div>`;
                }
                h += '</div>';
            }

            if (!d.signupOpen) return h;

            if (party.guests.length >= party.maxGuests) {
                return h + `<div class="small text-muted mb-2">Du har natt taket pa ${party.maxGuests} gaster. `
                         + 'Kontakta arrangoren om ni ar fler.</div>';
            }

            h += '<div class="mb-2">'
              +  '<button type="button" class="btn btn-sm btn-outline-secondary w-100" id="ces-guest-open">'
              +  '<i class="bi bi-person-plus me-1"></i>Anmal en till</button>'
              +  '<div class="d-none mt-2" id="ces-guest-form">'
              +  '<label for="ces-guest-name" class="form-label small text-muted mb-1">'
              +  'Namn pa den du tar med</label>'
              +  `<input type="text" class="form-control form-control-sm mb-2" id="ces-guest-name" maxlength="80" `
              +  'placeholder="For- och efternamn">'
              +  guestPriceField(d)
              +  '<button type="button" class="btn btn-sm btn-primary w-100" id="ces-guest-add">Anmal</button>'
              +  '<div class="form-text">Familj och gaster behover inget konto — du star for anmalan.</div>'
              +  '</div></div>';
            return h;
        }

        function render(d) {
            // The card only exists for events that actually take sign-ups. An event with an
            // external registration link keeps that link (the page renders it separately) — we must
            // not offer a second, competing place to sign up.
            if (!d.success || !d.event.registrationRequired || d.event.registrationUrl) {
                card.style.display = 'none';
                return;
            }
            card.style.display = '';

            let html = '';

            if (d.event.isMandatory) {
                html += '<div class="alert alert-warning py-2 px-3 small mb-3">'
                     +  '<i class="bi bi-exclamation-triangle me-1"></i>'
                     +  '<strong>Obligatoriskt för klubbens medlemmar.</strong> Närvaron registreras av klubben.'
                     +  '</div>';
            }

            // Counts. Shown to everyone who can see the event — that is what tells a besökare
            // whether there is room, without publishing who is going.
            const c = d.counts;
            html += '<div class="mb-3">';
            html += `<div class="fs-4 fw-semibold">${c.signedUp} anmälda</div>`;
            if (d.event.maxParticipants > 0) {
                const left = c.seatsLeft;
                html += `<div class="small text-muted">${d.event.maxParticipants} platser`
                     +  (left > 0 ? ` · ${left} kvar` : ' · <span class="text-warning-emphasis">fullt, nya anmälningar blir reserver</span>')
                     +  (c.reserves > 0 ? ` · ${c.reserves} reserv${c.reserves === 1 ? '' : 'er'}` : '')
                     +  '</div>';
            }
            if (d.event.fee) {
                html += `<div class="small text-muted mt-1"><i class="bi bi-wallet2 me-1"></i>Avgift ${esc(d.event.fee)} kr</div>`;
            }
            const dlText = deadlineText(d);
            if (dlText) {
                html += `<div class="small ${d.signupOpen ? 'text-muted' : 'text-danger-emphasis'} mt-1">`
                     +  '<i class="bi bi-hourglass-split me-1"></i>'
                     +  (d.signupOpen
                            ? `Anmälan är öppen till och med <strong>${dlText}</strong>.`
                            : `Sista anmälningsdag var <strong>${dlText}</strong>.`)
                     +  '</div>';
            }
            html += '</div>';

            html += adminLoanBlock(d);

            if (!d.loggedIn) {
                const back = encodeURIComponent(window.location.pathname + window.location.search);
                html += `<a class="btn btn-primary w-100" href="/login-register/?returnUrl=${back}">Logga in för att anmäla dig</a>`;
            } else if (!d.eligible) {
                html += '<div class="alert alert-light border small mb-0">'
                     +  (d.event.isRegion
                            ? 'Anmälan är öppen för medlemmar i kretsens klubbar.'
                            : `Anmälan är öppen för medlemmar i ${esc(d.event.ownerName)}.`)
                     +  '</div>';
            } else if (d.me && d.me.signedUp) {
                html += '<div class="alert ' + (d.me.isReserve ? 'alert-warning' : 'alert-success') + ' py-2 px-3 mb-2">'
                     +  (d.me.isReserve
                            ? '<i class="bi bi-hourglass-split me-1"></i>Du står som <strong>reserv</strong>. Blir en plats ledig flyttas du upp automatiskt.'
                            : '<i class="bi bi-check-circle me-1"></i>Du är <strong>anmäld</strong>.')
                     +  '</div>';
                if (d.me.feeAmount !== null && d.me.feeAmount !== undefined) {
                    // Vad hen valde och vad det kostade DA. Hojs priset efterat star medlemmen kvar
                    // pa sitt belopp - snapshotten ar overenskommelsen, inte dagens prislista.
                    html += '<div class="small mb-2"><span class="text-muted">Ditt pris:</span> '
                         +  `<strong>${d.me.feeAmount === 0 ? 'Gratis' : kr(d.me.feeAmount)}</strong>`
                         +  (d.me.feeLabel ? ` <span class="text-muted">${esc(d.me.feeLabel)}</span>` : '')
                         +  '</div>';
                }
                if (d.me.note) html += `<div class="small text-muted mb-2">Din notering: ${esc(d.me.note)}</div>`;
                // Sallskapet star DIREKT under det egna priset: "du betalar 180" och "ni ar tre och
                // det blir 450" hor ihop, och ett block langre ner hade last som en annan sak.
                html += partyBlock(d);
                html += myLoanBlock(d);
                // ⚠️ Knappen följer `cancelOpen`, INTE `signupOpen`. Efter sista anmälningsdag är
                // anmälan stängd men avbokningen öppen till evenemangsdagens slut — den som inte
                // kan komma måste kunna säga det, annars står hen kvar som väntad på listan.
                html += d.cancelOpen
                    ? '<button type="button" class="btn btn-outline-danger w-100" id="ces-cancel">Avboka min anmälan</button>'
                    : '<div class="small text-muted">Anmälan är stängd — kontakta arrangören om du inte kan komma.</div>';
            } else if (!d.signupOpen) {
                html += '<div class="alert alert-light border small mb-0">Anmälan är stängd.</div>';
            } else {
                html += priceBlock(d);
                html += loanWeaponBlock(d);
                html += '<div class="mb-2"><label for="ces-note" class="form-label small text-muted mb-1">Meddelande till arrangören (valfritt)</label>'
                     +  '<textarea class="form-control form-control-sm" id="ces-note" rows="2" maxlength="500"></textarea></div>';
                const full = d.event.maxParticipants > 0 && c.seatsLeft === 0;
                html += `<button type="button" class="btn btn-primary w-100" id="ces-signup">`
                     +  (full ? 'Ställ mig som reserv' : 'Anmäl mig')
                     +  '</button>';
            }

            // The roster is the club's own business: shown to the owning club's members and to
            // functionaries, never to a passer-by.
            if (d.roster && d.roster.length) {
                const seats = d.roster.filter(r => !r.isReserve);
                const res = d.roster.filter(r => r.isReserve);
                // ⚠️ Gästen märks ut. Ett namn utan konto bland medlemsnamnen ser ut som en medlem
                // vi inte hittar, och funktionären som letar efter hen i medlemsregistret letar
                // förgäves. Märket säger att det är meningen.
                const namn = r => esc(r.name)
                    + (r.isGuest ? ' <span class="badge bg-light text-muted border">gäst</span>' : '');
                html += '<hr><div class="small fw-semibold mb-1">Anmälda</div><ol class="small mb-0 ps-3">';
                seats.forEach(r => { html += `<li>${namn(r)}</li>`; });
                html += '</ol>';
                if (res.length) {
                    html += '<div class="small fw-semibold mt-2 mb-1">Reserver</div><ol class="small mb-0 ps-3">';
                    res.forEach(r => { html += `<li>${namn(r)}</li>`; });
                    html += '</ol>';
                }
            }

            body.innerHTML = html;

            const signupBtn = document.getElementById('ces-signup');
            // Väljaren visas bara när krysset är satt — annars är den en fråga till någon som
            // inte sagt att hen vill låna.
            const loanChk = document.getElementById('ces-loan');
            const loanPick = document.getElementById('ces-loan-pick');
            if (loanChk && loanPick) {
                loanChk.addEventListener('change',
                    () => loanPick.classList.toggle('d-none', !loanChk.checked));
            }

            if (signupBtn) signupBtn.addEventListener('click', () => act(signupBtn, 'SignUp', {
                eventId,
                note: document.getElementById('ces-note')?.value || '',
                loanWeapon: !!(loanChk && loanChk.checked),
                loanFirearmId: parseInt(document.getElementById('ces-loan-firearm')?.value || '0', 10),
                // Tomt nar evenemanget saknar avgift eller bara har ett pris - servern avgor,
                // och vagrar om ett val kravs men saknas. Klienten forvaljer aldrig at medlemmen.
                priceId: document.querySelector('input[name="ces-price"]:checked')?.value || '',
            }));

            // Lånevapen ändrat i efterhand: väljaren visas först när skytten sagt att hen vill låna.
            const loanOpen = document.getElementById('ces-loan-open');
            const loanAddPick = document.getElementById('ces-loan-add-pick');
            if (loanOpen && loanAddPick) {
                loanOpen.addEventListener('click', () => {
                    loanAddPick.classList.remove('d-none');
                    loanOpen.classList.add('d-none');
                });
            }

            const loanAdd = document.getElementById('ces-loan-add');
            if (loanAdd) loanAdd.addEventListener('click', () => act(loanAdd, 'SetLoanWeapon', {
                eventId,
                loanWeapon: true,
                loanFirearmId: parseInt(document.getElementById('ces-loan-firearm')?.value || '0', 10),
            }));

            const loanDrop = document.getElementById('ces-loan-drop');
            if (loanDrop) loanDrop.addEventListener('click', () =>
                act(loanDrop, 'SetLoanWeapon', { eventId, loanWeapon: false, loanFirearmId: 0 }));

            const cancelBtn = document.getElementById('ces-cancel');
            if (cancelBtn) cancelBtn.addEventListener('click', () => {
                // ⚠️ FRÅGAN MÅSTE NÄMNA SÄLLSKAPET. Avbokningen tar med sig gästerna, och "vill du
                // avboka din anmälan?" är inte den fråga som ställs när svaret också avanmäler
                // frun och sonen. Den som inte visste det upptäcker det på plats.
                const n = (d.party && d.party.guests.length) || 0;
                const fraga = n === 0
                    ? 'Vill du avboka din anmälan?'
                    : `Vill du avboka din anmälan? ${n === 1 ? 'Din gäst' : `Dina ${n} gäster`} avanmäls samtidigt.`;
                if (!confirm(fraga)) return;
                act(cancelBtn, 'Cancel', { eventId });
            });

            // ── Gäster ───────────────────────────────────────────────────────────────────────
            const guestOpen = document.getElementById('ces-guest-open');
            const guestForm = document.getElementById('ces-guest-form');
            if (guestOpen && guestForm) guestOpen.addEventListener('click', () => {
                guestForm.classList.toggle('d-none');
                if (!guestForm.classList.contains('d-none')) document.getElementById('ces-guest-name')?.focus();
            });

            const guestAdd = document.getElementById('ces-guest-add');
            if (guestAdd) guestAdd.addEventListener('click', () => act(guestAdd, 'AddGuest', {
                eventId,
                name: document.getElementById('ces-guest-name')?.value || '',
                priceId: document.getElementById('ces-guest-price')?.value || ''
            }));

            document.querySelectorAll('.ces-guest-drop').forEach(btn => {
                btn.addEventListener('click', () => {
                    // Namnet står i frågan: "ta bort gästen?" på en lista med tre är ingen fråga.
                    const namn = btn.getAttribute('title')?.replace(/^Avanmal\s+/, '') || 'gästen';
                    if (!confirm(`Vill du avanmäla ${namn}?`)) return;
                    act(btn, 'CancelGuest', { eventId, participantId: parseInt(btn.dataset.id, 10) });
                });
            });
        }

        // Pending state on the button itself. The lesson from the scorepad SAVE button: a request
        // with no visible pending state gets pressed again, and every press queues another action.
        async function act(btn, action, payload) {
            const label = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = 'Skickar…';
            const d = await post(action, payload);
            if (!d.success) {
                btn.disabled = false;
                btn.innerHTML = label;
                body.insertAdjacentHTML('afterbegin',
                    `<div class="alert alert-danger py-2 px-3 small">${esc(d.message || 'Något gick fel.')}</div>`);
                return;
            }
            await load();

            // ⚠️ LÅNEMEDDELANDET MÅSTE ÖVERLEVA OMLADDNINGEN. Anmälan kan lyckas medan vapnet
            // INTE gick att boka — och rullas anmälan inte tillbaka (den ska inte) är det här
            // enda stället skytten får veta det. Utan raden tror hen att hon har ett vapen.
            if (d.loanMessage) {
                const bad = d.loanMessage.indexOf('\u26a0') === 0;
                body.insertAdjacentHTML('afterbegin',
                    `<div class="alert ${bad ? 'alert-warning' : 'alert-success'} py-2 px-3 small">`
                    + esc(d.loanMessage) + '</div>');
            }
        }

        async function load() {
            try {
                const r = await fetch(`/umbraco/surface/ClubEvent/GetSignupState?eventId=${eventId}`, { cache: 'no-store' });
                render(await r.json());
            } catch {
                card.style.display = 'none';
            }
        }

        load();
    })();
    </script>
}
