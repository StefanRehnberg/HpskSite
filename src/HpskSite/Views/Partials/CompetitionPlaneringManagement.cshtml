@{
    // Planering tab host (Tävlingsplanering). Two planning axes over one shared people layer, plus the
    // day-of live view, on a pill switcher (default = Förberedelser, the earliest work in the timeline):
    //   • Förberedelser — the preparation work-breakdown (WorkArea/WorkItem). Independent of start lists.
    //   • Bemanning     — the day-of functionary roster (StaffAssignment). Always available, no start list needed.
    //   • Funktionärer  — the live functionary-load view + tävlingsledning message console (shipped).
    // See Documentation/COMPETITION_STAFFING_SYSTEM.md.
    var competitionId = ViewData["CompetitionId"];
    var discipline = ViewData["Discipline"]?.ToString() ?? "Precision";

    // Build child ViewData via the indexer (NOT the collection initializer): our own ViewData already
    // carries CompetitionId/Discipline from the parent, so an Add() would throw a duplicate-key error.
    var childVd = new ViewDataDictionary(ViewData);
    childVd["CompetitionId"] = competitionId;
    childVd["Discipline"] = discipline;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <span class="fw-bold fs-5"><i class="bi bi-clipboard-check me-1"></i>Planering</span>
</div>

<ul class="nav nav-pills mb-3 flex-wrap gap-1" id="planeringPills" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="plan-forberedelser-tab" data-bs-toggle="pill" data-bs-target="#plan-forberedelser" type="button" role="tab">
            <i class="bi bi-list-check me-1"></i>Förberedelser
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="plan-bemanning-tab" data-bs-toggle="pill" data-bs-target="#plan-bemanning" type="button" role="tab">
            <i class="bi bi-person-badge me-1"></i>Bemanning
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="plan-funktionarer-tab" data-bs-toggle="pill" data-bs-target="#plan-funktionarer" type="button" role="tab">
            <i class="bi bi-broadcast me-1"></i>Funktionärer
        </button>
    </li>
</ul>

<div class="tab-content" id="planeringPillContent">
    <div class="tab-pane fade show active" id="plan-forberedelser" role="tabpanel">
        @await Html.PartialAsync("_WorkBreakdown", childVd)
    </div>
    <div class="tab-pane fade" id="plan-bemanning" role="tabpanel">
        @await Html.PartialAsync("_StaffingRoster", childVd)
    </div>
    <div class="tab-pane fade" id="plan-funktionarer" role="tabpanel">
        @if (discipline == "Springskytte")
        {
            @await Html.PartialAsync("SpringskytteFunktionarerManagement", childVd)
        }
        else
        {
            @await Html.PartialAsync("PrecisionFunktionarerManagement", childVd)
        }
    </div>
</div>
