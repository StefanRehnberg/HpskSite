@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Dagsprogram — the competition's day programme (CompetitionAgendaItem).
    //
    // Start lists answer "when do I shoot" and the Bemanning roster answers "when do I work". This tab
    // is for everything else on the day — anmälan öppnar, upprop, lunch, prisutdelning — so a member's
    // personal itinerary on /mitt-schema reads like a programme instead of a sparse list.
    //
    // Audience per row matters: a "Städning och avrigg" line is noise for a shooter, and "Prisutdelning"
    // is not. Rows marked Endast funktionärer only reach people with an uppdrag; Endast skyttar only
    // reach registered participants.
    var competitionId = ViewData["CompetitionId"];
    var agToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var agPrintUrl = (ViewData["PlanningId"] as int? ?? 0) > 0
        ? $"/tavlingsplanering/blad?p={ViewData["PlanningId"]}&vy=dagsprogram"
        : $"/tavlingsplanering/blad?c={competitionId}&vy=dagsprogram";
}

<p class="text-muted small mb-3" style="max-width:760px">
    <i class="bi bi-signpost-2 me-1"></i>
    <strong>Så gör du:</strong> lägg in dagens hållpunkter här. De hamnar i skyttarnas och funktionärernas
    personliga schema (<em>Mitt schema</em>) tillsammans med deras starttider och pass — så alla ser samma
    program. Har du en typisk tävlingsdag kan du under <strong>Åtgärder</strong> välja punkter ur en färdig mall.
</p>

<div id="agList">
    <div class="text-muted py-4"><div class="spinner-border spinner-border-sm"></div> Laddar…</div>
</div>

<!-- Add/edit modal -->
<div class="modal fade" id="agItemModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="agModalTitle">Lägg till punkt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="agItemId" value="0">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="agTitle">Vad händer?</label>
                    <input type="text" class="form-control" id="agTitle" maxlength="200" placeholder="T.ex. Prisutdelning">
                </div>
                <div class="row g-2">
                    <div class="col-sm-4 mb-3">
                        <label class="form-label fw-semibold" for="agDate">Dag</label>
                        @* Fed from StaffDay — the SAME day list the Bemanning grid uses, so the programme
                           and the crew plan can never disagree about which days the event has. *@
                        <select class="form-select" id="agDate">
                            <option value="">Tävlingsdagen</option>
                        </select>
                        <div class="form-text">Dagarna kommer från planen. Lägg till fler under Bemanning.</div>
                    </div>
                    <div class="col-sm-4 mb-3">
                        <label class="form-label fw-semibold" for="agStart">Från</label>
                        <input type="text" class="form-control" id="agStart" placeholder="Ingen tid">
                    </div>
                    <div class="col-sm-4 mb-3">
                        <label class="form-label fw-semibold" for="agEnd">Till</label>
                        <input type="text" class="form-control" id="agEnd" placeholder="Valfritt">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="agAudience">Vem ska se punkten?</label>
                    <select class="form-select" id="agAudience">
                        <option value="All">Alla</option>
                        <option value="Shooters">Endast skyttar</option>
                        <option value="Staff">Endast funktionärer</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="agLocation">Var? (valfritt)</label>
                    <input type="text" class="form-control" id="agLocation" maxlength="200" placeholder="T.ex. Klubbstugan">
                </div>
                <div class="mb-1">
                    <label class="form-label fw-semibold" for="agNote">Kommentar (valfritt)</label>
                    <input type="text" class="form-control" id="agNote" maxlength="500">
                </div>
                <div class="text-danger small mt-2" id="agError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="agSave()">Spara</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const AG_COMP = @competitionId;
    const AG_TOKEN = '@agToken';
    let agModal = null;
    let agCompDate = null;

    function esc(s) {
        return (s == null ? '' : String(s))
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    function timeLabel(it) {
        if (!it.startTime) return 'Under dagen';
        return it.endTime ? (it.startTime + '–' + it.endTime) : it.startTime;
    }

    function audienceBadge(it) {
        if (it.audience === 'Staff') return '<span class="badge bg-success-subtle text-success-emphasis border ms-1">Funktionärer</span>';
        if (it.audience === 'Shooters') return '<span class="badge bg-primary-subtle text-primary-emphasis border ms-1">Skyttar</span>';
        return '';
    }

    function render(items) {
        const wrap = document.getElementById('agList');
        if (!items.length) {
            wrap.innerHTML = '<div class="alert alert-light border mb-0">' +
                'Inget dagsprogram än. Skyttarnas schema visar då bara deras starttider och pass. Under Åtgärder kan du lägga till punkter ur en mall.' +
                '</div>';
            return;
        }

        // Group by day so multi-day competitions read correctly.
        const byDay = {};
        items.forEach(it => {
            const k = it.itemDate || '';
            (byDay[k] = byDay[k] || []).push(it);
        });

        let html = '';
        Object.keys(byDay).sort().forEach(day => {
            const di = dayInfo(day);
            const heading = day
                ? new Date(day + 'T00:00:00').toLocaleDateString('sv-SE', { weekday: 'long', day: 'numeric', month: 'long' })
                : 'Tävlingsdagen';
            html += '<div class="fw-semibold text-muted small text-uppercase mt-3 mb-1">' + esc(heading)
                + (di && di.label ? ' <span class="text-body">· ' + esc(di.label) + '</span>' : '')
                + (di && !di.isParticipantFacing
                    ? ' <span class="badge bg-secondary-subtle text-secondary-emphasis border fw-normal text-lowercase">'
                      + esc(di.kindLabel) + ' — syns bara för funktionärer</span>' : '')
                + '</div>';
            html += '<div class="list-group list-group-flush">';
            byDay[day].forEach(it => {
                html += '<div class="list-group-item px-0 d-flex gap-3 align-items-start">' +
                    '<span class="fw-semibold text-nowrap" style="min-width:6.5rem;">' + esc(timeLabel(it)) + '</span>' +
                    '<span class="flex-grow-1">' +
                        '<span class="fw-semibold">' + esc(it.title) + '</span>' + audienceBadge(it) +
                        (it.location ? '<span class="text-muted small d-block">' + esc(it.location) + '</span>' : '') +
                        (it.note ? '<span class="text-muted small d-block">' + esc(it.note) + '</span>' : '') +
                    '</span>' +
                    '<span class="text-nowrap">' +
                        '<button type="button" class="btn btn-sm btn-outline-secondary agEdit" data-id="' + it.id + '" title="Redigera"><i class="bi bi-pencil"></i></button> ' +
                        '<button type="button" class="btn btn-sm btn-outline-danger agDel" data-id="' + it.id + '" title="Ta bort"><i class="bi bi-trash"></i></button>' +
                    '</span>' +
                '</div>';
            });
            html += '</div>';
        });
        wrap.innerHTML = html;

        // id-only handlers — never pass freeform text through inline onclick attributes.
        wrap.querySelectorAll('.agEdit').forEach(b =>
            b.addEventListener('click', () => agOpenEdit(parseInt(b.dataset.id, 10))));
        wrap.querySelectorAll('.agDel').forEach(b =>
            b.addEventListener('click', () => agDelete(parseInt(b.dataset.id, 10))));
    }

    let agItems = [];
    let agDays = [];

    // One shared day list with Bemanning. A Förberedelse day is crew-only, and the picker says so, so a
    // "banbygge 07:00" item can't quietly turn up in every shooter's schedule.
    function loadDays() {
        return fetch('/umbraco/surface/Staffing/GetDays?competitionId=' + AG_COMP)
            .then(r => r.json())
            .then(d => {
                agDays = (d && d.success && d.days) ? d.days : [];
                const sel = document.getElementById('agDate');
                if (!sel) return;
                const keep = sel.value;
                sel.innerHTML = '<option value="">' + (agDays.length ? 'Ingen särskild dag' : 'Tävlingsdagen') + '</option>'
                    + agDays.map(function (dd) {
                        const label = new Date(dd.date + 'T00:00:00')
                            .toLocaleDateString('sv-SE', { weekday: 'short', day: 'numeric', month: 'short' });
                        return '<option value="' + dd.date + '">' + esc(label)
                            + (dd.label ? ' — ' + esc(dd.label) : '')
                            + (dd.isParticipantFacing ? '' : ' (' + esc(dd.kindLabel) + ' — endast funktionärer)')
                            + '</option>';
                    }).join('');
                sel.value = keep;
            })
            .catch(() => { agDays = []; });
    }

    function dayInfo(key) { return agDays.find(function (d) { return d.date === key; }) || null; }

    function load() {
        loadDays().then(loadItems);
    }

    function loadItems() {
        return fetch('/umbraco/surface/Staffing/GetAgenda?competitionId=' + AG_COMP)
            .then(r => r.json())
            .then(d => {
                if (!d.success) {
                    document.getElementById('agList').innerHTML =
                        '<div class="alert alert-warning mb-0">' + esc(d.message || 'Kunde inte läsa dagsprogrammet.') + '</div>';
                    return;
                }
                agItems = d.items || [];
                agCompDate = d.competitionDate || null;
                render(agItems);
            })
            .catch(() => {
                document.getElementById('agList').innerHTML =
                    '<div class="alert alert-warning mb-0">Kunde inte läsa dagsprogrammet.</div>';
            });
    }

    function pickers() {
        if (typeof flatpickr !== 'function') return;
        // #agDate is a <select> fed from the plan's day list — never a datepicker.
        flatpickr('#agStart', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, allowInput: true });
        flatpickr('#agEnd', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, allowInput: true });
    }

    function show() {
        if (!agModal) agModal = new bootstrap.Modal(document.getElementById('agItemModal'));
        document.getElementById('agError').textContent = '';
        pickers();
        agModal.show();
    }

    window.agOpenNew = function () {
        document.getElementById('agModalTitle').textContent = 'Lägg till punkt';
        document.getElementById('agItemId').value = '0';
        ['agTitle', 'agDate', 'agStart', 'agEnd', 'agLocation', 'agNote'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('agAudience').value = 'All';
        show();
    };

    function agOpenEdit(id) {
        const it = agItems.find(x => x.id === id);
        if (!it) return;
        document.getElementById('agModalTitle').textContent = 'Redigera punkt';
        document.getElementById('agItemId').value = String(it.id);
        document.getElementById('agTitle').value = it.title || '';
        document.getElementById('agDate').value = it.itemDate || '';
        document.getElementById('agStart').value = it.startTime || '';
        document.getElementById('agEnd').value = it.endTime || '';
        document.getElementById('agAudience').value = it.audience || 'All';
        document.getElementById('agLocation').value = it.location || '';
        document.getElementById('agNote').value = it.note || '';
        show();
    }

    window.agSave = function () {
        const title = document.getElementById('agTitle').value.trim();
        if (!title) {
            document.getElementById('agError').textContent = 'Skriv vad som händer.';
            return;
        }
        fetch('/umbraco/surface/Staffing/SaveAgendaItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': AG_TOKEN },
            body: JSON.stringify({
                id: parseInt(document.getElementById('agItemId').value, 10) || 0,
                competitionId: AG_COMP,
                title: title,
                itemDate: document.getElementById('agDate').value || null,
                startTime: document.getElementById('agStart').value || null,
                endTime: document.getElementById('agEnd').value || null,
                audience: document.getElementById('agAudience').value,
                location: document.getElementById('agLocation').value || null,
                note: document.getElementById('agNote').value || null
            })
        })
        .then(r => r.json())
        .then(d => {
            if (!d.success) {
                document.getElementById('agError').textContent = d.message || 'Kunde inte spara.';
                return;
            }
            agModal.hide();
            load();
        })
        .catch(() => document.getElementById('agError').textContent = 'Ett oväntat fel uppstod.');
    };

    function agDelete(id) {
        const it = agItems.find(x => x.id === id);
        if (!it) return;
        if (!confirm('Ta bort "' + it.title + '" från dagsprogrammet?')) return;
        fetch('/umbraco/surface/Staffing/DeleteAgendaItem', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': AG_TOKEN },
            body: JSON.stringify({ id: id, competitionId: AG_COMP })
        })
        .then(r => r.json())
        .then(() => load())
        .catch(() => {});
    }

    // Åtgärder och dialoger kommer från planeringens skal (planering.js), som på övriga sidor.
    let shell = null;
    const PRINT_URL = '@Html.Raw(agPrintUrl)';

    // "Lägg till från mall": mallens punkter i en dialog, kryssa de du vill ha. Punkter som redan finns den dagen går inte att välja.
    window.agTemplate = async function () {
        if (!shell) return;
        const day = agCompDate || '';
        let d;
        try { d = await (await fetch('/umbraco/surface/Staffing/GetAgendaTemplate?competitionId=' + AG_COMP + '&date=' + encodeURIComponent(day))).json(); }
        catch (e) { d = null; }
        if (!d || !d.success) { shell.showMsg(esc((d && d.message) || 'Kunde inte hämta mallen.'), 'danger'); return; }
        const rows = d.items || [];
        const fresh = rows.filter(r => !r.exists).length;
        shell.formModal({
            title: 'Lägg till från mall', okLabel: 'Lägg till valda', wide: false,
            html: '<p class="mb-2">Så ser en vanlig tävlingsdag ut. Bocka ur de punkter du inte vill ha — tiderna ändrar du efteråt.</p>'
                + '<div class="d-flex flex-wrap align-items-center gap-2 mb-2">'
                + '<button type="button" class="btn btn-sm btn-outline-secondary" data-ag-all="1">Välj alla</button>'
                + '<button type="button" class="btn btn-sm btn-outline-secondary" data-ag-all="0">Välj ingen</button>'
                + '<span class="ms-auto small" id="agTmCount" aria-live="polite"></span></div>'
                + (fresh ? '' : '<div class="alert alert-info py-2">Alla mallens punkter finns redan i dagsprogrammet.</div>')
                + '<div class="border rounded p-2">' + rows.map(r =>
                    '<div class="form-check"><input class="form-check-input" type="checkbox" id="agTm' + r.index + '" data-ag-tm="' + r.index + '"' + (r.exists ? ' disabled' : ' checked') + '>'
                    + '<label class="form-check-label' + (r.exists ? ' text-body-secondary' : '') + '" for="agTm' + r.index + '">'
                    + '<span class="fw-semibold">' + esc(r.title) + '</span> '
                    + '<span class="text-body-secondary small">' + esc(timeLabel({ startTime: r.startTime, endTime: r.endTime })) + '</span>'
                    + (r.audience === 'Staff' ? ' <span class="badge bg-success-subtle text-success-emphasis border">Funktionärer</span>' : r.audience === 'Shooters' ? ' <span class="badge bg-primary-subtle text-primary-emphasis border">Skyttar</span>' : '')
                    + (r.exists ? ' <span class="text-body-secondary small">— finns redan, läggs inte in igen</span>' : '')
                    + '</label></div>').join('') + '</div>',
            onOpen: body => {
                const boxes = () => [].slice.call(body.querySelectorAll('[data-ag-tm]:not(:disabled)'));
                const sync = () => { body.querySelector('#agTmCount').textContent = boxes().filter(x => x.checked).length + ' av ' + fresh + ' punkter valda'; };
                body.addEventListener('change', sync);
                body.addEventListener('click', e => {
                    const b = e.target.closest('[data-ag-all]'); if (!b) return;
                    boxes().forEach(x => { x.checked = b.getAttribute('data-ag-all') === '1'; });
                    sync();
                });
                sync();
            },
            onOk: async body => {
                const picks = [].slice.call(body.querySelectorAll('[data-ag-tm]:checked:not(:disabled)')).map(x => parseInt(x.getAttribute('data-ag-tm'), 10));
                if (!picks.length) return 'Välj minst en punkt, eller tryck Avbryt.';
                const r = await (await fetch('/umbraco/surface/Staffing/SeedAgenda', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': AG_TOKEN },
                    body: JSON.stringify({ competitionId: AG_COMP, items: picks, itemDate: day || null })
                })).json();
                if (!r.success) return r.message || 'Kunde inte lägga till punkterna.';
                await loadItems();
                shell.showMsg(r.created ? esc(r.created + (r.created === 1 ? ' punkt lades till.' : ' punkter lades till.')) : 'Ingenting lades till.', r.created ? 'success' : 'info');
                return true;
            }
        });
    };

    window.plOnShell = function (A) {
        shell = A;
        A.setActions([
            { label: 'Lägg till punkt…', icon: 'bi-plus-lg', fn: () => window.agOpenNew() },
            { label: 'Lägg till från mall…', icon: 'bi-magic', fn: () => window.agTemplate() },
            { divider: true },
            { label: 'Skriv ut dagsprogrammet', icon: 'bi-printer', fn: () => window.open(PRINT_URL, '_blank', 'noopener') },
        ]);
    };

    // Lazy-load when the tab is first shown, like the other planning tabs.
    const tabBtn = document.getElementById('plan-dagsprogram-tab');
    if (tabBtn) {
        tabBtn.addEventListener('shown.bs.tab', function once() {
            tabBtn.removeEventListener('shown.bs.tab', once);
            load();
        });
    } else {
        load();
    }
})();
</script>
