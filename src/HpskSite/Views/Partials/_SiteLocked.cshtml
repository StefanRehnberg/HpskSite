@* Besökarens vy: rutan som visas i stället för en LÅST sida (den finns i menyn med hänglås men tittaren får inte se den). Menyn står kvar.
   Aldrig sidans titel eller innehåll. Utloggad: Logga in (med återvändsadress, så att en delad länk fungerar). Inloggad utan medlemskap: besked utan knapp.
   Modell: (ägartyp, ägarens namn, kräver medlemskap, inloggad, inloggningsadress). *@
@model (string OwnerType, string OwnerName, bool NeedsMembership, bool LoggedIn, string LoginUrl)
@{
    var ownerWord = Model.OwnerType == HpskSite.Services.SitePages.SiteTemplates.Region ? "kretsens" : "klubbens";
    var title = !Model.NeedsMembership ? "Den här sidan kräver inloggning"
        : Model.LoggedIn ? "Den här sidan är bara för medlemmar i " + Model.OwnerName
        : "Den här sidan är för " + ownerWord + " medlemmar";
    var text = !Model.NeedsMembership ? "Logga in för att se den."
        : Model.LoggedIn ? "Du är inloggad, men inte medlem här."
        : "Logga in för att se innehållet.";
}
<div class="card text-center mx-auto my-4 hpsk-locked-card" style="max-width: 36rem;" data-site-page-locked role="status">
    <div class="card-body py-4">
        <i class="bi bi-lock-fill display-5 text-secondary" aria-hidden="true"></i>
        <h2 class="h4 mt-2 mb-1">@title</h2>
        <p class="text-muted mb-3">@text</p>
        @if (!Model.LoggedIn)
        {
            <a class="btn btn-primary" href="@Model.LoginUrl">Logga in</a>
        }
    </div>
</div>
