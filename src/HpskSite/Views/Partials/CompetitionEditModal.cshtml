function saveCompetition() {
    // Sync CKEditor content to textarea before reading form
    if (compDescriptionEditor) {
        document.getElementById('description').value = compDescriptionEditor.getData();
    }

    const form = document.getElementById('competitionEditForm');

    // Disable Flatpickr-generated inputs before validation (they have name="" which breaks checkValidity)
    const fpInputs = form.querySelectorAll('.numInput, .flatpickr-hour, .flatpickr-minute, .flatpickr-am-pm');
    fpInputs.forEach(i => i.disabled = true);
    const isValid = form.checkValidity();
    if (!isValid) {
        // ⚠ Med flikar ligger fälten på olika synliga sidor. reportValidity() kan inte
        // peka på ett fält som sitter på en flik som inte visas — bubblan hamnar
        // ingenstans och Spara ser ut att inte göra någonting. Byt till rätt flik
        // FÖRST, sedan rapportera. Det är exakt det tysta felet flikarna annars inför.
        const firstBad = Array.prototype.slice.call(form.querySelectorAll('input,select,textarea'))
            .find(el => !el.disabled && el.checkValidity && !el.checkValidity());
        if (firstBad && typeof window.hpskRevealField === 'function') {
            window.hpskRevealField('#competitionEditModal', firstBad);
        }
        form.reportValidity();
        fpInputs.forEach(i => i.disabled = false);
        return;
    }
    fpInputs.forEach(i => i.disabled = false);

    // Soft "at-least-one" check: clubId, regionalFederation, or competitionScope must
    // be set so CompetitionUrlProvider can produce a clean URL. The wizard mutex is
    // UI-only (a club selection disables the regionalFederation dropdown), so we check
    // disabled state on regionalFederation the same way the field-collection logic does.
    const _clubIdVal = parseInt(document.getElementById('clubId')?.value || '0', 10);
    const _regSel = document.getElementById('regionalFederation');
    const _regFedVal = _regSel && !_regSel.disabled ? (_regSel.value || '').trim() : '';
    const _scopeVal = (document.getElementById('competitionScope')?.value || '').trim();
    if (_clubIdVal <= 0 && !_regFedVal && !_scopeVal) {
        const errorList = document.getElementById('errorList');
        errorList.innerHTML = '';
        const li = document.createElement('li');
        li.textContent = 'Välj antingen ansvarig klubb, krets eller mästerskapstyp — annars går det inte att skapa en lättläst URL för tävlingen.';
        errorList.appendChild(li);
        const errDiv = document.getElementById('editFormErrors');
        errDiv.classList.remove('d-none');
        errDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        return;
    }

    // Sync rolling start JSON before collecting form data
    var rsCheckbox = document.getElementById('edit_rollingStartEnabled');
    var rsHidden = document.getElementById('edit_rollingStart');
    if (rsCheckbox && rsHidden) {
        rsHidden.value = rsCheckbox.checked ? JSON.stringify({ enabled: true, patrolSize: parseInt(document.getElementById('edit_patrolSize').value) || 2 }) : '';
    }

    // Temporarily enable disabled fields so they're included in FormData
    const disabledFields = form.querySelectorAll(':disabled');
    disabledFields.forEach(f => f.disabled = false);
    const formData = new FormData(form);
    disabledFields.forEach(f => f.disabled = true);
    const fields = {};

    for (let [key, value] of formData.entries()) {
        // Skip competitionId - it's passed separately
        if (key === 'competitionId') {
            continue;
        }

        // Skip competitionManagers and competitionManagerIds - handled separately below
        if (key === 'competitionManagers' || key === 'competitionManagerIds') {
            continue;
        }

        if ((key === 'competitionEndDate' || key === 'description' || key === 'contactPhone') && !value) {
            continue;
        }

        if (key === 'showLiveResults' || key === 'addToMenu' || key === 'allowDualCClass' || key === 'isClubOnly' || key === 'isAwardingStandardMedals' || key === 'allowSelfReporting' || key === 'allowTeams' || key === 'allowStafett' || key === 'faltskytteSelfServiceResults') {
            fields[key] = value === 'on';
        } else {
            fields[key] = value;
        }
    }

    // FormData omits unchecked checkboxes, which means switching one OFF and
    // saving wouldn't actually clear the property. Force the current state
    // for the Fältskytte self-service flag (the only boolean we care about
    // strictly turning off in this flow).
    var ssEl = document.getElementById('edit_faltskytteSelfServiceResults');
    if (ssEl) fields.faltskytteSelfServiceResults = ssEl.checked;

    // Extract seriesId — for existing competitions it's handled via Move after save,
    // but for new competitions (copy/create) it must be passed to CreateCompetition
    // so the competition is created as a child of the series
    const newSeriesId = fields.seriesId || '';
    delete fields.seriesId;

    // Handle competitionManagers - convert from hidden field to array of integers
    const managerIdsStr = document.getElementById('comp_competitionManagers_ids').value || '';
    const managerIds = managerIdsStr.split(',')
        .map(id => id.trim())
        .filter(id => id)
        .map(id => parseInt(id));
    fields.competitionManagers = managerIds;

    // Handle regionalFederation - it may be disabled when a club is selected
    // Always include it explicitly (empty string clears it when club is selected)
    const regionSelect = document.getElementById('regionalFederation');
    fields.regionalFederation = regionSelect.disabled ? '' : (regionSelect.value || '');

    // Add Direktplacering config
    if (document.getElementById('edit_enableDirektplacering').checked) {
        fields.direktplaceringConfig = JSON.stringify(collectEditDpConfig());
    } else {
        fields.direktplaceringConfig = '';
    }

    // Ensure unchecked checkboxes are explicitly set to false
    const checkboxFields = ['showLiveResults', 'addToMenu', 'allowDualCClass', 'isClubOnly', 'isAwardingStandardMedals', 'isExternal', 'allowSelfReporting', 'allowTeams', 'allowStafett'];
    checkboxFields.forEach(field => {
        if (!(field in fields)) {
            fields[field] = false;
        }
    });

    // Team result series count: empty = auto. Normalize to an int (0 = auto) so the
    // int property stores cleanly and an emptied field clears back to auto.
    if (!('teamResultSeriesCount' in fields) || String(fields.teamResultSeriesCount).trim() === '') {
        fields.teamResultSeriesCount = 0;
    } else {
        fields.teamResultSeriesCount = parseInt(fields.teamResultSeriesCount, 10) || 0;
    }

    const requiredDateFields = ['competitionDate', 'registrationOpenDate', 'registrationCloseDate'];
    for (let field of requiredDateFields) {
        if (!fields[field]) {
            showNotification(`${field} är obligatorisk`, 'error');
            return;
        }
    }

    const saveBtn = document.getElementById('saveCompetitionBtn');
    const originalText = saveBtn.innerHTML;
    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="bi bi-spinner-border spinner-border-sm"></i> Sparar...';

    const competitionId = parseInt(document.getElementById('competitionId').value) || 0;
    const isNewCompetition = competitionId === 0;

    let endpoint = '/umbraco/surface/CompetitionEdit/SaveCompetition';
    let requestBody;

    if (isNewCompetition) {
        // For new competitions (copy), use CreateCompetition endpoint
        endpoint = '/umbraco/surface/CompetitionAdmin/CreateCompetition';
        // CreateCompetition expects competitionType in fields
        fields.competitionType = 'Precision';
        // Include seriesId so CreateCompetition places it under the correct series
        if (newSeriesId) {
            fields.seriesId = newSeriesId;
        }
        requestBody = { fields: fields };
    } else {
        // For existing competitions (edit), use SaveCompetition endpoint
        requestBody = {
            competitionId: competitionId,
            competitionType: 'Precision',
            fields: fields
        };
    }

    fetch(endpoint, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
        },
        body: JSON.stringify(requestBody)
    })
    .then(response => {
        if (!response.ok) {
            return response.text().then(text => {
                throw new Error(`HTTP ${response.status}: ${text}`);
            });
        }
        return response.json();
    })
    .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;

        if (data.success) {
            document.getElementById('editFormErrors').classList.add('d-none');

            // Check if series assignment changed — if so, move the competition
            const seriesDropdown = document.getElementById('competitionSeriesId');
            const originalSeriesId = seriesDropdown ? (seriesDropdown.dataset.originalSeriesId || '') : '';
            const seriesChanged = !isNewCompetition && String(newSeriesId) !== String(originalSeriesId);

            if (seriesChanged) {
                // Move competition to new series (or out of series)
                fetch('/umbraco/surface/CompetitionAdmin/MoveCompetitionToSeries', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        competitionId: competitionId,
                        seriesId: newSeriesId ? parseInt(newSeriesId) : null
                    })
                })
                .then(r => r.json())
                .then(moveData => {
                    if (moveData.success) {
                        showNotification('Tävlingen uppdaterades och flyttades till vald serie!', 'success');
                    } else {
                        showNotification('Tävlingen sparades men kunde inte flyttas till serien: ' + (moveData.message || ''), 'warning');
                    }
                    bootstrap.Modal.getInstance(editModal).hide();
                    // Refresh both competition list and series list after move
                    setTimeout(() => {
                        if (typeof loadCompetitionsList === 'function') loadCompetitionsList();
                        if (typeof loadSeriesList === 'function') loadSeriesList();
                    }, 300);
                })
                .catch(err => {
                    console.error('Error moving competition to series:', err);
                    showNotification('Tävlingen sparades men serieflyttning misslyckades', 'warning');
                    bootstrap.Modal.getInstance(editModal).hide();
                    setTimeout(() => {
                        if (typeof loadCompetitionsList === 'function') loadCompetitionsList();
                        if (typeof loadSeriesList === 'function') loadSeriesList();
                    }, 300);
                });
                return; // Don't run the normal success flow below
            }

            const message = isNewCompetition ? 'Tävlingen skapades framgångsrikt!' : 'Tävlingen uppdaterades framgångsrikt!';
            showNotification(message, 'success');
            bootstrap.Modal.getInstance(editModal).hide();

            // Reload just the competitions list to update the modified row
            if (typeof loadCompetitionsList === 'function') {
                setTimeout(() => {
                    loadCompetitionsList();
                }, 500);
            }
        } else {
            const errorList = document.getElementById('errorList');
            errorList.innerHTML = '';
            
            if (data.errors && typeof data.errors === 'object' && Object.keys(data.errors).length > 0) {
                for (let [field, error] of Object.entries(data.errors)) {
                    const li = document.createElement('li');
                    li.textContent = error;
                    errorList.appendChild(li);
                }
            } else {
                const li = document.createElement('li');
                li.textContent = data.message || 'Ett okänt fel uppstod';
                errorList.appendChild(li);
            }
            
            const errDiv = document.getElementById('editFormErrors');
            errDiv.classList.remove('d-none');
            errDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
    })
    .catch(error => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        console.error('Error saving competition:', error);
        showNotification('Fel vid sparning: ' + error.message, 'error');
    });
}

function showNotification(message, type) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const notification = document.createElement('div');
    notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
    notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; max-width: 400px;';
    notification.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;

    document.body.appendChild(notification);

    setTimeout(() => {
        if (notification.parentNode) {
            notification.remove();
        }
    }, 5000);
}

// Ensure clubs are loaded in the dropdown
function ensureClubsLoaded() {
    const clubSelect = document.getElementById('clubId');
    // Load clubs if not already loaded
    if (clubSelect.options.length <= 1) {
        loadClubsForSelector();
    } else {
        // Clubs already loaded, just set the value from dataset
        const currentClubId = clubSelect.dataset.currentValue;
        if (currentClubId && currentClubId !== '0') {
            clubSelect.value = currentClubId;
        }
    }
}

// Module-level variables for role-aware club management
let editManagedClubIds = [];
let editUserRole = '';
let editOriginalClubId = '';
let editOriginalRegion = '';

function loadClubsForSelector() {
    const clubSelect = document.getElementById('clubId');
    const helpText = clubSelect.parentElement.querySelector('small');

    // Use role-aware endpoint that returns only clubs the user can manage
    fetch('/umbraco/surface/CompetitionAdmin/GetClubsForCompetitionAdmin')
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            const clubs = data.clubs || [];

            if (data.success && Array.isArray(clubs)) {
                // Store role info for warning logic
                editManagedClubIds = data.managedClubIds || [];
                editUserRole = data.role || '';

                // Clear loading message
                helpText.style.display = 'none';

                // Populate clubs (already sorted by sv-SE on server)
                clubs.forEach(club => {
                    const option = document.createElement('option');
                    option.value = club.id;
                    option.textContent = club.name;
                    clubSelect.appendChild(option);
                });

                // Set the current club if editing
                const currentClubId = clubSelect.dataset.currentValue;
                if (currentClubId && currentClubId !== '0') {
                    clubSelect.value = currentClubId;
                }

                // Store original values for mismatch warning
                editOriginalClubId = clubSelect.dataset.currentValue || '';
                const regionSelect = document.getElementById('regionalFederation');
                editOriginalRegion = regionSelect.dataset.currentValue || '';

                // Club page context: lock dropdowns for non-admin roles
                const isClubPage = window.location.pathname.includes('/clubs/');
                const currentPageClubId = window.currentClubId;
                if (isClubPage && currentPageClubId && editUserRole !== 'admin') {
                    clubSelect.disabled = true;
                    helpText.style.display = '';
                    helpText.textContent = 'Tävlingen tillhör denna klubb';
                    helpText.classList.remove('text-danger', 'text-warning');
                    helpText.classList.add('text-muted');
                    // Also lock region dropdown
                    document.getElementById('regionalFederation').disabled = true;
                }

                // Update organizer UI based on club selection
                updateEditOrganizerUI();
                // Re-evaluate "Endast för vald klubb" now that the club value is in place.
                syncEditClubOnlyAvailability();
            } else if (data.success && clubs.length === 0) {
                helpText.textContent = 'Inga klubbar finns registrerade';
                helpText.classList.add('text-warning');
            } else {
                helpText.textContent = data.message || 'Kunde inte ladda klubbar';
                helpText.classList.add('text-danger');
            }
        })
        .catch(error => {
            console.error('Error loading clubs:', error);
            helpText.textContent = 'Fel vid hämtning av klubbar';
            helpText.classList.add('text-danger');
        });
}

function loadRegionsForSelector() {
    const regionSelect = document.getElementById('regionalFederation');
    const helpText = regionSelect.parentElement.querySelector('small');

    fetch('/umbraco/surface/RegionalAdmin/GetAllRegions')
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            if (data.success && data.regions && data.regions.length > 0) {
                // Clear loading message
                helpText.style.display = 'none';

                // Populate regions
                data.regions.forEach(region => {
                    const option = document.createElement('option');
                    option.value = region.id;
                    option.textContent = region.name;
                    regionSelect.appendChild(option);
                });

                // Set the current region if editing
                const currentRegion = regionSelect.dataset.currentValue;
                if (currentRegion) {
                    regionSelect.value = currentRegion;
                }
            } else {
                helpText.textContent = data.message || 'Kunde inte ladda kretsar';
                helpText.classList.add('text-danger');
            }
        })
        .catch(error => {
            console.error('Error loading regions:', error);
            helpText.textContent = 'Fel vid hämtning av kretsar';
            helpText.classList.add('text-danger');
        });
}

// Ensure regions are loaded
function ensureRegionsLoaded() {
    const regionSelect = document.getElementById('regionalFederation');
    if (regionSelect.options.length <= 1) {
        loadRegionsForSelector();
    } else {
        // Regions already loaded, just set the value from dataset
        const currentRegion = regionSelect.dataset.currentValue;
        if (currentRegion) {
            regionSelect.value = currentRegion;
        }
    }
    // Update UI based on current club selection
    updateEditOrganizerUI();
}

// Handle club selection change - disable region if club is selected
function onEditClubChange() {
    const regionSelect = document.getElementById('regionalFederation');
    // Clear region when club is selected
    if (document.getElementById('clubId').value) {
        regionSelect.value = '';
    }
    syncEditClubOnlyAvailability();
    updateEditOrganizerUI();
    updateEditMismatchWarning();

    // Refresh the range picker's "Klubbens banor" quick-pick for the chosen club.
    if (typeof compRangeLoadClubRanges === 'function') compRangeLoadClubRanges('edit_', document.getElementById('clubId').value);
}

// Handle region selection change
function onEditRegionChange() {
    syncEditClubOnlyAvailability();
    updateEditMismatchWarning();
    updateEditDestinationSummary();
}

// "Endast för vald klubb" only makes sense when an actual club is selected.
// With no club, the visibility filter (clubId == myClub) would hide the comp
// everywhere — so we force-uncheck and disable the checkbox in that state.
function syncEditClubOnlyAvailability() {
    const clubSelect = document.getElementById('clubId');
    const cb = document.getElementById('isClubOnly');
    if (!cb) return;
    const hasClub = !!(clubSelect && clubSelect.value);
    if (!hasClub) {
        if (cb.checked) cb.checked = false;
        cb.disabled = true;
        // Cascade so standardmedal checkbox is re-enabled when isClubOnly is forced off.
        onEditIsClubOnlyChange();
    } else {
        cb.disabled = false;
    }
}

// Show/hide mismatch warning based on club/region changes
function updateEditMismatchWarning() {
    const warningDiv = document.getElementById('edit_clubMismatchWarning');
    const warningText = document.getElementById('edit_clubMismatchText');
    const clubSelect = document.getElementById('clubId');
    const regionSelect = document.getElementById('regionalFederation');

    const newClubId = clubSelect.value || '';
    const newRegion = regionSelect.disabled ? '' : (regionSelect.value || '');
    const origClub = editOriginalClubId || '';
    const origRegion = editOriginalRegion || '';

    let message = '';

    if (origClub && origClub !== '0') {
        // Competition originally had a club
        if (newClubId && newClubId !== origClub) {
            // Case 1: Changed to a different club
            message = '<strong>Obs!</strong> Du ändrar tävlingens klubb. Om du sparar kommer tävlingen att flyttas och visas under den nya klubben istället.';
        } else if (!newClubId && !newRegion) {
            // Case 4: Both club and region removed (national)
            message = '<strong>Obs!</strong> Tävlingen blir nationell utan klubb eller krets. Den hanteras från den allmänna administrationssidan (eller kretsens regionsida).';
        } else if (!newClubId && newRegion) {
            // Case 3: Club removed but region set
            message = '<strong>Obs!</strong> Tävlingen flyttas till kretsnivå. Den kommer inte att visas i någon klubbs tävlingslista — den hanteras istället från <strong>kretsens regionsida</strong>.';
        }
    } else if (origRegion) {
        // Competition originally had a region but no club
        if (!newClubId && !newRegion) {
            // Region removed, now national
            message = '<strong>Obs!</strong> Tävlingen blir nationell utan klubb eller krets. Den hanteras från den allmänna administrationssidan (eller kretsens regionsida).';
        }
    }

    if (message) {
        warningText.innerHTML = message;
        warningDiv.classList.remove('d-none');
    } else {
        warningDiv.classList.add('d-none');
    }
}

// Update the region dropdown state + the destination summary
function updateEditOrganizerUI() {
    const clubSelect = document.getElementById('clubId');
    const regionSelect = document.getElementById('regionalFederation');

    // Don't re-enable region if dropdown is locked on club page
    const isClubPage = window.location.pathname.includes('/clubs/');
    const isLocked = isClubPage && window.currentClubId && editUserRole !== 'admin';

    if (clubSelect && clubSelect.value) {
        // Club selected - disable region dropdown
        if (!isLocked) {
            regionSelect.disabled = true;
        }
    } else {
        // No club - enable region dropdown (unless locked)
        if (!isLocked) {
            regionSelect.disabled = false;
        }
    }

    updateEditDestinationSummary();
}

// Live "Var hamnar tävlingen?" summary — neutral, always-on statement of where the
// competition is managed/shown, based on the current Arrangör + visibility choices.
// Mirrors updateWizardDestinationSummary in CompetitionWizardModal.cshtml.
function updateEditDestinationSummary() {
    const textEl = document.getElementById('edit_destinationText');
    if (!textEl) return;

    const clubSelect = document.getElementById('clubId');
    const regionSelect = document.getElementById('regionalFederation');
    const clubVal = clubSelect ? (clubSelect.value || '') : '';
    const regionVal = regionSelect ? (regionSelect.value || '') : '';
    const clubOnly = document.getElementById('isClubOnly')?.checked || false;

    if (clubSelect && clubSelect.options.length <= 1 && !regionVal) {
        textEl.innerHTML = 'Välj klubb eller krets ovan.';
        return;
    }

    const clubName = (clubVal && clubSelect.selectedIndex >= 0)
        ? clubSelect.options[clubSelect.selectedIndex].textContent : '';
    const regionName = (regionVal && regionSelect.selectedIndex >= 0)
        ? regionSelect.options[regionSelect.selectedIndex].textContent : '';

    let msg;
    if (clubVal) {
        if (clubOnly) {
            msg = 'Visas <strong>endast för ' + clubName + 's medlemmar</strong>, på ' + clubName + 's sida. Hanteras från <strong>' + clubName + 's administrationssida</strong>.';
        } else {
            msg = 'Visas på <strong>' + clubName + 's sida</strong> och i kretsens inbjudningslista. Hanteras från <strong>' + clubName + 's administrationssida</strong>.';
        }
    } else if (regionVal) {
        msg = 'Visas på <strong>kretsens (' + regionName + ') regionsida</strong> — inte under någon klubb. Hanteras från <strong>regionsidan</strong>.';
    } else {
        msg = '<strong>Nationell tävling</strong> — syns för alla. Hanteras endast från den allmänna <strong>administrationssidan</strong>.';
    }
    textEl.innerHTML = msg;
}

// Update populateEditModal to handle club and region fields
const originalPopulateEditModal = window.populateEditModal;
window.populateEditModal = function(competition) {
    // Call original function
    originalPopulateEditModal(competition);

    // Handle club and region fields
    if (competition) {
        setCheckboxValue('isClubOnly', competition.isClubOnly || false);
        onEditIsClubOnlyChange();

        // Set clubId as data attribute for later use
        document.getElementById('clubId').dataset.currentValue = competition.clubId || '0';

        // Set regionalFederation as data attribute for later use
        document.getElementById('regionalFederation').dataset.currentValue = competition.regionalFederation || '';

        // Store original values for mismatch warning
        editOriginalClubId = String(competition.clubId || '0');
        editOriginalRegion = competition.regionalFederation || '';

        // Hide any previous mismatch warning
        document.getElementById('edit_clubMismatchWarning').classList.add('d-none');

        // Always ensure clubs and regions are loaded
        ensureClubsLoaded();
        ensureRegionsLoaded();

        // Handle external competition fields
        setCheckboxValue('isExternal', competition.isExternal || false);
        setFieldValue('externalUrl', competition.externalUrl || '');
        setFieldValue('externalRegistrationEmail', competition.externalRegistrationEmail || '');
        // Note: invitationFile cannot be pre-populated for security reasons (file inputs cannot be set programmatically)
    }
}

// ============================================================================
// Direktplacering - Edit Modal
// ============================================================================

let editDpTeamCounter = 0;

function toggleEditDirektplacering() {
    const section = document.getElementById('editDpConfigSection');
    const enabled = document.getElementById('edit_enableDirektplacering').checked;
    section.style.display = enabled ? 'block' : 'none';
    if (enabled && editDpTeamCounter === 0) {
        addEditDpTeam();
    }
}

function loadEditDirektplaceringConfig(configStr) {
    const container = document.getElementById('editDpTeamList');
    container.innerHTML = '';
    editDpTeamCounter = 0;

    if (!configStr) {
        document.getElementById('edit_enableDirektplacering').checked = false;
        document.getElementById('editDpConfigSection').style.display = 'none';
        return;
    }

    let config;
    try {
        config = typeof configStr === 'string' ? JSON.parse(configStr) : configStr;
    } catch(e) {
        document.getElementById('edit_enableDirektplacering').checked = false;
        document.getElementById('editDpConfigSection').style.display = 'none';
        return;
    }

    if (!config || !config.enabled) {
        document.getElementById('edit_enableDirektplacering').checked = false;
        document.getElementById('editDpConfigSection').style.display = 'none';
        return;
    }

    document.getElementById('edit_enableDirektplacering').checked = true;
    document.getElementById('editDpConfigSection').style.display = 'block';
    document.getElementById('edit_allowMixedClasses').checked = config.allowMixedClasses !== false;

    if (config.teams && config.teams.length > 0) {
        config.teams.forEach(team => {
            addEditDpTeam(team.startTime, team.endTime, team.positions, team.allowedWeaponClasses || [], team.label || '');
        });
    }
    onEditMixedClassesChanged();
}

function addEditDpTeam(startTime, endTime, positions, weaponClasses, label) {
    editDpTeamCounter++;
    const teamNum = editDpTeamCounter;
    const container = document.getElementById('editDpTeamList');

    const defStart = startTime || '09:00';
    const defEnd = endTime || '11:00';
    const defPositions = positions || 30;
    const defLabel = label || '';
    const labelSuffix = defLabel ? ` - ${defLabel}` : '';

    const card = document.createElement('div');
    card.className = 'card mb-2 edit-dp-team-card';
    card.dataset.teamNumber = teamNum;
    card.innerHTML = `
        <div class="card-body py-2 px-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <strong class="edit-dp-team-header">Skjutlag: ${teamNum} - Tid: ${defStart}-${defEnd} (${defPositions} st)${labelSuffix}</strong>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeEditDpTeam(this)">
                    <i class="bi bi-trash"></i>
                </button>
            </div>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small mb-0">Starttid</label>
                    <input type="text" class="form-control form-control-sm edit-dp-start-time" value="${defStart}">
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">Sluttid</label>
                    <input type="text" class="form-control form-control-sm edit-dp-end-time" value="${defEnd}">
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">Antal platser</label>
                    <input type="number" class="form-control form-control-sm edit-dp-positions" value="${defPositions}" min="1">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Plats</label>
                    <input type="text" class="form-control form-control-sm edit-dp-label" value="${defLabel}" placeholder="T.ex. Hall 1">
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-0">Vapengrupper</label>
                    <select class="form-select form-select-sm edit-dp-weapon-classes" ${document.getElementById('edit_allowMixedClasses').checked ? 'multiple' : ''} form="dp-no-form">
                        <option value="A">A</option>
                        <option value="A_Opt">A Opt</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                        <option value="R">R</option>
                        <option value="L">L</option>
                        <option value="M">M</option>
                    </select>
                    <small class="form-text text-muted" style="font-size:0.7rem;">Ingen markerad = alla</small>
                </div>
            </div>
        </div>
    `;
    container.appendChild(card);

    // Pre-select weapon classes
    if (weaponClasses && weaponClasses.length > 0) {
        const select = card.querySelector('.edit-dp-weapon-classes');
        weaponClasses.forEach(cls => {
            const opt = select.querySelector(`option[value="${cls}"]`);
            if (opt) opt.selected = true;
        });
    }

    // Initialize Flatpickr (static: true to stay in place inside modal, defaultDate ensures value is written)
    flatpickr(card.querySelector('.edit-dp-start-time'), { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, static: true, defaultDate: defStart });
    flatpickr(card.querySelector('.edit-dp-end-time'), { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true, static: true, defaultDate: defEnd });

    // Live header update
    [card.querySelector('.edit-dp-start-time'), card.querySelector('.edit-dp-end-time'), card.querySelector('.edit-dp-positions'), card.querySelector('.edit-dp-label')].forEach(input => {
        input.addEventListener('change', () => updateEditDpTeamHeader(card));
        input.addEventListener('input', () => updateEditDpTeamHeader(card));
    });
}

function removeEditDpTeam(btn) {
    btn.closest('.edit-dp-team-card').remove();
    const cards = document.querySelectorAll('#editDpTeamList .edit-dp-team-card');
    cards.forEach((card, idx) => {
        card.dataset.teamNumber = idx + 1;
        updateEditDpTeamHeader(card);
    });
    editDpTeamCounter = cards.length;
}

function updateEditDpTeamHeader(card) {
    const teamNum = card.dataset.teamNumber;
    const start = card.querySelector('.edit-dp-start-time')?.value || '??:??';
    const end = card.querySelector('.edit-dp-end-time')?.value || '??:??';
    const positions = card.querySelector('.edit-dp-positions')?.value || '?';
    const label = card.querySelector('.edit-dp-label')?.value || '';
    const labelSuffix = label ? ` - ${label}` : '';
    const header = card.querySelector('.edit-dp-team-header');
    if (header) header.textContent = `Skjutlag: ${teamNum} - Tid: ${start}-${end} (${positions} st)${labelSuffix}`;
}

function onEditMixedClassesChanged() {
    const allowMultiple = document.getElementById('edit_allowMixedClasses').checked;
    document.querySelectorAll('#editDpTeamList .edit-dp-weapon-classes').forEach(select => {
        const selected = Array.from(select.selectedOptions).map(o => o.value);
        select.multiple = allowMultiple;
        // When switching to single, keep only the first selection
        if (!allowMultiple && selected.length > 1) {
            Array.from(select.options).forEach(o => o.selected = (o.value === selected[0]));
        }
    });
}

function collectEditDpConfig() {
    const teams = [];
    document.querySelectorAll('#editDpTeamList .edit-dp-team-card').forEach((card, idx) => {
        const selectedClasses = Array.from(card.querySelector('.edit-dp-weapon-classes').selectedOptions).map(o => o.value);
        teams.push({
            teamNumber: idx + 1,
            startTime: card.querySelector('.edit-dp-start-time')?.value || '',
            endTime: card.querySelector('.edit-dp-end-time')?.value || '',
            positions: parseInt(card.querySelector('.edit-dp-positions')?.value) || 30,
            label: card.querySelector('.edit-dp-label')?.value || '',
            allowedWeaponClasses: selectedClasses
        });
    });
    return {
        enabled: true,
        allowMixedClasses: document.getElementById('edit_allowMixedClasses').checked,
        teams: teams
    };
}
