<script>
// Rita om sektionsraden EFTER populateEditModal, inte pa en gissad timeout.
//
// ⚠ Det ar disciplinvillkoren INNE i populateEditModal som doljer
// #editFaltskytteSection och #editDirektplaceringSection. Ritas raden fore dem far
// en precisionstavling en knapp till "Faltskytte-installningar" som hoppar till en
// tom rubrik. En forsta version anvande setTimeout(900) och gjorde precis det —
// samma tidsglapp som redan finns i modalens ovriga oppningsvagar. Hooka pa den
// auktoritativa punkten i stallet.
//
// Wrappern laggs SIST i filen, sa den ligger utanpa bada de befintliga
// populateEditModal-definitionerna (den andra dekorerar den forsta).
(function () {
    if (typeof window.populateEditModal !== 'function') return;
    if (window.__hpskSecnavWrapped) return;
    window.__hpskSecnavWrapped = true;
    var inner = window.populateEditModal;
    window.populateEditModal = function (competition) {
        var r = inner.apply(this, arguments);
        // Noll fordrojning: bara efter att synkron show/hide i inner har kort.
        setTimeout(window.hpskEditModalSyncSections, 0);
        return r;
    };
})();
</script>
<script>
// ─── Byt gren pa en befintlig tavling ────────────────────────────────────────
//
// competitionType sattes i tavlingsguiden och gick inte att andra efterat; modalen
// laste den bara for att visa/dolja avsnitt. Valde arrangoren fel gren var
// radera-och-skapa-om enda vagen ut.
//
// ⚠ SERVERN AGER REGELN. Klienten fragar bara vad som galler och visar svaret.
// ChangeCompetitionType kontrollerar om, eftersom en anmalan kan ha kommit in mellan
// att modalen oppnades och att knappen trycktes.
(function () {
    if (window.hpskLoadCompetitionTypeState) return;

    window.hpskLoadCompetitionTypeState = function (competitionId) {
        var sel = document.getElementById('edit_competitionTypeSelect');
        var btn = document.getElementById('edit_competitionTypeBtn');
        var help = document.getElementById('edit_competitionTypeHelp');
        if (!sel || !btn || !help) return;
        if (!competitionId) { sel.innerHTML = '<option value="">—</option>'; return; }

        fetch('/umbraco/surface/CompetitionEdit/GetCompetitionTypeChangeability?competitionId=' + competitionId, {
            credentials: 'same-origin'
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            if (!d.success) {
                sel.innerHTML = '<option value="">' + (d.message || 'Kunde inte lasa grenen') + '</option>';
                sel.disabled = true; btn.disabled = true; help.textContent = '';
                return;
            }
            sel.innerHTML = '';
            (d.options || []).forEach(function (o) {
                var opt = document.createElement('option');
                opt.value = o.id;
                opt.textContent = o.name;
                if (o.id === d.currentType) opt.selected = true;
                sel.appendChild(opt);
            });
            sel.dataset.currentType = d.currentType || '';
            sel.disabled = !d.canChange;
            btn.disabled = !d.canChange;
            help.textContent = d.reason || '';
            help.className = 'form-text ' + (d.canChange ? 'text-success' : 'text-warning-emphasis');
        })
        .catch(function (e) {
            sel.innerHTML = '<option value="">Kunde inte lasa grenen</option>';
            sel.disabled = true; btn.disabled = true;
            help.textContent = 'Fel vid kontroll: ' + e;
        });
    };

    window.hpskChangeCompetitionType = function () {
        var sel = document.getElementById('edit_competitionTypeSelect');
        var btn = document.getElementById('edit_competitionTypeBtn');
        var help = document.getElementById('edit_competitionTypeHelp');
        var id = parseInt(document.getElementById('competitionId').value, 10) || 0;
        if (!id || !sel) return;
        var newType = sel.value;
        if (!newType || newType === sel.dataset.currentType) {
            help.textContent = 'Valj en annan gren an den nuvarande.';
            return;
        }
        var label = sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].textContent : newType;
        // Klasserna nollstalls av servern — sag det INNAN, inte efterat.
        if (!confirm('Byt gren till "' + label + '"?\n\nTavlingens klasser nollstalls, eftersom klasserna '
                   + 'tillhor grenen. Du far valja klasser for den nya grenen och spara.')) return;

        btn.disabled = true;
        var prev = btn.textContent;
        btn.textContent = 'Byter…';
        fetch('/umbraco/surface/CompetitionEdit/ChangeCompetitionType', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            credentials: 'same-origin',
            body: JSON.stringify({ competitionId: id, newType: newType })
        })
        .then(function (r) { return r.json(); })
        .then(function (d) {
            btn.textContent = prev;
            if (!d.success) {
                help.className = 'form-text text-danger';
                help.textContent = d.message || 'Grenbytet gick inte.';
                btn.disabled = false;
                return;
            }
            help.className = 'form-text text-success';
            help.textContent = d.message || 'Grenen andrad.';
            sel.dataset.currentType = d.newType || newType;
            // Ladda om modalen sa avsnitten (Faltskytte/Egenbokning) och klasslistan
            // speglar den nya grenen. Att lamna kvar den gamla vyn vore vilseledande.
            if (typeof window.openAdminEditModal === 'function') {
                setTimeout(function () { window.openAdminEditModal(id, false, d.newType); }, 700);
            }
        })
        .catch(function (e) {
            btn.textContent = prev; btn.disabled = false;
            help.className = 'form-text text-danger';
            help.textContent = 'Fel: ' + e;
        });
    };

    // Hamta tillstandet nar modalen fyllts — da finns competitionId i det dolda faltet.
    if (typeof window.populateEditModal === 'function' && !window.__hpskTypeChangeWrapped) {
        window.__hpskTypeChangeWrapped = true;
        var inner = window.populateEditModal;
        window.populateEditModal = function (competition) {
            var r = inner.apply(this, arguments);
            try {
                var id = (competition && competition.id) ||
                         parseInt(document.getElementById('competitionId').value, 10) || 0;
                window.hpskLoadCompetitionTypeState(id);
            } catch (e) { console.warn('grenbyte:', e); }
            return r;
        };
    }
})();
</script>
@* Skytteklassvaljaren — SAMMA som tavlingsguiden. Inkluderas av modalen sjalv sa den
   foljer med aven till CompetitionManagement, dar guiden inte finns. Guardad. *@
@await Html.PartialAsync("_ShootingClassPicker")
<script>
// Oppnar den DELADE klassvaljaren med redigeringen som agare.
//
// ⚠ hiddenId ar 'shootingClassIds' UTAN prefix — det ar name-attributet som hamnar i
// FormData och darmed i payloaden till SaveCompetition. Ett prefix har hade tyst
// andrat vad som sparas.
window.hpskEditOpenClassPicker = function () {
    var typeSel = document.getElementById('edit_competitionTypeSelect');
    var type = (typeSel && typeSel.dataset.currentType) || (typeSel && typeSel.value) || '';
    window.hpskOpenClassPicker({
        hiddenId: 'shootingClassIds',
        cardPrefix: 'edit_',
        type: type,
        title: 'Välj skytteklasser'
    });
};

// Hall kortet i takt med faltet — bade nar modalen fylls och om nagon annan kod
// skriver till faltet.
(function () {
    var sync = function () { window.hpskUpdateClassCard('edit_', 'shootingClassIds'); };
    var hidden = document.getElementById('shootingClassIds');
    if (hidden) hidden.addEventListener('change', sync);
    if (typeof window.populateEditModal === 'function' && !window.__hpskEditClassCardWrapped) {
        window.__hpskEditClassCardWrapped = true;
        var inner = window.populateEditModal;
        window.populateEditModal = function () {
            var r = inner.apply(this, arguments);
            setTimeout(sync, 0);
            return r;
        };
    }
})();
</script>
