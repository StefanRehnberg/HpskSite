// Show error in editor
function showEditorError(message) {
    document.getElementById('editorLoading').classList.add('d-none');
    document.getElementById('editorContent').classList.add('d-none');
    document.getElementById('editorError').classList.remove('d-none');
    document.getElementById('editorErrorMessage').textContent = message;
}

// Load start lists when tab is shown
$(document).ready(function() {
    console.log('CompetitionStartListManagement: Document ready');

    try {
        // Initialize Flatpickr time picker
        if (typeof flatpickr !== 'undefined') {
            flatpickr('#firstStartTime', {
                locale: 'sv',
                enableTime: true,
                noCalendar: true,
                dateFormat: 'H:i',
                time_24hr: true,
                defaultHour: 9,
                defaultMinute: 0
            });
        }

        // Use both tab and pill events, and also check on document ready
        // Support both admin page (#comp-startlists) and standalone page (#startlists)
        $('button[data-bs-target="#comp-startlists"], button[data-bs-target="#startlists"]').on('shown.bs.tab shown.bs.pill click', function () {
            console.log('Start Lists tab activated via jQuery event');
            loadStartLists();
        });

        // Also trigger load on document ready if this tab is active
        if ($('#comp-startlists').hasClass('active') || $('#comp-startlists').hasClass('show') ||
            $('#startlists').hasClass('active') || $('#startlists').hasClass('show')) {
            console.log('Start Lists tab is active on page load');
            loadStartLists();
        }
    } catch (e) {
        console.error('Error in CompetitionStartListManagement initialization:', e);
        // Try to hide loading indicator if there's an error
        const loadingEl = document.getElementById('startListsLoading');
        if (loadingEl) loadingEl.style.display = 'none';
        showStartListsError('Fel vid initialisering av startlistor.');
    }
});

// Fallback: Also listen for pure JavaScript events in case jQuery fails
document.addEventListener('DOMContentLoaded', function() {
    // Add click listeners to tab buttons as fallback
    const tabButtons = document.querySelectorAll('button[data-bs-target="#comp-startlists"], button[data-bs-target="#startlists"]');
    tabButtons.forEach(function(btn) {
        btn.addEventListener('click', function() {
            console.log('Start Lists tab clicked (vanilla JS fallback)');
            // Small delay to let Bootstrap show the tab
            setTimeout(function() {
                loadStartLists();
            }, 100);
        });
    });
});
</script>
