// Global variables for editor
// NOTE: currentStartListId is stored on window object (set in displayOfficialStartList)
let currentStartListConfig = null;
let editorModal = null;

// Track if changes were made in the editor
let editorHasChanges = false;

// Open the start list editor modal
function openStartListEditor(startListId) {
    console.log('Opening editor for start list:', startListId);
    window.currentStartListId = startListId;
    editorHasChanges = false;  // Reset change tracking

    // Get or create modal instance
    const modalElement = document.getElementById('startListEditorModal');
    if (!editorModal) {
        editorModal = new bootstrap.Modal(modalElement);

        // Add event listener to refresh start list display when modal is closed
        modalElement.addEventListener('hidden.bs.modal', function () {
            if (editorHasChanges) {
                console.log('Editor closed with changes - refreshing start list display');
                refreshStartListDisplay();
            }
        });
    }

    // Reset modal state
    document.getElementById('editorLoading').classList.remove('d-none');
    document.getElementById('editorError').classList.add('d-none');
    document.getElementById('editorContent').classList.add('d-none');

    // Show modal
    editorModal.show();

    // Load data
    loadStartListForEditing(startListId);
}

// Refresh the start list iframe display
function refreshStartListDisplay() {
    const iframe = document.getElementById('startListIframe');
    if (iframe && iframe.src) {
        // Add cache-busting parameter to force reload
        const url = new URL(iframe.src, window.location.origin);
        url.searchParams.set('_refresh', new Date().getTime());
        iframe.src = url.toString();
        console.log('Refreshed iframe with URL:', iframe.src);
    }
}

// Load start list data from API
function loadStartListForEditing(startListId) {
    // Add cache-busting parameter to ensure fresh data after edits
    const cacheBuster = new Date().getTime();
    fetch(`/umbraco/surface/PrecisionStartList/GetStartListForEditing?startListId=${startListId}&_=${cacheBuster}`, {
        cache: 'no-store'  // Prevent browser caching
    })
        .then(response => response.json())
        .then(async data => {
            if (data.success) {
                currentStartListConfig = data.configuration;
                // Statuses must be in hand BEFORE rendering — the shooter rows draw their
                // Ej start / Bruten badge straight from window.participantStatusByKey.
                await loadParticipantStatuses();
                displayStartListInEditor(data.configuration, data.isOfficial);
            } else {
                showEditorError(data.message || 'Kunde inte ladda startlistan.');
            }
        })
        .catch(error => {
            console.error('Error loading start list for editing:', error);
            showEditorError('Ett oväntat fel uppstod när startlistan skulle laddas.');
        });
}

// ── DNS / DNF ────────────────────────────────────────────────────────────────
// Marks that a shooter will produce no further results. Consumed by the championship
// särskjutning gate, which must not decide a medal on a tie a later series could still break.

// Keyed "memberId|classid" (lowercased) — mirrors ParticipantStatusService.Key on the server.
window.participantStatusByKey = window.participantStatusByKey || {};

async function loadParticipantStatuses() {
    const competitionId = $('.competition-startlist-management').data('competition-id');
    if (!competitionId) return;
    try {
        const r = await fetch('/umbraco/surface/CompetitionResults/GetParticipantStatuses?competitionId=' + competitionId);
        const d = await r.json();
        const map = {};
        (d.statuses || d.Statuses || []).forEach(s => {
            const mid = s.memberId ?? s.MemberId;
            const cls = (s.shootingClass ?? s.ShootingClass ?? '').toLowerCase();
            map[`${mid}|${cls}`] = { status: s.status ?? s.Status, label: s.label ?? s.Label };
        });
        window.participantStatusByKey = map;
    } catch (e) {
        // A missing status table must not stop the editor from opening — badges simply don't render.
        console.warn('Could not load participant statuses', e);
        window.participantStatusByKey = {};
    }
}

async function setParticipantStatus(memberId, shootingClass, status) {
    const competitionId = $('.competition-startlist-management').data('competition-id');
    const label = status === 'DNS' ? 'ej start' : 'bruten';
    if (!confirm(`Markera skytten som ${label}? Det påverkar resultatlistan.`)) return;

    const token = getAntiForgeryToken();
    if (!token) { showAlert('danger', 'Säkerhetstoken saknas. Försök ladda om sidan.'); return; }

    try {
        const r = await fetch('/umbraco/surface/CompetitionResults/SetParticipantStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId, memberId, shootingClass, status })
        });
        const d = await r.json();
        if (d.success || d.Success) {
            showAlert('success', `Skytten är markerad som ${label}.`);
            loadStartListForEditing(window.currentStartListId);
        } else {
            showAlert('danger', d.message || d.Message || 'Statusen kunde inte sparas.');
        }
    } catch (e) {
        showAlert('danger', 'Ett oväntat fel uppstod när statusen skulle sparas.');
    }
}

async function clearParticipantStatus(memberId, shootingClass) {
    const competitionId = $('.competition-startlist-management').data('competition-id');
    const token = getAntiForgeryToken();
    if (!token) { showAlert('danger', 'Säkerhetstoken saknas. Försök ladda om sidan.'); return; }

    try {
        const r = await fetch('/umbraco/surface/CompetitionResults/ClearParticipantStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId, memberId, shootingClass })
        });
        const d = await r.json();
        if (d.success || d.Success) {
            showAlert('success', 'Statusen är borttagen — skytten räknas som vanligt igen.');
            loadStartListForEditing(window.currentStartListId);
        } else {
            showAlert('warning', d.message || d.Message || 'Hittade ingen status att ta bort.');
        }
    } catch (e) {
        showAlert('danger', 'Ett oväntat fel uppstod när statusen skulle tas bort.');
    }
}

// Display start list in editor
function displayStartListInEditor(configuration, isOfficial) {
    // Hide loading, show content and toolbar
    document.getElementById('editorLoading').classList.add('d-none');
    document.getElementById('editorContent').classList.remove('d-none');
    document.getElementById('editorToolbar').classList.remove('d-none');

    // Show/hide official banner
    const officialBanner = document.getElementById('officialBanner');
    if (isOfficial) {
        officialBanner.classList.remove('d-none');
    } else {
        officialBanner.classList.add('d-none');
    }

    // Display teams as cards
    if (configuration.teams && configuration.teams.length > 0) {
        displayTeamCards(configuration.teams, isOfficial);
        document.getElementById('noTeamsMessage').classList.add('d-none');
    } else {
        document.getElementById('teamCardsContainer').innerHTML = '';
        document.getElementById('noTeamsMessage').classList.remove('d-none');
    }

    // Reset selection state
    clearAllSelections();
}

// Display teams as cards
function displayTeamCards(teams, isOfficial) {
    const container = document.getElementById('teamCardsContainer');
    container.innerHTML = '';

    teams.forEach((team, index) => {
        const teamHtml = createTeamCard(team, index, isOfficial);
        container.insertAdjacentHTML('beforeend', teamHtml);
    });

    // Add event listeners for checkboxes
    container.querySelectorAll('.shooter-checkbox').forEach(cb => {
        cb.addEventListener('change', updateSelectionCount);
    });
}

// Create single team card
function createTeamCard(team, index, isOfficial) {
    const shooterCount = team.shooters ? team.shooters.length : 0;
    const canDeleteTeam = shooterCount === 0;

    // Build shooters list HTML
    let shootersHtml = '';
    if (team.shooters && team.shooters.length > 0) {
        team.shooters.forEach(shooter => {
            // Handle both camelCase (from API) and PascalCase (from raw JSON)
            const clubDisplay = shooter.club || shooter.Club || 'Okänd klubb';
            // The class Id, which is what SetParticipantStatus keys on — read defensively for the
            // same reason clubDisplay is: this JSON reaches us in both casings.
            const shooterWeaponClass = shooter.weaponClass || shooter.WeaponClass || '';
            const pstatus = (window.participantStatusByKey || {})[`${shooter.memberId}|${shooterWeaponClass.toLowerCase()}`];
            const statusBadge = pstatus
                ? `<span class="badge bg-warning text-dark" title="Skytten producerar inga fler resultat">${pstatus.label}</span>`
                : '';
            shootersHtml += `
                <div class="shooter-row d-flex align-items-center p-2 border-bottom" data-member-id="${shooter.memberId}" data-team="${team.teamNumber}">
                    <input type="checkbox" class="form-check-input me-2 shooter-checkbox"
                           data-member-id="${shooter.memberId}" data-team="${team.teamNumber}">
                    <div class="flex-grow-1 min-width-0">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-1">
                            <div class="shooter-info">
                                <strong class="d-block d-sm-inline">${shooter.position}. ${hpskEsc(shooter.name)}</strong>
                                <span class="text-muted d-none d-md-inline ms-2">${hpskEsc(clubDisplay)}</span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="badge bg-info">${hpskEsc(shooter.weaponClass)}</span>
                                ${statusBadge}
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link text-secondary p-1" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="#" onclick="moveShooterPosition(${shooter.memberId}, 'up'); return false;">
                                            <i class="bi bi-arrow-up me-2"></i>Flytta upp
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="moveShooterPosition(${shooter.memberId}, 'down'); return false;">
                                            <i class="bi bi-arrow-down me-2"></i>Flytta ner
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#" onclick="openEditWeaponClassModalFor(this); return false;"
                                               data-member-id="${shooter.memberId}" data-shooter-name="${hpskEsc(shooter.name)}"
                                               data-weapon-class="${hpskEsc(shooter.weaponClass)}" data-team="${team.teamNumber}">
                                            <i class="bi bi-pencil me-2"></i>Ändra vapenklass
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="openMoveShooterModalFor(this); return false;"
                                               data-member-id="${shooter.memberId}" data-shooter-name="${hpskEsc(shooter.name)}"
                                               data-team="${team.teamNumber}">
                                            <i class="bi bi-arrows-move me-2"></i>Flytta till annat lag
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="#" onclick="setParticipantStatus(${shooter.memberId}, '${shooterWeaponClass}', 'DNS'); return false;">
                                            <i class="bi bi-dash-circle me-2"></i>Markera som ej start
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="setParticipantStatus(${shooter.memberId}, '${shooterWeaponClass}', 'DNF'); return false;">
                                            <i class="bi bi-x-octagon me-2"></i>Markera som bruten
                                        </a></li>
                                        <li><a class="dropdown-item" href="#" onclick="clearParticipantStatus(${shooter.memberId}, '${shooterWeaponClass}'); return false;">
                                            <i class="bi bi-arrow-counterclockwise me-2"></i>Ta bort status
                                        </a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="removeShooterFromTeamFor(this); return false;"
                                               data-member-id="${shooter.memberId}" data-shooter-name="${hpskEsc(shooter.name)}"
                                               data-weapon-class="${hpskEsc(shooter.weaponClass)}">
                                            <i class="bi bi-trash me-2"></i>Ta bort
                                        </a></li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <small class="text-muted d-md-none">${hpskEsc(clubDisplay)}</small>
                    </div>
                </div>
            `;
        });
    } else {
        shootersHtml = '<p class="text-muted p-3 mb-0 text-center"><i>Inga skyttar i detta lag</i></p>';
    }

    // Same dual-casing pattern as shooter.club above — server JSON can land as camelCase OR PascalCase.
    const teamLabel = team.label || team.Label || '';
    return `
        <div class="card mb-3 team-card" data-team-number="${team.teamNumber}">
            <div class="card-header py-2">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h6 class="mb-0 d-inline"><strong>Skjutlag ${team.teamNumber}${teamLabel ? ' — ' + escapeHtmlInline(teamLabel) : ''}</strong></h6>
                        <span class="badge bg-secondary ms-2">${shooterCount} skyttar</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge team-time-badge">${team.startTime} - ${team.endTime}</span>
                        <button class="btn btn-sm btn-outline-primary py-0 px-1"
                                onclick="openEditTeamTimesModal(${window.currentStartListId}, ${team.teamNumber}, '${team.startTime}', '${team.endTime}')"
                                title="Redigera skjutlag (namn och tider)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger py-0 px-1"
                                onclick="deleteTeam(${team.teamNumber})"
                                title="${canDeleteTeam ? 'Ta bort lag' : 'Laget måste vara tomt'}"
                                ${canDeleteTeam ? '' : 'disabled'}>
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                ${shootersHtml}
            </div>
            <div class="card-footer py-2">
                <button class="btn btn-sm btn-outline-success w-100" onclick="openAddShooterToTeamModal(${team.teamNumber})">
                    <i class="bi bi-person-plus me-1"></i>Lägg till skytt i detta lag
                </button>
            </div>
        </div>
    `;
}

// Selection management
function updateSelectionCount() {
    const selected = document.querySelectorAll('.shooter-checkbox:checked').length;
    document.getElementById('selectedCount').textContent = selected;
    document.getElementById('moveSelectedBtn').disabled = selected === 0;

    if (selected > 0) {
        document.getElementById('clearSelectionBtn').classList.remove('d-none');
    } else {
        document.getElementById('clearSelectionBtn').classList.add('d-none');
    }
}

function clearAllSelections() {
    document.querySelectorAll('.shooter-checkbox:checked').forEach(cb => {
        cb.checked = false;
    });
    updateSelectionCount();
}

function getSelectedShooters() {
    const selected = [];
    document.querySelectorAll('.shooter-checkbox:checked').forEach(cb => {
        selected.push({
            memberId: parseInt(cb.dataset.memberId),
            currentTeam: parseInt(cb.dataset.team)
        });
    });
    return selected;
}

// Move shooters modal
let moveShootersModal = null;
let currentMoveShooterIds = [];

function openMoveShootersModal() {
    const selected = getSelectedShooters();
    if (selected.length === 0) {
        showAlert('warning', 'Välj minst en skytt att flytta.');
        return;
    }

    currentMoveShooterIds = selected.map(s => s.memberId);
    document.getElementById('moveShooterCount').textContent = selected.length;

    // Populate team select (exclude teams that all selected shooters are already in)
    const teamSelect = document.getElementById('moveTargetTeamSelect');
    teamSelect.innerHTML = '<option value="">-- Välj skjutlag --</option>';
    if (currentStartListConfig && currentStartListConfig.teams) {
        currentStartListConfig.teams.forEach(team => {
            const lbl = team.label || team.Label || '';
            const labelSuffix = lbl ? ' — ' + lbl : '';
            teamSelect.appendChild(new Option(`Skjutlag ${team.teamNumber}${labelSuffix} (${team.startTime})`, String(team.teamNumber)));
        });
    }

    if (!moveShootersModal) {
        moveShootersModal = new bootstrap.Modal(document.getElementById('moveShootersModal'));
    }
    moveShootersModal.show();
}

// Move a single shooter (from dropdown menu)
function openMoveShooterModal(memberId, name, currentTeam) {
    currentMoveShooterIds = [memberId];
    document.getElementById('moveShooterCount').textContent = `1 (${name})`;

    // Populate team select excluding current team
    const teamSelect = document.getElementById('moveTargetTeamSelect');
    teamSelect.innerHTML = '<option value="">-- Välj skjutlag --</option>';
    if (currentStartListConfig && currentStartListConfig.teams) {
        currentStartListConfig.teams.forEach(team => {
            if (team.teamNumber !== currentTeam) {
                const lbl = team.label || team.Label || '';
                const labelSuffix = lbl ? ' — ' + lbl : '';
                teamSelect.appendChild(new Option(`Skjutlag ${team.teamNumber}${labelSuffix} (${team.startTime})`, String(team.teamNumber)));
            }
        });
    }

    if (!moveShootersModal) {
        moveShootersModal = new bootstrap.Modal(document.getElementById('moveShootersModal'));
    }
    moveShootersModal.show();
}

function confirmMoveShooters() {
    if (!confirmIfResultsExist('Flytta skyttar')) return;
    const targetTeam = parseInt(document.getElementById('moveTargetTeamSelect').value);
    if (!targetTeam) {
        showAlert('warning', 'Välj ett lag att flytta till.');
        return;
    }

    const token = getAntiForgeryToken();
    if (!token) {
        showAlert('danger', 'Säkerhetstoken saknas. Försök ladda om sidan.');
        return;
    }

    // Use bulk move if multiple shooters, single move otherwise
    const endpoint = currentMoveShooterIds.length > 1
        ? '/umbraco/surface/PrecisionStartList/BulkMoveShooters'
        : '/umbraco/surface/PrecisionStartList/MoveShooterToTeam';

    const body = currentMoveShooterIds.length > 1
        ? { startListId: window.currentStartListId, memberIds: currentMoveShooterIds, targetTeamNumber: targetTeam }
        : { startListId: window.currentStartListId, memberId: currentMoveShooterIds[0], targetTeamNumber: targetTeam };

    fetch(endpoint, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify(body)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('success', data.message || 'Skyttarna har flyttats.');
            editorHasChanges = true;  // Mark that changes were made
            moveShootersModal.hide();
            clearAllSelections();
            loadStartListForEditing(window.currentStartListId);
        } else {
            showAlert('danger', data.message || 'Kunde inte flytta skyttarna.');
        }
    })
    .catch(error => {
        console.error('Error moving shooters:', error);
        showAlert('danger', 'Ett oväntat fel uppstod.');
    });
}

// Edit weapon class modal
let editWeaponClassModal = null;
let currentEditMemberId = null;
let currentEditTeamNumber = null;  // Track which team the shooter is in
let currentEditOldWeaponClass = null;  // Track original weapon class for registration update

function openEditWeaponClassModal(memberId, name, currentClass, teamNumber) {
    currentEditMemberId = memberId;
    currentEditTeamNumber = teamNumber;  // Store the team number
    currentEditOldWeaponClass = currentClass;  // Store the original class
    document.getElementById('editWeaponShooterName').textContent = name;
    document.getElementById('editWeaponClassSelect').value = currentClass;

    if (!editWeaponClassModal) {
        editWeaponClassModal = new bootstrap.Modal(document.getElementById('editWeaponClassModal'));
    }
    editWeaponClassModal.show();
}

function confirmUpdateWeaponClass() {
    if (!confirmIfResultsExist('\u00c4ndra vapenklass')) return;
    const newClass = document.getElementById('editWeaponClassSelect').value;
    if (!newClass || !currentEditMemberId) {
        showAlert('warning', 'Välj en vapenklass.');
        return;
    }

    // Don't make API call if class hasn't changed
    if (newClass === currentEditOldWeaponClass) {
        editWeaponClassModal.hide();
        return;
    }

    const token = getAntiForgeryToken();
    if (!token) {
        showAlert('danger', 'Säkerhetstoken saknas. Försök ladda om sidan.');
        return;
    }

    fetch('/umbraco/surface/PrecisionStartList/UpdateShooterWeaponClass', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({
            startListId: window.currentStartListId,
            memberId: currentEditMemberId,
            teamNumber: currentEditTeamNumber,  // Include team number to identify correct entry
            oldWeaponClass: currentEditOldWeaponClass,  // Include old class for registration update
            newWeaponClass: newClass
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('success', data.message || 'Vapenklassen har uppdaterats.');
            editorHasChanges = true;  // Mark that changes were made
            editWeaponClassModal.hide();
            loadStartListForEditing(window.currentStartListId);
        } else {
            showAlert('danger', data.message || 'Kunde inte uppdatera vapenklassen.');
        }
    })
    .catch(error => {
        console.error('Error updating weapon class:', error);
        showAlert('danger', 'Ett oväntat fel uppstod.');
    });
}

// Delete team
function deleteTeam(teamNumber) {
    if (!confirmIfResultsExist('Ta bort skjutlag')) return;
    if (!confirm(`Är du säker på att du vill ta bort Skjutlag ${teamNumber}?\n\nOBS: Skjutlaget måste vara tomt.`)) {
        return;
    }

    const token = getAntiForgeryToken();
    if (!token) {
        showAlert('danger', 'Säkerhetstoken saknas. Försök ladda om sidan.');
        return;
    }

    fetch('/umbraco/surface/PrecisionStartList/DeleteTeam', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({
            startListId: window.currentStartListId,
            teamNumber: teamNumber
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('success', data.message || 'Laget har tagits bort.');
            editorHasChanges = true;  // Mark that changes were made
            loadStartListForEditing(window.currentStartListId);
        } else {
            showAlert('danger', data.message || 'Kunde inte ta bort laget.');
        }
    })
    .catch(error => {
        console.error('Error deleting team:', error);
        showAlert('danger', 'Ett oväntat fel uppstod.');
    });
}

// Helper function to get anti-forgery token
function getAntiForgeryToken() {
    return $('input[name="__RequestVerificationToken"]').val() ||
           $('input[name="__RequestVerificationToken"]:first').val() ||
           document.querySelector('input[name="__RequestVerificationToken"]')?.value;
}

// Add shooter to specific team (from card footer button)
function openAddShooterToTeamModal(teamNumber) {
    openAddShooterModal();
    // Pre-select the team
    setTimeout(() => {
        document.getElementById('targetTeam').value = teamNumber;
    }, 100);
}

// Remove shooter from team
// Move shooter up or down by one position within their current team. Calls
// PrecisionStartListController.MoveShooterPosition which swaps with the adjacent shooter
// and renumbers the team's positions. Works for both qualifying and finals lists.
function moveShooterPosition(memberId, direction) {
    const startListId = window.currentStartListId;
    if (!startListId || !memberId) return;

    const token = $('input[name="__RequestVerificationToken"]').val() ||
                  $('input[name="__RequestVerificationToken"]:first').val() ||
                  document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (!token) { showAlert('danger', 'Säkerhetstoken saknas. Försök ladda om sidan.'); return; }

    fetch('/umbraco/surface/PrecisionStartList/MoveShooterPosition', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ startListId: startListId, memberId: memberId, direction: direction })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            editorHasChanges = true;
            loadStartListForEditing(startListId);
        } else {
            showAlert('warning', data.message || 'Kunde inte flytta skyttan.');
        }
    })
    .catch(err => {
        console.error('Error moving shooter position:', err);
        showAlert('danger', 'Ett oväntat fel uppstod.');
    });
}

// ⚠️ These three read the shooter off DATA ATTRIBUTES on the clicked element instead of taking the
// name as an argument built into an onclick. The old form interpolated `shooter.name` into a JS
// string literal inside the attribute and escaped ONLY single quotes — a double quote in a member's
// name terminates the attribute and a trailing backslash escapes the literal's own closing quote,
// i.e. code execution in the organiser's browser from a value the member sets themselves. Identical
// to the Fältskytte "lägg till skytt" onclick fixed in 12e0578; this is its precision-family twin.
// No user text reaches an attribute now — never build a JS literal in an attribute from user text.
function openEditWeaponClassModalFor(el) {
    openEditWeaponClassModal(parseInt(el.dataset.memberId, 10), el.dataset.shooterName,
        el.dataset.weaponClass, parseInt(el.dataset.team, 10));
}
function openMoveShooterModalFor(el) {
    openMoveShooterModal(parseInt(el.dataset.memberId, 10), el.dataset.shooterName,
        parseInt(el.dataset.team, 10));
}
function removeShooterFromTeamFor(el) {
    removeShooterFromTeam(window.currentStartListId, parseInt(el.dataset.memberId, 10),
        el.dataset.shooterName, el.dataset.weaponClass);
}

function removeShooterFromTeam(startListId, memberId, shooterName, shootingClass) {
    if (!confirmIfResultsExist('Ta bort skytt fr\u00e5n lag')) return;
    // Name the CLASS in the dialog. A place on the list is per (skytt, klass), so on a multi-class
    // shooter "ta bort NN från startlistan" does not say which of their starts is about to go.
    const what = shootingClass ? `${shooterName} (${shootingClass})` : shooterName;
    if (!confirm(`Är du säker på att du vill ta bort ${what} från startlistan?\n\nOBS: Detta går inte att ångra.`)) {
        return;
    }

    // Get anti-forgery token
    const token = $('input[name="__RequestVerificationToken"]').val() ||
                  $('input[name="__RequestVerificationToken"]:first').val() ||
                  document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    if (!token) {
        showAlert('danger', 'Säkerhetstoken saknas. Försök ladda om sidan.');
        return;
    }

    fetch('/umbraco/surface/PrecisionStartList/RemoveShooterFromStartList', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({
            startListId: startListId,
            memberId: memberId,
            // Required for a multi-class shooter: the server removes per (member, class) and
            // refuses outright rather than guessing when several placements exist.
            shootingClass: shootingClass || ''
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            showAlert('success', data.message || 'Skyttan har tagits bort.');
            editorHasChanges = true;  // Mark that changes were made
            // Reload editor
            loadStartListForEditing(startListId);
        } else {
            showAlert('danger', data.message || 'Kunde inte ta bort skyttan.');
        }
    })
    .catch(error => {
        console.error('Error removing shooter:', error);
        showAlert('danger', 'Ett oväntat fel uppstod.');
    });
}

