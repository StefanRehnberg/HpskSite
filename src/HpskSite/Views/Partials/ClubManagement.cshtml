function displayClubs(clubs) {
    const tableTemplate = document.getElementById('clubsTableTemplate').innerHTML;
    const rowTemplate = document.getElementById('clubRowTemplate').innerHTML;

    document.getElementById('clubsList').innerHTML = tableTemplate;

    // The PUB-avtal column is only meaningful for site admins (the overview endpoint
    // is site-admin gated); hide it entirely for regional admins.
    const dpaIsSiteAdmin = document.getElementById('clubs')?.dataset.isSiteAdmin === 'true';
    if (!dpaIsSiteAdmin) {
        document.getElementById('clubsList')
            .querySelectorAll('.dpa-col').forEach(el => el.style.display = 'none');
    }

    const tbody = document.getElementById('clubsTableBody');
    tbody.innerHTML = '';

    clubs.forEach(club => {
        // Build contact display - show person and/or email, or "No contact" if both empty
        let contactDisplay = '';
        if (club.contactPerson && club.contactEmail) {
            contactDisplay = `${club.contactPerson}<br><small class="text-muted">${club.contactEmail}</small>`;
        } else if (club.contactPerson) {
            contactDisplay = club.contactPerson;
        } else if (club.contactEmail) {
            contactDisplay = `<small class="text-muted">${club.contactEmail}</small>`;
        } else {
            contactDisplay = '<span class="text-muted">-</span>';
        }

        const row = rowTemplate
            .replace(/{name}/g, club.name || '')
            .replace(/{description}/g, club.description || '')
            .replace(/{kretsDisplay}/g, getKretsDescription(club.regionalFederation))
            .replace(/{regionalFederation}/g, club.regionalFederation || '')
            .replace(/{city}/g, club.city || '-')
            .replace(/{contactDisplay}/g, contactDisplay)
            .replace(/{dpaBadge}/g, dpaIsSiteAdmin ? dpaBadgeHtml(dpaStatusMap[club.id]) : '')
            .replace(/{id}/g, club.id);

        tbody.innerHTML += row;
    });
}

// ===== DPA / PUB-avtal compliance overview (site admins only) =====
let dpaOverview = null;   // full response { summary, clubs, currentVersion }
let dpaStatusMap = {};    // clubId -> { state, version, date, by, name, region }
let dpaPage = 1;          // current page of the (filtered) club list
const DPA_PAGE_SIZE = 25;

function toggleDpaDetails() {
    const details = document.getElementById('dpaDetails');
    const open = details.style.display === 'none';
    details.style.display = open ? '' : 'none';
    document.getElementById('dpaToggleBtn').setAttribute('aria-expanded', open ? 'true' : 'false');
    document.getElementById('dpaToggleIcon').className =
        (open ? 'bi bi-chevron-up' : 'bi bi-chevron-down') + ' me-1';
    document.getElementById('dpaToggleLabel').textContent = open ? 'Dölj klubblista' : 'Visa klubblista';
}

function dpaFilterChanged() {
    dpaPage = 1; // filtering can shrink the list — restart at page 1
    renderDpaOverview();
}

function dpaChangePage(delta) {
    dpaPage += delta;
    renderDpaOverview();
}

function dpaBadgeHtml(entry) {
    if (!entry) return '<span class="text-muted">–</span>';
    if (entry.state === 'current')
        return `<span class="badge bg-success" title="Godkänt ${entry.version || ''} ${entry.date || ''}">Aktuellt</span>`;
    if (entry.state === 'outdated')
        return `<span class="badge bg-warning text-dark" title="Godkände ${entry.version || 'äldre version'} – behöver godkänna det aktuella avtalet på nytt">Äldre (${entry.version || '?'})</span>`;
    return '<span class="badge bg-danger">Ej godkänt</span>';
}

function loadDpaOverview() {
    const isSiteAdmin = document.getElementById('clubs')?.dataset.isSiteAdmin === 'true';
    if (!isSiteAdmin) return; // endpoint is site-admin gated; card stays hidden for others

    fetch('/umbraco/surface/Dpa/GetDpaOverview')
        .then(r => r.json())
        .then(data => {
            if (!data.success) return; // silent — card simply stays hidden
            dpaOverview = data;
            dpaStatusMap = {};
            (data.clubs || []).forEach(c => {
                dpaStatusMap[c.clubId] = {
                    state: c.state, version: c.acceptedVersion,
                    date: c.acceptedDate, by: c.acceptedByName,
                    name: c.clubName, region: c.region
                };
            });
            document.getElementById('dpaCurrentVersion').textContent = 'v' + (data.currentVersion || '');
            document.getElementById('dpaOverviewCard').style.display = '';
            renderDpaOverview();
            applyDpaBadgesToTable();
        })
        .catch(err => console.error('Kunde inte ladda PUB-översikt:', err));
}

function renderDpaOverview() {
    if (!dpaOverview) return;
    const s = dpaOverview.summary || {};
    document.getElementById('dpaCountTotal').textContent = s.total ?? 0;
    document.getElementById('dpaCountCurrent').textContent = s.current ?? 0;
    document.getElementById('dpaCountOutdated').textContent = s.outdated ?? 0;
    document.getElementById('dpaCountNone').textContent = s.none ?? 0;

    const onlyMissing = document.getElementById('dpaOnlyMissing').checked;
    let rows = (dpaOverview.clubs || []);
    if (onlyMissing) rows = rows.filter(c => c.state !== 'current');

    const tbody = document.getElementById('dpaTableBody');
    const wrap = document.getElementById('dpaTableWrap');
    const note = document.getElementById('dpaEmptyNote');
    const pager = document.getElementById('dpaPager');

    if (rows.length === 0) {
        wrap.style.display = 'none';
        pager.style.display = 'none';
        note.style.display = '';
        note.textContent = onlyMissing
            ? 'Alla klubbar har godkänt det aktuella avtalet.'
            : 'Inga klubbar hittades.';
        return;
    }

    // Clamp the page to the available range, then slice.
    const totalPages = Math.max(1, Math.ceil(rows.length / DPA_PAGE_SIZE));
    if (dpaPage > totalPages) dpaPage = totalPages;
    if (dpaPage < 1) dpaPage = 1;
    const start = (dpaPage - 1) * DPA_PAGE_SIZE;
    const pageRows = rows.slice(start, start + DPA_PAGE_SIZE);

    note.style.display = 'none';
    wrap.style.display = '';
    tbody.innerHTML = pageRows.map(c => {
        const by = c.acceptedByName ? escapeDpaHtml(c.acceptedByName) : '<span class="text-muted">–</span>';
        const date = c.acceptedDate || '<span class="text-muted">–</span>';
        return `<tr>
            <td>${escapeDpaHtml(c.clubName)}</td>
            <td>${getKretsDescription(c.region)}</td>
            <td>${dpaBadgeHtml({ state: c.state, version: c.acceptedVersion, date: c.acceptedDate })}</td>
            <td>${by}</td>
            <td>${date}</td>
        </tr>`;
    }).join('');

    // Pager — only when more than one page.
    if (rows.length > DPA_PAGE_SIZE) {
        pager.style.display = '';
        document.getElementById('dpaPagerInfo').textContent =
            `Visar ${start + 1}–${start + pageRows.length} av ${rows.length}`;
        document.getElementById('dpaPrev').disabled = dpaPage <= 1;
        document.getElementById('dpaNext').disabled = dpaPage >= totalPages;
    } else {
        pager.style.display = 'none';
    }
}

function applyDpaBadgesToTable() {
    // Patch badges into any already-rendered club rows (the table may render before
    // the overview fetch resolves).
    document.querySelectorAll('#clubsTableBody td.dpa-col[data-dpa-club]').forEach(td => {
        const id = td.getAttribute('data-dpa-club');
        td.innerHTML = dpaBadgeHtml(dpaStatusMap[id]);
    });
}

function escapeDpaHtml(s) {
    const d = document.createElement('div');
    d.textContent = s == null ? '' : String(s);
    return d.innerHTML;
}

function exportDpaOverviewCsv() {
    if (!dpaOverview || !dpaOverview.clubs) return;
    const stateLabel = { current: 'Aktuellt', outdated: 'Äldre version', none: 'Ej godkänt' };
    const header = ['Klubb', 'Krets', 'Status', 'Godkänd version', 'Godkänd av', 'Datum'];
    const lines = [header];
    dpaOverview.clubs.forEach(c => {
        lines.push([
            c.clubName || '',
            getKretsDescription(c.region) || '',
            stateLabel[c.state] || c.state,
            c.acceptedVersion || '',
            c.acceptedByName || '',
            c.acceptedDate || ''
        ]);
    });
    const csv = lines.map(row =>
        row.map(f => `"${String(f).replace(/"/g, '""')}"`).join(',')
    ).join('\r\n');
    const bom = String.fromCharCode(0xFEFF); // UTF-8 BOM so Excel reads åäö correctly
    const blob = new Blob([bom + csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'pub-avtal-oversikt.csv';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

