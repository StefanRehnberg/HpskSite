@{
    // This partial handles club management UI
}

<div id="clubManagement">
    <!-- Region Filter -->
    <div class="card mb-3 border-primary">
        <div class="card-body py-2">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <label class="form-label fw-bold mb-1">
                        <i class="bi bi-funnel me-1"></i>Filtrera på krets
                    </label>
                    <select class="form-select" id="adminKretsFilter" onchange="filterAdminClubsByKrets()">
                        <option value="">Alla kretsar</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <small class="text-muted">
                        Filtrerar klubblistan efter vald krets
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- DPA (Personuppgiftsbiträdesavtal) compliance overview — site admins only -->
    <div class="card mb-3 border-secondary" id="dpaOverviewCard" style="display:none;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <h5 class="mb-0">
                    <i class="bi bi-shield-check me-1"></i>Personuppgiftsbiträdesavtal (PUB/DPA)
                    <span class="badge bg-light text-dark ms-1" id="dpaCurrentVersion"></span>
                </h5>
                <button class="btn btn-sm btn-outline-secondary" id="dpaToggleBtn" onclick="toggleDpaDetails()" aria-expanded="false">
                    <i class="bi bi-chevron-down me-1" id="dpaToggleIcon"></i><span id="dpaToggleLabel">Visa klubblista</span>
                </button>
            </div>

            <div class="row g-2 text-center mb-2" id="dpaSummary">
                <div class="col"><div class="border rounded py-2"><div class="fs-4 fw-bold" id="dpaCountTotal">–</div><small class="text-muted">Klubbar</small></div></div>
                <div class="col"><div class="border rounded py-2 border-success"><div class="fs-4 fw-bold text-success" id="dpaCountCurrent">–</div><small class="text-muted">Aktuellt avtal</small></div></div>
                <div class="col"><div class="border rounded py-2 border-warning"><div class="fs-4 fw-bold text-warning" id="dpaCountOutdated">–</div><small class="text-muted">Äldre version</small></div></div>
                <div class="col"><div class="border rounded py-2 border-danger"><div class="fs-4 fw-bold text-danger" id="dpaCountNone">–</div><small class="text-muted">Ej godkänt</small></div></div>
            </div>

            <!-- Collapsible, paginated club list (collapsed by default — can be hundreds of rows) -->
            <div id="dpaDetails" style="display:none;">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 my-2">
                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" id="dpaOnlyMissing" onchange="dpaFilterChanged()">
                        <label class="form-check-label small" for="dpaOnlyMissing">Visa endast klubbar utan aktuellt avtal</label>
                    </div>
                    <button class="btn btn-sm btn-outline-secondary" onclick="exportDpaOverviewCsv()" title="Exportera alla rader till CSV">
                        <i class="bi bi-download me-1"></i>CSV
                    </button>
                </div>

                <div class="table-responsive" id="dpaTableWrap" style="display:none;">
                    <table class="table table-sm table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Klubb</th>
                                <th>Krets</th>
                                <th>Status</th>
                                <th>Godkänd av</th>
                                <th>Datum</th>
                            </tr>
                        </thead>
                        <tbody id="dpaTableBody"></tbody>
                    </table>
                </div>
                <p class="text-muted small mb-0 mt-2" id="dpaEmptyNote" style="display:none;"></p>

                <div class="d-flex justify-content-between align-items-center mt-2" id="dpaPager" style="display:none;">
                    <small class="text-muted" id="dpaPagerInfo"></small>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" id="dpaPrev" onclick="dpaChangePage(-1)">
                            <i class="bi bi-chevron-left"></i> Föregående
                        </button>
                        <button class="btn btn-outline-secondary" id="dpaNext" onclick="dpaChangePage(1)">
                            Nästa <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Klubbar</h4>
        <button class="btn btn-success" onclick="showAddClubModal()">
            <i class="bi bi-plus-circle me-1"></i>Ny klubb
        </button>
    </div>

    <div id="clubsList">
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
            <p>Laddar klubbar...</p>
        </div>
    </div>
</div>

<!-- Add/Edit Club Modal -->
<div class="modal fade" id="clubModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clubModalTitle">Lägg till klubb</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="clubForm">
                    <input type="hidden" id="clubManagementId" name="id">
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="clubName" class="form-label">Klubbnamn *</label>
                                <input type="text" class="form-control" id="clubName" name="name" required>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check mt-4">
                                <input class="form-check-input" type="checkbox" id="isActive" name="isActive" checked>
                                <label class="form-check-label" for="isActive">
                                    Aktiv klubb
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="clubIdNumber" class="form-label">Klubb-ID (SPSF)</label>
                                <input type="number" class="form-control" id="clubIdNumber" name="clubIdNumber" placeholder="T.ex. 12345">
                                <div class="form-text">ID-nummer från Svenska Pistolskytteförbundet</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="regionalFederation" class="form-label">Krets</label>
                                <select class="form-select" id="regionalFederation" name="regionalFederation">
                                    <option value="">-- Välj krets --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="clubDescription" class="form-label">Beskrivning</label>
                        <textarea class="form-control" id="clubDescription" name="description" rows="3"></textarea>
                    </div>
                    
                    <h6>Kontaktinformation</h6>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="contactPersonSelect" class="form-label">Kontaktperson</label>
                                <select class="form-control" id="contactPersonSelect" name="contactPersonSelect">
                                    <option value="">-- Välj bland klubbmedlemmar --</option>
                                </select>
                                <input type="hidden" id="contactPerson" name="contactPerson">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="contactEmail" class="form-label">E-post</label>
                                <input type="email" class="form-control" id="contactEmail" name="contactEmail">
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="contactPhone" class="form-label">Telefon</label>
                                <input type="tel" class="form-control" id="contactPhone" name="contactPhone">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="webSite" class="form-label">Webbplats</label>
                                <input type="url" class="form-control" id="webSite" name="webSite" placeholder="https://example.com">
                            </div>
                        </div>
                    </div>

                    <h6>Adress</h6>
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="address" class="form-label">Gatuadress</label>
                                <input type="text" class="form-control" id="address" name="address">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="orgNumber" class="form-label">Organisationsnummer</label>
                                <input type="text" class="form-control" id="orgNumber" name="orgNumber" placeholder="T.ex. 802345-6789">
                                <div class="form-text">Visas på kvitton (t.ex. för friskvårdsbidrag)</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label for="city" class="form-label">Ort</label>
                                <input type="text" class="form-control" id="city" name="city">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label for="postalCode" class="form-label">Postnummer</label>
                                <input type="text" class="form-control" id="postalCode" name="postalCode">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="receiptEmail" class="form-label">E-post på kvitto</label>
                        <input type="email" class="form-control" id="receiptEmail" name="receiptEmail">
                        <div class="form-text">Visas på kvitton. Lämna tom för att använda kontakt-e-posten.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" id="deleteClubBtn" onclick="deleteClubFromModal()" style="display: none;">
                    <i class="bi bi-trash"></i> Ta bort klubb
                </button>
                <div class="ms-auto">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn btn-primary" onclick="saveClub()">Spara klubb</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Club Members Modal -->
<div class="modal fade" id="clubMembersModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clubMembersModalTitle">Klubbmedlemmar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="clubMembersList">
                    <div class="text-center">
                        <div class="spinner-border spinner-border-sm" role="status">
                            <span class="visually-hidden">Laddar...</span>
                        </div>
                        <p>Laddar medlemmar...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Club Deletion Error Modal -->
<div class="modal fade" id="deletionErrorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Kan inte ta bort klubb
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="deletionErrorMessage"></div>
                <div class="mt-3">
                    <strong>För att ta bort den här klubben måste du:</strong>
                    <ol class="mt-2">
                        <li>Gå till Användare-fliken</li>
                        <li>Hitta alla medlemmar kopplade till den här klubben</li>
                        <li>Ta bort medlemmarna eller flytta dem till en annan klubb</li>
                        <li>Försök sedan ta bort klubben igen</li>
                    </ol>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
                <button type="button" class="btn btn-primary" onclick="switchToUserManagement()" data-bs-dismiss="modal">
                    Gå till Användare
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Club Admins Modal -->
<div class="modal fade" id="clubAdminsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="clubAdminsModalTitle">Hantera klubbadministratörer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Nuvarande klubbadministratörer</h6>
                        <div id="currentClubAdmins">
                            <div class="text-center">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                                Laddar...
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <h6>Tilldela ny admin</h6>
                        <div class="mb-3">
                            <label for="clubAdminRegionFilter" class="form-label">Krets</label>
                            <select class="form-select" id="clubAdminRegionFilter" onchange="onClubAdminRegionFilterChange()">
                                <option value="">Välj krets...</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="clubAdminClubFilter" class="form-label">Klubb</label>
                            <select class="form-select" id="clubAdminClubFilter" onchange="onClubAdminClubFilterChange()">
                                <option value="">Välj krets först...</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="availableMembersSelect" class="form-label">Välj medlem</label>
                            <select class="form-select" id="availableMembersSelect">
                                <option value="">Välj klubb först...</option>
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary" id="assignAdminBtn" onclick="assignSelectedAdmin()" disabled>
                            <i class="bi bi-person-plus"></i> Tilldela som admin
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Clubs Table Template -->
<script id="clubsTableTemplate" type="text/template">
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Namn</th>
                    <th>Krets</th>
                    <th>Ort</th>
                    <th>Kontakt</th>
                    <th class="dpa-col">PUB-avtal</th>
                    <th>Åtgärder</th>
                </tr>
            </thead>
            <tbody id="clubsTableBody">
            </tbody>
        </table>
    </div>
</script>

<!-- Club Row Template -->
<script id="clubRowTemplate" type="text/template">
    <tr>
        <td>
            <strong>{name}</strong>
            <br><small class="text-muted">{description}</small>
        </td>
        <td>{kretsDisplay}</td>
        <td>{city}</td>
        <td>{contactDisplay}</td>
        <td class="dpa-col" data-dpa-club="{id}">{dpaBadge}</td>
        <td>
            <button class="btn btn-sm btn-warning me-1" onclick="editClub({id})" title="Redigera klubb">
                <i class="bi bi-pencil"></i>
            </button>
            <button class="btn btn-sm btn-info me-1" onclick="showClubMembers({id}, '{name}')" title="Visa medlemmar">
                <i class="bi bi-people"></i>
            </button>
            <button class="btn btn-sm btn-secondary" onclick="showClubAdmins({id}, '{name}', '{regionalFederation}')" title="Hantera administratörer">
                <i class="bi bi-person-gear"></i>
            </button>
        </td>
    </tr>
</script>

<!-- Club Members Table Template -->
<script id="clubMembersTableTemplate" type="text/template">
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Namn</th>
                    <th>E-post</th>
                    <th>Typ</th>
                </tr>
            </thead>
            <tbody id="clubMembersTableBody">
            </tbody>
        </table>
    </div>
</script>

<script>
// Lazy load club management data
let clubManagementLoaded = false;
let allAdminClubs = []; // Store all clubs for filtering

// Regional Federations data (from Models/Federations.cs)
const regionalFederations = [
    { value: 'Blekinge', description: 'Blekinge Pistolskyttekrets' },
    { value: 'Dalarna', description: 'Dalarnas Pistolskyttekrets' },
    { value: 'Gotland', description: 'Gotlands Pistolskyttekrets' },
    { value: 'Gavleborg', description: 'Gävleborgs Pistolskyttekrets' },
    { value: 'Goteborg', description: 'Göteborg och Bohusläns Pistol.Krets' },
    { value: 'Halland', description: 'Hallands Pistolskyttekrets' },
    { value: 'Jamtland', description: 'Jämtlands Läns Pistolskyttekrets' },
    { value: 'Jonkoping', description: 'Jönköpings Läns Pistolskyttekrets' },
    { value: 'KalmarNorra', description: 'Kalmar Läns Norra Pistolskyttekrets' },
    { value: 'KalmarSodra', description: 'Kalmar Läns Södra Pistolskyttekrets' },
    { value: 'Kristianstad', description: 'Kristianstads Pistolskyttekrets' },
    { value: 'Kronoberg', description: 'Kronobergs Läns Pistolskyttekrets' },
    { value: 'Malmohus', description: 'Malmöhus Pistolskyttekrets' },
    { value: 'Norrbotten', description: 'Norrbottens Pistolskyttekrets' },
    { value: 'Skaraborg', description: 'Skaraborgs Pistolskyttekrets' },
    { value: 'Stockholm', description: 'Stockholms Pistolskyttekrets' },
    { value: 'Sodermanland', description: 'Södermanlands Pistolskyttekrets' },
    { value: 'Uppsala', description: 'Uppsala Läns Pistolskyttekrets' },
    { value: 'Varmland', description: 'Värmlands Pistolskyttekrets' },
    { value: 'Vasterbotten', description: 'Västerbottens Läns Pistolskyttekrets' },
    { value: 'Vasternorrland', description: 'Västernorrlands Läns Pistolskyttekrets' },
    { value: 'VastgotaDal', description: 'Västgöta-Dals Pistolskyttekrets' },
    { value: 'Vastmanland', description: 'Västmanlands Pistolskyttekrets' },
    { value: 'Alvsborg', description: 'Älvsborgs Pistolskyttekrets' },
    { value: 'Orebro', description: 'Örebro Läns Pistolskyttekrets' },
    { value: 'Ostergotland', description: 'Östergötlands Pistolskyttekrets' }
];

function getKretsDescription(value) {
    if (!value) return '';
    const krets = regionalFederations.find(f => f.value === value);
    return krets ? krets.description : value;
}

function populateRegionalFederationsDropdown(selectedValue) {
    const select = document.getElementById('regionalFederation');
    select.innerHTML = '<option value="">-- Välj krets --</option>';
    regionalFederations.forEach(f => {
        const selected = f.value === selectedValue ? 'selected' : '';
        select.innerHTML += `<option value="${f.value}" ${selected}>${f.description}</option>`;
    });
}

function populateAdminKretsFilter() {
    const select = document.getElementById('adminKretsFilter');
    if (!select) return;

    // Get user's default region and managed regions from parent container data attributes
    const clubsTab = document.getElementById('clubs');
    const userDefaultRegion = clubsTab?.dataset.userDefaultRegion || '';
    const isSiteAdmin = clubsTab?.dataset.isSiteAdmin === 'true';
    let managedRegions = [];
    try {
        managedRegions = JSON.parse(clubsTab?.dataset.managedRegions || '[]');
    } catch (e) {
        console.error('Error parsing managed regions:', e);
    }
    const isRegionalAdmin = !isSiteAdmin && managedRegions.length > 0;

    // Show loading state
    select.innerHTML = '<option value="">Laddar kretsar...</option>';
    select.disabled = true;

    // Use the same API endpoint as UserManagement for consistency
    fetch('/umbraco/surface/MemberAdmin/GetRegionsForUserManagement')
        .then(response => response.json())
        .then(data => {
            select.innerHTML = '';
            if (data.success && data.regions && data.regions.length > 0) {
                if (isRegionalAdmin) {
                    // Regional admin - show only their managed regions
                    if (managedRegions.length === 1) {
                        // Single region - show only that region, disabled
                        const regionData = data.regions.find(r => r.id === managedRegions[0]);
                        if (regionData) {
                            const option = document.createElement('option');
                            option.value = regionData.id;
                            option.textContent = regionData.name;
                            option.selected = true;
                            select.appendChild(option);
                        }
                        select.disabled = true;
                    } else {
                        // Multiple regions - show dropdown with their regions
                        data.regions
                            .filter(r => managedRegions.includes(r.id))
                            .forEach((region, index) => {
                                const option = document.createElement('option');
                                option.value = region.id;
                                option.textContent = region.name;
                                if (region.id === userDefaultRegion) {
                                    option.selected = true;
                                } else if (index === 0) {
                                    option.selected = true;
                                }
                                select.appendChild(option);
                            });
                        if (userDefaultRegion && managedRegions.includes(userDefaultRegion)) {
                            select.value = userDefaultRegion;
                        }
                        select.disabled = false;
                    }
                } else {
                    // Site admin - show all regions (no "Alla kretsar" option - too slow with 500+ clubs)
                    let defaultFound = false;
                    data.regions.forEach((region, index) => {
                        const option = document.createElement('option');
                        option.value = region.id;
                        option.textContent = region.name;
                        // Select user's default region, or first if not found
                        if (region.id === userDefaultRegion) {
                            option.selected = true;
                            defaultFound = true;
                        } else if (index === 0 && !defaultFound) {
                            option.selected = true;
                        }
                        select.appendChild(option);
                    });
                    // If user's default was found later in the list, deselect the first one
                    if (defaultFound && userDefaultRegion) {
                        select.value = userDefaultRegion;
                    }
                    select.disabled = false;
                }
                // Load clubs for the selected region
                loadClubs();
            } else {
                select.innerHTML = '<option value="">Inga kretsar hittades</option>';
                loadClubs();
            }
        })
        .catch(error => {
            console.error('Error loading regions:', error);
            // Fallback to hardcoded list if API fails
            select.innerHTML = '';
            if (isRegionalAdmin) {
                // Show only managed regions from fallback
                const filteredFederations = regionalFederations.filter(f => managedRegions.includes(f.value));
                if (filteredFederations.length === 1) {
                    const option = document.createElement('option');
                    option.value = filteredFederations[0].value;
                    option.textContent = filteredFederations[0].description;
                    option.selected = true;
                    select.appendChild(option);
                    select.disabled = true;
                } else {
                    filteredFederations.forEach((f, index) => {
                        const option = document.createElement('option');
                        option.value = f.value;
                        option.textContent = f.description;
                        if (f.value === userDefaultRegion) {
                            option.selected = true;
                        } else if (index === 0) {
                            option.selected = true;
                        }
                        select.appendChild(option);
                    });
                    if (userDefaultRegion && managedRegions.includes(userDefaultRegion)) {
                        select.value = userDefaultRegion;
                    }
                    select.disabled = false;
                }
            } else {
                regionalFederations.forEach((f, index) => {
                    const option = document.createElement('option');
                    option.value = f.value;
                    option.textContent = f.description;
                    if (f.value === userDefaultRegion) {
                        option.selected = true;
                    } else if (index === 0 && !userDefaultRegion) {
                        option.selected = true;
                    }
                    select.appendChild(option);
                });
                if (userDefaultRegion) {
                    select.value = userDefaultRegion;
                }
                select.disabled = false;
            }
