async function loadClubAdminClubFilter(regionCode, preselectClubId) {
    const clubSelect = document.getElementById('clubAdminClubFilter');
    const memberSelect = document.getElementById('availableMembersSelect');

    if (!regionCode) {
        clubSelect.innerHTML = '<option value="">Välj krets först...</option>';
        memberSelect.innerHTML = '<option value="">Välj klubb först...</option>';
        document.getElementById('assignAdminBtn').disabled = true;
        return;
    }

    clubSelect.innerHTML = '<option value="">Laddar klubbar...</option>';

    try {
        const response = await fetch(`/umbraco/surface/ClubAdmin/GetClubsForRegion?region=${encodeURIComponent(regionCode)}`);
        const data = await response.json();
        if (data.success && data.clubs) {
            clubSelect.innerHTML = '<option value="">Alla klubbar i kretsen</option>';
            data.clubs.forEach(club => {
                const selected = club.id == preselectClubId ? ' selected' : '';
                clubSelect.innerHTML += `<option value="${club.id}"${selected}>${club.name}</option>`;
            });
            // Load members for the pre-selected or default club
            loadAvailableMembers(currentClubForAdmins);
        } else {
            clubSelect.innerHTML = '<option value="">Inga klubbar</option>';
        }
    } catch (error) {
        console.error('Error loading clubs for region:', error);
        clubSelect.innerHTML = '<option value="">Fel vid laddning</option>';
    }
}

function onClubAdminRegionFilterChange() {
    const regionCode = document.getElementById('clubAdminRegionFilter').value;
    loadClubAdminClubFilter(regionCode, 0);
}

function onClubAdminClubFilterChange() {
    loadAvailableMembers(currentClubForAdmins);
}

async function loadClubAdmins(clubId) {
    const container = document.getElementById('currentClubAdmins');
    container.innerHTML = '<div class="text-center"><div class="spinner-border spinner-border-sm" role="status"></div> Laddar...</div>';

    try {
        const response = await fetch(`/umbraco/surface/ClubAdmin/GetClubAdmins?clubId=${clubId}`);
        const data = await response.json();

        if (data.success) {
            displayClubAdmins(data.admins);
        } else {
            container.innerHTML = `<div class="alert alert-warning">${data.message}</div>`;
        }
    } catch (error) {
        console.error('Error loading club admins:', error);
        container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av klubbadministratörer</div>';
    }
}

function displayClubAdmins(admins) {
    const container = document.getElementById('currentClubAdmins');

    if (admins.length === 0) {
        container.innerHTML = '<p class="text-muted">Inga klubbadministratörer tilldelade</p>';
        return;
    }

    let html = '<div class="list-group">';
    admins.forEach(admin => {
        html += `
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>${admin.name || 'Okänd'}</strong>
                    <br><small class="text-muted">${admin.email}</small>
                </div>
                <button class="btn btn-sm btn-outline-danger" onclick="removeClubAdmin(${admin.id}, '${admin.name}')">
                    Ta bort
                </button>
            </div>
        `;
    });
    html += '</div>';

    container.innerHTML = html;
}

async function loadAvailableMembers(clubId) {
    const select = document.getElementById('availableMembersSelect');
    const assignBtn = document.getElementById('assignAdminBtn');

    select.innerHTML = '<option value="">Laddar medlemmar...</option>';
    assignBtn.disabled = true;

    const filterClubId = document.getElementById('clubAdminClubFilter').value || '';
    let url = `/umbraco/surface/ClubAdmin/GetAvailableMembersForClubAdmin?clubId=${clubId}`;
    if (filterClubId) {
        url += `&filterClubId=${filterClubId}`;
    }

    try {
        const response = await fetch(url);
        const data = await response.json();

        if (data.success) {
            populateMemberDropdown(data.members);
        } else {
            select.innerHTML = '<option value="">Fel vid laddning av medlemmar</option>';
        }
    } catch (error) {
        console.error('Error loading available members:', error);
        select.innerHTML = '<option value="">Fel vid laddning av medlemmar</option>';
    }
}

function populateMemberDropdown(members) {
    const select = document.getElementById('availableMembersSelect');
    const assignBtn = document.getElementById('assignAdminBtn');

    if (!members || members.length === 0) {
        select.innerHTML = '<option value="">Inga tillgängliga medlemmar</option>';
        assignBtn.disabled = true;
        return;
    }

    let options = '<option value="">Välj en medlem att tilldela...</option>';
    members.forEach(member => {
        options += `<option value="${member.id}" data-name="${member.name}">${member.name} (${member.email})</option>`;
    });

    select.innerHTML = options;

    // Enable assign button when selection changes
    select.onchange = function() {
        assignBtn.disabled = !this.value;
    };
}

function assignSelectedAdmin() {
    const select = document.getElementById('availableMembersSelect');
    const selectedOption = select.options[select.selectedIndex];

    if (!selectedOption.value) {
        alert('Välj en medlem att tilldela som admin.');
        return;
    }

    const memberId = selectedOption.value;
    const memberName = selectedOption.getAttribute('data-name');

    assignClubAdmin(memberId, memberName);
}

async function assignClubAdmin(memberId, memberName) {
    if (!currentClubForAdmins) return;

    try {
        const formData = new FormData();
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        formData.append('__RequestVerificationToken', token);
        formData.append('memberId', memberId);
        formData.append('clubId', currentClubForAdmins);

        const response = await fetch('/umbraco/surface/ClubAdmin/AssignClubAdmin', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            // Refresh the admin list
            loadClubAdmins(currentClubForAdmins);
            // Refresh available members dropdown (removes the newly assigned admin)
            loadAvailableMembers(currentClubForAdmins);
            // Refresh the clubs table to update admin count
            loadClubs();
            // Show success message
            alert(`${memberName} har tilldelats som klubbadmin.`);
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error assigning club admin:', error);
        alert('Fel vid tilldelning av klubbadmin');
    }
}

async function removeClubAdmin(memberId, memberName) {
    if (!confirm(`Ta bort ${memberName} som klubbadmin?`)) return;

    if (!currentClubForAdmins) return;

    try {
        const formData = new FormData();
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        formData.append('__RequestVerificationToken', token);
        formData.append('memberId', memberId);
        formData.append('clubId', currentClubForAdmins);

        const response = await fetch('/umbraco/surface/ClubAdmin/RemoveClubAdmin', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            // Refresh the admin list
            loadClubAdmins(currentClubForAdmins);
            // Refresh available members dropdown (adds the removed admin back)
            loadAvailableMembers(currentClubForAdmins);
            // Refresh the clubs table to update admin count
            loadClubs();
            // Show success message
            alert(`${memberName} har tagits bort som klubbadmin.`);
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error removing club admin:', error);
        alert('Fel vid borttagning av klubbadmin');
    }
}
</script>
