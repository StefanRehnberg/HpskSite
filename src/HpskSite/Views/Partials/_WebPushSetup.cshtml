@*
    Reusable "Aktivera notiser" control. Registers the service worker, requests permission,
    subscribes via PushManager with the server's VAPID public key, and POSTs the subscription.
    Self-contained; safe to include on multiple pages (guards against double-init).
    Renders nothing if the browser doesn't support web push.
*@
@{
    // The "Nya matcher" + "träningsform"-prefs are Träningsmatch-specific. Host pages opt in;
    // competition pages + Min sida pass WebPushShowMatchPrefs=false (unrelated to competitions).
    var wpShowMatchPrefs = (ViewData["WebPushShowMatchPrefs"] as bool?) ?? true;
    // Opt-in only: hide the toggle once subscribed so this surface can't opt OUT. Opting out
    // lives solely on Min sida → Profil (deliberately out-of-the-way). Default false = full toggle.
    var wpOptInOnly = (ViewData["WebPushOptInOnly"] as bool?) ?? false;
}
<div id="webPushSetup" class="d-none">
    <button type="button" id="webPushToggle" class="btn btn-sm btn-outline-primary">
        <i class="bi bi-bell me-1"></i><span id="webPushToggleText">Aktivera notiser</span>
    </button>
    <span id="webPushStatus" class="small text-body-secondary ms-2"></span>

    @if (wpShowMatchPrefs)
    {
        <div id="webPushPrefs" class="d-none mt-2 small">
            <div class="mb-1 d-flex align-items-center gap-2">
                <label for="wpMatchPref" class="mb-0">Nya matcher:</label>
                <select id="wpMatchPref" class="form-select form-select-sm w-auto">
                    <option value="All">Alla matcher</option>
                    <option value="OpenMatchesOnly">Bara öppna matcher</option>
                    <option value="Off">Av</option>
                </select>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="wpRanking" checked>
                <label class="form-check-label" for="wpRanking">Notis när min träningsform förbättras</label>
            </div>
        </div>
    }
</div>

<script>
(function () {
    if (window.__webPushInit) return;
    window.__webPushInit = true;

    function afToken() {
        var el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    var supported = ('serviceWorker' in navigator) && ('PushManager' in window) && ('Notification' in window);
    var wrap = document.getElementById('webPushSetup');
    if (!supported || !wrap) {
        // Still expose a minimal API so callers (e.g. the registration-success prompt) degrade gracefully.
        window.HpskWebPush = window.HpskWebPush || {
            isSupported: false,
            getSubscription: function () { return Promise.resolve(null); },
            subscribe: function () { return Promise.resolve(false); },
            mountRegPrompt: function () {}
        };
        return;
    }
    wrap.classList.remove('d-none');

    // iOS is the only platform that needs the add-to-home-screen tutorial (Android/desktop web push
    // is a single tap). iPadOS 13+ reports as MacIntel with touch, so detect that too.
    var isIOS = /iP(hone|ad|od)/.test(navigator.userAgent) ||
        (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    var optInOnly = @(wpOptInOnly ? "true" : "false"); // hide the toggle once subscribed (no opt-out here)

    var btn = document.getElementById('webPushToggle');
    var txt = document.getElementById('webPushToggleText');
    var status = document.getElementById('webPushStatus');

    function urlB64ToUint8Array(base64String) {
        var padding = '='.repeat((4 - base64String.length % 4) % 4);
        var base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
        var raw = window.atob(base64);
        var out = new Uint8Array(raw.length);
        for (var i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
        return out;
    }

    function setState(subscribed) {
        txt.textContent = subscribed ? 'Notiser på' : 'Aktivera notiser';
        btn.classList.toggle('btn-outline-primary', !subscribed);
        btn.classList.toggle('btn-success', subscribed);
        btn.querySelector('i').className = subscribed ? 'bi bi-bell-fill me-1' : 'bi bi-bell me-1';
        btn.style.display = (subscribed && optInOnly) ? 'none' : '';   // opt-out only via Min sida
        if (!subscribed) { var _pe = document.getElementById('webPushPrefs'); if (_pe) _pe.classList.add('d-none'); }
    }

    function getReg() { return navigator.serviceWorker.register('/sw-push.js'); }

    function loadPrefs() {
        if (!document.getElementById('webPushPrefs')) return; // prefs suppressed on this host page
        getReg().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (sub) {
            if (!sub) { document.getElementById('webPushPrefs').classList.add('d-none'); return; }
            fetch('/umbraco/surface/WebPush/GetPreferences', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': afToken() },
                body: JSON.stringify({ endpoint: sub.endpoint })
            }).then(function (r) { return r.json(); }).then(function (j) {
                if (!j.success) return;
                document.getElementById('wpMatchPref').value = j.matchPref || 'OpenMatchesOnly';
                document.getElementById('wpRanking').checked = j.rankingEnabled !== false;
                document.getElementById('webPushPrefs').classList.remove('d-none');
            }).catch(function () { });
        });
    }

    function savePrefs() {
        getReg().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (sub) {
            if (!sub) return;
            fetch('/umbraco/surface/WebPush/SavePreferences', {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': afToken() },
                body: JSON.stringify({
                    endpoint: sub.endpoint,
                    matchPref: document.getElementById('wpMatchPref').value,
                    rankingEnabled: document.getElementById('wpRanking').checked
                })
            }).catch(function () { });
        });
    }

    function refresh() {
        getReg().then(function (reg) {
            return reg.pushManager.getSubscription();
        }).then(function (sub) { setState(!!sub); if (sub) loadPrefs(); }).catch(function () { });
    }

    // Returns a promise resolving to true when the browser ended up subscribed, false otherwise,
    // so external callers (registration-success prompt) can give their own feedback.
    function subscribe() {
        status.textContent = '';
        if (Notification.permission === 'denied') {
            status.textContent = 'Notiser är blockerade i webbläsaren.';
            return Promise.resolve(false);
        }
        return fetch('/umbraco/surface/WebPush/GetPublicKey', { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (j) {
                if (!j.success || !j.configured || !j.publicKey) { status.textContent = 'Notiser är inte aktiverade på servern än.'; throw 'no-key'; }
                return Notification.requestPermission().then(function (perm) {
                    if (perm !== 'granted') { status.textContent = 'Du måste tillåta notiser.'; throw 'denied'; }
                    return getReg().then(function (reg) {
                        return reg.pushManager.subscribe({
                            userVisibleOnly: true,
                            applicationServerKey: urlB64ToUint8Array(j.publicKey)
                        });
                    });
                });
            })
            .then(function (sub) {
                return fetch('/umbraco/surface/WebPush/Subscribe', {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': afToken() },
                    body: JSON.stringify(sub)
                });
            })
            .then(function () { setState(true); status.textContent = 'Klart! Du får nu notiser.'; loadPrefs(); return true; })
            .catch(function (e) { if (e !== 'no-key' && e !== 'denied') status.textContent = 'Kunde inte aktivera notiser.'; return false; });
    }

    function unsubscribe() {
        getReg().then(function (reg) { return reg.pushManager.getSubscription(); })
            .then(function (sub) {
                if (!sub) { setState(false); return; }
                var endpoint = sub.endpoint;
                return sub.unsubscribe().then(function () {
                    return fetch('/umbraco/surface/WebPush/Unsubscribe', {
                        method: 'POST', credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': afToken() },
                        body: JSON.stringify({ endpoint: endpoint })
                    });
                }).then(function () { setState(false); status.textContent = 'Notiser avstängda.'; });
            }).catch(function () { });
    }

    btn.addEventListener('click', function () {
        getReg().then(function (reg) { return reg.pushManager.getSubscription(); })
            .then(function (sub) { if (sub) unsubscribe(); else subscribe(); });
    });

    var _mp = document.getElementById('wpMatchPref'); if (_mp) _mp.addEventListener('change', savePrefs);
    var _rk = document.getElementById('wpRanking'); if (_rk) _rk.addEventListener('change', savePrefs);

    refresh();

    // Shared API so other surfaces (the registration-success prompt) can reuse this one control
    // instead of duplicating the subscribe flow. There is a single _WebPushSetup per page.
    window.HpskWebPush = {
        isSupported: true,
        isIOS: isIOS,
        getSubscription: function () { return getReg().then(function (r) { return r.pushManager.getSubscription(); }); },
        subscribe: subscribe,
        // Render an "Aktivera notiser" prompt into containerEl — but only for a shooter registering
        // THEMSELVES (isSelf) who is NOT already subscribed on this device. A "Visa hur" tutorial
        // button appears only when window.pnNotisTutorialId is set (i.e. the tutorial node exists).
        mountRegPrompt: function (containerEl, isSelf) {
            if (!isSelf || !containerEl) return;
            getReg().then(function (r) { return r.pushManager.getSubscription(); }).then(function (sub) {
                if (sub) return; // already opted in on this device — don't nag
                var tutId = window.pnNotisTutorialId;
                // Tutorial (add-to-home-screen) is iOS-only; Android/desktop web push is one tap.
                var iosNote = isIOS
                    ? '<p class="small text-body-secondary mt-2 mb-0"><i class="bi bi-apple me-1"></i>På iPhone lägger du först till pistol.nu på hemskärmen — det är ett krav från Apple, inte pistol.nu.</p>'
                    : '';
                var tut = (tutId && isIOS)
                    ? '<div class="mt-2"><button type="button" class="btn btn-outline-secondary btn-sm" onclick="TutorialHelper.open(\'' + tutId + '\')"><i class="bi bi-play-circle me-1"></i>Visa hur på iPhone</button></div>'
                    : '';
                containerEl.innerHTML =
                    '<div class="alert alert-primary mt-4 text-start">' +
                        '<h6 class="mb-1"><i class="bi bi-bell me-1"></i>Aktivera notiser</h6>' +
                        '<p class="small mb-2">Få meddelanden från arrangören — schemaändringar, särskjutning och när resultatlistan publiceras — direkt i telefonen.</p>' +
                        '<button type="button" class="btn btn-primary btn-sm" data-pn-enable><i class="bi bi-bell me-1"></i>Aktivera notiser</button>' +
                        iosNote + tut +
                        '<div class="small mt-2" data-pn-status></div>' +
                    '</div>';
                containerEl.style.display = '';
                var b = containerEl.querySelector('[data-pn-enable]');
                var st = containerEl.querySelector('[data-pn-status]');
                b.addEventListener('click', function () {
                    b.disabled = true;
                    subscribe().then(function (ok) {
                        b.disabled = false;
                        if (ok) { st.textContent = 'Klart! Du får nu notiser.'; b.style.display = 'none'; }
                        else { st.textContent = 'Kunde inte aktivera — kan vara blockerat i webbläsaren.'; }
                    });
                });
            }).catch(function () {});
        }
    };
})();
</script>
