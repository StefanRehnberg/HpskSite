<!-- Transfer Registration Modal — re-points an existing registration (and its
     linked invoices) to a different member. Used when shooter A drops out and
     shooter B takes their spot at the desk. -->
<div class="modal fade" id="transferRegistrationModal" tabindex="-1" aria-labelledby="transferRegistrationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="transferRegistrationModalLabel">
                    <i class="bi bi-arrow-left-right me-2"></i>Överför anmälan
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="transferRegistrationId" />

                <div class="alert alert-light mb-3">
                    <small class="text-muted d-block">Från</small>
                    <strong id="transferFromName"></strong>
