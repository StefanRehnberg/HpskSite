@*
 * Competition-Specific Registration Management Partial View
 * Focused on managing registrations for a single competition
*@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
    var availableShootingClasses = ViewData["AvailableShootingClasses"] ?? new List<object>();
    var availableShootingClassesJson = System.Text.Json.JsonSerializer.Serialize(availableShootingClasses);

    // Walk-in patrol picker (item #5). Only shown for Fältskytte / MagnumFält with rolling
    // start enabled. CompetitionType is on ViewData from the host page; rollingStart is the
    // raw JSON blob — we just probe for the enabled flag.
    var compType = ViewData["CompetitionType"]?.ToString() ?? "Precision";
    var rollingStartRaw = ViewData["RollingStart"]?.ToString() ?? "";
    var rollingStartEnabled = false;
    if ((compType == "Faltskytte" || compType == "MagnumFalt") && !string.IsNullOrEmpty(rollingStartRaw))
    {
        try
        {
            var rs = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(rollingStartRaw);
            rollingStartEnabled = rs?.enabled == true;
        }
        catch { }
    }

    // Walk-in slot picker (item #6). Reuses the same DirektplaceringConfig.Parse helper that
    // the public flow uses, so "enabled" semantics stay aligned.
    var dpRaw = ViewData["DirektplaceringConfig"]?.ToString() ?? "";
    var dpEnabled = HpskSite.Models.DirektplaceringConfig.Parse(dpRaw) != null;

    // Rullande start for Springskytte (item #7). Springskytte has no patrols/skjutlag — each
    // shooter is an individual interval start — so the desk drops a walk-in straight onto a free
    // start TIME in an existing start list (per registered class). No competition-level toggle:
    // it just surfaces whenever a Springskytte start list already exists for the ticked class.
    var springskytteEnabled = compType == "Springskytte";

    // The server's own UTC offset as "+02:00" / "-05:00", handed to the JS timestamp helpers
    // (see the note at the top of the script block). Built here rather than inline in the
    // script because Razor HTML-encodes a "+" in an @() expression — "&#x2B;02:00" produces
    // an Invalid Date and every timestamp silently renders blank.
    var srvOffset = DateTimeOffset.Now.Offset;
    var serverUtcOffset = (srvOffset < TimeSpan.Zero ? "-" : "+")
        + Math.Abs(srvOffset.Hours).ToString("00") + ":" + Math.Abs(srvOffset.Minutes).ToString("00");

    // Springskytte class selector: mirror the public registration modal (tick A/C weapon groups +
    // pick ONE spelled-out age class) instead of a flat checkbox list of composite ids. This makes
    // the two structural mistakes impossible at the desk — two C-classes, or a different age class
    // for A vs C. Derive the offered weapons + age classes from the competition's configured ids.
    var springWeapons = new HashSet<string>();
    var springAgeClasses = new HashSet<string>();
    if (springskytteEnabled)
    {
        try
        {
            using var scDoc = System.Text.Json.JsonDocument.Parse(availableShootingClassesJson);
            foreach (var el in scDoc.RootElement.EnumerateArray())
            {
                var id = el.TryGetProperty("id", out var idp) ? (idp.GetString() ?? "") : "";
                if (string.IsNullOrEmpty(id)) continue;
                var dash = id.IndexOf('-');
                if (dash < 0) { springWeapons.Add(id.Trim()); continue; }
                springWeapons.Add(id.Substring(0, dash).Trim());
                springAgeClasses.Add(id.Substring(dash + 1).Trim());
            }
        }
        catch { }
    }
    var springHasA = springWeapons.Contains("A");
    var springHasC = springWeapons.Contains("C");

    // Deltävling (sub-competition) opt-in. When the competition has a configured name,
    // the walk-in + edit modals render a checkbox so the cashier can opt the shooter in
    // (and the backend recomputes the fee via RegistrationFeeCalculator).
    var subCompetitionName = ViewData["SubCompetitionName"]?.ToString() ?? "";
    var subCompetitionEnabled = !string.IsNullOrWhiteSpace(subCompetitionName);

    // Late lag/stafett registration (efteranmälan av lag). The public page's team buttons go dead
    // at sista anmälningsdag; the desk has no deadline, so these render whenever the competition
    // allows that kind of team at all. Discipline-agnostic — a Precision comp with allowTeams gets
    // the same modal Springskytte does.
    var allowTeams = ViewData["AllowTeams"] as bool? ?? false;
    var allowStafett = ViewData["AllowStafett"] as bool? ?? false;
    var lateTeamEnabled = allowTeams || allowStafett;
    var lateTeamClubsJson = ViewData["ClubsWithRegionsJson"]?.ToString() ?? "[]";
    var lateTeamRegionsJson = "[]";
    if (lateTeamEnabled)
    {
        var regionOptions = Enum.GetValues(typeof(HpskSite.Models.Federations.RegionalFederations))
            .Cast<Enum>()
            .Select(rf => new { code = rf.ToString(), name = HpskSite.Models.Federations.GetDescription(rf) })
            .ToList();
        lateTeamRegionsJson = System.Text.Json.JsonSerializer.Serialize(
            regionOptions,
            new System.Text.Json.JsonSerializerOptions
            {
                Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
            });
    }
}

<!-- Flatpickr (used by the mark-as-paid date picker). Loaded again here so the
     registration tab works standalone even when the start list tab isn't rendered. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<div class="competition-registration-management" data-competition-id="@competitionId" data-competition-club-id="@(ViewData["CompetitionClubId"]?.ToString() ?? "")">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-people me-2"></i>Anmälningar</h4>
        @* One Åtgärder menu instead of a row of buttons. Adding late lag + stafett took the
           header to six side-by-side buttons, which wrapped onto two lines on the desk's
           tablet and made nothing findable.

           Styled as the PAGE-level action menu from Klubbadmin → Medlemmar (btn-primary at
           default size, shadowed menu, min-width) rather than the small outline toggle the
           table ROWS use. That contrast is deliberate: blue-and-large means "acts on this
           whole list", small-and-grey means "acts on this one row". *@
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" id="registrationActionsMenu"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-sliders me-2"></i>Åtgärder
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="registrationActionsMenu" style="min-width: 260px;">
                <li><h6 class="dropdown-header">Anmälningar</h6></li>
                <li>
                    <button class="dropdown-item" type="button" onclick="openWalkInRegistrationModal()">
                        <i class="bi bi-person-plus me-2 text-primary"></i>Anmäl och betala
                    </button>
                </li>
                @if (allowTeams)
                {
                    <li>
                        <button class="dropdown-item" type="button" onclick="openLateTeamModal(false)">
                            <i class="bi bi-people-fill me-2 text-primary"></i>Anmäl lag
                        </button>
                    </li>
                }
                @if (allowStafett)
                {
                    <li>
                        <button class="dropdown-item" type="button" onclick="openLateTeamModal(true)">
                            <i class="bi bi-flag-fill me-2 text-primary"></i>Anmäl stafettlag
                        </button>
                    </li>
                }
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Betalningar</h6></li>
                @* The organiser-side samlingsfaktura. Until 2026-08-20 only the PAYING club could build
                   one, on its own klubbsida — the page the clubs who most need it have never opened. *@
                <li>
                    <button class="dropdown-item" type="button" onclick="openOrganiserConsolidateModal()">
                        <i class="bi bi-receipt-cutoff me-2 text-primary"></i>Samlingsfaktura – en räkning till en klubb
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Kommunikation</h6></li>
                <li>
                    <button class="dropdown-item" type="button" onclick="openSendRemindersModal()">
                        <i class="bi bi-envelope-exclamation me-2 text-warning"></i>Påminnelser – välj mottagare innan du skickar
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" onclick="openParticipantEmails()">
                        <i class="bi bi-envelope me-2 text-primary"></i>E-postlista – adresser att klistra in
                    </button>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Listor</h6></li>
                <li>
                    <button class="dropdown-item" type="button" onclick="openBokforingsUnderlag()">
                        <i class="bi bi-file-earmark-text me-2 text-success"></i>Bokföringsunderlag – utskriftsvänligt
                    </button>
                </li>
                <li>
                    <button class="dropdown-item" type="button" onclick="exportCompetitionRegistrations()">
                        <i class="bi bi-download me-2 text-secondary"></i>Exportera CSV – anmälningar och betalningar
                    </button>
                </li>
            </ul>
        </div>
    </div>

    <!-- Payment Summary Cards. 6 cards across at lg+, 2 per row on mobile/tablet so the
         layout still wraps cleanly. Money totals (Betalat/Väntande) include both
         individual registrations AND teams/stafett (Lag). -->
    <div class="row g-2 mb-3" id="paymentSummaryCards" style="display:none">
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Anmälda Ind.</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="summaryRegCount">0</h4>
                        <small class="text-muted"><span id="summaryUniqueMembers">0</span> unika</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Anmälda Lag</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="summaryTeamCount">0</h4>
                        <small class="text-muted" id="summaryTeamBreakdown">lag/stafett</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Starter</h6>
                    @* Per weapon class, because "104 starter" says nothing about how many banor
                       each group needs. It sits in the same baseline row as the total — where the
                       word "klasser" used to be — because a second line here stretches every card
                       in the row (they are h-100). Clipped rather than wrapped for the same reason;
                       the full list is on the title attribute. Derived from the registrations' own
                       class ids, so Springskytte's composite ids work too. *@
                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <h4 class="card-title mb-0" id="summaryStartsCount">0</h4>
                        <small class="text-muted text-end text-truncate" id="summaryStartsByWeapon"></small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Incheckade</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="summaryCheckedInCount">0</h4>
                        <small class="text-muted">av <span id="summaryCheckedInTotal">0</span> skyttar</small>
                    </div>
                    <div class="progress mt-1" style="height:4px;">
                        <div class="progress-bar bg-success" id="summaryCheckedInBar" style="width:0%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-success">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-success small">Betalat</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0 text-success" id="summaryPaidAmount">0 kr</h4>
                        <small class="text-muted"><span id="summaryPaidCount">0</span> st</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-warning">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-warning small">Väntande</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0 text-warning" id="summaryPendingAmount">0 kr</h4>
                        <small class="text-muted"><span id="summaryPendingCount">0</span> st</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* "Saknar faktura" used to be a permanent sixth card showing 0 almost always. It is now an
       exception row that appears only when there is something to repair — but the repair itself
       must not be lost: an anmälan without an invoice cannot be paid at all, not by the shooter
       and not through a club's samlingsfaktura, because there is nothing to select. The eager
       invoice is created by a background job a few seconds after registration and is best-effort,
       so a recycle or a burst of registrations can lose one silently, and re-registering does NOT
       retry it. The count is also still reachable as a Betalstatus filter. Idempotent. *@
    <div class="alert alert-secondary d-none d-flex align-items-center justify-content-between mb-3" id="missingInvoiceRow">
        <div>
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong><span id="summaryNoInvoiceCount">0</span></strong> anmälningar saknar faktura och kan inte betalas.
        </div>
        <button class="btn btn-sm btn-outline-dark ms-3 flex-shrink-0" id="fixMissingInvoicesBtn"
                onclick="fixMissingInvoices()" title="Skapar fakturor för anmälningar som saknar en">
            <i class="bi bi-wrench-adjustable me-1"></i>Skapa saknade fakturor
        </button>
    </div>

    @if (springskytteEnabled)
    {
        @* Placement warning at the DESK, not just on the Startlistor tab — this is where staff
           stand all day, and a shooter with no starttid is only discovered at the firing line
           otherwise. Links straight to the tab that can fix it. *@
        <div id="deskCoverageBanner" class="alert alert-danger d-none align-items-center justify-content-between mb-3">
            <div id="deskCoverageText"></div>
            <button class="btn btn-sm btn-danger ms-3 flex-shrink-0" onclick="deskGoToStartLists()">
                <i class="bi bi-list-ol me-1"></i>Till startlistor
            </button>
        </div>
    }

    <!-- Search + Filters — six inputs in a single row at lg+ to minimize vertical
         space at the desk. Search matches name, club, and Swish reference (invoice
         number) so a treasurer can paste the reference from a Swish notification
         and jump straight to the right row. -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionRegistrationSearch" class="form-label">
                        <i class="bi bi-search me-1"></i>Sök
                    </label>
                    <input type="text" class="form-control" id="competitionRegistrationSearch"
                           placeholder="Namn, klubb, referens"
                           title="Sök på namn, klubb eller betalningsreferens. Klistra in referensen från banken — även en samlingsfaktura (…-club-…), då visas alla anmälningar som betalningen täcker."
                           oninput="filterCompetitionRegistrations()" autocomplete="off">
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionClassFilterBtn" class="form-label">Klass</label>
                    <!-- Multi-select class filter. Rendered as a Bootstrap dropdown of checkboxes
                         (senior-friendly, no ctrl-click) rather than a native multi-select. Options
                         are populated from the actual registrations by populateShootingClassFilter(),
                         so the list is discipline-agnostic: standard comps show standard classes,
                         Springskytte comps show their composite weapon-ageclasses (e.g. "A-D 21"). -->
                    <div class="dropdown">
                        <button type="button" class="form-select text-start" id="competitionClassFilterBtn"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"
                                title="Filtrera på en eller flera klasser">
                            <span id="competitionClassFilterLabel">Alla klasser</span>
                        </button>
                        <div class="dropdown-menu p-2" id="competitionClassFilterMenu"
                             style="max-height: 320px; overflow-y: auto; min-width: 220px;">
                            <div class="text-muted small px-2 py-1">Inga klasser</div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionClubFilter" class="form-label">Klubb</label>
                    <select class="form-select" id="competitionClubFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla klubbar</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionPreferenceFilter" class="form-label">Startpreferens</label>
                    <select class="form-select" id="competitionPreferenceFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla preferenser</option>
                        <option value="Inget">Inget (ingen preferens)</option>
                        <option value="Tidig Start">Tidig start</option>
                        <option value="Sen Start">Sen start</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionPaymentFilter" class="form-label">Betalstatus</label>
                    <select class="form-select" id="competitionPaymentFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla betalstatus</option>
                        <option value="Paid">Betald</option>
                        <option value="Pending">Väntande</option>
                        <option value="Failed">Misslyckad</option>
                        <option value="Cancelled">Makulerad</option>
                        <option value="Refunded">Återbetald</option>
                        <option value="No Invoice">Saknar faktura</option>
                        <option value="No Fee">Ingen avgift</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionCheckedInFilter" class="form-label">Närvaro</label>
                    <select class="form-select" id="competitionCheckedInFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla</option>
                        <option value="in">Incheckad</option>
                        <option value="out">Ej incheckad</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Registrations Table -->
    <div class="card">
        <div class="card-header" role="button" data-bs-toggle="collapse" data-bs-target="#individualsCollapse" aria-expanded="true" style="cursor:pointer;">
            <h5 class="mb-0 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people me-2"></i>Individuella anmälningar</span>
                <span class="badge bg-secondary" id="individualsCount">0</span>
            </h5>
        </div>
        <div class="collapse show" id="individualsCollapse">
        <div class="card-body">
            <!-- Loading State -->
            <div id="competitionRegistrationsLoading" class="text-center py-4">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Laddar...</span>
                </div>
                <p class="mt-2">Laddar anmälningar...</p>
            </div>

            <!-- Error State -->
            <div id="competitionRegistrationsError" class="alert alert-danger d-none">
                <h6>Fel vid inläsning av anmälningar</h6>
                <p id="competitionRegistrationsErrorMessage"></p>
                <button class="btn btn-outline-danger" onclick="loadCompetitionRegistrations()">Försök igen</button>
            </div>

            <!-- Resolved payment reference (samlingsfaktura / wrong competition / unknown ref).
                 Sits above the table because it explains what the table is currently showing. -->
            <div id="paymentRefBanner" class="alert d-none py-2"></div>

            <!-- Kvittot på vad en sparning gjorde (avgiftsändring, klubbspridning). Detta var
                 alert() förut, vilket LÅSER fliken tills någon klickar OK — en klassändring
                 returnerar alltid en avgiftsnot, så varje klassändring frös bordet. Servern är
                 klar på under en sekund; det som såg ut som en frysning var dialogen. -->
            <div id="deskSaveNotice" class="alert d-none py-2 alert-dismissible fade show"></div>

            <!-- Registrations Table -->
            <div id="competitionRegistrationsTableContainer" class="d-none">
                <div class="table-responsive">
                    <table class="table table-striped table-hover desk-sticky-actions" id="competitionRegistrationsTable">
                        <thead>
                            <tr>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionRegistrations('memberName')">Medlem <span class="sort-ind" data-sort="memberName"></span></th>
                                <th class="sortable-col" style="cursor:pointer; width:130px;" onclick="sortCompetitionRegistrations('memberClub')">Klubb <span class="sort-ind" data-sort="memberClub"></span></th>
                                <th>Klass</th>
                                <th id="subCompColHeader" class="sortable-col" style="display:none; cursor:pointer;" onclick="sortCompetitionRegistrations('isSubCompetition')">Deltävling <span class="sort-ind" data-sort="isSubCompetition"></span></th>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionRegistrations('registrationDate')">Anmälningsdatum <span class="sort-ind" data-sort="registrationDate"></span></th>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionRegistrations('paymentStatus')">Status <span class="sort-ind" data-sort="paymentStatus"></span></th>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionRegistrations('isCheckedIn')">Närvaro <span class="sort-ind" data-sort="isCheckedIn"></span></th>
                                <th class="sortable-col text-center" style="cursor:pointer;" title="Kan nås med push-notis" onclick="sortCompetitionRegistrations('hasPushSubscription')">Notis <span class="sort-ind" data-sort="hasPushSubscription"></span></th>
                                <th class="text-end desk-actions-col">Åtgärder</th>
                            </tr>
                        </thead>
                        <tbody id="competitionRegistrationsTableBody">
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <nav aria-label="Competition registrations pagination">
                    <ul class="pagination justify-content-center" id="competitionRegistrationsPagination">
                    </ul>
                </nav>
            </div>

            <!-- No Results State -->
            <div id="competitionNoRegistrations" class="text-center py-4 d-none">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="text-muted mt-2">Inga anmälningar till den här tävlingen ännu.</p>
            </div>
        </div>
        </div>
    </div>

    <!-- Lag (teams + stafett) — its own collapsible card. Hidden when the competition has no
         teams. Stafett is a kind of team, so both kinds live here, tagged by a Typ badge. -->
    <div class="card mt-3 d-none" id="competitionTeamsSection">
        <div class="card-header" role="button" data-bs-toggle="collapse" data-bs-target="#teamsCollapse" aria-expanded="true" style="cursor:pointer;">
            <h5 class="mb-0 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-people-fill me-2"></i>Lag</span>
                <span class="badge bg-secondary" id="teamsCount">0</span>
            </h5>
        </div>
        <div class="collapse show" id="teamsCollapse">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover desk-sticky-actions">
                        <thead>
                            <tr>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionTeams('teamName')">Lagnamn <span class="team-sort-ind" data-sort="teamName"></span></th>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionTeams('type')">Typ <span class="team-sort-ind" data-sort="type"></span></th>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionTeams('teamClass')">Klass <span class="team-sort-ind" data-sort="teamClass"></span></th>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionTeams('clubName')">Klubb <span class="team-sort-ind" data-sort="clubName"></span></th>
                                <th>Deltagare</th>
                                <th class="sortable-col" style="cursor:pointer;" onclick="sortCompetitionTeams('paymentStatus')">Status <span class="team-sort-ind" data-sort="paymentStatus"></span></th>
                                <th class="text-end desk-actions-col">Åtgärder</th>
                            </tr>
                        </thead>
                        <tbody id="competitionTeamsTableBody"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- E-postlista — a paste target, not a mail client. The organiser's own mail program knows their
     signature, their attachments and their sent-folder; pistol.nu should not try to replace it.
     BCC is what the hint and the mailto both use: a start list is a list of named private people,
     and two hundred addresses in To: hands every one of them to everybody else.
     Same shape as the Bemanning list, deliberately — one idiom for "get the addresses out". -->
<div class="modal fade" id="participantEmailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0"><i class="bi bi-envelope me-2"></i>E-postlista</h5>
                    <div class="small text-muted" id="peSummary"></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-2 mb-2 flex-wrap align-items-center">
                    <button type="button" class="btn btn-sm btn-primary" onclick="peCopy(event)">
                        <i class="bi bi-clipboard me-1"></i>Kopiera adresserna
                    </button>
                    <a class="btn btn-sm btn-outline-secondary" id="peMailto" href="#">
                        <i class="bi bi-envelope-open me-1"></i>Öppna i e-postprogrammet
                    </a>
                    <div class="form-check form-switch ms-auto">
                        <input class="form-check-input" type="checkbox" id="peIncludeTeams" checked onchange="peRender()">
                        <label class="form-check-label small" for="peIncludeTeams">Ta med lagmedlemmar</label>
                    </div>
                </div>
                <textarea class="form-control font-monospace" id="peBox" rows="8" readonly style="font-size:.8rem"></textarea>
                <div class="form-text">
                    Semikolon mellan adresserna — klistra in i <strong>Hemlig kopia (BCC)</strong> så ser
                    inte deltagarna varandras adresser.
                </div>
                <div id="peMissing" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

<!-- Bokföringsunderlag option modal — asks whether to include outstanding payments.
     The default print includes everything (running view); the verifikat-friendly
     variant for the final book-keeping confirmation only lists what was actually paid. -->
<div class="modal fade" id="bokforingsUnderlagModal" tabindex="-1" aria-labelledby="bokforingsUnderlagModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="bokforingsUnderlagModalLabel">
                    <i class="bi bi-file-earmark-text me-2"></i>Bokföringsunderlag
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Vill du inkludera utestående betalningar i underlaget?</p>
                <ul class="small text-muted mb-0">
                    <li><strong>Inkludera utestående</strong> — fullständig översikt som visar både inkomna och utestående betalningar. Bra under tävlingsdagen och vid uppföljning.</li>
                    <li><strong>Endast betalda</strong> — bokföringsverifikat. Endast inkomna betalningar listas. Bra för slutgiltig bokföring.</li>
                </ul>
            </div>
            <div class="modal-footer flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-outline-success" onclick="openBokforingsUnderlagWithMode(true)">
                    <i class="bi bi-list-check me-1"></i>Inkludera utestående
                </button>
                <button type="button" class="btn btn-success" onclick="openBokforingsUnderlagWithMode(false)">
                    <i class="bi bi-receipt me-1"></i>Endast betalda
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Manage Invoice Modal — desk workflow hub for a single registration's payment.
     Replaces the older Betalningsalternativ + Swish-QR modals. Has two visual states
     (action picker / QR display) toggled by JS. Lazily creates the invoice on first
     action when the row is in "No Invoice" state. -->
<div class="modal fade" id="manageInvoiceModal" tabindex="-1" aria-labelledby="manageInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="manageInvoiceModalLabel">
                    <i class="bi bi-wallet2 me-2"></i>Hantera betalning
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <!-- Header strip: shooter, amount, status -->
                <div class="alert alert-light mb-3">
                    <div class="row small">
                        <div class="col-6">
                            <strong>Skytt:</strong> <span id="manageInvoiceShooterName"></span><br>
                            <small class="text-muted" id="manageInvoiceClub"></small>
                        </div>
                        <div class="col-6 text-end">
                            <strong>Belopp:</strong> <span id="manageInvoiceAmount"></span> kr<br>
                            <span id="manageInvoiceStatusBadge"></span>
                        </div>
                    </div>
                    <div class="small text-muted mt-1" id="manageInvoiceRefRow" style="display:none">
                        <i class="bi bi-hash"></i><span id="manageInvoiceRef"></span>
                    </div>
                </div>

                <!-- State A: Action chooser (default) -->
                <div id="manageInvoiceActions">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary btn-lg" onclick="showQrInManageModal()">
                            <i class="bi bi-qr-code me-1"></i>Visa QR-kod
                            <div class="small fw-normal">Skytten skannar koden från din skärm</div>
                        </button>
                        <button type="button" class="btn btn-success btn-lg" onclick="markPaidFromManageModal()">
                            <i class="bi bi-check-circle me-1"></i>Registrera betalning
                            <div class="small fw-normal">Kontant, Swish via app, bankgiro eller annat</div>
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link btn-sm text-muted" onclick="emailQrFromManageModal(this)">
                            <i class="bi bi-envelope me-1"></i>Skicka QR-kod via e-post till skytten
                        </button>
                    </div>
                </div>

                <!-- State B: QR display (toggled when "Visa QR-kod" clicked) -->
                <div id="manageInvoiceQr" style="display:none">
                    <div class="text-center" id="manageInvoiceQrBody">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Laddar QR-kod...</span>
                        </div>
                    </div>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link btn-sm" onclick="backToManageInvoiceActions()">
                            <i class="bi bi-arrow-left me-1"></i>Tillbaka
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Invoice History Modal — read-only audit trail for one invoice. -->
