async function confirmTransferRegistration() {
    const registrationId = parseInt(document.getElementById('transferRegistrationId').value, 10);
    const toMemberId = parseInt(document.getElementById('transferSelectedMemberId').value, 10);
    if (!registrationId || !toMemberId) return;

    const errBox = document.getElementById('transferError');
    errBox.classList.add('d-none');
    const btn = document.getElementById('transferSubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Överför...';

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const response = await fetch('/umbraco/surface/RegistrationAdmin/TransferRegistration', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ registrationId, toMemberId })
        });
        const data = await response.json();
        if (!data.success) {
            errBox.textContent = data.message || 'Kunde inte överföra anmälan';
            errBox.classList.remove('d-none');
            return;
        }
        transferModalInstance?.hide();
