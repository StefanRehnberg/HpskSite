<script>
// ── Timestamps ────────────────────────────────────────────────────────────
// Timestamps come off the wire WITHOUT a timezone designator ("2026-08-05T18:15:48"),
// and JavaScript reads an offset-less datetime as the BROWSER's local time. Two different
// clocks are stored behind that identical shape:
//   • registrationDate — written with DateTime.Now, i.e. the SERVER's local time. Prod runs
//     UTC, so the desk saw 18:15 for a 20:15 registration; dev runs Swedish time, so a fixed
//     "add two hours" would be wrong there. The server's own offset is stamped in below at
//     render time, which makes both environments come out right.
//   • occurredAt (invoice audit trail) — written with DateTime.UtcNow, so it is UTC regardless
//     of where the app runs.
// Both are then rendered in Europe/Stockholm, which is the clock the desk is working to.
// (Caveat: SERVER_UTC_OFFSET is the offset as of page render, so on a dev machine a timestamp
// from the other side of a DST switch can be an hour out. On prod the offset is always +00:00.)
const SERVER_UTC_OFFSET = '@Html.Raw(serverUtcOffset)';
const SWEDISH_DATETIME_FORMAT = {
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Stockholm'
};

function hasExplicitZone(s) {
    return /(Z|[+-]\d{2}:?\d{2})$/.test(s);
}

// For values written with DateTime.Now (server local).
function formatServerLocalDateTime(value) {
    if (!value) return '';
    const s = String(value);
    const d = new Date(hasExplicitZone(s) ? s : s + SERVER_UTC_OFFSET);
    return isNaN(d.getTime()) ? '' : d.toLocaleString('sv-SE', SWEDISH_DATETIME_FORMAT);
}

// For values written with DateTime.UtcNow.
function formatUtcDateTime(value) {
    if (!value) return '';
    const s = String(value);
    const d = new Date(hasExplicitZone(s) ? s : s + 'Z');
    return isNaN(d.getTime()) ? '' : d.toLocaleString('sv-SE', SWEDISH_DATETIME_FORMAT);
}

// Competition Registration Management JavaScript
let competitionRegistrations = [];
let filteredCompetitionRegistrations = [];
let currentCompetitionPage = 1;
const competitionPageSize = 20;
// Name of the competition's optional Deltävling (sub-competition); '' when it has none.
// Drives the conditional "Deltävling" column on the individuals table.
let competitionSubCompetitionName = '';

// Sort state for the individuals table. Empty key = original (load) order.
let competitionSortKey = '';
let competitionSortDir = 1; // 1 = ascending, -1 = descending

// Mirror of HpskSite.Helpers.ClubNameHelper.Shorten — abbreviates the long
// suffix words so the Klubb column stays narrow. Display only; the full name is
// kept on the row (search/filter/dropdown) and shown via the cell's title.
function shortenClubName(name) {
    if (!name) return name;
    // Special cases first — well-known clubs with an established acronym.
    if (name.toLowerCase() === 'göteborgs pistol-och sportskk pistolsektionen') return 'GPSSK';
    return name
        .replace(/Pistolskytteförening/gi, 'PSF')
        .replace(/Pistolskytteklubb/gi, 'PSK')
        .replace(/Pistolskyttar/gi, 'PS')
        .replace(/Pistolklubb/gi, 'PK')
        .replace(/Handeldvapenförening/gi, 'HF')
        .replace(/Sportskytteklubb/gi, 'SSK')
        .replace(/Skytteklubb/gi, 'SK')
        .replace(/Skytteförening/gi, 'SF');
}

// Toggle/choose sort column for the individuals table.
function sortCompetitionRegistrations(key) {
    if (competitionSortKey === key) {
        competitionSortDir = -competitionSortDir;
    } else {
        competitionSortKey = key;
        competitionSortDir = 1;
    }
    applyCompetitionSort();
    currentCompetitionPage = 1;
    displayCompetitionRegistrations();
    updateCompetitionSortIndicators();
}

// Sort filteredCompetitionRegistrations in place by the active key. No-op when no
// key is selected, so the natural load order is preserved until the user clicks.
function applyCompetitionSort() {
    if (!competitionSortKey) return;
    const key = competitionSortKey;
    const dir = competitionSortDir;
    filteredCompetitionRegistrations.sort((a, b) => {
        switch (key) {
            case 'memberName':
                return (a.memberName || '').localeCompare(b.memberName || '', 'sv') * dir;
            case 'memberClub':
                return (a.memberClub || '').localeCompare(b.memberClub || '', 'sv') * dir;
            case 'isSubCompetition':
                return ((a.isSubCompetition ? 1 : 0) - (b.isSubCompetition ? 1 : 0)) * dir;
            case 'registrationDate':
                return ((new Date(a.registrationDate).getTime() || 0) - (new Date(b.registrationDate).getTime() || 0)) * dir;
            case 'paymentStatus':
                return (a.paymentStatus || '').localeCompare(b.paymentStatus || '', 'sv') * dir;
            default:
                return 0;
        }
    });
}

// Paint the ▲/▼ arrow on the active sort column header.
function updateCompetitionSortIndicators() {
    document.querySelectorAll('#competitionRegistrationsTable .sort-ind').forEach(el => {
        const k = el.getAttribute('data-sort');
        el.textContent = (k === competitionSortKey) ? (competitionSortDir === 1 ? ' ▲' : ' ▼') : '';
    });
}

// Helper function to get payment status badge class
function getPaymentStatusBadgeClass(status) {
    switch(status) {
        case 'Paid':
            return 'bg-success';
        case 'Pending':
            return 'bg-warning';
        case 'Failed':
        case 'Cancelled':
        case 'Refunded':
            return 'bg-danger';
        case 'No Invoice':
            return 'bg-danger';
        case 'No Fee':
            return 'bg-secondary';
        default:
            return 'bg-secondary';
    }
}

// Helper function to get payment status display text in Swedish
function getPaymentStatusText(status) {
    switch(status) {
        case 'Paid':
            return 'Betald';
        case 'Pending':
            return 'Väntande';
        case 'Failed':
            return 'Misslyckad';
        case 'Cancelled':
            return 'Makulerad';
        case 'Refunded':
            return 'Återbetald';
        case 'No Invoice':
            return 'Saknar faktura';
        case 'No Fee':
            return 'Ingen avgift';
        case 'Unknown':
            return 'Okänd';
        default:
            return status;
    }
}

// Load registrations when tab is shown
function loadCompetitionRegistrations() {
    showCompetitionLoading();
    const currentCompetitionId = $('.competition-registration-management').data('competition-id');

    fetch(`/umbraco/surface/Competition/GetCompetitionRegistrations?competitionId=${currentCompetitionId}`, {
        method: 'GET',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            competitionRegistrations = data.registrations || [];
            competitionSubCompetitionName = data.subCompetitionName || '';
            const ic = document.getElementById('individualsCount');
            if (ic) ic.textContent = competitionRegistrations.length;
            populateCompetitionClubFilter();
            populateShootingClassFilter();
            updatePaymentSummary();
            filterCompetitionRegistrations();
        } else {
            showCompetitionError(data.message || 'Failed to load registrations');
        }
    })
    .catch(error => {
        console.error('Error loading competition registrations:', error);
        showCompetitionError('Failed to load registrations. Please try again.');
    });

    // Teams/relay live in their own section; load them alongside individuals so they also
    // refresh after a payment is recorded (which re-runs loadCompetitionRegistrations).
    loadCompetitionTeams();
}

// ==================== Lag (teams + stafett) ====================
let competitionTeams = [];

// Sort state for the teams table. Empty key = original (load) order.
let teamSortKey = '';
let teamSortDir = 1; // 1 = ascending, -1 = descending

function sortCompetitionTeams(key) {
    if (teamSortKey === key) {
        teamSortDir = -teamSortDir;
    } else {
        teamSortKey = key;
        teamSortDir = 1;
    }
    renderCompetitionTeams();
    updateTeamSortIndicators();
}

// Paint the ▲/▼ arrow on the active teams sort column header.
function updateTeamSortIndicators() {
    document.querySelectorAll('#competitionTeamsSection .team-sort-ind').forEach(el => {
        const k = el.getAttribute('data-sort');
        el.textContent = (k === teamSortKey) ? (teamSortDir === 1 ? ' ▲' : ' ▼') : '';
    });
}

// Desk-side placement warning. Same coverage data the Startlistor tab shows, condensed to one
// line: the desk needs to know that what it just registered has nowhere to start.
async function refreshDeskCoverageBanner() {
    const banner = document.getElementById('deskCoverageBanner');
    if (!banner) return; // non-Springskytte
    try {
        const cid = $('.competition-registration-management').data('competition-id');
        const cov = await fetch(`/umbraco/surface/Springskytte/GetStartListCoverage?competitionId=${cid}`)
            .then(r => r.json());
        if (!cov.success) { banner.classList.add('d-none'); return; }

        const ind = cov.individuals || { total: 0, placed: 0, byWeapon: [] };
        const staf = cov.stafett || { total: 0, placed: 0, missing: [] };
        const indMissing = Math.max(0, (ind.total || 0) - (ind.placed || 0));
        const stafMissing = (staf.missing || []).length;

        if (indMissing === 0 && stafMissing === 0) {
            banner.classList.add('d-none');
            banner.classList.remove('d-flex');
            return;
        }

        const parts = [];
        if (indMissing > 0) {
            const perWc = (ind.byWeapon || [])
                .filter(w => w.placed < w.total)
                .map(w => `${w.weaponClass} ${w.total - w.placed}`)
                .join(', ');
            parts.push(`<strong>${indMissing} start${indMissing === 1 ? '' : 'er'} utan starttid</strong>`
                     + (perWc ? ` (${perWc})` : ''));
        }
        if (stafMissing > 0) parts.push(`<strong>${stafMissing} stafettlag utan startlista</strong>`);

        document.getElementById('deskCoverageText').innerHTML =
            '<i class="bi bi-exclamation-triangle me-1"></i>' + parts.join(' · ')
            + ' — de saknas på startlistan.';
        banner.classList.remove('d-none');
        banner.classList.add('d-flex');
    } catch (err) {
        console.warn('Could not refresh desk coverage banner:', err);
    }
}

// The tab buttons live in the host page (CompetitionManagement.cshtml), so switch via Bootstrap.
function deskGoToStartLists() {
    const tabBtn = document.querySelector('[data-bs-target="#startlists"], #startlists-tab');
    if (tabBtn && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(tabBtn).show(); }
    else { alert('Öppna fliken Startlistor för att lägga till de som saknas.'); }
}

function loadCompetitionTeams() {
    const cid = $('.competition-registration-management').data('competition-id');
    fetch(`/umbraco/surface/RegistrationAdmin/GetCompetitionTeams?competitionId=${cid}`)
        .then(r => r.json())
        .then(data => {
            competitionTeams = (data.success && data.teams) ? data.teams : [];
            // Teams arrive after the individuals, so re-run the club list now that their
            // clubs are known (see the note in populateCompetitionClubFilter).
            populateCompetitionClubFilter();
            renderCompetitionTeams();
            refreshDeskCoverageBanner();
        })
        .catch(err => {
            console.error('Error loading teams:', err);
            competitionTeams = [];
            renderCompetitionTeams();
        });
}

// Reads the same inputs as filterCompetitionRegistrations so the two lists can never drift apart.
function filterCompetitionTeams(teams) {
    const clubFilter = document.getElementById('competitionClubFilter')?.value || '';
    const paymentFilter = document.getElementById('competitionPaymentFilter')?.value || '';
    const searchTerm = (document.getElementById('competitionRegistrationSearch')?.value || '').trim().toLowerCase();
    if (!clubFilter && !paymentFilter && !searchTerm) return teams;

    return teams.filter(t => {
        if (clubFilter && t.clubName !== clubFilter) return false;
        if (paymentFilter && (t.paymentStatus || 'No Invoice') !== paymentFilter) return false;
        if (searchTerm) {
            const haystack = [
                t.teamName || '',
                t.clubName || '',
                t.teamClass || '',
                ...(t.members || []).map(m => m.name || '')
            ].join(' ').toLowerCase();
            if (!haystack.includes(searchTerm)) return false;
        }
        return true;
    });
}

function renderCompetitionTeams() {
    const section = document.getElementById('competitionTeamsSection');
    const tbody = document.getElementById('competitionTeamsTableBody');
    if (!section || !tbody) return;

    // Teams load asynchronously after individuals; recompute the summary cards so the
    // money totals + "Anmälda Lag" count include teams once they arrive.
    updatePaymentSummary();

    // Apply the desk's filters to teams too. Sök matches the team name, its club and its
    // members' names; Klubb and Betalstatus map straight across. Klass / Startpreferens /
    // Närvaro are individual-only concepts and are deliberately NOT applied — a team has no
    // check-in and its teamClass lives in a different id space than the shooters' classes.
    const teamsFiltered = filterCompetitionTeams(competitionTeams);

    const countEl = document.getElementById('teamsCount');
    if (countEl) {
        countEl.textContent = teamsFiltered.length === competitionTeams.length
            ? competitionTeams.length
            : `${teamsFiltered.length} av ${competitionTeams.length}`;
    }

    // Keep the card visible while filtered-to-empty, so "no hits" reads as a filter result
    // rather than as a competition without teams.
    if (!competitionTeams.length) {
        section.classList.add('d-none');
        tbody.innerHTML = '';
        return;
    }
    section.classList.remove('d-none');

    if (!teamsFiltered.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">Inga lag matchar filtret.</td></tr>';
        return;
    }

    // Sort a copy by the active key (the natural load order is preserved until a header click).
    let teamRows = teamsFiltered.slice();
    if (teamSortKey) {
        const dir = teamSortDir;
        teamRows.sort((a, b) => {
            switch (teamSortKey) {
                case 'teamName':
                    return (a.teamName || '').localeCompare(b.teamName || '', 'sv') * dir;
                case 'type':
                    return ((a.isRelay ? 1 : 0) - (b.isRelay ? 1 : 0)) * dir;
                case 'teamClass':
                    return (a.teamClass || '').localeCompare(b.teamClass || '', 'sv') * dir;
                case 'clubName':
                    return (a.clubName || '').localeCompare(b.clubName || '', 'sv') * dir;
                case 'paymentStatus':
                    return (a.paymentStatus || '').localeCompare(b.paymentStatus || '', 'sv') * dir;
                default:
                    return 0;
            }
        });
    }

    tbody.innerHTML = teamRows.map(t => {
        const typeBadge = t.isRelay
            ? '<span class="badge bg-primary">Stafett</span>'
            : '<span class="badge bg-info">Lag</span>';
        const members = (t.members && t.members.length)
            ? t.members.map(m => `${escapeHtmlSafe(m.name)}${m.isSpare ? ' <span class="badge bg-secondary">Reserv</span>' : ''}`).join('<br>')
            : '<span class="text-muted fst-italic">Ej valda än</span>';
        const statusBadge = `<span class="badge ${getPaymentStatusBadgeClass(t.paymentStatus)}">${getPaymentStatusText(t.paymentStatus)}</span>`;

        // Mirror the individual rows' Åtgärder exactly: Redigera (rename) + Hantera betalning +
        // Markera som betald (only when Pending) + Betalningshistorik (when an invoice exists),
        // with the destructive Ta bort pinned to the right so it stays in a fixed position.
        const nameArg = JSON.stringify(t.teamName).replace(/"/g, '&quot;');
        const editBtn = `<button class="btn btn-sm btn-outline-primary" onclick="editTeam(${t.id})" title="Redigera lag — namn och deltagare"><i class="bi bi-pencil"></i></button>`;
        const walletBtn = (t.paymentStatus !== 'No Fee')
            ? `<button class="btn btn-sm btn-outline-success" onclick="showPaymentOptionsForTeam(${t.id})" title="Hantera betalning"><i class="bi bi-wallet2"></i></button>`
            : '';
        const markBtn = (t.paymentStatus === 'Pending')
            ? `<button class="btn btn-sm btn-success" onclick="markTeamAsPaid(${t.id})" title="Markera som betald"><i class="bi bi-check-circle"></i></button>`
            : '';
        const histBtn = renderHistoryButton(t.invoiceId, nameArg, t.lastReminderSentDate, t.reminderCount);

        return `<tr>
            <td><strong>${escapeHtmlSafe(t.teamName)}</strong></td>
            <td>${typeBadge}</td>
            <td>${escapeHtmlSafe(t.teamClass)}</td>
            <td style="font-size:0.85em; max-width:150px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtmlSafe(t.clubName || '')}">${escapeHtmlSafe(shortenClubName(t.clubName || ''))}</td>
            <td class="small">${members}</td>
            <td>${statusBadge}</td>
            <td>
                <div class="d-flex justify-content-between align-items-center gap-1">
                    <div class="d-flex gap-1">${editBtn}${walletBtn}${markBtn}${histBtn}</div>
                    <button class="btn btn-sm btn-outline-danger" onclick="confirmDeleteTeam(${t.id})" title="Ta bort laget">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        </tr>`;
    }).join('');
}

function escapeHtmlSafe(s) {
    const d = document.createElement('div');
    d.textContent = s == null ? '' : String(s);
    return d.innerHTML;
}

// Build the "Betalningshistorik" button. When a payment reminder has already gone out for
// this invoice we tint the button (info instead of the neutral secondary) and spell out
// when / how many times in the tooltip, so the operator can tell at a glance who has
// already been chased before opening the full history. `nameArg` is the member/team name
// pre-stringified + &quot;-escaped by the caller (passed straight into the onclick).
function renderHistoryButton(invoiceId, nameArg, lastReminderSentDate, reminderCount) {
    if (!invoiceId) return '';
    let cls = 'btn-outline-secondary';
    let title = 'Visa betalningshistorik';
    if (lastReminderSentDate) {
        cls = 'btn-outline-info';
        const when = formatUtcDateTime(lastReminderSentDate);
        const n = reminderCount || 1;
        title = `Påminnelse skickad ${when}${n > 1 ? ` (${n} st)` : ''} – visa betalningshistorik`;
    }
    return `<button class="btn btn-sm ${cls}" onclick="showInvoiceHistory(${invoiceId}, ${nameArg})" title="${title.replace(/"/g, '&quot;')}"><i class="bi bi-clock-history"></i></button>`;
}

// Edit a team from the desk = rename it. The full roster editor lives on the public
// competition page; here the common need is correcting the name. We post the current
// roster back unchanged (UpdateTeam replaces all members) so only the name changes.
// Open the team editor: name + roster. Roster candidates are the team's club's members who
// are registered for this competition, unioned with whoever is already on the team (so a
// member who was named on a deferred roster but has no individual registration still shows).
async function editTeam(teamId) {
    const team = competitionTeams.find(t => t.id === teamId);
    if (!team) { alert('Laget hittades inte.'); return; }

    document.getElementById('editTeamId').value = team.id;
    document.getElementById('editTeamName').value = team.teamName || '';
    document.getElementById('editTeamClass').value = team.teamClass || '';
    const errBox = document.getElementById('editTeamRosterError');
    errBox.classList.add('d-none');
    errBox.textContent = '';

    const listEl = document.getElementById('editTeamRosterList');
    listEl.innerHTML = '<div class="text-muted small">Hämtar medlemmar…</div>';
    new bootstrap.Modal(document.getElementById('competitionEditTeamModal')).show();

    const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
    const current = (team.members || []).filter(m => m.memberId > 0);
    const currentIds = new Set(current.map(m => m.memberId));
    const spare = current.find(m => m.isSpare);

    let candidates = [];
    try {
        const resp = await fetch(
            `/umbraco/surface/CompetitionTeam/GetRegisteredMembersForClub?competitionId=${competitionId}&clubId=${team.clubId}`);
        const data = await resp.json();
        if (data && data.success && Array.isArray(data.members)) candidates = data.members;
    } catch (err) {
        console.warn('Could not load club members for team roster:', err);
    }

    // Union in anyone already on the team who isn't in the registered list — never let opening
    // the editor be a way to silently drop an existing member.
    const seen = new Set(candidates.map(c => c.memberId));
    current.forEach(m => {
        if (!seen.has(m.memberId)) {
            candidates.push({ memberId: m.memberId, name: m.name, shootingClasses: '', notRegistered: true });
        }
    });
    candidates.sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'sv'));

    document.getElementById('editTeamRosterHint').textContent = candidates.length
        ? 'Bocka i vilka som ingår i laget. Markera eventuell reserv i högerkolumnen.'
        : 'Inga medlemmar från klubben är anmälda till tävlingen än.';

    if (candidates.length === 0) {
        listEl.innerHTML = '<div class="text-muted small">Inga medlemmar att välja.</div>';
        return;
    }

    listEl.innerHTML = `
        <div class="d-flex fw-bold small text-muted border-bottom pb-1 mb-1">
            <div class="flex-grow-1">Medlem</div><div style="width:70px" class="text-center">Reserv</div>
        </div>` +
        candidates.map(c => {
            const checked = currentIds.has(c.memberId) ? 'checked' : '';
            const isSpare = spare && spare.memberId === c.memberId ? 'checked' : '';
            const warn = c.notRegistered
                ? ' <span class="badge bg-warning text-dark" title="Medlemmen har ingen individuell anmälan till tävlingen">ej anmäld</span>'
                : '';
            const cls = c.shootingClasses
                ? ` <span class="text-muted small">${escapeHtmlSafe(c.shootingClasses)}</span>` : '';
            return `
            <div class="d-flex align-items-center py-1">
                <div class="form-check flex-grow-1 mb-0">
                    <input class="form-check-input team-member-cb" type="checkbox"
                           id="teamMem_${c.memberId}" value="${c.memberId}" ${checked}>
                    <label class="form-check-label" for="teamMem_${c.memberId}">
                        ${escapeHtmlSafe(c.name)}${cls}${warn}
                    </label>
                </div>
                <div style="width:70px" class="text-center">
                    <input class="form-check-input team-spare-radio" type="radio" name="editTeamSpare"
                           value="${c.memberId}" ${isSpare}>
                </div>
            </div>`;
        }).join('');

    // Unticking a member must also clear them as reserv — otherwise the save would send a
    // spareId that isn't in memberIds.
    listEl.addEventListener('change', (e) => {
        if (!e.target.classList.contains('team-member-cb') || e.target.checked) return;
        const radio = listEl.querySelector(`.team-spare-radio[value="${e.target.value}"]`);
        if (radio && radio.checked) radio.checked = false;
    });
}

async function saveTeamChanges() {
    const teamId = parseInt(document.getElementById('editTeamId').value, 10);
    const team = competitionTeams.find(t => t.id === teamId);
    const errBox = document.getElementById('editTeamRosterError');
    const showErr = (msg) => { errBox.textContent = msg; errBox.classList.remove('d-none'); };
    errBox.classList.add('d-none');

    const teamName = (document.getElementById('editTeamName').value || '').trim();
    if (!teamName) { showErr('Lagnamnet får inte vara tomt.'); return; }

    const memberIds = Array.from(document.querySelectorAll('#editTeamRosterList .team-member-cb:checked'))
        .map(cb => parseInt(cb.value, 10));
    const spareEl = document.querySelector('#editTeamRosterList .team-spare-radio:checked');
    let spareId = spareEl ? parseInt(spareEl.value, 10) : null;
    if (spareId != null && !memberIds.includes(spareId)) spareId = null;

    try {
        const resp = await fetch('/umbraco/surface/CompetitionTeam/UpdateTeam', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ teamId, teamName, memberIds, spareId })
        });
        const data = await resp.json();
        if (data && data.success) {
            bootstrap.Modal.getInstance(document.getElementById('competitionEditTeamModal')).hide();
            loadCompetitionTeams();
        } else {
            // Roster rules (min/max size, duplicate name) come back as messages — keep the modal
            // open so the operator can correct the selection instead of losing their edits.
            showErr((data && data.message) || 'Kunde inte uppdatera laget.');
        }
    } catch (err) {
        showErr('Ett fel uppstod: ' + err.message);
    }
}

function confirmDeleteTeam(teamId) {
    const team = competitionTeams.find(t => t.id === teamId);
    const label = team ? `"${team.teamName}" (${team.isRelay ? 'stafett' : 'lag'})` : 'laget';
    if (confirm(`Är du säker på att du vill ta bort ${label}? Åtgärden kan inte ångras.`)) {
        deleteTeamById(teamId);
    }
}

async function deleteTeamById(teamId) {
    try {
