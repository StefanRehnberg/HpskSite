<!-- Send Payment Reminders Modal — bulk action with confirmation. -->
<div class="modal fade" id="sendRemindersModal" tabindex="-1" aria-labelledby="sendRemindersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="sendRemindersModalLabel">
                    <i class="bi bi-envelope-exclamation me-2"></i>Skicka betalningspåminnelser
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p>Maila en Swish QR-påminnelse till valda skyttar med <strong>Väntande</strong> betalningsstatus.</p>

                <div class="mb-3" id="sendRemindersInfo">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-1 mb-1">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary" onclick="reminderSelectAll(true)">Markera alla</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="reminderSelectAll(false)">Avmarkera alla</button>
                            <button type="button" class="btn btn-outline-secondary" id="reminderDeselectRemindedBtn" onclick="reminderUncheckAlreadyReminded()">Avmarkera redan påminda</button>
                        </div>
                        <span id="sendRemindersSelectedInfo" class="small text-muted fw-bold">…</span>
                    </div>
                    <div id="sendRemindersRecipients" class="border rounded" style="max-height: 240px; overflow-y: auto;">
                        <div class="text-center py-3 text-muted">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>Laddar mottagare...
                        </div>
                    </div>
                    <small class="text-muted d-block mt-1">Bocka ur de skyttar som inte ska få en påminnelse. Lagbetalningar och skyttar utan e-postadress visas inte.</small>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label for="sendRemindersMessage" class="form-label mb-0">Meddelande</label>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none"
                                id="sendRemindersResetBtn" onclick="resetReminderMessage()">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Återställ standardtext
                        </button>
                    </div>
                    <textarea class="form-control" id="sendRemindersMessage" rows="6"
                              placeholder="t.ex. ”Tre dagar kvar till tävlingen — vänligen betala för att behålla din plats.”"></textarea>
                    <small class="form-text text-muted">Förifyllt med standardmeddelandet — ändra fritt. Lämnas fältet tomt används standardmeddelandet. Länkar (http/https) blir klickbara i mejlet.</small>
                </div>

                <div class="border-top pt-3 mb-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="sendTestReminderBtn" onclick="sendTestReminder()">
                        <i class="bi bi-envelope-check me-1"></i>Skicka testpåminnelse till mig
                    </button>
                    <small class="form-text text-muted d-block mt-1">
                        Skickar ett exempelmejl till din egen e-postadress så du ser hur det ser ut — påverkar inga skyttar.
                    </small>
                    <div id="sendTestReminderResult" class="mt-2"></div>
                </div>

                <div id="sendRemindersResult" class="d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="sendRemindersCancelBtn">Avbryt</button>
                <button type="button" class="btn btn-warning" id="sendRemindersConfirmBtn" onclick="confirmSendReminders()">
                    <i class="bi bi-send me-1"></i>Skicka påminnelser
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Walk-in Registration Modal — for a shooter who turns up at the desk without
     pre-registering. Searches members, picks a class, calls AddLateRegistration,
     then drops the result into the manage-invoice flow so the cashier can take
     payment in the same session. -->
<div class="modal fade" id="walkInRegistrationModal" tabindex="-1" aria-labelledby="walkInRegistrationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="walkInRegistrationModalLabel">
                    <i class="bi bi-person-plus me-2"></i>Anmäl och betala
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Anmäl en skytt som kommer till tävlingsbordet utan att vara föranmäld.
                    Efter anmälan öppnas betalningshanteringen direkt.
                </p>

                <div class="mb-3">
                    <label for="walkInMemberSearch" class="form-label fw-bold">Sök medlem</label>
                    <input type="text" class="form-control" id="walkInMemberSearch"
                           placeholder="Skriv namn eller e-post (minst 2 tecken)" autocomplete="off">
                    <div id="walkInMemberResults" class="list-group mt-2" style="max-height: 220px; overflow-y: auto;"></div>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-outline-success btn-sm" id="walkInQuickCreateToggleBtn" onclick="toggleWalkInQuickCreate()">
                        <i class="bi bi-person-plus me-1"></i><span id="walkInQuickCreateBtnText">Lägg till ny medlem</span>
                    </button>
                    <div id="walkInQuickCreateForm" style="display:none" class="mt-2 p-2 border rounded bg-body">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input type="text" class="form-control form-control-sm" id="walkInQcFirstName" placeholder="Förnamn" autocomplete="off" data-1p-ignore="true">
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control form-control-sm" id="walkInQcLastName" placeholder="Efternamn" autocomplete="off" data-1p-ignore="true">
                            </div>
                            <div class="col-md-6">
                                <input type="email" class="form-control form-control-sm" id="walkInQcEmail" placeholder="E-post" autocomplete="off" data-1p-ignore="true">
                            </div>
                            <div class="col-md-6">
                                <select class="form-select form-select-sm" id="walkInQcClub">
                                    <option value="">Laddar klubbar...</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="walkInQcAutoApprove" checked>
                                <label class="form-check-label small" for="walkInQcAutoApprove">Godkänn direkt</label>
                            </div>
                            <button type="button" class="btn btn-success btn-sm ms-auto" onclick="walkInQuickCreateMember()">
                                <i class="bi bi-check-lg me-1"></i>Skapa
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleWalkInQuickCreate()">Avbryt</button>
                        </div>
                        <div id="walkInQcMessage" class="mt-1 small"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Vald skytt</label>
                    <div id="walkInSelectedMember" class="form-control-plaintext text-muted">Ingen vald än</div>
                    <input type="hidden" id="walkInSelectedMemberId" value="">
                </div>

                @if (springskytteEnabled)
                {
                    @* Springskytte: A/C weapon-group checkboxes + ONE spelled-out age-class dropdown,
                       exactly like the public SpringskytteRegistrationModal. Builds "A-<age>" / "C-<age>"
                       so the operator can't pick two C-classes or mismatch the age across A and C. *@
                    <div class="mb-3">
                        <label class="form-label fw-bold">Vapengrupp</label>
                        <div class="d-flex gap-2" id="walkInSpringClassSelector">
                            @if (springHasA)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input walk-in-spring-ctl" type="checkbox" id="walkInSpringWeaponA" value="A">
                                    <label class="form-check-label" for="walkInSpringWeaponA">
                                        <span class="badge bg-primary fs-6 px-3 py-2">A</span>
                                        <small class="d-block text-muted mt-1">Tavla (ring 1-4)</small>
                                    </label>
                                </div>
                            }
                            @if (springHasC)
                            {
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input walk-in-spring-ctl" type="checkbox" id="walkInSpringWeaponC" value="C">
                                    <label class="form-check-label" for="walkInSpringWeaponC">
                                        <span class="badge bg-primary fs-6 px-3 py-2">C</span>
                                        <small class="d-block text-muted mt-1">Fallmål</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="@((springskytteEnabled) ? "mb-3" : "mb-0")">
                        <label for="walkInSpringAgeClass" class="form-label fw-bold">Ålders-/könsklass</label>
                        <select class="form-select walk-in-spring-ctl" id="walkInSpringAgeClass">
                            <option value="">-- Välj klass --</option>
                            @{
                                var wiJuniorClasses = new (string val, string label)[] {
                                    ("D 15", "D 15 (Dam –15 år)"), ("H 15", "H 15 (Herr –15 år)"),
                                    ("D 18", "D 18 (Dam 16–18 år)"), ("H 18", "H 18 (Herr 16–18 år)"),
                                    ("D jun", "D jun (Dam junior 15–20 år)"), ("H jun", "H jun (Herr junior 15–20 år)")
                                };
                                var wiSeniorClasses = new (string val, string label)[] {
                                    ("D 21", "D 21 (Dam 21–34 år)"), ("H 21", "H 21 (Herr 21–34 år)"),
                                    ("D 35", "D 35 (Dam 35–49 år)"), ("H 35", "H 35 (Herr 35–49 år)")
                                };
                                var wiVeteranClasses = new (string val, string label)[] {
                                    ("D 50", "D 50 (Dam 50–59 år)"), ("H 50", "H 50 (Herr 50–59 år)"),
                                    ("D 60", "D 60 (Dam 60–64 år)"), ("H 60", "H 60 (Herr 60–64 år)"),
                                    ("D 65", "D 65 (Dam 65–69 år)"), ("H 65", "H 65 (Herr 65–69 år)"),
                                    ("D 70", "D 70 (Dam 70+ år)"), ("H 70", "H 70 (Herr 70+ år)")
                                };
                                var wiFilteredJunior = wiJuniorClasses.Where(c => springAgeClasses.Contains(c.val)).ToArray();
                                var wiFilteredSenior = wiSeniorClasses.Where(c => springAgeClasses.Contains(c.val)).ToArray();
                                var wiFilteredVeteran = wiVeteranClasses.Where(c => springAgeClasses.Contains(c.val)).ToArray();
                            }
                            @if (wiFilteredJunior.Any())
                            {
                                <optgroup label="Junior">
                                    @foreach (var c in wiFilteredJunior)
                                    {
                                        <option value="@c.val">@c.label</option>
                                    }
                                </optgroup>
                            }
                            @if (wiFilteredSenior.Any())
                            {
                                <optgroup label="Senior">
                                    @foreach (var c in wiFilteredSenior)
                                    {
                                        <option value="@c.val">@c.label</option>
                                    }
                                </optgroup>
                            }
                            @if (wiFilteredVeteran.Any())
                            {
                                <optgroup label="Veteran">
                                    @foreach (var c in wiFilteredVeteran)
                                    {
                                        <option value="@c.val">@c.label</option>
                                    }
                                </optgroup>
                            }
                        </select>
                        <small class="text-muted d-block mt-1">Bocka i A och/eller C, välj sedan en klass. Samma klass gäller för båda vapengrupperna.</small>
                    </div>
                }
                else
                {
                    <div class="@((rollingStartEnabled || dpEnabled) ? "mb-3" : "mb-0")">
                        <label class="form-label fw-bold">Vapenklasser</label>
                        <small class="text-muted d-block mb-2">Bocka i en eller flera klasser. Egenbokning visar skjutlag-väljare per vald klass.</small>
                        <div id="walkInClassList" class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                            <!-- Populated from walkInAvailableClasses on modal open -->
                        </div>
                    </div>
                }

                @if (dpEnabled)
                {
                    <div class="mb-3">
                        <div id="walkInDpSlotsContainer">
                            <!-- Per-class slot pickers rendered when classes are ticked. -->
                        </div>
                    </div>
                }

                @if (rollingStartEnabled)
                {
                    <div class="mb-0">
                        <label for="walkInPatrolTarget" class="form-label fw-bold">Patrull</label>
                        <select class="form-select" id="walkInPatrolTarget">
                            <option value="nextAvailable" selected>Nästa lediga patrull</option>
                            <option value="newPatrol">Skapa ny patrull</option>
                            <!-- Existing patrols populated on modal open -->
                        </select>
                        <small class="form-text text-muted">
                            Rullande start: skytten placeras direkt på en patrull. Väljs för alla
                            valda klasser inom samma vapengrupp.
                        </small>
                    </div>
                }

                @* Deltävling opt-in. Mirrors the public registration modal's checkbox so
                   the cashier can register a walk-in into the sub-competition in one step.
                   Backend recomputes the fee via RegistrationFeeCalculator when persisting,
                   so the auto-generated invoice picks up the surcharge. *@
                @if (subCompetitionEnabled)
                {
                    <div class="mb-3 p-2 rounded border" style="background-color: var(--bs-info-bg-subtle);">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="walkInSubCompetitionCheckbox">
                            <label class="form-check-label" for="walkInSubCompetitionCheckbox">
                                Anmäl även till <strong>@subCompetitionName</strong>
                            </label>
                        </div>
                    </div>
                }

                @* Springskytte rullande start: one start-TIME dropdown per ticked class, populated
                   at runtime from the free slots of an existing start list (per weapon class). Hidden
                   silently when no start list covers the class yet — the shooter still registers and
                   can be slotted in later from the Startlista tab. *@
                @if (springskytteEnabled)
                {
                    <div class="mb-0">
                        <div id="walkInSpringSlotsContainer">
                            <!-- Per-class start-time pickers rendered when classes are ticked. -->
                        </div>
                    </div>
                }

                @* Non-DP precision start-list picker. Only rendered when the modal isn't
                   already showing the rolling-start patrol picker, the DP slot picker or the
                   Springskytte start-time picker — those handle their own placement flows. The
                   dropdown is populated and shown at runtime only when GetWalkInStartListTeams
                   returns teams. *@
                @if (!rollingStartEnabled && !dpEnabled && !springskytteEnabled)
                {
                    <div class="mb-0 d-none" id="walkInStartListPickerWrapper">
                        <label for="walkInStartListTeam" class="form-label fw-bold">Skjutlag</label>
                        <select class="form-select" id="walkInStartListTeam">
                            <option value="">— Lägg inte på startlistan —</option>
                            <!-- Populated when modal opens if a precisionStartList exists. -->
                        </select>
                        <small class="form-text text-muted">
                            Startlista är genererad. Väljer du ett skjutlag läggs skytten dit
                            direkt — annars måste startlistan regenereras manuellt.
                        </small>
                    </div>
                }

                <div id="walkInError" class="alert alert-danger mt-3 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="walkInSubmitBtn" onclick="submitWalkInRegistration()" disabled>
                    <i class="bi bi-arrow-right me-1"></i>Skapa anmälan och fortsätt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Mark as Paid Modal -->
<div class="modal fade" id="markAsPaidModal" tabindex="-1" aria-labelledby="markAsPaidModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="markAsPaidModalLabel">
                    <i class="bi bi-check-circle me-2"></i>Markera som betald
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-light mb-3">
                    <div class="row small">
                        <div class="col-6"><strong>Skytt:</strong> <span id="markPaidShooterName"></span></div>
                        <div class="col-6 text-end"><strong>Belopp:</strong> <span id="markPaidAmount"></span> kr</div>
                    </div>
                </div>
                <input type="hidden" id="markPaidInvoiceId" />
                <input type="hidden" id="markPaidRegistrationId" />
                <input type="hidden" id="markPaidInvoiceAmount" />

                <div class="mb-3">
                    <label for="markPaidActualAmount" class="form-label">Faktiskt belopp (kr)</label>
                    <input type="number" min="0" step="1" class="form-control" id="markPaidActualAmount" oninput="updateMarkPaidVariance()" />
                    <small id="markPaidVarianceNote" class="form-text text-warning d-none">
                        <i class="bi bi-exclamation-triangle me-1"></i>Avviker från fakturabeloppet — <span id="markPaidVarianceDelta"></span>
                    </small>
                </div>

                <div class="mb-3">
                    <label for="markPaidMethod" class="form-label">Betalningsmetod</label>
                    <select class="form-select" id="markPaidMethod">
                        <option value="Swish">Swish</option>
                        <option value="Kontant">Kontant</option>
                        <option value="Bankgiro">Bankgiro / banköverföring</option>
                        <option value="Annat">Annat</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="markPaidDate" class="form-label">Betaldatum</label>
                    <input type="text" class="form-control" id="markPaidDate" placeholder="Välj datum">
                </div>

                <div class="mb-3">
                    <label for="markPaidTransactionId" class="form-label">Referens / transaktions-ID <small class="text-muted">(valfritt)</small></label>
                    <input type="text" class="form-control" id="markPaidTransactionId" placeholder="t.ex. Swish-referens, kvittonummer">
                </div>

                <div class="mb-3">
                    <label for="markPaidNotes" class="form-label">Anteckning <small class="text-muted">(valfritt)</small></label>
                    <textarea class="form-control" id="markPaidNotes" rows="2" placeholder="t.ex. 'Betalt vid registreringsbordet'"></textarea>
                </div>

                <div class="form-check mb-0">
                    <input class="form-check-input" type="checkbox" id="markPaidSendReceipt" checked>
                    <label class="form-check-label" for="markPaidSendReceipt">
                        Skicka betalningsbekräftelse via e-post till skytten
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-success" id="markPaidConfirmBtn" onclick="confirmMarkAsPaid()">
                    <i class="bi bi-check-circle me-1"></i>Bekräfta betalning
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Registration Modal — multi-class editor with shared start preference. -->
<div class="modal fade" id="competitionEditRegistrationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Redigera anmälan</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <form id="competitionEditRegistrationForm">
                    <input type="hidden" id="competitionEditRegistrationId" />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="competitionEditMemberName" class="form-label">Skytt</label>
                                <input type="text" class="form-control" id="competitionEditMemberName" readonly />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="competitionEditMemberClub" class="form-label">Klubb</label>
                                <input type="text" class="form-control" id="competitionEditMemberClub" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="@(dpEnabled ? "mb-3" : "mb-0")">
                        <label class="form-label fw-bold">Klasser</label>
                        <small class="text-muted d-block mb-2">Bocka i klasserna skytten ska tävla i. Faktura räknas om automatiskt om beloppet ändras (förutsatt att den fortfarande är obetald).</small>
                        <div id="competitionEditClassList" class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                            <!-- Populated from walkInAvailableClasses + reg.shootingClasses -->
                        </div>
                    </div>

                    @if (dpEnabled)
                    {
                        <div class="mb-3">
                            <div id="competitionEditDpSlotsContainer">
                                <!-- Per-class slot pickers; each row labelled with its class. Existing
                                     classes pre-fill from the registration, new classes default to
                                     no-slot until the operator picks. -->
                            </div>
                        </div>
                    }

                    @if (springskytteEnabled)
                    {
                        <div class="mb-3">
                            <div id="competitionEditSpringSlotsContainer">
                                <!-- Springskytte rullande start: one row per ticked weapon group.
                                     A group the shooter is already slotted in shows its current start
                                     time read-only; a group with no start (i.e. a class just added at
                                     the desk) gets a free-slot picker. Without this the added class
                                     silently landed on no start list at all. -->
                            </div>
                        </div>
                    }

                    @* Deltävling opt-in. Pre-checked from reg.isSubCompetition; toggling here
                       triggers the fee re-compute path on save. *@
                    @if (subCompetitionEnabled)
                    {
                        <div class="mb-0 p-2 rounded border" style="background-color: var(--bs-info-bg-subtle);">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="competitionEditSubCompetitionCheckbox">
                                <label class="form-check-label" for="competitionEditSubCompetitionCheckbox">
                                    Anmäld även till <strong>@subCompetitionName</strong>
                                </label>
                            </div>
                        </div>
                    }
                </form>
            </div>
            <div class="modal-footer flex-wrap gap-2">
                <button type="button" class="btn btn-danger me-auto" onclick="deleteCompetitionRegistration()">
                    <i class="bi bi-trash me-1"></i>Ta bort anmälan
                </button>
