                @if (dpEnabled)
                {
                    <div class="mb-3">
                        <div id="walkInDpSlotsContainer">
                            <!-- Per-class slot pickers rendered when classes are ticked. -->
                        </div>
                    </div>
                }

                @if (rollingStartEnabled)
                {
                    <div class="mb-0">
                        <label for="walkInPatrolTarget" class="form-label fw-bold">Patrull</label>
                        <select class="form-select" id="walkInPatrolTarget">
                            <option value="nextAvailable" selected>Nästa lediga patrull</option>
                            <option value="newPatrol">Skapa ny patrull</option>
                            <!-- Existing patrols populated on modal open -->
                        </select>
                        <small class="form-text text-muted">
                            Rullande start: skytten placeras direkt på en patrull. Väljs för alla
                            valda klasser inom samma vapengrupp.
                        </small>
                    </div>
                }

                @* Deltävling opt-in. Mirrors the public registration modal's checkbox so
                   the cashier can register a walk-in into the sub-competition in one step.
                   Backend recomputes the fee via RegistrationFeeCalculator when persisting,
                   so the auto-generated invoice picks up the surcharge. *@
                @if (subCompetitionEnabled)
                {
                    <div class="mb-3 p-2 rounded border" style="background-color: var(--bs-info-bg-subtle);">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="walkInSubCompetitionCheckbox">
                            <label class="form-check-label" for="walkInSubCompetitionCheckbox">
                                Anmäl även till <strong>@subCompetitionName</strong>
                            </label>
                        </div>
                    </div>
                }

                @* Springskytte rullande start: one start-TIME dropdown per ticked class, populated
                   at runtime from the free slots of an existing start list (per weapon class). Hidden
                   silently when no start list covers the class yet — the shooter still registers and
                   can be slotted in later from the Startlista tab. *@
                @if (springskytteEnabled)
                {
                    <div class="mb-0">
                        <div id="walkInSpringSlotsContainer">
                            <!-- Per-class start-time pickers rendered when classes are ticked. -->
                        </div>
                    </div>
                }

                @* Non-DP precision start-list picker. Only rendered when the modal isn't
                   already showing the rolling-start patrol picker, the DP slot picker or the
                   Springskytte start-time picker — those handle their own placement flows. The
                   dropdown is populated and shown at runtime only when GetWalkInStartListTeams
                   returns teams. *@
                @if (!rollingStartEnabled && !dpEnabled && !springskytteEnabled)
                {
                    <div class="mb-0 d-none" id="walkInStartListPickerWrapper">
                        <label for="walkInStartListTeam" class="form-label fw-bold">Skjutlag</label>
                        <select class="form-select" id="walkInStartListTeam">
                            <option value="">— Lägg inte på startlistan —</option>
                            <!-- Populated when modal opens if a precisionStartList exists. -->
                        </select>
                        <small class="form-text text-muted">
                            Startlista är genererad. Väljer du ett skjutlag läggs skytten dit
                            direkt — annars måste startlistan regenereras manuellt.
                        </small>
                    </div>
                }

                <div id="walkInError" class="alert alert-danger mt-3 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="walkInSubmitBtn" onclick="submitWalkInRegistration()" disabled>
                    <i class="bi bi-arrow-right me-1"></i>Skapa anmälan och fortsätt
                </button>
            </div>
        </div>
    </div>
</div>

