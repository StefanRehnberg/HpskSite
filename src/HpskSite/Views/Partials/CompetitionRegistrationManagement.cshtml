@*
 * Competition-Specific Registration Management Partial View
 * Focused on managing registrations for a single competition
*@

@{
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "";
    var availableShootingClasses = ViewData["AvailableShootingClasses"] ?? new List<object>();
    var availableShootingClassesJson = System.Text.Json.JsonSerializer.Serialize(availableShootingClasses);

    // Walk-in patrol picker (item #5). Only shown for Fältskytte / MagnumFält with rolling
    // start enabled. CompetitionType is on ViewData from the host page; rollingStart is the
    // raw JSON blob — we just probe for the enabled flag.
    var compType = ViewData["CompetitionType"]?.ToString() ?? "Precision";
    var rollingStartRaw = ViewData["RollingStart"]?.ToString() ?? "";
    var rollingStartEnabled = false;
    if ((compType == "Faltskytte" || compType == "MagnumFalt") && !string.IsNullOrEmpty(rollingStartRaw))
    {
        try
        {
            var rs = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(rollingStartRaw);
            rollingStartEnabled = rs?.enabled == true;
        }
        catch { }
    }

    // Walk-in slot picker (item #6). Reuses the same DirektplaceringConfig.Parse helper that
    // the public flow uses, so "enabled" semantics stay aligned.
    var dpRaw = ViewData["DirektplaceringConfig"]?.ToString() ?? "";
    var dpEnabled = HpskSite.Models.DirektplaceringConfig.Parse(dpRaw) != null;

    // Deltävling (sub-competition) opt-in. When the competition has a configured name,
    // the walk-in + edit modals render a checkbox so the cashier can opt the shooter in
    // (and the backend recomputes the fee via RegistrationFeeCalculator).
    var subCompetitionName = ViewData["SubCompetitionName"]?.ToString() ?? "";
    var subCompetitionEnabled = !string.IsNullOrWhiteSpace(subCompetitionName);
}

<!-- Flatpickr (used by the mark-as-paid date picker). Loaded again here so the
     registration tab works standalone even when the start list tab isn't rendered. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<div class="competition-registration-management" data-competition-id="@competitionId" data-competition-club-id="@(ViewData["CompetitionClubId"]?.ToString() ?? "")">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0"><i class="bi bi-people me-2"></i>Anmälningar</h4>
        <div class="d-flex gap-2 flex-wrap">
            <button type="button" class="btn btn-primary btn-sm" onclick="openWalkInRegistrationModal()" title="Anmäl en skytt vid registreringsbordet">
                <i class="bi bi-person-plus me-1"></i>Anmäl och betala
            </button>
            <button type="button" class="btn btn-warning btn-sm" onclick="openSendRemindersModal()" title="Maila påminnelse till alla obetalda">
                <i class="bi bi-envelope-exclamation me-1"></i>Skicka påminnelser
            </button>
            <button type="button" class="btn btn-outline-success btn-sm" onclick="openBokforingsUnderlag()" title="Öppna utskriftsvänligt bokföringsunderlag">
                <i class="bi bi-file-earmark-text me-1"></i>Bokföringsunderlag
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="exportCompetitionRegistrations()" title="Exportera anmälningar och betalningar som CSV">
                <i class="bi bi-download me-1"></i>Exportera CSV
            </button>
        </div>
    </div>

    <!-- Payment Summary Cards. 5 cards across at lg+, 2 per row on mobile/tablet so the
         odd-count layout still wraps cleanly without leaving an orphan card. -->
    <div class="row g-2 mb-3" id="paymentSummaryCards" style="display:none">
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Anmälda</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="summaryRegCount">0</h4>
                        <small class="text-muted"><span id="summaryUniqueMembers">0</span> unika</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Starter</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="summaryStartsCount">0</h4>
                        <small class="text-muted">klasser</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-success">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-success small">Betalt</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0 text-success" id="summaryPaidAmount">0 kr</h4>
                        <small class="text-muted"><span id="summaryPaidCount">0</span> st</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-warning">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-warning small">Väntande</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0 text-warning" id="summaryPendingAmount">0 kr</h4>
                        <small class="text-muted"><span id="summaryPendingCount">0</span> st</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg">
            <div class="card h-100 border-secondary">
                <div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-secondary small">Saknar betalning</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="summaryNoInvoiceCount">0</h4>
                        <small class="text-muted">st</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Search + Filters — six inputs in a single row at lg+ to minimize vertical
         space at the desk. Search matches name, club, and Swish reference (invoice
         number) so a treasurer can paste the reference from a Swish notification
         and jump straight to the right row. -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionRegistrationSearch" class="form-label">
                        <i class="bi bi-search me-1"></i>Sök
                    </label>
                    <input type="text" class="form-control" id="competitionRegistrationSearch"
                           placeholder="Namn, klubb, referens"
                           oninput="filterCompetitionRegistrations()" autocomplete="off">
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionClassFilter" class="form-label">Klass</label>
                    <select class="form-select" id="competitionClassFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla klasser</option>
                        <!-- Options populated dynamically by populateShootingClassFilter() -->
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionClubFilter" class="form-label">Klubb</label>
                    <select class="form-select" id="competitionClubFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla klubbar</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionPreferenceFilter" class="form-label">Startpreferens</label>
                    <select class="form-select" id="competitionPreferenceFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla preferenser</option>
                        <option value="Inget">Inget (ingen preferens)</option>
                        <option value="Tidig Start">Tidig start</option>
                        <option value="Sen Start">Sen start</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionPaymentFilter" class="form-label">Betalstatus</label>
                    <select class="form-select" id="competitionPaymentFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla betalstatus</option>
                        <option value="Paid">Betald</option>
                        <option value="Pending">Väntande</option>
                        <option value="Failed">Misslyckad</option>
                        <option value="Cancelled">Makulerad</option>
                        <option value="Refunded">Återbetald</option>
                        <option value="No Invoice">Saknar betalning</option>
                    </select>
                </div>
                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label for="competitionCheckedInFilter" class="form-label">Närvaro</label>
                    <select class="form-select" id="competitionCheckedInFilter" onchange="filterCompetitionRegistrations()">
                        <option value="">Alla</option>
                        <option value="in">Incheckad</option>
                        <option value="out">Ej incheckad</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Registrations Table -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Anmälningar för denna tävling</h5>
        </div>
        <div class="card-body">
            <!-- Loading State -->
            <div id="competitionRegistrationsLoading" class="text-center py-4">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Laddar...</span>
                </div>
                <p class="mt-2">Laddar anmälningar...</p>
            </div>

            <!-- Error State -->
            <div id="competitionRegistrationsError" class="alert alert-danger d-none">
                <h6>Fel vid inläsning av anmälningar</h6>
                <p id="competitionRegistrationsErrorMessage"></p>
                <button class="btn btn-outline-danger" onclick="loadCompetitionRegistrations()">Försök igen</button>
            </div>

            <!-- Registrations Table -->
            <div id="competitionRegistrationsTableContainer" class="d-none">
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="competitionRegistrationsTable">
                        <thead>
                            <tr>
                                <th>Medlem</th>
                                <th>Klubb</th>
                                <th>Klass</th>
                                <th>Anmälningsdatum</th>
                                <th>Status</th>
                                <th>Närvaro</th>
                                <th>Åtgärder</th>
                            </tr>
                        </thead>
                        <tbody id="competitionRegistrationsTableBody">
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <nav aria-label="Competition registrations pagination">
                    <ul class="pagination justify-content-center" id="competitionRegistrationsPagination">
                    </ul>
                </nav>
            </div>

            <!-- No Results State -->
            <div id="competitionNoRegistrations" class="text-center py-4 d-none">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="text-muted mt-2">No registrations found for this competition.</p>
            </div>
        </div>
    </div>
</div>

<!-- Bokföringsunderlag option modal — asks whether to include outstanding payments.
     The default print includes everything (running view); the verifikat-friendly
     variant for the final book-keeping confirmation only lists what was actually paid. -->
<div class="modal fade" id="bokforingsUnderlagModal" tabindex="-1" aria-labelledby="bokforingsUnderlagModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="bokforingsUnderlagModalLabel">
                    <i class="bi bi-file-earmark-text me-2"></i>Bokföringsunderlag
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">Vill du inkludera utestående betalningar i underlaget?</p>
                <ul class="small text-muted mb-0">
                    <li><strong>Inkludera utestående</strong> — fullständig översikt som visar både inkomna och utestående betalningar. Bra under tävlingsdagen och vid uppföljning.</li>
                    <li><strong>Endast betalda</strong> — bokföringsverifikat. Endast inkomna betalningar listas. Bra för slutgiltig bokföring.</li>
                </ul>
            </div>
            <div class="modal-footer flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-outline-success" onclick="openBokforingsUnderlagWithMode(true)">
                    <i class="bi bi-list-check me-1"></i>Inkludera utestående
                </button>
                <button type="button" class="btn btn-success" onclick="openBokforingsUnderlagWithMode(false)">
                    <i class="bi bi-receipt me-1"></i>Endast betalda
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Manage Invoice Modal — desk workflow hub for a single registration's payment.
     Replaces the older Betalningsalternativ + Swish-QR modals. Has two visual states
     (action picker / QR display) toggled by JS. Lazily creates the invoice on first
     action when the row is in "No Invoice" state. -->
<div class="modal fade" id="manageInvoiceModal" tabindex="-1" aria-labelledby="manageInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="manageInvoiceModalLabel">
                    <i class="bi bi-wallet2 me-2"></i>Hantera betalning
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <!-- Header strip: shooter, amount, status -->
                <div class="alert alert-light mb-3">
                    <div class="row small">
                        <div class="col-6">
                            <strong>Skytt:</strong> <span id="manageInvoiceShooterName"></span><br>
                            <small class="text-muted" id="manageInvoiceClub"></small>
                        </div>
                        <div class="col-6 text-end">
                            <strong>Belopp:</strong> <span id="manageInvoiceAmount"></span> kr<br>
                            <span id="manageInvoiceStatusBadge"></span>
                        </div>
                    </div>
                    <div class="small text-muted mt-1" id="manageInvoiceRefRow" style="display:none">
                        <i class="bi bi-hash"></i><span id="manageInvoiceRef"></span>
                    </div>
                </div>

                <!-- State A: Action chooser (default) -->
                <div id="manageInvoiceActions">
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-primary btn-lg" onclick="showQrInManageModal()">
                            <i class="bi bi-qr-code me-1"></i>Visa QR-kod
                            <div class="small fw-normal">Skytten skannar koden från din skärm</div>
                        </button>
                        <button type="button" class="btn btn-success btn-lg" onclick="markPaidFromManageModal()">
                            <i class="bi bi-check-circle me-1"></i>Registrera betalning
                            <div class="small fw-normal">Kontant, Swish via app, bankgiro eller annat</div>
                        </button>
                    </div>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link btn-sm text-muted" onclick="emailQrFromManageModal(this)">
                            <i class="bi bi-envelope me-1"></i>Skicka QR-kod via e-post till skytten
                        </button>
                    </div>
                </div>

                <!-- State B: QR display (toggled when "Visa QR-kod" clicked) -->
                <div id="manageInvoiceQr" style="display:none">
                    <div class="text-center" id="manageInvoiceQrBody">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Laddar QR-kod...</span>
                        </div>
                    </div>
                    <div class="text-center mt-3">
                        <button type="button" class="btn btn-link btn-sm" onclick="backToManageInvoiceActions()">
                            <i class="bi bi-arrow-left me-1"></i>Tillbaka
                        </button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Invoice History Modal — read-only audit trail for one invoice. -->
<div class="modal fade" id="invoiceHistoryModal" tabindex="-1" aria-labelledby="invoiceHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title" id="invoiceHistoryModalLabel">
                    <i class="bi bi-clock-history me-2"></i>Betalningshistorik
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div class="small text-muted mb-2" id="invoiceHistoryHeader"></div>
                <div id="invoiceHistoryBody">
                    <div class="text-center py-3">
                        <div class="spinner-border spinner-border-sm me-2" role="status"></div>Laddar historik...
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Send Payment Reminders Modal — bulk action with confirmation. -->
<div class="modal fade" id="sendRemindersModal" tabindex="-1" aria-labelledby="sendRemindersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="sendRemindersModalLabel">
                    <i class="bi bi-envelope-exclamation me-2"></i>Skicka betalningspåminnelser
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p>Maila en Swish QR-påminnelse till alla skyttar med <strong>Väntande</strong> betalningsstatus.</p>

                <div class="alert alert-info mb-3" id="sendRemindersInfo">
                    <span id="sendRemindersCount" class="fw-bold">…</span> mottagare kommer att få ett mejl.
                    <small class="text-muted d-block mt-1">Lagbetalningar och skyttar utan e-postadress hoppas över.</small>
                </div>

                <div class="mb-3">
                    <label for="sendRemindersMessage" class="form-label">Meddelande <small class="text-muted">(valfritt)</small></label>
                    <textarea class="form-control" id="sendRemindersMessage" rows="3"
                              placeholder="t.ex. ”Tre dagar kvar till tävlingen — vänligen betala för att behålla din plats.”"></textarea>
                    <small class="form-text text-muted">Lämnas tomt för att använda standardmeddelandet.</small>
                </div>

                <div id="sendRemindersResult" class="d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="sendRemindersCancelBtn">Avbryt</button>
                <button type="button" class="btn btn-warning" id="sendRemindersConfirmBtn" onclick="confirmSendReminders()">
                    <i class="bi bi-send me-1"></i>Skicka påminnelser
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Walk-in Registration Modal — for a shooter who turns up at the desk without
     pre-registering. Searches members, picks a class, calls AddLateRegistration,
     then drops the result into the manage-invoice flow so the cashier can take
     payment in the same session. -->
<div class="modal fade" id="walkInRegistrationModal" tabindex="-1" aria-labelledby="walkInRegistrationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="walkInRegistrationModalLabel">
                    <i class="bi bi-person-plus me-2"></i>Anmäl och betala
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    Anmäl en skytt som kommer till tävlingsbordet utan att vara föranmäld.
                    Efter anmälan öppnas betalningshanteringen direkt.
                </p>

                <div class="mb-3">
                    <label for="walkInMemberSearch" class="form-label fw-bold">Sök medlem</label>
                    <input type="text" class="form-control" id="walkInMemberSearch"
                           placeholder="Skriv namn eller e-post (minst 2 tecken)" autocomplete="off">
                    <div id="walkInMemberResults" class="list-group mt-2" style="max-height: 220px; overflow-y: auto;"></div>
                </div>

                <div class="mb-3">
                    <button type="button" class="btn btn-outline-success btn-sm" id="walkInQuickCreateToggleBtn" onclick="toggleWalkInQuickCreate()">
                        <i class="bi bi-person-plus me-1"></i><span id="walkInQuickCreateBtnText">Lägg till ny medlem</span>
                    </button>
                    <div id="walkInQuickCreateForm" style="display:none" class="mt-2 p-2 border rounded bg-body">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input type="text" class="form-control form-control-sm" id="walkInQcFirstName" placeholder="Förnamn" autocomplete="off" data-1p-ignore="true">
                            </div>
                            <div class="col-md-6">
                                <input type="text" class="form-control form-control-sm" id="walkInQcLastName" placeholder="Efternamn" autocomplete="off" data-1p-ignore="true">
                            </div>
                            <div class="col-md-6">
                                <input type="email" class="form-control form-control-sm" id="walkInQcEmail" placeholder="E-post" autocomplete="off" data-1p-ignore="true">
                            </div>
                            <div class="col-md-6">
                                <select class="form-select form-select-sm" id="walkInQcClub">
                                    <option value="">Laddar klubbar...</option>
                                </select>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 mt-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="walkInQcAutoApprove" checked>
                                <label class="form-check-label small" for="walkInQcAutoApprove">Godkänn direkt</label>
                            </div>
                            <button type="button" class="btn btn-success btn-sm ms-auto" onclick="walkInQuickCreateMember()">
                                <i class="bi bi-check-lg me-1"></i>Skapa
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleWalkInQuickCreate()">Avbryt</button>
                        </div>
                        <div id="walkInQcMessage" class="mt-1 small"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Vald skytt</label>
                    <div id="walkInSelectedMember" class="form-control-plaintext text-muted">Ingen vald än</div>
                    <input type="hidden" id="walkInSelectedMemberId" value="">
                </div>

                <div class="@((rollingStartEnabled || dpEnabled) ? "mb-3" : "mb-0")">
                    <label class="form-label fw-bold">Vapenklasser</label>
                    <small class="text-muted d-block mb-2">Bocka i en eller flera klasser. Egenbokning visar skjutlag-väljare per vald klass.</small>
                    <div id="walkInClassList" class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                        <!-- Populated from walkInAvailableClasses on modal open -->
                    </div>
                </div>

                @if (dpEnabled)
                {
                    <div class="mb-3">
                        <div id="walkInDpSlotsContainer">
                            <!-- Per-class slot pickers rendered when classes are ticked. -->
                        </div>
                    </div>
                }

                @if (rollingStartEnabled)
                {
                    <div class="mb-0">
                        <label for="walkInPatrolTarget" class="form-label fw-bold">Patrull</label>
                        <select class="form-select" id="walkInPatrolTarget">
                            <option value="nextAvailable" selected>Nästa lediga patrull</option>
                            <option value="newPatrol">Skapa ny patrull</option>
                            <!-- Existing patrols populated on modal open -->
                        </select>
                        <small class="form-text text-muted">
                            Rullande start: skytten placeras direkt på en patrull. Väljs för alla
                            valda klasser inom samma vapengrupp.
                        </small>
                    </div>
                }

                @* Deltävling opt-in. Mirrors the public registration modal's checkbox so
                   the cashier can register a walk-in into the sub-competition in one step.
                   Backend recomputes the fee via RegistrationFeeCalculator when persisting,
                   so the auto-generated invoice picks up the surcharge. *@
                @if (subCompetitionEnabled)
                {
                    <div class="mb-3 p-2 rounded border" style="background-color: var(--bs-info-bg-subtle);">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="walkInSubCompetitionCheckbox">
                            <label class="form-check-label" for="walkInSubCompetitionCheckbox">
                                Anmäl även till <strong>@subCompetitionName</strong>
                            </label>
                        </div>
                    </div>
                }

                @* Non-DP precision start-list picker. Only rendered when the modal isn't
                   already showing the rolling-start patrol picker or the DP slot picker —
                   those handle their own placement flows. The dropdown is populated and
                   shown at runtime only when GetWalkInStartListTeams returns teams. *@
                @if (!rollingStartEnabled && !dpEnabled)
                {
                    <div class="mb-0 d-none" id="walkInStartListPickerWrapper">
                        <label for="walkInStartListTeam" class="form-label fw-bold">Skjutlag</label>
                        <select class="form-select" id="walkInStartListTeam">
                            <option value="">— Lägg inte på startlistan —</option>
                            <!-- Populated when modal opens if a precisionStartList exists. -->
                        </select>
                        <small class="form-text text-muted">
                            Startlista är genererad. Väljer du ett skjutlag läggs skytten dit
                            direkt — annars måste startlistan regenereras manuellt.
                        </small>
                    </div>
                }

                <div id="walkInError" class="alert alert-danger mt-3 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="walkInSubmitBtn" onclick="submitWalkInRegistration()" disabled>
                    <i class="bi bi-arrow-right me-1"></i>Skapa anmälan och fortsätt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Mark as Paid Modal -->
