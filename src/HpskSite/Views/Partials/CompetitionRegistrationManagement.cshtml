// Bootstrap modal instance, lazily created on first open
let markPaidModalInstance = null;
let markPaidDatePicker = null;

function markAsPaid(registrationId) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);
    if (!reg) {
        alert('Kunde inte hitta anmälan i listan.');
        return;
    }
    if (!reg.invoiceId) {
        alert('Det finns ingen betalning för denna anmälan. Använd plånboksknappen för att starta en betalning först.');
        return;
    }

    // Pre-fill the modal with this registration's data.
    // Reference field: prefer an existing transactionId (e.g. a real Swish transaction
    // ID from a callback) if one was already recorded; otherwise drop in the invoice
    // number, which is exactly what the payer sees as the Swish reference. Saves the
    // cashier from typing/pasting it from the Swish notification.
    const billed = Math.round(Number(reg.paymentAmount) || 0);
    document.getElementById('markPaidInvoiceId').value = reg.invoiceId;
    document.getElementById('markPaidRegistrationId').value = reg.id;
    document.getElementById('markPaidInvoiceAmount').value = billed;
    document.getElementById('markPaidShooterName').textContent = reg.memberName || '';
    document.getElementById('markPaidAmount').textContent = billed;
    document.getElementById('markPaidActualAmount').value = billed;
    document.getElementById('markPaidMethod').value = 'Swish';
    document.getElementById('markPaidTransactionId').value = reg.transactionId || reg.invoiceNumber || '';
    document.getElementById('markPaidNotes').value = '';
    // Receipt checkbox defaults to ON — most paid transitions benefit from the shooter
    // getting a copy. Cash-desk operators can untick when they don't want an email out.
    const receiptBox = document.getElementById('markPaidSendReceipt');
    if (receiptBox) receiptBox.checked = true;
    updateMarkPaidVariance();

    const modalEl = document.getElementById('markAsPaidModal');
    if (!markPaidModalInstance) {
        markPaidModalInstance = new bootstrap.Modal(modalEl);
    }

    // Initialise (or reset) the date picker; defaults to today.
    if (!markPaidDatePicker) {
        markPaidDatePicker = flatpickr('#markPaidDate', {
            locale: 'sv',
            dateFormat: 'Y-m-d',
            defaultDate: 'today',
            maxDate: 'today'
        });
    } else {
        markPaidDatePicker.setDate(new Date(), true);
    }

    markPaidModalInstance.show();
}

function updateMarkPaidVariance() {
    const billed = Number(document.getElementById('markPaidInvoiceAmount').value) || 0;
    const actual = Number(document.getElementById('markPaidActualAmount').value) || 0;
    const note = document.getElementById('markPaidVarianceNote');
    const deltaSpan = document.getElementById('markPaidVarianceDelta');
    if (Math.abs(actual - billed) < 0.005) {
        note.classList.add('d-none');
        return;
    }
    const diff = actual - billed;
    const sign = diff > 0 ? '+' : '−';
    deltaSpan.textContent = `${sign}${Math.abs(Math.round(diff))} kr`;
    note.classList.remove('d-none');
}

function confirmMarkAsPaid() {
    const invoiceId = document.getElementById('markPaidInvoiceId').value;
    if (!invoiceId) return;

    const method = document.getElementById('markPaidMethod').value;
    const dateStr = document.getElementById('markPaidDate').value;
    const transactionId = document.getElementById('markPaidTransactionId').value.trim();
    const notesField = document.getElementById('markPaidNotes').value.trim();
    const billed = Number(document.getElementById('markPaidInvoiceAmount').value) || 0;
    const actualRaw = document.getElementById('markPaidActualAmount').value;
    const actualAmount = actualRaw === '' ? billed : Number(actualRaw);
    if (!Number.isFinite(actualAmount) || actualAmount < 0) {
        alert('Ogiltigt belopp.');
        return;
    }
    const variance = Math.abs(actualAmount - billed) >= 0.005;

    // Build a default note that captures method + reference if the user didn't write one.
    // Surfaces enough context in the invoice's notes field that a future reader can tell
    // who marked it paid and how. Variance is recorded so the audit trail explains why
    // the recorded amount differs from the invoice total.
    const noteParts = [];
    if (notesField) noteParts.push(notesField);
    noteParts.push(`Markerad som betald — ${method}`);
    if (transactionId) noteParts.push(`Ref: ${transactionId}`);
    if (variance) noteParts.push(`Faktiskt: ${Math.round(actualAmount)} kr (faktura: ${Math.round(billed)} kr)`);
    const finalNotes = noteParts.join(' | ');

    const btn = document.getElementById('markPaidConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sparar…';

    const sendReceipt = document.getElementById('markPaidSendReceipt')?.checked === true;

    const token = $('input[name="__RequestVerificationToken"]').val();
    const params = new URLSearchParams();
    params.append('invoiceId', invoiceId);
    params.append('paymentStatus', 'Paid');
    params.append('paymentDate', dateStr ? new Date(dateStr).toISOString() : new Date().toISOString());
    if (transactionId) params.append('transactionId', transactionId);
    params.append('notes', finalNotes);
    params.append('paymentMethod', method);
    params.append('actualAmount', actualAmount);
    // Always send the flag — omitting it would let the backend default (true) override
    // an explicit untick, defeating the opt-out.
    params.append('sendReceipt', sendReceipt ? 'true' : 'false');

    fetch('/umbraco/surface/Payment/UpdatePaymentStatus', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': token
        },
        body: params.toString()
    })
    .then(r => r.json())
    .then(result => {
        if (result.success) {
            markPaidModalInstance?.hide();
            loadCompetitionRegistrations();
            // Receipt is best-effort and lives inside PaymentService now. Failures land
            // in the application log; the audit history modal shows whether a ReceiptSent
            // event was actually written for this invoice.
        } else {
            alert('Kunde inte uppdatera: ' + (result.message || 'okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Ett fel uppstod: ' + error.message);
    })
    .finally(() => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Bekräfta betalning';
    });
}

// Item #9: persist the at-the-desk attendance toggle. Optimistic — flips the in-memory
// row immediately so the operator sees the label flip without waiting for the round trip.
// On failure we revert the checkbox + in-memory state so the desk doesn't drift from the
// server's view of the world.
async function setCheckedIn(registrationId, checkedIn) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);
    if (reg) reg.isCheckedIn = checkedIn;
    const label = document.querySelector(`label[for="checkin_${registrationId}"]`);
    if (label) label.textContent = checkedIn ? 'Här' : '';

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const resp = await fetch('/umbraco/surface/RegistrationAdmin/SetCheckedIn', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ registrationId, checkedIn })
        });
        const data = await resp.json();
        if (!data.success) {
            throw new Error(data.message || 'Misslyckades att spara närvaro.');
        }
    } catch (err) {
        // Revert UI + cache on failure
        const cb = document.getElementById(`checkin_${registrationId}`);
        if (cb) cb.checked = !checkedIn;
        if (reg) reg.isCheckedIn = !checkedIn;
        if (label) label.textContent = !checkedIn ? 'Här' : '';
        alert('Kunde inte uppdatera närvaro: ' + err.message);
    }
}

function getPreferenceBadgeClass(preference) {
    switch (preference) {
        case 'Tidig Start': return 'bg-info';
        case 'Sen Start': return 'bg-warning';
        default: return 'bg-secondary';
    }
}

function normalizeShootingClass(raw) {
    if (!raw) return '';
    let s = String(raw).trim();
    // Normalize separators and uppercase where needed
    s = s.replace(/_/g, ' ').replace(/\s+/g, ' ').trim();

    // Common compact forms → spaced
    s = s.replace(/^C\s?Jun$/i, 'C Jun');
    s = s.replace(/^C1\s?Dam$/i, 'C1 Dam');
    s = s.replace(/^C2\s?Dam$/i, 'C2 Dam');
    s = s.replace(/^C3\s?Dam$/i, 'C3 Dam');

    // Veteran Younger/Older variants
    // Map various CVY forms to 'C Vet Y'
    if (/^C\s*V(e|ä)?t\s*Y$/i.test(s) || /^CVY$/i.test(s)) {
        return 'C Vet Y';
    }
    // Map various CVÄ/CVAE forms to 'C Vet Ä'
    if (/^C\s*V(e|ä)?t\s*(Ä|A)$/i.test(s) || /^CVÄ$/i.test(s) || /^CVA$/i.test(s)) {
        // Force Swedish Ä
        return 'C Vet Ä';
    }

    // Map CD3 or C D3 to C3 Dam
    if (/^C\s*D3$/i.test(s) || /^CD3$/i.test(s)) {
        return 'C3 Dam';
    }

    // Uppercase A/B/C categories like A1/A2/A3/B1... keep as-is
    if (/^[ABC][0-9]$/i.test(s)) return s.toUpperCase();

    return s;
}

