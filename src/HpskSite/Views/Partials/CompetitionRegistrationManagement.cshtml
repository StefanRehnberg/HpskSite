async function markPaidFromManageModal() {
    if (!currentManageInvoiceReg) return;
    const reg = currentManageInvoiceReg;
    const competitionId = $('.competition-registration-management').data('competition-id');

    // Team: hide the chooser and open the mark-as-paid modal pre-filled for the team.
    if (reg.isTeam) {
        manageInvoiceModalInstance?.hide();
        const team = competitionTeams.find(t => t.id === reg.teamId);
        if (team) setTimeout(() => openMarkAsPaidForTeam(team), 250);
        return;
    }

    // No-invoice path: silently create an invoice via RegistrationAdmin/EnsureInvoice,
    // then open the mark-as-paid modal with the new invoiceId. We deliberately do NOT go
    // through Swish/GeneratePaymentQR here — recording a cash/bankgiro/Swish-via-app
    // payment must work even when the competition has no Swish number configured.
    if (!reg.invoiceId) {
        try {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const response = await fetch('/umbraco/surface/RegistrationAdmin/EnsureInvoice', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ registrationId: reg.id })
            });
            // Read as text first so an empty/non-JSON body (e.g. a 404 because the server
            // wasn't rebuilt, or a 500 error page) gives a clear message instead of the
            // cryptic "Unexpected end of JSON input".
            const raw = await response.text();
            let data;
            try {
                data = raw ? JSON.parse(raw) : null;
            } catch {
                data = null;
            }
            if (!response.ok || !data) {
                alert('Kunde inte starta betalning: serverfel (' + response.status + '). '
                    + 'Kontrollera att tjänsten har startats om efter senaste uppdateringen.');
                return;
            }
            if (!data.success || !data.invoiceId) {
                alert('Kunde inte starta betalning: ' + (data.message || 'okänt fel'));
                return;
            }
            reg.invoiceId = data.invoiceId;
            reg.invoiceNumber = data.invoiceNumber || reg.invoiceNumber;
            reg.paymentAmount = data.amount || reg.paymentAmount;
            const live = competitionRegistrations.find(r => r.id === reg.id);
            if (live) {
                live.invoiceId = data.invoiceId;
                live.invoiceNumber = data.invoiceNumber || live.invoiceNumber;
                live.paymentAmount = data.amount || live.paymentAmount;
                if (live.paymentStatus === 'No Invoice') {
                    live.paymentStatus = 'Pending';
                    live.pendingAmount = (Number(live.pendingAmount) || 0) + (Number(data.amount) || 0);
                }
            }
        } catch (err) {
            alert('Kunde inte starta betalning: ' + err.message);
            return;
        }
    }

    // Hide manage modal, then open mark-as-paid modal which is already designed for
    // method/date/reference/notes input.
    manageInvoiceModalInstance?.hide();
    setTimeout(() => markAsPaid(reg.id), 250);  // small delay so Bootstrap finishes the hide animation
}

async function emailQrFromManageModal(button) {
    if (!currentManageInvoiceReg) return;
    const competitionId = $('.competition-registration-management').data('competition-id');
    const reg = currentManageInvoiceReg;

    const original = button.innerHTML;
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skickar...';

    // Team: ask WHO the QR goes to before sending. Without this step the endpoint defaults to the
    // logged-in user — right on the public page (the club's own lagledare mails themselves), wrong
    // at the desk, where a late lag registered by the organiser would mail the QR to the organiser.
    if (reg.isTeam) {
        button.disabled = false;
        button.innerHTML = original;
        await showTeamQrEmailRecipients(reg, competitionId);
        return;
    }

    try {
        const formData = new FormData();
        formData.append('competitionId', competitionId);
        formData.append('targetMemberId', reg.memberId);

        const response = await fetch('/umbraco/surface/Swish/SendQRCodeEmail', {
            method: 'POST',
            body: formData,
            headers: {
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value,
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        });
        const result = await response.json();

        if (result.success) {
            manageInvoiceModalInstance?.hide();
            alert(`QR-koden har skickats till ${result.email}`);
        } else {
            alert('Fel: ' + (result.message || 'okänt fel'));
        }
    } catch (error) {
        console.error('Error sending Swish QR code email:', error);
        alert('Ett fel uppstod när e-posten skulle skickas. Försök igen.');
    } finally {
        button.disabled = false;
        button.innerHTML = original;
    }
}

// ──────────────────────────────────────────────────────────────────────
// Walk-in registration: shooter turns up at the desk without pre-registering.
// Search a member, pick a class, create the registration, then drop into the
// manage-invoice modal so the cashier can take payment in the same flow.
// ──────────────────────────────────────────────────────────────────────
let walkInModalInstance = null;
let walkInSearchTimer = null;

// Server-rendered list of {id, name} for the classes this competition actually allows
// (sourced from competition.shootingClassIds). Used to populate the walk-in class dropdown.
const walkInAvailableClasses = @Html.Raw(availableShootingClassesJson);

// Item #5: walk-in patrol picker is rendered server-side only when the competition has
// rolling start on. The flag drives the post-registration call to AssignWalkInToPatrol.
const walkInPatrolPickerEnabled = @(rollingStartEnabled ? "true" : "false");

// Item #6: walk-in slot picker for direktplacering / Egenbokning competitions. Server-
// side rendered only when relevant; JS fetches live availability each time the modal
// opens so a popular slot can fill up between two cashier visits. Multi-class — each
// checked class gets its own slot dropdown.
const walkInDirektplaceringEnabled = @(dpEnabled ? "true" : "false");

// Item #7: Springskytte rullande start. Renders a start-TIME dropdown per ticked class from
// the free slots of an existing start list; the flag drives the post-registration call to
// AssignSpringskytteWalkInStartTime.
const walkInSpringskytteEnabled = @(springskytteEnabled ? "true" : "false");

// Free slots for the current modal session, grouped by weapon class (A/C). Each entry is
// { time, nodeId, kind }. Populated on open from GetSpringskytteFreeSlots.
let springFreeSlotsByWc = null;

// Cached team availability for the current modal session — populated on open, consumed
// by per-class slot dropdown rendering. Refresh on each modal open.
let dpTeamAvailabilityCache = null;

async function refreshDpTeamAvailability() {
    if (!walkInDirektplaceringEnabled) { dpTeamAvailabilityCache = null; return; }
    const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
    try {
        const resp = await fetch(`/umbraco/surface/Competition/GetTeamAvailability?competitionId=${competitionId}`);
        const data = await resp.json();
        dpTeamAvailabilityCache = (data.success && Array.isArray(data.teams))
            ? data.teams.slice().sort((a, b) => a.teamNumber - b.teamNumber)
            : [];
    } catch (err) {
        console.warn('Could not load team availability:', err);
        dpTeamAvailabilityCache = [];
    }
}

// Build a `<select>` of slots with our standard label + capacity badge. The shooter's
// existing assignment for THIS class (if any) is excluded from the "FULLT" check so
// re-saving an unchanged Edit doesn't disable the slot they already hold.
function buildDpSlotSelect(classId, preselected, ownExistingForThisClass) {
    const sel = document.createElement('select');
    sel.className = 'form-select form-select-sm dp-slot-select';
    sel.dataset.classId = classId;

    const noneOpt = new Option('— Inget skjutlag —', '');
    sel.add(noneOpt);

    (dpTeamAvailabilityCache || []).forEach(t => {
        const labelBits = [`Skjutlag ${t.teamNumber}`];
        if (t.startTime) labelBits.push(t.startTime);
        if (t.label) labelBits.push(t.label);
        const head = labelBits.join(' · ');
        const tail = `${t.positionsRemaining}/${t.positionsTotal} lediga`;
        const opt = new Option(`${head} (${tail})`, String(t.teamNumber));
        // "FULLT" only blocks NEW bookings — if this is the slot the shooter already holds
        // for this class, leave it selectable so a no-op save doesn't fail.
        if (t.isFull && t.teamNumber !== ownExistingForThisClass) {
            opt.disabled = true;
            opt.text = `${head} (FULLT)`;
        }
        sel.add(opt);
    });

    if (preselected != null && preselected !== '') {
        sel.value = String(preselected);
    }
    return sel;
}

// Render one row per checked class into a host container. Each row shows the class label
// and a slot dropdown. Used by both the walk-in modal and the Edit Registration modal.
function renderDpSlotRows(hostEl, checkedClasses, existingTeamByClass) {
    if (!walkInDirektplaceringEnabled) { hostEl.innerHTML = ''; return; }
    // Capture current picks so re-renders (when more classes are ticked) don't clobber
    // what the operator has already chosen.
    const previous = {};
    hostEl.querySelectorAll('.dp-slot-select').forEach(s => {
        if (s.value) previous[s.dataset.classId] = s.value;
    });

    if (checkedClasses.length === 0) { hostEl.innerHTML = ''; return; }

    hostEl.innerHTML = '';
    const heading = document.createElement('div');
    heading.className = 'form-label fw-bold mb-1';
    heading.textContent = 'Skjutlag / tid per klass';
    hostEl.appendChild(heading);

    checkedClasses.forEach(c => {
        const row = document.createElement('div');
        row.className = 'd-flex align-items-center gap-2 mb-2';

        const label = document.createElement('div');
        label.className = 'small fw-semibold';
        label.style.minWidth = '120px';
        label.textContent = c.name || c.id;
        row.appendChild(label);

        const presel = previous[c.id] != null
            ? previous[c.id]
            : (existingTeamByClass && existingTeamByClass[c.id] != null ? existingTeamByClass[c.id] : '');
        const sel = buildDpSlotSelect(c.id, presel,
            existingTeamByClass ? existingTeamByClass[c.id] : null);
        row.appendChild(sel);

        hostEl.appendChild(row);
    });
}

// ─── Springskytte rullande start: free start-time slots per weapon class ────

// Weapon class (A/C) from a registration class id like "A-D 21" / "C-H 35" / "A".
function springClassWeapon(classId) {
    const head = String(classId || '').trim().split('-')[0].trim().toUpperCase();
    return head.startsWith('A') ? 'A' : (head.startsWith('C') ? 'C' : head.charAt(0));
}

// "HH:mm:ss" → "HH:mm" for display; leaves anything unexpected untouched.
function springTimeShort(t) {
    const m = String(t || '').match(/^(\d{1,2}):(\d{2})/);
    return m ? `${m[1].padStart(2, '0')}:${m[2]}` : String(t || '');
}

// The walk-in's selected classes as [{id, name}], unified across both selectors:
// Springskytte → weapon checkboxes (A/C) × one age dropdown → "A-<age>" / "C-<age>";
// everything else → the flat #walkInClassList checkboxes. Single source of truth for the
// submit collection, submit-enabled state, and the Springskytte start-time slot rows.
function getWalkInSelectedClasses() {
    if (walkInSpringskytteEnabled) {
        const age = document.getElementById('walkInSpringAgeClass')?.value || '';
        if (!age) return [];
        const out = [];
        const a = document.getElementById('walkInSpringWeaponA');
        const c = document.getElementById('walkInSpringWeaponC');
        if (a && a.checked) out.push({ id: `A-${age}`, name: `A · ${age}` });
        if (c && c.checked) out.push({ id: `C-${age}`, name: `C · ${age}` });
        return out;
    }
    return Array.from(document.querySelectorAll('#walkInClassList .walk-in-class-cb:checked'))
        .map(cb => ({ id: cb.value, name: cb.dataset.className || cb.value }));
}

// Pull the competition's free start slots (paus gaps, DNS-freed times, trailing "efter" slots)
// once per modal open and bucket them by weapon class for the per-class dropdowns. Fails soft:
// no slots → the class rows just show "ingen startlista genererad".
async function refreshSpringFreeSlots() {
    springFreeSlotsByWc = { A: [], C: [] };
    if (!walkInSpringskytteEnabled) return;
    try {
        const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
        const resp = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteFreeSlots?competitionId=${competitionId}`);
        const data = await resp.json();
        if (!data.success || !Array.isArray(data.freeSlots)) return;
        const byWc = {};
        data.freeSlots.forEach(s => {
            const wc = String(s.weaponClass || '').toUpperCase();
            if (!wc) return;
            (byWc[wc] = byWc[wc] || []).push({ time: s.time, nodeId: s.nodeId, kind: s.kind });
        });
        Object.keys(byWc).forEach(wc => byWc[wc].sort((a, b) => String(a.time).localeCompare(String(b.time))));
        springFreeSlotsByWc = byWc;
    } catch (err) {
        console.warn('Could not load Springskytte free slots for walk-in:', err);
    }
}

// One start-time dropdown per ticked class (mirrors the DP per-class slot rows). Preserves any
// picks already made so re-renders (as more classes are ticked) don't clobber them.
function renderSpringSlotRows(hostEl, checkedClasses) {
    if (!walkInSpringskytteEnabled || !hostEl) return;
    const previous = {};
    hostEl.querySelectorAll('.spring-slot-select').forEach(s => {
        if (s.value) previous[s.dataset.classId] = s.value;
    });

    if (checkedClasses.length === 0) { hostEl.innerHTML = ''; return; }

    hostEl.innerHTML = '';
    const heading = document.createElement('div');
    heading.className = 'form-label fw-bold mb-1';
    heading.textContent = 'Starttid per klass';
    hostEl.appendChild(heading);

    checkedClasses.forEach(c => {
        const wc = springClassWeapon(c.id);
        const slots = (springFreeSlotsByWc && springFreeSlotsByWc[wc]) || [];

        const row = document.createElement('div');
        row.className = 'd-flex align-items-center gap-2 mb-2';

        const label = document.createElement('div');
        label.className = 'small fw-semibold';
        label.style.minWidth = '120px';
        label.textContent = c.name || c.id;
        row.appendChild(label);

        if (slots.length === 0) {
            const note = document.createElement('div');
            note.className = 'form-text text-muted small mb-0';
            note.textContent = 'Ingen startlista genererad — anmäls utan starttid.';
            row.appendChild(note);
        } else {
            const sel = document.createElement('select');
            sel.className = 'form-select form-select-sm spring-slot-select';
            sel.dataset.classId = c.id;
            // Placeholder is empty + non-submittable so a start-time choice is REQUIRED — a forgotten
            // dropdown must not silently leave the shooter off the start list. "Lägg inte på
            // startlistan" is an explicit, deliberate option alongside the actual times.
            const placeholder = new Option('— Välj starttid —', '');
            placeholder.disabled = true;
            sel.add(placeholder);
            sel.add(new Option('Lägg inte på startlistan', 'skip'));
            slots.forEach(s => {
                const kindLabel = s.kind === 'dns' ? 'ledig (DNS)' : (s.kind === 'paus' ? 'lucka' : 'efter sista');
                const opt = new Option(`kl ${springTimeShort(s.time)} · ${kindLabel}`, `${s.time}|${s.nodeId}`);
                sel.add(opt);
            });
            // Restore a prior pick if any; otherwise leave the (empty) placeholder selected so the
            // submit button stays disabled until the operator actively chooses.
            sel.value = (previous[c.id] != null) ? previous[c.id] : '';
            row.appendChild(sel);
        }

        hostEl.appendChild(row);
    });
}

async function refreshWalkInPatrolOptions() {
    if (!walkInPatrolPickerEnabled) return;
    const select = document.getElementById('walkInPatrolTarget');
    if (!select) return;
    const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
    // Strip dynamic options (everything past the two static targets).
    while (select.options.length > 2) select.remove(2);
    try {
        const resp = await fetch(`/umbraco/surface/Faltskytte/GetPatrols?competitionId=${competitionId}`);
        const data = await resp.json();
        if (data.success && Array.isArray(data.patrols)) {
            // Highest-numbered first matches "Nästa lediga" intuition (most recent, likely still open).
            data.patrols.slice().sort((a, b) => b.patrolNumber - a.patrolNumber).forEach(p => {
                const wg = p.weaponGroup ? ` · ${p.weaponGroup}` : '';
                const lbl = p.label ? ` — ${p.label}` : '';
                const count = (p.members || []).length;
                const opt = new Option(`Patrull ${p.patrolNumber}${lbl}${wg} (${count} skyttar)`, String(p.patrolId));
                select.add(opt);
            });
        }
    } catch (err) {
        console.warn('Could not load patrols for walk-in picker:', err);
    }
}

// Mutual-exclusion bucket for a class id. Mirrors the public registration form's radio
// groupings so a checkbox-style modal still treats "C1, C2, C3" as a swap, not a stack.
//   "C1", "C2", "C3"             → "C:open"     (regular C — pick one)
//   "C_Vet_Y", "C_Vet_A"         → "C:vet"      (vet C — pick one)
//   "C_Jun"                      → "C:jun"
//   "C1_Dam", "C2_Dam"           → "C:dam"
//   "A_opt_1", "A_opt_2"         → "A_Opt:open"
//   "A-D 21" (Springskytte)      → unique bucket per id (composite age/gender, no swap)
//
// When the operator ticks a class, anything already ticked in the same bucket is unticked
// automatically. Two classes from *different* buckets (e.g. C1 + R1) stay independent.
function getClassMutexBucket(classId) {
    const id = String(classId || '');
    if (!id) return '';
    // Springskytte composite — each combination is its own bucket so multi-class still works.
    if (id.includes('-')) return `springskytte:${id}`;

    // A-family weapon groups: A, A_Opt, A_M, A_P, A_G are each their own bucket so a
    // shooter can register in A1 + AM1 + AP1 + AG1 + A_opt_1 simultaneously. Without
    // this, the simple first-char mapping would lump them all into "A" and the cashier
    // mutex would auto-untick when a second A-family class is picked.
    let weapon = id.charAt(0).toUpperCase();
    if (/^A_opt/i.test(id)) weapon = 'A_Opt';
    else if (/^A_m_/i.test(id)) weapon = 'A_M';
    else if (/^A_p_/i.test(id)) weapon = 'A_P';
    else if (/^A_g_/i.test(id)) weapon = 'A_G';

    let subcat = 'open';
    if (/_Jun(\b|$|_)/i.test(id)) subcat = 'jun';
    else if (/_Vet_/i.test(id)) subcat = 'vet';
    else if (/Dam/i.test(id)) subcat = 'dam';

    return `${weapon}:${subcat}`;
}

// Apply mutex semantics within a checkbox container: when a checkbox is ticked, untick any
// other checkbox sharing the same bucket. Returns true when the action mutated the DOM so
// callers can re-render dependent UI (per-class slot rows, submit-button enabled state, …).
function enforceClassMutex(containerSelector, justChanged) {
    if (!justChanged || !justChanged.checked) return false;
    const myBucket = getClassMutexBucket(justChanged.value);
    if (!myBucket) return false;
    let mutated = false;
    document.querySelectorAll(`${containerSelector} input[type="checkbox"]`).forEach(cb => {
        if (cb === justChanged) return;
        if (!cb.checked) return;
        if (getClassMutexBucket(cb.value) === myBucket) {
            cb.checked = false;
            mutated = true;
        }
    });
    return mutated;
}

// Probe the competition for an existing precisionStartList. When present, surface a
// "Skjutlag" picker so the cashier can drop the new walk-in onto a specific team
// without anyone having to regenerate the whole list. Hidden silently when there's
// no start list yet — the operator can still register the shooter and let someone
// regenerate later.
async function refreshWalkInStartListTeams() {
    const wrapper = document.getElementById('walkInStartListPickerWrapper');
    const select = document.getElementById('walkInStartListTeam');
    if (!wrapper || !select) return;
    wrapper.classList.add('d-none');
    while (select.options.length > 1) select.remove(1);
    select.value = '';
    try {
        const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
        const resp = await fetch(`/umbraco/surface/RegistrationAdmin/GetWalkInStartListTeams?competitionId=${competitionId}`);
        const data = await resp.json();
        if (!data.success || !data.hasStartList || !Array.isArray(data.teams) || data.teams.length === 0) return;

        data.teams
            .slice()
            .sort((a, b) => a.teamNumber - b.teamNumber)
            .forEach(t => {
                const labelBits = [`Skjutlag ${t.teamNumber}`];
                if (t.startTime) {
                    labelBits.push(t.endTime ? `${t.startTime}-${t.endTime}` : t.startTime);
                }
                const head = labelBits.join(' · ');
                const tail = `${t.positionsRemaining}/${t.positionsTotal} lediga`;
                const opt = new Option(`${head} (${tail})`, String(t.teamNumber));
                if (t.isFull) {
                    opt.disabled = true;
                    opt.text = `${head} (FULLT)`;
                }
                select.add(opt);
            });
        wrapper.classList.remove('d-none');
    } catch (err) {
        console.warn('Could not load start-list teams for walk-in picker:', err);
    }
}

async function openWalkInRegistrationModal() {
    // Reset state
    document.getElementById('walkInMemberSearch').value = '';
    document.getElementById('walkInMemberResults').innerHTML = '';
    document.getElementById('walkInSelectedMember').textContent = 'Ingen vald än';
    document.getElementById('walkInSelectedMember').classList.add('text-muted');
    document.getElementById('walkInSelectedMemberId').value = '';
    document.getElementById('walkInError').classList.add('d-none');
    document.getElementById('walkInSubmitBtn').disabled = true;
    // Hide the club picker until a shooter is picked — a stale one from the previous walk-in
    // would offer the wrong shooter's clubs.
    document.getElementById('walkInClubBlock')?.classList.add('d-none');

    // Reset the deltävling opt-in on each open so a stale tick from a previous walk-in
    // doesn't silently surcharge the next shooter.
    const walkInSubCompCb = document.getElementById('walkInSubCompetitionCheckbox');
    if (walkInSubCompCb) walkInSubCompCb.checked = false;

    if (walkInSpringskytteEnabled) {
        // Springskytte uses the server-rendered A/C + age-class selector (mirrors the public modal).
        // Just reset it here — nothing to build in JS.
        const wA = document.getElementById('walkInSpringWeaponA');
        const wC = document.getElementById('walkInSpringWeaponC');
        if (wA) wA.checked = false;
        if (wC) wC.checked = false;
        const wAge = document.getElementById('walkInSpringAgeClass');
        if (wAge) wAge.value = '';
    } else {
        // Populate the class checkbox list from the competition's actual allowed classes.
        // Multi-class so the cashier can register A + C in a single round trip — particularly
        // important for direktplacering competitions where each class needs its own slot.
        const classListEl = document.getElementById('walkInClassList');
        const classes = (Array.isArray(walkInAvailableClasses) && walkInAvailableClasses.length > 0)
            ? walkInAvailableClasses
            : []; // No fallback for the multi-class form — operator must have a configured class list.

        if (classes.length === 0) {
            classListEl.innerHTML = '<div class="text-muted small">Inga klasser tillgängliga för denna tävling.</div>';
        } else {
            classListEl.innerHTML = classes.map(c => {
                const safeId = `walkInCls_${c.id.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
                return `
                    <div class="form-check">
                        <input class="form-check-input walk-in-class-cb" type="checkbox"
                               id="${safeId}" value="${c.id}" data-class-name="${(c.name || c.id).replace(/"/g, '&quot;')}">
                        <label class="form-check-label" for="${safeId}">${c.name || c.id}</label>
                    </div>`;
            }).join('');
        }
    }

    if (!walkInModalInstance) {
        walkInModalInstance = new bootstrap.Modal(document.getElementById('walkInRegistrationModal'));
    }

    // Reset patrol picker to the default and (re-)fetch existing patrols so a refresh
    // mid-day reflects what other operators have created since the modal was last open.
    if (walkInPatrolPickerEnabled) {
        const sel = document.getElementById('walkInPatrolTarget');
        if (sel) sel.value = 'nextAvailable';
        refreshWalkInPatrolOptions();
    }

    // Pull live team availability when the modal opens. Per-class slot dropdowns are
    // rendered as the operator ticks classes (driven by the checkbox change handler).
    if (walkInDirektplaceringEnabled) {
        const slots = document.getElementById('walkInDpSlotsContainer');
        if (slots) slots.innerHTML = '';
        await refreshDpTeamAvailability();
    }

    // Springskytte rullande start: pull the free start slots once, clear the per-class rows
    // (they render as classes are ticked, via the checkbox change handler).
    if (walkInSpringskytteEnabled) {
        const springHost = document.getElementById('walkInSpringSlotsContainer');
        if (springHost) springHost.innerHTML = '';
        await refreshSpringFreeSlots();
    }

    // Non-DP / non-rolling-start / non-Springskytte: probe for an existing precisionStartList and
    // render the team picker only if one is present with usable teams. This is the equivalent
    // of the DP slot picker for "regular" precision competitions where the start list
    // is generated all-at-once but we still want a clean way to drop a late shooter in.
    if (!walkInPatrolPickerEnabled && !walkInDirektplaceringEnabled && !walkInSpringskytteEnabled) {
        await refreshWalkInStartListTeams();
    }

    // Reset quick-create state every time the modal opens — collapsed form, cleared
    // inputs, club picker re-populated (cached after first load) with the
    // competition's organising club preselected.
    resetWalkInQuickCreate();
    ensureWalkInQuickCreateClubs();

    walkInModalInstance.show();
    setTimeout(() => document.getElementById('walkInMemberSearch').focus(), 250);
}

// ─── Quick-create new member (mirrors the public modal's flow) ──────

let walkInQcClubsLoaded = false;

function resetWalkInQuickCreate() {
    const form = document.getElementById('walkInQuickCreateForm');
    if (form) form.style.display = 'none';
    ['walkInQcFirstName', 'walkInQcLastName', 'walkInQcEmail'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
    });
    const auto = document.getElementById('walkInQcAutoApprove');
    if (auto) auto.checked = true;
    const msg = document.getElementById('walkInQcMessage');
    if (msg) msg.innerHTML = '';
    const btnText = document.getElementById('walkInQuickCreateBtnText');
    if (btnText) btnText.textContent = 'Lägg till ny medlem';
}

async function ensureWalkInQuickCreateClubs() {
    const select = document.getElementById('walkInQcClub');
    if (!select) return;
    const competitionClubId = $('.competition-registration-management').data('competition-club-id');
    if (walkInQcClubsLoaded) {
        // Re-select the competition's club on every open — operator may have left the
        // list on a different value last time and forgotten to switch back.
        if (competitionClubId) select.value = String(competitionClubId);
        updateWalkInQuickCreateBtnText();
        return;
    }
    try {
        // Pass the competition so a competition manager (who holds no club role) can load the list.
        const resp = await fetch(`/umbraco/surface/Competition/GetClubsForRegistration?competitionId=@competitionId`, {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await resp.json();
        if (data && Array.isArray(data.clubs)) {
            const opts = ['<option value="">Välj klubb...</option>']
                .concat(data.clubs.map(c => `<option value="${c.id}">${escapeWalkIn(c.name)}</option>`));
            select.innerHTML = opts.join('');
            walkInQcClubsLoaded = true;
            if (competitionClubId) select.value = String(competitionClubId);
            updateWalkInQuickCreateBtnText();
        }
    } catch (err) {
        console.error('Could not load clubs for walk-in quick-create:', err);
    }
}

function updateWalkInQuickCreateBtnText() {
    const select = document.getElementById('walkInQcClub');
    const btnText = document.getElementById('walkInQuickCreateBtnText');
    if (!select || !btnText) return;
    const opt = select.options[select.selectedIndex];
    btnText.textContent = (select.value && opt && opt.text)
        ? `Lägg till ny medlem i ${opt.text}`
        : 'Lägg till ny medlem';
}

function toggleWalkInQuickCreate() {
    const form = document.getElementById('walkInQuickCreateForm');
    if (!form) return;
    if (form.style.display === 'none') {
        form.style.display = '';
        document.getElementById('walkInQcFirstName')?.focus();
    } else {
        form.style.display = 'none';
        const msg = document.getElementById('walkInQcMessage');
        if (msg) msg.innerHTML = '';
    }
}

async function walkInQuickCreateMember() {
    const firstName = (document.getElementById('walkInQcFirstName').value || '').trim();
    const lastName  = (document.getElementById('walkInQcLastName').value || '').trim();
    const email     = (document.getElementById('walkInQcEmail').value || '').trim();
    const clubId    = document.getElementById('walkInQcClub').value;
    const autoApprove = document.getElementById('walkInQcAutoApprove').checked;
    const msg = document.getElementById('walkInQcMessage');

    if (!firstName || !lastName) { msg.innerHTML = '<span class="text-danger">Ange för- och efternamn.</span>'; return; }
    if (!email || !email.includes('@@')) { msg.innerHTML = '<span class="text-danger">Ange en giltig e-postadress.</span>'; return; }
    if (!clubId) { msg.innerHTML = '<span class="text-danger">Välj en klubb.</span>'; return; }

    msg.innerHTML = '<span class="text-muted">Skapar...</span>';

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        const resp = await fetch('/umbraco/surface/Member/QuickCreateMember', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ firstName, lastName, email, clubId: parseInt(clubId, 10), autoApprove })
        });
        const data = await resp.json();
        if (data.success) {
            const actionText = data.alreadyExisted ? ' hittad (redan registrerad)' : ' skapad';
            msg.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>${escapeWalkIn(data.memberName)}${actionText}</span>`;

            // Drop the freshly-created member straight into the search field +
            // selection, so the cashier can keep going to class selection.
            const clubOpt = document.getElementById('walkInQcClub').options[document.getElementById('walkInQcClub').selectedIndex];
            const clubName = clubOpt ? clubOpt.text : '';
            selectWalkInMember(data.memberId, data.memberName, clubName);

            setTimeout(() => {
                const form = document.getElementById('walkInQuickCreateForm');
                if (form) form.style.display = 'none';
                ['walkInQcFirstName', 'walkInQcLastName', 'walkInQcEmail'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.value = '';
                });
                msg.innerHTML = '';
            }, 1200);
        } else {
            msg.innerHTML = `<span class="text-danger">${escapeWalkIn(data.message || 'Fel vid skapande.')}</span>`;
        }
    } catch (err) {
        console.error('walkInQuickCreateMember error:', err);
        msg.innerHTML = '<span class="text-danger">Nätverksfel.</span>';
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('walkInQcClub');
    if (select) select.addEventListener('change', updateWalkInQuickCreateBtnText);
});

// Hook checkbox toggles after the modal builds its list so the per-class slot rows
// stay in sync. Delegated listener on the container survives re-renders. Auto-unticking
// "siblings" in the same mutex bucket (C1 ↔ C2 ↔ C3, C_Vet_Y ↔ C_Vet_A, …) mirrors
// the public registration form so swapping a class doesn't accidentally bill twice.
document.addEventListener('DOMContentLoaded', () => {
    const list = document.getElementById('walkInClassList');
    if (!list) return;
    list.addEventListener('change', (e) => {
        if (!e.target.classList.contains('walk-in-class-cb')) return;
        enforceClassMutex('#walkInClassList', e.target);
        if (walkInDirektplaceringEnabled) {
            const checked = Array.from(list.querySelectorAll('.walk-in-class-cb:checked'))
                .map(cb => ({ id: cb.value, name: cb.dataset.className || cb.value }));
            const host = document.getElementById('walkInDpSlotsContainer');
            if (host) renderDpSlotRows(host, checked, {});
        }
        refreshWalkInSubmitState();
    });
});

// Springskytte A/C + age-class selector: any change re-renders the per-class start-time rows
// and re-evaluates the submit button. The controls are server-rendered, so they exist at load.
document.addEventListener('DOMContentLoaded', () => {
    if (!walkInSpringskytteEnabled) return;
    document.querySelectorAll('.walk-in-spring-ctl').forEach(el => {
        el.addEventListener('change', () => {
            const host = document.getElementById('walkInSpringSlotsContainer');
            if (host) renderSpringSlotRows(host, getWalkInSelectedClasses());
            refreshWalkInSubmitState();
        });
    });
    // Picking a start time (or "Lägg inte på startlistan") in a dynamically-rendered row must
    // re-enable the submit button — the rows require an explicit choice. Delegated so it works
    // across re-renders.
    const springSlotHost = document.getElementById('walkInSpringSlotsContainer');
    if (springSlotHost) {
        springSlotHost.addEventListener('change', (e) => {
            if (e.target.classList.contains('spring-slot-select')) refreshWalkInSubmitState();
        });
    }
});

// Debounced member search via the existing TrainingGroup/SearchMembers endpoint
// (which already handles four-tier auth and returns name + email + club).
document.addEventListener('DOMContentLoaded', () => {
    const search = document.getElementById('walkInMemberSearch');
    if (search) {
        search.addEventListener('input', () => {
            clearTimeout(walkInSearchTimer);
            const query = search.value.trim();
            const resultsBox = document.getElementById('walkInMemberResults');
            if (query.length < 2) {
                resultsBox.innerHTML = '';
                return;
            }
            walkInSearchTimer = setTimeout(() => doWalkInMemberSearch(query), 250);
        });
    }

    // Delegated click handler for the dynamically-built result list.
    const resultsBox = document.getElementById('walkInMemberResults');
    if (resultsBox) {
        resultsBox.addEventListener('click', (e) => {
            const btn = e.target.closest('.walk-in-result');
            if (!btn) return;
            e.preventDefault();
            const memberId = parseInt(btn.dataset.memberId, 10);
            const memberName = btn.dataset.memberName || '';
            const clubName = btn.dataset.clubName || '';
            selectWalkInMember(memberId, memberName, clubName);
        });
    }
});

function doWalkInMemberSearch(query) {
    const resultsBox = document.getElementById('walkInMemberResults');
    resultsBox.innerHTML = '<div class="list-group-item text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Söker...</div>';

    fetch(`/umbraco/surface/TrainingGroup/SearchMembers?query=${encodeURIComponent(query)}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                resultsBox.innerHTML = `<div class="list-group-item text-danger small">${data.message || 'Kunde inte söka'}</div>`;
                return;
            }
            const results = data.data || [];
            if (results.length === 0) {
                resultsBox.innerHTML = '<div class="list-group-item text-muted small">Inga träffar</div>';
                return;
            }
            // Use data-* attributes (HTML-escaped) and let a delegated click listener handle
            // selection. Avoids quote-escaping headaches with inline onclick.
            resultsBox.innerHTML = results.map(m => `
                <button type="button" class="list-group-item list-group-item-action walk-in-result"
                        data-member-id="${m.memberId}"
                        data-member-name="${escapeWalkIn(m.memberName || '')}"
                        data-club-name="${escapeWalkIn(m.clubName || '')}">
                    <strong>${escapeWalkIn(m.memberName)}</strong>
                    <small class="text-muted ms-2">${escapeWalkIn(m.clubName || '')}</small>
                    <small class="text-muted d-block">${escapeWalkIn(m.email || '')}</small>
                </button>`).join('');
        })
        .catch(err => {
            console.error('Walk-in member search failed:', err);
            resultsBox.innerHTML = '<div class="list-group-item text-danger small">Sökningen misslyckades</div>';
        });
}

function escapeWalkIn(s) {
    return String(s ?? '').replace(/[&<>"']/g, c =>
        ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function selectWalkInMember(memberId, memberName, clubName) {
    document.getElementById('walkInSelectedMemberId').value = memberId;
    const sel = document.getElementById('walkInSelectedMember');
    sel.textContent = clubName ? `${memberName} (${clubName})` : memberName;
    sel.classList.remove('text-muted');
    document.getElementById('walkInMemberResults').innerHTML = '';
    document.getElementById('walkInMemberSearch').value = memberName;
    populateWalkInClubSelect(memberId);
    refreshWalkInSubmitState();
}

// Show "Tävlar för" only when there is a genuine choice to make. Not awaited by the caller:
// the club defaults server-side to the shooter's primary club, so the desk can submit before
// the lookup lands and still get the right answer.
async function populateWalkInClubSelect(memberId) {
    const block = document.getElementById('walkInClubBlock');
    const sel = document.getElementById('walkInClubSelect');
    if (!block || !sel) return;

    block.classList.add('d-none');
    sel.innerHTML = '';

    const clubs = await fetchMemberClubs(memberId);
    // Guard against a slow response for a shooter the operator has already moved on from.
    if (parseInt(document.getElementById('walkInSelectedMemberId').value, 10) !== parseInt(memberId, 10)) return;
    if (clubs.length < 2) return;

    sel.innerHTML = clubs.map(c =>
        `<option value="${c.id}"${c.isPrimary ? ' selected' : ''}>` +
        `${escapeWalkIn(c.name)}${c.isPrimary ? ' (primär)' : ''}</option>`).join('');
    block.classList.remove('d-none');
}

function refreshWalkInSubmitState() {
    const memberId = document.getElementById('walkInSelectedMemberId').value;
    let ok = !!memberId && getWalkInSelectedClasses().length > 0;
    // Springskytte: every rendered start-time dropdown must have an explicit choice (a time OR
    // "Lägg inte på startlistan"). A blank placeholder blocks submit so a slot can't be forgotten.
    if (ok && walkInSpringskytteEnabled) {
        const springSelects = document.querySelectorAll('#walkInSpringSlotsContainer .spring-slot-select');
        for (const sel of springSelects) {
            if (!sel.value) { ok = false; break; }
        }
    }
    document.getElementById('walkInSubmitBtn').disabled = !ok;
}

async function submitWalkInRegistration() {
    const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
    const memberId = parseInt(document.getElementById('walkInSelectedMemberId').value, 10);

    // Multi-class: each checked class becomes one entry, paired with its per-class slot
    // (when direktplacering is enabled). Walk-ins don't pick a start preference — start
    // lists are typically already built by the time someone walks up.
    const slotByClass = {};
    if (walkInDirektplaceringEnabled) {
        document.querySelectorAll('#walkInDpSlotsContainer .dp-slot-select').forEach(sel => {
            if (sel.value) slotByClass[sel.dataset.classId] = parseInt(sel.value, 10);
        });
    }
    const classes = getWalkInSelectedClasses()
        .map(c => {
            const entry = { class: c.id, startPreference: 'Inget' };
            if (slotByClass[c.id] != null) entry.teamNumber = slotByClass[c.id];
            return entry;
        });

    const errBox = document.getElementById('walkInError');
    errBox.classList.add('d-none');

    if (classes.length === 0) {
        errBox.textContent = 'Välj minst en klass.';
        errBox.classList.remove('d-none');
        return;
    }

    const btn = document.getElementById('walkInSubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skapar...';

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const subCompCb = document.getElementById('walkInSubCompetitionCheckbox');
        const isSubCompetition = !!(subCompCb && subCompCb.checked);
        // Tävlar för — only present for a multi-club shooter; otherwise the server falls back
        // to their primary club.
        const walkInClubSel = document.getElementById('walkInClubSelect');
        const clubBlockVisible = !document.getElementById('walkInClubBlock')?.classList.contains('d-none');
        const clubId = (clubBlockVisible && walkInClubSel?.value) ? parseInt(walkInClubSel.value, 10) : null;

        const response = await fetch('/umbraco/surface/RegistrationAdmin/AddLateRegistration', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ competitionId, memberId, classes, isSubCompetition, clubId })
        });
        const data = await response.json();

        if (!data.success) {
            errBox.textContent = data.message || 'Kunde inte skapa anmälan';
            errBox.classList.remove('d-none');
            return;
        }

        const newRegistrationId = data.registrationId;

        // Item #5: rolling-start Fältskytte / MagnumFält — drop the new shooter on a patrol
        // immediately. Failure is non-fatal (the registration is the load-bearing operation);
        // the operator can fix the patrol assignment from the start-list tab afterward.
        if (walkInPatrolPickerEnabled) {
            const target = document.getElementById('walkInPatrolTarget')?.value || 'nextAvailable';
            try {
                const patrolResp = await fetch('/umbraco/surface/Faltskytte/AssignWalkInToPatrol', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ competitionId, registrationId: newRegistrationId, target })
                });
                const patrolData = await patrolResp.json();
                if (!patrolData.success) {
                    console.warn('Patrol assignment failed:', patrolData.message);
                }
            } catch (patrolErr) {
                console.warn('Patrol assignment threw:', patrolErr);
            }
        }

        // Springskytte rullande start: slot the new shooter onto the picked free start TIME, per
        // class. Same fail-soft semantics — registration is the load-bearing op; a slotting hiccup
        // is surfaced but the shooter can be placed from the Startlista tab afterward.
        if (walkInSpringskytteEnabled) {
            // Only rows where an actual time was picked get slotted; "skip" (Lägg inte på
            // startlistan) and the empty placeholder are deliberately left off the start list.
            const springSelects = Array.from(document.querySelectorAll('#walkInSpringSlotsContainer .spring-slot-select'))
                .filter(sel => sel.value && sel.value !== 'skip');
            for (const sel of springSelects) {
                const [startTime, nodeIdRaw] = sel.value.split('|');
                const nodeId = nodeIdRaw ? parseInt(nodeIdRaw, 10) : null;
                try {
                    const springResp = await fetch('/umbraco/surface/Springskytte/AssignSpringskytteWalkInStartTime', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ competitionId, memberId, shootingClass: sel.dataset.classId, startTime, nodeId })
                    });
                    const springData = await springResp.json();
                    if (!springData.success) {
                        console.warn('Springskytte start-time assignment failed:', springData.message);
                        errBox.textContent = 'Anmälan skapad, men kunde inte läggas på startlistan: '
                            + (springData.message || 'okänt fel');
                        errBox.classList.remove('d-none');
                    }
                } catch (springErr) {
                    console.warn('Springskytte start-time assignment threw:', springErr);
                }
            }
        }

        // Non-DP precision: drop the new shooter onto the picked start team. Same fail-soft
        // semantics as the patrol assignment above — registration is the load-bearing op.
        if (!walkInPatrolPickerEnabled && !walkInDirektplaceringEnabled && !walkInSpringskytteEnabled) {
            const teamRaw = document.getElementById('walkInStartListTeam')?.value || '';
            const teamNumber = teamRaw ? parseInt(teamRaw, 10) : null;
            if (teamNumber != null && Number.isFinite(teamNumber)) {
                try {
                    const slResp = await fetch('/umbraco/surface/RegistrationAdmin/AssignWalkInToStartListTeam', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({ competitionId, registrationId: newRegistrationId, teamNumber })
                    });
                    const slData = await slResp.json();
                    if (!slData.success) {
                        console.warn('Start-list team assignment failed:', slData.message);
                        errBox.textContent = 'Anmälan skapad, men kunde inte läggas på startlistan: '
                            + (slData.message || 'okänt fel');
                        errBox.classList.remove('d-none');
                    }
                } catch (slErr) {
                    console.warn('Start-list team assignment threw:', slErr);
                }
            }
        }

        // Eagerly create the invoice + compute the fee so the manage-invoice modal opens
        // with the real amount instead of "0 kr / Saknar betalning". The endpoint side-effect
        // creates the invoice using RegistrationFeeCalculator (the single source of truth
        // for fee math), so we get the same number as a normal Swish-pay flow would.
        let invoiceInfo = null;
        try {
            const qrResponse = await fetch(
                `/umbraco/surface/Swish/GeneratePaymentQR?competitionId=${competitionId}&targetMemberId=${memberId}`);
            const qrData = await qrResponse.json();
            if (qrData.success) {
                invoiceInfo = {
                    invoiceId: qrData.invoiceId,
                    invoiceNumber: qrData.invoiceNumber,
                    paymentAmount: qrData.amount
                };
            }
        } catch (qrErr) {
            // Non-fatal — the registration was created. The manage modal's lazy path will
            // create the invoice on demand if this preflight failed.
            console.warn('Walk-in invoice pre-creation failed, will fall back to lazy creation:', qrErr);
        }

        walkInModalInstance?.hide();

        // Refresh the list and open the manage modal for the new row. We patch the row's
        // invoice fields from invoiceInfo as soon as the row appears, so the modal sees
        // the correct amount even on the first paint.
        loadCompetitionRegistrations();
        const wait = setInterval(() => {
            const reg = competitionRegistrations.find(r => r.id === newRegistrationId);
            if (reg) {
                clearInterval(wait);
                if (invoiceInfo) {
                    if (invoiceInfo.invoiceId) reg.invoiceId = invoiceInfo.invoiceId;
                    if (invoiceInfo.invoiceNumber) reg.invoiceNumber = invoiceInfo.invoiceNumber;
                    if (invoiceInfo.paymentAmount) reg.paymentAmount = invoiceInfo.paymentAmount;
                    if (reg.paymentStatus === 'No Invoice') {
                        reg.paymentStatus = 'Pending';
                        reg.pendingAmount = (Number(reg.pendingAmount) || 0) + (Number(invoiceInfo.paymentAmount) || 0);
                    }
                }
                showPaymentOptionsForRegistration(newRegistrationId);
            }
        }, 200);
        setTimeout(() => clearInterval(wait), 5000);
    } catch (err) {
        errBox.textContent = 'Ett fel uppstod: ' + err.message;
        errBox.classList.remove('d-none');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-arrow-right me-1"></i>Skapa anmälan och fortsätt';
    }
}

// ──────────────────────────────────────────────────────────────────────
// Transfer registration — re-points a registration (and its invoices) to
// a different shooter. Used when shooter A drops out and shooter B takes
// their spot. Member-search pattern mirrors the walk-in modal's.
// ──────────────────────────────────────────────────────────────────────
let transferModalInstance = null;
let transferSearchTimer = null;

function openTransferRegistrationModal() {
    // Triggered from the Edit Registration modal's "Överför till annan skytt" button.
    // We pull the registration id and name from the edit-modal hidden inputs (still
    // populated at this point) so the operator doesn't lose context.
    const regId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
    if (!regId) return;
    const reg = competitionRegistrations.find(r => r.id === regId);
    if (!reg) return;

    document.getElementById('transferRegistrationId').value = regId;
    document.getElementById('transferFromName').textContent =
        reg.memberClub ? `${reg.memberName} (${reg.memberClub})` : reg.memberName || '';
    document.getElementById('transferMemberSearch').value = '';
    document.getElementById('transferMemberResults').innerHTML = '';
    document.getElementById('transferSelectedMember').textContent = 'Ingen vald än';
    document.getElementById('transferSelectedMember').classList.add('text-muted');
    document.getElementById('transferSelectedMemberId').value = '';
    document.getElementById('transferError').classList.add('d-none');
    document.getElementById('transferSubmitBtn').disabled = true;

    // Hide the edit modal first so the transfer modal stacks cleanly.
    bootstrap.Modal.getInstance(document.getElementById('competitionEditRegistrationModal'))?.hide();

    if (!transferModalInstance) {
        transferModalInstance = new bootstrap.Modal(document.getElementById('transferRegistrationModal'));
    }
    setTimeout(() => {
        transferModalInstance.show();
        document.getElementById('transferMemberSearch').focus();
    }, 250);
}

// Wire member-search + delegated click on the result list. Mirrors the walk-in pattern.
document.addEventListener('DOMContentLoaded', () => {
    const search = document.getElementById('transferMemberSearch');
    if (search) {
        search.addEventListener('input', () => {
            clearTimeout(transferSearchTimer);
            const query = search.value.trim();
            const resultsBox = document.getElementById('transferMemberResults');
            if (query.length < 2) {
                resultsBox.innerHTML = '';
                return;
            }
            transferSearchTimer = setTimeout(() => doTransferMemberSearch(query), 250);
        });
    }
    const resultsBox = document.getElementById('transferMemberResults');
    if (resultsBox) {
        resultsBox.addEventListener('click', (e) => {
            const btn = e.target.closest('.transfer-result');
            if (!btn) return;
            e.preventDefault();
            const memberId = parseInt(btn.dataset.memberId, 10);
            const memberName = btn.dataset.memberName || '';
            const clubName = btn.dataset.clubName || '';
            selectTransferMember(memberId, memberName, clubName);
        });
    }
});

function doTransferMemberSearch(query) {
    const resultsBox = document.getElementById('transferMemberResults');
    resultsBox.innerHTML = '<div class="list-group-item text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Söker...</div>';

    fetch(`/umbraco/surface/TrainingGroup/SearchMembers?query=${encodeURIComponent(query)}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                resultsBox.innerHTML = `<div class="list-group-item text-danger small">${data.message || 'Kunde inte söka'}</div>`;
                return;
            }
            const results = data.data || [];
            if (results.length === 0) {
                resultsBox.innerHTML = '<div class="list-group-item text-muted small">Inga träffar</div>';
                return;
            }
            resultsBox.innerHTML = results.map(m => `
                <button type="button" class="list-group-item list-group-item-action transfer-result"
                        data-member-id="${m.memberId}"
                        data-member-name="${escapeWalkIn(m.memberName || '')}"
                        data-club-name="${escapeWalkIn(m.clubName || '')}">
                    <strong>${escapeWalkIn(m.memberName)}</strong>
                    <small class="text-muted ms-2">${escapeWalkIn(m.clubName || '')}</small>
                    <small class="text-muted d-block">${escapeWalkIn(m.email || '')}</small>
                </button>`).join('');
        })
        .catch(err => {
            console.error('Transfer member search failed:', err);
            resultsBox.innerHTML = '<div class="list-group-item text-danger small">Sökningen misslyckades</div>';
        });
}

function selectTransferMember(memberId, memberName, clubName) {
    document.getElementById('transferSelectedMemberId').value = memberId;
    const sel = document.getElementById('transferSelectedMember');
    sel.textContent = clubName ? `${memberName} (${clubName})` : memberName;
    sel.classList.remove('text-muted');
    document.getElementById('transferMemberResults').innerHTML = '';
    document.getElementById('transferMemberSearch').value = memberName;
    document.getElementById('transferSubmitBtn').disabled = false;
}

async function confirmTransferRegistration() {
    const registrationId = parseInt(document.getElementById('transferRegistrationId').value, 10);
    const toMemberId = parseInt(document.getElementById('transferSelectedMemberId').value, 10);
    if (!registrationId || !toMemberId) return;

    const errBox = document.getElementById('transferError');
    errBox.classList.add('d-none');
    const btn = document.getElementById('transferSubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Överför...';

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const response = await fetch('/umbraco/surface/RegistrationAdmin/TransferRegistration', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ registrationId, toMemberId })
        });
        const data = await response.json();
        if (!data.success) {
            errBox.textContent = data.message || 'Kunde inte överföra anmälan';
            errBox.classList.remove('d-none');
            return;
        }
        transferModalInstance?.hide();
        loadCompetitionRegistrations();
    } catch (err) {
        errBox.textContent = 'Ett fel uppstod: ' + err.message;
        errBox.classList.remove('d-none');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Överför anmälan';
    }
}

// ──────────────────────────────────────────────────────────────────────
// Invoice history modal — read-only timeline of audit events for one invoice.
// ──────────────────────────────────────────────────────────────────────
let invoiceHistoryModalInstance = null;

function showInvoiceHistory(invoiceId, memberName) {
    const modalEl = document.getElementById('invoiceHistoryModal');
    if (!invoiceHistoryModalInstance) {
        invoiceHistoryModalInstance = new bootstrap.Modal(modalEl);
    }
    document.getElementById('invoiceHistoryHeader').textContent = memberName ? `För ${memberName}` : '';
    document.getElementById('invoiceHistoryRef').textContent = '';
    document.getElementById('invoiceHistoryBody').innerHTML = `
        <div class="text-center py-3">
            <div class="spinner-border spinner-border-sm me-2" role="status"></div>Laddar historik...
        </div>`;
    invoiceHistoryModalInstance.show();

    fetch(`/umbraco/surface/InvoiceAdmin/GetInvoiceHistory?invoiceId=${invoiceId}`)
        .then(r => r.json())
        .then(data => renderInvoiceHistory(data))
        .catch(err => {
            console.error('Error loading invoice history:', err);
            document.getElementById('invoiceHistoryBody').innerHTML =
                '<div class="alert alert-danger">Kunde inte ladda historiken: ' + err.message + '</div>';
        });
}

function renderInvoiceHistory(data) {
    const body = document.getElementById('invoiceHistoryBody');
    if (!data || !data.success) {
        body.innerHTML = `<div class="alert alert-warning">${(data && data.message) || 'Kunde inte ladda historik.'}</div>`;
        return;
    }
    const events = data.events || [];
    if (events.length === 0) {
        body.innerHTML = '<div class="alert alert-light mb-0">Inga händelser registrerade ännu.</div>';
        return;
    }

    // Pretty event-type labels in Swedish
    const labelFor = t => ({
        Created: 'Faktura skapad',
        MarkedPaid: 'Markerad som betald (mottagen)',
        Cancelled: 'Makulerad',
        Refunded: 'Återbetald',
        EmailSent: 'E-post skickad',
        ReceiptSent: 'Betalningsbekräftelse skickad',
        ReceiptFailed: 'Betalningsbekräftelse kunde INTE skickas',
        Transferred: 'Överförd till annan skytt',
        StatusChanged: 'Status ändrad',
        PaymentSent: 'Betalning anmäld av betalaren',
        PaymentSentCleared: 'Betalningsanmälan återkallad',
        Consolidated: 'Lagd i samlingsfaktura',
        ConsolidationCancelled: 'Frisläppt ur samlingsfaktura'
    })[t] || t;
    const colorFor = t => ({
        Created: 'secondary',
        MarkedPaid: 'success',
        Cancelled: 'danger',
        Refunded: 'warning',
        EmailSent: 'info',
        ReceiptSent: 'info',
        ReceiptFailed: 'danger',
        Transferred: 'warning',
        StatusChanged: 'secondary',
        PaymentSent: 'info',
        PaymentSentCleared: 'secondary',
        Consolidated: 'primary',
        ConsolidationCancelled: 'secondary'
    })[t] || 'secondary';

    // The reference is normally the invoice number, identical on every row — hoist it into the
    // header and drop the column so the remaining ones stop line-breaking. Only keep the column
    // when the rows genuinely differ (e.g. a Swish transaction id on the MarkedPaid row).
    const refs = [...new Set(events.map(e => (e.reference || '').trim()).filter(r => r !== ''))];
    const singleRef = refs.length === 1 ? refs[0] : null;
    const refEl = document.getElementById('invoiceHistoryRef');
    if (refEl) refEl.textContent = singleRef ? `Referens: ${singleRef}` : '';

    let html = '<div class="table-responsive"><table class="table table-sm align-middle mb-0">';
    html += '<thead><tr><th>När</th><th>Händelse</th><th>Av</th><th>Metod</th><th class="text-end">Belopp</th>'
        + (singleRef ? '' : '<th>Referens</th>') + '<th>Anteckning</th></tr></thead><tbody>';
    events.forEach(e => {
        // Audit events are stamped with DateTime.UtcNow — see the note at the top of this script.
        const when = formatUtcDateTime(e.occurredAt);
        const amount = (e.amount != null && e.amount !== '') ? Math.round(Number(e.amount)) + ' kr' : '';
        // A payment method is only meaningful for events where money actually moved.
        // For "Faktura skapad", cancellations, emails, transfers etc. the stored method
        // is just the *intended* channel (defaults to Swish) — showing it there makes an
        // unpaid invoice look paid, so suppress it everywhere except real payment/refund events.
        const showMethod = (e.eventType === 'MarkedPaid' || e.eventType === 'Refunded');
        // An EmailSent row is either a bulk payment reminder or a one-off QR resend — the
        // note tells them apart. Label reminders explicitly so the trail reads clearly.
        let typeLabel = labelFor(e.eventType);
        if (e.eventType === 'EmailSent' && (e.notes || '').toLowerCase().includes('påminnelse')) {
            typeLabel = 'Påminnelse skickad';
        }
        html += `<tr>
            <td class="small text-nowrap">${escapeHistory(when)}</td>
            <td class="text-nowrap"><span class="badge bg-${colorFor(e.eventType)}">${escapeHistory(typeLabel)}</span></td>
            <td class="small text-nowrap">${escapeHistory(e.byMemberName || '—')}</td>
            <td class="small text-nowrap">${showMethod ? escapeHistory(e.paymentMethod || '') : ''}</td>
            <td class="small text-end text-nowrap">${escapeHistory(amount)}</td>
            ${singleRef ? '' : `<td class="small">${escapeHistory(e.reference || '')}</td>`}
            <td class="small">${escapeHistory(e.notes || '')}</td>
        </tr>`;
    });
    html += '</tbody></table></div>';
    body.innerHTML = html;
}

function escapeHistory(s) {
    return String(s ?? '').replace(/[&<>"']/g, c =>
        ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// ──────────────────────────────────────────────────────────────────────
// Bulk payment reminders — sends a Swish QR-code email to every pending
// invoice on this competition. Each send produces one EmailSent audit event.
// ──────────────────────────────────────────────────────────────────────
let sendRemindersModalInstance = null;
let reminderDefaultMessage = '';   // standard message, fetched from the server so it can't drift
let reminderRecipients = [];       // eligible recipients for the current competition

function openSendRemindersModal() {
    const competitionId = $('.competition-registration-management').data('competition-id');
    if (!competitionId) return;

    if (!sendRemindersModalInstance) {
        sendRemindersModalInstance = new bootstrap.Modal(document.getElementById('sendRemindersModal'));
    }

    // Reset state
    reminderRecipients = [];
    document.getElementById('sendRemindersMessage').value = '';   // replaced by the default once the fetch returns
    document.getElementById('sendRemindersResult').classList.add('d-none');
    document.getElementById('sendRemindersResult').innerHTML = '';
    document.getElementById('sendTestReminderResult').innerHTML = '';
    document.getElementById('sendRemindersConfirmBtn').disabled = true;
    document.getElementById('sendRemindersSelectedInfo').textContent = '…';
    document.getElementById('sendRemindersRecipients').innerHTML = `
        <div class="text-center py-3 text-muted">
            <span class="spinner-border spinner-border-sm me-2" role="status"></span>Laddar mottagare...
        </div>`;

    sendRemindersModalInstance.show();

    // Load the eligible recipients (with reminder history) + the standard message to prefill.
    fetch(`/umbraco/surface/InvoiceAdmin/GetReminderRecipients?competitionId=${competitionId}`)
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                reminderDefaultMessage = data.defaultMessage || '';
                const ta = document.getElementById('sendRemindersMessage');
                if (!ta.value) ta.value = reminderDefaultMessage;

                reminderRecipients = (data.recipients || []).map(r => ({ ...r, selected: true }));
                renderReminderRecipients();
            } else {
                document.getElementById('sendRemindersRecipients').innerHTML =
                    `<div class="alert alert-warning mb-0">${escapeHistory(data.message || 'Kunde inte ladda mottagare.')}</div>`;
                document.getElementById('sendRemindersSelectedInfo').textContent = '';
            }
        })
        .catch(err => {
            console.error('Failed to load reminder recipients:', err);
            document.getElementById('sendRemindersRecipients').innerHTML =
                `<div class="alert alert-danger mb-0">Kunde inte ladda mottagare: ${escapeHistory(err.message)}</div>`;
            document.getElementById('sendRemindersSelectedInfo').textContent = '';
        });
}

// Draw the recipient checklist. Each row carries its invoiceId on the checkbox; the
// "selected" flag lives on the in-memory model so re-renders preserve choices.
function renderReminderRecipients() {
    const box = document.getElementById('sendRemindersRecipients');
    if (!reminderRecipients.length) {
        box.innerHTML = '<div class="text-center py-3 text-muted">Inga obetalda skyttar med e-postadress.</div>';
        updateReminderSelection();
        return;
    }

    let html = '<ul class="list-group list-group-flush">';
    reminderRecipients.forEach((r, i) => {
        let reminded = '';
        if (r.lastReminderSentDate) {
            const when = formatUtcDateTime(r.lastReminderSentDate);
            const n = r.reminderCount || 1;
            reminded = `<span class="badge bg-info ms-2" title="Senaste: ${escapeHistory(when)}">Påmind${n > 1 ? ` ${n}×` : ''}</span>`;
        }
        const amount = (r.amount != null) ? `${Math.round(Number(r.amount))} kr` : '';
        const sub = [r.club, r.email].filter(Boolean).map(escapeHistory).join(' · ');
        html += `<li class="list-group-item py-1 px-2">
            <div class="form-check mb-0 d-flex align-items-center">
                <input class="form-check-input reminder-recipient-cb mt-0 me-2" type="checkbox"
                       id="reminderCb_${i}" data-idx="${i}" ${r.selected ? 'checked' : ''}
                       onchange="onReminderCbChange(${i}, this.checked)">
                <label class="form-check-label flex-grow-1" for="reminderCb_${i}">
                    <span class="fw-semibold">${escapeHistory(r.memberName || '(namnlös)')}</span>${reminded}
                    <small class="text-muted d-block">${sub}</small>
                </label>
                <span class="small text-muted ms-2 text-nowrap">${escapeHistory(amount)}</span>
            </div>
        </li>`;
    });
    html += '</ul>';
    box.innerHTML = html;
    updateReminderSelection();
}

function onReminderCbChange(idx, checked) {
    if (reminderRecipients[idx]) reminderRecipients[idx].selected = checked;
    updateReminderSelection();
}

function reminderSelectAll(checked) {
    reminderRecipients.forEach(r => r.selected = checked);
    document.querySelectorAll('#sendRemindersRecipients .reminder-recipient-cb').forEach(cb => cb.checked = checked);
    updateReminderSelection();
}

// Untick everyone who has already had at least one reminder — the common "chase only the
// ones I haven't contacted yet" case.
function reminderUncheckAlreadyReminded() {
    reminderRecipients.forEach((r, i) => {
        if (r.lastReminderSentDate) {
            r.selected = false;
            const cb = document.getElementById(`reminderCb_${i}`);
            if (cb) cb.checked = false;
        }
    });
    updateReminderSelection();
}

// Sync the selected count + confirm button label/disabled state with the current ticks.
function updateReminderSelection() {
    const total = reminderRecipients.length;
    const selected = reminderRecipients.filter(r => r.selected).length;
    document.getElementById('sendRemindersSelectedInfo').textContent =
        total ? `${selected} av ${total} valda` : '';
    const btn = document.getElementById('sendRemindersConfirmBtn');
    btn.disabled = selected === 0;
    btn.innerHTML = `<i class="bi bi-send me-1"></i>Skicka påminnelser${selected ? ` (${selected})` : ''}`;
    const deselectBtn = document.getElementById('reminderDeselectRemindedBtn');
    if (deselectBtn) deselectBtn.disabled = !reminderRecipients.some(r => r.lastReminderSentDate);
}

// Restore the standard message into the textarea (used by the "Återställ standardtext" link).
function resetReminderMessage() {
    document.getElementById('sendRemindersMessage').value = reminderDefaultMessage;
}

// Send a single preview reminder to the operator's own email. Uses whatever is currently
// in the message box so the test reflects exactly what the shooters would receive.
async function sendTestReminder() {
    const competitionId = $('.competition-registration-management').data('competition-id');
    if (!competitionId) return;

    const message = document.getElementById('sendRemindersMessage').value.trim();
    const btn = document.getElementById('sendTestReminderBtn');
    const resultBox = document.getElementById('sendTestReminderResult');
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skickar test...';
    resultBox.innerHTML = '';

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const params = new URLSearchParams();
        params.append('competitionId', competitionId);
        if (message) params.append('reminderMessage', message);

        const response = await fetch('/umbraco/surface/InvoiceAdmin/SendTestReminder', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: params.toString()
        });
        const data = await response.json();

        if (data.success) {
            resultBox.innerHTML = `<div class="alert alert-success py-2 px-3 mb-0 small">
                <i class="bi bi-check-circle me-1"></i>${escapeHistory(data.message || 'Testpåminnelse skickad.')}
            </div>`;
        } else {
            resultBox.innerHTML = `<div class="alert alert-danger py-2 px-3 mb-0 small">
                <i class="bi bi-exclamation-triangle me-1"></i>${escapeHistory(data.message || 'Kunde inte skicka testet.')}
            </div>`;
        }
    } catch (err) {
        resultBox.innerHTML = `<div class="alert alert-danger py-2 px-3 mb-0 small">Ett fel uppstod: ${escapeHistory(err.message)}</div>`;
    } finally {
        btn.disabled = false;
        btn.innerHTML = original;
    }
}

async function confirmSendReminders() {
    const competitionId = $('.competition-registration-management').data('competition-id');
    if (!competitionId) return;

    // Only the ticked recipients. Empty selection is blocked by the disabled button, but
    // guard anyway so we never fall through to the server's "send to everyone" default.
    const selectedIds = reminderRecipients.filter(r => r.selected).map(r => r.invoiceId);
    if (selectedIds.length === 0) return;

    const message = document.getElementById('sendRemindersMessage').value.trim();
    const btn = document.getElementById('sendRemindersConfirmBtn');
    const cancelBtn = document.getElementById('sendRemindersCancelBtn');
    btn.disabled = true;
    cancelBtn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skickar...';

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const params = new URLSearchParams();
        params.append('competitionId', competitionId);
        if (message) params.append('reminderMessage', message);
        selectedIds.forEach(id => params.append('invoiceIds', id));

        const response = await fetch('/umbraco/surface/InvoiceAdmin/SendPaymentReminders', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: params.toString()
        });
        const data = await response.json();

        const resultBox = document.getElementById('sendRemindersResult');
        resultBox.classList.remove('d-none');
        if (data.success) {
            let html = `<div class="alert alert-success mb-0">
                <i class="bi bi-check-circle me-1"></i>${escapeHistory(data.message || 'Klart')}
            </div>`;
            if (data.errorCount > 0 && data.errors && data.errors.length > 0) {
                html += `<div class="alert alert-warning mt-2 mb-0">
                    <strong>${data.errorCount} fel:</strong>
                    <ul class="mb-0 small">${data.errors.map(e => `<li>${escapeHistory(e)}</li>`).join('')}</ul>
                </div>`;
            }
            resultBox.innerHTML = html;
            // Refresh the registrations list so the audit history button on each row sees
            // the new EmailSent events the next time the operator opens it.
            loadCompetitionRegistrations();
        } else {
            resultBox.innerHTML = `<div class="alert alert-danger mb-0">
                <i class="bi bi-exclamation-triangle me-1"></i>${escapeHistory(data.message || 'Misslyckades')}
            </div>`;
        }
    } catch (err) {
        document.getElementById('sendRemindersResult').classList.remove('d-none');
        document.getElementById('sendRemindersResult').innerHTML =
            `<div class="alert alert-danger mb-0">Ett fel uppstod: ${escapeHistory(err.message)}</div>`;
    } finally {
        cancelBtn.disabled = false;
        cancelBtn.textContent = 'Stäng';  // changes meaning after submit
        btn.disabled = true;               // prevent double-send
        btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Klart';
    }
}
</script>
