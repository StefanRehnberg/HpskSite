function showQrInManageModal() {
    if (!currentManageInvoiceReg) return;
    const competitionId = $('.competition-registration-management').data('competition-id');
    const registration = currentManageInvoiceReg;

    // Teams use a dedicated QR endpoint (team fee, memberId "team-{id}").
    if (registration.isTeam) { showTeamQrInManageModal(registration, competitionId); return; }

    // Toggle to QR state immediately so the operator sees feedback
    document.getElementById('manageInvoiceActions').style.display = 'none';
    const qrPanel = document.getElementById('manageInvoiceQr');
    qrPanel.style.display = '';

    const body = document.getElementById('manageInvoiceQrBody');
    body.innerHTML = `
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Laddar QR-kod...</span>
        </div>
        <p class="mt-2 small text-muted">Genererar QR-kod...</p>`;

    // When the row already has an invoice (Pending top-up after class change, or any
    // existing pending invoice), generate the QR for *that specific invoice's* amount
    // via InvoiceAdmin/GenerateInvoiceQRCode. Falling through to Swish/GeneratePaymentQR
    // would recompute the registration's total fee and produce the wrong amount on the QR.
    // Only fall back to the lazy-create path when no invoice exists yet.
    const usePerInvoice = registration.invoiceId && registration.invoiceId > 0;
    const url = usePerInvoice
        ? `/umbraco/surface/InvoiceAdmin/GenerateInvoiceQRCode?invoiceId=${registration.invoiceId}`
        : `/umbraco/surface/Swish/GeneratePaymentQR?competitionId=${competitionId}&targetMemberId=${registration.memberId}`;

    fetch(url, { method: 'GET', headers: { 'Content-Type': 'application/json' } })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            // The two endpoints return slightly different shapes:
            //  - SwishController returns `qrCode` (data-URI), `amount`, `shootingClasses`, `invoiceNumber`, `invoiceId`
            //  - InvoiceAdminController returns `qrCodeBase64` (raw base64), `amount`, `invoiceNumber`
            const qrSrc = data.qrCode
                || (data.qrCodeBase64 ? `data:image/png;base64,${data.qrCodeBase64}` : '');

            body.innerHTML = `
                ${qrSrc ? `<img src="${qrSrc}" alt="Swish QR Code" class="img-fluid mb-3" style="max-width: 280px;" />` : ''}
                <p class="mb-1"><strong>Belopp:</strong> ${data.amount} kr</p>
                ${data.shootingClasses ? `<p class="mb-1 small text-muted"><strong>Klasser:</strong> ${data.shootingClasses}</p>` : ''}
                <p class="mb-1 small text-muted"><strong>Referens:</strong> ${data.invoiceNumber || ''}</p>
                ${qrSrc ? '<p class="small text-muted mt-2 mb-0">Be skytten skanna koden med Swish-appen.</p>' : ''}
                ${window.renderBankgiroBlock ? window.renderBankgiroBlock(data) : ''}`;

            // Lazy-create path only: SwishController side-effect creates an invoice if none
            // existed; patch the in-memory row so subsequent actions see the new invoiceId
            // without forcing a page reload.
            if (!usePerInvoice && data.invoiceId) {
                currentManageInvoiceReg.invoiceId = data.invoiceId;
                currentManageInvoiceReg.invoiceNumber = data.invoiceNumber || currentManageInvoiceReg.invoiceNumber;
                currentManageInvoiceReg.paymentAmount = data.amount || currentManageInvoiceReg.paymentAmount;
                const live = competitionRegistrations.find(r => r.id === currentManageInvoiceReg.id);
                if (live) {
                    live.invoiceId = data.invoiceId;
                    live.invoiceNumber = data.invoiceNumber || live.invoiceNumber;
                    live.paymentAmount = data.amount || live.paymentAmount;
                    if (live.paymentStatus === 'No Invoice') {
                        live.paymentStatus = 'Pending';
                        live.pendingAmount = (Number(live.pendingAmount) || 0) + (Number(data.amount) || 0);
                    }
                }
            }
        } else {
            body.innerHTML = `<div class="alert alert-danger">${data.message || 'Kunde inte ladda QR-kod'}</div>`;
        }
    })
    .catch(err => {
        console.error('Error loading Swish QR code:', err);
        body.innerHTML = '<div class="alert alert-danger">Ett fel uppstod när QR-koden skulle laddas.</div>';
    });
}

// Recipient chooser for a team's Swish QR e-mail. Rendered into the manage-payment modal's
// second panel (the one the QR uses), so it inherits the existing Tillbaka affordance.
// Recipients are the team's own members that have an e-mail on file, plus the operator — a
// Springskytte team whose roster is still deferred has no members yet, so "mig själv" must
// always remain available as the fallback.
async function showTeamQrEmailRecipients(reg, competitionId) {
    document.getElementById('manageInvoiceActions').style.display = 'none';
    document.getElementById('manageInvoiceQr').style.display = '';
    const body = document.getElementById('manageInvoiceQrBody');
    body.innerHTML = `
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Laddar...</span></div>
        <p class="mt-2 small text-muted">Hämtar lagets kontakter...</p>`;

    let contacts = [];
    try {
        const resp = await fetch(`/umbraco/surface/CompetitionTeam/GetTeamContacts?competitionId=${competitionId}&teamId=${reg.teamId}`);
        const data = await resp.json();
        if (data.success && Array.isArray(data.contacts)) contacts = data.contacts;
    } catch (err) {
        console.warn('Could not load team contacts:', err);
    }

    const options = contacts.map(c =>
        `<option value="${c.memberId}">${escapeHtmlSafe(c.name)} — ${escapeHtmlSafe(c.email)}</option>`).join('');

    body.innerHTML = `
        <div class="text-start">
            <p class="mb-2"><strong>Skicka QR-kod för ${escapeHtmlSafe(reg.memberName)}</strong></p>
            <label for="teamQrRecipient" class="form-label small fw-bold">Mottagare</label>
            <select class="form-select mb-2" id="teamQrRecipient">
                ${options}
                <option value="0">Mig själv</option>
            </select>
            ${contacts.length === 0
                ? '<div class="alert alert-warning small py-2 mb-2">Ingen av lagets deltagare har en e-postadress registrerad. Du kan skicka koden till dig själv och vidarebefordra den.</div>'
                : ''}
            <button type="button" class="btn btn-primary w-100" id="teamQrSendBtn">
                <i class="bi bi-envelope me-1"></i>Skicka
            </button>
        </div>`;

    document.getElementById('teamQrSendBtn').addEventListener('click', async function () {
        const targetMemberId = parseInt(document.getElementById('teamQrRecipient').value, 10) || 0;
        this.disabled = true;
        this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skickar...';
        try {
            const resp = await fetch(
                `/umbraco/surface/Swish/SendTeamQRCodeEmail?competitionId=${competitionId}&teamId=${reg.teamId}&targetMemberId=${targetMemberId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            });
            const result = await resp.json();
            if (result.success) {
                manageInvoiceModalInstance?.hide();
                alert(result.email ? `QR-koden har skickats till ${result.email}` : 'QR-koden har skickats.');
            } else {
                alert('Fel: ' + (result.message || 'okänt fel'));
                this.disabled = false;
                this.innerHTML = '<i class="bi bi-envelope me-1"></i>Skicka';
            }
        } catch (error) {
            console.error('Error sending team Swish QR code email:', error);
            alert('Ett fel uppstod när e-posten skulle skickas. Försök igen.');
            this.disabled = false;
            this.innerHTML = '<i class="bi bi-envelope me-1"></i>Skicka';
        }
    });
}

