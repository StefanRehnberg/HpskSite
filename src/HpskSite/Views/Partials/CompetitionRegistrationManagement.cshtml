// Fetched once per open; the include-teams switch re-filters what's already here rather than
// round-tripping, so toggling it is instant.
let peData = null;

async function openParticipantEmails() {
    const compId = $('.competition-registration-management').data('competition-id');
    peData = null;
    document.getElementById('peBox').value = '';
    document.getElementById('peSummary').textContent = 'Läser…';
    document.getElementById('peMissing').innerHTML = '';
    new bootstrap.Modal(document.getElementById('participantEmailsModal')).show();
    try {
        const r = await fetch(`/umbraco/surface/RegistrationAdmin/GetParticipantEmails?competitionId=${compId}`,
            { headers: { 'Accept': 'application/json' } });
        const d = await r.json();
        if (!d.success) { document.getElementById('peSummary').textContent = d.message || 'Kunde inte läsa adresserna.'; return; }
        peData = d;
        peRender();
    } catch (e) {
        document.getElementById('peSummary').textContent = 'Kunde inte läsa adresserna.';
    }
}

function peRender() {
    if (!peData) return;
    const withTeams = document.getElementById('peIncludeTeams').checked;
    const keep = x => withTeams || x.source !== 'Lag';

    // Dedupe on the ADDRESS: one person entered in two classes is one recipient, and a parent's
    // address shared by two juniors should be mailed once.
    const seen = {}, addrs = [];
    (peData.people || []).filter(keep).forEach(p => {
        const k = (p.email || '').trim().toLowerCase();
        if (!k || seen[k]) return;
        seen[k] = 1; addrs.push(p.email.trim());
    });
    const missing = (peData.missing || []).filter(keep);

    document.getElementById('peBox').value = addrs.join('; ');
    document.getElementById('peSummary').textContent =
        addrs.length + (addrs.length === 1 ? ' adress' : ' adresser')
        + (missing.length ? ' · ' + missing.length + ' saknar e-post' : '');

    const a = document.getElementById('peMailto');
    a.href = 'mailto:?bcc=' + encodeURIComponent(addrs.join(','));
    a.classList.toggle('disabled', addrs.length === 0);

    document.getElementById('peMissing').innerHTML = missing.length
        ? `<div class="alert alert-warning py-2 mb-0">
             <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>${missing.length} ${missing.length === 1 ? 'deltagare nås' : 'deltagare nås'} inte av mejlet</div>
             <div class="small">${missing.map(m => escapeHtmlSafe(m.name) + (m.clubName ? ` <span class="text-muted">(${escapeHtmlSafe(m.clubName)})</span>` : '')).join(', ')}</div>
           </div>`
        : '';
}

function peCopy(ev) {
    const box = document.getElementById('peBox');
    if (!box.value) return;
    navigator.clipboard.writeText(box.value).then(() => {
        const b = ev && ev.currentTarget; if (!b) return;
        const old = b.innerHTML;
        b.innerHTML = '<i class="bi bi-check2 me-1"></i>Kopierat';
        setTimeout(() => { b.innerHTML = old; }, 1500);
    }, () => {
        // Clipboard can be blocked; select instead so Ctrl+C still works rather than the button
        // appearing to do nothing.
        box.removeAttribute('readonly'); box.select(); box.setAttribute('readonly', 'readonly');
    });
}

