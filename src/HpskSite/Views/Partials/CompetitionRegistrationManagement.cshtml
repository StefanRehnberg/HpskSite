// ──────────────────────────────────────────────────────────────────────
// Tävlar för — which of the shooter's clubs a registration is filed under
//
// A shooter may belong to several clubs (primaryClubId + memberClubIds) and may enter a
// competition for any of them. Until 2026-08 the registration always took their PRIMARY club
// with no way to say otherwise, so the only fix for "anmäld för fel klubb" was to edit the
// member's primary club — which changes them everywhere, for every competition.
// ──────────────────────────────────────────────────────────────────────

// Cache per member: the modal can be opened repeatedly on the same shooter, and club
// membership does not change while the operator works the desk.
const memberClubsCache = {};

async function fetchMemberClubs(memberId) {
    if (!memberId) return [];
    if (memberClubsCache[memberId]) return memberClubsCache[memberId];
    const compId = $('.competition-registration-management').data('competition-id');
    try {
        const resp = await fetch(
            `/umbraco/surface/Competition/GetMemberClubs?memberId=${encodeURIComponent(memberId)}&competitionId=${encodeURIComponent(compId)}`,
            { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await resp.json();
        const clubs = (data && data.success && Array.isArray(data.clubs)) ? data.clubs : [];
        memberClubsCache[memberId] = clubs;
        return clubs;
    } catch (e) {
        console.error('Kunde inte hämta skyttens klubbar', e);
        return [];
    }
}

async function populateEditClubSelect(registration) {
    const sel = document.getElementById('competitionEditMemberClub');
    const hint = document.getElementById('competitionEditClubHint');
    if (!sel) return;

    sel.disabled = true;
    hint.classList.add('d-none');
    sel.innerHTML = '<option value="">Laddar…</option>';

    const clubs = await fetchMemberClubs(registration.memberId);
    const currentId = parseInt(registration.memberClubId, 10) || 0;

    // Guard against a slow response landing after the operator moved to another shooter.
    const openRegId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
    if (openRegId !== registration.id) return;

    if (clubs.length === 0) {
        // No club list (lookup failed, or the member has no resolvable club). Fall back to
        // showing what the registration says rather than an empty control that implies the
        // shooter has no club.
        sel.innerHTML = `<option value="${currentId}">${escapeAttr(registration.memberClub || 'Okänd klubb')}</option>`;
        sel.disabled = true;
        return;
    }

    let options = clubs.map(c =>
        `<option value="${c.id}"${c.id === currentId ? ' selected' : ''}>` +
        `${escapeAttr(c.name)}${c.isPrimary ? ' (primär)' : ''}</option>`).join('');

    // The registration may be filed under a club the shooter has since left. Keep it as a
    // selectable option so simply saving the modal cannot silently move them somewhere else —
    // the server treats an unchanged club as a no-op, so this round-trips safely.
    if (currentId > 0 && !clubs.some(c => c.id === currentId)) {
        options = `<option value="${currentId}" selected>` +
                  `${escapeAttr(registration.memberClub || 'Okänd klubb')} (ej medlem längre)</option>` + options;
    }

    sel.innerHTML = options;
    sel.disabled = clubs.length < 2 && !(currentId > 0 && !clubs.some(c => c.id === currentId));

    if (!sel.disabled) {
        hint.textContent = 'Skytten är medlem i flera klubbar. Välj vilken hen tävlar för i den här tävlingen.';
        hint.classList.remove('d-none');
    }
}

async function editCompetitionRegistration(registrationId) {
    const registration = competitionRegistrations.find(r => r.id === registrationId);
    if (!registration) return;

    // Header fields
    document.getElementById('competitionEditRegistrationId').value = registration.id;
    document.getElementById('competitionEditMemberName').value = registration.memberName || '';
    // Fire-and-forget: the club dropdown needs a round trip, and nothing else in this modal
    // depends on it, so the operator sees the classes immediately.
    populateEditClubSelect(registration);

    // Build the class checklist from the competition's allowed classes (same source the
    // walk-in modal uses). Pre-check the registration's current classes.
    const existingIds = new Set(
        (registration.shootingClasses || []).map(sc => (sc.class || sc.className || '').trim())
    );
    const list = document.getElementById('competitionEditClassList');
    if (Array.isArray(walkInAvailableClasses) && walkInAvailableClasses.length > 0) {
        // Any class the registration already has but that is NOT in the competition's current
        // allowed-class list (e.g. the comp was edited after the shooter registered). Without this,
        // no checkbox renders for it → it silently drops on the next save. Show it pre-checked so
        // the operator has to deliberately untick to remove it.
        const availableIds = new Set(walkInAvailableClasses.map(c => c.id));
        const orphanExisting = Array.from(existingIds).filter(id => id && !availableIds.has(id));
        list.innerHTML = walkInAvailableClasses.map(c => {
            const checked = existingIds.has(c.id) ? 'checked' : '';
            const safeId = `editCls_${c.id.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
            return `
                <div class="form-check">
                    <input class="form-check-input edit-class-cb" type="checkbox"
                           id="${safeId}" value="${escapeAttr(c.id)}" ${checked}>
                    <label class="form-check-label" for="${safeId}">
                        ${escapeAttr(c.name)}
                    </label>
                </div>`;
        }).join('') + orphanExisting.map(id => {
            const safeId = `editCls_${id.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
            return `
                <div class="form-check">
                    <input class="form-check-input edit-class-cb" type="checkbox"
                           id="${safeId}" value="${escapeAttr(id)}" checked>
                    <label class="form-check-label" for="${safeId}">
                        ${escapeAttr(id)} <span class="badge bg-warning text-dark">befintlig</span>
                    </label>
                </div>`;
        }).join('');
    } else {
        // Fallback when the parent view didn't pass an allowed-class list — show whatever
        // the registration currently has, so the operator can at least save start prefs.
        const ids = Array.from(existingIds);
        list.innerHTML = ids.length === 0
            ? '<div class="text-muted small">Inga klasser tillgängliga.</div>'
            : ids.map(id => {
                const safeId = `editCls_${id.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
                return `
                    <div class="form-check">
                        <input class="form-check-input edit-class-cb" type="checkbox"
                               id="${safeId}" value="${escapeAttr(id)}" checked>
                        <label class="form-check-label" for="${safeId}">${escapeAttr(id)}</label>
                    </div>`;
            }).join('');
    }

    // Direktplacering: refresh the slot picker on open so capacity reflects the
    // current state. Reset the selection — adding a class is an explicit choice.
    if (walkInDirektplaceringEnabled) {
        // Pull live availability and render per-class slot rows for whatever the registration
        // already has. Operator-toggled checkboxes will re-render the list (handler below).
        await refreshDpTeamAvailability();
        renderEditDpSlotRows(registration);
    }

    // Springskytte: load the free slots + which weapon groups this shooter already has a start
    // in, so adding a class here can be given a start time instead of silently getting none.
    if (walkInSpringskytteEnabled) {
        await Promise.all([
            refreshSpringFreeSlots(),
            refreshEditSpringMembership(registration.memberId)
        ]);
        renderEditSpringSlotRows();
    }

    // Echo any recorded start-time wish (set from the row's Åtgärder menu, preserved here).
    const prefNote = document.getElementById('competitionEditPrefNote');
    if (prefNote) {
        const wishes = (registration.shootingClasses || [])
            .map(sc => ({
                id: (sc.class || sc.className || '').trim(),
                pref: normalizeStartPreference(sc.startPreference)
            }))
            .filter(w => w.id && w.pref !== 'Inget');
        if (wishes.length === 0) {
            prefNote.classList.add('d-none');
            prefNote.innerHTML = '';
        } else {
            prefNote.classList.remove('d-none');
            prefNote.innerHTML = '<i class="bi bi-clock-history me-1"></i>Önskemål om starttid: '
                + wishes.map(w => {
                    const norm = normalizeShootingClass(w.id);
                    const label = window.formatAgeSpan ? window.formatAgeSpan(norm) : norm;
                    return `${escapeAttr(label)} – ${w.pref === 'Tidig Start' ? 'tidig' : 'sen'} start`;
                }).join(', ')
                + '. Ändras via Åtgärder → Önskemål om starttid.';
        }
    }

    // Pre-fill the deltävling checkbox from the registration. Untoggling here will
    // recompute the fee downward (and surface a refund note); toggling on creates a
    // top-up invoice via the standard multi-invoice flow.
    const editSubCompCb = document.getElementById('competitionEditSubCompetitionCheckbox');
    if (editSubCompCb) editSubCompCb.checked = !!registration.isSubCompetition;

    new bootstrap.Modal(document.getElementById('competitionEditRegistrationModal')).show();
}

// Springskytte: the weapon groups this shooter is ALREADY slotted in, keyed by weapon class
// ("C" → { startTime, listName, official }). Refreshed each time the Edit modal opens.
let editSpringStartsByWc = {};

async function refreshEditSpringMembership(memberId) {
    editSpringStartsByWc = {};
    if (!walkInSpringskytteEnabled || !memberId) return;
    try {
        const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
        const resp = await fetch(`/umbraco/surface/Springskytte/GetStartListMembership?competitionId=${competitionId}&memberId=${memberId}`,
            { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await resp.json();
        if (!data.success || !Array.isArray(data.inLists)) return;
        data.inLists.forEach(l => {
            const wc = String(l.weaponClass || '').toUpperCase();
            if (wc && !editSpringStartsByWc[wc]) {
                editSpringStartsByWc[wc] = { startTime: l.startTime, listName: l.listName, official: !!l.official };
            }
        });
    } catch (err) {
        console.warn('Could not load Springskytte start-list membership for edit:', err);
    }
}

// One row per ticked WEAPON GROUP (a Springskytte start is per member+vapengrupp, not per
// age class — ticking C-H 35 and C-D 35 is still a single C start). Already-slotted groups
// render read-only; groups with no start get the same free-slot picker the walk-in uses.
function renderEditSpringSlotRows() {
    const host = document.getElementById('competitionEditSpringSlotsContainer');
    if (!walkInSpringskytteEnabled || !host) return;

    // Preserve picks across re-renders (the operator may tick more classes afterwards).
    const previous = {};
    host.querySelectorAll('.edit-spring-slot-select').forEach(s => {
        if (s.value) previous[s.dataset.weaponClass] = s.value;
    });

    const checked = Array.from(document.querySelectorAll('#competitionEditClassList .edit-class-cb:checked'))
        .map(cb => cb.value);
    // Distinct weapon groups, in a stable order.
    const weapons = [];
    checked.forEach(id => {
        const wc = springClassWeapon(id);
        if (wc && !weapons.includes(wc)) weapons.push(wc);
    });

    if (weapons.length === 0) { host.innerHTML = ''; return; }

    host.innerHTML = '';
    const heading = document.createElement('div');
    heading.className = 'form-label fw-bold mb-1';
    heading.textContent = 'Starttid per vapengrupp';
    host.appendChild(heading);

    weapons.forEach(wc => {
        const row = document.createElement('div');
        row.className = 'd-flex align-items-center gap-2 mb-2';

        const label = document.createElement('div');
        label.className = 'small fw-semibold';
        label.style.minWidth = '120px';
        label.textContent = `Vapengrupp ${wc}`;
        row.appendChild(label);

        const existing = editSpringStartsByWc[wc];
        if (existing) {
            // Already on a start list — say so plainly rather than offering a second slot.
            const note = document.createElement('div');
            note.className = 'form-text mb-0 small';
            note.innerHTML = `<span class="badge bg-success">kl ${escapeAttr(springTimeShort(existing.startTime))}</span> `
                + `redan på <strong>${escapeAttr(existing.listName || 'startlistan')}</strong>`
                + (existing.official ? ' <span class="badge bg-info">publicerad</span>' : '');
            row.appendChild(note);
        } else {
            const slots = (springFreeSlotsByWc && springFreeSlotsByWc[wc]) || [];
            if (slots.length === 0) {
                const note = document.createElement('div');
                note.className = 'form-text text-warning mb-0 small';
                note.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>'
                    + 'Ingen startlista genererad för denna vapengrupp — skytten får ingen starttid.';
                row.appendChild(note);
            } else {
                const sel = document.createElement('select');
                sel.className = 'form-select form-select-sm edit-spring-slot-select';
                sel.dataset.weaponClass = wc;
                const placeholder = new Option('— Välj starttid —', '');
                placeholder.disabled = true;
                sel.add(placeholder);
                sel.add(new Option('Lägg inte på startlistan', 'skip'));
                slots.forEach(s => {
                    const kindLabel = s.kind === 'dns' ? 'ledig (DNS)' : (s.kind === 'paus' ? 'lucka' : 'efter sista');
                    sel.add(new Option(`kl ${springTimeShort(s.time)} · ${kindLabel}`, `${s.time}|${s.nodeId}`));
                });
                sel.value = (previous[wc] != null) ? previous[wc] : '';
                row.appendChild(sel);

                const hint = document.createElement('div');
                hint.className = 'form-text text-muted mb-0 small';
                hint.textContent = 'Ny klass — välj starttid.';
                row.appendChild(hint);
            }
        }

        host.appendChild(row);
    });
}

// Read the Edit modal's checked classes + the registration's existing per-class team
// assignments and rebuild the per-class slot rows from scratch.
function renderEditDpSlotRows(registration) {
    const host = document.getElementById('competitionEditDpSlotsContainer');
    if (!host) return;

    const existingTeamByClass = {};
    (registration?.shootingClasses || []).forEach(sc => {
        const key = (sc.class || sc.className || '').trim();
        if (key && sc.teamNumber != null) existingTeamByClass[key] = sc.teamNumber;
    });

    const checked = Array.from(document.querySelectorAll('#competitionEditClassList .edit-class-cb:checked'))
        .map(cb => {
            const id = cb.value;
            const lbl = cb.parentElement?.querySelector('label')?.textContent?.trim() || id;
            return { id, name: lbl };
        });
    renderDpSlotRows(host, checked, existingTeamByClass);
}

// Hook checkbox toggles in the Edit modal: enforce mutex within the same bucket so
// "swap C1 to C3" stays a swap (one ticked) instead of stacking two billable classes,
// then re-render the per-class slot rows when direktplacering is enabled.
document.addEventListener('DOMContentLoaded', () => {
    const list = document.getElementById('competitionEditClassList');
    if (!list) return;
    list.addEventListener('change', (e) => {
        if (!e.target.classList.contains('edit-class-cb')) return;
        enforceClassMutex('#competitionEditClassList', e.target);
        if (walkInSpringskytteEnabled) renderEditSpringSlotRows();
        if (!walkInDirektplaceringEnabled) return;
        const registrationId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
        const reg = competitionRegistrations.find(r => r.id === registrationId);
        renderEditDpSlotRows(reg);
    });
});

// Tiny HTML attribute escaper local to this modal.
function escapeAttr(s) {
    return String(s ?? '').replace(/[&<>"']/g, c =>
        ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

// ── Önskemål om starttid ──────────────────────────────────────────────────
// Client mirror of Models/StartPreference.cs. The stored vocabulary drifted for years while
// nothing consumed the field, so six spellings are in the wild ("Inget", "No Preference", "",
// "Tidig Start"/"Sen Start", "Early"/"Late"). Compare the raw string anywhere and the badge
// and the filter silently disagree with the generator.
function normalizeStartPreference(value) {
    const v = String(value ?? '').trim().toLowerCase();
    if (v === 'tidig start' || v === 'tidig' || v === 'early') return 'Tidig Start';
    if (v === 'sen start' || v === 'sen' || v === 'late') return 'Sen Start';
    return 'Inget';
}

// Rows are keyed per weapon group on Springskytte, per class elsewhere. Kept as module state
// so Spara knows which classes each row stands for without re-deriving it from the DOM.
let startPrefRowKeys = [];

async function openStartPreferenceModal(registrationId) {
    const reg = (competitionRegistrations || []).find(r => r.id === registrationId);
    if (!reg) { alert('Anmälan hittades inte i listan. Ladda om sidan.'); return; }

    document.getElementById('startPreferenceRegistrationId').value = registrationId;
    document.getElementById('startPreferenceShooter').textContent = reg.memberName || '';
    document.getElementById('startPreferenceClub').textContent = reg.memberClub || '';
    const errEl = document.getElementById('startPreferenceError');
    errEl.classList.add('d-none');
    errEl.textContent = '';

    // Which weapon groups already have a start time. The wish is consumed at GENERATION, so for
    // an already-slotted shooter it changes nothing until the list is regenerated — saying that
    // on the spot is the difference between a tool and a trap. Reuses the Edit modal's loader
    // (it resets its own state on each call and the two modals are never open together).
    document.getElementById('startPreferenceRows').innerHTML =
        '<div class="text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Laddar…</div>';
    bootstrap.Modal.getOrCreateInstance(document.getElementById('startPreferenceModal')).show();

    if (walkInSpringskytteEnabled) {
        await refreshEditSpringMembership(reg.memberId);
    }
    renderStartPreferenceRows(reg);
}

function renderStartPreferenceRows(reg) {
    const host = document.getElementById('startPreferenceRows');
    const classes = (reg.shootingClasses || [])
        .map(sc => ({ id: (sc.class || sc.className || '').trim(), pref: normalizeStartPreference(sc.startPreference) }))
        .filter(c => c.id);

    startPrefRowKeys = [];

    if (classes.length === 0) {
        host.innerHTML = '<div class="alert alert-warning py-2 mb-0">Anmälan har inga klasser.</div>';
        document.getElementById('startPreferenceSaveBtn').disabled = true;
        return;
    }
    document.getElementById('startPreferenceSaveBtn').disabled = false;

    if (walkInSpringskytteEnabled) {
        // One row per weapon group: a Springskytte start is per (member, vapengrupp), so a
        // shooter entered in both C-H 35 and C-D 35 still has ONE C start to wish about.
        const groups = [];
        classes.forEach(c => {
            const wc = springClassWeapon(c.id);
            let g = groups.find(x => x.wc === wc);
            if (!g) { g = { wc, classIds: [], pref: 'Inget' }; groups.push(g); }
            g.classIds.push(c.id);
            // Any class in the group carrying a wish decides the group's displayed value.
            if (c.pref !== 'Inget' && g.pref === 'Inget') g.pref = c.pref;
        });
        startPrefRowKeys = groups;
        host.innerHTML = groups.map((g, i) => startPrefRowHtml(
            i, `Vapengrupp ${escapeAttr(g.wc)}`, g.pref, editSpringStartsByWc[g.wc])).join('');
    } else {
        startPrefRowKeys = classes.map(c => ({ classIds: [c.id], pref: c.pref }));
        host.innerHTML = classes.map((c, i) => {
            const norm = normalizeShootingClass(c.id);
            const label = window.formatAgeSpan ? window.formatAgeSpan(norm) : norm;
            return startPrefRowHtml(i, escapeAttr(label), c.pref, null);
        }).join('');
    }

    document.getElementById('startPreferenceFootnote').innerHTML = walkInSpringskytteEnabled
        ? '<i class="bi bi-info-circle me-1"></i>Önskemålet styr sorteringen nästa gång startlistan genereras. '
          + 'Tidiga önskemål läggs först i sin vapengrupp, sena sist.'
        : '<i class="bi bi-info-circle me-1"></i>Den här tävlingsformens startlistegenerator sorterar ännu inte '
          + 'på önskemål — noteringen syns i listan, i filtret och i CSV-exporten.';
}

function startPrefRowHtml(index, label, pref, existingStart) {
    const warn = existingStart
        ? `<div class="form-text text-warning mb-0 small"><i class="bi bi-exclamation-triangle me-1"></i>`
          + `Har redan starttid kl ${escapeAttr(springTimeShort(existingStart.startTime))}`
          + `${existingStart.official ? ' (publicerad)' : ''} – önskemålet gäller först vid omgenerering.</div>`
        : '';
    return `
        <div class="mb-3">
            <div class="d-flex align-items-center gap-2">
                <label class="small fw-semibold mb-0" style="min-width:130px" for="startPrefSel_${index}">${label}</label>
                <select class="form-select form-select-sm start-pref-select" id="startPrefSel_${index}" data-row="${index}">
                    <option value="Inget"${pref === 'Inget' ? ' selected' : ''}>Ingen preferens</option>
                    <option value="Tidig Start"${pref === 'Tidig Start' ? ' selected' : ''}>Tidig start</option>
                    <option value="Sen Start"${pref === 'Sen Start' ? ' selected' : ''}>Sen start</option>
                </select>
            </div>
            ${warn}
        </div>`;
}

async function saveStartPreference() {
    const registrationId = parseInt(document.getElementById('startPreferenceRegistrationId').value, 10);
    const btn = document.getElementById('startPreferenceSaveBtn');
    const errEl = document.getElementById('startPreferenceError');
    errEl.classList.add('d-none');

    // Expand each row back onto the classes it stands for — on Springskytte one weapon-group
    // row writes the same wish to every class in that group, so storage stays per class.
    const preferences = [];
    document.querySelectorAll('#startPreferenceRows .start-pref-select').forEach(sel => {
        const row = startPrefRowKeys[parseInt(sel.dataset.row, 10)];
        if (!row) return;
        row.classIds.forEach(id => preferences.push({ class: id, preference: sel.value }));
    });

    if (preferences.length === 0) {
        errEl.textContent = 'Inga klasser att spara.';
        errEl.classList.remove('d-none');
        return;
    }

    const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
    btn.disabled = true;
    try {
        const resp = await fetch('/umbraco/surface/RegistrationAdmin/SetStartPreference', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ competitionId, registrationId, preferences })
        });
        const data = await resp.json();
        if (!data.success) {
            errEl.textContent = data.message || 'Kunde inte spara önskemålet.';
            errEl.classList.remove('d-none');
            return;
        }

        // Patch local state so the badges update without a full reload of the table.
        const reg = (competitionRegistrations || []).find(r => r.id === registrationId);
        if (reg && Array.isArray(reg.shootingClasses)) {
            const byClass = {};
            preferences.forEach(p => { byClass[p.class.toLowerCase()] = p.preference; });
            reg.shootingClasses.forEach(sc => {
                const key = String(sc.class || sc.className || '').trim().toLowerCase();
                if (byClass[key] !== undefined) sc.startPreference = byClass[key];
            });
        }
        filterCompetitionRegistrations();

        bootstrap.Modal.getOrCreateInstance(document.getElementById('startPreferenceModal')).hide();
    } catch (err) {
        errEl.textContent = 'Ett fel uppstod: ' + err.message;
        errEl.classList.remove('d-none');
    } finally {
        btn.disabled = false;
    }
}

function saveCompetitionRegistrationChanges() {
    const registrationId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
    const reg = competitionRegistrations.find(r => r.id === registrationId);

    // Index existing per-class state so we can preserve startPreference + teamNumber for
    // classes that were already on the registration. Newly-added classes get the picker's
    // chosen slot (when direktplacering is enabled) and no start preference.
    const existingByClass = {};
    (reg?.shootingClasses || []).forEach(sc => {
        const key = (sc.class || sc.className || '').trim();
        if (key) existingByClass[key] = sc;
    });

    // Per-class slot picks come from the dynamic rows under the class list. Each row's
    // <select> is keyed by class id, so existing classes' picks (pre-filled from the reg)
    // and newly-added classes' picks both surface here.
    const slotByClass = {};
    if (walkInDirektplaceringEnabled) {
        document.querySelectorAll('#competitionEditDpSlotsContainer .dp-slot-select').forEach(sel => {
            if (sel.value) slotByClass[sel.dataset.classId] = parseInt(sel.value, 10);
        });
    }

    const checkedBoxes = document.querySelectorAll('#competitionEditClassList .edit-class-cb:checked');
    const classes = Array.from(checkedBoxes).map(cb => {
        const key = cb.value;
        const existing = existingByClass[key];
        const entry = { class: key };
        if (existing && existing.startPreference) entry.startPreference = existing.startPreference;
        // Slot resolution: explicit per-class pick wins; otherwise fall back to whatever the
        // registration already had (lets a no-op save preserve the existing assignment).
        if (slotByClass[key] != null) {
            entry.teamNumber = slotByClass[key];
        } else if (existing && existing.teamNumber != null) {
            entry.teamNumber = existing.teamNumber;
        }
        return entry;
    });

    if (classes.length === 0) {
        alert('Anmälan måste ha minst en klass. Vill du istället ta bort anmälan, använd knappen längst ner till vänster.');
        return;
    }

    // Deltävling opt-in: read the modal's checkbox when rendered (competition has a
    // configured subCompetitionName), otherwise fall back to whatever the registration
    // already had so a fee re-compute doesn't accidentally drop the surcharge.
    const editSubCompCb = document.getElementById('competitionEditSubCompetitionCheckbox');
    const isSubCompetition = editSubCompCb
        ? !!editSubCompCb.checked
        : !!(reg && reg.isSubCompetition);

    const data = {
        registrationId,
        shootingClasses: classes,
        isSubCompetition
    };

    // Tävlar för. Only sent when it actually differs from what the registration holds, so an
    // ordinary class edit never carries a club change — and a disabled dropdown (single-club
    // shooter) can never move anyone.
    const clubSel = document.getElementById('competitionEditMemberClub');
    const pickedClubId = clubSel && !clubSel.disabled ? parseInt(clubSel.value, 10) : 0;
    if (pickedClubId > 0 && pickedClubId !== (parseInt(reg?.memberClubId, 10) || 0)) {
        data.clubId = pickedClubId;
    }

    // Springskytte start-time picks for weapon groups the shooter isn't slotted in yet. Read
    // BEFORE the save — hiding the modal tears the rows down.
    const springPicks = walkInSpringskytteEnabled
        ? Array.from(document.querySelectorAll('#competitionEditSpringSlotsContainer .edit-spring-slot-select'))
            .filter(sel => sel.value && sel.value !== 'skip')
            .map(sel => {
                const [startTime, nodeIdRaw] = sel.value.split('|');
                // Any ticked class in this weapon group identifies the start; the start list is
                // keyed by member + vapengrupp, and the class travels with the registration.
                const cls = Array.from(document.querySelectorAll('#competitionEditClassList .edit-class-cb:checked'))
                    .map(cb => cb.value)
                    .find(id => springClassWeapon(id) === sel.dataset.weaponClass);
                return { shootingClass: cls, startTime, nodeId: nodeIdRaw ? parseInt(nodeIdRaw, 10) : null };
            })
            .filter(p => p.shootingClass)
        : [];

    // A picker left on the placeholder means a class was added but no start time chosen — the
    // exact silent failure this picker exists to prevent. Make the operator confirm it.
    if (walkInSpringskytteEnabled) {
        const undecided = Array.from(document.querySelectorAll('#competitionEditSpringSlotsContainer .edit-spring-slot-select'))
            .filter(sel => !sel.value)
            .map(sel => sel.dataset.weaponClass);
        if (undecided.length > 0) {
            const ok = confirm(
                `Ingen starttid vald för vapengrupp ${undecided.join(', ')}.\n\n` +
                'Skytten kommer inte att finnas på startlistan för den vapengruppen.\n\nSpara ändå?');
            if (!ok) return;
        }
    }

    fetch('/umbraco/surface/RegistrationAdmin/UpdateCompetitionRegistration', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(async result => {
        if (result.success) {
            // Slot the shooter onto the picked free start times. Fail-soft, exactly like the
            // walk-in path: the class change is the load-bearing op and is already committed.
            if (springPicks.length > 0) {
                const compId = parseInt($('.competition-registration-management').data('competition-id'), 10);
                const token = $('input[name="__RequestVerificationToken"]').val();
                const memberId = reg ? reg.memberId : null;
                const failures = [];
                for (const p of springPicks) {
                    try {
                        const r = await fetch('/umbraco/surface/Springskytte/AssignSpringskytteWalkInStartTime', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                            body: JSON.stringify({
                                competitionId: compId, memberId,
                                shootingClass: p.shootingClass, startTime: p.startTime, nodeId: p.nodeId
                            })
                        });
                        const d = await r.json();
                        if (!d.success) failures.push(d.message || 'okänt fel');
                    } catch (e) {
                        failures.push(e.message || 'nätverksfel');
                    }
                }
                if (failures.length > 0) {
                    alert('Klassändringen sparades, men starttiden kunde inte sättas:\n' + failures.join('\n')
                        + '\n\nLägg skytten på startlistan från fliken Startlistor.');
                }
            }
            bootstrap.Modal.getInstance(document.getElementById('competitionEditRegistrationModal')).hide();
            // Fee-change feedback (e.g. "Faktura uppdaterat: 150 → 300 kr", or a
            // manual-reconciliation warning when the invoice is already paid), plus the club
            // note: a club change rewrites the shooter's club in any already-generated start
            // list / patrol list, and the operator otherwise has no way to know whether the
            // public lists were left showing the old club.
            // Shown as ONE non-blocking banner. These were two alert()s, i.e. up to two native
            // dialogs that freeze the tab — and a class change always produces the fee note.
            showDeskSaveNotice([result.feeChangeNote, result.clubPropagationNote], 'info');
            const registrationId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
            loadCompetitionRegistrations();

            // If the backend created a top-up invoice (paid invoice + fee went up), poll
            // for the registrations list to refresh and then auto-open the wallet modal so
            // the cashier can show the QR for the additional amount in one continuous flow.
            if (result.topUpInvoiceId) {
                const wait = setInterval(() => {
                    const reg = competitionRegistrations.find(r => r.id === registrationId);
                    if (reg && reg.invoiceId === result.topUpInvoiceId) {
                        clearInterval(wait);
                        showPaymentOptionsForRegistration(registrationId);
                    }
                }, 200);
                setTimeout(() => clearInterval(wait), 5000);
            }
        } else {
            alert('Kunde inte uppdatera anmälan: ' + (result.message || 'okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error updating registration:', error);
        alert('Ett fel uppstod vid uppdatering av anmälan.');
    });
}

// Springskytte deletes are start-list-aware: warn if the shooter is in a (published) list, then
// after removal free their slot + drop result/adjustments via a cleanup call.
const springDiscipline = '@compType' === 'Springskytte';

// What the delete does to the money, spelled out in the confirm. The backend is right —
// Pending invoices are cancelled, Paid ones are kept as the historical record
// (RegistrationAdminController.DeleteCompetitionRegistration) — but until now the operator
// was told only "Åtgärden kan inte ångras", so deleting a paid shooter looked free.
function deleteMoneyNote(registrationId) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);
    if (!reg) return '';
    const paid = Math.round(Number(reg.paidAmount) || 0);
    const pending = Math.round(Number(reg.pendingAmount) || 0);
    const lines = [];
    if (paid > 0) {
        lines.push(`OBS: ${paid} kr är redan betalt. Den betalda fakturan makuleras INTE — ` +
                   `återbetalning eller överföring till en annan skytt måste hanteras separat.`);
    }
    if (pending > 0) {
        lines.push(`Obetald faktura på ${pending} kr makuleras.`);
    }
    return lines.length ? '\n\n' + lines.join('\n') : '';
}

async function confirmDeleteCompetitionRegistration(registrationId) {
    if (springDiscipline) { await springAwareDelete(registrationId, null); return; }
    if (confirm('Är du säker på att du vill ta bort denna anmälan? Åtgärden kan inte ångras.'
                + deleteMoneyNote(registrationId))) {
        deleteRegistrationById(registrationId);
    }
}

async function deleteCompetitionRegistration() {
    const registrationId = parseInt(document.getElementById('competitionEditRegistrationId').value);
    const modalEl = document.getElementById('competitionEditRegistrationModal');
    if (springDiscipline) { await springAwareDelete(registrationId, modalEl); return; }
    if (confirm('Är du säker på att du vill ta bort denna anmälan? Åtgärden kan inte ångras.'
                + deleteMoneyNote(registrationId))) {
        bootstrap.Modal.getInstance(modalEl).hide();
        deleteRegistrationById(registrationId);
    }
}

async function springAwareDelete(registrationId, modalElToHide) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);
    const memberId = reg ? reg.memberId : null;
    const compId = $('.competition-registration-management').data('competition-id');
    let msg = 'Är du säker på att du vill ta bort denna anmälan? Åtgärden kan inte ångras.';
    try {
        if (memberId) {
            const m = await fetch(`/umbraco/surface/Springskytte/GetStartListMembership?competitionId=${compId}&memberId=${memberId}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }).then(r => r.json());
            if (m.success && (m.inLists || []).length) {
                const parts = m.inLists.map(l => `• ${l.listName} (start ${(l.startTime || '').substring(0,5)})${l.official ? ' – PUBLICERAD' : ''}`);
                const anyOfficial = m.inLists.some(l => l.official);
                msg = 'Skytten finns i startlista:\n' + parts.join('\n') +
                      '\n\nStarttiden frigörs' + (anyOfficial ? ' och den publicerade startlistan uppdateras' : '') +
                      '. Ta bort anmälan?';
            }
        }
    } catch (e) { /* fall back to the generic confirm */ }
    msg += deleteMoneyNote(registrationId);
    if (!confirm(msg)) return;
    if (modalElToHide) { const inst = bootstrap.Modal.getInstance(modalElToHide); if (inst) inst.hide(); }
    deleteRegistrationById(registrationId, memberId);
}

function deleteRegistrationById(registrationId, memberId) {
    const compId = $('.competition-registration-management').data('competition-id');
    fetch('/umbraco/surface/RegistrationAdmin/DeleteCompetitionRegistration', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify({ registrationId: registrationId })
    })
    .then(response => response.json())
    .then(async data => {
        if (data.success) {
            // Springskytte: free the vacated slot + drop result/adjustment rows.
            if (springDiscipline && memberId) {
                try {
                    await fetch('/umbraco/surface/Springskytte/CleanupDeletedRegistration', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                        body: JSON.stringify({ competitionId: parseInt(compId), memberId: memberId })
                    });
                } catch (e) { /* registration already removed; cleanup is best-effort */ }
            }
            loadCompetitionRegistrations();
        } else {
            alert('Kunde inte ta bort anmälan: ' + (data.message || 'okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error deleting registration:', error);
        alert('Ett fel uppstod vid borttagning av anmälan.');
    });
}

// Bootstrap modal instance, lazily created on first open
let markPaidModalInstance = null;
let markPaidDatePicker = null;

function markAsPaid(registrationId) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);
    if (!reg) {
        alert('Kunde inte hitta anmälan i listan.');
        return;
    }
    if (!reg.invoiceId) {
        alert('Det finns ingen betalning för denna anmälan. Använd plånboksknappen för att starta en betalning först.');
        return;
    }

    // Pre-fill the modal with this registration's data.
    // Reference field: prefer an existing transactionId (e.g. a real Swish transaction
    // ID from a callback) if one was already recorded; otherwise drop in the invoice
    // number, which is exactly what the payer sees as the Swish reference. Saves the
    // cashier from typing/pasting it from the Swish notification.
    const billed = Math.round(Number(reg.paymentAmount) || 0);
    document.getElementById('markPaidInvoiceId').value = reg.invoiceId;
    document.getElementById('markPaidRegistrationId').value = reg.id;
    document.getElementById('markPaidInvoiceAmount').value = billed;
    document.getElementById('markPaidShooterName').textContent = reg.memberName || '';
    document.getElementById('markPaidAmount').textContent = billed;
    document.getElementById('markPaidActualAmount').value = billed;
    document.getElementById('markPaidMethod').value = 'Swish';
    document.getElementById('markPaidTransactionId').value = reg.transactionId || reg.invoiceNumber || '';
    document.getElementById('markPaidNotes').value = '';
    // Receipt checkbox defaults to ON — most paid transitions benefit from the shooter
    // getting a copy. Cash-desk operators can untick when they don't want an email out.
    const receiptBox = document.getElementById('markPaidSendReceipt');
    if (receiptBox) receiptBox.checked = true;
    updateMarkPaidVariance();

    const modalEl = document.getElementById('markAsPaidModal');
    if (!markPaidModalInstance) {
        markPaidModalInstance = new bootstrap.Modal(modalEl);
    }

    // Initialise (or reset) the date picker; defaults to today.
    if (!markPaidDatePicker) {
        markPaidDatePicker = flatpickr('#markPaidDate', {
            locale: 'sv',
            dateFormat: 'Y-m-d',
            defaultDate: 'today',
            maxDate: 'today'
        });
    } else {
        markPaidDatePicker.setDate(new Date(), true);
    }

    markPaidModalInstance.show();
}

function updateMarkPaidVariance() {
    const billed = Number(document.getElementById('markPaidInvoiceAmount').value) || 0;
    const actual = Number(document.getElementById('markPaidActualAmount').value) || 0;
    const note = document.getElementById('markPaidVarianceNote');
    const deltaSpan = document.getElementById('markPaidVarianceDelta');
    if (Math.abs(actual - billed) < 0.005) {
        note.classList.add('d-none');
        return;
    }
    const diff = actual - billed;
    const sign = diff > 0 ? '+' : '−';
    deltaSpan.textContent = `${sign}${Math.abs(Math.round(diff))} kr`;
    note.classList.remove('d-none');
}

function confirmMarkAsPaid() {
    const invoiceId = document.getElementById('markPaidInvoiceId').value;
    if (!invoiceId) return;

    const method = document.getElementById('markPaidMethod').value;
    const dateStr = document.getElementById('markPaidDate').value;
    const transactionId = document.getElementById('markPaidTransactionId').value.trim();
    const notesField = document.getElementById('markPaidNotes').value.trim();
    const billed = Number(document.getElementById('markPaidInvoiceAmount').value) || 0;
    const actualRaw = document.getElementById('markPaidActualAmount').value;
    const actualAmount = actualRaw === '' ? billed : Number(actualRaw);
    if (!Number.isFinite(actualAmount) || actualAmount < 0) {
        alert('Ogiltigt belopp.');
        return;
    }
    const variance = Math.abs(actualAmount - billed) >= 0.005;

    // Build a default note that captures method + reference if the user didn't write one.
    // Surfaces enough context in the invoice's notes field that a future reader can tell
    // who marked it paid and how. Variance is recorded so the audit trail explains why
    // the recorded amount differs from the invoice total.
    const noteParts = [];
    if (notesField) noteParts.push(notesField);
    noteParts.push(`Markerad som betald — ${method}`);
    if (transactionId) noteParts.push(`Ref: ${transactionId}`);
    if (variance) noteParts.push(`Faktiskt: ${Math.round(actualAmount)} kr (faktura: ${Math.round(billed)} kr)`);
    const finalNotes = noteParts.join(' | ');

    const btn = document.getElementById('markPaidConfirmBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sparar…';

    const sendReceipt = document.getElementById('markPaidSendReceipt')?.checked === true;

    const token = $('input[name="__RequestVerificationToken"]').val();
    const params = new URLSearchParams();
    params.append('invoiceId', invoiceId);
    params.append('paymentStatus', 'Paid');
    params.append('paymentDate', dateStr ? new Date(dateStr).toISOString() : new Date().toISOString());
    if (transactionId) params.append('transactionId', transactionId);
    params.append('notes', finalNotes);
    params.append('paymentMethod', method);
    params.append('actualAmount', actualAmount);
    // Always send the flag — omitting it would let the backend default (true) override
    // an explicit untick, defeating the opt-out.
    params.append('sendReceipt', sendReceipt ? 'true' : 'false');

    fetch('/umbraco/surface/Payment/UpdatePaymentStatus', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'RequestVerificationToken': token
        },
        body: params.toString()
    })
    .then(r => r.json())
    .then(result => {
        if (result.success) {
            markPaidModalInstance?.hide();
            loadCompetitionRegistrations();
            // The payment itself is committed — only the confirmation email can fail. Tell the
            // operator while the shooter is still at the desk so they can correct the address or
            // print a kvitto instead. Silence here used to mean "assume it went out".
            if (result.receiptError) {
                alert('Betalningen är registrerad.\n\nOBS: ' + result.receiptError +
                      '\nSkytten har alltså INTE fått någon bekräftelse via e-post.');
            }
        } else {
            alert('Kunde inte uppdatera: ' + (result.message || 'okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Ett fel uppstod: ' + error.message);
    })
    .finally(() => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Bekräfta betalning';
    });
}

// Item #9: persist the at-the-desk attendance toggle. Optimistic — flips the in-memory
// row immediately so the operator sees the label flip without waiting for the round trip.
// On failure we revert the checkbox + in-memory state so the desk doesn't drift from the
// server's view of the world.
async function setCheckedIn(registrationId, checkedIn) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);
    if (reg) reg.isCheckedIn = checkedIn;
    const label = document.querySelector(`label[for="checkin_${registrationId}"]`);
    if (label) label.textContent = checkedIn ? 'Här' : '';
    // The Incheckade card counts the same in-memory rows, so it follows the toggle
    // immediately — and follows the revert below if the save fails.
    updatePaymentSummary();

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const resp = await fetch('/umbraco/surface/RegistrationAdmin/SetCheckedIn', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ registrationId, checkedIn })
        });
        const data = await resp.json();
        if (!data.success) {
            throw new Error(data.message || 'Misslyckades att spara närvaro.');
        }
    } catch (err) {
        // Revert UI + cache on failure
        const cb = document.getElementById(`checkin_${registrationId}`);
        if (cb) cb.checked = !checkedIn;
        if (reg) reg.isCheckedIn = !checkedIn;
        if (label) label.textContent = !checkedIn ? 'Här' : '';
        updatePaymentSummary();
        alert('Kunde inte uppdatera närvaro: ' + err.message);
    }
}

function getPreferenceBadgeClass(preference) {
    switch (preference) {
        case 'Tidig Start': return 'bg-info';
        case 'Sen Start': return 'bg-warning';
        default: return 'bg-secondary';
    }
}

function normalizeShootingClass(raw) {
    if (!raw) return '';
    let s = String(raw).trim();
    // Normalize separators and uppercase where needed
    s = s.replace(/_/g, ' ').replace(/\s+/g, ' ').trim();

    // Common compact forms → spaced
    s = s.replace(/^C\s?Jun$/i, 'C Jun');
    s = s.replace(/^C1\s?Dam$/i, 'C1 Dam');
    s = s.replace(/^C2\s?Dam$/i, 'C2 Dam');
    s = s.replace(/^C3\s?Dam$/i, 'C3 Dam');

    // Veteran Younger/Older variants
    // Map various CVY forms to 'C Vet Y'
    if (/^C\s*V(e|ä)?t\s*Y$/i.test(s) || /^CVY$/i.test(s)) {
        return 'C Vet Y';
    }
    // Map various CVÄ/CVAE forms to 'C Vet Ä'
    if (/^C\s*V(e|ä)?t\s*(Ä|A)$/i.test(s) || /^CVÄ$/i.test(s) || /^CVA$/i.test(s)) {
        // Force Swedish Ä
        return 'C Vet Ä';
    }

    // Map CD3 or C D3 to C3 Dam
    if (/^C\s*D3$/i.test(s) || /^CD3$/i.test(s)) {
        return 'C3 Dam';
    }

    // Uppercase A/B/C categories like A1/A2/A3/B1... keep as-is
    if (/^[ABC][0-9]$/i.test(s)) return s.toUpperCase();

    return s;
}

