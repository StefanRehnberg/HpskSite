async function editCompetitionRegistration(registrationId) {
    const registration = competitionRegistrations.find(r => r.id === registrationId);
    if (!registration) return;

    // Header fields
    document.getElementById('competitionEditRegistrationId').value = registration.id;
    document.getElementById('competitionEditMemberName').value = registration.memberName || '';
    document.getElementById('competitionEditMemberClub').value = registration.memberClub || '';

    // Build the class checklist from the competition's allowed classes (same source the
    // walk-in modal uses). Pre-check the registration's current classes.
    const existingIds = new Set(
        (registration.shootingClasses || []).map(sc => (sc.class || sc.className || '').trim())
    );
    const list = document.getElementById('competitionEditClassList');
    if (Array.isArray(walkInAvailableClasses) && walkInAvailableClasses.length > 0) {
        list.innerHTML = walkInAvailableClasses.map(c => {
            const checked = existingIds.has(c.id) ? 'checked' : '';
            const safeId = `editCls_${c.id.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
            return `
                <div class="form-check">
                    <input class="form-check-input edit-class-cb" type="checkbox"
                           id="${safeId}" value="${escapeAttr(c.id)}" ${checked}>
                    <label class="form-check-label" for="${safeId}">
                        ${escapeAttr(c.name)}
                    </label>
                </div>`;
        }).join('');
    } else {
        // Fallback when the parent view didn't pass an allowed-class list — show whatever
        // the registration currently has, so the operator can at least save start prefs.
        const ids = Array.from(existingIds);
        list.innerHTML = ids.length === 0
            ? '<div class="text-muted small">Inga klasser tillgängliga.</div>'
            : ids.map(id => {
                const safeId = `editCls_${id.replace(/[^a-zA-Z0-9_-]/g, '_')}`;
                return `
                    <div class="form-check">
                        <input class="form-check-input edit-class-cb" type="checkbox"
                               id="${safeId}" value="${escapeAttr(id)}" checked>
                        <label class="form-check-label" for="${safeId}">${escapeAttr(id)}</label>
                    </div>`;
            }).join('');
    }

    // Direktplacering: refresh the slot picker on open so capacity reflects the
    // current state. Reset the selection — adding a class is an explicit choice.
    if (walkInDirektplaceringEnabled) {
        // Pull live availability and render per-class slot rows for whatever the registration
        // already has. Operator-toggled checkboxes will re-render the list (handler below).
        await refreshDpTeamAvailability();
        renderEditDpSlotRows(registration);
    }

    // Pre-fill the deltävling checkbox from the registration. Untoggling here will
    // recompute the fee downward (and surface a refund note); toggling on creates a
    // top-up invoice via the standard multi-invoice flow.
    const editSubCompCb = document.getElementById('competitionEditSubCompetitionCheckbox');
    if (editSubCompCb) editSubCompCb.checked = !!registration.isSubCompetition;

    new bootstrap.Modal(document.getElementById('competitionEditRegistrationModal')).show();
}

// Read the Edit modal's checked classes + the registration's existing per-class team
// assignments and rebuild the per-class slot rows from scratch.
function renderEditDpSlotRows(registration) {
    const host = document.getElementById('competitionEditDpSlotsContainer');
    if (!host) return;

    const existingTeamByClass = {};
    (registration?.shootingClasses || []).forEach(sc => {
        const key = (sc.class || sc.className || '').trim();
        if (key && sc.teamNumber != null) existingTeamByClass[key] = sc.teamNumber;
    });

    const checked = Array.from(document.querySelectorAll('#competitionEditClassList .edit-class-cb:checked'))
        .map(cb => {
            const id = cb.value;
            const lbl = cb.parentElement?.querySelector('label')?.textContent?.trim() || id;
            return { id, name: lbl };
        });
    renderDpSlotRows(host, checked, existingTeamByClass);
}

// Hook checkbox toggles in the Edit modal: enforce mutex within the same bucket so
// "swap C1 to C3" stays a swap (one ticked) instead of stacking two billable classes,
// then re-render the per-class slot rows when direktplacering is enabled.
document.addEventListener('DOMContentLoaded', () => {
    const list = document.getElementById('competitionEditClassList');
    if (!list) return;
    list.addEventListener('change', (e) => {
        if (!e.target.classList.contains('edit-class-cb')) return;
        enforceClassMutex('#competitionEditClassList', e.target);
        if (!walkInDirektplaceringEnabled) return;
        const registrationId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
        const reg = competitionRegistrations.find(r => r.id === registrationId);
        renderEditDpSlotRows(reg);
    });
});

// Tiny HTML attribute escaper local to this modal.
function escapeAttr(s) {
    return String(s ?? '').replace(/[&<>"']/g, c =>
        ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function saveCompetitionRegistrationChanges() {
    const registrationId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
    const reg = competitionRegistrations.find(r => r.id === registrationId);

    // Index existing per-class state so we can preserve startPreference + teamNumber for
    // classes that were already on the registration. Newly-added classes get the picker's
    // chosen slot (when direktplacering is enabled) and no start preference.
    const existingByClass = {};
    (reg?.shootingClasses || []).forEach(sc => {
        const key = (sc.class || sc.className || '').trim();
        if (key) existingByClass[key] = sc;
    });

    // Per-class slot picks come from the dynamic rows under the class list. Each row's
    // <select> is keyed by class id, so existing classes' picks (pre-filled from the reg)
    // and newly-added classes' picks both surface here.
    const slotByClass = {};
    if (walkInDirektplaceringEnabled) {
        document.querySelectorAll('#competitionEditDpSlotsContainer .dp-slot-select').forEach(sel => {
            if (sel.value) slotByClass[sel.dataset.classId] = parseInt(sel.value, 10);
        });
    }

    const checkedBoxes = document.querySelectorAll('#competitionEditClassList .edit-class-cb:checked');
    const classes = Array.from(checkedBoxes).map(cb => {
        const key = cb.value;
        const existing = existingByClass[key];
        const entry = { class: key };
        if (existing && existing.startPreference) entry.startPreference = existing.startPreference;
        // Slot resolution: explicit per-class pick wins; otherwise fall back to whatever the
        // registration already had (lets a no-op save preserve the existing assignment).
        if (slotByClass[key] != null) {
            entry.teamNumber = slotByClass[key];
        } else if (existing && existing.teamNumber != null) {
            entry.teamNumber = existing.teamNumber;
        }
        return entry;
    });

    if (classes.length === 0) {
        alert('Anmälan måste ha minst en klass. Vill du istället ta bort anmälan, använd knappen längst ner till vänster.');
        return;
    }

    // Deltävling opt-in: read the modal's checkbox when rendered (competition has a
    // configured subCompetitionName), otherwise fall back to whatever the registration
    // already had so a fee re-compute doesn't accidentally drop the surcharge.
    const editSubCompCb = document.getElementById('competitionEditSubCompetitionCheckbox');
    const isSubCompetition = editSubCompCb
        ? !!editSubCompCb.checked
        : !!(reg && reg.isSubCompetition);

    const data = {
        registrationId,
        shootingClasses: classes,
        isSubCompetition
    };

    fetch('/umbraco/surface/RegistrationAdmin/UpdateCompetitionRegistration', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
        },
        body: JSON.stringify(data)
    })
    .then(response => response.json())
    .then(result => {
        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('competitionEditRegistrationModal')).hide();
            // Surface fee-change feedback (e.g. "Faktura uppdaterat: 150 → 300 kr" or
            // a manual-reconciliation warning when invoice is already paid).
            if (result.feeChangeNote) {
                alert(result.feeChangeNote);
            }
            const registrationId = parseInt(document.getElementById('competitionEditRegistrationId').value, 10);
            loadCompetitionRegistrations();

            // If the backend created a top-up invoice (paid invoice + fee went up), poll
            // for the registrations list to refresh and then auto-open the wallet modal so
            // the cashier can show the QR for the additional amount in one continuous flow.
            if (result.topUpInvoiceId) {
                const wait = setInterval(() => {
                    const reg = competitionRegistrations.find(r => r.id === registrationId);
                    if (reg && reg.invoiceId === result.topUpInvoiceId) {
                        clearInterval(wait);
                        showPaymentOptionsForRegistration(registrationId);
                    }
                }, 200);
                setTimeout(() => clearInterval(wait), 5000);
            }
        } else {
            alert('Kunde inte uppdatera anmälan: ' + (result.message || 'okänt fel'));
        }
    })
    .catch(error => {
        console.error('Error updating registration:', error);
        alert('Ett fel uppstod vid uppdatering av anmälan.');
    });
}

