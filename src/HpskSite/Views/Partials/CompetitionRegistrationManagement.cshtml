                                        <th>Namn</th>
                                        <th id="lateTeamMembersClassHeader">Klasser</th>
                                        <th style="width:70px;" class="text-center" id="lateTeamMembersSpareHeader">Reserv</th>
                                    </tr>
                                </thead>
                                <tbody id="lateTeamMembersTableBody"></tbody>
                            </table>
                        </div>
                        <div class="form-text mt-1" id="lateTeamMemberCountInfo"></div>
