@* Shared samlingsfaktura dialog + preview rendering (also used by the club's Fakturor tab). *@
@await Html.PartialAsync("_ConsolidatePreview")
@await Html.PartialAsync("_ConsolidateByClubModal")

<script>
// ── Timestamps ────────────────────────────────────────────────────────────
// Timestamps come off the wire WITHOUT a timezone designator ("2026-08-05T18:15:48"),
// and JavaScript reads an offset-less datetime as the BROWSER's local time. Two different
// clocks are stored behind that identical shape:
//   • registrationDate — written with DateTime.Now, i.e. the SERVER's local time. Prod runs
//     UTC, so the desk saw 18:15 for a 20:15 registration; dev runs Swedish time, so a fixed
//     "add two hours" would be wrong there. The server's own offset is stamped in below at
//     render time, which makes both environments come out right.
//   • occurredAt (invoice audit trail) — written with DateTime.UtcNow, so it is UTC regardless
//     of where the app runs.
// Both are then rendered in Europe/Stockholm, which is the clock the desk is working to.
// (Caveat: SERVER_UTC_OFFSET is the offset as of page render, so on a dev machine a timestamp
// from the other side of a DST switch can be an hour out. On prod the offset is always +00:00.)
const SERVER_UTC_OFFSET = '@Html.Raw(serverUtcOffset)';
const SWEDISH_DATETIME_FORMAT = {
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Stockholm'
};

function hasExplicitZone(s) {
    return /(Z|[+-]\d{2}:?\d{2})$/.test(s);
}

// For values written with DateTime.Now (server local).
function formatServerLocalDateTime(value) {
    if (!value) return '';
    const s = String(value);
    const d = new Date(hasExplicitZone(s) ? s : s + SERVER_UTC_OFFSET);
    return isNaN(d.getTime()) ? '' : d.toLocaleString('sv-SE', SWEDISH_DATETIME_FORMAT);
}

// For values written with DateTime.UtcNow.
function formatUtcDateTime(value) {
    if (!value) return '';
    const s = String(value);
    const d = new Date(hasExplicitZone(s) ? s : s + 'Z');
    return isNaN(d.getTime()) ? '' : d.toLocaleString('sv-SE', SWEDISH_DATETIME_FORMAT);
}

// Competition Registration Management JavaScript
let competitionRegistrations = [];
let filteredCompetitionRegistrations = [];
let currentCompetitionPage = 1;
const competitionPageSize = 20;
// Name of the competition's optional Deltävling (sub-competition); '' when it has none.
// Drives the conditional "Deltävling" column on the individuals table.
let competitionSubCompetitionName = '';

// Sort state for the individuals table. Empty key = original (load) order.
let competitionSortKey = '';
let competitionSortDir = 1; // 1 = ascending, -1 = descending

// Mirror of HpskSite.Helpers.ClubNameHelper.Shorten — abbreviates the long
// suffix words so the Klubb column stays narrow. Display only; the full name is
// kept on the row (search/filter/dropdown) and shown via the cell's title.
function shortenClubName(name) {
    if (!name) return name;
    // Special cases first — well-known clubs with an established acronym.
    if (name.toLowerCase() === 'göteborgs pistol-och sportskk pistolsektionen') return 'GPSSK';
    return name
        .replace(/Pistolskytteförening/gi, 'PSF')
        .replace(/Pistolskytteklubb/gi, 'PSK')
        .replace(/Pistolskyttar/gi, 'PS')
        .replace(/Pistolklubb/gi, 'PK')
        .replace(/Handeldvapenförening/gi, 'HF')
        .replace(/Sportskytteklubb/gi, 'SSK')
        .replace(/Skytteklubb/gi, 'SK')
        .replace(/Skytteförening/gi, 'SF');
}

// Toggle/choose sort column for the individuals table.
function sortCompetitionRegistrations(key) {
    if (competitionSortKey === key) {
        competitionSortDir = -competitionSortDir;
    } else {
        competitionSortKey = key;
        competitionSortDir = 1;
    }
    applyCompetitionSort();
    currentCompetitionPage = 1;
    displayCompetitionRegistrations();
    updateCompetitionSortIndicators();
}

// Sort filteredCompetitionRegistrations in place by the active key. No-op when no
// key is selected, so the natural load order is preserved until the user clicks.
function applyCompetitionSort() {
    if (!competitionSortKey) return;
    const key = competitionSortKey;
    const dir = competitionSortDir;
    filteredCompetitionRegistrations.sort((a, b) => {
        switch (key) {
            case 'memberName':
                return (a.memberName || '').localeCompare(b.memberName || '', 'sv') * dir;
            case 'memberClub':
                return (a.memberClub || '').localeCompare(b.memberClub || '', 'sv') * dir;
            case 'isSubCompetition':
                return ((a.isSubCompetition ? 1 : 0) - (b.isSubCompetition ? 1 : 0)) * dir;
            // Both boolean columns sort false-first ascending, so one click groups the shooters
            // the desk needs to chase — not yet checked in, or unreachable by push — together.
            case 'isCheckedIn':
                return ((a.isCheckedIn ? 1 : 0) - (b.isCheckedIn ? 1 : 0)) * dir;
            case 'hasPushSubscription':
                return ((a.hasPushSubscription ? 1 : 0) - (b.hasPushSubscription ? 1 : 0)) * dir;
            case 'registrationDate':
                return ((new Date(a.registrationDate).getTime() || 0) - (new Date(b.registrationDate).getTime() || 0)) * dir;
            case 'paymentStatus':
                return (a.paymentStatus || '').localeCompare(b.paymentStatus || '', 'sv') * dir;
            default:
                return 0;
        }
    });
}

// Paint the ▲/▼ arrow on the active sort column header.
function updateCompetitionSortIndicators() {
    document.querySelectorAll('#competitionRegistrationsTable .sort-ind').forEach(el => {
        const k = el.getAttribute('data-sort');
        el.textContent = (k === competitionSortKey) ? (competitionSortDir === 1 ? ' ▲' : ' ▼') : '';
    });
}

// Helper function to get payment status badge class
function getPaymentStatusBadgeClass(status) {
    switch(status) {
        case 'Paid':
            return 'bg-success';
        case 'Pending':
            return 'bg-warning';
        case 'Failed':
        case 'Cancelled':
        case 'Refunded':
            return 'bg-danger';
        case 'No Invoice':
            return 'bg-danger';
        case 'No Fee':
            return 'bg-secondary';
        default:
            return 'bg-secondary';
    }
}

// Helper function to get payment status display text in Swedish
function getPaymentStatusText(status) {
    switch(status) {
        case 'Paid':
            return 'Betald';
        case 'Pending':
            return 'Väntande';
        case 'Failed':
            return 'Misslyckad';
        case 'Cancelled':
            return 'Makulerad';
        case 'Refunded':
            return 'Återbetald';
        case 'No Invoice':
            return 'Saknar faktura';
        case 'No Fee':
            return 'Ingen avgift';
        case 'Unknown':
            return 'Okänd';
        default:
            return status;
    }
}

// Load registrations when tab is shown
function loadCompetitionRegistrations() {
    showCompetitionLoading();
    const currentCompetitionId = $('.competition-registration-management').data('competition-id');

    fetch(`/umbraco/surface/Competition/GetCompetitionRegistrations?competitionId=${currentCompetitionId}`, {
        method: 'GET',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            competitionRegistrations = data.registrations || [];
            competitionSubCompetitionName = data.subCompetitionName || '';
            const ic = document.getElementById('individualsCount');
            if (ic) ic.textContent = competitionRegistrations.length;
            populateCompetitionClubFilter();
            populateShootingClassFilter();
            updatePaymentSummary();
            filterCompetitionRegistrations();
        } else {
            showCompetitionError(data.message || 'Failed to load registrations');
        }
    })
    .catch(error => {
        console.error('Error loading competition registrations:', error);
        showCompetitionError('Failed to load registrations. Please try again.');
    });

    // Teams/relay live in their own section; load them alongside individuals so they also
    // refresh after a payment is recorded (which re-runs loadCompetitionRegistrations).
    loadCompetitionTeams();
}

// ==================== Lag (teams + stafett) ====================
let competitionTeams = [];

// Sort state for the teams table. Empty key = original (load) order.
let teamSortKey = '';
let teamSortDir = 1; // 1 = ascending, -1 = descending

function sortCompetitionTeams(key) {
    if (teamSortKey === key) {
        teamSortDir = -teamSortDir;
    } else {
        teamSortKey = key;
        teamSortDir = 1;
    }
    renderCompetitionTeams();
    updateTeamSortIndicators();
}

// Paint the ▲/▼ arrow on the active teams sort column header.
function updateTeamSortIndicators() {
    document.querySelectorAll('#competitionTeamsSection .team-sort-ind').forEach(el => {
        const k = el.getAttribute('data-sort');
        el.textContent = (k === teamSortKey) ? (teamSortDir === 1 ? ' ▲' : ' ▼') : '';
    });
}

// Desk-side placement warning. Same coverage data the Startlistor tab shows, condensed to one
// line: the desk needs to know that what it just registered has nowhere to start.
async function refreshDeskCoverageBanner() {
    const banner = document.getElementById('deskCoverageBanner');
    if (!banner) return; // non-Springskytte
    try {
        const cid = $('.competition-registration-management').data('competition-id');
        const cov = await fetch(`/umbraco/surface/Springskytte/GetStartListCoverage?competitionId=${cid}`)
            .then(r => r.json());
        if (!cov.success) { banner.classList.add('d-none'); return; }

        const ind = cov.individuals || { total: 0, placed: 0, byWeapon: [] };
        const staf = cov.stafett || { total: 0, placed: 0, missing: [] };
        const indMissing = Math.max(0, (ind.total || 0) - (ind.placed || 0));
        const stafMissing = (staf.missing || []).length;

        if (indMissing === 0 && stafMissing === 0) {
            banner.classList.add('d-none');
            banner.classList.remove('d-flex');
            return;
        }

        const parts = [];
        if (indMissing > 0) {
            const perWc = (ind.byWeapon || [])
                .filter(w => w.placed < w.total)
                .map(w => `${w.weaponClass} ${w.total - w.placed}`)
                .join(', ');
            parts.push(`<strong>${indMissing} start${indMissing === 1 ? '' : 'er'} utan starttid</strong>`
                     + (perWc ? ` (${perWc})` : ''));
        }
        if (stafMissing > 0) parts.push(`<strong>${stafMissing} stafettlag utan startlista</strong>`);

        document.getElementById('deskCoverageText').innerHTML =
            '<i class="bi bi-exclamation-triangle me-1"></i>' + parts.join(' · ')
            + ' — de saknas på startlistan.';
        banner.classList.remove('d-none');
        banner.classList.add('d-flex');
    } catch (err) {
        console.warn('Could not refresh desk coverage banner:', err);
    }
}

// The tab buttons live in the host page (CompetitionManagement.cshtml), so switch via Bootstrap.
function deskGoToStartLists() {
    const tabBtn = document.querySelector('[data-bs-target="#startlists"], #startlists-tab');
    if (tabBtn && window.bootstrap) { bootstrap.Tab.getOrCreateInstance(tabBtn).show(); }
    else { alert('Öppna fliken Startlistor för att lägga till de som saknas.'); }
}

function loadCompetitionTeams() {
    const cid = $('.competition-registration-management').data('competition-id');
    fetch(`/umbraco/surface/RegistrationAdmin/GetCompetitionTeams?competitionId=${cid}`)
        .then(r => r.json())
        .then(data => {
            competitionTeams = (data.success && data.teams) ? data.teams : [];
            // Teams arrive after the individuals, so re-run the club list now that their
            // clubs are known (see the note in populateCompetitionClubFilter).
            populateCompetitionClubFilter();
            renderCompetitionTeams();
            refreshDeskCoverageBanner();
        })
        .catch(err => {
            console.error('Error loading teams:', err);
            competitionTeams = [];
            renderCompetitionTeams();
        });
}

// Reads the same inputs as filterCompetitionRegistrations so the two lists can never drift apart.
function filterCompetitionTeams(teams) {
    const clubFilter = document.getElementById('competitionClubFilter')?.value || '';
    const paymentFilter = document.getElementById('competitionPaymentFilter')?.value || '';
    const searchTerm = (document.getElementById('competitionRegistrationSearch')?.value || '').trim().toLowerCase();

    // A resolved samlingsfaktura reference wins here too — it can cover lag as well as individual
    // registrations (often both), and the raw reference text matches no team's name or roster, so
    // without this the Lag card would empty out exactly when it holds what the payment settles.
    if (consolidatedRefTeamIds) {
        return consolidatedRefTeamIds.size > 0
            ? teams.filter(t => consolidatedRefTeamIds.has(t.id))
            : [];
    }

    if (!clubFilter && !paymentFilter && !searchTerm) return teams;

    return teams.filter(t => {
        if (clubFilter && t.clubName !== clubFilter) return false;
        if (paymentFilter && (t.paymentStatus || 'No Invoice') !== paymentFilter) return false;
        if (searchTerm) {
            const haystack = [
                t.teamName || '',
                t.clubName || '',
                t.teamClass || '',
                ...(t.members || []).map(m => m.name || '')
            ].join(' ').toLowerCase();
            if (!haystack.includes(searchTerm)) return false;
        }
        return true;
    });
}

function renderCompetitionTeams() {
    const section = document.getElementById('competitionTeamsSection');
    const tbody = document.getElementById('competitionTeamsTableBody');
    if (!section || !tbody) return;

    // Teams load asynchronously after individuals; recompute the summary cards so the
    // money totals + "Anmälda Lag" count include teams once they arrive.
    updatePaymentSummary();

    // Apply the desk's filters to teams too. Sök matches the team name, its club and its
    // members' names; Klubb and Betalstatus map straight across. Klass / Startpreferens /
    // Närvaro are individual-only concepts and are deliberately NOT applied — a team has no
    // check-in and its teamClass lives in a different id space than the shooters' classes.
    const teamsFiltered = filterCompetitionTeams(competitionTeams);

    const countEl = document.getElementById('teamsCount');
    if (countEl) {
        countEl.textContent = teamsFiltered.length === competitionTeams.length
            ? competitionTeams.length
            : `${teamsFiltered.length} av ${competitionTeams.length}`;
    }

    // Keep the card visible while filtered-to-empty, so "no hits" reads as a filter result
    // rather than as a competition without teams.
    if (!competitionTeams.length) {
        section.classList.add('d-none');
        tbody.innerHTML = '';
        return;
    }
    section.classList.remove('d-none');

    if (!teamsFiltered.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted py-3">Inga lag matchar filtret.</td></tr>';
        return;
    }

    // Sort a copy by the active key (the natural load order is preserved until a header click).
    let teamRows = teamsFiltered.slice();
    if (teamSortKey) {
        const dir = teamSortDir;
        teamRows.sort((a, b) => {
            switch (teamSortKey) {
                case 'teamName':
                    return (a.teamName || '').localeCompare(b.teamName || '', 'sv') * dir;
                case 'type':
                    return ((a.isRelay ? 1 : 0) - (b.isRelay ? 1 : 0)) * dir;
                case 'teamClass':
                    return (a.teamClass || '').localeCompare(b.teamClass || '', 'sv') * dir;
                case 'clubName':
                    return (a.clubName || '').localeCompare(b.clubName || '', 'sv') * dir;
                case 'paymentStatus':
                    return (a.paymentStatus || '').localeCompare(b.paymentStatus || '', 'sv') * dir;
                default:
                    return 0;
            }
        });
    }

    tbody.innerHTML = teamRows.map(t => {
        const typeBadge = t.isRelay
            ? '<span class="badge bg-primary">Stafett</span>'
            : '<span class="badge bg-info">Lag</span>';
        const members = (t.members && t.members.length)
            ? t.members.map(m => `${escapeHtmlSafe(m.name)}${m.isSpare ? ' <span class="badge bg-secondary">Reserv</span>' : ''}`).join('<br>')
            : '<span class="text-muted fst-italic">Ej valda än</span>';
        const statusBadge = `<span class="badge ${getPaymentStatusBadgeClass(t.paymentStatus)}">${getPaymentStatusText(t.paymentStatus)}</span>`;

        // Mirror the individual rows' Åtgärder menu exactly — same items, same order, same
        // divider placement, delete last and named in full. A team row that still looked like
        // the old icon strip while the shooter rows above it were menus would be worse than
        // either style applied consistently. No "Visa skytt" here: a team has no one member.
        const nameArg = JSON.stringify(t.teamName).replace(/"/g, '&quot;');
        const editItem = `<li><button class="dropdown-item" type="button" onclick="editTeam(${t.id})"><i class="bi bi-pencil me-2 text-primary"></i>Redigera lag – namn och deltagare</button></li>`;
        const walletItem = (t.paymentStatus !== 'No Fee')
            ? `<li><button class="dropdown-item" type="button" onclick="showPaymentOptionsForTeam(${t.id})"><i class="bi bi-wallet2 me-2 text-success"></i>Hantera betalning</button></li>`
            : '';
        const markItem = (t.paymentStatus === 'Pending')
            ? `<li><button class="dropdown-item fw-semibold" type="button" onclick="markTeamAsPaid(${t.id})"><i class="bi bi-check-circle me-2 text-success"></i>Markera som betald</button></li>`
            : '';
        const histItem = renderHistoryMenuItem(t.invoiceId, nameArg, t.lastReminderSentDate, t.reminderCount);
        const payItems = (markItem || walletItem || histItem)
            ? `<li><hr class="dropdown-divider"></li>${markItem}${walletItem}${histItem}`
            : '';

        return `<tr>
            <td><strong>${escapeHtmlSafe(t.teamName)}</strong></td>
            <td>${typeBadge}</td>
            <td>${escapeHtmlSafe(t.teamClass)}</td>
            <td style="font-size:0.85em; max-width:150px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtmlSafe(t.clubName || '')}">${escapeHtmlSafe(shortenClubName(t.clubName || ''))}</td>
            <td class="small">${members}</td>
            <td>${statusBadge}</td>
            <td class="text-end desk-actions-col">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}'
                            aria-expanded="false" title="Åtgärder för ${escapeHtmlSafe(t.teamName)}">
                        <i class="bi bi-sliders me-2"></i>Åtgärder
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        ${editItem}
                        ${payItems}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item text-danger" type="button" onclick="confirmDeleteTeam(${t.id})">
                                <i class="bi bi-trash me-2"></i>Ta bort laget
                            </button>
                        </li>
                    </ul>
                </div>
            </td>
        </tr>`;
    }).join('');
}

function escapeHtmlSafe(s) {
    const d = document.createElement('div');
    d.textContent = s == null ? '' : String(s);
    return d.innerHTML;
}

// Build the "Betalningshistorik" item for a row's Åtgärder menu. No invoice, no item.
// When a payment reminder has already gone out we tint the icon and say the count out loud
// in the label rather than hiding it in a tooltip — when the operator is chasing an unpaid
// entry, "already reminded 3 times" is the thing they need to see without hovering.
// `nameArg` is the member/team name pre-stringified + &quot;-escaped by the caller
// (passed straight into the onclick).
function renderHistoryMenuItem(invoiceId, nameArg, lastReminderSentDate, reminderCount) {
    if (!invoiceId) return '';
    let label = 'Betalningshistorik';
    let icon = 'text-secondary';
    if (lastReminderSentDate) {
        const n = reminderCount || 1;
        label = `Betalningshistorik – påmind ${n} ${n > 1 ? 'gånger' : 'gång'}`;
        icon = 'text-info';
    }
    return `<li>
        <button class="dropdown-item" type="button" onclick="showInvoiceHistory(${invoiceId}, ${nameArg})">
            <i class="bi bi-clock-history me-2 ${icon}"></i>${escapeHtmlSafe(label)}
        </button>
    </li>`;
}

// ── Send a notis to one shooter ───────────────────────────────────────────
// Reuses ParticipantMessage/SendToParticipants with the Person scope, which already exists for
// the "Meddela deltagare" tab. Nothing new server-side: same audit trail, same in-app inbox,
// same push fan-out — just an audience of one.
let sendNoticeMemberId = 0;

function openSendNoticeModal(registrationId) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);
    if (!reg) { alert('Anmälan kunde inte hittas.'); return; }

    sendNoticeMemberId = reg.memberId;
    document.getElementById('sendNoticeName').textContent = reg.memberName || '';
    document.getElementById('sendNoticeBody').value = '';
    document.getElementById('sendNoticeUrgency').value = 'Normal';
    document.getElementById('sendNoticeError').classList.add('d-none');
    document.getElementById('sendNoticeOk').classList.add('d-none');
    document.getElementById('sendNoticeSubmit').disabled = false;

    // Be explicit about what will actually happen — a dark antenna does not mean "cannot send".
    document.getElementById('sendNoticeReach').innerHTML = reg.hasPushSubscription
        ? '<span class="text-success"><i class="bi bi-broadcast me-1"></i>Skytten har en enhet registrerad — notisen når mobilen direkt.</span>'
        : '<span class="text-muted"><i class="bi bi-broadcast me-1"></i>Ingen enhet registrerad för push. Meddelandet sparas ändå och syns på tävlingssidan när skytten loggar in — men mobilen plingar inte.</span>';

    bootstrap.Modal.getOrCreateInstance(document.getElementById('sendNoticeModal')).show();
}

async function confirmSendNotice() {
    const body = document.getElementById('sendNoticeBody').value.trim();
    const errBox = document.getElementById('sendNoticeError');
    const okBox = document.getElementById('sendNoticeOk');
    const btn = document.getElementById('sendNoticeSubmit');

    errBox.classList.add('d-none');
    okBox.classList.add('d-none');

    if (!body) {
        errBox.textContent = 'Skriv ett meddelande först.';
        errBox.classList.remove('d-none');
        return;
    }
    if (!sendNoticeMemberId) {
        errBox.textContent = 'Skytten saknar medlems-id — notis kan inte skickas.';
        errBox.classList.remove('d-none');
        return;
    }

    btn.disabled = true;
    const original = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skickar…';

    try {
        const competitionId = $('.competition-registration-management').data('competition-id');
        const resp = await fetch('/umbraco/surface/ParticipantMessage/SendToParticipants', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({
                competitionId: competitionId,
                scopeType: 'Person',
                scopeKey: String(sendNoticeMemberId),
                body: body,
                urgency: document.getElementById('sendNoticeUrgency').value
            })
        });
        const data = await resp.json();
        if (data.success) {
            okBox.textContent = data.recipientCount > 0
                ? 'Notisen är skickad.'
                : 'Ingen mottagare hittades — kontrollera att skytten fortfarande är anmäld.';
            okBox.classList.remove('d-none');
            btn.innerHTML = original;
            setTimeout(() => bootstrap.Modal.getInstance(document.getElementById('sendNoticeModal'))?.hide(), 1200);
            return;
        }
        errBox.textContent = data.message || 'Notisen kunde inte skickas.';
    } catch (e) {
        errBox.textContent = 'Notisen kunde inte skickas. Kontrollera nätverket.';
    }

    errBox.classList.remove('d-none');
    btn.disabled = false;
    btn.innerHTML = original;
}

// ── Shooter info card ─────────────────────────────────────────────────────
// Opened from the row's Åtgärder menu. Everything about payment, classes and check-in is
// ALREADY in the row object the table was rendered from, so the round-trip fetches only the
// contact details the browser has never seen. That keeps the modal fast on a phone at the
// desk and keeps the endpoint small.

function shooterInfoRow(label, value, opts) {
    if (!value) return '';
    const o = opts || {};
    const shown = o.html ? value : escapeHtmlSafe(value);
    return `<div class="row g-0 py-1 border-bottom">
        <div class="col-5 col-sm-4 text-muted small">${escapeHtmlSafe(label)}</div>
        <div class="col-7 col-sm-8">${shown}</div>
    </div>`;
}

function shooterInfoTel(number) {
    if (!number) return '';
    const clean = String(number).replace(/[^\d+]/g, '');
    return `<a href="tel:${encodeURIComponent(clean)}">${escapeHtmlSafe(number)}</a>`;
}

function shooterInfoMail(addr) {
    if (!addr) return '';
    return `<a href="mailto:${encodeURIComponent(addr)}">${escapeHtmlSafe(addr)}</a>`;
}

function shooterInfoMoney(n) {
    const v = Number(n || 0);
    return `${v.toLocaleString('sv-SE', { maximumFractionDigits: 2 })} kr`;
}

async function showShooterInfo(registrationId) {
    const reg = competitionRegistrations.find(r => r.id === registrationId);

    const modalEl = document.getElementById('shooterInfoModal');
    const loading = document.getElementById('shooterInfoLoading');
    const errBox = document.getElementById('shooterInfoError');
    const body = document.getElementById('shooterInfoBody');
    const editBtn = document.getElementById('shooterInfoEditBtn');

    document.getElementById('shooterInfoTitle').textContent = reg ? reg.memberName : 'Skytt';
    loading.classList.remove('d-none');
    errBox.classList.add('d-none');
    body.classList.add('d-none');
    body.innerHTML = '';
    editBtn.classList.add('d-none');

    bootstrap.Modal.getOrCreateInstance(modalEl).show();

    let info = null;
    try {
        // currentCompetitionId is a const scoped inside loadCompetitionRegistrations, not a
        // global — read the same source it does.
        const competitionId = $('.competition-registration-management').data('competition-id');
        const resp = await fetch(
            `/umbraco/surface/RegistrationAdmin/GetShooterInfo?competitionId=${competitionId}&registrationId=${registrationId}`,
            { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        info = await resp.json();
    } catch (e) {
        info = { success: false, message: 'Kunde inte hämta uppgifterna. Kontrollera nätverket.' };
    }

    loading.classList.add('d-none');

    if (!info || !info.success) {
        errBox.textContent = (info && info.message) || 'Kunde inte hämta uppgifterna.';
        errBox.classList.remove('d-none');
        return;
    }

    const s = info.shooter || {};
    const r = info.registration || {};

    // ── Kontakt ──
    // Klubb and krets share one row and are both links when the pages resolve. Opening in a new
    // tab is deliberate: the desk must not lose the Anmälningar view mid-transaction.
    let contact = '';
    const clubLabel = s.clubName || (reg ? reg.memberClub : '') || '';
    if (clubLabel) {
        const clubPart = s.clubUrl
            ? `<a href="${escapeHtmlSafe(s.clubUrl)}" target="_blank" rel="noopener">${escapeHtmlSafe(clubLabel)}</a>`
            : escapeHtmlSafe(clubLabel);
        const regionPart = s.regionName
            ? (s.regionUrl
                ? ` <span class="text-body-secondary">·</span> <a href="${escapeHtmlSafe(s.regionUrl)}" target="_blank" rel="noopener">${escapeHtmlSafe(s.regionName)}</a>`
                : ` <span class="text-body-secondary">·</span> ${escapeHtmlSafe(s.regionName)}`)
            : '';
        contact += shooterInfoRow('Klubb', clubPart + regionPart, { html: true });
    }
    contact += shooterInfoRow('Telefon', shooterInfoTel(s.phone), { html: true });
    contact += shooterInfoRow('E-post', shooterInfoMail(s.email), { html: true });
    if (reg) {
        contact += shooterInfoRow('Push-notis', reg.hasPushSubscription
            ? '<span class="text-success"><i class="bi bi-broadcast me-1"></i>Enhet registrerad</span>'
            : '<span class="text-muted"><i class="bi bi-broadcast me-1"></i>Ingen enhet – notis syns bara i appen</span>',
            { html: true });
    }
    if (!s.phone && !s.email) {
        contact += `<div class="alert alert-warning mb-0 mt-2 py-2 small">
            <i class="bi bi-exclamation-triangle me-1"></i>Inga kontaktuppgifter registrerade på medlemmen.
        </div>`;
    }

    // ── Målsman / anhörig — only rendered when something is on file ──
    let nextOfKin = '';
    nextOfKin += shooterInfoRow('Närmast anhörig', s.emergencyContactName);
    nextOfKin += shooterInfoRow('Anhörig, telefon', shooterInfoTel(s.emergencyContactPhone), { html: true });
    nextOfKin += shooterInfoRow('Målsman 1', s.guardian1Name);
    nextOfKin += shooterInfoRow('Målsman 1, telefon', shooterInfoTel(s.guardian1Mobile), { html: true });
    nextOfKin += shooterInfoRow('Målsman 1, e-post', shooterInfoMail(s.guardian1Email), { html: true });
    nextOfKin += shooterInfoRow('Målsman 2', s.guardian2Name);
    nextOfKin += shooterInfoRow('Målsman 2, telefon', shooterInfoTel(s.guardian2Mobile), { html: true });
    nextOfKin += shooterInfoRow('Målsman 2, e-post', shooterInfoMail(s.guardian2Email), { html: true });

    // ── Anmälan ── (from the row object the table already holds)
    let entry = '';
    if (reg) {
        const classNames = (reg.shootingClasses || []).map(sc => {
            const id = sc.class || sc.className || '';
            const norm = normalizeShootingClass(id);
            const disp = window.formatAgeSpan ? window.formatAgeSpan(norm) : norm;
            return `<span class="badge bg-primary me-1">${escapeHtmlSafe(disp)}</span>`;
        }).join('');
        entry += shooterInfoRow('Klasser', classNames || '<span class="text-muted">—</span>', { html: true });
        entry += shooterInfoRow('Anmäld', formatServerLocalDateTime(reg.registrationDate));
        entry += shooterInfoRow('Incheckad', reg.isCheckedIn
            ? '<span class="badge bg-success">Ja</span>'
            : '<span class="badge bg-secondary">Nej</span>', { html: true });
        if (competitionSubCompetitionName) {
            entry += shooterInfoRow(competitionSubCompetitionName, reg.isSubCompetition ? 'Ja' : 'Nej');
        }
    }
    entry += shooterInfoRow('Anmäld av', r.registeredBy);
    entry += shooterInfoRow('Skyttens meddelande', r.shooterNotes);

    // ── Betalning ── the "why is this not settled" half
    let pay = '';
    if (reg) {
        pay += shooterInfoRow('Status',
            `<span class="badge ${getPaymentStatusBadgeClass(reg.paymentStatus)}">${getPaymentStatusText(reg.paymentStatus)}</span>`,
            { html: true });
        pay += shooterInfoRow('Fakturanummer', reg.invoiceNumber);
        pay += shooterInfoRow('Att betala', shooterInfoMoney(reg.paymentAmount));
        if (Number(reg.paidAmount) > 0) pay += shooterInfoRow('Betalt', shooterInfoMoney(reg.paidAmount));
        if (Number(reg.pendingAmount) > 0) pay += shooterInfoRow('Utestående', shooterInfoMoney(reg.pendingAmount));
        if (reg.hasVariance) {
            pay += shooterInfoRow('Avvikelse',
                '<span class="badge bg-warning text-dark">Faktiskt belopp avviker från fakturan</span>', { html: true });
        }
        if (reg.paymentSentDate && reg.paymentStatus !== 'Paid') {
            pay += shooterInfoRow('Betalning anmäld',
                `${escapeHtmlSafe(formatUtcDateTime(reg.paymentSentDate))}${reg.paymentSentBy ? ' av ' + escapeHtmlSafe(reg.paymentSentBy) : ''}
                 <div class="small text-muted">Betalaren uppger att betalning är gjord — bekräfta när den är mottagen.</div>`,
                { html: true });
        }
        // The single most useful answer to "why hasn't this person paid": often nobody asked.
        if (reg.lastReminderSentDate) {
            const n = reg.reminderCount || 1;
            pay += shooterInfoRow('Påminnelser',
                `${n} st – senast ${escapeHtmlSafe(formatUtcDateTime(reg.lastReminderSentDate))}`, { html: true });
        } else if (reg.paymentStatus === 'Pending') {
            pay += shooterInfoRow('Påminnelser',
                '<span class="text-danger">Ingen påminnelse skickad</span>', { html: true });
        }
    }

    const section = (title, icon, content) => content
        ? `<h6 class="text-uppercase text-muted small mt-3 mb-2"><i class="bi bi-${icon} me-1"></i>${title}</h6>${content}`
        : '';

    body.innerHTML =
        (s.memberMissing
            ? `<div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>
                 Medlemsposten kunde inte hittas — anmälan finns kvar men medlemmen kan vara borttagen.</div>`
            : '')
        + section('Kontakt', 'telephone', contact)
        + section('Målsman & närmast anhörig', 'people', nextOfKin)
        + section('Anmälan', 'card-checklist', entry)
        + section('Betalning', 'wallet2', pay);

    body.classList.remove('d-none');

    // Hand off to the editor without making the operator find the row again.
    editBtn.classList.remove('d-none');
    editBtn.onclick = () => {
        bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        editCompetitionRegistration(registrationId);
    };
}

// Edit a team from the desk = rename it. The full roster editor lives on the public
// competition page; here the common need is correcting the name. We post the current
// roster back unchanged (UpdateTeam replaces all members) so only the name changes.
// Open the team editor: name + roster. Roster candidates are the team's club's members who
// are registered for this competition, unioned with whoever is already on the team (so a
// member who was named on a deferred roster but has no individual registration still shows).
async function editTeam(teamId) {
    const team = competitionTeams.find(t => t.id === teamId);
    if (!team) { alert('Laget hittades inte.'); return; }

    document.getElementById('editTeamId').value = team.id;
    document.getElementById('editTeamName').value = team.teamName || '';
    document.getElementById('editTeamClass').value = team.teamClass || '';
    const errBox = document.getElementById('editTeamRosterError');
    errBox.classList.add('d-none');
    errBox.textContent = '';

    const listEl = document.getElementById('editTeamRosterList');
    listEl.innerHTML = '<div class="text-muted small">Hämtar medlemmar…</div>';
    new bootstrap.Modal(document.getElementById('competitionEditTeamModal')).show();

    const competitionId = parseInt($('.competition-registration-management').data('competition-id'), 10);
    const current = (team.members || []).filter(m => m.memberId > 0);
    const currentIds = new Set(current.map(m => m.memberId));
    const spare = current.find(m => m.isSpare);

    let candidates = [];
    try {
        const resp = await fetch(
            `/umbraco/surface/CompetitionTeam/GetRegisteredMembersForClub?competitionId=${competitionId}&clubId=${team.clubId}`);
        const data = await resp.json();
        if (data && data.success && Array.isArray(data.members)) candidates = data.members;
    } catch (err) {
        console.warn('Could not load club members for team roster:', err);
    }

    // Union in anyone already on the team who isn't in the registered list — never let opening
    // the editor be a way to silently drop an existing member.
    const seen = new Set(candidates.map(c => c.memberId));
    current.forEach(m => {
        if (!seen.has(m.memberId)) {
            candidates.push({ memberId: m.memberId, name: m.name, shootingClasses: '', notRegistered: true });
        }
    });
    candidates.sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'sv'));

    document.getElementById('editTeamRosterHint').textContent = candidates.length
        ? 'Bocka i vilka som ingår i laget. Markera eventuell reserv i högerkolumnen.'
        : 'Inga medlemmar från klubben är anmälda till tävlingen än.';

    if (candidates.length === 0) {
        listEl.innerHTML = '<div class="text-muted small">Inga medlemmar att välja.</div>';
        return;
    }

    listEl.innerHTML = `
        <div class="d-flex fw-bold small text-muted border-bottom pb-1 mb-1">
            <div class="flex-grow-1">Medlem</div><div style="width:70px" class="text-center">Reserv</div>
        </div>` +
        candidates.map(c => {
            const checked = currentIds.has(c.memberId) ? 'checked' : '';
            const isSpare = spare && spare.memberId === c.memberId ? 'checked' : '';
            const warn = c.notRegistered
                ? ' <span class="badge bg-warning text-dark" title="Medlemmen har ingen individuell anmälan till tävlingen">ej anmäld</span>'
                : '';
            const cls = c.shootingClasses
                ? ` <span class="text-muted small">${escapeHtmlSafe(c.shootingClasses)}</span>` : '';
            return `
            <div class="d-flex align-items-center py-1">
                <div class="form-check flex-grow-1 mb-0">
                    <input class="form-check-input team-member-cb" type="checkbox"
                           id="teamMem_${c.memberId}" value="${c.memberId}" ${checked}>
                    <label class="form-check-label" for="teamMem_${c.memberId}">
                        ${escapeHtmlSafe(c.name)}${cls}${warn}
                    </label>
                </div>
                <div style="width:70px" class="text-center">
                    <input class="form-check-input team-spare-radio" type="radio" name="editTeamSpare"
                           value="${c.memberId}" ${isSpare}>
                </div>
            </div>`;
        }).join('');

    // Unticking a member must also clear them as reserv — otherwise the save would send a
    // spareId that isn't in memberIds.
    listEl.addEventListener('change', (e) => {
        if (!e.target.classList.contains('team-member-cb') || e.target.checked) return;
        const radio = listEl.querySelector(`.team-spare-radio[value="${e.target.value}"]`);
        if (radio && radio.checked) radio.checked = false;
    });
}

async function saveTeamChanges() {
    const teamId = parseInt(document.getElementById('editTeamId').value, 10);
    const team = competitionTeams.find(t => t.id === teamId);
    const errBox = document.getElementById('editTeamRosterError');
    const showErr = (msg) => { errBox.textContent = msg; errBox.classList.remove('d-none'); };
    errBox.classList.add('d-none');

    const teamName = (document.getElementById('editTeamName').value || '').trim();
    if (!teamName) { showErr('Lagnamnet får inte vara tomt.'); return; }

    const memberIds = Array.from(document.querySelectorAll('#editTeamRosterList .team-member-cb:checked'))
        .map(cb => parseInt(cb.value, 10));
    const spareEl = document.querySelector('#editTeamRosterList .team-spare-radio:checked');
    let spareId = spareEl ? parseInt(spareEl.value, 10) : null;
    if (spareId != null && !memberIds.includes(spareId)) spareId = null;

    try {
        const resp = await fetch('/umbraco/surface/CompetitionTeam/UpdateTeam', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ teamId, teamName, memberIds, spareId })
        });
        const data = await resp.json();
        if (data && data.success) {
            bootstrap.Modal.getInstance(document.getElementById('competitionEditTeamModal')).hide();
            loadCompetitionTeams();
        } else {
            // Roster rules (min/max size, duplicate name) come back as messages — keep the modal
            // open so the operator can correct the selection instead of losing their edits.
            showErr((data && data.message) || 'Kunde inte uppdatera laget.');
        }
    } catch (err) {
        showErr('Ett fel uppstod: ' + err.message);
    }
}

function confirmDeleteTeam(teamId) {
    const team = competitionTeams.find(t => t.id === teamId);
    const label = team ? `"${team.teamName}" (${team.isRelay ? 'stafett' : 'lag'})` : 'laget';
    if (confirm(`Är du säker på att du vill ta bort ${label}? Åtgärden kan inte ångras.`)) {
        deleteTeamById(teamId);
    }
}

async function deleteTeamById(teamId) {
    try {
        const resp = await fetch('/umbraco/surface/CompetitionTeam/DeleteTeam', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ teamId: teamId })
        });
        const data = await resp.json();
        if (data && data.success) {
            loadCompetitionTeams();
        } else {
            alert((data && data.message) || 'Kunde inte ta bort laget.');
        }
    } catch (err) {
        alert('Ett fel uppstod: ' + err.message);
    }
}

// Open the shared "Hantera betalning" options modal for a team (same modal individuals use:
// Visa QR-kod / Registrera betalning / Skicka QR via e-post). The three actions branch on
// currentManageInvoiceReg.isTeam to hit the team-specific endpoints.
function showPaymentOptionsForTeam(teamId) {
    const team = competitionTeams.find(t => t.id === teamId);
    if (!team) { alert('Laget hittades inte'); return; }

    currentManageInvoiceReg = {
        isTeam: true,
        teamId: team.id,
        memberName: `${team.teamName} (${team.isRelay ? 'stafett' : 'lag'})`,
        memberClub: team.clubName || '',
        paymentStatus: team.paymentStatus,
        paymentAmount: Math.round(Number(team.amount) || 0),
        invoiceId: team.invoiceId || 0,
        invoiceNumber: team.invoiceNumber || ''
    };

    document.getElementById('manageInvoiceShooterName').textContent = currentManageInvoiceReg.memberName;
    document.getElementById('manageInvoiceClub').textContent = currentManageInvoiceReg.memberClub;
    document.getElementById('manageInvoiceAmount').textContent = currentManageInvoiceReg.paymentAmount;

    const statusEl = document.getElementById('manageInvoiceStatusBadge');
    statusEl.className = `badge ${getPaymentStatusBadgeClass(team.paymentStatus)}`;
    statusEl.textContent = getPaymentStatusText(team.paymentStatus);

    const refRow = document.getElementById('manageInvoiceRefRow');
    if (team.invoiceNumber) {
        document.getElementById('manageInvoiceRef').textContent = team.invoiceNumber;
        refRow.style.display = '';
    } else {
        refRow.style.display = 'none';
    }

    backToManageInvoiceActions();
    if (!manageInvoiceModalInstance) {
        manageInvoiceModalInstance = new bootstrap.Modal(document.getElementById('manageInvoiceModal'));
    }
    manageInvoiceModalInstance.show();
}

// Direct "Markera som betald" for a team (the green check button) — ensures the invoice then
// opens the mark-as-paid modal, skipping the options chooser.
async function markTeamAsPaid(teamId) {
    const team = competitionTeams.find(t => t.id === teamId);
    if (team) await openMarkAsPaidForTeam(team);
}

// Ensure a team has an invoice (covers legacy / "Betala senare" teams), then pre-fill and
// open the shared mark-as-paid modal (which posts by invoiceId to Payment/UpdatePaymentStatus).
async function openMarkAsPaidForTeam(team) {
    const cid = $('.competition-registration-management').data('competition-id');
    let invoiceId = team.invoiceId;
    let amount = Math.round(Number(team.amount) || 0);
    let invoiceNumber = team.invoiceNumber || '';

    if (!invoiceId) {
        try {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const resp = await fetch('/umbraco/surface/RegistrationAdmin/EnsureTeamInvoice', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ competitionId: parseInt(cid, 10), teamId: team.id })
            });
            const raw = await resp.text();
            const data = raw ? JSON.parse(raw) : null;
            if (!resp.ok || !data || !data.success || !data.invoiceId) {
                alert('Kunde inte skapa lagfaktura: ' + ((data && data.message) || 'okänt fel'));
                return;
            }
            invoiceId = data.invoiceId;
            amount = Math.round(Number(data.amount) || amount);
            invoiceNumber = data.invoiceNumber || invoiceNumber;
        } catch (err) {
            alert('Kunde inte skapa lagfaktura: ' + err.message);
            return;
        }
    }

    document.getElementById('markPaidInvoiceId').value = invoiceId;
    document.getElementById('markPaidRegistrationId').value = '';
    document.getElementById('markPaidInvoiceAmount').value = amount;
    document.getElementById('markPaidShooterName').textContent = `${team.teamName} (${team.isRelay ? 'stafett' : 'lag'})`;
    document.getElementById('markPaidAmount').textContent = amount;
    document.getElementById('markPaidActualAmount').value = amount;
    document.getElementById('markPaidMethod').value = 'Swish';
    document.getElementById('markPaidTransactionId').value = invoiceNumber;
    document.getElementById('markPaidNotes').value = '';
    // Teams have no single member email, so the receipt/confirmation is a no-op — leave it off.
    const receiptBox = document.getElementById('markPaidSendReceipt');
    if (receiptBox) receiptBox.checked = false;
    updateMarkPaidVariance();

    const modalEl = document.getElementById('markAsPaidModal');
    if (!markPaidModalInstance) markPaidModalInstance = new bootstrap.Modal(modalEl);
    if (!markPaidDatePicker) {
        markPaidDatePicker = flatpickr('#markPaidDate', { locale: 'sv', dateFormat: 'Y-m-d', defaultDate: 'today', maxDate: 'today' });
    } else {
        markPaidDatePicker.setDate(new Date(), true);
    }
    markPaidModalInstance.show();
}

// ──────────────────────────────────────────────────────────────────────
// Late lag / stafett registration (efteranmälan av lag)
//
// The public competition page disables "Anmäl lag" / "Anmäl stafettlag" the moment sista
// anmälningsdag passes, but a club turning up on the competition day wanting to enter one
// more lag or stafettlag is routine — at an SM it is expected. The desk therefore gets its
// own create-team path with no deadline gate, exactly like the individual walk-in above.
//
// One modal serves both kinds. lateTeamIsRelay decides three things:
//   class list   — data.teamClasses            vs data.stafettTeamClasses
//   member list  — GetEligibleMembers          vs GetClubMembersForRelay
//                  (lag members must already be registered in a compatible class;
//                   relay members need no individual registration at all)
//   endpoint     — CompetitionTeam/CreateTeam  vs CompetitionTeam/CreateStafettTeam
//
// On success we hand off to showPaymentOptionsForTeam() — the same chooser the Lag card's
// rows use — so Visa QR-kod, Registrera betalning and Skicka QR via e-post all work on a
// late team just as they do on a late individual registration. The team's Pending invoice
// is created eagerly server-side (CreateTeamAsync → EnsureTeamInvoiceCoreAsync), so the
// amount is already correct by the time the chooser opens; no QR pre-flight needed here.
// ──────────────────────────────────────────────────────────────────────
const lateTeamAllClubs = @Html.Raw(lateTeamClubsJson);
const lateTeamAllRegions = @Html.Raw(lateTeamRegionsJson);

let lateTeamModalInstance = null;
let lateTeamIsRelay = false;
let lateTeamClassList = [];          // the active class list for the current mode
let lateTeamIsSpringskytte = false;  // Springskytte may create a team with no/partial roster
let lateTeamMembers = [];
let lateTeamSelected = new Set();
let lateTeamSpare = null;
let lateTeamBound = false;

function openLateTeamModal(isRelay) {
    lateTeamIsRelay = !!isRelay;
    lateTeamClassList = [];
    lateTeamMembers = [];
    lateTeamSelected.clear();
    lateTeamSpare = null;

    document.getElementById('lateTeamModalTitle').textContent = lateTeamIsRelay ? 'Anmäl stafettlag' : 'Anmäl lag';
    document.getElementById('lateTeamModalIntro').textContent = lateTeamIsRelay
        ? 'Anmäl ett stafettlag som inte hunnit anmäla sig i tid. Efter anmälan öppnas betalningshanteringen direkt.'
        : 'Anmäl ett lag som inte hunnit anmäla sig i tid. Efter anmälan öppnas betalningshanteringen direkt.';
    document.getElementById('lateTeamClassLabel').textContent = lateTeamIsRelay ? 'Stafettklass' : 'Lagklass';
    document.getElementById('lateTeamMembersLabel').textContent = lateTeamIsRelay
        ? 'Deltagare från vald förening'
        : 'Anmälda skyttar från vald förening';
    document.getElementById('lateTeamSubmitBtn').innerHTML = lateTeamIsRelay
        ? '<i class="bi bi-arrow-right me-1"></i>Skapa stafettlag och fortsätt'
        : '<i class="bi bi-arrow-right me-1"></i>Skapa lag och fortsätt';

    // Relay teams have no reserv and no per-shooter registration class, so those two
    // columns are meaningless there.
    document.getElementById('lateTeamMembersClassHeader').style.display = lateTeamIsRelay ? 'none' : '';
    document.getElementById('lateTeamMembersSpareHeader').style.display = lateTeamIsRelay ? 'none' : '';

    document.getElementById('lateTeamName').value = '';
    document.getElementById('lateTeamClassInfo').textContent = '';
    document.getElementById('lateTeamMembersArea').style.display = 'none';
    document.getElementById('lateTeamMembersTableBody').innerHTML = '';
    document.getElementById('lateTeamMemberCountInfo').textContent = '';
    document.getElementById('lateTeamOptionalHint').classList.add('d-none');
    hideLateTeamError();

    populateLateTeamRegions();
    populateLateTeamClubs('');
    loadLateTeamClasses();

    if (!lateTeamBound) {
        document.getElementById('lateTeamRegionSelect').addEventListener('change', function () {
            populateLateTeamClubs(this.value);
            onLateTeamSelectionChanged();
        });
        document.getElementById('lateTeamClubSelect').addEventListener('change', onLateTeamSelectionChanged);
        document.getElementById('lateTeamClassSelect').addEventListener('change', onLateTeamClassChanged);
        lateTeamBound = true;
    }

    if (!lateTeamModalInstance) {
        lateTeamModalInstance = new bootstrap.Modal(document.getElementById('lateTeamRegistrationModal'));
    }
    lateTeamModalInstance.show();
}

function showLateTeamError(msg) {
    const el = document.getElementById('lateTeamError');
    el.textContent = msg;
    el.classList.remove('d-none');
}

function hideLateTeamError() {
    document.getElementById('lateTeamError').classList.add('d-none');
}

function populateLateTeamRegions() {
    const sel = document.getElementById('lateTeamRegionSelect');
    sel.innerHTML = '<option value="">Alla kretsar</option>';
    (lateTeamAllRegions || []).forEach(r => {
        const opt = document.createElement('option');
        opt.value = r.code;
        opt.textContent = r.name;
        sel.appendChild(opt);
    });
    sel.value = '';
}

function populateLateTeamClubs(regionFilter) {
    const sel = document.getElementById('lateTeamClubSelect');
    sel.innerHTML = '<option value="">Välj förening...</option>';
    let clubs = lateTeamAllClubs || [];
    if (regionFilter) clubs = clubs.filter(c => c.region === regionFilter);
    clubs.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        sel.appendChild(opt);
    });
    sel.value = '';
}

async function loadLateTeamClasses() {
    const select = document.getElementById('lateTeamClassSelect');
    select.innerHTML = '<option value="">Laddar klasser...</option>';
    const cid = $('.competition-registration-management').data('competition-id');
    try {
        const resp = await fetch(`/umbraco/surface/CompetitionTeam/GetTeamsForCompetition?competitionId=${cid}`);
        const data = await resp.json();
        if (!data.success) { select.innerHTML = '<option value="">Kunde inte hämta klasser</option>'; return; }
        lateTeamIsSpringskytte = !!data.isSpringskytte;
        lateTeamClassList = (lateTeamIsRelay ? data.stafettTeamClasses : data.teamClasses) || [];

        select.innerHTML = '<option value="">Välj klass...</option>';
        lateTeamClassList.forEach(tc => {
            const opt = document.createElement('option');
            opt.value = tc.teamClass;
            opt.textContent = lateTeamIsRelay
                ? `${tc.teamClass} (${tc.coreMembers} deltagare, ${tc.description})`
                : `${tc.teamClass} (${tc.coreMembers} skyttar + reserv)`;
            select.appendChild(opt);
        });

        // Springskytte lets a lag/stafett be created and paid for with the roster named later.
        document.getElementById('lateTeamOptionalHint').classList.toggle('d-none', !lateTeamIsSpringskytte);
    } catch (e) {
        select.innerHTML = '<option value="">Kunde inte hämta klasser</option>';
    }
}

function lateTeamSelectedClass() {
    const tc = document.getElementById('lateTeamClassSelect').value;
    return tc ? lateTeamClassList.find(c => c.teamClass === tc) : null;
}

function onLateTeamClassChanged() {
    hideLateTeamError();
    const tc = lateTeamSelectedClass();
    const info = document.getElementById('lateTeamClassInfo');
    if (!tc) {
        info.textContent = '';
    } else if (lateTeamIsRelay) {
        info.textContent = `${tc.coreMembers} deltagare. ${tc.description || ''}`.trim();
    } else {
        info.textContent = `${tc.coreMembers} ordinarie skyttar, max ${tc.maxSpares} reserv.`;
    }
    onLateTeamSelectionChanged();
}

async function onLateTeamSelectionChanged() {
    hideLateTeamError();
    lateTeamSelected.clear();
    lateTeamSpare = null;

    const clubId = parseInt(document.getElementById('lateTeamClubSelect').value, 10);
    const area = document.getElementById('lateTeamMembersArea');
    const tbody = document.getElementById('lateTeamMembersTableBody');
    const teamClass = document.getElementById('lateTeamClassSelect').value;

    // Lag needs a class before we can ask which shooters are eligible for it; stafett only
    // needs the club (every club member may run a relay leg).
    if (!clubId || (!lateTeamIsRelay && !teamClass)) {
        area.style.display = 'none';
        lateTeamMembers = [];
        updateLateTeamMemberCount();
        return;
    }

    area.style.display = 'block';
    const colSpan = lateTeamIsRelay ? 2 : 4;
    tbody.innerHTML = `<tr><td colspan="${colSpan}" class="text-center py-2"><span class="spinner-border spinner-border-sm"></span></td></tr>`;

    const cid = $('.competition-registration-management').data('competition-id');
    const url = lateTeamIsRelay
        ? `/umbraco/surface/CompetitionTeam/GetClubMembersForRelay?competitionId=${cid}&clubId=${clubId}`
        : `/umbraco/surface/CompetitionTeam/GetEligibleMembers?competitionId=${cid}&teamClass=${encodeURIComponent(teamClass)}&clubId=${clubId}`;

    try {
        const resp = await fetch(url);
        const data = await resp.json();
        lateTeamMembers = (data.success && data.members) ? data.members : [];
        if (!data.success && data.message) showLateTeamError(data.message);
    } catch (e) {
        lateTeamMembers = [];
        showLateTeamError('Kunde inte hämta medlemmar: ' + e.message);
    }
    renderLateTeamMembers();
}

// Damklasser in stafett are dam-only. Unknown gender passes — the same lenient rule the
// server applies, so a member without gender on file is never silently locked out.
function lateTeamMemberAllowed(m) {
    if (!lateTeamIsRelay) return true;
    const tc = lateTeamSelectedClass();
    const restriction = tc && tc.genderRestriction ? tc.genderRestriction : null;
    if (!restriction) return true;
    const g = (m.gender || '').trim();
    return g === '' || g === restriction;
}

function renderLateTeamMembers() {
    const tbody = document.getElementById('lateTeamMembersTableBody');
    const colSpan = lateTeamIsRelay ? 2 : 4;
    tbody.innerHTML = '';

    if (!lateTeamMembers.length) {
        tbody.innerHTML = `<tr><td colspan="${colSpan}" class="text-muted small py-2">`
            + (lateTeamIsRelay
                ? 'Inga medlemmar hittades för denna förening.'
                : 'Inga anmälda skyttar i en kompatibel klass för denna förening.')
            + '</td></tr>';
        updateLateTeamMemberCount();
        return;
    }

    lateTeamMembers.forEach(m => {
        const row = document.createElement('tr');
        const eligible = lateTeamMemberAllowed(m);

        const tdCheck = document.createElement('td');
        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'form-check-input';
        cb.checked = lateTeamSelected.has(m.memberId);
        cb.disabled = !eligible;
        cb.addEventListener('change', function () {
            if (this.checked) {
                lateTeamSelected.add(m.memberId);
            } else {
                lateTeamSelected.delete(m.memberId);
                if (lateTeamSpare === m.memberId) lateTeamSpare = null;
            }
            // Update in place rather than re-rendering: with a big club roster a full redraw
            // on every tick throws away the operator's scroll position mid-selection.
            syncLateTeamSpareBoxes();
            updateLateTeamMemberCount();
        });
        tdCheck.appendChild(cb);
        row.appendChild(tdCheck);

        const tdName = document.createElement('td');
        tdName.textContent = m.name;
        if (!eligible) {
            row.classList.add('text-muted');
            tdName.title = 'Klassen är endast för damer';
        }
        row.appendChild(tdName);

        if (!lateTeamIsRelay) {
            const tdClass = document.createElement('td');
            tdClass.className = 'small text-muted';
            tdClass.textContent = m.shootingClass || '';
            row.appendChild(tdClass);

            const tdSpare = document.createElement('td');
            tdSpare.className = 'text-center';
            const spareCb = document.createElement('input');
            spareCb.type = 'checkbox';
            spareCb.className = 'form-check-input';
            spareCb.checked = lateTeamSpare === m.memberId;
            spareCb.disabled = !lateTeamSelected.has(m.memberId);
            spareCb.dataset.lateTeamSpareFor = m.memberId;
            spareCb.addEventListener('change', function () {
                // At most one reserv — ticking a new one releases the previous.
                lateTeamSpare = this.checked ? m.memberId : null;
                syncLateTeamSpareBoxes();
                updateLateTeamMemberCount();
            });
            tdSpare.appendChild(spareCb);
            row.appendChild(tdSpare);
        }

        tbody.appendChild(row);
    });

    updateLateTeamMemberCount();
}

// The Reserv column only makes sense for a shooter who is actually on the team, and only one
// reserv is allowed — both are kept true in place so ticking never redraws the table.
function syncLateTeamSpareBoxes() {
    document.querySelectorAll('#lateTeamMembersTableBody [data-late-team-spare-for]').forEach(box => {
        const id = parseInt(box.dataset.lateTeamSpareFor, 10);
        box.disabled = !lateTeamSelected.has(id);
        box.checked = lateTeamSpare === id;
    });
}

function updateLateTeamMemberCount() {
    const el = document.getElementById('lateTeamMemberCountInfo');
    const tc = lateTeamSelectedClass();
    if (!tc) { el.textContent = ''; return; }
    const core = lateTeamSelected.size - (lateTeamSpare != null && lateTeamSelected.has(lateTeamSpare) ? 1 : 0);
    const suffix = lateTeamIsSpringskytte ? ' (kan fyllas i senare)' : '';
    el.textContent = `Valda: ${core} av ${tc.coreMembers} ordinarie`
        + (lateTeamIsRelay ? '' : `, ${lateTeamSpare != null ? 1 : 0} av ${tc.maxSpares} reserv`)
        + suffix;
}

// Advisory only, same as the public modals: a shooter may legitimately be in more than one
// team, so we surface the clash and let the operator continue.
async function lateTeamConfirmConflicts(teamClass, memberIds) {
    if (!memberIds.length) return true;
    const cid = $('.competition-registration-management').data('competition-id');
    let conflicts = [];
    try {
        const resp = await fetch('/umbraco/surface/CompetitionTeam/CheckTeamMembership', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ competitionId: parseInt(cid, 10), teamClass, memberIds, excludeTeamId: null })
        });
        const d = await resp.json();
        conflicts = (d && d.conflicts) ? d.conflicts : [];
    } catch (e) {
        return true;   // never let the advisory check block a registration
    }
    if (!conflicts.length) return true;
    const lines = conflicts
        .map(c => `• ${c.memberName} är redan med i ${c.teamName} (${c.teamClass})${c.isSpare ? ' — som reserv' : ''}`)
        .join('\n');
    return window.confirm(`Redan med i ett lag:\n\n${lines}\n\nDet är tillåtet att vara med i flera lag. Vill du fortsätta ändå?`);
}

async function submitLateTeamRegistration() {
    hideLateTeamError();

    const cid = parseInt($('.competition-registration-management').data('competition-id'), 10);
    const clubId = parseInt(document.getElementById('lateTeamClubSelect').value, 10);
    const teamName = document.getElementById('lateTeamName').value.trim();
    const teamClass = document.getElementById('lateTeamClassSelect').value;
    const tc = lateTeamSelectedClass();

    if (!clubId) { showLateTeamError('Välj en förening för laget.'); return; }
    if (!teamName) { showLateTeamError('Ange ett lagnamn.'); return; }
    if (!teamClass || !tc) { showLateTeamError('Välj en klass.'); return; }

    const memberIds = Array.from(lateTeamSelected);
    const spareId = (!lateTeamIsRelay && lateTeamSpare != null && lateTeamSelected.has(lateTeamSpare))
        ? lateTeamSpare : null;
    const coreCount = memberIds.length - (spareId != null ? 1 : 0);

    // Mirror CreateTeamAsync's roster rules so the mistake is caught before the round trip.
    if (lateTeamIsSpringskytte) {
        if (coreCount > tc.coreMembers) {
            showLateTeamError(`Max ${tc.coreMembers} ordinarie deltagare (${coreCount} valda).`);
            return;
        }
    } else if (coreCount !== tc.coreMembers) {
        showLateTeamError(`Välj exakt ${tc.coreMembers} ordinarie deltagare (${coreCount} valda).`);
        return;
    }

    if (!await lateTeamConfirmConflicts(teamClass, memberIds)) return;

    const btn = document.getElementById('lateTeamSubmitBtn');
    const btnHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skapar...';

    try {
        const token = $('input[name="__RequestVerificationToken"]').val();
        const endpoint = lateTeamIsRelay
            ? '/umbraco/surface/CompetitionTeam/CreateStafettTeam'
            : '/umbraco/surface/CompetitionTeam/CreateTeam';
        const body = { competitionId: cid, teamName, teamClass, clubId, memberIds };
        if (spareId != null) body.spareId = spareId;

        const resp = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify(body)
        });
        const raw = await resp.text();
        const data = raw ? JSON.parse(raw) : null;

        if (!data || !data.success) {
            showLateTeamError((data && data.message) || 'Kunde inte skapa laget.');
            return;
        }

        const newTeamId = data.teamId;
        lateTeamModalInstance?.hide();

        // Refresh the Lag card, then open the payment chooser for the new team as soon as its
        // row exists — the same handoff the individual walk-in makes.
        loadCompetitionTeams();
        const wait = setInterval(() => {
            const team = competitionTeams.find(t => t.id === newTeamId);
            if (team) {
                clearInterval(wait);
                if ((team.paymentStatus || '') !== 'No Fee') showPaymentOptionsForTeam(newTeamId);
            }
        }, 200);
        setTimeout(() => clearInterval(wait), 5000);
    } catch (err) {
        showLateTeamError('Ett fel uppstod: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = btnHtml;
    }
}

// ── Payment-reference lookup ──────────────────────────────────────────────
// While a samlingsfaktura reference is resolved these hold what it settles; null otherwise.
// Registrations and teams are tracked separately because a samlingsfaktura may cover either or
// both — one on the SM seed covers seven LAG and zero individual registrations.
let consolidatedRefRegistrationIds = null;   // Set<registrationId> | null
let consolidatedRefTeamIds = null;           // Set<teamId> | null
let consolidatedRefTerm = '';                // the search term this resolution belongs to
let paymentRefLookupTimer = null;
let paymentRefLastTerm = '';

function filterCompetitionRegistrations() {
    const selectedClasses = getSelectedCompetitionClasses();
    const clubFilter = document.getElementById('competitionClubFilter').value;
    const preferenceFilter = document.getElementById('competitionPreferenceFilter').value;
    const paymentFilter = document.getElementById('competitionPaymentFilter')?.value || '';
    const checkedInFilter = document.getElementById('competitionCheckedInFilter')?.value || '';
    const searchTerm = (document.getElementById('competitionRegistrationSearch')?.value || '').trim().toLowerCase();

    filteredCompetitionRegistrations = competitionRegistrations.filter(reg => {
        // Multi-select: match when no class is selected, or any of the registration's
        // classes is among the selected ones.
        const matchesClass = selectedClasses.length === 0
            || (reg.shootingClasses && reg.shootingClasses.some(sc => selectedClasses.includes(sc.class)));
        const matchesClub = !clubFilter || reg.memberClub === clubFilter;
        // Check if any class has the matching start preference
        const matchesPreference = !preferenceFilter || (reg.shootingClasses && reg.shootingClasses.some(sc => sc.startPreference === preferenceFilter));
        const matchesPayment = !paymentFilter || (reg.paymentStatus || 'No Invoice') === paymentFilter;
        const matchesCheckedIn = !checkedInFilter
            || (checkedInFilter === 'in' && reg.isCheckedIn === true)
            || (checkedInFilter === 'out' && !reg.isCheckedIn);

        // A resolved samlingsfaktura reference wins over text matching: the club's payment covers a
        // specific set of registrations, and those are exactly the rows the cashier needs to see.
        // The parent's own number appears on NO row (rows carry their own child invoice numbers),
        // so text search can never find it — see resolvePaymentReference below.
        if (consolidatedRefRegistrationIds) {
            return consolidatedRefRegistrationIds.has(reg.id);
        }

        // Free-text search against name, club, and Swish reference (invoice number).
        // Substring match so partial pastes from a Swish notification still hit.
        let matchesSearch = true;
        if (searchTerm) {
            const haystack = [
                reg.memberName || '',
                reg.memberClub || '',
                reg.invoiceNumber || ''
            ].join(' ').toLowerCase();
            matchesSearch = haystack.includes(searchTerm);
        }

        return matchesClass && matchesClub && matchesPreference && matchesPayment && matchesCheckedIn && matchesSearch;
    });

    // Header badge reflects the filtered view, not the full total.
    const ic = document.getElementById('individualsCount');
    if (ic) ic.textContent = filteredCompetitionRegistrations.length;

    applyCompetitionSort();
    currentCompetitionPage = 1;
    displayCompetitionRegistrations();

    // The Lag card used to ignore every filter: searching for a shooter narrowed the
    // individuals to one row while all 55 teams stayed on screen. Re-render it here so
    // Sök / Klubb / Betalstatus reach both lists from the one set of inputs.
    renderCompetitionTeams();

    maybeResolvePaymentReference(searchTerm);
}

// A search that finds nothing is the signal to ask the server what the term means. Only then —
// so ordinary name searches never cost a request, and the lookup can't fire on every keystroke
// of someone typing a shooter's name.
function maybeResolvePaymentReference(searchTerm) {
    const term = (searchTerm || '').trim();

    // A resolution belongs to the term it was made for. Without this the banner and the row filter
    // stick on the first reference for the rest of the session: typing a second reference kept
    // showing the first one's club, total and rows.
    if (consolidatedRefRegistrationIds && term !== consolidatedRefTerm) {
        consolidatedRefRegistrationIds = null;
        consolidatedRefTeamIds = null;
        consolidatedRefTerm = '';
        hidePaymentRefBanner();
        filterCompetitionRegistrations();   // re-run now that the reference filter is gone
        return;
    }

    if (!term) {
        if (consolidatedRefRegistrationIds) { clearPaymentReference(false); }
        hidePaymentRefBanner();
        paymentRefLastTerm = '';
        return;
    }
    if (consolidatedRefRegistrationIds) return;          // current term already resolved
    if (filteredCompetitionRegistrations.length > 0) { hidePaymentRefBanner(); paymentRefLastTerm = term; return; }
    if (term === paymentRefLastTerm) return;             // already asked about this exact term
    if (term.length < 4 || !term.includes('-')) { hidePaymentRefBanner(); return; }

    clearTimeout(paymentRefLookupTimer);
    paymentRefLookupTimer = setTimeout(() => resolvePaymentReference(term), 350);
}

async function resolvePaymentReference(term) {
    paymentRefLastTerm = term;
    try {
        const competitionId = $('.competition-registration-management').data('competition-id');
        const resp = await fetch(
            `/umbraco/surface/RegistrationAdmin/LookupPaymentReference?competitionId=${competitionId}&reference=${encodeURIComponent(term)}`,
            { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await resp.json();
        if (!data || !data.success) return;

        // The user may have kept typing while this was in flight.
        const current = (document.getElementById('competitionRegistrationSearch')?.value || '').trim();
        if (current !== term) return;

        if (data.kind === 'consolidated') {
            // Only keep ids that correspond to rows we can actually show, so the banner's counts
            // and the tables agree. A covered invoice with no row here (already-deleted
            // registration, or an unexpected shape) is reported rather than quietly dropped.
            const knownRegIds = new Set(competitionRegistrations.map(r => r.id));
            const matchedRegs = (data.registrationIds || []).filter(id => knownRegIds.has(id));
            const knownTeamIds = new Set((competitionTeams || []).map(t => t.id));
            const matchedTeams = (data.teamIds || []).filter(id => knownTeamIds.has(id));

            // Both tables are filtered to exactly what the payment settles, even when one side is
            // empty. Leaving the individuals table showing all 61 shooters while the payment covers
            // 7 lag would bury the answer in noise; an empty table plus a banner that says where the
            // rows actually are is clearer. The banner always names both counts.
            consolidatedRefTerm = term;
            consolidatedRefTeamIds = new Set(matchedTeams);
            consolidatedRefRegistrationIds = new Set(matchedRegs);

            showConsolidatedRefBanner(data, matchedRegs.length, matchedTeams.length);
            filterCompetitionRegistrations();
            if (matchedTeams.length > 0) renderCompetitionTeams();
        } else if (data.kind === 'othercompetition') {
            showPaymentRefBanner('warning', 'bi-signpost-split',
                `<strong>Referensen hör till en annan tävling.</strong> ${escapeHtmlSafe(data.message || '')}` +
                (data.otherCompetitionId
                    ? ` <a href="/competitionmanagement?competitionId=${data.otherCompetitionId}" class="alert-link">Öppna den tävlingen</a>.`
                    : ''));
        } else if (data.kind === 'trashed') {
            // The club paid against a reference whose invoice has since been deleted. Say so, and
            // offer the undo — otherwise the cashier has no way to reconcile the payment at all.
            const amount = Number(data.totalAmount || 0).toLocaleString('sv-SE', { maximumFractionDigits: 2 });
            const what = data.isConsolidated ? 'Samlingsfakturan' : 'Fakturan';
            showPaymentRefBanner('warning', 'bi-trash',
                `<div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <strong>${what} ${escapeHtmlSafe(data.reference || '')} har raderats.</strong><br>
                        <span class="small">${escapeHtmlSafe(data.payerName || '')} · ${amount} kr — ligger i papperskorgen.</span><br>
                        <span class="small text-body-secondary">Återställ den för att kunna registrera betalningen.</span>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-warning btn-sm" onclick="restoreDeletedInvoice(${data.invoiceId}, '${escapeHtmlSafe(data.reference || '')}')">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Återställ fakturan
                        </button>
                    </div>
                 </div>`);
        } else if (data.kind === 'individual' && data.registrationId) {
            // Rare: the invoice exists but its registration is filtered out by another control.
            showPaymentRefBanner('info', 'bi-info-circle',
                `<strong>${escapeHtmlSafe(data.memberName || 'Anmälan')}</strong> har den referensen, men raden döljs av ett annat filter. Rensa filtren för att se den.`);
        } else {
            showPaymentRefBanner('secondary', 'bi-question-circle',
                `Hittade ingen faktura med referensen <code>${escapeHtmlSafe(term)}</code> i den här tävlingen.`);
        }
    } catch (e) { /* leave the table as-is; the plain search result still stands */ }
}

function showConsolidatedRefBanner(d, matchedRegs, matchedTeams) {
    const paid = (d.paymentStatus || '').toLowerCase() === 'paid';
    const statusBadge = paid
        ? '<span class="badge bg-success">Betald</span>'
        : '<span class="badge bg-warning text-dark">Väntande</span>';
    const amount = Number(d.totalAmount || 0).toLocaleString('sv-SE', { maximumFractionDigits: 2 });
    const payBtn = paid ? '' :
        `<button type="button" class="btn btn-success btn-sm" onclick="markConsolidatedRefPaid(${d.invoiceId})">
            <i class="bi bi-check-circle me-1"></i>Markera samlingsfakturan som betald
         </button>`;

    // Describe what the payment ACTUALLY covers. Claiming "N anmälningar" over a table showing
    // none was the first version's bug: a real samlingsfaktura here covers 7 lag and 0 shooters.
    const parts = [];
    if (matchedRegs > 0) parts.push(`${matchedRegs} ${matchedRegs === 1 ? 'anmälan' : 'anmälningar'}`);
    if (matchedTeams > 0) parts.push(`${matchedTeams} ${matchedTeams === 1 ? 'lag' : 'lag'}`);
    const covers = parts.length ? parts.join(' och ') : 'inga poster som visas här';

    let where = '';
    if (matchedRegs > 0 && matchedTeams > 0) where = 'Tabellen nedan och <strong>Lag</strong>-kortet är filtrerade till dem.';
    else if (matchedRegs > 0) where = 'Tabellen nedan är filtrerad till dem.';
    else if (matchedTeams > 0) where = 'De ligger i <strong>Lag</strong>-kortet längre ned. Inga individuella anmälningar ingår, så tabellen nedan är tom.';

    const unaccounted = (d.coveredCount || 0) - matchedRegs - matchedTeams;
    const gapNote = unaccounted > 0
        ? `<br><span class="small text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>${unaccounted} av posterna kunde inte kopplas till en rad här. Öppna fakturan i klubbens eller kretsens Fakturor-flik för hela listan.</span>`
        : '';

    showPaymentRefBanner('primary', 'bi-collection',
        `<div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div>
                <strong>Samlingsfaktura ${escapeHtmlSafe(d.reference || '')}</strong> ${statusBadge}<br>
                <span class="small">${escapeHtmlSafe(d.payerName || '')} · ${amount} kr · täcker ${covers}</span><br>
                <span class="small text-body-secondary">${where}</span>${gapNote}
            </div>
            <div class="d-flex gap-2 flex-wrap">${payBtn}
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearPaymentReference(true)">
                    <i class="bi bi-x-lg me-1"></i>Rensa
                </button>
            </div>
         </div>`);
}

// Non-blocking replacement for the post-save alert()s. A native alert freezes the whole tab
// until it is dismissed, and the desk hits this on every class change — which is what the
// 2026-08-05 shift reported as a ~40 s freeze it had to kill the tab out of. Scrolled into view
// so it can't be missed the way an off-screen banner would be.
function showDeskSaveNotice(notes, variant) {
    const el = document.getElementById('deskSaveNotice');
    const list = (Array.isArray(notes) ? notes : [notes]).filter(Boolean);
    if (!el || list.length === 0) return;
    el.className = `alert alert-${variant || 'info'} py-2 alert-dismissible fade show`;
    el.innerHTML = `<i class="bi bi-info-circle me-2"></i>`
        + (list.length === 1
            ? escapeHtmlSafe(list[0])
            : '<ul class="mb-0 ps-3">' + list.map(n => `<li>${escapeHtmlSafe(n)}</li>`).join('') + '</ul>')
        + '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Stäng"></button>';
    el.classList.remove('d-none');
    el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
}

function showPaymentRefBanner(variant, icon, html) {
    let el = document.getElementById('paymentRefBanner');
    if (!el) return;
    el.className = `alert alert-${variant} py-2`;
    el.innerHTML = `<i class="bi ${icon} me-2"></i>${html}`;
    el.classList.remove('d-none');
}

function hidePaymentRefBanner() {
    const el = document.getElementById('paymentRefBanner');
    if (el) el.classList.add('d-none');
}

function clearPaymentReference(alsoClearSearch) {
    consolidatedRefRegistrationIds = null;
    consolidatedRefTeamIds = null;
    consolidatedRefTerm = '';
    paymentRefLastTerm = '';
    hidePaymentRefBanner();
    if (alsoClearSearch) {
        const box = document.getElementById('competitionRegistrationSearch');
        if (box) box.value = '';
    }
    filterCompetitionRegistrations();
}

// Pull a deleted invoice back out of the recycle bin, so a payment that arrived against a
// since-deleted reference can be settled. After restoring we re-run the lookup, which then finds
// it under the hub and shows the normal samlingsfaktura banner with its Markera som betald action.
async function restoreDeletedInvoice(invoiceId, reference) {
    if (!confirm(`Återställ fakturan ${reference} från papperskorgen?`)) return;
    try {
        const competitionId = $('.competition-registration-management').data('competition-id');
        const resp = await fetch('/umbraco/surface/RegistrationAdmin/RestoreDeletedInvoice', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ competitionId: competitionId, invoiceId: invoiceId })
        });
        const data = await resp.json();
        if (!data.success) { alert(data.message || 'Kunde inte återställa fakturan.'); return; }

        paymentRefLastTerm = '';
        await loadCompetitionRegistrations();
        setTimeout(() => resolvePaymentReference(reference), 700);
    } catch (e) {
        alert('Kunde inte återställa fakturan. Kontrollera nätverket.');
    }
}

// Reuses the existing InvoiceAdmin/MarkAsPaid, which already cascades a parent to every child it
// covers (audit row + betalningsbekräftelse per shooter). No separate code path for the desk.
async function markConsolidatedRefPaid(invoiceId) {
    if (!confirm('Markera samlingsfakturan som betald? Alla anmälningar den täcker markeras också som betalda och skyttarna får en betalningsbekräftelse.')) return;
    try {
        const resp = await fetch('/umbraco/surface/InvoiceAdmin/MarkAsPaid', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            body: JSON.stringify({ invoiceId: invoiceId })
        });
        const data = await resp.json();
        if (data.success) {
            const term = (document.getElementById('competitionRegistrationSearch')?.value || '').trim();
            consolidatedRefRegistrationIds = null;
            paymentRefLastTerm = '';
            await loadCompetitionRegistrations();
            // Re-resolve so the banner comes back showing Betald over the same rows.
            if (term) setTimeout(() => resolvePaymentReference(term), 600);
        } else {
            alert(data.message || 'Kunde inte markera samlingsfakturan som betald.');
        }
    } catch (e) {
        alert('Kunde inte markera samlingsfakturan som betald. Kontrollera nätverket.');
    }
}

// Recompute and render the totals across the FULL registration list (not the filtered view).
// Filtering changes the table below, the summary above represents the whole competition.
const springskytteSummary = @(springskytteEnabled ? "true" : "false");

function updatePaymentSummary() {
    const cards = document.getElementById('paymentSummaryCards');
    if (!cards) return;

    const regs = competitionRegistrations || [];
    const teams = competitionTeams || [];
    if (regs.length === 0 && teams.length === 0) {
        cards.style.display = 'none';
        return;
    }

    const uniqueMembers = new Set(regs.map(r => r.memberId)).size;
    let paidCount = 0, paidAmount = 0;
    let pendingCount = 0, pendingAmount = 0;
    let noInvoiceCount = 0;
    // Counted as unique MEMBERS, not rows — the same shooter can hold two registration rows,
    // and the card is labelled "skyttar", so rows would over-count against the total.
    const checkedInMembers = new Set();
    // "Starter" = total class entries across all registrations. A shooter
    // registered for two classes contributes 2 starts, not 1.
    let totalStarts = 0;
    // …and per weapon class, which is what staffing a firing line actually needs.
    const startsByWeapon = {};

    regs.forEach(r => {
        if (r.isCheckedIn === true) checkedInMembers.add(r.memberId);
        (Array.isArray(r.shootingClasses) ? r.shootingClasses : []).forEach(sc => {
            const wc = weaponClassOf(sc.class);
            if (wc) startsByWeapon[wc] = (startsByWeapon[wc] || 0) + 1;
        });
        const status = r.paymentStatus || 'No Invoice';
        // Amounts come from aggregates so multi-invoice regs (paid + top-up pending) sum correctly.
        paidAmount += Number(r.paidAmount) || 0;
        // "Väntande" = what the ANMÄLAN still owes (fee − paid), not the sum of its Pending
        // invoice rows. The two disagree whenever a stale invoice lingers, and the row status
        // follows the debt — so counting rows here is what made the heading contradict the list
        // right underneath it. See outstandingAmount in CompetitionController.
        const owed = Number(r.outstandingAmount) || 0;
        pendingAmount += owed;
        // The count follows the same definition as the amount: anyone who still owes something.
        // Bucketing by invoice status instead let a row read "Betald" while its money sat in the
        // Väntande total — one registration counted in one card and paid for in the other.
        if (owed > 0) pendingCount++;
        if (status === 'Paid') paidCount++;
        if (status === 'No Invoice') noInvoiceCount++;
        totalStarts += Array.isArray(r.shootingClasses) ? r.shootingClasses.length : 0;
    });

    // Fold teams/stafett (Lag) into the money totals so the sums above the lists
    // reflect the whole competition, not just individuals. Teams carry a single
    // invoice (amount + status), not the multi-invoice aggregates individuals have.
    let relayCount = 0;
    teams.forEach(t => {
        if (t.isRelay) relayCount++;
        const status = t.paymentStatus || 'No Invoice';
        const amount = Number(t.amount) || 0;
        if (status === 'Paid') { paidCount++; paidAmount += amount; }
        else if (status === 'Pending') { pendingCount++; pendingAmount += amount; }
        else if (status === 'No Invoice') noInvoiceCount++;
    });

    document.getElementById('summaryRegCount').textContent = regs.length;
    document.getElementById('summaryUniqueMembers').textContent = uniqueMembers;
    document.getElementById('summaryTeamCount').textContent = teams.length;
    // Springskytte runs lag and stafett side by side with different fees and different start
    // lists, so one merged number hides which half is missing. Everywhere else there is only
    // one kind of team, so the split would be noise.
    const teamBreakdownEl = document.getElementById('summaryTeamBreakdown');
    if (teamBreakdownEl) {
        teamBreakdownEl.textContent = springskytteSummary
            ? `${teams.length - relayCount} lag · ${relayCount} stafett`
            : 'lag/stafett';
    }
    document.getElementById('summaryStartsCount').textContent = totalStarts;
    const byWeaponEl = document.getElementById('summaryStartsByWeapon');
    if (byWeaponEl) {
        // Ordered by count so the biggest group leads — that is the one that sets the schedule.
        const parts = Object.keys(startsByWeapon)
            .sort((a, b) => startsByWeapon[b] - startsByWeapon[a] || a.localeCompare(b, 'sv'))
            .map(wc => `${wc} ${startsByWeapon[wc]}`);
        byWeaponEl.textContent = parts.join(' · ');
        // The cell clips at one line, so keep the whole list reachable on hover.
        byWeaponEl.title = parts.length ? 'Starter per vapengrupp: ' + parts.join(', ') : '';
    }
    document.getElementById('summaryCheckedInCount').textContent = checkedInMembers.size;
    document.getElementById('summaryCheckedInTotal').textContent = uniqueMembers;
    const bar = document.getElementById('summaryCheckedInBar');
    if (bar) bar.style.width = uniqueMembers ? `${Math.round(100 * checkedInMembers.size / uniqueMembers)}%` : '0%';
    document.getElementById('summaryPaidCount').textContent = paidCount;
    document.getElementById('summaryPaidAmount').textContent = `${Math.round(paidAmount)} kr`;
    document.getElementById('summaryPendingCount').textContent = pendingCount;
    document.getElementById('summaryPendingAmount').textContent = `${Math.round(pendingAmount)} kr`;
    document.getElementById('summaryNoInvoiceCount').textContent = noInvoiceCount;
    // Only surface the exception row when there is actually something to repair.
    document.getElementById('missingInvoiceRow')?.classList.toggle('d-none', noInvoiceCount === 0);
    cards.style.display = '';
}

// Weapon class from a class id. First character for the standard ids (C1, A_Vet_Y, A_opt_1)
// and for Springskytte's composite ids ("A-D 21" → A) alike — the same rule the live result
// board uses. Returns '' for anything that doesn't start with a known weapon letter, so an
// unexpected id is dropped from the breakdown rather than inventing a group.
function weaponClassOf(classId) {
    const c = (classId || '').trim().charAt(0).toUpperCase();
    return 'ABCRLM'.includes(c) ? c : '';
}

// Mint the invoices for registrations that lost theirs. Idempotent — the endpoint skips anything
// already invoiced and reports what it did, so a partial repair is never silent.
async function fixMissingInvoices() {
    const btn = document.getElementById('fixMissingInvoicesBtn');
    if (!btn) return;
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skapar...';
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        // currentCompetitionId is scoped inside loadCompetitionRegistrations, so read the same source.
        const competitionId = $('.competition-registration-management').data('competition-id');
        const r = await fetch('/umbraco/surface/RegistrationAdmin/EnsureMissingInvoices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId })
        });
        const d = await r.json();
        alert(d.message || (d.success ? 'Klart.' : 'Kunde inte skapa fakturor.'));
        if (d.success) await loadCompetitionRegistrations();
    } catch (e) {
        alert('Nätverksfel när saknade fakturor skulle skapas.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = original;
    }
}

function populateCompetitionClubFilter() {
    const select = document.getElementById('competitionClubFilter');
    if (!select) return;
    // Teams are included: a club can have a lag in the competition without any individual
    // entry, and it would otherwise be unreachable from the Klubb filter.
    const clubs = Array.from(new Set([
        ...competitionRegistrations.map(r => r.memberClub),
        ...(competitionTeams || []).map(t => t.clubName)
    ].filter(Boolean))).sort((a, b) => a.localeCompare(b, 'sv'));
    const current = select.value;
    select.innerHTML = '<option value="">Alla klubbar</option>';
    clubs.forEach(club => {
        const opt = document.createElement('option');
        opt.value = club;
        opt.textContent = club;
        select.appendChild(opt);
    });
    if (clubs.includes(current)) {
        select.value = current;
    }
}

// Canonical ordering for the 39 standard shooting classes. Anything not in this
// list (e.g. Springskytte composite classes like "A-D 21") sorts after these,
// alphabetically/numerically.
const STANDARD_CLASS_ORDER = [
    "A1", "A2", "A3",
    "B1", "B2", "B3",
    "C1", "C2", "C3", "C_Vet_Y", "C_Vet_A", "C_Jun", "C1_Dam", "C2_Dam", "C3_Dam",
    "R1", "R2", "R3",
    "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9",
    "L1", "L2", "L3", "L_Vet_Y", "L_Vet_A", "L_Jun", "L1_Dam", "L2_Dam", "L3_Dam"
];

function compareShootingClassIds(a, b) {
    const ia = STANDARD_CLASS_ORDER.indexOf(a);
    const ib = STANDARD_CLASS_ORDER.indexOf(b);
    if (ia !== -1 && ib !== -1) return ia - ib;
    if (ia !== -1) return -1;
    if (ib !== -1) return 1;
    return a.localeCompare(b, 'sv', { numeric: true });
}

// The class ids currently ticked in the multi-select dropdown.
function getSelectedCompetitionClasses() {
    return Array.from(document.querySelectorAll('.competition-class-filter-cb:checked')).map(cb => cb.value);
}

// Keep the collapsed button label in sync with the current selection.
function updateCompetitionClassFilterLabel() {
    const label = document.getElementById('competitionClassFilterLabel');
    if (!label) return;
    const checked = document.querySelectorAll('.competition-class-filter-cb:checked');
    if (checked.length === 0) {
        label.textContent = 'Alla klasser';
    } else if (checked.length === 1) {
        const lbl = document.querySelector('label[for="' + checked[0].id + '"]');
        label.textContent = lbl ? lbl.textContent : checked[0].value;
    } else {
        label.textContent = checked.length + ' klasser valda';
    }
}

function onCompetitionClassFilterChange() {
    updateCompetitionClassFilterLabel();
    filterCompetitionRegistrations();
}

function clearCompetitionClassFilter() {
    document.querySelectorAll('.competition-class-filter-cb:checked').forEach(cb => cb.checked = false);
    onCompetitionClassFilterChange();
}

// Build the multi-select class filter from the classes actually present in the
// registrations. This keeps it discipline-agnostic — standard comps show the
// standard classes registered, Springskytte comps show their composite
// weapon-ageclasses (e.g. "A-D 21") — and guarantees every option matches the
// exact value the filter compares against (reg.shootingClasses[].class).
function populateShootingClassFilter() {
    const menu = document.getElementById('competitionClassFilterMenu');
    if (!menu) return;

    // Preserve the current selection across re-populations (e.g. after data load).
    const previouslySelected = getSelectedCompetitionClasses();

    // id -> display label. Display uses the same transform as the class badges in
    // the table so the filter and the rows read identically.
    const seen = new Map();
    (competitionRegistrations || []).forEach(reg => {
        (reg.shootingClasses || []).forEach(sc => {
            const id = sc.class || sc.className || '';
            if (!id || seen.has(id)) return;
            const normalized = normalizeShootingClass(id);
            const label = window.formatAgeSpan ? window.formatAgeSpan(normalized) : normalized;
            seen.set(id, label);
        });
    });

    if (seen.size === 0) {
        menu.innerHTML = '<div class="text-muted small px-2 py-1">Inga klasser</div>';
        updateCompetitionClassFilterLabel();
        return;
    }

    const ids = Array.from(seen.keys()).sort(compareShootingClassIds);

    let html = '<div class="d-flex justify-content-between align-items-center px-2 pb-1 mb-1 border-bottom">'
        + '<span class="small text-muted">Välj klasser</span>'
        + '<button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="clearCompetitionClassFilter()">Rensa</button>'
        + '</div>';
    ids.forEach((id, idx) => {
        const checked = previouslySelected.includes(id) ? 'checked' : '';
        // Index suffix guarantees a unique DOM id even if two class ids slugify the same.
        const cbId = 'ccf_' + idx + '_' + id.replace(/[^A-Za-z0-9_-]/g, '_');
        html += '<div class="form-check">'
            + '<input class="form-check-input competition-class-filter-cb" type="checkbox"'
            + ' value="' + escapeHtmlSafe(id) + '" id="' + cbId + '" ' + checked
            + ' onchange="onCompetitionClassFilterChange()">'
            + '<label class="form-check-label" for="' + cbId + '">' + escapeHtmlSafe(seen.get(id)) + '</label>'
            + '</div>';
    });
    menu.innerHTML = html;
    updateCompetitionClassFilterLabel();
}

function displayCompetitionRegistrations() {
    const tbody = document.getElementById('competitionRegistrationsTableBody');
    const startIndex = (currentCompetitionPage - 1) * competitionPageSize;
    const endIndex = startIndex + competitionPageSize;
    const pageRegistrations = filteredCompetitionRegistrations.slice(startIndex, endIndex);

    if (filteredCompetitionRegistrations.length === 0) {
        showCompetitionNoResults();
        return;
    }

    // Show the Deltävling column only when this competition actually has one.
    const showSubComp = !!competitionSubCompetitionName;
    const subCompHeader = document.getElementById('subCompColHeader');
    if (subCompHeader) {
        subCompHeader.style.display = showSubComp ? '' : 'none';
        subCompHeader.title = showSubComp ? competitionSubCompetitionName : '';
    }

    tbody.innerHTML = '';

    pageRegistrations.forEach(reg => {
        // Build class badges from shootingClasses array (small badges)
        let classBadges = '';

        if (reg.shootingClasses && Array.isArray(reg.shootingClasses) && reg.shootingClasses.length > 0) {
            classBadges = reg.shootingClasses.map(sc => {
                // sc should be an object with 'class', 'className', and 'startPreference' properties
                const classId = sc.class || sc.className || '';
                const normalizedClass = normalizeShootingClass(classId);
                const displayClass = window.formatAgeSpan ? window.formatAgeSpan(normalizedClass) : normalizedClass;
                const badge = `<span class="badge bg-primary me-1 mb-1" style="font-size: 0.85em;">${displayClass}</span>`;
                // A recorded wish rides ALONGSIDE its class badge rather than in a column of its
                // own: the wish is per class, and on a multi-class row a separate column could not
                // say which class it belonged to.
                const pref = normalizeStartPreference(sc.startPreference);
                if (pref === 'Inget') return badge;
                return badge + `<span class="badge ${getPreferenceBadgeClass(pref)} me-1 mb-1" style="font-size: 0.75em;"`
                    + ` title="Önskemål om starttid för ${escapeAttr(displayClass)}">`
                    + `<i class="bi bi-clock-history me-1"></i>${pref === 'Tidig Start' ? 'Tidig' : 'Sen'}</span>`;
            }).join('');
        }

        const row = document.createElement('tr');
        // Club name shortened for a narrow column; full name kept in the title for hover
        // and still used for search/filter (reg.memberClub is untouched).
        const fullClub = reg.memberClub || '';
        const shortClub = shortenClubName(fullClub);
        row.innerHTML = `
            <td>
                <strong>${reg.memberName}</strong>
            </td>
            <td style="font-size:0.85em; max-width:150px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtmlSafe(fullClub)}">${escapeHtmlSafe(shortClub)}</td>
            <td>
                ${classBadges}
            </td>
            <td style="display:${showSubComp ? '' : 'none'};">
                ${reg.isSubCompetition
                    ? `<span class="badge bg-success" title="Anmäld till ${escapeHtmlSafe(competitionSubCompetitionName)}"><i class="bi bi-check-lg"></i></span>`
                    : '<span class="text-muted">—</span>'}
            </td>
            <td>
                ${formatServerLocalDateTime(reg.registrationDate)}
            </td>
            <td>
                <span class="badge ${getPaymentStatusBadgeClass(reg.paymentStatus)}">
                    ${getPaymentStatusText(reg.paymentStatus)}
                </span>
                ${reg.hasVariance ? `
                    <span class="badge bg-warning text-dark ms-1" title="Faktiskt belopp avviker från fakturabeloppet">
                        <i class="bi bi-exclamation-triangle me-1"></i>Avvikande belopp
                    </span>
                ` : ''}
                ${(reg.paymentSentDate && reg.paymentStatus !== 'Paid') ? `
                    <span class="badge bg-info text-dark ms-1" title="Betalaren${reg.paymentSentBy ? ' (' + escapeHistory(reg.paymentSentBy) + ')' : ''} anger att betalning är gjord — bekräfta när den är mottagen">
                        <i class="bi bi-cash-coin me-1"></i>Betalning anmäld
                    </span>
                ` : ''}
            </td>
            <td>
                <!-- Item #9: at-the-desk attendance toggle. Saves on change; reflects state
                     on next render via the API field, but we also update the in-memory row
                     immediately so the operator gets instant feedback. -->
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="checkin_${reg.id}"
                           ${reg.isCheckedIn ? 'checked' : ''}
                           onchange="setCheckedIn(${reg.id}, this.checked)"
                           title="Markera som incheckad / närvarande">
                    <label class="form-check-label small text-muted" for="checkin_${reg.id}">
                        ${reg.isCheckedIn ? 'Här' : ''}
                    </label>
                </div>
            </td>
            <td class="text-center">
                <!-- Push reachability. Lit = the shooter has at least one browser subscribed, so a
                     notis will reach their phone. Dark = it will still be delivered as an in-app
                     message on the competition page, it just won't buzz. -->
                ${reg.hasPushSubscription
                    ? `<i class="bi bi-broadcast text-success fs-5" title="Kan nås med push-notis"></i>`
                    : `<i class="bi bi-broadcast text-muted fs-5" style="opacity:.3;" title="Ingen enhet registrerad för push — en notis syns bara i appen"></i>`}
            </td>
            <td class="desk-actions-col">
                <!-- One labelled "Åtgärder" menu per row rather than a variable-length icon
                     strip. The row had outgrown the strip (5 buttons, 2 of them conditional,
                     so the positions shifted per row) and delete sat one mis-tap away from
                     mark-as-paid. In the menu delete is last, below a divider, and named in
                     full — safer than the old pinned-right trash icon it replaces.
                     The popper-config strategy:fixed is required: .table-responsive is
                     overflow-x:auto (which makes the browser clip vertically too), so an
                     absolutely-positioned menu is cut off on the last rows of the table.
                     Note it is data-bs-popper-config, NOT data-bs-strategy — the latter is
                     not a Bootstrap option and is silently ignored. -->
                <div class="dropdown text-end">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            type="button" data-bs-toggle="dropdown"
                            data-bs-popper-config='{"strategy":"fixed"}'
                            aria-expanded="false" title="Åtgärder för ${escapeHtmlSafe(reg.memberName)}">
                        <i class="bi bi-sliders me-2"></i>Åtgärder
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <button class="dropdown-item" type="button" onclick="showShooterInfo(${reg.id})">
                                <i class="bi bi-person-vcard me-2 text-primary"></i>Visa skytt – kontakt &amp; status
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="editCompetitionRegistration(${reg.id})">
                                <i class="bi bi-pencil me-2 text-primary"></i>Redigera anmälan
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="openStartPreferenceModal(${reg.id})">
                                <i class="bi bi-clock-history me-2 text-primary"></i>Önskemål om starttid…
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item" type="button" onclick="openSendNoticeModal(${reg.id})">
                                <i class="bi bi-broadcast me-2 ${reg.hasPushSubscription ? 'text-success' : 'text-muted'}"></i>Skicka notis…
                            </button>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        ${reg.paymentStatus === 'Pending' ? `
                            <li>
                                <button class="dropdown-item fw-semibold" type="button" onclick="markAsPaid(${reg.id})">
                                    <i class="bi bi-check-circle me-2 text-success"></i>Markera som betald
                                </button>
                            </li>
                        ` : ''}
                        <li>
                            <button class="dropdown-item" type="button" onclick="showPaymentOptionsForRegistration(${reg.id})">
                                <i class="bi bi-wallet2 me-2 text-success"></i>Hantera betalning
                            </button>
                        </li>
                        ${renderHistoryMenuItem(reg.invoiceId, JSON.stringify(reg.memberName).replace(/"/g, '&quot;'), reg.lastReminderSentDate, reg.reminderCount)}
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item text-danger" type="button"
                                    onclick="confirmDeleteCompetitionRegistration(${reg.id})">
                                <i class="bi bi-trash me-2"></i>Ta bort anmälan
                            </button>
                        </li>
                    </ul>
                </div>
            </td>
        `;
        tbody.appendChild(row);
    });

    showCompetitionTable();
    updateCompetitionPagination();
}

