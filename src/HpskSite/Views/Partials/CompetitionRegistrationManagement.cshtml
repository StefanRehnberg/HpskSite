// Direct "Markera som betald" for a team (the green check button) — ensures the invoice then
// opens the mark-as-paid modal, skipping the options chooser.
async function markTeamAsPaid(teamId) {
    const team = competitionTeams.find(t => t.id === teamId);
    if (team) await openMarkAsPaidForTeam(team);
}

// Ensure a team has an invoice (covers legacy / "Betala senare" teams), then pre-fill and
// open the shared mark-as-paid modal (which posts by invoiceId to Payment/UpdatePaymentStatus).
async function openMarkAsPaidForTeam(team) {
    const cid = $('.competition-registration-management').data('competition-id');
    let invoiceId = team.invoiceId;
    let amount = Math.round(Number(team.amount) || 0);
    let invoiceNumber = team.invoiceNumber || '';

    if (!invoiceId) {
        try {
            const token = $('input[name="__RequestVerificationToken"]').val();
            const resp = await fetch('/umbraco/surface/RegistrationAdmin/EnsureTeamInvoice', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ competitionId: parseInt(cid, 10), teamId: team.id })
            });
            const raw = await resp.text();
            const data = raw ? JSON.parse(raw) : null;
            if (!resp.ok || !data || !data.success || !data.invoiceId) {
                alert('Kunde inte skapa lagfaktura: ' + ((data && data.message) || 'okänt fel'));
                return;
            }
            invoiceId = data.invoiceId;
            amount = Math.round(Number(data.amount) || amount);
            invoiceNumber = data.invoiceNumber || invoiceNumber;
        } catch (err) {
            alert('Kunde inte skapa lagfaktura: ' + err.message);
            return;
        }
    }

    document.getElementById('markPaidInvoiceId').value = invoiceId;
    document.getElementById('markPaidRegistrationId').value = '';
    document.getElementById('markPaidInvoiceAmount').value = amount;
    document.getElementById('markPaidShooterName').textContent = `${team.teamName} (${team.isRelay ? 'stafett' : 'lag'})`;
    document.getElementById('markPaidAmount').textContent = amount;
    document.getElementById('markPaidActualAmount').value = amount;
    document.getElementById('markPaidMethod').value = 'Swish';
    document.getElementById('markPaidTransactionId').value = invoiceNumber;
    document.getElementById('markPaidNotes').value = '';
    // Teams have no single member email, so the receipt/confirmation is a no-op — leave it off.
    const receiptBox = document.getElementById('markPaidSendReceipt');
    if (receiptBox) receiptBox.checked = false;
    updateMarkPaidVariance();

    const modalEl = document.getElementById('markAsPaidModal');
    if (!markPaidModalInstance) markPaidModalInstance = new bootstrap.Modal(modalEl);
    if (!markPaidDatePicker) {
        markPaidDatePicker = flatpickr('#markPaidDate', { locale: 'sv', dateFormat: 'Y-m-d', defaultDate: 'today', maxDate: 'today' });
    } else {
        markPaidDatePicker.setDate(new Date(), true);
    }
    markPaidModalInstance.show();
}

function filterCompetitionRegistrations() {
    const selectedClasses = getSelectedCompetitionClasses();
    const clubFilter = document.getElementById('competitionClubFilter').value;
    const preferenceFilter = document.getElementById('competitionPreferenceFilter').value;
    const paymentFilter = document.getElementById('competitionPaymentFilter')?.value || '';
    const checkedInFilter = document.getElementById('competitionCheckedInFilter')?.value || '';
    const searchTerm = (document.getElementById('competitionRegistrationSearch')?.value || '').trim().toLowerCase();

    filteredCompetitionRegistrations = competitionRegistrations.filter(reg => {
        // Multi-select: match when no class is selected, or any of the registration's
        // classes is among the selected ones.
        const matchesClass = selectedClasses.length === 0
            || (reg.shootingClasses && reg.shootingClasses.some(sc => selectedClasses.includes(sc.class)));
        const matchesClub = !clubFilter || reg.memberClub === clubFilter;
        // Check if any class has the matching start preference
        const matchesPreference = !preferenceFilter || (reg.shootingClasses && reg.shootingClasses.some(sc => sc.startPreference === preferenceFilter));
        const matchesPayment = !paymentFilter || (reg.paymentStatus || 'No Invoice') === paymentFilter;
        const matchesCheckedIn = !checkedInFilter
            || (checkedInFilter === 'in' && reg.isCheckedIn === true)
            || (checkedInFilter === 'out' && !reg.isCheckedIn);

        // Free-text search against name, club, and Swish reference (invoice number).
        // Substring match so partial pastes from a Swish notification still hit.
        let matchesSearch = true;
        if (searchTerm) {
            const haystack = [
                reg.memberName || '',
                reg.memberClub || '',
                reg.invoiceNumber || ''
            ].join(' ').toLowerCase();
            matchesSearch = haystack.includes(searchTerm);
        }

        return matchesClass && matchesClub && matchesPreference && matchesPayment && matchesCheckedIn && matchesSearch;
    });

    // Header badge reflects the filtered view, not the full total.
    const ic = document.getElementById('individualsCount');
    if (ic) ic.textContent = filteredCompetitionRegistrations.length;

    applyCompetitionSort();
    currentCompetitionPage = 1;
    displayCompetitionRegistrations();

    // The Lag card used to ignore every filter: searching for a shooter narrowed the
    // individuals to one row while all 55 teams stayed on screen. Re-render it here so
    // Sök / Klubb / Betalstatus reach both lists from the one set of inputs.
    renderCompetitionTeams();
}

// Recompute and render the totals across the FULL registration list (not the filtered view).
// Filtering changes the table below, the summary above represents the whole competition.
const springskytteSummary = @(springskytteEnabled ? "true" : "false");

function updatePaymentSummary() {
    const cards = document.getElementById('paymentSummaryCards');
    if (!cards) return;

    const regs = competitionRegistrations || [];
    const teams = competitionTeams || [];
    if (regs.length === 0 && teams.length === 0) {
        cards.style.display = 'none';
        return;
    }

    const uniqueMembers = new Set(regs.map(r => r.memberId)).size;
    let paidCount = 0, paidAmount = 0;
    let pendingCount = 0, pendingAmount = 0;
    let noInvoiceCount = 0;
    // Counted as unique MEMBERS, not rows — the same shooter can hold two registration rows,
    // and the card is labelled "skyttar", so rows would over-count against the total.
    const checkedInMembers = new Set();
    // "Starter" = total class entries across all registrations. A shooter
    // registered for two classes contributes 2 starts, not 1.
    let totalStarts = 0;
    // …and per weapon class, which is what staffing a firing line actually needs.
    const startsByWeapon = {};

    regs.forEach(r => {
        if (r.isCheckedIn === true) checkedInMembers.add(r.memberId);
        (Array.isArray(r.shootingClasses) ? r.shootingClasses : []).forEach(sc => {
            const wc = weaponClassOf(sc.class);
            if (wc) startsByWeapon[wc] = (startsByWeapon[wc] || 0) + 1;
        });
        const status = r.paymentStatus || 'No Invoice';
        // Amounts come from aggregates so multi-invoice regs (paid + top-up pending) sum correctly.
        paidAmount += Number(r.paidAmount) || 0;
        pendingAmount += Number(r.pendingAmount) || 0;
        // Counts still bucket by the actionable status so buckets sum to total registrations.
        if (status === 'Paid') paidCount++;
        else if (status === 'Pending') pendingCount++;
        else if (status === 'No Invoice') noInvoiceCount++;
        totalStarts += Array.isArray(r.shootingClasses) ? r.shootingClasses.length : 0;
    });

    // Fold teams/stafett (Lag) into the money totals so the sums above the lists
    // reflect the whole competition, not just individuals. Teams carry a single
    // invoice (amount + status), not the multi-invoice aggregates individuals have.
    let relayCount = 0;
    teams.forEach(t => {
        if (t.isRelay) relayCount++;
        const status = t.paymentStatus || 'No Invoice';
        const amount = Number(t.amount) || 0;
        if (status === 'Paid') { paidCount++; paidAmount += amount; }
        else if (status === 'Pending') { pendingCount++; pendingAmount += amount; }
        else if (status === 'No Invoice') noInvoiceCount++;
    });

    document.getElementById('summaryRegCount').textContent = regs.length;
    document.getElementById('summaryUniqueMembers').textContent = uniqueMembers;
    document.getElementById('summaryTeamCount').textContent = teams.length;
    // Springskytte runs lag and stafett side by side with different fees and different start
    // lists, so one merged number hides which half is missing. Everywhere else there is only
    // one kind of team, so the split would be noise.
    const teamBreakdownEl = document.getElementById('summaryTeamBreakdown');
    if (teamBreakdownEl) {
        teamBreakdownEl.textContent = springskytteSummary
            ? `${teams.length - relayCount} lag · ${relayCount} stafett`
            : 'lag/stafett';
    }
    document.getElementById('summaryStartsCount').textContent = totalStarts;
    const byWeaponEl = document.getElementById('summaryStartsByWeapon');
    if (byWeaponEl) {
        // Ordered by count so the biggest group leads — that is the one that sets the schedule.
        const parts = Object.keys(startsByWeapon)
            .sort((a, b) => startsByWeapon[b] - startsByWeapon[a] || a.localeCompare(b, 'sv'))
            .map(wc => `${wc} ${startsByWeapon[wc]}`);
        byWeaponEl.textContent = parts.join(' · ');
    }
    document.getElementById('summaryCheckedInCount').textContent = checkedInMembers.size;
    document.getElementById('summaryCheckedInTotal').textContent = uniqueMembers;
    const bar = document.getElementById('summaryCheckedInBar');
    if (bar) bar.style.width = uniqueMembers ? `${Math.round(100 * checkedInMembers.size / uniqueMembers)}%` : '0%';
    document.getElementById('summaryPaidCount').textContent = paidCount;
    document.getElementById('summaryPaidAmount').textContent = `${Math.round(paidAmount)} kr`;
    document.getElementById('summaryPendingCount').textContent = pendingCount;
    document.getElementById('summaryPendingAmount').textContent = `${Math.round(pendingAmount)} kr`;
    document.getElementById('summaryNoInvoiceCount').textContent = noInvoiceCount;
    // Only surface the exception row when there is actually something to repair.
    document.getElementById('missingInvoiceRow')?.classList.toggle('d-none', noInvoiceCount === 0);
    cards.style.display = '';
}

// Weapon class from a class id. First character for the standard ids (C1, A_Vet_Y, A_opt_1)
// and for Springskytte's composite ids ("A-D 21" → A) alike — the same rule the live result
// board uses. Returns '' for anything that doesn't start with a known weapon letter, so an
// unexpected id is dropped from the breakdown rather than inventing a group.
function weaponClassOf(classId) {
    const c = (classId || '').trim().charAt(0).toUpperCase();
    return 'ABCRLM'.includes(c) ? c : '';
}

// Mint the invoices for registrations that lost theirs. Idempotent — the endpoint skips anything
// already invoiced and reports what it did, so a partial repair is never silent.
async function fixMissingInvoices() {
    const btn = document.getElementById('fixMissingInvoicesBtn');
    if (!btn) return;
    const original = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Skapar...';
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        // currentCompetitionId is scoped inside loadCompetitionRegistrations, so read the same source.
        const competitionId = $('.competition-registration-management').data('competition-id');
        const r = await fetch('/umbraco/surface/RegistrationAdmin/EnsureMissingInvoices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ competitionId })
        });
        const d = await r.json();
        alert(d.message || (d.success ? 'Klart.' : 'Kunde inte skapa fakturor.'));
        if (d.success) await loadCompetitionRegistrations();
    } catch (e) {
        alert('Nätverksfel när saknade fakturor skulle skapas.');
    } finally {
        btn.disabled = false;
        btn.innerHTML = original;
    }
}

function populateCompetitionClubFilter() {
    const select = document.getElementById('competitionClubFilter');
    if (!select) return;
    // Teams are included: a club can have a lag in the competition without any individual
    // entry, and it would otherwise be unreachable from the Klubb filter.
    const clubs = Array.from(new Set([
        ...competitionRegistrations.map(r => r.memberClub),
        ...(competitionTeams || []).map(t => t.clubName)
    ].filter(Boolean))).sort((a, b) => a.localeCompare(b, 'sv'));
    const current = select.value;
    select.innerHTML = '<option value="">Alla klubbar</option>';
    clubs.forEach(club => {
        const opt = document.createElement('option');
        opt.value = club;
        opt.textContent = club;
        select.appendChild(opt);
    });
    if (clubs.includes(current)) {
        select.value = current;
    }
}

// Canonical ordering for the 39 standard shooting classes. Anything not in this
// list (e.g. Springskytte composite classes like "A-D 21") sorts after these,
// alphabetically/numerically.
const STANDARD_CLASS_ORDER = [
    "A1", "A2", "A3",
    "B1", "B2", "B3",
    "C1", "C2", "C3", "C_Vet_Y", "C_Vet_A", "C_Jun", "C1_Dam", "C2_Dam", "C3_Dam",
    "R1", "R2", "R3",
    "M1", "M2", "M3", "M4", "M5", "M6", "M7", "M8", "M9",
    "L1", "L2", "L3", "L_Vet_Y", "L_Vet_A", "L_Jun", "L1_Dam", "L2_Dam", "L3_Dam"
];

function compareShootingClassIds(a, b) {
    const ia = STANDARD_CLASS_ORDER.indexOf(a);
    const ib = STANDARD_CLASS_ORDER.indexOf(b);
    if (ia !== -1 && ib !== -1) return ia - ib;
    if (ia !== -1) return -1;
    if (ib !== -1) return 1;
    return a.localeCompare(b, 'sv', { numeric: true });
}

// The class ids currently ticked in the multi-select dropdown.
function getSelectedCompetitionClasses() {
    return Array.from(document.querySelectorAll('.competition-class-filter-cb:checked')).map(cb => cb.value);
}

// Keep the collapsed button label in sync with the current selection.
function updateCompetitionClassFilterLabel() {
    const label = document.getElementById('competitionClassFilterLabel');
    if (!label) return;
    const checked = document.querySelectorAll('.competition-class-filter-cb:checked');
    if (checked.length === 0) {
        label.textContent = 'Alla klasser';
    } else if (checked.length === 1) {
        const lbl = document.querySelector('label[for="' + checked[0].id + '"]');
        label.textContent = lbl ? lbl.textContent : checked[0].value;
    } else {
        label.textContent = checked.length + ' klasser valda';
    }
}

function onCompetitionClassFilterChange() {
    updateCompetitionClassFilterLabel();
    filterCompetitionRegistrations();
}

function clearCompetitionClassFilter() {
    document.querySelectorAll('.competition-class-filter-cb:checked').forEach(cb => cb.checked = false);
    onCompetitionClassFilterChange();
}

// Build the multi-select class filter from the classes actually present in the
// registrations. This keeps it discipline-agnostic — standard comps show the
// standard classes registered, Springskytte comps show their composite
// weapon-ageclasses (e.g. "A-D 21") — and guarantees every option matches the
// exact value the filter compares against (reg.shootingClasses[].class).
function populateShootingClassFilter() {
    const menu = document.getElementById('competitionClassFilterMenu');
    if (!menu) return;

    // Preserve the current selection across re-populations (e.g. after data load).
    const previouslySelected = getSelectedCompetitionClasses();

    // id -> display label. Display uses the same transform as the class badges in
    // the table so the filter and the rows read identically.
    const seen = new Map();
    (competitionRegistrations || []).forEach(reg => {
        (reg.shootingClasses || []).forEach(sc => {
            const id = sc.class || sc.className || '';
            if (!id || seen.has(id)) return;
            const normalized = normalizeShootingClass(id);
            const label = window.formatAgeSpan ? window.formatAgeSpan(normalized) : normalized;
            seen.set(id, label);
        });
    });

    if (seen.size === 0) {
        menu.innerHTML = '<div class="text-muted small px-2 py-1">Inga klasser</div>';
        updateCompetitionClassFilterLabel();
        return;
    }

    const ids = Array.from(seen.keys()).sort(compareShootingClassIds);

    let html = '<div class="d-flex justify-content-between align-items-center px-2 pb-1 mb-1 border-bottom">'
        + '<span class="small text-muted">Välj klasser</span>'
        + '<button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="clearCompetitionClassFilter()">Rensa</button>'
        + '</div>';
    ids.forEach((id, idx) => {
        const checked = previouslySelected.includes(id) ? 'checked' : '';
        // Index suffix guarantees a unique DOM id even if two class ids slugify the same.
        const cbId = 'ccf_' + idx + '_' + id.replace(/[^A-Za-z0-9_-]/g, '_');
        html += '<div class="form-check">'
            + '<input class="form-check-input competition-class-filter-cb" type="checkbox"'
            + ' value="' + escapeHtmlSafe(id) + '" id="' + cbId + '" ' + checked
            + ' onchange="onCompetitionClassFilterChange()">'
            + '<label class="form-check-label" for="' + cbId + '">' + escapeHtmlSafe(seen.get(id)) + '</label>'
            + '</div>';
    });
    menu.innerHTML = html;
    updateCompetitionClassFilterLabel();
}

function displayCompetitionRegistrations() {
    const tbody = document.getElementById('competitionRegistrationsTableBody');
    const startIndex = (currentCompetitionPage - 1) * competitionPageSize;
    const endIndex = startIndex + competitionPageSize;
    const pageRegistrations = filteredCompetitionRegistrations.slice(startIndex, endIndex);

    if (filteredCompetitionRegistrations.length === 0) {
        showCompetitionNoResults();
        return;
    }

    // Show the Deltävling column only when this competition actually has one.
    const showSubComp = !!competitionSubCompetitionName;
    const subCompHeader = document.getElementById('subCompColHeader');
    if (subCompHeader) {
        subCompHeader.style.display = showSubComp ? '' : 'none';
        subCompHeader.title = showSubComp ? competitionSubCompetitionName : '';
    }

    tbody.innerHTML = '';

    pageRegistrations.forEach(reg => {
        // Build class badges from shootingClasses array (small badges)
        let classBadges = '';

        if (reg.shootingClasses && Array.isArray(reg.shootingClasses) && reg.shootingClasses.length > 0) {
            classBadges = reg.shootingClasses.map(sc => {
                // sc should be an object with 'class', 'className', and 'startPreference' properties
                const classId = sc.class || sc.className || '';
                const normalizedClass = normalizeShootingClass(classId);
                const displayClass = window.formatAgeSpan ? window.formatAgeSpan(normalizedClass) : normalizedClass;
                return `<span class="badge bg-primary me-1 mb-1" style="font-size: 0.85em;">${displayClass}</span>`;
            }).join('');
        }

        const row = document.createElement('tr');
        // Club name shortened for a narrow column; full name kept in the title for hover
        // and still used for search/filter (reg.memberClub is untouched).
        const fullClub = reg.memberClub || '';
        const shortClub = shortenClubName(fullClub);
        row.innerHTML = `
            <td>
                <strong>${reg.memberName}</strong>
            </td>
            <td style="font-size:0.85em; max-width:150px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${escapeHtmlSafe(fullClub)}">${escapeHtmlSafe(shortClub)}</td>
            <td>
                ${classBadges}
            </td>
            <td style="display:${showSubComp ? '' : 'none'};">
                ${reg.isSubCompetition
                    ? `<span class="badge bg-success" title="Anmäld till ${escapeHtmlSafe(competitionSubCompetitionName)}"><i class="bi bi-check-lg"></i></span>`
                    : '<span class="text-muted">—</span>'}
            </td>
            <td>
                ${formatServerLocalDateTime(reg.registrationDate)}
            </td>
            <td>
                <span class="badge ${getPaymentStatusBadgeClass(reg.paymentStatus)}">
                    ${getPaymentStatusText(reg.paymentStatus)}
                </span>
                ${reg.hasVariance ? `
                    <span class="badge bg-warning text-dark ms-1" title="Faktiskt belopp avviker från fakturabeloppet">
                        <i class="bi bi-exclamation-triangle me-1"></i>Avvikande belopp
                    </span>
                ` : ''}
                ${(reg.paymentSentDate && reg.paymentStatus !== 'Paid') ? `
                    <span class="badge bg-info text-dark ms-1" title="Betalaren${reg.paymentSentBy ? ' (' + escapeHistory(reg.paymentSentBy) + ')' : ''} anger att betalning är gjord — bekräfta när den är mottagen">
                        <i class="bi bi-cash-coin me-1"></i>Betalning anmäld
                    </span>
                ` : ''}
            </td>
            <td>
                <!-- Item #9: at-the-desk attendance toggle. Saves on change; reflects state
                     on next render via the API field, but we also update the in-memory row
                     immediately so the operator gets instant feedback. -->
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="checkin_${reg.id}"
                           ${reg.isCheckedIn ? 'checked' : ''}
                           onchange="setCheckedIn(${reg.id}, this.checked)"
                           title="Markera som incheckad / närvarande">
                    <label class="form-check-label small text-muted" for="checkin_${reg.id}">
                        ${reg.isCheckedIn ? 'Här' : ''}
                    </label>
                </div>
            </td>
            <td>
                <!-- Action buttons in two groups: workflow on the left, destructive (delete)
                     pinned to the right so it's always in the same horizontal position
                     regardless of how many of the optional middle buttons (mark-paid /
                     history) are present. Reduces the chance of mis-tapping delete. -->
                <div class="d-flex justify-content-between align-items-center gap-1">
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary"
                                onclick="editCompetitionRegistration(${reg.id})"
                                title="Redigera anmälan">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-success"
                                onclick="showPaymentOptionsForRegistration(${reg.id})"
                                title="Hantera betalning">
                            <i class="bi bi-wallet2"></i>
                        </button>
                        ${reg.paymentStatus === 'Pending' ? `
                            <button class="btn btn-sm btn-success"
                                    onclick="markAsPaid(${reg.id})"
                                    title="Markera som betald">
                                <i class="bi bi-check-circle"></i>
                            </button>
                        ` : ''}
                        ${renderHistoryButton(reg.invoiceId, JSON.stringify(reg.memberName).replace(/"/g, '&quot;'), reg.lastReminderSentDate, reg.reminderCount)}
                    </div>
                    <button class="btn btn-sm btn-outline-danger"
                            onclick="confirmDeleteCompetitionRegistration(${reg.id})"
                            title="Ta bort anmälan">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </td>
        `;
        tbody.appendChild(row);
    });

    showCompetitionTable();
    updateCompetitionPagination();
}

