@{
    // "Funktionärer" tab (Springskytte). The competition-day cockpit for the two weapon-group lines
    // (A/C — one runs at a time). Per class: launchers into the three role screens (Startlinje, Tid &
    // straff, Poäng) + a live load view derived purely from saves (GetSpringskytteFunctionaryLoad):
    // who is scoring / timing, their pace + freshness, backlog (scored vs startade, måltider vs
    // startade), and a "behöver hjälp" flag. Plus the tävlingsledning message console (#evtInboxMount).
    var competitionId = ViewData["CompetitionId"];
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <span class="fw-bold fs-5"><i class="bi bi-person-badge me-1"></i>Funktionärer</span>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span class="text-muted small" id="sfnUpdated"></span>
        <a class="btn btn-outline-success btn-sm" href="/live?c=@competitionId" target="_blank" rel="noopener">
            <i class="bi bi-tv me-1"></i>Live-resultattavla
        </a>
    </div>
</div>

@Html.AntiForgeryToken()

@{ var sdVd = new ViewDataDictionary(ViewData); sdVd["CompetitionId"] = competitionId; sdVd["Discipline"] = "Springskytte"; }
@await Html.PartialAsync("_StaffingDayOf", sdVd)

<div class="row g-3" id="sfnClasses">
    <div class="col-12 text-center text-muted py-4"><div class="spinner-border spinner-border-sm" role="status"></div> Laddar…</div>
</div>

<p class="text-muted small mt-3 mb-0">
    Bemanningen härleds från inmatningarna som poängräknarna och tidtagarna redan gör — ingen extra app
    och ingen batteridränerande inloggningssignal. "Arbetar nu" visar vilka som registrerat nyligt och
    deras takt (senaste 10 min). En funktionär som just satt sig syns först efter första sparade posten.
</p>

@await Html.PartialAsync("_EventMessageInbox")
<script>
(function () {
    var compId = @competitionId;
    var REFRESH = 15000;
    var timer = null;
    var BASE_CLASSES = ['A', 'C'];   // Springskytte always runs A + C; show launchers even before data.

    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

    function activeBadge(cl) {
        if (cl && cl.active) return '<span class="badge bg-primary">Pågår</span>';
        if (cl && (cl.scored > 0 || cl.maltider > 0)) return '<span class="badge bg-warning text-dark">Vilande</span>';
        return '<span class="badge bg-secondary">Väntar</span>';
    }
    function freshDot(mins) {
        var cls = mins <= 2 ? 'text-success' : (mins <= 4 ? 'text-warning' : 'text-danger');
        return '<i class="bi bi-circle-fill ' + cls + ' me-1" style="font-size:.5rem;vertical-align:middle"></i>';
    }
    function rosterRow(p, maxRecent) {
        var barPct = maxRecent > 0 ? Math.round((p.entriesRecent / maxRecent) * 100) : 0;
        return '<div class="d-flex align-items-center gap-2 small py-1">'
            + '<span style="min-width:140px">' + freshDot(p.lastSaveMinsAgo) + '<span class="fw-semibold">' + esc(p.name) + '</span></span>'
            + '<div class="flex-grow-1"><div class="progress" style="height:6px" title="' + p.entriesRecent + ' senaste 10 min">'
            + '<div class="progress-bar bg-info" style="width:' + barPct + '%"></div></div></div>'
            + '<span class="text-muted text-nowrap">' + p.entriesRecent + '/10 min · '
            + (p.lastSaveMinsAgo <= 0 ? 'nyss' : p.lastSaveMinsAgo + ' min') + '</span>'
            + '</div>';
    }
    function backlogLine(label, done, total) {
        var pct = total > 0 ? Math.min(100, Math.round((done / total) * 100)) : 0;
        var cls = (total > 0 && done >= total) ? 'bg-success' : 'bg-primary';
        return '<div class="mb-1"><div class="d-flex justify-content-between small"><span class="text-muted">' + label + '</span>'
            + '<span class="text-muted">' + done + '/' + total + '</span></div>'
            + '<div class="progress" style="height:6px"><div class="progress-bar ' + cls + '" style="width:' + pct + '%"></div></div></div>';
    }
    function rosterBlock(title, people, maxRecent, emptyMsg) {
        if (!people || !people.length) return '<div class="small text-muted mb-2">' + emptyMsg + '</div>';
        return '<div class="mb-2"><div class="small text-muted mb-1"><i class="bi bi-people me-1"></i>' + title + ' (' + people.length + ')</div>'
            + people.map(function (p) { return rosterRow(p, maxRecent); }).join('') + '</div>';
    }
    function helpAlert(reason) {
        return '<div class="alert alert-warning py-1 px-2 small mt-1 mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Behöver hjälp: ' + esc(reason) + '</div>';
    }

    function render(d) {
        var host = document.getElementById('sfnClasses');
        var upd = document.getElementById('sfnUpdated');
        if (upd && d.success) upd.textContent = 'Uppdaterad ' + new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

        var byClass = {};
        if (d.success) (d.classes || []).forEach(function (c) { byClass[c.weaponClass] = c; });
        // Merge the always-present A/C with any extra class the endpoint reports.
        var order = BASE_CLASSES.slice();
        Object.keys(byClass).forEach(function (w) { if (order.indexOf(w) < 0) order.push(w); });

        var maxRecent = 0;
        Object.values(byClass).forEach(function (c) {
            (c.scorers || []).concat(c.timers || []).forEach(function (p) { if (p.entriesRecent > maxRecent) maxRecent = p.entriesRecent; });
        });

        host.innerHTML = order.map(function (wc) {
            var cl = byClass[wc] || null;
            var needsHelp = cl && (cl.scoringNeedsHelp || cl.timingNeedsHelp);

            var body;
            if (!cl) {
                body = '<div class="small text-muted">Inga startande/registrerade ännu.</div>';
            } else {
                body = backlogLine('Poängsatta', cl.scored, cl.starters)
                    + backlogLine('Sluttider', cl.maltider, cl.starters)
                    + '<hr class="my-2">'
                    + rosterBlock('Poängräknare', cl.scorers, maxRecent, 'Ingen poängräknare aktiv.')
                    + (cl.scoringNeedsHelp ? helpAlert(cl.scoringHelpReason) : '')
                    + rosterBlock('Tidtagare', cl.timers, maxRecent, 'Ingen tidtagare aktiv.')
                    + (cl.timingNeedsHelp ? helpAlert(cl.timingHelpReason) : '');
            }

            // Footer launchers — full-width text buttons, one per role screen, matching the Fältskytte
            // Stationer / Precision Funktionärer pattern. Scoring is the solid primary; the other two
            // role screens are outline secondaries.
            var footer = '<div class="card-footer p-2">'
                + '<a class="btn btn-primary w-100 mb-2" href="/station?c=' + compId + '&s=' + wc + '" target="_blank"><i class="bi bi-card-list me-1"></i>Öppna poänginmatning</a>'
                + '<a class="btn btn-outline-secondary w-100 mb-2" href="/station?c=' + compId + '&s=' + wc + '&mode=tid" target="_blank"><i class="bi bi-stopwatch me-1"></i>Öppna tid &amp; straff</a>'
                + '<a class="btn btn-outline-secondary w-100" href="/startlinje/' + compId + '?s=' + wc + '" target="_blank"><i class="bi bi-flag me-1"></i>Öppna startlinje</a>'
                + '</div>';

            return '<div class="col-12 col-xl-6">'
                + '<div class="card h-100' + (needsHelp ? ' border-warning' : '') + '">'
                + '<div class="card-header d-flex justify-content-between align-items-center py-2">'
                + '<span class="fw-bold">Vapengrupp ' + wc + '</span> ' + activeBadge(cl)
                + '</div>'
                + '<div class="card-body py-2">' + body + '</div>'
                + footer
                + '</div></div>';
        }).join('');
    }

    async function refresh() {
        try {
            var r = await fetch('/umbraco/surface/Springskytte/GetSpringskytteFunctionaryLoad?competitionId=' + compId, { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            render(d);
        } catch (e) {
            render({ success: false, classes: [] });
        }
    }

    // Tävlingsledningens meddelandekonsol (consoleMode → sees every thread). Springskytte messaging is
    // role-based (one line at a time), so recipients are the three roles + everyone.
    if (window.EventInbox) {
        EventInbox.init({
            competitionId: compId,
            consoleMode: true,
            mountSelector: '#evtInboxMount',
            label: 'Tävlingsledning',
            fromScope: { type: 'Role', key: 'ledning' },
            scopes: [ { type: 'Role', key: 'ledning' } ],
            recipients: [
                { type: 'All', label: 'Alla funktionärer' },
                { type: 'Role', key: 'startledare', label: 'Startledare' },
                { type: 'Role', key: 'timer', label: 'Tidtagare' },
                { type: 'Role', key: 'scorer', label: 'Poängräknare' }
            ]
        });
    }

    refresh();
    timer = setInterval(refresh, REFRESH);
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) { if (timer) { clearInterval(timer); timer = null; } }
        else if (!timer) { refresh(); timer = setInterval(refresh, REFRESH); }
    });
})();
</script>
