@*
 * Board Roles Management - Reusable partial for managing board roles and other positions.
 * Used by both ClubAdminPanel (ownerType=0, renders as modal) and RegionalAdminPanel (ownerType=1, renders inline).
 * Requires ViewBag: BoardOwnerType (int), BoardOwnerId (int)
 *@

@{
    var brOwnerType = ViewBag.BoardOwnerType as int? ?? 0;
    var brOwnerId = ViewBag.BoardOwnerId as int? ?? 0;
    var isClubContext = brOwnerType == 0;
}

<!-- Flatpickr (date pickers for term tracking). Guarded so a second include on the same page is harmless. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

@if (isClubContext)
{
<!-- Board Roles Management Modal (Club context) -->
<div class="modal fade" id="boardRolesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-award me-2"></i>Styrelse &amp; Roller</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Hantera styrelsemedlemmar och andra roller. Tilldelade roller visas i klubbens medlemslista.</p>

                <!-- Current roles table -->
                <div id="boardRolesList" class="mb-4">
                    <div class="text-center text-muted py-3">Laddar...</div>
                </div>

                <hr>

                <!-- Assign new role -->
                <h6 class="fw-semibold mb-3">Lägg till roll</h6>
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label small">Medlem</label>
                        <select id="boardRoleMemberSelect" class="form-select form-select-sm">
                            <option value="">Välj medlem...</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small">Roll</label>
                        <select id="boardRoleKeySelect" class="form-select form-select-sm" onchange="onBoardRoleKeyChange()">
                            <option value="">Välj roll...</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3" id="boardRoleCustomTitleGroup" style="display: none;">
                        <label class="form-label small">Egen titel</label>
                        <input type="text" id="boardRoleCustomTitle" class="form-control form-control-sm"
                               placeholder="T.ex. Materialförvaltare">
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="boardRoleIsBoardMember" checked>
                            <label class="form-check-label small" for="boardRoleIsBoardMember">Styrelse</label>
                        </div>
                    </div>
                </div>
                <div class="row g-2 align-items-end mt-1">
                    <div class="col-6 col-md-4">
                        <label class="form-label small">Vald datum</label>
                        <input type="text" id="boardRoleElectedDate" class="form-control form-control-sm" placeholder="Välj datum...">
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small">Mandattid (år)</label>
                        <input type="number" id="boardRoleTermYears" class="form-control form-control-sm" min="1" max="10" placeholder="t.ex. 2">
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label small">Mandat t.o.m.</label>
                        <input type="text" id="boardRoleTermEndsDate" class="form-control form-control-sm" placeholder="Fylls i automatiskt...">
                    </div>
                </div>
                <div class="mt-2">
                    <button class="btn btn-sm btn-primary" onclick="assignBoardRole()">
                        <i class="bi bi-plus-circle me-1"></i><span id="boardRoleSubmitLabel">Tilldela roll</span>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary d-none" id="boardRoleCancelEdit" onclick="cancelEditBoardRole()">Avbryt</button>
                </div>

                <hr>

                <!-- Mandat som löper ut -->
                <h6 class="fw-semibold mb-2"><i class="bi bi-hourglass-split me-1"></i>Mandat som löper ut</h6>
                <div id="boardRolesExpiring">
                    <div class="text-center text-muted py-2 small">Laddar...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>
}
else
{
<!-- Board Roles Management Inline (Region context) -->
<div id="boardRolesInlineContainer">
    <p class="text-muted small mb-3">Hantera styrelsemedlemmar och andra roller. Roller markerade som styrelsemedlem visas i fliken "Styrelsen".</p>

    <!-- Current roles table -->
    <div id="boardRolesList" class="mb-4">
        <div class="text-center text-muted py-3">Laddar...</div>
    </div>

    <hr>

    <!-- Assign new role -->
    <h6 class="fw-semibold mb-3">Lägg till roll</h6>
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small">Medlem</label>
            <input type="text" id="boardRoleMemberSearch" class="form-control form-control-sm"
                   placeholder="Sök namn eller e-post..." autocomplete="off">
            <select id="boardRoleMemberSearchResults" class="form-select form-select-sm mt-1 d-none" size="4">
            </select>
            <small id="boardRoleSelectedMember" class="text-success d-none"></small>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small">Roll</label>
            <select id="boardRoleKeySelect" class="form-select form-select-sm" onchange="onBoardRoleKeyChange()">
                <option value="">Välj roll...</option>
            </select>
        </div>
        <div class="col-12 col-md-3" id="boardRoleCustomTitleGroup" style="display: none;">
            <label class="form-label small">Egen titel</label>
            <input type="text" id="boardRoleCustomTitle" class="form-control form-control-sm"
                   placeholder="T.ex. Materialförvaltare">
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end gap-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="boardRoleIsBoardMember" checked>
                <label class="form-check-label small" for="boardRoleIsBoardMember">Styrelse</label>
            </div>
        </div>
    </div>
    <div class="row g-2 align-items-end mt-1">
        <div class="col-6 col-md-4">
            <label class="form-label small">Vald datum</label>
            <input type="text" id="boardRoleElectedDate" class="form-control form-control-sm" placeholder="Välj datum...">
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small">Mandattid (år)</label>
            <input type="number" id="boardRoleTermYears" class="form-control form-control-sm" min="1" max="10" placeholder="t.ex. 2">
        </div>
        <div class="col-6 col-md-4">
            <label class="form-label small">Mandat t.o.m.</label>
            <input type="text" id="boardRoleTermEndsDate" class="form-control form-control-sm" placeholder="Fylls i automatiskt...">
        </div>
    </div>
    <div class="mt-2">
        <button class="btn btn-sm btn-primary" onclick="assignBoardRole()">
            <i class="bi bi-plus-circle me-1"></i><span id="boardRoleSubmitLabel">Tilldela roll</span>
        </button>
        <button class="btn btn-sm btn-outline-secondary d-none" id="boardRoleCancelEdit" onclick="cancelEditBoardRole()">Avbryt</button>
    </div>

    <hr>

    <!-- Mandat som löper ut -->
    <h6 class="fw-semibold mb-2"><i class="bi bi-hourglass-split me-1"></i>Mandat som löper ut</h6>
    <div id="boardRolesExpiring">
        <div class="text-center text-muted py-2 small">Laddar...</div>
    </div>
</div>
}

<script>
(function() {
    const brOwnerType = @brOwnerType;
    const brOwnerId = @brOwnerId;
    const brIsClub = @(isClubContext.ToString().ToLower());
    let brSearchTimeout = null;
    let brAvailableRoles = [];
    let brRoles = [];          // last-loaded roles, for edit lookup
    let brEditId = 0;          // 0 = assigning new, >0 = editing this role id
    let brLoaded = false;
    let brFpElected = null, brFpEnds = null, brTermDirty = false;

    function initBoardRoles() {
        if (brLoaded) return;
        brLoaded = true;
        initTermPickers();
        loadBoardRoles();
        loadAvailableRoles();
    }

    function initTermPickers() {
        if (typeof flatpickr === 'undefined') return; // inputs degrade to plain Y-m-d text
        const opts = { locale: 'sv', dateFormat: 'Y-m-d', allowInput: true };
        brFpEnds = flatpickr('#boardRoleTermEndsDate', {
            ...opts,
            onChange: () => { brTermDirty = true; }
        });
        brFpElected = flatpickr('#boardRoleElectedDate', { ...opts, onChange: autoFillTermEnd });
        const yearsEl = document.getElementById('boardRoleTermYears');
        if (yearsEl) yearsEl.addEventListener('input', autoFillTermEnd);
    }

    // Auto-fill "Mandat t.o.m." = elected + years, unless the user has edited the end date manually.
    function autoFillTermEnd() {
        if (brTermDirty) return;
        const elected = document.getElementById('boardRoleElectedDate').value;
        const years = parseInt(document.getElementById('boardRoleTermYears').value, 10);
        if (!elected || !years || years < 1) return;
        const d = new Date(elected + 'T00:00:00');
        if (isNaN(d)) return;
        d.setFullYear(d.getFullYear() + years);
        const iso = d.toISOString().slice(0, 10);
        if (brFpEnds) brFpEnds.setDate(iso, false);
        else document.getElementById('boardRoleTermEndsDate').value = iso;
    }

    // Club context: open modal and load
    if (brIsClub) {
        window.showBoardRolesModal = function() {
            const modal = new bootstrap.Modal(document.getElementById('boardRolesModal'));
            modal.show();
            initBoardRoles();
            resetBoardRoleForm();
        };
    }

    // Region context: load when the Roller tab is shown
    if (!brIsClub) {
        const tabEl = document.getElementById('regionBoardAdmin-tab');
        if (tabEl) {
            tabEl.addEventListener('shown.bs.tab', function() {
                initBoardRoles();
            });
        }
    }

    function loadBoardRoles() {
        const container = document.getElementById('boardRolesList');
        container.innerHTML = '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Laddar...</div>';

        fetch(`/umbraco/surface/BoardRole/GetBoardMembers?ownerType=${brOwnerType}&ownerId=${brOwnerId}`)
            .then(r => r.json())
            .then(data => {
                brRoles = (data.success && data.data) ? data.data : [];
                loadExpiringTerms();
                if (brRoles.length === 0) {
                    container.innerHTML = '<p class="text-muted text-center py-2">Inga roller tilldelade.</p>';
                    loadMemberDropdown([]);
                    return;
                }
                let html = `<div class="table-responsive"><table class="table table-sm table-hover mb-0">
                    <thead><tr>
                        <th>Namn</th><th>Roll</th><th class="text-center">Styrelse</th><th>Mandat t.o.m.</th><th class="text-end"></th>
                    </tr></thead><tbody>`;

                brRoles.forEach(r => {
                    const boardBadge = r.isBoardMember
                        ? '<span class="badge bg-primary">Ja</span>'
                        : '<span class="badge bg-secondary">Nej</span>';
                    html += `<tr>
                        <td>${escBR(r.memberName || '-')}</td>
                        <td>${escBR(r.title)}</td>
                        <td class="text-center">${boardBadge}</td>
                        <td>${termCell(r)}</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-secondary py-0 px-2 me-1" title="Redigera" onclick="editBoardRole(${r.id})">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger py-0 px-2" title="Ta bort" onclick="removeBoardRole(${r.id}, '${escBR(r.memberName)}', '${escBR(r.title)}')">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>`;
                });

                html += '</tbody></table></div>';
                container.innerHTML = html;

                loadMemberDropdown(brRoles.map(r => r.memberId));
            })
            .catch(() => {
                container.innerHTML = '<p class="text-danger">Kunde inte ladda roller.</p>';
            });
    }

    function loadMemberDropdown(existingMemberIds) {
        if (!brIsClub) return;

        const select = document.getElementById('boardRoleMemberSelect');
        fetch(`/umbraco/surface/ClubAdmin/GetClubMembers?clubId=${brOwnerId}`)
            .then(r => r.json())
            .then(data => {
                select.innerHTML = '<option value="">Välj medlem...</option>';
                if (data.success && data.data) {
                    data.data
                        .filter(m => m.isApproved !== false)
                        .forEach(m => {
                            select.innerHTML += `<option value="${m.id}">${escBR(m.memberName)} (${escBR(m.email)})</option>`;
                        });
                }
            })
            .catch(() => {
                select.innerHTML = '<option value="">Kunde inte ladda medlemmar</option>';
            });
    }

    function loadAvailableRoles() {
        if (brAvailableRoles.length > 0) return;
        fetch('/umbraco/surface/BoardRole/GetAvailableRoles')
            .then(r => r.json())
            .then(data => {
                if (data.success && data.data) {
                    brAvailableRoles = data.data;
                    const select = document.getElementById('boardRoleKeySelect');
                    select.innerHTML = '<option value="">Välj roll...</option>';
                    brAvailableRoles.forEach(r => {
                        select.innerHTML += `<option value="${r.key}" data-board="${r.isBoardMember}">${escBR(r.label)}</option>`;
                    });
                    select.innerHTML += '<option value="Custom">Annat...</option>';
                }
            });
    }

    window.onBoardRoleKeyChange = function() {
        const select = document.getElementById('boardRoleKeySelect');
        const customGroup = document.getElementById('boardRoleCustomTitleGroup');
        const boardCheck = document.getElementById('boardRoleIsBoardMember');
        const val = select.value;

        if (val === 'Custom') {
            customGroup.style.display = '';
            boardCheck.checked = false;
        } else {
            customGroup.style.display = 'none';
            document.getElementById('boardRoleCustomTitle').value = '';
            const opt = select.options[select.selectedIndex];
            boardCheck.checked = opt.dataset.board === 'true';
        }
    };

    // Region-only: member search with debounce
    if (!brIsClub) {
        const searchInput = document.getElementById('boardRoleMemberSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                const query = e.target.value.trim();
                clearTimeout(brSearchTimeout);

                if (query.length < 2) {
                    document.getElementById('boardRoleMemberSearchResults').classList.add('d-none');
                    return;
                }

                brSearchTimeout = setTimeout(() => {
                    fetch(`/umbraco/surface/BoardRole/SearchMembers?query=${encodeURIComponent(query)}&ownerType=${brOwnerType}&ownerId=${brOwnerId}`)
                        .then(r => r.json())
                        .then(data => {
                            const sel = document.getElementById('boardRoleMemberSearchResults');
                            sel.innerHTML = '';
                            if (data.success && data.data && data.data.length > 0) {
                                data.data.forEach(m => {
                                    sel.innerHTML += `<option value="${m.id}">${escBR(m.name)} (${escBR(m.email)})</option>`;
                                });
                                sel.classList.remove('d-none');
                            } else {
                                sel.innerHTML = '<option value="" disabled>Inga träffar</option>';
                                sel.classList.remove('d-none');
                            }
                        });
                }, 300);
            });

            document.getElementById('boardRoleMemberSearchResults').addEventListener('change', function() {
                const opt = this.options[this.selectedIndex];
                if (opt && opt.value) {
                    document.getElementById('boardRoleMemberSearch').value = opt.textContent;
                    document.getElementById('boardRoleSelectedMember').textContent = opt.textContent;
                    document.getElementById('boardRoleSelectedMember').classList.remove('d-none');
                    this.classList.add('d-none');
                    this.dataset.selectedId = opt.value;
                }
            });
        }
    }

    function getSelectedMemberId() {
        if (brIsClub) {
            return document.getElementById('boardRoleMemberSelect').value;
        } else {
            const searchResults = document.getElementById('boardRoleMemberSearchResults');
            return searchResults?.dataset.selectedId || '';
        }
    }

    window.assignBoardRole = function() {
        const memberId = getSelectedMemberId();
        const roleKey = document.getElementById('boardRoleKeySelect').value;
        const customTitle = document.getElementById('boardRoleCustomTitle').value.trim();
        const isBoardMember = document.getElementById('boardRoleIsBoardMember').checked;

        if (!memberId) { alert('Välj en medlem'); return; }
        if (!roleKey) { alert('Välj en roll'); return; }
        if (roleKey === 'Custom' && !customTitle) { alert('Ange en titel för den anpassade rollen'); return; }

        const electedDate = document.getElementById('boardRoleElectedDate').value.trim();
        const termEndsDate = document.getElementById('boardRoleTermEndsDate').value.trim();
        const termYears = document.getElementById('boardRoleTermYears').value.trim();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const editing = brEditId > 0;
        const params = new URLSearchParams({
            roleKey: roleKey,
            customTitle: roleKey === 'Custom' ? customTitle : '',
            isBoardMember: isBoardMember,
            electedDate: electedDate,
            termEndsDate: termEndsDate,
            termYears: termYears
        });
        if (editing) {
            params.set('boardRoleId', brEditId);
            params.set('sortOrder', 0);
        } else {
            params.set('ownerType', brOwnerType);
            params.set('ownerId', brOwnerId);
            params.set('memberId', memberId);
        }

        const url = editing
            ? '/umbraco/surface/BoardRole/UpdateBoardRole'
            : '/umbraco/surface/BoardRole/AssignBoardRole';

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: params.toString()
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                loadBoardRoles();
                resetBoardRoleForm();
            } else {
                alert(data.message || 'Kunde inte spara roll');
            }
        })
        .catch(() => alert('Fel vid sparande av roll'));
    };

    window.editBoardRole = function(id) {
        const r = brRoles.find(x => x.id === id);
        if (!r) return;
        brEditId = id;

        // Member is fixed while editing (UpdateBoardRole keeps the same member); show it, lock pickers.
        if (brIsClub) {
            const sel = document.getElementById('boardRoleMemberSelect');
            if (sel) { sel.value = r.memberId; sel.disabled = true; }
        } else {
            const searchInput = document.getElementById('boardRoleMemberSearch');
            if (searchInput) { searchInput.value = r.memberName || ''; searchInput.disabled = true; }
            const results = document.getElementById('boardRoleMemberSearchResults');
            if (results) results.dataset.selectedId = r.memberId;
            const lbl = document.getElementById('boardRoleSelectedMember');
            if (lbl) { lbl.textContent = r.memberName || ''; lbl.classList.remove('d-none'); }
        }

        const roleSel = document.getElementById('boardRoleKeySelect');
        roleSel.value = r.roleKey;
        onBoardRoleKeyChange();
        if (r.roleKey === 'Custom') document.getElementById('boardRoleCustomTitle').value = r.customTitle || '';
        document.getElementById('boardRoleIsBoardMember').checked = r.isBoardMember;

        document.getElementById('boardRoleTermYears').value = r.termYears || '';
        brTermDirty = true; // don't auto-overwrite the loaded end date
        setDateInput('boardRoleElectedDate', brFpElected, r.electedDate);
        setDateInput('boardRoleTermEndsDate', brFpEnds, r.termEndsDate);

        document.getElementById('boardRoleSubmitLabel').textContent = 'Spara ändringar';
        document.getElementById('boardRoleCancelEdit').classList.remove('d-none');
    };

    window.cancelEditBoardRole = function() {
        resetBoardRoleForm();
    };

    function setDateInput(elId, fp, val) {
        if (fp) fp.setDate(val || null, false);
        else document.getElementById(elId).value = val || '';
    }

    window.removeBoardRole = function(id, name, title) {
        if (!confirm(`Ta bort rollen "${title}" från ${name}?`)) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        fetch('/umbraco/surface/BoardRole/RemoveBoardRole', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `boardRoleId=${id}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                loadBoardRoles();
            } else {
                alert(data.message || 'Kunde inte ta bort roll');
            }
        })
        .catch(() => alert('Fel vid borttagning av roll'));
    };

    function resetBoardRoleForm() {
        brEditId = 0;
        brTermDirty = false;
        if (brIsClub) {
            const sel = document.getElementById('boardRoleMemberSelect');
            if (sel) { sel.value = ''; sel.disabled = false; }
        } else {
            const searchInput = document.getElementById('boardRoleMemberSearch');
            if (searchInput) { searchInput.value = ''; searchInput.disabled = false; }
            const searchResults = document.getElementById('boardRoleMemberSearchResults');
            if (searchResults) { searchResults.classList.add('d-none'); searchResults.dataset.selectedId = ''; }
            const selectedLabel = document.getElementById('boardRoleSelectedMember');
            if (selectedLabel) selectedLabel.classList.add('d-none');
        }
        document.getElementById('boardRoleKeySelect').value = '';
        document.getElementById('boardRoleCustomTitle').value = '';
        document.getElementById('boardRoleCustomTitleGroup').style.display = 'none';
        document.getElementById('boardRoleIsBoardMember').checked = true;
        document.getElementById('boardRoleTermYears').value = '';
        setDateInput('boardRoleElectedDate', brFpElected, null);
        setDateInput('boardRoleTermEndsDate', brFpEnds, null);
        document.getElementById('boardRoleSubmitLabel').textContent = 'Tilldela roll';
        document.getElementById('boardRoleCancelEdit').classList.add('d-none');
    }

    // Mandate-end cell: date + an "utgånget" / "löper ut snart" badge.
    function termCell(r) {
        if (!r.termEndsDate) return '<span class="text-muted">—</span>';
        if (r.isTermExpired)
            return `${escBR(r.termEndsDate)} <span class="badge bg-danger ms-1">Mandat utgånget</span>`;
        if (r.daysLeftInTerm != null && r.daysLeftInTerm <= 90)
            return `${escBR(r.termEndsDate)} <span class="badge bg-warning text-dark ms-1">löper ut om ${r.daysLeftInTerm} dgr</span>`;
        return escBR(r.termEndsDate);
    }

    function loadExpiringTerms() {
        const el = document.getElementById('boardRolesExpiring');
        if (!el) return;
        fetch(`/umbraco/surface/BoardRole/GetExpiringTerms?ownerType=${brOwnerType}&ownerId=${brOwnerId}&withinDays=365`)
            .then(r => r.json())
            .then(data => {
                const rows = (data.success && data.data) ? data.data : [];
                if (rows.length === 0) {
                    el.innerHTML = '<p class="text-muted small mb-0">Inga mandat löper ut inom 12 månader.</p>';
                    return;
                }
                let html = '<ul class="list-group list-group-flush small">';
                rows.forEach(r => {
                    const badge = r.isTermExpired
                        ? '<span class="badge bg-danger">utgånget</span>'
                        : `<span class="badge bg-warning text-dark">om ${r.daysLeftInTerm} dgr</span>`;
                    html += `<li class="list-group-item d-flex justify-content-between align-items-center px-0 py-1">
                        <span>${escBR(r.memberName || '-')} — ${escBR(r.title)} <span class="text-muted">(${escBR(r.termEndsDate)})</span></span>
                        ${badge}
                    </li>`;
                });
                html += '</ul>';
                el.innerHTML = html;
            })
            .catch(() => { el.innerHTML = '<p class="text-danger small mb-0">Kunde inte ladda mandat.</p>'; });
    }

    function escBR(str) {
        if (!str) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return str.toString().replace(/[&<>"']/g, m => map[m]);
    }
})();
</script>
