@*
 * Board Roles Management - Reusable partial for managing board roles and other positions.
 * Used by both ClubAdminPanel (ownerType=0, renders as modal) and RegionalAdminPanel (ownerType=1, renders inline).
 * Requires ViewBag: BoardOwnerType (int), BoardOwnerId (int)
 *@

@{
    var brOwnerType = ViewBag.BoardOwnerType as int? ?? 0;
    var brOwnerId = ViewBag.BoardOwnerId as int? ?? 0;
    var isClubContext = brOwnerType == 0;
}

@if (isClubContext)
{
<!-- Board Roles Management Modal (Club context) -->
<div class="modal fade" id="boardRolesModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-award me-2"></i>Styrelse &amp; Roller</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">Hantera styrelsemedlemmar och andra roller. Tilldelade roller visas i klubbens medlemslista.</p>

                <!-- Current roles table -->
                <div id="boardRolesList" class="mb-4">
                    <div class="text-center text-muted py-3">Laddar...</div>
                </div>

                <hr>

                <!-- Assign new role -->
                <h6 class="fw-semibold mb-3">Lägg till roll</h6>
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label small">Medlem</label>
                        <select id="boardRoleMemberSelect" class="form-select form-select-sm">
                            <option value="">Välj medlem...</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label small">Roll</label>
                        <select id="boardRoleKeySelect" class="form-select form-select-sm" onchange="onBoardRoleKeyChange()">
                            <option value="">Välj roll...</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-3" id="boardRoleCustomTitleGroup" style="display: none;">
                        <label class="form-label small">Egen titel</label>
                        <input type="text" id="boardRoleCustomTitle" class="form-control form-control-sm"
                               placeholder="T.ex. Materialförvaltare">
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="boardRoleIsBoardMember" checked>
                            <label class="form-check-label small" for="boardRoleIsBoardMember">Styrelse</label>
                        </div>
                    </div>
                </div>
                <div class="mt-2">
                    <button class="btn btn-sm btn-primary" onclick="assignBoardRole()">
                        <i class="bi bi-plus-circle me-1"></i>Tilldela roll
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>
}
else
{
<!-- Board Roles Management Inline (Region context) -->
<div id="boardRolesInlineContainer">
    <p class="text-muted small mb-3">Hantera styrelsemedlemmar och andra roller. Roller markerade som styrelsemedlem visas i fliken "Styrelsen".</p>

    <!-- Current roles table -->
    <div id="boardRolesList" class="mb-4">
        <div class="text-center text-muted py-3">Laddar...</div>
    </div>

    <hr>

    <!-- Assign new role -->
    <h6 class="fw-semibold mb-3">Lägg till roll</h6>
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label class="form-label small">Medlem</label>
            <input type="text" id="boardRoleMemberSearch" class="form-control form-control-sm"
                   placeholder="Sök namn eller e-post..." autocomplete="off">
            <select id="boardRoleMemberSearchResults" class="form-select form-select-sm mt-1 d-none" size="4">
            </select>
            <small id="boardRoleSelectedMember" class="text-success d-none"></small>
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small">Roll</label>
            <select id="boardRoleKeySelect" class="form-select form-select-sm" onchange="onBoardRoleKeyChange()">
                <option value="">Välj roll...</option>
            </select>
        </div>
        <div class="col-12 col-md-3" id="boardRoleCustomTitleGroup" style="display: none;">
            <label class="form-label small">Egen titel</label>
            <input type="text" id="boardRoleCustomTitle" class="form-control form-control-sm"
                   placeholder="T.ex. Materialförvaltare">
        </div>
        <div class="col-12 col-md-2 d-flex align-items-end gap-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="boardRoleIsBoardMember" checked>
                <label class="form-check-label small" for="boardRoleIsBoardMember">Styrelse</label>
            </div>
        </div>
    </div>
    <div class="mt-2">
        <button class="btn btn-sm btn-primary" onclick="assignBoardRole()">
            <i class="bi bi-plus-circle me-1"></i>Tilldela roll
        </button>
    </div>
</div>
}

<script>
(function() {
    const brOwnerType = @brOwnerType;
    const brOwnerId = @brOwnerId;
    const brIsClub = @(isClubContext.ToString().ToLower());
    let brSearchTimeout = null;
    let brAvailableRoles = [];
    let brLoaded = false;

    function initBoardRoles() {
        if (brLoaded) return;
        brLoaded = true;
        loadBoardRoles();
        loadAvailableRoles();
    }

    // Club context: open modal and load
    if (brIsClub) {
        window.showBoardRolesModal = function() {
            const modal = new bootstrap.Modal(document.getElementById('boardRolesModal'));
            modal.show();
            initBoardRoles();
            resetBoardRoleForm();
        };
    }

    // Region context: load when the Roller tab is shown
    if (!brIsClub) {
        const tabEl = document.getElementById('regionBoardAdmin-tab');
        if (tabEl) {
            tabEl.addEventListener('shown.bs.tab', function() {
                initBoardRoles();
            });
        }
    }

    function loadBoardRoles() {
        const container = document.getElementById('boardRolesList');
        container.innerHTML = '<div class="text-center text-muted py-3"><div class="spinner-border spinner-border-sm"></div> Laddar...</div>';

        fetch(`/umbraco/surface/BoardRole/GetBoardMembers?ownerType=${brOwnerType}&ownerId=${brOwnerId}`)
            .then(r => r.json())
            .then(data => {
                if (!data.success || !data.data || data.data.length === 0) {
                    container.innerHTML = '<p class="text-muted text-center py-2">Inga roller tilldelade.</p>';
                    loadMemberDropdown([]);
                    return;
                }
                let html = `<div class="table-responsive"><table class="table table-sm table-hover mb-0">
                    <thead><tr>
                        <th>Namn</th><th>Roll</th><th class="text-center">Styrelse</th><th class="text-end"></th>
                    </tr></thead><tbody>`;

                data.data.forEach(r => {
                    const boardBadge = r.isBoardMember
                        ? '<span class="badge bg-primary">Ja</span>'
                        : '<span class="badge bg-secondary">Nej</span>';
                    html += `<tr>
                        <td>${escBR(r.memberName || '-')}</td>
                        <td>${escBR(r.title)}</td>
                        <td class="text-center">${boardBadge}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="removeBoardRole(${r.id}, '${escBR(r.memberName)}', '${escBR(r.title)}')">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>`;
                });

                html += '</tbody></table></div>';
                container.innerHTML = html;

                loadMemberDropdown(data.data.map(r => r.memberId));
            })
            .catch(() => {
                container.innerHTML = '<p class="text-danger">Kunde inte ladda roller.</p>';
            });
    }

    function loadMemberDropdown(existingMemberIds) {
        if (!brIsClub) return;

        const select = document.getElementById('boardRoleMemberSelect');
        fetch(`/umbraco/surface/ClubAdmin/GetClubMembers?clubId=${brOwnerId}`)
            .then(r => r.json())
            .then(data => {
                select.innerHTML = '<option value="">Välj medlem...</option>';
                if (data.success && data.data) {
                    data.data
                        .filter(m => m.isApproved !== false)
                        .forEach(m => {
                            select.innerHTML += `<option value="${m.id}">${escBR(m.memberName)} (${escBR(m.email)})</option>`;
                        });
                }
            })
            .catch(() => {
                select.innerHTML = '<option value="">Kunde inte ladda medlemmar</option>';
            });
    }

    function loadAvailableRoles() {
        if (brAvailableRoles.length > 0) return;
        fetch('/umbraco/surface/BoardRole/GetAvailableRoles')
            .then(r => r.json())
            .then(data => {
                if (data.success && data.data) {
                    brAvailableRoles = data.data;
                    const select = document.getElementById('boardRoleKeySelect');
                    select.innerHTML = '<option value="">Välj roll...</option>';
                    brAvailableRoles.forEach(r => {
                        select.innerHTML += `<option value="${r.key}" data-board="${r.isBoardMember}">${escBR(r.label)}</option>`;
                    });
                    select.innerHTML += '<option value="Custom">Annat...</option>';
                }
            });
    }

    window.onBoardRoleKeyChange = function() {
        const select = document.getElementById('boardRoleKeySelect');
        const customGroup = document.getElementById('boardRoleCustomTitleGroup');
        const boardCheck = document.getElementById('boardRoleIsBoardMember');
        const val = select.value;

        if (val === 'Custom') {
            customGroup.style.display = '';
            boardCheck.checked = false;
        } else {
            customGroup.style.display = 'none';
            document.getElementById('boardRoleCustomTitle').value = '';
            const opt = select.options[select.selectedIndex];
            boardCheck.checked = opt.dataset.board === 'true';
        }
    };

    // Region-only: member search with debounce
    if (!brIsClub) {
        const searchInput = document.getElementById('boardRoleMemberSearch');
        if (searchInput) {
            searchInput.addEventListener('input', function(e) {
                const query = e.target.value.trim();
                clearTimeout(brSearchTimeout);

                if (query.length < 2) {
                    document.getElementById('boardRoleMemberSearchResults').classList.add('d-none');
                    return;
                }

                brSearchTimeout = setTimeout(() => {
                    fetch(`/umbraco/surface/BoardRole/SearchMembers?query=${encodeURIComponent(query)}&ownerType=${brOwnerType}&ownerId=${brOwnerId}`)
                        .then(r => r.json())
                        .then(data => {
                            const sel = document.getElementById('boardRoleMemberSearchResults');
                            sel.innerHTML = '';
                            if (data.success && data.data && data.data.length > 0) {
                                data.data.forEach(m => {
                                    sel.innerHTML += `<option value="${m.id}">${escBR(m.name)} (${escBR(m.email)})</option>`;
                                });
                                sel.classList.remove('d-none');
                            } else {
                                sel.innerHTML = '<option value="" disabled>Inga träffar</option>';
                                sel.classList.remove('d-none');
                            }
                        });
                }, 300);
            });

            document.getElementById('boardRoleMemberSearchResults').addEventListener('change', function() {
                const opt = this.options[this.selectedIndex];
                if (opt && opt.value) {
                    document.getElementById('boardRoleMemberSearch').value = opt.textContent;
                    document.getElementById('boardRoleSelectedMember').textContent = opt.textContent;
                    document.getElementById('boardRoleSelectedMember').classList.remove('d-none');
                    this.classList.add('d-none');
                    this.dataset.selectedId = opt.value;
                }
            });
        }
    }

    function getSelectedMemberId() {
        if (brIsClub) {
            return document.getElementById('boardRoleMemberSelect').value;
        } else {
            const searchResults = document.getElementById('boardRoleMemberSearchResults');
            return searchResults?.dataset.selectedId || '';
        }
    }

    window.assignBoardRole = function() {
        const memberId = getSelectedMemberId();
        const roleKey = document.getElementById('boardRoleKeySelect').value;
        const customTitle = document.getElementById('boardRoleCustomTitle').value.trim();
        const isBoardMember = document.getElementById('boardRoleIsBoardMember').checked;

        if (!memberId) { alert('Välj en medlem'); return; }
        if (!roleKey) { alert('Välj en roll'); return; }
        if (roleKey === 'Custom' && !customTitle) { alert('Ange en titel för den anpassade rollen'); return; }

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const params = new URLSearchParams({
            ownerType: brOwnerType,
            ownerId: brOwnerId,
            memberId: memberId,
            roleKey: roleKey,
            customTitle: roleKey === 'Custom' ? customTitle : '',
            isBoardMember: isBoardMember
        });

        fetch('/umbraco/surface/BoardRole/AssignBoardRole', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: params.toString()
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                loadBoardRoles();
                resetBoardRoleForm();
            } else {
                alert(data.message || 'Kunde inte tilldela roll');
            }
        })
        .catch(() => alert('Fel vid tilldelning av roll'));
    };

    window.removeBoardRole = function(id, name, title) {
        if (!confirm(`Ta bort rollen "${title}" från ${name}?`)) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        fetch('/umbraco/surface/BoardRole/RemoveBoardRole', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `boardRoleId=${id}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                loadBoardRoles();
            } else {
                alert(data.message || 'Kunde inte ta bort roll');
            }
        })
        .catch(() => alert('Fel vid borttagning av roll'));
    };

    function resetBoardRoleForm() {
        if (brIsClub) {
            const sel = document.getElementById('boardRoleMemberSelect');
            if (sel) sel.value = '';
        } else {
            const searchInput = document.getElementById('boardRoleMemberSearch');
            if (searchInput) searchInput.value = '';
            const searchResults = document.getElementById('boardRoleMemberSearchResults');
            if (searchResults) { searchResults.classList.add('d-none'); searchResults.dataset.selectedId = ''; }
            const selectedLabel = document.getElementById('boardRoleSelectedMember');
            if (selectedLabel) selectedLabel.classList.add('d-none');
        }
        document.getElementById('boardRoleKeySelect').value = '';
        document.getElementById('boardRoleCustomTitle').value = '';
        document.getElementById('boardRoleCustomTitleGroup').style.display = 'none';
        document.getElementById('boardRoleIsBoardMember').checked = true;
    }

    function escBR(str) {
        if (!str) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return str.toString().replace(/[&<>"']/g, m => map[m]);
    }
})();
</script>
