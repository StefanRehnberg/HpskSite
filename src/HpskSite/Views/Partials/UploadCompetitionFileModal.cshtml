@*
 * Upload Competition File Modal
 * Generic modal for uploading either an invitation or a result-list file
 * to an external competition. Driven by a "kind" parameter passed to the
 * opener (invitation | resultList).
 *@

<div class="modal fade" id="uploadCompetitionFileModal" tabindex="-1" aria-labelledby="uploadCompetitionFileModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="uploadCompetitionFileModalLabel">
                    <i class="bi bi-file-earmark-arrow-up me-2"></i><span id="upload_modalTitle">Ladda upp fil</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="uploadCompetitionFileForm">
                    <input type="hidden" id="upload_competitionId" name="competitionId">
                    <input type="hidden" id="upload_kind" value="invitation">

                    <p class="mb-3">
                        <span id="upload_introText">Ladda upp fil för:</span> <strong id="upload_competitionName"></strong>
                    </p>

                    <div class="mb-3">
                        <label for="upload_competitionFile" class="form-label">Välj fil (PDF, Word)</label>
                        <input type="file" class="form-control" id="upload_competitionFile"
                               name="competitionFile" accept=".pdf,.doc,.docx" required>
                        <small class="form-text text-muted">Max 10 MB</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Avbryt
                </button>
                <button type="button" class="btn btn-success" id="uploadCompetitionFileBtn" onclick="uploadCompetitionFile()">
                    <i class="bi bi-upload me-1"></i>Ladda upp
                </button>
            </div>
        </div>
    </div>
</div>

<script>
const UPLOAD_KINDS = {
    invitation: {
        title: 'Ladda upp inbjudan',
        intro: 'Ladda upp inbjudan för:',
        endpoint: '/umbraco/surface/CompetitionAdmin/UploadInvitationFile',
        formField: 'invitationFile',
        successMessage: 'Inbjudan uppladdad!'
    },
    resultList: {
        title: 'Ladda upp resultatlista',
        intro: 'Ladda upp resultatlista för:',
        endpoint: '/umbraco/surface/CompetitionAdmin/UploadResultListFile',
        formField: 'resultListFile',
        successMessage: 'Resultatlista uppladdad!'
    }
};

function openUploadCompetitionFileModal(kind, competitionId, competitionName) {
    const cfg = UPLOAD_KINDS[kind];
    if (!cfg) {
        console.error('Unknown upload kind:', kind);
        return;
    }

    document.getElementById('upload_competitionId').value = competitionId;
    document.getElementById('upload_kind').value = kind;
    document.getElementById('upload_competitionName').textContent = competitionName;
    document.getElementById('upload_modalTitle').textContent = cfg.title;
    document.getElementById('upload_introText').textContent = cfg.intro;
    document.getElementById('upload_competitionFile').value = '';

    const modal = new bootstrap.Modal(document.getElementById('uploadCompetitionFileModal'));
    modal.show();
}

// Backwards-compatible openers (existing callers + future ones)
function openUploadInvitationModal(competitionId, competitionName) {
    openUploadCompetitionFileModal('invitation', competitionId, competitionName);
}
function openUploadResultListModal(competitionId, competitionName) {
    openUploadCompetitionFileModal('resultList', competitionId, competitionName);
}

function uploadCompetitionFile() {
    const kind = document.getElementById('upload_kind').value;
    const cfg = UPLOAD_KINDS[kind];
    if (!cfg) {
        alert('Okänd uppladdningstyp');
        return;
    }

    const fileInput = document.getElementById('upload_competitionFile');
    if (!fileInput.files || fileInput.files.length === 0) {
        alert('Välj en fil att ladda upp');
        return;
    }

    const file = fileInput.files[0];

    if (file.size > 10 * 1024 * 1024) {
        alert('Filen är för stor. Max 10 MB.');
        return;
    }

    const validExtensions = ['.pdf', '.doc', '.docx'];
    const fileName = file.name.toLowerCase();
    if (!validExtensions.some(ext => fileName.endsWith(ext))) {
        alert('Ogiltig filtyp. Endast PDF och Word-dokument är tillåtna.');
        return;
    }

    const formData = new FormData();
    formData.append('competitionId', document.getElementById('upload_competitionId').value);
    formData.append(cfg.formField, file);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    const uploadBtn = document.getElementById('uploadCompetitionFileBtn');
    const originalText = uploadBtn.innerHTML;
    uploadBtn.disabled = true;
    uploadBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Laddar upp...';

    fetch(cfg.endpoint, {
        method: 'POST',
        headers: {
            'RequestVerificationToken': token
        },
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        uploadBtn.disabled = false;
        uploadBtn.innerHTML = originalText;

        if (data.success) {
            showUploadNotification(cfg.successMessage, 'success');
            bootstrap.Modal.getInstance(document.getElementById('uploadCompetitionFileModal')).hide();

            if (typeof loadCompetitionsList === 'function') {
                setTimeout(() => {
                    loadCompetitionsList();
                }, 500);
            }
        } else {
            alert('Fel vid uppladdning: ' + (data.message || 'Okänt fel'));
        }
    })
    .catch(error => {
        uploadBtn.disabled = false;
        uploadBtn.innerHTML = originalText;
        console.error('Upload error:', error);
        alert('Fel vid uppladdning: ' + error.message);
    });
}

function showUploadNotification(message, type) {
    const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
    const notification = document.createElement('div');
    notification.className = `alert ${alertClass} alert-dismissible fade show position-fixed`;
    notification.style.cssText = 'top: 20px; right: 20px; z-index: 9999; max-width: 400px;';
    notification.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;

    document.body.appendChild(notification);

    setTimeout(() => {
        if (notification.parentNode) {
            notification.remove();
        }
    }, 5000);
}
</script>
