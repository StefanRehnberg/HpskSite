@using HpskSite.Controllers
@model KretsAnsokningarModel
@*
    Kretsgranskning fas 4 — kretsens inkorg för tävlingsansökningar. EN partial som både kretsens
    adminpanel (fliken Ansökningar) och den fristående sidan /kretsen/ansokningar renderar. Den
    fristående sidan finns för den tävlingsansvarige som inte är kretsadmin — mejlen pekar dit.

    ⚠️ FORMEN ÄR KODBASENS INKORGSFORM (Stefans beslut 2026-10-02), samma som "Väntande
    godkännanden" i UserManagement och föreningsintygets inkorg:
      1. Siffran i rälsen (GetPendingCounts vid sidladdning av panelen).
      2. Ett GULT KORT "Att behandla" med inskickade ansökningar — en synlig knapp per rad
         (Besluta för en kretstävling, Yttra för landsdel/nationell). Göms när inget väntar.
      3. En tabell med allt övrigt och dess status, statusfilter och år. Radens grå meny bär
         Förbundets beslut, "markera som skickad" och historiken.
    Sammanställningen och sista ansökningsdagarna ligger bakom sidans blå Åtgärder.

    ⚠️ Inga användartexter i attribut — knappar bär bara id:n.
    Laddas lat: window.hpskKretsApplicationsInit().
*@
@{ var m = Model; }
<div class="ka-root" data-region-id="@m.RegionId">
    @Html.AntiForgeryToken()

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <h5 class="mb-1">
                <i class="bi bi-envelope-paper text-primary me-2"></i>Tävlingsansökningar
                <span class="badge bg-warning text-dark ms-1 d-none" id="kaBadge">0</span>
            </h5>
            <div class="small text-muted">En kretstävling beslutar kretsen själv. En landsdelstävling och en nationell tävling tillstyrker eller avstyrker kretsen, och Förbundet beslutar.</div>
        </div>
        <div class="dropdown">
            <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="kaActions">
                <i class="bi bi-sliders me-2"></i>Åtgärder
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="min-width:300px;">
                <li><h6 class="dropdown-header">Förbundet</h6></li>
                <li><a class="dropdown-item" id="kaSummaryLink" target="_blank" rel="noopener" href="#"><i class="bi bi-printer me-2"></i>Sammanställning till Förbundet</a></li>
                <li><button class="dropdown-item" type="button" data-ka="markAllSent" id="kaMarkAllItem"><i class="bi bi-send-check me-2"></i>Markera ansökningarna hos Förbundet som skickade</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><h6 class="dropdown-header">Inställningar</h6></li>
                <li><button class="dropdown-item" type="button" data-ka="deadlines"><i class="bi bi-calendar-x me-2"></i>Kretsens sista ansökningsdagar…</button></li>
                <li><button class="dropdown-item" type="button" data-ka="neighbours"><i class="bi bi-map me-2"></i>Kretsens grannkretsar…</button></li>
                <li><button class="dropdown-item" type="button" data-ka="checklist"><i class="bi bi-list-check me-2"></i>Kretsens arrangörschecklista…</button></li>
            </ul>
        </div>
    </div>

    <div id="kaTopMessage"></div>

    @* ── Att behandla ─────────────────────────────────────────────────────────────────── *@
    <div class="card mb-3 border-warning d-none" id="kaPendingCard">
        <div class="card-header bg-warning text-dark">
            <h6 class="mb-0">
                <i class="bi bi-inbox me-1"></i>Att behandla
                <span class="badge bg-dark ms-2" id="kaPendingCount">0</span>
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Datum</th><th>Tävling</th><th>Klubb</th><th>Nivå</th><th class="text-end"></th></tr></thead>
                    <tbody id="kaPendingRows"></tbody>
                </table>
            </div>
        </div>
    </div>

    @* ── Övriga ansökningar ──────────────────────────────────────────────────────────── *@
    <div class="card">
        <div class="card-header py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong><i class="bi bi-list-check me-2"></i>Ansökningar</strong>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <label class="visually-hidden" for="kaStatusFilter">Visa</label>
                <select class="form-select form-select-sm w-auto" id="kaStatusFilter"></select>
                <label class="visually-hidden" for="kaYear">Tävlingsår</label>
                <select class="form-select form-select-sm w-auto" id="kaYear"></select>
            </div>
        </div>
        <div class="card-body">
            <div class="small text-muted mb-2" id="kaForbundetDeadline"></div>
            <div id="kaBody"><div class="text-muted small">Laddar…</div></div>
        </div>
    </div>
</div>

@* EN dialog för alla beslut och för historiken — innehållet byggs per åtgärd. *@
<div class="modal fade" id="kaModal" tabindex="-1" aria-labelledby="kaModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kaModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="kaModalBody"></div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_HtmlEscape")
<script>
if (!window.hpskKretsApplicationsInit) {
window.hpskKretsApplicationsInit = function () {
    if (window.hpskKretsApplicationsInit.done) return;
    window.hpskKretsApplicationsInit.done = true;

    const root = document.querySelector('.ka-root');
    const REGION_ID = +root.getAttribute('data-region-id');
    // ⚠️ Dialogen flyttas till body — i adminpanelen ligger partialen i en flik.
    const modalEl = document.getElementById('kaModal');
    if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);
    const $ = id => document.getElementById(id);
    const esc = s => window.hpskEsc(s == null ? '' : String(s));
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;
    const base = '/umbraco/surface/CompetitionApplication/';
    let apps = {}, data = null, year = new Date().getFullYear() + 1;

    const post = (action, body) => fetch(base + action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
        body: new URLSearchParams(body).toString()
    }).then(r => r.json());

    const yearSel = $('kaYear');
    const now = new Date().getFullYear();
    for (let y = now - 1; y <= now + 2; y++) yearSel.insertAdjacentHTML('beforeend', '<option value="' + y + '"' + (y === year ? ' selected' : '') + '>' + y + '</option>');
    yearSel.addEventListener('change', () => { year = +yearSel.value; load(); });
    const filter = $('kaStatusFilter');
    filter.addEventListener('change', renderTable);

    function message(msg, ok) {
        const el = $('kaTopMessage');
        el.className = 'alert ' + (ok ? 'alert-success' : 'alert-warning') + ' py-2';
        el.textContent = msg;
    }
    function setRailCount(n) {
        const r = document.getElementById('regionApplicationsRailCount');
        if (r) { r.textContent = n; r.classList.toggle('d-none', n === 0); }
    }

    function load() {
        return fetch(base + 'GetRegionApplications?regionId=' + REGION_ID + '&year=' + year, { credentials: 'same-origin' })
            .then(r => r.json()).then(d => {
                if (!d.success) { $('kaBody').innerHTML = '<div class="alert alert-warning mb-0">' + esc(d.message) + '</div>'; return; }
                data = d; apps = {}; d.applications.forEach(a => apps[a.id] = a);
                $('kaForbundetDeadline').textContent = 'Förbundets sista dag för nationella tävlingar och landsdelstävlingar ' + year + ': ' + d.forbundetDeadline + '.';
                $('kaSummaryLink').href = '/kretsen/sammanstallning?krets=' + REGION_ID + '&year=' + year;
                renderPending();
                renderTable();
            }).catch(() => { $('kaBody').innerHTML = '<div class="alert alert-warning mb-0">Ansökningarna kunde inte hämtas. Försök igen om en stund.</div>'; });
    }

    const dateOf = a => a.grantedDate || a.competitionDate;
    const late = a => a.lateNote ? ' <span class="badge bg-danger-subtle text-danger-emphasis" title="' + esc(a.lateNote) + '">sen</span>' : '';

    function renderPending() {
        const open = data.applications.filter(a => a.status === 'Inskickad');
        $('kaPendingCard').classList.toggle('d-none', open.length === 0);
        $('kaPendingCount').textContent = open.length;
        $('kaBadge').textContent = open.length;
        $('kaBadge').classList.toggle('d-none', open.length === 0);
        setRailCount(open.length);
        $('kaPendingRows').innerHTML = open.map(a => '<tr>'
            + '<td class="small text-nowrap">' + esc(dateOf(a)) + '</td>'
            + '<td><strong>' + esc(a.name) + '</strong>' + late(a)
            + '<div class="small text-muted">' + esc(a.disciplineLabel) + (a.place ? ' · ' + esc(a.place) : '') + '</div>'
            + (a.completionReply ? '<div class="small text-success-emphasis"><i class="bi bi-chat-left-text me-1"></i>Klubbens komplettering: ' + esc(a.completionReply) + '</div>' : '')
            + (a.note ? '<div class="small text-muted fst-italic">”' + esc(a.note) + '”</div>' : '')
            + '</td>'
            + '<td class="small">' + esc(a.clubName) + '</td>'
            + '<td class="small">' + esc(a.levelLabel) + '</td>'
            + '<td class="text-end text-nowrap"><button type="button" class="btn btn-primary btn-sm" data-ka="decide" data-id="' + a.id + '">'
            + (a.needsForbundet ? 'Yttra' : 'Besluta') + ' <i class="bi bi-arrow-right ms-1"></i></button></td>'
            + '</tr>').join('');
    }

    const STATUS = [['all', 'Alla'], ['Komplettering', 'Väntar på klubben'], ['HosForbundet', 'Hos Förbundet'], ['Beviljad', 'Beviljade'], ['Avslagen', 'Avslagna'], ['Aterkallad', 'Återkallade']];
    function statusBadge(a) {
        switch (a.status) {
            case 'Komplettering': return '<span class="badge bg-light text-dark border">Väntar på klubben</span>';
            case 'HosForbundet': return '<span class="badge bg-info-subtle text-info-emphasis">Hos Förbundet</span>' + (a.sentToForbundetAt ? '<div class="small text-muted">skickad ' + esc(a.sentToForbundetAt) + '</div>' : '<div class="small text-muted">inte skickad än</div>');
            case 'Beviljad': return '<span class="badge bg-success">Beviljad</span>';
            case 'Avslagen': return '<span class="badge bg-danger">Avslagen</span>';
            default: return '<span class="badge bg-secondary">' + esc(a.statusLabel) + '</span>';
        }
    }
    function rowMenu(a) {
        const items = [];
        if (a.status === 'HosForbundet') {
            items.push('<li><button class="dropdown-item" type="button" data-ka="forbundet" data-id="' + a.id + '"><i class="bi bi-bank me-2"></i>Registrera Förbundets beslut…</button></li>');
            if (!a.sentToForbundetAt) items.push('<li><button class="dropdown-item" type="button" data-ka="markSent" data-id="' + a.id + '"><i class="bi bi-send-check me-2"></i>Markera som skickad till Förbundet</button></li>');
        }
        if (a.competitionUrl) items.push('<li><a class="dropdown-item" href="' + esc(a.competitionUrl) + '"><i class="bi bi-box-arrow-up-right me-2"></i>Öppna tävlingen</a></li>');
        items.push('<li><button class="dropdown-item" type="button" data-ka="history" data-id="' + a.id + '"><i class="bi bi-clock-history me-2"></i>Visa ansökan och historik</button></li>');
        return '<div class="dropdown"><button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-popper-config=\'{"strategy":"fixed"}\' aria-expanded="false">'
            + '<i class="bi bi-sliders me-1"></i>Åtgärder</button><ul class="dropdown-menu dropdown-menu-end">' + items.join('') + '</ul></div>';
    }

    function renderTable() {
        const all = data.applications.filter(a => a.status !== 'Inskickad').sort((p, q) => dateOf(p).localeCompare(dateOf(q)));
        const counts = { all: all.length };
        all.forEach(a => counts[a.status] = (counts[a.status] || 0) + 1);
        const cur = filter.value || 'all';
        filter.innerHTML = STATUS.map(([v, l]) => '<option value="' + v + '"' + (v === cur ? ' selected' : '') + '>' + l + ' (' + (counts[v] || 0) + ')</option>').join('');
        const rows = cur === 'all' ? all : all.filter(a => a.status === cur);
        const unsent = data.applications.filter(a => a.status === 'HosForbundet' && !a.sentToForbundetAt);
        $('kaMarkAllItem').classList.toggle('d-none', unsent.length === 0);
        if (!all.length) {
            $('kaBody').innerHTML = '<div class="text-center text-muted py-4"><i class="bi bi-inbox display-6 d-block mb-2"></i><p class="mb-0 small">' + (data.applications.some(a => a.status === 'Inskickad') ? 'Inga andra ansökningar för ' : 'Inga ansökningar för ') + year + '.</p></div>';
            return;
        }
        $('kaBody').innerHTML = '<p class="small text-muted">Visar ' + rows.length + ' av ' + all.length + '.</p>'
            + '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Datum</th><th>Tävling</th><th>Klubb</th><th>Nivå</th><th>Status</th><th class="text-end"></th></tr></thead><tbody>'
            + rows.map(a => '<tr>'
                + '<td class="small text-nowrap">' + esc(dateOf(a)) + '</td>'
                + '<td>' + esc(a.name) + late(a) + (a.status === 'Komplettering' && a.completionRequest ? '<div class="small text-warning-emphasis">Kretsen bad om: ' + esc(a.completionRequest) + '</div>' : '') + '</td>'
                + '<td class="small">' + esc(a.clubName) + '</td>'
                + '<td class="small">' + esc(a.levelLabel) + '</td>'
                + '<td>' + statusBadge(a) + '</td>'
                + '<td class="text-end">' + rowMenu(a) + '</td></tr>').join('')
            + '</tbody></table></div>';
    }

    // ── Dialogerna ───────────────────────────────────────────────────────────────────
    const modal = () => bootstrap.Modal.getOrCreateInstance(modalEl);
    function openModal(title, html) { $('kaModalTitle').textContent = title; $('kaModalBody').innerHTML = html; modal().show(); }
    function resultBox(msg, ok) { const el = $('kaModalResult'); if (el) { el.className = 'mt-2 alert py-2 ' + (ok ? 'alert-success' : 'alert-warning'); el.textContent = msg || ''; } }
    const done = r => { if (!r.success) { resultBox(r.message, false); return; } modal().hide(); message(r.message, true); load(); };

    function summary(a) {
        const dt = (k, v) => v ? '<dt class="col-sm-4">' + esc(k) + '</dt><dd class="col-sm-8">' + esc(v) + '</dd>' : '';
        return '<dl class="row small mb-3">'
            + dt('Tävling', a.name) + dt('Klubb', a.clubName) + dt('Nivå och gren', a.levelLabel + ' · ' + a.disciplineLabel)
            + dt('Datum', a.competitionDate + (a.endDate ? ' – ' + a.endDate : '') + (a.reserveDate ? ' (reserv ' + a.reserveDate + ')' : ''))
            + dt('Plats', a.place) + dt('Klasser', a.classes)
            + dt('Kontakt', [a.contactName, a.contactEmail, a.contactPhone].filter(Boolean).join(', '))
            + dt('Meddelande', a.note) + dt('Klubbens komplettering', a.completionReply) + dt('Sen ansökan', a.lateNote)
            + '</dl>';
    }

    function decide(a) {
        const choices = a.needsForbundet
            ? [['tillstyrk', 'Tillstyrk — kretsen stödjer ansökan, Förbundet beslutar'], ['avstyrk', 'Avstyrk'], ['complete', 'Be klubben komplettera']]
            : [['approve', 'Godkänn ansökan'], ['reject', 'Avslå ansökan'], ['complete', 'Be klubben komplettera']];
        openModal(a.needsForbundet ? 'Kretsens yttrande' : 'Besluta om ansökan', summary(a)
            + '<div class="mb-2" role="radiogroup">' + choices.map(([v, l], i) => '<div class="form-check"><input class="form-check-input" type="radio" name="kaAct" id="kaAct' + v + '" value="' + v + '"' + (i === 0 ? ' checked' : '') + '><label class="form-check-label" for="kaAct' + v + '">' + l + '</label></div>').join('') + '</div>'
            + '<label class="form-label small" for="kaText">Motivering till klubben' + (a.needsForbundet ? ' och Förbundet' : '') + ' <span class="text-muted">(krävs vid avslag, avstyrkan och komplettering)</span></label>'
            + '<textarea class="form-control mb-2" id="kaText" rows="3" maxlength="4000"></textarea>'
            + '<button type="button" class="btn btn-primary" data-ka="decideSend" data-id="' + a.id + '">Skicka</button><div id="kaModalResult" role="status"></div>');
    }

    function forbundet(a) {
        openModal('Förbundets beslut', summary(a) + '<div class="row g-2">'
            + '<div class="col-md-4"><label class="form-label small mb-1" for="kaFd">Förbundets beslut</label><select class="form-select form-select-sm" id="kaFd"><option value="granted">Beviljad</option><option value="rejected">Avslagen</option></select></div>'
            + '<div class="col-md-4"><label class="form-label small mb-1" for="kaFdDate">Beslutsdatum</label><input class="form-control form-control-sm" id="kaFdDate" placeholder="ÅÅÅÅ-MM-DD"></div>'
            + '<div class="col-md-4"><label class="form-label small mb-1" for="kaFdGranted">Beviljat datum, om ändrat</label><input class="form-control form-control-sm" id="kaFdGranted" placeholder="' + esc(a.competitionDate) + '"></div>'
            + '<div class="col-12"><label class="form-label small mb-1" for="kaText">Förbundets motivering eller anteckning</label><textarea class="form-control" id="kaText" rows="2" maxlength="4000"></textarea></div>'
            + '</div><button type="button" class="btn btn-primary mt-2" data-ka="forbundetSend" data-id="' + a.id + '">Registrera beslutet</button><div id="kaModalResult" role="status"></div>');
        if (typeof flatpickr !== 'undefined') { flatpickr('#kaFdDate', { locale: 'sv', dateFormat: 'Y-m-d', maxDate: 'today', defaultDate: 'today' }); flatpickr('#kaFdGranted', { locale: 'sv', dateFormat: 'Y-m-d' }); }
    }

    function history(a) {
        fetch(base + 'GetApplication?id=' + a.id, { credentials: 'same-origin' }).then(r => r.json()).then(d => {
            const ev = d.success ? d.events : [];
            openModal(a.name, summary(a) + '<h6>Historik</h6><ul class="list-unstyled small mb-0">'
                + ev.map(e => '<li class="mb-1"><span class="text-muted">' + esc(e.at) + '</span> · <strong>' + esc(e.kindLabel) + '</strong>' + (e.byName ? ' · ' + esc(e.byName) : '') + (e.text ? '<div class="ms-3">' + esc(e.text) + '</div>' : '') + '</li>').join('')
                + '</ul>');
        });
    }

    const LEVELS = [['Krets', 'Kretstävling'], ['Landsdel', 'Landsdelstävling'], ['Nationell', 'Nationell tävling']];
    function deadlines() {
        const list = data.deadlines || [];
        openModal('Kretsens sista ansökningsdagar ' + year, '<p class="small text-muted">Klubbarna ser dagen när de ansöker. En ansökan som kommer senare märks som sen, men stoppas inte.</p><div class="row g-2">'
            + LEVELS.map(([v, l]) => { const c = list.find(x => x.level === v);
                return '<div class="col-md-4"><label class="form-label small mb-1" for="kaDl' + v + '">' + l + '</label>'
                    + '<div class="input-group input-group-sm"><input class="form-control" id="kaDl' + v + '" value="' + esc(c ? c.lastDate : '') + '" placeholder="ingen">'
                    + '<button class="btn btn-outline-primary" type="button" data-ka="dlSave" data-level="' + v + '">Spara</button></div></div>'; }).join('')
            + '</div><div id="kaModalResult" role="status"></div>');
        if (typeof flatpickr !== 'undefined') LEVELS.forEach(([v]) => flatpickr('#kaDl' + v, { locale: 'sv', dateFormat: 'Y-m-d', allowInput: true }));
    }

    // ── Grannkretsar (fas 4) ───────────────────────────────────────────────────────────
    // Standarden är gränsschemat; kretsen kan välja själv. Valet styr "Visa grannkretsar" i
    // kalendern OCH krockvarningarna, så att en krets som delar banor med en krets längre bort
    // kan se den som granne.
    function neighbours() {
        fetch(base + 'GetNeighbourSettings?regionId=' + REGION_ID, { credentials: 'same-origin' }).then(r => r.json()).then(d => {
            if (!d.success) { openModal('Kretsens grannkretsar', '<div class="alert alert-warning">' + esc(d.message) + '</div>'); return; }
            openModal('Kretsens grannkretsar',
                '<p class="small text-muted">Grannkretsarnas tävlingar visas i kretskalendern med växeln <strong>Visa grannkretsar</strong>, och kretsen varnas när en tävling i samma gren ligger samma dag hos en granne. '
                + 'Förvalt är kretsarna som gränsar till er.' + (d.isDefault ? ' <strong>Ni använder förvalet.</strong>' : ' <strong>Ni har valt själva.</strong>') + '</p>'
                + '<div class="row row-cols-1 row-cols-md-2 g-1" id="kaNbList">'
                + d.regions.map((r, i) => '<div class="col"><div class="form-check"><input class="form-check-input" type="checkbox" id="kaNb' + i + '" data-code-index="' + i + '"' + (r.chosen ? ' checked' : '') + '>'
                    + '<label class="form-check-label" for="kaNb' + i + '">' + esc(r.name) + (r.standard ? ' <span class="badge bg-light text-dark border">gränsar</span>' : '') + '</label></div></div>').join('')
                + '</div><div class="d-flex flex-wrap gap-2 mt-3"><button type="button" class="btn btn-primary" data-ka="nbSave">Spara</button>'
                + (d.isDefault ? '' : '<button type="button" class="btn btn-outline-secondary" data-ka="nbDefault">Återgå till förvalet</button>')
                + '</div><div id="kaModalResult" class="mt-2" role="status"></div>');
            window._kaNbCodes = d.regions.map(r => r.code);
        });
    }

    // ── Arrangörschecklista (fas 4) ────────────────────────────────────────────────────
    // Kretsens regler som uppgifter: arrangören lägger in dem i tävlingens förberedelser.
    let clData = null, clEdit = 0;
    function checklist() {
        fetch(base + 'GetOrganiserChecklist?regionId=' + REGION_ID, { credentials: 'same-origin' }).then(r => r.json()).then(d => {
            if (!d.success) { openModal('Kretsens arrangörschecklista', '<div class="alert alert-warning">' + esc(d.message) + '</div>'); return; }
            clData = d; renderChecklist();
        });
    }
    function renderChecklist(msg, ok) {
        const d = clData, items = d.items;
        const cur = items.find(x => x.id === clEdit) || {};
        openModal('Kretsens arrangörschecklista',
            '<p class="small text-muted">Punkterna erbjuds arrangören i förberedelserna för varje tävling i kretsen som de gäller. Arrangören lägger in dem som uppgifter och bockar av dem. '
            + 'Ändrar ni en punkt här rörs inte uppgifter som redan lagts in.</p>'
            + (items.length ? '<ol class="list-group list-group-numbered mb-3" id="kaClList">' + items.map((x, i) =>
                '<li class="list-group-item d-flex gap-2 align-items-start"><div class="ms-1 me-auto"><div class="fw-semibold">' + esc(x.title) + '</div>'
                + '<div class="small text-muted">' + esc(x.appliesToLabel) + (x.whenLabel ? ' · ' + esc(x.whenLabel) : '') + '</div>'
                + (x.description ? '<div class="small">' + esc(x.description) + '</div>' : '') + '</div>'
                + '<div class="btn-group btn-group-sm flex-none">'
                + '<button type="button" class="btn btn-outline-secondary" data-ka="clUp" data-id="' + x.id + '"' + (i === 0 ? ' disabled' : '') + ' aria-label="Flytta upp"><i class="bi bi-arrow-up"></i></button>'
                + '<button type="button" class="btn btn-outline-secondary" data-ka="clDown" data-id="' + x.id + '"' + (i === items.length - 1 ? ' disabled' : '') + ' aria-label="Flytta ner"><i class="bi bi-arrow-down"></i></button>'
                + '<button type="button" class="btn btn-outline-secondary" data-ka="clEdit" data-id="' + x.id + '">Ändra</button>'
                + '<button type="button" class="btn btn-outline-danger" data-ka="clRemove" data-id="' + x.id + '">Ta bort</button></div></li>').join('') + '</ol>'
              : '<div class="alert alert-light border small">Kretsen har inga punkter än. Exempel: <em>Skicka ett reportage till kretsens webbredaktör</em>, <em>Beställ KM-medaljer från kretsen</em>, <em>Betala lagavgiften till kretsens bankgiro</em>.</div>')
            + '<div class="card"><div class="card-body"><h6 class="mb-2">' + (clEdit ? 'Ändra punkten' : 'Ny punkt') + '</h6>'
            + '<label class="form-label small mb-1" for="kaClTitle">Vad ska arrangören göra?</label><input class="form-control mb-2" id="kaClTitle" maxlength="300" value="' + esc(cur.title || '') + '">'
            + '<label class="form-label small mb-1" for="kaClDesc">Förklaring <span class="text-muted">(valfri)</span></label><textarea class="form-control mb-2" id="kaClDesc" rows="2" maxlength="2000">' + esc(cur.description || '') + '</textarea>'
            + '<div class="row g-2"><div class="col-md-6"><label class="form-label small mb-1" for="kaClScope">Gäller</label><select class="form-select" id="kaClScope">'
            + d.scopes.map(s => '<option value="' + esc(s.value) + '"' + ((cur.appliesTo || 'All') === s.value ? ' selected' : '') + '>' + esc(s.label) + '</option>').join('') + '</select></div>'
            + '<div class="col-md-6"><label class="form-label small mb-1" for="kaClDays">Klar dagar före tävlingen <span class="text-muted">(valfritt)</span></label>'
            + '<input type="number" class="form-control" id="kaClDays" min="-365" max="730" value="' + (cur.daysBeforeComp ?? '') + '">'
            + '<div class="form-text">Negativt tal = efter tävlingen, till exempel −7 för ett reportage.</div></div></div>'
            + '<div class="d-flex gap-2 mt-2"><button type="button" class="btn btn-primary" data-ka="clSave">' + (clEdit ? 'Spara ändringen' : 'Lägg till punkten') + '</button>'
            + (clEdit ? '<button type="button" class="btn btn-outline-secondary" data-ka="clCancel">Avbryt</button>' : '') + '</div></div></div>'
            + '<div id="kaModalResult" class="mt-2" role="status"></div>');
        if (msg) resultBox(msg, ok);
    }
    function clReload(msg, ok) {
        return fetch(base + 'GetOrganiserChecklist?regionId=' + REGION_ID, { credentials: 'same-origin' }).then(r => r.json())
            .then(d => { if (d.success) clData = d; renderChecklist(msg, ok); });
    }

    document.addEventListener('click', function (e) {
        const b = e.target.closest('[data-ka]');
        if (!b || !(root.contains(b) || modalEl.contains(b))) return;
        const id = +(b.dataset.id || 0), a = apps[id], t = () => ($('kaText')?.value || '');
        switch (b.dataset.ka) {
            case 'decide': return decide(a);
            case 'forbundet': return forbundet(a);
            case 'history': return history(a);
            case 'deadlines': return data && deadlines();
            case 'neighbours': return neighbours();
            case 'nbSave': {
                const codes = (window._kaNbCodes || []).filter((c, i) => $('kaNb' + i)?.checked);
                return post('SaveNeighbours', { regionId: REGION_ID, codes: codes.join(',') }).then(r => { resultBox(r.message, r.success); });
            }
            case 'nbDefault': return post('SaveNeighbours', { regionId: REGION_ID, useDefault: '1' }).then(r => { if (r.success) neighbours(); });
            case 'checklist': clEdit = 0; return checklist();
            case 'clEdit': clEdit = id; return renderChecklist();
            case 'clCancel': clEdit = 0; return renderChecklist();
            case 'clSave': return post('SaveOrganiserChecklistItem', {
                    regionId: REGION_ID, id: clEdit, title: $('kaClTitle').value, description: $('kaClDesc').value,
                    daysBeforeComp: $('kaClDays').value, appliesTo: $('kaClScope').value
                }).then(r => { if (r.success) { const was = clEdit; clEdit = 0; clReload(was ? 'Punkten är ändrad.' : 'Punkten är tillagd.', true); } else resultBox(r.message, false); });
            case 'clRemove': return post('RemoveOrganiserChecklistItem', { regionId: REGION_ID, id }).then(r => { clEdit = 0; clReload(r.message, r.success); });
            case 'clUp': return post('MoveOrganiserChecklistItem', { regionId: REGION_ID, id, direction: -1 }).then(() => clReload());
            case 'clDown': return post('MoveOrganiserChecklistItem', { regionId: REGION_ID, id, direction: 1 }).then(() => clReload());
            case 'decideSend': {
                const act = document.querySelector('input[name="kaAct"]:checked').value;
                const call = act === 'approve' ? post('DecideApplication', { id, decision: 'approve', text: t() })
                    : act === 'reject' ? post('DecideApplication', { id, decision: 'reject', text: t() })
                    : act === 'complete' ? post('RequestCompletion', { id, text: t() })
                    : post('GiveOpinion', { id, opinion: act === 'tillstyrk' ? 'Tillstyrker' : 'Avstyrker', text: t() });
                return call.then(done);
            }
            case 'forbundetSend': return post('RegisterForbundetDecision', { id, decision: $('kaFd').value, decisionDate: $('kaFdDate').value, grantedDate: $('kaFdGranted').value, text: t() }).then(done);
            case 'markSent': return post('MarkSentToForbundet', { regionId: REGION_ID, ids: String(id) }).then(r => { message(r.message, r.success); if (r.success) load(); });
            case 'markAllSent': {
                const ids = data.applications.filter(x => x.status === 'HosForbundet' && !x.sentToForbundetAt).map(x => x.id);
                if (!ids.length) return;
                return post('MarkSentToForbundet', { regionId: REGION_ID, ids: ids.join(',') }).then(r => { message(r.message, r.success); if (r.success) load(); });
            }
            case 'dlSave': {
                const lvl = b.dataset.level;
                return post('SetDeadline', { regionId: REGION_ID, year, level: lvl, lastDate: $('kaDl' + lvl).value }).then(r => { resultBox(r.message, r.success); if (r.success) load(); });
            }
        }
    });

    load();
};
}
</script>
