@*
    Kortet "Medaljer och priser" på Resultat-fliken (precisionsfamiljen OCH fältet delar det).

    Klubbens egna medaljregler (plan v2, S3): paket (som förbundets mästerskap / tre bästa i varje klass / bäste skytt per vapengrupp,
    och Inga medaljer utanför mästerskap), antal som får medalj och hur lika resultat avgörs. Kortet är HELT EGET: det visar vad som
    gäller nu och ändras på stället (Ändra → formuläret öppnas i kortet självt, inte i en annan sektion). Sparar genom
    CompetitionResults/SetMedalGrouping, som räknar om listan i samma handling och kräver bekräftelse när något redan är utdelat.

    Dolt tills servern säger att ytan gäller tävlingen (GetMedalRules.enabled): sajtinställningen Medals:ClubRules är på, nivån tillåter
    val (inte SM/landsdel) och grenen är inte springskytte/skidskytte. Efter en sparning skickas händelsen hpsk:medal-rules-saved, som
    värdsidan lyssnar på för att ladda om listan.

    ⚠️ Inga @-tecken i skriptet (Razor).
*@
@model string
@{
    var mrCompetitionId = Model ?? "";
}

<div class="card mb-3 d-none" id="medalRulesCard" data-competition-id="@mrCompetitionId">
    <div class="card-header py-2 d-flex align-items-center flex-wrap gap-2">
        <h6 class="mb-0 me-auto" style="font-size:1rem"><i class="bi bi-award me-2"></i>Medaljer och priser</h6>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="medalRulesEditBtn" onclick="hpskMedalRules.edit()">
            <i class="bi bi-pencil me-1"></i>Ändra
        </button>
    </div>
    <div class="card-body py-3">
        <div id="medalRulesSummary" class="small">Laddar…</div>
        <div id="medalRulesLocked" class="text-muted small mt-2 d-none"><i class="bi bi-lock me-1"></i>Låst av förbundet: vid svenskt mästerskap och landsdelsmästerskap delas medaljerna ut enligt förbundets regler, så här finns inget att välja.</div>
        <div id="medalRulesFlash" class="alert alert-success small py-2 mt-2 mb-0 d-none" role="status"></div>
        <div id="medalRulesForm" class="mt-3 d-none"></div>
    </div>
</div>

<script>
window.hpskMedalRules = (function () {
    var state = null;

    function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
    }
    function card() { return document.getElementById('medalRulesCard'); }
    function compId() { var c = card(); return c ? c.dataset.competitionId : ''; }
    function token() { var t = document.querySelector('input[name="__RequestVerificationToken"]'); return t ? t.value : ''; }
    function flash(text) {
        var el = document.getElementById('medalRulesFlash');
        if (!el) return;
        el.textContent = text || '';
        el.classList.toggle('d-none', !text);
    }

    async function load() {
        var c = card();
        if (!c || !compId()) return;
        try {
            var res = await fetch('/umbraco/surface/CompetitionResults/GetMedalRules?competitionId=' + compId());
            var d = await res.json();
            if (!d || !d.success || !d.enabled) { c.classList.add('d-none'); return; }
            state = d;
            document.getElementById('medalRulesSummary').textContent = d.summary || '';
            // Låst (SM/landsdel): förbundets regler, inget val — summan visas men Ändra och formuläret göms.
            document.getElementById('medalRulesLocked').classList.toggle('d-none', !d.locked);
            document.getElementById('medalRulesEditBtn').classList.toggle('d-none', !!d.locked);
            document.getElementById('medalRulesForm').classList.add('d-none');
            c.classList.remove('d-none');
        } catch (e) {
            console.error('medalRules.load', e);
        }
    }

    function radio(value, title, sub, initMode) {
        var id = 'mrcMode_' + (value || 'none');
        return '<div class="form-check mb-1">' +
            '<input class="form-check-input" type="radio" name="mrcMode" id="' + id + '" value="' + value + '"' +
            (initMode === value ? ' checked' : '') + ' onchange="hpskMedalRules.modeChanged()">' +
            '<label class="form-check-label" for="' + id + '">' + title +
            '<span class="text-muted d-block small">' + sub + '</span></label></div>';
    }
    function opt(value, label, current) {
        return '<option value="' + value + '"' + (String(current) === String(value) ? ' selected' : '') + '>' + label + '</option>';
    }

    function edit() {
        if (!state || state.locked) return;
        flash('');
        var champ = !!state.isChampionshipScope;
        // Det som gäller nu: ett lagrat läge, annars förbundets (mästerskap) eller inga medaljer.
        var initMode = state.mode || (state.awards ? 'shb' : '');
        var places = Number(state.places || 0);
        var tie = state.tieRule || 'shootoff';
        var html =
            '<div class="fw-semibold small mb-2">Hur delas medaljerna ut?</div>' +
            (champ ? '' : radio('', 'Inga medaljer', 'Tävlingen delar inte ut medaljer', initMode)) +
            radio('shb', 'Som förbundets mästerskap', 'A, B och C, och i C även Dam, Vet Y, Vet Ä och Junior var för sig', initMode) +
            radio('class', 'Tre bästa i varje klass', 'A1, A2 och A3 var för sig (sammanslagna klasser räknas som en klass, så som listan visar dem)', initMode) +
            radio('weapongroup', 'Bäste skytt per vapengrupp', 'En uppsättning medaljer för hela A, hela B och hela C', initMode) +
            '<div id="mrcDetails" class="mt-3' + (initMode === '' ? ' d-none' : '') + '">' +
            '<label class="form-label small mb-1" for="mrcPlaces">Antal som får medalj</label>' +
            '<select class="form-select form-select-sm mb-2" id="mrcPlaces" style="max-width:26rem">' +
            opt(0, 'Som förbundet (färre medaljer när det är få deltagare)', places) +
            opt(1, 'Bara guld', places) + opt(2, 'Guld och silver', places) + opt(3, 'Guld, silver och brons', places) +
            '</select>' +
            '<label class="form-label small mb-1" for="mrcTie">Vid lika resultat på en medaljplats</label>' +
            '<select class="form-select form-select-sm" id="mrcTie" style="max-width:26rem">' +
            opt('shootoff', 'Särskjutning', tie) + opt('shared', 'Delad plats (samma medalj till båda)', tie) +
            opt('series', 'Serieräkningen avgör (ingen särskjutning)', tie) +
            '</select></div>' +
            '<div id="mrcError" class="alert alert-danger small py-2 mt-3 mb-0 d-none" role="alert"></div>' +
            '<div class="d-flex gap-2 mt-3">' +
            '<button type="button" class="btn btn-primary btn-sm" id="mrcSave" onclick="hpskMedalRules.save()">Spara och räkna om listan</button>' +
            '<button type="button" class="btn btn-outline-secondary btn-sm" onclick="hpskMedalRules.cancel()">Avbryt</button>' +
            '</div>' +
            '<div class="form-text mt-2">Gäller bara den här tävlingen. Listan räknas om när du sparar.</div>';
        var form = document.getElementById('medalRulesForm');
        form.innerHTML = html;
        form.dataset.initMode = initMode;
        form.dataset.initPlaces = String(places);
        form.dataset.initTie = tie;
        form.classList.remove('d-none');
        document.getElementById('medalRulesEditBtn').classList.add('d-none');
    }

    function cancel() {
        document.getElementById('medalRulesForm').classList.add('d-none');
        document.getElementById('medalRulesEditBtn').classList.remove('d-none');
    }

    function modeChanged() {
        var picked = document.querySelector('#medalRulesForm input[name="mrcMode"]:checked');
        var details = document.getElementById('mrcDetails');
        var places = document.getElementById('mrcPlaces');
        if (!picked || !details || !places) return;
        details.classList.toggle('d-none', picked.value === '');
        // Förslag: per klass och per vapengrupp delar klubbar oftast ut till de tre bästa.
        if ((picked.value === 'class' || picked.value === 'weapongroup') && places.value === '0') places.value = '3';
    }

    function confirmChange(text) {
        return new Promise(function (resolve) {
            var modal = document.createElement('div');
            modal.className = 'modal fade';
            modal.tabIndex = -1;
            modal.innerHTML =
                '<div class="modal-dialog"><div class="modal-content">' +
                '<div class="modal-header"><h5 class="modal-title">Ändra medaljreglerna?</h5>' +
                '<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button></div>' +
                '<div class="modal-body"><p class="mb-0">' + esc(text) + '</p></div>' +
                '<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>' +
                '<button type="button" class="btn btn-warning" id="mrcConfirmBtn">Ja, ändra och räkna om</button></div>' +
                '</div></div>';
            document.body.appendChild(modal);
            var m = new bootstrap.Modal(modal);
            var answered = false;
            modal.querySelector('#mrcConfirmBtn').addEventListener('click', function () { answered = true; resolve(true); m.hide(); });
            modal.addEventListener('hidden.bs.modal', function () { if (!answered) resolve(false); modal.remove(); });
            m.show();
        });
    }

    async function post(body) {
        var res = await fetch('/umbraco/surface/CompetitionResults/SetMedalGrouping', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        });
        if (!res.ok) return { success: false, message: 'Medaljreglerna kunde inte sparas (' + res.status + '). Inget är ändrat.' };
        return res.json();
    }

    async function save() {
        var form = document.getElementById('medalRulesForm');
        var picked = form.querySelector('input[name="mrcMode"]:checked');
        var err = document.getElementById('mrcError');
        err.classList.add('d-none');
        if (!picked) return;
        var mode = picked.value;
        var places = mode === '' ? 0 : Number(document.getElementById('mrcPlaces').value);
        var tie = mode === '' ? 'shootoff' : document.getElementById('mrcTie').value;
        if (mode === form.dataset.initMode && places === Number(form.dataset.initPlaces) && tie === form.dataset.initTie) {
            cancel();
            return;
        }
        var btn = document.getElementById('mrcSave');
        btn.disabled = true;
        try {
            var body = { competitionId: parseInt(compId(), 10), mode: mode, places: places, tieRule: tie, confirm: false };
            var d = await post(body);
            if (d.needsConfirm) {
                if (!await confirmChange(d.message)) { btn.disabled = false; return; }
                body.confirm = true;
                d = await post(body);
            }
            if (!d.success) {
                err.textContent = d.message || 'Medaljreglerna kunde inte sparas. Inget är ändrat.';
                err.classList.remove('d-none');
                btn.disabled = false;
                return;
            }
            cancel();
            await load();
            flash(d.message ? d.message : 'Sparat. Listan är omräknad.');
            document.dispatchEvent(new CustomEvent('hpsk:medal-rules-saved'));
        } catch (e) {
            console.error('medalRules.save', e);
            err.textContent = 'Ingen kontakt med servern — inget är sparat.';
            err.classList.remove('d-none');
            btn.disabled = false;
        }
    }

    document.addEventListener('DOMContentLoaded', load);
    return { edit: edit, cancel: cancel, save: save, modeChanged: modeChanged, reload: load };
})();
</script>
