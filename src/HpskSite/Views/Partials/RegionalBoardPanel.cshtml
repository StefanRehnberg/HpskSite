@*
 * Regional Board Panel - Read-only display of regional board members.
 * Shows only IsBoardMember=true entries, sorted by role hierarchy.
 * Requires ViewBag: regionContentId (int)
 *@

@{
    var regionId = ViewBag.regionContentId as int? ?? 0;
}

<div class="card">
    <div class="card-header">
        <h5 class="mb-0"><i class="bi bi-award me-2"></i>Styrelsen</h5>
    </div>
    <div class="card-body">
        <div id="regionalBoardContainer">
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Laddar...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(function() {
    const regionId = @regionId;
    const canManage = @((ViewBag.regionBoardCanManage as bool? ?? false) ? "true" : "false");

    // Fliken finns i det gamla skalet (ladda när den visas); på en egen sida (/styrelsen/) finns ingen flik — ladda direkt.
    const tabEl = document.getElementById('regionBoard-tab');
    let loaded = false;
    function loadOnce() { if (!loaded) { loaded = true; loadRegionalBoard(); } }
    if (tabEl) {
        tabEl.addEventListener('shown.bs.tab', loadOnce);
        if (tabEl.classList.contains('active')) loadOnce();
    } else {
        loadOnce();
    }

    function loadRegionalBoard() {
        const container = document.getElementById('regionalBoardContainer');
        fetch(`/umbraco/surface/BoardRole/GetBoardMembers?ownerType=1&ownerId=${regionId}&boardOnly=true`)
            .then(r => r.json())
            .then(data => {
                if (!data.success || !data.data || data.data.length === 0) {
                    container.innerHTML = canManage
                        ? '<div class="alert alert-info mb-0"><div class="fw-semibold mb-1"><i class="bi bi-info-circle me-1"></i>Ingen styrelse har lagts till ännu</div>'
                            + '<p class="mb-2">Så här lägger du till styrelsemedlemmar: öppna <a href="/styrelse?type=1&id=' + regionId + '&tab=styrelse" class="alert-link">Styrelsearbete</a> '
                            + '(finns också i Admin-menyn på kretssidan), välj <strong>Styrelsen och mandat</strong> och klicka på <strong>Lägg till förtroendevald…</strong>. '
                            + 'Välj person och roll och låt <em>Sitter i styrelsen</em> vara ibockat — då visas personen här.</p>'
                            + '<p class="mb-0 small text-muted">Den här rutan syns bara för kretsens administratörer; besökare ser en kort notis.</p></div>'
                        : '<p class="text-muted text-center py-3">Kretsens styrelse har inte registrerats ännu.</p>';
                    return;
                }

                let html = '<div class="table-responsive"><table class="table table-hover">';
                html += '<thead><tr><th>Roll</th><th>Namn</th></tr></thead><tbody>';

                data.data.forEach(r => {
                    html += `<tr>
                        <td><span class="badge bg-primary">${esc(r.title)}</span></td>
                        <td>${esc(r.memberName || '-')}</td>
                    </tr>`;
                });

                html += '</tbody></table></div>';
                container.innerHTML = html;
            })
            .catch(() => {
                container.innerHTML = '<p class="text-danger">Kunde inte ladda styrelsemedlemmar.</p>';
            });
    }

    function esc(str) {
        if (!str) return '';
        const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return str.toString().replace(/[&<>"']/g, m => map[m]);
    }
})();
</script>
