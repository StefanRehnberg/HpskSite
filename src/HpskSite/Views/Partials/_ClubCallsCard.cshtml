@*
    Kretsutlysningen F3 — klubbens kort "Tävlingar kretsen har utlyst", överst i klubbadminpanelens Tävlingar-flik.
    Klubben ser vad kretsen utlyst, trycker "Vi vill arrangera" (valfritt förslag till dag + ett meddelande) och kan ångra sig
    så länge kretsen inte utsett en klubb. Utsedd klubb syns som rubrik för alla klubbar i kretsen.

    ViewData["CallsClubId"] = klubbens id. Kortet döljer sig självt när kretsen inte utlyst något för året — ingen tom ruta
    för klubbar vars krets inte använder utlysningen.

    ⚠️ ORDEN: utlysa · önska · utse. Aldrig "ansök" (det är klubb → krets) eller "tilldela".
    ⚠️ Formen är kodbasens: EN dialog, inga prompt()/alert(), knappar bär bara id:n (aldrig fritext i attribut),
       avstängd handling har alltid sin förklaring som text.
    ⚠️ Andra klubbars önskemål visas med namn, förslag och meddelande — aldrig kontaktuppgifter (servern skickar dem inte).
*@
@{
    var callsClubId = ViewData["CallsClubId"] as int? ?? 0;
}
@if (callsClubId > 0)
{
@await Html.PartialAsync("_HtmlEscape")
<div class="card mb-3 d-none" id="ccCard" data-club-id="@callsClubId">
    @Html.AntiForgeryToken()
    <div class="card-header py-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <strong><i class="bi bi-calendar-event me-1"></i>Tävlingar <span id="ccRegion">kretsen</span> har utlyst</strong>
            <span class="text-muted small d-block">Kretsen utlyser årets tävlingar och utser vilken klubb som arrangerar. Önska de ni vill arrangera.</span>
        </div>
        <div>
            <label class="visually-hidden" for="ccYear">Tävlingsår</label>
            <select class="form-select form-select-sm w-auto" id="ccYear"></select>
        </div>
    </div>
    <div class="card-body">
        <div id="ccMessage"></div>
        <div id="ccBody"><div class="text-muted small">Laddar…</div></div>
    </div>
</div>

<div class="modal fade" id="ccModal" tabindex="-1" aria-labelledby="ccModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ccModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="ccModalBody"></div>
        </div>
    </div>
</div>

<script>
(function () {
    const card = document.getElementById('ccCard');
    if (!card) return;
    const CLUB_ID = +card.getAttribute('data-club-id');
    const modalEl = document.getElementById('ccModal');
    // ⚠️ Dialogen flyttas till body — i adminpanelen ligger partialen i en flik.
    if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);
    const modal = () => bootstrap.Modal.getOrCreateInstance(modalEl);
    const $ = id => document.getElementById(id);
    const esc = s => window.hpskEsc(s == null ? '' : String(s));
    const token = () => card.querySelector('input[name="__RequestVerificationToken"]').value;
    const base = '/umbraco/surface/CompetitionCallClub/';
    const MONTHS = ['januari', 'februari', 'mars', 'april', 'maj', 'juni', 'juli', 'augusti', 'september', 'oktober', 'november', 'december'];
    let data = null, calls = {}, year = null, shown = false;

    const post = (action, body) => fetch(base + action, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
        body: new URLSearchParams(body).toString()
    }).then(r => r.json());
    const dateText = d => { if (!d) return ''; const p = d.split('-'); return +p[2] + ' ' + MONTHS[+p[1] - 1] + ' ' + p[0]; };
    function say(msg, ok) { const el = $('ccMessage'); el.className = 'alert ' + (ok ? 'alert-success' : 'alert-warning') + ' py-2'; el.textContent = msg; }

    function load() {
        const q = base + 'GetForClub?clubId=' + CLUB_ID + (year ? '&year=' + year : '');
        return fetch(q, { credentials: 'same-origin' }).then(r => r.json()).then(d => {
            if (!d.success) { if (shown) $('ccBody').innerHTML = '<div class="alert alert-warning mb-0">' + esc(d.message) + '</div>'; return; }
            data = d; year = d.year;
            calls = {}; d.calls.forEach(c => calls[c.id] = c);
            // Inget utlyst och kortet har aldrig visats: dölj det helt.
            if (!d.calls.length && !shown) { card.classList.add('d-none'); return; }
            shown = true; card.classList.remove('d-none');
            $('ccRegion').textContent = d.regionName || 'kretsen';
            $('ccYear').innerHTML = d.years.map(y => '<option value="' + y + '"' + (y === year ? ' selected' : '') + '>' + y + '</option>').join('');
            render();
        }).catch(() => { if (shown) $('ccBody').innerHTML = '<div class="alert alert-warning mb-0">Utlysningarna kunde inte läsas just nu. Försök igen om en stund.</div>'; });
    }

    function stateCell(c) {
        // text-wrap: ett långt klubbnamn bryts i stället för att klippas på telefon.
        if (c.state === 'awarded-me') return '<span class="badge bg-success text-wrap text-start">Ni är utsedda att arrangera</span>';
        if (c.state === 'awarded-other') return '<span class="badge bg-secondary text-wrap text-start">Går i år till ' + esc(c.awardedClub) + '</span>';
        if (c.state === 'wished') return '<span class="badge bg-primary text-wrap text-start">Ni har önskat</span>'
            + (c.mine && c.mine.byKrets ? '<div class="small text-muted">Registrerat av kretsen</div>' : '');
        return '<span class="badge bg-light text-dark border">Utlyst</span>';
    }
    function actionCell(c) {
        if (c.state === 'wished' && c.canUnwish)
            return '<button class="btn btn-outline-secondary btn-sm" type="button" data-cc="unwish" data-id="' + c.id + '">Ångra</button>';
        if (c.state === 'open') {
            if (c.canWish) return '<button class="btn btn-primary btn-sm" type="button" data-cc="wish" data-id="' + c.id + '">Vi vill arrangera</button>';
            return '<span class="small text-muted">' + esc(c.whyNotWish || '') + '</span>';
        }
        return '';
    }
    function render() {
        if (!data.calls.length) { $('ccBody').innerHTML = '<div class="text-muted">Kretsen har inte utlyst några tävlingar för ' + year + ' ännu.</div>'; return; }
        let h = '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr>'
            + '<th>Datum</th><th>Tävling</th><th class="d-none d-md-table-cell">Läge</th><th class="text-end"></th></tr></thead><tbody>';
        data.calls.forEach(c => {
            const when = c.date ? '<div class="fw-semibold">' + esc(c.weekday) + ' ' + esc(dateText(c.date)) + '</div>'
                + (c.locked ? '<div class="small text-muted"><i class="bi bi-lock me-1"></i>Fastställt av kretsen</div>' : '')
                : '<span class="text-muted">Datum inte bestämt</span>';
            const others = c.others && c.others.length
                ? '<div class="small text-muted mt-1">Önskat av: ' + c.others.map(o => esc(o.club) + (o.proposedDate ? ' (föreslår ' + esc(dateText(o.proposedDate)) + ')' : '')).join(', ') + '</div>' : '';
            const mine = c.mine && (c.mine.proposedDate || c.mine.note) ? '<div class="small mt-1">' + (c.mine.proposedDate ? 'Ert förslag: ' + esc(dateText(c.mine.proposedDate)) + '. ' : '') + (c.mine.note ? 'Ert meddelande: ' + esc(c.mine.note) : '') + '</div>' : '';
            const deadline = c.state === 'open' && c.wishDeadline ? '<div class="small text-muted mt-1">Önska senast ' + esc(dateText(c.wishDeadline)) + '</div>' : '';
            h += '<tr><td>' + when + '</td><td><div class="fw-semibold">' + esc(c.name) + '</div>'
                + (c.disciplineLabel ? '<div class="small text-muted">' + esc(c.disciplineLabel) + '</div>' : '')
                + (c.description ? '<div class="small">' + esc(c.description) + '</div>' : '')
                + '<div class="d-md-none mt-1">' + stateCell(c) + '</div>' + deadline + mine + others + '</td>'
                + '<td class="d-none d-md-table-cell">' + stateCell(c) + '</td><td class="text-end">' + actionCell(c) + '</td></tr>';
        });
        $('ccBody').innerHTML = h + '</tbody></table></div>';
    }

    function openModal(title, bodyHtml) { $('ccModalTitle').textContent = title; $('ccModalBody').innerHTML = bodyHtml; modal().show(); }
    function wishModal(c) {
        openModal('Vi vill arrangera ' + c.name,
            '<div id="ccFormMsg"></div>'
            + '<p class="small text-muted">Kretsen får en notis om ert önskemål och utser sedan en klubb. Ni kan ångra er tills dess.</p>'
            + '<div class="mb-3"><label class="form-label fw-semibold" for="ccDate">Förslag till dag (valfritt)</label>'
            + '<input class="form-control" type="date" id="ccDate" value="">'
            + (c.locked ? '<div class="form-text">Kretsen har fastställt datumet – ert förslag är bara ett förslag.</div>' : '<div class="form-text">Lämna tomt om ni passar på kretsens dag eller inte har någon önskad dag.</div>') + '</div>'
            + '<div class="mb-3"><label class="form-label fw-semibold" for="ccNote">Meddelande till kretsen (valfritt)</label><textarea class="form-control" id="ccNote" rows="3" maxlength="500"></textarea></div>'
            + '<div class="d-flex gap-2 justify-content-end"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Avbryt</button>'
            + '<button class="btn btn-primary" type="button" id="ccSend" data-id="' + c.id + '">Skicka önskemål</button></div>');
    }
    function send() {
        const b = $('ccSend'); b.disabled = true;
        post('Wish', { clubId: CLUB_ID, id: b.dataset.id, proposedDate: $('ccDate').value, note: $('ccNote').value }).then(d => {
            if (!d.success) { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message) + '</div>'; return; }
            modal().hide(); say(d.message, true); load();
        }).catch(() => { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">Det gick inte att skicka. Försök igen.</div>'; });
    }
    function unwishModal(c) {
        openModal('Ångra önskemålet', '<div id="ccFormMsg"></div><p>Ni önskar inte längre arrangera <b>' + esc(c.name) + '</b>.</p>'
            + '<div class="d-flex gap-2 justify-content-end"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Behåll önskemålet</button>'
            + '<button class="btn btn-warning" type="button" id="ccUnwish" data-id="' + c.id + '">Ångra</button></div>');
    }
    function unwish() {
        const b = $('ccUnwish'); b.disabled = true;
        post('Unwish', { clubId: CLUB_ID, id: b.dataset.id }).then(d => {
            if (!d.success) { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message) + '</div>'; return; }
            modal().hide(); say(d.message, true); load();
        }).catch(() => { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">Något gick fel. Ladda om sidan och försök igen.</div>'; });
    }

    document.addEventListener('click', ev => {
        const t = ev.target.closest('[data-cc], #ccSend, #ccUnwish');
        if (!t || (!card.contains(t) && !modalEl.contains(t))) return;
        if (t.id === 'ccSend') return send();
        if (t.id === 'ccUnwish') return unwish();
        const c = calls[+t.dataset.id];
        if (!c) return;
        if (t.dataset.cc === 'wish') return wishModal(c);
        if (t.dataset.cc === 'unwish') return unwishModal(c);
    });
    $('ccYear').addEventListener('change', () => { year = +$('ccYear').value; load(); });
    load();
})();
</script>
}
