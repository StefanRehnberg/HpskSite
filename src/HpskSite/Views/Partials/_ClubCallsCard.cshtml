@*
    Kretsutlysningen F3 — klubbens kort "Tävlingar kretsen har utlyst", överst i klubbadminpanelens Tävlingar-flik.
    Klubben ser vad kretsen utlyst, trycker "Vi vill arrangera" (valfritt förslag till dag + ett meddelande) och kan ångra sig
    så länge kretsen inte utsett en klubb. Utsedd klubb syns som rubrik för alla klubbar i kretsen.

    ViewData["CallsClubId"] = klubbens id. Sidan är en egen post i klubbadminens räls (#clubCallsTab, "Utlysningar från kretsen"). Rälsposten
    och mobilvalet är dolda tills servern svarat att kretsen utlyst något (railUpdate) — ingen tom plats för klubbar vars krets inte
    använder utlysningen. Gult märke = utlysningar som går att önska.

    ⚠️ ORDEN: utlysa · önska · utse. Aldrig "ansök" (det är klubb → krets) eller "tilldela".
    ⚠️ Formen är kodbasens: EN dialog, inga prompt()/alert(), knappar bär bara id:n (aldrig fritext i attribut),
       avstängd handling har alltid sin förklaring som text.
    ⚠️ Andra klubbars önskemål visas med namn, förslag och meddelande — aldrig kontaktuppgifter (servern skickar dem inte).
*@
@{
    var callsClubId = ViewData["CallsClubId"] as int? ?? 0;
}
@if (callsClubId > 0)
{
@await Html.PartialAsync("_HtmlEscape")
@* Egen plats i rälsen (Utlysningar från kretsen). Sidan har inga sidhandlingar, så ingen blå Åtgärder. *@
<div id="ccCard" data-club-id="@callsClubId">
    @Html.AntiForgeryToken()
    <h5 class="mb-2"><i class="bi bi-calendar-event me-2"></i>Utlysningar från kretsen</h5>
    <p class="text-muted small"><span id="ccRegion">Kretsen</span> utlyser årets tävlingar och utser vilken klubb som arrangerar. Önska de ni vill arrangera.</p>
    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
        <div class="d-flex align-items-center gap-2">
            <label class="small mb-0" for="ccYear">År</label>
            <select class="form-select form-select-sm w-auto" id="ccYear"></select>
        </div>
        <span class="small text-muted ms-auto" id="ccCount"></span>
    </div>
    <div id="ccMessage" role="status"></div>
    <div id="ccBody"><div class="text-muted small">Laddar…</div></div>
</div>

<style>
    /* Fältet under sin etikett och kalendern inom dialogen (telefon): flatpickr static sitter annars till höger om fältet och klipps. */
    #ccModalBody .mb-3 { display: block; position: relative; }
    #ccModalBody .mb-3 > .form-label { display: block; }
    #ccModalBody .flatpickr-wrapper { display: block; }
    #ccModalBody .flatpickr-calendar.static { left: 0; right: auto; max-width: 100%; }
    @@media (max-width: 575.98px) { #ccModalBody .flatpickr-calendar.static.open { position: relative; top: 4px; margin-bottom: 8px; } }
    @@media (max-width: 575.98px) { #ccModalBody .flatpickr-calendar.static { width: 100%; } #ccModalBody .flatpickr-calendar .dayContainer { width: 100%; min-width: 0; max-width: 100%; } #ccModalBody .flatpickr-calendar .flatpickr-days { width: 100%; } #ccModalBody .flatpickr-day { max-width: none; } }
</style>
<div class="modal fade" id="ccModal" tabindex="-1" aria-labelledby="ccModalTitle" aria-hidden="true" data-bs-backdrop="static" data-bs-focus="false">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ccModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="ccModalBody"></div>
        </div>
    </div>
</div>

<script>
(function () {
    const card = document.getElementById('ccCard');
    if (!card) return;
    const CLUB_ID = +card.getAttribute('data-club-id');
    const modalEl = document.getElementById('ccModal');
    // ⚠️ Dialogen flyttas till body — i adminpanelen ligger partialen i en flik.
    if (modalEl.parentNode !== document.body) document.body.appendChild(modalEl);
    const modal = () => bootstrap.Modal.getOrCreateInstance(modalEl);
    const $ = id => document.getElementById(id);
    const esc = s => window.hpskEsc(s == null ? '' : String(s));
    const token = () => card.querySelector('input[name="__RequestVerificationToken"]').value;
    const base = '/umbraco/surface/CompetitionCallClub/';
    const MONTHS = ['januari', 'februari', 'mars', 'april', 'maj', 'juni', 'juli', 'augusti', 'september', 'oktober', 'november', 'december'];
    let data = null, calls = {}, year = null, shown = false;

    const post = (action, body) => fetch(base + action, {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
        body: new URLSearchParams(body).toString()
    }).then(r => r.json());
    const dateText = d => { if (!d) return ''; const p = d.split('-'); return +p[2] + ' ' + MONTHS[+p[1] - 1] + ' ' + p[0]; };
    function say(msg, ok) { const el = $('ccMessage'); el.className = 'alert ' + (ok ? 'alert-success' : 'alert-warning') + ' py-2'; el.textContent = msg; }

    // Rälsposten + mobilvalet visas när klubben har något här; det gula märket = utlysningar ni kan önska.
    function railUpdate() {
        const btn = $('clubCalls-tab'); if (!btn) return;
        btn.classList.remove('d-none'); btn.classList.add('d-flex');
        const opt = $('clubCallsOption'); if (opt) opt.hidden = false;
        const n = data ? data.calls.filter(c => c.state === 'open' && c.canWish).length : 0;
        const badge = $('ccRailCount');
        if (badge) { badge.textContent = n; badge.classList.toggle('d-none', n === 0); }
        if (opt) opt.textContent = 'Utlysningar från kretsen' + (n ? ' (' + n + ')' : '');
        document.dispatchEvent(new CustomEvent('hpsk-club-needs', { detail: { key: 'calls', count: n } }));
    }

    function load() {
        const q = base + 'GetForClub?clubId=' + CLUB_ID + (year ? '&year=' + year : '');
        return fetch(q, { credentials: 'same-origin' }).then(r => r.json()).then(d => {
            if (!d.success) { if (shown) $('ccBody').innerHTML = '<div class="alert alert-warning mb-0">' + esc(d.message) + '</div>'; return; }
            data = d; year = d.year;
            calls = {}; d.calls.forEach(c => calls[c.id] = c);
            // Inget utlyst och platsen har aldrig visats: rälsposten förblir dold (klubbar vars krets inte utlyser något ser ingen tom plats).
            if (!d.calls.length && !shown) return;
            shown = true; railUpdate();
            $('ccRegion').textContent = d.regionName || 'Kretsen';
            $('ccCount').textContent = d.calls.length + (d.calls.length === 1 ? ' utlysning' : ' utlysningar');
            $('ccYear').innerHTML = d.years.map(y => '<option value="' + y + '"' + (y === year ? ' selected' : '') + '>' + y + '</option>').join('');
            render();
        }).catch(() => { if (shown) $('ccBody').innerHTML = '<div class="alert alert-warning mb-0">Utlysningarna kunde inte läsas just nu. Försök igen om en stund.</div>'; });
    }

    function stateCell(c) {
        // text-wrap: ett långt klubbnamn bryts i stället för att klippas på telefon.
        if (c.state === 'awarded-me') return '<span class="badge bg-success text-wrap text-start">' + (c.created ? 'Tävlingen är skapad' : 'Ni är utsedda att arrangera') + '</span>';
        if (c.state === 'awarded-other') return '<span class="badge bg-secondary text-wrap text-start">Går i år till ' + esc(c.awardedClub) + '</span>';
        if (c.state === 'wished') return '<span class="badge bg-primary text-wrap text-start">Ni har önskat</span>'
            + (c.mine && c.mine.byKrets ? '<div class="small text-muted">Registrerat av kretsen</div>' : '');
        return '<span class="badge bg-light text-dark border">Utlyst</span>';
    }
    function actionCell(c) {
        if (c.state === 'awarded-me') {
            // Två handlingar får stå på samma rad; avstängd handling har sin förklaring som text.
            let h = '';
            if (c.canCreate) h += '<button class="btn btn-primary btn-sm" type="button" data-cc="create" data-id="' + c.id + '">Skapa tävlingen</button>';
            else if (c.whyNotCreate) h += '<span class="small text-muted d-block">' + esc(c.whyNotCreate) + '</span>';
            else if (c.created) h += '<span class="small text-muted d-block">Bygg klart och publicera den under Era tävlingar.</span>';
            if (c.canProposeDate) h += '<button class="btn btn-outline-secondary btn-sm mt-1" type="button" data-cc="proposedate" data-id="' + c.id + '">Föreslå annat datum</button>';
            return h;
        }
        if (c.state === 'wished' && c.canUnwish)
            return '<button class="btn btn-outline-secondary btn-sm" type="button" data-cc="unwish" data-id="' + c.id + '">Ångra</button>';
        if (c.state === 'open') {
            if (c.canWish) return '<button class="btn btn-primary btn-sm" type="button" data-cc="wish" data-id="' + c.id + '">Vi vill arrangera</button>';
            return '<span class="small text-muted">' + esc(c.whyNotWish || '') + '</span>';
        }
        return '';
    }
    function render() {
        if (!data.calls.length) { $('ccBody').innerHTML = '<div class="text-muted">Kretsen har inte utlyst några tävlingar för ' + year + ' ännu.</div>'; return; }
        let h = '<div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr>'
            + '<th>Datum</th><th>Tävling</th><th class="d-none d-md-table-cell">Läge</th><th class="text-end"></th></tr></thead><tbody>';
        data.calls.forEach(c => {
            const when = c.date ? '<div class="fw-semibold">' + esc(c.weekday) + ' ' + esc(dateText(c.date)) + '</div>'
                + (c.locked ? '<div class="small text-muted"><i class="bi bi-lock me-1"></i>Fastställt av kretsen</div>' : '')
                : '<span class="text-muted">Datum inte bestämt</span>';
            const others = c.others && c.others.length
                ? '<div class="small text-muted mt-1">Önskat av: ' + c.others.map(o => esc(o.club) + (o.proposedDate ? ' (föreslår ' + esc(dateText(o.proposedDate)) + ')' : '')).join(', ') + '</div>' : '';
            const mine = c.mine && (c.mine.proposedDate || c.mine.note) ? '<div class="small mt-1">' + (c.mine.proposedDate ? 'Ert förslag: ' + esc(dateText(c.mine.proposedDate)) + '. ' : '') + (c.mine.note ? 'Ert meddelande: ' + esc(c.mine.note) : '') + '</div>' : '';
            const deadline = c.state === 'open' && c.wishDeadline ? '<div class="small text-muted mt-1">Önska senast ' + esc(dateText(c.wishDeadline)) + '</div>' : '';
            h += '<tr><td>' + when + '</td><td><div class="fw-semibold">' + esc(c.name) + '</div>'
                + (c.disciplineLabel ? '<div class="small text-muted">' + esc(c.disciplineLabel) + '</div>' : '')
                + (c.description ? '<div class="small">' + esc(c.description) + '</div>' : '')
                + '<div class="d-md-none mt-1">' + stateCell(c) + '</div>' + deadline + mine + others + '</td>'
                + '<td class="d-none d-md-table-cell">' + stateCell(c) + '</td><td class="text-end">' + actionCell(c) + '</td></tr>';
        });
        $('ccBody').innerHTML = h + '</tbody></table></div>';
    }

    // Svensk datumväljare (som övriga sajten): flatpickr, locale 'sv', ÅÅÅÅ-MM-DD — aldrig <input type="date"> (följer webbläsarens språk).
    // Adminpanelen laddar flatpickr; saknas den laddas den här. static: kalendern ligger i dialogen.
    let fpReady = null;
    function ensureFlatpickr() {
        if (window.flatpickr && window.flatpickr.l10ns && window.flatpickr.l10ns.sv) return Promise.resolve();
        if (fpReady) return fpReady;
        const load = src => new Promise((res, rej) => { const s = document.createElement('script'); s.src = src; s.onload = res; s.onerror = rej; document.head.appendChild(s); });
        if (!document.querySelector('link[href*="flatpickr.min.css"]')) { const l = document.createElement('link'); l.rel = 'stylesheet'; l.href = 'https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css'; document.head.appendChild(l); }
        fpReady = (window.flatpickr ? Promise.resolve() : load('https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js'))
            .then(() => load('https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/sv.js'));
        return fpReady;
    }
    function initDates() {
        ensureFlatpickr().then(() => modalEl.querySelectorAll('input[data-date]').forEach(el => {
            // Tom ruta: kalendern öppnas på utlysningens månad (data-start), inte på dagens.
            if (!el._flatpickr) flatpickr(el, { locale: 'sv', dateFormat: 'Y-m-d', allowInput: true, appendTo: document.body,   // svävar över dialogen (data-bs-focus="false" på dialogen), ger ingen skrollist i den
                onOpen: (sel, str, inst) => { if (!sel.length && el.dataset.start) inst.jumpToDate(el.dataset.start); } });
        })).catch(() => { /* utan kalender går datumet ändå att skriva som ÅÅÅÅ-MM-DD */ });
    }
    function openModal(title, bodyHtml) { $('ccModalTitle').textContent = title; $('ccModalBody').innerHTML = bodyHtml; modal().show(); initDates(); }
    function wishModal(c) {
        openModal('Vi vill arrangera ' + c.name,
            '<div id="ccFormMsg"></div>'
            + '<p class="small text-muted">Kretsen får en notis om ert önskemål och utser sedan en klubb. Ni kan ångra er tills dess.</p>'
            + '<div class="mb-3"><label class="form-label fw-semibold" for="ccDate">Förslag till dag (valfritt)</label>'
            + '<input class="form-control" type="text" data-date data-start="' + esc(c.date || '') + '" autocomplete="off" placeholder="ÅÅÅÅ-MM-DD" id="ccDate" value="">'
            + (c.locked ? '<div class="form-text">Kretsen har fastställt datumet – ert förslag är bara ett förslag.</div>' : '<div class="form-text">Lämna tomt om ni passar på kretsens dag eller inte har någon önskad dag.</div>') + '</div>'
            + '<div class="mb-3"><label class="form-label fw-semibold" for="ccNote">Meddelande till kretsen (valfritt)</label><textarea class="form-control" id="ccNote" rows="3" maxlength="500"></textarea></div>'
            + '<div class="d-flex gap-2 justify-content-end"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Avbryt</button>'
            + '<button class="btn btn-primary" type="button" id="ccSend" data-id="' + c.id + '">Skicka önskemål</button></div>');
    }
    function send() {
        const b = $('ccSend'); b.disabled = true;
        post('Wish', { clubId: CLUB_ID, id: b.dataset.id, proposedDate: $('ccDate').value, note: $('ccNote').value }).then(d => {
            if (!d.success) { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message) + '</div>'; return; }
            modal().hide(); say(d.message, true); load();
        }).catch(() => { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">Det gick inte att skicka. Försök igen.</div>'; });
    }
    function unwishModal(c) {
        openModal('Ångra önskemålet', '<div id="ccFormMsg"></div><p>Ni önskar inte längre arrangera <b>' + esc(c.name) + '</b>.</p>'
            + '<div class="d-flex gap-2 justify-content-end"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Behåll önskemålet</button>'
            + '<button class="btn btn-warning" type="button" id="ccUnwish" data-id="' + c.id + '">Ångra</button></div>');
    }
    function unwish() {
        const b = $('ccUnwish'); b.disabled = true;
        post('Unwish', { clubId: CLUB_ID, id: b.dataset.id }).then(d => {
            if (!d.success) { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message) + '</div>'; return; }
            modal().hide(); say(d.message, true); load();
        }).catch(() => { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">Något gick fel. Ladda om sidan och försök igen.</div>'; });
    }

    function createModal(c) {
        openModal('Skapa tävlingen', '<div id="ccFormMsg"></div>'
            + '<p>Tävlingen <b>' + esc(c.name) + '</b> skapas med kretsens uppgifter (namn, gren' + (c.date ? ', datum ' + esc(dateText(c.date)) : '') + ').</p>'
            + '<p class="small text-muted">Den är <b>dold</b> för skyttarna tills ni trycker Publicera under Era tävlingar. Ni bygger klart den först.</p>'
            + '<div class="d-flex gap-2 justify-content-end"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Avbryt</button>'
            + '<button class="btn btn-primary" type="button" id="ccCreate" data-id="' + c.id + '">Skapa tävlingen</button></div>');
    }
    function createIt() {
        const b = $('ccCreate'); b.disabled = true;
        post('CreateCompetition', { clubId: CLUB_ID, id: b.dataset.id }).then(d => {
            if (!d.success) { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message) + '</div>'; return; }
            modal().hide(); say(d.message, true); load();
        }).catch(() => { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">Det gick inte att skapa tävlingen. Försök igen.</div>'; });
    }
    function proposeModal(c) {
        openModal('Föreslå annat datum', '<div id="ccFormMsg"></div>'
            + '<p class="small text-muted">Kretsen har fastställt datumet för <b>' + esc(c.name) + '</b>. Ert förslag ändrar ingenting – kretsen får en notis och beslutar.</p>'
            + '<div class="mb-3"><label class="form-label fw-semibold" for="ccPDate">Förslag till dag</label><input class="form-control" type="text" data-date data-start="' + esc(c.date || '') + '" autocomplete="off" placeholder="ÅÅÅÅ-MM-DD" id="ccPDate"></div>'
            + '<div class="mb-3"><label class="form-label fw-semibold" for="ccPNote">Varför? (valfritt)</label><textarea class="form-control" id="ccPNote" rows="3" maxlength="500"></textarea></div>'
            + '<div class="d-flex gap-2 justify-content-end"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Avbryt</button>'
            + '<button class="btn btn-primary" type="button" id="ccPSend" data-id="' + c.id + '">Skicka förslaget</button></div>');
    }
    function proposeIt() {
        const b = $('ccPSend'); b.disabled = true;
        post('ProposeDate', { clubId: CLUB_ID, id: b.dataset.id, proposedDate: $('ccPDate').value, note: $('ccPNote').value }).then(d => {
            if (!d.success) { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message) + '</div>'; return; }
            modal().hide(); say(d.message, true);
        }).catch(() => { b.disabled = false; $('ccFormMsg').innerHTML = '<div class="alert alert-warning py-2">Det gick inte att skicka. Försök igen.</div>'; });
    }

    document.addEventListener('click', ev => {
        const t = ev.target.closest('[data-cc], #ccSend, #ccUnwish, #ccCreate, #ccPSend');
        if (!t || (!card.contains(t) && !modalEl.contains(t))) return;
        if (t.id === 'ccSend') return send();
        if (t.id === 'ccUnwish') return unwish();
        if (t.id === 'ccCreate') return createIt();
        if (t.id === 'ccPSend') return proposeIt();
        const c = calls[+t.dataset.id];
        if (!c) return;
        if (t.dataset.cc === 'create') return createModal(c);
        if (t.dataset.cc === 'proposedate') return proposeModal(c);
        if (t.dataset.cc === 'wish') return wishModal(c);
        if (t.dataset.cc === 'unwish') return unwishModal(c);
    });
    $('ccYear').addEventListener('change', () => { year = +$('ccYear').value; load(); });
    load();
})();
</script>
}
