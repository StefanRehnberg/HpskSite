@*
    "Samlingsfaktura till en klubb" — pick one club, review, issue. Shared by the two surfaces that
    need it, because they are the same operation asked from two directions:

      * Anmälningar (tävling)        — the desk on the day: "this club standing here owes me for four
                                       entries, give them one bill".
      * Klubbens Fakturor, "att få   — the treasurer a week later: "Varbergs owes us across two
        betalt för"                    competitions, send the bill".

    Both are the ORGANISER/utställare direction: the parent invoice is created in the issuing
    organisation's ledger and addressed to the DEBTOR club, so `payerClubId` is the other club, not
    the one clicking. (The payer-side flow on the same Fakturor page is the mirror image — there the
    club bundles its own debts and the parent is created in the organiser's ledger. Different
    direction, different control, deliberately.)

    Only the SOURCE differs, so that is the only thing injected: a function returning
    { clubs: [{ clubId, clubName, invoiceCount, total, invoices[], competitions[]? }] }.

    Preview/confirm rendering comes from _ConsolidatePreview.cshtml — include that too.
    Guarded so including it twice on one page cannot redefine anything.
*@
<div class="modal fade" id="hpskConsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-receipt-cutoff me-2"></i>Samlingsfaktura till en klubb</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small" id="hpskConsIntro"></p>

                <div id="hpskConsLoading" class="text-center py-4">
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                    <span class="ms-2">Hämtar obetalda fakturor…</span>
                </div>

                <div id="hpskConsPick" class="d-none">
                    <label class="form-label fw-semibold" for="hpskConsClub">Vilken klubb ska faktureras?</label>
                    <select class="form-select" id="hpskConsClub"></select>
                    <div class="form-text">Bara klubbar med mer än en obetald faktura kan slås ihop.</div>
                    <div id="hpskConsClubInvoices" class="mt-3"></div>
                    @* Invoices with no club to bill. Shown on the picker step, not hidden behind the
                       preview, because they are the reason the picker's total can differ from the
                       Fakturor list the organiser is holding it up against. *@
                    <div id="hpskConsOrphans" class="alert alert-warning mt-3 d-none"></div>
                </div>

                <div id="hpskConsPreview" class="d-none">
                    <div class="alert alert-warning d-none" id="hpskConsWarning"></div>
                    <div id="hpskConsGroups"></div>
                    <div class="d-none" id="hpskConsRejectedWrap">
                        <hr>
                        <h6 class="text-muted"><i class="bi bi-exclamation-circle me-1"></i>Kan inte tas med</h6>
                        <ul class="small mb-0" id="hpskConsRejected"></ul>
                    </div>
                </div>

                <div class="alert alert-info d-none" id="hpskConsEmpty"></div>
                <div class="alert alert-danger d-none" id="hpskConsError"></div>
                <div class="alert alert-success d-none" id="hpskConsSuccess"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
                <button type="button" class="btn btn-outline-secondary d-none" id="hpskConsBack">Tillbaka</button>
                <button type="button" class="btn btn-primary d-none" id="hpskConsNext">Granska</button>
                <button type="button" class="btn btn-primary d-none" id="hpskConsConfirm">Skapa samlingsfaktura</button>
            </div>
        </div>
    </div>
</div>

<script>
if (!window.hpskConsolidateByClubLoaded) {
window.hpskConsolidateByClubLoaded = true;

let hpskConsClubs = [];
let hpskConsSel = { clubId: 0, invoiceIds: [] };
let hpskConsOnDone = null;

function hpskConsShow(step) {
    const set = (id, on) => document.getElementById(id)?.classList.toggle('d-none', !on);
    set('hpskConsLoading', step === 'loading');
    set('hpskConsPick', step === 'pick');
    set('hpskConsPreview', step === 'preview');
    set('hpskConsBack', step === 'preview');
    set('hpskConsNext', step === 'pick');
    set('hpskConsConfirm', step === 'preview');
}

function hpskConsFail(msg) {
    hpskConsShow('none');
    const el = document.getElementById('hpskConsError');
    el.textContent = msg;
    el.classList.remove('d-none');
}

/**
 * @@param {object} opts
 *   fetchGroups : async () => ({ success, clubs, message })
 *   intro       : sentence under the title
 *   emptyText   : shown when no club has more than one unpaid invoice
 *   onDone      : called after a successful create (refresh the caller's list)
 */
async function hpskOpenConsolidateModal(opts) {
    hpskConsOnDone = opts.onDone || null;
    document.getElementById('hpskConsIntro').textContent = opts.intro || '';
    ['hpskConsError', 'hpskConsSuccess', 'hpskConsEmpty'].forEach(id =>
        document.getElementById(id)?.classList.add('d-none'));
    hpskConsShow('loading');
    new bootstrap.Modal(document.getElementById('hpskConsModal')).show();

    let data;
    try { data = await opts.fetchGroups(); }
    catch (e) { hpskConsFail('Nätverksfel när fakturorna skulle hämtas.'); return; }
    if (!data || !data.success) { hpskConsFail((data && data.message) || 'Kunde inte hämta fakturorna.'); return; }

    // Invoices with no club to bill (a deleted team) can never be consolidated. Say so instead of
    // just leaving them out: the Fakturor list the organiser is reconciling against DOES show them,
    // and an unexplained difference between the two screens is worse than the rows themselves.
    hpskConsRenderOrphans(data.orphans || []);

    // A single invoice needs no samlingsfaktura — the service refuses to mint a second document for
    // the same money, so offering those clubs would only produce a confusing "betalas direkt".
    hpskConsClubs = (data.clubs || []).filter(c => c.invoiceCount > 1);
    if (!hpskConsClubs.length) {
        hpskConsShow('none');
        const el = document.getElementById('hpskConsEmpty');
        let msg = (data.clubs || []).length
            ? 'Ingen klubb har mer än en obetald faktura — de betalas var för sig.'
            : (opts.emptyText || 'Det finns inga obetalda fakturor att slå ihop.');
        // The orphan note lives inside the picker step, which is hidden here — so repeat it, or the
        // organiser is told "inga fakturor" while the Fakturor list plainly shows some.
        const orphans = data.orphans || [];
        if (orphans.length) {
            const sum = orphans.reduce((t, o) => t + Number(o.amount || 0), 0);
            msg += ` ${orphans.length} faktur${orphans.length === 1 ? 'a' : 'or'} (${sum.toFixed(2)} kr) `
                 + 'hör till borttagna lag och kan inte faktureras — makulera dem i Fakturor-vyn.';
        }
        el.textContent = msg;
        el.classList.remove('d-none');
        return;
    }

    const sel = document.getElementById('hpskConsClub');
    sel.innerHTML = hpskConsClubs.map(c =>
        `<option value="${c.clubId}">${hpskConsEsc(c.clubName)} — ${c.invoiceCount} fakturor, ${Number(c.total).toFixed(2)} kr</option>`
    ).join('');
    sel.onchange = hpskConsRenderClub;
    hpskConsRenderClub();
    hpskConsShow('pick');
}

// "N föräldralösa fakturor ignorerade" — the sentence that was missing. Skipping them is correct;
// doing it without a word on screen is what made the picker impossible to reconcile.
function hpskConsRenderOrphans(orphans) {
    const el = document.getElementById('hpskConsOrphans');
    if (!el) return;
    if (!orphans.length) { el.classList.add('d-none'); el.innerHTML = ''; return; }

    const sum = orphans.reduce((t, o) => t + Number(o.amount || 0), 0);
    el.innerHTML = `<div class="fw-semibold mb-1">`
        + `<i class="bi bi-exclamation-triangle me-1"></i>`
        + `${orphans.length} faktur${orphans.length === 1 ? 'a' : 'or'} (${sum.toFixed(2)} kr) kan inte tas med</div>`
        + `<ul class="small mb-1">`
        + orphans.map(o => `<li>${hpskConsEsc(o.invoiceNumber)} · ${hpskConsEsc(o.name)} · `
            + `${Number(o.amount).toFixed(2)} kr — ${hpskConsEsc(o.reason)}</li>`).join('')
        + `</ul>`
        + `<div class="small mb-0">Makulera dem i Fakturor-vyn så försvinner de ur listorna.</div>`;
    el.classList.remove('d-none');
}

function hpskConsRenderClub() {
    const clubId = parseInt(document.getElementById('hpskConsClub').value, 10);
    const club = hpskConsClubs.find(c => c.clubId === clubId);
    const wrap = document.getElementById('hpskConsClubInvoices');
    if (!club) { wrap.innerHTML = ''; return; }

    // Start with everything that CAN be taken ticked. The excluded rows are rendered too, but
    // disabled and with their reason spelled out — never silently absent (see hpskConsLine).
    hpskConsSel = { clubId, invoiceIds: club.invoices.filter(i => i.selectable !== false).map(i => i.id) };

    // When the debtor owes across several competitions, say so here: the engine makes one parent PER
    // competition, so they will receive one bill per arrangemang and should not be surprised by it.
    const perComp = (club.competitions || []);
    const body = perComp.length > 1
        ? perComp.map(c => `
            <div class="mb-2">
                <div class="small fw-semibold">${hpskConsEsc(c.competitionName)}</div>
                <ul class="small text-muted mb-0">
                    ${c.invoices.map(i => hpskConsLine(i)).join('')}
                </ul>
            </div>`).join('')
        : `<ul class="small text-muted mb-0">${club.invoices.map(i => hpskConsLine(i)).join('')}</ul>`;

    const excluded = club.excludedCount || 0;

    wrap.innerHTML = `
        <div class="card"><div class="card-body py-2">
            <div class="d-flex justify-content-between">
                <strong>${hpskConsEsc(club.clubName)}</strong>
                <span class="fw-bold" id="hpskConsRunningTotal">${Number(club.total).toFixed(2)} kr</span>
            </div>
            ${perComp.length > 1
                ? `<div class="small text-warning mt-1"><i class="bi bi-info-circle me-1"></i>`
                  + `Fordran över ${perComp.length} tävlingar — en samlingsfaktura skapas per tävling.</div>`
                : ''}
            ${excluded
                ? `<div class="small text-muted mt-1"><i class="bi bi-info-circle me-1"></i>`
                  + `${excluded} post${excluded === 1 ? '' : 'er'} kan inte tas med och visas nedan med skälet utskrivet.</div>`
                : ''}
            <div class="mt-2">${body}</div>
        </div></div>`;

    // Re-evaluate the Nästa button for the newly selected club.
    hpskConsToggle(-1, false);
}

// One row per invoice, with a checkbox so the organiser can drop a single entry instead of being
// blocked by it. Rows that cannot be consolidated are STILL SHOWN — unticked, disabled, with the
// reason in plain Swedish. Leaving them out was the right outcome reached invisibly: the picker's
// list then disagreed with the Fakturor list beside it and there was nothing on screen to explain
// the gap.
function hpskConsLine(i) {
    const usable = i.selectable !== false;
    const cbId = `hpskConsInv_${i.id}`;
    const cb = `<input type="checkbox" class="form-check-input me-2" id="${cbId}" value="${i.id}"
                       ${usable ? 'checked' : 'disabled'} onchange="hpskConsToggle(${i.id}, this.checked)">`;
    const reason = usable ? '' :
        `<div class="small text-danger ms-4"><i class="bi bi-exclamation-triangle me-1"></i>${hpskConsEsc(i.excludedReason || 'Kan inte ingå i en samlingsfaktura.')}</div>`;
    return `<li class="list-unstyled mb-1 ${usable ? '' : 'text-muted'}">`
        + `<label class="d-inline-flex align-items-center mb-0" for="${cbId}">`
        + cb
        + `<span>${hpskConsEsc(i.invoiceNumber)} · ${hpskConsEsc(i.name)}`
        + `${i.isTeam ? ' <span class="badge bg-secondary">lag</span>' : ''}`
        + ` · ${Number(i.amount).toFixed(2)} kr</span></label>${reason}</li>`;
}

// Keep the running total honest as boxes are ticked — the number the organiser confirms must be the
// number they are about to bill.
function hpskConsToggle(invoiceId, checked) {
    const ids = new Set(hpskConsSel.invoiceIds);
    if (checked) ids.add(invoiceId); else ids.delete(invoiceId);
    hpskConsSel.invoiceIds = [...ids];

    const club = hpskConsClubs.find(c => c.clubId === hpskConsSel.clubId);
    const totalEl = document.getElementById('hpskConsRunningTotal');
    if (club && totalEl) {
        const sum = club.invoices
            .filter(i => hpskConsSel.invoiceIds.includes(i.id))
            .reduce((t, i) => t + Number(i.amount || 0), 0);
        totalEl.textContent = `${sum.toFixed(2)} kr`;
    }
    // One invoice is not a samlingsfaktura, and zero is nothing at all.
    const next = document.getElementById('hpskConsNext');
    if (next) next.disabled = hpskConsSel.invoiceIds.length < 2;
}

function hpskConsToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
}

async function hpskConsPreviewStep() {
    if (!hpskConsSel.invoiceIds.length) return;
    hpskConsShow('loading');
    let data;
    try {
        const r = await fetch('/umbraco/surface/InvoiceAdmin/PreviewConsolidation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': hpskConsToken() },
            body: JSON.stringify({ payerClubId: hpskConsSel.clubId, invoiceIds: hpskConsSel.invoiceIds, organiserScope: true })
        });
        data = await r.json();
    } catch (e) { hpskConsFail('Nätverksfel vid kontroll av fakturorna.'); return; }
    if (!data.success) { hpskConsFail(data.message || 'Kunde inte kontrollera fakturorna.'); return; }

    const anyPayable = hpskRenderConsolidatePreview({
        groups: document.getElementById('hpskConsGroups'),
        rejectedWrap: document.getElementById('hpskConsRejectedWrap'),
        rejected: document.getElementById('hpskConsRejected'),
        warning: document.getElementById('hpskConsWarning')
    }, data);

    hpskConsShow('preview');
    document.getElementById('hpskConsConfirm').disabled = !anyPayable;
}

async function hpskConsCreate() {
    const btn = document.getElementById('hpskConsConfirm');
    btn.disabled = true;
    try {
        const r = await fetch('/umbraco/surface/InvoiceAdmin/CreateConsolidatedInvoices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': hpskConsToken() },
            body: JSON.stringify({ payerClubId: hpskConsSel.clubId, invoiceIds: hpskConsSel.invoiceIds, organiserScope: true })
        });
        const d = await r.json();
        if (!d.success) {
            const err = document.getElementById('hpskConsError');
            err.textContent = d.message || 'Kunde inte skapa samlingsfakturan.';
            err.classList.remove('d-none');
            btn.disabled = false;
            return;
        }
        hpskConsShow('none');
        const okEl = document.getElementById('hpskConsSuccess');
        // The invoice document is what the debtor's treasurer actually needs — belopp, referens and a
        // bankgiro-QR. Hand over every parent that was created, not just the first.
        const parents = (d.parents || []).filter(x => x.parentInvoiceId);
        okEl.innerHTML = hpskConsolidateSuccessHtml(d) + (parents.length
            ? '<hr>' + parents.map(x =>
                `<a class="btn btn-sm btn-outline-primary me-2 mb-1" target="_blank" rel="noopener"
                    href="/faktura/${x.parentInvoiceId}"><i class="bi bi-printer me-1"></i>`
                + `Öppna fakturan (${hpskConsEsc(x.parentInvoiceNumber || '')})</a>`).join('')
            : '');
        okEl.classList.remove('d-none');
        if (typeof hpskConsOnDone === 'function') hpskConsOnDone();
    } catch (e) {
        const err = document.getElementById('hpskConsError');
        err.textContent = 'Nätverksfel.';
        err.classList.remove('d-none');
        btn.disabled = false;
    }
}

document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('hpskConsNext')?.addEventListener('click', hpskConsPreviewStep);
    document.getElementById('hpskConsBack')?.addEventListener('click', () => hpskConsShow('pick'));
    document.getElementById('hpskConsConfirm')?.addEventListener('click', hpskConsCreate);
});

// ⚠️ EXPORT EXPLICITLY — do not rely on hoisting out of this guard block.
// A plain `function` declared inside a block leaks to global scope under Annex B's web-compat rules,
// which is why _ConsolidatePreview.cshtml's helpers happen to work. An `async function` (or a
// generator) does NOT: it stays block-scoped. This partial's entry point is async, so without this
// line the caller gets "hpskOpenConsolidateModal is not defined" while the script is present and
// fully parsed on the page — a confusing failure that cost a debugging round.
window.hpskOpenConsolidateModal = hpskOpenConsolidateModal;
}
</script>
