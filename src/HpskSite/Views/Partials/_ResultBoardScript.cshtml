<script>
// Live result board logic (rbBoardScript) — rendered by /live (Views/ResultBoard.cshtml). Do not duplicate; this is the single home.
function rbBoardScript(compId, hasFinalsRound, qualSeriesCount, numFinalSeries, totalSeriesCount, configuredWCs, compTypeId, resultPageUrl) {
    var refreshTimer=null;
    var allGroups=[],isOfficial=false,isMedals=false;
    var selectedWCs=null;          // object map of checked weapon classes, e.g. {C:1,A:1}
    var cycleMode=false;           // Växla: rotate through selected classes one at a time
    var cycleTimer=null,cycleIdx=0;
    var CYCLE_MS=12000;            // ~12 s per class in Växla mode
    var layoutMode='list';         // 'list' | 'grid' (tiled dashboard)
    var tileCount=4;               // grid: 1-4 tiles
    var REFRESH=15000;
    // Springskytte spectator additions: an on-course band pinned above the standings, and paging so a
    // 100+ field is fully visible over time instead of being cut off at the fold.
    var springBoard=null;          // GetSpringskytteBoardState payload (on course + next off)
    var springBoardAt=0;           // Date.now() at fetch — lets the elapsed clocks tick between polls
    var springTick=null;
    var pageIdx=0,pageTimer=null,springPageCount=1,PAGE_MS=12000;
    var compact=false;             // denser rows; drops Bom (it's just a count of the red dots)
    var rowsPerPage=0;             // 0 = auto-fit to the screen height
    var springGrouped=false;       // ?grupper=1 restores the old per-class group headers (see springFlatSorted)
    resultPageUrl=resultPageUrl||'';
    var qrMode='auto';             // ?qr= auto (default, on when official) | 1 (always) | 0 (never)
    var qrShown=null;              // last applied state, so we don't re-set src every 15 s poll
    var springOfficialWCs=[];      // Springskytte publishes per weapon class — see updateStatus
    var springRowH=0,springBandH=0,springHeadH=0,springRemeasuring=false;   // measured, for the capacity maths
    configuredWCs=configuredWCs||[];
    compTypeId=compTypeId||'Precision';
    var isMilsnabb=compTypeId==='Milsnabb';
    var isNH=compTypeId==='NationellHelmatch';
    var isGrouped12=isMilsnabb||isNH;
    var isSpringskytte=compTypeId==='Springskytte';
    var isFaltskytte=compTypeId==='Faltskytte'||compTypeId==='MagnumFalt';
    var faltStationCount=0,faltIsPoang=false;

    function getWC(n){
        if(isSpringskytte){
            // Extract weapon class letter from "Vapengrupp A - D 21" or weaponClass field
            var m=(n||'').match(/Vapengrupp\s+([AC])/i);
            return m?m[1].toUpperCase():((n||'').trim().charAt(0).toUpperCase()||'?');
        }
        return(n||'').trim().charAt(0).toUpperCase()||'?';
    }
    function getSpringWC(g){return g.weaponClass||getWC(g.className||g.ClassName||'')}

    // Build the weapon-class checkbox filter from configured classes
    function populateWcFilter(){
        var box=document.getElementById('rbWcFilter');
        if(!box)return;
        var wcs=configuredWCs.length>0?configuredWCs.slice():[];
        if(!wcs.length){
            var s=new Set();allGroups.forEach(function(g){
                s.add(isSpringskytte?getSpringWC(g):getWC(g.className||g.ClassName||''));
            });
            var o=['C','B','A','R','L','M'];
            wcs=Array.from(s).sort(function(a,b){var ai=o.indexOf(a),bi=o.indexOf(b);return(ai<0?99:ai)-(bi<0?99:bi)});
        }
        if(!wcs.length)return; // no classes yet — wait for data
        if(selectedWCs===null){
            var saved=null;
            try{var raw=localStorage.getItem('hpsk_rb_wcs_'+compId);if(raw)saved=JSON.parse(raw)}catch(e){}
            selectedWCs={};
            (saved&&saved.length?saved:wcs).forEach(function(w){if(wcs.indexOf(w)>=0)selectedWCs[w]=1});
            if(!Object.keys(selectedWCs).length)wcs.forEach(function(w){selectedWCs[w]=1});
        }
        var sig=wcs.join(',');
        if(box.getAttribute('data-sig')===sig)return; // class list unchanged — keep DOM + selection
        box.setAttribute('data-sig',sig);
        box.innerHTML='';
        wcs.forEach(function(w){
            var lab=document.createElement('label');lab.className='rb-wc-chk';
            var cb=document.createElement('input');cb.type='checkbox';cb.value=w;cb.checked=!!selectedWCs[w];
            cb.addEventListener('change',function(){
                if(this.checked)selectedWCs[this.value]=1;else delete selectedWCs[this.value];
                persistFilter();cycleIdx=0;syncUrl();renderAll();restartCycle();
            });
            lab.appendChild(cb);lab.appendChild(document.createTextNode(' '+w));
            box.appendChild(lab);
        });
    }
    function persistFilter(){try{localStorage.setItem('hpsk_rb_wcs_'+compId,JSON.stringify(Object.keys(selectedWCs||{})))}catch(e){}}
    function persistCycle(){try{localStorage.setItem('hpsk_rb_cycle_'+compId,cycleMode?'1':'0')}catch(e){}}
    // Weapon classes present in the data AND selected, in dropdown order
    function orderedSelectedPresent(){
        var s={};allGroups.forEach(function(g){s[isSpringskytte?getSpringWC(g):getWC(g.className||g.ClassName||'')]=1});
        var o=['C','B','A','R','L','M'];
        return Object.keys(s).filter(function(w){return selectedWCs&&selectedWCs[w]}).sort(function(a,b){var ai=o.indexOf(a),bi=o.indexOf(b);return(ai<0?99:ai)-(bi<0?99:bi)});
    }
    // Which weapon classes to render right now (one at a time when Växla is on)
    function currentDisplayWcs(){
        var sel=orderedSelectedPresent();
        if(cycleMode){if(!sel.length)return[];if(cycleIdx>=sel.length)cycleIdx=0;return[sel[cycleIdx]]}
        return sel;
    }
    function restartCycle(){stopCycle();if(cycleMode)cycleTimer=setInterval(cycleTick,CYCLE_MS)}
    function stopCycle(){if(cycleTimer){clearInterval(cycleTimer);cycleTimer=null}}
    function cycleTick(){var tot=orderedSelectedPresent().length;if(layoutMode==='grid'){if(tot<=tileCount)return}else if(tot<=1)return;cycleIdx=(cycleIdx+1)%tot;renderAll()}
    function updateCycleLabel(){
        var el=document.getElementById('rbCycleNow');if(!el)return;
        if(layoutMode==='grid'){var tot=orderedSelectedPresent().length;el.textContent=(cycleMode&&tot>tileCount)?'▶ roterar':'';return}
        if(cycleMode){var s=orderedSelectedPresent();el.textContent=s.length?('▶ Vapengrupp '+(s[cycleIdx]||s[0])):''}
        else el.textContent='';
    }

    function getFiltered(){
        var show={};currentDisplayWcs().forEach(function(w){show[w]=1});
        return allGroups.filter(function(g){return show[isSpringskytte?getSpringWC(g):getWC(g.className||g.ClassName||'')]});
    }

    function fetchResults(){
        var url=isSpringskytte
            ?'/umbraco/surface/Springskytte/GetSpringskytteResults?competitionId='+compId
            :isFaltskytte
            ?'/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId='+compId
            :'/umbraco/surface/CompetitionResults/GetResultsList?competitionId='+compId;
        fetch(url)
        .then(function(r){return r.json()})
        .then(function(d){
            if(!d.success)return;
            if(isSpringskytte){
                allGroups=d.classGroups||[];
                // Springskytte publishes PER WEAPON CLASS (officialWeaponClasses; resultsOfficial is only
                // "at least one class is public"). The board shows one class at a time, so the official
                // state has to be judged against what is on screen — computed in updateStatus, which is
                // called after populateWcFilter has resolved the selection.
                springOfficialWCs=(d.officialWeaponClasses||[]).map(function(w){return String(w||'').toUpperCase()});
                isMedals=false;
            } else if(isFaltskytte){
                var rr=d.results||d.Results||{};
                allGroups=rr.classGroups||rr.ClassGroups||[];
                faltStationCount=rr.stationCount||rr.StationCount||0;
                faltIsPoang=(rr.scoringMode||rr.ScoringMode)==='Poang';
                isOfficial=rr.isOfficial||rr.IsOfficial||false;
                isMedals=rr.isAwardingStandardMedals||rr.IsAwardingStandardMedals||false;
            } else {
                if(!d.exists)return;
                isOfficial=d.isOfficial||d.IsOfficial||false;
                isMedals=d.isAwardingStandardMedals||d.IsAwardingStandardMedals||false;
                allGroups=(d.results||d.Results).classGroups||(d.results||d.Results).ClassGroups||[];
            }
            populateWcFilter();updateStatus();renderAll();
            if(isSpringskytte)fetchSpringBoard();
        }).catch(function(e){console.error(e)});
    }
    // Springskytte only. The results payload contains shooters who already have a result row, so the
    // in-progress field is invisible to it — this second call diffs the published start list against
    // entered results to get who is out on the course right now.
    function fetchSpringBoard(){
        var sel=Object.keys(selectedWCs||{});
        var wc=sel.length===1?sel[0]:'';   // one class on screen (the normal case) → let the server filter
        fetch('/umbraco/surface/Springskytte/GetSpringskytteBoardState?competitionId='+compId+(wc?'&weaponClass='+encodeURIComponent(wc):''))
        .then(function(r){return r.json()})
        .then(function(d){
            if(!d.success)return;
            springBoard=d;springBoardAt=Date.now();
            renderAll();
        }).catch(function(e){console.error(e)});
    }
    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
    function mmss(t){t=Math.max(0,Math.round(t));var m=Math.floor(t/60),s=t%60;return m+':'+(s<10?'0':'')+s}
    // Count the on-course clocks up locally between the 15 s polls, anchored on the server's "now" so a
    // wrong clock on the kiosk PC can't skew them.
    function startSpringTick(){
        if(springTick||!isSpringskytte)return;
        springTick=setInterval(function(){
            if(!springBoardAt)return;
            var drift=Math.floor((Date.now()-springBoardAt)/1000);
            var els=document.querySelectorAll('[data-elapsed]');
            for(var i=0;i<els.length;i++){
                var base=parseInt(els[i].getAttribute('data-elapsed'))||0;
                els[i].textContent=mmss(base+drift);
            }
        },1000);
    }
    function stopSpringTick(){if(springTick){clearInterval(springTick);springTick=null}}
    function springPageTick(){
        if(!isSpringskytte||springPageCount<=1)return;
        pageIdx=(pageIdx+1)%springPageCount;
        renderAll();
    }
    function updateStatus(){
        var b=document.getElementById('rbStatusBadge'),ts=document.getElementById('rbLastUpdated');
        // Springskytte: official is per weapon class, so it is true only when EVERY class on screen is
        // published. Showing OFFICIELLT (and the results QR) over a still-preliminary A list because C
        // happened to be published would be a lie on a wall in front of spectators.
        if(isSpringskytte){
            var disp=currentDisplayWcs();
            isOfficial=disp.length>0&&disp.every(function(w){return springOfficialWCs.indexOf(w)>=0});
        }
        if(isOfficial){b.className='rb-badge-official';b.innerHTML='<i class="bi bi-check-circle me-1"></i>OFFICIELLT'}
        else{b.className='rb-badge-live';b.innerHTML='<i class="bi bi-broadcast me-1 rb-pulse"></i>LIVE'}
        if(ts)ts.textContent='Uppdaterad '+new Date().toLocaleTimeString('sv-SE',{hour:'2-digit',minute:'2-digit',second:'2-digit'});
        rbQrApply();
    }
    // QR panel to the official /resultat/ page — for the hour or so between the last shooter and the
    // medal ceremony, when what spectators want is their own full result on their own phone.
    //
    // It appears BY ITSELF when results go official, which is the whole design point: the board is a
    // Chrome kiosk with no keyboard to hand, and changing its URL at the venue means killing the
    // supervisor loop over Remote Desktop. Publishing the results already happens before the ceremony,
    // and /resultat/ does not exist until then (PublishResults creates the node), so "official" is both
    // the right moment AND the guarantee the link resolves. ?qr=1 forces it on, ?qr=0 off.
    //
    // Split left/right rather than replacing the standings: the panel costs width, and the paging
    // capacity maths is measured from HEIGHT, so no rows are lost.
    function rbQrApply(){
        var el=document.getElementById('rbQrPanel');
        if(!el)return;
        var want=!!resultPageUrl&&(qrMode==='1'||(qrMode==='auto'&&isOfficial));
        if(want===qrShown)return;                     // don't re-fetch the PNG on every poll
        qrShown=want;
        el.hidden=!want;
        if(!want)return;
        var img=document.getElementById('rbQrImg');
        if(img&&!img.getAttribute('src'))
            img.src='/umbraco/surface/Faltskytte/GenerateQrCode?url='+encodeURIComponent(resultPageUrl);
        var sub=document.getElementById('rbQrSub');
        if(sub&&!sub.textContent)
            sub.textContent=resultPageUrl.replace(/^https?:\/\//,'');
        if(springRowH){springRowH=0;renderAll()}      // narrower table → re-measure rows, re-page
    }
    function renderAll(){
        var wr=document.getElementById('rbTableWrap');
        updateCycleLabel();
        if(layoutMode==='grid'){renderGrid(wr);return}
        wr.className='rb-table-wrap';
        renderInto(wr,getFiltered());
    }
    // Weapon groups (selected + present) with participant counts, largest first
    function weaponGroupsByCount(){
        var map={};
        allGroups.forEach(function(g){
            var wc=isSpringskytte?getSpringWC(g):getWC(g.className||g.ClassName||'');
            if(!(selectedWCs&&selectedWCs[wc]))return;
            if(!map[wc])map[wc]={wc:wc,groups:[],count:0};
            map[wc].groups.push(g);
            map[wc].count+=(g.shooters||g.Shooters||[]).length;
        });
        return Object.keys(map).map(function(k){return map[k]}).sort(function(a,b){return b.count-a.count});
    }
    // Tiled dashboard: 1-4 weapon-group panels (largest = hero), optional Växla rotation of overflow
    function renderGrid(wr){
        var wgs=weaponGroupsByCount();
        if(!wgs.length){wr.className='rb-table-wrap';wr.innerHTML='<div style="text-align:center;padding:3rem 0;opacity:.5"><i class="bi bi-inbox" style="font-size:2rem"></i><p>Inga resultat</p></div>';return}
        var n=Math.max(1,Math.min(4,tileCount));
        var ordered=wgs.slice();
        if(cycleMode&&wgs.length>n){var off=cycleIdx%wgs.length;ordered=wgs.slice(off).concat(wgs.slice(0,off))}
        var show=ordered.slice(0,n);
        var html='<div class="rb-grid cols-'+n+'">';
        for(var i=0;i<n;i++){
            var wg=show[i];
            var head=(wg&&!isFaltskytte)?('<div class="rb-tile-head">Vapengrupp '+wg.wc+' ('+wg.count+' deltagare)</div>'):'';
            html+='<div class="rb-tile">'+head+'<div class="rb-tile-body" id="rbTile'+i+'"></div></div>';
        }
        html+='</div>';
        wr.className='rb-table-wrap is-grid';
        wr.innerHTML=html;
        show.forEach(function(wg,i){var body=document.getElementById('rbTile'+i);if(body)renderInto(body,wg.groups)});
    }
    // Render a flat list of all filtered shooters sorted by total score (or time for Springskytte)
    function renderInto(wr,groups){
        if(isSpringskytte){renderSpringskytte(wr,groups);return}
        if(isFaltskytte){renderFaltskytte(wr,groups);return}
        // Flatten all shooters into one list with calculated scores
        var all=[];
        groups.forEach(function(cg){
            var cn=cg.className||cg.ClassName||'';
            (cg.shooters||cg.Shooters||[]).forEach(function(sh){
                var nm=sh.name||sh.Name||'',cl=sh.club||sh.Club||'',sc=sh.shootingClass||sh.ShootingClass||cn;
                var res=sh.results||sh.Results||[];
                var tot=0,tx=0,sr=[];
                res.forEach(function(r){var shots=JSON.parse(r.shots||r.Shots||'[]');var s=0,x=0;shots.forEach(function(v){s+=(v==='X'||v==='x')?10:(parseInt(v)||0);if(v==='X'||v==='x')x++});sr.push({s:s,x:x});tot+=s;tx+=x});
                all.push({nm:nm,cl:cl,sc:sc,sr:sr,tot:tot,tx:tx,medal:sh.standardMedal||sh.StandardMedal||''});
            });
        });
        if(!all.length){wr.innerHTML='<div style="text-align:center;padding:3rem 0;opacity:.5"><i class="bi bi-inbox" style="font-size:2rem"></i><p>Inga resultat</p></div>';return}
        // Sort by total desc, then X count desc
        all.sort(function(a,b){return b.tot-a.tot||(b.tx-a.tx)});
        var maxSeries=0;
        all.forEach(function(s){if(s.sr.length>maxSeries)maxSeries=s.sr.length});
        var useFinals=hasFinalsRound&&maxSeries>=totalSeriesCount;
        // Build table
        var h='<table class="rb-table"><thead><tr><th>#</th><th>Namn</th><th>Klass</th><th>Förening</th>';
        if(isGrouped12){
            var gLabels=isNH?['Prec','Duell','Fält']:['10s','8s','6s'];
            for(var g=0;g<3;g++){for(var i=g*4+1;i<=g*4+4;i++)h+='<th class="rb-series-col">'+i+'</th>';h+='<th class="rb-subtotal">'+gLabels[g]+'</th>'}
        } else if(useFinals){for(var i=1;i<=qualSeriesCount;i++)h+='<th class="rb-series-col">'+i+'</th>';h+='<th class="rb-series-col">Tot</th>';for(var i=1;i<=numFinalSeries;i++)h+='<th class="rb-series-col">F'+i+'</th>'}
        else{for(var i=1;i<=maxSeries;i++)h+='<th class="rb-series-col">'+i+'</th>'}
        h+='<th>Tot</th><th>X</th>';if(isMedals)h+='<th>S</th>';h+='</tr></thead><tbody>';
        all.forEach(function(sh,pos0){
            var pos=pos0+1,sr=sh.sr,qs=0;
            if(useFinals)qs=sr.slice(0,qualSeriesCount).reduce(function(a,v){return a+v.s},0);
            var pc=pos<=3?' rb-pos-'+pos:'';
            h+='<tr><td class="'+pc.trim()+'">'+pos+'</td><td>'+sh.nm+'</td><td>'+sh.sc+'</td><td>'+sh.cl+'</td>';
            if(isGrouped12){
                var grps=[[0,4],[4,8],[8,12]];
                grps.forEach(function(g){var gt=0;for(var i=g[0];i<g[1];i++){var v=i<sr.length?sr[i].s:0;gt+=v;h+='<td class="rb-series-col">'+(i<sr.length?v:'-')+'</td>'}h+='<td class="rb-subtotal">'+gt+'</td>'});
            } else if(useFinals){
                for(var i=0;i<qualSeriesCount;i++)h+='<td class="rb-series-col">'+(i<sr.length?sr[i].s:'-')+'</td>';
                h+='<td class="rb-series-col"><strong>'+qs+'</strong></td>';
                for(var i=qualSeriesCount;i<totalSeriesCount;i++)h+='<td class="rb-series-col">'+(i<sr.length?sr[i].s:'-')+'</td>';
            } else {
                for(var i=0;i<maxSeries;i++)h+='<td class="rb-series-col">'+(i<sr.length?sr[i].s:'-')+'</td>';
            }
            h+='<td><strong>'+sh.tot+'</strong></td><td>'+sh.tx+'</td>';
            if(isMedals){var mc=sh.medal==='S'?' rb-medal-s':sh.medal==='B'?' rb-medal-b':'';h+='<td class="'+mc.trim()+'">'+sh.medal+'</td>'}
            h+='</tr>';
        });
        h+='</tbody></table>';wr.innerHTML=h;
    }
    // Fältskytte / MagnumFält result board — one combined leaderboard per weapon class.
    // Sub-classes (C1/C2/C3/CVet/CDam…) are merged and ranked together; each shooter's
    // own sub-class stays visible in the Klass column. Top row is the best raw score in
    // the weapon group, NOT the official per-class placement (deliberate, spectator view).
    function fNum(camel,pascal){var v=(camel!=null?camel:pascal);return v!=null?v:0}
    function renderFaltskytte(wr,groups){
        if(!groups.length){wr.innerHTML='<div style="text-align:center;padding:3rem 0;opacity:.5"><i class="bi bi-inbox" style="font-size:2rem"></i><p>Inga resultat</p></div>';return}
        var n=faltStationCount,h='';
        // Bucket every shooter into its weapon class; collect per-class shoot-off notes.
        var buckets={},notesByWc={};
        groups.forEach(function(cg){
            var cn=cg.className||cg.ClassName||'';
            (cg.shooters||cg.Shooters||[]).forEach(function(sh){
                var wc=getWC(sh.shootingClass||sh.ShootingClass||cn);
                (buckets[wc]=buckets[wc]||[]).push(sh);
            });
            var ns=cg.shootOffNotes||cg.ShootOffNotes||[];
            if(Array.isArray(ns)&&ns.length){var w=getWC(cn);(notesByWc[w]=notesByWc[w]||[]).push.apply(notesByWc[w],ns)}
        });
        // Render weapon-class tables in the dropdown's order.
        var order=['C','B','A','R','L','M'];
        var wcs=Object.keys(buckets).sort(function(a,b){var ai=order.indexOf(a),bi=order.indexOf(b);return(ai<0?99:ai)-(bi<0?99:bi)});
        wcs.forEach(function(wc){
            var shooters=buckets[wc];
            if(!shooters.length)return;
            // Rank across the whole weapon class using the server's tiebreaker keys.
            shooters.sort(function(a,b){
                if(faltIsPoang){
                    return fNum(b.totalPoints,b.TotalPoints)-fNum(a.totalPoints,a.TotalPoints)
                        || fNum(b.totalTiebreakerScore,b.TotalTiebreakerScore)-fNum(a.totalTiebreakerScore,a.TotalTiebreakerScore);
                }
                return fNum(b.totalHits,b.TotalHits)-fNum(a.totalHits,a.TotalHits)
                    || fNum(b.totalFigures,b.TotalFigures)-fNum(a.totalFigures,a.TotalFigures)
                    || fNum(b.totalTiebreakerScore,b.TotalTiebreakerScore)-fNum(a.totalTiebreakerScore,a.TotalTiebreakerScore);
            });
            var hasSS=shooters.some(function(s){var r=s.shootOffRounds||s.ShootOffRounds;return Array.isArray(r)&&r.length>0});
            var cols=4+n+2+(hasSS?1:0)+(isMedals?1:0);
            h+='<table class="rb-table" style="margin-bottom:1rem">';
            h+='<thead><tr><td colspan="'+cols+'" style="background:#0f3460;color:#4ecca3;font-weight:700;padding:.5rem;text-align:left;border-bottom:2px solid #4ecca3">Vapengrupp '+wc+' <span style="opacity:.6;font-weight:400">('+shooters.length+' deltagare)</span></td></tr>';
            h+='<tr><th>#</th><th>Namn</th><th>Klass</th><th>Förening</th>';
            for(var i=1;i<=n;i++)h+='<th class="rb-series-col">'+i+'</th>';
            h+='<th>'+(faltIsPoang?'Poäng':'Tot')+'</th><th>Pm</th>';
            if(hasSS)h+='<th>Sär</th>';
            if(isMedals)h+='<th>S</th>';
            h+='</tr></thead><tbody>';
            shooters.forEach(function(sh,idx){
                var pos=idx+1;
                var nm=sh.name||sh.Name||'',cl=sh.club||sh.Club||'',sc=sh.shootingClass||sh.ShootingClass||'';
                var sts=sh.stations||sh.Stations||[];
                var pc=pos<=3?' rb-pos-'+pos:'';
                h+='<tr><td class="'+pc.trim()+'">'+pos+'</td><td>'+nm+'</td><td>'+sc+'</td><td>'+cl+'</td>';
                for(var i=1;i<=n;i++){
                    var st=null;
                    for(var j=0;j<sts.length;j++){if((sts[j].stationNumber||sts[j].StationNumber)===i){st=sts[j];break}}
                    if(st){
                        var hits=st.hits!=null?st.hits:st.Hits,figs=st.figures!=null?st.figures:st.Figures;
                        var tb=st.tiebreakerScore!=null?st.tiebreakerScore:st.TiebreakerScore;
                        var cell=hits+'/'+figs;
                        if(tb!=null)cell+=' <small style="opacity:.7">'+tb+'p</small>';
                        h+='<td class="rb-series-col">'+cell+'</td>';
                    } else {
                        h+='<td class="rb-series-col" style="opacity:.4">-</td>';
                    }
                }
                if(faltIsPoang){h+='<td><strong>'+(sh.totalPoints!=null?sh.totalPoints:sh.TotalPoints)+'</strong></td>'}
                else{h+='<td><strong>'+(sh.totalHits!=null?sh.totalHits:sh.TotalHits)+'/'+(sh.totalFigures!=null?sh.totalFigures:sh.TotalFigures)+'</strong></td>'}
                var pm=sh.totalTiebreakerScore!=null?sh.totalTiebreakerScore:sh.TotalTiebreakerScore;
                h+='<td>'+(pm||'')+'</td>';
                if(hasSS){
                    var rounds=sh.shootOffRounds||sh.ShootOffRounds||[];
                    if(rounds.length>0){var tip=rounds.map(function(t,i){return'Runda '+(i+1)+': '+t}).join(', ');h+='<td title="'+tip+'"><strong>'+rounds.join(' / ')+'</strong></td>'}
                    else h+='<td style="opacity:.4">—</td>';
                }
                if(isMedals){var m=sh.standardMedal||sh.StandardMedal||'';var mc=m==='S'?' rb-medal-s':m==='B'?' rb-medal-b':'';h+='<td class="'+mc.trim()+'">'+m+'</td>'}
                h+='</tr>';
            });
            h+='</tbody></table>';
            var notes=notesByWc[wc]||[];
            if(Array.isArray(notes)&&notes.length>0){
                h+='<div style="opacity:.6;font-size:.8rem;margin:-.5rem 0 1rem .25rem">';
                notes.forEach(function(note){var safe=String(note).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]});h+='<div><i class="bi bi-info-circle me-1"></i>'+safe+'</div>'});
                h+='</div>';
            }
        });
        wr.innerHTML=h||'<div style="text-align:center;padding:3rem 0;opacity:.5"><i class="bi bi-inbox" style="font-size:2rem"></i><p>Inga resultat</p></div>';
    }
    // Format class name with age span, e.g. "Vapengrupp A - D 21" → "Vapengrupp A - D 21-34"
    function formatClassWithAgeSpan(cn){
        var map=[['15','-15 år',true],['18','16-18 år',true],['jun','15-20 år',true],
            ['21','21-34',false],['35','35-49',false],['50','50-59',false],
            ['60','60-64',false],['65','65-69',false],['70','70+',false]];
        for(var i=0;i<map.length;i++){
            var code=map[i][0],span=map[i][1],parens=map[i][2];
            if(cn.endsWith(' '+code)||cn.endsWith('-'+code)){
                if(parens)return cn+' ('+span+')';
                return cn.substring(0,cn.length-code.length)+span;
            }
        }
        return cn;
    }

    // "Nyss startat" band: the last 3 shooters away, with time-since-start counting up, plus who is
    // next off. It is a START-LINE widget, not an on-course tracker — see the endpoint's remarks for
    // why. Once the whole field has started (allStarted) the band disappears and the standings get the
    // full screen, which is also when spectators stop caring about the line.
    function springBandHtml(){
        if(!springBoard)return '';
        if(springBoard.allStarted)return '';
        var js=springBoard.justStarted||[],up=springBoard.upcoming||[];
        if(!js.length&&!up.length)return '';
        var h='<div id="rbSpringBand" style="margin-bottom:.9rem;border:2px solid #4ecca3;border-radius:.4rem;overflow:hidden">';
        h+='<div style="background:#4ecca3;color:#0f1021;font-weight:800;letter-spacing:.08em;padding:.35rem .6rem;font-size:1rem">NYSS STARTAT</div>';
        if(js.length){
            h+='<table class="rb-table" style="margin:0"><colgroup><col style="width:3rem"><col><col><col style="width:6rem"></colgroup><tbody>';
            js.forEach(function(r){
                var e=r.elapsedSeconds||0;
                h+='<tr><td style="font-weight:700">'+esc(r.startOrder||'')+'</td>'
                  +'<td style="text-align:left;font-weight:700">'+esc(r.name||'')+'</td>'
                  +'<td style="text-align:left;opacity:.75">'+esc(r.clubShort||r.club||'')+'</td>'
                  +'<td style="font-variant-numeric:tabular-nums;font-weight:700;color:#4ecca3" data-elapsed="'+e+'">'+mmss(e)+'</td></tr>';
            });
            h+='</tbody></table>';
        } else {
            h+='<div style="padding:.55rem .6rem;opacity:.6">Ingen har startat än</div>';
        }
        if(up.length){
            h+='<div style="background:#0f3460;padding:.35rem .6rem;font-size:.9rem">'
              +'<span style="color:#4ecca3;font-weight:700;letter-spacing:.06em;margin-right:.6rem">NÄSTA START</span>';
            h+=up.map(function(r){
                return '<span style="margin-right:1.4rem;white-space:nowrap"><strong>'+esc(r.startTime||'')+'</strong> '+esc(r.name||'')+'</span>';
            }).join('');
            h+='</div>';
        }
        return h+'</div>';
    }
    // Flatten the class groups into a single row stream (group headers included) so it can be paged.
    function springFlatRows(groups){
        var flat=[];
        groups.forEach(function(cg){
            var shooters=cg.shooters||[];
            if(!shooters.length)return;
            var cn=formatClassWithAgeSpan(cg.className||cg.ClassName||'');
            var wc=cg.weaponClass||'C';
            flat.push({group:cn});
            shooters.forEach(function(sh){flat.push({sh:sh,wc:wc,group:cn})});
        });
        return flat;
    }
    // DEFAULT for Springskytte: one flat cross-class table, class carried in a Klass column instead of
    // group headers. On an SM C-field the ~10 age/gender headers cost ~10 rows per pass (plus a repeat
    // whenever a page opens mid-class); one narrow column costs none, so that many more shooters fit.
    //
    // Ranked on Totaltid ascending, and ONLY shooters who have FINISHED are ranked. A shooter mid-course
    // has accumulated less time than the finishers, so a naive sort puts someone who is still out running
    // at the very top of the board — the "least time on the track" trap. Those shooters are the "Nyss
    // startat" band's job, not the table's, which keeps the two halves of the screen non-overlapping:
    // the band is who is running, the table is who is done.
    //   DNF → bottom of the table (did start, has no time).  DNS → never shown (never took the line;
    //   the server excludes it from the band for the same reason).
    //
    // The # column is the OVERALL position, so the gold/silver/bronze cell tint follows it. Placement in
    // Springskytte is per class, though, so the class leaders get their own discreet row cue instead —
    // otherwise a shooter leading D 50 is indistinguishable from mid-field.
    function springFlatSorted(groups){
        var fin=[],dnf=[];
        groups.forEach(function(cg){
            var wc=cg.weaponClass||'C';
            var cls=cg.ageGenderClass||cg.AgeGenderClass||'';
            (cg.shooters||[]).forEach(function(sh){
                var row={sh:sh,wc:wc,cls:cls,classRank:sh.rank||0};
                if(sh.status){
                    if(String(sh.status).toUpperCase()==='DNS')return;
                    dnf.push(row);return;
                }
                if(sh.totalTimeSeconds===null||sh.totalTimeSeconds===undefined)return;   // still out
                fin.push(row);
            });
        });
        fin.sort(function(a,b){
            var d=(a.sh.totalTimeSeconds||0)-(b.sh.totalTimeSeconds||0);
            if(d)return d;
            d=(a.classRank||99)-(b.classRank||99);            // server tiebreaker already ordered per class
            if(d)return d;
            return (a.sh.name||'').localeCompare(b.sh.name||'','sv');
        });
        fin.forEach(function(r,i){r.overall=i+1});
        return fin.concat(dnf);
    }
    // How many rows fit on this screen. Everything is measured from the real rendered DOM rather than
    // assumed: font sizes scale with the kiosk's zoom factor, and the on-course band's height varies
    // with how many shooters are out, so a fixed row count would overflow the screen on most TVs —
    // which is the exact truncation this paging exists to prevent.
    function springCapacity(wr){
        if(rowsPerPage>0)return rowsPerPage;
        var h=wr.clientHeight||0;
        if(!h||!springRowH)return 20;                     // conservative until we've measured once
        var avail=h-springBandH-springHeadH-28;           // 28 ≈ the "Sida x/y" line
        // −1 row of slack. In grouped mode it covers group-header rows being taller than shooter rows
        // while being budgeted as one; in flat mode there are no headers, but the row is kept as margin —
        // overflowing the bottom edge re-creates the exact truncation this paging exists to prevent, and
        // one row is a cheap insurance premium against a TV whose reported height is off.
        return Math.max(6,Math.floor(avail/springRowH)-1);
    }
    function springPaginate(flat,cap){
        var pages=[],i=0,guard=0;
        while(i<flat.length&&guard++<200){
            var cont=(flat[i]&&flat[i].sh)?flat[i].group:null;   // page opens mid-class → repeat header
            var budget=Math.max(1,cap-(cont?1:0)),rows=[];
            while(i<flat.length&&rows.length<budget){rows.push(flat[i]);i++}
            // Never end a page on a dangling group header with its shooters overleaf.
            if(rows.length>1&&!rows[rows.length-1].sh&&i<flat.length){rows.pop();i--}
            pages.push({rows:rows,cont:cont});
        }
        return pages.length?pages:[{rows:[],cont:null}];
    }
    // Springskytte result board — shot dots kept deliberately (the biathlon-style hit/miss row is the
    // most legible thing on the screen from across a hall); compact mode drops Bom instead.
    function renderSpringskytte(wr,groups){
        if(!groups.length&&!springBoard){wr.innerHTML='<div style="text-align:center;padding:3rem 0;opacity:.5"><i class="bi bi-inbox" style="font-size:2rem"></i><p>Inga resultat</p></div>';return}
        var showKlass=!springGrouped;
        var nCols=(compact?8:9)+(showKlass?1:0);
        var h=springBandHtml();
        var flat=springGrouped?springFlatRows(groups):springFlatSorted(groups);
        // Only prefix the weapon group in the Klass cell when more than one is on screen — at an SM it is
        // one group at a time (?wc=C) and "C" on every row is pure noise.
        var multiWc=false;
        if(showKlass){
            var seenWc={},nWc=0;
            flat.forEach(function(r){if(r.wc&&!seenWc[r.wc]){seenWc[r.wc]=1;nWc++}});
            multiWc=nWc>1;
        }
        if(!flat.length){
            wr.innerHTML=h+'<div style="text-align:center;padding:2rem 0;opacity:.5"><p>Inga resultat än</p></div>';
            springPageCount=1;return;
        }
        var pages=springPaginate(flat,springCapacity(wr));
        springPageCount=pages.length;
        if(pageIdx>=pages.length)pageIdx=0;
        var pg=pages[pageIdx];

        h+='<table class="rb-table" id="rbSpringTable">';
        h+='<colgroup><col style="width:2.5rem"><col style="width:2.5rem"><col><col>';
        h+=(showKlass?'<col style="width:7rem">':'');
        h+='<col><col style="width:5rem">'+(compact?'':'<col style="width:3rem">')+'<col style="width:4.5rem"><col style="width:5.5rem"></colgroup>';
        h+='<thead><tr><th>#</th><th>Nr</th><th style="text-align:left">Namn</th><th style="text-align:left">Förening</th>';
        h+=(showKlass?'<th style="text-align:left;white-space:nowrap">Klass · Pos</th>':'');
        h+='<th>Skytte</th><th>Löptid</th>'+(compact?'':'<th>Bom</th>')+'<th>Tillägg</th><th>Totaltid</th></tr></thead><tbody>';

        function groupRow(label,first){
            return '<tr><td colspan="'+nCols+'" style="background:#0f3460;color:#4ecca3;font-weight:700;padding:'
                +(compact?'.35rem':'.6rem')+' .5rem;font-size:.95rem;text-align:left;border-bottom:2px solid #4ecca3'
                +(first?'':';border-top:4px solid #1a1a2e')+'">'+label+'</td></tr>';
        }
        if(pg.cont)h+=groupRow(pg.cont+' <span style="opacity:.6;font-weight:400">(forts.)</span>',true);
        pg.rows.forEach(function(r,ri){
            if(!r.sh){h+=groupRow(r.group,ri===0&&!pg.cont);return}
            var sh=r.sh,status=sh.status||null;
            // Grouped mode: # is the rank within the class (straight from the server). Flat mode: # is the
            // overall position, and the class rank moves into the Klass cell.
            var rank=showKlass?(r.overall||0):(sh.rank||0);
            var pc=rank>=1&&rank<=3&&!status?' rb-pos-'+rank:'';
            var isClassLeader=showKlass&&!status&&r.classRank===1;
            // Discreet class-leader cue: a tinted row + a green edge on the first cell. The edge lives on
            // the TD, not as a box-shadow on the TR — the table is border-collapse:collapse, where a
            // shadow on a row is not reliably painted, but a cell border always is.
            var trStyle=(compact?'padding-top:.2rem;padding-bottom:.2rem;':'')
                +(isClassLeader?'background:rgba(78,204,163,.07);':'');
            var pad=trStyle?' style="'+trStyle+'"':'';
            var firstTd=isClassLeader?' style="border-left:3px solid #4ecca3"':'';
            var so=sh.startOrder||'';
            var klassCell='';
            if(showKlass){
                var rk=r.classRank>=1
                    ?' <span style="color:'+(isClassLeader?'#4ecca3':'#8892b0')+';font-weight:'+(isClassLeader?'700':'400')+'">· '+r.classRank+'</span>'
                    :'';
                klassCell='<td style="text-align:left;white-space:nowrap">'
                    +esc((multiWc?r.wc+' ':'')+(r.cls||''))+rk+'</td>';
            }
            if(status){
                h+='<tr'+pad+'><td>-</td><td>'+esc(so)+'</td><td style="text-align:left">'+esc(sh.name||'')+'</td><td style="text-align:left">'+esc(sh.clubShort||sh.club||'')+'</td>'+klassCell;
                h+='<td colspan="'+(nCols-(showKlass?5:4))+'" style="text-align:center;opacity:.6">'+esc(status)+'</td></tr>';
            } else {
                h+='<tr'+pad+'><td class="'+pc.trim()+'"'+firstTd+'>'+(rank||'-')+'</td><td>'+esc(so)+'</td><td style="text-align:left">'+esc(sh.name||'')+'</td><td style="text-align:left">'+esc(sh.clubShort||sh.club||'')+'</td>'+klassCell;
                h+='<td>'+renderShotDots(sh,r.wc)+'</td>';
                h+='<td>'+esc(sh.sprintTimeDisplay||'-')+'</td>';
                if(!compact)h+='<td>'+(sh.shootingScore||0)+'</td>';
                h+='<td>'+esc(sh.penaltyTimeDisplay||'-')+'</td>';
                h+='<td><strong>'+esc(sh.totalTimeDisplay||'-')+'</strong></td></tr>';
            }
        });
        h+='</tbody></table>';
        if(pages.length>1)
            h+='<div style="text-align:right;opacity:.55;padding:.3rem .2rem 0;font-size:.85rem">Sida '+(pageIdx+1)+'/'+pages.length+'</div>';
        wr.innerHTML=h;

        // Measure the real band / header / row heights, and re-page once if they changed. Guarded by a
        // reentrancy flag so a layout that measures slightly differently each pass can't ping-pong.
        var bandEl=wr.querySelector('#rbSpringBand'),headEl=wr.querySelector('#rbSpringTable thead'),probe=wr.querySelector('#rbSpringTable tbody tr');
        var bh=bandEl?bandEl.offsetHeight:0,hh=headEl?headEl.offsetHeight:0,rh=probe?probe.offsetHeight:0;
        if(rh&&(rh!==springRowH||bh!==springBandH||hh!==springHeadH)&&!springRemeasuring){
            springRowH=rh;springBandH=bh;springHeadH=hh;
            springRemeasuring=true;
            renderSpringskytte(wr,groups);
            springRemeasuring=false;
        }
    }

    function isUnshot(shot){return !shot||shot===''||shot==='-'}

    // Render compact shot dots for table row — Class C: green/red dots, Class A: zone numbers
    function renderShotDots(sh,wc){
        var series=sh.shotSeries||sh.ShotSeries||[];
        if(!series.length)return'<span style="opacity:.3">-</span>';
        var h='<span style="display:inline-flex;gap:3px;flex-wrap:nowrap">';
        if(wc==='C'){
            series.forEach(function(station,si){
                var allEmpty=(station||[]).every(isUnshot);
                if(allEmpty)return; // skip unshot stations entirely in compact view
                if(si>0)h+='<span style="width:1px;background:rgba(255,255,255,.15);margin:0 1px"></span>';
                (station||[]).forEach(function(shot){
                    if(isUnshot(shot)){h+='<span style="display:inline-block;width:8px;height:8px;border-radius:50%;border:1px solid rgba(255,255,255,.2)"></span>';return}
                    var isHit=shot==='H'||shot==='h';
                    h+='<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:'+(isHit?'#27ae60':'#e74c3c')+'"></span>';
                });
            });
        } else {
            // Class A — zone counts per target, show penalty score per target
            var zp=[0,0,1,2,3];
            series.forEach(function(station,si){
                var allEmpty=(station||[]).every(isUnshot);
                if(allEmpty)return;
                if(si>0)h+='<span style="width:1px;background:rgba(255,255,255,.15);margin:0 1px"></span>';
                var ts=0;(station||[]).forEach(function(s,zi){var v=parseInt(s)||0;ts+=v*(zp[zi]||0)});
                var c=ts===0?'#27ae60':ts<=2?'#8bc34a':ts<=4?'#f39c12':'#e74c3c';
                h+='<span style="display:inline-flex;align-items:center;justify-content:center;min-width:16px;height:16px;border-radius:.2rem;background:'+c+';font-size:.65rem;color:#fff;font-weight:700;padding:0 2px">'+ts+'</span>';
            });
        }
        h+='</span>';
        return h;
    }

    // Render larger shot card for "Senast in" banner
    function renderShotCard(sh,wc){
        var series=sh.shotSeries||sh.ShotSeries||[];
        if(!series.length)return'';
        var h='<div style="display:flex;gap:.5rem;flex-wrap:wrap;margin:.25rem 0">';
        if(wc==='C'){
            series.forEach(function(station,si){
                var allEmpty=(station||[]).every(isUnshot);
                var shotCount=(station||[]).filter(function(s){return !isUnshot(s)}).length;
                if(allEmpty)return; // skip entirely unshot stations
                var hits=(station||[]).filter(function(s){return s==='H'||s==='h'}).length;
                h+='<div style="background:rgba(255,255,255,.05);border-radius:.35rem;padding:.3rem .5rem;display:flex;align-items:center;gap:4px">';
                h+='<span style="font-size:.7rem;opacity:.4;margin-right:2px">'+(si+1)+'</span>';
                (station||[]).forEach(function(shot){
                    if(isUnshot(shot)){h+='<span style="display:inline-block;width:12px;height:12px;border-radius:50%;border:1.5px solid rgba(255,255,255,.15)"></span>';return}
                    var isHit=shot==='H'||shot==='h';
                    h+='<span style="display:inline-block;width:12px;height:12px;border-radius:50%;background:'+(isHit?'#27ae60':'#e74c3c')+'"></span>';
                });
                h+='<span style="font-size:.75rem;margin-left:3px;color:'+(hits===shotCount&&shotCount>0?'#27ae60':'rgba(255,255,255,.5)')+'">'+hits+'/'+shotCount+'</span>';
                h+='</div>';
            });
        } else {
            // Class A — show zone values
            series.forEach(function(station,si){
                var allEmpty=(station||[]).every(isUnshot);
                if(allEmpty)return;
                var sum=(station||[]).filter(function(s){return !isUnshot(s)}).reduce(function(a,s){return a+(parseInt(s)||0)},0);
                h+='<div style="background:rgba(255,255,255,.05);border-radius:.35rem;padding:.3rem .5rem;display:flex;align-items:center;gap:4px">';
                h+='<span style="font-size:.7rem;opacity:.4;margin-right:2px">'+(si+1)+'</span>';
                (station||[]).forEach(function(shot){
                    if(isUnshot(shot)){h+='<span style="display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;border:1.5px solid rgba(255,255,255,.15)"></span>';return}
                    var v=parseInt(shot)||0;
                    var c=v===0?'#27ae60':v===1?'#8bc34a':v===2?'#f39c12':'#e74c3c';
                    h+='<span style="display:inline-flex;align-items:center;justify-content:center;width:14px;height:14px;border-radius:50%;background:'+c+';font-size:.6rem;color:#fff;font-weight:700">'+v+'</span>';
                });
                h+='<span style="font-size:.75rem;margin-left:3px;opacity:.5">'+sum+'</span>';
                h+='</div>';
            });
        }
        h+='</div>';
        return h;
    }
    function persistLayout(){try{localStorage.setItem('hpsk_rb_layout_'+compId,layoutMode==='grid'?('grid'+tileCount):'list')}catch(e){}}
    // Keep the URL in sync with current state so the board is castable: copy the address to a TV/kiosk.
    function syncUrl(){
        try{
            var qp=new URLSearchParams(location.search);
            qp.set('c',compId);
            var wcsel=Object.keys(selectedWCs||{});
            if(wcsel.length)qp.set('wc',wcsel.join(','));else qp.delete('wc');
            if(layoutMode==='grid')qp.set('tiles',tileCount);else qp.delete('tiles');
            if(cycleMode)qp.set('vaxla','1');else qp.delete('vaxla');
            history.replaceState(null,'','?'+qp.toString());
        }catch(e){}
    }
    // Init: localStorage defaults, then URL params override (so a cast URL is deterministic), then wire controls
    (function(){
        try{
            var lay=localStorage.getItem('hpsk_rb_layout_'+compId);
            if(lay==='list')layoutMode='list';
            else if(lay&&lay.indexOf('grid')===0){layoutMode='grid';tileCount=Math.max(1,Math.min(4,parseInt(lay.slice(4))||4))}
            cycleMode=localStorage.getItem('hpsk_rb_cycle_'+compId)==='1';
        }catch(e){}
        var qp=new URLSearchParams(location.search);
        var wcp=qp.get('wc');
        if(wcp){selectedWCs={};wcp.split(',').forEach(function(w){w=(w||'').trim().toUpperCase();if(w)selectedWCs[w]=1})}
        var tp=qp.get('tiles');
        if(tp!==null){var t=parseInt(tp);if(t>=1&&t<=4){layoutMode='grid';tileCount=t}}
        var vp=qp.get('vaxla');
        if(vp==='1'||vp==='true')cycleMode=true;else if(vp==='0'||vp==='false')cycleMode=false;
        // Springskytte board tuning, URL-only (no on-screen control — these are set once per venue):
        //   ?compact=1  denser rows, drops Bom      ?rows=N  fixed rows/page instead of auto-fit
        var cp=qp.get('compact');
        if(cp==='1'||cp==='true')compact=true;
        var rp=parseInt(qp.get('rows'));
        if(rp>0&&rp<=200)rowsPerPage=rp;
        //   ?grupper=1  restore per-class group headers instead of the flat Klass-column table
        var gp=qp.get('grupper');
        if(gp==='1'||gp==='true')springGrouped=true;
        //   ?qr=1|0     force the results-QR panel on/off (default: on once results are official)
        var qrp=qp.get('qr');
        if(qrp==='1'||qrp==='true')qrMode='1';
        else if(qrp==='0'||qrp==='false')qrMode='0';
        var ct=document.getElementById('rbCycleToggle');
        if(ct){ct.checked=cycleMode;ct.addEventListener('change',function(){cycleMode=this.checked;cycleIdx=0;persistCycle();syncUrl();renderAll();restartCycle()})}
        var ls=document.getElementById('rbLayoutSel');
        if(ls){
            ls.value=layoutMode==='grid'?('grid'+tileCount):'list';
            ls.addEventListener('change',function(){
                var v=this.value;
                if(v==='list')layoutMode='list';
                else{layoutMode='grid';tileCount=Math.max(1,Math.min(4,parseInt(v.slice(4))||4))}
                cycleIdx=0;persistLayout();syncUrl();renderAll();restartCycle();
            });
        }
    })();
    function startSpringTimers(){
        if(!isSpringskytte)return;
        if(!pageTimer)pageTimer=setInterval(springPageTick,PAGE_MS);
        startSpringTick();
    }
    function stopSpringTimers(){
        if(pageTimer){clearInterval(pageTimer);pageTimer=null}
        stopSpringTick();
    }
    document.addEventListener('visibilitychange',function(){
        if(document.hidden){if(refreshTimer){clearInterval(refreshTimer);refreshTimer=null}stopCycle();stopSpringTimers()}
        else{fetchResults();refreshTimer=setInterval(fetchResults,REFRESH);restartCycle();startSpringTimers()}
    });
    fetchResults();refreshTimer=setInterval(fetchResults,REFRESH);restartCycle();startSpringTimers();
}
</script>
