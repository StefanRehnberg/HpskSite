@model HpskSite.Models.Staffing.InviteResponseModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Din placering – pistol.nu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">
<div class="container" style="max-width:520px">
    <div class="card shadow-sm mt-5">
        <div class="card-body p-4">
            @if (!Model.Valid)
            {
                <h1 class="h5"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Ogiltig länk</h1>
                <p class="text-muted mb-0">Länken är ogiltig eller har gått ut. Kontakta arrangören om du undrar över din placering.</p>
            }
            else
            {
                <h1 class="h5 mb-3"><i class="bi bi-person-badge me-2"></i>Din placering</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Notice))
                {
                    <div class="alert alert-info py-2" role="status" data-svar-notice>@Model.Notice</div>
                }
                <p class="mb-1">Hej @Model.PersonName!</p>
                <p>Arrangören har gett dig @(Model.Placements.Count > 1 ? "de här placeringarna" : "den här placeringen") under <strong>@Model.CompName</strong>:</p>
                <ul class="list-group mb-3" data-svar-placements>
                    @foreach (var p in Model.Placements)
                    {
                        <li class="list-group-item">
                            <strong>@p.RoleName</strong>
                            @if (!string.IsNullOrWhiteSpace(p.ScopeLabel)) { <span class="text-muted"> · @p.ScopeLabel</span> }
                            @if (!string.IsNullOrWhiteSpace(p.When)) { <span class="d-block">@p.When</span> }
                        </li>
                    }
                </ul>
                <p class="text-muted small mb-0">Du behöver inte svara. Kan du inte, kontakta arrangören — svara på mejlet du fick.</p>
            }
        </div>
    </div>
</div>
</body>
</html>
