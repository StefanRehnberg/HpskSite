@model HpskSite.Models.Staffing.InviteResponseModel
@{
    Layout = null;
    var accepted = string.Equals(Model.Status, "Accepted", StringComparison.OrdinalIgnoreCase);
    var declined = string.Equals(Model.Status, "Declined", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Funktionärsförfrågan – pistol.nu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body class="bg-light">
<div class="container" style="max-width:520px">
    <div class="card shadow-sm mt-5">
        <div class="card-body p-4">
            @if (!Model.Valid)
            {
                <h1 class="h5"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Ogiltig länk</h1>
                <p class="text-muted mb-0">Länken är ogiltig eller har gått ut. Kontakta arrangören om du vill svara på förfrågan.</p>
            }
            else
            {
                <h1 class="h5 mb-3"><i class="bi bi-person-badge me-2"></i>Funktionärsförfrågan</h1>
                <p class="mb-1">Hej @Model.PersonName!</p>
                <p>Du är tillfrågad som <strong>@Model.RoleName</strong> på <strong>@Model.ScopeLabel</strong>
                   under <strong>@Model.CompName</strong>@(string.IsNullOrEmpty(Model.ShiftLabel) ? "" : $" ({Model.ShiftLabel})").</p>

                @if (accepted)
                {
                    <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>Tack! Du har <strong>tackat ja</strong>. Du kan ändra ditt svar nedan om något ändras.</div>
                }
                else if (declined)
                {
                    <div class="alert alert-secondary"><i class="bi bi-x-circle me-2"></i>Du har <strong>tackat nej</strong>. Du kan ändra ditt svar nedan om du ändrar dig.</div>
                }

                <form method="post" action="/mina-uppdrag/svar" class="d-flex gap-2 mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="t" value="@Model.Token" />
                    <button type="submit" name="status" value="Accepted" class="btn @(accepted ? "btn-success" : "btn-outline-success") flex-fill"><i class="bi bi-check-lg me-1"></i>Tacka ja</button>
                    <button type="submit" name="status" value="Declined" class="btn @(declined ? "btn-danger" : "btn-outline-danger") flex-fill"><i class="bi bi-x-lg me-1"></i>Tacka nej</button>
                </form>
                <p class="text-muted small mt-3 mb-0">Ditt svar skickas till arrangören.</p>
            }
        </div>
    </div>
</div>
</body>
</html>
