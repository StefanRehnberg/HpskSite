@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Ekonomi";
    var Model = ViewData["EkonomiData"] as HpskSite.Controllers.EkonomiPageModel
                ?? new HpskSite.Controllers.EkonomiPageModel();
    var uid = $"ek{Model.IssuerType}_{Model.IssuerId}";
    // Ordet för föreningens årsavgift: kretsen tar kretsavgift av klubbarna, klubben medlemsavgift.
    var feeWord = Model.IssuerType == 1 ? "Kretsavgift" : "Medlemsavgifter";
    // Sandlådornas id räknas NEDÅT, så den nyaste har det lägsta id:t.
    var newestSandbox = Model.Issuers.Where(i => i.IsSandbox).OrderBy(i => i.Id).FirstOrDefault();
}
@*
    Kassorens arbetsyta. Innehallet foljer Ekonomi Exempel/Ekonomi_Wireframes.pdf - oppna den
    innan du andrar nagot har.

    AVSTEG FRAN SKISSEN, MED FLIT (Stefan 2026-09-22): skissen ar ett fristaende dokument utan
    sajtens ram. Den LEVANDE ytan behaller headern och formspraket, precis som /styrelse - det
    ar samma sorts arbetsyta, och /styrelse loste redan fragan. Bara UTSKRIFTER (protokoll,
    kvitto) kor Layout = null. Skissens accentfarg och serif ar darfor utbytta mot --bs-*;
    det som ar kvar ar det som BAR BETYDELSE: numrerade paneler, fragor som rubriker, tonade
    rader dar nagot saknas, och "Inget" i stallet for en nolla.

    Fyra railposter har ingen motor an. De sager vad de ska gora och visar ALDRIG ett belopp.
*@
@* ⚠️ ALLT ar scopat under .ek-page och bygger pa --bs-*-variabler. Dels foljer morkt lage och
   temat da med av sig sjalvt, dels kan inget harifran lacka ut i resten av sajten. Klasser som
   krockar med Bootstrap (nav, card, btn, alert) ar omdopta till ek-*; utan det staller ramverket
   railen pa hogkant och kort utan variant blir osynliga.
   Toppniva-<style> i en VY ar OK - /styrelse gor samma sak. Det ar i en PARTIAL det 500:ar. *@
@* ⚠️⚠️ DATUM SKRIVS OCH VISAS ALLTID SOM ÅÅÅÅ-MM-DD. <input type="date"> renderas i
   WEBBLÄSARENS språk — på en svensk dator med engelskt gränssnitt blev fälten dd/mm/yyyy,
   vilket Stefan såg direkt. Husregeln i CLAUDE.md är entydig: flatpickr med locale 'sv' och
   dateFormat 'Y-m-d', aldrig ett HTML5-datumfält. Ekonomiytan var undantaget.
   ⚠️ Formatet 'Y-m-d' gör att fältets .value fortsätter vara ISO — alltså är varje läsning
   och varje payload i den här filen oförändrad. Det är det som gör bytet ofarligt. *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>
<style>
  .ek-page { --ek-attn: #B45309; --ek-attn-bg: #FBF4EC; --ek-attn-line: #E8D5BE; }
  [data-bs-theme="dark"] .ek-page { --ek-attn: #E0A566; --ek-attn-bg: #2A2118; --ek-attn-line: #4A3A24; }

  /* ── Sandlådemärkning ───────────────────────────────────────────────────────
     ⚠️ Egen färg, INTE den orangea. Orange betyder redan "detta saknas" i den här ytan;
     låter vi den också betyda "du är i en sandlåda" slutar båda betyda något. Lila är
     obesatt i produkten och läses som "annat läge", inte som "fel". */
  .ek-sandbox-bar { position: sticky; top: 0; z-index: 1030;
      background: #6B21A8; color: #fff; padding: .5rem 1rem; font-size: .9rem;
      display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
  .ek-sandbox-bar strong { letter-spacing: .1em; }
  .ek-sandbox-name { background: rgba(255,255,255,.18); padding: .1rem .6rem; border-radius: 2rem; }
  .ek-sandbox-meta { opacity: .75; font-size: .85rem; }
  /* Ramen: perifer och alltid synlig, aven efter att raden scrollats forbi. */
  .ek-page.ek-is-sandbox { outline: 3px solid #6B21A8; outline-offset: -3px; }

  .ek-page .wrap { display: flex; gap: 1.5rem; align-items: flex-start; }

  /* ⚠️ SAMMA INRAMNING SOM ADMINRAILEN pa klubb- och kretssidan (ClubAdminPanel .admin-rail):
     egen yta i --bs-tertiary-bg med ram och radie, sa den laeser som en panel och inte som
     flytande text. Ar dessutom samma bredd, samma radie pa posterna och samma sticky-toppning. */
  .ek-page .rail { width: 250px; flex-shrink: 0; position: sticky; top: 1rem;
      background-color: var(--bs-tertiary-bg); border: 1px solid var(--bs-border-color);
      border-radius: .5rem; padding: 8px; }
  .ek-page .rail .brand { display: none; }
  .ek-page .rail .club { font-size: 1.1rem; font-weight: 700; padding: 6px 12px 0; }
  .ek-page .rail .role { font-size: .8rem; color: var(--bs-secondary-color);
      padding: 0 12px 10px; }
  .ek-page .rail a.ek-nav { display: block; text-align: left; padding: 8px 12px;
      border-radius: 8px; color: var(--bs-body-color); text-decoration: none;
      border-left: 3px solid transparent; }
  /* Ett steg upp fran railens egen yta, annars syns inte hover. */
  .ek-page .rail a.ek-nav:hover { background-color: var(--bs-secondary-bg); }
  /* ⚠️⚠️ AKTIV POST AR BLA, INTE ORANGE. -text-emphasis pa -bg-subtle ar Bootstraps
     kontrastsakra par i BADA temana, och det ar samma markering som resten av adminytorna.
     Orange ar reserverat for BETYDELSE — "detta saknas" — och tappar sin kraft i samma
     sekund den ocksa betyder "har ar du". */
  .ek-page .rail a.ek-nav.on { font-weight: 600;
      background-color: var(--bs-primary-bg-subtle); color: var(--bs-primary-text-emphasis);
      border-left-color: var(--bs-primary); }
  .ek-page .rail a.ek-nav.soon { color: var(--bs-secondary-color); }
  /* Tillbaka ar en utgang, inte en vy — avskild med en linje och i dampad ton, sa den inte
     konkurrerar med de sex posterna som ar arbetet. */
  .ek-page .rail a.ek-back { color: var(--bs-secondary-color); font-size: .9rem;
      padding-bottom: 10px; margin-bottom: 6px; border-bottom: 1px solid var(--bs-border-color);
      border-radius: 0; }
  .ek-page .rail a.ek-back:hover { color: var(--bs-link-color); background: none; }

  .ek-page .ek-issuer-switch { margin-top: 1rem; padding: 10px 12px 4px;
      border-top: 1px solid var(--bs-border-color); }
  .ek-page .ek-issuer { display: block; font-size: .85rem; padding: 4px 8px; border-radius: 6px;
      color: var(--bs-body-color); text-decoration: none; }
  .ek-page .ek-issuer.on { font-weight: 700; background: var(--bs-secondary-bg); }
  /* ⚠️ BÅDA posterna bär en markör. Bar bara sandlådan en, läste den omärkta raden ovanför som
     en rubrik över den — vilket är precis vad som rapporterades. */
  .ek-page .ek-issuer.sb::before { content: "⬤ "; color: #6B21A8; font-size: .7em; }
  .ek-page .ek-issuer.live::before { content: "⬤ "; color: var(--bs-secondary-color); font-size: .7em; }
  .ek-page .ek-issuer-head { font-size: .7rem; letter-spacing: .05em; text-transform: uppercase;
      color: var(--bs-secondary-color); padding: 0 8px 4px; }
  .ek-page .ek-issuer-why { font-size: .75rem; color: var(--bs-secondary-color); margin-top: 6px; }

  /* ⚠️⚠️ `flex: 1 1 auto` MASTE staa uttryckligen. Sajtens layout satter `main { flex: 1 0 auto }`
     pa ELEMENTET (sticky footer-monstret), sa flex-shrink ar 0 — och da vagrar ytan krympa hur
     mycket min-width:0 man an satter. Matt 2026-09-22: .ek-main blev 2010 px i en 1296 px bred
     container och panel 2 och 4 hamnade utanfor skarmen. Att doypa om KLASSEN hjalper inte, for
     regeln traeffar taggen. */
  .ek-page .ek-main { flex: 1 1 auto; min-width: 0; }
  .ek-page .head { display: flex; justify-content: space-between; align-items: flex-start;
      gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .ek-page h1 { font-size: 1.9rem; font-weight: 700; margin: 0; }
  .ek-page .sub { color: var(--bs-secondary-color); margin-top: .2rem; }
  .ek-page .pills { display: flex; gap: .5rem; flex-wrap: wrap; }
  .ek-page .pill { border: 1px solid var(--bs-border-color); border-radius: 2rem;
      padding: .3rem .85rem; font-size: .9rem; text-decoration: none;
      color: var(--bs-body-color); background: var(--bs-body-bg); white-space: nowrap; }
  .ek-page .pill.strong { border-color: var(--bs-primary); color: var(--bs-primary-text-emphasis);
      background-color: var(--bs-primary-bg-subtle); font-weight: 600; border-radius: .5rem; }

  /* ⚠️ minmax(0,1fr), inte 1fr. En grid-kolumn har min-width:auto som standard, sa en bred
     tabell inuti vagrar krympa och rutnatet svammar ut ur containern — panel 2 och 4 hamnade
     utanfor skarmkanten. */
  .ek-page .ek-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .ek-page .ek-card { background: var(--bs-body-bg); border: 1px solid var(--bs-border-color);
      border-radius: .75rem; padding: 1.15rem 1.25rem; }
  .ek-page .ek-card.wide { grid-column: 1 / -1; }
  .ek-page .ek-cardh { display: flex; justify-content: space-between; align-items: baseline;
      gap: .75rem; margin-bottom: .9rem; }
  .ek-page .ek-cardh h2 { font-size: 1.15rem; font-weight: 700; margin: 0; }
  .ek-page .meta { font-size: .875rem; color: var(--bs-secondary-color); }

  /* Skissens tonade problemrad — den enda platsen accentfargen bar betydelse. */
  .ek-page .todo { display: flex; align-items: center; gap: .9rem; background: var(--ek-attn-bg);
      border: 1px solid var(--ek-attn-line); border-radius: .5rem; padding: .65rem .9rem;
      margin-bottom: .5rem; }
  .ek-page .todo .n { font-size: 1.1rem; font-weight: 700; min-width: 2rem; text-align: right; }
  .ek-page .todo .t { flex-grow: 1; }
  .ek-page .todo.done { background: var(--bs-success-bg-subtle);
      border-color: var(--bs-success-border-subtle); }

  .ek-page .ek-bigbox { background: var(--bs-success-bg-subtle);
      border: 1px solid var(--bs-success-border-subtle); border-radius: .5rem; padding: 1.15rem 1.25rem; }
  .ek-page .ek-bigbox .amount { font-size: 2.2rem; font-weight: 700;
      color: var(--bs-success-text-emphasis); line-height: 1.1; }
  .ek-page .ek-bigbox .lead { color: var(--bs-success-text-emphasis); font-weight: 600; font-size: 1rem; }
  .ek-page .ek-bigbox .note { color: var(--bs-secondary-color); font-size: .9rem; margin-top: .25rem; }
  .ek-page .ek-bigbox.ek-warn { background: var(--ek-attn-bg); border-color: var(--ek-attn-line); }
  .ek-page .ek-bigbox.ek-warn .amount, .ek-page .ek-bigbox.ek-warn .lead { color: var(--ek-attn); }

  .ek-page .why { color: var(--bs-secondary-color); font-size: .875rem; margin-top: .75rem; }
  .ek-page .muted { color: var(--bs-secondary-color); font-size: .9rem; }

  .ek-page table.t { width: 100%; border-collapse: collapse; }
  .ek-page table.t th { text-align: left; font-size: .72rem; letter-spacing: .04em;
      text-transform: uppercase; color: var(--bs-secondary-color); padding: .4rem .6rem;
      border-bottom: 1px solid var(--bs-border-color); }
  .ek-page table.t td { padding: .55rem .6rem; border-top: 1px solid var(--bs-border-color-translucent); }
  .ek-page table.t td.n, .ek-page table.t th.n { text-align: right;
      font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* ⚠️ Tonad rad DAR NAGOT SAKNAS. Textfargen sätts uttryckligen: arvd muted text pa en ljus
     rad ar osynlig i morkt lage. */
  .ek-page table.t tr.gap td { background: var(--ek-attn-bg); color: var(--bs-body-color); }
  .ek-page table.t td.miss { color: var(--ek-attn); font-weight: 700; }
  .ek-page table.t td.fine { color: var(--bs-success-text-emphasis); font-weight: 600; }
  .ek-page table.t td.date { color: var(--bs-secondary-color); white-space: nowrap; }

  .ek-page .rows > div { display: flex; gap: .6rem; padding: .45rem 0;
      border-bottom: 1px solid var(--bs-border-color-translucent); }
  .ek-page .rows > div:last-child { border-bottom: 0; }
  .ek-page .rows .grow { flex-grow: 1; min-width: 0; overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap; }
  .ek-page .rows .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .ek-page .kvitto { color: var(--bs-success-text-emphasis); font-weight: 700; font-size: .8rem;
      text-decoration: none; }

  .ek-page .more { margin-top: .6rem; font-size: .9rem; }
  /* Navigation, inte varning — darfor sajtens bla. */
  .ek-page .more button, .ek-page .linkbtn { background: none; border: 0; padding: 0;
      color: var(--bs-link-color); font: inherit; font-weight: 600; cursor: pointer; }

  /* ⚠️⚠️ .ek-btn ar BORTTAGEN — knapparna ar Bootstraps (.btn .btn-primary /
     .btn-sm .btn-outline-secondary). Den gamla ek-small ritade dessutom "Lagg till" i
     ACCENTFARGEN, och accenten betyder "detta saknas" i den har ytan (se .todo .a). En
     neutral handling i varningsfarg later hela sidan se ut att ha ett problem, och nar
     accenten betyder tva saker slutar den betyda nagon. */

  .ek-page .ek-alert { border: 1px solid var(--bs-border-color); border-radius: .5rem;
      padding: .6rem .85rem; margin-bottom: .9rem; font-size: .95rem; }
  .ek-page .ek-alert.ek-warn { border-color: var(--ek-attn-line); background: var(--ek-attn-bg);
      color: var(--ek-attn); }
  .ek-page .ek-alert.ek-bad { border-color: var(--bs-danger-border-subtle);
      background: var(--bs-danger-bg-subtle); color: var(--bs-danger-text-emphasis); }
  /* Under test-rutan: rubriken är alltid synlig, innehållet går att fälla ihop. */
  /* ⚠️ Specificiteten måste slå .ek-alert.ek-warn — annars blir hela texten i
     varningsfärgen, och tre stycken orange text är tunga att läsa. Bara rubriken bär färgen. */
  .ek-page .ek-alert.ek-beta { color: var(--bs-body-color); margin-bottom: 1.25rem; }
  .ek-page .ek-beta summary { cursor: pointer; color: var(--ek-attn); }
  .ek-page .ek-beta[open] summary { margin-bottom: .5rem; }
  .ek-page .ek-beta-body ol { padding-left: 1.25rem; margin-bottom: .6rem; }
  .ek-page .ek-beta-body li { margin-bottom: .5rem; }
  .ek-page .ek-beta-body p { margin-bottom: .5rem; }
  .ek-page .ek-alert.ek-ok { border-color: var(--bs-success-border-subtle);
      background: var(--bs-success-bg-subtle); color: var(--bs-success-text-emphasis); }

  .ek-page .choice { display: flex; gap: .7rem; align-items: flex-start;
      border: 1px solid var(--bs-border-color); border-radius: .5rem; padding: .8rem .9rem;
      margin-bottom: .5rem; cursor: pointer; }
  .ek-page .fields { display: flex; gap: 1rem; flex-wrap: wrap; margin: 1rem 0 .3rem; }
  .ek-page .fields label { display: flex; flex-direction: column; gap: .25rem; font-size: .8rem;
      font-weight: 700; color: var(--bs-secondary-color); }
  /* ⚠️⚠️ FORMKONTROLLERNA AR BOOTSTRAPS — .form-control / .form-select / .btn, samma som
     resten av pistol.nu. Har fanns tidigare en EGEN uppsattning padding, ram, radie och
     bakgrund, alltsa ett andra formsprak som bara LIKNADE sajtens; Stefan 2026-09-22:
     "jag upplever det fortfarande som att designspraket i ekonomidelen inte ar samma som
     pa resten av pistol.nu". Varre var att kontonamnets ruta och kontovaljaren inte hade
     nagon klass alls och alltsa renderades som webblasarens RAFORM.
     Det enda som far bo har ar BREDD — allt utseende kommer fran ramverket.
     ⚠️ Bootstrap satter width:100% pa .form-control/.form-select. Inuti en <label> utan egen
     bredd kollapsar det till etikettens TEXT, sa bredden maste sagas uttryckligen. */
  .ek-page .fields label { min-width: 11rem; }
  .ek-page .fields input, .ek-page .fields select { width: 100%; }
  .ek-page .amount-row label { display: flex; flex-direction: column; gap: .25rem;
      font-size: .8rem; font-weight: 700; color: var(--bs-secondary-color); }
  .ek-page .amount-row label input, .ek-page .amount-row label select { width: 11rem; }
  .ek-page .wide-in { width: 100%; max-width: 34rem; }

  .ek-page .soonbox { border: 1px dashed var(--bs-border-color); border-radius: .75rem;
      padding: 1.15rem 1.25rem; background: var(--bs-body-bg); }
  .ek-page .soonbox h2 { font-size: 1.15rem; font-weight: 700; margin: 0 0 .4rem; }

  /* Lågmäld, men i läsvägen och alltid synlig — den förklarar varför railen är kortare. */
  .ek-page .ek-readonly-note { font-size: .82rem; color: var(--bs-secondary-color);
      padding: 8px 12px 10px; border-bottom: 1px solid var(--bs-border-color); margin-bottom: 6px; }

  /* ── Rapport: utfall mot budget ───────────────────────────────────────────
     ⚠️ Stapeln ar utfallet som andel av budgeten, KAPAD vid 100 %. En stapel som
     vaxer forbi sin egen ram laeser som ett fel i ytan, inte som en avvikelse —
     och avvikelsen star redan utskriven i kronor och procent bredvid. */
  .ek-page .rep-bar { width: 11rem; height: .5rem; border-radius: 1rem;
      background: var(--bs-secondary-bg); overflow: hidden; }
  .ek-page .rep-bar i { display: block; height: 100%; background: var(--bs-secondary-color); }
  .ek-page .rep-bar.ok i { background: var(--bs-success); }
  .ek-page .rep-bar.attn i { background: var(--ek-attn); }
  .ek-page table.t td.barcell { width: 12rem; }
  /* Avsnittsrubrik i tabellen. Bar ingen siffra — den skiljer bara intakt fran kostnad. */
  .ek-page table.t tr.grp td { font-size: .72rem; letter-spacing: .04em; text-transform: uppercase;
      color: var(--bs-secondary-color); font-weight: 700; padding-top: 1.1rem; border-top: 0; }
  .ek-page table.t tr.sum td { font-weight: 700; background: var(--bs-tertiary-bg);
      border-top: 2px solid var(--bs-border-color); }
  .ek-page .rep-amt { width: 8rem; text-align: right; font-variant-numeric: tabular-nums; }
  /* ⚠️ Kontonamnet fyller sin kolumn. En smal ruta mitt i en bred kolumn läses som avstängd. */
  .ek-page input.chart-name { width: 100%; box-sizing: border-box; }
  .ek-page table.t td.chart-off { color: var(--bs-secondary-color); }
  .ek-page .headactions { display: flex; gap: .6rem; flex-wrap: wrap; }
  /* Utfallslistan hor till raden ovanfor, sa den ar indragen och avskild med en linje. */
  .ek-page .ek-drill { margin-top: 1rem; padding: .9rem 0 0 1rem;
      border-top: 1px solid var(--bs-border-color); border-left: 3px solid var(--bs-border-color); }
  .ek-page tr.ek-clickable { cursor: pointer; }
  .ek-page tr.ek-clickable:hover td { background: var(--bs-tertiary-bg); }
  .ek-page tr.ek-open td { background: var(--bs-tertiary-bg); font-weight: 600; }
  /* Rymmer ÅÅÅÅ-MM-DD utan att kapa. Bootstraps width:100% duger inte i en <label>. */
  .ek-page .ek-date { width: 11rem; }

  /* ── Utskrift: underlaget till styrelsemötet ──────────────────────────────
     ⚠️ Skissens primara knapp ar en LEVERANS, inte en vy. Papperet ar det som laeses
     pa motet, sa railen, sajtens header och alla andra paneler maste bort — annars
     far styrelsen tre sidor meny och en tabell. */
  @@media print {
      .ek-page .rail, .ek-page .headactions, .ek-page .ek-sandbox-bar,
      .ek-page .soonbox, .ek-page #@(uid)_repPeriodBox { display: none !important; }
      .ek-page .wrap { display: block; }
      .ek-page .ek-card { border: 0; padding: 0; }
      .ek-page table.t tr.sum td { background: none; }
      .ek-page .ek-noprint { display: none !important; }
      /* Sajtens ram hör inte till handlingen. */
      body > header, body > footer, #cookieConsentBanner, body .position-fixed,
      .chat-toggle-btn, .chat-panel,
      .ek-page section[data-pane="bokslut"] > .head { display: none !important; }
      .ek-page .ek-printonly { display: block !important; }
      .ek-page .ek-grid { display: block; }
      .ek-page .ek-grid > .ek-card { margin-bottom: 1.5rem; break-inside: avoid; }
  }
  .ek-page .ek-printonly { display: none; }

  /* ── Bokför ──────────────────────────────────────────────────────────────── */
  .ek-page .bokfor-grid { display: grid; grid-template-columns: minmax(0, 1fr) 22rem; gap: 1rem;
      align-items: start; }
  .ek-page .fieldlabel { display: block; font-weight: 700; font-size: .9rem; margin: 1.1rem 0 .4rem; }
  .ek-page .fieldlabel:first-child { margin-top: 0; }
  .ek-page .amount-row { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  .ek-page .amount-in { font-size: 1.8rem; font-weight: 700; width: 12rem; padding: .5rem .9rem;
      border-width: 2px; border-color: var(--bs-primary); font-variant-numeric: tabular-nums; }
  .ek-page .kr-unit { color: var(--bs-secondary-color); }
  .ek-page .chips { display: flex; gap: .4rem; flex-wrap: wrap; margin-top: .5rem; }
  .ek-page .preview { margin-top: 1.25rem; border-top: 1px solid var(--bs-border-color);
      padding-top: .9rem; }

  @@media (max-width: 991px) {
    .ek-page .wrap { flex-direction: column; }
    .ek-page .rail { width: auto; position: static; display: flex; flex-wrap: wrap;
        gap: .3rem; align-items: center; }
    .ek-page .rail .club, .ek-page .rail .role { width: 100%; margin-bottom: .3rem; }
    .ek-page .rail a.ek-nav { border-left: 0; }
    .ek-page .rail a.ek-nav.on { border-left: 0; box-shadow: inset 0 -3px 0 var(--bs-primary); }
    .ek-page .rail .foot { width: 100%; }
    .ek-page .ek-grid, .ek-page .bokfor-grid { grid-template-columns: 1fr; }
    .ek-page .amount-in { width: 100%; }
    /* ⚠️⚠️ UTTRYCKLIG BREDD, och min-width:0 räcker inte. I kolumnläget ärver .wrap
       `align-items: flex-start` från datorlayouten, så .ek-main fick sitt INNEHÅLLS minsta bredd —
       och en tabell med fasta kolumnbredder gjorde den bredare än skärmen. Mätt 2026-09-23 på 390 px:
       sex av tio flikar rullade i sidled (Bokslut 764, Tillgångar 634, Projekt 568). Med bredden
       satt får tabellen i stället rulla INUTI sitt kort. Inga rullgardinsmenyer ligger i korten,
       så overflow klipper ingenting — lägg aldrig en dit utan att ta bort den här regeln. */
    .ek-page .ek-main { width: 100%; }
    .ek-page .ek-card { overflow-x: auto; }
  }
</style>

@* ⚠️ container-FLUID, inte container. Sajtens standard ar full bredd (Master.cshtml har
   <main class="container-fluid">, och klubbsidan med sin adminrail likasa). /styrelse ar den
   MEDVETNA avvikelsen - smal rad och stor text for aldre lasare - men den ar loptext och
   formular. Kassorsytan ar TABELLER: per tavling, kon att bokfora, konteringsforslaget. De
   vinner pa bredden, och en smal kolumn hade tvingat fram vagrat radbrytning i sifferkolumner. *@
@* ══ SANDLÅDEMÄRKNING ════════════════════════════════════════════════════════════════════
   ⚠️⚠️ TRE SAMVERKANDE SIGNALER, och valet är inte smak:

   1. EN TEXTRAD I LÄSVÄGEN. Ordet "SANDLÅDA" står skrivet, inte antytt. WCAG 1.4.1: information
      får aldrig bäras av färg ensam — var tionde man ser inte skillnad på den orangea ramen.
      Raden går inte att stänga; en märkning man kan klicka bort är ingen märkning.
   2. EN RAM RUNT YTAN. Perifert och alltid synligt, även när man scrollat förbi raden. Samma
      grepp som betaltjänsters testläge, och det överlever en skärmdump — vilket spelar roll
      den dag någon mejlar en bild och frågar "varför står det så här?".
   3. MÄRKNING PÅ HANDLINGARNA. Kvittot bär sin egen stämpel (se LedgerReceipt.cshtml). En
      utskrift lämnar sidan och tar ingen ram med sig.

   ⛔ INGEN VATTENSTÄMPEL ÖVER INNEHÅLLET. Sidan är till för att läsa siffror, och en stämpel
      tvärs över gör exakt det svårare. Den signal som förstör uppgiften är fel signal. *@
@if (Model.IsSandbox)
{
    <div class="ek-sandbox-bar">
        <strong>SANDLÅDA</strong>
        <span>Inget här är riktig bokföring. Allt kan kastas.</span>
        @if (!string.IsNullOrWhiteSpace(Model.SandboxLabel))
        {
            <span class="ek-sandbox-name">@Model.SandboxLabel</span>
        }
        @if (Model.SandboxCreatedUtc is not null)
        {
            <span class="ek-sandbox-meta">skapad @Model.SandboxCreatedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd")</span>
        }
    </div>
}

<div class="ek-page container-fluid py-4 @(Model.IsSandbox ? "ek-is-sandbox" : "")"
     id="@uid" data-issuer-type="@Model.IssuerType" data-issuer-id="@Model.IssuerId"
     data-owner-id="@Model.OwnerId" data-sandbox="@(Model.IsSandbox ? "1" : "0")"
     data-can-write="@(Model.CanWrite ? "1" : "0")">

@* ══ UNDER TEST ═══════════════════════════════════════════════════════════════════════
           Stefan 2026-09-24: ekonomidelen är ny, och så många som möjligt ska hjälpa till att
           testa — i en sandlåda. Tre varianter, för att rådet måste gå att följa för den som läser:
             · kassören i den riktiga bokföringen: skapa (eller öppna) en sandlåda,
             · kassören i en sandlåda: vad som är värt att prova och hur man rapporterar,
             · en läsare (styrelse/revisor): sandlådan är kassörens, men felrapporten är allas.
           ⚠️ Knapparna står I RUTAN, intill texten som ber om handlingen — ett råd som pekar på en
              knapp någon annanstans är ett råd ingen hittar ([[en-text-far-inte-hanvisa-till-det-osynliga]]).
           ⚠️ Rutan går att FÄLLA IHOP men aldrig ta bort: rubriken står kvar, så beskedet att delen
              är under test följer med varje besök. Läget minns per webbläsare (localStorage i
              try/catch — sidan fungerar utan). *@
        <details class="ek-alert ek-warn ek-beta" id="@(uid)_beta" open>
            <summary><strong>Ekonomidelen är ny och testas just nu</strong>@(Model.IsSandbox ? " — tack för att du provar!" : "")</summary>
            <div class="ek-beta-body">
                @if (!Model.IsSandbox)
                {
                    <p>Pistol.nu:s ekonomidel fungerar, men den har bara använts av ett fåtal föreningar.
                       Fel hittas när fler provar, så pistol.nu vill att så många som möjligt testar den.</p>
                }
                @if (Model.CanWrite && !Model.IsSandbox)
                {
                    <p class="mb-1"><strong>Så här provar du utan risk:</strong></p>
                    <ol>
                        <li><strong>Skapa en sandlåda.</strong> En sandlåda är en övningsbokföring: allt fungerar
                            som på riktigt, men ingenting blir vår riktiga bokföring. Styrelsen och revisorn ser
                            den inte.
                            <div class="mt-2">
                                @if (newestSandbox is null)
                                {
                                    <button type="button" class="btn btn-sm btn-primary" id="@(uid)_betaCreate">Skapa en sandlåda</button>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-primary" href="/ekonomi?type=@Model.IssuerType&id=@Model.OwnerId&issuer=@newestSandbox.Id">Öppna vår sandlåda</a>
                                }
                            </div>
                        </li>
                        <li><strong>Lägg in ett år du redan har facit för.</strong> Ge sandlådan räkenskapsåret 2025
                            och läs in 2025 från vårt gamla program som en SIE-fil, eller skriv in det. Jämför sedan
                            resultat- och balansräkningen med årsredovisningen.</li>
                        <li><strong>Säg till när något är fel, konstigt eller svårt att förstå.</strong> Skriv vad du
                            gjorde och vad du väntade dig — en skärmbild hjälper.
                            <div class="mt-2">
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#bugReportModal">Rapportera fel</button>
                            </div>
                        </li>
                    </ol>
                    <p class="small mb-0">Avgifter och fakturor går inte att prova i sandlådan, men de testas av sig
                       själva: anmälningsavgifter för tävlingar och evenemang bokförs automatiskt i den riktiga
                       bokföringen när betalningen markeras som mottagen. Det gäller tävlingar som får sin första
                       anmälan efter 24 september 2026.</p>
                }
                else if (Model.IsSandbox)
                {
                    <p>Allt du gör här är övning och kan kastas. Bäst är ett år du redan har facit för: ge
                       sandlådan räkenskapsåret 2025, läs in 2025 från vårt gamla program som en SIE-fil eller
                       skriv in det, och jämför resultat- och balansräkningen med årsredovisningen.</p>
                    <p>Hittar du något som är fel, konstigt eller svårt att förstå, skriv vad du gjorde och vad
                       du väntade dig — en skärmbild hjälper.</p>
                    <p class="mb-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#bugReportModal">Rapportera fel</button>
                    </p>
                    <p class="small mb-0">Avgifter och fakturor finns bara i den riktiga bokföringen, där anmälningsavgifter
                       för tävlingar och evenemang bokförs automatiskt när betalningen markeras som mottagen. Dit kommer du tillbaka under <strong>Du arbetar i</strong> längst ned i menyn.
                       Vill du börja om skapar du en ny sandlåda där.</p>
                }
                else
                {
                    <p>Kassören kan prova allt i en sandlåda, en övningsbokföring som bara hen ser. Ser du något
                       som är fel, konstigt eller svårt att förstå, skriv vad du gjorde och vad du väntade dig.</p>
                    <p class="mb-0">
                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#bugReportModal">Rapportera fel</button>
                    </p>
                }
            </div>
        </details>

<div class="wrap">

    <nav class="rail">
        <div class="brand">Pistol.nu</div>
        <div class="club">@Model.IssuerName</div>
        <div class="role">@(Model.CanWrite ? "Kassör" : "Styrelsen") · @Model.CurrentYear</div>

        @* ⚠️⚠️ FRÅNVARON MÅSTE FÖRKLARAS. En yta där knapparna bara saknas läses som trasig —
           läsaren undrar om hen gjort fel, inte om hen har fel roll. *@
        @if (!Model.CanWrite)
        {
            <div class="ek-readonly-note">
                Du läser föreningens ekonomi som styrelseledamot.
                <strong>Det är kassören som bokför.</strong>
            </div>
        }

        @* ⚠️ Tillbaka ligger ÖVERST och är alltid första railposten. Den låg förut som en länk i
           en fotnot längst ned, tillsammans med skissens rationalisering "Menyn är kassörens år,
           inte databasens tabeller" — den meningen var en anteckning till oss om VARFÖR menyn ser
           ut som den gör, inte något en kassör behöver läsa. Den bor i koden, inte i granssnittet. *@
        <a href="@Model.BackUrl" class="ek-nav ek-back">← Tillbaka</a>

        <a href="#" class="ek-nav on" data-view="oversikt">Översikt</a>
        @* ⚠️ Skrivytorna renderas INTE för en läsare. En knapp som nekas är sämre än ingen
           knapp — och den riktiga gränsen ligger i endpointarna, inte här. *@
        @if (Model.CanWrite)
        {
            <a href="#" class="ek-nav" data-view="bokfor">Bokför</a>
        }
        @* ⚠️ Verifikationerna ligger direkt efter Bokför, inte bland rapporterna. Det är dit man
           går för att LETA REDA PÅ en post — "vad var det där på 3 400 i mars?" — och det är en
           daglig fråga, inte en årlig. *@
        <a href="#" class="ek-nav" data-view="verifikationer">Verifikationer</a>
        <a href="#" class="ek-nav" data-view="avstamning">Avstämning</a>
        <a href="#" class="ek-nav" data-view="rapport">Rapport</a>
        @* ⚠️ Projekt ligger intill Rapport: det är samma sorts fråga ("vad gav tävlingen?") och
           läses av styrelsen och revisorn lika mycket som av kassören — därför INTE gated på
           skrivrätt. Skrivkontrollerna inuti är det. *@
        <a href="#" class="ek-nav" data-view="projekt">Projekt</a>
        <a href="#" class="ek-nav" data-view="avgifter">Avgifter</a>
        @* ⚠️ Fakturorna bodde i klubbens och kretsens ADMINPANEL (Admin → Fakturor) fram till
           2026-09-24 (Stefan: "Allt under Admin / Fakturor för klubbar och Kretsar ska in under
           Ekonomin"). Tävlingsavgifterna i den nya modellen, fakturorna till klubbar, inkommande
           fakturor och den gamla modellens lista — på ETT ställe. Läsbart för styrelsen. *@
        <a href="#" class="ek-nav" data-view="fakturor">Fakturor</a>
        @* ⚠️ Årsavgiften bodde förut i klubbens/kretsens ADMINPANEL (flyttad 2026-09-23). Det är
           kassörens arbete, och här har den rätt behörighet: kassören skriver, styrelsen läser. *@
        <a href="#" class="ek-nav" data-view="arsavgift">@feeWord</a>
        <a href="#" class="ek-nav" data-view="utgifter">Utgifter</a>
        <a href="#" class="ek-nav" data-view="tillgangar">Tillgångar</a>
        <a href="#" class="ek-nav" data-view="bokslut">Bokslut</a>
        @if (Model.CanWrite)
        {
            <a href="#" class="ek-nav" data-view="installningar" id="@(uid)_toggleSetup">Inställningar</a>
            <a href="#" class="ek-nav" data-view="revisorer">Revisorer</a>
        }

        @* ⚠️ Växlaren ligger SIST och lågmält. Att byta liggare är sällsynt och allvarligt;
           den ska gå att hitta, inte att råka klicka på. *@
        @* ⚠️ Sandlådan är kassörens kladdpapper. En läsare ser bara den riktiga liggaren. *@
        @if (Model.CanWrite)
        {
        <div class="ek-issuer-switch">
            @* ⚠️ Rubriken är inte pynt. Utan den läste den FÖRSTA posten ("Riktig bokföring") som
               en rubrik över den andra — den var omärkt och låg rakt ovanför den markerade
               sandlådan. Nu bär båda posterna samma markör, och rubriken säger vad listan ÄR. *@
            <div class="ek-issuer-head">Du arbetar i</div>
            @foreach (var i in Model.Issuers)
            {
                var isActive = i.Id == Model.IssuerId;
                <a href="/ekonomi?type=@Model.IssuerType&id=@Model.OwnerId@(i.IsSandbox ? $"&issuer={i.Id}" : "")"
                   class="ek-issuer @(isActive ? "on" : "") @(i.IsSandbox ? "sb" : "live")">
                    @(i.IsSandbox ? (string.IsNullOrWhiteSpace(i.Label) ? "Sandlåda" : i.Label) : "Riktig bokföring")
                </a>
            }
            <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-start mt-2" id="@(uid)_newSandbox">
                @(Model.Issuers.Any(i => i.IsSandbox) ? "Börja om i ny sandlåda" : "Skapa en sandlåda")
            </button>
            <div class="ek-issuer-why">
                En sandlåda kastas genom att du skapar en ny. Inget raderas — den gamla lämnas bara.
            </div>
            <div class="ek-alert ek-bad d-none" id="@(uid)_sandboxError"></div>
        </div>
        }

    </nav>

    <main class="ek-main">

        <div id="@(uid)_loading" class="muted">Läser ekonomiuppgifter…</div>
        <div id="@(uid)_error" class="ek-alert ek-warn d-none"></div>

        <div id="@(uid)_shell" class="d-none">

            @* ══ ÖVERSIKT ═══════════════════════════════════════════════════════════ *@
            <section data-pane="oversikt">
                <div class="head">
                    <div>
                        @* ⚠️ Hette "Är något fel?" (skissens rubrik) — lästes som ett larm av den som öppnar
                           sidan första gången (Stefan 2026-09-24). Rubriken säger VAR man är, samma ord
                           som menyvalet; frågorna står på korten, var och en med sitt svar intill. *@
                        <h1>Översikt</h1>
                        <div class="sub" id="@(uid)_today"></div>
                    </div>
                    @* Vad inställningen ÄR, som text. Ändras under Inställningar — aldrig härifrån. *@
                    @* ⚠️ En bricka utan fråga är en gåta. Den bar bara "Hel bokföring" — eller, före
                       uppsättningen, "Inte uppsatt" utan förklaring, vilket lästes som ett fel (Stefan
                       2026-09-24: "Ove 72 år blir rädd"). Nu står frågan intill svaret, och före
                       uppsättningen ersätts brickan av vägen framåt. Räkenskapsåret visas bara när ett
                       år finns — annars påstår brickan ett år som inte är upplagt. *@
                    <div class="pills">
                        <span class="ek-shape-wrap @(Model.IsSetUp ? "" : "d-none")" id="@(uid)_shapeWrap">
                            <span class="muted small">Vi använder pistol.nu till:</span>
                            <span class="badge bg-light text-dark border fw-normal" style="font-size:.9rem" id="@(uid)_shapeBadge">@Model.ShapeLabel</span>
                        </span>
                        @if (Model.CanWrite)
                        {
                            <button type="button" class="btn btn-sm btn-primary @(Model.IsSetUp ? "d-none" : "")" id="@(uid)_setupStart">Kom igång: välj hur vi använder ekonomin</button>
                        }
                        else
                        {
                            <span class="muted small @(Model.IsSetUp ? "d-none" : "")" id="@(uid)_setupPending">Kassören har inte valt hur vi använder ekonomin än.</span>
                        }
                        <span class="badge bg-primary-subtle text-primary-emphasis border fw-semibold @(Model.IsSetUp ? "" : "d-none")" style="font-size:.9rem" id="@(uid)_yearBadge">Räkenskapsår @Model.CurrentYear</span>
                    </div>
                </div>

                <div class="ek-grid">
                    <div class="ek-card">
                        <div class="ek-cardh">
                            <h2>1 · Väntar något på mig?</h2>
                            <span class="meta" id="@(uid)_todoCount"></span>
                        </div>
                        <div id="@(uid)_todo"></div>
                    </div>

                    <div class="ek-card">
                        <div class="ek-cardh"><h2>2 · Stämmer det?</h2></div>
                        @* ⚠️⚠️ PANELEN VISAR VERKLIGT LAGE och far ALDRIG saga "0 kr - allt
                           stammer" pa en avstamning som inte gjorts. Det vore en logn om att vi
                           kontrollerat mot banken.

                           ⚠️ Texten pastod "den byggs harnast" anda efter att P11 byggts - en
                           hanvisning som blev falsk i samma stund funktionen blev klar. Darfor
                           renderas den har rutan nu ur DATA, inte som fast text. *@
                        <div class="ek-bigbox ek-warn" id="@(uid)_recPanel">
                            <div class="lead" id="@(uid)_recPanelLead">Inte avstämt mot banken än</div>
                            <div class="note" id="@(uid)_recPanelNote">
                                Avstämningen läser in vårt kontoutdrag och matchar rad för rad.
                                Tills någon gjort det vet vi vad som bokförts — inte att det är komplett.
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2"
                                    data-view="avstamning" id="@(uid)_recPanelGo">Gå till Avstämning</button>
                        </div>
                    </div>

                    <div class="ek-card">
                        <div class="ek-cardh">
                            <h2>3 · Hur går året?</h2>
                        </div>
                        @* Skissens kort 3: tva staplar och en rad om beslutet. Samma motor som
                           Rapport-ytan — kortet far ALDRIG rakna sjalvt, da kan de tva saga olika
                           saker om samma ar. *@
                        <div id="@(uid)_yearBars" class="d-none">
                            <div class="rows">
                                <div><span class="grow">Intäkter</span>
                                     <span class="num" id="@(uid)_yrIncome">—</span></div>
                            </div>
                            <div class="rep-bar ok" style="width:100%;margin:.15rem 0 .8rem">
                                <i id="@(uid)_yrIncomeBar" style="width:0"></i>
                            </div>
                            <div class="rows">
                                <div><span class="grow">Kostnader</span>
                                     <span class="num" id="@(uid)_yrCost">—</span></div>
                            </div>
                            <div class="rep-bar" style="width:100%;margin:.15rem 0 0">
                                <i id="@(uid)_yrCostBar" style="width:0"></i>
                            </div>
                            <div class="why" id="@(uid)_yrNote"></div>
                        </div>
                        @* ⚠️ Erbjud aldrig en åtgärd rollen inte kan utföra. En läsare som klickar
                           "Lägg in den" möts av en Rapport-yta utan knapp, och undrar vad hen gjorde fel. *@
                        <div id="@(uid)_yearNoBudget" class="d-none">
                            <p class="muted" style="margin-top:0">
                                Budget mot utfall kräver en antagen budget.
                                @if (Model.CanWrite)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-view="rapport">Lägg in budgeten</button>
                                }
                                else
                                {
                                    <text>Kassören lägger in den.</text>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="ek-card">
                        <div class="ek-cardh">
                            <h2>4 · Vad hände senast?</h2>
                        @* ⚠️ Rubriken sätts av JS: "Bokförda verifikationer" när föreningen
                           bokför här, annars "Mottagna betalningar". En fast rubrik hade beskrivit
                           fel lista för den ena av dem. *@
                            <span class="meta" id="@(uid)_recvMeta">Mottagna betalningar</span>
                        </div>
                        <div class="rows" id="@(uid)_recvBody"></div>
                        <div class="muted d-none" id="@(uid)_recvEmpty">Inga betalningar ännu.</div>
                        <div class="more" id="@(uid)_recvMore"></div>
                    </div>
                </div>

                <p class="why">
                    @* ⚠️ Texten påstod att "de flesta posterna skriver ingen människa". Det är sant
                       för en klubb vars ekonomi är tävlingsavgifter, och falskt för den som för
                       hela sin bokföring här — alltså den vi bygger liggaren för. *@
                    Anmälningar och avgifter bokförs av sig själva. Resten — hyran, inköpen,
                    bidragen — lägger kassören in under Bokför.
                </p>
            </section>

            @* ══ AVGIFTER ══════════════════════════════════════════════════════════ *@
            <section data-pane="avgifter" hidden>
                <div class="head">
                    <div>
                        <h1>Vad har vi att få in?</h1>
                        <div class="sub">Avgifter som begärts, och vad som saknas per tävling.</div>
                    </div>
                </div>

                <div class="ek-grid">
                    <div class="ek-card">
                        <div class="ek-cardh"><h2>Att få in</h2></div>
                        <div class="ek-bigbox" id="@(uid)_outBox">
                            <div class="amount" id="@(uid)_outTotal">—</div>
                        </div>
                        <div class="rows" id="@(uid)_outRows" style="margin-top:14px"></div>
                    </div>

                    <div class="ek-card" id="@(uid)_fullOnly">
                        <div class="ek-cardh">
                            <h2>Att bokföra</h2>
                            <span class="meta d-none" id="@(uid)_queueBadge"></span>
                        </div>
                        <p class="muted" style="margin-top:0">
                            Mottagna betalningar som ännu inte blivit verifikationer. De uppstår när
                            pengarna togs emot innan bokföringen var igång.
                        </p>
                        <div id="@(uid)_queueEmpty" class="ek-alert ek-ok d-none">Allt mottaget är bokfört.</div>
                        <div class="d-none" id="@(uid)_queueWrap">
                            <table class="t">
                                <thead>
                                    <tr><th>Mottaget</th><th>Betalare</th><th class="n">Belopp</th><th></th></tr>
                                </thead>
                                <tbody id="@(uid)_queueBody"></tbody>
                            </table>
                        </div>
                        <div class="more" id="@(uid)_queueMore"></div>
                        <div class="ek-alert ek-bad d-none" id="@(uid)_queueError"></div>
                    </div>

                    @* ⚠️ Läsbryggan (P3/P4): betalda fakturor i det GAMLA fakturasättet, betalda efter att
                       föreningen började bokföra här. Utan kortet hade pengarna stått utanför bokföringen
                       tyst — tävlingar i den gamla modellen lever kvar hela sin livstid. *@
                    @if (!Model.IsSandbox)
                    {
                        <div class="ek-card wide d-none" id="@(uid)_legacyPost">
                            <div class="ek-cardh"><h2>Betalda fakturor enligt det gamla sättet</h2><span class="meta" id="@(uid)_legacyPostMeta"></span></div>
                            <p class="muted" style="margin-top:0">Tävlingar som fick sina första anmälningar före bytet har kvar de gamla fakturorna. De som betalats sedan ni började bokföra här ska bli verifikationer.</p>
                            <table class="t"><thead><tr><th>Betald</th><th>Faktura</th><th>Betalare</th><th class="n">Belopp</th></tr></thead><tbody id="@(uid)_legacyPostBody"></tbody></table>
                            @if (Model.CanWrite)
                            {
                                <button type="button" class="btn btn-sm btn-primary mt-2" id="@(uid)_legacyPostBtn">Bokför dem</button>
                            }
                            <div class="small mt-2" id="@(uid)_legacyPostMsg"></div>
                        </div>
                        <script>
                        (function () {
                            var uid = '@uid', issuerType = @Model.IssuerType, issuerId = @Model.IssuerId;
                            var $ = function (s) { return document.getElementById(uid + '_' + s); };
                            var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); };
                            var kr = function (v) { return (Number(v) || 0).toLocaleString('sv-SE') + ' kr'; };
                            function load() {
                                fetch('/umbraco/surface/EkonomiAdmin/GetLegacyInvoicesToPost?issuerType=' + issuerType + '&issuerId=' + issuerId, { credentials: 'same-origin' })
                                    .then(function (r) { return r.json(); })
                                    .then(function (d) {
                                        var card = $('legacyPost');
                                        if (!d.success || !d.invoices || !d.invoices.length) { card.classList.add('d-none'); return; }
                                        card.classList.remove('d-none');
                                        $('legacyPostMeta').textContent = d.invoices.length + ' st · ' + kr(d.total);
                                        $('legacyPostBody').innerHTML = d.invoices.map(function (i) {
                                            return '<tr class="gap"><td>' + esc(i.paidDate) + '</td><td>' + esc(i.number) + ' <span class="muted">' + esc(i.competition) + '</span></td><td>' + esc(i.payer) + '</td><td class="n">' + kr(i.amount) + '</td></tr>';
                                        }).join('');
                                    });
                            }
                            window.hpskEkonomiLoadLegacyPost = load;
                            var btn = $('legacyPostBtn');
                            if (btn) btn.addEventListener('click', function () {
                                btn.disabled = true;
                                fetch('/umbraco/surface/Club/GetFormToken', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (t) {
                                    return fetch('/umbraco/surface/EkonomiAdmin/PostLegacyInvoices', {
                                        method: 'POST', credentials: 'same-origin',
                                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': t.token },
                                        body: JSON.stringify({ issuerType: issuerType, issuerId: issuerId })
                                    });
                                }).then(function (r) { return r.json(); }).then(function (d) {
                                    var m = $('legacyPostMsg'); m.className = 'small mt-2 ' + (d.success ? 'text-success' : 'text-danger'); m.textContent = d.message;
                                    btn.disabled = false; load();
                                });
                            });
                        })();
                        </script>
                    }

                    @* ⚠️⚠️ MEDLEMSAVGIFTEN ÄR KLUBBENS STÖRSTA INTÄKTSPOST och nådde inte
                       bokföringen förrän 2026-09-22 — avgiftsmodulen har egen tabell och egen
                       betalvägg. Kortet finns för att den luckan ska vara SYNLIG, inte tyst. *@
                    <div class="ek-card wide d-none" id="@(uid)_feesCard">
                        <div class="ek-cardh">
                            @* ⚠️ Rubriken sätts ur svaret: en krets har KRETSavgifter, inte
                               medlemsavgifter. Samma kort, samma motor, olika ord. *@
                            <h2 id="@(uid)_feesTitle">@(Model.IssuerType == 1 ? "Kretsavgifter" : "Medlemsavgifter")</h2>
                            <span class="meta" id="@(uid)_feesYear"></span>
                        </div>

                        @* ⚠️ Sandlådan har inga medlemsavgifter att visa, och tystnad om det är
                           oskiljbart från "alla har betalat" — på årets största intäktspost. *@
                        <div class="ek-alert ek-warn d-none" id="@(uid)_feesSandbox"></div>

                        <div class="ek-grid" id="@(uid)_feesNumbers" style="gap:14px">
                            <div>
                                <div class="muted">Har inte kommit in</div>
                                <div style="font-size:26px;font-weight:700" id="@(uid)_feesUnpaid">—</div>
                            </div>
                            <div>
                                <div class="muted">Betalt men inte bokfört</div>
                                <div style="font-size:26px;font-weight:700" id="@(uid)_feesUnposted">—</div>
                                <div style="margin-top:10px">
                                    @if (Model.CanWrite)
                                    {
                                    <button type="button" class="btn btn-sm btn-primary d-none" id="@(uid)_feesPost">
                                        Bokför dem
                                    </button>
                                    }
                                </div>
                            </div>
                        </div>
                        <div style="margin-top:12px">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-view="arsavgift">Öppna @feeWord.ToLower()</button>
                        </div>
                        <div class="ek-alert ek-ok d-none" id="@(uid)_feesOk" style="margin-top:14px"></div>
                        <div class="ek-alert ek-bad d-none" id="@(uid)_feesError" style="margin-top:14px"></div>
                    </div>

                    <div class="ek-card wide">
                        <div class="ek-cardh">
                            <h2>Per tävling — saknas någon avgift?</h2>
                            <span class="meta">Det som saknas ligger överst</span>
                        </div>
                        <div class="muted d-none" id="@(uid)_perEmpty">
                            Inga tävlingar eller händelser med avgifter ännu.
                        </div>
                        <table class="t">
                            <thead>
                                <tr><th>Tävling</th><th class="n">Anmälda</th><th class="n">Betalt</th><th class="n">Saknas</th></tr>
                            </thead>
                            <tbody id="@(uid)_perBody"></tbody>
                        </table>
                        <div class="more" id="@(uid)_perMore"></div>

                        @* ⚠️⚠️ SIFFRAN GÅR INTE ATT AGERA PÅ — NAMNEN GÖR DET. "4 saknas" är det
                           Fredrik beskrev som okänt för kassören, men utan vägen hit är panelen
                           ett larm utan nästa steg, och kassören går tillbaka till just de
                           Pending-fakturor som ska ersättas. *@
                        <div class="ek-drill d-none" id="@(uid)_perDrill">
                            <div class="ek-cardh">
                                <h2 id="@(uid)_drillName"></h2>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        id="@(uid)_drillClose">Stäng listan</button>
                            </div>
                            <div class="ek-alert ek-bad d-none" id="@(uid)_drillError"></div>
                            <table class="t">
                                <thead>
                                    <tr><th>Betalare</th><th>Läge</th>
                                        <th class="n" style="width:8rem">Belopp</th>
                                        <th class="n" style="width:7rem">Kvitto</th></tr>
                                </thead>
                                <tbody id="@(uid)_drillBody"></tbody>
                            </table>
                            <div class="more" id="@(uid)_drillMore"></div>
                        </div>

                        <p class="why">
                            Den här raden är poängen. Bokföringen ser vad som kom in — den kan aldrig
                            se vad som borde ha kommit in.
                        </p>
                    </div>

                    @*
                        FORDRINGSEXPORTEN. Bara for den forening som bokfor NAGON ANNANSTANS.

                        ⚠️⚠️ Formen ar Fredriks (Varbergs PK): vi lamnar 1510 debet mot valt
                        intaktskonto nar avgiften uppstar, sa klubbens bankkoppling kan boka
                        1930/1510 nar pengarna kommer. Utan fordringsbenet skapar bankhandelsen
                        intakten en ANDRA gang - och det var just den dubbelbokforingen som holl
                        exporten borta fran den bankkopplade klubben.
                    *@
                    @* ⚠️ Prefixet är `fordr`, INTE `recv` — översiktens panel 4 äger redan
                       `recvBody`, och två element med samma id gör det andra dött för
                       getElementById. Följden var att fordringsraderna skrevs in i panel 4
                       medan den här tabellen stod tom. *@
                    <div class="ek-card wide d-none" id="@(uid)_fordrCard">
                        <div class="ek-cardh">
                            <h2>Fordringar till ert bokföringsprogram</h2>
                            <span class="meta" id="@(uid)_fordrMeta"></span>
                        </div>
                        <p class="muted" style="margin-top:0">
                            Filen bokför vad ni har rätt att få in — fordran mot intäkt. När pengarna
                            sedan syns på kontot bokar ert program bankkontot mot fordran, och
                            intäkten räknas en gång.
                        </p>

                        <div class="ek-alert ek-warn d-none" id="@(uid)_fordrMissing"></div>

                        <div class="amount-row">
                            <label>Från <input type="text" class="form-control ek-date"
                                   placeholder="åååå-mm-dd" id="@(uid)_fordrFrom"></label>
                            <label>Till <input type="text" class="form-control ek-date"
                                   placeholder="åååå-mm-dd" id="@(uid)_fordrTo"></label>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    id="@(uid)_fordrApply">Visa</button>
                        </div>

                        <table class="t" style="margin-top:.5rem">
                            <thead><tr><th style="width:9rem">Fordran</th><th>Avser</th>
                                <th class="n" style="width:5rem">Antal</th>
                                <th class="n" style="width:8rem">Belopp</th></tr></thead>
                            <tbody id="@(uid)_fordrBody"></tbody>
                        </table>

                        @* ⚠️ Perioden star UTSKRIVEN pa knappen. Samma period importerad tva ganger
                           dubbelbokfor intakten, och det ar den troligaste felhandlingen har. *@
                        <div class="amount-row" style="margin-top:1rem">
                            <a class="btn btn-primary" id="@(uid)_fordrDownload" href="#">Hämta SIE-fil</a>
                            <span class="muted" id="@(uid)_fordrWarn"></span>
                        </div>
                    </div>
                </div>
            </section>

            @* ── Fakturor och tävlingsavgifter (P3/P4) ──────────────────────────────────────────
               ⚠️ Samma modul (competition-fees.js) och samma endpoints som tävlingens Anmälningar-flik:
                  en bekräftelse här syns där, och tvärtom (Stefans beslut 2026-09-24).
               ⚠️ Tävlingsavgifter finns bara i den RIKTIGA bokföringen, som evenemangens. *@
            <section data-pane="fakturor" hidden>
                <div class="head">
                    <div>
                        <h1>Fakturor och tävlingsavgifter</h1>
                        <div class="sub">Vad tävlingarna ska ge, vad som är anmält betalt och vilka klubbar som har fått en faktura.</div>
                    </div>
                </div>
                @if (Model.IsSandbox)
                {
                    <div class="ek-card">
                        <div class="ek-alert ek-warn">
                            Tävlingsavgifter och fakturor finns bara i den riktiga bokföringen, inte i sandlådan.
                            <a href="/ekonomi?type=@Model.IssuerType&id=@Model.OwnerId&vy=fakturor">Gå till den riktiga bokföringen</a>.
                        </div>
                    </div>
                }
                else
                {
                    <div class="ek-card" id="@(uid)_feeComps">
                        <div class="ek-cardh"><h2>Tävlingar med avgifter</h2><span class="meta">Det som väntar på en avstämning ligger överst</span></div>
                        <div id="@(uid)_feeCompList" class="muted">Hämtar…</div>
                        <div id="@(uid)_feeCompPanel" class="mt-3"></div>
                    </div>
                    @* Ingen ek-card här: listan ritar sitt eget kort (samma som på Anmälningar-fliken). *@
                    <div id="@(uid)_feeInvoices" style="margin-bottom:1rem"></div>
                    @if (Model.IssuerType == 0)
                    {
                        <div class="ek-card" id="@(uid)_feeIncoming"></div>
                    }
                    @* ⚠️ Den gamla modellen, flyttad hit ORÖRD. Den räknas aldrig om och tas bort när
                       sista tävlingen i den är avslutad. Laddas först när den öppnas — listan är tung. *@
                    <details class="ek-card" id="@(uid)_legacyInvoices">
                        <summary class="fw-semibold" id="ekLegacyInvoicesToggle">Fakturor enligt det gamla sättet</summary>
                        <p class="muted mt-2">Tävlingar som fick sina första anmälningar före bytet. Där gäller fakturorna som förut — samlingsfaktura, kreditfaktura och markera betald.</p>
                        @if (Model.IssuerType == 1)
                        {
                            var regionNode = Umbraco.Content(Model.OwnerId);
                            var legacyVD = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData)
                            {
                                ["LockedRegionCode"] = regionNode?.Value<string>("regionCode") ?? "",
                                ["LockedRegionName"] = regionNode?.Name ?? "",
                                ["TabButtonId"] = "ekLegacyInvoicesToggle"
                            };
                            @await Html.PartialAsync("AdminInvoicesList", legacyVD)
                        }
                        else
                        {
                            <script>const clubId = @Model.OwnerId;</script>
                            @await Html.PartialAsync("ClubAdminInvoicesList")
                        }
                    </details>
                    <script src="/js/competition-fees.js?v=@DateTime.Now.Ticks"></script>
                    <script>
                    (function () {
                        var uid = '@uid', ownerType = @Model.IssuerType, ownerId = @Model.OwnerId;
                        var $ = function (s) { return document.getElementById(uid + '_' + s); };

                        function load() {
                            HpskFees.get('GetIssuerFees', { ownerType: ownerType, ownerId: ownerId }).then(function (d) {
                                if (!d.success) { $('feeCompList').textContent = d.message || 'Kunde inte hämta.'; return; }
                                var kr = HpskFees.kr, esc = HpskFees.esc;
                                if (!d.competitions.length) {
                                    $('feeCompList').innerHTML = '<div class="muted">Inga tävlingar med avgifter i den nya modellen ännu.</div>';
                                } else {
                                    $('feeCompList').innerHTML = '<table class="t"><thead><tr><th>Tävling</th><th class="n">Mottaget</th><th class="n">Anmält betalt</th><th class="n">Obetalt</th><th class="n">Fakturerat, obetalt</th><th></th></tr></thead><tbody>'
                                        + d.competitions.map(function (c) {
                                            var gap = c.claimed > 0 || c.open > 0 || c.invoicedOpen > 0;
                                            var cell = function (v) { return v > 0 ? kr(v) : 'Inget'; };
                                            return '<tr' + (gap ? ' class="gap"' : '') + ' data-comp="' + c.competitionId + '"><td>' + esc(c.name) + (c.date ? ' <span class="muted">' + esc(c.date) + '</span>' : '') + '</td>'
                                                + '<td class="n">' + cell(c.received) + '</td><td class="n">' + cell(c.claimed) + '</td><td class="n">' + cell(c.open) + '</td><td class="n">' + cell(c.invoicedOpen) + '</td>'
                                                + '<td class="n"><button type="button" class="btn btn-sm btn-outline-primary" data-open-comp="' + c.competitionId + '">Öppna</button></td></tr>';
                                        }).join('') + '</tbody></table>';
                                    $('feeCompList').querySelectorAll('[data-open-comp]').forEach(function (b) {
                                        b.addEventListener('click', function () {
                                            var panel = $('feeCompPanel');
                                            HpskFees.renderOrganiserPanel(panel, +b.dataset.openComp, { onChange: load });
                                            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                        });
                                    });
                                }
                                var inv = $('feeInvoices');
                                inv.innerHTML = HpskFees.renderInvoiceList(d.invoices, 'Fakturor till klubbar');
                                inv._data = { invoices: d.invoices };
                                HpskFees.wireInvoiceList(inv, load);
                                var inc = $('feeIncoming');
                                if (inc) {
                                    inc.innerHTML = '<div class="ek-cardh"><h2>Fakturor från andra föreningar</h2><span class="meta">Det klubben ska betala</span></div>'
                                        + (d.incoming.length ? '<table class="t"><thead><tr><th>Faktura</th><th>Från</th><th>Förfaller</th><th class="n">Kvar</th><th></th></tr></thead><tbody>'
                                            + d.incoming.map(function (v) {
                                                var state = v.settled ? 'Betald' : v.claimed > 0 ? 'Betalning anmäld' : '';
                                                return '<tr' + (!v.settled && v.claimed <= 0 ? ' class="gap"' : '') + '><td><a href="' + esc(v.documentUrl) + '" target="_blank">' + esc(v.number) + '</a> <span class="muted">' + esc(v.competitionName) + '</span></td>'
                                                    + '<td>' + esc(v.issuerName || '') + '</td><td>' + esc(v.dueDate || '') + '</td><td class="n">' + (v.outstanding > 0 ? kr(v.outstanding) : 'Inget') + '</td>'
                                                    + '<td class="n">' + (state ? '<span class="muted">' + state + '</span>'
                                                        : (d.canWrite ? '<button type="button" class="btn btn-sm btn-outline-primary" data-expense="' + v.id + '">Lägg in som utgift</button> ' : '')
                                                          + '<button type="button" class="btn btn-sm btn-outline-success" data-claim-inv="' + v.id + '">Vi har betalat</button>') + '</td></tr>';
                                            }).join('') + '</tbody></table>' : '<div class="muted">Inga fakturor från andra föreningar.</div>')
                                        + '<div class="hf-msg"></div>';
                                    inc.querySelectorAll('[data-claim-inv]').forEach(function (b) {
                                        b.addEventListener('click', function () {
                                            b.disabled = true;
                                            HpskFees.post('ClaimInvoicePaid', { chargeId: +b.dataset.claimInv }).then(function (r) {
                                                var m = inc.querySelector('.hf-msg'); m.className = 'hf-msg small mt-2 ' + (r.success ? 'text-success' : 'text-danger'); m.textContent = r.message;
                                                if (r.success) setTimeout(load, 900); else b.disabled = false;
                                            });
                                        });
                                    });
                                    inc.querySelectorAll('[data-expense]').forEach(function (b) {
                                        b.addEventListener('click', function () {
                                            if (window.hpskEkonomiExpenseFromCharge) window.hpskEkonomiExpenseFromCharge(+b.dataset.expense, load);
                                        });
                                    });
                                }
                            });
                        }
                        window.hpskEkonomiLoadInvoices = load;

                        // Den gamla listan laddas först när den öppnas.
                        var legacy = $('legacyInvoices'), legacyLoaded = false;
                        legacy.addEventListener('toggle', function () {
                            if (!legacy.open || legacyLoaded) return;
                            legacyLoaded = true;
                            if (typeof loadClubInvoices === 'function') loadClubInvoices();
                            // AdminInvoicesList lyssnar på shown.bs.tab på sin "flikknapp" — samma händelse här.
                            document.getElementById('ekLegacyInvoicesToggle').dispatchEvent(new Event('shown.bs.tab'));
                        });
                    })();
                    </script>
                }
            </section>

            @* ── Årsavgiften: kretsavgift (krets → klubb) eller medlemsavgifter (klubb → medlem) ──
               ⚠️ Samma partialer som förut låg i adminpanelerna — flyttade, inte kopierade.
               ⚠️ Avgifterna finns bara i den RIKTIGA bokföringen (ingen sandlåda); i en sandlåda
                  säger panelen det i stället för att visa en tom lista som ser betald ut. *@
            <section data-pane="arsavgift" hidden>
                <div class="head">
                    <div>
                        <h1>@feeWord</h1>
                        <div class="sub">@(Model.IssuerType == 1 ? "Kretsens årsavgift till klubbarna, och vilka som betalat." : "Klubbens avgift till medlemmarna, och vilka som betalat.")</div>
                    </div>
                </div>
                <div class="ek-card">
                    @if (Model.IsSandbox)
                    {
                        <div class="ek-alert ek-warn">
                            @feeWord finns bara i den riktiga bokföringen, inte i sandlådan.
                            <a href="/ekonomi?type=@Model.IssuerType&id=@Model.OwnerId&vy=arsavgift">Gå till den riktiga bokföringen</a>.
                        </div>
                    }
                    else if (Model.IssuerType == 1)
                    {
                        @await Html.PartialAsync("RegionFeeManagement", new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["regionContentId"] = Model.OwnerId, ["feesReadOnly"] = !Model.CanWrite })
                    }
                    else
                    {
                        @await Html.PartialAsync("ClubFeeManagement", new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { ["clubId"] = Model.OwnerId, ["feesReadOnly"] = !Model.CanWrite })
                    }
                </div>
            </section>

            @* ══ INSTÄLLNINGAR ═════════════════════════════════════════════════════ *@
            <section data-pane="installningar" hidden>
                <div class="head">
                    <div>
                        <h1 id="@(uid)_setupTitle">Kom igång med ekonomin</h1>
                        <div class="sub" id="@(uid)_setupIntro">
                            Hur sköter ni bokföringen i dag, och vilket räkenskapsår gäller det?
                        </div>
                    </div>
                </div>

                <div class="ek-alert d-none" id="@(uid)_blocked"></div>

                <div class="ek-card wide" id="@(uid)_setup">
                    <div class="ek-cardh"><h2>Vad vill ni använda pistol.nu till?</h2></div>

                    @*
                        ⚠️⚠️ FRÅGAN GÄLLER AVSIKTEN, INTE NULÄGET — och det är skillnaden mellan
                        att fånga föreningens vilja och att gissa fel åt den.

                        Första versionen frågade "Var bokförs föreningens ekonomi?", alltså ett
                        FAKTUM om i dag. Stefan 2026-09-22: en förening som HAR ett program men
                        hellre vill flytta bokföringen hit svarar då sanningsenligt "vi har ett
                        program och skriver in kontohändelserna själva" — och hamnar i
                        avgiftsläget, tvärtemot vad den ville. Frågan var rätt ställd och gav fel
                        svar, vilket är den värsta sorten: ingenting felar.

                        DÄRFÖR TVÅ STEG:
                          1. VAD VILL NI ANVÄNDA PISTOL.NU TILL?  (avsikt — väljer full eller ej)
                          2. Bara om bokföringen stannar kvar hos er: HÄMTAR ERT PROGRAM
                             KONTOHÄNDELSERNA FRÅN BANKEN?  (faktum — avgör om SIE-filen är säker
                             eller skulle dubbelbokföra)

                        ⚠️ Steg 2 är ett FAKTUM om programmet och hör därför inte ihop med steg 1.
                        Slås de ihop till en lista måste läsaren hålla två frågor i huvudet
                        samtidigt, och det var precis vad som gick fel.

                        ⚠️ FÖRENINGEN ÄR "VI". PISTOL.NU SKRIVS UT. "NI" ANVÄNDS INTE — utom i
                        frågerubrikerna, där det är pistol.nu som frågar föreningen.
                        Regeln blev fel åt båda hållen innan den satt: först blandades "vi"
                        (pistol.nu) och "ni" (föreningen), sedan gjorde jag föreningen till "ni".
                        Stefan: "En kassör som läser det läser det som att ni är någon annan, vi är
                        föreningen." Läsaren ÄR föreningen.
                    *@
                    <p class="muted" style="margin-top:0">
                        Svaret styr bara vad den här sidan visar.
                        Pistol.nu kopplas aldrig till föreningens bankkonto.
                    </p>

                    <label class="choice">
                        <input type="radio" name="@(uid)_use" id="@(uid)_useFull" value="full">
                        <span><strong>Sköta hela bokföringen här</strong>
                            <span class="muted" style="display:block">Kontoplan, verifikationer,
                            resultat- och balansräkning och handlingarna till årsmötet.
                            <strong>Det här gäller även om vi redan har ett bokföringsprogram</strong>
                            — vi kan välja att flytta hit.</span></span>
                    </label>

                    <label class="choice">
                        <input type="radio" name="@(uid)_use" id="@(uid)_useKeep" value="keep">
                        <span><strong>Bara avgifter och kontroll</strong>
                            <span class="muted" style="display:block">Bokföringen ligger kvar i
                            vårt eget program. Pistol.nu håller reda på vem som betalat och vad som
                            saknas.</span></span>
                    </label>

                    @* Steg 2 — visas bara när bokföringen stannar kvar hos föreningen. *@
                    <div class="d-none" id="@(uid)_bankStep" style="margin:14px 0 0 28px">
                        <div class="fieldlabel" style="margin-top:0">
                            Hämtar ert program kontohändelserna från banken automatiskt?
                        </div>

                        <label class="choice">
                            <input type="radio" name="@(uid)_bank" id="@(uid)_shapeExport" value="export">
                            <span><strong>Nej, någon av oss skriver in dem</strong>
                                <span class="muted" style="display:block">Då hämtar vi en
                                <strong>SIE-fil</strong> härifrån och läser in den i vårt
                                program.</span></span>
                        </label>

                        <label class="choice">
                            <input type="radio" name="@(uid)_bank" id="@(uid)_shapeFees" value="fees">
                            <span><strong>Ja, de dyker upp av sig själva</strong>
                                <span class="muted" style="display:block">Då lämnar pistol.nu
                                <strong>ingen SIE-fil</strong> — avgifterna är redan bokförda via
                                banken, och en fil till skulle bokföra samma sak en gång till.</span></span>
                        </label>

                        @* ⚠️ Tipset hör HIT, inte under båda stegen. Det låg i foten och talade om
                           "den andra frågan" och "svara nej" — men steg 2 är dolt för den som valt
                           hela bokföringen, så texten hänvisade till något som inte fanns på
                           skärmen. Ett råd om ett val ska stå vid valet. *@
                        @* ⚠️ Formen är inte kosmetik. Rådet och foten under steg 2 har samma färg
                           och storlek, så kant i kant läses de som EN mening — alltså tillbaka
                           till att rådet ser ut att gälla hela uppsättningen. Kantlinjen binder
                           det till frågan ovanför i stället. *@
                        <div class="why"
                             style="margin:12px 0 2px 2px;padding-left:10px;
                                    border-left:3px solid var(--bs-border-color)">
                            Osäker? Välj <strong>Nej</strong> — en SIE-fil går alltid att låta bli
                            att läsa in, men en som saknas går inte att skapa i efterhand.
                        </div>
                    </div>

                    <div class="muted">Valet går att ändra när som helst.</div>

                    <div class="fields">
                        <label>Räkenskapsår
                            <input type="number" class="form-control" id="@(uid)_year"
                                   min="2000" max="2100" value="@DateTime.Today.Year"></label>
                        <label>Börjar <input type="text" class="form-control ek-date" placeholder="åååå-mm-dd" id="@(uid)_start"></label>
                        <label>Slutar <input type="text" class="form-control ek-date" placeholder="åååå-mm-dd" id="@(uid)_end"></label>
                    </div>
                    <div class="muted">Lämna datumen tomma för kalenderår.</div>

                    <div style="display:flex;align-items:center;gap:14px;margin-top:18px">
                        <button type="button" class="btn btn-primary" id="@(uid)_saveBtn">Spara uppsättningen</button>
                        <span class="d-none" style="color:var(--bs-success-text-emphasis);font-weight:600" id="@(uid)_saveOk"></span>
                    </div>
                    <div class="ek-alert ek-bad d-none" id="@(uid)_saveError" style="margin-top:14px"></div>
                </div>

                <div class="ek-grid d-none" id="@(uid)_setupSummary" style="margin-top:18px">
                    <div class="ek-card"><div class="ek-cardh"><h2>Räkenskapsår</h2></div>
                        <div id="@(uid)_yearSummary">—</div></div>
                    <div class="ek-card"><div class="ek-cardh"><h2>Kontoplan</h2></div>
                        <div id="@(uid)_accountSummary">—</div></div>

                    @*
                        ⚠️⚠️ INGÅENDE BALANSER. Utan dem börjar varje förening på noll kronor — en
                        klubb som funnits i femtio år har pengar på kontot och kanske en klubbstuga.
                        Bara för en förening som bokför här; de andra har sina balanser i sitt program.
                    *@
                    <div class="ek-card wide d-none" id="@(uid)_obCard">
                        <div class="ek-cardh">
                            <h2>Ingående balanser</h2>
                            <span class="meta" id="@(uid)_obMeta"></span>
                        </div>
                        <div id="@(uid)_obBody" class="muted">Hämtar…</div>
                        <div class="ek-alert ek-ok d-none" id="@(uid)_obOk" style="margin-top:12px"></div>
                        <button type="button" class="btn btn-sm btn-outline-secondary d-none mt-2"
                                id="@(uid)_obOpen">Lägg in ingående balanser…</button>
                    </div>

                    @*
                        ⚠️⚠️ SIE-IMPORTEN (P10.2). Utan den kan en förening bara flytta hit vid ett årsskifte.
                        Stefans beslut 2026-09-24: kontoplan + ingående balanser + årets verifikationer;
                        originalnumren i en egen serie; saknade konton STOPPAR och kassören frågas;
                        förhandsgranska, och prova i en sandlåda först.
                    *@
                    @if (Model.CanWrite)
                    {
                    <div class="ek-card wide d-none" id="@(uid)_sieCard">
                        <div class="ek-cardh">
                            <h2>Flytta hit bokföringen från ett annat program</h2>
                            <span class="meta">SIE-fil</span>
                        </div>
                        <p class="muted" style="margin-top:0">
                            Exportera en SIE-fil (typ 4) för det här räkenskapsåret ur ert tidigare program. Ingående balanser och
                            årets verifikationer hittills tas in — verifikationerna med sina gamla nummer, i en egen serie.
                            Ingenting sparas förrän ni tryckt Importera.
                        </p>
                        @if (!Model.IsSandbox)
                        {
                            <div class="ek-alert ek-warn" style="margin-bottom:10px">
                                Prova gärna i en sandlåda först. En import går inte att ta tillbaka — fel rättas med rättelser.
                            </div>
                        }
                        <div class="amount-row">
                            <input type="file" class="form-control" accept=".se,.si,.sie,.txt" id="@(uid)_sieFile" style="max-width:24rem">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="@(uid)_siePreview">Förhandsgranska</button>
                        </div>
                        <div id="@(uid)_sieResult" style="margin-top:12px"></div>
                        <div class="ek-alert ek-ok d-none" id="@(uid)_sieOk" style="margin-top:12px"></div>
                        <div class="ek-alert ek-bad d-none" id="@(uid)_sieError" style="margin-top:12px"></div>
                    </div>
                    }

                    @*
                        ⚠️⚠️ HETTE "KONTOROLLER" OCH VISADE "12 mappade".
                        Stefan under provning: "Jag förstår inte vad 'Kontoroller' är för nåt och
                        vad de 12 mappade är, men jag förstår inte bokföring…" — och det är exakt
                        den personen modulen finns för. Rubriken är nu frågan kortet svarar på, och
                        varje rad står som en HÄNDELSE i stället för ett kontobegrepp.
                    *@
                    <div class="ek-card wide">
                        <div class="ek-cardh">
                            <h2>Vad hamnar var?</h2>
                            <span class="meta" id="@(uid)_roleSummary"></span>
                        </div>
                        <p class="muted" style="margin-top:0">
                            När något händer behöver bokföringen veta vilket konto det gäller.
                            Kopplingarna fylls i automatiskt ur mallen — du behöver bara ändra dem
                            om er kontoplan ser annorlunda ut.
                        </p>
                        <table class="t">
                            <thead><tr><th>När det här händer</th><th>Konto</th></tr></thead>
                            <tbody id="@(uid)_roleRows"></tbody>
                        </table>
                        <div class="ek-alert ek-bad d-none" id="@(uid)_roleError" style="margin-top:12px"></div>
                    </div>

                    @* Kontoplanen, att faktiskt ändra i. *@
                    <div class="ek-card wide">
                        <div class="ek-cardh">
                            <h2>Kontoplan</h2>
                            <span class="meta" id="@(uid)_chartMeta"></span>
                        </div>
                        @* ⚠️ "Stäng" sa ingenting om vad som händer. Knappen heter nu vad den
                           GÖR — kontot slutar erbjudas när man bokför — och texten här säger att
                           ingenting försvinner. *@
                        <p class="muted" style="margin-top:0">
                            Kontona kom ur mallen. Saknas något — lägg till det.
                        </p>
                        <div class="why" style="margin-top:.25rem">
                            <div><strong>Vad &quot;Sluta använda&quot; gör.</strong>
                                Kontot försvinner ur listorna du väljer ur när du bokför — då
                                erbjuds det inte längre när du bokför. Inget annat händer.
                                <strong>Ett konto raderas aldrig</strong>, och poster som redan
                                är bokförda på det ligger kvar och går att förklara.</div>
                            <div style="margin-top:.35rem"><strong>Varför du vill det.</strong>
                                Mallen ger fler konton än en förening använder. Ligger alla kvar
                                får du leta i hela listan varje gång du bokför, och det är då man
                                väljer fel konto. Stänger du dem ni aldrig använder blir listan
                                er egen.</div>
                            <div style="margin-top:.35rem"><strong>Du kan ångra dig.</strong>
                                Knappen byter till <em>Använd igen</em>, och kontot är tillbaka
                                direkt. Ingenting går förlorat under tiden.</div>
                        </div>

                        <div class="amount-row" style="margin-bottom:12px">
                            <label>Nummer <input type="number" class="form-control" id="@(uid)_accNumber"
                                   min="1000" max="8999" style="width:7rem"></label>
                            <label>Namn <input type="text" class="form-control" id="@(uid)_accName" maxlength="120"
                                   style="width:18rem" placeholder="T.ex. Sponsring"></label>
                            <button type="button" class="btn btn-sm btn-primary" id="@(uid)_accAdd">Lägg till</button>
                        </div>

                        <div class="ek-alert ek-bad d-none" id="@(uid)_chartError"></div>
                        <div class="ek-alert ek-ok d-none" id="@(uid)_chartOk"></div>

                        <table class="t">
                            <thead>
                                @* "Poster" = antal bokförda rader som pekar hit. Skillnaden
                                   mellan ett konto som går att sluta använda utan följder och ett
                                   som bär historik. *@
                                <tr><th style="width:5rem">Konto</th>
                                    <th style="width:16rem">Namn</th>
                                    <th>Används till</th>
                                    <th class="n" style="width:6rem">Bokförda poster</th>
                                    <th style="width:9rem"></th></tr>
                            </thead>
                            <tbody id="@(uid)_chartRows"></tbody>
                        </table>
                        <div class="more" id="@(uid)_chartMore"></div>
                    </div>
                </div>
            </section>

            @* ══ ÄNNU INTE BYGGDA — ärliga, aldrig fejkade ═════════════════════════ *@
            @*
                ⚠️⚠️ REVISORN ÄR INTE STYRELSEN. Uppdraget är ett EGET objekt med utgångstid och
                återkallning — aldrig ett styrelseuppdrag, eftersom `IsBoardMember` också avgör
                vilka som räknas i beslutsförhet på styrelsemöten.

                ⚠️ Kortet ligger på Inställningar och inte på Översikt: att utse revisor är något
                man gör en gång om året, efter årsmötet.
            *@
            <section data-pane="revisorer" hidden>
                <div class="head">
                    <div><h1>Vem granskar oss?</h1>
                        <div class="sub">Revisorn får läsa räkenskaperna — aldrig ändra dem.</div></div>
                    <div class="dropdown">
                        <button type="button" class="btn btn-primary shadow dropdown-toggle" data-bs-toggle="dropdown"
                                aria-expanded="false" id="@(uid)_revMenu"><i class="bi bi-sliders me-1"></i>Åtgärder</button>
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width:240px">
                            <li><button type="button" class="dropdown-item" id="@(uid)_revNew">Bjud in en revisor…</button></li>
                        </ul>
                    </div>
                </div>

                <div class="ek-alert ek-ok d-none" id="@(uid)_revOk"></div>
                @* ⚠️ Länken visas EN gång. Den lagras bara som hash och går aldrig att hämta
                   igen — rutan säger det, så ingen tror att den finns kvar någonstans. *@
                <div class="ek-alert ek-warn d-none" id="@(uid)_revLink"></div>

                <div class="ek-card wide">
                    <div class="ek-cardh">
                        <h2>Våra revisorer</h2>
                    </div>
                    <table class="t">
                        <thead><tr>
                            <th>Revisor</th>
                            <th style="width:9rem">Läge</th>
                            <th style="width:8rem">Gäller till</th>
                            <th style="width:9rem">Senast inne</th>
                            <th style="width:8rem"></th>
                        </tr></thead>
                        <tbody id="@(uid)_revBody"></tbody>
                    </table>
                    <p class="why" style="margin-bottom:0">
                        Revisorn behöver inget konto sedan tidigare. Hen får en länk och skapar sin
                        inloggning själv — och blir aldrig medlem i föreningen. Uppdraget gäller i 13 månader.
                    </p>
                </div>
            </section>

            <section data-pane="bokfor" hidden>
                <div class="head"><div><h1>Bokför något</h1>
                    <div class="sub">Ett kvitto, en kontant insättning, en korrigering.</div></div></div>

                <div class="bokfor-grid">
                    <div class="ek-card">
                        <label class="fieldlabel" for="@(uid)_bAmount">Hur mycket?</label>
                        <div class="amount-row">
                            <input type="number" id="@(uid)_bAmount" class="form-control amount-in" step="0.01" min="0" placeholder="0">
                            <span class="kr-unit">kr</span>
                            @* ⚠️ Riktningen anges med knappen, ALDRIG med ett minustecken. Ett negativt
                               belopp vänder bara konteringen och ger en verifikation som balanserar men
                               betyder motsatsen till vad kassören menade. *@
                            <div class="btn-group" role="group" aria-label="Riktning">
                                <button type="button" class="btn btn-outline-primary active" aria-pressed="true" id="@(uid)_bPaid">Vi betalade</button>
                                <button type="button" class="btn btn-outline-primary" aria-pressed="false" id="@(uid)_bGot">Vi fick in</button>
                            </div>
                        </div>

                        <label class="fieldlabel" for="@(uid)_bDate">När?</label>
                        <input type="text" class="form-control ek-date" placeholder="åååå-mm-dd" id="@(uid)_bDate">
                        @* ⚠️⚠️ ÅRET MÅSTE STÅ SKRIVET intill datumet. Ligger i dag utanför
                           räkenskapsåret förifylls ett datum INNE i året — och en kassör som ser
                           2025-12-31 dyka upp utan förklaring läser det som ett fel. Värre: en
                           förening som glömt lägga upp det nya året skulle annars kunna datera en
                           januaripost till förra årets sista dag utan att något sa ifrån. *@
                        <div class="why" id="@(uid)_bYearNote"></div>

                        <label class="fieldlabel" for="@(uid)_bText">Vad var det?</label>
                        <input type="text" id="@(uid)_bText" class="form-control wide-in" maxlength="200"
                               placeholder="Ammunition till måndagsträningen">
                        <div class="chips" id="@(uid)_bChips"></div>

                        <label class="fieldlabel" for="@(uid)_bAccount">Vilket konto hör det till?</label>
                        <select id="@(uid)_bAccount" class="form-select wide-in"></select>

                        <label class="fieldlabel" for="@(uid)_bPayAccount">Hur rörde sig pengarna?</label>
                        <select id="@(uid)_bPayAccount" class="form-select wide-in"></select>

                        @* ⚠️ Projektet är FRIVILLIGT och står därför med "(inget projekt)" överst.
                           Utan det tomma valet blir varje post märkt med det första projektet i
                           listan, tyst — och märkningen på en bokförd rad går aldrig att ändra. *@
                        <label class="fieldlabel" for="@(uid)_bProject">Hör det till ett projekt? (frivilligt)</label>
                        <select id="@(uid)_bProject" class="form-select wide-in"></select>
                        <div class="why">
                            Avgifter för tävlingar och evenemang märks med sitt projekt av sig själva.
                            Här väljer du bara för det du bokför för hand — tavlorna, gravyren, fikat.
                        </div>

                        @* ⚠️ "Så bokförs det" visas ALLTID, utfälld. Skissen: "Vi gömmer inte, vi
                           sorterar." Konteringen som står här är exakt den BuildLines skapar — det
                           kassören godkänner är det som bokförs. *@
                        <div class="preview">
                            <div class="fieldlabel">Så bokförs det</div>
                            <table class="t">
                                <thead><tr><th>Konto</th><th>Benämning</th><th class="n">Debet</th><th class="n">Kredit</th></tr></thead>
                                <tbody id="@(uid)_bPreview"></tbody>
                            </table>
                            <p class="why">
                                Du behöver inte kunna debet och kredit — konteringen byggs av beloppet och
                                riktningen. Debet och kredit är bokföringens två sidor; varje post står på båda.
                            </p>
                        </div>

                        @* ⚠️⚠️ KVITTOT HÖR TILL POSTEN. Förut stod "Kvittobilden kommer" här — fast
                           uppladdningen fanns sedan länge på verifikationen. Ove ska inte behöva leta upp
                           posten i Verifikationer efteråt för att fästa kvittot han håller i handen.
                           Filen laddas upp EFTER bokföringen: verifikationen måste finnas först. *@
                        <label class="fieldlabel" for="@(uid)_bReceipt">Kvitto (frivilligt — foto eller PDF)</label>
                        <input type="file" class="form-control wide-in" id="@(uid)_bReceipt"
                               accept=".pdf,.jpg,.jpeg,.png,.heic,.webp" capture="environment">
                        <div class="why" style="margin-top:.25rem">På telefonen kan du fotografera kvittot direkt.</div>

                        <div class="ek-alert ek-bad d-none" id="@(uid)_bError" style="margin-top:12px"></div>
                        <div class="ek-alert ek-ok d-none" id="@(uid)_bOk" style="margin-top:12px"></div>

                        <div style="display:flex;gap:12px;align-items:center;margin-top:16px">
                            <button type="button" class="btn btn-primary" id="@(uid)_bSave">Bokför</button>
                        </div>
                    </div>

                    <div>
                        <div class="ek-card" style="margin-bottom:18px">
                            <div class="ek-cardh"><h2>Behöver du rätta något?</h2></div>
                            <p class="muted" style="margin-top:0">
                                En rättelse skapar en <strong>ny rad</strong> som tar ut den gamla. Den
                                gamla står kvar — så ska det vara, och det är inget du gjort fel.
                            </p>
                            <p class="muted" style="margin-bottom:0">
                                Öppna posten under <strong>Verifikationer</strong> och välj
                                <em>Rätta den här posten</em>. Bokför sedan den rätta posten här.
                            </p>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-2" data-view="verifikationer">Gå till Verifikationer</button>
                        </div>

                        <div class="ek-card">
                            <div class="ek-cardh">
                                <h2>Senast bokfört</h2>
                                <span class="meta" id="@(uid)_bSeries"></span>
                            </div>
                            <div class="rows" id="@(uid)_bRecent"></div>
                            <div class="muted d-none" id="@(uid)_bRecentEmpty">Inget bokfört ännu.</div>
                            <p class="why">
                                Numret är luckfritt och går inte att ändra i efterhand. Prefixet väljer
                                föreningen själv.
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            @*
                AVSTAMNINGEN (P11).

                ⚠️⚠️ F6 STYR FORMEN: gor det AVVIKANDE hittbart och underlaget ett klick bort -
                inte allt lika tydligt. Kasper Aase: "att medlem 1, 2 och 3 betalt sin arsavgift
                och swishat 40 kr varje manad for en intern tavling, det tittar jag sallan
                djupare pa." Darfor ligger det omatchade overst och det matchade hopfallt.

                ⚠️ TVA SORTERS OMATCHAT AR TVA OLIKA ARBETSUPPGIFTER och far aldrig slas ihop
                till en siffra: en bankrad utan motpart saknar en verifikation, en bokforingsrad
                utan motpart ar bokford men syns inte pa kontot.
            *@
            @*
                ⚠️⚠️ VERIFIKATIONSLISTAN ÄR REVISIONENS RYGGRAD, och den saknades helt.
                Skatteverket kräver att revisorn självständigt kan följa *bokförd transaktion →
                verifikation → faktisk betalning* åt båda hållen. Bokföringen fanns, bankkopplingen
                fanns — men det gick inte att BLÄDDRA i dem, och en kedja som inte går att följa
                går inte att granska.

                ⚠️ Två kolumner bär hela kedjan: "Underlag" och "Bank". En rad utan båda är inte
                nödvändigtvis fel — men det är den raden en revisor frågar om.
            *@
            <section data-pane="verifikationer" hidden>
                <div class="head">
                    <div><h1>Vad är bokfört?</h1>
                        <div class="sub">Varje verifikation, i nummerordning, med sitt underlag.</div></div>
                    <div class="headactions">
                        <span class="meta" id="@(uid)_verSummary"></span>
                    </div>
                </div>

                @* ⚠️ Luckvarningen är ett EGET tillstånd, inte en rad i listan. Luckfri numrering
                   är ett påstående vi gör; den här rutan är beviset, och den måste synas även när
                   man sökt fram något helt annat. *@
                <div class="ek-alert ek-bad d-none" id="@(uid)_verGap"></div>

                <div class="ek-card wide">
                    <div class="amount-row">
                        <label style="flex:1 1 220px">Sök
                            <input type="text" class="form-control" id="@(uid)_verSearch"
                                   placeholder="text, motpart eller konto"></label>
                        <label>Från <input type="text" class="form-control ek-date"
                               placeholder="åååå-mm-dd" id="@(uid)_verFrom"></label>
                        <label>Till <input type="text" class="form-control ek-date"
                               placeholder="åååå-mm-dd" id="@(uid)_verTo"></label>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                id="@(uid)_verApply">Visa</button>
                        <button type="button" class="btn btn-sm btn-link"
                                id="@(uid)_verClear">Rensa</button>
                    </div>

                    <table class="t" style="margin-top:.5rem">
                        <thead><tr>
                            <th style="width:6rem">Nr</th>
                            <th style="width:7rem">Datum</th>
                            <th>Avser</th>
                            <th class="n" style="width:8rem">Belopp</th>
                            <th style="width:6rem">Underlag</th>
                            <th style="width:5rem">Bank</th>
                        </tr></thead>
                        <tbody id="@(uid)_verBody"></tbody>
                    </table>

                    <div class="amount-row" style="margin-top:.75rem">
                        <button type="button" class="btn btn-sm btn-outline-secondary d-none"
                                id="@(uid)_verMore">Visa fler</button>
                        <span class="muted" id="@(uid)_verCount"></span>
                    </div>
                </div>

                @* Detaljen öppnas i samma panel — en modal hade gjort det omöjligt att läsa
                   verifikationen och listan samtidigt, vilket är precis vad man gör när man letar. *@
                <div class="ek-card wide d-none" id="@(uid)_verDetail">
                    <div class="ek-cardh">
                        <h2 id="@(uid)_verDetailTitle">Verifikation</h2>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="@(uid)_verClose">Stäng</button>
                    </div>
                    <div id="@(uid)_verDetailBody"></div>
                </div>
            </section>

            <section data-pane="avstamning" hidden>
                <div class="head">
                    <div><h1>Stämmer det?</h1>
                        <div class="sub">Här bevisas fullständigheten.</div></div>
                    <div class="headactions" id="@(uid)_recActions"></div>
                </div>

                <div class="ek-alert ek-bad d-none" id="@(uid)_bankError"></div>
                <div class="ek-alert ek-ok d-none" id="@(uid)_bankOk"></div>

                @* Tomt lage. ⚠️ Sager vad vi INTE gor - det ar den vanligaste farhagan. *@
                <div class="soonbox d-none" id="@(uid)_bankEmpty">
                    <h2>Inget kontoutdrag inläst ännu</h2>
                    <p class="muted">
                        Ni laddar upp kontoutdraget själva. <strong>Vi läser inte ert bankkonto</strong>,
                        och ingen tredje part får läsrätt. Avstämningen parar ihop bankens rader med
                        bokföringens och visar vad som är kvar.
                    </p>
                </div>

                @if (Model.CanWrite)
                {
                    <div class="ek-card" id="@(uid)_bankUpload">
                        <div class="ek-cardh"><h2>Läs in ett kontoutdrag</h2>
                            <span class="meta">CSV från internetbanken</span></div>

                        <div class="amount-row">
                            <label>Konto
                                <select class="form-select" id="@(uid)_bankAccount" style="width:16rem"></select></label>
                            <label>Fil
                                <input type="file" class="form-control" id="@(uid)_bankFile"
                                       accept=".csv,.txt,text/csv" style="width:18rem"></label>
                        </div>

                        @* ⚠️ Mappningen ar ett FORSLAG och visas ALLTID innan nagot skrivs.
                           Bankerna doper kolumnerna olika, och en tyst felmappning ger ett
                           kontoutdrag som stams av mot fel siffror. *@
                        <div class="d-none" id="@(uid)_bankMapBox">
                            <div class="why">
                                Så här läser vi filen. Stämmer det inte — ändra här innan du läser in.
                            </div>
                            <div class="fields" id="@(uid)_bankMapFields"></div>
                            <table class="t" style="margin-top:.5rem">
                                <thead><tr id="@(uid)_bankSampleHead"></tr></thead>
                                <tbody id="@(uid)_bankSampleBody"></tbody>
                            </table>
                        </div>

                        <div style="margin-top:1rem">
                            <button type="button" class="btn btn-primary d-none"
                                    id="@(uid)_bankImport">Läs in</button>
                        </div>
                    </div>
                }

                @* Avstamningen. *@
                <div class="d-none" id="@(uid)_recWrap">
                    <div class="ek-bigbox" id="@(uid)_recVerdict" style="margin-bottom:1rem">
                        <div class="lead" id="@(uid)_recVerdictLead"></div>
                        <div class="amount" id="@(uid)_recVerdictAmount"></div>
                        <div class="note" id="@(uid)_recVerdictNote"></div>
                    </div>

                    <div class="ek-card wide" id="@(uid)_recBankOnlyCard">
                        <div class="ek-cardh">
                            <h2>Hänt på kontot — men inte bokfört</h2>
                            <span class="meta" id="@(uid)_recBankOnlyMeta"></span>
                        </div>
                        <p class="muted" style="margin-top:0">
                            Pengar har rört kontot utan att det finns en verifikation. Antingen ska
                            posten bokföras, eller så hör raden till ett annat konto.
                        </p>
                        <table class="t">
                            <thead><tr><th style="width:7rem">Datum</th><th>Text</th>
                                <th class="n" style="width:8rem">Belopp</th>
                                <th style="width:12rem"></th></tr></thead>
                            <tbody id="@(uid)_recBankOnly"></tbody>
                        </table>
                    </div>

                    <div class="ek-card wide" id="@(uid)_recLedgerOnlyCard" style="margin-top:1rem">
                        <div class="ek-cardh">
                            <h2>Bokfört — men syns inte på kontot</h2>
                            <span class="meta" id="@(uid)_recLedgerOnlyMeta"></span>
                        </div>
                        <p class="muted" style="margin-top:0">
                            Verifikationen finns, men ingen bankrad matchar den. Beloppet kan vara fel,
                            datumet ligga utanför utdragets period, eller pengarna aldrig ha kommit.
                        </p>
                        <table class="t">
                            <thead><tr><th style="width:7rem">Datum</th><th style="width:6rem">Ver.</th>
                                <th>Beskrivning</th>
                                <th class="n" style="width:8rem">Belopp</th></tr></thead>
                            <tbody id="@(uid)_recLedgerOnly"></tbody>
                        </table>
                    </div>

                    @* ⚠️ Hopfallt med FLIT - det ar den trakiga majoriteten, och F6 sager att
                       vardet ligger i att gora det avvikande hittbart. *@
                    <details class="ek-card wide" style="margin-top:1rem">
                        <summary style="cursor:pointer;font-weight:700">
                            Hopparat <span class="meta" id="@(uid)_recMatchedMeta"></span>
                        </summary>
                        <table class="t" style="margin-top:.75rem">
                            <thead><tr><th style="width:7rem">Datum</th><th>Bankens text</th>
                                <th style="width:6rem">Ver.</th>
                                <th class="n" style="width:8rem">Belopp</th>
                                <th style="width:8rem"></th></tr></thead>
                            <tbody id="@(uid)_recMatched"></tbody>
                        </table>
                    </details>
                </div>
            </section>

            @*
                RAPPORT — Ekonomi_Wireframes.pdf sida 4.

                ⚠️ Det HAR ar inte en resultatrakning. Den hor till Bokslut, steg 6. Ytan svarar
                pa en annan fraga: haller vi budgeten? Den stalls pa varje styrelsemote, medan
                bokslutet gors en gang om aret — darav skissens egen underrubrik.

                ⚠️ PERIODEN MASTE STA UTSKRIVEN. Budgeten ar hela arets och proportioneras aldrig
                (se LedgerBudgetService), sa −49 % pa kiosken i maj betyder "sasongen har inte
                borjat". Utan perioden i rubriken laeser en styrelse det som en katastrof.
            *@
            <section data-pane="rapport" hidden>
                <div class="head">
                    <div>
                        <h1>Utfall mot budget</h1>
                        <div class="sub" id="@(uid)_repPeriod">Kassörens vanligaste leverans — oftare än bokslutet.</div>
                    </div>
                    <div class="headactions d-none" id="@(uid)_repActions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="@(uid)_repPeriodBtn">Byt period</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_repPrint">Ta fram underlag till styrelsemötet</button>
                    </div>
                </div>

                <div class="ek-alert ek-bad d-none" id="@(uid)_repError"></div>

                @* Perioden. Doljd tills nagon trycker "Byt period" — skissen visar den inte, och
                   en kassor som bara vill se laget ska inte motas av tva datumfalt. *@
                <div class="ek-card d-none" id="@(uid)_repPeriodBox">
                    <div class="ek-cardh"><h2>Period</h2></div>
                    <div class="amount-row">
                        <label>Från <input type="text" class="form-control ek-date" placeholder="åååå-mm-dd" id="@(uid)_repFrom"></label>
                        <label>Till <input type="text" class="form-control ek-date" placeholder="åååå-mm-dd" id="@(uid)_repTo"></label>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="@(uid)_repApply">Visa</button>
                        <button type="button" class="btn btn-sm btn-link" id="@(uid)_repReset">Hela året hittills</button>
                    </div>
                    <div class="why">
                        Budgeten är alltid hela årets och räknas aldrig om till en del av året.
                        Ett halvår mot en helårsbudget ser ut som ett underskott även när allt går som planerat.
                    </div>
                </div>

                @* Tomt lage. ⚠️ Visar ALDRIG ett belopp — en rapport mot ingen budget ar inget. *@
                <div class="soonbox d-none" id="@(uid)_repEmpty">
                    <h2 id="@(uid)_repEmptyH">Ingen budget är antagen ännu</h2>
                    <p class="muted" id="@(uid)_repEmptyP">
                        Uppföljningen jämför årets utfall med det styrelsen eller årsmötet beslutade.
                        Utan ett beslut finns inget att jämföra med.
                    </p>
                    @if (Model.CanWrite)
                    {
                        <button type="button" class="btn btn-primary" id="@(uid)_repStart">Lägg in budgeten</button>
                    }
                </div>

                @* Rapporten. *@
                <div class="ek-card d-none" id="@(uid)_repCard">
                    <table class="t">
                        <thead>
                            <tr>
                                <th>Konto</th>
                                <th class="barcell"></th>
                                <th class="n">Budget</th>
                                <th class="n">Utfall</th>
                                <th class="n">Diff kr</th>
                                <th class="n">Diff %</th>
                            </tr>
                        </thead>
                        <tbody id="@(uid)_repBody"></tbody>
                    </table>
                    <div class="why" id="@(uid)_repAdopted"></div>
                </div>

                <div class="ek-grid d-none" id="@(uid)_repFooter">
                    @* ⚠️ Skissens "Fäst på styrelsemötet" är INTE byggd, och rutan säger det i
                       stället för att bära en knapp som inte gör något. Den kräver en delbar
                       handling: styrelsen kan inte öppna /ekonomi, så en länk dit i dagordningen
                       vore en länk de flesta möts av ett nekande på. Samma fråga som revisorns
                       åtkomst — den ska lösas en gång, för båda. *@
                    <div class="soonbox">
                        <h2>Fäst på styrelsemötet</h2>
                        <p class="muted" style="margin-top:0">
                            Budgetuppföljning är redan en punkt på dagordningen, och nästa steg är att
                            fästa den här sidan där. Det kräver en läsbar handling som en ledamot kan
                            öppna utan kassörens behörighet — tills dess: <strong>Ta fram underlag</strong>
                            skriver ut den.
                        </p>
                    </div>

                    @* ⚠️ Skissens egen text, ordagrant. Den forklarar varfor ytan inte har en
                       "redigera budget"-knapp, och det ar den vanligaste fragan om sidan. *@
                    <div class="ek-card">
                        <div class="ek-cardh"><h2>Om budgeten</h2></div>
                        <p class="muted" style="margin-top:0">
                            <strong>Budgeten är ett beslut, inte en prognos.</strong>
                            <span id="@(uid)_repDecision"></span>
                            Den kan inte skrivas om i efterhand — vill styrelsen ändra den blir
                            ändringen ett eget, spårbart beslut.
                        </p>
                        @if (Model.CanWrite)
                        {
                            <button type="button" class="linkbtn" id="@(uid)_repRevise">Gör en ny version</button>
                        }
                    </div>
                </div>

                @*
                    BUDGETINMATNINGEN.

                    ⚠️ Finns INTE i skissen — den visar bara uppfoljningen. Men utan en yta att
                    skriva in budgeten pa ar hela sidan onabar, sa den ligger har: dar budgeten
                    konsumeras, och dar den som saknar en upptacker att hen saknar en.
                *@
                @if (Model.CanWrite)
                {
                <div class="ek-card d-none" id="@(uid)_budCard">
                    <div class="ek-cardh">
                        <h2 id="@(uid)_budTitle">Budget</h2>
                        <span class="meta" id="@(uid)_budMeta"></span>
                    </div>

                    <p class="muted" style="margin-top:0">
                        Skriv beloppen som de är — en intäkt på 146 000 skrivs 146000, en kostnad på
                        95 000 skrivs 95000. Konton du lämnar tomma räknas inte som noll, de räknas
                        som obudgeterade.
                    </p>

                    <div class="ek-alert ek-bad d-none" id="@(uid)_budError"></div>
                    <div class="ek-alert ek-ok d-none" id="@(uid)_budOk"></div>

                    <table class="t">
                        <thead>
                            <tr>
                                <th>Konto</th>
                                <th class="n" id="@(uid)_budPrevH"></th>
                                <th class="n">Budget</th>
                            </tr>
                        </thead>
                        <tbody id="@(uid)_budBody"></tbody>
                    </table>

                    <div class="amount-row" style="margin-top:1rem">
                        <button type="button" class="btn btn-sm btn-primary" id="@(uid)_budSave">Spara utkastet</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="@(uid)_budCancel">Stäng</button>
                    </div>

                    <div class="ek-cardh" style="margin-top:1.5rem"><h2>Anta budgeten</h2></div>
                    <p class="muted" style="margin-top:0">
                        <strong>Efter det här går den inte att ändra.</strong>
                        Ett utkast går att rätta hur många gånger som helst; en antagen budget är ett
                        beslut, och en ändring blir en ny version med båda kvar.
                    </p>
                    <div class="amount-row">
                        <label>Beslutsdatum <input type="text" class="form-control ek-date" placeholder="åååå-mm-dd" id="@(uid)_budDate"></label>
                        <label>Beslutades av
                            <select class="form-select" id="@(uid)_budAdoptedBy">
                                <option value="arsmote">Årsmötet</option>
                                <option value="styrelse">Styrelsen</option>
                            </select>
                        </label>
                        <input type="text" id="@(uid)_budNote" class="form-control wide-in"
                               style="max-width:18rem" placeholder="T.ex. Årsmötet 14 mars">
                        <button type="button" class="btn btn-primary" id="@(uid)_budAdopt">Anta budgeten</button>
                    </div>
                </div>
                }
            </section>

            @*
                BOKSLUTET (P7).

                ⚠️ STEGEN AR HARLEDDA ur verkligt tillstand, aldrig kryssrutor. En kryssruta sager
                att kassoren TROR att steget ar gjort; harlett sager om det AR gjort - och det ar
                hela poangen med en checklista i ett bokslut. Den ska kunna saga emot.

                ⚠️ Ett steg vi inte kan MATA sags vara omatt, inte klart. Ett omatt steg som visas
                som klart ar varre an inget steg alls.
            *@
            @*
                ⚠️⚠️ ANSKAFFNINGSVÄRDET STÅR KVAR PÅ TILLGÅNGSKONTOT. Avskrivningen samlas på ett
                minuskonto (7830 debet / 1229 kredit) — BAS-praxis. Direktmodellen (kredit 1220)
                togs bort 2026-09-24, se LedgerAsset. Utrangeringen bokförs, och raden står kvar.

                ⚠️ Kontona väljs PER TILLGÅNG ur föreningens egen kontoplan, inte via roller: en
                klubbstuga skrivs av mot 7820 och en pistol mot 7830, och en roll hade tvingat
                fram ETT val för hela föreningen.
            *@
            @*
                ⚠️⚠️ ATT REGISTRERA EN UTGIFT BOKFÖR INGENTING. Föreningen bokför enligt
                kontantmetoden, så verifikationen skrivs när utgiften BETALAS. Den här ytan är
                alltså en arbetslista och en attestkedja — bokföringen sker i ett enda steg.

                ⚠️ Ett utlägg och en leverantörsfaktura är SAMMA FORM: ett åtagande som uppstod
                före pengarna. Skillnaden är motparten.
            *@
            <section data-pane="utgifter" hidden>
                <div class="head">
                    <div><h1>Vad ska vi betala?</h1>
                        <div class="sub">Utlägg och räkningar — registrera, attestera, betala.</div></div>
                    @* ⚠️ Husets form: EN blå Åtgärder uppe till höger för det som gäller hela listan.
                       Formuläret låg förut som sidinnehåll under listorna. *@
                    @if (Model.CanWrite)
                    {
                        <div class="dropdown">
                            <button type="button" class="btn btn-primary shadow dropdown-toggle" data-bs-toggle="dropdown"
                                    aria-expanded="false" id="@(uid)_utMenu"><i class="bi bi-sliders me-1"></i>Åtgärder</button>
                            <ul class="dropdown-menu dropdown-menu-end" style="min-width:280px">
                                <li><h6 class="dropdown-header">Registrera</h6></li>
                                <li><button type="button" class="dropdown-item" id="@(uid)_utNewUtlagg">Ett utlägg — någon har lagt ut egna pengar…</button></li>
                                <li><button type="button" class="dropdown-item" id="@(uid)_utNewFaktura">En räkning som har kommit…</button></li>
                            </ul>
                        </div>
                    }
                </div>

                <div class="ek-alert ek-bad d-none" id="@(uid)_utError"></div>
                <div class="ek-alert ek-ok d-none" id="@(uid)_utOk"></div>

                @* ⚠️ Kretsavgiften fanns bara på kretsens sida — klubbens kassör fick skriva in
                   samma räkning för hand. Nu står den här, där den ska betalas. *@
                <div class="ek-card wide d-none" id="@(uid)_utIncoming" style="margin-bottom:1rem">
                    @* Kretsavgiften och fakturor från andra arrangörer i pistol.nu (P3/P4) — samma lista. *@
                    <div class="ek-cardh"><h2>Räkningar från kretsen och andra föreningar</h2></div>
                    <table class="t">
                        <tbody id="@(uid)_utIncomingBody"></tbody>
                    </table>
                </div>

                <div class="ek-card wide">
                    <div class="ek-cardh">
                        <h2>Att göra</h2>
                        <div class="muted" id="@(uid)_utTodoMeta"></div>
                    </div>
                    <table class="t">
                        <thead><tr>
                            <th>Utgift</th>
                            <th style="width:11rem">Mottagare</th>
                            <th style="width:8rem">Förfaller</th>
                            <th class="n" style="width:8rem">Belopp</th>
                            <th style="width:13rem">Läge</th>
                            <th style="width:15rem"></th>
                        </tr></thead>
                        <tbody id="@(uid)_utTodoBody"></tbody>
                    </table>
                </div>

                @* Avklarat göms, men rubriken står kvar — sortera, göm inte. *@
                <details class="ek-card wide" id="@(uid)_utDoneCard">
                    <summary class="ek-cardh"><h2 style="display:inline">Avklarat</h2>
                        <span class="muted" id="@(uid)_utDoneMeta"></span></summary>
                    <table class="t">
                        <thead><tr>
                            <th>Utgift</th>
                            <th style="width:11rem">Mottagare</th>
                            <th style="width:8rem">Betald</th>
                            <th class="n" style="width:8rem">Belopp</th>
                            <th style="width:13rem">Läge</th>
                            <th style="width:8rem">Verifikation</th>
                        </tr></thead>
                        <tbody id="@(uid)_utDoneBody"></tbody>
                    </table>
                </details>

            </section>

            @*
                PROJEKTEN.

                ⚠️⚠️ MARKERA FINAST, GRUPPERA EFTERÅT. En tävling eller ett evenemang blir ett projekt
                AV SIG SJÄLV vid första kronan — den som skapade tävlingen gjorde aldrig något val,
                och kassören behöver inte heller göra det i förväg. Märkningen på raden är fryst;
                grupperingen här ovanpå får ändras för alltid.

                ⚠️⚠️ INGEN TOTALSUMMA ÖVER GRUPPER. Ett projekt kan ligga i flera grupper, och då
                vore en summa över dem ett tal som inte finns. Varje grupp säger i stället vilka
                den delar projekt med.
            *@
            <section data-pane="projekt" hidden>
                <div class="head">
                    <div><h1>Vad gav projekten?</h1>
                        <div class="sub">Varje tävling och evenemang som haft pengar blir ett projekt av sig självt.
                            Gruppera dem som föreningen vill se dem.</div></div>
                    <div class="headactions" style="align-items:center">
                        <label class="muted" style="display:flex;gap:.5rem;align-items:center">Period
                            <select class="form-select form-select-sm" id="@(uid)_prYear" style="width:auto"></select></label>
                        @if (Model.CanWrite)
                        {
                            <div class="dropdown">
                                <button type="button" class="btn btn-primary shadow dropdown-toggle" data-bs-toggle="dropdown"
                                        aria-expanded="false" id="@(uid)_prMenu"><i class="bi bi-sliders me-1"></i>Åtgärder</button>
                                <ul class="dropdown-menu dropdown-menu-end" style="min-width:260px">
                                    <li><h6 class="dropdown-header">Skapa</h6></li>
                                    <li><button type="button" class="dropdown-item" id="@(uid)_prNewProject">Nytt eget projekt…</button></li>
                                    <li><button type="button" class="dropdown-item" id="@(uid)_prNewGroup">Ny grupp…</button></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>

                <div class="ek-alert ek-bad d-none" id="@(uid)_prError"></div>
                <div class="ek-alert ek-ok d-none" id="@(uid)_prOk"></div>

                <div class="ek-card wide">
                    <div class="ek-cardh">
                        <h2>Projekt</h2>
                        <div class="muted" id="@(uid)_prMeta"></div>
                    </div>
                    <table class="t">
                        <thead><tr>
                            <th>Projekt</th>
                            <th style="width:14rem">Grupper</th>
                            <th class="n" style="width:8rem">Intäkter</th>
                            <th class="n" style="width:8rem">Kostnader</th>
                            <th class="n" style="width:8rem">Resultat</th>
                            <th style="width:10rem"></th>
                        </tr></thead>
                        <tbody id="@(uid)_prBody"></tbody>
                    </table>
                </div>

                @* Stängda göms, men rubriken står kvar — sortera, göm inte. *@
                <details class="ek-card wide" id="@(uid)_prClosedCard">
                    <summary class="ek-cardh"><h2 style="display:inline">Stängda projekt</h2>
                        <span class="muted" id="@(uid)_prClosedMeta"></span></summary>
                    <p class="muted">Ett stängt projekt syns inte när någon bokför, men finns kvar här
                        och i rapporterna. Projekt raderas aldrig.</p>
                    <table class="t">
                        <thead><tr>
                            <th>Projekt</th>
                            <th style="width:14rem">Grupper</th>
                            <th class="n" style="width:8rem">Intäkter</th>
                            <th class="n" style="width:8rem">Kostnader</th>
                            <th class="n" style="width:8rem">Resultat</th>
                            <th style="width:10rem"></th>
                        </tr></thead>
                        <tbody id="@(uid)_prClosedBody"></tbody>
                    </table>
                </details>

                <div class="ek-card wide">
                    <div class="ek-cardh">
                        <h2>Grupper</h2>
                        <div class="muted" id="@(uid)_prGroupMeta"></div>
                    </div>
                    <div id="@(uid)_prGroups"></div>
                    @* ⚠️ Förklaringen till att det inte finns någon summarad — annars letar kassören
                       efter den och tror att den saknas. *@
                    <p class="why" style="margin-bottom:0">
                        Grupperna får överlappa, så det finns ingen summa över dem. Läs en grupp i taget.
                        Att ta bort en grupp tar inte bort några projekt.
                    </p>
                </div>

            </section>

            <section data-pane="tillgangar" hidden>
                <div class="head">
                    <div><h1>Vad äger föreningen?</h1>
                        <div class="sub">Klubbstugan, vapenskåpet, tavelställen — och årets avskrivning.</div></div>
                    @if (Model.CanWrite)
                    {
                        <div class="dropdown d-none" id="@(uid)_assetActions">
                            <button type="button" class="btn btn-primary shadow dropdown-toggle" data-bs-toggle="dropdown"
                                    aria-expanded="false" id="@(uid)_assetMenu"><i class="bi bi-sliders me-1"></i>Åtgärder</button>
                            <ul class="dropdown-menu dropdown-menu-end" style="min-width:280px" id="@(uid)_assetMenuList">
                                <li><h6 class="dropdown-header">Registret</h6></li>
                                <li><button type="button" class="dropdown-item" id="@(uid)_aNew">Lägg till något föreningen köpt…</button></li>
                            </ul>
                        </div>
                    }
                </div>

                <div class="ek-alert ek-bad d-none" id="@(uid)_assetError"></div>
                <div class="ek-alert ek-ok d-none" id="@(uid)_assetOk"></div>

                @* En avskrivning hör till ett räkenskapsår. Utan år går den inte att räkna, och
                   det sägs i klartext i stället för att visa ett tomt register. *@
                <div class="soonbox d-none" id="@(uid)_assetNoYear">
                    <h2>Lägg upp räkenskapsåret först</h2>
                    <p class="muted">Årets avskrivning räknas från räkenskapsårets början och slut,
                        så registret behöver veta vilket år ni arbetar i. Det gör ni under
                        Inställningar.</p>
                </div>

                <div class="ek-card wide d-none" id="@(uid)_assetListCard">
                    <div class="ek-cardh">
                        <h2>Anläggningsregistret</h2>
                        <div class="muted" id="@(uid)_assetMeta"></div>
                    </div>
                    <table class="t">
                        <thead><tr>
                            <th>Tillgång</th>
                            <th style="width:7rem">I bruk sedan</th>
                            <th class="n" style="width:8rem">Köptes för</th>
                            <th class="n" style="width:8rem">Värde nu</th>
                            <th class="n" style="width:8rem">Avskrivs i år</th>
                            <th class="n" style="width:8rem">Bokfört i år</th>
                            <th style="width:8rem"></th>
                        </tr></thead>
                        <tbody id="@(uid)_assetBody"></tbody>
                    </table>
                    <p class="why" style="margin-bottom:0">
                        Det föreningen köper för att använda i flera år skrivs av — kostnaden fördelas
                        över åren det håller, i stället för att hela beloppet belastar köpåret.
                    </p>
                </div>
            </section>

            <section data-pane="bokslut" hidden>
                <div class="head">
                    <div><h1>Stäng räkenskapsåret</h1>
                        <div class="sub">Görs i januari, ofta av någon som gör det första gången.</div></div>
                    <div class="headactions" id="@(uid)_closeActions"></div>
                </div>

                <div class="ek-alert ek-bad d-none" id="@(uid)_closeError"></div>
                <div class="ek-alert ek-ok d-none" id="@(uid)_closeOk"></div>

                @* En forening som bokfor nagon annanstans stanger sitt ar dar. *@
                <div class="soonbox d-none" id="@(uid)_closeNotApplicable">
                    <h2>Bokslutet görs i ert eget program</h2>
                    <p class="muted">
                        Ni har valt att bokföringen ligger kvar hos er, så det är där året stängs.
                        Den här sidan håller reda på avgifterna — vad som borde ha kommit in och
                        vad som faktiskt gjorde det.
                    </p>
                </div>

                <div class="soonbox d-none" id="@(uid)_closeNoYear">
                    <h2>Inget räkenskapsår upplagt</h2>
                    <p class="muted">Lägg upp året under Inställningar först.</p>
                </div>

                <div class="d-none" id="@(uid)_closeWrap">
                    @* ⚠️ Handlingarna till årsmötet: papperet ska säga VEMS och VILKET år — en
                       resultaträkning utan föreningens namn är ett lösblad. *@
                    <div class="ek-printonly" style="margin-bottom:1rem">
                        <h1 style="font-size:1.4rem;margin:0">@Model.IssuerName</h1>
                        <div id="@(uid)_printYear" style="font-size:1.05rem"></div>
                    </div>
                    <div class="ek-card wide ek-noprint">
                        <div class="ek-cardh"><h2>Stegen</h2>
                            <span class="meta" id="@(uid)_closeMeta"></span></div>
                        <div class="rows" id="@(uid)_closeSteps"></div>
                    </div>

                    <div class="ek-grid" style="margin-top:1rem">
                        <div class="ek-card">
                            <div class="ek-cardh"><h2>Resultaträkning</h2>
                                <span class="meta" id="@(uid)_resPeriod"></span></div>
                            <table class="t">
                                <tbody id="@(uid)_resBody"></tbody>
                            </table>
                        </div>

                        <div class="ek-card">
                            <div class="ek-cardh"><h2>Balansräkning</h2>
                                <span class="meta" id="@(uid)_balDate"></span></div>
                            <table class="t">
                                <tbody id="@(uid)_balBody"></tbody>
                            </table>
                        </div>
                    </div>

                    @* ⚠️ Fastställandet ligger SIST och efter handlingarna. Det ar en enkelriktad
                       handling, och den som trycker ska ha resultat- och balansrakningen pa
                       skarmen nar hen gor det. *@
                    <div class="ek-card wide ek-noprint" style="margin-top:1rem" id="@(uid)_establishCard">
                        <div class="ek-cardh"><h2>Fastställ året</h2></div>
                        <p class="muted" style="margin-top:0">
                            <strong>Efter det här tar året inte emot bokföring.</strong>
                            Ett fel som hittas senare rättas som en ny verifikation i ett öppet år —
                            ingenting skrivs om i efterhand.
                        </p>
                        <div class="amount-row" id="@(uid)_establishRow"></div>
                    </div>
                </div>
            </section>

        </div>
    </main>
</div>

@* ══ DIALOGERNA ════════════════════════════════════════════════════════════════════════════
   ⚠️⚠️ HUSETS FORM (Stefan 2026-09-23/24): ändringar och inställningar görs i en DIALOG — rubrik,
   fält, Avbryt + blå Spara — aldrig som sidinnehåll och aldrig i window.prompt/alert.
   ⚠️ Dialogerna ligger UTANFÖR flikarna med flit. En flik göms med attributet hidden, och en dialog
   inuti en dold flik ärver display:none — den öppnas då osynligt, och ingenting säger ifrån. *@
<div class="ek-modals">
    @* Den gemensamma frågedialogen: ett eventuellt fält, en bekräftelse. Ersätter window.prompt,
       som stoppar hela webbläsaren och inte går att läsa om innan man trycker OK. *@
    <div class="modal fade" id="@(uid)_askModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_askTitle">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="@(uid)_askTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                </div>
                <div class="modal-body">
                    <p id="@(uid)_askText" style="margin-top:0"></p>
                    <div id="@(uid)_askFieldWrap" class="d-none">
                        <label class="form-label" for="@(uid)_askInput" id="@(uid)_askLabel"></label>
                        <textarea class="form-control d-none" id="@(uid)_askArea" rows="3"></textarea>
                        <input type="text" class="form-control d-none" id="@(uid)_askInput" autocomplete="off">
                        <div class="form-text" id="@(uid)_askHelp"></div>
                    </div>
                    <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_askError"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn btn-primary" id="@(uid)_askOk">OK</button>
                </div>
            </div>
        </div>
    </div>

    @if (Model.CanWrite)
    {
        @* ── Utgifter: registrera / ändra ── *@
        <div class="modal fade" id="@(uid)_utFormModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_utFormTitle">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_utFormTitle">Registrera en utgift</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="@(uid)_uId" value="0">
                        <div class="row g-3">
                            <div class="col-md-5">
                                <label class="form-label" for="@(uid)_uKind">Vad är det?</label>
                                <select class="form-select" id="@(uid)_uKind">
                                    <option value="utlagg">Utlägg — någon har lagt ut egna pengar</option>
                                    <option value="faktura">Räkning — en faktura har kommit</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="@(uid)_uDesc">Vad avser den?</label>
                                <input type="text" class="form-control" id="@(uid)_uDesc"
                                       placeholder="Tavlor, ammunition, fika" autocomplete="off">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="@(uid)_uAmount">Belopp (kr)</label>
                                <input type="number" class="form-control" id="@(uid)_uAmount" step="0.01" min="0" placeholder="0">
                            </div>

                            @* ⚠️ Mottagaren är en MEDLEM vid utlägg — det är det fältet attestspärren
                               läser. Fritext där hade gjort det möjligt att godkänna sin egen
                               utbetalning. Vid räkning är det tvärtom fritext: en leverantör finns
                               inte i något register hos oss. *@
                            <div class="col-md-6" id="@(uid)_uPayeeMemberWrap">
                                <label class="form-label" for="@(uid)_uPayee">Vem ska ha pengarna?</label>
                                <select class="form-select" id="@(uid)_uPayee"></select>
                            </div>
                            <div class="col-md-6 d-none" id="@(uid)_uPayeeNameWrap">
                                <label class="form-label" for="@(uid)_uPayeeName">Vem har skickat räkningen?</label>
                                <input type="text" class="form-control" id="@(uid)_uPayeeName"
                                       placeholder="Företagets eller föreningens namn" autocomplete="off">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="@(uid)_uDate">Datum på kvittot</label>
                                <input type="text" class="form-control ek-date" id="@(uid)_uDate" placeholder="åååå-mm-dd">
                            </div>
                            <div class="col-md-3" id="@(uid)_uDueWrap">
                                <label class="form-label" for="@(uid)_uDue">Ska betalas senast</label>
                                <input type="text" class="form-control ek-date" id="@(uid)_uDue" placeholder="åååå-mm-dd">
                            </div>

                            <div class="col-md-6">
                                <label class="form-label" for="@(uid)_uAccount">Vilket konto?</label>
                                <select class="form-select" id="@(uid)_uAccount"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="@(uid)_uProject">Projekt (frivilligt)</label>
                                <select class="form-select" id="@(uid)_uProject"></select>
                            </div>

                            @* ⚠️ Kvittot lagras nu men blir en bilaga till VERIFIKATIONEN först vid
                               betalningen. Attesten sker mot kvittot, alltså innan det finns någon
                               verifikation att hänga det på. *@
                            <div class="col-12">
                                <label class="form-label" for="@(uid)_uReceipt">Kvitto eller faktura (frivilligt — foto eller PDF)</label>
                                <input type="file" class="form-control" id="@(uid)_uReceipt" accept=".pdf,.jpg,.jpeg,.png,.heic,.webp">
                                <div class="form-text" id="@(uid)_uReceiptNow"></div>
                            </div>
                        </div>
                        <div class="form-text mt-3" id="@(uid)_uHint"></div>
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_uError"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="@(uid)_uCancel">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_uSave">Spara</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Revisorer: bjud in ── *@
        <div class="modal fade" id="@(uid)_revModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_revModalTitle">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_revModalTitle">Bjud in en revisor</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="muted" style="margin-top:0">
                            Revisorn får en länk i mejlet och skapar sin inloggning själv. Hen kan läsa
                            räkenskaperna men aldrig ändra något.
                        </p>
                        <div class="mb-3">
                            <label class="form-label" for="@(uid)_revName">Revisorns namn</label>
                            <input type="text" class="form-control" id="@(uid)_revName" autocomplete="off">
                        </div>
                        <label class="form-label" for="@(uid)_revEmail">E-post</label>
                        <input type="email" class="form-control" id="@(uid)_revEmail" placeholder="revisor@@example.se" autocomplete="off">
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_revErr"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_revInvite">Skicka inbjudan</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Ingående balanser ── *@
        <div class="modal fade" id="@(uid)_obModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_obModalTitle">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_obModalTitle">Ingående balanser</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="muted" style="margin-top:0" id="@(uid)_obIntro"></p>
                        <div id="@(uid)_obRows"></div>
                        <div class="ek-bigbox" style="margin-top:14px">
                            <div class="lead">Föreningens eget kapital blir</div>
                            <div class="amount" id="@(uid)_obEquity">0 kr</div>
                            <div class="muted" style="font-size:.85rem">Räknas ut: det föreningen äger minus det den är skyldig.</div>
                        </div>
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_obErr"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_obSave">Spara</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Projekt: eget projekt ── *@
        <div class="modal fade" id="@(uid)_prFormModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_prFormTitle">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_prFormTitle">Nytt eget projekt</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="muted" style="margin-top:0">
                            För det som inte är en tävling: Klubbstugan, Ungdomssektionen, Skjutbanan.
                            Ett projekt utan slutdatum fungerar som ett kostnadsställe.
                        </p>
                        <input type="hidden" id="@(uid)_pId" value="0">
                        <div class="mb-3">
                            <label class="form-label" for="@(uid)_pName">Namn</label>
                            <input type="text" class="form-control" id="@(uid)_pName" maxlength="120" placeholder="Klubbstugan" autocomplete="off">
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="form-label" for="@(uid)_pStart">Börjar (frivilligt)</label>
                                <input type="text" class="form-control ek-date" id="@(uid)_pStart" placeholder="åååå-mm-dd">
                            </div>
                            <div class="col-6">
                                <label class="form-label" for="@(uid)_pEnd">Slutar (frivilligt)</label>
                                <input type="text" class="form-control ek-date" id="@(uid)_pEnd" placeholder="åååå-mm-dd">
                            </div>
                        </div>
                        <label class="form-label" for="@(uid)_pDesc">Beskrivning (frivilligt)</label>
                        <input type="text" class="form-control" id="@(uid)_pDesc" maxlength="400" autocomplete="off">
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_pError"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="@(uid)_pCancel">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_pSave">Spara projektet</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Projekt: grupp ── *@
        <div class="modal fade" id="@(uid)_gFormModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_gFormTitle">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_gFormTitle">Ny grupp</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="muted" style="margin-top:0">
                            Till exempel "Klubbtävlingar 2026" eller "Fältskytte". En tävlingsserie blir en
                            grupp av sig själv.
                        </p>
                        <input type="hidden" id="@(uid)_gId" value="0">
                        <div class="mb-3">
                            <label class="form-label" for="@(uid)_gName">Namn</label>
                            <input type="text" class="form-control" id="@(uid)_gName" maxlength="120" placeholder="Klubbtävlingar 2026" autocomplete="off">
                        </div>
                        <label class="form-label" for="@(uid)_gDesc">Beskrivning (frivilligt)</label>
                        <input type="text" class="form-control" id="@(uid)_gDesc" maxlength="400" autocomplete="off">
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_gError"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="@(uid)_gCancel">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_gSave">Spara gruppen</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Projekt: välj projekt i en grupp. Kryssrutan skriver direkt. ── *@
        <div class="modal fade" id="@(uid)_prPickModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_prPickTitle">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_prPickTitle">Projekt i gruppen</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="muted" style="margin-top:0">
                            Kryssa i de projekt som ska ingå. Ett projekt får ligga i flera grupper — det
                            ändrar ingenting i bokföringen.
                        </p>
                        <div id="@(uid)_prPickList"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="@(uid)_prPickDone">Klar</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Tillgångar: lägg till / ändra ── *@
        <div class="modal fade" id="@(uid)_assetFormModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_assetFormTitle">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_assetFormTitle">Lägg till en tillgång</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p class="muted" style="margin-top:0">
                            Skriv in vad föreningen köpte, vad det kostade och hur många år det ska hålla.
                            Avskrivningen räknas ut av sig själv, från den månad den togs i bruk.
                        </p>
                        <input type="hidden" id="@(uid)_aId" value="0">
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label" for="@(uid)_aName">Vad är det?</label>
                                <input type="text" class="form-control" id="@(uid)_aName"
                                       placeholder="Vapenskåp, klubbstuga, tavelställ" autocomplete="off">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="@(uid)_aAmount">Köptes för (kr)</label>
                                <input type="number" class="form-control" id="@(uid)_aAmount" step="0.01" min="0" placeholder="0">
                            </div>
                            @* ⚠️ TOGS I BRUK, inte betalningsdatum. Det är skillnaden som gör att
                               något som köpts i december inte skrivs av för ett helt år. *@
                            <div class="col-md-4">
                                <label class="form-label" for="@(uid)_aDate">Togs i bruk</label>
                                <input type="text" class="form-control ek-date" id="@(uid)_aDate" placeholder="åååå-mm-dd">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="@(uid)_aLife">Ska hålla i (år)</label>
                                <input type="number" class="form-control" id="@(uid)_aLife" step="1" min="1" value="5">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="@(uid)_aResidual">Värt när det är uttjänt (kr)</label>
                                <input type="number" class="form-control" id="@(uid)_aResidual" step="0.01" min="0" value="0">
                                <div class="form-text">Oftast 0.</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="@(uid)_aAssetAccount">Konto där tillgången står</label>
                                <select class="form-select" id="@(uid)_aAssetAccount"></select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="@(uid)_aDeprAccount">Konto för årets avskrivning</label>
                                <select class="form-select" id="@(uid)_aDeprAccount"></select>
                            </div>
                            @* ⚠️⚠️ Minuskontot. Anskaffningsvärdet står kvar på tillgångskontot och
                               avskrivningarna samlas här (1220 → 1229) — BAS-praxis, rättat efter
                               Michael Henriksson 2026-09-24. Förslaget följer tillgångskontot. *@
                            <div class="col-md-6">
                                <label class="form-label" for="@(uid)_aAccAccount">Konto där avskrivningarna samlas</label>
                                <select class="form-select" id="@(uid)_aAccAccount"></select>
                                <div class="form-text">Inköpsvärdet står kvar på tillgångens konto. Balansräkningen visar båda, och skillnaden är värdet nu.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="@(uid)_aNote">Anteckning (frivillig)</label>
                                <input type="text" class="form-control" id="@(uid)_aNote"
                                       placeholder="Serienummer, var den står, vem som köpte den" autocomplete="off">
                            </div>
                        </div>
                        <div class="form-text mt-3" id="@(uid)_aLocked"></div>
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_aError"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="@(uid)_aCancel">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_aSave">Spara</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Tillgångar: utrangera ── *@
        <div class="modal fade" id="@(uid)_aDisposeModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_aDisposeTitle">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_aDisposeTitle">Utrangera</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p style="margin-top:0">Utrangeringen bokförs: inköpsvärdet och avskrivningarna tas bort,
                            och det värde som återstår blir en förlust. Raden står kvar i registret.</p>
                        @* ⚠️ Datumet var hårdkodat till i dag: en försäljning förra månaden gick inte att föra in. *@
                        <div class="mb-3">
                            <label class="form-label" for="@(uid)_aDisposeDate">När lämnade den föreningen?</label>
                            <input type="text" class="form-control ek-date" id="@(uid)_aDisposeDate" placeholder="åååå-mm-dd">
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="@(uid)_aDisposeReason">Vad hände? Såld, skrotad eller stulen.</label>
                            <textarea class="form-control" id="@(uid)_aDisposeReason" rows="2"></textarea>
                        </div>
                        <div class="mb-2" id="@(uid)_aDisposeLossWrap">
                            <label class="form-label" for="@(uid)_aDisposeLoss">Konto för värdet som återstår</label>
                            <select class="form-select" id="@(uid)_aDisposeLoss"></select>
                        </div>
                        <div class="form-text">Såldes den? Bokför försäljningen själv under Bokför, t.ex. mot 3970 — beloppet vet bara du.
                            Utrangeringen går inte att ångra; ett fel rättas med en ny verifikation.</div>
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_aDisposeError"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <button type="button" class="btn btn-danger" id="@(uid)_aDisposeConfirm">Utrangera</button>
                    </div>
                </div>
            </div>
        </div>

        @* ── Utgifter: betala ut ── *@
        <div class="modal fade" id="@(uid)_utPayModal" tabindex="-1" aria-hidden="true" aria-labelledby="@(uid)_utPayTitle">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="@(uid)_utPayTitle">Betala ut</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
                    </div>
                    <div class="modal-body">
                        <p style="margin-top:0" id="@(uid)_utPayWhat"></p>
                        <div class="mb-3">
                            <label class="form-label" for="@(uid)_utPayDate">Vilken dag betalades den?</label>
                            <input type="text" class="form-control ek-date" id="@(uid)_utPayDate" placeholder="åååå-mm-dd">
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="@(uid)_utPayAccount">Från vilket konto?</label>
                            <select class="form-select" id="@(uid)_utPayAccount"></select>
                        </div>
                        @* ⚠️ Kontantmetoden i klartext. En kassör som tror att fakturadatumet gäller
                           kommer att undra varför decemberräkningen hamnar på det nya året. *@
                        <div class="form-text">Utgiften bokförs den dag den betalas, inte på datumet på räkningen.</div>
                        <div class="alert alert-danger d-none mt-3 mb-0" id="@(uid)_utPayError"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="@(uid)_utPayCancel">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="@(uid)_utPayConfirm">Bokför utbetalningen</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
(function () {
    var uid = '@uid';
    var root = document.getElementById(uid);
    var issuerType = parseInt(root.dataset.issuerType, 10);
    var issuerId = parseInt(root.dataset.issuerId, 10);
    var el = function (s) { return document.getElementById(uid + '_' + s); };

    // ⚠️⚠️ SVENSK DATUMSTANDARD, PA ETT STALLE. Faltet visar och tar emot ÅÅÅÅ-MM-DD oavsett
    //    webblasarens sprak — ett <input type="date"> gjorde det INTE och visade dd/mm/yyyy.
    //    'Y-m-d' betyder att faltets .value fortsatter vara ISO, sa varje lasning och varje
    //    payload nedanfor ar oforandrad. Lagg till ett nytt datumfalt HAR, aldrig som type=date.
    var EK_DATE_FIELDS = ['start', 'end', 'bDate', 'repFrom', 'repTo', 'budDate',
                          'fordrFrom', 'fordrTo', 'verFrom', 'verTo', 'aDate',
                          'uDate', 'uDue', 'utPayDate', 'pStart', 'pEnd', 'aDisposeDate'];
    if (window.flatpickr) {
        EK_DATE_FIELDS.forEach(function (n) {
            var f = el(n);
            // ⚠️⚠️ allowInput ar ett MEDVETET avsteg fran husets flatpickr-monster, och det ar
            //    inte kosmetik: utan det satter flatpickr faltet READONLY, och da gar ett datum
            //    bara att KLICKA fram. Att mata in forra arets bokforing ar dussintals daterade
            //    verifikationer i rad — en kalenderklickning per datum ar langsammare an det
            //    HTML5-falt vi just ersatte, alltsa en forsamring foraedd av en forbattring.
            //    Hittat av sviten: p.fill() pa datumfaltet timeoutade med "element is not
            //    editable". Det var inte ett testfel.
            if (f) flatpickr(f, { locale: 'sv', dateFormat: 'Y-m-d', allowInput: true });
        });
    }

    // ⚠️ Satt ALDRIG .value direkt pa ett flatpickr-falt. Instansen far da inte veta om det, sa
    //    kalendern oppnar pa fel manad och nasta val kan skriva over det som just sattes.
    //    ⚠️ Tomt varde ska CLEAR:a, inte setDate('') — se [[flatpickr-setdate-maxdate-trap]].
    function setDateField(name, value) {
        var f = el(name);
        if (!f) return;
        f.value = value || '';
        if (f._flatpickr) {
            if (value) f._flatpickr.setDate(value, false);
            else f._flatpickr.clear();
        }
    }

    // ⚠️⚠️ SKRIVKONTROLLER RENDERAS INTE ALLS för en läsare, så varje addEventListener på en
    //    sådan knapp skulle kasta på null — och det dödar HELA den här IIFE:n, alltså en sida
    //    som inte laddar någonting. Felet syns bara för den som saknar skrivrätt.
    //    Flaggan läses explicit ur DOM:en; härledd ur "finns knappen X?" slutar den stämma tyst
    //    den dag knappen döps om.
    var canWrite = root.dataset.canWrite === '1';

    // ⚠️ Avgiftsordet följer utställaren — "Kretsavgifter" för en krets. Deklareras HÄR och inte
    //    vid avgiftskortet: renderTodo läser det, och körs det före en senare `var`-rad är värdet
    //    undefined och .toLowerCase() fäller hela sidan. Sätts om ur servern i loadFees.
    var feeLabel = issuerType === 1 ? 'Kretsavgifter' : 'Medlemsavgifter';
    var show = function (n, on) { if (n) n.classList.toggle('d-none', !on); };

    var ROLE_NAMES = {
        'revenue-participation-fee':'Deltagaravgift','revenue-membership-fee':'Medlemsavgift',
        'revenue-region-fee':'Kretsavgift','revenue-other':'Övrig intäkt','bank-account':'Bankkonto',
        'swish':'Swish','cash-box':'Kontantkassa','accounts-receivable':'Kundfordran',
        'accounts-payable':'Leverantörsskuld','rounding':'Öresavrundning',
        'vat-outgoing':'Utgående moms','vat-incoming':'Ingående moms'
    };
    var MONTHS = ['jan','feb','mar','apr','maj','jun','jul','aug','sep','okt','nov','dec'];

    // Skissen skriver "16 sep", inte "2026-09-16" — året är detsamma på varje rad ändå.
    function shortDate(iso) {
        if (!iso) return '';
        var m = String(iso).slice(0, 10).split('-');
        return m.length === 3 ? parseInt(m[2], 10) + ' ' + (MONTHS[parseInt(m[1], 10) - 1] || m[1])
                              : String(iso).slice(0, 10);
    }
    function kr(n) { return (n || 0).toLocaleString('sv-SE', { maximumFractionDigits: 0 }) + ' kr'; }
    function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; }

    // Varje lista har ett tak med en väg till resten — annars blir sidan en vägg av rader.
    function capList(body, more, rows, cap, renderRow, labelAll) {
        body.innerHTML = rows.slice(0, cap).map(renderRow).join('');
        if (rows.length <= cap) { more.innerHTML = ''; return; }
        more.innerHTML = '<button type="button" class="btn btn-sm btn-link p-0">' + labelAll.replace('{n}', rows.length) + '</button>';
        more.querySelector('button').addEventListener('click', function () {
            body.innerHTML = rows.map(renderRow).join(''); more.innerHTML = '';
        });
    }

    // ══ HUSETS BYGGSTENAR ═════════════════════════════════════════════════════════════════
    // ⚠️⚠️ Stefan 2026-09-23: ekonomiytan ska tala SAJTENS språk. EN blå Åtgärder uppe till höger
    //    för det som gäller hela listan, radåtgärder i en liten grå meny, ändringar i en dialog,
    //    status som en bricka. Byggstenarna bor HÄR, så att ingen flik uppfinner en egen form igen.
    function modalOf(name) {
        var m = el(name);
        return m && window.bootstrap ? bootstrap.Modal.getOrCreateInstance(m) : null;
    }
    function openModal(name) { var m = modalOf(name); if (m) m.show(); }
    function closeModal(name) { var m = modalOf(name); if (m) m.hide(); }

    // Brickorna: samma färger som resten av sajten (Anmälningar, Fakturor, avgifterna).
    var BADGE = {
        ok: 'bg-success', wait: 'bg-warning text-dark', info: 'bg-info text-dark',
        off: 'bg-secondary', bad: 'bg-danger', light: 'bg-light text-dark border',
        miss: 'bg-danger-subtle text-danger-emphasis border'
    };
    function badge(kind, text, note) {
        return '<span class="badge ' + (BADGE[kind] || BADGE.light) + '">' + esc(text) + '</span>'
             + (note ? ' <span class="muted" style="font-size:.85rem">' + note + '</span>' : '');
    }

    // Radens Åtgärder: en liten grå meny. Det destruktiva sist, i rött, under en linje.
    // ⚠️ popper-config "fixed" krävs — tabellerna klipper annars menyn på sista raden.
    function rowMenu(items) {
        var list = items.filter(Boolean);
        if (list.length === 0) return '';
        var html = '', dangerStarted = false;
        list.forEach(function (i) {
            if (i.danger && !dangerStarted && html) { html += '<li><hr class="dropdown-divider"></li>'; }
            if (i.danger) dangerStarted = true;
            html += '<li><button type="button" class="dropdown-item' + (i.danger ? ' text-danger' : '') + '"'
                  + ' data-row-act="' + esc(i.act) + '" data-row-id="' + esc(i.id) + '">' + esc(i.text) + '</button></li>';
        });
        return '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"'
             + ' data-bs-toggle="dropdown" aria-expanded="false" data-bs-popper-config=\'{"strategy":"fixed"}\'>Åtgärder</button>'
             + '<ul class="dropdown-menu dropdown-menu-end">' + html + '</ul></div>';
    }
    // Delegerad lyssnare: raderna byts ut vid varje omritning, så en lyssnare på raden dör.
    function onRowAction(container, handlers) {
        if (!container || container.dataset.rowWired) return;
        container.dataset.rowWired = '1';
        container.addEventListener('click', function (ev) {
            var b = ev.target.closest('[data-row-act]');
            if (!b || !container.contains(b)) return;
            var h = handlers[b.dataset.rowAct];
            if (h) h(b.dataset.rowId, b);
        });
    }

    // ⚠️⚠️ ERSÄTTER window.prompt/alert. En prompt stoppar hela webbläsaren, går inte att läsa om
    //    innan man trycker OK, och har tidigare rapporterats som att "fliken frös".
    //    ask({ title, text, label, required, multiline, value, help, ok, danger }) → Promise<string|null>
    //    Utan label är det en ren bekräftelse, och löftet ger '' vid OK.
    var askResolve = null;
    function ask(o) {
        el('askTitle').textContent = o.title || '';
        el('askText').textContent = o.text || '';
        show(el('askText'), !!o.text);
        var hasField = !!o.label;
        show(el('askFieldWrap'), hasField);
        var area = el('askArea'), input = el('askInput');
        show(area, hasField && !!o.multiline);
        show(input, hasField && !o.multiline);
        var field = o.multiline ? area : input;
        field.value = o.value || '';
        el('askLabel').textContent = o.label || '';
        el('askLabel').setAttribute('for', field.id);
        el('askHelp').textContent = o.help || '';
        show(el('askError'), false);
        var okBtn = el('askOk');
        okBtn.textContent = o.ok || 'OK';
        okBtn.className = 'btn ' + (o.danger ? 'btn-danger' : 'btn-primary');
        okBtn.dataset.required = o.required ? '1' : '';
        return new Promise(function (resolve) {
            askResolve = resolve; askAnswer = null;
            openModal('askModal');
            if (hasField) setTimeout(function () { field.focus(); }, 300);
        });
    }
    el('askOk').addEventListener('click', function () {
        var area = el('askArea');
        var field = area.classList.contains('d-none') ? el('askInput') : area;
        var hasField = !el('askFieldWrap').classList.contains('d-none');
        var v = hasField ? field.value.trim() : '';
        if (hasField && this.dataset.required && !v) {
            el('askError').textContent = 'Fyll i ' + (el('askLabel').textContent || 'fältet').toLowerCase() + ' först.';
            show(el('askError'), true);
            return;
        }
        // ⚠️ Svaret lämnas först när dialogen är HELT stängd. Följer ett besked direkt på en fråga
        //    (ask → tell) öppnades annars samma dialog medan den fortfarande stängdes, och den
        //    andra öppningen gick inte att klicka i.
        askAnswer = v;
        closeModal('askModal');
    });
    var askAnswer = null;
    el('askModal').addEventListener('hidden.bs.modal', function () {
        var r = askResolve, v = askAnswer;
        askResolve = null; askAnswer = null;
        if (r) r(v);
    });
    // En bekräftelse eller ett besked utan fält — i stället för window.alert.
    function tell(title, text) { return ask({ title: title, text: text, ok: 'OK' }); }

    function showView(name) {
        root.querySelectorAll('.rail a.ek-nav').forEach(function (a) {
            a.classList.toggle('on', a.dataset.view === name);
        });
        root.querySelectorAll('[data-pane]').forEach(function (s) { s.hidden = s.dataset.pane !== name; });
        window.scrollTo(0, 0);
        if (name === 'rapport') loadReport();

        // ⚠️ Avstämningen hämtas LAT och bara EN gång per sidladdning. Den läser hela kontots
        //    bokföringsrader för att kunna räkna saldot, alltså en tung fråga — och panelen
        //    ändrar sig inte av sig själv. Varje skrivning hämtar om den själv.
        if (name === 'avstamning' && !bankLoaded) { bankLoaded = true; loadBank(); }

        // ⚠️ Samma skal som avstamningen: bokslutet laser hela arets bokforingsrader for att
        //    kunna summera resultat och balans, alltsa en tung fraga som inte andrar sig av sig
        //    sjalv. Varje skrivning hamtar om den sjalv.
        if (name === 'bokslut' && !closeLoaded) { closeLoaded = true; loadClosing(); }

        if (name === 'avgifter' && !recvLoaded) {
            recvLoaded = true; loadReceivables();
            if (window.hpskEkonomiLoadLegacyPost) window.hpskEkonomiLoadLegacyPost();
        }

        // Fakturor och tävlingsavgifter: vyns eget skript exporterar laddaren. EN gång per
        // sidladdning — varje handling i vyn läser om själv.
        if (name === 'fakturor' && !invoicesLoaded && window.hpskEkonomiLoadInvoices) {
            invoicesLoaded = true; window.hpskEkonomiLoadInvoices();
        }

        // ⚠️ Samma skäl som ovan: listan läser hela årets verifikationer för luckkontrollen.
        if (name === 'verifikationer' && !verLoaded) { verLoaded = true; loadJournal(true); }

        if (name === 'revisorer' && !revLoaded) { revLoaded = true; loadAuditors(); }

        // ⚠️ Samma skäl som ovan: registret räknar årets plan och läser årets bokförda
        //    avskrivningar ur liggaren. Varje skrivning hämtar om det själv.
        if (name === 'tillgangar' && !assetLoaded) { assetLoaded = true; loadAssets(); }

        // ⚠️ Samma skäl som ovan: listan läser hela utgiftsregistret plus kontoplanen. Varje
        //    skrivning hämtar om den själv.
        if (name === 'utgifter' && !expenseLoaded) { expenseLoaded = true; loadExpenses(); }

        // ⚠️ Samma skäl: summeringen läser varje projektmärkt rad i hela liggaren. Varje
        //    skrivning hämtar om den själv.
        if (name === 'projekt' && !projLoaded) { projLoaded = true; loadProjects(); }

        // Årsavgiften: partialen exporterar sin egen laddare. EN gång — varje skrivning i den läser om själv.
        if (name === 'arsavgift' && !annualFeeLoaded) {
            var loader = window.hpskLoadRegionFees || window.hpskLoadClubFees;
            if (loader) { annualFeeLoaded = true; loader(); }
        }
    }
    var annualFeeLoaded = false;
    var invoicesLoaded = false;
    // Fakturor-vyns "Lägg in som utgift" leder hit: räkningarna registreras under Utgifter.
    window.hpskEkonomiExpenseFromCharge = function () { showView('utgifter'); };
    root.querySelectorAll('[data-view]').forEach(function (a) {
        a.addEventListener('click', function (ev) { ev.preventDefault(); showView(a.dataset.view); });
    });
    // ?vy=arsavgift öppnar en viss vy direkt — adminpanelernas länk till årsavgiften. Körs EFTER
    // resten av skriptet (setTimeout 0), eftersom vyernas laddare definieras längre ned.
    (function () {
        var want = (new URLSearchParams(location.search).get('vy') || '').replace(/[^a-z]/g, '');
        if (want && root.querySelector('[data-pane="' + want + '"]'))
            setTimeout(function () { showView(want); }, 0);
    })();

    var DAYS = ['Söndag','Måndag','Tisdag','Onsdag','Torsdag','Fredag','Lördag'];
    var FULLMONTH = ['januari','februari','mars','april','maj','juni','juli','augusti','september','oktober','november','december'];
    var now = new Date();
    el('today').textContent = DAYS[now.getDay()] + ' ' + now.getDate() + ' ' + FULLMONTH[now.getMonth()] + ' ' + now.getFullYear();

    // ── Panel 1: vad väntar på mig ────────────────────────────────────────────────────────
    // ⚠️ BARA SAKER SOM FAKTISKT MÄTS. Skissen listar även utlägg utan attest och poster utan
    //    underlag; de lagren finns inte, och en rad som alltid säger noll lär kassören att inte
    //    läsa panelen.
    var todo = { outstandingCount: 0, unposted: 0, missingSources: 0, unpaidFees: 0, unpostedFees: 0, noOpening: false };

    function renderTodo() {
        var items = [];
        if (todo.outstandingCount > 0)
            items.push([todo.outstandingCount, 'avgifter har inte kommit in', 'Visa', 'avgifter']);
        if (todo.unposted > 0)
            items.push([todo.unposted, 'betalningar väntar på bokföring', 'Bokför', 'avgifter']);
        if (todo.missingSources > 0)
            items.push([todo.missingSources, 'tävlingar saknar avgifter', 'Visa', 'avgifter']);
        if (todo.unpaidFees > 0)
            items.push([todo.unpaidFees, feeLabel.toLowerCase() + ' har inte kommit in', 'Visa', 'arsavgift']);
        if (todo.unpostedFees > 0)
            items.push([todo.unpostedFees, 'betalda ' + feeLabel.toLowerCase() + ' är obokförda', 'Bokför', 'avgifter']);

        if (todo.noOpening)
            items.push([1, 'Ingående balanser är inte inlagda', 'Lägg in', 'installningar']);

        el('todoCount').textContent = items.length === 0 ? 'Inget just nu'
            : items.length + (items.length === 1 ? ' sak' : ' saker');

        if (items.length === 0) {
            el('todo').innerHTML = '<div class="todo done"><div class="t">Ingenting väntar på dig.</div></div>';
            return;
        }

        el('todo').innerHTML = items.map(function (i) {
            return '<div class="todo"><div class="n">' + i[0] + '</div><div class="t">' + esc(i[1]) + '</div>'
                 + '<button type="button" class="btn btn-sm btn-outline-secondary" data-goto="' + i[3] + '">' + esc(i[2]) + '</button></div>';
        }).join('');

        el('todo').querySelectorAll('button[data-goto]').forEach(function (b) {
            b.addEventListener('click', function () { showView(b.dataset.goto); });
        });
    }

    // ── Data ──────────────────────────────────────────────────────────────────────────────
    function renderOverview(o) {
        el('outTotal').textContent = kr(o.outstandingTotal);
        el('outBox').classList.toggle('ek-warn', (o.outstandingTotal || 0) > 0);

        var groups = o.outstanding || [];
        el('outRows').innerHTML = groups.length === 0
            ? '<div style="color:var(--bs-success-text-emphasis);font-weight:600">Inget utestående.</div>'
            : groups.map(function (g) {
                return '<div><span class="grow">' + esc(g.label) + ', ' + g.count + '</span>'
                     + '<span class="num">' + kr(g.amount) + '</span></div>';
            }).join('');

        todo.outstandingCount = groups.reduce(function (a, g) { return a + g.count; }, 0);

        // ⚠️⚠️ TVÅ LISTOR, EN PANEL. Bokför föreningen här är VERIFIKATIONERNA svaret på "vad
        //    hände senast?" — panelen läste bara betalningsrader, och en klubb som bokfört ett
        //    helt år manuellt fick därför "Inga betalningar ännu" på en full liggare.
        //    Verifikationer finns = föreningen bokför här; då täcker de även betalningarna,
        //    eftersom en bekräftad betalning alltid bär en verifikation hos en sådan förening.
        var journal = o.journal || [];
        var recv = o.received || [];
        var books = journal.length > 0;

        el('recvMeta').textContent = books ? 'Bokförda verifikationer' : 'Mottagna betalningar';
        el('recvEmpty').textContent = books ? 'Inget bokfört ännu.' : 'Inga betalningar ännu.';
        show(el('recvEmpty'), (books ? journal : recv).length === 0);

        if (books) {
            capList(el('recvBody'), el('recvMore'), journal, 5, function (v) {
                var vad = v.counterparty
                    ? esc(v.description) + ' · ' + esc(v.counterparty) : esc(v.description);
                return '<div><span class="num muted">' + esc(shortDate(v.date)) + '</span>'
                     + '<span class="grow">' + vad + '</span>'
                     + '<span class="num">' + kr(v.amount) + '</span>'
                     + '<span class="kvitto muted">' + esc(v.number) + '</span></div>';
            }, 'Visa alla {n} verifikationer');
        } else {
            capList(el('recvBody'), el('recvMore'), recv, 5, function (r) {
                var kvitto = r.receiptId
                    ? '<a class="kvitto" href="/betalkvitto/' + r.receiptId + '" target="_blank" rel="noopener">'
                      + esc(r.receiptNumber) + '</a>' : '<span class="muted">—</span>';
                return '<div><span class="num muted">' + esc(shortDate(r.date)) + '</span>'
                     + '<span class="grow">' + esc(r.payerName) + ' · ' + esc(r.what) + '</span>'
                     + '<span class="num">' + kr(r.amount) + '</span>' + kvitto + '</div>';
            }, 'Visa alla {n} betalningar');
        }

        // ⚠️ Panelen far bara saga att det stammer nar nagon FAKTISKT stamt av. Saknas utdrag
        //    star den kvar i sitt varnande lage - noll fel ska visas lika stort som fel.
        var rs = o.reconciliation;
        var panel = el('recPanel');
        if (panel) {
            if (!rs) {
                panel.classList.add('ek-warn');
                el('recPanelLead').textContent = 'Inte avstämt mot banken än';
                el('recPanelNote').textContent =
                    'Avstämningen läser in vårt kontoutdrag och matchar rad för rad. Tills någon '
                    + 'gjort det vet vi vad som bokförts — inte att det är komplett.';
            } else if (rs.unmatched === 0) {
                panel.classList.remove('ek-warn');
                el('recPanelLead').textContent = 'Avstämt mot banken';
                el('recPanelNote').textContent =
                    'Alla ' + rs.rows + ' rader i utdraget t.o.m. ' + shortDate(rs.periodTo)
                    + ' har en motpart i bokföringen.';
            } else {
                panel.classList.add('ek-warn');
                el('recPanelLead').textContent = rs.unmatched + ' rader utan motpart';
                el('recPanelNote').textContent =
                    'Av ' + rs.rows + ' rader i utdraget t.o.m. ' + shortDate(rs.periodTo)
                    + ' saknar ' + rs.unmatched + ' en bokföringsrad.';
            }
        }

        var per = o.perSource || [];
        show(el('perEmpty'), per.length === 0);
        todo.missingSources = per.filter(function (s) { return s.missingCount > 0; }).length;

        capList(el('perBody'), el('perMore'), per, 8, function (s) {
            var miss = s.missingCount > 0
                ? '<td class="n miss">' + s.missingCount + ' · ' + kr(s.missingAmount) + '</td>'
                : '<td class="n fine">Inget</td>';
            var cls = 'ek-clickable' + (s.missingCount > 0 ? ' gap' : '')
                    + (drillKey === s.sourceType + ':' + s.sourceId ? ' ek-open' : '');

            return '<tr class="' + cls + '" data-src-type="' + esc(s.sourceType) + '"'
                 + ' data-src-id="' + s.sourceId + '" data-src-name="' + esc(s.name) + '">'
                 + '<td>' + esc(s.name) + '</td><td class="n">' + s.expected + '</td>'
                 + '<td class="n">' + s.settled + '</td>' + miss + '</tr>';
        }, 'Visa alla {n} tävlingar');

        // ⚠️ Delegerad lyssnare pa TBODY. Raderna byts ut vid varje omritning (capList skriver
        //    innerHTML), sa en lyssnare bunden till raden slutar fungera efter forsta uppdateringen.
        //    Samma fella som vaxeln i medaljutdelningen.
        if (!el('perBody').dataset.wired) {
            el('perBody').dataset.wired = '1';
            el('perBody').addEventListener('click', function (ev) {
                var tr = ev.target.closest('tr[data-src-type]');
                if (tr) openDrill(tr.dataset.srcType, parseInt(tr.dataset.srcId, 10),
                                  tr.dataset.srcName, tr);
            });
        }

        renderTodo();
    }

    // ══ VERIFIKATIONERNA ═════════════════════════════════════════════════
    var verLoaded = false, verSkip = 0, verRows = [];
    var VER_PAGE = 50;

    function verQuery(skip) {
        var q = '?issuerType=' + issuerType + '&issuerId=' + issuerId
              + '&skip=' + skip + '&take=' + VER_PAGE;

        var f = el('verFrom') && el('verFrom').value;
        var t = el('verTo') && el('verTo').value;
        var s = el('verSearch') && el('verSearch').value;

        if (f) q += '&from=' + encodeURIComponent(f);
        if (t) q += '&to=' + encodeURIComponent(t);
        if (s) q += '&search=' + encodeURIComponent(s);

        return q;
    }

    // ⚠️ `reset` skiljer "visa fler" från en ny sökning. Utan den växer listan när man
    //    filtrerar, och träffarna blandas med de gamla — vilket ser ut som att filtret inte tog.
    async function loadJournal(reset) {
        if (reset) { verSkip = 0; verRows = []; closeEntry(); }

        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetJournal' + verQuery(verSkip),
                            { cache: 'no-store' }).then(function (r) { return r.json(); });

        if (!d.success) {
            el('verBody').innerHTML = '<tr><td colspan="6" class="muted">'
                + esc(d.message || 'Listan gick inte att läsa.') + '</td></tr>';
            return;
        }

        verRows = verRows.concat(d.rows || []);
        verSkip = verRows.length;

        // ⚠️⚠️ LUCKAN ÄR DET FÖRSTA EN REVISOR KONTROLLERAR. Numreringen påstås vara
        //    luckfri; rutan är beviset. Den räknas på HELA året, inte på den filtrerade sidan —
        //    ett filter tar självklart bort nummer, och att kalla det en lucka vore falskt larm
        //    på varje sökning.
        show(el('verGap'), d.hasGaps === true);
        if (d.hasGaps) {
            el('verGap').textContent = 'Det saknas verifikationsnummer i serien: '
                + (d.series || []).filter(function (x) { return x.count !== x.expected; })
                    .map(function (x) {
                        return x.prefix + '-' + x.first + '\u2013' + x.prefix + '-' + x.last
                             + ' har ' + x.count + ' av ' + x.expected;
                    }).join(', ')
                + '. Numreringen ska vara luckfri — kontakta oss.';
        }

        el('verSummary').textContent = (d.series || [])
            .map(function (x) { return x.prefix + '-' + x.first + ' – ' + x.prefix + '-' + x.last; })
            .join(' · ');

        renderJournal(d.total);
    }

    function renderJournal(total) {
        el('verBody').innerHTML = verRows.length === 0
            ? '<tr><td colspan="6" class="muted">Inga verifikationer i urvalet.</td></tr>'
            : verRows.map(function (v, i) {
                // ⚠️ Kedjans två sista led som EGNA kolumner. En bock räcker: frågan är
                //    "finns det underlag" och "syns betalningen på banken", inte hur många.
                var underlag = v.attachmentCount > 0
                    ? '<span title="' + v.attachmentCount + ' underlag">\u2713 '
                      + v.attachmentCount + '</span>'
                    : (v.isManual
                        ? '<span class="muted" title="Bokförd för hand utan underlag">\u2014</span>'
                        : '<span class="muted" title="Faller ut ur en avgift — underlaget är anmälan">auto</span>');

                var bank = v.bankMatchedLines > 0
                    ? '<span title="Matchad mot kontoutdraget">\u2713</span>'
                    : '<span class="muted">\u2014</span>';

                return '<tr class="ver-row" data-ver="' + i + '" style="cursor:pointer">'
                     + '<td>' + esc(v.number) + '</td>'
                     + '<td class="muted">' + esc(shortDate(v.accountingDate)) + '</td>'
                     + '<td>' + esc(v.description)
                     + (v.counterparty ? ' <span class="muted">· ' + esc(v.counterparty) + '</span>' : '')
                     + (v.correctsEntryId ? ' <span class="muted">(rättelse)</span>' : '')
                     + '</td>'
                     + '<td class="n">' + kr(v.amount) + '</td>'
                     + '<td>' + underlag + '</td>'
                     + '<td>' + bank + '</td></tr>';
            }).join('');

        el('verCount').textContent = verRows.length + ' av ' + total;
        show(el('verMore'), verRows.length < total);

        // ⚠️ Raden bär ett INDEX, aldrig verifikationens text i ett onclick. Beskrivningen
        //    skrivs av en människa, och ett citattecken där hade avslutat attributet.
        el('verBody').querySelectorAll('tr[data-ver]').forEach(function (tr) {
            tr.addEventListener('click', function () {
                openEntry(verRows[parseInt(tr.dataset.ver, 10)]);
            });
        });
    }

    function closeEntry() { show(el('verDetail'), false); }

    async function openEntry(v) {
        if (!v) return;

        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetJournalEntry?issuerType=' + issuerType
                            + '&issuerId=' + issuerId + '&entryId=' + v.entryId, { cache: 'no-store' })
            .then(function (r) { return r.json(); });

        if (!d.success) { tell('Verifikationen gick inte att läsa', d.message || ''); return; }

        el('verDetailTitle').textContent = 'Verifikation ' + d.head.number;

        var rader = '<table class="t"><thead><tr><th>Konto</th><th>Text</th>'
                  + '<th class="n" style="width:7rem">Debet</th>'
                  + '<th class="n" style="width:7rem">Kredit</th></tr></thead><tbody>'
            + (d.lines || []).map(function (l) {
                return '<tr><td>' + l.accountNumber + ' <span class="muted">'
                     + esc(l.accountName) + '</span></td>'
                     + '<td>' + esc(l.text || '') + '</td>'
                     + '<td class="n">' + (l.debit ? kr(l.debit) : '') + '</td>'
                     + '<td class="n">' + (l.credit ? kr(l.credit) : '') + '</td></tr>';
            }).join('')
            // ⚠️ Summaraden visas ALLTID, också när den går ihop. Det är den enklaste
            //    kontrollen som finns, och en revisor ska slippa addera i huvudet.
            + '<tr class="sum"><td colspan="2"><strong>' + (d.balances ? 'Går ihop' : 'GÅR INTE IHOP')
            + '</strong></td><td class="n"><strong>' + kr(d.debitTotal) + '</strong></td>'
            + '<td class="n"><strong>' + kr(d.creditTotal) + '</strong></td></tr>'
            + '</tbody></table>';

        var bank = (d.bankRows || []).length === 0
            ? '<p class="muted">Ingen rad i kontoutdraget pekar på den här verifikationen.</p>'
            : '<table class="t"><thead><tr><th style="width:7rem">Bokfördes</th><th>Text på kontoutdraget</th>'
              + '<th class="n" style="width:8rem">Belopp</th><th style="width:10rem">Matchad</th></tr></thead><tbody>'
              + d.bankRows.map(function (b) {
                  return '<tr><td class="muted">' + esc(shortDate(b.bookedDate)) + '</td>'
                       + '<td>' + esc(b.text) + '</td>'
                       + '<td class="n">' + kr(b.amount) + '</td>'
                       + '<td class="muted">' + esc(b.matchKind || '')
                       + (b.matchedByName ? ' · ' + esc(b.matchedByName) : '') + '</td></tr>';
              }).join('') + '</tbody></table>';

        var underlag = (d.attachments || []).length === 0
            ? '<p class="muted">Inget underlag kopplat än.</p>'
            : '<div class="rows">' + d.attachments.map(function (a) {
                var url = '/umbraco/surface/EkonomiAdmin/GetAttachment?issuerType=' + issuerType
                        + '&issuerId=' + issuerId + '&attachmentId=' + a.id;
                return '<div><span class="grow">'
                     + (a.isVoided ? '<s>' : '')
                     + '<a href="' + url + '" target="_blank" rel="noopener">' + esc(a.fileName) + '</a>'
                     + (a.isVoided ? '</s>' : '')
                     + '<span class="muted"> · ' + esc(a.uploadedByName) + ' ' + esc(shortDate(a.uploadedUtc)) + '</span>'
                     + (a.isVoided ? '<div class="muted">Bortkopplad: ' + esc(a.voidReason || '') + '</div>' : '')
                     + '</span>'
                     + (canWrite && !a.isVoided
                        ? '<button type="button" class="btn btn-sm btn-outline-danger" data-void="' + a.id + '">Koppla bort…</button>'
                        : '')
                     + '</div>';
            }).join('') + '</div>';

        // ⚠️ Uppladdningen renderas bara för den som får skriva. En inbjuden revisor läser
        //    underlagen, lägger aldrig till dem.
        var uppladdning = !canWrite ? '' :
            '<div class="amount-row" style="margin-top:.75rem">'
            + '<input type="file" class="form-control" id="' + uid + '_verFile" '
            + 'accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,.csv,.txt">'
            + '<button type="button" class="btn btn-sm btn-primary" id="' + uid + '_verUpload">'
            + 'Lägg till underlag</button></div>'
            + '<div class="ek-alert ek-bad d-none" id="' + uid + '_verUploadErr" style="margin-top:.5rem"></div>';

        // ⚠️⚠️ RÄTTELSEKEDJAN SYNS ÅT BÅDA HÅLLEN. En rättad post som ser ut som vilken post som
        //    helst läses som att felet står kvar — och den som letar bokför om den en gång till.
        var chain = '';
        if (d.correctedByNumber)
            chain += '<div class="ek-alert">' + badge('off', 'Rättad') + ' Posten är utjämnad av '
                   + '<strong>' + esc(d.correctedByNumber) + '</strong>. Den står kvar i bokföringen, '
                   + 'men påverkar inte längre resultatet.</div>';
        if (d.correctsNumber)
            chain += '<div class="ek-alert">' + badge('info', 'Rättelse') + ' Den här posten rättar '
                   + '<strong>' + esc(d.correctsNumber) + '</strong>.</div>';

        var correctBtn = (canWrite && d.canCorrect)
            ? '<div style="margin-top:.75rem"><button type="button" class="btn btn-sm btn-outline-secondary" id="'
              + uid + '_verCorrect">Rätta den här posten…</button>'
              + ' <span class="muted" style="font-size:.85rem">Blev något fel? Posten tas ut med en rättelse, '
              + 'och du bokför den rätta posten igen.</span></div>'
            : '';

        el('verDetailBody').innerHTML =
            '<p class="muted" style="margin-top:0">' + esc(shortDate(d.head.accountingDate))
            + ' · ' + esc(d.head.description)
            + (d.head.counterparty ? ' · ' + esc(d.head.counterparty) : '') + '</p>'
            + chain
            + rader
            + correctBtn
            + '<h3 style="margin-top:1.25rem">Underlag</h3>' + underlag + uppladdning
            + '<h3 style="margin-top:1.25rem">Betalningen på banken</h3>' + bank;

        show(el('verDetail'), true);
        el('verDetail').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

        if (canWrite) wireEntryActions(d.head.entryId, v);
    }

    function wireEntryActions(entryId, row) {
        var cb = el('verCorrect');
        if (cb) cb.addEventListener('click', function () {
            ask({
                title: 'Rätta posten',
                text: 'Posten tas ut med en rättelse som bokförs i dag. Den gamla står kvar — så ska '
                    + 'det vara, och det är inget du gjort fel. Efteråt bokför du den rätta posten under Bokför.',
                label: 'Vad var fel?',
                help: 'Till exempel "fel belopp, ska vara 340 kr" eller "fel konto".',
                multiline: true, required: true,
                ok: 'Rätta posten'
            }).then(function (reason) {
                if (reason === null) return;
                postJson('/umbraco/surface/EkonomiAdmin/CorrectEntry', {
                    issuerType: issuerType, issuerId: issuerId, entryId: entryId, reason: reason
                }).then(function (j) {
                    if (!j.success) { tell('Posten rättades inte', j.message); return; }
                    loadJournal(true).then(function () { openEntry(row); });
                    loadOverview();
                    tell('Posten är rättad', j.message);
                });
            });
        });

        var up = el('verUpload');
        if (up) up.addEventListener('click', function () {
            var input = el('verFile');
            var errBox = el('verUploadErr');
            show(errBox, false);

            if (!input.files || input.files.length === 0) {
                errBox.textContent = 'Välj en fil först.';
                show(errBox, true);
                return;
            }

            up.disabled = true;

            // ⚠️ FormData, inte JSON — en fil ska aldrig base64-kodas genom ett JSON-fält.
            //    Token hämtas på samma sätt som postJson gör.
            withToken(function (t) {
                var fd = new FormData();
                fd.append('issuerType', issuerType);
                fd.append('issuerId', issuerId);
                fd.append('entryId', entryId);
                fd.append('file', input.files[0]);

                fetch('/umbraco/surface/EkonomiAdmin/UploadAttachment', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': t || '' },
                    body: fd
                })
                    .then(function (r) { return r.json(); })
                    .then(function (j) {
                        up.disabled = false;
                        if (!j.success) { errBox.textContent = j.message; show(errBox, true); return; }
                        // Listan måste hämtas om — underlagskolumnen är en av kedjans två bockar.
                        loadJournal(true).then(function () { openEntry(row); });
                    })
                    .catch(function (e) {
                        up.disabled = false;
                        errBox.textContent = e.message;
                        show(errBox, true);
                    });
            });
        });

        el('verDetailBody').querySelectorAll('button[data-void]').forEach(function (b) {
            b.addEventListener('click', function () {
                // ⚠️ Skälet är obligatoriskt och prövas på servern också. En bortkopplad
                //    bilaga utan skäl går inte att bedöma i efterhand.
                ask({
                    title: 'Koppla bort underlaget',
                    text: 'Filen raderas inte — den är räkenskapsinformation och finns kvar i historiken.',
                    label: 'Varför kopplas det bort?',
                    help: 'Texten syns för revisorn.',
                    multiline: true, required: true,
                    ok: 'Koppla bort', danger: true
                }).then(function (reason) {
                    if (reason === null) return;
                    postJson('/umbraco/surface/EkonomiAdmin/VoidAttachment', {
                        issuerType: issuerType, issuerId: issuerId,
                        attachmentId: parseInt(b.dataset.void, 10), reason: reason
                    }).then(function (j) {
                        if (!j.success) { tell('Underlaget kopplades inte bort', j.message); return; }
                        loadJournal(true).then(function () { openEntry(row); });
                    });
                });
            });
        });
    }

    if (el('verApply')) el('verApply').addEventListener('click', function () { loadJournal(true); });
    if (el('verMore')) el('verMore').addEventListener('click', function () { loadJournal(false); });
    if (el('verClose')) el('verClose').addEventListener('click', closeEntry);

    if (el('verClear')) el('verClear').addEventListener('click', function () {
        el('verSearch').value = '';
        setDateField('verFrom', '');
        setDateField('verTo', '');
        loadJournal(true);
    });

    // Enter i sökrutan ska söka — annars får man leta efter knappen.
    if (el('verSearch')) el('verSearch').addEventListener('keydown', function (ev) {
        if (ev.key === 'Enter') { ev.preventDefault(); loadJournal(true); }
    });



    // ══ UTGIFTSSIDAN ═════════════════════════════════════════════════════════════════════
    //
    // ⚠️⚠️ REGISTRERING BOKFÖR INGENTING. Föreningen bokför enligt kontantmetoden, så
    //    verifikationen skrivs när utgiften BETALAS — och det sker på exakt ett ställe här nere
    //    (payExpense). Allt annat är arbetslista och attest.
    var expenseLoaded = false;
    var expensePayees = null;
    var expenseRows = [];
    var payingId = 0;

    async function loadExpenses() {
        show(el('utError'), false);

        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetExpenses?issuerType=' + issuerType
                            + '&issuerId=' + issuerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); });

        if (!d.success) {
            el('utError').textContent = d.message || 'Utgifterna gick inte att läsa.';
            show(el('utError'), true);
            return;
        }

        expenseRows = d.expenses || [];
        renderExpenses(d);
        renderIncomingFees(d.incomingRegionFees || [], d.incomingInvoices || []);

        if (canWrite) {
            fillSelect(el('uAccount'), d.accounts || []);
            fillSelect(el('utPayAccount'), d.paymentAccounts || []);

            // ⚠️ Projektet är FRIVILLIGT, så listan måste bära ett tomt val. Utan det blir varje
            //    utgift märkt med det första projektet i listan, tyst.
            el('uProject').innerHTML = '<option value="0">Inget projekt</option>'
                + (d.projects || []).map(function (p) {
                    return '<option value="' + p.id + '">' + esc(p.name) + '</option>';
                }).join('');
        }
    }

    function expenseStatusCell(e) {
        var extra = '';

        // ⚠️ Attesten SÄGS med namn. "Attesterad" utan vem är inte en internkontroll, det är en
        //    bock — och det är just namnet revisorn frågar efter.
        if (e.approvedByName)
            extra += '<div class="muted">Attesterad av ' + esc(e.approvedByName)
                   + (e.approvedBySelf ? ' (som också registrerade den)' : '') + '</div>';

        if (e.rejectedReason)
            extra += '<div class="muted">' + esc(e.rejectedReason) + '</div>';

        // Status som bricka, i sajtens färger.
        var kind = { registered: 'wait', approved: 'info', paid: 'ok', rejected: 'off' }[e.status] || 'light';
        return badge(kind, e.statusLabel) + extra;
    }

    function renderExpenses(d) {
        var todo = expenseRows.filter(function (e) {
            return e.status === 'registered' || e.status === 'approved';
        });
        var done = expenseRows.filter(function (e) {
            return e.status === 'paid' || e.status === 'rejected';
        });

        el('utTodoMeta').textContent = todo.length === 0 ? ''
            : (d.toApprove || 0) + ' väntar på attest · ' + (d.toPay || 0) + ' att betala ('
              + kr(d.toPayAmount) + ')'
              + ((d.overdue || 0) > 0 ? ' · ' + d.overdue + ' förfallna' : '');

        el('utDoneMeta').textContent = done.length === 0 ? ' — inget ännu'
                                                         : ' — ' + done.length + ' utgifter';

        el('utTodoBody').innerHTML = todo.length === 0
            ? '<tr><td colspan="6" class="muted">Ingenting väntar. Kommer en räkning eller har '
              + 'någon lagt ut pengar registrerar du det under Åtgärder.</td></tr>'
            : todo.map(function (e) {
                // ⚠️ Husets form: EN liten grå Åtgärder per rad, det destruktiva sist och i rött.
                //    Förut fyra blå textlänkar i rad, där "Avvisa" såg ut som "Ändra".
                var acts = !canWrite ? '' : rowMenu([
                    e.status === 'registered' && { act: 'approve', id: e.id, text: 'Attestera…' },
                    e.canPay && { act: 'pay', id: e.id, text: 'Betala…' },
                    { act: 'edit', id: e.id, text: 'Ändra…' },
                    { act: 'reject', id: e.id, text: 'Avvisa…', danger: true }
                ]);

                // ⚠️ "Saknas" står UT. En tom cell läser som att ingen tittat efter kvittot, och
                //    det är skillnaden mellan ett underlag som fattas och ett ingen frågat om.
                var receipt = e.hasReceipt
                    ? '<a href="/umbraco/surface/EkonomiAdmin/GetExpenseReceipt?issuerType=' + issuerType
                      + '&issuerId=' + issuerId + '&expenseId=' + e.id
                      + '" target="_blank" rel="noopener">Visa kvittot</a>'
                    : badge('miss', 'Kvitto saknas');

                return '<tr><td><strong>' + esc(e.description) + '</strong>'
                     + '<div class="muted">' + esc(e.kindLabel) + ' · ' + e.accountNumber
                     + ' ' + esc(e.accountName)
                     + (e.projectName ? ' · ' + esc(e.projectName) : '') + '</div>'
                     + '<div class="muted">' + receipt + '</div></td>'
                     + '<td>' + esc(e.payeeName) + '</td>'
                     + '<td class="muted">' + (e.dueDate ? esc(shortDate(e.dueDate)) : '—')
                     + (e.isOverdue ? '<div>' + badge('bad', 'Förfallen') + '</div>' : '') + '</td>'
                     + '<td class="n">' + kr(e.amount) + '</td>'
                     + '<td>' + expenseStatusCell(e) + '</td>'
                     + '<td class="n">' + acts + '</td></tr>';
            }).join('');

        el('utDoneBody').innerHTML = done.length === 0
            ? '<tr><td colspan="6" class="muted">Inget avklarat ännu.</td></tr>'
            : done.map(function (e) {
                return '<tr><td>' + esc(e.description)
                     + '<div class="muted">' + esc(e.kindLabel) + '</div></td>'
                     + '<td>' + esc(e.payeeName) + '</td>'
                     + '<td class="muted">' + (e.paidDate ? esc(shortDate(e.paidDate)) : '—') + '</td>'
                     + '<td class="n">' + kr(e.amount) + '</td>'
                     + '<td>' + expenseStatusCell(e) + '</td>'
                     + '<td class="muted">' + esc(e.journalEntryNumber || '') + '</td></tr>';
            }).join('');

        onRowAction(el('utTodoBody'), {
            approve: function (id) { approveExpense(parseInt(id, 10)); },
            reject: function (id) { rejectExpense(parseInt(id, 10)); },
            pay: function (id) { openPayPanel(parseInt(id, 10)); },
            edit: function (id) {
                var e = expenseRows.find(function (x) { return x.id === parseInt(id, 10); });
                if (e) fillExpenseForm(e);
            }
        });
    }

    function expenseDone(j, reload) {
        if (!j.success) {
            el('utError').textContent = j.message;
            show(el('utError'), true);
            show(el('utOk'), false);
            return false;
        }
        el('utOk').textContent = j.message;
        show(el('utOk'), true);
        show(el('utError'), false);
        if (reload !== false) loadExpenses();
        return true;
    }

    function expenseOf(id) { return expenseRows.find(function (x) { return x.id === id; }); }
    function expenseWhat(e) { return e ? e.description + ' — ' + kr(e.amount) + ' till ' + e.payeeName : ''; }

    function approveExpense(id) {
        ask({
            title: 'Attestera utgiften',
            text: expenseWhat(expenseOf(id)) + '. Att attestera betyder att du godkänner att den betalas.',
            label: 'Notering (frivilligt)',
            help: 'Följer med till bokföringen, t.ex. "enligt styrelsebeslut 12 mars".',
            ok: 'Attestera'
        }).then(function (note) {
            if (note === null) return;
            postJson('/umbraco/surface/EkonomiAdmin/ApproveExpense', {
                issuerType: issuerType, issuerId: issuerId, expenseId: id, text: note
            }).then(expenseDone);
        });
    }

    function rejectExpense(id) {
        ask({
            title: 'Avvisa utgiften',
            text: expenseWhat(expenseOf(id)) + '.',
            label: 'Varför avvisas den?',
            help: 'Den som lagt ut pengarna ska kunna läsa skälet.',
            multiline: true, required: true,
            ok: 'Avvisa', danger: true
        }).then(function (reason) {
            if (reason === null) return;
            postJson('/umbraco/surface/EkonomiAdmin/RejectExpense', {
                issuerType: issuerType, issuerId: issuerId, expenseId: id, text: reason
            }).then(expenseDone);
        });
    }

    function openPayPanel(id) {
        var e = expenseOf(id);
        if (!e) return;

        payingId = id;
        el('utPayWhat').textContent = expenseWhat(e);
        show(el('utPayError'), false);

        // ⚠️ Idag som förval, inte fakturadatumet: betaldagen är det som gäller under
        //    kontantmetoden, och kassören betalar nästan alltid samma dag hen klickar.
        if (!el('utPayDate').value)
            setDateField('utPayDate', new Date().toISOString().substring(0, 10));

        openModal('utPayModal');
    }

    if (el('utPayModal')) el('utPayModal').addEventListener('hidden.bs.modal', function () { payingId = 0; });

    if (el('utPayConfirm')) el('utPayConfirm').addEventListener('click', function () {
        if (!payingId) return;
        var btn = this;
        btn.disabled = true;

        postJson('/umbraco/surface/EkonomiAdmin/PayExpense', {
            issuerType: issuerType, issuerId: issuerId, expenseId: payingId,
            paidDate: el('utPayDate').value,
            paymentAccountNumber: parseInt(el('utPayAccount').value, 10) || 0
        }).then(function (j) {
            btn.disabled = false;
            // ⚠️ Dialogen stängs INTE vid fel — annars får man börja om för att läsa vad som gick snett.
            if (!j.success) { el('utPayError').textContent = j.message; show(el('utPayError'), true); return; }
            closeModal('utPayModal');
            expenseDone(j);
        }).catch(function (err) {
            btn.disabled = false;
            el('utPayError').textContent = err.message;
            show(el('utPayError'), true);
        });
    });

    // ⚠️ Mottagarlistan hämtas LAT, först när någon väljer Utlägg. Klubbgrenen går genom hela
    //    medlemsregistret, och det ska inte ligga i varje sidladdning av ekonomiytan.
    function loadPayees() {
        if (expensePayees) return Promise.resolve();

        return fetch('/umbraco/surface/EkonomiAdmin/GetExpensePayees?issuerType=' + issuerType
                     + '&issuerId=' + issuerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) return;
                expensePayees = d.payees || [];

                el('uPayee').innerHTML = expensePayees.map(function (m) {
                    return '<option value="' + m.id + '">' + esc(m.name) + '</option>';
                }).join('');

                // ⚠️ Avgränsningen sägs ut. En lista som bara innehåller kretsens styrelse, utan
                //    att något förklarar varför, läser som att medlemmarna saknas.
                if (d.note) el('uHint').textContent = d.note;
            });
    }

    function syncExpenseKind() {
        var isUtlagg = el('uKind').value === 'utlagg';

        show(el('uPayeeMemberWrap'), isUtlagg);
        show(el('uPayeeNameWrap'), !isUtlagg);
        show(el('uDueWrap'), !isUtlagg);

        if (isUtlagg) {
            // ⚠️ Förfallodagen NOLLSTÄLLS vid byte till utlägg. Ett utlägg har ingen, och servern
            //    vägrar — ett kvarglömt datum hade gett ett avslag på något användaren inte ser.
            setDateField('uDue', '');
            loadPayees();
        }
    }

    if (el('uKind')) el('uKind').addEventListener('change', syncExpenseKind);

    // ⚠️⚠️ ETT NYTT UTLÄGG MÅSTE KÖRA syncExpenseKind. Förut kördes den bara när någon BYTTE slag,
    //    så första gången formuläret öppnades som utlägg var mottagarlistan TOM och förfallodagen
    //    synlig — och Spara nekades med "välj vem som ska ha pengarna" utan att något gick att välja.
    var incomingFees = [];
    function renderIncomingFees(list, invoices) {
        incomingFees = list;
        invoices = invoices || [];
        show(el('utIncoming'), list.length > 0 || invoices.length > 0);
        if (list.length === 0 && invoices.length === 0) return;

        var statusLabel = { registered: 'Väntar på attest', approved: 'Attesterad', paid: 'Betald' };
        el('utIncomingBody').innerHTML = list.map(function (f, i) {
            var state = f.expenseId
                ? badge(f.expenseStatus === 'paid' ? 'ok' : 'info', 'Registrerad · ' + (statusLabel[f.expenseStatus] || f.expenseStatus))
                : (f.paidByUs ? badge('ok', 'Kretsen har kvitterat') + ' ' : '') + badge('wait', 'Inte registrerad');
            var btn = (!f.expenseId && canWrite)
                ? '<button type="button" class="btn btn-sm btn-outline-secondary" data-incoming="' + i + '">Registrera som räkning</button>'
                : '';
            return '<tr><td>' + esc(f.regionName) + ' <span class="muted">· Kretsavgift ' + f.year
                 + ' · ' + esc(f.reference) + '</span></td>'
                 + '<td class="n" style="width:8rem">' + kr(f.amount) + '</td>'
                 + '<td style="width:17rem">' + state + '</td>'
                 + '<td class="n" style="width:13rem">' + btn + '</td></tr>';
        }).join('')
        // Fakturor från andra föreningar (anmälningsavgifter). "Registrerad" = referensen står i en
        // utgifts beskrivning — samma regel som kretsavgiften.
        + invoices.map(function (f, i) {
            var state = f.expenseId
                ? badge(f.expenseStatus === 'paid' ? 'ok' : 'info', 'Registrerad · ' + (statusLabel[f.expenseStatus] || f.expenseStatus))
                : (f.settled ? badge('ok', 'Arrangören har kvitterat') + ' ' : '') + badge('wait', 'Inte registrerad');
            var btn = (!f.expenseId && canWrite)
                ? '<button type="button" class="btn btn-sm btn-outline-secondary" data-incoming-inv="' + i + '">Registrera som räkning</button>'
                : '';
            return '<tr><td>' + esc(f.issuerName) + ' <span class="muted">· Faktura '
                 + (f.documentUrl ? '<a href="' + esc(f.documentUrl) + '" target="_blank">' + esc(f.number) + '</a>' : esc(f.number))
                 + ' · ' + esc(f.competitionName) + ' · ' + esc(f.reference) + '</span></td>'
                 + '<td class="n" style="width:8rem">' + kr(f.amount) + '</td>'
                 + '<td style="width:17rem">' + state + '</td>'
                 + '<td class="n" style="width:13rem">' + btn + '</td></tr>';
        }).join('');

        el('utIncomingBody').querySelectorAll('button[data-incoming-inv]').forEach(function (b) {
            b.addEventListener('click', function () {
                var f = invoices[parseInt(b.dataset.incomingInv, 10)];
                openExpenseForm('faktura');
                // ⚠️ Referensen MÅSTE stå i beskrivningen — det är den som gör raden "registrerad".
                el('uDesc').value = 'Faktura ' + f.number + ', ' + f.competitionName + ' (' + f.reference + ')';
                el('uAmount').value = f.outstanding > 0 ? f.outstanding : f.amount;
                el('uPayeeName').value = f.issuerName;
                if (f.issueDate) setDateField('uDate', f.issueDate);
                if (f.dueDate) setDateField('uDue', f.dueDate);
            });
        });

        el('utIncomingBody').querySelectorAll('button[data-incoming]').forEach(function (b) {
            b.addEventListener('click', function () {
                var f = incomingFees[parseInt(b.dataset.incoming, 10)];
                openExpenseForm('faktura');
                el('uDesc').value = 'Kretsavgift ' + f.year + ' (' + f.reference + ')';
                el('uAmount').value = f.amount;
                el('uPayeeName').value = f.regionName;
                if (f.sentDate) setDateField('uDate', String(f.sentDate).substring(0, 10));
                // Förbunds- och kretsavgifter, om föreningen har kontot.
                if (el('uAccount').querySelector('option[value="6980"]')) el('uAccount').value = '6980';
            });
        });
    }

    function openExpenseForm(kind) {
        resetExpenseForm();
        el('uKind').value = kind === 'faktura' ? 'faktura' : 'utlagg';
        el('utFormTitle').textContent = kind === 'faktura' ? 'Registrera en räkning' : 'Registrera ett utlägg';
        syncExpenseKind();
        openModal('utFormModal');
        setTimeout(function () { el('uDesc').focus(); }, 300);
    }
    if (el('utNewUtlagg')) el('utNewUtlagg').addEventListener('click', function () { openExpenseForm('utlagg'); });
    if (el('utNewFaktura')) el('utNewFaktura').addEventListener('click', function () { openExpenseForm('faktura'); });

    function fillExpenseForm(e) {
        show(el('uError'), false);
        el('utFormTitle').textContent = 'Ändra ' + e.description;
        el('uId').value = e.id;
        el('uKind').value = e.kind;
        el('uDesc').value = e.description || '';
        el('uAmount').value = e.amount;
        setDateField('uDate', String(e.expenseDate).substring(0, 10));
        setDateField('uDue', e.dueDate ? String(e.dueDate).substring(0, 10) : '');
        el('uPayeeName').value = e.kind === 'faktura' ? (e.payeeName || '') : '';
        el('uAccount').value = String(e.accountNumber);
        el('uProject').value = String(e.projectId || 0);

        el('uReceiptNow').textContent = e.hasReceipt
            ? 'Kvitto: ' + e.receiptFileName + '. Väljer du en ny fil ersätts den.'
            : '';

        syncExpenseKind();

        if (e.kind === 'utlagg' && e.payeeMemberId) {
            loadPayees().then(function () { el('uPayee').value = String(e.payeeMemberId); });
        }

        openModal('utFormModal');
    }

    function resetExpenseForm() {
        el('utFormTitle').textContent = 'Registrera en utgift';
        el('uId').value = '0';
        el('uDesc').value = '';
        el('uAmount').value = '';
        el('uPayeeName').value = '';
        setDateField('uDate', '');
        setDateField('uDue', '');
        el('uReceipt').value = '';
        el('uReceiptNow').textContent = '';
        show(el('uError'), false);
        syncExpenseKind();
    }

    function expenseFormError(t) { el('uError').textContent = t; show(el('uError'), true); }

    if (el('uSave')) el('uSave').addEventListener('click', function () {
        var btn = this;
        btn.disabled = true;

        var isUtlagg = el('uKind').value === 'utlagg';

        postJson('/umbraco/surface/EkonomiAdmin/SaveExpense', {
            issuerType: issuerType, issuerId: issuerId,
            id: parseInt(el('uId').value, 10) || 0,
            kind: el('uKind').value,
            payeeMemberId: isUtlagg ? (parseInt(el('uPayee').value, 10) || 0) : 0,
            // ⚠️ Vid utlägg är NAMNET mottagarens, taget ur väljaren — inte fritextfältet, som
            //    hör till leverantörsgrenen. Blandas de ihop sparas ett tomt mottagarnamn.
            payeeName: isUtlagg
                ? (el('uPayee').selectedOptions[0] ? el('uPayee').selectedOptions[0].textContent : '')
                : el('uPayeeName').value,
            description: el('uDesc').value,
            amount: parseFloat(el('uAmount').value) || 0,
            expenseDate: el('uDate').value,
            dueDate: isUtlagg ? '' : el('uDue').value,
            accountNumber: parseInt(el('uAccount').value, 10) || 0,
            projectId: parseInt(el('uProject').value, 10) || 0
        }).then(function (j) {
            btn.disabled = false;

            // ⚠️ Dialogen stängs INTE vid fel — felet visas i den, så man kan rätta och spara igen.
            if (!j.success) { expenseFormError(j.message); return; }

            closeModal('utFormModal');
            var file = el('uReceipt').files && el('uReceipt').files[0];
            if (!file) { expenseDone(j); resetExpenseForm(); return; }

            // ⚠️ Kvittot laddas upp EFTER sparningen — id:t finns inte förrän raden gör det. Ett
            //    misslyckat kvitto får inte rapporteras som en misslyckad sparning: utgiften ÄR
            //    registrerad, och ett felmeddelande som antyder motsatsen får kassören att skriva
            //    in den en gång till.
            var fd = new FormData();
            fd.append('issuerType', issuerType);
            fd.append('issuerId', issuerId);
            fd.append('expenseId', j.id);
            fd.append('file', file);

            postForm('/umbraco/surface/EkonomiAdmin/UploadExpenseReceipt', fd).then(function (u) {
                if (!u.success) {
                    el('utError').textContent = 'Utgiften är sparad, men kvittot kunde inte kopplas: '
                        + u.message;
                    show(el('utError'), true);
                } else {
                    expenseDone(j, false);
                }
                resetExpenseForm();
                loadExpenses();
            });
        }).catch(function (err) {
            btn.disabled = false;
            expenseFormError(err.message);
        });
    });

    // ══ ANLÄGGNINGSREGISTRET ═════════════════════════════════════════════════════════════
    //
    // ⚠️⚠️ "BOKFÖRT I ÅR" ÄR HÄRLETT UR LIGGAREN, aldrig en flagga på tillgången. En flagga kan
    //    glömmas; en verifikation kan inte. Samma princip som medlemsavgifternas "bokförd".
    var assetLoaded = false;
    var assetAccounts = null;

    async function loadAssets() {
        show(el('assetError'), false);
        show(el('assetOk'), false);

        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetAssets?issuerType=' + issuerType
                            + '&issuerId=' + issuerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); });

        if (!d.success) {
            el('assetError').textContent = d.message || 'Registret gick inte att läsa.';
            show(el('assetError'), true);
            return;
        }

        show(el('assetNoYear'), d.hasFiscalYear === false);
        show(el('assetListCard'), d.hasFiscalYear !== false);
        // Menyn finns bara när det finns ett år att räkna avskrivningen i.
        show(el('assetActions'), d.hasFiscalYear !== false);

        if (d.hasFiscalYear === false) return;

        assetMissing = d.missingAccounts || [];
        assetLossDefault = d.disposalLossAccount || 0;

        renderAssets(d);
        if (canWrite) loadAssetAccounts();
    }

    // Mallens minus- och förlustkonton föreningen ännu saknar. De skapas när tillgången sparas.
    var assetMissing = [], assetLossDefault = 0;
    var ADDED = ' (läggs till)';

    function withMissing(list, pick) {
        var have = {};
        list.forEach(function (a) { have[a.number] = true; });
        return list.concat(assetMissing.filter(function (m) { return pick(m.number) && !have[m.number]; })
                                       .map(function (m) { return { number: m.number, name: m.name + ADDED }; }))
                   .sort(function (a, b) { return a.number - b.number; });
    }

    // ⚠️ Förslaget är tillgångskontot med 9 sist (1220 → 1229). Bara ett förslag — finns det
    //    inte i listan lämnas valet orört.
    function proposeAccAccount() {
        var n = parseInt(el('aAssetAccount').value, 10);
        if (!n) return;
        var want = String(Math.floor(n / 10) * 10 + 9);
        var sel = el('aAccAccount');
        if (Array.prototype.some.call(sel.options, function (o) { return o.value === want; })) sel.value = want;
    }

    function renderAssets(d) {
        var rows = d.assets || [];

        el('assetMeta').textContent = rows.length === 0
            ? 'Räkenskapsåret ' + d.year
            : rows.length + ' tillgångar · bokfört värde ' + kr(d.bookValueTotal)
              + ' · räkenskapsåret ' + d.year;

        el('assetBody').innerHTML = rows.length === 0
            ? '<tr><td colspan="7" class="muted">Registret är tomt. Har föreningen köpt något '
              + 'som ska hålla i flera år lägger du in det under Åtgärder.</td></tr>'
            : rows.map(function (a) {
                // ⚠️ En utrangerad rad STÅR KVAR och märks ut. Den är underlaget till
                //    utrangeringens verifikation — revisorn ska kunna se vad som togs bort.
                var mark = a.isDisposed
                    ? '<div>' + badge('off', 'Utrangerad', esc(shortDate(a.disposedDate))
                      + (a.disposalReason ? ' · ' + esc(a.disposalReason) : '')) + '</div>'
                    : (a.isFullyDepreciated
                        ? '<div>' + badge('ok', 'Färdigavskriven') + '</div>' : '');

                var acts = !(canWrite && !a.isDisposed) ? '' : rowMenu([
                    { act: 'edit', id: a.id, text: 'Ändra…' },
                    { act: 'dispose', id: a.id, text: 'Utrangera…', danger: true }
                ]);

                return '<tr><td><strong>' + esc(a.name) + '</strong>'
                     + (a.note ? '<div class="muted">' + esc(a.note) + '</div>' : '')
                     + mark
                     + '<div class="muted">Står på ' + a.assetAccountNumber + ' ' + esc(a.assetAccountName)
                     + ' · skrivs av mot ' + a.depreciationAccountNumber + ' ' + esc(a.depreciationAccountName)
                     + ' · avskrivningarna samlas på ' + a.accumulatedDepreciationAccountNumber
                     + (a.accumulatedDepreciationAccountName ? ' ' + esc(a.accumulatedDepreciationAccountName) : '')
                     + '</div></td>'
                     + '<td class="muted">' + esc(shortDate(a.inUseDate))
                     + '<div class="muted">' + a.usefulLifeYears + ' år</div></td>'
                     + '<td class="n">' + kr(a.acquisitionAmount) + '</td>'
                     + '<td class="n">' + kr(a.bookValue) + '</td>'
                     + '<td class="n">' + kr(a.plannedThisYear) + '</td>'
                     // ⚠️ Skillnaden SÄGS ut. "Bokfört i år" som står under planen utan
                     //    förklaring läses som ett räknefel, inte som något att göra.
                     + '<td class="n">' + kr(a.postedThisYear)
                     + (a.needsPosting ? '<div class="muted">' + kr(a.remaining) + ' kvar</div>' : '')
                     + '</td>'
                     + '<td class="n">' + acts + '</td></tr>';
            }).join('');

        assetRows = d.assets || [];
        onRowAction(el('assetBody'), {
            edit: function (id) {
                var a = assetRows.find(function (x) { return x.id === parseInt(id, 10); });
                if (a) fillAssetForm(a);
            },
            dispose: function (id) { disposeAsset(parseInt(id, 10)); }
        });

        renderAssetAction(d);
    }
    var assetRows = [];

    // ⚠️ Menyposten FINNS bara när något återstår. En post som inte gör något lär kassören att
    //    sluta läsa menyn.
    function renderAssetAction(d) {
        if (!canWrite) return;
        var list = el('assetMenuList');
        list.querySelectorAll('.ek-post-li').forEach(function (n) { n.remove(); });
        if ((d.toPostCount || 0) === 0) return;

        list.insertAdjacentHTML('beforeend',
            '<li class="ek-post-li"><hr class="dropdown-divider"></li>'
            + '<li class="ek-post-li"><h6 class="dropdown-header">Årets avskrivning</h6></li>'
            + '<li class="ek-post-li"><button type="button" class="dropdown-item" id="' + uid
            + '_aPost">Bokför årets avskrivningar (' + kr(d.toPost) + ')</button></li>');

        el('aPost').addEventListener('click', function () {
            var btn = this;
            btn.disabled = true;
            show(el('assetError'), false);
            show(el('assetOk'), false);

            postJson('/umbraco/surface/EkonomiAdmin/PostDepreciation', {
                issuerType: issuerType, issuerId: issuerId
            }).then(function (j) {
                btn.disabled = false;

                // ⚠️ Problemen SÄGS, aldrig sväljs. En tillgång som inte gick att bokföra är
                //    exakt det som gör bokslutet fel.
                if (j.problems && j.problems.length) {
                    el('assetError').innerHTML = esc(j.message || '') + '<br>'
                        + j.problems.map(esc).join('<br>');
                    show(el('assetError'), true);
                } else if (!j.success) {
                    el('assetError').textContent = j.message || 'Avskrivningarna gick inte att bokföra.';
                    show(el('assetError'), true);
                } else {
                    el('assetOk').textContent = j.message;
                    show(el('assetOk'), true);
                }

                loadAssets();
            }).catch(function (e) {
                btn.disabled = false;
                el('assetError').textContent = e.message;
                show(el('assetError'), true);
            });
        });
    }

    // ⚠️ Kontoplanen hämtas EN gång. Den ändras inte medan kassören skriver in ett vapenskåp.
    function loadAssetAccounts() {
        if (assetAccounts) return Promise.resolve();

        return fetch('/umbraco/surface/EkonomiAdmin/GetChart?issuerType=' + issuerType
                     + '&issuerId=' + issuerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) return;
                assetAccounts = d.accounts || [];

                var balance = assetAccounts.filter(function (a) { return a.isBalance; });
                var result = assetAccounts.filter(function (a) { return !a.isBalance && !a.isIncome; });
                var classOne = function (n) { return n >= 1000 && n < 2000; };
                var cost = function (n) { return n >= 4000 && n < 8000; };

                // ⚠️ Faller tillbaka på HELA kontoplanen när filtret är tomt. En tom rullgardin
                //    ser ut som ett fel i produkten; en bred lista går alltid att välja i.
                // ⚠️ Förval: inventarier (1220 / 7830), det vanligaste. Listans första konto gav
                //    1110 + 4010 Ammunition — en avskrivning på ammunitionskontot.
                fillSelect(el('aAssetAccount'), balance.length ? balance : assetAccounts, 1220);
                fillSelect(el('aDeprAccount'), result.length ? result : assetAccounts, 7830);
                fillSelect(el('aAccAccount'), withMissing(
                    assetAccounts.filter(function (a) { return classOne(a.number); }), classOne));
                fillSelect(el('aDisposeLoss'), withMissing(
                    assetAccounts.filter(function (a) { return cost(a.number); }), cost), assetLossDefault);
                proposeAccAccount();
            });
    }

    if (el('aAssetAccount')) el('aAssetAccount').addEventListener('change', proposeAccAccount);

    function fillAssetForm(a) {
        el('assetFormTitle').textContent = 'Ändra ' + a.name;
        el('aId').value = a.id;
        el('aName').value = a.name || '';
        el('aNote').value = a.note || '';
        el('aAmount').value = a.acquisitionAmount;
        el('aLife').value = a.usefulLifeYears;
        el('aResidual').value = a.residualValue;
        setDateField('aDate', String(a.inUseDate).substring(0, 10));

        loadAssetAccounts().then(function () {
            el('aAssetAccount').value = String(a.assetAccountNumber);
            el('aDeprAccount').value = String(a.depreciationAccountNumber);
            el('aAccAccount').value = String(a.accumulatedDepreciationAccountNumber);
        });

        // ⚠️⚠️ ETT BOKFÖRT BELOPP LÅSER PLANEN, och det sägs INNAN kassören skriver. Servern
        //    vägrar ändå, men ett avslag efter att formuläret fyllts läser som en bugg.
        el('aLocked').textContent = a.postedThisYear > 0
            ? 'Avskrivningar är redan bokförda på den här tillgången, så belopp, datum, '
              + 'nyttjandetid och konton går inte att ändra. Namn och anteckning går.'
            : '';

        show(el('aError'), false);
        openModal('assetFormModal');
    }

    function resetAssetForm() {
        el('assetFormTitle').textContent = 'Lägg till en tillgång';
        el('aId').value = '0';
        el('aName').value = '';
        el('aNote').value = '';
        el('aAmount').value = '';
        el('aLife').value = '5';
        el('aResidual').value = '0';
        setDateField('aDate', '');
        el('aLocked').textContent = '';
        show(el('aError'), false);
    }

    if (el('aNew')) el('aNew').addEventListener('click', function () {
        resetAssetForm();
        loadAssetAccounts().then(function () {
            // Ett nytt formulär börjar på förvalet, inte på förra tillgångens konton.
            fillSelectValue(el('aAssetAccount'), 1220);
            fillSelectValue(el('aDeprAccount'), 7830);
            proposeAccAccount();
        });
        openModal('assetFormModal');
        setTimeout(function () { el('aName').focus(); }, 300);
    });

    // ⚠️ Utrangeringen tar ett DATUM. Det var hårdkodat till i dag, så en försäljning förra
    //    månaden gick inte att föra in på rätt dag.
    var disposingId = 0;
    function disposeAsset(id) {
        var a = assetRows.find(function (x) { return x.id === id; });
        disposingId = id;
        el('aDisposeTitle').textContent = 'Utrangera ' + (a ? a.name : '');
        el('aDisposeReason').value = '';
        setDateField('aDisposeDate', new Date().toISOString().substring(0, 10));
        // Förlustkontot behövs bara när något värde återstår. Färdigavskrivet = inget att välja.
        show(el('aDisposeLossWrap'), !a || a.bookValue > 0);
        loadAssetAccounts().then(function () {
            if (assetLossDefault) fillSelectValue(el('aDisposeLoss'), assetLossDefault);
        });
        show(el('aDisposeError'), false);
        openModal('aDisposeModal');
    }

    function fillSelectValue(sel, v) {
        if (Array.prototype.some.call(sel.options, function (o) { return o.value === String(v); }))
            sel.value = String(v);
    }

    if (el('aDisposeConfirm')) el('aDisposeConfirm').addEventListener('click', function () {
        var reason = el('aDisposeReason').value.trim();
        if (!reason) { el('aDisposeError').textContent = 'Skriv vad som hände med den.'; show(el('aDisposeError'), true); return; }
        var btn = this; btn.disabled = true;
        postJson('/umbraco/surface/EkonomiAdmin/DisposeAsset', {
            issuerType: issuerType, issuerId: issuerId, assetId: disposingId,
            when: el('aDisposeDate').value, reason: reason,
            lossAccountNumber: parseInt(el('aDisposeLoss').value, 10) || 0
        }).then(function (j) {
            btn.disabled = false;
            if (!j.success) { el('aDisposeError').textContent = j.message; show(el('aDisposeError'), true); return; }
            // Ett konto ur mallen kan ha lagts till — hämta kontoplanen på nytt nästa gång.
            assetAccounts = null;
            closeModal('aDisposeModal');
            show(el('assetError'), false);
            el('assetOk').textContent = j.message;
            show(el('assetOk'), true);
            loadAssets();
        }).catch(function (e) {
            btn.disabled = false;
            el('aDisposeError').textContent = e.message; show(el('aDisposeError'), true);
        });
    });

    if (el('aSave')) el('aSave').addEventListener('click', function () {
        var btn = this;
        btn.disabled = true;
        show(el('assetError'), false);
        show(el('assetOk'), false);

        postJson('/umbraco/surface/EkonomiAdmin/SaveAsset', {
            issuerType: issuerType, issuerId: issuerId,
            id: parseInt(el('aId').value, 10) || 0,
            name: el('aName').value,
            note: el('aNote').value,
            assetAccountNumber: parseInt(el('aAssetAccount').value, 10) || 0,
            depreciationAccountNumber: parseInt(el('aDeprAccount').value, 10) || 0,
            accumulatedDepreciationAccountNumber: parseInt(el('aAccAccount').value, 10) || 0,
            inUseDate: el('aDate').value,
            acquisitionAmount: parseFloat(el('aAmount').value) || 0,
            usefulLifeYears: parseInt(el('aLife').value, 10) || 0,
            residualValue: parseFloat(el('aResidual').value) || 0
        }).then(function (j) {
            btn.disabled = false;

            // ⚠️ Dialogen stängs INTE vid fel — felet står i den, så man kan rätta och spara igen.
            if (!j.success) { el('aError').textContent = j.message; show(el('aError'), true); return; }

            closeModal('assetFormModal');
            el('assetOk').textContent = j.message;
            show(el('assetOk'), true);
            resetAssetForm();
            // Minuskontot kan ha lagts till ur mallen — hämta kontoplanen på nytt.
            assetAccounts = null;
            loadAssets();
        }).catch(function (e) {
            btn.disabled = false;
            el('aError').textContent = e.message; show(el('aError'), true);
        });
    });

    // ══ REVISORERNA ══════════════════════════════════════════════════════════════════════
    var revLoaded = false;

    // ⚠️⚠️ ÄGAREN, ALDRIG UTSTÄLLAREN. Man är revisor för en FÖRENING; en sandlåda har negativt
    //    id och kan inte ha revisorer. Kortet ska därför visa samma revisorer oavsett vilken
    //    liggare kassören råkar titta i.
    //
    // ⚠️ TYPEN är densamma för en sandlåda och dess ägare — en klubbs sandlåda är fortfarande
    //    Club — så `issuerType` duger. ID:T gör det INTE: `issuerId` är sandlådans negativa id,
    //    och `ownerId` är föreningens riktiga nod-id. Att ta issuerId här hade skapat
    //    revisorsuppdrag på en kastbar liggare, som ingen kan återkalla från föreningens sida.
    var ownerType = issuerType;
    var ownerId = parseInt(root.dataset.ownerId, 10);

    async function loadAuditors() {
        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetAuditors?ownerType=' + ownerType
                            + '&ownerId=' + ownerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); });

        if (!d.success) {
            el('revBody').innerHTML = '<tr><td colspan="5" class="muted">'
                + esc(d.message || 'Listan gick inte att läsa.') + '</td></tr>';
            return;
        }

        var rows = d.auditors || [];

        el('revBody').innerHTML = rows.length === 0
            ? '<tr><td colspan="5" class="muted">Ingen revisor är inbjuden än.</td></tr>'
            : rows.map(function (a) {
                return '<tr><td>' + esc(a.name)
                     + '<div class="muted">' + esc(a.email) + '</div></td>'
                     + '<td>' + badge(a.isActive ? 'ok' : (/Inbjuden/.test(a.status || '') ? 'wait' : 'off'), a.status)
                     + (a.revokeReason ? '<div class="muted">' + esc(a.revokeReason) + '</div>' : '')
                     + '</td>'
                     + '<td class="muted">' + esc(shortDate(a.expiresUtc)) + '</td>'
                     // ⚠️ "Aldrig" sägs ut. En tom cell läser som att uppgiften saknas, inte som
                     //    att revisorn faktiskt inte varit inne — och det är en skillnad
                     //    föreningen vill se.
                     + '<td class="muted">' + (a.lastSeenUtc ? esc(shortDate(a.lastSeenUtc)) : 'Aldrig') + '</td>'
                     + '<td class="n">' + (a.isActive || /Inbjuden/.test(a.status || '')
                        ? rowMenu([{ act: 'revoke', id: a.id, text: 'Avsluta åtkomsten…', danger: true }])
                        : '') + '</td></tr>';
            }).join('');

        onRowAction(el('revBody'), {
            revoke: function (id) {
                var a = rows.find(function (x) { return String(x.id) === String(id); });
                ask({
                    title: 'Avsluta ' + (a ? a.name : 'revisorns') + ' åtkomst',
                    text: 'Revisorn kommer inte längre åt räkenskaperna.',
                    label: 'Varför avslutas den?',
                    help: 'Texten sparas i föreningens historik.',
                    multiline: true, required: true,
                    ok: 'Avsluta åtkomsten', danger: true
                }).then(function (reason) {
                    if (reason === null) return;
                    postJson('/umbraco/surface/EkonomiAdmin/RevokeAuditor', {
                        ownerType: ownerType, ownerId: ownerId, grantId: parseInt(id, 10), reason: reason
                    }).then(function (j) {
                        if (!j.success) { tell('Åtkomsten avslutades inte', j.message); return; }
                        loadAuditors();
                    });
                });
            }
        });
    }

    if (el('revNew')) el('revNew').addEventListener('click', function () {
        el('revName').value = ''; el('revEmail').value = '';
        show(el('revErr'), false);
        openModal('revModal');
        setTimeout(function () { el('revName').focus(); }, 300);
    });

    if (el('revInvite')) el('revInvite').addEventListener('click', function () {
        var btn = this;
        show(el('revErr'), false);
        show(el('revOk'), false);
        show(el('revLink'), false);

        btn.disabled = true;

        postJson('/umbraco/surface/EkonomiAdmin/InviteAuditor', {
            ownerType: ownerType, ownerId: ownerId,
            name: el('revName').value, email: el('revEmail').value
        }).then(function (j) {
            btn.disabled = false;

            // ⚠️ Dialogen stängs INTE vid fel — felet står i den.
            if (!j.success) {
                el('revErr').textContent = j.message;
                show(el('revErr'), true);
                return;
            }

            closeModal('revModal');
            el('revOk').textContent = j.message;
            show(el('revOk'), true);

            // ⚠️⚠️ GICK MEJLET INTE FRAM MÅSTE LÄNKEN VISAS — den går aldrig att hämta igen,
            //    eftersom bara hashen sparas. Ett tyst "inbjudan skapad" hade lämnat föreningen
            //    med ett uppdrag ingen kan ta emot.
            if (!j.sent) {
                el('revLink').innerHTML = 'Mejlet gick inte fram. Ge den här länken till revisorn '
                    + 'på annat sätt — den visas bara en gång:<br><code>' + esc(j.url) + '</code>';
                show(el('revLink'), true);
            }

            el('revName').value = '';
            el('revEmail').value = '';
            loadAuditors();
        }).catch(function (e) {
            btn.disabled = false;
            el('revErr').textContent = e.message;
            show(el('revErr'), true);
        });
    });

    // ══ FORDRINGSEXPORTEN ════════════════════════════════════════════════════════════════
    async function loadReceivables() {
        var q = '';
        var f = el('fordrFrom') && el('fordrFrom').value;
        var t = el('fordrTo') && el('fordrTo').value;
        if (f) q += '&from=' + encodeURIComponent(f);
        if (t) q += '&to=' + encodeURIComponent(t);

        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetReceivables?issuerType=' + issuerType
                            + '&issuerId=' + issuerId + q, { cache: 'no-store' })
            .then(function (r) { return r.json(); });

        if (!d.success) return;

        show(el('fordrCard'), d.applicable === true);
        if (d.applicable !== true) return;

        // Faltens forval kommer fran servern - arbetsaret - sa kassoren slipper skriva dem.
        if (!el('fordrFrom').value) setDateField('fordrFrom', String(d.from).substring(0, 10));
        if (!el('fordrTo').value) setDateField('fordrTo', String(d.to).substring(0, 10));

        // ⚠️ Etiketten beskriver FÖRENINGENS VAL, inte den här periodens rader. Läst ur raderna
        //    sa den "Allt på ett fordringskonto" så fort perioden var tom — alltså motsatsen till
        //    vad klubben just ställt in.
        el('fordrMeta').textContent = d.splitConfigured
            ? 'Uppdelat per intäktsslag' : 'Allt på ett fordringskonto';

        // ⚠️ En roll utan konto SAGS. En fordran som inte kan exporteras gor filen ofullstandig,
        //    och att tyst utelamna den ar samma sak som att ljuga om totalen.
        show(el('fordrMissing'), (d.missingRoles || []).length > 0);
        if ((d.missingRoles || []).length > 0) {
            el('fordrMissing').textContent = 'Saknar konto och kommer inte med: '
                + d.missingRoles.join(', ') + '. Peka ut dem under Inställningar.';
        }

        el('fordrBody').innerHTML = (d.rows || []).length === 0
            ? '<tr><td colspan="4" class="muted">Inga avgifter uppstod under perioden.</td></tr>'
            : d.rows.map(function (r) {
                return '<tr><td>' + r.receivableAccount + ' <span class="muted">'
                     + esc(r.receivableName) + '</span></td>'
                     + '<td>' + esc(r.what) + ' <span class="muted">mot ' + r.revenueAccount
                     + ' ' + esc(r.revenueName) + '</span></td>'
                     + '<td class="n">' + r.count + '</td>'
                     + '<td class="n">' + kr(r.amount) + '</td></tr>';
            }).join('')
            + '<tr class="sum"><td></td><td><strong>Summa</strong></td><td></td>'
            + '<td class="n"><strong>' + kr(d.total) + '</strong></td></tr>';

        var from = String(d.from).substring(0, 10), to = String(d.to).substring(0, 10);

        el('fordrDownload').setAttribute('href',
            '/umbraco/surface/EkonomiAdmin/ExportReceivables?issuerType=' + issuerType
            + '&issuerId=' + issuerId + '&from=' + from + '&to=' + to);

        // ⚠️ Perioden utskriven intill knappen, och varningen med. Samma period importerad tva
        //    ganger dubbelbokfor intakten - den troligaste felhandlingen pa den har ytan.
        el('fordrWarn').textContent = from + ' till ' + to
            + ' — läs bara in samma period en gång.';
    }

    if (el('fordrApply')) el('fordrApply').addEventListener('click', loadReceivables);

    // ══ BOKSLUTET (P7) ═══════════════════════════════════════════════════════════════════
    var closeLoaded = false, closeYearId = 0, recvLoaded = false;

    function stepMark(state) {
        // ⚠️ ORD, inte bara farg (WCAG 1.4.1). Och "omatt" ar ett EGET lage - att visa det som
        //    klart vore falsk trygghet i precis den handling som inte tal sadan.
        if (state === 1) return badge('ok', 'Klart');
        if (state === 2) return badge('off', 'Kan inte mätas');
        return badge('wait', 'Kvar');
    }

    async function loadClosing(yearId) {
        var url = '/umbraco/surface/EkonomiAdmin/GetClosing?issuerType=' + issuerType
                + '&issuerId=' + issuerId + (yearId ? '&fiscalYearId=' + yearId : '');

        var d = await fetch(url, { cache: 'no-store' }).then(function (r) { return r.json(); });
        if (!d.success) return;

        show(el('closeNotApplicable'), d.applicable === false);
        show(el('closeNoYear'), d.applicable !== false && d.hasYear === false);
        show(el('closeWrap'), d.applicable !== false && d.hasYear === true);
        if (d.applicable === false || d.hasYear === false) { el('closeActions').innerHTML = ''; return; }

        closeYearId = d.checklist.fiscalYearId;

        // Arsvaljaren plus SIE-exporten.
        // ⚠️ Exporten hor HIT, inte under Installningar: den ar en del av arsavslutet, och det ar
        //    har kassoren star nar hen behover arkivfilen. En vanlig LANK, inte fetch - filen ska
        //    laddas ner av webblasaren.
        el('closeActions').innerHTML =
            '<select class="form-select" id="' + uid + '_closeYear" style="width:14rem">'
            + d.years.map(function (y) {
                return '<option value="' + y.id + '"' + (y.id === closeYearId ? ' selected' : '') + '>'
                     + y.year + '</option>';
            }).join('') + '</select>'
            + '<a class="btn btn-outline-secondary" id="' + uid + '_sieLink" href="'
            + '/umbraco/surface/EkonomiAdmin/ExportSie?issuerType=' + issuerType
            + '&issuerId=' + issuerId + '&fiscalYearId=' + closeYearId + '">Hämta SIE-fil</a>'
            + '<button type="button" class="btn btn-outline-secondary" id="' + uid + '_closePrint">'
            + '<i class="bi bi-printer me-1"></i>Skriv ut handlingarna</button>';

        var yr = (d.years || []).find(function (y) { return y.id === closeYearId; });
        el('printYear').textContent = 'Resultat- och balansräkning för räkenskapsåret ' + (yr ? yr.year : '')
            + (d.checklist.status === 'established' ? '' : ' — ej fastställd');
        el('closePrint').addEventListener('click', function () { window.print(); });

        var pick = el('closeYear');
        if (pick) pick.addEventListener('change', function () { loadClosing(pick.value); });

        renderSteps(d.checklist);
        renderStatements(d.statements);
        renderEstablish(d.checklist, d.statements);
    }

    function renderSteps(c) {
        var done = c.steps.filter(function (s) { return s.state === 1; }).length;
        el('closeMeta').textContent = done + ' av ' + c.steps.length + ' klara';

        el('closeSteps').innerHTML = c.steps.map(function (s, i) {
            var link = (s.goTo && s.state === 0)
                ? ' <button type="button" class="btn btn-sm btn-outline-secondary ms-1" data-goto-view="'
                  + esc(s.goTo) + '">Gå dit</button>' : '';

            return '<div><span class="num muted">' + (i + 1) + '</span>'
                 + '<span class="grow"><strong>' + esc(s.title) + '</strong>'
                 + (s.detail ? '<div class="muted">' + esc(s.detail) + link + '</div>' : '')
                 + '</span><span class="num">' + stepMark(s.state) + '</span></div>';
        }).join('');

        el('closeSteps').querySelectorAll('button[data-goto-view]').forEach(function (btn) {
            btn.addEventListener('click', function () { showView(btn.dataset.gotoView); });
        });
    }

    function stmtRows(rows, total, totalLabel) {
        var body = rows.map(function (r) {
            return '<tr><td class="muted" style="width:4rem">' + r.accountNumber + '</td>'
                 + '<td>' + esc(r.accountName) + '</td>'
                 + '<td class="n">' + kr(r.amount) + '</td></tr>';
        }).join('');

        return body + '<tr class="sum"><td></td><td>' + esc(totalLabel) + '</td>'
             + '<td class="n">' + kr(total) + '</td></tr>';
    }

    function renderStatements(s) {
        el('resPeriod').textContent = shortDate(s.from) + '–' + shortDate(s.to);
        el('balDate').textContent = 'per ' + shortDate(s.to);

        el('resBody').innerHTML =
              '<tr class="grp"><td colspan="3">Intäkter</td></tr>'
            + stmtRows(s.revenue, s.revenueTotal, 'Summa intäkter')
            + '<tr class="grp"><td colspan="3">Kostnader</td></tr>'
            + stmtRows(s.costs, s.costTotal, 'Summa kostnader')
            + '<tr class="sum"><td></td><td><strong>Årets resultat</strong></td>'
            + '<td class="n"><strong>' + kr(s.result) + '</strong></td></tr>';

        // ⚠️⚠️ ARETS RESULTAT STAR PA SKULDSIDAN. Det ar inte bokfort mot eget kapital forran
        //    aret stangs, sa utan raden ar differensen exakt arets resultat - varje ar, for varje
        //    forening - och det laeses som ett fel i bokforingen i stallet for i jamforelsen.
        var diff = s.balanceDifference === 0 ? '' :
              '<tr class="gap"><td></td><td><strong>Differens</strong></td>'
            + '<td class="n miss">' + kr(s.balanceDifference) + '</td></tr>';

        el('balBody').innerHTML =
              '<tr class="grp"><td colspan="3">Tillgångar</td></tr>'
            + stmtRows(s.assets, s.assetTotal, 'Summa tillgångar')
            + '<tr class="grp"><td colspan="3">Eget kapital och skulder</td></tr>'
            + stmtRows(s.equityAndLiabilities, s.equityAndLiabilityTotal, 'Summa')
            // ⚠️ Tidigare års resultat har aldrig bokförts mot eget kapital — det härleds. Utan
            //    raden går balansräkningen aldrig ihop från och med föreningens andra år.
            + (s.priorResult ? '<tr><td></td><td>Tidigare års resultat</td><td class="n">'
                + kr(s.priorResult) + '</td></tr>' : '')
            + '<tr><td></td><td>Årets resultat</td><td class="n">' + kr(s.result) + '</td></tr>'
            + '<tr class="sum"><td></td><td><strong>Summa eget kapital och skulder</strong></td>'
            + '<td class="n"><strong>' + kr(s.equityAndLiabilityTotal + (s.priorResult || 0) + s.result) + '</strong></td></tr>'
            + diff;
    }

    function renderEstablish(c, s) {
        var row = el('establishRow');

        if (c.status === 'established') {
            row.innerHTML = '<div class="ek-alert ek-ok" style="margin:0">'
                + 'Året är fastställt och tar inte emot bokföring.</div>';
            return;
        }

        if (!canWrite) { row.innerHTML = '<span class="muted">Endast kassören kan fastställa året.</span>'; return; }

        // ⚠️ Knappen ar AV tills balansrakningen gar ihop OCH stegen ar klara. Att fastalla ett
        //    ar som inte balanserar laser in felet - servern vagrar ocksa, men en knapp som gar
        //    att trycka och alltid nekas ar samre an en som sager varfor.
        var blocked = !s.balances || !c.readyToEstablish;

        row.innerHTML =
              '<button type="button" class="btn btn-primary" id="' + uid + '_establishBtn"'
            + (blocked ? ' disabled' : '') + '>Fastställ ' + c.year + '</button>'
            + (blocked ? '<span class="muted">'
                 + (!s.balances ? 'Balansräkningen går inte ihop.'
                                : 'Det finns steg kvar i listan ovan.') + '</span>' : '');

        var btn = el('establishBtn');
        if (btn) btn.addEventListener('click', establishYear);
    }

    async function establishYear() {
        var go = await ask({
            title: 'Fastställ året',
            text: 'Efter det tar året inte emot bokföring. Ett fel som hittas senare rättas som en '
                + 'ny verifikation i ett öppet år. Det här går inte att ångra.',
            ok: 'Fastställ året', danger: true
        });
        if (go === null) return;

        try {
            var d = await postJson('/umbraco/surface/EkonomiAdmin/SetFiscalYearStatus', {
                issuerType: issuerType, issuerId: issuerId,
                fiscalYearId: closeYearId, status: 'established'
            });
            if (!d.success) throw new Error(d.message || 'Året gick inte att fastställa.');

            show(el('closeError'), false);
            el('closeOk').textContent = 'Året är fastställt.';
            show(el('closeOk'), true);
            await loadClosing(closeYearId);
        } catch (e) {
            show(el('closeOk'), false);
            el('closeError').textContent = e.message;
            show(el('closeError'), true);
        }
    }

    // ══ BANKAVSTAMNINGEN (P11) ═══════════════════════════════════════════════════════════
    //
    // ⚠️⚠️ F6 STYR FORMEN: det avvikande overst, det matchade hopfallt. Vardet ligger inte i att
    //    visa allt lika tydligt utan i att gora det som INTE stammer hittbart.
    var bankMap = null, bankImports = [], recCurrent = 0, bankLoaded = false;

    function bankFields() {
        // ⚠️ Rubrikerna kommer ur FILEN, aldrig ur en lista i koden - bankerna doper kolumnerna
        //    olika och operatoren maste kanna igen sin egen fil.
        var head = bankMap.header || [];
        var opts = function (sel) {
            return '<option value="-1">— saknas —</option>' + head.map(function (h, i) {
                return '<option value="' + i + '"' + (sel === i ? ' selected' : '') + '>'
                     + esc(h || ('Kolumn ' + (i + 1))) + '</option>';
            }).join('');
        };

        var row = function (key, label, sel) {
            return '<label>' + label + '<select class="form-select" data-map="' + key + '">'
                 + opts(sel) + '</select></label>';
        };

        el('bankMapFields').innerHTML =
              row('date', 'Datum', bankMap.mapping.date)
            + row('text', 'Text', bankMap.mapping.text)
            + row('amount', 'Belopp (eller insättning)', bankMap.mapping.amount)
            + row('amountOut', 'Uttag (om banken delar)', bankMap.mapping.amountOut)
            + row('balance', 'Saldo', bankMap.mapping.balance);

        el('bankMapFields').querySelectorAll('select[data-map]').forEach(function (sl) {
            sl.addEventListener('change', function () {
                bankMap.mapping[sl.dataset.map] = parseInt(sl.value, 10);
                syncImportButton();
            });
        });

        el('bankSampleHead').innerHTML = head.map(function (h) {
            return '<th>' + esc(h || '') + '</th>';
        }).join('');

        el('bankSampleBody').innerHTML = (bankMap.sample || []).map(function (r) {
            return '<tr>' + head.map(function (_, i) {
                return '<td>' + esc(r[i] || '') + '</td>';
            }).join('') + '</tr>';
        }).join('');
    }

    function syncImportButton() {
        var m = bankMap && bankMap.mapping;
        // ⚠️ Utan datum OCH ett belopp gar filen inte att lasa alls. En knapp som gar att trycka
        //    men alltid misslyckas ar samre an en som sager varfor den ar av.
        var usable = !!m && m.date >= 0 && (m.amount >= 0 || m.amountOut >= 0);
        show(el('bankImport'), usable);
    }

    async function bankPreview(file) {
        show(el('bankError'), false);
        show(el('bankOk'), false);

        var fd = new FormData();
        fd.append('issuerType', issuerType);
        fd.append('issuerId', issuerId);
        fd.append('file', file);

        try {
            var d = await postForm('/umbraco/surface/EkonomiAdmin/PreviewBankFile', fd);
            if (!d.success) throw new Error(d.message || 'Filen gick inte att läsa.');

            bankMap = d;
            show(el('bankMapBox'), true);
            bankFields();
            syncImportButton();

            if (!d.usable) {
                // ⚠️ Utan rubrikrad finns inga kolumner att välja bland - då vore "peka ut dem
                //    själv" ett löfte ytan inte kan hålla (felrapport 2026-09-24).
                el('bankError').textContent = (d.header || []).length === 0
                    ? 'Vi kunde inte dela upp filen i kolumner. Kontrollera att det är en CSV-fil '
                      + 'från internetbanken, eller skicka in en felrapport så lägger vi till er banks format.'
                    : 'Vi hittade ingen datum- eller beloppskolumn. Peka ut dem själv nedan.';
                show(el('bankError'), true);
            }
        } catch (e) {
            el('bankError').textContent = e.message;
            show(el('bankError'), true);
        }
    }

    async function bankImportFile() {
        var f = el('bankFile').files[0];
        if (!f || !bankMap) return;

        var fd = new FormData();
        fd.append('issuerType', issuerType);
        fd.append('issuerId', issuerId);
        fd.append('accountNumber', el('bankAccount').value);
        fd.append('file', f);
        fd.append('date', bankMap.mapping.date);
        fd.append('text', bankMap.mapping.text);
        fd.append('amount', bankMap.mapping.amount);
        fd.append('amountOut', bankMap.mapping.amountOut);
        fd.append('balance', bankMap.mapping.balance);
        fd.append('delimiter', bankMap.delimiter);
        fd.append('headerRow', bankMap.mapping.headerRow);

        try {
            var d = await postForm('/umbraco/surface/EkonomiAdmin/ImportBankFile', fd);
            if (!d.success) {
                var msg = d.message || 'Filen gick inte att läsa in.';
                if (d.skipped && d.skipped.length) msg += ' ' + d.skipped.join(' ');
                throw new Error(msg);
            }

            // ⚠️ Overhoppade rader SAGS aven nar importen lyckades - en bortfallen rad ar en
            //    differens operatoren annars far leta efter i kontoutdraget for hand.
            var note = d.rows + ' rader inlästa.';
            if (d.skipped && d.skipped.length)
                note += ' ' + d.skipped.length + ' rad(er) kunde inte läsas: ' + d.skipped.join(' ');

            el('bankOk').textContent = note;
            show(el('bankOk'), true);
            show(el('bankMapBox'), false);
            show(el('bankImport'), false);
            el('bankFile').value = '';
            bankMap = null;

            await loadBank(d.importId);
        } catch (e) {
            el('bankError').textContent = e.message;
            show(el('bankError'), true);
        }
    }

    async function loadBank(selectId) {
        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetBankImports?issuerType=' + issuerType
                            + '&issuerId=' + issuerId, { cache: 'no-store' }).then(function (r) { return r.json(); });
        if (!d.success) return;

        bankImports = d.imports || [];

        el('bankAccount').innerHTML = (d.accounts || []).map(function (a) {
            return '<option value="' + a.number + '">' + a.number + ' · ' + esc(a.name) + '</option>';
        }).join('');

        show(el('bankEmpty'), bankImports.length === 0);

        // Vaxlaren mellan inlasta utdrag. En rad racker; det ar inget register.
        el('recActions').innerHTML = bankImports.length === 0 ? '' :
            '<select class="form-select" id="' + uid + '_recPick" style="width:22rem">'
            + bankImports.map(function (i) {
                return '<option value="' + i.id + '">' + i.accountNumber + ' · '
                     + esc(shortDate(i.periodFrom)) + '–' + esc(shortDate(i.periodTo))
                     + ' (' + i.rowCount + ' rader)</option>';
            }).join('') + '</select>';

        var pick = el('recPick');
        if (pick) {
            pick.value = String(selectId || bankImports[0].id);
            pick.addEventListener('change', function () { loadReconciliation(pick.value); });
            await loadReconciliation(pick.value);
        } else {
            show(el('recWrap'), false);
        }
    }

    async function loadReconciliation(importId) {
        recCurrent = parseInt(importId, 10);

        var d = await fetch('/umbraco/surface/EkonomiAdmin/GetReconciliation?issuerType=' + issuerType
                            + '&issuerId=' + issuerId + '&importId=' + recCurrent,
                            { cache: 'no-store' }).then(function (r) { return r.json(); });

        if (!d.success) { show(el('recWrap'), false); return; }
        renderReconciliation(d.reconciliation);
    }

    function renderReconciliation(r) {
        show(el('recWrap'), true);

        // ⚠️⚠️ "Allt stammer" kraver BADA halvorna: noll omatchade OCH noll differens. Var for
        //    sig racker ingen - alla rader kan vara hopparade medan saldot anda skiljer sig, och
        //    saldot kan rakna stamma medan tva fel tar ut varandra.
        var box = el('recVerdict');
        box.classList.toggle('ek-warn', !r.balances);

        if (r.balances) {
            el('recVerdictLead').textContent = 'Kontot stämmer';
            el('recVerdictAmount').textContent = kr(r.bankClosingBalance);
            el('recVerdictNote').textContent =
                'Alla ' + r.rowCount + ' rader är hopparade och saldot går ihop med bokföringen.';
        } else if (r.allRowsMatchedButNoBalance) {
            // ⚠️ Filen bar inget saldo. Da SAGS det - ett pastaende om att kontot stammer vore
            //    baserat pa halva beviset.
            el('recVerdictLead').textContent = 'Alla rader är hopparade';
            el('recVerdictAmount').textContent = r.rowCount + ' rader';
            el('recVerdictNote').textContent =
                'Filen bar inget saldo, så vi kan inte bevisa att kontot stämmer — bara att '
                + 'varje rad i utdraget har en motpart.';
        } else {
            el('recVerdictLead').textContent = 'Det här är kvar';
            el('recVerdictAmount').textContent = r.difference == null
                ? (r.bankOnly.length + r.ledgerOnly.length) + ' rader'
                : kr(r.difference);
            el('recVerdictNote').textContent = r.difference == null
                ? 'Filen bar inget saldo, så differensen går inte att räkna fram.'
                : 'Bankens saldo ' + kr(r.bankClosingBalance)
                  + ' mot bokföringens ' + kr(r.ledgerBalance) + '.';
        }

        // ── Bankrader utan motpart ──────────────────────────────────────────────────────
        show(el('recBankOnlyCard'), r.bankOnly.length > 0);
        el('recBankOnlyMeta').textContent = r.bankOnly.length + ' rader';
        el('recBankOnly').innerHTML = r.bankOnly.map(function (b) {
            return '<tr><td class="date">' + esc(shortDate(b.bookedDate)) + '</td>'
                 + '<td>' + esc(b.text) + '</td>'
                 + '<td class="n">' + kr(b.amount) + '</td>'
                 + '<td class="n">' + (canWrite
                     ? // En kapad etikett laeses som en trasig kontroll. Bredden racker for hela texten.
                     '<select class="form-select form-select-sm" style="min-width:15rem"'
                       + ' data-match-row="' + b.id + '">'
                       + '<option value="0">— välj bokföringsrad —</option>'
                       + r.ledgerOnly.map(function (l) {
                             return '<option value="' + l.lineId + '">' + esc(l.entryNumber)
                                  + ' · ' + kr(l.movement) + '</option>';
                         }).join('') + '</select>'
                     : '') + '</td></tr>';
        }).join('');

        el('recBankOnly').querySelectorAll('select[data-match-row]').forEach(function (sl) {
            sl.addEventListener('change', function () {
                setBankMatch(parseInt(sl.dataset.matchRow, 10), parseInt(sl.value, 10));
            });
        });

        // ── Bokforingsrader utan motpart ────────────────────────────────────────────────
        show(el('recLedgerOnlyCard'), r.ledgerOnly.length > 0);
        el('recLedgerOnlyMeta').textContent = r.ledgerOnly.length + ' rader';
        el('recLedgerOnly').innerHTML = r.ledgerOnly.map(function (l) {
            return '<tr><td class="date">' + esc(shortDate(l.accountingDate)) + '</td>'
                 + '<td>' + esc(l.entryNumber) + '</td>'
                 + '<td>' + esc(l.description) + '</td>'
                 + '<td class="n">' + kr(l.movement) + '</td></tr>';
        }).join('');

        // ── Hopparat ────────────────────────────────────────────────────────────────────
        el('recMatchedMeta').textContent = r.matched.length + ' rader';
        el('recMatched').innerHTML = r.matched.map(function (m) {
            // ⚠️ "Automatiskt" star utskrivet. En automatisk traff ar en gissning operatoren kan
            //    angra; en manuell ar ett beslut. Utan skillnaden gar det inte att se vad en
            //    manniska faktiskt granskat.
            var kind = m.kind === 'auto'
                ? '<span class="muted">automatiskt</span>' : '<span class="muted">manuellt</span>';

            return '<tr><td class="date">' + esc(shortDate(m.bank.bookedDate)) + '</td>'
                 + '<td>' + esc(m.bank.text) + '</td>'
                 + '<td>' + esc(m.ledger.entryNumber) + '</td>'
                 + '<td class="n">' + kr(m.bank.amount) + '</td>'
                 + '<td class="n">' + kind + (canWrite
                     ? ' <button type="button" class="btn btn-sm btn-outline-secondary"'
                       + ' data-unmatch="' + m.bank.id + '">Ångra</button>' : '')
                 + '</td></tr>';
        }).join('');

        el('recMatched').querySelectorAll('button[data-unmatch]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                setBankMatch(parseInt(btn.dataset.unmatch, 10), 0);
            });
        });
    }

    async function setBankMatch(rowId, lineId) {
        try {
            var d = await postJson('/umbraco/surface/EkonomiAdmin/SetBankMatch', {
                issuerType: issuerType, issuerId: issuerId, rowId: rowId, lineId: lineId
            });
            if (!d.success) throw new Error(d.message || 'Matchningen gick inte att spara.');
            show(el('bankError'), false);
            await loadReconciliation(recCurrent);
        } catch (e) {
            el('bankError').textContent = e.message;
            show(el('bankError'), true);
        }
    }

    if (canWrite && el('bankFile')) {
        el('bankFile').addEventListener('change', function () {
            var f = el('bankFile').files[0];
            if (f) bankPreview(f);
        });
        el('bankImport').addEventListener('click', bankImportFile);
    }

    // ══ AVPRICKNINGSLISTAN ═══════════════════════════════════════════════════════════════
    //
    // ⚠️⚠️ TRE TILLSTAND, ALDRIG EN BOOLEAN. "Vantar" och "sager sig ha betalat" ar tva skilda
    //    arbetsuppgifter: den ena ska paminnas, den andra stammas av mot kontoutdraget. Slas de
    //    ihop ar listan inte langre en kontroll. Samma regel som ClubEvent/GetPayments foljer -
    //    de tva ytorna far inte saga olika saker om samma betalning.
    var drillKey = '';

    function drillState(p) {
        if (p.confirmedDate) return ['ok', 'Betalt'];
        if (p.claimedDate) return ['info', 'Säger sig ha betalat'];
        return ['wait', 'Väntar'];
    }

    function openDrill(sourceType, sourceId, name, tr) {
        var key = sourceType + ':' + sourceId;

        // Andra klicket pa samma rad stanger. En lista som bara gar att oppna tvingar fram
        // "Stang listan" for nagot man just pekade pa.
        if (drillKey === key) { closeDrill(); return; }

        drillKey = key;
        markOpenRow(tr);
        el('drillName').textContent = name || 'Avprickning';
        show(el('perDrill'), true);
        show(el('drillError'), false);
        el('drillBody').innerHTML = '<tr><td colspan="4" class="muted">Hämtar…</td></tr>';
        el('drillMore').innerHTML = '';

        fetch('/umbraco/surface/EkonomiAdmin/GetSourcePayments?issuerType=' + issuerType
              + '&issuerId=' + issuerId + '&sourceType=' + encodeURIComponent(sourceType)
              + '&sourceId=' + sourceId, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (drillKey !== key) return;   // Hann klicka vidare - kasta det gamla svaret.
                if (!d.success) throw new Error(d.message || 'Listan gick inte att läsa.');
                renderDrill(d);
            })
            .catch(function (e) {
                if (drillKey !== key) return;
                el('drillBody').innerHTML = '';
                el('drillError').textContent = e.message;
                show(el('drillError'), true);
            });
    }

    // Markeringen skots direkt i DOM:en. Att rita om panelen for att tanda eller slacka en klass
    // hade kostat en ny GetOverview, och den bygger hela oversikten.
    function markOpenRow(tr) {
        var open = el('perBody').querySelector('tr.ek-open');
        if (open) open.classList.remove('ek-open');
        if (tr) tr.classList.add('ek-open');
    }

    function closeDrill() {
        drillKey = '';
        show(el('perDrill'), false);
        markOpenRow(null);
    }

    function renderDrill(d) {
        // ⚠️ De obetalda overst. Listan ar en arbetslista, inte ett register - samma ordning som
        //    panelen ovanfor sorterar tavlingarna i.
        var rows = (d.payments || []).slice().sort(function (a, b) {
            var aw = a.confirmedDate ? 1 : 0, bw = b.confirmedDate ? 1 : 0;
            if (aw !== bw) return aw - bw;
            return (a.payerName || '').localeCompare(b.payerName || '', 'sv');
        });

        capList(el('drillBody'), el('drillMore'), rows, 12, function (p) {
            var st = drillState(p);
            var kvitto = p.receiptId
                ? '<a class="kvitto" href="/betalkvitto/' + p.receiptId
                  + '" target="_blank" rel="noopener">Kvitto</a>'
                : '<span class="muted">—</span>';

            // ⚠️ Pa en betald rad visas det BEKRAFTADE beloppet nar det finns. Visas det begarda
            //    ser en delbetalning ut som en helbetalning.
            var amount = (p.confirmedDate && p.actualAmount != null) ? p.actualAmount : p.amount;

            return '<tr><td>' + esc(p.payerName || '—') + '</td>'
                 + '<td>' + badge(st[0], st[1]) + '</td>'
                 + '<td class="n">' + kr(amount) + '</td>'
                 + '<td class="n">' + kvitto + '</td></tr>';
        }, 'Visa alla {n} betalare');

        if (rows.length === 0) {
            el('drillBody').innerHTML =
                '<tr><td colspan="4" class="muted">Inga avgifter på den här raden.</td></tr>';
        }
    }

    function renderQueue(rows, total) {
        var badge = el('queueBadge');
        show(el('queueEmpty'), rows.length === 0);
        show(el('queueWrap'), rows.length > 0);
        show(badge, rows.length > 0);
        todo.unposted = rows.length;
        renderTodo();

        if (rows.length === 0) { el('queueBody').innerHTML = ''; return; }
        badge.textContent = rows.length + ' st · ' + kr(total);

        capList(el('queueBody'), el('queueMore'), rows, 8, function (r) {
            return '<tr data-payment-id="' + r.id + '">'
                 + '<td class="date">' + esc(shortDate(r.confirmedDate)) + '</td>'
                 + '<td>' + esc(r.payerName) + ' <span class="muted">· ' + esc(r.description) + '</span></td>'
                 + '<td class="n">' + kr(r.amount) + '</td>'
                 + '<td class="n">' + (canWrite
                        ? '<button type="button" class="btn btn-sm btn-outline-secondary" data-post="' + r.id + '">Bokför</button>'
                        : '') + '</td>'
                 + '</tr>';
        }, 'Visa alla {n} betalningar att bokföra');
    }

    function render(status, keepSetupOpen) {
        show(el('loading'), false);
        show(el('shell'), true);

        var setUp = status.isSetUp && status.shape;
        el('shapeBadge').textContent = status.shape === 'full' ? 'Hel bokföring'
            : status.shape === 'export' ? 'Avgifter och export'
            : status.shape === 'fees' ? 'Avgifter och kontroll' : '';
        show(el('shapeWrap'), !!setUp);
        show(el('yearBadge'), !!setUp);
        show(el('setupStart'), !setUp);
        show(el('setupPending'), !setUp);

        if (!setUp) {
            el('setupTitle').textContent = 'Kom igång med ekonomin';
            show(el('setupSummary'), false);
            showView('installningar');
            return;
        }

        el('setupTitle').textContent = 'Inställningar och räkenskapsår';
        el('setupIntro').textContent = 'Lägg upp ett nytt räkenskapsår, eller ändra föreningsformen.';
        show(el('setupSummary'), true);

        // ⚠️ EN sparad form, TVÅ frågor på ytan. Formen "full" är steg 1; "export" och "fees"
        //    är steg 1 = behåll + ett svar på steg 2.
        applyShape(status.shape);

        // Kön bara för en förening som bokför här — för de andra saknar varje rad verifikation
        // per definition, och listan hade påstått att allt är ogjort.
        show(el('fullOnly'), status.shape === 'full');
        if (status.shape === 'full') { loadQueue(); loadBokfor(); }
        else { todo.unposted = 0; renderTodo(); }

        // ⚠️ Medlemsavgifterna läses OAVSETT föreningsform. En klubb som bokför i eget program
        // behöver fortfarande veta vilka avgifter som inte kommit in — det är hela nyttan vi
        // tillför den. Bara "att bokföra"-halvan är beroende av att vi för böckerna.
        loadFees();

        var years = status.fiscalYears || [];
        var labels = { open: 'öppet', closing: 'bokslut pågår', established: 'fastställt' };
        el('yearSummary').innerHTML = years.length === 0 ? 'Inget år upplagt'
            : years.slice(0, 3).map(function (y) {
                return '<div>' + y.year + ' <span class="muted">' + (labels[y.status] || y.status) + '</span></div>';
            }).join('');
        el('accountSummary').textContent = status.accountCount + ' konton';

        // ⚠️ "Alla 12 mappade" sa ingenting till den som inte kan bokföring. Nu står antalet
        //    bara som en lugn bricka, och tabellen under säger vad kopplingarna ÄR.
        var missing = status.missingRoles || [];
        el('roleSummary').textContent = missing.length === 0
            ? 'Allt har ett konto'
            : missing.length + ' saknar konto';
        el('roleSummary').style.color = missing.length === 0 ? '' : '#b02a37';

        if (canWrite) loadChart();

        show(el('obCard'), status.shape === 'full');
        // SIE-importen hör till den förening som bokför här — de andra har kvar sitt program.
        if (el('sieCard')) show(el('sieCard'), status.shape === 'full');
        if (status.shape === 'full') loadOpeningBalances();
        else { todo.noOpening = false; renderTodo(); }

        // ⚠️⚠️ ÅRSFÄLTET MÅSTE FÖLJA ARBETSÅRET. Det stod på dagens år oavsett vad föreningen
        //    lagt upp — så en förening som arbetar i 2025 och trycker "Spara uppsättningen" för
        //    att ändra NÅGOT ANNAT (formen, momsen) fick tyst ett räkenskapsår 2026 på köpet.
        //    Uppsättningen skapar året som står i fältet.
        if (status.workingYear) el('year').value = status.workingYear;

        // ── Vilket år bokför vi i? ────────────────────────────────────────────────────────
        // ⚠️ Förifyllningen får ALDRIG vara tyst. Ligger i dag inuti året står det ingenting
        //    extra; ligger det utanför skrivs året ut, och datumet flyttas in i det.
        var note = el('bYearNote');
        if (status.workingYear) {
            var iso = function (d) { return String(d).slice(0, 10); };
            var today = new Date().toISOString().slice(0, 10);
            var from = iso(status.workingYearStart), to = iso(status.workingYearEnd);
            var inside = today >= from && today <= to;

            setDateField('bDate', inside ? today : (today > to ? to : from));
            note.textContent = inside
                ? 'Bokförs i räkenskapsåret ' + status.workingYear + '.'
                : 'Bokförs i räkenskapsåret ' + status.workingYear + ' (' + from + ' – ' + to + '). '
                  + 'I dag ligger utanför året.';
        } else {
            note.textContent = '';
        }

        var blocked = el('blocked');
        // ⚠️⚠️ TRE LÄGEN, inte två. En SPÄRR ("året är fastställt") och en UPPLYSNING ("i dag
        //    ligger utanför året") är olika saker — att visa den andra som den första var precis
        //    felet: ytan sa "lägg upp året" om ett år som fanns och gick att bokföra i.
        if (status.blockedReason) { blocked.className = 'ek-alert ek-warn'; blocked.textContent = status.blockedReason; }
        else if (status.postingDateNote) { blocked.className = 'ek-alert'; blocked.textContent = 'Klart att bokföra. ' + status.postingDateNote; }
        else if (status.shape === 'full') { blocked.className = 'ek-alert ek-ok'; blocked.textContent = 'Klart att bokföra.'; }
        else { blocked.className = 'ek-alert d-none'; }

        if (keepSetupOpen === true) showView('installningar');
        loadOverview();
    }

    // ══ Bokför ═══════════════════════════════════════════════════════════════════════════
    var bokforCtx = null;
    var weReceived = false;

    // Förslagen i skissen. ⚠️ De fyller bara TEXTEN — kontot väljer kassören, för vilka konton
    // som finns är föreningens sak, inte vår.
    var CHIPS = ['Ammunition', 'El och vatten', 'Underhåll bana', 'Kiosk', 'Resa', 'Fika och möten'];

    function fillSelect(sel, options, preferred) {
        sel.innerHTML = options.map(function (a) {
            return '<option value="' + a.number + '">' + a.number + ' · ' + esc(a.name) + '</option>';
        }).join('');
        if (preferred) {
            var hit = options.find(function (a) { return a.number === preferred; });
            if (hit) sel.value = String(preferred);
        }
    }

    function renderBokforContext(c) {
        bokforCtx = c;

        // Kostnads- och intäktskonton i den stora listan; balanskonton hör till pengarnas väg.
        var resultAccounts = (c.accounts || []).filter(function (a) { return !a.isBalance; });
        fillSelect(el('bAccount'), resultAccounts.length ? resultAccounts : (c.accounts || []));

        var pay = (c.paymentAccounts || []);
        fillSelect(el('bPayAccount'), pay.length ? pay : (c.accounts || []).filter(function (a) { return a.isBalance; }));

        // Förvalet sätts EFTER att listan fyllts, annars finns inget att välja bland.
        pickAccountForDirection();

        // ⚠️ Valet står KVAR efter en bokföring. En kassör som bokför fem kvitton till samma
        //    tävling ska inte behöva välja om projektet fem gånger — och valet syns i fältet.
        var projSel = el('bProject');
        var keep = projSel.value;
        projSel.innerHTML = '<option value="0">(inget projekt)</option>'
            + (c.projects || []).map(function (p) {
                return '<option value="' + p.id + '">' + esc(p.name) + '</option>';
            }).join('');
        if (keep && projSel.querySelector('option[value="' + keep + '"]')) projSel.value = keep;

        el('bSeries').textContent = c.seriesLabel || '';

        var recent = c.recent || [];
        show(el('bRecentEmpty'), recent.length === 0);
        el('bRecent').innerHTML = recent.map(function (r) {
            return '<div><span class="num muted">' + esc(r.number) + '</span>'
                 + '<span class="grow">' + esc(r.description) + '</span>'
                 + '<span class="num">' + kr(r.amount) + '</span></div>';
        }).join('');

        renderPreview();
    }

    // ⚠️⚠️ SPEGLAR LedgerManualPostingService.BuildLines. Två beskrivningar av samma kontering
    //    kan glida isär, och då godkänner kassören en rad och en annan bokförs. Ändras den ena
    //    MÅSTE den andra ändras — sviten LedgerManualPostingTests pinnar serverns sida.
    function renderPreview() {
        var amount = parseFloat(el('bAmount').value || '0') || 0;
        var accNum = parseInt(el('bAccount').value, 10);
        var payNum = parseInt(el('bPayAccount').value, 10);
        var all = (bokforCtx && bokforCtx.accounts) || [];
        var nameOf = function (n) {
            var a = all.find(function (x) { return x.number === n; });
            return a ? a.name : '';
        };

        if (!amount || !accNum || !payNum) {
            el('bPreview').innerHTML = '<tr><td colspan="4" class="muted">'
                + 'Fyll i belopp och konto så visas konteringen här.</td></tr>';
            return;
        }

        var rows = weReceived
            ? [[payNum, amount, null], [accNum, null, amount]]
            : [[accNum, amount, null], [payNum, null, amount]];

        el('bPreview').innerHTML = rows.map(function (r) {
            return '<tr><td>' + r[0] + '</td><td>' + esc(nameOf(r[0])) + '</td>'
                 + '<td class="n">' + (r[1] ? kr(r[1]) : '—') + '</td>'
                 + '<td class="n">' + (r[2] ? kr(r[2]) : '—') + '</td></tr>';
        }).join('');
    }

    // ⚠️⚠️ FÖRVALET MÅSTE FÖLJA RIKTNINGEN. Första versionen valde alltid det lägsta kontot i
    //    listan — 3010 Medlemsavgifter — även när riktningen var "Vi betalade". Konteringen såg
    //    då fullt trovärdig ut: en INTÄKT i debet, med rätt belopp och rätt motkonto. Den
    //    balanserar, liggaren tar emot den, och felet syns först i resultatrapporten.
    //    Ett förval som är fel åt fel håll är värre än inget förval.
    function pickAccountForDirection() {
        var sel = el('bAccount');
        var cur = parseInt(sel.value, 10);
        var wantRevenue = weReceived;

        var isRevenue = function (n) { return n >= 3000 && n < 4000; };
        if (cur && isRevenue(cur) === wantRevenue) return;   // redan på rätt sida

        var options = Array.prototype.map.call(sel.options, function (o) { return parseInt(o.value, 10); });
        var hit = options.find(function (n) { return isRevenue(n) === wantRevenue; });
        if (hit) sel.value = String(hit);
    }

    function setDirection(received) {
        weReceived = received;
        el('bPaid').classList.toggle('active', !received);
        el('bGot').classList.toggle('active', received);
        el('bPaid').setAttribute('aria-pressed', String(!received));
        el('bGot').setAttribute('aria-pressed', String(received));
        pickAccountForDirection();
        renderPreview();
    }

    el('bPaid').addEventListener('click', function () { setDirection(false); });
    el('bGot').addEventListener('click', function () { setDirection(true); });
    ['bAmount', 'bAccount', 'bPayAccount'].forEach(function (f) {
        el(f).addEventListener('input', renderPreview);
        el(f).addEventListener('change', renderPreview);
    });

    el('bChips').innerHTML = CHIPS.map(function (c) {
        return '<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill ek-chip">' + esc(c) + '</button>';
    }).join('');
    el('bChips').addEventListener('click', function (ev) {
        var b = ev.target.closest('.ek-chip');
        if (b) { el('bText').value = b.textContent; el('bText').focus(); }
    });

    // ⚠️ Sätts om i render() så fort statusen är läst — då vet vi vilket räkenskapsår
    //    föreningen arbetar i. Det här är bara ett värde att stå med innan dess.
    setDateField('bDate', new Date().toISOString().slice(0, 10));

    // ── Under test-rutan ────────────────────────────────────────────────────────────────────
    // ⚠️ "Skapa en sandlåda" i rutan går SAMMA väg som knappen i menyn (bekräftelse, fel, omladdning)
    //    — två vägar att skapa en sandlåda hade kunnat säga olika saker om vad en sandlåda är.
    (function () {
        var beta = el('beta'), key = 'hpsk_ek_beta_closed';
        if (!beta) return;
        try { if (localStorage.getItem(key) === '1') beta.removeAttribute('open'); } catch (e) { }
        beta.addEventListener('toggle', function () {
            try { localStorage.setItem(key, beta.open ? '0' : '1'); } catch (e) { }
        });
        // "Kom igång" i Översiktens rubrikrad öppnar Inställningar — samma väg som menyvalet.
        var start = el('setupStart');
        if (start && el('toggleSetup')) start.addEventListener('click', function () { el('toggleSetup').click(); });
        var create = el('betaCreate');
        if (create && el('newSandbox')) create.addEventListener('click', function () { el('newSandbox').click(); });
    })();

    // ── Ny sandlåda ───────────────────────────────────────────────────────────────────────
    if (canWrite) el('newSandbox').addEventListener('click', function () {
        var btn = this, err = el('sandboxError');
        err.classList.add('d-none');

        // ⚠️ En fråga och inte en tyst skapelse: att byta liggare ska kräva ett medvetet
        // ögonblick. Ett namn gör dessutom att kassören kan skilja två försök åt i efterhand.
        ask({
            title: 'Skapa en sandlåda',
            text: 'En sandlåda är en övningsbokföring. Inget i den blir riktig bokföring, och en '
                + 'eventuell tidigare sandlåda lämnas kvar — ingenting raderas.',
            label: 'Vad ska den heta?',
            help: 'Till exempel "Test 1" eller "Provade bokslutet".',
            ok: 'Skapa sandlådan'
        }).then(function (label) {
        if (label === null) return;

        btn.disabled = true;
        postJson('/umbraco/surface/EkonomiAdmin/CreateSandbox', {
            ownerType: parseInt(root.dataset.issuerType, 10),
            ownerId: parseInt(root.dataset.ownerId, 10),
            label: label
        })
            .then(function (d) {
                btn.disabled = false;
                if (!d.success) {
                    err.textContent = d.message || 'Sandlådan gick inte att skapa.';
                    err.classList.remove('d-none');
                    return;
                }
                // Hela sidan laddas om i den nya sandlådan — utställaren bor i URL:en.
                window.location = d.url;
            })
            .catch(function (e) {
                btn.disabled = false;
                err.textContent = e.message; err.classList.remove('d-none');
            });
        });
    });

    el('bSave').addEventListener('click', function () {
        var btn = this, err = el('bError'), okBox = el('bOk');
        err.classList.add('d-none'); okBox.classList.add('d-none');
        btn.disabled = true;

        postJson('/umbraco/surface/EkonomiAdmin/PostManual', {
            issuerType: issuerType, issuerId: issuerId,
            amount: parseFloat(el('bAmount').value || '0') || 0,
            weReceived: weReceived,
            date: el('bDate').value || null,
            description: el('bText').value,
            accountNumber: parseInt(el('bAccount').value, 10) || 0,
            paymentAccountNumber: parseInt(el('bPayAccount').value, 10) || 0,
            // ⚠️ 0 = "(inget projekt)" → null. Ett sandlådeprojekt har NEGATIVT id och är giltigt.
            projectId: parseInt(el('bProject').value, 10) || null
        })
            .then(function (d) {
                btn.disabled = false;
                if (!d.success) {
                    err.textContent = d.message || 'Posten gick inte att bokföra.';
                    err.classList.remove('d-none');
                    return;
                }
                okBox.textContent = 'Bokfört som ' + (d.number || ('#' + d.entryId)) + '.';
                okBox.classList.remove('d-none');

                // ⚠️ Ett misslyckat kvitto får inte se ut som en misslyckad bokföring — posten ÄR
                //    bokförd, och ett felmeddelande som antyder motsatsen får kassören att bokföra
                //    den en gång till.
                var file = el('bReceipt').files && el('bReceipt').files[0];
                if (file && d.entryId) {
                    var fd = new FormData();
                    fd.append('issuerType', issuerType);
                    fd.append('issuerId', issuerId);
                    fd.append('entryId', d.entryId);
                    fd.append('file', file);
                    postForm('/umbraco/surface/EkonomiAdmin/UploadAttachment', fd).then(function (u) {
                        if (u.success) okBox.textContent = 'Bokfört som ' + (d.number || ('#' + d.entryId)) + ', med kvittot.';
                        else {
                            err.textContent = 'Posten är bokförd, men kvittot kunde inte fästas: ' + u.message
                                + ' Fäst det under Verifikationer.';
                            err.classList.remove('d-none');
                        }
                    });
                }

                el('bAmount').value = '';
                el('bText').value = '';
                el('bReceipt').value = '';
                if (d.context) renderBokforContext(d.context);
                loadOverview();
            })
            .catch(function (e) {
                btn.disabled = false;
                err.textContent = e.message; err.classList.remove('d-none');
            });
    });

    function loadBokfor() {
        fetch('/umbraco/surface/EkonomiAdmin/GetPostingContext?issuerType=' + issuerType + '&issuerId=' + issuerId)
            .then(function (r) { return r.json(); })
            .then(function (d) { if (d.success && d.context) renderBokforContext(d.context); })
            .catch(function () { });
    }

    // ══ Projekten ════════════════════════════════════════════════════════════════════════
    //
    // ⚠️⚠️ INGEN SUMMA ÖVER GRUPPER, NÅGONSIN. Grupperna får överlappa; en summarad hade varit ett
    //    tal som inte finns. Varje grupp säger i stället vilka den delar projekt med.
    //
    // ⚠️ Knapparna bär ett id och läses med en DELEGERAD lyssnare på behållaren. Raderna ritas om
    //    vid varje skrivning, så en direktbunden lyssnare hade slutat fungera efter första klicket
    //    — och ett projektnamn i ett onclick-attribut är samma lucka som gav kodexekvering i
    //    Fältskyttes "lägg till skytt".
    var projLoaded = false;
    var projData = null;
    var pickingGroupId = 0;

    function projMsg(j, okText) {
        if (!j || !j.success) {
            el('prError').textContent = (j && j.message) || 'Det gick inte att spara.';
            show(el('prError'), true);
            show(el('prOk'), false);
            return false;
        }
        var text = okText || j.message;
        el('prOk').textContent = text || '';
        show(el('prOk'), !!text);
        show(el('prError'), false);
        return true;
    }

    function plural(n, one, many) { return n + ' ' + (n === 1 ? one : many); }

    function netCell(n) {
        // ⚠️ Tecknet står UTSKRIVET. Färg ensam bär aldrig informationen (WCAG 1.4.1) — ett
        //    underskott ska gå att läsa i en svartvit utskrift till årsmötet.
        var style = n < 0 ? ' style="color:var(--bs-danger-text-emphasis)"' : '';
        return '<strong' + style + '>' + (n > 0 ? '+' : '') + kr(n) + '</strong>';
    }

    async function loadProjects() {
        show(el('prError'), false);

        var yr = el('prYear').value;
        var url = '/umbraco/surface/EkonomiAdmin/GetProjects?issuerType=' + issuerType
                + '&issuerId=' + issuerId + (yr ? '&fiscalYearId=' + encodeURIComponent(yr) : '');

        var d;
        try {
            d = await fetch(url, { cache: 'no-store' }).then(function (r) { return r.json(); });
        } catch (e) {
            d = { success: false, message: 'Projekten gick inte att läsa.' };
        }

        if (!d.success) {
            el('prError').textContent = d.message || 'Projekten gick inte att läsa.';
            show(el('prError'), true);
            return;
        }

        projData = d;
        renderProjectYears(d);
        renderProjectRows(d);
        renderProjectGroups(d);
        if (pickingGroupId) renderPickList();
    }

    function renderProjectYears(d) {
        var sel = el('prYear');
        // ⚠️ Förvalet är projektets HELA tid, inte i år. Ett projekt vill ha ett slutresultat —
        //    en tävling vars fakturor kom i januari ska inte se ut att ha gått med vinst i december.
        sel.innerHTML = '<option value="">Hela projektets tid</option>'
            + (d.fiscalYears || []).map(function (y) {
                return '<option value="' + y.id + '">Räkenskapsår ' + y.year + '</option>';
            }).join('');
        // Servern ekar det år den faktiskt räknade på — ett okänt år blir null, alltså "hela tiden".
        sel.value = d.fiscalYearId != null ? String(d.fiscalYearId) : '';
    }

    function groupNamesFor(p) {
        var byId = {};
        (projData.groups || []).forEach(function (g) { byId[g.id] = g.name; });
        var names = (p.groupIds || []).map(function (id) { return byId[id]; }).filter(Boolean);
        return names.length ? names.map(esc).join(', ') : '<span class="muted">—</span>';
    }

    function projectRow(p) {
        var what = (p.sourceLabel || 'Eget projekt') + ' · ' + plural(p.entryCount, 'verifikation', 'verifikationer');

        var acts = !canWrite ? '' : rowMenu([
            { act: 'edit', id: p.id, text: 'Ändra…' },
            { act: 'close', id: p.id, text: p.isClosed ? 'Öppna projektet igen' : 'Stäng projektet' }
        ]);

        return '<tr><td><strong>' + esc(p.name) + '</strong><div class="muted">' + esc(what) + '</div></td>'
             + '<td>' + groupNamesFor(p) + '</td>'
             + '<td class="n">' + kr(p.income) + '</td>'
             + '<td class="n">' + kr(p.costs) + '</td>'
             + '<td class="n">' + netCell(p.net) + '</td>'
             + '<td class="n">' + acts + '</td></tr>';
    }

    function renderProjectRows(d) {
        var all = d.projects || [];
        var open = all.filter(function (p) { return !p.isClosed; });
        var closed = all.filter(function (p) { return p.isClosed; });

        el('prMeta').textContent = open.length === 0 ? '' : plural(open.length, 'projekt', 'projekt');
        el('prClosedMeta').textContent = closed.length === 0 ? ' — inga' : ' — ' + closed.length;

        el('prBody').innerHTML = open.length === 0
            ? '<tr><td colspan="6" class="muted">Inga projekt ännu. När en tävling eller ett evenemang '
              + 'får sin första betalning blir det ett projekt här av sig självt. Egna projekt — '
              + 'Klubbstugan, Ungdomssektionen — skapar du under Åtgärder.</td></tr>'
            : open.map(projectRow).join('');

        el('prClosedBody').innerHTML = closed.length === 0
            ? '<tr><td colspan="6" class="muted">Inga stängda projekt.</td></tr>'
            : closed.map(projectRow).join('');
    }

    function renderProjectGroups(d) {
        var groups = d.groups || [];
        var nameOf = {};
        (d.projects || []).forEach(function (p) { nameOf[p.id] = p.name; });

        el('prGroupMeta').textContent = groups.length === 0 ? '' : plural(groups.length, 'grupp', 'grupper');

        if (groups.length === 0) {
            el('prGroups').innerHTML = '<p class="muted">Inga grupper ännu. En grupp är ett urval av '
                + 'projekt, till exempel årets klubbtävlingar — skapa en under Åtgärder och välj vilka '
                + 'projekt som ingår.</p>';
            return;
        }

        el('prGroups').innerHTML = '<table class="t"><thead><tr><th>Grupp</th>'
            + '<th class="n" style="width:8rem">Intäkter</th><th class="n" style="width:8rem">Kostnader</th>'
            + '<th class="n" style="width:8rem">Resultat</th><th style="width:14rem"></th></tr></thead><tbody>'
            + groups.map(function (g) {
                var names = (g.projectIds || []).map(function (id) { return nameOf[id]; }).filter(Boolean);
                var list = names.length === 0 ? 'Inga projekt i gruppen ännu.'
                    : plural(names.length, 'projekt', 'projekt') + ': '
                      + names.slice(0, 4).map(esc).join(', ')
                      + (names.length > 4 ? ' och ' + (names.length - 4) + ' till' : '');

                // ⚠️⚠️ Överlappet SÄGS på gruppens egen rad. Två gruppers summor som delar ett
                //    projekt går inte att lägga ihop, och det enda som hindrar någon från att göra
                //    det i huvudet är att det står här.
                var overlap = (g.overlaps || []).map(function (o) {
                    return '<div class="muted">Delar ' + plural(o.sharedProjects, 'projekt', 'projekt')
                         + ' med <strong>' + esc(o.groupName) + '</strong> — lägg inte ihop gruppernas summor.</div>';
                }).join('');

                var acts = !canWrite ? '' : rowMenu([
                    { act: 'pick', id: g.id, text: 'Välj projekt…' },
                    { act: 'edit', id: g.id, text: 'Döp om…' },
                    { act: 'delete', id: g.id, text: 'Ta bort gruppen…', danger: true }
                ]);

                return '<tr><td><strong>' + esc(g.name) + '</strong>'
                     + (g.isFromSeries ? ' ' + badge('info', 'tävlingsserie') : '')
                     + (g.description ? '<div class="muted">' + esc(g.description) + '</div>' : '')
                     + '<div class="muted">' + list + '</div>' + overlap + '</td>'
                     + '<td class="n">' + kr(g.income) + '</td>'
                     + '<td class="n">' + kr(g.costs) + '</td>'
                     + '<td class="n">' + netCell(g.net) + '</td>'
                     + '<td class="n">' + acts + '</td></tr>';
            }).join('')
            + '</tbody></table>';
    }

    function renderPickList() {
        var g = (projData.groups || []).find(function (x) { return x.id === pickingGroupId; });
        if (!g) { pickingGroupId = 0; closeModal('prPickModal'); return; }

        el('prPickTitle').textContent = 'Projekt i gruppen ' + g.name;
        var inGroup = {};
        (g.projectIds || []).forEach(function (id) { inGroup[id] = true; });

        var all = (projData.projects || []);
        el('prPickList').innerHTML = all.length === 0
            ? '<p class="muted">Föreningen har inga projekt ännu.</p>'
            : all.map(function (p) {
                return '<div class="form-check">'
                     + '<input class="form-check-input" type="checkbox" id="' + uid + '_pick' + p.id + '" data-pick-project="' + p.id + '"'
                     + (inGroup[p.id] ? ' checked' : '') + '>'
                     + '<label class="form-check-label" for="' + uid + '_pick' + p.id + '">' + esc(p.name)
                     + (p.isClosed ? ' ' + badge('off', 'stängt') : '')
                     + ' <span class="muted">· ' + netCell(p.net) + '</span></label></div>';
            }).join('');
    }

    el('prYear').addEventListener('change', function () { loadProjects(); });

    var projRowHandlers = {
        edit: function (id) {
            var p = (projData.projects || []).find(function (x) { return x.id === parseInt(id, 10); });
            if (p) fillProjectForm(p);
        },
        close: function (id, b) {
            var p = (projData.projects || []).find(function (x) { return x.id === parseInt(id, 10); });
            if (!p) return;
            b.disabled = true;
            postJson('/umbraco/surface/EkonomiAdmin/SetProjectClosed', {
                issuerType: issuerType, issuerId: issuerId, projectId: p.id, closed: !p.isClosed
            }).then(function (j) {
                if (projMsg(j)) { loadProjects(); if (canWrite) loadBokfor(); }
                else b.disabled = false;
            }).catch(function (e) { b.disabled = false; projMsg({ success: false, message: e.message }); });
        }
    };
    onRowAction(el('prBody'), projRowHandlers);
    onRowAction(el('prClosedBody'), projRowHandlers);

    onRowAction(el('prGroups'), {
        pick: function (id) {
            pickingGroupId = parseInt(id, 10);
            renderPickList();
            openModal('prPickModal');
        },
        edit: function (id) {
            var g = (projData.groups || []).find(function (x) { return x.id === parseInt(id, 10); });
            if (g) fillGroupForm(g);
        },
        delete: function (id) {
            var gid = parseInt(id, 10);
            var gd = (projData.groups || []).find(function (x) { return x.id === gid; });
            var n = gd ? (gd.projectIds || []).length : 0;
            // ⚠️ Fråga bara när det finns något att förlora. En tom grupp äger ingenting, och
