    // ══ RAPPORT: utfall mot budget ═══════════════════════════════════════════════════════
    //
    // ⚠️ Laeses om vid VARJE besok i panelen, med flit. Datat andras fran Bokfor-ytan bredvid,
    //    och fragan ar en enda GROUP BY over arets verifikationsrader — alltsa billig. Det ar en
    //    annan sak an tavlingarnas resultatlista, dar en omrakning kostade 8-16 s och darfor
    //    laddas en gang per sidladdning.
    var repFrom = null, repTo = null, budAccounts = [], budDraftId = 0;

    function toneClass(t) { return t === 'ok' ? 'fine' : (t === 'attn' ? 'miss' : ''); }

    // "Antagen av årsmötet 14 mars 2026". Faller tillbaka på ett ensamt "Antagen" hellre än på
    // en halv mening — en rad som slutar mitt i läses som ett fel i sidan.
    function adoptedSentence(rep) {
        var who = (rep.adoptedBodyLabel || '').toLowerCase();
        var dat = rep.adoptedDate ? longDate(rep.adoptedDate) : '';
        if (!who && !dat) return 'Antagen';
        return 'Antagen av ' + (who || 'föreningen') + (dat ? ' ' + dat : '');
    }

    function longDate(iso) {
        var m = String(iso).slice(0, 10).split('-');
        if (m.length !== 3) return '';
        return parseInt(m[2], 10) + ' ' + (FULLMONTH[parseInt(m[1], 10) - 1] || m[1]) + ' ' + m[0];
    }

    function signed(n) {
        if (!n) return '0 kr';
        return (n > 0 ? '+' : '−') + Math.abs(n).toLocaleString('sv-SE', { maximumFractionDigits: 0 }) + ' kr';
    }

    function pct(p) {
        if (p === null || p === undefined) return '—';
        return (p > 0 ? '+' : (p < 0 ? '−' : '')) + Math.abs(p) + ' %';
    }

    function repRow(r) {
        var tc = toneClass(r.tone);
        var bar = r.budget > 0
            ? '<div class="rep-bar ' + (r.tone === 'ok' ? 'ok' : (r.tone === 'attn' ? 'attn' : ''))
              + '"><i style="width:' + r.barPercent + '%"></i></div>'
            : '';

        return '<tr>'
             + '<td>' + r.accountNumber + ' ' + esc(r.accountName)
             + (r.unbudgeted ? ' <span class="muted">(obudgeterat)</span>' : '') + '</td>'
             + '<td class="barcell">' + bar + '</td>'
             + '<td class="n">' + (r.budget > 0 ? kr(r.budget) : '—') + '</td>'
             + '<td class="n"><strong>' + kr(r.actual) + '</strong></td>'
             + '<td class="n ' + tc + '">' + (r.budget > 0 ? signed(r.diff) : '—') + '</td>'
             + '<td class="n ' + tc + '">' + (r.budget > 0 ? pct(r.diffPercent) : '—') + '</td>'
             + '</tr>';
    }

    function renderReport(d) {
        var rep = d.report || {};
        var hasBudget = !!rep.hasBudget;

        el('repPeriod').textContent = hasBudget
            ? d.periodLabel
            : 'Kassörens vanligaste leverans — oftare än bokslutet.';

        show(el('repActions'), hasBudget);
        show(el('repCard'), hasBudget);
        show(el('repFooter'), hasBudget);
        show(el('repEmpty'), !hasBudget);

        // ⚠️ Det tomma laget maste skilja "ingen budget alls" fran "ett utkast ligger och
        //    vantar". Det andra ar nagon som borjat och inte blivit klar, och da ar radet ett
        //    annat.
        if (!hasBudget) {
            el('repEmptyH').textContent = rep.hasDraft
                ? 'Budgeten är påbörjad men inte antagen'
                : 'Ingen budget är antagen ännu';
            el('repEmptyP').textContent = rep.hasDraft
                ? 'Ett utkast ligger och väntar. Uppföljningen visas när budgeten är antagen — '
                  + 'ett förslag ingen beslutat om är inget att mäta mot.'
                : 'Uppföljningen jämför årets utfall med det styrelsen eller årsmötet beslutade. '
                  + 'Utan ett beslut finns inget att jämföra med.';
            // ⚠️⚠️ KNAPPEN FINNS INTE FÖR EN LÄSARE. Utan vakten kastar renderReport här, och
            //    felet SVÄLJS av fetch-kedjans catch — det landar i felrutan i stället för i
            //    konsolen, så "inga JS-fel" är grönt medan Översiktens kort 3 står tomt.
            //    Upptäckt genom att titta på den renderade sidan, inte i loggen.
            if (el('repStart'))
                el('repStart').textContent = rep.hasDraft ? 'Fortsätt med budgeten' : 'Lägg in budgeten';

            renderYearCard(null);
            return;
        }

        var html = '';
        if ((rep.income || []).length) {
            html += '<tr class="grp"><td colspan="6">Intäkter</td></tr>'
                  + rep.income.map(repRow).join('');
        }
        if ((rep.costs || []).length) {
            html += '<tr class="grp"><td colspan="6">Kostnader</td></tr>'
                  + rep.costs.map(repRow).join('');
        }

        html += '<tr class="sum"><td>Resultat</td><td></td>'
              + '<td class="n">' + kr(rep.budgetResult) + '</td>'
              + '<td class="n">' + kr(rep.actualResult) + '</td>'
              + '<td class="n ' + toneClass(d.resultTone) + '">' + signed(rep.resultDiff) + '</td>'
              + '<td></td></tr>';

        el('repBody').innerHTML = html;

        // ⚠️ Meningen byggs av DELARNA (vem + datum), aldrig av adoptedLabel — den kan vara
        //    kassörens egen fritext, och "Den antogs Årsmötet 14 mars" är ingen mening.
        var rev = rep.revision > 1 ? (' · version ' + rep.revision) : '';
        var decided = adoptedSentence(rep);
        el('repAdopted').textContent = decided + rev
            + (rep.adoptedNote ? ' · ' + rep.adoptedNote : '')
            + '. Budgeten gäller hela året och räknas aldrig om till en del av det.';
        el('repDecision').textContent = decided + '.';

        renderYearCard(rep);
    }

    // Översiktens kort 3. ⚠️ Samma svar som rapporten — kortet räknar aldrig själv, då kan de
    //    två säga olika saker om samma år.
    function renderYearCard(rep) {
        var has = !!(rep && rep.hasBudget);
        show(el('yearBars'), has);
        show(el('yearNoBudget'), !has);
        if (!has) return;

        var sum = function (rows, f) { return (rows || []).reduce(function (a, r) { return a + f(r); }, 0); };
        var inB = sum(rep.income, function (r) { return r.budget; });
        var inA = sum(rep.income, function (r) { return r.actual; });
        var koB = sum(rep.costs, function (r) { return r.budget; });
        var koA = sum(rep.costs, function (r) { return r.actual; });
        var w = function (a, b) { return b > 0 ? Math.min(100, Math.round(a / b * 100)) : 0; };

        el('yrIncome').textContent = kr(inA) + ' av ' + kr(inB);
        el('yrCost').textContent = kr(koA) + ' av ' + kr(koB);
        el('yrIncomeBar').style.width = w(inA, inB) + '%';
        el('yrCostBar').style.width = w(koA, koB) + '%';
        el('yrNote').textContent = adoptedSentence(rep) + '.';
    }

    function loadReport() {
        var q = '?issuerType=' + issuerType + '&issuerId=' + issuerId
              + (repFrom ? '&from=' + repFrom : '') + (repTo ? '&to=' + repTo : '');

        return fetch('/umbraco/surface/EkonomiAdmin/GetBudgetReport' + q, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) throw new Error(d.message || 'Rapporten gick inte att läsa.');

                // Inget räkenskapsår = ingenting att följa upp. Ett eget läge, inte ett fel.
                if (d.hasFiscalYear === false) {
                    show(el('repActions'), false);
                    show(el('repCard'), false);
                    show(el('repFooter'), false);
                    show(el('repEmpty'), true);
                    el('repEmptyH').textContent = 'Räkenskapsåret saknas';
                    el('repEmptyP').textContent = d.message || '';
                    if (el('repStart')) show(el('repStart'), false);

                    // ⚠️⚠️ Översiktens kort 3 måste ändå få ett innehåll. Utan det här står
                    //    kortet HELT TOMT för en förening som inte satt upp ekonomin — en ruta
                    //    med en rubrik och ingenting under läses som att sidan är trasig, inte
                    //    som att det inte finns någon budget. Syns på varje ny förening.
                    renderYearCard(null);
                    return;
                }

                setDateField('repFrom', d.report.periodStart ? d.report.periodStart.substring(0, 10) : '');
                setDateField('repTo', d.report.periodEnd ? d.report.periodEnd.substring(0, 10) : '');
                el('repError').classList.add('d-none');
                renderReport(d);
            })
            .catch(function (e) {
                el('repError').textContent = e.message;
                el('repError').classList.remove('d-none');
            });
    }

    el('repPeriodBtn').addEventListener('click', function () {
        el('repPeriodBox').classList.toggle('d-none');
    });
    el('repApply').addEventListener('click', function () {
        repFrom = el('repFrom').value || null;
        repTo = el('repTo').value || null;
        loadReport();
    });
    el('repReset').addEventListener('click', function () {
        repFrom = null; repTo = null; loadReport();
    });
    el('repPrint').addEventListener('click', function () { window.print(); });

    // ── Budgetinmatningen ────────────────────────────────────────────────────────────────
    function budRow(a) {
        return '<tr>'
             + '<td>' + a.number + ' ' + esc(a.name) + '</td>'
             + '<td class="n muted">' + (a.previousActual ? kr(a.previousActual) : '—') + '</td>'
             + '<td class="n"><input type="number" step="1" min="0" class="form-control form-control-sm rep-amt" '
             + 'data-acc="' + a.number + '" value="' + (a.amount || '') + '"></td>'
             + '</tr>';
    }

    function openBudget() {
        show(el('budCard'), true);
        el('budError').classList.add('d-none');
        el('budOk').classList.add('d-none');

        fetch('/umbraco/surface/EkonomiAdmin/GetBudgetEditor?issuerType=' + issuerType
              + '&issuerId=' + issuerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) throw new Error(d.message || 'Budgetunderlaget gick inte att läsa.');

                budDraftId = d.draftId;
                budAccounts = d.accounts || [];

                el('budTitle').textContent = 'Budget ' + d.fiscalYear;
                el('budMeta').textContent = d.revision > 1 ? ('version ' + d.revision) : '';
                el('budPrevH').textContent = d.previousYear ? ('Utfall ' + d.previousYear) : '';

                var inc = budAccounts.filter(function (a) { return a.isIncome; });
                var cos = budAccounts.filter(function (a) { return !a.isIncome; });

                el('budBody').innerHTML =
                    (inc.length ? '<tr class="grp"><td colspan="3">Intäkter</td></tr>' + inc.map(budRow).join('') : '')
                  + (cos.length ? '<tr class="grp"><td colspan="3">Kostnader</td></tr>' + cos.map(budRow).join('') : '');
            })
            .catch(function (e) {
                el('budError').textContent = e.message;
                el('budError').classList.remove('d-none');
            });
    }

    function collectBudgetLines() {
        return Array.prototype.map.call(
            el('budBody').querySelectorAll('input[data-acc]'),
            function (i) {
                var num = parseInt(i.dataset.acc, 10);
                var a = budAccounts.find(function (x) { return x.number === num; });
                return { accountNumber: num, accountName: a ? a.name : '', amount: parseFloat(i.value || '0') || 0 };
            });
    }

    // ⚠️⚠️ VAKTERNA ÄR INTE VALFRIA. Skrivkontrollerna renderas inte alls för en läsare, och
    //    addEventListener på null kastar — vilket dödar HELA den här IIFE:n och ger en sida som
    //    inte laddar någonting. Felet syns bara för den som saknar skrivrätt.
    if (canWrite) {
        el('repStart').addEventListener('click', openBudget);
        el('repRevise').addEventListener('click', openBudget);
        el('budCancel').addEventListener('click', function () { show(el('budCard'), false); });
    }

    if (canWrite) el('budSave').addEventListener('click', function () {
        var btn = el('budSave');
        btn.disabled = true;
        el('budError').classList.add('d-none');
        el('budOk').classList.add('d-none');

        postJson('/umbraco/surface/EkonomiAdmin/SaveBudgetDraft', {
            issuerType: issuerType, issuerId: issuerId, budgetId: budDraftId, lines: collectBudgetLines()
        })
            .then(function (d) {
                btn.disabled = false;
                if (!d.success) throw new Error(d.message);
                el('budOk').textContent = d.message;
                el('budOk').classList.remove('d-none');
            })
            .catch(function (e) {
                btn.disabled = false;
                el('budError').textContent = e.message;
                el('budError').classList.remove('d-none');
            });
    });

    if (canWrite) el('budAdopt').addEventListener('click', function () {
        var btn = el('budAdopt');
        btn.disabled = true;
        el('budError').classList.add('d-none');
        el('budOk').classList.add('d-none');

        // ⚠️ Sparar FÖRST. Annars antas det som ligger i databasen, inte det som står på
        //    skärmen — och skillnaden syns aldrig, eftersom raden sedan är låst.
        postJson('/umbraco/surface/EkonomiAdmin/SaveBudgetDraft', {
            issuerType: issuerType, issuerId: issuerId, budgetId: budDraftId, lines: collectBudgetLines()
        })
            .then(function (d) {
                if (!d.success) throw new Error(d.message);
                return postJson('/umbraco/surface/EkonomiAdmin/AdoptBudget', {
                    issuerType: issuerType, issuerId: issuerId, budgetId: budDraftId,
                    adoptedDate: el('budDate').value,
                    adoptedBody: el('budAdoptedBy').value,
                    note: el('budNote').value
                });
            })
            .then(function (d) {
                btn.disabled = false;
                if (!d.success) throw new Error(d.message);
                show(el('budCard'), false);
                loadReport();
            })
            .catch(function (e) {
                btn.disabled = false;
                el('budError').textContent = e.message;
                el('budError').classList.remove('d-none');
            });
    });


    // ══ KONTOPLANEN OCH KOPPLINGARNA ═════════════════════════════════════════════════════
    //
    // ⚠️⚠️ Kontoplanen gick inte att ändra från någon yta alls fram till 2026-09-22. För den som
    //    matar in förra årets bokföring är det blockerande: en förening har konton vi inte sått.
    var chartAccounts = [], chartRoles = [], chartExpanded = false;

    // ⚠️⚠️ KNAPPEN HETER VAD DEN GÖR. Den hette "Stäng", och det sa ingenting om vad som
    //    händer — Stefan 2026-09-22: "Vad menas med / vad gör, länken / knappen Stäng". Ett konto
    //    RADERAS aldrig; det slutar bara erbjudas när man bokför. Då ska knappen säga just det.
    function chartRow(a) {
        var uses = (a.roles || []).join(', ');

        // Läget står SKRIVET på raden, inte bara som en blek färg. Färg ensam bär aldrig
        // information (WCAG 1.4.1) — och "varför är den här raden grå?" är en onödig fråga.
        var name = '<input type="text" class="form-control form-control-sm chart-name" data-acc="'
                 + a.number + '" value="'
                 + esc(a.name) + '" maxlength="120">'
                 + (a.isActive ? '' : '<div class="muted">Används inte längre</div>');

        return '<tr>'
             + '<td' + (a.isActive ? '' : ' class="chart-off"') + '>' + a.number + '</td>'
             + '<td>' + name + '</td>'
             + '<td class="muted">' + esc(uses) + '</td>'
             + '<td class="n">' + (a.entryLines || 0) + '</td>'
             + '<td class="n"><button type="button" class="btn btn-sm btn-outline-secondary"'
             + ' data-toggle-acc="' + a.number + '" title="'
             + (a.isActive
                 ? 'Kontot slutar erbjudas när du bokför. Det raderas inte, och du kan ångra dig.'
                 : 'Kontot börjar erbjudas när du bokför igen.')
             + '">'
             + (a.isActive ? 'Sluta använda' : 'Använd igen') + '</button></td>'
             + '</tr>';
    }

    function renderChart() {
        // ⚠️ Kontoplanen är ~39 rader. Visa tio och erbjud resten — en vägg av rader läses inte.
        var show = chartExpanded ? chartAccounts : chartAccounts.slice(0, 10);
        el('chartRows').innerHTML = show.map(chartRow).join('');
        el('chartMeta').textContent = chartAccounts.length + ' konton';

        el('chartMore').innerHTML = (chartExpanded || chartAccounts.length <= 10)
            ? '' : '<button type="button">Visa alla ' + chartAccounts.length + ' konton</button>';

        var more = el('chartMore').querySelector('button');
        if (more) more.addEventListener('click', function () { chartExpanded = true; renderChart(); });

        // ⚠️ Namnet sparas när fältet lämnas, inte vid varje tangenttryck — annars blir varje
        //    bokstav ett anrop, och ett halvskrivet namn hinner sparas.
        el('chartRows').querySelectorAll('input.chart-name').forEach(function (i) {
            i.addEventListener('change', function () {
                saveAccount(parseInt(i.dataset.acc, 10), i.value, true);
            });
        });

        el('chartRows').querySelectorAll('button[data-toggle-acc]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var num = parseInt(btn.dataset.toggleAcc, 10);
                var acc = chartAccounts.find(function (a) { return a.number === num; });
                postJson('/umbraco/surface/EkonomiAdmin/SetAccountActive', {
                    issuerType: issuerType, issuerId: issuerId, number: num, active: !acc.isActive
                }).then(chartDone).catch(chartFailed);
            });
        });
    }

    function renderRoles() {
        // ⚠️ Kontot väljs ur FÖRENINGENS egen kontoplan, aldrig ur en lista i koden — en klubb som
        //    lagt till 3015 ska kunna peka medlemsavgiften dit.
        var options = chartAccounts.filter(function (a) { return a.isActive; });

        el('roleRows').innerHTML = chartRoles.map(function (r) {
            // ⚠️⚠️ EN VALFRI ROLL MÅSTE KUNNA STÅ TOM. Utan det tomma alternativet väljs första
            //    kontot i listan automatiskt, och raden PÅSTÅR en koppling som inte finns —
            //    på en inställning vars hela poäng är att den är frivillig. Det tomma valet är
            //    också enda vägen tillbaka; servern tolkar 0 som "ta bort", men bara här.
            var tomt = r.optional
                ? '<option value="0"' + (!r.accountNumber ? ' selected' : '') + '>'
                  + '— används inte, allt ligger på kundfordran —</option>'
                : '';

            return '<tr><td>' + esc(r.label)
                 + (r.optional ? ' <span class="muted">(valfritt)</span>' : '')
                 + (r.hint ? '<div class="muted">' + esc(r.hint) + '</div>' : '') + '</td>'
                 + '<td><select class="form-select form-select-sm" data-role="' + esc(r.key) + '">'
                 + tomt
                 + options.map(function (a) {
                       return '<option value="' + a.number + '"'
                            + (a.number === r.accountNumber ? ' selected' : '') + '>'
                            + a.number + ' · ' + esc(a.name) + '</option>';
                   }).join('')
                 + '</select></td></tr>';
        }).join('');

        el('roleRows').querySelectorAll('select[data-role]').forEach(function (sel) {
            sel.addEventListener('change', function () {
                postJson('/umbraco/surface/EkonomiAdmin/SetAccountRole', {
                    issuerType: issuerType, issuerId: issuerId,
                    roleKey: sel.dataset.role, number: parseInt(sel.value, 10)
                }).then(function (d) {
                    if (!d.success) { el('roleError').textContent = d.message; show(el('roleError'), true); return; }
                    show(el('roleError'), false);
                    loadChart();
                }).catch(function (e) {
                    el('roleError').textContent = e.message; show(el('roleError'), true);
                });
            });
        });
    }

    // ══ INGÅENDE BALANSER ═════════════════════════════════════════════════════════════════
    // ⚠️ Kassören anger SALDON, inte debet och kredit — eget kapital räknas ut. Samma regel som
    //    Bokför: "på föreningskontot fanns 48 312 kr" är en fråga hen kan svara på.
    var obState = null;

    function obNum(v) {
        var t = String(v == null ? '' : v).replace(/\s/g, '').replace(/\u2212/g, '-').replace(',', '.');
        if (t === '' || t === '-') return 0;
        var n = Number(t);
        return isNaN(n) ? NaN : n;
    }

    function loadOpeningBalances() {
        return fetch('/umbraco/surface/EkonomiAdmin/GetOpeningBalances?issuerType=' + issuerType
                     + '&issuerId=' + issuerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) throw new Error(d.message || 'De ingående balanserna gick inte att läsa.');
                obState = d.state;
                renderOpeningBalances();
            })
            .catch(function (e) { el('obBody').textContent = e.message; });
    }

    function renderOpeningBalances() {
        var s = obState, btn = el('obOpen');
        if (!s || !s.fiscalYearId) {
            el('obMeta').innerHTML = '';
            el('obBody').textContent = 'Lägg upp räkenskapsåret först.';
            show(btn, false);
            todo.noOpening = false; renderTodo();
            return;
        }

        var date = shortDate(s.date);
        if (s.existingEntryId) {
            var assets = s.existingLines.filter(function (l) { return l.accountNumber < 2000; })
                .reduce(function (a, l) { return a + l.amount; }, 0);
            el('obMeta').innerHTML = badge('ok', 'Inlagda');
            el('obBody').innerHTML = 'Per ' + esc(date) + ': tillgångar ' + kr(assets)
                + ', eget kapital ' + kr(s.existingEquity) + '.';
            btn.textContent = 'Ändra ingående balanser…';
        } else {
            el('obMeta').innerHTML = badge('wait', 'Inte inlagda');
            el('obBody').innerHTML = 'Vad hade föreningen den ' + esc(date) + ', när bokföringen började här? '
                + 'Pengar på kontot, i kassan och på Swish, och det föreningen äger eller är skyldig. '
                + 'Utan dem börjar balansräkningen på noll.';
            btn.textContent = 'Lägg in ingående balanser…';
        }

        show(btn, canWrite && s.yearIsOpen);
        if (!s.yearIsOpen && !s.existingEntryId)
            el('obBody').innerHTML += ' <span class="muted">Året ' + s.year + ' är fastställt, så de kan inte längre läggas in.</span>';

        todo.noOpening = !s.existingEntryId && s.yearIsOpen;
        renderTodo();
    }

    function obRowsHtml(list, title, prefill) {
        if (list.length === 0) return '';
        return '<h6 class="mt-2">' + esc(title) + '</h6>'
            + '<table class="t"><tbody>' + list.map(function (a) {
                var v = prefill[a.number];
                return '<tr><td class="muted" style="width:4rem">' + a.number + '</td>'
                     + '<td>' + esc(a.name) + '</td>'
                     + '<td class="n" style="width:11rem"><input type="text" inputmode="decimal" autocomplete="off"'
                     + ' class="form-control form-control-sm text-end" data-ob-acc="' + a.number + '"'
                     + ' value="' + (v ? String(v).replace('.', ',') : '') + '"></td></tr>';
            }).join('') + '</tbody></table>';
    }

    function obRecalc() {
        var eq = 0, bad = false;
        el('obRows').querySelectorAll('input[data-ob-acc]').forEach(function (inp) {
            var n = obNum(inp.value), acc = parseInt(inp.dataset.obAcc, 10);
            inp.classList.toggle('is-invalid', isNaN(n));
            if (isNaN(n)) { bad = true; return; }
            eq += acc < 2000 ? n : -n;
        });
        el('obEquity').textContent = bad ? '—' : kr(Math.round(eq * 100) / 100);
        return !bad;
    }

    function openOpeningBalances() {
        var s = obState; if (!s) return;
        var prefill = {};
        (s.existingLines || []).forEach(function (l) { prefill[l.accountNumber] = l.amount; });

        el('obIntro').textContent = 'Skriv saldona som de stod den ' + shortDate(s.date)
            + ' — kontoutdraget och kassaboken säger det. Tomma rader betyder noll. '
            + (s.existingEntryId ? 'De tidigare uppgifterna rättas och ersätts; ingenting skrivs över.' : '');
        el('obRows').innerHTML =
              obRowsHtml(s.accounts.filter(function (a) { return a.isAsset; }), 'Det föreningen äger', prefill)
            + obRowsHtml(s.accounts.filter(function (a) { return !a.isAsset; }), 'Det föreningen är skyldig', prefill);
        show(el('obErr'), false);
        obRecalc();
        openModal('obModal');
    }

    if (el('obOpen')) {
        el('obOpen').addEventListener('click', openOpeningBalances);
        el('obRows').addEventListener('input', obRecalc);
        el('obSave').addEventListener('click', function () {
            if (!obRecalc()) { dialogError('obErr', { message: 'Ett belopp går inte att läsa. Skriv bara siffror, t.ex. 48 312,50.' }); return; }
            var lines = [];
            el('obRows').querySelectorAll('input[data-ob-acc]').forEach(function (inp) {
                var n = obNum(inp.value);
                if (n !== 0) lines.push({ accountNumber: parseInt(inp.dataset.obAcc, 10), amount: n });
            });
            var b = el('obSave'); b.disabled = true;
            postJson('/umbraco/surface/EkonomiAdmin/SaveOpeningBalances',
                     { issuerType: issuerType, issuerId: issuerId, lines: lines })
                .then(function (j) {
                    b.disabled = false;
                    if (!j.success) { dialogError('obErr', j); return; }
                    closeModal('obModal');
                    obState = j.state;
                    renderOpeningBalances();
                    el('obOk').textContent = j.removed ? 'De ingående balanserna är borttagna.'
                        : 'De ingående balanserna är bokförda.';
                    show(el('obOk'), true);
                })
                .catch(function (e) { b.disabled = false; dialogError('obErr', { message: e.message }); });
        });
    }

    function loadChart() {
        return fetch('/umbraco/surface/EkonomiAdmin/GetChart?issuerType=' + issuerType
                     + '&issuerId=' + issuerId, { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (d) {
                if (!d.success) throw new Error(d.message || 'Kontoplanen gick inte att läsa.');
                chartAccounts = d.accounts || [];
                chartRoles = d.roles || [];
                renderChart();
                renderRoles();
            })
            .catch(function (e) {
                el('chartError').textContent = e.message;
                show(el('chartError'), true);
            });
    }

    function chartDone(d) {
        if (!d.success) { el('chartError').textContent = d.message; show(el('chartError'), true); return; }
        show(el('chartError'), false);
        el('chartOk').textContent = d.message;
        show(el('chartOk'), true);
        loadChart();
    }

    function chartFailed(e) {
        el('chartError').textContent = e.message;
        show(el('chartError'), true);
    }

    function saveAccount(number, name, rename) {
        return postJson('/umbraco/surface/EkonomiAdmin/SaveAccount', {
            issuerType: issuerType, issuerId: issuerId,
            number: number, name: name, rename: rename === true
        }).then(chartDone).catch(chartFailed);
    }

    if (canWrite) el('accAdd').addEventListener('click', function () {
        var num = parseInt(el('accNumber').value, 10) || 0;
        saveAccount(num, el('accName').value, false).then(function () {
            el('accNumber').value = '';
            el('accName').value = '';
        });
    });


    // ══ FORMEN: avsikt först, faktum sedan ═══════════════════════════════════════════════
    //
    // ⚠️⚠️ Ytan frågade tidigare om NULÄGET ("var bokförs ekonomin?") men styr AVSIKTEN. En
    //    förening som HAR ett program men vill flytta hit svarade då sanningsenligt fel och
    //    hamnade i avgiftsläget — utan att något felade. Steg 1 är därför viljan, steg 2 ett
    //    faktum om programmet som bara spelar roll om bokföringen stannar kvar hos föreningen.
    function syncBankStep() {
        var use = root.querySelector('input[name="' + uid + '_use"]:checked');
        show(el('bankStep'), !!use && use.value === 'keep');
    }

    function applyShape(shape) {
        var useFull = el('useFull'), useKeep = el('useKeep');

        if (shape === 'full') {
            useFull.checked = true;
        } else if (shape === 'export' || shape === 'fees') {
            useKeep.checked = true;
            var bank = document.getElementById(uid + (shape === 'export' ? '_shapeExport' : '_shapeFees'));
            if (bank) bank.checked = true;
        }

        syncBankStep();
    }

    // ⚠️ Den valda formen är HÄRLEDD ur de två stegen, aldrig lagrad i en tredje variabel som kan
    //    hamna ur takt med radioknapparna.
    function chosenShape() {
        var use = root.querySelector('input[name="' + uid + '_use"]:checked');
        if (!use) return null;
        if (use.value === 'full') return 'full';

        var bank = root.querySelector('input[name="' + uid + '_bank"]:checked');
        return bank ? bank.value : null;
    }

    root.querySelectorAll('input[name="' + uid + '_use"]').forEach(function (r) {
        r.addEventListener('change', syncBankStep);
    });


    load();
})();
</script>
</div>
