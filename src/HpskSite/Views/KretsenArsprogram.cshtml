@model HpskSite.Controllers.KretsArsprogramModel
@using System.Globalization
@*
    Kretsens årsprogram på papper (kretsutlysningen F2). Öppnas från kortet Utlysta tävlingar (Åtgärder → Skriv ut årsprogram…).
    A4 stående, en sida per månad, krets och år i sidhuvudet, datumlösa för sig, "Ej utsedd" på tomma rader.
    Raderna kommer ur CompetitionCallRules.ProgramRows — samma regelfunktion som kalendern får i F5.
*@
@{
    Layout = null;
    var ci = CultureInfo.GetCultureInfo("sv-SE");
    string Day(DateTime? d) => d.HasValue ? d.Value.ToString("d MMM", ci) : "";
    var total = Model.Months.Sum(g => g.Rows.Count);
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Årsprogram @Model.Year – @Model.RegionName</title>
    <style>
        body { font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1a1a1a; margin: 0; padding: 24px; background: #fff; }
        .wrap { max-width: 820px; margin: 0 auto; }
        .head { border-bottom: 3px solid #1a1a1a; padding-bottom: .4rem; margin-bottom: 1rem; }
        h1 { font-size: 1.6rem; margin: 0; }
        .sub { color: #555; font-size: .92rem; }
        h2 { font-size: 1.15rem; margin: 1.5rem 0 .4rem; border-bottom: 1px solid #888; padding-bottom: .15rem; }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #ddd; vertical-align: top; font-size: .95rem; }
        th { color: #444; font-size: .8rem; text-transform: uppercase; letter-spacing: .02em; }
        .date { white-space: nowrap; font-weight: 600; width: 18%; }
        .none { color: #777; font-style: italic; }
        .pill { display: inline-block; font-size: .72rem; padding: 0 6px; border: 1px solid #999; border-radius: 8px; color: #555; margin-left: .3rem; }
        .small { color: #555; font-size: .85rem; }
        .toolbar { margin-bottom: 1rem; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
        .btn { display: inline-block; padding: 8px 16px; background: #0d6efd; color: #fff; border: 0; border-radius: 6px; text-decoration: none; cursor: pointer; font-size: .95rem; }
        .btn.secondary { background: #6c757d; }
        .month { page-break-after: always; break-after: page; }
        .month:last-child { page-break-after: auto; break-after: auto; }
        @@media (max-width: 560px) { body { padding: 14px; } .col-note { display: none; } .date { width: 28%; } }
        @@media print { .toolbar { display: none; } body { padding: 0; } @@page { size: A4 portrait; margin: 16mm; } }
    </style>
</head>
<body>
<div class="wrap">
    <div class="toolbar">
        <button type="button" class="btn" onclick="window.print()">Skriv ut</button>
        <button type="button" class="btn secondary" onclick="window.close()">Stäng</button>
        @if (Model.HasPlanningRows)
        {
            if (Model.IncludePlanning)
            {
                <a class="btn secondary" href="?krets=@Context.Request.Query["krets"]&ar=@Model.Year">Utan det som bara är planering</a>
            }
            else
            {
                <a class="btn secondary" href="?krets=@Context.Request.Query["krets"]&ar=@Model.Year&planering=true">Ta med det som bara är planering</a>
            }
        }
    </div>
    <div class="head">
        <h1>@Model.RegionName – tävlingsprogram @Model.Year</h1>
        <div class="sub">@total @(total == 1 ? "tävling" : "tävlingar")@if (!Model.IncludePlanning && Model.HasPlanningRows) {<text> · utan det som ännu bara är planering</text>} · utskrivet @DateTime.Today.ToString("d MMMM yyyy", ci)</div>
    </div>

    @if (Model.Months.Count == 0)
    {
        <p class="none">Inga utlysta tävlingar för @Model.Year.</p>
    }
    @foreach (var (heading, rows) in Model.Months)
    {
        <div class="month">
            <h2>@heading @(heading == "Datum inte bestämt" ? "" : Model.Year.ToString())</h2>
            <table>
                <thead><tr><th>Datum</th><th>Tävling</th><th>Arrangör</th><th class="col-note">Anteckning</th></tr></thead>
                <tbody>
                @foreach (var r in rows)
                {
                    <tr>
                        <td class="date">@if (r.Date.HasValue) { <text>@r.Weekday<br /><span class="small">@Day(r.Date)</span></text> } else { <span class="none">–</span> }</td>
                        <td>@r.Name@if (!string.IsNullOrWhiteSpace(r.Discipline)) {<br /><span class="small">@r.Discipline</span>}@if (r.IsPlanning) {<span class="pill">planering</span>}</td>
                        <td>@if (r.Organiser != null) { @r.Organiser } else { <span class="none">Ej utsedd</span> }</td>
                        <td class="col-note small">@r.Note</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
</body>
</html>
