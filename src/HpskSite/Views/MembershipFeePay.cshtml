@model HpskSite.Controllers.MembershipFeePayModel
@using System.Globalization
@{
    Layout = null;
    var sv = CultureInfo.GetCultureInfo("sv-SE");
    string Kr(decimal v) => Math.Round(v).ToString("N0", sv) + " kr";
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(Model.IsRegionFee ? "Kretsavgift" : "Medlemsavgift")@(Model.Found ? $" {Model.Year}" : "")</title>
    <style>
        :root { --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --accent:#0d6efd; --ok:#198754; }
        * { box-sizing: border-box; }
        body {
            font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--ink); background: #f3f4f6; margin: 0; padding: 24px;
        }
        .sheet {
            max-width: 460px; margin: 24px auto; background:#fff; border-radius: 14px;
            box-shadow: 0 6px 24px rgba(0,0,0,.08); padding: 32px 28px; text-align: center;
        }
        .club { font-size: 15px; color: var(--muted); margin: 0 0 4px; }
        h1 { font-size: 24px; margin: 0 0 16px; }
        .amount { font-size: 40px; font-weight: 700; color: var(--accent); margin: 12px 0 20px; }
        .qr { max-width: 260px; width: 100%; height: auto; margin: 0 auto 16px; display:block; }
        .btn {
            display:inline-block; font: inherit; cursor:pointer; text-decoration:none;
            border: 1px solid var(--line); background:#fff; color: var(--ink);
            padding: 12px 22px; border-radius: 10px; font-size: 16px; margin: 6px 4px;
        }
        .btn-swish { background: var(--accent); border-color: var(--accent); color:#fff; }
        .btn-paid { background:#fff; border-color: var(--ok); color: var(--ok); }
        .paid-box {
            background:#e8f5ec; border:1px solid #b7e0c4; color: var(--ok);
            border-radius: 12px; padding: 24px; font-size: 22px; font-weight: 700; margin: 16px 0;
        }
        .notice { color: var(--muted); font-size: 14px; margin-top: 14px; }
        .warn {
            background:#fff8e6; border:1px solid #ffe08a; color:#8a6d00;
            border-radius: 10px; padding: 16px; font-size: 15px; margin: 16px 0;
        }
        .claimed { color: var(--muted); font-size: 13px; margin-top: 10px; }
        .hint { font-size: 13px; color: var(--muted); }
        .pay-h { font-size: 16px; margin: 18px 0 8px; }
        table.bg { margin: 0 auto 8px; border-collapse: collapse; font-size: 15px; text-align: left; }
        table.bg td { padding: 3px 12px 3px 0; }
        table.bg td:first-child { color: var(--muted); }
    </style>
</head>
<body>
    <div class="sheet">
        @if (!Model.Found)
        {
            <h1>Ogiltig länk</h1>
            <p class="notice">Den här betalningslänken är ogiltig eller har upphört att gälla. Kontakta din klubb.</p>
        }
        else
        {
            <p class="club">@Model.ClubName</p>
            @if (Model.IsRegionFee)
            {
                <h1>Kretsavgift @Model.Year</h1>
                <p class="notice" style="margin-top:-8px">för @Model.PayerName</p>
                @* ⚠️ Raderna står på sidan: klubbens kassör ska kunna se att beloppet är 23
                   medlemmar à 20 kr, och det är medlemsantalet klubben kan ha synpunkter på. *@
                @if (Model.Lines.Count > 0)
                {
                    <table style="margin:12px auto 0;border-collapse:collapse;font-size:15px;text-align:left">
                        @foreach (var line in Model.Lines)
                        {
                            <tr><td style="padding:3px 16px 3px 0">@line.Description</td>
                                <td style="padding:3px 0;text-align:right;white-space:nowrap">@Kr(line.Amount)</td></tr>
                        }
                    </table>
                }
            }
            else
            {
                <h1>Medlemsavgift @Model.Year</h1>
            }

            @if (Model.Covered)
            {
                <div class="paid-box">Ingår i familjemedlemskapet ✓</div>
                <p class="notice">Din medlemsavgift för @Model.Year ingår i familjens medlemskap – du behöver inte betala något separat.</p>
            }
            else if (Model.IsPaid)
            {
                <div class="paid-box">Betald för @Model.Year ✓</div>
                <p class="notice">@(Model.IsRegionFee ? "Kretsavgiften är registrerad som betald. Tack!" : "Din medlemsavgift är registrerad som betald. Tack!")</p>
            }
            else
            {
                <div class="amount">@Kr(Model.Amount)</div>

                @* ⚠️⚠️ SWISH ELLER BANKGIRO — många klubbar och kretsar betalar via bankgiro (Stefan
                   2026-09-23). Båda visas när föreningen har båda, och "Jag har betalat" gäller båda.
                   Referensen kommer ur MembershipFeeCharge.PaymentReference — samma som i mejlet. *@
                @* id="swish"/"bankgiro" är mejlets två knappar: var och en landar på sin egen sektion. *@
                @if (Model.HasSwish)
                {
                    <h2 class="pay-h" id="swish">Betala med Swish</h2>
                    <img class="qr" src="@Model.SwishQrDataUri" alt="Swish QR-kod" />
                    <p class="hint">Skanna QR-koden med Swish, eller öppna Swish-appen på din telefon.</p>
                    @if (!string.IsNullOrEmpty(Model.SwishAppUrl))
                    {
                        <a class="btn btn-swish" href="@Model.SwishAppUrl">Öppna Swish</a>
                    }
                }
                @if (Model.HasBg)
                {
                    <h2 class="pay-h" id="bankgiro">@(Model.HasSwish ? "Eller betala med bankgiro" : "Betala med bankgiro")</h2>
                    <table class="bg">
                        <tr><td>Bankgiro</td><td>@Model.BgNumber</td></tr>
                        <tr><td>Mottagare</td><td>@Model.ClubName</td></tr>
                        <tr><td>Belopp</td><td>@Kr(Model.Amount)</td></tr>
                        <tr><td>Referens</td><td><strong>@Model.Reference</strong></td></tr>
                    </table>
                    <p class="hint">Ange referensen, så vet @(Model.IsRegionFee ? "kretsen" : "klubben") vem betalningen gäller.</p>
                    @if (!string.IsNullOrEmpty(Model.BgQrDataUri))
                    {
                        <img class="qr" src="@Model.BgQrDataUri" alt="Bankgiro-QR" style="max-width:180px" />
                        <p class="hint">Eller skanna koden i din bankapp.</p>
                    }
                }

                @if (Model.HasSwish || Model.HasBg)
                {
                    <form method="post" action="/medlemsavgift/@Model.Token/betalat" style="display:block;margin-top:12px">
                        <button type="submit" class="btn btn-paid">Jag har betalat</button>
                    </form>
                    @if (Model.PaymentClaimed)
                    {
                        <p class="claimed">@(Model.IsRegionFee
                            ? "Ni har markerat att ni betalat. Kretsen bekräftar när betalningen registrerats."
                            : "Du har markerat att du betalat. Klubben bekräftar när betalningen registrerats.")</p>
                    }
                }
                else
                {
                    <div class="warn">@(Model.IsRegionFee
                        ? "Kretsen har inte lagt in något Swishnummer eller bankgiro ännu — kontakta kretsen."
                        : "Klubben har inte lagt in något Swishnummer eller bankgiro ännu — kontakta klubben.")</div>
                }
            }
        }
    </div>
</body>
</html>
