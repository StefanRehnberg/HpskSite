@using Umbraco.Cms.Web.Common.PublishedModels;
@using System.Linq;
@using System;
@using HpskSite.Extensions
@using Newtonsoft.Json
@inject Umbraco.Cms.Core.Services.IMemberService MemberService
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager
@inject Umbraco.Cms.Core.Services.IContentService ContentService
@inject HpskSite.Services.AdminAuthorizationService AuthService
@inject HpskSite.Services.ClubService ClubService
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";

    // Get competition ID from query string
    var competitionIdStr = Context.Request.Query["competitionId"].FirstOrDefault();
    int competitionId = 0;
    int.TryParse(competitionIdStr, out competitionId);

    // Find the competition content via direct cache lookup (O(1) instead of full tree scan)
    IPublishedContent? competition = null;
    if (competitionId > 0)
    {
        var node = Umbraco.Content(competitionId);
        if (node != null && node.ContentType.Alias == "competition")
        {
            competition = node;
        }
    }

    // Set page title based on competition
    if (competitionId == 0)
    {
        ViewBag.Title = "Tävlingshantering - Välj tävling";
    }
    else if (competition == null)
    {
        ViewBag.Title = "Tävlingshantering - Tävlingen hittades inte";
    }
    else
    {
        ViewBag.Title = $"Tävlingshantering - {competition.Value<string>("competitionName")}";

        // Pass competition properties to ViewData for partial views
        ViewData["NumberOfSeriesOrStations"] = competition.Value<int>("numberOfSeriesOrStations");
        ViewData["NumberOfFinalSeries"] = competition.Value<int>("numberOfFinalSeries");
        ViewData["CompetitionType"] = competition.Value<string>("competitionType") ?? "Precision";
    }

    // Check authorization
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    bool canManageCompetition = false;
    bool isSiteAdmin = false;
    bool isRegionalAdmin = false;

    // Registration modal variables (computed inside auth block)
    var regRole = "member";
    var regMemberId = 0;
    int? regClubId = null;
    var regClubName = "";
    var regMemberName = "";
    var allClubsJson = "[]";

    if (currentMember != null)
    {
        // Load member data and roles once — derive all auth from this (avoids ~15 redundant service calls)
        var memberData = MemberService.GetByEmail(currentMember.Email ?? "");
        if (memberData != null)
        {
            var roles = MemberService.GetAllRoles(memberData.Id)?.ToList() ?? new List<string>();
            isSiteAdmin = roles.Contains("Administrators");
            isRegionalAdmin = !isSiteAdmin && roles.Any(r => r.StartsWith("RegionalAdmin_"));

            // Compute registration target info
            regMemberId = memberData.Id;
            regMemberName = currentMember.Name ?? "";
            var primaryClubIdStr = memberData.GetValue<string>("primaryClubId");
            if (!string.IsNullOrEmpty(primaryClubIdStr) && int.TryParse(primaryClubIdStr, out int pClubId))
            {
                regClubId = pClubId;
                regClubName = ClubService.GetClubNameById(pClubId) ?? "";
            }

            if (isSiteAdmin) regRole = "admin";
            else if (roles.Any(r => r.StartsWith("ClubAdmin_"))) regRole = "clubAdmin";
            else if (roles.Any(r => r.StartsWith("Skjutledare_"))) regRole = "skjutledare";

            // For admin/clubAdmin roles, provide club list for target member selection
            if (regRole != "member")
            {
                var clubs = ClubService.GetAllClubs()
                    .Where(c => c.IsActive)
                    .OrderBy(c => c.Name)
                    .Select(c => new { id = c.Id, name = c.Name })
                    .ToList();
                allClubsJson = System.Text.Json.JsonSerializer.Serialize(clubs);
            }

            if (competition != null)
            {
                // Competition management access: the tävlingsansvariga list OR any Bemanning roster row
                // (any role — sekretariat, kassa, stationschef …) that was granted app access.
                var cmJson = competition.Value<string>("competitionManagers") ?? "[]";
                int[] cmIds;
                try { cmIds = Newtonsoft.Json.JsonConvert.DeserializeObject<int[]>(cmJson) ?? Array.Empty<int>(); }
                catch { cmIds = Array.Empty<int>(); }
                bool isCompetitionManager = cmIds.Contains(memberData.Id)
                    || AuthService.HasRosterAppAccess(competition.Id, memberData.Id);

                // Check club admin from roles + regional admin from club's region
                bool isClubAdminForCompetition = false;
                var competitionClubId = competition.Value<int>("clubId");
                if (competitionClubId > 0)
                {
                    isClubAdminForCompetition = isSiteAdmin
                        || roles.Contains($"ClubAdmin_{competitionClubId}")
                        || roles.Any(r =>
                        {
                            if (!r.StartsWith("RegionalAdmin_")) return false;
                            var clubNode = Umbraco.Content(competitionClubId);
                            if (clubNode == null || clubNode.ContentType.Alias != "club") return false;
                            var clubRegion = clubNode.Value<string>("regionalFederation") ?? "";
                            return r == $"RegionalAdmin_{clubRegion}";
                        });
                }

                canManageCompetition = isSiteAdmin || isCompetitionManager || isClubAdminForCompetition;
            }
            else if (competitionId == 0)
            {
                // Allow access to competition selection if user is site admin or regional admin.
                // Regional admins only see competitions in their managed regions (filtered server-side).
                canManageCompetition = isSiteAdmin || isRegionalAdmin;
            }
        }
    }

    // Prepare shooting classes for registration modal (if competition exists)
    var allowDualCClassRegistration = false;
    var competitionShootingClasses = new List<HpskSite.Models.ShootingClass>();
    var aClasses = new List<HpskSite.Models.ShootingClass>();
    var aOptClasses = new List<HpskSite.Models.ShootingClass>();
    var aMClasses = new List<HpskSite.Models.ShootingClass>();
    var aPClasses = new List<HpskSite.Models.ShootingClass>();
    var aGClasses = new List<HpskSite.Models.ShootingClass>();
    var bClasses = new List<HpskSite.Models.ShootingClass>();
    var cClasses = new List<HpskSite.Models.ShootingClass>();
    var cRegularClasses = new List<HpskSite.Models.ShootingClass>();
    var cVetClasses = new List<HpskSite.Models.ShootingClass>();
    var cJuniorClasses = new List<HpskSite.Models.ShootingClass>();
    var cDamClasses = new List<HpskSite.Models.ShootingClass>();
    var rClasses = new List<HpskSite.Models.ShootingClass>();
    var lClasses = new List<HpskSite.Models.ShootingClass>();
    var lRegularClasses = new List<HpskSite.Models.ShootingClass>();
    var lVetClasses = new List<HpskSite.Models.ShootingClass>();
    var lJuniorClasses = new List<HpskSite.Models.ShootingClass>();
    var lDamClasses = new List<HpskSite.Models.ShootingClass>();
    var mClasses = new List<HpskSite.Models.ShootingClass>();
    var shootingClassIds = "";
    // Raw class-id list parsed from competition.shootingClassIds. Used both for the
    // legacy precision-flavoured groupings below AND for the walk-in dropdown further
    // down (which needs ALL ids — including Springskytte composites like "A-D 21" that
    // ShootingClasses.GetById can't resolve).
    var parsedShootingClassIds = new List<string>();
    var competitionType = ViewData["CompetitionType"]?.ToString() ?? "Precision";

    if (competition != null)
    {
        allowDualCClassRegistration = competition.Value<bool>("allowDualCClassRegistration");

        // Get shooting class IDs
        var shootingClassIdsRaw = competition.Value("shootingClassIds");
        shootingClassIds = "";

        // Handle different data types from Umbraco multiselect
        if (shootingClassIdsRaw is string[] stringArray)
        {
            shootingClassIds = string.Join(",", stringArray);
        }
        else if (shootingClassIdsRaw is IEnumerable<string> enumerable)
        {
            shootingClassIds = string.Join(",", enumerable);
        }
        else if (shootingClassIdsRaw is string stringValue)
        {
            shootingClassIds = stringValue ?? "";
        }
        else if (shootingClassIdsRaw != null)
        {
            // Try generic Value<T> approach for Flexible Dropdown
            try
            {
                var typed = competition.Value<IEnumerable<string>>("shootingClassIds");
                if (typed != null)
                {
                    shootingClassIds = string.Join(",", typed);
                }
            }
            catch
            {
                // Fallback to empty if all parsing fails
                shootingClassIds = "";
            }
        }

        // Parse shooting class IDs - handle JSON array format
        if (!string.IsNullOrEmpty(shootingClassIds))
        {
            // Check if it's a JSON array format: ["A1","B2"]
            if (shootingClassIds.StartsWith("[") && shootingClassIds.EndsWith("]"))
            {
                try
                {
                    // Parse JSON array manually (simple approach)
                    var jsonContent = shootingClassIds.Substring(1, shootingClassIds.Length - 2); // Remove [ and ]
                    parsedShootingClassIds.AddRange(jsonContent.Split(',')
                        .Select(s => s.Trim().Trim('"'))
                        .Where(s => !string.IsNullOrEmpty(s)));
                }
                catch
                {
                    // If JSON parsing fails, try as comma-separated
                    parsedShootingClassIds.AddRange(shootingClassIds.Split(',')
                        .Select(id => id.Trim())
                        .Where(id => !string.IsNullOrEmpty(id)));
                }
            }
            else
            {
                // Already comma-separated or single value
                parsedShootingClassIds.AddRange(shootingClassIds.Split(',')
                    .Select(id => id.Trim())
                    .Where(id => !string.IsNullOrEmpty(id)));
            }

            foreach (var id in parsedShootingClassIds)
            {
                var shootingClass = HpskSite.Models.ShootingClasses.GetById(id);
                if (shootingClass != null)
                {
                    competitionShootingClasses.Add(shootingClass);
                }
            }
        }

        // Group available shooting classes by weapon (so A_opt_X is its own group, not lumped into A).
        aClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A).ToList();
        aOptClasses = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_Opt).ToList();
        aMClasses   = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_M).ToList();
        aPClasses   = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_P).ToList();
        aGClasses   = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_G).ToList();
        bClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.B).ToList();
        cClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.C).ToList();
        rClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.R).ToList();
        lClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.L).ToList();
        mClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.M).ToList();

        // Subdivide C classes into subcategories for proper validation
        cRegularClasses = cClasses.Where(sc => sc.Id == "C1" || sc.Id == "C2" || sc.Id == "C3").ToList();
        cVetClasses = cClasses.Where(sc => sc.Id == "C_Vet_Y" || sc.Id == "C_Vet_A").ToList();
        cJuniorClasses = cClasses.Where(sc => sc.Id == "C_Jun").ToList();
        cDamClasses = cClasses.Where(sc => sc.Id.EndsWith("_Dam") && sc.Id.StartsWith("C")).ToList();

        // Subdivide L classes into subcategories (same structure as C)
        lRegularClasses = lClasses.Where(sc => sc.Id == "L1" || sc.Id == "L2" || sc.Id == "L3").ToList();
        lVetClasses = lClasses.Where(sc => sc.Id == "L_Vet_Y" || sc.Id == "L_Vet_A").ToList();
        lJuniorClasses = lClasses.Where(sc => sc.Id == "L_Jun").ToList();
        lDamClasses = lClasses.Where(sc => sc.Id.EndsWith("_Dam") && sc.Id.StartsWith("L")).ToList();
    }
}

@* Check if user is logged in *@
@if (currentMember == null)
{
    <div class="container-fluid mt-4">
        <div class="alert alert-warning">
            <h4>Åtkomst nekad</h4>
            <p>Du måste vara inloggad för att komma åt tävlingshanteringen.</p>
            <a href="/login-register/" class="btn btn-primary">Logga in</a>
        </div>
    </div>
    return;
}

@* Handle no competition selected or competition not found *@
@if (competition == null)
{
    @if (competitionId == 0)
    {
        @* Competition selection interface *@
        <div class="container-fluid mt-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1><i class="bi bi-gear me-2"></i>Tävlingshantering</h1>
                    <p class="text-muted mb-0">Välj en tävling att hantera</p>
                </div>
            </div>

            @if (isSiteAdmin || isRegionalAdmin)
            {
                <div class="card">
                    <div class="card-header">
                        <h5><i class="bi bi-list me-2"></i>Välj tävling att hantera</h5>
                    </div>
                    <div class="card-body">
                        <div id="competitionListLoading" class="text-center py-4">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Laddar...</span>
                            </div>
                            <p class="mt-2">Laddar tävlingar...</p>
                        </div>

                        <div id="competitionListContainer" class="d-none">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Tävling</th>
                                            <th>Datum</th>
                                            <th>Status</th>
                                            <th>Plats</th>
                                            <th>Åtgärd</th>
                                        </tr>
                                    </thead>
                                    <tbody id="competitionListBody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <h4>Åtkomst nekad</h4>
                    <p>Du har inte behörighet att komma åt tävlingshanteringen. Endast webbplatsadministratörer och tävlingsansvariga har åtkomst.</p>
                    <a href="/" class="btn btn-primary">Gå till startsidan</a>
                </div>
            }
        </div>

        <script>
        // Load competitions for selection
        $(document).ready(function() {
            if (@((isSiteAdmin || isRegionalAdmin) ? "true" : "false")) {
                loadCompetitionList();
            }
        });

        function loadCompetitionList() {
            fetch('/umbraco/surface/RegistrationAdmin/GetActiveCompetitions', {
                method: 'GET'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    populateCompetitionList(data.competitions || []);
                } else {
                    showCompetitionListError(data.message || 'Failed to load competitions');
                }
            })
            .catch(error => {
                console.error('Error loading competitions:', error);
                showCompetitionListError('Failed to load competitions. Please try again.');
            });
        }

        function populateCompetitionList(competitions) {
            const tbody = document.getElementById('competitionListBody');
            tbody.innerHTML = '';

            if (competitions.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No competitions found</td></tr>';
            } else {
                competitions.forEach(comp => {
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td><strong>${comp.name}</strong></td>
                        <td>-</td>
                        <td><span class="badge bg-secondary">Loading...</span></td>
                        <td>-</td>
                        <td>
                            <a href="/competitionmanagement?competitionId=${comp.id}" class="btn btn-primary btn-sm">
                                <i class="bi bi-gear me-1"></i>Manage
                            </a>
                        </td>
                    `;
                    tbody.appendChild(row);
                });
            }

            document.getElementById('competitionListLoading').classList.add('d-none');
            document.getElementById('competitionListContainer').classList.remove('d-none');
        }

        function showCompetitionListError(message) {
            const tbody = document.getElementById('competitionListBody');
            tbody.innerHTML = `<tr><td colspan="5" class="text-center text-danger py-4">Error: ${message}</td></tr>`;

            document.getElementById('competitionListLoading').classList.add('d-none');
            document.getElementById('competitionListContainer').classList.remove('d-none');
        }
        </script>

        return;
    }
    else
    {
        @* Competition not found with specific ID *@
        <div class="container-fluid mt-4">
            <div class="alert alert-danger">
                <h4>Tävlingen hittades inte</h4>
                <p>Den begärda tävlingen kunde inte hittas eller så är tävlings-ID ogiltigt.</p>
                <a href="/competitionmanagement/" class="btn btn-primary">Välj tävling</a>
                <a href="/competitions/" class="btn btn-outline-primary ms-2">Visa alla tävlingar</a>
            </div>
        </div>
        return;
    }
}

@* Check authorization *@
@if (!canManageCompetition)
{
    <div class="container-fluid mt-4">
        <div class="alert alert-warning">
            <h4>Access Denied</h4>
            <p>You do not have permission to manage this competition. Only competition managers and administrators can access this page.</p>
            <a href="@(competition?.CompetitionUrl() ?? "/")" class="btn btn-primary">Back to Competition</a>
        </div>
    </div>
    return;
}

<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>
                <i class="bi bi-gear me-2"></i>Tävlingshantering
            </h1>
            <p class="text-muted mb-0">
                Hanterar: <strong>@(competition?.Value<string>("competitionName") ?? "Okänd tävling")</strong>
            </p>
        </div>
        <div class="d-flex flex-column align-items-end gap-2">
            <div class="d-flex gap-2">
                <a href="@(competition?.CompetitionUrl() ?? "/")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Tillbaka till tävlingen
                </a>
                @if (canManageCompetition)
                {
                    var isExternalComp = competition?.Value<bool>("isExternal") ?? false;
                    <a href="/tavlingsplanering?c=@competitionId" class="btn btn-outline-primary" title="Planera tävlingen — förberedelser och bemanning">
                        <i class="bi bi-clipboard-check"></i> Planering
                    </a>
                    <button type="button" class="btn btn-outline-primary"
                            onclick="openEditCompetitionModal(@competitionId, @(isExternalComp ? "true" : "false"), '@competitionType')">
                        <i class="bi bi-pencil"></i> Redigera tävling
                    </button>
                }
            </div>
            @* Funktionärsmeddelanden — the discipline's staff-screen partial mounts its message button
               here (under the two buttons), so it sits with the page's top controls. *@
            <div id="evtInboxMount"></div>
        </div>
    </div>

    @* Anti-forgery token for AJAX requests *@
    @Html.AntiForgeryToken()

    @* Venue (Tävlingsplats/skjutbana) is set in each discipline's edit modal (standard, Springskytte,
       advert) via the shared _CompetitionRangePicker — the old standalone card here was removed once
       all edit modals covered it. *@

    @{
        // Funktionärer is the day-of operational hub (live functionary load + tävlingsledning message
        // console) for Precision-family + Springskytte — a major comp-management tab. The preparatory
        // work (Förberedelser + Bemanning) lives on the separate /tavlingsplanering page reached via the
        // "Planering" header button, since it relates to the comp rather than being part of running it.
        // See Documentation/COMPETITION_STAFFING_SYSTEM.md.
        var hasFunktionarerTab = (ViewData["CompetitionType"]?.ToString() ?? "Precision") is "Precision" or "MagnumPrecision" or "Springskytte";
    }
    <!-- Navigation tabs -->
    <ul class="nav nav-tabs" id="managementTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="registrations-tab" data-bs-toggle="tab" data-bs-target="#registrations" type="button" role="tab">
                <i class="bi bi-people me-1"></i>Anmälningar
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="startlists-tab" data-bs-toggle="tab" data-bs-target="#startlists" type="button" role="tab">
                <i class="bi bi-list-ol me-1"></i>Startlistor
            </button>
        </li>
        @if ((ViewData["CompetitionType"]?.ToString() ?? "Precision") is "Faltskytte" or "MagnumFalt")
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="stationer-tab" data-bs-toggle="tab" data-bs-target="#stationer" type="button" role="tab">
                    <i class="bi bi-geo-alt me-1"></i>Stationer
                </button>
            </li>
        }
        @if (hasFunktionarerTab)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="funktionarer-tab" data-bs-toggle="tab" data-bs-target="#funktionarer" type="button" role="tab">
                    <i class="bi bi-person-badge me-1"></i>Funktionärer
                </button>
            </li>
        }
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="results-tab" data-bs-toggle="tab" data-bs-target="#results" type="button" role="tab">
                <i class="bi bi-trophy me-1"></i>Resultat
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="deltagare-tab" data-bs-toggle="tab" data-bs-target="#deltagare" type="button" role="tab">
                <i class="bi bi-megaphone me-1"></i>Meddela deltagare
            </button>
        </li>
    </ul>

    <!-- Tab content -->
    <div class="tab-content" id="managementTabContent">
        <!-- Registrations Tab -->
        <div class="tab-pane fade show active" id="registrations" role="tabpanel">
            <div class="mt-3">
                @{
                    // Hand the partial the competition's actual allowed classes (id+name) so the
                    // walk-in modal's "Vapenklass" dropdown only offers what's valid here.
                    // Source from the raw parsed id list (NOT competitionShootingClasses) so
                    // Springskytte composite IDs like "A-D 21" — which ShootingClasses.GetById
                    // can't resolve — still appear in the dropdown. Name falls back to the id
                    // itself when the registry doesn't know it.
                    var availableShootingClasses = parsedShootingClassIds
                        .Select(id => new {
                            id,
                            name = HpskSite.Models.ShootingClasses.GetById(id)?.Name ?? id
                        })
                        .ToList();
                    var regViewData = new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } };
                    regViewData["AvailableShootingClasses"] = availableShootingClasses;
                    // Default the quick-create new-member club picker in the walk-in modal
                    // to the competition's organising club. Cashier almost always wants to
                    // add a guest into the host club; saves a click.
                    regViewData["CompetitionClubId"] = competition?.Value<int>("clubId") ?? 0;
                    // Walk-in patrol picker (item #5): only meaningful for Fältskytte/MagnumFält
                    // with rolling start enabled. The partial reads these to decide whether
                    // to render the Patrull dropdown in the walk-in modal.
                    regViewData["RollingStart"] = competition?.HasProperty("rollingStart") == true
                        ? (competition.Value<string>("rollingStart") ?? "")
                        : "";
                    // Walk-in slot picker (item #6): direktplacering / Egenbokning. The partial
                    // probes for `enabled` and renders a Skjutlag dropdown when set.
                    regViewData["DirektplaceringConfig"] = competition?.HasProperty("direktplaceringConfig") == true
                        ? (competition.Value<string>("direktplaceringConfig") ?? "")
                        : "";
                    // Deltävling: the partial renders a checkbox in the walk-in and edit
                    // modals when this is non-empty. Fee is recomputed server-side via
                    // RegistrationFeeCalculator, so we don't need to pass the fee here.
                    regViewData["SubCompetitionName"] = competition?.HasProperty("subCompetitionName") == true
                        ? (competition.Value<string>("subCompetitionName") ?? "")
                        : "";
                }
                @await Html.PartialAsync("CompetitionRegistrationManagement", regViewData)
            </div>
        </div>

        <!-- Start Lists Tab -->
        <div class="tab-pane fade" id="startlists" role="tabpanel">
            <div class="mt-3">
                @if ((ViewData["CompetitionType"]?.ToString() ?? "Precision") == "Springskytte")
                {
                    @await Html.PartialAsync("SpringskytteStartListManagement", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
                    @await Html.PartialAsync("SpringskytteStafettManagement", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
                }
                else if ((ViewData["CompetitionType"]?.ToString() ?? "Precision") is "Faltskytte" or "MagnumFalt")
                {
                    var slViewData = new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } };
                    var rsJsonStr = competition?.Value<string>("rollingStart") ?? "";
                    slViewData["RollingStart"] = rsJsonStr;
                    @await Html.PartialAsync("FaltskytteStartListManagement", slViewData)
                }
                else
                {
                    var isDp = false;
                    try { var dpJson = competition?.HasProperty("direktplaceringConfig") == true ? (competition.Value<string>("direktplaceringConfig") ?? "") : ""; isDp = dpJson.Contains("\"enabled\":true") || dpJson.Contains("\"Enabled\":true"); } catch { }
                    @await Html.PartialAsync("CompetitionStartListManagement", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId }, { "IsDirektplacering", isDp } })

                    // Finals start-list card — only for precision-family competitions that have finals series configured.
                    // The card itself further gates on snapshot existence, etc.
                    var numFinalSeries = 0;
                    try { numFinalSeries = competition?.HasProperty("numberOfFinalSeries") == true ? competition.Value<int>("numberOfFinalSeries") : 0; } catch { }
                    if (numFinalSeries > 0)
                    {
                        @await Html.PartialAsync("CompetitionFinalsStartListManagement", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
                    }
                }
            </div>
        </div>

        <!-- Results Tab -->
        <div class="tab-pane fade" id="results" role="tabpanel">
            <div class="mt-3">
                @{
                    var resultsViewData = new ViewDataDictionary(ViewData);
                    resultsViewData["CompetitionId"] = competitionId;
                    resultsViewData["CompetitionName"] = competition?.Value<string>("competitionName") ?? "Tävling";
                    resultsViewData["SubCompetitionName"] = competition?.HasProperty("subCompetitionName") == true ? competition.Value<string>("subCompetitionName") ?? "" : "";
                    // Result page URL — used by Fältskytte/Springskytte admin partials to embed the canonical /resultat/ view.
                    // Only set if a competitionResult child node named "Resultat" actually exists; otherwise the
                    // iframe would 404 ("Page not Found"). The partial falls back to a friendly inline message
                    // ("inga publicerade resultat ännu") when this is empty.
                    var resultChild = competition?.Children()?.FirstOrDefault(c => c.ContentType.Alias == "competitionResult" && c.Name == "Resultat");

                    // Safety net: for Fältskytte/MagnumFält comps the Resultat page should always exist
                    // (created eagerly when the comp is created or copied). If it's missing — legacy comp
                    // that pre-dates the eager creation, or some other edge case — quietly create it here
                    // on first view so the admin Resultat tab always works. Default state is Preliminär
                    // (isOfficial=false), so the public "Visa resultat"-button stays hidden until the
                    // admin explicitly clicks Officiell.
                    var compTypeForResultPage = competition?.Value<string>("competitionType");
                    if (resultChild == null && (compTypeForResultPage == "Faltskytte" || compTypeForResultPage == "MagnumFalt") && competition != null)
                    {
                        try
                        {
                            var compContent = ContentService.GetById(competition.Id);
                            if (compContent != null)
                            {
                                var existing = ContentService.GetPagedChildren(compContent.Id, 0, int.MaxValue, out _)
                                    .FirstOrDefault(c => c.ContentType.Alias == "competitionResult" && c.Name == "Resultat");
                                if (existing == null)
                                {
                                    var newResultPage = ContentService.Create("Resultat", compContent.Id, "competitionResult");
                                    newResultPage.SetValue("resultType", "Final Results");
                                    newResultPage.SetValue("isOfficial", false);
                                    newResultPage.SetValue("lastUpdated", DateTime.Now);
                                    ContentService.Save(newResultPage);
                                    ContentService.Publish(newResultPage, new[] { "*" }, -1);
                                }
                            }
                        }
                        catch { /* best effort — the partial will show the friendly empty-state if creation fails */ }
                        // URL is deterministic from the competition's URL + the "/resultat/" slug, even before
                        // the published cache picks up the just-created child.
                        resultsViewData["ResultPageUrl"] = competition.Url().TrimEnd('/') + "/resultat/";
                    }
                    else if (compTypeForResultPage == "Springskytte" && competition != null)
                    {
                        // Deterministic /resultat/ URL so the print buttons work even right after the
                        // first calculation (before the published cache picks up the new child node).
                        // The buttons themselves are only shown once a result list exists (client-side).
                        resultsViewData["ResultPageUrl"] = competition.Url().TrimEnd('/') + "/resultat/";
                    }
                    else
                    {
                        resultsViewData["ResultPageUrl"] = resultChild != null ? (resultChild.Url().TrimEnd('/') + "/") : "";
                    }
                    // NumberOfSeriesOrStations is already in ViewData from line 39
                }
                @if ((ViewData["CompetitionType"]?.ToString() ?? "Precision") == "Springskytte")
                {
                    @await Html.PartialAsync("SpringskytteResultsManagement", resultsViewData)
                    @await Html.PartialAsync("SpringskytteLagResults", resultsViewData)
                    @await Html.PartialAsync("SpringskytteStafettResults", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
                }
                else if ((ViewData["CompetitionType"]?.ToString() ?? "Precision") is "Faltskytte" or "MagnumFalt")
                {
                    @await Html.PartialAsync("FaltskytteResultsManagement", resultsViewData)
                }
                else
                {
                    @await Html.PartialAsync("CompetitionResultsManagement", resultsViewData)
                }
            </div>
        </div>

        @if ((ViewData["CompetitionType"]?.ToString() ?? "Precision") is "Faltskytte" or "MagnumFalt")
        {
            <!-- Stationer Tab -->
            <div class="tab-pane fade" id="stationer" role="tabpanel">
                <div class="mt-3">
                    @await Html.PartialAsync("FaltskytteStationerManagement", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
                </div>
            </div>
        }

        @if (hasFunktionarerTab)
        {
            <!-- Funktionärer Tab (day-of hub: live functionary load + tävlingsledning message console) -->
            <div class="tab-pane fade" id="funktionarer" role="tabpanel">
                <div class="mt-3">
                    @if ((ViewData["CompetitionType"]?.ToString() ?? "Precision") == "Springskytte")
                    {
                        @await Html.PartialAsync("SpringskytteFunktionarerManagement", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
                    }
                    else
                    {
                        @await Html.PartialAsync("PrecisionFunktionarerManagement", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
                    }
                </div>
            </div>
        }

        <!-- Meddela deltagare Tab (organizer → registered shooters: web-push + in-app inbox) -->
        <div class="tab-pane fade" id="deltagare" role="tabpanel">
            @await Html.PartialAsync("ParticipantNotificationComposer", new ViewDataDictionary(ViewData) { { "CompetitionId", competitionId } })
        </div>

    </div>
</div>

@* Tävlingsledningens meddelandekonsol mounts on #evtInboxMount from each discipline's hub-tab partial:
   Fältskytte → Stationer, Precision/MagnumPrecision + Springskytte → Funktionärer. No generic block
   needed here anymore. *@

<script>
// Competition Management JavaScript
const competitionId = @competitionId;

// Load data on page ready
$(document).ready(function() {
    // Overview tab removed - no stats to load
});

// Removed loadOverviewStats() function - overview tab no longer exists
function loadOverviewStats_REMOVED() {
    // Load registration statistics
    fetch(`/umbraco/surface/Competition/GetCompetitionRegistrations?competitionId=${competitionId}`, {
        method: 'GET',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            const registrations = data.registrations || [];
            const activeRegistrations = registrations.filter(r => r.isActive);
            const maxParticipants = @(competition?.Value<int>("maxParticipants", fallback: Fallback.ToDefaultValue, defaultValue: 0) ?? 0);

            document.getElementById('totalRegistrationsCount').textContent = registrations.length;
            document.getElementById('activeRegistrationsCount').textContent = activeRegistrations.length;
            
            // Update progress bar
            if (maxParticipants > 0) {
                const percentage = Math.min(100, Math.round((activeRegistrations.length / maxParticipants) * 100));
                const progressBar = document.getElementById('registrationsProgress');
                progressBar.style.width = `${percentage}%`;
                
                // Change color based on capacity
                if (percentage >= 90) {
                    progressBar.classList.remove('bg-primary', 'bg-warning');
                    progressBar.classList.add('bg-danger');
                } else if (percentage >= 70) {
                    progressBar.classList.remove('bg-primary', 'bg-danger');
                    progressBar.classList.add('bg-warning');
                } else {
                    progressBar.classList.remove('bg-warning', 'bg-danger');
                    progressBar.classList.add('bg-primary');
                }
            }
        } else {
            document.getElementById('totalRegistrationsCount').textContent = 'Error';
            document.getElementById('activeRegistrationsCount').textContent = 'Error';
        }
    })
    .catch(error => {
        console.error('Error loading registration stats:', error);
        document.getElementById('totalRegistrationsCount').textContent = 'Error';
        document.getElementById('activeRegistrationsCount').textContent = 'Error';
    });

    // Load start list statistics
    fetch(`/umbraco/surface/PrecisionStartList/GetStartLists?competitionId=${competitionId}`, {
        method: 'GET'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            const startLists = data.startLists || [];
            document.getElementById('startListsCount').textContent = startLists.length;
        } else {
    document.getElementById('startListsCount').textContent = '0';
        }
    })
    .catch(error => {
        console.error('Error loading start list stats:', error);
        document.getElementById('startListsCount').textContent = 'Error';
    });

    // Load results statistics
    fetch(`/umbraco/surface/CompetitionResults/GetResultsStats?competitionId=${competitionId}`, {
        method: 'GET'
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('resultsCount').textContent = data.count || '0';
        } else {
    document.getElementById('resultsCount').textContent = '0';
        }
    })
    .catch(error => {
        console.error('Error loading results stats:', error);
        document.getElementById('resultsCount').textContent = 'Error';
    });

    // Calculate days to competition
    const competitionDate = new Date('@(competition?.Value<DateTime>("competitionDate", fallback: Fallback.ToDefaultValue, defaultValue: DateTime.Now).ToString("yyyy-MM-dd") ?? DateTime.Now.ToString("yyyy-MM-dd"))');
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    const timeDiff = competitionDate.getTime() - today.getTime();
    const daysDiff = Math.ceil(timeDiff / (1000 * 3600 * 24));
    
    const daysElement = document.getElementById('daysToCompetition');
    if (daysDiff > 0) {
        daysElement.textContent = daysDiff;
        daysElement.classList.remove('bg-success', 'bg-warning');
        daysElement.classList.add('bg-danger');
    } else if (daysDiff === 0) {
        daysElement.textContent = 'Idag!';
        daysElement.classList.remove('bg-danger', 'bg-warning');
        daysElement.classList.add('bg-success');
    } else {
        daysElement.textContent = `${Math.abs(daysDiff)} dagar sedan`;
        daysElement.classList.remove('bg-danger', 'bg-success');
        daysElement.classList.add('bg-warning');
    }
    
    // Update last updated timestamp
    document.getElementById('lastUpdated').textContent = new Date().toLocaleTimeString();
}

function refreshAllData() {
    // Overview tab removed - no stats to load
    // Refresh active tabs if needed
    const activeTab = document.querySelector('.tab-pane.active');
    if (activeTab) {
        // Trigger refresh for active tab
        if (activeTab.id === 'registrations' && window.loadCompetitionRegistrations) {
            window.loadCompetitionRegistrations();
        }
    }
}

function generateStartList() {
    // Navigate to start lists tab and trigger the create start list button
    document.getElementById('startlists-tab').click();
    setTimeout(() => {
        const createButton = document.querySelector('.create-start-list-btn');
        if (createButton) {
            createButton.click();
        }
    }, 500);
}

function openResultsTab() {
    // Navigate to results tab
    document.getElementById('results-tab').click();
}
</script>

