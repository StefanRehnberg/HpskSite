@using Microsoft.AspNetCore.Mvc.ViewFeatures
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    var competitionId = ViewData["CompetitionId"]?.ToString() ?? "0";
    var competitionName = ViewData["CompetitionName"]?.ToString() ?? "Tävling";
    var presetWeaponClass = ViewData["PresetWeaponClass"]?.ToString() ?? "";
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Startlinje – @competitionName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background:#0b0f14; color:#e9edf1; font-family:system-ui,sans-serif; margin:0; padding:1rem; }
        .wrap { max-width:1100px; margin:0 auto; }
        .clock { font-variant-numeric:tabular-nums; font-weight:800; font-size:6rem; line-height:1; text-align:center; letter-spacing:2px; }
        .clock-label { text-align:center; color:#8b98a5; text-transform:uppercase; letter-spacing:3px; font-size:.8rem; }
        .next-card { border-radius:1rem; padding:1.5rem; text-align:center; transition:background .2s; background:#16202b; }
        .next-card.warn { background:#3a3420; }
        .next-card.hot  { background:#4a2a12; }
        .next-card.go   { background:#123a1c; }
        .countdown { font-variant-numeric:tabular-nums; font-weight:800; font-size:5rem; line-height:1; }
        .bib { font-size:1.4rem; color:#8b98a5; }
        .shooter-name { font-size:2.2rem; font-weight:700; }
        .after { color:#8b98a5; }
        .go-flash { animation:flash .5s ease-in-out 3; }
        @@keyframes flash { 0%,100%{background:#123a1c} 50%{background:#1f8f3a} }
        .rm-panel { background:#16202b; border-radius:.75rem; }
        .table-dark-2 { --bs-table-bg:#111922; color:#e9edf1; }
        .noshow { color:#ffb020; }
        select, .form-control { background:#0b0f14; color:#e9edf1; border-color:#33414f; }
        select:focus, .form-control:focus { background:#0b0f14; color:#e9edf1; }
    </style>
</head>
<body>
<div class="wrap">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div>
            <a href="/competitionmanagement?competitionId=@competitionId" class="text-secondary text-decoration-none me-3" title="Tillbaka till tävlingshanteringen"><i class="bi bi-arrow-left"></i> Till tävlingen</a>
            <i class="bi bi-flag me-2"></i><span class="h5">@competitionName</span> <span class="text-secondary">— Startlinje</span>
            @if (!string.IsNullOrEmpty(presetWeaponClass)) { <span class="badge bg-info text-dark ms-1">Vapengrupp @presetWeaponClass</span> }
        </div>
        <div class="d-flex align-items-center gap-2">
            <span id="connBadge" class="badge bg-secondary" title="Nätverksstatus"><i class="bi bi-wifi"></i></span>
            <button id="wakeBtn" class="btn btn-outline-secondary btn-sm" title="Hindra skärmen från att slockna"><i class="bi bi-display me-1"></i>Håll skärmen vaken</button>
            <button id="soundBtn" class="btn btn-outline-warning btn-sm"><i class="bi bi-volume-up me-1"></i>Aktivera ljud</button>
            <button id="rmBtn" class="btn btn-outline-info btn-sm"><i class="bi bi-tools me-1"></i>Startledare</button>
            <span id="evtMountSpringStarter" style="display:none"></span>
        </div>
    </div>

    <!-- Weapon-class chooser (shown only when no ?s= given — A and C are independent start lines). -->
    <div id="classChooser" style="display:none">
        <div class="clock-label mt-4 mb-3">Välj vapengrupp</div>
        <div id="classChooserBtns" class="d-flex flex-column gap-3" style="max-width:480px;margin:0 auto"></div>
    </div>

    <div id="starterMain" style="@(string.IsNullOrEmpty(presetWeaponClass) ? "display:none" : "")">
    <div class="clock-label">Klockan är</div>
    <div id="clock" class="clock mb-1">--:--:--</div>

    <!-- Schedule-slip offset (P3): shift the countdowns when the line runs late. Display-only, per device.
         Admin control — only shown in Startledare-läge, never on the shooter-facing wall screen. -->
    <div class="text-center mb-3" id="offsetRow" style="font-size:.9rem;display:none">
        <span class="text-secondary me-2"><i class="bi bi-hourglass-split me-1"></i>Körs sent:</span>
        <button id="offMinus" class="btn btn-outline-secondary btn-sm py-0">−30s</button>
        <span id="offVal" class="mx-2 fw-bold" style="font-variant-numeric:tabular-nums">0:00</span>
        <button id="offPlus" class="btn btn-outline-secondary btn-sm py-0">+30s</button>
        <button id="offReset" class="btn btn-outline-secondary btn-sm py-0 ms-2">Nollställ</button>
    </div>

    <div class="row g-3 align-items-stretch">
        <div class="col-md-7">
            <div id="nextCard" class="next-card h-100">
                <div class="bib">Nästa start <span id="nextTime"></span></div>
                <div id="nextName" class="shooter-name">–</div>
                <div id="nextClass" class="mb-2 text-secondary"></div>
                <div id="countdown" class="countdown">--</div>
                <div id="cueText" class="mt-2" style="height:1.6rem;font-weight:700"></div>
                <div id="nextAdj" class="small mt-1"></div>
                <!-- Quick actions on the current shooter (P2) — admin only. NOTE: no .d-flex class here;
                     its display:flex !important would beat the inline display toggle. Flex is set via style. -->
                <div id="nextActions" class="mt-3 gap-2 justify-content-center flex-wrap" style="display:none">
                    <button id="qsDns" class="btn btn-outline-warning btn-sm"><i class="bi bi-x-octagon me-1"></i>Startade inte</button>
                    <button id="qsBump" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-right-circle me-1"></i>Flytta fram</button>
                    <button id="qsAdj" class="btn btn-outline-danger btn-sm"><i class="bi bi-exclamation-triangle me-1"></i>Straff / tillägg</button>
                </div>
                <div id="qsMsg" class="small mt-2"></div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="next-card h-100">
                <div class="bib">Därefter</div>
                <div id="afterName" class="after" style="font-size:1.4rem;font-weight:600">–</div>
                <div id="afterMeta" class="after"></div>
                <hr style="border-color:#33414f">
                <div class="bib">Kommande</div>
                <div id="upcoming" class="after small text-start" style="max-height:150px;overflow:auto"></div>
            </div>
        </div>
    </div>

    <!-- Range-master move tool (item 8) -->
    <div id="rmPanel" class="rm-panel p-3 mt-3" style="display:none">
        <h6 class="mb-3"><i class="bi bi-arrow-left-right me-1"></i>Flytta skytt / markera DNS</h6>
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Skytt</label>
                <select id="moveShooter" class="form-select form-select-sm"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Ledig lucka</label>
                <select id="moveSlot" class="form-select form-select-sm"></select>
            </div>
            <div class="col-md-2">
                <button id="moveApply" class="btn btn-primary btn-sm w-100"><i class="bi bi-arrow-left-right me-1"></i>Flytta</button>
            </div>
            <div class="col-md-3">
                <button id="dnsToggle" class="btn btn-outline-warning btn-sm w-100"><i class="bi bi-x-octagon me-1"></i>Markera DNS</button>
            </div>
        </div>
        <div class="form-text">En lucka är ledig bara om den är en paus, efter sista start, eller frigjord av en DNS. Ej incheckad betyder inte ledig.</div>
        <div id="moveMsg" class="small mt-2"></div>

        <hr style="border-color:#33414f">
        <div class="d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-exclamation-triangle me-1"></i>Straff &amp; tidsavdrag <span class="text-secondary small" id="adjForName"></span></h6>
            <button id="adjOpenBtn" class="btn btn-outline-danger btn-sm"><i class="bi bi-plus-lg me-1"></i>Lägg till</button>
        </div>
        <div id="adjList" class="mt-2"></div>
        <div class="form-text">Straff läggs till för den skytt som är vald ovan. Läggs i samma huvudbok som tidtagningen.</div>
    </div>
    </div><!-- /#starterMain -->

    <!-- Straff/tidsavdrag modal (P2) — same fields as the timekeeper card -->
    <div class="modal fade" id="adjModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background:#16202b;color:#e9edf1">
                <div class="modal-header" style="border-color:#33414f">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Straff / tidsavdrag</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Stäng"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3"><strong id="adjName">–</strong> <span class="text-secondary" id="adjClass"></span></p>
                    <div class="btn-group w-100 mb-3" role="group">
                        <input type="radio" class="btn-check" name="adjType" id="adjPenalty" value="Penalty" checked>
                        <label class="btn btn-outline-danger" for="adjPenalty">Straff (+ min)</label>
                        <input type="radio" class="btn-check" name="adjType" id="adjReduction" value="Reduction">
                        <label class="btn btn-outline-success" for="adjReduction">Tidsavdrag (− tid)</label>
                    </div>
                    <div id="adjPenaltyFields">
                        <label class="form-label small">Antal straffminuter (1 min per straff)</label>
                        <input type="number" class="form-control mb-2" id="adjPoints" value="1" min="1" max="60">
                    </div>
                    <div id="adjReductionFields" style="display:none">
                        <label class="form-label small">Tidsavdrag (MM:SS)</label>
                        <input type="text" class="form-control mb-2" id="adjTime" placeholder="MM:SS">
                    </div>
                    <label class="form-label small">Anledning</label>
                    <select class="form-select mb-2" id="adjReasonSelect"></select>
                    <input type="text" class="form-control" id="adjReasonText" placeholder="Egen anledning (valfritt)">
                    <div class="alert alert-danger mt-3 mb-0 py-2 d-none" id="adjError"></div>
                </div>
                <div class="modal-footer" style="border-color:#33414f">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn btn-primary" id="adjSaveBtn"><i class="bi bi-check-lg me-1"></i>Lägg till</button>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="afToken" value="@tokens.RequestToken" />

@* Startledarens funktionärsinbox — only surfaced in Startledare-läge (operator), never on the
   public wall view. Anchored in the toolbar next to the other operator controls. *@
@await Html.PartialAsync("_EventMessageInbox")

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script>
const COMP = @competitionId;
const PRESET_WC = '@presetWeaponClass';
let state = { starters: [], freeSlots: [], adjustments: [] };
let curNext = null; // the shooter shown in the "Nästa start" card (target of the quick actions)

// ---------- schedule-slip offset (P3): shift countdowns when the line runs late ----------
const OFF_KEY = 'hpsk_startlinje_offset_' + COMP + '_' + (PRESET_WC || 'x');
let offsetSec = parseInt(localStorage.getItem(OFF_KEY) || '0', 10) || 0;
function fmtOffset(s) { const m = Math.floor(s / 60), ss = s % 60; return m + ':' + String(ss).padStart(2, '0'); }
function renderOffset() { const el = document.getElementById('offVal'); if (el) el.textContent = fmtOffset(offsetSec); }
function nudgeOffset(delta) { offsetSec = Math.max(0, offsetSec + delta); localStorage.setItem(OFF_KEY, offsetSec); renderOffset(); }

// ---------- audio ----------
let audioCtx = null;
function ensureAudio() {
    if (!audioCtx) { try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return; } }
    if (audioCtx.state === 'suspended') audioCtx.resume();
}
function beep(freq, durMs) {
    if (!audioCtx) return;
    const o = audioCtx.createOscillator(), g = audioCtx.createGain();
    o.frequency.value = freq; o.type = 'square'; o.connect(g); g.connect(audioCtx.destination);
    const t = audioCtx.currentTime;
    g.gain.setValueAtTime(0.0001, t);
    g.gain.exponentialRampToValueAtTime(0.35, t + 0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, t + durMs / 1000);
    o.start(t); o.stop(t + durMs / 1000 + 0.03);
}
document.getElementById('soundBtn').addEventListener('click', () => {
    ensureAudio(); beep(880, 120);
    document.getElementById('soundBtn').innerHTML = '<i class="bi bi-volume-up me-1"></i>Ljud på';
    document.getElementById('soundBtn').classList.replace('btn-outline-warning', 'btn-warning');
});
// "Startledare-läge" reveals ALL admin controls (offset row, the quick actions in the Nästa-start
// card, and the move/straff panel). Default = clean shooter-facing wall view. Persisted per device
// so the manager's pad stays in admin mode while the wall screen stays clean.
const ADMIN_KEY = 'hpsk_startlinje_admin_' + COMP + '_' + (PRESET_WC || 'x');
let adminMode = localStorage.getItem(ADMIN_KEY) === '1';
let evtInited = false;
function ensureStarterInbox() {
    // Lazily start the inbox the first time the operator enters Startledare-läge. The public wall
    // view never mounts it (and never polls the messaging endpoints).
    if (evtInited || !PRESET_WC || !window.EventInbox) return;
    evtInited = true;
    EventInbox.init({
        competitionId: COMP,
        mountSelector: '#evtMountSpringStarter',
        label: 'Startlinje ' + PRESET_WC,
        // A and C never run at the same time — there is one physical line, so messaging is role-based
        // (no per-class scope). Matches the roles + "Alla funktionärer" model of the other disciplines.
        fromScope: { type: 'Role', key: 'startledare' },
        scopes: [
            { type: 'Role', key: 'startledare' }
        ],
        // The three Springskytte staff roles (each has its own per-class screen) + tävlingsledningen.
        recipients: [
            { type: 'All', label: 'Alla funktionärer' },
            { type: 'Role', key: 'startledare', label: 'Startledare' },
            { type: 'Role', key: 'timer', label: 'Tidtagare' },
            { type: 'Role', key: 'scorer', label: 'Poängräknare' },
            { type: 'Role', key: 'ledning', label: 'Tävlingsledning' }
        ]
    });
}
function applyAdminMode() {
    document.getElementById('rmPanel').style.display = adminMode ? 'block' : 'none';
    document.getElementById('offsetRow').style.display = adminMode ? '' : 'none';
    const mount = document.getElementById('evtMountSpringStarter');
    if (mount) mount.style.display = adminMode ? '' : 'none';
    const btn = document.getElementById('rmBtn');
    btn.classList.toggle('btn-info', adminMode);
    btn.classList.toggle('btn-outline-info', !adminMode);
    if (adminMode) { buildMovePickers(); ensureStarterInbox(); }
    // The quick-action buttons in the card are toggled inside tick() (they also need a current shooter).
}
document.getElementById('rmBtn').addEventListener('click', () => {
    adminMode = !adminMode;
    localStorage.setItem(ADMIN_KEY, adminMode ? '1' : '0');
    applyAdminMode();
});
// offset controls
document.getElementById('offMinus').addEventListener('click', () => nudgeOffset(-30));
document.getElementById('offPlus').addEventListener('click', () => nudgeOffset(30));
document.getElementById('offReset').addEventListener('click', () => nudgeOffset(-offsetSec));

// ---------- wake lock (keep the big clock awake) ----------
let wakeLock = null, wakeWanted = false;
async function acquireWake() {
    if (!('wakeLock' in navigator)) return false;
    try { wakeLock = await navigator.wakeLock.request('screen'); wakeLock.addEventListener('release', () => { wakeLock = null; }); return true; }
    catch (e) { return false; }
}
function renderWakeBtn() {
    const btn = document.getElementById('wakeBtn');
    if (wakeWanted) { btn.innerHTML = '<i class="bi bi-display-fill me-1"></i>Skärm vaken'; btn.classList.replace('btn-outline-secondary', 'btn-secondary'); }
    else { btn.innerHTML = '<i class="bi bi-display me-1"></i>Håll skärmen vaken'; btn.classList.replace('btn-secondary', 'btn-outline-secondary'); }
}
document.getElementById('wakeBtn').addEventListener('click', async () => {
    if (wakeWanted) { wakeWanted = false; if (wakeLock) { try { await wakeLock.release(); } catch (e) {} wakeLock = null; } }
    else {
        wakeWanted = true;
        if (!('wakeLock' in navigator)) { document.getElementById('wakeBtn').innerHTML = '<i class="bi bi-x me-1"></i>Stöds ej'; wakeWanted = false; return; }
        await acquireWake();
    }
    renderWakeBtn();
});
// Re-acquire after the tab was hidden (the OS releases the lock automatically).
document.addEventListener('visibilitychange', async () => { if (wakeWanted && !wakeLock && document.visibilityState === 'visible') await acquireWake(); });

// ---------- connectivity indicator ----------
function setConn(online) {
    const el = document.getElementById('connBadge');
    if (!el) return;
    if (online) { el.className = 'badge bg-success'; el.innerHTML = '<i class="bi bi-wifi"></i>'; el.title = 'Uppkopplad'; }
    else { el.className = 'badge bg-danger'; el.innerHTML = '<i class="bi bi-wifi-off"></i> Ingen kontakt'; el.title = 'Ingen kontakt med servern — åtgärder sparas inte'; }
}

// ---------- time helpers ----------
function hmsToSec(t) {
    if (!t) return null;
    const p = String(t).split(':').map(Number);
    if (p.length === 3) return p[0] * 3600 + p[1] * 60 + p[2];
    if (p.length === 2) return p[0] * 3600 + p[1] * 60;
    return null;
}
function nowSec() { const d = new Date(); return d.getHours() * 3600 + d.getMinutes() * 60 + d.getSeconds(); }
// "now" adjusted for a late-running line: treat now as offsetSec earlier so each scheduled
// start's countdown lands when it actually happens. Clock display still shows real wall time.
function effNow() { return nowSec() - offsetSec; }
function fmtClock(d) { return String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0') + ':' + String(d.getSeconds()).padStart(2,'0'); }

// ---------- data ----------
async function loadState() {
    try {
        const r = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteStarterState?competitionId=${COMP}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const d = await r.json();
        if (d.success) {
            let starters = d.starters || [], freeSlots = d.freeSlots || [];
            // Scope to one weapon group so A and C are never interleaved into one line.
            if (PRESET_WC) {
                starters = starters.filter(s => s.weaponClass === PRESET_WC);
                freeSlots = freeSlots.filter(f => f.weaponClass === PRESET_WC);
            }
            state.starters = starters; state.freeSlots = freeSlots;
        }
        // Straff/tidsavdrag ledger (same source as the timekeeper card).
        const ar = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteAdjustments?competitionId=${COMP}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const ad = await ar.json();
        state.adjustments = ad.success ? (ad.adjustments || []) : [];
        setConn(true);
    } catch (e) { setConn(false); /* keep last */ }
}
function adjustmentsFor(memberId, weaponClass) {
    return (state.adjustments || []).filter(a => a.memberId === memberId && a.weaponClass === weaponClass);
}
function adjBadgesHtml(list) {
    if (!list.length) return '';
    return list.map(a => {
        const isPen = a.adjustmentType === 'Penalty';
        let label;
        if (isPen) label = '+' + a.points + ' min';
        else { const mag = Math.abs(a.seconds); label = '−' + (mag % 60 === 0 ? (mag / 60) + ' min' : mag + ' s'); }
        return `<span class="badge ${isPen ? 'bg-danger' : 'bg-success'} me-1 mb-1" title="${escapeHtml(a.reason || '')}">${label}</span>`;
    }).join('');
}

// When no ?s= is given, present a chooser — each weapon group is its own start line.
async function showClassChooser() {
    let classes = [];
    try {
        const r = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteStarterState?competitionId=${COMP}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const d = await r.json();
        if (d.success) classes = [...new Set((d.starters || []).map(s => s.weaponClass))].sort();
    } catch (e) { /* fall through */ }
    if (!classes.length) classes = ['A', 'C']; // fallback so the page is never a dead end
    document.getElementById('classChooserBtns').innerHTML = classes.map(c =>
        `<a class="btn btn-info btn-lg py-3 fs-4 fw-bold" href="/startlinje/${COMP}?s=${encodeURIComponent(c)}"><i class="bi bi-flag me-2"></i>Startlinje – Vapengrupp ${c}</a>`).join('');
    document.getElementById('classChooser').style.display = 'block';
}

// ---------- cues ----------
const CUES = [30, 10, 3, 2, 1, 0];
let firedCues = {}; // key `${startTime}:${threshold}` -> true

function fireCue(threshold) {
    ensureAudio();
    const cue = document.getElementById('cueText');
    if (threshold === 30) { beep(880, 140); cue.textContent = '30 sekunder'; }
    else if (threshold === 10) { beep(880, 140); cue.textContent = '10 sekunder'; }
    else if (threshold === 3 || threshold === 2 || threshold === 1) { beep(660, 130); cue.textContent = String(threshold); }
    else if (threshold === 0) {
        beep(1320, 550); cue.textContent = 'START!';
        const c = document.getElementById('nextCard'); c.classList.add('go-flash');
        setTimeout(() => c.classList.remove('go-flash'), 1600);
    }
}

// ---------- render ----------
function upcomingStarters() {
    const n = effNow();
    // upcoming = start time >= now-5s (keep the one just started visible briefly), ordered by time.
    // DNS shooters drop off the line entirely.
    return state.starters
        .filter(s => !s.isDns)
        .filter(s => { const t = hmsToSec(s.startTime); return t != null && t >= n - 5; })
        .sort((a, b) => hmsToSec(a.startTime) - hmsToSec(b.startTime));
}

function tick() {
    const d = new Date();
    document.getElementById('clock').textContent = fmtClock(d);
    const n = effNow();
    const up = upcomingStarters();
    const next = up[0], after = up[1];

    const card = document.getElementById('nextCard');
    card.classList.remove('warn', 'hot', 'go');

    if (next) {
        const t = hmsToSec(next.startTime);
        const rem = t - n;
        document.getElementById('nextTime').textContent = '(' + next.startTime.substring(0,5) + ')';
        document.getElementById('nextName').innerHTML = '<span class="bib">#' + next.startOrder + '</span> ' + escapeHtml(next.name)
            + (next.checkedIn === false ? ' <span class="noshow">⚠ ej incheckad</span>' : '');
        document.getElementById('nextClass').textContent = next.weaponClass + ' · ' + next.ageGenderClass + (next.listName ? ' · ' + next.listName : '');
        document.getElementById('countdown').textContent = rem >= 0 ? fmtCountdown(rem) : 'GÅTT';
        if (rem <= 3) card.classList.add('go'); else if (rem <= 10) card.classList.add('hot'); else if (rem <= 30) card.classList.add('warn');

        // fire cues on crossing
        for (const thr of CUES) {
            const key = next.startTime + ':' + thr;
            if (rem <= thr && rem >= thr - 1 && !firedCues[key]) { firedCues[key] = true; fireCue(thr); }
        }
        curNext = next;
        document.getElementById('nextActions').style.display = adminMode ? 'flex' : 'none';
        // Penalties on the current shooter are relevant to the manager; hide on the clean wall view.
        document.getElementById('nextAdj').innerHTML = adminMode ? adjBadgesHtml(adjustmentsFor(next.memberId, next.weaponClass)) : '';
    } else {
        document.getElementById('nextTime').textContent = '';
        document.getElementById('nextName').textContent = 'Inga fler starter';
        document.getElementById('nextClass').textContent = '';
        document.getElementById('countdown').textContent = '--';
        document.getElementById('cueText').textContent = '';
        curNext = null;
        document.getElementById('nextActions').style.display = 'none';
        document.getElementById('nextAdj').innerHTML = '';
    }

    if (after) {
        document.getElementById('afterName').innerHTML = '#' + after.startOrder + ' ' + escapeHtml(after.name);
        document.getElementById('afterMeta').textContent = after.startTime.substring(0,5) + ' · ' + after.weaponClass + ' ' + after.ageGenderClass;
    } else {
        document.getElementById('afterName').textContent = '–';
        document.getElementById('afterMeta').textContent = '';
    }

    // upcoming list (next 6 after the "after")
    const list = up.slice(2, 8).map(s =>
        `<div>${s.startTime.substring(0,5)} · #${s.startOrder} ${escapeHtml(s.name)}${s.checkedIn === false ? ' <span class="noshow">⚠</span>' : ''}</div>`).join('');
    document.getElementById('upcoming').innerHTML = list || '<span class="text-secondary">–</span>';
}

function fmtCountdown(sec) {
    if (sec < 60) return String(sec);
    const m = Math.floor(sec / 60), s = sec % 60;
    return m + ':' + String(s).padStart(2, '0');
}
function escapeHtml(s) { return (s || '').replace(/[&<>"]/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c])); }

// ---------- RM move tool ----------
function buildMovePickers() {
    const n = nowSec();
    const shooterSel = document.getElementById('moveShooter');
    const slotSel = document.getElementById('moveSlot');
    // candidate shooters: everyone with a time, ordered by time; DNS + not-checked-in flagged
    const cand = state.starters
        .filter(s => hmsToSec(s.startTime) != null)
        .sort((a, b) => hmsToSec(a.startTime) - hmsToSec(b.startTime));
    shooterSel.innerHTML = cand.map(s => {
        const flags = (s.isDns ? ' [DNS]' : '') + (s.checkedIn === false ? ' (ej incheckad)' : '');
        return `<option value="${s.nodeId}|${s.memberId}|${s.weaponClass}|${s.startOrder}">${s.startTime.substring(0,5)} #${s.startOrder} ${escapeHtml(s.name)}${flags}</option>`;
    }).join('');

    buildSlotOptions();
    updateDnsToggleLabel();
    adjRefresh();
}

// Slots are restricted to the selected shooter's weapon class — classes are never mixed
// (separate sequences, often different days).
function buildSlotOptions() {
    const n = nowSec();
    const slotSel = document.getElementById('moveSlot');
    const sel = selectedMoveShooter();
    const wc = sel ? sel.weaponClass : null;
    const slotList = (state.freeSlots || [])
        .filter(f => !wc || f.weaponClass === wc)
        .filter(f => hmsToSec(f.time) >= n - 5)
        .sort((a, b) => hmsToSec(a.time) - hmsToSec(b.time));
    slotSel.innerHTML = slotList.map(f => {
        const label = f.kind === 'dns' ? ('ledig – ' + (f.freedFrom || 'DNS')) : (f.kind === 'efter' ? 'efter sista' : 'paus');
        return `<option value="${f.time}">${f.time.substring(0,5)} – ${label}</option>`;
    }).join('') || '<option value="">Inga lediga luckor</option>';
}

function selectedMoveShooter() {
    const v = document.getElementById('moveShooter').value;
    if (!v) return null;
    const [nodeId, memberId, weaponClass, startOrder] = v.split('|');
    return { nodeId: +nodeId, memberId: +memberId, weaponClass, startOrder: +startOrder };
}
function updateDnsToggleLabel() {
    const sel = selectedMoveShooter();
    const btn = document.getElementById('dnsToggle');
    if (!sel) { btn.innerHTML = '<i class="bi bi-x-octagon me-1"></i>Markera DNS'; return; }
    const s = state.starters.find(x => x.memberId === sel.memberId && x.weaponClass === sel.weaponClass);
    if (s && s.isDns) { btn.innerHTML = '<i class="bi bi-arrow-counterclockwise me-1"></i>Ångra DNS'; btn.classList.remove('btn-outline-warning'); btn.classList.add('btn-outline-secondary'); }
    else { btn.innerHTML = '<i class="bi bi-x-octagon me-1"></i>Markera DNS'; btn.classList.add('btn-outline-warning'); btn.classList.remove('btn-outline-secondary'); }
}
document.getElementById('moveShooter').addEventListener('change', () => { buildSlotOptions(); updateDnsToggleLabel(); adjRefresh(); });

document.getElementById('dnsToggle').addEventListener('click', async () => {
    const sel = selectedMoveShooter();
    const msg = document.getElementById('moveMsg');
    if (!sel) { msg.innerHTML = '<span class="text-warning">Välj en skytt.</span>'; return; }
    const s = state.starters.find(x => x.memberId === sel.memberId && x.weaponClass === sel.weaponClass);
    const makeDns = !(s && s.isDns);
    msg.textContent = makeDns ? 'Markerar DNS…' : 'Ångrar DNS…';
    try {
        const d = await fetch('/umbraco/surface/Springskytte/SetSpringskytteDns', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.getElementById('afToken').value },
            body: JSON.stringify({ competitionId: COMP, memberId: sel.memberId, weaponClass: sel.weaponClass, isDns: makeDns })
        }).then(r => r.json());
        if (d.success) { msg.innerHTML = '<span class="text-success">' + (d.message || 'OK') + '</span>'; await loadState(); buildMovePickers(); }
        else msg.innerHTML = '<span class="text-danger">' + (d.message || 'Fel') + '</span>';
    } catch (e) { msg.innerHTML = '<span class="text-danger">Ett fel uppstod.</span>'; }
});

document.getElementById('moveApply').addEventListener('click', async () => {
    const msg = document.getElementById('moveMsg');
    const shooterVal = document.getElementById('moveShooter').value;
    const slot = document.getElementById('moveSlot').value;
    if (!shooterVal || !slot) { msg.innerHTML = '<span class="text-warning">Välj skytt och lucka.</span>'; return; }
    const [nodeId, memberId, weaponClass, startOrder] = shooterVal.split('|');
    msg.textContent = 'Flyttar…';
    try {
        const r = await fetch('/umbraco/surface/Springskytte/UpdateSpringskytteStarter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.getElementById('afToken').value },
            body: JSON.stringify({ competitionId: COMP, nodeId: parseInt(nodeId), memberId: parseInt(memberId), weaponClass: weaponClass, startOrder: parseInt(startOrder), startTime: slot })
        });
        const d = await r.json();
        if (d.success) {
            msg.innerHTML = '<span class="text-success">Flyttad till ' + slot.substring(0,5) + '.</span>';
            await loadState(); buildMovePickers();
        } else {
            msg.innerHTML = '<span class="text-danger">' + (d.message || 'Kunde inte flytta.') + '</span>';
        }
    } catch (e) { msg.innerHTML = '<span class="text-danger">Ett fel uppstod.</span>'; }
});

// ---------- straff & tidsavdrag (same ledger as the timekeeper card) ----------
const PEN_REASONS = ['Vapenhantering utanför skjutområde', 'Oproppat vapen efter skjutning', 'För tidig start', 'Otillåten utrustning', 'Ordningsförseelse', 'Annat'];
const RED_REASONS = ['Bana blockerad – väntan', 'Avbrott/incident', 'Tekniskt fel på bana', 'Väntan pga föregående skytt', 'Funktionärsfel', 'Annat'];
let adjTarget = null;
let adjModalInst = null;
function adjModal() { if (!adjModalInst) adjModalInst = bootstrap.Modal.getOrCreateInstance(document.getElementById('adjModal')); return adjModalInst; }
function syncAdjType() {
    const isPen = document.getElementById('adjPenalty').checked;
    document.getElementById('adjPenaltyFields').style.display = isPen ? '' : 'none';
    document.getElementById('adjReductionFields').style.display = isPen ? 'none' : '';
    document.getElementById('adjReasonSelect').innerHTML = (isPen ? PEN_REASONS : RED_REASONS).map(r => `<option>${escapeHtml(r)}</option>`).join('');
}
document.getElementById('adjPenalty').addEventListener('change', syncAdjType);
document.getElementById('adjReduction').addEventListener('change', syncAdjType);

function openAdjFor(target) {
    if (!target) return;
    adjTarget = target;
    document.getElementById('adjName').textContent = target.name || ('#' + (target.startOrder || ''));
    document.getElementById('adjClass').textContent = target.weaponClass + (target.ageGenderClass ? (' · ' + target.ageGenderClass) : '');
    document.getElementById('adjPenalty').checked = true;
    document.getElementById('adjPoints').value = 1;
    document.getElementById('adjTime').value = '';
    document.getElementById('adjReasonText').value = '';
    const err = document.getElementById('adjError'); err.classList.add('d-none'); err.textContent = '';
    syncAdjType();
    adjModal().show();
}
document.getElementById('adjSaveBtn').addEventListener('click', async () => {
    if (!adjTarget) return;
    const err = document.getElementById('adjError'); err.classList.add('d-none');
    const isPen = document.getElementById('adjPenalty').checked;
    const sel = document.getElementById('adjReasonSelect').value;
    const free = (document.getElementById('adjReasonText').value || '').trim();
    const reason = free ? (sel === 'Annat' ? free : sel + ' – ' + free) : sel;
    const body = { competitionId: COMP, memberId: adjTarget.memberId, weaponClass: adjTarget.weaponClass, adjustmentType: isPen ? 'Penalty' : 'Reduction', reason };
    if (isPen) body.points = parseInt(document.getElementById('adjPoints').value, 10);
    else body.timeInput = (document.getElementById('adjTime').value || '').trim();
    const btn = document.getElementById('adjSaveBtn'); btn.disabled = true;
    try {
        const d = await fetch('/umbraco/surface/Springskytte/AddSpringskytteAdjustment', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.getElementById('afToken').value }, body: JSON.stringify(body) }).then(r => r.json());
        if (d.success) { adjModal().hide(); await loadState(); adjRefresh(); }
        else { err.textContent = d.message || 'Kunde inte spara.'; err.classList.remove('d-none'); }
    } catch (e) { err.textContent = 'Ett fel uppstod.'; err.classList.remove('d-none'); }
    finally { btn.disabled = false; }
});

// Panel: adjustments for the selected move-shooter (add via button, delete inline)
function adjRefresh() {
    const nameEl = document.getElementById('adjForName');
    const listEl = document.getElementById('adjList');
    if (!nameEl || !listEl) return;
    const sel = selectedMoveShooter();
    if (!sel) { nameEl.textContent = ''; listEl.innerHTML = '<span class="text-secondary small">Välj en skytt ovan.</span>'; return; }
    const s = state.starters.find(x => x.memberId === sel.memberId && x.weaponClass === sel.weaponClass);
    nameEl.textContent = s ? ('— ' + s.name) : '';
    const list = adjustmentsFor(sel.memberId, sel.weaponClass);
    if (!list.length) { listEl.innerHTML = '<span class="text-secondary small">Inga straff/avdrag.</span>'; return; }
    listEl.innerHTML = list.map(a => {
        const isPen = a.adjustmentType === 'Penalty';
        let label; if (isPen) label = '+' + a.points + ' min'; else { const mag = Math.abs(a.seconds); label = '−' + (mag % 60 === 0 ? (mag / 60) + ' min' : mag + ' s'); }
        return `<span class="badge ${isPen ? 'bg-danger' : 'bg-success'} me-1 mb-1" title="${escapeHtml(a.reason || '')}">${label} <a href="#" class="text-white ms-1" onclick="delAdj(${a.id});return false;">&times;</a></span>`;
    }).join('');
}
window.delAdj = async function (id) {
    if (!confirm('Ta bort denna post?')) return;
    try { await fetch('/umbraco/surface/Springskytte/DeleteSpringskytteAdjustment', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.getElementById('afToken').value }, body: JSON.stringify({ id, competitionId: COMP }) }); await loadState(); adjRefresh(); } catch (e) { }
};
document.getElementById('adjOpenBtn').addEventListener('click', () => {
    const sel = selectedMoveShooter();
    if (!sel) { document.getElementById('moveMsg').innerHTML = '<span class="text-warning">Välj en skytt ovan.</span>'; return; }
    const s = state.starters.find(x => x.memberId === sel.memberId && x.weaponClass === sel.weaponClass);
    openAdjFor({ memberId: sel.memberId, weaponClass: sel.weaponClass, name: s ? s.name : ('#' + sel.startOrder), ageGenderClass: s ? s.ageGenderClass : '', startOrder: sel.startOrder });
});

// ---------- quick actions on the current shooter ----------
document.getElementById('qsAdj').addEventListener('click', () => { if (curNext) openAdjFor(curNext); });
document.getElementById('qsDns').addEventListener('click', async () => {
    if (!curNext) return;
    if (!confirm(`Markera #${curNext.startOrder} ${curNext.name} som "startade inte" (DNS)?`)) return;
    const msg = document.getElementById('qsMsg'); msg.textContent = 'Markerar DNS…';
    try {
        const d = await fetch('/umbraco/surface/Springskytte/SetSpringskytteDns', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.getElementById('afToken').value }, body: JSON.stringify({ competitionId: COMP, memberId: curNext.memberId, weaponClass: curNext.weaponClass, isDns: true }) }).then(r => r.json());
        if (d.success) { msg.innerHTML = '<span class="text-success">Markerad som DNS.</span>'; await loadState(); tick(); }
        else msg.innerHTML = '<span class="text-danger">' + (d.message || 'Fel') + '</span>';
    } catch (e) { msg.innerHTML = '<span class="text-danger">Ett fel uppstod.</span>'; }
});
document.getElementById('qsBump').addEventListener('click', async () => {
    if (!curNext) return;
    const n = nowSec();
    const slot = (state.freeSlots || []).filter(f => f.weaponClass === curNext.weaponClass && hmsToSec(f.time) >= n - 5).sort((a, b) => hmsToSec(a.time) - hmsToSec(b.time))[0];
    const msg = document.getElementById('qsMsg');
    if (!slot) { msg.innerHTML = '<span class="text-warning">Ingen ledig lucka att flytta till.</span>'; return; }
    if (!confirm(`Flytta #${curNext.startOrder} ${curNext.name} till ${slot.time.substring(0,5)}?`)) return;
    msg.textContent = 'Flyttar…';
    try {
        const d = await fetch('/umbraco/surface/Springskytte/UpdateSpringskytteStarter', { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.getElementById('afToken').value }, body: JSON.stringify({ competitionId: COMP, nodeId: curNext.nodeId, memberId: curNext.memberId, weaponClass: curNext.weaponClass, startOrder: curNext.startOrder, startTime: slot.time }) }).then(r => r.json());
        if (d.success) { msg.innerHTML = '<span class="text-success">Flyttad till ' + slot.time.substring(0,5) + '.</span>'; await loadState(); tick(); }
        else msg.innerHTML = '<span class="text-danger">' + (d.message || 'Kunde inte flytta.') + '</span>';
    } catch (e) { msg.innerHTML = '<span class="text-danger">Ett fel uppstod.</span>'; }
});

// ---------- loop ----------
if (!PRESET_WC) {
    // No weapon group chosen — show the chooser and stop (A and C are separate start lines).
    showClassChooser();
} else {
    renderOffset();
    loadState().then(() => { applyAdminMode(); tick(); });
    setInterval(tick, 250);
    setInterval(loadState, 5000);
}
</script>
</body>
</html>
