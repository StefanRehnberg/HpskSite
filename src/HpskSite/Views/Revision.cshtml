@model HpskSite.Controllers.RevisionModel
@{
    Layout = null;

    var sv = System.Globalization.CultureInfo.GetCultureInfo("sv-SE");
    string Kr(decimal v) => v.ToString("#,##0", sv) + " kr";
    var s = Model.Selected;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Revision — pistol.nu</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <style>
        body { background: #f4f6f9; }
        .wrap { max-width: 1040px; margin: 0 auto; padding: 24px 16px 60px; }
        .brand { font-weight: 800; font-size: 20px; letter-spacing: -.3px; }
        .brand span { color: #0b63ce; }
        .card2 { border: 1px solid #dde3ea; border-radius: 10px; background: #fff; padding: 22px; margin-bottom: 18px; }
        .muted { color: #5b6672; }
        .kpi { font-size: 30px; font-weight: 700; line-height: 1.1; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 18px; }
        .step { display: flex; gap: 10px; padding: 7px 0; border-bottom: 1px solid #f0f3f7; }
        .step:last-child { border-bottom: 0; }
        .badge-ro { background: #eef4ff; color: #0b4da2; border: 1px solid #cfe0fb;
                    border-radius: 999px; padding: 3px 11px; font-size: 13px; font-weight: 600; }
        .warn { background: #fff7e8; border: 1px solid #f3dcae; border-radius: 8px; padding: 14px; }
        .bad  { background: #fdeeee; border: 1px solid #f2c3c3; border-radius: 8px; padding: 14px; }
        .okbx { background: #eef8f0; border: 1px solid #c6e6cf; border-radius: 8px; padding: 14px; }
        h2 { font-size: 19px; font-weight: 700; margin: 0 0 12px; }

        @@media (prefers-color-scheme: dark) {
            body { background: #10151b; color: #e7edf3; }
            .card2 { background: #171e26; border-color: #27313d; }
            .muted { color: #9fb0c0; }
            .step { border-color: #222b35; }
            .warn { background: #2b2415; border-color: #5c4a22; }
            .bad  { background: #2c1a1a; border-color: #5e2e2e; }
            .okbx { background: #16261b; border-color: #2c5437; }
            .badge-ro { background: #11243c; color: #9cc4f5; border-color: #1d3d63; }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="d-flex align-items-center justify-content-between" style="margin-bottom:18px">
        <div>
            <div class="brand">pistol<span>.nu</span></div>
            <div class="muted">Revision</div>
        </div>
        @if (Model.ReadOnly && s is not null)
        {
            @* ⚠️ Läsläget SÄGS, det antyds inte. En revisor som är osäker på om hen kan råka
               ändra något vågar inte klicka sig fram — och granskar då sämre. *@
            <span class="badge-ro">Du kan läsa allt, ändra ingenting</span>
        }
    </div>

    @if (Model.NeedsLogin)
    {
        <div class="card2">
            <h2>Logga in</h2>
            <p class="muted">Logga in med den adress föreningen bjöd in.</p>
            <a class="btn btn-primary"
               href="/login-&-register/?tab=login&returnUrl=@Uri.EscapeDataString("/revision")">Logga in</a>
        </div>
    }
    else if (Model.Assignments.Count == 0)
    {
        <div class="card2">
            <h2>Inget revisorsuppdrag</h2>
            <p class="muted">
                Kontot har inget aktivt revisorsuppdrag. Har du fått en inbjudan — öppna länken i
                mejlet. Har uppdraget gått ut ber du föreningen skicka en ny inbjudan.
            </p>
        </div>
    }
    else
    {
        @if (Model.Assignments.Count > 1)
        {
            <div class="card2">
                <h2>Vilken förening?</h2>
                @foreach (var a in Model.Assignments)
                {
                    <a class="btn @(s is not null && a.OwnerId == s.OwnerId ? "btn-primary" : "btn-outline-secondary") me-2 mb-2"
                       href="/revision?type=@a.OwnerType&id=@a.OwnerId">@a.OwnerName</a>
                }
            </div>
        }

        @if (s is null)
        {
            <div class="card2"><p class="muted" style="margin:0">Välj förening ovan.</p></div>
        }
        else
        {
            <h1 style="font-size:26px;font-weight:800;margin-bottom:4px">@s.OwnerName</h1>
            <p class="muted">
                Räkenskaperna, verifikationerna och underlagen — samlat.
                Uppdraget gäller till @s.ExpiresUtc.ToLocalTime().ToString("d MMMM yyyy", sv).
            </p>

            @if (Model.Problem is not null)
            {
                <div class="card2"><div class="bad">@Model.Problem</div></div>
            }

            @if (Model.Years.Count > 1)
            {
                <div class="card2">
                    <h2>Räkenskapsår</h2>
                    @* ⚠️ ALLA år, inte bara det som ska fastställas. Att jämföra med föregående år
                       är en del av granskningen, inte en bekvämlighet. *@
                    @foreach (var y in Model.Years)
                    {
                        <a class="btn btn-sm @(y.Id == Model.SelectedYearId ? "btn-primary" : "btn-outline-secondary") me-2 mb-2"
                           href="/revision?type=@s.OwnerType&id=@s.OwnerId&year=@y.Id">@y.Year</a>
                    }
                </div>
            }

            @if (Model.Statements is not null)
            {
                var st = Model.Statements;
                <div class="card2">
                    <h2>Resultat och ställning</h2>
                    <div class="grid">
                        <div>
                            <div class="muted">Intäkter</div>
                            <div class="kpi">@Kr(st.RevenueTotal)</div>
                        </div>
                        <div>
                            <div class="muted">Kostnader</div>
                            <div class="kpi">@Kr(st.CostTotal)</div>
                        </div>
                        <div>
                            <div class="muted">Resultat</div>
                            <div class="kpi">@Kr(st.Result)</div>
                        </div>
                        <div>
                            <div class="muted">Tillgångar</div>
                            <div class="kpi">@Kr(st.AssetTotal)</div>
                        </div>
                    </div>

                    <div style="margin-top:16px">
                        @* ⚠️ Balanskontrollen visas ALLTID, också när den går ihop. Det är den
                           enklaste kontrollen som finns och den första en revisor gör. *@
                        @if (st.Balances)
                        {
                            <div class="okbx">Balansräkningen går ihop.</div>
                        }
                        else
                        {
                            <div class="bad">
                                <strong>Balansräkningen går inte ihop.</strong>
                                Differens @Kr(st.BalanceDifference). Be kassören räkna om bokslutet.
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card2">
                <h2>Underlagen</h2>
                @* ⚠️⚠️ −1 BETYDER "VET INTE", aldrig "inga saknas". En siffra som tyst blir noll
                   vid ett fel hade kryssat av en kontroll ingen gjort. *@
                @if (Model.AttachmentsMissing < 0)
                {
                    <div class="warn">Underlagsläget gick inte att läsa just nu.</div>
                }
                else if (Model.AttachmentsTotal == 0)
                {
                    <p class="muted" style="margin:0">
                        Inga handbokförda poster i året — allt har fallit ut ur avgifter och
                        anmälningar, där underlaget är anmälan själv.
                    </p>
                }
                else if (Model.AttachmentsMissing == 0)
                {
                    <div class="okbx">
                        Alla @Model.AttachmentsTotal handbokförda poster har ett underlag.
                    </div>
                }
                else
                {
                    <div class="warn">
                        <strong>@Model.AttachmentsMissing av @Model.AttachmentsTotal</strong>
                        handbokförda poster saknar underlag.
                        @* Rakt in i listan, filtrerad — annars får revisorn leta själv. *@
                        <div style="margin-top:8px">
                            <a href="/ekonomi?type=@s.OwnerType&id=@s.OwnerId#verifikationer">
                                Gå till verifikationerna
                            </a>
                        </div>
                    </div>
                }
                <p class="muted" style="margin:12px 0 0">
                    Poster som faller ut ur avgifter och anmälningar räknas inte här — deras
                    underlag är anmälan och betalningsraden, inte ett papper.
                </p>
            </div>

            <div class="card2">
                <h2>Avstämningen mot banken</h2>
                @if (Model.BankRows == 0)
                {
                    <div class="warn">
                        Inget kontoutdrag är inläst. Då är bokföringen inte avstämd mot banken, och
                        fullständigheten går inte att bevisa.
                    </div>
                }
                else if (Model.BankUnmatched == 0)
                {
                    <div class="okbx">
                        Alla @Model.BankRows rader i kontoutdraget
                        @(Model.BankPeriodTo.HasValue ? "t.o.m. " + Model.BankPeriodTo.Value.ToString("d MMMM yyyy", sv) : "")
                        har en motpart i bokföringen.
                    </div>
                }
                else
                {
                    <div class="warn">
                        <strong>@Model.BankUnmatched av @Model.BankRows</strong> rader i
                        kontoutdraget saknar motpart i bokföringen.
                    </div>
                }
            </div>

            @if (Model.Checklist is not null)
            {
                <div class="card2">
                    <h2>Bokslutets steg</h2>
                    @foreach (var step in Model.Checklist.Steps)
                    {
                        var mark = step.State == HpskSite.Models.Ledger.LedgerClosingChecklist.StepState.Done ? "✓"
                                 : step.State == HpskSite.Models.Ledger.LedgerClosingChecklist.StepState.Unknown ? "?" : "·";
                        <div class="step">
                            <div style="width:18px;font-weight:700">@mark</div>
                            <div>
                                <div>@step.Title</div>
                                @if (!string.IsNullOrWhiteSpace(step.Detail))
                                {
                                    <div class="muted" style="font-size:14px">@step.Detail</div>
                                }
                            </div>
                        </div>
                    }
                    <p class="muted" style="margin:12px 0 0;font-size:14px">
                        <strong>?</strong> betyder att vi inte kan avgöra steget åt föreningen —
                        inte att det är gjort.
                    </p>
                </div>
            }

            <div class="card2">
                <h2>Gå vidare i granskningen</h2>
                <p class="muted">
                    Härifrån följer du kedjan: en bokförd post → dess underlag → raden på
                    kontoutdraget.
                </p>
                <a class="btn btn-primary mb-2 me-2"
                   href="/ekonomi?type=@s.OwnerType&id=@s.OwnerId">Verifikationer och huvudbok</a>
                <a class="btn btn-outline-secondary mb-2 me-2"
                   href="/styrelse?type=@s.OwnerType&id=@s.OwnerId">Protokoll</a>
            </div>

            @* ⚠️ Protokollen är ännu INTE öppna för revisorn — /styrelse har sin egen grind
               (CanAccessBoardWork) och den känner inte till revisorsuppdrag. Att låtsas att
               länken fungerar vore värre än att säga det. *@
            <p class="muted" style="font-size:14px">
                Protokollen kräver i dag att föreningen delar dem separat — vi öppnar dem för
                revisorn härnäst.
            </p>
        }
    }
</div>
</body>
</html>
