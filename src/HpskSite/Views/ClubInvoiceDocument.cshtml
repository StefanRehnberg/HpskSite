@model HpskSite.Controllers.ClubInvoiceDocumentModel
@using System.Globalization
@*
    Fakturan till en klubb (/klubbfaktura/{id}). Samma formspråk som den gamla fakturan och kvittot,
    så handlingarna från pistol.nu ser ut att komma från samma organisation.

    ⚠️ INGEN BETALSTATUS PÅ ARKET. Status är dynamisk och ett utskrivet papper hade fortsatt påstå ett
    läge som ändrats. Det enda som stämplas är MAKULERAD — en egenskap hos handlingen själv.
    Läget ("betald", "betalning anmäld") står i en ruta OVANFÖR arket, som inte skrivs ut.

    ⚠️ Varje @ i CSS är @@ — annars spräcks runtime-kompileringen utan meddelande.
*@
@{
    Layout = null;
    var sv = CultureInfo.GetCultureInfo("sv-SE");
    string Kr(decimal v) => v.ToString("N2", sv) + " kr";
    var c = Model.Charge;
    var isCredit = c.IsCredit;
    var title = isCredit ? "KREDITFAKTURA" : "FAKTURA";
    var b = Model.Balance;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(isCredit ? "Kreditfaktura" : "Faktura") @c.NumberText — @c.IssuerName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root { --ink:#1f2937; --muted:#6b7280; --line:#e5e7eb; --accent:#0d6efd; --ok:#2F6B4A; --attn:#B45309; --attn-bg:#FBF4EC; }
        * { box-sizing: border-box; }
        body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: var(--ink);
               background: #f3f4f6; margin: 0; padding: 24px 16px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
        .wrap { max-width: 820px; margin: 0 auto; }
        .toolbar { display: flex; gap: 8px; justify-content: flex-end; margin-bottom: 12px; flex-wrap: wrap; }
        .btn { font: inherit; cursor: pointer; border: 1px solid var(--line); background: #fff; color: var(--ink);
               padding: 8px 16px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
        .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
        .state { background: #fff; border-radius: 10px; padding: 12px 16px; margin-bottom: 12px; border-left: 4px solid var(--muted); }
        .state.ok { border-left-color: var(--ok); }
        .state.attn { border-left-color: var(--attn); background: var(--attn-bg); }
        .sheet { background: #fff; border-radius: 14px; box-shadow: 0 6px 24px rgba(0,0,0,.08); padding: 40px 48px; position: relative; }
        .head { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
        .issuer strong { font-size: 18px; }
        .meta { font-size: 13px; color: var(--muted); line-height: 1.6; }
        .meta b { color: var(--ink); }
        h1 { margin: 0; font-size: 30px; letter-spacing: 2px; color: var(--accent); text-align: right; }
        .rule { height: 1px; background: var(--line); margin: 24px 0; border: 0; }
        .grid2 { display: flex; gap: 32px; flex-wrap: wrap; }
        .grid2 > div { flex: 1 1 220px; }
        .label { text-transform: uppercase; letter-spacing: .06em; font-size: 11px; color: var(--muted); margin-bottom: 4px; }
        table.items { width: 100%; border-collapse: collapse; margin-top: 20px; }
        table.items th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted);
                         border-bottom: 2px solid var(--line); padding: 8px 0; }
        table.items td { padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
        .amt { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .totals { display: flex; justify-content: flex-end; margin-top: 16px; }
        .totals table { border-collapse: collapse; min-width: 280px; }
        .totals td { padding: 6px 0; }
        .totals tr.grand td { border-top: 2px solid var(--ink); padding-top: 10px; font-size: 20px; font-weight: 700; }
        .pay { display: flex; gap: 24px; align-items: flex-start; flex-wrap: wrap; margin-top: 8px; }
        .pay img { width: 150px; height: 150px; }
        .note { font-size: 12px; color: var(--muted); margin-top: 18px; }
        .stamp { position: absolute; top: 120px; right: 60px; transform: rotate(-12deg); border: 4px solid #dc3545;
                 color: #dc3545; border-radius: 10px; padding: 6px 18px; font-size: 26px; font-weight: 800; letter-spacing: 3px; }
        @@media (max-width: 600px) { .sheet { padding: 24px 18px; } h1 { text-align: left; } }
        @@media print {
            body { background: #fff; padding: 0; }
            .toolbar, .state { display: none !important; }
            .sheet { box-shadow: none; border-radius: 0; padding: 0; }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="toolbar">
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Skriv ut</button>
    </div>

    @if (!isCredit && !c.IsVoided)
    {
        if (b.IsSettled)
        {
            <div class="state ok" data-state="settled"><strong>Betald.</strong> Arrangören har tagit emot hela beloppet.</div>
        }
        else if (b.Claimed > 0)
        {
            <div class="state" data-state="claimed"><strong>Betalning anmäld.</strong> Arrangören stämmer av den mot banken.</div>
        }
        else
        {
            <div class="state attn" data-state="open">
                <strong>Att betala: @Kr(b.Outstanding)</strong>@(c.DueDate is DateTime due ? $" senast {due:yyyy-MM-dd}" : "").
                <div style="margin-top:8px">
                    <button type="button" class="btn" id="claimBtn"><i class="bi bi-check2-circle"></i> Vi har betalat</button>
                    <span id="claimMsg" class="meta"></span>
                </div>
            </div>
        }
    }

    <div class="sheet">
        @if (c.IsVoided)
        {
            <div class="stamp">MAKULERAD</div>
        }
        <div class="head">
            <div class="issuer">
                <strong>@c.IssuerName</strong>
                <div class="meta">
                    @if (!string.IsNullOrWhiteSpace(c.IssuerAddress)) { <div>@c.IssuerAddress</div> }
                    @if (!string.IsNullOrWhiteSpace(c.IssuerOrgNumber)) { <div>Org.nr @c.IssuerOrgNumber</div> }
                    @if (!string.IsNullOrWhiteSpace(c.IssuerEmail)) { <div>@c.IssuerEmail</div> }
                </div>
            </div>
            <div>
                <h1>@title</h1>
                <div class="meta" style="text-align:right">
                    <div>Nummer <b>@c.NumberText</b></div>
                    <div>Fakturadatum <b>@c.IssueDate.ToString("yyyy-MM-dd")</b></div>
                    @if (!isCredit && c.DueDate is DateTime d) { <div>Förfallodag <b>@d.ToString("yyyy-MM-dd")</b></div> }
                    @if (isCredit) { <div>Krediterar faktura <b>@Model.Invoice.NumberText</b></div> }
                </div>
            </div>
        </div>

        <hr class="rule" />

        <div class="grid2">
            <div>
                <div class="label">Mottagare</div>
                <div><strong>@c.RecipientName</strong></div>
            </div>
            <div>
                <div class="label">Avser</div>
                <div>Anmälningar till @c.SourceName</div>
            </div>
        </div>

        <table class="items">
            <thead><tr><th>Beskrivning</th><th class="amt">Belopp</th></tr></thead>
            <tbody>
            @foreach (var line in c.Lines)
            {
                <tr><td>@line.Description</td><td class="amt">@Kr(line.Amount)</td></tr>
            }
            </tbody>
        </table>

        <div class="totals">
            <table>
                <tr class="grand"><td>@(isCredit ? "Att kreditera" : "Att betala")</td><td class="amt">@Kr(c.Amount)</td></tr>
            </table>
        </div>
        <div class="note" style="text-align:right">
            @(c.IssuerIsVatRegistered ? "Moms enligt föreningens registrering." : "Föreningen är inte momsregistrerad – moms ingår ej.")
        </div>

        @if (!isCredit)
        {
            <hr class="rule" />
            <div class="label">Betalning</div>
            <div class="pay">
                <div class="meta" style="font-size:15px;color:var(--ink)">
                    @if (!string.IsNullOrWhiteSpace(c.IssuerBankgiro)) { <div>Bankgiro <b>@c.IssuerBankgiro</b></div> }
                    @if (!string.IsNullOrWhiteSpace(c.IssuerSwish)) { <div>Swish <b>@c.IssuerSwish</b></div> }
                    <div>Referens <b>@c.Reference</b></div>
                    <div class="note">Ange referensen vid betalningen — det är så arrangören ser vilken faktura pengarna gäller.</div>
                </div>
                @if (!string.IsNullOrEmpty(Model.BgQrCodeBase64))
                {
                    <img src="data:image/png;base64,@Model.BgQrCodeBase64" alt="QR-kod för betalning i bankappen" />
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(c.Note))
        {
            <div class="note">@c.Note</div>
        }
    </div>
</div>

@if (!isCredit && !c.IsVoided && !b.IsSettled && b.Claimed <= 0)
{
    <script>
        (function () {
            var btn = document.getElementById('claimBtn');
            if (!btn) return;
            btn.addEventListener('click', async function () {
                btn.disabled = true;
                var msg = document.getElementById('claimMsg');
                try {
                    // ⚠️ Sidan har ingen Umbraco-form — antiforgery-token hämtas separat, annars blir POST:en en tom 400.
                    var tokRes = await fetch('/umbraco/surface/Club/GetFormToken', { credentials: 'same-origin' });
                    var tok = (await tokRes.json()).token;
                    var res = await fetch('/umbraco/surface/CompetitionFee/ClaimInvoicePaid', {
                        method: 'POST', credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': tok },
                        body: JSON.stringify({ chargeId: @c.Id, token: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Token ?? "")) })
                    });
                    var data = await res.json();
                    msg.textContent = data.message || '';
                    if (!data.success) btn.disabled = false;
                } catch (e) {
                    msg.textContent = 'Det gick inte att skicka. Försök igen.';
                    btn.disabled = false;
                }
            });
        })();
    </script>
}
</body>
</html>
