@model string
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Validera serie – pistol.nu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #f6f7f9; padding: 1rem; }
        .verify-card { max-width: 520px; margin: 1rem auto; }
        .shot-pill { display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:50%;border:2px solid var(--bs-border-color);font-weight:bold;margin:.15rem; }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="verify-card">
        <div class="text-center mb-3">
            <i class="bi bi-patch-check-fill text-warning" style="font-size:2rem;"></i>
            <h4 class="mb-0">Validera serie</h4>
        </div>
        <div id="verifyContent">
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        </div>
    </div>

    <script>
        const TOKEN = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        const content = document.getElementById('verifyContent');

        function token() { return document.querySelector('input[name="__RequestVerificationToken"]').value; }
        function esc(s){ return s==null?'':String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

        // A response we cannot read used to become a bare "Något gick fel", which hid the cause and led
        // the shooter to submit the series again — each retry a new pending row (prod 2026-09-29). Say
        // what happened, and retry with the SAME code: it is valid for 30 minutes, nothing new is needed.
        function readJson(r) {
            const type = r.headers.get('content-type') || '';
            if (r.ok && type.indexOf('application/json') !== -1) return r.json();
            const err = new Error('http');
            err.status = r.status;
            throw err;
        }
        function failureText(err) {
            const s = err && err.status;
            if (!s) return 'Servern gick inte att nå. Kontrollera täckningen och försök igen.';
            if (s === 455 || s === 403) return `Anropet stoppades på vägen (fel ${s}). Försök igen — koden gäller fortfarande.`;
            if (s === 400) return 'Sidan behöver laddas om (fel 400). Tryck Försök igen.';
            return `Servern svarade med fel ${s}. Försök igen — koden gäller fortfarande.`;
        }
        function showFailure(err, retry) {
            content.innerHTML = `<div class="alert alert-danger text-center">
                    <i class="bi bi-exclamation-triangle"></i> ${esc(failureText(err))}</div>
                <div class="d-grid"><button class="btn btn-primary btn-lg" id="retryBtn">
                    <i class="bi bi-arrow-clockwise"></i> Försök igen</button></div>
                <p class="text-center text-muted small mt-2 mb-0">Skytten behöver inte skicka in serien igen.</p>`;
            document.getElementById('retryBtn').addEventListener('click', retry);
        }

        function load() {
            content.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
            fetch('/umbraco/surface/Marken/GetSerieForVerify?token=' + encodeURIComponent(TOKEN))
                .then(readJson)
                .then(d => {
                    if (d.needsLogin) {
                        content.innerHTML = `<div class="card verify-card"><div class="card-body text-center">
                            <p>Du måste vara inloggad som funktionär för att validera.</p>
                            <a class="btn btn-primary" href="/login-register?returnUrl=${encodeURIComponent(location.pathname + location.search)}">Logga in</a></div></div>`;
                        return;
                    }
                    if (!d.success) { content.innerHTML = `<div class="alert alert-warning">${esc(d.message)}</div>`; return; }
                    render(d.serie);
                })
                .catch(err => showFailure(err, () => {
                    // A 400 means the page's antiforgery token is stale; only a reload renews it.
                    if (err && err.status === 400) location.reload(); else load();
                }));
        }

        function render(s) {
            let body = '';
            if (s.kind === 'comp') {
                const lvl = s.reachedLevel
                    ? `<span class="badge bg-success">${esc(s.reachedLevel)}-nivå</span>`
                    : '<span class="badge bg-secondary">Under märkeskravet</span>';
                body = `<p class="text-center mb-1"><span class="fs-5 fw-bold">${esc(s.familyName)}</span></p>
                    <p class="text-center"><span class="fs-4 fw-bold">${s.total}</span>
                       <span class="text-muted">(vapengrupp ${esc(s.weaponGroup)}${s.dim ? ', ' + s.dim : ''})</span></p>
                    <p class="text-center text-muted">${esc(s.competitionName)}</p>
                    <p class="text-center">${lvl}</p>`;
            } else if (s.discipline === 'Precision') {
                const shots = (s.shots || []).map(v => `<span class="shot-pill">${esc(v)}</span>`).join('');
                body = `<p class="text-center mb-1"><span class="fs-5 fw-bold">Precisionsserie</span></p>
                    <div class="text-center mb-2">${shots}</div>
                    <p class="text-center mb-1"><span class="fs-4 fw-bold">${s.total} p</span>
                       <span class="text-muted">(vapengrupp ${esc(s.weaponGroup)})</span></p>
                    <p class="text-center text-muted small">Räknas mot Pistolskyttemärket (guld ≥ ${s.threshold}) och Elitmärket.</p>`;
            } else if (s.discipline === 'Air') {
                body = `<p class="text-center mb-1"><span class="fs-5 fw-bold">Luftpistolserie</span></p>
                    <p class="text-center"><span class="fs-4 fw-bold">${s.total} p</span> <span class="text-muted">(nivå ${esc(s.claimedLevel)})</span></p>`;
            } else if (s.discipline === 'Snabbpistol') {
                body = `<p class="text-center mb-1"><span class="fs-5 fw-bold">Snabbpistolserie (Elit)</span></p>
                    <p class="text-center"><span class="fs-4 fw-bold">${s.total} p</span> <span class="text-muted">(nivå ${esc(s.claimedLevel)} · vapengrupp ${esc(s.weaponGroup)})</span></p>`;
            } else {
                body = `<p class="text-center mb-1"><span class="fs-5 fw-bold">Snabbserie (tillämpning) – ${esc(s.claimedLevel)}</span></p>
                    <p class="text-center text-muted">Mål: ${esc(s.targetName)} · vapengrupp ${esc(s.weaponGroup)}<br>${esc(s.speedRequirement)}</p>`;
            }
            const photoUrl = s.kind === 'comp' ? `/umbraco/surface/Marken/GetCompResultPhoto?id=${s.id}` : `/umbraco/surface/Marken/GetSeriePhoto?id=${s.id}`;
            const photo = s.hasPhoto ? `<div class="text-center my-2"><a href="${photoUrl}" target="_blank" rel="noopener"><img src="${photoUrl}" class="img-fluid rounded border" style="max-height:280px;"></a></div>` : '';
            const date = (s.kind === 'comp' ? s.competitionDate : s.seriesDate) ? new Date(s.kind === 'comp' ? s.competitionDate : s.seriesDate).toLocaleDateString('sv-SE') : '';

            // Which club the approval is FOR. Only asked when the functionary may act for more than one
            // of the shooter's clubs — we cannot tell from the range which club they represent.
            const opts = s.clubOptions || [];
            const clubPick = (s.status === 'Pending' && opts.length > 1)
                ? `<div class="mt-3"><label class="form-label small mb-1" for="validateClub">Godkänn för klubb</label>
                     <select class="form-select" id="validateClub">${opts.map(o =>
                        `<option value="${o.id}"${o.id === s.defaultClubId ? ' selected' : ''}>${esc(o.name)}</option>`).join('')}</select>
                     <div class="form-text">Du har behörighet i flera av skyttens klubbar. Välj den klubb du godkänner för.</div></div>`
                : '';

            let actions;
            if (s.status === 'Pending') {
                actions = clubPick + `<div class="d-grid gap-2 mt-3">
                    <button class="btn btn-success btn-lg" onclick="act('${s.kind}', ${s.id}, true)"><i class="bi bi-check-lg"></i> Godkänn</button>
                    <button class="btn btn-outline-danger" onclick="act('${s.kind}', ${s.id}, false)"><i class="bi bi-x-lg"></i> Avvisa</button></div>`;
            } else {
                actions = `<div class="alert ${s.status === 'Verified' ? 'alert-success' : 'alert-secondary'} mt-3 text-center mb-0">
                    Redan ${s.status === 'Verified' ? 'godkänd' : 'avvisad'}.</div>`;
            }

            content.innerHTML = `<div class="card"><div class="card-body">
                <h5 class="card-title text-center">${esc(s.memberName)}</h5>
                <p class="text-center text-muted small mb-3">${esc(s.kind === 'comp' ? 'Tävlingsresultat' : (s.disciplineName || s.seriesTypeName))} · ${esc(s.clubName)} · ${date}</p>
                ${body}${photo}${actions}</div></div>`;
        }

        function act(kind, id, approve) {
            const url = approve ? '/umbraco/surface/Marken/VerifyEvidence' : '/umbraco/surface/Marken/RejectEvidence';
            if (!approve && !confirm('Avvisa?')) return;
            const pick = document.getElementById('validateClub');
            const clubId = pick ? parseInt(pick.value, 10) || 0 : 0;
            content.querySelectorAll('button, select').forEach(b => b.disabled = true);
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                // Pass the scanned token along: on a club that requires on-site witnessing it is the
                // PROOF that this approval came from scanning the shooter's live code, and the server
                // refuses a bare approve there.
                body: JSON.stringify({ kind, id, token: TOKEN, clubId })
            })
            .then(readJson)
            .then(res => {
                content.innerHTML = `<div class="alert ${res.success ? 'alert-success' : 'alert-danger'} text-center">${esc(res.message)}</div>`;
            })
            // Retrying reloads the series first: if the first attempt did land, the page then says
            // "Redan godkänd" instead of approving twice.
            .catch(err => showFailure(err, () => {
                if (err && err.status === 400) location.reload(); else load();
            }));
        }

        load();
    </script>
</body>
</html>
