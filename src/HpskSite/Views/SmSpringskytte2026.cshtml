@*
    /sm-springskytte-2026 — hub page for the event site.
    Rendered by SmSpringskytte2026Controller (routed, no Umbraco node).
    Facts come from Tävlings-PM 2026-08-13 (Hallands Pistolskyttekrets).
*@
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "SM i Springskytte 2026 — Obbhult, Varberg";

    // CompetitionId läses inte här — _SmSpringskytteFore hämtar det själv ur ViewData.
    var compUrl = ViewData["CompetitionUrl"] as string ?? "";

    // Resultaten är hubbens huvudsak så snart de finns. Controllern lägger dokumenten i ViewData
    // för ALLA sidor i sajten, så hubben kan lista resultatfilerna själv utan en egen läsning.
    var docs = ViewData["Documents"] as IEnumerable<HpskSite.Controllers.SmDocument>
               ?? Array.Empty<HpskSite.Controllers.SmDocument>();
    var results = docs.Where(d => d.Category == "Resultat").ToList();
    var hasResults = results.Any();
    var contactName = ViewData["ContactName"] as string ?? "";
    var contactEmail = ViewData["ContactEmail"] as string ?? "";
    var contactPhone = ViewData["ContactPhone"] as string ?? "";

    ViewBag.MetaDescription = hasResults
        ? "Resultat från Svenska Mästerskapen i springskytte 22–23 augusti 2026 i Släryds grustag, Obbhult utanför Varberg — individuellt och lagtävling i vapengrupp C och A."
        : "Resultatlistorna från Svenska Mästerskapen i springskytte 22–23 augusti 2026 i Obbhult kontrolleras och publiceras så snart de är klara. Tidsplan, banor, PM och service.";
}

<link href="~/css/sm-springskytte-2026.css" rel="stylesheet" asp-append-version="true" />

<div class="container sm-page my-4">

    <header class="sm-hero">
        <div class="sm-kicker">Svenska Mästerskapen · Hallands Pistolskyttekrets</div>
        <h1>SM i Springskytte 2026</h1>
        <p class="sm-hero-sub">22–23 augusti · Släryds grustag, Obbhult utanför Varberg</p>
        <div class="sm-hero-facts">
            <span>@(hasResults ? "🏆 Resultaten är publicerade" : "⏳ Resultatlistorna kontrolleras")</span>
            <span>📅 Lördag 22/8: vapengrupp C + stafett</span>
            <span>📅 Söndag 23/8: vapengrupp A</span>
            <span>🏅 Första SM i springskytte i vapengrupp A</span>
        </div>
    </header>

    @await Html.PartialAsync("_SmSpringskytteNav")

    @* Resultaten ligger först på sidan — det är dem alla kommer hit för nu. Filerna listas direkt
       här, så ingen behöver klicka sig vidare. Sektionen renderas ÄVEN utan filer: en tömd mapp
       ska ge beskedet att listorna kontrolleras, inte ett tomrum där rubriken borde stått. *@
    <section class="sm-section">
        <h2>Resultat</h2>
        @await Html.PartialAsync("_SmSpringskytteResultatNot")
        @if (hasResults)
        {
            <p class="lead">
                Tack för ett fint mästerskap. Här är resultatlistorna från båda dagarna — individuellt
                och lagtävling, vapengrupp C och A.
            </p>
            <div class="sm-doc-list">
                @foreach (var doc in results)
                {
                    @await Html.PartialAsync("_SmSpringskytteDokument", doc)
                }
            </div>
            <p class="mt-3 mb-0">
                <a class="btn btn-primary" href="/sm-springskytte-2026/startlistor">Resultat &amp; startlistor</a>
            </p>
        }
        else
        {
            @await Html.PartialAsync("_SmSpringskytteResultatVantar")
            <p class="mt-3 mb-0">
                <a class="btn btn-outline-primary" href="/sm-springskytte-2026/startlistor">Startlistor</a>
            </p>
        }
    </section>

    <section class="sm-section">
        <h2>Välkommen till Halland</h2>
        <p class="lead">
            Hej och välkommen till Springskytte-SM i Varbergs kommun och Obbhult. Vi är väldigt glada att som
            förstagångsvärdar kunna bjuda in till årets Svenska Mästerskap i springskytte med pistol — som
            därtill är Svenska Pistolskytteförbundets första SM-springskytte i vapengrupp A.
        </p>
        <p>
            Tack till alla skyttar, lagledare och funktionärer som gjorde mästerskapet till vad det blev.
            Sidan står kvar som den var: resultaten högst upp, och under dem tävlings-PM, banor, service
            och funktionärsinfo precis som under tävlingsdagarna.
        </p>
        <p class="mb-0"><strong>Tack för att ni kom till Halland!</strong></p>
    </section>

    @* "Gör det här innan du åker" (Mitt schema + notiser) är borttagen — tävlingen är genomförd.
       Partialen _SmSpringskytteFore lever kvar för funktionärssidan, som lämnas orörd. *@

    <section class="sm-section">
        <h2>Tidsplan</h2>
        <p>
            Så här såg dagarna ut. <a href="/sm-springskytte-2026/startlistor">Startlistorna ligger kvar</a>
            tillsammans med resultaten.
        </p>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="sm-day">
                    <div class="sm-day-head">Lördag 22 augusti <small>Vapengrupp C, individuellt och stafett</small></div>
                    <ul>
                        <li><span class="sm-time">9.00–12.00</span><span>Vapenkontroll och nummerlappar</span></li>
                        <li><span class="sm-time">10.00–11.00</span><span>Inskjutning mot Kurvinen fallmål och femprickstavlor i papp</span></li>
                        <li><span class="sm-time">12.00</span><span>Första start vapengrupp C, klass H35</span></li>
                        <li><span class="sm-time">ca 15.00</span><span>Stafettstart H/D 21</span></li>
                        <li><span class="sm-time">ca 15.30</span><span>Stafettstart H/D 50</span></li>
                        <li><span class="sm-time">ca 17.00</span><span>Prisutdelning</span></li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="sm-day">
                    <div class="sm-day-head">Söndag 23 augusti <small>Vapengrupp A</small></div>
                    <ul>
                        <li><span class="sm-time">7.30–9.00</span><span>Vapenkontroll och nummerlappar</span></li>
                        <li><span class="sm-time">8.30–9.30</span><span>Inskjutning mot olympiska skidskyttetavlan</span></li>
                        <li><span class="sm-time">10.00</span><span>Start skjutlag 1, vapengrupp A</span></li>
                        <li><span class="sm-time">12.00</span><span>Start skjutlag 2, vapengrupp A</span></li>
                        <li><span class="sm-time">ca 15.00</span><span>Prisutdelning</span></li>
                    </ul>
                </div>
            </div>
        </div>
        <p class="mt-3 mb-0">
            <strong>Vapenkontrollen öppnar redan fredag 21 augusti kl. 18.00–21.00</strong> för dig som kommer
            kvällen innan.
        </p>
    </section>

    <section class="sm-section">
        <h2>Läs vidare</h2>
        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <a class="sm-card" href="/sm-springskytte-2026/pm">
                    <h3>📋 Tävlings-PM</h3>
                    <p>Hela PM:et: tävlingsområdet, genomförande per vapengrupp, stafetten, säkerhetsregler och lagtävlingar.</p>
                    <span class="sm-card-more">Läs PM:et →</span>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a class="sm-card" href="/sm-springskytte-2026/banor">
                    <h3>🗺️ Banor &amp; skjutområden</h3>
                    <p>Kartor över löpslingorna (blå, röd, svart och gul), skjutområde C med sektion A/B, samt skjutområde A.</p>
                    <span class="sm-card-more">Se kartorna →</span>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a class="sm-card" href="/sm-springskytte-2026/service">
                    <h3>🍔 Service &amp; boende</h3>
                    <p>Servering, parkering, toaletter och dusch, husvagn/husbil, bad i sjön och tips på boende.</p>
                    <span class="sm-card-more">Se servicen →</span>
                </a>
            </div>
            <div class="col-md-6 col-lg-3">
                <a class="sm-card" href="/sm-springskytte-2026/funktionarer">
                    <h3>🦺 För funktionärer</h3>
                    <p>Din roll, bemanningen på skjutområdet, tider — och länk till ditt personliga schema.</p>
                    <span class="sm-card-more">Funktionärsinfo →</span>
                </a>
            </div>
        </div>
    </section>

    <section class="sm-section">
        <h2>Resultat och tävlingssida</h2>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="sm-card">
                    <h3>🏆 Resultat och startlistor</h3>
                    <p>
                        @if (hasResults)
                        {
                            <text>
                                Resultatlistorna för vapengrupp C och A, individuellt och lagtävling — och
                                startlistorna som de såg ut på tävlingsdagarna.
                            </text>
                        }
                        else
                        {
                            <text>
                                Resultatlistorna kontrolleras och publiceras så snart de är klara. Startlistorna
                                ligger kvar som de såg ut på tävlingsdagarna.
                            </text>
                        }
                    </p>
                    <a class="btn btn-primary" href="/sm-springskytte-2026/startlistor">Till resultaten</a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="sm-card">
                    <h3>Tävlingssidan</h3>
                    <p>
                        Avgifter, laganmälan och betalning sköts på tävlingens egen sida.
                    </p>
                    <a class="btn btn-outline-primary" href="@compUrl">Till tävlingssidan</a>
                </div>
            </div>
        </div>
    </section>

    <section class="sm-section">
        <h2>Hitta hit</h2>
        <div class="row g-4">
            <div class="col-lg-7">
                <figure class="sm-figure">
                    <img src="~/images/sm-springskytte-2026/tavlingsomrade.jpg"
                         alt="Flygbild över tävlingsområdet i Släryds grustag med sekretariat, vapenkontroll, servering, start, målgång, skjutplats, publikområde och stafettens start och mål utmarkerade." />
                    <figcaption>Tävlingsområdet. Sekretariat, vapenkontroll och servering ligger samlat vid infarten; start, målgång och skjutområde ligger på andra sidan sjön.</figcaption>
                </figure>
            </div>
            <div class="col-lg-5">
                <div class="sm-card">
                    <h3>Adress</h3>
                    <p class="mb-2">
                        Släryds Grus<br />
                        Obbhult 1<br />
                        432 97 Rolfstorp
                    </p>
                    <p class="mb-2">
                        <strong>Koordinater:</strong> 57.131637, 12.513277<br />
                        <strong>Plus code:</strong> 4GJ7+J8 Stenaljung
                    </p>
                    <a class="btn btn-outline-primary btn-sm"
                       href="https://www.google.com/maps/search/?api=1&query=57.131637,12.513277"
                       target="_blank" rel="noopener">Öppna i Google Maps</a>
                </div>
            </div>
        </div>
    </section>

    <section class="sm-section">
        <h2>Frågor?</h2>
        <div class="sm-card">
            @if (!string.IsNullOrEmpty(contactName) || !string.IsNullOrEmpty(contactEmail))
            {
                <p class="mb-1"><strong>Tävlingsledare:</strong> @contactName</p>
                if (!string.IsNullOrEmpty(contactEmail))
                {
                    <p class="mb-1"><strong>E-post:</strong> <a href="mailto:@contactEmail">@contactEmail</a></p>
                }
                if (!string.IsNullOrEmpty(contactPhone))
                {
                    <p class="mb-1"><strong>Telefon:</strong> <a href="tel:@contactPhone">@contactPhone</a></p>
                }
            }
            else
            {
                <p class="mb-1">Kontaktuppgifter finns på tävlingssidan.</p>
            }
            <p class="mb-0 mt-2">Arrangör: Hallands Pistolskyttekrets.</p>
        </div>
    </section>

    @await Html.PartialAsync("_SmSpringskytteFot")

</div>
