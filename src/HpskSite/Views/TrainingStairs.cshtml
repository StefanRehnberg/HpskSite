                            </div>
                            ${isAdmin && canApproveParticipant(member) ? `
                                <button class="btn btn-sm btn-outline-primary py-0 px-1" onclick="viewMemberProgress(${member.memberId})">
                                    <i class="bi bi-eye"></i>
