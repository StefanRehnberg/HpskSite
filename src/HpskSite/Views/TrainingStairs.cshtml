// Training Group member view functions
function onTrainingGroupChanged() {
    selectedTrainingGroupId = parseInt(document.getElementById('trainingGroupSelect').value);
    loadTrainingGroupProgress();
}

async function loadTrainingGroupProgress() {
    if (!selectedTrainingGroupId) return;

    const container = document.getElementById('trainingGroupContent');
    container.innerHTML = `
        <div class="text-center py-3">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span class="ms-2">Laddar...</span>
        </div>
    `;

    try {
        const response = await fetch(`/umbraco/surface/TrainingGroup/GetTrainingGroupProgress?trainingGroupId=${selectedTrainingGroupId}`);
        const result = await response.json();

        if (!result.success) {
            container.innerHTML = `<div class="alert alert-warning">${result.message}</div>`;
            return;
        }

        const data = result.data;
        const group = data.group;
        const myGroup = myTrainingGroups.find(g => g.id === selectedTrainingGroupId);
        const isTrainer = myGroup?.myRole === 'Trainer';

        // Update header
        document.getElementById('trainingGroupHeader').textContent =
            `${group.clubName || ''} - Startdatum: ${group.startDate}`;

        // Show/hide send message button for trainers/admins
        document.getElementById('sendGroupMessageBtn').style.display =
            (isTrainer || isAdmin) ? '' : 'none';

        // Show trainer names
        let trainers = myGroup?.trainers || [];
        let trainerHtml = trainers.length > 0
            ? `<div class="mb-3"><small class="text-muted">Tränare: ${trainers.map(t => t.memberName).join(', ')}</small></div>`
            : '';

        let html = trainerHtml;

        if (data.members.length === 0) {
            html += '<p class="text-muted">Inga medlemmar i gruppen.</p>';
        } else {
            // Sort: trainers first, then by level desc, step desc
            const sorted = [...data.members].sort((a, b) => {
                if (a.role === 'Trainer' && b.role !== 'Trainer') return -1;
                if (a.role !== 'Trainer' && b.role === 'Trainer') return 1;
                if (b.currentLevel !== a.currentLevel) return b.currentLevel - a.currentLevel;
                return b.currentStep - a.currentStep;
            });

            html += '<div class="list-group">';
            sorted.forEach(m => {
                const progress = Math.round(m.overallProgress || 0);
                html += `
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="me-3" style="min-width: 0;">
                                <div class="fw-bold text-truncate">
                                    ${m.levelBadge ? `<span class="me-1">${m.levelBadge}</span>` : ''}
                                    ${m.memberName}
                                    ${m.role === 'Trainer' ? '<span class="badge bg-info ms-1">Tränare</span>' : ''}
                                </div>
                                <small class="text-muted">${m.levelName} - Steg ${m.currentStep}</small>
                                ${m.lastActivity ? `<br><small class="text-muted">Senast aktiv: ${m.lastActivity}</small>` : ''}
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                <div class="text-end me-2">
                                    <small class="d-block">${m.completedSteps} steg</small>
                                    <div class="progress" style="width: 60px; height: 16px;">
                                        <div class="progress-bar bg-success" role="progressbar" style="width: ${progress}%">
                                            <small style="font-size: 0.65rem;">${progress}%</small>
                                        </div>
                                    </div>
                                </div>
                                ${(isTrainer || isAdmin) && m.role !== 'Trainer' ? `
                                    <button class="btn btn-sm btn-outline-primary py-0 px-2" onclick="viewMemberProgressWithApproval(${m.memberId}, '${escapeHtml(m.memberName)}')" title="Visa framsteg">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-success py-0 px-2" onclick="showCompleteStepModal(${m.memberId}, '${escapeHtml(m.memberName)}', ${m.currentLevel}, ${m.currentStep})" title="Godkänn steg">
                                        <i class="bi bi-check-lg"></i> Godkänn
                                    </button>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
        }

        container.innerHTML = html;
    } catch (error) {
        console.error('Error loading training group progress:', error);
        container.innerHTML = '<div class="alert alert-danger">Fel vid laddning av träningsgrupp</div>';
    }
}

function escapeHtml(str) {
    const div = document.createElement('div');
    div.appendChild(document.createTextNode(str));
    return div.innerHTML;
}

function showSendGroupMessageModal() {
    document.getElementById('groupMsgSubject').value = '';
    document.getElementById('groupMsgBody').value = '';
