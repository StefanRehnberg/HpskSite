@using Umbraco.Cms.Core.Security
@using HpskSite.Models.ViewModels.Training
@inject IMemberManager MemberManager
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "Master.cshtml";
    var pageTitle = Model.Value<string>("pageTitle") ?? "Skyttetrappan - Träningsprogram";
    var pageSubtitle = Model.Value<string>("pageSubtitle") ?? "Progressivt träningsprogram för pistolskytte";
    ViewBag.Title = pageTitle;

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;
}

<div class="container py-4">
    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="h3 mb-1">Skyttetrappan</h1>
        <p class="text-muted mb-0">Progressivt träningsprogram för pistolskytte</p>
    </div>

    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-4 order-2 order-lg-2 mb-4 mb-lg-0">
            @if (isLoggedIn)
            {
                <!-- Kom igång Card (hidden once training has started) -->
                <div class="card border-success mb-3" id="startTrainingCard" style="display: none;">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0"><i class="bi bi-bullseye me-2"></i>Kom igång</h6>
                    </div>
                    <div class="card-body">
                        <p class="small mb-3">Du har inte påbörjat träningsprogrammet än. Starta för att börja följa dina framsteg!</p>
                        <div class="d-grid gap-2">
                            <button class="btn btn-success" onclick="startTraining()">
                                <i class="bi bi-play-circle me-2"></i>Börja träning
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Help Card -->
            <div class="card" id="helpCard">
                <div class="card-header bg-body-tertiary">
                    <h6 class="mb-0"><i class="bi bi-question-circle me-2"></i>Hur fungerar det?</h6>
                </div>
                <div class="card-body">
                    <ul class="small mb-3 ps-3">
                        <li>9 nivåer från nybörjare till rekord</li>
                        <li>74 steg med tydliga mål</li>
                        <li>Avancera under handledning av instruktör</li>
                        <li>Följ dina framsteg i realtid</li>
                    </ul>
                    <div class="d-flex flex-column gap-2">
                        <button class="btn btn-sm btn-outline-primary" onclick="TutorialHelper.open('tutorial-05')">
                            <i class="bi bi-play-circle me-1"></i>Se instruktionsvideo
                        </button>
                    </div>
                </div>
            </div>

            <!-- About Card -->
            <div class="card mt-3">
                <div class="card-header bg-body-tertiary">
                    <h6 class="mb-0"><i class="bi bi-lightbulb me-2"></i>Om Skyttetrappan</h6>
                </div>
                <div class="card-body">
                    <p class="small mb-2">
                        Skyttetrappan finns till för att ge nya skyttar ett roligt och strukturerat sätt att träna mot sina första tre guldserier. Tydliga delmål och steg gör det lättare att se framsteg och hålla motivationen uppe.
                    </p>
                    <p class="small mb-2">
                        Efter guldnivån kan den som vill fortsätta i sin egen takt uppåt i trappan, men det är helt frivilligt.
                    </p>
                    <p class="small mb-2">
                        Programmet är under testning och långt ifrån färdigt. Vi uppskattar all feedback och hoppas att många klubbar vill vara med och prova!
                    </p>
                    <div class="d-flex flex-column gap-2">
                        <a href="mailto:trappan@pistol.nu" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-envelope me-1"></i>Frågor eller förslag? Maila oss
                        </a>
                    </div>
                </div>
            </div>

            @if (!isLoggedIn)
            {
                <!-- Login Card -->
                <div class="card mt-3 border-info">
                    <div class="card-body">
                        <i class="bi bi-info-circle me-2 text-info"></i>
                        <strong>Logga in för att börja</strong>
                        <p class="small text-muted mt-2 mb-2">Du behöver vara inloggad som medlem för att starta ditt träningsprogram och se dina personliga framsteg.</p>
                        <a href="/login-register" class="btn btn-primary btn-sm">Logga in</a>
                    </div>
                </div>
            }
        </div>

        <!-- Main Content -->
        <div class="col-lg-8 order-1 order-lg-1">
            <!-- Main Navigation Tabs -->
            <ul class="nav nav-tabs mb-4" id="trainingTabs" role="tablist">
                <!-- Tab 1: Trappan (always first, always default active) -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="levels-tab" data-bs-toggle="tab" data-bs-target="#levels" type="button" role="tab">
                        <i class="bi bi-ladder me-1"></i>Trappan
                    </button>
                </li>
                <!-- Tab 2: Mina Framsteg (only visible if logged in) -->
                @if (isLoggedIn)
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="progress-tab" data-bs-toggle="tab" data-bs-target="#progress" type="button" role="tab">
                            <i class="bi bi-person-check me-1"></i>Mina Framsteg
                        </button>
                    </li>
                }
                <!-- Tab 3: Min Träningsgrupp (hidden by default, shown via JS if user belongs to a training group) -->
                <li class="nav-item" role="presentation" id="mytraininggroup-tab-item" style="display: none;">
                    <button class="nav-link" id="mytraininggroup-tab" data-bs-toggle="tab" data-bs-target="#mytraininggroup" type="button" role="tab">
                        <i class="bi bi-people-fill me-1"></i>Min Träningsgrupp
                    </button>
                </li>
                <!-- Tab 4: Deltagare -->
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="leaderboard-tab" data-bs-toggle="tab" data-bs-target="#leaderboard-content" type="button" role="tab">
                        <i class="bi bi-trophy me-1"></i>Deltagare
                    </button>
                </li>
                <!-- Tab 5: Administration (only visible if admin, hidden by default) -->
                <li class="nav-item" role="presentation" id="admin-tab-item" style="display: none;">
                    <button class="nav-link" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin" type="button" role="tab">
                        <i class="bi bi-gear me-1"></i>Administration
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content" id="trainingTabContent">
                <!-- Training Levels Tab (Tab 1 - always default active) -->
                <div class="tab-pane fade show active" id="levels" role="tabpanel">
                    <div class="card border-success">
                        <div class="card-header bg-success text-white">
                            <h4 class="mb-0"><i class="bi bi-ladder me-2"></i>Trappan</h4>
                            <small class="opacity-75">9 nivåer från nybörjare till rekord</small>
                        </div>
                        <div class="card-body" id="trainingLevels">
                            <div class="text-center py-5">
                                <div class="spinner-border text-success" role="status">
                                    <span class="visually-hidden">Laddar...</span>
                                </div>
                                <p class="mt-3">Laddar träningsnivåer...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- My Progress Tab (Tab 2 - Mina Framsteg, only for logged-in users) -->
                @if (isLoggedIn)
                {
                    <div class="tab-pane fade" id="progress" role="tabpanel">
                        <div id="memberProgress">
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Laddar...</span>
                                </div>
                                <p class="mt-3">Laddar dina träningsframsteg...</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- My Training Group Tab -->
                <div class="tab-pane fade" id="mytraininggroup" role="tabpanel">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Min Träningsgrupp</h4>
                                    <small class="opacity-75" id="trainingGroupHeader"></small>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <div id="trainingGroupSelector" style="display: none;">
                                        <select class="form-select form-select-sm bg-white" id="trainingGroupSelect" onchange="onTrainingGroupChanged()">
                                        </select>
                                    </div>
                                    <button class="btn btn-sm btn-outline-light" id="sendGroupMessageBtn" style="display: none;"
                                            onclick="showSendGroupMessageModal()" title="Skicka meddelande till gruppen">
                                        <i class="bi bi-envelope"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="card-body" id="trainingGroupContent">
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Laddar...</span>
                                </div>
                                <p class="mt-3">Laddar träningsgrupp...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Leaderboard Tab (Tab 4 - Deltagare) -->
                <div class="tab-pane fade" id="leaderboard-content" role="tabpanel">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white">
                            <h4 class="mb-0"><i class="bi bi-people me-2"></i>Deltagare</h4>
                            <small>Se vilka medlemmar som tränar på Skyttetrappan</small>
                        </div>
                        <div class="card-body" id="leaderboard">
                            <div class="text-center py-5">
                                <div class="spinner-border text-warning" role="status">
                                    <span class="visually-hidden">Laddar...</span>
                                </div>
                                <p class="mt-3">Laddar träningsdeltagare...</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admin Tab (Tab 5 - Administration) -->
                <div class="tab-pane fade" id="admin" role="tabpanel">
                    <div class="card border-danger">
                        <div class="card-header bg-danger text-white">
                            <h4 class="mb-0"><i class="bi bi-gear me-2"></i>Administration</h4>
                            <small class="opacity-75">Hantera medlemmarnas träningsframsteg</small>
                        </div>
                        <div class="card-body" id="adminContent">
                            <div class="text-center py-5">
                                <div class="spinner-border text-danger" role="status">
                                    <span class="visually-hidden">Laddar...</span>
                                </div>
                                <p class="mt-3">Laddar adminpanel...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (isLoggedIn)
            {
                <!-- Anti-forgery token for AJAX requests -->
                @Html.AntiForgeryToken()
            }
        </div>
    </div>
</div>

<!-- Training Step Modal -->
<div class="modal fade" id="stepModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="stepModalTitle">Steg Detaljer</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="stepModalBody">
                <!-- Step details will be loaded here -->
            </div>
            <div class="modal-footer" id="stepModalFooter">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Complete Step Modal (Admin only) -->
<div class="modal fade" id="completeStepModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Markera Steg som Slutfört</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="completeStepForm">
                    <input type="hidden" id="completeMemberId" name="memberId">
                    <input type="hidden" id="completeLevelId" name="levelId">
                    <input type="hidden" id="completeStepNumber" name="stepNumber">

                    <div class="mb-3">
                        <label class="form-label"><strong>Medlem:</strong></label>
                        <p id="completeMemberName" class="form-control-plaintext"></p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label"><strong>Steg:</strong></label>
                        <p id="completeStepDescription" class="form-control-plaintext"></p>
                    </div>

                    <div class="mb-3">
                        <label for="completeNotes" class="form-label">Anteckningar (valfritt)</label>
                        <textarea class="form-control" id="completeNotes" name="notes" rows="3"
                                  placeholder="T.ex. resultat, datum, eller andra kommentarer..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-success" onclick="submitStepCompletion()">
                    <i class="bi bi-check-circle"></i> Markera som Slutfört
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Member Progress Modal (Admin only) -->
<div class="modal fade" id="memberProgressModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-person-badge me-2"></i>
                    Medlemsframsteg
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Member Info -->
                <div class="card mb-3">
                    <div class="card-body">
                        <h6 class="card-title mb-3" id="progressMemberName"></h6>
                        <div class="row">
                            <div class="col-md-4">
                                <small class="text-muted">Klubb</small>
                                <p class="mb-2" id="progressClubName">-</p>
                            </div>
                            <div class="col-md-5">
                                <small class="text-muted">Nuvarande Nivå</small>
                                <p class="mb-2" id="progressCurrentLevel">-</p>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Framsteg</small>
                                <p class="mb-2" id="progressPercentage">-</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Completed Steps -->
                <h6 class="mb-3">Slutförda Steg</h6>
                <div id="completedStepsList" class="list-group">
                    <!-- Steps will be populated here -->
                </div>

                <!-- Empty State -->
                <div id="noStepsMessage" class="alert alert-info" style="display: none;">
                    <i class="bi bi-info-circle me-2"></i>
                    Inga slutförda steg ännu.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" id="progressResetBtn" style="display: none;">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Nollställ
                </button>
                <button type="button" class="btn btn-secondary ms-auto" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Send Group Message Modal -->
<div class="modal fade" id="sendGroupMessageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-envelope me-2"></i>Skicka meddelande till gruppen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="groupMsgSubject" class="form-label">Ämne *</label>
                    <input type="text" class="form-control" id="groupMsgSubject" placeholder="T.ex. Träningen inställd tisdag">
                </div>
                <div class="mb-3">
                    <label for="groupMsgBody" class="form-label">Meddelande *</label>
                    <textarea class="form-control" id="groupMsgBody" rows="5" placeholder="Skriv ditt meddelande här..."></textarea>
                </div>
                <small class="text-muted">Meddelandet skickas via e-post till alla medlemmar i gruppen.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="sendGroupMsgBtn" onclick="sendGroupMessage()">
                    <i class="bi bi-send me-2"></i>Skicka
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Create Training Group Modal -->
<div class="modal fade" id="createTrainingGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Skapa ny träningsgrupp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createTrainingGroupForm">
                    <div class="mb-3">
                        <label for="tgName" class="form-label">Namn</label>
                        <input type="text" class="form-control" id="tgName" required placeholder="T.ex. Nybörjargrupp VT2026">
                    </div>
                    <div class="mb-3">
                        <label for="tgClubId" class="form-label">Klubb</label>
                        <select class="form-select" id="tgClubId" required>
                            <option value="">Välj klubb...</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="tgDescription" class="form-label">Beskrivning (valfritt)</label>
                        <textarea class="form-control" id="tgDescription" rows="2" placeholder="Kort beskrivning av gruppen..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="tgStartDate" class="form-label">Startdatum</label>
                        <input type="text" class="form-control" id="tgStartDate" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-success" onclick="submitCreateTrainingGroup()">
                    <i class="bi bi-plus-circle me-1"></i>Skapa
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Training Group Modal -->
<div class="modal fade" id="editTrainingGroupModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Redigera träningsgrupp</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editTrainingGroupForm">
                    <input type="hidden" id="editTgId">
                    <div class="mb-3">
                        <label for="editTgName" class="form-label">Namn</label>
                        <input type="text" class="form-control" id="editTgName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editTgDescription" class="form-label">Beskrivning</label>
                        <textarea class="form-control" id="editTgDescription" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editTgStartDate" class="form-label">Startdatum</label>
                        <input type="text" class="form-control" id="editTgStartDate" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="submitEditTrainingGroup()">
                    <i class="bi bi-check-circle me-1"></i>Spara
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Training Group Member Modal -->
<div class="modal fade" id="addTrainingGroupMemberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Lägg till medlem</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="addMemberTgId">
                <div class="mb-3">
                    <label for="memberSearchInput" class="form-label">Sök medlem</label>
                    <input type="text" class="form-control" id="memberSearchInput" placeholder="Namn eller e-post..." oninput="searchMembersForTrainingGroup()">
                </div>
                <div id="memberSearchResults" class="list-group mb-3" style="max-height: 200px; overflow-y: auto;">
                </div>
                <div id="selectedMemberInfo" class="alert alert-info d-none mb-3">
                    <strong id="selectedMemberName"></strong>
                    <input type="hidden" id="selectedMemberIdForAdd">
                </div>
                <div class="mb-3">
                    <label for="addMemberRole" class="form-label">Roll</label>
                    <select class="form-select" id="addMemberRole">
                        <option value="Member">Medlem</option>
                        <option value="Trainer">Tränare</option>
                    </select>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="addMemberSendEmail">
                    <label class="form-check-label" for="addMemberSendEmail">
                        Skicka e-post till medlemmen
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-success" onclick="confirmAddMember()">
                    <i class="bi bi-person-plus me-2"></i>Lägg till
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .training-level-card {
        transition: transform 0.2s ease-in-out;
        border-left: 4px solid #007bff;
    }

    .training-level-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* Scrollable completed steps list in member progress modal */
    #completedStepsList {
        max-height: 400px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Mobile responsive - use more of viewport height */
    @@media (max-width: 768px) {
        #completedStepsList {
            max-height: 50vh;
        }
    }

    .training-step {
        padding: 8px;
        margin: 4px 0;
        border-radius: 4px;
        border-left: 3px solid var(--bs-border-color);
        background-color: var(--bs-secondary-bg);
    }

    .training-step.completed {
        background-color: var(--bs-success-bg-subtle);
        border-left-color: var(--bs-success);
    }

    .training-step.current {
        background-color: var(--bs-warning-bg-subtle);
        border-left-color: var(--bs-warning);
    }

    .training-step.pending {
        background-color: var(--bs-secondary-bg);
        border-left-color: var(--bs-secondary);
    }

    .badge-level {
        font-size: 1.2em;
        margin-right: 8px;
    }

    .progress-ring {
        width: 60px;
        height: 60px;
    }

    .member-progress-card {
        border-left: 4px solid #28a745;
    }

    .leaderboard-row:hover {
        background-color: #f8f9fa;
    }

    .competition-required {
        color: #dc3545;
        font-weight: bold;
    }
</style>

<!-- Flatpickr Date Picker -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<script>
let isAdmin = false;
let isSiteAdmin = false;
let isSkjutledare = false;
let managedClubIds = [];
let skjutledareClubIds = [];
let currentMemberProgress = null;
let allLevels = [];
let leaderboardData = [];
let clubsData = [];
let regionsData = [];
let clubRegionMap = {};
let myTrainingGroups = [];
let selectedTrainingGroupId = null;
let selectedMemberForAdd = null;

document.addEventListener('DOMContentLoaded', function() {
    loadTrainingData();
});

// Helper function to use XMLHttpRequest as fallback
function fetchWithXHR(url) {
    return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('GET', url, true);
        xhr.setRequestHeader('Accept', 'application/json');

        xhr.onload = function() {
            if (xhr.status >= 200 && xhr.status < 300) {
                try {
                    const data = JSON.parse(xhr.responseText);
                    resolve(data);
                } catch (parseError) {
                    reject(new Error('Failed to parse JSON response'));
                }
            } else {
                reject(new Error(`HTTP ${xhr.status}: ${xhr.statusText}`));
            }
        };

        xhr.onerror = function() {
            reject(new Error('Network error'));
        };

        xhr.ontimeout = function() {
            reject(new Error('Request timeout'));
        };

        xhr.timeout = 10000; // 10 second timeout
        xhr.send();
    });
}

async function loadTrainingData() {
    console.log('Loading training data...');
    let data = null;

    // Try to get data using multiple approaches
    try {
        console.log('Attempting to fetch training data...');
        const response = await fetch('/umbraco/surface/Training/GetTrainingOverview', {
            method: 'GET',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json'
            },
            cache: 'no-cache'
        });

        console.log('Response received:', response.status, response.ok);

        if (response.ok) {
            data = await response.json();
            console.log('JSON parsed successfully:', data);
        }
    } catch (error) {
        console.warn('Fetch failed, trying XHR fallback:', error);

        // Try XMLHttpRequest fallback
        try {
            data = await fetchWithXHR('/umbraco/surface/Training/GetTrainingOverview');
            console.log('XHR fallback succeeded:', data);
        } catch (xhrError) {
            console.warn('XHR fallback also failed:', xhrError);
        }
    }

    // Process the data if we got it successfully
    if (data && data.success) {
        console.log('Processing training data...');
        currentMemberProgress = data.data.currentMemberProgress;
        allLevels = data.data.allLevels;

        console.log('Member progress:', currentMemberProgress);
        console.log('All levels:', allLevels);

        // Display training levels
        displayTrainingLevels(allLevels);

        // Check if user is logged in (based on having currentMemberProgress or not)
        const isUserLoggedIn = @Html.Raw(isLoggedIn ? "true" : "false");

        if (isUserLoggedIn) {
            // Display member progress if logged in
            // Check trainingStartDate to determine if member has actually started
            if (currentMemberProgress && currentMemberProgress.trainingStartDate) {
                displayMemberProgress(currentMemberProgress);
            } else {
                // Show "Kom igång" card in sidebar
                const startCard = document.getElementById('startTrainingCard');
                if (startCard) startCard.style.display = 'block';
            }

            // Check if user is admin, then load leaderboard (needs admin status for buttons)
            await checkAdminStatus();
        }

        // Fetch clubs and regions for participant filtering
        const [clubsRes, regionsRes] = await Promise.all([
            fetch('/umbraco/surface/ClubAdmin/GetClubsPublic').then(r => r.json()).catch(() => null),
            fetch('/umbraco/surface/RegionalAdmin/GetAllRegions').then(r => r.json()).catch(() => null)
        ]);

        if (clubsRes?.success) {
            clubsData = clubsRes.clubs;
            clubsData.forEach(c => { clubRegionMap[c.id] = c.regionalFederation; });
        }
        if (regionsRes?.success) {
            regionsData = regionsRes.regions;
        }

        // Load leaderboard
        loadLeaderboard();
    } else {
        console.error('Failed to load training data or invalid response:', data);
        // Provide fallback data if API fails
        showError('API-anslutning misslyckades. Visar grundläggande träningsinformation.');
        loadFallbackData();
    }
}

