                                <button class="btn btn-sm btn-success py-0 px-1" onclick="showCompleteStepModal(${member.memberId}, '${member.memberName}', ${member.currentLevel}, ${member.currentStep})">
                                    <i class="bi bi-check"></i> Godkänn
                                </button>
                                ${isSiteAdmin ? `<button class="btn btn-sm btn-outline-danger py-0 px-1" onclick="resetMemberProgress(${member.memberId}, '${member.memberName}')" title="Nollställ framsteg"><i class="bi bi-arrow-counterclockwise"></i></button>` : ''}
                            ` : isAdmin ? `
