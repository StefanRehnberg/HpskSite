}

async function sendGroupMessage() {
    const subject = document.getElementById('groupMsgSubject').value.trim();
    const message = document.getElementById('groupMsgBody').value.trim();

    if (!subject) { alert('Ange ett ämne'); return; }
    if (!message) { alert('Skriv ett meddelande'); return; }
    if (!selectedTrainingGroupId) { alert('Ingen träningsgrupp vald'); return; }

    const btn = document.getElementById('sendGroupMsgBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Skickar...';

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new FormData();
        formData.append('__RequestVerificationToken', token);
        formData.append('trainingGroupId', selectedTrainingGroupId);
        formData.append('subject', subject);
        formData.append('message', message);

        const response = await fetch('/umbraco/surface/TrainingGroup/SendGroupMessage', {
            method: 'POST',
            body: formData
        });

        const result = await response.json();

        if (result.success) {
            bootstrap.Modal.getInstance(document.getElementById('sendGroupMessageModal')).hide();
            alert(result.message);
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Error sending group message:', error);
        alert('Ett fel uppstod vid sändning av meddelande');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-send me-2"></i>Skicka';
    }
}

function showCompleteStepModal(memberId, memberName, levelId = null, stepNumber = null) {
    // Validate that levelId and stepNumber are provided
    if (!levelId || !stepNumber) {
        alert('Kunde inte hitta stegets information');
        return;
    }

    const level = allLevels.find(l => l.levelId === levelId);
    const step = level?.steps.find(s => s.stepNumber === stepNumber);

    if (!step) {
        alert('Kunde inte hitta steget');
        return;
    }

    document.getElementById('completeMemberId').value = memberId;
    document.getElementById('completeLevelId').value = levelId;
    document.getElementById('completeStepNumber').value = stepNumber;
    document.getElementById('completeMemberName').textContent = memberName;
    document.getElementById('completeStepDescription').textContent =
        `${level.name} - Steg ${stepNumber}: ${step.description}`;
    document.getElementById('completeNotes').value = '';

    new bootstrap.Modal(document.getElementById('completeStepModal')).show();
}

async function submitStepCompletion() {
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new FormData();

        formData.append('__RequestVerificationToken', token);
        formData.append('memberId', document.getElementById('completeMemberId').value);
        formData.append('levelId', document.getElementById('completeLevelId').value);
        formData.append('stepNumber', document.getElementById('completeStepNumber').value);
        formData.append('notes', document.getElementById('completeNotes').value);

        const response = await fetch('/umbraco/surface/Training/CompleteStep', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            alert('Steg markerat som slutfört!');
            bootstrap.Modal.getInstance(document.getElementById('completeStepModal')).hide();
            // Also close the member progress modal if open
            const progressModal = bootstrap.Modal.getInstance(document.getElementById('memberProgressModal'));
            if (progressModal) progressModal.hide();
            // Refresh training group view if active
            if (selectedTrainingGroupId && document.getElementById('mytraininggroup')?.classList.contains('show')) {
                loadTrainingGroupProgress();
            }
            refreshData(); // Reload all data
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error completing step:', error);
        alert('Ett fel uppstod vid slutförande av steg');
    }
}

async function viewMemberProgress(memberId) {
    try {
        const response = await fetch(`/umbraco/surface/Training/GetMemberProgress?memberId=${memberId}`);
        const result = await response.json();

        if (result.success && result.data) {
            const data = result.data;
            const progress = data.progress;

            // Populate member info
            document.getElementById('progressMemberName').textContent = progress.memberName;
            document.getElementById('progressClubName').textContent = progress.primaryClubName || 'Ingen klubb';

            const currentLevel = data.currentLevel;
            const currentStep = data.currentStep;
            const levelEl = document.getElementById('progressCurrentLevel');
            if (currentLevel) {
                levelEl.innerHTML = `
                    ${currentLevel.badge} ${currentLevel.name} - Steg ${progress.currentStep}
                    ${currentStep ? `<br><small class="text-muted">Nästa steg: ${currentStep.description}</small>` : ''}
                `;
            } else {
                levelEl.textContent = 'Nivå 1';
            }

            document.getElementById('progressPercentage').textContent =
                `${Math.round(progress.overallCompletionPercentage)}%`;

            // Populate completed steps
            const stepsList = document.getElementById('completedStepsList');
            const noStepsMsg = document.getElementById('noStepsMessage');

            if (progress.completedSteps && progress.completedSteps.length > 0) {
                stepsList.style.display = 'block';
                noStepsMsg.style.display = 'none';

                // Sort by completed date (most recent first)
                const sortedSteps = [...progress.completedSteps].sort((a, b) =>
                    new Date(b.completedDate) - new Date(a.completedDate)
                );

                let stepsHtml = '';
                sortedSteps.forEach(step => {
                    const level = data.allLevels.find(l => l.levelId === step.levelId);
                    const stepInfo = level?.steps.find(s => s.stepNumber === step.stepNumber);
                    const completedDate = formatDate(step.completedDate);

                    stepsHtml += `
                        <div class="list-group-item">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">
                                        <span class="badge bg-primary me-2">${level?.badge || ''}</span>
                                        ${level?.name || 'Nivå ' + step.levelId} - Steg ${step.stepNumber}
                                    </h6>
                                    <p class="mb-1 text-muted small">${stepInfo?.description || ''}</p>
                                    ${step.notes ? `<p class="mb-1"><small><strong>Anteckningar:</strong> ${step.notes}</small></p>` : ''}
                                </div>
                                <div class="text-end">
                                    <small class="text-muted">${completedDate}</small>
                                    ${step.instructorName ? `<br><small class="text-muted">Godkänd av: ${step.instructorName}</small>` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                });

                stepsList.innerHTML = stepsHtml;
            } else {
                stepsList.style.display = 'none';
                noStepsMsg.style.display = 'block';
            }

            // Hide reset button in read-only view
            document.getElementById('progressResetBtn').style.display = 'none';

            // Show modal
            new bootstrap.Modal(document.getElementById('memberProgressModal')).show();
        } else {
            alert('Kunde inte hämta medlemsframsteg: ' + (result.message || 'Okänt fel'));
        }
    } catch (error) {
        console.error('Error fetching member progress:', error);
        alert('Ett fel uppstod vid hämtning av medlemsframsteg');
    }
}

async function viewMemberProgressWithApproval(memberId, memberName) {
    try {
        const response = await fetch(`/umbraco/surface/Training/GetMemberProgress?memberId=${memberId}`);
        const result = await response.json();

        if (!result.success || !result.data) {
            alert('Kunde inte hämta medlemsframsteg: ' + (result.message || 'Okänt fel'));
            return;
        }

        const data = result.data;
        const progress = data.progress;
        const completedSteps = progress.completedSteps || [];

        // Populate member info
        document.getElementById('progressMemberName').textContent = progress.memberName;
        document.getElementById('progressClubName').textContent = progress.primaryClubName || 'Ingen klubb';

        const currentLevel = data.currentLevel;
        const levelEl = document.getElementById('progressCurrentLevel');
        if (currentLevel) {
            levelEl.innerHTML = `${currentLevel.badge} ${currentLevel.name} - Steg ${progress.currentStep}`;
        } else {
            levelEl.textContent = 'Nivå 1';
        }

        document.getElementById('progressPercentage').textContent =
            `${Math.round(progress.overallCompletionPercentage)}%`;

        // Build accordion of all levels with approve buttons
        const stepsList = document.getElementById('completedStepsList');
        const noStepsMsg = document.getElementById('noStepsMessage');
        noStepsMsg.style.display = 'none';
        stepsList.style.display = 'block';

        let html = '<div class="accordion" id="progressAccordion">';
        data.allLevels.forEach((level, idx) => {
            const levelCompleted = level.steps.every(s =>
                completedSteps.some(cs => cs.levelId === level.levelId && cs.stepNumber === s.stepNumber));
            const levelStepsCompleted = level.steps.filter(s =>
                completedSteps.some(cs => cs.levelId === level.levelId && cs.stepNumber === s.stepNumber)).length;
            const isCurrentLevel = level.levelId === progress.currentLevel;
            const expanded = isCurrentLevel ? 'true' : 'false';
            const show = isCurrentLevel ? 'show' : '';

            html += `
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button ${show ? '' : 'collapsed'} py-2" type="button" data-bs-toggle="collapse" data-bs-target="#lvl${level.levelId}" aria-expanded="${expanded}">
                            <span class="me-2">${level.badge}</span>
                            <strong>${level.name}</strong>
                            <span class="ms-2 badge ${levelCompleted ? 'bg-success' : 'bg-secondary'}">${levelStepsCompleted}/${level.steps.length}</span>
                        </button>
                    </h2>
                    <div id="lvl${level.levelId}" class="accordion-collapse collapse ${show}" data-bs-parent="#progressAccordion">
                        <div class="accordion-body p-2">
                            <div class="list-group list-group-flush">`;

            level.steps.forEach(step => {
                const completed = completedSteps.find(cs => cs.levelId === level.levelId && cs.stepNumber === step.stepNumber);
                if (completed) {
                    const completedDate = formatDate(completed.completedDate);
                    html += `
                        <div class="list-group-item px-2 py-1 d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                <small>Steg ${step.stepNumber}: ${step.description}</small>
                                <br><small class="text-muted ms-4">${completedDate}${completed.instructorName ? ' - ' + completed.instructorName : ''}</small>
                            </div>
                        </div>`;
                } else {
                    html += `
                        <div class="list-group-item px-2 py-1 d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-circle text-muted me-1"></i>
                                <small>Steg ${step.stepNumber}: ${step.description}</small>
                            </div>
                            <button class="btn btn-sm btn-success py-0 px-2" onclick="showCompleteStepModal(${memberId}, '${escapeHtml(memberName || progress.memberName)}', ${level.levelId}, ${step.stepNumber})" title="Godkänn">
                                <i class="bi bi-check-lg"></i>
                            </button>
                        </div>`;
                }
            });

            html += `
                            </div>
                        </div>
                    </div>
                </div>`;
        });
        html += '</div>';

        stepsList.innerHTML = html;

        // Show reset button for site admins
        const resetBtn = document.getElementById('progressResetBtn');
        if (isSiteAdmin) {
            resetBtn.style.display = '';
            resetBtn.onclick = () => {
                bootstrap.Modal.getInstance(document.getElementById('memberProgressModal')).hide();
                resetMemberProgress(memberId, memberName || progress.memberName);
            };
        } else {
            resetBtn.style.display = 'none';
        }

        new bootstrap.Modal(document.getElementById('memberProgressModal')).show();
    } catch (error) {
        console.error('Error fetching member progress with approval:', error);
        alert('Ett fel uppstod vid hämtning av medlemsframsteg');
    }
}

function refreshData() {
    loadTrainingData();
}

function formatDate(dateString) {
    if (!dateString) return 'Aldrig';
    const date = new Date(dateString);
    return date.toLocaleDateString('sv-SE');
}

function drawProgressRing(canvas, percentage) {
    const ctx = canvas.getContext('2d');
    const centerX = 30;
    const centerY = 30;
    const radius = 25;

    // Clear canvas
    ctx.clearRect(0, 0, 60, 60);

    // Background circle
    ctx.beginPath();
    ctx.arc(centerX, centerY, radius, 0, 2 * Math.PI);
    ctx.strokeStyle = '#e9ecef';
    ctx.lineWidth = 4;
    ctx.stroke();

    // Progress arc
    ctx.beginPath();
    ctx.arc(centerX, centerY, radius, -Math.PI/2, -Math.PI/2 + (2 * Math.PI * percentage / 100));
    ctx.strokeStyle = '#28a745';
    ctx.lineWidth = 4;
    ctx.lineCap = 'round';
    ctx.stroke();
}

