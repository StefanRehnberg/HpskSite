                return b.currentStep - a.currentStep;
            }
            return a.memberName.localeCompare(b.memberName);
        }).forEach(member => {
            const progress = Math.round(member.overallProgress || 0);

            html += `
                <div class="list-group-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="me-3" style="min-width: 0;">
                            <div class="fw-bold text-truncate">${member.memberName}</div>
                            <small class="text-muted text-truncate d-block">${member.clubName || 'Ingen klubb'}</small>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
