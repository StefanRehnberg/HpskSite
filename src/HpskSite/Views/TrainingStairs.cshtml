function populateFilterDropdowns() {
    const regionSelect = document.getElementById('regionFilter');
    const clubSelect = document.getElementById('clubFilter');
    if (!regionSelect || !clubSelect) return;

    // Determine which regions have active participants
    const participantClubIds = new Set(leaderboardData.map(m => m.primaryClubId).filter(Boolean));
    const participantRegions = new Set();
    participantClubIds.forEach(cid => {
        const region = clubRegionMap[cid];
        if (region) participantRegions.add(region);
    });

    // Populate regions (only those with participants)
    regionsData
        .filter(r => participantRegions.has(r.name))
        .sort((a, b) => a.name.localeCompare(b.name, 'sv'))
        .forEach(r => {
            const opt = document.createElement('option');
            opt.value = r.name;
            opt.textContent = r.name;
            regionSelect.appendChild(opt);
        });

    // Restore saved region
    const savedRegion = sessionStorage.getItem('skyttetrappan_region') || '';
    regionSelect.value = savedRegion;
    if (regionSelect.value !== savedRegion) regionSelect.value = '';

    // Populate clubs based on selected region
    populateClubDropdown();

    // Restore saved club
    const savedClub = sessionStorage.getItem('skyttetrappan_club') || '';
    clubSelect.value = savedClub;
    if (clubSelect.value !== savedClub) clubSelect.value = '';

    // Wire up change events
    regionSelect.addEventListener('change', () => {
        sessionStorage.setItem('skyttetrappan_region', regionSelect.value);
        populateClubDropdown();
        sessionStorage.setItem('skyttetrappan_club', '');
        refreshParticipantDisplay();
    });

    clubSelect.addEventListener('change', () => {
        sessionStorage.setItem('skyttetrappan_club', clubSelect.value);
        refreshParticipantDisplay();
    });
}

function populateClubDropdown() {
    const clubSelect = document.getElementById('clubFilter');
    if (!clubSelect) return;

    const regionVal = document.getElementById('regionFilter')?.value || '';

    clubSelect.innerHTML = '<option value="">Alla klubbar</option>';

    const participantClubIds = new Set(leaderboardData.map(m => m.primaryClubId).filter(Boolean));

    clubsData
        .filter(c => participantClubIds.has(c.id) && (!regionVal || c.regionalFederation === regionVal))
        .sort((a, b) => a.name.localeCompare(b.name, 'sv'))
        .forEach(c => {
            const opt = document.createElement('option');
            opt.value = c.id;
            opt.textContent = c.name;
            clubSelect.appendChild(opt);
        });
}

function getFilteredLeaderboard() {
    const regionVal = document.getElementById('regionFilter')?.value || '';
    const clubVal = document.getElementById('clubFilter')?.value || '';

    let filtered = leaderboardData;

    if (regionVal) {
        filtered = filtered.filter(m => clubRegionMap[m.primaryClubId] === regionVal);
    }
    if (clubVal) {
        const clubId = parseInt(clubVal);
        filtered = filtered.filter(m => m.primaryClubId === clubId);
    }

    return filtered;
}

function refreshParticipantDisplay() {
    const filtered = getFilteredLeaderboard();
    const display = document.getElementById('participantDisplay');

    if (filtered.length === 0) {
        display.innerHTML = '<p class="text-muted">Inga deltagare matchar vald filtrering.</p>';
        return;
    }

    if (document.getElementById('allView')?.checked) {
        displayAllParticipants(filtered);
    } else {
        displayGroupedParticipants(filtered);
    }
}

function displayGroupedParticipants(data) {
    const display = document.getElementById('participantDisplay');

    // Group by training level
    const grouped = data.reduce((acc, member) => {
        const levelId = member.currentLevel || 1;
        if (!acc[levelId]) {
            acc[levelId] = [];
        }
        acc[levelId].push(member);
        return acc;
    }, {});

    let html = '';

    // Sort levels by ID and display each group
    Object.keys(grouped).sort((a, b) => parseInt(a) - parseInt(b)).forEach(levelId => {
        const members = grouped[levelId];
        const levelInfo = allLevels?.find(l => l.levelId === parseInt(levelId));
        const levelName = levelInfo?.name || `Nivå ${levelId}`;
        const levelBadge = levelInfo?.badge || '🎯';

        html += `
            <div class="card mb-3">
