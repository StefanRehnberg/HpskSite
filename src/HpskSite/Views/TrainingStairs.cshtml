async function resetMemberProgress(memberId, memberName) {
    if (!confirm(`Vill du nollställa träningsframsteg för ${memberName}? Detta kan inte ångras.`)) return;

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new FormData();
        formData.append('__RequestVerificationToken', token);
        formData.append('memberId', memberId);

        const response = await fetch('/umbraco/surface/Training/ResetProgress', {
            method: 'POST',
            body: formData
        });

        const result = await response.json();

        if (result.success) {
            alert('Träningsframsteg nollställda för ' + memberName);
            refreshData();
        } else {
            alert('Fel: ' + result.message);
        }
    } catch (error) {
        console.error('Error resetting progress:', error);
        alert('Ett fel uppstod vid nollställning');
    }
}

async function startTraining() {
    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new FormData();
        formData.append('__RequestVerificationToken', token);

        const response = await fetch('/umbraco/surface/Training/StartTraining', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            alert('Träning påbörjad! Välkommen till Skyttetrappan!');
            location.reload(); // Reload to show progress
        } else {
            alert('Fel: ' + data.message);
        }
    } catch (error) {
        console.error('Error starting training:', error);
        alert('Ett fel uppstod vid start av träning');
    }
}

function showStepDetails(levelId, stepNumber) {
    const level = allLevels.find(l => l.levelId === levelId);
    const step = level?.steps.find(s => s.stepNumber === stepNumber);

    if (!step) return;

    document.getElementById('stepModalTitle').textContent =
        `${level.name} - Steg ${step.stepNumber}`;

    let isCompleted = false;
    let isCurrentStep = false;

    if (currentMemberProgress) {
        isCompleted = currentMemberProgress.isStepCompleted &&
                     currentMemberProgress.isStepCompleted(levelId, stepNumber);
        isCurrentStep = currentMemberProgress.currentLevel === levelId &&
                       currentMemberProgress.currentStep === stepNumber;
    }

    document.getElementById('stepModalBody').innerHTML = `
        <div class="mb-3">
            <h6>Beskrivning:</h6>
            <p>${step.description}</p>
            ${step.isCompetitionRequired ? '<div class="alert alert-info"><i class="bi bi-trophy"></i> <strong>Tävling krävs:</strong> Detta steg kräver resultat från tävling.</div>' : ''}
        </div>

        <div class="mb-3">
            <h6>Status:</h6>
            ${isCompleted ? '<span class="badge bg-success"><i class="bi bi-check-circle"></i> Slutfört</span>' : ''}
            ${isCurrentStep ? '<span class="badge bg-warning"><i class="bi bi-arrow-right-circle"></i> Pågående</span>' : ''}
            ${!isCompleted && !isCurrentStep ? '<span class="badge bg-secondary">Inte påbörjat</span>' : ''}
        </div>

        ${step.notes ? `
            <div class="mb-3">
                <h6>Anteckningar:</h6>
                <p class="text-muted">${step.notes}</p>
            </div>
        ` : ''}
    `;

    // Show admin action button if applicable
    let footerHtml = '<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>';

    if (isAdmin && !isCompleted && currentMemberProgress) {
        footerHtml += `
            <button type="button" class="btn btn-success" onclick="showCompleteStepModal(${currentMemberProgress.memberId}, '${currentMemberProgress.memberName}', ${levelId}, ${stepNumber})">
                <i class="bi bi-check-circle"></i> Markera som Slutfört
            </button>
        `;
    }

    document.getElementById('stepModalFooter').innerHTML = footerHtml;

    new bootstrap.Modal(document.getElementById('stepModal')).show();
}

async function checkAdminStatus() {
    try {
        const [adminRes, tgRes] = await Promise.all([
            fetch('/umbraco/surface/Training/GetTrainingAdminStatus').then(r => r.json()).catch(() => null),
            fetch('/umbraco/surface/TrainingGroup/GetMyTrainingGroups').then(r => r.json()).catch(() => null)
        ]);

        if (adminRes?.success && adminRes.data) {
            isAdmin = adminRes.data.isAdmin || adminRes.data.isSkjutledare;
            isSiteAdmin = adminRes.data.isSiteAdmin;
            isSkjutledare = adminRes.data.isSkjutledare || false;
            managedClubIds = adminRes.data.managedClubIds || [];
            skjutledareClubIds = adminRes.data.skjutledareClubIds || [];

            if (isAdmin) {
                document.getElementById('admin-tab-item').style.display = 'block';
                loadAdminPanel();
            }
        }

        if (tgRes?.success && tgRes.data && tgRes.data.length > 0) {
            myTrainingGroups = tgRes.data;
            document.getElementById('mytraininggroup-tab-item').style.display = 'block';

            // If multiple groups, show selector
            if (myTrainingGroups.length > 1) {
                const selector = document.getElementById('trainingGroupSelector');
                const select = document.getElementById('trainingGroupSelect');
                selector.style.display = 'block';
                select.innerHTML = myTrainingGroups.map(g =>
                    `<option value="${g.id}">${g.name}</option>`
                ).join('');
            }

            selectedTrainingGroupId = myTrainingGroups[0].id;

            // Load training group data when tab is activated
            document.getElementById('mytraininggroup-tab').addEventListener('shown.bs.tab', function() {
                loadTrainingGroupProgress();
            });
        }
    } catch (error) {
        console.error('Error checking admin status:', error);
    }
}

/**
 * Check if current user can approve a member based on club membership
 * Site admins can approve anyone
 * Club admins and skjutledare can approve members from their clubs
 */
function canApproveParticipant(participant) {
    // Site admins can approve anyone
    if (isSiteAdmin) return true;

    // Not an admin or skjutledare at all
    if (!isAdmin && !isSkjutledare) return false;
    if (managedClubIds.length === 0 && skjutledareClubIds.length === 0) return false;

    // Check if participant belongs to any managed clubs or skjutledare clubs
    const participantClubIds = [];

    // Add primary club
    if (participant.primaryClubId) {
        participantClubIds.push(participant.primaryClubId);
    }

    // Add additional clubs (parse CSV)
    if (participant.memberClubIds) {
        const additionalIds = participant.memberClubIds
            .split(',')
            .map(id => parseInt(id.trim()))
            .filter(id => !isNaN(id));
        participantClubIds.push(...additionalIds);
    }

    // Check if any participant club matches managed clubs or skjutledare clubs
    return participantClubIds.some(clubId => managedClubIds.includes(clubId) || skjutledareClubIds.includes(clubId));
}

