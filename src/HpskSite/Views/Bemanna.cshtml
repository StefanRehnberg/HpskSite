@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Bemanning";
    var competitionId = ViewData["CompetitionId"];
    var compExists = ViewData["CompetitionExists"] as bool? ?? false;
    var preview = ViewData["Preview"] as bool? ?? false;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<div class="container mt-4 mb-5" style="max-width:760px">
    @if (!compExists)
    {
        <div class="alert alert-warning">Tävlingen hittades inte.</div>
    }
    else
    {
        @if (preview)
        {
            <div class="alert alert-info d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-eye fs-5"></i>
                <div><strong>Förhandsgranskning.</strong> Så här ser anmälningssidan ut för en medlem som ännu inte anmält sig. Inget sparas här.</div>
            </div>
        }

        <h1 class="h3"><i class="bi bi-person-badge me-2"></i>Bemanning</h1>
        <p class="text-muted" id="beHeader">Laddar…</p>

        <div id="beMine"></div>

        <div class="card mt-3">
            <div class="card-header py-2 fw-semibold"><i class="bi bi-hand-thumbs-up me-1"></i>Kan du hjälpa till?</div>
            <div class="card-body py-2">
                <p class="text-muted small mb-2">Bocka för de pass du kan hjälpa till med. Du kan (valfritt) ange vilka tider du kan — flera tider per pass går bra. Skriv gärna en kommentar om vad du kan bidra med, eller vad du inte kan göra.</p>
                <div id="beSlots"><div class="text-muted small">Laddar…</div></div>
                <div class="mb-2 mt-3">
                    <label class="form-label fw-semibold">Kommentar (valfritt)</label>
                    <textarea class="form-control" id="beComment" rows="3" placeholder="t.ex. Jag kan hjälpa i kansliet men inte stå i markeringsgraven. Kan köra material på fredagen."></textarea>
                </div>
                <button type="button" class="btn btn-primary" id="beSaveBtn" onclick="beSave()"><i class="bi bi-check-lg me-1"></i>Spara min anmälan</button>
                <span class="ms-2 small text-success" id="beSaved" style="display:none"><i class="bi bi-check-circle me-1"></i>Sparat</span>
            </div>
        </div>
    }
</div>

<script>
(function () {
    var compId = @(competitionId ?? 0);
    var TOKEN = '@token';
    var PREVIEW = @(preview ? "true" : "false");
    var STATUS_LABEL = { Planned: 'Ej svarat', Invited: 'Inbjuden', Accepted: 'Tackat ja', Declined: 'Tackat nej', Confirmed: 'Bekräftad' };
    var STATUS_CLS = { Planned: 'bg-secondary', Invited: 'bg-info text-dark', Accepted: 'bg-success', Declined: 'bg-danger', Confirmed: 'bg-success' };

    var slots = [];              // help-slots from the organiser
    var checked = {};            // { slotId: [{from,to}, ...] } — the member's current choices

    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function q(id) { return document.getElementById(id); }

    async function load() {
        try {
            var r = await fetch('/mina-uppdrag/for-competition?competitionId=' + compId + (PREVIEW ? '&preview=true' : ''), { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { q('beHeader').textContent = d.message || 'Kunde inte läsa.'; return; }
            q('beHeader').innerHTML = 'Tävling: <strong>' + esc(d.compName) + '</strong>' + (d.compDate ? ' · ' + esc(d.compDate) : '');
            slots = d.slots || [];
            checked = {};
            if (d.mySignup) {
                q('beComment').value = d.mySignup.comment || '';
                (d.mySignup.slots || []).forEach(function (c) { checked[c.slotId] = (c.times || []).map(function (t) { return { from: t.from || '', to: t.to || '' }; }); });
            }
            renderMine(d.assignments || []);
            renderSlots();
            if (PREVIEW) { q('beSaveBtn').disabled = true; q('beSaveBtn').textContent = 'Förhandsgranskning'; }
        } catch (e) { q('beHeader').textContent = 'Kunde inte läsa bemanningen.'; }
    }

    // Directed invitations (accept/decline) — kept, separate from volunteering.
    function renderMine(a) {
        q('beMine').innerHTML = a.length
            ? '<div class="card"><div class="card-header py-2 fw-semibold">Du är tillfrågad</div><div class="card-body py-2">' + a.map(assignmentHtml).join('') + '</div></div>'
            : '';
    }
    function assignmentHtml(a) {
        var star = a.isResponsible ? '<i class="bi bi-star-fill text-warning me-1"></i>' : '';
        var fn = a.functionTitle ? '<span class="text-muted"> · ' + esc(a.functionTitle) + '</span>' : '';
        var scope = a.scopeLabel ? '<span class="badge bg-light text-dark border ms-1"><i class="bi bi-geo-alt me-1"></i>' + esc(a.scopeLabel) + '</span>' : '';
        var st = '<span class="badge ' + (STATUS_CLS[a.status] || 'bg-secondary') + ' ms-1">' + esc(STATUS_LABEL[a.status] || a.status) + '</span>';
        var acc = a.status === 'Accepted', dec = a.status === 'Declined';
        return '<div class="d-flex justify-content-between align-items-start py-2 gap-2 flex-wrap border-bottom">'
            + '<div>' + star + '<span class="fw-semibold">' + esc(a.roleName) + '</span>' + fn + scope + st + '</div>'
            + '<div class="btn-group btn-group-sm">'
            + '<button type="button" class="btn ' + (acc ? 'btn-success' : 'btn-outline-success') + '" onclick="beRespond(' + a.id + ',\'Accepted\')">Tacka ja</button>'
            + '<button type="button" class="btn ' + (dec ? 'btn-danger' : 'btn-outline-danger') + '" onclick="beRespond(' + a.id + ',\'Declined\')">Tacka nej</button>'
            + '</div></div>';
    }

    function renderSlots() {
        var host = q('beSlots');
        if (!slots.length) { host.innerHTML = '<div class="text-muted small fst-italic">Arrangören har inte lagt upp några pass att anmäla sig till ännu.</div>'; return; }
        var html = '', lastDate = null;
        slots.forEach(function (s) {
            if (s.date !== lastDate) { html += '<div class="fw-semibold mt-2 mb-1"><i class="bi bi-calendar-event me-1"></i>' + esc(s.date) + '</div>'; lastDate = s.date; }
            var isOn = Object.prototype.hasOwnProperty.call(checked, s.id);
            var timeRange = (s.startTime || s.endTime) ? ' <span class="text-muted">(' + esc(s.startTime || '') + '–' + esc(s.endTime || '') + ')</span>' : '';
            html += '<div class="border rounded p-2 mb-2">'
                + '<div class="form-check">'
                + '<input class="form-check-input" type="checkbox" id="beSlot' + s.id + '" ' + (isOn ? 'checked' : '') + ' onchange="beToggle(' + s.id + ',this.checked)">'
                + '<label class="form-check-label" for="beSlot' + s.id + '"><strong>' + esc(s.headline) + '</strong>' + timeRange + '</label>'
                + (s.description ? '<div class="text-muted small ms-1">' + esc(s.description) + '</div>' : '')
                + '</div>'
                + (isOn ? timesBlock(s.id) : '')
                + '</div>';
        });
        host.innerHTML = html;
        initTimePickers();
    }

    function timesBlock(slotId) {
        var wins = checked[slotId] || [];
        var rows = wins.map(function (w, i) {
            return '<div class="input-group input-group-sm mb-1" style="max-width:300px">'
                + '<input type="text" class="form-control be-time" data-slot="' + slotId + '" data-idx="' + i + '" data-f="from" placeholder="från" value="' + esc(w.from || '') + '">'
                + '<span class="input-group-text">–</span>'
                + '<input type="text" class="form-control be-time" data-slot="' + slotId + '" data-idx="' + i + '" data-f="to" placeholder="till" value="' + esc(w.to || '') + '">'
                + '<button class="btn btn-outline-danger" type="button" onclick="beRemoveTime(' + slotId + ',' + i + ')"><i class="bi bi-x"></i></button>'
                + '</div>';
        }).join('');
        return '<div class="ms-4 mt-2"><div class="small text-muted mb-1">Jag kan (valfritt — lämna tomt = hela passet):</div>'
            + rows
            + '<button class="btn btn-sm btn-outline-secondary" type="button" onclick="beAddTime(' + slotId + ')"><i class="bi bi-plus-lg me-1"></i>Lägg till tid</button></div>';
    }

    // Read time inputs from the DOM into state before any re-render (preserve typed values).
    function readTimes() {
        document.querySelectorAll('.be-time').forEach(function (inp) {
            var sid = inp.getAttribute('data-slot'), idx = +inp.getAttribute('data-idx'), f = inp.getAttribute('data-f');
            if (!checked[sid]) return;
            if (!checked[sid][idx]) checked[sid][idx] = { from: '', to: '' };
            checked[sid][idx][f] = inp.value.trim();
        });
    }

    window.beToggle = function (slotId, on) {
        readTimes();
        if (on) { if (!checked[slotId]) checked[slotId] = []; }
        else { delete checked[slotId]; }
        renderSlots();
    };
    window.beAddTime = function (slotId) { readTimes(); (checked[slotId] = checked[slotId] || []).push({ from: '', to: '' }); renderSlots(); };
    window.beRemoveTime = function (slotId, idx) { readTimes(); if (checked[slotId]) checked[slotId].splice(idx, 1); renderSlots(); };

    function initTimePickers() {
        if (typeof flatpickr === 'undefined') return;
        flatpickr('.be-time', { locale: 'sv', enableTime: true, noCalendar: true, dateFormat: 'H:i', time_24hr: true });
    }

    async function post(url, payload) {
        try {
            var r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify(payload) });
            return await r.json();
        } catch (e) { return { success: false, message: 'Nätverksfel.' }; }
    }

    window.beRespond = async function (id, status) {
        var d = await post('/mina-uppdrag/respond', { assignmentId: id, status: status });
        if (d.success) await load(); else alert(d.message || 'Kunde inte spara.');
    };

    window.beSave = async function () {
        if (PREVIEW) return;
        readTimes();
        var payloadSlots = Object.keys(checked).map(function (sid) {
            return { slotId: +sid, times: (checked[sid] || []).filter(function (t) { return (t.from && t.from.length) || (t.to && t.to.length); }) };
        });
        var btn = q('beSaveBtn'); btn.disabled = true;
        var d = await post('/mina-uppdrag/help-signup', { competitionId: compId, comment: q('beComment').value.trim(), slots: payloadSlots });
        btn.disabled = false;
        if (d.success) { var s = q('beSaved'); s.style.display = 'inline'; setTimeout(function () { s.style.display = 'none'; }, 2500); }
        else alert(d.message || 'Kunde inte spara.');
    };

    if (compId > 0) load();
})();
</script>
