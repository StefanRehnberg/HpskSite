@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Bemanning";
    var competitionId = ViewData["CompetitionId"];
    var planningId = ViewData["PlanningId"] as int? ?? 0;
    var compExists = ViewData["CompetitionExists"] as bool? ?? false;
    var preview = ViewData["Preview"] as bool? ?? false;
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="container mt-4 mb-5" style="max-width:760px">
    @if (!compExists)
    {
        <div class="alert alert-warning">Tävlingen eller planeringen hittades inte.</div>
    }
    else
    {
        @if (preview)
        {
            <div class="alert alert-info d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-eye fs-5"></i>
                <div><strong>Förhandsgranskning.</strong> Så här ser anmälningssidan ut för en medlem som ännu inte anmält sig. Inget sparas här.</div>
            </div>
        }

        <h1 class="h3"><i class="bi bi-person-badge me-2"></i>Bemanning</h1>
        <p class="text-muted" id="beHeader">Laddar…</p>

        <div id="beMine"></div>

        <div class="card mt-3">
            <div class="card-header py-2 fw-semibold"><i class="bi bi-hand-thumbs-up me-1"></i>Kan du hjälpa till?</div>
            <div class="card-body py-2">
                <p class="text-muted small mb-2" id="beIntro">Kryssa i det du kan hjälpa till med. Du kan (valfritt) ange vilka tider du kan. Skriv gärna en kommentar om vad du kan bidra med, eller vad du inte kan göra. Arrangören fördelar uppdragen och hör av sig.</p>
                <div id="beSlots"><div class="text-muted small">Laddar…</div></div>
                <div id="beShoot" class="mt-3" style="display:none">
                    <div class="fw-semibold"><i class="bi bi-bullseye me-1"></i>Tänker du själv tävla?</div>
                    <p class="text-muted small mb-2">Kryssa i de tävlingar du tänker anmäla dig till, och skriv gärna klassen. Då kan arrangören lägga dina uppdrag så att du hinner skjuta — långt innan anmälan öppnar. Du anmäler dig till tävlingen som vanligt när anmälan öppnar.</p>
                    <div id="beShootList"></div>
                </div>
                <div class="mb-2 mt-3">
                    <label class="form-label fw-semibold">Kommentar (valfritt)</label>
                    <textarea class="form-control" id="beComment" rows="3" placeholder="t.ex. Jag kan hjälpa i kansliet men inte stå i markeringsgraven. Kan köra material på fredagen."></textarea>
                </div>
                <button type="button" class="btn btn-primary" id="beSaveBtn" onclick="beSave()"><i class="bi bi-check-lg me-1"></i>Spara min anmälan</button>
                <span class="ms-2 small text-success" id="beSaved" style="display:none"><i class="bi bi-check-circle me-1"></i>Sparat</span>
            </div>
        </div>
    }
</div>

<script>
(function () {
    var compId = @(competitionId ?? 0);
    var planningId = @planningId;   // P2b: planeringens bemanning, även före kopplingen
    var TOKEN = '@token';
    var PREVIEW = @(preview ? "true" : "false");
    var STATUS_LABEL = { Planned: 'Ej svarat', Invited: 'Inbjuden', Accepted: 'Tackat ja', Declined: 'Tackat nej', Confirmed: 'Bekräftad' };
    var STATUS_CLS = { Planned: 'bg-secondary', Invited: 'bg-info text-dark', Accepted: 'bg-success', Declined: 'bg-danger', Confirmed: 'bg-success' };

    // Det medlemmen kan anmäla sig till (Stefan 2026-10-23): planens dagar med rollerna som behövs
    // (needDays), plus arrangörens egna "något annat"-tillfällen (slots). Ett val har en nyckel:
    // "n:{datum}|{roll}" (tom roll = var det behövs) eller "s:{id}".
    var slots = [], needDays = [], roleChoice = true;
    var shootTargets = null, shootPicked = {};   // omgång 3 steg 9: veckans tävlingar och de funktionären tänker tävla i
    var checked = {};            // { nyckel: [{from,to}, ...] }
    var items = [];              // det som ritades, i ordning — kryssrutorna bär index hit, aldrig text

    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function q(id) { return document.getElementById(id); }
    // Long Swedish date for a yyyy-MM-dd string, e.g. "Fredag 21 Augusti 2026" (raw string if unparseable).
    function longDate(dateStr) {
        try {
            var d = new Date(dateStr + 'T00:00:00');
            if (isNaN(d.getTime())) return dateStr;
            var cap = function (s) { return s.charAt(0).toUpperCase() + s.slice(1); };
            return cap(d.toLocaleDateString('sv-SE', { weekday: 'long' })) + ' ' + d.getDate() + ' '
                + cap(d.toLocaleDateString('sv-SE', { month: 'long' })) + ' ' + d.getFullYear();
        } catch (e) { return dateStr; }
    }

    async function load() {
        try {
            var r = await fetch('/mina-uppdrag/for-competition?competitionId=' + compId + '&planningId=' + planningId + (PREVIEW ? '&preview=true' : ''), { headers: { 'Accept': 'application/json' } });
            var d = await r.json();
            if (!d.success) { q('beHeader').textContent = d.message || 'Kunde inte läsa.'; return; }
            // En planering utan tävling heter planering — en kopplad har tävlingens namn.
            q('beHeader').innerHTML = (planningId > 0 && compId <= 0 ? 'Planering: ' : 'Tävling: ') + '<strong>' + esc(d.compName) + '</strong>' + (d.compDate ? ' · ' + esc(d.compDate) : '');
            slots = d.slots || [];
            needDays = d.needDays || [];
            roleChoice = d.roleChoice !== false;
            checked = {};
            // Ingenting är förkryssat: medlemmen väljer det hen kan (förut var allt förkryssat, och en
            // stressad medlem anmälde sig då till allt).
            if (d.mySignup) {
                q('beComment').value = d.mySignup.comment || '';
                (d.mySignup.slots || []).forEach(function (c) {
                    var key = c.slotId > 0 ? 's:' + c.slotId : 'n:' + (c.date || '') + '|' + (c.roleKey || '');
                    checked[key] = (c.times || []).map(function (t) { return { from: t.from || '', to: t.to || '' }; });
                });
            }
            shootTargets = d.shootTargets || null;
            shootPicked = {};
            (d.myShootIntents || []).forEach(function (i) { shootPicked[i.targetPlanningId] = i.classes || ''; });
            renderMine(d.assignments || []);
            renderSlots();
            renderShoot();
            if (PREVIEW) { q('beSaveBtn').disabled = true; q('beSaveBtn').textContent = 'Förhandsgranskning'; }
        } catch (e) { q('beHeader').textContent = 'Kunde inte läsa bemanningen.'; }
    }

    // Directed invitations (accept/decline) — kept, separate from volunteering.
    function renderMine(a) {
        q('beMine').innerHTML = a.length
            ? '<div class="card"><div class="card-header py-2 fw-semibold">Du är tillfrågad</div><div class="card-body py-2">' + a.map(assignmentHtml).join('') + '</div></div>'
            : '';
    }
    function assignmentHtml(a) {
        var star = a.isResponsible ? '<i class="bi bi-star-fill text-warning me-1"></i>' : '';
        var fn = a.functionTitle ? '<span class="text-muted"> · ' + esc(a.functionTitle) + '</span>' : '';
        var scope = a.scopeLabel ? '<span class="badge bg-light text-dark border ms-1"><i class="bi bi-geo-alt me-1"></i>' + esc(a.scopeLabel) + '</span>' : '';
        var st = '<span class="badge ' + (STATUS_CLS[a.status] || 'bg-secondary') + ' ms-1">' + esc(STATUS_LABEL[a.status] || a.status) + '</span>';
        var acc = a.status === 'Accepted', dec = a.status === 'Declined';
        return '<div class="d-flex justify-content-between align-items-start py-2 gap-2 flex-wrap border-bottom">'
            + '<div>' + star + '<span class="fw-semibold">' + esc(a.roleName) + '</span>' + fn + scope + st + '</div>'
            + '<div class="btn-group btn-group-sm">'
            + '<button type="button" class="btn ' + (acc ? 'btn-success' : 'btn-outline-success') + '" onclick="beRespond(' + a.id + ',\'Accepted\')">Tacka ja</button>'
            + '<button type="button" class="btn ' + (dec ? 'btn-danger' : 'btn-outline-danger') + '" onclick="beRespond(' + a.id + ',\'Declined\')">Tacka nej</button>'
            + '</div></div>';
    }

    function isOn(key) { return Object.prototype.hasOwnProperty.call(checked, key); }

    // Ett val: kryssruta + (när ikryssat) tider. Index in i items — aldrig text i ett attribut.
    function choiceHtml(item, labelHtml, subHtml) {
        var i = items.push(item) - 1, on = isOn(item.key);
        return '<div class="border rounded p-2 mb-2' + (on ? ' border-primary' : '') + '">'
            + '<div class="form-check">'
            + '<input class="form-check-input be-choice" type="checkbox" id="beC' + i + '" data-i="' + i + '" ' + (on ? 'checked' : '') + '>'
            + '<label class="form-check-label" for="beC' + i + '">' + labelHtml + '</label>'
            + (subHtml ? '<div class="text-muted small">' + subHtml + '</div>' : '')
            + '</div>'
            + (on ? timesBlock(i, item.key) : '')
            + '</div>';
    }

    function renderSlots() {
        var host = q('beSlots');
        items = [];
        var byDate = {};
        needDays.forEach(function (d) { (byDate[d.date] = byDate[d.date] || { need: null, slots: [] }).need = d; });
        slots.forEach(function (s) { (byDate[s.date] = byDate[s.date] || { need: null, slots: [] }).slots.push(s); });
        var dates = Object.keys(byDate).sort();
        if (!dates.length) { host.innerHTML = '<div class="text-muted small fst-italic">Arrangören har inte angett vad som behövs ännu. Titta in igen lite senare.</div>'; return; }
        var html = '';
        dates.forEach(function (date) {
            var g = byDate[date], n = g.need;
            html += '<div class="fw-semibold mt-3 mb-1"><i class="bi bi-calendar-event me-1"></i>' + esc(longDate(date))
                + (n && n.kindLabel ? ' <span class="text-muted fw-normal small">· ' + esc(n.kindLabel) + (n.dayLabel ? ' · ' + esc(n.dayLabel) : '') + '</span>' : '')
                + '</div>';
            if (n) {
                if (roleChoice) {
                    n.roles.forEach(function (r) {
                        var sub = r.missing > 0 ? r.missing + ' fattas av ' + r.needed : 'Alla ' + r.needed + ' platser är fyllda, men fler kan behövas';
                        html += choiceHtml({ key: 'n:' + date + '|' + r.roleKey, date: date, roleKey: r.roleKey }, '<strong>' + esc(r.roleName) + '</strong>', esc(sub));
                    });
                    html += choiceHtml({ key: 'n:' + date + '|', date: date, roleKey: '' }, '<strong>Var det behövs</strong>', 'Arrangören väljer en uppgift åt dig');
                } else {
                    var miss = n.roles.reduce(function (a, r) { return a + (r.missing || 0); }, 0);
                    html += choiceHtml({ key: 'n:' + date + '|', date: date, roleKey: '' }, '<strong>Jag kan hjälpa till den här dagen</strong>',
                        (miss > 0 ? miss + (miss === 1 ? ' person fattas. ' : ' personer fattas. ') : '') + 'Arrangören väljer en uppgift åt dig');
                }
            }
            if (g.slots.length) {
                if (n) html += '<div class="small text-muted mt-1 mb-1">Något annat den här dagen:</div>';
                g.slots.forEach(function (s) {
                    var timeRange = (s.startTime || s.endTime) ? ' <span class="text-muted">(' + esc(s.startTime || '') + '–' + esc(s.endTime || '') + ')</span>' : '';
                    html += choiceHtml({ key: 's:' + s.id, slotId: s.id }, '<strong>' + esc(s.headline) + '</strong>' + timeRange, s.description ? esc(s.description) : '');
                });
            }
        });
        host.innerHTML = html;
    }

    // Omgång 3 steg 9: en rad per tävling i veckan — kryssruta och (när ikryssad) klass. Index i data-attributet, aldrig text.
    function renderShoot() {
        var box = q('beShoot');
        if (!shootTargets || !shootTargets.length) { box.style.display = 'none'; return; }
        box.style.display = '';
        q('beShootList').innerHTML = shootTargets.map(function (t, i) {
            var on = Object.prototype.hasOwnProperty.call(shootPicked, t.planningId);
            var when = t.from ? longDate(t.from) + (t.to && t.to !== t.from ? ' – ' + longDate(t.to) : '') : '';
            return '<div class="border rounded p-2 mb-2' + (on ? ' border-primary' : '') + '">'
                + '<div class="form-check"><input class="form-check-input be-shoot" type="checkbox" id="beS' + i + '" data-t="' + i + '"' + (on ? ' checked' : '') + '>'
                + '<label class="form-check-label" for="beS' + i + '"><strong>' + esc(t.name) + '</strong></label>'
                + (when ? '<div class="text-muted small">' + esc(when) + '</div>' : '') + '</div>'
                + (on ? '<div class="ms-4 mt-1" style="max-width:300px"><label class="small text-muted" for="beSC' + i + '">Klass (valfritt)</label>'
                    + '<input type="text" class="form-control form-control-sm be-shoot-class" id="beSC' + i + '" data-t="' + i + '" maxlength="200" placeholder="t.ex. C1, A3" value="' + esc(shootPicked[t.planningId] || '') + '"></div>' : '')
                + '</div>';
        }).join('');
    }
    function readShootClasses() {
        document.querySelectorAll('.be-shoot-class').forEach(function (inp) {
            var t = shootTargets[+inp.getAttribute('data-t')]; if (t && Object.prototype.hasOwnProperty.call(shootPicked, t.planningId)) shootPicked[t.planningId] = inp.value.trim();
        });
    }
    document.addEventListener('change', function (e) {
        var cb = e.target.closest && e.target.closest('.be-shoot'); if (!cb) return;
        var t = shootTargets[+cb.getAttribute('data-t')]; if (!t) return;
        readShootClasses();
        if (cb.checked) shootPicked[t.planningId] = shootPicked[t.planningId] || ''; else delete shootPicked[t.planningId];
        renderShoot();
    });

    function timesBlock(i, key) {
        var wins = checked[key] || [];
        var rows = wins.map(function (w, j) {
            return '<div class="input-group input-group-sm mb-1" style="max-width:300px">'
                + '<input type="text" class="form-control be-time" data-hpsk-time inputmode="decimal" data-i="' + i + '" data-idx="' + j + '" data-f="from" placeholder="från" value="' + esc(w.from || '') + '">'
                + '<span class="input-group-text">–</span>'
                + '<input type="text" class="form-control be-time" data-hpsk-time inputmode="decimal" data-i="' + i + '" data-idx="' + j + '" data-f="to" placeholder="till" value="' + esc(w.to || '') + '">'
                + '<button class="btn btn-outline-danger be-deltime" type="button" data-i="' + i + '" data-idx="' + j + '" aria-label="Ta bort tiden"><i class="bi bi-x"></i></button>'
                + '</div>';
        }).join('');
        return '<div class="ms-4 mt-2">'
            + '<div class="d-flex justify-content-between align-items-center gap-2 mb-1">'
            + '<span class="small text-muted">Jag kan (valfritt — tomt = hela dagen):</span>'
            + '<button class="btn btn-sm btn-outline-secondary flex-shrink-0 be-addtime" type="button" data-i="' + i + '" title="Lägg till tid" aria-label="Lägg till tid"><i class="bi bi-clock"></i><i class="bi bi-plus-lg"></i></button>'
            + '</div>'
            + rows
            + '</div>';
    }

    // Read time inputs from the DOM into state before any re-render (preserve typed values).
    function readTimes() {
        document.querySelectorAll('.be-time').forEach(function (inp) {
            var it = items[+inp.getAttribute('data-i')]; if (!it) return;
            var idx = +inp.getAttribute('data-idx'), f = inp.getAttribute('data-f');
            if (!checked[it.key]) return;
            if (!checked[it.key][idx]) checked[it.key][idx] = { from: '', to: '' };
            checked[it.key][idx][f] = window.hpskNormalizeTime ? (window.hpskNormalizeTime(inp.value) || inp.value.trim()) : inp.value.trim();
        });
    }

    document.addEventListener('change', function (e) {
        var cb = e.target.closest && e.target.closest('.be-choice'); if (!cb) return;
        var it = items[+cb.getAttribute('data-i')]; if (!it) return;
        readTimes();
        if (cb.checked) { if (!checked[it.key]) checked[it.key] = []; } else delete checked[it.key];
        renderSlots();
    });
    document.addEventListener('click', function (e) {
        var add = e.target.closest && e.target.closest('.be-addtime');
        var del = e.target.closest && e.target.closest('.be-deltime');
        var b = add || del; if (!b) return;
        var it = items[+b.getAttribute('data-i')]; if (!it) return;
        readTimes();
        if (add) (checked[it.key] = checked[it.key] || []).push({ from: '', to: '' });
        else if (checked[it.key]) checked[it.key].splice(+b.getAttribute('data-idx'), 1);
        renderSlots();
    });

    async function post(url, payload) {
        try {
            var r = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': TOKEN }, body: JSON.stringify(payload) });
            return await r.json();
        } catch (e) { return { success: false, message: 'Nätverksfel.' }; }
    }

    window.beRespond = async function (id, status) {
        var d = await post('/mina-uppdrag/respond', { assignmentId: id, status: status });
        if (d.success) await load(); else alert(d.message || 'Kunde inte spara.');
    };

    window.beSave = async function () {
        if (PREVIEW) return;
        readTimes();
        var payloadSlots = Object.keys(checked).map(function (key) {
            var times = (checked[key] || []).filter(function (t) { return (t.from && t.from.length) || (t.to && t.to.length); });
            if (key.indexOf('s:') === 0) return { slotId: +key.slice(2), times: times };
            var rest = key.slice(2), bar = rest.indexOf('|');
            return { slotId: 0, date: rest.slice(0, bar), roleKey: rest.slice(bar + 1), times: times };
        });
        var btn = q('beSaveBtn'); btn.disabled = true;
        readShootClasses();
        var shootIntents = shootTargets && shootTargets.length
            ? Object.keys(shootPicked).map(function (k) { return { targetPlanningId: +k, classes: shootPicked[k] || '' }; }) : null;
        var d = await post('/mina-uppdrag/help-signup', { competitionId: compId, planningId: planningId, comment: q('beComment').value.trim(), slots: payloadSlots, shootIntents: shootIntents });
        btn.disabled = false;
        if (d.success) { var s = q('beSaved'); s.style.display = 'inline'; setTimeout(function () { s.style.display = 'none'; }, 2500); }
        else alert(d.message || 'Kunde inte spara.');
    };

    if (compId > 0 || planningId > 0) load();
})();
</script>
