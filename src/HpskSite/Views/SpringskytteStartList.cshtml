@using HpskSite.CompetitionTypes.Springskytte.Models
@model SpringskytteStartListPageModel
@{
    // Standalone Springskytte start-list page (routed /startlista/{compId}[/{slug}]).
    // Chromeless. Replaces the fragile name-derived Umbraco child-node URL that 404'd.
    Layout = null;
    var selected = string.IsNullOrEmpty(Model.SelectedSlug)
        ? null
        : Model.Lists.FirstOrDefault(l => string.Equals(l.Slug, Model.SelectedSlug, StringComparison.OrdinalIgnoreCase));
    var pageTitle = selected != null
        ? $"{selected.ListName} – {Model.CompetitionName}"
        : $"Startlistor – {Model.CompetitionName}";
    var intervalSec = selected != null && !selected.IsStafett ? IntervalSeconds(selected.Config.DefaultInterval) : 60;
    var breakSec = selected != null && !selected.IsStafett ? IntervalSeconds(selected.Config.BreakDuration) : 300;
}
@functions {
    static int ParseTimeToSeconds(string? time)
    {
        if (string.IsNullOrEmpty(time)) return 0;
        var parts = time.Split(':');
        if (parts.Length == 3 && int.TryParse(parts[0], out var h) && int.TryParse(parts[1], out var m) && int.TryParse(parts[2], out var s))
            return h * 3600 + m * 60 + s;
        if (parts.Length == 2 && int.TryParse(parts[0], out var h2) && int.TryParse(parts[1], out var m2))
            return h2 * 3600 + m2 * 60;
        return 0;
    }

    static int IntervalSeconds(string? interval)
    {
        if (string.IsNullOrEmpty(interval)) return 60;
        var parts = interval.Split(':');
        if (parts.Length == 2 && int.TryParse(parts[0], out var m) && int.TryParse(parts[1], out var s))
            return Math.Max(1, m * 60 + s);
        return 60;
    }

    static string FmtSec(int total) => TimeSpan.FromSeconds(Math.Max(0, total)).ToString(@"hh\:mm\:ss");
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background:#f8f9fa; padding:1rem; }
        .sl-wrap { max-width: 1000px; margin: 0 auto; }
        table.start-list-table { width:100%; border-collapse:collapse; background:#fff; }
        table.start-list-table th, table.start-list-table td { border:1px solid #dee2e6; padding:4px 8px; font-size:14px; }
        table.start-list-table th { background:#f1f3f5; text-align:left; }
        .start-list-table td.time { font-family:monospace; font-weight:bold; }
        .start-list-table tr.current-user { background:#d1e7dd; }
        .start-list-table tr.same-club { background:#e7f1ff; }
        .paus-row td { background:#fff3cd; text-align:center; font-weight:bold; font-size:12px; }
        .ledig-row td { background:#fafbfc; color:#8a94a0; font-style:italic; font-size:12px; }
        .ledig-row td.time { color:#8a94a0; font-weight:normal; }
        .list-header { border-left:4px solid #0d6efd; background:#eef2f7; padding:8px 12px; font-weight:600; margin-bottom:0; }
        /* Delays happen, and the new time often can't be typed into /station in the moment — so the
           printed Starttid column is wide enough to pen a new time next to the printed one, with a
           dotted write-in rule that appears on PAPER ONLY (SM rehearsal 2026-08-03). */
        .start-list-table th.col-time { width:150px; }
        .start-list-table td.time { white-space:nowrap; }
        .write-in { display:none; }
        /* Relay: the leg bib is what the runner wears; the name can be penned in afterwards. */
        .leg-row { white-space:nowrap; }
        .leg-bib { display:inline-block; min-width:52px; font-family:monospace; font-weight:bold; }
        .leg-blank { display:inline-block; min-width:120px; border-bottom:1px dotted #adb5bd; }
        @@media print {
            body { background:#fff; padding:0; }
            .no-print { display:none !important; }
            a { text-decoration:none; color:#000; }
            .start-list-table th.col-time { width:42mm; }
            .start-list-table th, .start-list-table td { padding:7px 8px; }
            .write-in { display:inline-block; width:18mm; border-bottom:1px dotted #6c757d; margin-left:7px; }
        }
    </style>
</head>
<body>
<div class="sl-wrap">

    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-list-ol me-2"></i>@(selected != null ? "Startlista" : "Startlistor")</h1>
            <div class="text-muted">@Model.CompetitionName</div>
        </div>
        <div class="no-print d-flex gap-2">
            @if (selected != null)
            {
                <a href="/startlista/@Model.CompetitionId" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i>Alla startlistor
                </a>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Skriv ut
                </button>
            }
        </div>
    </div>

    @if (!Model.Lists.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-hourglass-split me-1"></i>Ingen startlista har skapats för den här tävlingen än.
        </div>
    }
    else if (selected == null)
    {
        <div class="row g-3">
            @foreach (var l in Model.Lists)
            {
                var isStafett = l.IsStafett;
                var first = isStafett
                    ? (l.StafettConfig?.Teams?.FirstOrDefault()?.StartTime ?? l.StafettConfig?.CommonStartTime ?? "")
                    : (l.Config.Starters.FirstOrDefault()?.StartTime ?? "");
                var count = isStafett ? (l.StafettConfig?.Teams?.Count ?? 0) : l.Config.Starters.Count;
                var listDate = isStafett ? (l.StafettConfig?.ListDate ?? "") : l.Config.ListDate;
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="h5 mb-1">
                                    @if (isStafett) { <i class="bi bi-people-fill me-1 text-primary"></i> }
                                    @l.ListName
                                </h2>
                                <div class="text-muted small">
                                    @if (!string.IsNullOrEmpty(listDate)) { <span><i class="bi bi-calendar-event me-1"></i>@listDate · </span> }
                                    @if (isStafett) { <span>@count lag</span> } else { <span>@count starter</span> }
                                    @if (!string.IsNullOrEmpty(first)) { <span>· @(isStafett ? "gemensam start" : "första start") @first</span> }
                                    @if (!l.IsOfficial) { <span class="badge bg-secondary ms-1">Preliminär</span> }
                                </div>
                            </div>
                            <a href="/startlista/@Model.CompetitionId/@l.Slug" class="btn btn-info">
                                <i class="bi bi-list-ol me-1"></i>Visa
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (selected.IsStafett)
    {
        var scfg = selected.StafettConfig!;
        <div class="list-header mb-0">
            <i class="bi bi-people-fill me-1"></i>@selected.ListName@(!string.IsNullOrEmpty(scfg.ListDate) ? $" – {scfg.ListDate}" : "")
            <span class="badge bg-primary ms-2">Gemensam start @scfg.CommonStartTime</span>
        </div>
        <table class="start-list-table mb-3">
            <thead>
                <tr>
                    <th style="width:48px" class="text-center">#</th>
                    <th style="width:150px" class="col-time">Starttid</th>
                    <th>Lag</th>
                    <th>Förening</th>
                    <th style="width:150px">Klass</th>
                    <th>Deltagare <span class="fw-normal">(nr per sträcka)</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var team in scfg.Teams.OrderBy(t => t.StartOrder))
                {
                    var rowClass = !string.IsNullOrEmpty(Model.CurrentMemberClub) && team.Club == Model.CurrentMemberClub ? "same-club" : "";
                    @* Each leg wears "teamNumber-leg" (120-1, 120-2 …). The bib belongs to the LEG, so a
                       reserve stepping in wears the same one, and the NAME may legitimately be empty —
                       a relay roster can be completed after the race, so leave a pen line for it. *@
                    var named = team.Members.Where(m => !m.IsSpare).OrderBy(m => m.LegNumber).ToList();
                    var legCount = Math.Max(named.Count,
                        HpskSite.Models.TeamClassHelper.GetStafettTeamSize(team.StafettClass ?? "")?.coreMembers ?? 0);
                    var spares = team.Members.Where(m => m.IsSpare).Select(m => m.Name).ToList();
                    <tr class="@rowClass">
                        <td class="text-center">@team.StartOrder</td>
                        <td class="time">@team.StartTime<span class="write-in"></span></td>
                        <td><strong>@team.TeamName</strong></td>
                        <td>@HpskSite.Helpers.ClubNameHelper.Shorten(team.Club)</td>
                        <td>@team.StafettClass</td>
                        <td>
                            @for (int leg = 1; leg <= legCount; leg++)
                            {
                                var runner = named.FirstOrDefault(x => x.LegNumber == leg);
                                <div class="leg-row">
                                    <span class="leg-bib">@team.StartOrder-@leg</span>
                                    @if (runner == null || string.IsNullOrWhiteSpace(runner.Name))
                                    {
                                        <span class="leg-blank"></span>
                                    }
                                    else
                                    {
                                        <span>@runner.Name</span>
                                    }
                                </div>
                            }
                            @if (spares.Any()) { <div class="text-muted small">(reserv: @string.Join(", ", spares))</div> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="list-header mb-0">@selected.ListName@(!string.IsNullOrEmpty(selected.Config.ListDate) ? $" – {selected.Config.ListDate}" : "")</div>
        <table class="start-list-table mb-3">
            <thead>
                <tr>
                    <th style="width:48px" class="text-center">#</th>
                    <th style="width:150px" class="col-time">Starttid</th>
                    <th>Namn</th>
                    <th>Förening</th>
                    <th style="width:70px" class="text-center">Vapen</th>
                    <th style="width:90px">Klass</th>
                </tr>
            </thead>
            <tbody>
                @{ string? prevTime = null; }
                @foreach (var s in selected.Config.Starters)
                {
                    if (prevTime != null && !string.IsNullOrEmpty(s.StartTime))
                    {
                        var pSec = ParseTimeToSeconds(prevTime);
                        var cSec = ParseTimeToSeconds(s.StartTime);
                        var gap = cSec - pSec;
                        if (gap > intervalSec + intervalSec / 2)   // there is a break in the sequence
                        {
                            // A configured pause (≈ break duration) vs an open slot (a missing interval,
                            // e.g. a shooter moved away) get different styling — a pause is a 3-5 min break,
                            // an open slot is just a free start time.
                            bool isPause = breakSec > 0 ? (gap - intervalSec) >= breakSec * 0.75 : gap >= intervalSec * 4;
                            if (isPause)
                            {
                                <tr class="paus-row"><td colspan="6">Paus</td></tr>
                            }
                            else
                            {
                                var steps = (int)Math.Round((double)gap / intervalSec) - 1;
                                for (int k = 1; k <= steps; k++)
                                {
                                    <tr class="ledig-row">
                                        <td></td>
                                        <td class="time">@FmtSec(pSec + k * intervalSec)<span class="write-in"></span></td>
                                        <td colspan="4"><i class="bi bi-dash-circle me-1"></i>Ledig tid</td>
                                    </tr>
                                }
                            }
                        }
                    }
                    var rowClass = "";
                    if (!string.IsNullOrEmpty(Model.CurrentMemberName) && s.Name == Model.CurrentMemberName)
                        rowClass = "current-user";
                    else if (!string.IsNullOrEmpty(Model.CurrentMemberClub) && s.Club == Model.CurrentMemberClub)
                        rowClass = "same-club";
                    <tr class="@rowClass">
                        <td class="text-center">@s.StartOrder</td>
                        <td class="time">@s.StartTime<span class="write-in"></span></td>
                        <td>@s.Name</td>
                        <td>@HpskSite.Helpers.ClubNameHelper.Shorten(s.Club)</td>
                        <td class="text-center">@s.WeaponClass</td>
                        <td>@s.AgeGenderClass</td>
                    </tr>
                    prevTime = s.StartTime;
                }
            </tbody>
        </table>
    }

    @if (selected != null && !selected.IsOfficial)
    {
        <div class="text-muted small mt-4 no-print">
            <i class="bi bi-info-circle me-1"></i>Preliminär startlista – kan komma att ändras.
        </div>
    }
</div>
</body>
</html>
