@using HpskSite.CompetitionTypes.Faltskytte.Models
@using System.Globalization
@model FaltskyttePatrolListModel
@functions {
    static string Hm(DateTime? t) => t.HasValue ? t.Value.ToString("HH:mm", CultureInfo.GetCultureInfo("sv-SE")) : "";
}
@{
    // Standalone public patrol-list page (/patrullista/{id}) — built for a clubhouse
    // screen, so it's large/readable and reloads every 60 s to stay current. The start
    // time is the headline info ("when does my patrol leave?").
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>Patrullista@(string.IsNullOrEmpty(Model.CompetitionName) ? "" : " — " + Model.CompetitionName)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #f5f6f8; }
        .pl-time { font-variant-numeric: tabular-nums; }
        .pl-patrol-no { font-size: 1.15rem; }
        .pl-member { font-size: .9rem; }
    </style>
</head>
<body>
    <div class="container-fluid py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 border-bottom pb-2">
            <h2 class="mb-0"><i class="bi bi-people-fill me-2"></i>Patrullista</h2>
            <div class="text-end">
                <div class="fw-bold">@Model.CompetitionName</div>
                <div class="text-muted small">Uppdaterad <span id="plUpdated"></span></div>
            </div>
        </div>

        @if (!Model.Published)
        {
            <div class="alert alert-info"><i class="bi bi-hourglass-split me-2"></i>Patrullistan har inte publicerats än.</div>
        }
        else if (!Model.Patrols.Any())
        {
            <div class="alert alert-warning">Inga patruller.</div>
        }
        else
        {
            <div class="row g-2">
                @foreach (var p in Model.Patrols)
                {
                    <div class="col-12 col-sm-6 col-lg-4 col-xxl-3">
                        <div class="card h-100">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <span class="fw-bold pl-patrol-no">Patrull @p.PatrolNumber, Vapengrupp @p.WeaponGroup@(string.IsNullOrEmpty(p.Label) ? "" : " — " + p.Label)</span>
                                @if (p.StartTime.HasValue)
                                {
                                    <span class="badge bg-primary pl-time fs-6"><i class="bi bi-clock me-1"></i>@Hm(p.StartTime)</span>
                                }
                            </div>
                            <ul class="list-group list-group-flush">
                                @foreach (var m in p.Members)
                                {
                                    <li class="list-group-item py-1 pl-member d-flex justify-content-between">
                                        <span>@m.Name <span class="text-muted">(@m.Club)</span></span>
                                        <span class="badge bg-body-secondary text-body">@m.ShootingClass</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    <script>
        document.getElementById('plUpdated').textContent = new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' });
        // Clubhouse screen: keep it current without anyone touching it.
        setTimeout(function () { location.reload(); }, 60000);
    </script>
</body>
</html>
