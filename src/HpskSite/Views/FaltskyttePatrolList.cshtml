@using HpskSite.CompetitionTypes.Faltskytte.Models
@model FaltskyttePatrolListModel
@{
    // Patrullista — PUBLIC READ-ONLY WALL screen (/patrullista/{id}). Big-screen/clubhouse display:
    // patrol list, "NÄST PÅ TUR", and status (Utgått / Väntar). No controls — the starter's
    // operator screen (send-off / hold / DNS) is the separate staff-only /startledare/{id} page.
    // Polls GetPatrolListState every 10 s so the wall mirrors what the starter does.
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv" data-bs-theme="dark">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>Patrullista@(string.IsNullOrEmpty(Model.CompetitionName) ? "" : " — " + Model.CompetitionName)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css">
    <style>
        /* Big-screen dark theme — matches the live results board (/live). Bootstrap dark mode
           handles cards/alerts/badges; we only recolour the surfaces to the board's navy palette. */
        body {
            background: #1a1a2e;
            color: #e0e0e0;
            --bs-body-bg: #1a1a2e;
            --bs-body-color: #e0e0e0;
            --bs-emphasis-color: #ffffff;
            --bs-border-color: #0f3460;
            --bs-card-bg: #16213e;
            --bs-card-border-color: #0f3460;
            --bs-card-cap-bg: #0f3460;
            --bs-list-group-bg: #16213e;
            --bs-list-group-border-color: rgba(255,255,255,.06);
        }
        h2 i { color: #4ecca3; }               /* teal accent, same as the results board */
        .pl-time { font-variant-numeric: tabular-nums; }
        .pl-departed { opacity: .55; }
        .pl-next { box-shadow: 0 0 0 .25rem rgba(78,204,163,.45); }
        .pl-held { opacity: .75; border: 2px solid var(--bs-warning, #ffc107); }
        .pl-member { font-size: .9rem; }
    </style>
</head>
<body>
    <div class="container-fluid py-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2 border-bottom pb-2">
            <h2 class="mb-0"><i class="bi bi-people-fill me-2"></i>Patrullista</h2>
            <div class="d-flex align-items-center gap-3">
                @* This page is meant to be left up on a monitor by the start area, so the screen
                   going black is the normal failure mode rather than an edge case. Opt-in, because
                   the same URL is also opened on a phone. *@
                <div class="d-print-none">
                    @await Html.PartialAsync("_ScreenWakeButton")
                </div>
                <div class="text-end">
                    <div class="fw-bold">@Model.CompetitionName</div>
                    <div class="text-muted small">Uppdaterad <span id="plUpdated"></span></div>
                </div>
            </div>
        </div>

        <div id="plBanner"></div>
        <div class="row g-2" id="plCards">
            <div class="col-12 text-center text-muted py-4"><div class="spinner-border spinner-border-sm" role="status"></div> Laddar…</div>
        </div>
    </div>

    <script>
        var compId = @Model.CompetitionId;
        var REFRESH = 10000;
        var lastNextId = null;

        function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
        function fmt(d) { try { return d.toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' }); } catch (e) { return ''; } }

        async function refresh() {
            try {
                var r = await fetch('/umbraco/surface/Faltskytte/GetPatrolListState?competitionId=' + compId);
                var d = await r.json();
                render(d);
                document.getElementById('plUpdated').textContent = new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            } catch (e) { console.error(e); }
        }

        function render(d) {
            var banner = document.getElementById('plBanner');
            var host = document.getElementById('plCards');
            if (!d || !d.success) return;
            if (!d.published) {
                banner.innerHTML = '';
                host.innerHTML = '<div class="col-12"><div class="alert alert-info"><i class="bi bi-hourglass-split me-2"></i>Patrullistan har inte publicerats än.</div></div>';
                return;
            }
            var patrols = d.patrols || [];
            if (!patrols.length) {
                banner.innerHTML = '';
                host.innerHTML = '<div class="col-12"><div class="alert alert-warning">Inga patruller.</div></div>';
                return;
            }

            // Next up = lowest-numbered patrol that's neither departed NOR held (parked).
            var next = patrols.find(function (p) { return !p.departedAt && !p.held; });
            var deps = patrols.filter(function (p) { return p.departedAt; }).map(function (p) { return new Date(p.departedAt).getTime(); });
            var lastDep = deps.length ? new Date(Math.max.apply(null, deps)) : null;

            // ── Banner: next up + rhythm (display only) ──────────────
            var b = '';
            if (next) {
                b += '<div class="alert alert-success d-flex align-items-center flex-wrap gap-2 py-3 mb-2">'
                    + '<span class="badge bg-success me-2">NÄST PÅ TUR</span>'
                    + '<span class="fs-2 fw-bold">Patrull ' + next.patrolNumber + '</span>'
                    + '<span class="fs-5 ms-2 text-muted">Vapengrupp ' + esc(next.weaponGroup) + (next.label ? ' — ' + esc(next.label) : '') + '</span></div>';
            } else {
                var anyHeld = patrols.some(function (p) { return !p.departedAt && p.held; });
                b += '<div class="alert alert-secondary fs-4 py-3 mb-2"><i class="bi bi-check2-all me-2"></i>'
                    + (anyHeld ? 'Inga fler att skicka just nu — parkerade patruller väntar.' : 'Alla patruller har gått ut.') + '</div>';
            }
            if (lastDep) {
                var mins = Math.max(0, Math.floor((Date.now() - lastDep.getTime()) / 60000));
                b += '<div class="text-muted mb-2"><i class="bi bi-stopwatch me-1"></i>Senaste utgång: <strong>' + fmt(lastDep) + '</strong> · ' + mins + ' min sedan</div>';
            }
            banner.innerHTML = b;

            // ── Cards (display only) ─────────────────────────────────
            host.innerHTML = patrols.map(function (p) {
                var dep = p.departedAt ? new Date(p.departedAt) : null;
                var isNext = next && p.patrolId === next.patrolId;
                var cardCls = 'card h-100' + (dep ? ' pl-departed' : (p.held ? ' pl-held' : (isNext ? ' border-success border-3 pl-next' : '')));
                var startBadge = p.startTime ? '<span class="badge bg-dark-subtle text-body pl-time"><i class="bi bi-clock me-1"></i>' + fmt(new Date(p.startTime)) + '</span>' : '';
                var status = dep
                    ? '<span class="badge bg-success"><i class="bi bi-check-lg me-1"></i>Utgått ' + fmt(dep) + '</span>'
                    : (p.held ? '<span class="badge bg-warning text-dark"><i class="bi bi-pause-fill me-1"></i>Väntar</span>'
                              : (isNext ? '<span class="badge bg-success">NÄST PÅ TUR</span>' : ''));
                var members = (p.members || []).map(function (m) {
                    var isDns = m.status === 'DNS';
                    return '<li class="list-group-item py-1 pl-member d-flex justify-content-between' + (isDns ? ' opacity-50' : '') + '"><span>' + esc(m.name) + ' <span class="text-muted">(' + esc(m.club) + ')</span>' + (isDns ? ' <span class="badge bg-secondary">DNS</span>' : '') + '</span><span class="badge bg-body-secondary text-body">' + esc(m.shootingClass) + '</span></li>';
                }).join('');
                return '<div class="col-12 col-sm-6 col-lg-4 col-xxl-3" data-patrol="' + p.patrolId + '">'
                    + '<div class="' + cardCls + '">'
                    + '<div class="card-header d-flex justify-content-between align-items-center py-2">'
                    + '<span class="fw-bold">Patrull ' + p.patrolNumber + ', Vapengrupp ' + esc(p.weaponGroup) + (p.label ? ' — ' + esc(p.label) : '') + '</span>'
                    + startBadge
                    + '</div>'
                    + (status ? '<div class="card-body py-2">' + status + '</div>' : '')
                    + '<ul class="list-group list-group-flush">' + members + '</ul>'
                    + '</div></div>';
            }).join('');

            // Auto-scroll the next patrol into view when it changes (handy on a long wall list).
            var nextId = next ? next.patrolId : null;
            if (nextId && nextId !== lastNextId) {
                var el = host.querySelector('[data-patrol="' + nextId + '"]');
                if (el) el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
            lastNextId = nextId;
        }

        refresh();
        var timer = setInterval(refresh, REFRESH);
        document.addEventListener('visibilitychange', function () {
            if (document.hidden) { if (timer) { clearInterval(timer); timer = null; } }
            else { refresh(); timer = setInterval(refresh, REFRESH); }
        });
    </script>
</body>
</html>
