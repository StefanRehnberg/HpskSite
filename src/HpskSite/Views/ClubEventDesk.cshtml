@model HpskSite.Controllers.EventDeskPageModel
@{
    Layout = null;
    var title = string.IsNullOrEmpty(Model.EventName) ? "Deltagare" : $"Deltagare — {Model.EventName}";
}
@*
    /evenemang/deltagare — arrangörens yta för ett klubb- eller kretsevenemang.

    ⚠️ TVÅ HÅLLNINGAR, EN SIDA. Före: laptop, läsa noteringar, bocka av Swish mot bankappen.
    Under: telefon i handen, pricka närvaro, ta en sen anmälan. Se controllerns huvud.

    ⚠️ SAMMA FORMSPRÅK SOM TÄVLINGENS ANMÄLNINGAR. Summeringskort på en rad, en tabell med
    form-switch för närvaron, och en Åtgärder-meny per rad. Det är MÖNSTREN som återanvänds,
    inte koden: den ytan är 6817 rader och vilar på competitionRegistration-noder, fakturor och
    lag, medan en händelses deltagare är en helt annan modell. En abstraktion över de två hade
    gett en sämre version av båda — samma sak som gjorde att tävlingslistan en gång fanns i tre
    glidande kopior.

    ⚠️⚠️ NÄRVARON HAR FYRA LÄGEN, INTE TVÅ, och switchen kan bara uttrycka två. "Ej avprickad"
    är ett EGET tillstånd: ett obligatoriskt evenemang där uppropet aldrig togs får ALDRIG läsas
    som att alla uteblev — siffran är på väg att bli underlag för ett föreningsintyg. Därför är
    en oberörd switch INTE "frånvarande": etiketten säger "—" tills någon rört den, och
    "Giltig frånvaro" nås ur radens meny. En avslagen switch som betydde frånvaro hade varit ett
    påstående systemet hittat på.

    ⚠️ SKULDEN ÄR PER SÄLLSKAP. Hugo swishar en gång för sig, frun och sonen. Gästraderna visar
    därför "ingår i NN:s betalning" och aldrig ett eget belopp — annars summerar skärmen
    450 + 180 + 90 för ett sällskap som är skyldigt 450.
*@
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>@title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body { padding-bottom: 3rem; }
        /* Sticky rubrikrad: under eventet scrollar man i listan med tummen och ska ändå se
           vilket evenemang och hur många som är kvar. */
        .desk-head { position: sticky; top: 0; z-index: 10; background: var(--bs-body-bg);
                     border-bottom: 1px solid var(--bs-border-color); }
        /* ⚠️ Träffytan är byggd för en tumme på en telefon under kvällen, inte för en mus. */
        @@media (max-width: 767.98px) {
            .form-switch .form-check-input { width: 3rem; height: 1.5rem; }
            .desk-row td { padding-top: .75rem; padding-bottom: .75rem; }
        }
        .desk-note { white-space: pre-wrap; }
        tr.desk-cancelled { opacity: .55; }
    </style>
</head>
<body class="bg-body-tertiary">

@if (Model.RequiresLogin)
{
    <div class="container py-5 text-center">
        <h1 class="h4 mb-3">Deltagarlistan</h1>
        <p class="text-muted">Du behöver vara inloggad för att se deltagarna.</p>
        <a class="btn btn-primary" href="@Model.LoginUrl">Logga in</a>
    </div>
}
else if (!Model.CanManage)
{
    <div class="container py-5">
        <div class="alert alert-warning mb-0">
            <i class="bi bi-exclamation-triangle me-2"></i>@(Model.Error ?? "Deltagarlistan kunde inte visas.")
        </div>
    </div>
}
else
{
    <div class="desk-head px-3 py-2">
        <div class="container-fluid px-0 d-flex align-items-center gap-3 flex-wrap">
            <div class="me-auto">
                <div class="h5 mb-0">@Model.EventName</div>
                <div class="small text-muted">
                    @if (Model.EventDate.HasValue)
                    {
                        @Model.EventDate.Value.ToString("dddd d MMMM yyyy HH:mm",
                            new System.Globalization.CultureInfo("sv-SE"))<text> · </text>
                    }
                    @Model.OwnerName
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="deskLoad()">
                <i class="bi bi-arrow-clockwise me-1"></i>Uppdatera
            </button>
        </div>
    </div>

    @* ⚠️ Sidan är chromeless och har inget Umbraco-formulär, alltså ingen antiforgery-token
       i DOM:en — och skriv-endpointsen är [ValidateAntiForgeryToken]. Utan den här raden blir
       varje avprickning ett TYST 400. Samma fälla som event-copy-svitens städning gick i, där
       POST:en gjordes från en sida som saknade token. *@
    @Html.AntiForgeryToken()

    <div class="container-fluid py-3" id="deskApp" data-event-id="@Model.EventId">

        @* Summeringskorten — samma form som Anmälningars, i en rad som bryter rent. *@
        <div class="row g-2 mb-3" id="deskCards">
            <div class="col-6 col-lg">
                <div class="card h-100"><div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Anmälda</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="cSignedUp">–</h4>
                        <small class="text-muted"><span id="cReserves">0</span> reserver</small>
                    </div>
                </div></div>
            </div>
            <div class="col-6 col-lg">
                <div class="card h-100"><div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Platser kvar</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="cSeatsLeft">–</h4>
                        <small class="text-muted" id="cSeatsHint"></small>
                    </div>
                </div></div>
            </div>
            <div class="col-6 col-lg">
                <div class="card h-100"><div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Närvaro</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="cPresent">–</h4>
                        @* ⚠️ "ej avprickade" står UTSKRIVET, inte underförstått. Skillnaden mot
                           frånvarande är hela poängen med det tredje tillståndet. *@
                        <small class="text-muted"><span id="cNotRecorded">0</span> ej avprickade</small>
                    </div>
                    <div class="progress mt-1" style="height:4px;">
                        <div class="progress-bar bg-success" id="cPresentBar" style="width:0%"></div>
                    </div>
                </div></div>
            </div>
            <div class="col-6 col-lg">
                <div class="card h-100"><div class="card-body py-2">
                    <h6 class="card-subtitle mb-1 text-muted small">Mottaget</h6>
                    <div class="d-flex justify-content-between align-items-baseline">
                        <h4 class="card-title mb-0" id="cSettled">–</h4>
                        <small class="text-muted">av <span id="cExpected">0</span> kr</small>
                    </div>
                    <div class="progress mt-1" style="height:4px;">
                        <div class="progress-bar bg-primary" id="cPaidBar" style="width:0%"></div>
                    </div>
                </div></div>
            </div>
        </div>

        <div id="deskWarnings"></div>

        @* Filtret är medvetet litet. Största händelsen i dev har 14 deltagare — filter,
           sortering och paginering är maskineri för en lista på fjorton. *@
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <div class="input-group input-group-sm" style="max-width:260px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" id="deskSearch" placeholder="Sök namn"
                       oninput="deskRender()">
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="Filter">
                <input type="radio" class="btn-check" name="deskFilter" id="fAll" value="all" checked onchange="deskRender()">
                <label class="btn btn-outline-secondary" for="fAll">Alla</label>
                <input type="radio" class="btn-check" name="deskFilter" id="fUnpaid" value="unpaid" onchange="deskRender()">
                <label class="btn btn-outline-secondary" for="fUnpaid">Obetalda</label>
                <input type="radio" class="btn-check" name="deskFilter" id="fNotRec" value="notrec" onchange="deskRender()">
                <label class="btn btn-outline-secondary" for="fNotRec">Ej avprickade</label>
            </div>
            <span class="text-muted small ms-auto" id="deskShowing"></span>
            <button type="button" class="btn btn-sm btn-primary" onclick="deskAddOpen()">
                <i class="bi bi-person-plus me-1"></i>Lägg till deltagare
            </button>
        </div>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0" id="deskTable">
                    <thead>
                        <tr>
                            <th>Namn</th>
                            <th>Anmäld</th>
                            <th>Betalning</th>
                            <th style="min-width:150px;">Närvaro</th>
                            <th>Notering</th>
                            <th class="text-end">Åtgärder</th>
                        </tr>
                    </thead>
                    <tbody id="deskBody">
                        <tr><td colspan="6" class="text-center text-muted py-4">Hämtar deltagare…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="small text-muted mt-2" id="deskFoot"></div>
    </div>

    @* Lägg till deltagare — medlem eller gäst utan konto. *@
    <div class="modal fade" id="deskAddModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Lägg till deltagare</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-pills mb-3" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill"
                            data-bs-target="#deskAddMember" type="button">Medlem</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill"
                            data-bs-target="#deskAddGuest" type="button">Gäst utan konto</button></li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="deskAddMember">
                            <label class="form-label">Sök medlem</label>
                            <input type="search" class="form-control" id="deskMemberQ"
                                   placeholder="Namn" oninput="deskSearchMembers()">
                            <div id="deskMemberHits" class="list-group mt-2"></div>
                        </div>
                        <div class="tab-pane fade" id="deskAddGuest">
                            @* ⚠️ En gäst hänger på en ANMÄLD medlem, som ansvarar och betalar.
                               Väljaren listar bara anmälda: AddGuestAsync vägrar annars, och en
                               väljare som erbjuder någon utanför listan ger ett avslag i stället
                               för ett besked. *@
                            <label class="form-label">Gästens namn</label>
                            <input type="text" class="form-control" id="deskGuestName" placeholder="För- och efternamn">
                            <label class="form-label mt-2">Kommer tillsammans med</label>
                            <select class="form-select" id="deskGuestHost"></select>
                            <div class="form-text">Den medlemmen ansvarar för platsen och avgiften.</div>
                            <div class="mt-2" id="deskGuestPriceWrap" style="display:none">
                                <label class="form-label">Pris</label>
                                <select class="form-select" id="deskGuestPrice"></select>
                            </div>
                            <button type="button" class="btn btn-primary mt-3" onclick="deskAddGuest()">
                                <i class="bi bi-person-plus me-1"></i>Lägg till gäst
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    if (!document.getElementById('deskApp')) return;

    const EVENT_ID = +document.getElementById('deskApp').dataset.eventId;
    let state = null;

    const esc = s => String(s ?? '').replace(/[&<>"']/g,
        c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]));
    const kr = n => (n === null || n === undefined) ? '' : Number(n).toLocaleString('sv-SE') + ' kr';

    function token() {
        const el = document.querySelector('input[name="__RequestVerificationToken"]');
        return el ? el.value : '';
    }

    async function post(url, body) {
        const r = await fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body || {}),
        });
        const t = await r.text();
        try { return JSON.parse(t); }
        catch { return { success: false, message: `Oväntat svar (${r.status}).` }; }
    }

    // ── Läsning ─────────────────────────────────────────────────────────────────────────
    window.deskLoad = async function () {
        const r = await fetch(`/umbraco/surface/ClubEvent/GetRoster?eventId=${EVENT_ID}`,
                              { credentials: 'same-origin' });
        const d = await r.json().catch(() => null);
        if (!d || !d.success) {
            document.getElementById('deskBody').innerHTML =
                `<tr><td colspan="6" class="text-danger py-4">${esc((d && d.message) || 'Listan kunde inte hämtas.')}</td></tr>`;
            return;
        }
        state = d;
        deskCards();
        deskRender();
    };

    function deskCards() {
        const c = state.counts, p = state.payments || {};
        document.getElementById('cSignedUp').textContent = c.signedUp;
        document.getElementById('cReserves').textContent = c.reserves;
        document.getElementById('cSeatsLeft').textContent =
            (state.event.maxParticipants > 0) ? c.seatsLeft : '∞';
        document.getElementById('cSeatsHint').textContent =
            (state.event.maxParticipants > 0) ? `av ${state.event.maxParticipants}` : 'ingen gräns';
        document.getElementById('cPresent').textContent = c.present;
        document.getElementById('cNotRecorded').textContent = c.notRecorded;
        const total = Math.max(1, c.seated);
        document.getElementById('cPresentBar').style.width = Math.round(100 * c.present / total) + '%';

        // ⚠️ BELOPP, inte antal betalningsrader. Se GetRoster.
        document.getElementById('cSettled').textContent = kr(p.paidAmount || 0);
        document.getElementById('cExpected').textContent = Number(p.expectedAmount || 0).toLocaleString('sv-SE');
        const exp = Number(p.expectedAmount || 0);
        document.getElementById('cPaidBar').style.width =
            exp > 0 ? Math.round(100 * Number(p.paidAmount || 0) / exp) + '%' : '0%';

        // ⚠️ Kan liggaren inte läsas SÄGS det. En nolla i betalningskortet är annars
        // oskiljbar från "ingen har betalat", och det är ett helt annat påstående.
        document.getElementById('deskWarnings').innerHTML = (p.readable === false)
            ? '<div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-2"></i>'
              + 'Betalningarna kunde inte läsas just nu. Närvaron går att pricka av ändå.</div>'
            : '';
    }

    // Betalningscellen. ⚠️ "Säger sig ha betalat" och "Mottaget" hålls isär — vi har ingen
    // Swish-API, så det första är ett PÅSTÅENDE och aldrig pengar.
    function payCell(r) {
        if (r.cancelled) return '<span class="text-muted">–</span>';
        if (r.isGuest) {
            const host = (state.rows.find(x => x.memberId === r.guestOfMemberId && !x.isGuest) || {}).name;
            return `<span class="text-muted small">Ingår i ${esc(host || 'värdens')} betalning</span>`;
        }
        switch (r.paymentState) {
            case 'free':
                return '<span class="badge bg-secondary-subtle text-secondary-emphasis">Ingen avgift</span>';
            case 'paid':
                return `<span class="badge bg-success-subtle text-success-emphasis">Mottaget ${kr(r.partyPaid)}</span>`;
            case 'claimed':
                return `<span class="badge bg-warning-subtle text-warning-emphasis" title="Medlemmen säger sig ha betalat. Stäm av mot bankappen.">`
                     + `Säger sig ha betalat ${kr(r.partyClaimed)}</span>`;
            case 'partial':
                return `<span class="badge bg-info-subtle text-info-emphasis">Delbetalt ${kr(r.partyPaid)} av ${kr(r.partyTotal)}</span>`;
            default:
                return `<span class="badge bg-danger-subtle text-danger-emphasis">Obetalt ${kr(r.partyTotal)}</span>`;
        }
    }

    // ⚠️⚠️ SWITCHEN ÄR BINÄR, NÄRVARON ÄR DET INTE. Oberörd = "ej avprickad", INTE frånvarande.
    function attCell(r) {
        const on = r.attendanceStatus === 'Present';
        const label = r.attendanceStatus === 'Present' ? 'Här'
                    : r.attendanceStatus === 'Absent' ? 'Ej här'
                    : r.attendanceStatus === 'Excused' ? 'Giltig frånvaro'
                    : '—';
        const cls = r.attendanceStatus ? 'text-body' : 'text-muted';
        return `<div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="att_${r.id}"
                   ${on ? 'checked' : ''} ${r.cancelled ? 'disabled' : ''}
                   onchange="deskSetAttendance(${r.id}, this.checked)"
                   title="Pricka av som närvarande">
            <label class="form-check-label small ${cls}" for="att_${r.id}">${esc(label)}</label>
        </div>`;
    }

    window.deskRender = function () {
        if (!state) return;
        const q = (document.getElementById('deskSearch').value || '').toLowerCase().trim();
        const filter = (document.querySelector('input[name="deskFilter"]:checked') || {}).value || 'all';

        const rows = state.rows.filter(r => {
            if (q && !String(r.name || '').toLowerCase().includes(q)) return false;
            if (filter === 'unpaid') return !r.cancelled && !r.isGuest
                && ['unpaid', 'claimed', 'partial'].includes(r.paymentState);
            if (filter === 'notrec') return !r.cancelled && !r.attendanceStatus;
            return true;
        });

        document.getElementById('deskShowing').textContent =
            `Visar ${rows.length} av ${state.rows.length}`;

        document.getElementById('deskBody').innerHTML = rows.length ? rows.map(r => `
            <tr class="desk-row ${r.cancelled ? 'desk-cancelled' : ''}">
                <td>
                    <strong>${esc(r.name)}</strong>
                    ${r.isGuest ? '<span class="badge bg-secondary ms-1">gäst</span>' : ''}
                    ${r.isReserve ? '<span class="badge bg-warning text-dark ms-1">reserv</span>' : ''}
                    ${r.isWalkIn ? '<span class="badge bg-info text-dark ms-1">på plats</span>' : ''}
                    ${r.cancelled ? '<span class="badge bg-secondary ms-1">avbokad</span>' : ''}
                    ${r.selfRegistered ? '<span class="badge bg-light text-dark border ms-1" title="Skannade QR-koden själv">självreg.</span>' : ''}
                </td>
                <td class="small text-muted">${esc(r.signedUpAt || '–')}</td>
                <td>${payCell(r)}</td>
                <td>${attCell(r)}</td>
                <td class="small desk-note">${esc(r.note || r.attendanceNote || '')}</td>
                <td class="text-end">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}'
                                aria-expanded="false">
                            <i class="bi bi-sliders me-1"></i>Åtgärder
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            ${(!r.isGuest && r.openPaymentId) ? `
                            <li><button class="dropdown-item" type="button" onclick="deskConfirmPay(${r.openPaymentId}, ${r.id})">
                                <i class="bi bi-cash-coin me-2 text-success"></i>Ta emot betalning</button></li>` : ''}
                            <li><button class="dropdown-item" type="button" onclick="deskSetStatus(${r.id}, 'Present')">
                                <i class="bi bi-check2 me-2 text-success"></i>Närvarande</button></li>
                            <li><button class="dropdown-item" type="button" onclick="deskSetStatus(${r.id}, 'Absent')">
                                <i class="bi bi-x me-2 text-danger"></i>Frånvarande</button></li>
                            <li><button class="dropdown-item" type="button" onclick="deskSetStatus(${r.id}, 'Excused')">
                                <i class="bi bi-shield-check me-2 text-secondary"></i>Giltig frånvaro…</button></li>
                            <li><button class="dropdown-item" type="button" onclick="deskSetStatus(${r.id}, null)">
                                <i class="bi bi-arrow-counterclockwise me-2"></i>Ångra avprickning</button></li>
                        </ul>
                    </div>
                </td>
            </tr>`).join('')
            : '<tr><td colspan="6" class="text-center text-muted py-4">Ingen deltagare matchar filtret.</td></tr>';

        document.getElementById('deskFoot').textContent = state.event.isMandatory
            ? 'Obligatoriskt deltagande — närvaron blir underlag för klubbens beslut om föreningsintyg.'
            : '';
    };

    // ── Skrivning ───────────────────────────────────────────────────────────────────────
    window.deskSetAttendance = async function (rowId, on) {
        // Switchen sätter bara de två vanliga lägena. Giltig frånvaro nås ur menyn.
        await deskSetStatus(rowId, on ? 'Present' : 'Absent');
    };

    window.deskSetStatus = async function (rowId, status) {
        let note = null;
        if (status === 'Excused') {
            note = prompt('Skäl för giltig frånvaro (syns i uppropet):', '');
            if (note === null) { deskRender(); return; }
        }
        const d = await post('/umbraco/surface/ClubEvent/SetAttendance',
                             { eventId: EVENT_ID, participantId: rowId, status, note });
        if (!d.success) alert(d.message || 'Kunde inte spara närvaron.');
        await deskLoad();
    };

    window.deskConfirmPay = async function (paymentId, rowId) {
        const row = state.rows.find(r => r.id === rowId) || {};
        // ⚠️ Beloppet frågas, inte antas. Avviker det som kom in från det begärda är det
        // arrangörens iakttagelse som gäller, inte vår beräkning.
        const raw = prompt(
            `Mottaget belopp från ${row.name || 'medlemmen'} (kr).\n`
            + `Förväntat: ${row.partyTotal ?? 0} kr.`,
            String(row.partyTotal ?? ''));
        if (raw === null) return;
        const amount = Number(String(raw).replace(',', '.').trim());
        if (!(amount > 0)) { alert('Ange ett belopp större än noll.'); return; }

        const d = await post('/umbraco/surface/ClubEvent/ConfirmPayment',
                             { eventId: EVENT_ID, paymentId, actualAmount: amount });
        // ⚠️ Svaret säger om det BOKFÖRDES eller bara kvitterades. "Bokförd" är osant för varje
        // klubb som inte bokför hos oss, och ett kvitto på mottagen betalning är giltigt ändå.
        alert(d.success ? (d.message || 'Betalningen är mottagen.') : (d.message || 'Kunde inte bekräfta.'));
        await deskLoad();
    };

    // ── Lägg till ───────────────────────────────────────────────────────────────────────
    window.deskAddOpen = function () {
        document.getElementById('deskMemberQ').value = '';
        document.getElementById('deskMemberHits').innerHTML = '';
        document.getElementById('deskGuestName').value = '';

        const hosts = state.rows.filter(r => !r.isGuest && !r.cancelled && r.memberId > 0);
        document.getElementById('deskGuestHost').innerHTML = hosts.length
            ? hosts.map(h => `<option value="${h.memberId}">${esc(h.name)}</option>`).join('')
            : '<option value="">Ingen anmäld medlem att koppla gästen till</option>';

        const prices = (state.event.prices || []);
        const wrap = document.getElementById('deskGuestPriceWrap');
        // Ett enda pris väljer sig självt; flera kräver ett val. Att gissa hade satt ett belopp
        // ingen pekat på, och det är medlemmen som får betala det.
        wrap.style.display = prices.length > 1 ? '' : 'none';
        document.getElementById('deskGuestPrice').innerHTML =
            prices.map(p => `<option value="${esc(p.id)}">${esc(p.label)} — ${kr(p.amount)}</option>`).join('');

        new bootstrap.Modal(document.getElementById('deskAddModal')).show();
    };

    let searchTimer = null;
    window.deskSearchMembers = function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(async () => {
            const q = document.getElementById('deskMemberQ').value.trim();
            if (q.length < 2) { document.getElementById('deskMemberHits').innerHTML = ''; return; }
            const r = await fetch(
                `/umbraco/surface/ClubEvent/SearchAddableMembers?eventId=${EVENT_ID}&q=${encodeURIComponent(q)}`,
                { credentials: 'same-origin' });
            const d = await r.json().catch(() => null);
            const hits = (d && d.success && d.members) ? d.members : [];
            document.getElementById('deskMemberHits').innerHTML = hits.length
                ? hits.map(m => `<button type="button" class="list-group-item list-group-item-action"
                        onclick="deskAddMember(${m.memberId})">${esc(m.name)}</button>`).join('')
                : '<div class="list-group-item text-muted">Ingen träff.</div>';
        }, 250);
    };

    window.deskAddMember = async function (memberId) {
        const d = await post('/umbraco/surface/ClubEvent/SetAttendance',
                             { eventId: EVENT_ID, memberId, status: 'Present' });
        if (!d.success) { alert(d.message || 'Kunde inte lägga till.'); return; }
        bootstrap.Modal.getInstance(document.getElementById('deskAddModal')).hide();
        await deskLoad();
    };

    window.deskAddGuest = async function () {
        const name = document.getElementById('deskGuestName').value.trim();
        const host = +document.getElementById('deskGuestHost').value;
        if (!name) { alert('Ange gästens namn.'); return; }
        if (!host) { alert('Välj vilken medlem gästen kommer tillsammans med.'); return; }

        const prices = (state.event.prices || []);
        const priceId = prices.length > 1
            ? document.getElementById('deskGuestPrice').value
            : (prices[0] ? prices[0].id : null);

        const d = await post('/umbraco/surface/ClubEvent/AddGuest',
                             { eventId: EVENT_ID, guestOfMemberId: host, name, priceId });
        if (!d.success) { alert(d.message || 'Kunde inte lägga till gästen.'); return; }
        bootstrap.Modal.getInstance(document.getElementById('deskAddModal')).hide();
        await deskLoad();
    };

    deskLoad();

    // ⚠️ Pollar under kvällen: någon annan kan pricka av på sin telefon samtidigt, och
    // QR-skanningarna trillar in av sig själva. Utan det visar skärmen ett läge som är en
    // sidladdning gammalt. Pausar när fliken är dold — en telefon i fickan ska inte polla.
    setInterval(() => { if (!document.hidden) deskLoad(); }, 30000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) deskLoad(); });
})();
</script>
</body>
</html>
