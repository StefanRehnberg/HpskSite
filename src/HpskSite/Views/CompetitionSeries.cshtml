@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@using HpskSite.Extensions
@inject HpskSite.Services.AdminAuthorizationService AuthService
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = Model.Value<string>("seriesName") ?? Model.Name;

    // Get all competitions in this series - order by seriesSortOrder first, then by date
    var seriesCompetitions = Model.Children().Where(x => x.ContentType.Alias == "competition")
                                          .OrderBy(x => x.Value<int?>("seriesSortOrder") ?? int.MaxValue)
                                          .ThenBy(x => x.Value<DateTime>("competitionDate"))
                                          .ToList();

    var now = DateTime.Now;
    var completedCompetitions = seriesCompetitions.Where(c => c.Value<DateTime>("competitionDate").Date < now.Date).Count();
    var totalCompetitions = seriesCompetitions.Count();
    var progressPercentage = totalCompetitions > 0 ? (completedCompetitions * 100 / totalCompetitions) : 0;

    var seriesStartDate = Model.Value<DateTime>("seriesStartDate");
    var seriesEndDate = Model.Value<DateTime>("seriesEndDate");
    var seriesName = Model.Value<string>("seriesName") ?? Model.Name;
    var seriesDescription = Model.Value<string>("seriesDescription");
    var seriesLogo = Model.Value<IPublishedContent>("seriesLogo");
    var isActive = Model.Value<bool>("isActive", fallback: Fallback.ToDefaultValue, defaultValue: true);
    var seriesCalculationStrategy = Model.Value<string>("seriesCalculationStrategy") ?? "";
    var seriesId = Model.Id;

    bool hasAdminAccess = false;
    if (User.Identity?.IsAuthenticated == true)
    {
        hasAdminAccess = await AuthService.IsCurrentUserAdminAsync();
        if (!hasAdminAccess)
        {
            var managedRegions = await AuthService.GetManagedRegions();
            hasAdminAccess = managedRegions.Any();
        }
    }
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Model.Root().Url()">Hem</a></li>
                    @if (Model.Parent()?.ContentType.Alias == "competitionsHub")
                    {
                        <li class="breadcrumb-item"><a href="@Model.Parent().Url()">Tävlingar</a></li>
                    }
                    else if (Model.Parent()?.ContentType.Alias == "competitionSeason")
                    {
                        <li class="breadcrumb-item"><a href="@Model.Parent().Parent().Url()">Tävlingar</a></li>
                    }
                    <li class="breadcrumb-item active">@seriesName</li>
                </ol>
            </nav>

            <!-- Series Header -->
            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="d-flex align-items-center">
                                @if (seriesLogo != null)
                                {
                                    <img src="@seriesLogo.Url()" alt="@seriesName Logo" class="me-3" style="max-height: 60px; max-width: 80px;">
                                }
                                <div>
                                    <h1 class="mb-1">🏆 @seriesName</h1>
                                    <p class="mb-0 opacity-75">
                                        @if (seriesStartDate != DateTime.MinValue && seriesEndDate != DateTime.MinValue)
                                        {
                                            @seriesStartDate.ToString("yyyy-MM-dd") <text> - </text> @seriesEndDate.ToString("yyyy-MM-dd")
                                        }
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 text-end">
                            <div class="text-white">
                                <div class="h4 mb-1">@completedCompetitions/@totalCompetitions</div>
                                <small>Genomförda</small>
                                @if (!isActive)
                                {
                                    <div class="badge bg-warning text-dark mt-2">Inaktiv</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(seriesDescription))
                {
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <!-- Expandable Description -->
                                <div class="series-description-container prose">
                                    <div class="series-description-preview" id="seriesDescriptionPreview">
                                        @Html.Raw(System.Net.WebUtility.HtmlDecode(seriesDescription))
                                    </div>
                                    <div class="series-description-full" id="seriesDescriptionFull" style="display: none;">
                                        @Html.Raw(System.Net.WebUtility.HtmlDecode(seriesDescription))
                                    </div>
                                    <button type="button" class="btn btn-link btn-sm p-0 mt-2 text-decoration-none"
                                            id="toggleDescription"
                                            onclick="toggleSeriesDescription()"
                                            style="display: none;">
                                        <i class="bi bi-chevron-down" id="toggleIcon"></i>
                                        <span id="toggleText">Visa mer</span>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <h6>Serieframsteg</h6>
                                <div class="progress mb-2" style="height: 8px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @progressPercentage%"></div>
                                </div>
                                <small class="text-muted">@progressPercentage% genomfört</small>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Competitions in Series -->
            @if (seriesCompetitions.Any())
            {
                <div class="row">
                    <div class="col-12">
                        <div class="row">
                            @{ int roundNumber = 1; }
                            @foreach (var competition in seriesCompetitions)
                            {
                                // Get competition details (same as competitions hub)
                                var compDate = competition.Value<DateTime>("competitionDate");
                                var compEndDate = competition.Value<DateTime?>("competitionEndDate");
                                var regCloseDate = competition.Value<DateTime>("registrationCloseDate");
                                var regOpenDate = competition.Value<DateTime>("registrationOpenDate");
                                var description = HpskSite.Extensions.RteHelper.ExtractMarkup(competition.Value<string>("description"));
                                var venue = competition.Value<string>("venue");

                                // Check if multi-day competition
                                var hasValidEndDate = compEndDate.HasValue &&
                                                      compEndDate.Value > DateTime.MinValue &&
                                                      compEndDate.Value.Year > 1900 &&
                                                      compEndDate.Value.Date >= compDate.Date;
                                var isMultiDay = hasValidEndDate && compEndDate!.Value.Date != compDate.Date;
                                var dateIcon = isMultiDay ? "📅" : "🕐";
                                var dateDisplay = isMultiDay ?
                                    $"{compDate:yyyy-MM-dd} - {compEndDate.Value:yyyy-MM-dd}" :
                                    compDate.ToString("yyyy-MM-dd");
                                var durationInfo = isMultiDay ?
                                    $"({(compEndDate.Value.Date - compDate.Date).Days + 1} dagar)" :
                                    "(1 dag)";

                                var maxParticipants = competition.Value<int>("maxParticipants");
                                var registrationFee = competition.Value<string>("registrationFee");
                                var competitionTypeId = competition.Value<string>("competitionType") ?? "";
                                var competitionTypeObj = HpskSite.Models.CompetitionTypes.GetById(competitionTypeId);
                                var competitionTypeName = competitionTypeObj?.Name ?? (!string.IsNullOrEmpty(competitionTypeId) ? competitionTypeId : "Okänd typ");
                                var numberOfSeriesOrStations = competition.Value<int>("numberOfSeriesOrStations");
                                var numberOfFinalSeries = competition.Value<int>("numberOfFinalSeries");

                                // Build competition type display name with series info (skip for Springskytte)
                                var competitionTypeDisplayName = competitionTypeName;
                                if (competitionTypeId != "Springskytte" && numberOfSeriesOrStations > 0)
                                {
                                    if (numberOfFinalSeries > 0)
                                    {
                                        var qualSeries = numberOfSeriesOrStations - numberOfFinalSeries;
                                        competitionTypeDisplayName += $" {qualSeries}+{numberOfFinalSeries} serier";
                                    }
                                    else
                                    {
                                        competitionTypeDisplayName += $" {numberOfSeriesOrStations} serier";
                                    }
                                }

                                // Multiple shooting classes support - handle string array, JSON array, or CSV
                                var shootingClassIdsRaw = competition.Value("shootingClassIds");
                                string[] classIdArray = Array.Empty<string>();
                                try
                                {
                                    if (shootingClassIdsRaw is string[] stringArray)
                                    {
                                        classIdArray = stringArray;
                                    }
                                    else if (shootingClassIdsRaw is string stringValue && !string.IsNullOrEmpty(stringValue))
                                    {
                                        // Check if JSON array format
                                        if (stringValue.TrimStart().StartsWith("["))
                                        {
                                            classIdArray = System.Text.Json.JsonSerializer.Deserialize<string[]>(stringValue) ?? Array.Empty<string>();
                                        }
                                        else
                                        {
                                            // CSV format (legacy)
                                            classIdArray = stringValue.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)).ToArray();
                                        }
                                    }
                                }
                                catch (System.Text.Json.JsonException)
                                {
                                    // Handle corrupted shooting class data - fallback to empty
                                    classIdArray = Array.Empty<string>();
                                }

                                // Use centralized shooting classes model (includes R, L, M classes)
                                var shootingClasses = HpskSite.Models.ShootingClasses.All;

                                var competitionShootingClasses = new List<dynamic>();
                                if (classIdArray.Length > 0)
                                {
                                    competitionShootingClasses = shootingClasses.Where(sc => classIdArray.Contains((string)sc.Id)).ToList<dynamic>();
                                }

                                var isSpringskytteComp = competitionTypeId == "Springskytte";
                                var shootingClassName = isSpringskytteComp && classIdArray.Length > 0
                                    ? string.Join(", ", classIdArray)
                                    : competitionShootingClasses.Any()
                                        ? string.Join(", ", competitionShootingClasses.Select(sc => sc.Name))
                                        : "Inga klasser";
                                var isCompetitionActive = competition.Value<bool>("isActive");

                                // Calculate status (same logic as competitions hub)
                                var effectiveEnd = hasValidEndDate ? compEndDate!.Value.Date : compDate.Date;
                                var status = "completed";
                                var statusIcon = "bi-check-circle";
                                var statusText = "Avslutad";
                                var statusClass = "secondary";
                                var buttonText = "Visa Tävling";
                                var buttonClass = "btn-secondary";

                                if (isCompetitionActive && effectiveEnd >= now.Date)
                                {
                                    if (regOpenDate <= now && regCloseDate >= now)
                                    {
                                        status = "open";
                                        statusIcon = "bi-person-plus";
                                        statusText = "Anmälan öppen";
                                        statusClass = "success";
                                        buttonClass = "btn-success";
                                    }
                                    else if (regOpenDate > now)
                                    {
                                        status = "upcoming";
                                        statusIcon = "bi-calendar-plus";
                                        statusText = "Kommande";
                                        statusClass = "warning";
                                        buttonClass = "btn-warning";
                                    }
                                    else if (compDate.Date == now.Date || (regCloseDate < now && compDate.Date >= now.Date))
                                    {
                                        status = "active";
                                        statusIcon = "bi-play-circle";
                                        statusText = "Pågående";
                                        statusClass = "primary";
                                        buttonClass = "btn-primary";
                                    }
                                }

                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100 border-@statusClass">
                                        <div class="card-header bg-@statusClass text-white d-flex justify-content-between align-items-center">
                                            <div class="flex-grow-1">
                                                <h5 class="card-title mb-0">@competition.Name</h5>
                                                <small><i class="bi @statusIcon me-1"></i>@statusText</small>
                                            </div>
                                            <span class="badge bg-light text-dark">Omg. @roundNumber</span>
                                        </div>
                                        <div class="card-body pt-2 pb-2">
                                            <ul class="list-unstyled small mb-0">
                                                @if (!string.IsNullOrEmpty(description))
                                                {
                                                    <li class="mb-1">@Html.Raw(System.Net.WebUtility.HtmlDecode(description))</li>
                                                }
                                                <li>
                                                    @dateIcon @dateDisplay
                                                    <small class="text-muted ms-1">@durationInfo</small>
                                                </li>
                                                <li><i class="bi bi-geo-alt"></i> @venue</li>
                                                @if (!string.IsNullOrEmpty(competitionTypeId))
                                                {
                                                    <li><i class="bi bi-trophy"></i> @competitionTypeDisplayName</li>
                                                }
                                                <li><i class="bi bi-bullseye"></i> @shootingClassName</li>
                                            </ul>
                                        </div>
                                        <div class="card-footer d-flex align-items-center">
                                            <a href="@competition.CompetitionUrl()" class="btn @buttonClass btn-sm">@buttonText</a>
                                            @if (status == "open")
                                            {
                                                <small class="text-muted ms-2">Stänger: @regCloseDate.ToString("yyyy-MM-dd")</small>
                                            }
                                            else if (status == "upcoming")
                                            {
                                                <small class="text-muted ms-2">Öppnar: @regOpenDate.ToString("yyyy-MM-dd")</small>
                                            }
                                        </div>
                                    </div>
                                </div>
                                roundNumber++;
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Inga tävlingar har lagts till i denna serie ännu.
                </div>
            }

            @if (!string.IsNullOrEmpty(seriesCalculationStrategy))
            {
                <!-- Series Results -->
                <div id="seriesResultsContainer" class="mt-4">
                    <div class="text-center py-4" id="seriesResultsLoading">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Laddar...</span>
                        </div>
                        <p class="mt-2 text-muted">Beräknar serieresultat...</p>
                    </div>
                    <div id="seriesResultsContent" style="display: none;"></div>
                    <div id="seriesResultsError" class="alert alert-warning d-none">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        <span id="seriesResultsErrorMessage"></span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
.series-description-container {
    position: relative;
}

.series-description-preview {
    max-height: 3.6em; /* Approximately 2-3 lines */
    overflow: hidden;
    position: relative;
    line-height: 1.4em;
}

.series-description-preview::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 1.4em;
    background: linear-gradient(to bottom, transparent, var(--bs-body-bg));
    pointer-events: none;
}

.series-description-preview.no-fade::after {
    display: none;
}

.series-description-full {
    line-height: 1.4em;
}

#toggleDescription {
    color: var(--bs-link-color) !important;
    font-size: 0.875rem;
    transition: all 0.2s ease;
}

#toggleDescription:hover {
    color: var(--bs-link-hover-color) !important;
}

#toggleIcon {
    transition: transform 0.2s ease;
    margin-right: 0.25rem;
}

#toggleIcon.rotated {
    transform: rotate(180deg);
}

/* Mobile card layout for series standings (visible under md breakpoint) */
.series-mobile-rounds-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.25rem 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--bs-border-color);
    font-size: 0.875rem;
}
.series-mobile-rounds-grid .label {
    color: var(--bs-secondary-color);
    margin-right: 0.35rem;
}
.series-mobile-rounds-grid .non-counting {
    opacity: 0.4;
    text-decoration: line-through;
}

/* Klubb section: per-round breakdown with contributing shooters (mobile collapse + desktop expander) */
.series-klubb-rounds {
    /* container; rounds stacked vertically */
}
.series-klubb-round {
    padding: 0.45rem 0;
    border-top: 1px solid var(--bs-border-color);
}
.series-klubb-round:first-child {
    border-top: 0;
    padding-top: 0.1rem;
}
.series-klubb-round-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-weight: 600;
    gap: 0.5rem;
}
.series-klubb-round-head .label {
    color: var(--bs-secondary-color);
    font-weight: 500;
}
.series-klubb-round-head .value {
    text-align: right;
}
.series-klubb-contributors {
    margin-top: 0.25rem;
    margin-left: 0.6rem;
    font-size: 0.875rem;
}
.series-klubb-contributor {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.05rem 0;
}
.series-klubb-contributor .name {
    flex: 1 1 auto;
    min-width: 0;
    color: var(--bs-body-color);
    word-break: break-word;
}
.series-klubb-contributor .score {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
    color: var(--bs-secondary-color);
}
.series-klubb-contributor .cls-badge {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0.05rem 0.4rem;
    border-radius: 0.2rem;
    background-color: var(--bs-tertiary-bg);
    color: var(--bs-secondary-color);
    font-size: 0.75rem;
    font-weight: 500;
}
.series-klubb-expand-btn {
    border: 0;
    background: transparent;
    padding: 0 0.25rem;
    color: var(--bs-secondary-color);
    cursor: pointer;
}
.series-klubb-expand-btn[aria-expanded="true"] .bi-chevron-down {
    transform: rotate(180deg);
}
.series-klubb-expand-btn .bi-chevron-down {
    transition: transform 0.15s ease;
}

/* Truncate long name/club values in series standings tables so fixed-width columns stay aligned */
.series-cell-truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    initializeSeriesDescription();
});

function initializeSeriesDescription() {
    const preview = document.getElementById('seriesDescriptionPreview');
    const toggle = document.getElementById('toggleDescription');

    if (!preview || !toggle) return;

    // Check if content actually overflows
    const lineHeight = parseFloat(getComputedStyle(preview).lineHeight);
    const maxHeight = 3.6 * (lineHeight || 16); // Fallback to 16px if lineHeight is NaN

    if (preview.scrollHeight > maxHeight) {
        // Content overflows, show the toggle button
        toggle.style.display = 'inline-flex';
    } else {
        // Content fits, remove fade effect and hide toggle
        preview.classList.add('no-fade');
        toggle.style.display = 'none';
    }
}

function toggleSeriesDescription() {
    const preview = document.getElementById('seriesDescriptionPreview');
    const full = document.getElementById('seriesDescriptionFull');
    const toggleIcon = document.getElementById('toggleIcon');
    const toggleText = document.getElementById('toggleText');

    if (!preview || !full || !toggleIcon || !toggleText) return;

    const isExpanded = full.style.display !== 'none';

    if (isExpanded) {
        // Collapse
        preview.style.display = 'block';
        full.style.display = 'none';
        toggleIcon.classList.remove('rotated');
        toggleText.textContent = 'Visa mer';

        // Smooth scroll to series header
        document.querySelector('.card.border-primary').scrollIntoView({
            behavior: 'smooth',
            block: 'start'
        });
    } else {
        // Expand
        preview.style.display = 'none';
        full.style.display = 'block';
        toggleIcon.classList.add('rotated');
        toggleText.textContent = 'Visa mindre';
    }
}

@if (!string.IsNullOrEmpty(seriesCalculationStrategy))
{
    <text>
    // Load series results
    (function() {
        const seriesId = @seriesId;
        const container = document.getElementById('seriesResultsContent');
        const loading = document.getElementById('seriesResultsLoading');
        const errorDiv = document.getElementById('seriesResultsError');
        const errorMsg = document.getElementById('seriesResultsErrorMessage');
        const isAdmin = @(hasAdminAccess ? "true" : "false");

        function loadSeriesResults(forceRefresh) {
            const url = '/umbraco/surface/CompetitionAdmin/GetSeriesResults?seriesId=' + seriesId
                + (forceRefresh ? '&forceRefresh=true' : '');

            // Show loading state
            loading.style.display = 'block';
            container.style.display = 'none';
            errorDiv.classList.add('d-none');

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    loading.style.display = 'none';

                    if (!data.success || !data.data) {
                        document.getElementById('seriesResultsContainer').style.display = 'none';
                        return;
                    }

                    const result = data.data;
                    if (!result.sections || result.sections.length === 0) {
                        document.getElementById('seriesResultsContainer').style.display = 'none';
                        return;
                    }

                    document.getElementById('seriesResultsContainer').style.display = 'block';
                    container.style.display = 'block';
                    let html = '';

                    // Header
                    html += '<div class="card border-success mb-4">';
                    html += '<div class="card-header bg-success text-white d-flex justify-content-between align-items-start">';
                    html += '<div>';
                    html += '<h3 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Serieresultat</h3>';
                    html += '<small>' + escapeHtmlSeries(result.strategyName) + '</small>';
                    html += '</div>';
                    if (isAdmin) {
                        html += '<button class="btn btn-sm btn-outline-light ms-2 mt-1" id="recalcSeriesBtn" title="Beräkna om serieresultat">';
                        html += '<i class="bi bi-arrow-clockwise"></i> Beräkna om';
                        html += '</button>';
                    }
                    html += '</div>';
                    html += '<div class="card-body p-0">';

                    // Pre-build lookup of contributing shooters (per club, per class) so the Klubb section
                    // can show "best of N" contributors without recomputing per row.
                    const contributorsByClub = buildContributorsByClub(result.sections);

                    // Render Club sections before Individual sections.
                    const orderedSections = result.sections.slice().sort(function(a, b) {
                        const rank = function(s) { return s.sectionType === 'Club' ? 0 : 1; };
                        return rank(a) - rank(b);
                    });

                    orderedSections.forEach(function(section) {
                        html += '<div class="p-3">';
                        if (result.sections.length > 1) {
                            html += '<h4 class="mb-3">' + escapeHtmlSeries(section.title) + '</h4>';
                        }

                        if (section.sectionType === 'Individual') {
                            html += renderIndividualSection(section, result.competitions);
                        } else if (section.sectionType === 'Club') {
                            html += renderClubSection(section, result.competitions, contributorsByClub);
                        }
                        html += '</div>';
                    });

                    html += '</div></div>';
                    container.innerHTML = html;

                    // Attach recalculate button handler
                    var recalcBtn = document.getElementById('recalcSeriesBtn');
                    if (recalcBtn) {
                        recalcBtn.addEventListener('click', function() {
                            loadSeriesResults(true);
                        });
                    }
                })
                .catch(error => {
                    loading.style.display = 'none';
                    document.getElementById('seriesResultsContainer').style.display = 'none';
                    console.error('Error loading series results:', error);
                });
        }

        // Initial load
        loadSeriesResults(false);

        function renderIndividualSection(section, competitions) {
            let html = '';
            const currentMemberId = parseInt(document.body.dataset.currentMemberId || '0');

            // Detect if any cell uses points different from score (placement scoring)
            let usesPoints = false;
            section.classStandings.forEach(function(classGroup) {
                classGroup.rows.forEach(function(row) {
                    row.competitionScores.forEach(function(cell) {
                        if (cell.points !== null && cell.points !== undefined && cell.score !== null && cell.points !== cell.score) {
                            usesPoints = true;
                        }
                    });
                });
            });

            // Column widths as percentages so tables fit the container and align across classes.
            // Numeric columns get a consistent share; name/club share the remaining space.
            const numCompCols = competitions.length;
            const omgPct = 7;
            const totalPct = 9;
            const xPct = 4;
            const rankPct = 3;
            const numericShare = numCompCols * omgPct + totalPct + xPct + rankPct;
            const textShare = 100 - numericShare;
            const namePct = textShare / 2;
            const clubPct = textShare / 2;

            section.classStandings.forEach(function(classGroup) {
                if (classGroup.rows.length === 0) return;

                html += '<div class="mb-4">';
                html += '<h5 class="p-2 rounded" style="background-color: var(--bs-tertiary-bg);">' + escapeHtmlSeries(classGroup.className) + '</h5>';
                html += '<div class="d-none d-md-block">';
                html += '<div class="table-responsive">';
                html += '<table class="table table-sm table-striped table-hover mb-0 series-standings-individual" style="table-layout:fixed;width:100%;">';
                html += '<thead><tr>';
                html += '<th style="width:' + rankPct + '%">#</th>';
                html += '<th style="width:' + namePct + '%">Namn</th>';
                html += '<th style="width:' + clubPct + '%">Klubb</th>';
                competitions.forEach(function(comp, idx) {
                    html += '<th class="text-center" style="width:' + omgPct + '%" title="' + escapeHtmlSeries(comp.name) + '">Omg.&nbsp;' + (idx + 1) + '</th>';
                });
                html += '<th class="text-center" style="width:' + totalPct + '%"><strong>' + (usesPoints ? 'Poäng' : 'Totalt') + '</strong></th>';
                html += '<th class="text-center" style="width:' + xPct + '%">X</th>';
                html += '</tr></thead>';
                html += '<tbody>';

                classGroup.rows.forEach(function(row) {
                    const isCurrentUser = row.entityId === currentMemberId;
                    const rowClass = isCurrentUser ? ' style="background-color: rgba(13,110,253,0.1);"' : '';

                    html += '<tr' + rowClass + '>';
                    html += '<td><strong>' + row.rank + '</strong></td>';
                    html += '<td class="series-cell-truncate" title="' + escapeHtmlSeries(row.name) + '">' + escapeHtmlSeries(row.name) + '</td>';
                    html += '<td class="series-cell-truncate" title="' + escapeHtmlSeries(row.club) + '"><small>' + escapeHtmlSeries(row.club) + '</small></td>';

                    row.competitionScores.forEach(function(cell) {
                        if (cell.score === null || cell.score === undefined) {
                            html += '<td class="text-center text-muted">-</td>';
                        } else if (!cell.counting) {
                            // Non-counting cell (bestOf) - dimmed with strikethrough
                            if (usesPoints && cell.points !== null && cell.points !== undefined) {
                                html += '<td class="text-center" style="opacity:0.4;text-decoration:line-through;">'
                                    + cell.score + '<br><small>' + cell.points + 'p</small></td>';
                            } else {
                                html += '<td class="text-center" style="opacity:0.4;text-decoration:line-through;">' + cell.score + '</td>';
                            }
                        } else if (usesPoints && cell.points !== null && cell.points !== undefined) {
                            // Placement scoring: show score + points below
                            html += '<td class="text-center">' + cell.score
                                + '<br><small class="text-success fw-bold">' + cell.points + 'p</small></td>';
                        } else {
                            html += '<td class="text-center">' + cell.score + '</td>';
                        }
                    });

                    html += '<td class="text-center"><strong>' + row.totalSeriesScore + '</strong></td>';
                    html += '<td class="text-center">' + row.totalXCount + '</td>';
                    html += '</tr>';
                });

                html += '</tbody></table></div></div>';

                // Mobile card list (visible below md breakpoint)
                html += '<div class="d-md-none">';
                classGroup.rows.forEach(function(row) {
                    const isCurrentUser = row.entityId === currentMemberId;
                    const cardStyle = isCurrentUser ? ' style="background-color: rgba(13,110,253,0.1);"' : '';
                    const collapseId = 'mr-Indiv-' + sanitizeIdSeries(classGroup.className) + '-' + row.entityId;

                    html += '<div class="series-mobile-card border rounded p-2 mb-2"' + cardStyle + '>';
                    html += '<div class="d-flex justify-content-between align-items-start">';
                    html += '<div class="flex-grow-1 me-2" style="min-width:0;">';
                    html += '<div><span class="fw-bold me-1">' + row.rank + '.</span>' + escapeHtmlSeries(row.name) + '</div>';
                    html += '<small class="text-muted">' + escapeHtmlSeries(row.club) + '</small>';
                    html += '</div>';
                    html += '<div class="text-end">';
                    html += '<div class="fw-bold">' + row.totalSeriesScore + '</div>';
                    html += '<small class="text-muted">' + row.totalXCount + ' &times;</small>';
                    html += '</div>';
                    html += '</div>';

                    html += '<button class="btn btn-link btn-sm p-0 mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#' + collapseId + '" aria-expanded="false" aria-controls="' + collapseId + '">';
                    html += '<i class="bi bi-chevron-down me-1"></i>Visa omgångar';
                    html += '</button>';

                    html += '<div class="collapse" id="' + collapseId + '">';
                    html += '<div class="series-mobile-rounds-grid">';
                    row.competitionScores.forEach(function(cell, idx) {
                        html += '<span><span class="label">Omg.' + (idx + 1) + '</span>' + buildMobileRoundCell(cell, usesPoints) + '</span>';
                    });
                    html += '</div>';
                    html += '</div>';

                    html += '</div>';
                });
                html += '</div>';

                html += '</div>';
            });

            return html;
        }

        function renderClubSection(section, competitions, contributorsByClub) {
            let html = '';

            // Detect if any cell uses points different from score (placement scoring)
            let usesPoints = false;
            section.classStandings.forEach(function(classGroup) {
                classGroup.rows.forEach(function(row) {
                    row.competitionScores.forEach(function(cell) {
                        if (cell.points !== null && cell.points !== undefined && cell.score !== null && cell.points !== cell.score) {
                            usesPoints = true;
                        }
                    });
                });
            });

            const numCompColsC = competitions.length;
            const omgPctC = 7;
            const totalPctC = 9;
            const rankPctC = 3;
            const clubPctC = 100 - (numCompColsC * omgPctC + totalPctC + rankPctC);

            section.classStandings.forEach(function(classGroup) {
                if (classGroup.rows.length === 0) return;

                html += '<div class="mb-4">';
                html += '<h5 class="p-2 rounded" style="background-color: var(--bs-tertiary-bg);">' + escapeHtmlSeries(classGroup.className) + '</h5>';
                html += '<div class="d-none d-md-block">';
                html += '<div class="table-responsive">';
                html += '<table class="table table-sm table-striped table-hover mb-0 series-standings-club" style="table-layout:fixed;width:100%;">';
                html += '<thead><tr>';
                html += '<th style="width:' + rankPctC + '%">#</th>';
                html += '<th style="width:' + clubPctC + '%">Klubb</th>';
                competitions.forEach(function(comp, idx) {
                    html += '<th class="text-center" style="width:' + omgPctC + '%" title="' + escapeHtmlSeries(comp.name) + '">Omg.&nbsp;' + (idx + 1) + '</th>';
                });
                html += '<th class="text-center" style="width:' + totalPctC + '%"><strong>' + (usesPoints ? 'Poäng' : 'Totalt') + '</strong></th>';
                html += '</tr></thead>';
                html += '<tbody>';

                const desktopColspan = 2 + competitions.length + 1; // rank + club + per-comp + total

                classGroup.rows.forEach(function(row) {
                    const collapseDeskId = 'kc-desk-' + sanitizeIdSeries(classGroup.className) + '-' + row.entityId;
                    const showExpander = !!contributorsByClub;

                    html += '<tr>';
                    html += '<td><strong>' + row.rank + '</strong>';
                    if (showExpander) {
                        html += ' <button type="button" class="series-klubb-expand-btn" data-bs-toggle="collapse" data-bs-target="#' + collapseDeskId + '" aria-expanded="false" aria-controls="' + collapseDeskId + '" title="Visa bidragande skyttar"><i class="bi bi-chevron-down"></i></button>';
                    }
                    html += '</td>';
                    html += '<td class="series-cell-truncate" title="' + escapeHtmlSeries(row.name) + '">' + escapeHtmlSeries(row.name) + '</td>';

                    row.competitionScores.forEach(function(cell) {
                        if (cell.score === null || cell.score === undefined) {
                            html += '<td class="text-center text-muted">-</td>';
                        } else if (!cell.counting) {
                            // Non-counting cell (bestOf) - dimmed with strikethrough
                            if (usesPoints && cell.points !== null && cell.points !== undefined) {
                                html += '<td class="text-center" style="opacity:0.4;text-decoration:line-through;">'
                                    + cell.score + '<br><small>' + cell.points + 'p</small></td>';
                            } else {
                                html += '<td class="text-center" style="opacity:0.4;text-decoration:line-through;">' + cell.score + '</td>';
                            }
                        } else if (usesPoints && cell.points !== null && cell.points !== undefined) {
                            // Placement scoring: show score + points below
                            html += '<td class="text-center">' + cell.score
                                + '<br><small class="text-success fw-bold">' + cell.points + 'p</small></td>';
                        } else {
                            html += '<td class="text-center">' + cell.score + '</td>';
                        }
                    });

                    html += '<td class="text-center"><strong>' + row.totalSeriesScore + '</strong></td>';
                    html += '</tr>';

                    // Sibling collapse row with per-round contributor breakdown (desktop only)
                    if (showExpander) {
                        html += '<tr>';
                        html += '<td colspan="' + desktopColspan + '" class="p-0 border-0">';
                        html += '<div class="collapse" id="' + collapseDeskId + '">';
                        html += '<div class="p-3" style="background-color: var(--bs-tertiary-bg);">';
                        html += buildKlubbRoundsBlock(row, classGroup.className, competitions, contributorsByClub, usesPoints);
                        html += '</div>';
                        html += '</div>';
                        html += '</td>';
                        html += '</tr>';
                    }
                });

                html += '</tbody></table></div></div>';

                // Mobile card list (visible below md breakpoint)
                html += '<div class="d-md-none">';
                classGroup.rows.forEach(function(row) {
                    const collapseId = 'mr-Klubb-' + sanitizeIdSeries(classGroup.className) + '-' + row.entityId;

                    html += '<div class="series-mobile-card border rounded p-2 mb-2">';
                    html += '<div class="d-flex justify-content-between align-items-start">';
                    html += '<div class="flex-grow-1 me-2" style="min-width:0;">';
                    html += '<div><span class="fw-bold me-1">' + row.rank + '.</span>' + escapeHtmlSeries(row.name) + '</div>';
                    html += '</div>';
                    html += '<div class="text-end">';
                    html += '<div class="fw-bold">' + row.totalSeriesScore + (usesPoints ? ' p' : '') + '</div>';
                    html += '</div>';
                    html += '</div>';

                    html += '<button class="btn btn-link btn-sm p-0 mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#' + collapseId + '" aria-expanded="false" aria-controls="' + collapseId + '">';
                    html += '<i class="bi bi-chevron-down me-1"></i>Visa omgångar';
                    html += '</button>';

                    html += '<div class="collapse" id="' + collapseId + '">';
                    html += buildKlubbRoundsBlock(row, classGroup.className, competitions, contributorsByClub, usesPoints);
                    html += '</div>';

                    html += '</div>';
                });
                html += '</div>';

                html += '</div>';
            });

            return html;
        }

        function sanitizeIdSeries(s) {
            return String(s == null ? '' : s).replace(/[^a-zA-Z0-9_-]/g, '-');
        }

        function buildMobileRoundCell(cell, usesPoints) {
            if (cell.score === null || cell.score === undefined) {
                return '<span class="text-muted">-</span>';
            }
            let inner = String(cell.score);
            if (usesPoints && cell.points !== null && cell.points !== undefined) {
                inner += ' <small class="text-success fw-bold">(' + cell.points + 'p)</small>';
            }
            if (!cell.counting) {
                return '<span class="non-counting">' + inner + '</span>';
            }
            return inner;
        }

        // Builds a lookup of Individual-section rows by class and by club for fast contributor lookup.
        // Each entry is { row, className } so we can show which class a contributing score came from
        // (a shooter may appear in multiple classes for the same competition).
        // Returns null when the response has no Individual section.
        function buildContributorsByClub(sections) {
            if (!sections) return null;
            const indSection = sections.find(function(s) { return s.sectionType === 'Individual'; });
            if (!indSection || !indSection.classStandings) return null;

            const byClass = {}; // className -> clubName -> entries[]
            const all = {};      // clubName -> entries[]

            indSection.classStandings.forEach(function(cg) {
                const cn = cg.className || '';
                if (!byClass[cn]) byClass[cn] = {};
                cg.rows.forEach(function(row) {
                    const entry = { row: row, className: cn };
                    const club = row.club || '';
                    if (!byClass[cn][club]) byClass[cn][club] = [];
                    byClass[cn][club].push(entry);
                    if (!all[club]) all[club] = [];
                    all[club].push(entry);
                });
            });

            return { byClass: byClass, all: all };
        }

        // Mirror of HpskSite.Helpers.ClubNameHelper.Shorten — the backend's BuildIndividualSection
        // shortens the club name on every Individual row (e.g. "Varbergs Pistolklubb" → "Varbergs PK"),
        // while the Klubb section keeps the raw long name. Apply the same transform on the lookup
        // key so they line up. Order matters: longer matches first.
        function shortenClubNameJs(name) {
            if (!name) return name;
            if (name.toLowerCase() === 'göteborgs pistol-och sportskk pistolsektionen') return 'GPSSK';
            return name
                .replace(/Pistolskytteförening/gi, 'PSF')
                .replace(/Pistolskytteklubb/gi, 'PSK')
                .replace(/Pistolskyttar/gi, 'PS')
                .replace(/Pistolklubb/gi, 'PK')
                .replace(/Handeldvapenförening/gi, 'HF')
                .replace(/Sportskytteklubb/gi, 'SSK')
                .replace(/Skytteklubb/gi, 'SK')
                .replace(/Skytteförening/gi, 'SF');
        }

        // Identify contributing shooters for a Klubb cell by replicating the strategy's selection rule:
        // take top-N from the club for that competition (by score desc, xCount desc) and accumulate
        // until the sum equals the Klubb cell's score. Whatever fell into the prefix is the contributor set.
        // For "Kombinerat" (groupByClass=false) Klubb sections, a shooter who shot multiple classes
        // counts only once with their best score across classes — match the backend in BuildClubSectionCombined.
        // Returns { contributors: entry[], matched: bool } so callers can distinguish a verified match from
        // an inconsistency (e.g. team total doesn't equal any prefix sum, indicating data drift).
        function findContributors(contributorsByClub, klubbClassName, clubName, competitionIdx, teamTotalScore) {
            const empty = { contributors: [], matched: false };
            if (!contributorsByClub) return empty;

            const shortName = shortenClubNameJs(clubName);

            let pool = null;
            let isCombined = false;
            if (klubbClassName && contributorsByClub.byClass[klubbClassName] && contributorsByClub.byClass[klubbClassName][shortName]) {
                pool = contributorsByClub.byClass[klubbClassName][shortName];
            } else if (contributorsByClub.all[shortName]) {
                pool = contributorsByClub.all[shortName];
                isCombined = true;
            } else {
                return empty;
            }

            // Keep only entries with a score in this competition
            let candidates = pool.filter(function(e) {
                const cell = e.row.competitionScores && e.row.competitionScores[competitionIdx];
                return cell && cell.score !== null && cell.score !== undefined;
            });
            if (candidates.length === 0) return empty;

            // Combined mode: dedupe per member, keep their best (score, xCount) for this comp.
            // The wrapper retains className, so the surviving entry shows the class of the winning score.
            if (isCombined) {
                const bestByMember = new Map();
                candidates.forEach(function(e) {
                    const id = e.row.entityId;
                    const cur = e.row.competitionScores[competitionIdx];
                    const ex = bestByMember.get(id);
                    if (!ex) { bestByMember.set(id, e); return; }
                    const exCell = ex.row.competitionScores[competitionIdx];
                    const curBetter = cur.score > exCell.score
                        || (cur.score === exCell.score && (cur.xCount || 0) > (exCell.xCount || 0));
                    if (curBetter) bestByMember.set(id, e);
                });
                candidates = Array.from(bestByMember.values());
            }

            // Sort top-down: score desc, xCount desc — matches strategy's selection order.
            candidates.sort(function(a, b) {
                const ca = a.row.competitionScores[competitionIdx];
                const cb = b.row.competitionScores[competitionIdx];
                if (cb.score !== ca.score) return cb.score - ca.score;
                return (cb.xCount || 0) - (ca.xCount || 0);
            });

            if (teamTotalScore === null || teamTotalScore === undefined) {
                return { contributors: candidates, matched: false };
            }

            // Accumulate from top until running sum equals the team total.
            // (Use for-of, not a numeric for-loop — Razor's text-block parser misreads
            //  the less-than operator before an identifier as the start of an HTML tag.)
            const result = [];
            let runningSum = 0;
            for (const entry of candidates) {
                result.push(entry);
                runningSum += entry.row.competitionScores[competitionIdx].score;
                if (runningSum === teamTotalScore) {
                    return { contributors: result, matched: true };
                }
            }

            // No prefix sum matched — data drift or unknown rule. Surface the inconsistency.
            return { contributors: [], matched: false };
        }

        // Render the rounds-with-contributors block for one Klubb row. Used in both mobile collapse and desktop expander.
        function buildKlubbRoundsBlock(row, klubbClassName, competitions, contributorsByClub, usesPoints) {
            let html = '<div class="series-klubb-rounds">';
            row.competitionScores.forEach(function(cell, idx) {
                html += '<div class="series-klubb-round">';
                html += '<div class="series-klubb-round-head">';
                html += '<span class="label">Omg.&nbsp;' + (idx + 1) + '</span>';
                html += '<span class="value">' + buildMobileRoundCell(cell, usesPoints) + '</span>';
                html += '</div>';

                if (cell.score !== null && cell.score !== undefined) {
                    const result = findContributors(contributorsByClub, klubbClassName, row.name, idx, cell.score);
                    if (result.contributors.length > 0) {
                        html += '<div class="series-klubb-contributors">';
                        result.contributors.forEach(function(c) {
                            const cellRef = c.row.competitionScores[idx];
                            let scoreText = String(cellRef.score);
                            if (cellRef.xCount !== null && cellRef.xCount !== undefined) {
                                scoreText += ' (' + cellRef.xCount + '×)';
                            }
                            // Show class only when it differs from the Klubb class (avoids redundant labels
                            // for single-class team series where every contributor is from the same class).
                            const showClass = c.className && c.className !== klubbClassName;
                            html += '<div class="series-klubb-contributor">';
                            html += '<span class="name">' + escapeHtmlSeries(c.row.name) + '</span>';
                            html += '<span class="score">';
                            if (showClass) {
                                html += '<span class="cls-badge">' + escapeHtmlSeries(c.className) + '</span>';
                            }
                            html += scoreText;
                            html += '</span>';
                            html += '</div>';
                        });
                        html += '</div>';
                    } else if (contributorsByClub) {
                        // Either no individual rows for this club/class/comp, or no prefix sum matches
                        // the team total. Either way, surface the inconsistency rather than hide it.
                        html += '<div class="series-klubb-contributors text-muted small fst-italic">(kunde inte härleda bidragande skyttar)</div>';
                    }
                }
                html += '</div>';
            });
            html += '</div>';
            return html;
        }

        function escapeHtmlSeries(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    })();
    </text>
}
</script>