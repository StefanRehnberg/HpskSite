@{
    Layout = null;
    var token = Context.Request.Query["t"].ToString();
}
<!DOCTYPE html>
<html lang="sv" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Justera protokoll</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        body { background: #f4f5f7; }
        .wrap { max-width: 560px; margin: 0 auto; padding: 1.25rem 1rem 3rem; font-size: 1.12rem; }
        .card { border-radius: .9rem; }
        .btn-xl { font-size: 1.25rem; padding: .9rem 1.4rem; font-weight: 600; border-radius: .7rem; }
        .signer { display: flex; align-items: center; justify-content: space-between; padding: .6rem .25rem; border-bottom: 1px solid #e6e6e6; }
        .signer:last-child { border-bottom: 0; }
        h1 { font-size: 1.6rem; font-weight: 700; }
    </style>
</head>
<body>
    <div class="wrap">
        <h1 class="mb-3"><i class="bi bi-pen me-2"></i>Justera protokoll</h1>
        <div id="content"><div class="text-center text-muted py-5"><div class="spinner-border"></div><div class="mt-2">Hämtar…</div></div></div>
    </div>

    <script>
        const TOKEN = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(token));
        const $ = id => document.getElementById(id);
        function token() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
        function esc(s) { return (s ?? '').toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c])); }
        function get(action) { return fetch('/umbraco/surface/BoardMeeting/' + action + '?t=' + encodeURIComponent(TOKEN)).then(r => r.json()); }
        function post(action) {
            return fetch('/umbraco/surface/BoardMeeting/' + action, {
                method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
                body: new URLSearchParams({ t: TOKEN }).toString()
            }).then(r => r.json());
        }

        function render(d) {
            const c = $('content');
            if (!d.success) {
                if (d.needsLogin) { location.href = '/login-register/?tab=login&returnUrl=' + encodeURIComponent('/styrelse/justera?t=' + TOKEN); return; }
                c.innerHTML = `<div class="alert alert-warning">${esc(d.message || 'Kunde inte hämta protokollet.')}</div>`;
                return;
            }
            const list = (d.signers || []).map(s =>
                `<div class="signer"><span>${esc(s.MemberName || s.memberName || '-')} <span class="text-muted">${esc(s.role)}</span></span>
                 <span>${s.approved ? '<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Justerat</span>' : '<span class="text-muted">Väntar</span>'}</span></div>`).join('');

            let action = '';
            if (d.locked) action = `<div class="alert alert-success mt-3"><i class="bi bi-lock-fill me-1"></i>Protokollet är justerat och låst.</div>`;
            else if (d.alreadyApproved) action = `<div class="alert alert-success mt-3"><i class="bi bi-check-circle me-1"></i>Du har justerat protokollet. Tack!</div>`;
            else if (d.canApprove) action = `<button class="btn btn-success btn-xl w-100 mt-3" onclick="approve()"><i class="bi bi-check2-circle me-2"></i>Godkänn och justera protokollet</button>`;
            else if (!d.isSigner) action = `<div class="alert alert-secondary mt-3">Du är inte vald att justera det här protokollet.</div>`;
            else action = `<div class="alert alert-secondary mt-3">Protokollet är inte öppet för justering.</div>`;

            c.innerHTML = `<div class="card shadow-sm"><div class="card-body">
                <h2 class="h4 mb-1">${esc(d.title)}</h2>
                <p class="text-muted mb-1">${esc(d.org)} · ${esc(d.date)}</p>
                <p class="mb-2"><a href="${esc(d.protokollUrl)}" target="_blank"><i class="bi bi-file-earmark-text me-1"></i>Läs protokollet</a></p>
                <hr>
                <p class="mb-1"><strong>Justeras av</strong> (${d.approvedCount}/${d.totalSigners} klara)</p>
                ${list}
                ${action}
            </div></div>`;
        }

        window.approve = function () {
            post('ApproveProtokollByToken').then(r => {
                if (!r.success) { alert(r.message || 'Kunde inte justera'); return; }
                load();
            });
        };
        function load() { get('GetJusteringByToken').then(render).catch(() => { $('content').innerHTML = '<div class="alert alert-danger">Tekniskt fel.</div>'; }); }
        load();
    </script>
    @Html.AntiForgeryToken()
</body>
</html>
