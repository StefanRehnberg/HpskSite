@*
    /om-pistol-nu/ — public landing/About page.

    Mission-first, then 7 shooter feature slabs + CTA, then 5 admin slabs + CTA
    pointing at Ankeborgs PSK (demo club). Content is hardcoded; only the page
    title and meta description are pulled from the Umbraco node.

    MANUAL UMBRACO SETUP (one time, in backoffice):
      1. Create doctype  Alias: aboutPage
         Allowed at root: yes (under Home)
         Properties (both optional):
           - pageTitle  (Textstring)  — overrides <title>
           - metaDescription (Textarea) — overrides meta description
         Set "About Page" (or whatever name fits) as the template on the doctype.
      2. Create a content node "Om pistol.nu" of type aboutPage as a child of
         the Home node. URL becomes /om-pistol-nu/.
      3. Publish it. The "Om pistol.nu" nav item in Master.cshtml will pick it
         up automatically via the aboutPage doc type alias lookup.

    IMAGE PLACEHOLDERS: SVGs in /images/about/ are placeholders. When real
    screenshots are ready, drop matching .png files in the same folder and
    update the .svg → .png references in the Image fields below (one find-
    replace covers all 12).
*@
@using Umbraco.Cms.Core.Security
@inject IMemberManager MemberManager
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = Model.Value<string>("pageTitle") ?? "Om Pistol.nu";
    ViewBag.MetaDescription = Model.Value<string>("metaDescription")
        ?? "Pistol.nu — hemmaplan för pistolskyttesporten. Av skyttar, för skyttar, klubbar och kretsar. Sponsrad av Hallands Pistolskyttekrets.";

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;

    // Same login lookup pattern Master.cshtml uses
    var loginPage = Model.Root().Children.FirstOrDefault(x => x.Name == "Login & Register")
                    ?? Model.Root().Children.FirstOrDefault(x => x.Name.ToLower().Contains("login"));
    var loginUrl = loginPage?.Url() ?? "/login-register";

    var userProfileUrl = Model.Root().Children.FirstOrDefault(x => x.ContentType.Alias == "userProfile")?.Url()
                         ?? "/user-profile-page/";

    var contactPage = Model.Root().Children.FirstOrDefault(x => x.Name == "Contact");
    var contactUrl = contactPage?.Url() ?? "/contact/";

    // Demo club (Ankeborgs PSK) — anchor target for the admin CTA
    var demoClubUrl = "/ankeland/klubbar/ankeborg/";

    // Helper struct for the feature slabs so the template stays clean.
    var shooterSlabs = new[]
    {
        new {
            Image = "/images/about/dashboard.svg",
            Title = "Min Sida — din dashboard",
            Teaser = "Följ din utveckling över tid, per disciplin och vapengrupp.",
            Detail = "Din Min Sida visar diagram över hur du presterar serie för serie, vilken klass du satsar mest tid på, dina personliga rekord och din senaste 30-dagarstrend. Det fungerar för alla discipliner — även Fältskytte, där träff- och figurprocent visas istället för seriepoäng. Allt sammanställs automatiskt från tävlings- och träningsresultat.",
            Tutorial = "tutorial-03"
        },
        new {
            Image = "/images/about/rekord.svg",
            Title = "Personliga rekord",
            Teaser = "Pistol.nu håller koll på alla dina rekord — du bara skjuter.",
            Detail = "För varje vapenklass och varje serielängd håller pistol.nu reda på ditt bästa resultat någonsin. Slå rekordet en gång och det syns på Min Sida och på din klubbsida. Alla rekord är kopplade till tävlingen eller träningstillfället där de sattes, så du alltid minns sammanhanget.",
            Tutorial = ""
        },
        new {
            Image = "/images/about/traningsmatch.svg",
            Title = "Träningsmatch — live mot kompisar och andra klubbar",
            Teaser = "Bjud in skyttar med en QR-kod och skjut tillsammans i realtid.",
            Detail = "Skapa en träningsmatch på fem sekunder, dela QR-koden med dem du tränar med, och börja räkna. Resultaten uppdateras live på allas skärmar. Tack vare vårt eget framtagna handikappsystem kan rutinerade skyttar och nybörjare tävla på lika villkor — poängen balanseras automatiskt så att alla har en chans att vinna.",
            Tutorial = "tutorial-04"
        },
        new {
            Image = "/images/about/skyttetrappan.svg",
            Title = "Skyttetrappan",
            Teaser = "Strukturerat träningsprogram från nybörjare till erfaren skytt.",
            Detail = "Skyttetrappan är ett 9-nivåers, 74-stegs träningsprogram som tar dig från första provskott till säker, kunnig pistolskytt. Tränare och skjutledare på din klubb godkänner stegen du klarat. Pistol.nu håller reda på dina framsteg så du alltid vet vad nästa moment är.",
            Tutorial = "tutorial-05"
        },
        new {
            Image = "/images/about/anmalan-swish.svg",
            Title = "Tävlingsanmälan + Swish",
            Teaser = "Anmäl dig till tävlingar i två klick. Betala med Swish.",
            Detail = "Hitta tävlingar i din krets, anmäl dig till de klasser du vill skjuta, och betala anmälningsavgiften direkt med en Swish-QR. På tävlingar med egenbokning väljer du själv din starttid redan vid anmälan; på övriga får du startlistan på mail när den publiceras. Många tävlingar tar dessutom emot drop-in-anmälan på plats. Slipp inbetalningskort och pappersanmälningar.",
            Tutorial = "tutorial-02"
        },
        new {
            Image = "/images/about/faltskytte.svg",
            Title = "Fältskytte via mobil",
            Teaser = "Patrullchefen skjuter, mobilen räknar.",
            Detail = "Vid varje station scannar patrullchefen en QR-kod, väljer skytt och knappar in träffar. Inga papperslappar, inga räknefel, inga sena resultatlistor. Patrullen och alla andra på tävlingen ser preliminära resultat i realtid när stationerna avslutas.",
            Tutorial = "tutorial-08"
        }
    };

    var adminSlabs = new[]
    {
        new {
            Image = "/images/about/admin-hemsida.svg",
            Title = "Gratis klubbhemsida",
            Teaser = "Ersätt Svenska Lag eller WordPress med något som är byggt för pistolskytteklubbar.",
            Detail = "Klubbsidan har färdiga sektioner för kalender, nyheter, dokument, klubbrekord, träningstider, styrelse, medlemslista och kontaktuppgifter. Varje evenemang får sin egen landningssida med bild, beskrivning, plats och anmälan — perfekt för städdagar, klubbmästerskap, kurser och samlingar. Anmälningsavgifter och andra inbetalningar tas emot via Swish direkt på sidan, med automatiska kvitton och bokföringsunderlag. Hantering av medlemsavgifter är planerad som nästa steg. Tävlingar, resultat och klubbrekord som klubben hanterar i pistol.nu visas direkt på sidan — ingen dubbel inmatning på en separat webbplats. Mindre att underhålla, mer tid till skytte.",
            Tutorial = ""
        },
        new {
            Image = "/images/about/admin-medlemmar.svg",
            Title = "Medlemshantering, certifikat och statistik",
            Teaser = "Hela registret i ett verktyg — godkännanden, roller, aktivitet och certifikat.",
            Detail = "Godkänn nya medlemmar med ett klick, fördela roller (klubbadmin, skjutledare, instruktör, banläggare, vapenkontrollant), spåra aktivitet, hantera SPSF-certifieringar och se klubbens utvecklingsstatistik. Inga Excel-filer som gnälls på.",
            Tutorial = "tutorial-07"
        },
        new {
            Image = "/images/about/admin-mail.svg",
            Title = "Mailutskick — nyhetsbrev och händelser",
            Teaser = "Skicka snygga mail till medlemmarna utan att hantera mailserver.",
            Detail = "Pistol.nu integrerar med Brevo — en mailtjänst som hanterar utskick, mallar och avregistreringar enligt GDPR. Brevos gratisnivå räcker långt för de flesta klubbar (~300 mail per dygn). Vid större volym väljer klubben en betalplan direkt hos Brevo. Integrationen är frivillig och inga medlemsuppgifter delas utan klubbens godkännande.",
            Tutorial = ""
        },
        new {
            Image = "/images/about/admin-tavling.svg",
            Title = "Tävlingsadministration",
            Teaser = "Från anmälan till officiellt resultat — för alla pistoldiscipliner, i ett flöde.",
            Detail = "Pistol.nu hanterar hela tävlingsflödet för Precision, Milsnabb, Duell, Magnumprecision, Nationell helmatch, Fältskytte, Magnum fält och Springskytte — inklusive lagtävlingar, stafetter, deltävlingar och tävlingsserier (t.ex. Hallandsserien). Skapa tävlingen i guiden, ta emot anmälningar (med egenbokning eller drop-in), generera startlistor och patrullistor automatiskt, driv kassan på tävlingsdagen och registrera resultat under tävlingens gång. Preliminära resultat visas live för publik och anmälda medan tävlingen pågår. Klassammanslagning vid få deltagare och standardmedaljer beräknas automatiskt enligt SPSF:s regler. När tävlingen är klar publicerar du den officiella resultatlistan med ett klick.",
            Tutorial = "tutorial-11"
        },
        new {
            Image = "/images/about/admin-konfigurator.svg",
            Title = "Fältskyttekonfigurator",
            Teaser = "Designa stationer grafiskt — utan papper och kalkylark.",
            Detail = "Designa varje station: välj mål från målkatalogen, justera figurer och tider per vapenklass och kopiera proportionellt mellan klasserna. Utskriftsklara stations- och målblad, QR-koder för mobilrapportering vid banan — allt från samma verktyg.",
            Tutorial = ""
        },
        new {
            Image = "/images/about/admin-kassa.svg",
            Title = "Kassan på tävlingsdagen",
            Teaser = "Anmälan, betalning, kvitto — på samma skärm.",
            Detail = "På tävlingsdagen sköts allt från en surfplatta vid kassan: walk-in-anmälan, Swish-betalningar, kvitton via mail, omflyttning av skyttar, incheckning. Anmälda får sin patrull- eller startlisteplats direkt. Bokföringsunderlag genereras automatiskt.",
            Tutorial = ""
        },
        new {
            Image = "/images/about/admin-krets.svg",
            Title = "Kretsfunktioner",
            Teaser = "Sammanhållande plattform för hela kretsen.",
            Detail = "Kretsens samtliga klubbar samlas under en kretssida med gemensam kalender, kretstävlingar och kretsmästare. Rekord och statistik per disciplin följs upp över alla klubbar. Kretsadministratörer kan stötta sina föreningar utan att behöva varje klubbs interna inloggning.",
            Tutorial = "tutorial-06"
        }
    };
}

<style>
    /* About page — mission band */
    .about-mission {
        background: linear-gradient(135deg, var(--bs-primary-bg-subtle) 0%, var(--bs-body-bg) 60%, var(--bs-tertiary-bg) 100%);
        border-bottom: 1px solid var(--bs-border-color);
    }
    .about-mission .promise-card {
        transition: transform 0.15s ease;
    }
    .about-mission .promise-card:hover {
        transform: translateY(-2px);
    }
    .about-section-heading {
        border-top: 1px solid var(--bs-border-color);
        padding-top: 3rem;
        margin-top: 1rem;
    }
    .about-slab {
        padding: 2.5rem 0;
    }
    .about-slab + .about-slab {
        border-top: 1px solid var(--bs-border-color-translucent);
    }
    .about-slab img.about-shot {
        width: 100%;
        height: auto;
        border-radius: 0.75rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        background-color: var(--bs-tertiary-bg);
    }
    .about-slab h3 {
        font-weight: 700;
    }
    .about-slab .read-more-btn {
        padding: 0;
        font-weight: 500;
    }
    .about-slab .read-more-btn[aria-expanded="true"] .bi-chevron-down {
        transform: rotate(180deg);
    }
    .about-slab .read-more-btn .bi-chevron-down {
        transition: transform 0.2s ease;
    }
    .about-cta-block {
        background-color: var(--bs-tertiary-bg);
        border-radius: 1rem;
        padding: 2.5rem 1.5rem;
        text-align: center;
        margin-top: 1.5rem;
    }
</style>

@* ============================================================
   1. MISSION  — sets the tone before the feature parade
============================================================ *@
<section class="about-mission py-5">
    <div class="container-fluid">
        <div class="text-center mb-4">
            <img src="/images/HPSK_Logo.png" alt="pistol.nu" style="max-height: 90px;" class="mb-3">
            <h1 class="display-4 fw-bold mb-3">Hemmaplan för pistolskyttesporten</h1>
            <p class="lead prose-wide mx-auto mb-0">
                En plattform av skyttar, för skyttar, klubbar och kretsar. Sponsrad av Hallands Pistolskyttekrets — gratis för skyttar nu och alltid.
            </p>
        </div>

        <div class="row g-3 mt-4 justify-content-center">
            <div class="col-lg-3 col-md-6">
                <div class="card promise-card h-100 text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-cash-coin text-success mb-2" style="font-size: 2.25rem;"></i>
                        <h5 class="card-title">Gratis för skyttar</h5>
                        <p class="card-text small mb-0">Inga avgifter. Ingen reklam. Aldrig.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card promise-card h-100 text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-heart-fill text-danger mb-2" style="font-size: 2.25rem;"></i>
                        <h5 class="card-title">Sponsrat av HPSK</h5>
                        <p class="card-text small mb-0">Hallands Pistolskyttekrets bekostar driften.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card promise-card h-100 text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-journal-code text-primary mb-2" style="font-size: 2.25rem;"></i>
                        <h5 class="card-title">Tillgänglig källkod</h5>
                        <p class="card-text small mb-0">Alla kan läsa, granska och föreslå förbättringar.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="card promise-card h-100 text-center border-0 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-people-fill text-warning mb-2" style="font-size: 2.25rem;"></i>
                        <h5 class="card-title">Bygger vi tillsammans</h5>
                        <p class="card-text small mb-0">Idéer, buggar och bidrag är välkomna.</p>
                    </div>
                </div>
            </div>
        </div>

        <p class="text-center text-muted small mt-4 fst-italic prose-wide mx-auto mb-0">
            Pistol.nu är idag kostnadsfritt även för klubbar. På sikt kan en liten avgift per klubb tillkomma för drift och lagring — uppskattningsvis några hundralappar per år, och aldrig mer än vad som behövs för att hålla plattformen igång.
        </p>
    </div>
</section>

@* ============================================================
   2. FÖR SKYTTAR — feature slabs + shooter CTA
============================================================ *@
<section class="container-fluid">
    <header class="about-section-heading text-center">
        <h2 class="mb-3"><i class="bi bi-bullseye me-2"></i>För skyttar</h2>
        <p class="text-muted prose-wide mx-auto">
            Allt du behöver för att följa din utveckling, träna och tävla — på en plats.
        </p>
    </header>

    @{
        var slabIndex = 0;
    }
    @foreach (var slab in shooterSlabs)
    {
        var imageRight = slabIndex % 2 == 1;
        var collapseId = $"shooterSlab{slabIndex}";
        <div class="about-slab">
            <div class="row align-items-center g-4">
                <div class="col-lg-6 @(imageRight ? "order-lg-2" : "")">
                    <img src="@slab.Image" alt="@slab.Title" class="about-shot" loading="lazy">
                </div>
                <div class="col-lg-6 @(imageRight ? "order-lg-1" : "")">
                    <div class="prose">
                        <h3 class="mb-2">@slab.Title</h3>
                        <p class="lead mb-2">@slab.Teaser</p>
                        <div class="d-flex flex-wrap gap-3 align-items-center">
                            <button class="btn btn-link read-more-btn" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                    aria-expanded="false" aria-controls="@collapseId">
                                Läs mer <i class="bi bi-chevron-down ms-1"></i>
                            </button>
                            @if (!string.IsNullOrEmpty(slab.Tutorial))
                            {
                                <a class="btn btn-link read-more-btn" href="/tutorials?tutorial=@slab.Tutorial">
                                    <i class="bi bi-play-circle me-1"></i> Se video
                                </a>
                            }
                        </div>
                        <div class="collapse mt-2" id="@collapseId">
                            <p class="mb-0">@slab.Detail</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        slabIndex++;
    }

    <div class="about-cta-block">
        @if (isLoggedIn)
        {
            <p class="lead mb-3">Du är redan med — fortsätt där du var.</p>
            <a class="btn btn-primary btn-lg" href="@userProfileUrl">
                <i class="bi bi-speedometer2 me-1"></i> Till Min Sida
            </a>
        }
        else
        {
            <p class="lead mb-3">Skapa ett gratis konto och börja följa din utveckling.</p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a class="btn btn-primary btn-lg" href="@(loginUrl)?tab=register">
                    <i class="bi bi-person-plus me-1"></i> Skapa konto
                </a>
                <a class="btn btn-outline-primary btn-lg" href="@(loginUrl)?tab=login">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Logga in
                </a>
            </div>
        }
        <div class="mt-3">
            <a href="@demoClubUrl" class="text-muted small">
                Eller kika in i Ankeborgs Pistolklubb — vår demoklubb <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

@* ============================================================
   3. FÖR KLUBBAR OCH KRETSAR — admin slabs + admin CTA
============================================================ *@
<section class="container-fluid">
    <header class="about-section-heading text-center">
        <h2 class="mb-3"><i class="bi bi-building me-2"></i>För klubbar och kretsar</h2>
        <p class="text-muted prose-wide mx-auto">
            Allt styrelsen och funktionärerna behöver — från medlemsregister till tävlingsdag, i samma verktyg.
        </p>
    </header>

    @{
        slabIndex = 0;
    }
    @foreach (var slab in adminSlabs)
    {
        var imageRight = slabIndex % 2 == 1;
        var collapseId = $"adminSlab{slabIndex}";
        <div class="about-slab">
            <div class="row align-items-center g-4">
                <div class="col-lg-6 @(imageRight ? "order-lg-2" : "")">
                    <img src="@slab.Image" alt="@slab.Title" class="about-shot" loading="lazy">
                </div>
                <div class="col-lg-6 @(imageRight ? "order-lg-1" : "")">
                    <div class="prose">
                        <h3 class="mb-2">@slab.Title</h3>
                        <p class="lead mb-2">@slab.Teaser</p>
                        <div class="d-flex flex-wrap gap-3 align-items-center">
                            <button class="btn btn-link read-more-btn" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                    aria-expanded="false" aria-controls="@collapseId">
                                Läs mer <i class="bi bi-chevron-down ms-1"></i>
                            </button>
                            @if (!string.IsNullOrEmpty(slab.Tutorial))
                            {
                                <a class="btn btn-link read-more-btn" href="/tutorials?tutorial=@slab.Tutorial">
                                    <i class="bi bi-play-circle me-1"></i> Se video
                                </a>
                            }
                        </div>
                        <div class="collapse mt-2" id="@collapseId">
                            <p class="mb-0">@slab.Detail</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        slabIndex++;
    }

    <div class="about-cta-block mb-5">
        <p class="lead mb-3">Vill du se hur en aktiv klubb använder pistol.nu?</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
            <a class="btn btn-primary btn-lg" href="@demoClubUrl">
                <i class="bi bi-building me-1"></i> Utforska Ankeborgs Pistolklubb
            </a>
            <a class="btn btn-outline-primary btn-lg" href="@contactUrl">
                <i class="bi bi-envelope me-1"></i> Kontakta oss
            </a>
        </div>
        <p class="text-muted small mt-3 mb-0">
            Ankeborg är vår demoklubb där du fritt kan klicka runt och se hur klubbsidan, tävlingar och resultat ser ut i praktiken.
        </p>
    </div>
</section>