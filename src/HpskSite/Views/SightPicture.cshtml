@using Umbraco.Cms.Core.Security
@inject IMemberManager MemberManager
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Siktbild - så ska din siktbild se ut";
    var isLoggedIn = (await MemberManager.GetCurrentMemberAsync()) != null;
}

<style>
    .sikt-stage {
        position: relative;
        width: 100%;
        max-width: 560px;
        margin: 0 auto;
        aspect-ratio: 5 / 4;
        border-radius: 12px;
        overflow: hidden;
        background: #0b0b0d;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    }

    .sikt-stage canvas {
        display: block;
        width: 100%;
        height: 100%;
    }

    .sikt-badge {
        position: absolute;
        padding: 0.2rem 0.5rem;
        font-size: 0.72rem;
        font-weight: 600;
        border-radius: 6px;
        color: #fff;
        pointer-events: none;
    }

    .sikt-badge-tl {
        top: 8px;
        left: 8px;
        background: rgba(0, 0, 0, 0.55);
    }

    .sikt-badge-tr {
        top: 8px;
        right: 8px;
        background: rgba(13, 110, 253, 0.9);
    }

    .sikt-control-label {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .sikt-control-label .val {
        font-weight: 500;
        color: var(--bs-secondary-color);
        font-variant-numeric: tabular-nums;
    }

    .sikt-ends {
        display: flex;
        justify-content: space-between;
        font-size: 0.72rem;
        color: var(--bs-secondary-color);
        margin-top: 0.1rem;
    }

    .sikt-focus-group .btn {
        font-size: 0.85rem;
    }

    .sikt-dpad {
        display: grid;
        grid-template-columns: repeat(3, 40px);
        grid-template-rows: repeat(3, 40px);
        grid-template-areas: ". up ." "left mid right" ". down .";
        gap: 5px;
        width: max-content;
    }

    .sikt-dpad .btn {
        width: 40px;
        height: 40px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sikt-sim-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sikt-sim-rowlabel {
        width: 40px;
        flex: 0 0 auto;
    }

    .sikt-sim-track {
        position: relative;
        flex: 1 1 auto;
        height: 10px;
        background: var(--bs-tertiary-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 5px;
        overflow: hidden;
    }

    .sikt-sim-window {
        position: absolute;
        top: 0;
        bottom: 0;
        background: rgba(25, 135, 84, 0.35);
    }

    .sikt-sim-play {
        position: absolute;
        top: -1px;
        bottom: -1px;
        width: 2px;
        background: var(--bs-body-color);
    }

    .sikt-sim-press {
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 0;
        background: var(--bs-warning);
    }

    .sikt-caption {
        min-height: 4.5rem;
        font-size: 0.95rem;
        line-height: 1.45;
    }

    .sikt-lesson-icon {
        flex: 0 0 auto;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--bs-primary-bg-subtle);
        color: var(--bs-primary);
    }
</style>

<div class="container-fluid py-4" id="siktApp">
    <div class="mb-4">
        <h1 class="h3 mb-1"><i class="bi bi-bullseye me-2"></i>Siktbild</h1>
        <p class="text-muted mb-0">
            Dra i reglagen och se hur siktbilden förändras &ndash; så förstår du varför skärpan ska ligga på kornet,
            och vad en diopter gör.
        </p>
        <button type="button" id="siktTutorialBtn" class="btn btn-sm btn-danger mt-2"
                onclick="if (window.TutorialHelper) { TutorialHelper.open('tutorial-11'); }">
            <i class="bi bi-play-circle-fill me-1"></i>Se videolektionen
        </button>
        @if (!isLoggedIn)
        {
            <div class="alert alert-warning py-2 px-3 small mt-2 mb-0 d-inline-flex align-items-center">
                <i class="bi bi-lock me-2"></i>Logga in som medlem för att styra simulatorn.
            </div>
        }
    </div>

    <!-- Images side by side -->
    <div class="row g-4">
        <!-- Sight picture -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-eye me-2"></i>Siktbild</h6>
                </div>
                <div class="card-body">
                    <div class="sikt-stage">
                        <canvas id="siktCanvas"></canvas>
                        <div id="siktImpairBadge" class="sikt-badge sikt-badge-tl" style="display:none;"></div>
                        <div id="siktGlassesBadge" class="sikt-badge sikt-badge-tr" style="display:none;"><i class="bi bi-eyeglasses me-1"></i>Skytteglasögon</div>
                    </div>

                    <!-- Scenario shortcuts -->
                    <div class="d-flex flex-wrap gap-2 justify-content-center mt-3">
                        <button type="button" class="btn btn-sm btn-outline-success" onclick="siktScenario('correct')">
                            <i class="bi bi-check2-circle me-1"></i>Rätt teknik
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="siktScenario('beginner')">
                            <i class="bi bi-exclamation-triangle me-1"></i>Nybörjarens misstag
                        </button>
                        <button type="button" class="btn btn-sm btn-primary" id="perfectShotBtn" onclick="siktPerfectShot()">
                            <i class="bi bi-crosshair me-1"></i>Perfekt skott
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="jerkShotBtn" onclick="siktPerfectShot('jerk')">
                            <i class="bi bi-lightning-charge me-1"></i>Ryckskott
                        </button>
                    </div>

                    <!-- Perfect-shot timing simulation -->
                    <div id="simOverlay" class="mt-3" style="display:none;">
                        <div class="fw-semibold small mb-2" id="simPhase"></div>
                        <div class="sikt-sim-row">
                            <span class="sikt-sim-rowlabel small text-muted">Tid</span>
                            <div class="sikt-sim-track">
                                <div class="sikt-sim-window" id="simWindow"></div>
                                <div class="sikt-sim-play" id="simPlay"></div>
                            </div>
                        </div>
                        <div class="sikt-sim-row mt-2">
                            <span class="sikt-sim-rowlabel small text-muted">Tryck</span>
                            <div class="sikt-sim-track">
                                <div class="sikt-sim-press" id="simPress"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Shot group -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h6 class="mb-0"><i class="bi bi-bullseye me-2"></i>Träffbild</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="siktNewSeries()">
                        <i class="bi bi-arrow-repeat me-1"></i>Ny serie
                    </button>
                </div>
                <div class="card-body">
                    <div class="text-center">
                        <canvas id="grpCanvas" style="width:100%;max-width:320px;aspect-ratio:1/1;"></canvas>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline mt-2">
                        <span class="fw-semibold" id="grpLabel"></span>
                        <span class="small text-muted" id="grpSize"></span>
                    </div>
                    <p class="small text-muted mt-2 mb-0" id="grpHint"></p>

                    <hr>

                    <!-- Live lesson caption -->
                    <div class="d-flex gap-3 align-items-start">
                        <div class="sikt-lesson-icon"><i class="bi bi-lightbulb"></i></div>
                        <div class="sikt-caption" id="siktCaption"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Controls -->
    <div class="card mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="mb-0"><i class="bi bi-sliders me-2"></i>Reglage</h6>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#siktSettingsModal" title="Avancerade inställningar">
                <i class="bi bi-gear"></i>
            </button>
        </div>
        <div class="card-body">
            <div class="row g-4 align-items-start">
                <!-- Focus -->
                <div class="col-md-6 col-xl-3">
                    <div class="sikt-control-label">
                        <span>Var ligger ögats skärpa?</span>
                    </div>
                    <div class="btn-group w-100 sikt-focus-group" role="group" id="siktFocusGroup">
                        <input type="radio" class="btn-check" name="siktFocus" id="focusRear" value="rear" autocomplete="off">
                        <label class="btn btn-outline-secondary" for="focusRear">Bakre sikte</label>

                        <input type="radio" class="btn-check" name="siktFocus" id="focusFront" value="front" autocomplete="off" checked>
                        <label class="btn btn-outline-secondary" for="focusFront">Kornet <i class="bi bi-star-fill text-warning small"></i></label>

                        <input type="radio" class="btn-check" name="siktFocus" id="focusTarget" value="target" autocomplete="off">
                        <label class="btn btn-outline-secondary" for="focusTarget">Tavlan</label>
                    </div>
                    <div class="sikt-ends">
                        <span>Närmast ögat</span>
                        <span>Längst bort</span>
                    </div>
                </div>

                <!-- Light -->
                <div class="col-md-6 col-xl-3">
                    <div class="sikt-control-label">
                        <span><i class="bi bi-brightness-high me-1"></i>Ljus</span>
                        <span class="val" id="lightVal">80&nbsp;%</span>
                    </div>
                    <input type="range" class="form-range" id="lightRange" min="0" max="100" value="80">
                    <div class="sikt-ends"><span>Skymning</span><span>Klart solsken</span></div>
                </div>

                <!-- Eye condition -->
                <div class="col-md-6 col-xl-3">
                    <div class="sikt-control-label">
                        <span><i class="bi bi-eye me-1"></i>Ögats tillstånd</span>
                    </div>
                    <div class="small text-muted mb-1">Brytningsfel</div>
                    <div class="btn-group btn-group-sm w-100" role="group" id="siktRefractiveGroup">
                        <input type="radio" class="btn-check" name="siktRefractive" id="refrNone" value="none" autocomplete="off" checked>
                        <label class="btn btn-outline-secondary" for="refrNone">Ingen</label>

                        <input type="radio" class="btn-check" name="siktRefractive" id="refrMyopia" value="myopia" autocomplete="off">
                        <label class="btn btn-outline-secondary" for="refrMyopia">Närsynt</label>

                        <input type="radio" class="btn-check" name="siktRefractive" id="refrHyperopia" value="hyperopia" autocomplete="off">
                        <label class="btn btn-outline-secondary" for="refrHyperopia">Långsynt</label>
                    </div>
                    <div class="form-check form-switch mt-2 mb-1">
                        <input class="form-check-input" type="checkbox" role="switch" id="presbyopiaToggle">
                        <label class="form-check-label small" for="presbyopiaToggle">Ålderssynthet (presbyopi)</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="glassesToggle">
                        <label class="form-check-label small" for="glassesToggle">Skytteglasögon (korrektion)</label>
                    </div>
                </div>

                <!-- Diopter -->
                <div class="col-md-6 col-xl-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div>
                            <div class="fw-semibold"><i class="bi bi-record-circle me-1"></i>Diopter (siktring)</div>
                            <div class="small text-muted">Nålhåls&shy;effekt &ndash; ökar skärpedjupet</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" id="diopterToggle" style="transform: scale(1.4);">
                        </div>
                    </div>

                    <!-- Aperture (only when diopter on) -->
                    <div class="mb-1" id="apertureWrap" style="display:none;">
                        <div class="sikt-control-label">
                            <span>Diopteröppning</span>
                            <span class="val" id="apVal">1.2&nbsp;mm</span>
                        </div>
                        <input type="range" class="form-range" id="apRange" min="0.5" max="2.5" step="0.1" value="1.2">
                        <div class="sikt-ends"><span>Litet hål (skarpt men mörkt)</span><span>Stort hål</span></div>
                    </div>
                </div>

                <!-- Sight alignment -->
                <div class="col-md-6 col-xl-3">
                    <div class="sikt-control-label">
                        <span><i class="bi bi-arrows-move me-1"></i>Kornets linjering</span>
                    </div>
                    <div class="small text-muted mb-2">Flytta kornet i siktet (0,1 mm/steg)</div>
                    <div class="sikt-dpad">
                        <button type="button" class="btn btn-sm btn-outline-secondary" style="grid-area:up;" onclick="siktNudge(0,0.1)" title="Korn upp"><i class="bi bi-arrow-up"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" style="grid-area:left;" onclick="siktNudge(-0.1,0)" title="Korn vänster"><i class="bi bi-arrow-left"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" style="grid-area:mid;" onclick="siktSightCenter()" title="Centrera kornet">0</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" style="grid-area:right;" onclick="siktNudge(0.1,0)" title="Korn höger"><i class="bi bi-arrow-right"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" style="grid-area:down;" onclick="siktNudge(0,-0.1)" title="Korn ned"><i class="bi bi-arrow-down"></i></button>
                    </div>
                    <div class="small mt-2" id="sightDevReadout"></div>
                </div>

                <!-- Hold wobble -->
                <div class="col-md-6 col-xl-3">
                    <div class="sikt-control-label">
                        <span><i class="bi bi-activity me-1"></i>Skakning (vingel)</span>
                    </div>
                    <div class="mb-3">
                        <div class="sikt-control-label">
                            <span class="small">Amplitud</span>
                            <span class="val" id="wobbleAmpVal">0&nbsp;%</span>
                        </div>
                        <input type="range" class="form-range" id="wobbleAmp" min="0" max="100" value="0">
                        <div class="sikt-ends"><span>Stadig</span><span>Skakig</span></div>
                    </div>
                    <div>
                        <div class="sikt-control-label">
                            <span class="small">Frekvens</span>
                            <span class="val" id="wobbleFreqVal">1.0&nbsp;Hz</span>
                        </div>
                        <input type="range" class="form-range" id="wobbleFreq" min="0.2" max="12" step="0.1" value="1.0">
                        <div class="sikt-ends"><span>Långsam sväng</span><span>Darrning (tremor)</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Teaching section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-mortarboard me-2"></i>Det här lär simulatorn ut</h6>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6 col-lg-3">
                            <h6 class="fw-bold"><i class="bi bi-1-circle text-primary me-1"></i>Skärpan på kornet</h6>
                            <p class="small text-muted mb-0">
                                Ögat kan bara ställa skärpa på <em>ett</em> avstånd. Lägg den på kornet:
                                då blir tavlan suddig och bakre siktet aningen mjukt &ndash; det är helt rätt.
                                Ett skarpt korn är viktigare än en skarp tavla.
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <h6 class="fw-bold"><i class="bi bi-2-circle text-primary me-1"></i>Ljuset styr pupillen</h6>
                            <p class="small text-muted mb-0">
                                I svagt ljus vidgas pupillen. En stor pupill ger litet skärpedjup &ndash;
                                allt utanför skärpeplanet blir suddigare. I starkt ljus dras pupillen ihop och
                                mer hamnar i fokus.
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <h6 class="fw-bold"><i class="bi bi-3-circle text-primary me-1"></i>Syn, glasögon &amp; ålder</h6>
                            <p class="small text-muted mb-0">
                                Brytningsfel och framför allt ålderssynthet (ögat slutar ställa om) gör kornet suddigt.
                                Skytteglasögon lägger skärpan på kornet &ndash; men låser ögat där, så tavlan blir
                                <em>ännu</em> suddigare. Då gör dioptern störst nytta.
                            </p>
                        </div>
                        <div class="col-md-6 col-lg-3">
                            <h6 class="fw-bold"><i class="bi bi-4-circle text-primary me-1"></i>Diopterns nålhål</h6>
                            <p class="small text-muted mb-0">
                                En liten öppning fungerar som ett nålhål och ger nästan oändligt skärpedjup &ndash;
                                både korn och tavla blir skarpa samtidigt. Priset: hålet släpper in mindre ljus,
                                så det kräver tillräckligt med ljus. För litet hål &rarr; mörk bild.
                            </p>
                        </div>
                    </div>

                    <div class="alert alert-info mt-4 mb-0 d-flex gap-3">
                        <i class="bi bi-arrow-down-circle fs-4 flex-shrink-0"></i>
                        <div>
                            <strong>Suddig tavla drar skotten lågt &ndash; och träffläget vandrar med ljuset.</strong>
                            En oskarp tavla upplevs som <em>större</em>. Med riktpunkt strax under tavlan (klockan 6)
                            håller du då omedvetet lite lägre och träffar lågt. Eftersom suddigheten ändras med ljuset
                            ändras även höjdträffen, så du tvingas justera siktet i höjd om och om igen. En diopter håller
                            tavlan skarp &ndash; och därmed lika stor &ndash; så höjdträffen ligger stilla oavsett ljus.
                            Det är en av de största anledningarna att skjuta med diopter.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Advanced settings modal -->
<div class="modal fade" id="siktSettingsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-gear me-2"></i>Avancerade inställningar</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Finjustera styrkan på synfelen bakom knapparna. Värdena anges i dioptrier (D).</p>

                <div class="mb-4">
                    <div class="sikt-control-label">
                        <span>Närsynthet (myopi)</span>
                        <span class="val" id="cfgMyopiaVal">1.7&nbsp;D</span>
                    </div>
                    <input type="range" class="form-range" id="cfgMyopia" min="0.5" max="4" step="0.1" value="1.7">
                    <div class="sikt-ends"><span>Mild</span><span>Kraftig (suddigare)</span></div>
                </div>

                <div class="mb-4">
                    <div class="sikt-control-label">
                        <span>Långsynthet (hyperopi)</span>
                        <span class="val" id="cfgHyperopiaVal">2.0&nbsp;D</span>
                    </div>
                    <input type="range" class="form-range" id="cfgHyperopia" min="0.5" max="4" step="0.1" value="2.0">
                    <div class="sikt-ends"><span>Mild</span><span>Kraftig (suddigare)</span></div>
                </div>

                <div class="mb-4">
                    <div class="sikt-control-label">
                        <span>Ålderssynthet (kvar ackommodation)</span>
                        <span class="val" id="cfgPresbyVal">0.25&nbsp;D</span>
                    </div>
                    <input type="range" class="form-range" id="cfgPresby" min="0" max="2" step="0.05" value="0.25">
                    <div class="sikt-ends"><span>Ingen kvar (svårast)</span><span>Mycket kvar (mild)</span></div>
                    <div class="form-text" id="cfgPresbyHint"></div>
                </div>

                <div class="mb-2">
                    <div class="sikt-control-label">
                        <span>Visirlinje (korn&ndash;sikte)</span>
                        <span class="val" id="cfgSightRadiusVal">220&nbsp;mm</span>
                    </div>
                    <input type="range" class="form-range" id="cfgSightRadius" min="100" max="300" step="5" value="220">
                    <div class="sikt-ends"><span>Kort (känsligare)</span><span>Lång</span></div>
                    <div class="form-text" id="cfgSightRadiusHint"></div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-outline-secondary" onclick="siktCfgReset()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Återställ till vanliga värden
                </button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Klar</button>
            </div>
        </div>
    </div>
</div>

<!-- Login-required modal -->
<div class="modal fade" id="siktLoginModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-lock me-2"></i>Inloggning krävs</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                Du måste vara inloggad som medlem på pistol.nu för att använda siktbildssimulatorn.
                Du kan titta på sidan utan att logga in, men reglagen är låsta.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
                <a href="/login-register" class="btn btn-primary"><i class="bi bi-box-arrow-in-right me-1"></i>Logga in</a>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    "use strict";
    var SIKT_LOGGED_IN = @(isLoggedIn ? "true" : "false");

    // ---- Optics model ----------------------------------------------------
    // Three things sit at three distances from the eye (pistol, open sights).
    // The eye focuses at one distance; blur of everything else grows with the
    // dioptric defocus and with the effective aperture (pupil, or diopter hole).
    var D_REAR = 1 / 0.60;   // rear sight ~60 cm  -> 1.667 D
    var D_FRONT = 1 / 0.77;  // front sight ~77 cm -> 1.30 D
    var K_DEF = 2.0;         // px of blur per (mm aperture * diopter defocus); tuned to look right

    // Residual softness grows with pupil/aperture (aberration): even a perfectly focused sight is
    // softer with a dilated pupil (dim light) and razor-sharp through a tiny diopter hole. This is
    // the single channel by which light reaches BOTH the visible picture and the group size.
    var RES_BASE = 0.30, RES_K = 0.045;

    var state = {
        focus: "front",
        light: 0.80,            // 0..1 — default = the zeroing light (POI dead centre here)
        refractive: "none",     // "none" | "myopia" | "hyperopia"
        presbyopia: false,      // loss of accommodation (age)
        glasses: false,         // shooting glasses prescribed for the front sight
        distanceM: 25,
        diopter: false,
        aperture: 1.2,          // mm
        sightDx: 0,             // front-sight alignment error, mm (right +)
        sightDy: 0,             // front-sight alignment error, mm (up + = "too much front sight")
        wobbleAmp: 0,           // hold wobble amplitude, 0..1
        wobbleFreq: 1.0         // hold wobble frequency, Hz
    };

    var SIGHT_VIS_PX = 20;      // canvas px per mm of (exaggerated) front-sight offset in the picture

    // Live wobble offset (px), updated by the animation loop; all zero when steady.
    var wob = { tx: 0, ty: 0, ax: 0, ay: 0 };
    var wobbleRaf = null;

    // Whole-sight-assembly shift (px), driven by the perfect-shot timing simulation; 0 otherwise.
    var sightShift = { x: 0, y: 0 };
    var ghostActive = false;   // show the brain's "burned-in" perfect image vs the drifted reality
    var ghostAlpha = 0;        // fades in 0 -> 1 so the illusion appears gradually
    var sim = { running: false, mode: "perfect", t0: null, raf: null, fired: false, scoreText: "", shots: null };
    // LIFT: settle. fire at BREAK_T. steady window LIFT..DRIFT_START. DRIFT_START: brain starts
    // substituting the perfect image while sights creep off. TREMOR_START: fine fast tremor adds in.
    var SIM = { LIFT: 2.5, PRESS_START: 2.3, BREAK_T: 5.0, DRIFT_START: 9.0, TREMOR_START: 12.0, END: 15.0 };

    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
    function dTarget() { return 1 / state.distanceM; }

    // Where the shooter is *trying* to focus (the layer they look at).
    function desiredFocusD() {
        if (state.focus === "rear") return D_REAR;
        if (state.focus === "target") return dTarget();
        return D_FRONT;
    }

    // The eye as a focus window in accommodation-demand (diopter) space:
    //   - baseOffset: built-in refractive power. Myopia = extra plus (relaxed eye focused short, so
    //     distant objects fall outside the window); hyperopia = a deficit.
    //   - amplitude:  how much the eye can *change* focus. Presbyopia collapses it toward zero.
    //   - lens:       shooting glasses, prescribed to put the FRONT SIGHT at the window's far edge.
    //                 Accommodation can pull nearer but never relax past the lens — that's the catch.
    // Tunable model constants (exposed via the cogwheel settings modal). Diopters.
    var CFG_DEFAULTS = { myopia: 1.7, hyperopia: 2.0, presbyAmp: 0.25, sightRadius: 220 };
    var cfg = { myopia: CFG_DEFAULTS.myopia, hyperopia: CFG_DEFAULTS.hyperopia, presbyAmp: CFG_DEFAULTS.presbyAmp, sightRadius: CFG_DEFAULTS.sightRadius };
    var NORMAL_AMP = 2.5;    // healthy adult accommodation (plenty for all three sight distances)

    function baseOffsetD() {
        if (state.refractive === "myopia") return cfg.myopia;     // far point near: can't see far (target worst)
        if (state.refractive === "hyperopia") return -cfg.hyperopia; // a plus deficit: near/front sight worst
        return 0;
    }
    // Accommodation amplitude. A healthy adult is ~2.5 D — NOT the textbook-young ~8 D, which would
    // let a hyperope simply accommodate the error away and show nothing. Presbyopia collapses it.
    function accommAmp() { return state.presbyopia ? cfg.presbyAmp : NORMAL_AMP; }
    function lensPower() { return state.glasses ? (D_FRONT - baseOffsetD()) : 0; }

    // Where the eye actually ends up focusing — the desired focus clamped to the reachable window.
    // Normal eye, no glasses: window is huge, so this just returns the desired focus (unchanged).
    function focusD() {
        var lo = baseOffsetD() + lensPower();
        return clamp(desiredFocusD(), lo, lo + accommAmp());
    }

    // True when the layer the shooter is looking at actually comes out SHARP in the picture.
    // Measured as the DEFOCUS blur of that layer (the part that depends on its distance from the
    // focus plane), excluding the common-mode pupil/diffraction softness that hits every layer.
    // Built from the same layerBlur term that draws the canvas, so the captions' "X är skarpt"
    // claims can never contradict the render: an uncorrected impairment (presbyopia / refractive
    // error) pushes it past the threshold, while a diopter's tiny aperture shrinks it back below —
    // correctly counting as "the diopter rescued the sharpness". ~3 px ≈ where softness shows.
    function focusAchieved() {
        return K_DEF * effectiveAperture() * Math.abs(focusD() - desiredFocusD()) < 3.0;
    }

    // Light -> pupil diameter: bright ~2 mm, dark ~7 mm
    function pupilMm() { return 7 - 5 * state.light; }
    function effectiveAperture() { return state.diopter ? state.aperture : pupilMm(); }
    function diffractionPx() { return state.diopter ? 0.6 / state.aperture : 0; } // tiny; grows as hole shrinks
    function residualPx() { var a = effectiveAperture(); return RES_BASE + RES_K * a * a; } // aberration grows with pupil

    function layerBlur(dObj) {
        return K_DEF * effectiveAperture() * Math.abs(dObj - focusD()) + residualPx() + diffractionPx();
    }

    function brightness() {
        var base = 0.35 + 0.65 * state.light;
        if (state.diopter) {
            var throughput = Math.pow(state.aperture / 1.5, 2); // light ~ hole area
            base = base * throughput * 1.3;
        }
        return clamp(base, 0, 1);
    }

    // Group size = how repeatably you can hold the sight ALIGNMENT — driven ONLY by how blurred the
    // sights are (front dominates; you line the blade up in the notch). The target's own sharpness
    // doesn't matter (a blurry mark still groups tight). Everything light/diopter-related is already
    // baked into the blur: dim light dilates the pupil -> softer sights (the same softness you SEE)
    // -> bigger group; a diopter's tiny aperture -> sharp sights -> tight group. No extra multipliers.
    function groupSigmaFrac() {
        var align = layerBlur(D_FRONT) + 0.7 * layerBlur(D_REAR);
        // Visirlinje (sight radius) is the lever arm: a longer one magnifies any alignment
        // imperfection at the eye, so the same blur becomes a smaller pointing error -> tighter
        // group (and a short radius is twitchy). 220 mm = neutral reference. Same 1/radius factor
        // that scales the d-pad alignment-error POI shift, so both say "longer = more forgiving".
        align *= 220 / cfg.sightRadius;
        var sigma = 0.028 + 0.030 * align;
        // The one thing NOT captured by blur: genuine darkness — too dark to make out the black
        // sights at all, so alignment falls apart (open sights and a too-dark diopter alike).
        var b = brightness();
        if (b < 0.40) sigma *= 1 + (0.40 - b) * 3.0;
        // Ceiling is high so stacked errors keep adding up (unreadable sights -> shots all over /
        // off the paper), instead of saturating once the picture gets bad.
        return clamp(sigma * (state.distanceM / 25), 0.03, 2.5);
    }

    // Pure defocus blur of the TARGET (no eye/diffraction baseline). This is what makes a fuzzy
    // bull's edge bleed outward so it looks larger.
    var REFERENCE_LIGHT = 0.80;   // sights are zeroed at typical (~80%) light
    function pupilMmAt(light) { return 7 - 5 * light; }
    function effectiveApertureAt(light) { return state.diopter ? state.aperture : pupilMmAt(light); }
    function targetDefocusPx() {
        return K_DEF * effectiveAperture() * Math.abs(dTarget() - focusD());
    }

    // Elevation error (down = +, fraction of target radius) RELATIVE to the zeroing light. A blurred
    // bull looks bigger so with a 6-o'clock hold you aim lower — but you zero your sights at typical
    // (~80%) light, so it's dead centre there. Brighter -> less blur -> POI creeps UP (negative);
    // darker -> POI drops. With a diopter the aperture is fixed regardless of light, so this stays
    // ~0 (stable elevation, no re-zeroing). Focusing ON the target removes it (sharp bull).
    function poiLowFrac() {
        var ref = K_DEF * effectiveApertureAt(REFERENCE_LIGHT) * Math.abs(dTarget() - focusD());
        return clamp(0.024 * (targetDefocusPx() - ref), -0.55, 0.55);
    }

    // Point-of-impact shift from a front-sight ALIGNMENT error (geometry, not blur):
    //   POI shift = deviation × (target distance / sight radius). The bullet "follows the front
    //   sight" — front sight held right -> hits right; too much front sight (up) -> hits high.
    function poiAlignCm() {
        var cmPerMm = 2500 / cfg.sightRadius;   // = (25000 mm / radius) / 10
        return { x: state.sightDx * cmPerMm, y: state.sightDy * cmPerMm }; // y: up + = high
    }


    // ---- Canvas rendering ------------------------------------------------
    var W = 700, H = 560;            // canvas logical size (cropped on top — less empty sky)
    var CX = 350;
    var DIO_CY = 283, DIO_R = 275;   // diopter (peep) circular field, fitted to the shorter canvas
    // Shared sight geometry (logical px). Front sight top + rear posts top are level.
    var SIGHT_TOP = 343;
    var FRONT_W = 50;                          // front-sight blade width
    var NOTCH_HALF = 56;                       // half the rear-sight notch opening (was 37; +50% wider)
    var LIGHT_BAR = NOTCH_HALF - FRONT_W / 2;  // white gap on each side of the front sight
    var cvs = document.getElementById("siktCanvas");
    var ctx = cvs.getContext("2d");
    var dpr = Math.max(1, window.devicePixelRatio || 1);

    function setupCanvas() {
        dpr = Math.max(1, window.devicePixelRatio || 1);
        cvs.width = W * dpr;
        cvs.height = H * dpr;
    }

    function blurStr(px) { return "blur(" + px.toFixed(2) + "px)"; }

    function drawTarget(c, cx, cy, R) {
        c.fillStyle = "#4e5c7e";
        c.beginPath(); c.arc(cx, cy, R, 0, Math.PI * 2); c.fill();

        // Rings from outer to inner: 7 sits at the disc rim (nothing scored outside it),
        // then 8, 9, then the two innermost rings are both the 10.
        c.strokeStyle = "rgba(233,237,246,0.92)";
        c.lineWidth = Math.max(1, R * 0.012);
        var rings = [1.0, 0.77, 0.55, 0.33, 0.17];
        for (var i = 0; i < rings.length; i++) {
            c.beginPath(); c.arc(cx, cy, R * rings[i], 0, Math.PI * 2); c.stroke();
        }

        // Numbers centred in their scoring bands (9 just outside the 10, then 8, then 7 near the rim).
        c.fillStyle = "#eef1f8";
        c.textAlign = "center";
        c.textBaseline = "middle";
        c.font = "bold " + (R * 0.13).toFixed(1) + "px system-ui, sans-serif";
        var nums = [{ r: 0.885, n: "7" }, { r: 0.66, n: "8" }, { r: 0.44, n: "9" }];
        for (var j = 0; j < nums.length; j++) {
            var o = nums[j];
            c.fillText(o.n, cx, cy - R * o.r);
            c.fillText(o.n, cx, cy + R * o.r);
            c.fillText(o.n, cx - R * o.r, cy);
            c.fillText(o.n, cx + R * o.r, cy);
        }
    }

    var GHOST_MAX = 0.40;   // peak opacity of the brain's "burned-in" perfect image
    function ghostFill() { return "rgba(13,110,253," + (GHOST_MAX * ghostAlpha).toFixed(3) + ")"; }

    function drawFront(c, cx, ox, oy, ghost) {
        var w = FRONT_W, x = cx - w / 2 + ox, top = SIGHT_TOP + oy, bottom = H - 6;
        if (ghost) {
            c.fillStyle = ghostFill();
            c.fillRect(x, top, w, bottom - top);
            return;
        }
        var g = c.createLinearGradient(x, 0, x + w, 0);
        g.addColorStop(0, "#717171");
        g.addColorStop(0.5, "#535353");
        g.addColorStop(1, "#404040");
        c.fillStyle = g;
        c.fillRect(x, top, w, bottom - top);
        c.fillStyle = "rgba(255,255,255,0.10)";
        c.fillRect(x, top, w, 4);
    }

    function drawRear(c, cx, sgx, sgy, ghost) {
        var cxs = cx + sgx;
        var notchHalf = NOTCH_HALF, top = SIGHT_TOP + sgy, postBottom = SIGHT_TOP + 146 + sgy, baseTop = SIGHT_TOP + 130 + sgy, baseBottom = H - 6 + sgy;
        var left = 96 + sgx, right = 604 + sgx;
        c.fillStyle = ghost ? ghostFill() : "#141414";
        c.fillRect(left, top, (cxs - notchHalf) - left, postBottom - top);            // left post
        c.fillRect(cxs + notchHalf, top, right - (cxs + notchHalf), postBottom - top); // right post
        c.fillRect(left, baseTop, right - left, baseBottom - baseTop);                // base bar
        if (!ghost) {
            c.fillStyle = "rgba(255,255,255,0.06)";
            c.fillRect(left, top, (cxs - notchHalf) - left, 3);
            c.fillRect(cxs + notchHalf, top, right - (cxs + notchHalf), 3);
        }
    }

    function draw() {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, W, H);

        var bright = brightness();
        var tB = layerBlur(dTarget());
        var fB = layerBlur(D_FRONT);
        var rB = layerBlur(D_REAR);

        // Target size scales with distance; bull held above the front sight (6-o'clock) so the
        // white gap under the bull equals the light bar on each side of the front sight ("lika ljusgap").
        var R = clamp(150 * Math.sqrt(25 / state.distanceM), 70, 200);
        var cy = (SIGHT_TOP - LIGHT_BAR) - R;
        // Hold wobble: the aim wanders, so the bull drifts relative to the (eye-fixed) sights.
        var tcx = CX + wob.tx;
        var tcy = cy + wob.ty;

        var cR = DIO_R;
        if (state.diopter) {
            ctx.fillStyle = "#000";
            ctx.fillRect(0, 0, W, H);
            ctx.save();
            ctx.beginPath(); ctx.arc(CX, DIO_CY, cR, 0, Math.PI * 2); ctx.clip();
        }

        // sky / backstop
        ctx.fillStyle = "#eef2f8";
        ctx.fillRect(0, 0, W, H);

        // layers, far -> near (correct occlusion); each blurred by its own defocus
        ctx.filter = blurStr(tB); drawTarget(ctx, tcx, tcy, R);

        // Ghost = the perfectly-aligned image the brain "burns in" and keeps showing (faint),
        // drawn before reality so the solid (actual) sights sit on top of it.
        if (ghostActive) {
            ctx.filter = "none";
            drawFront(ctx, CX, 0, 0, true);
            drawRear(ctx, CX, 0, 0, true);
        }

        var fox = state.sightDx * SIGHT_VIS_PX + wob.ax + sightShift.x;  // actual front-sight offset
        var foy = -state.sightDy * SIGHT_VIS_PX + wob.ay + sightShift.y;
        ctx.filter = blurStr(fB); drawFront(ctx, CX, fox, foy, false);
        ctx.filter = blurStr(rB); drawRear(ctx, CX, sightShift.x, sightShift.y, false);
        ctx.filter = "none";

        // When the bull is blurred its dark edge bleeds outward and it looks bigger than it is.
        // Show its true size as a dashed ring so the "ser större ut"-effect is visible.
        if (targetDefocusPx() > 4) {
            ctx.save();
            ctx.setLineDash([9, 9]);
            ctx.lineWidth = 2;
            ctx.strokeStyle = "rgba(255,255,255,0.85)";
            ctx.beginPath(); ctx.arc(tcx, tcy, R, 0, Math.PI * 2); ctx.stroke();
            ctx.setLineDash([]);
            ctx.restore();
        }

        if (bright < 1) {
            ctx.fillStyle = "rgba(0,0,0," + (1 - bright).toFixed(3) + ")";
            ctx.fillRect(0, 0, W, H);
        }

        if (state.diopter) {
            var vg = ctx.createRadialGradient(CX, DIO_CY, cR * 0.80, CX, DIO_CY, cR);
            vg.addColorStop(0, "rgba(0,0,0,0)");
            vg.addColorStop(1, "rgba(0,0,0,0.38)");
            ctx.fillStyle = vg;
            ctx.beginPath(); ctx.arc(CX, DIO_CY, cR, 0, Math.PI * 2); ctx.fill();
            ctx.restore();
        }
    }

    // ---- Shot group panel ------------------------------------------------
    var grpCvs = document.getElementById("grpCanvas");
    var grpCtx = grpCvs.getContext("2d");
    var GSIZE = 300, GR = 100, GCX = 150, GCY = 150;  // GR < canvas half so misses outside the rings show
    var TARGET_RADIUS_CM = 15;        // ring-7 radius on paper (~30 cm across); for the cm read-out
    var WOBBLE_PEAK_CM = 22;          // peak aim-wander (cm) at full amplitude — same scale drives view + group
    var shotSamples = [];             // per shot: {x,y} clarity draws + {px,py} random wobble phases

    function setupGroupCanvas() {
        grpCvs.width = GSIZE * dpr;
        grpCvs.height = GSIZE * dpr;
    }

    function gauss() {
        var u = 0, v = 0;
        while (u === 0) u = Math.random();
        while (v === 0) v = Math.random();
        return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    function generateSamples() {
        shotSamples = [];
        for (var i = 0; i < 5; i++) {
            shotSamples.push({
                x: gauss(), y: gauss(),                       // clarity dispersion (gaussian)
                px: Math.random() * 6.2832, py: Math.random() * 6.2832  // wobble phase at trigger break
            });
        }
    }

    // Each shot's offset from the bull centre (cm): the wobble position at a random trigger-break
    // moment + the clarity/blur dispersion + the systematic alignment and elevation shifts.
    function computeShots() {
        var claritySigmaCm = groupSigmaFrac() * TARGET_RADIUS_CM;
        var peakCm = state.wobbleAmp * WOBBLE_PEAK_CM;
        var align = poiAlignCm();                  // {x: right+, y: up+}
        var lowCm = poiLowFrac() * TARGET_RADIUS_CM;
        var out = [];
        for (var i = 0; i < shotSamples.length; i++) {
            var s = shotSamples[i];
            var wx = peakCm * Math.sin(s.px);
            var wy = peakCm * 0.8 * Math.sin(s.py);
            out.push({
                x: align.x + wx + claritySigmaCm * s.x,            // right +
                y: (-align.y) + lowCm + wy + claritySigmaCm * s.y  // down +
            });
        }
        return out;
    }

    function drawGroup() {
        grpCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        grpCtx.clearRect(0, 0, GSIZE, GSIZE);
        grpCtx.fillStyle = "#eef2f8";
        grpCtx.fillRect(0, 0, GSIZE, GSIZE);
        drawTarget(grpCtx, GCX, GCY, GR);   // sharp — this is the paper seen up close

        // Intended point of impact (centre of the bull) — so a low group is obvious.
        var cmk = GR * 0.07;
        grpCtx.strokeStyle = "rgba(220,53,69,0.9)";
        grpCtx.lineWidth = 2;
        grpCtx.beginPath();
        grpCtx.moveTo(GCX - cmk, GCY); grpCtx.lineTo(GCX + cmk, GCY);
        grpCtx.moveTo(GCX, GCY - cmk); grpCtx.lineTo(GCX, GCY + cmk);
        grpCtx.stroke();

        var pxPerCm = GR / TARGET_RADIUS_CM;
        var pos = computeShots();
        var hr = GR * 0.05;
        for (var i = 0; i < pos.length; i++) {
            var sx = GCX + pos[i].x * pxPerCm;
            var sy = GCY + pos[i].y * pxPerCm;
            grpCtx.beginPath();
            grpCtx.arc(sx, sy, hr, 0, Math.PI * 2);
            grpCtx.fillStyle = "#101010";
            grpCtx.fill();
            grpCtx.lineWidth = 1;
            grpCtx.strokeStyle = "rgba(255,255,255,0.55)";
            grpCtx.stroke();
        }
    }

    function updateGroupLabel() {
        var pos = computeShots();
        var spreadCm = 0, misses = 0;
        for (var a = 0; a < pos.length; a++) {
            if (Math.sqrt(pos[a].x * pos[a].x + pos[a].y * pos[a].y) > TARGET_RADIUS_CM) misses++;
            for (var b = a + 1; b < pos.length; b++) {
                var dx = pos[a].x - pos[b].x, dy = pos[a].y - pos[b].y;
                var d = Math.sqrt(dx * dx + dy * dy);
                if (d > spreadCm) spreadCm = d;
            }
        }
        var label, cls;
        if (spreadCm < 7) { label = "Tät träffbild"; cls = "text-success"; }
        else if (spreadCm < 13) { label = "Bra träffbild"; cls = "text-success"; }
        else if (spreadCm < 22) { label = "Spridd träffbild"; cls = "text-warning"; }
        else { label = "Mycket spridd"; cls = "text-danger"; }

        var lbl = document.getElementById("grpLabel");
        lbl.textContent = label;
        lbl.className = "fw-semibold " + cls;

        var elevCm = poiLowFrac() * TARGET_RADIUS_CM;
        var sizeHtml = "Träffbildens storlek ca " + Math.round(spreadCm) + "&nbsp;cm";
        if (elevCm >= 1) sizeHtml += " &middot; <span class='text-danger'>ca " + Math.round(elevCm) + "&nbsp;cm lågt</span>";
        else if (elevCm <= -1) sizeHtml += " &middot; <span class='text-danger'>ca " + Math.round(-elevCm) + "&nbsp;cm högt</span>";
        if (misses > 0) sizeHtml += " &middot; <span class='text-danger fw-semibold'>" + misses + " av " + pos.length + " utanför ringarna</span>";
        document.getElementById("grpSize").innerHTML = sizeHtml;

        var hint;
        if (state.focus === "front") {
            hint = focusAchieved()
                ? "Skärpan på kornet håller skotten samlade &ndash; även när tavlan är suddig."
                : "Kornet blir suddigt här, så du kan inte rikta likadant varje skott &ndash; träffbilden öppnar upp trots att du siktar mot kornet.";
        } else if (state.focus === "target") {
            hint = focusAchieved()
                ? "Suddiga riktmedel gör att du inte kan rikta likadant varje skott, så träffbilden öppnar upp &ndash; trots att tavlan ser skarp ut."
                : "Varken riktmedel eller tavla är skarpa här, så du kan inte rikta likadant varje skott och träffbilden öppnar upp.";
        } else {
            hint = "Med skärpan på bakre siktet blir kornet otydligt och träffbilden öppnar upp.";
        }
        if (state.presbyopia && !state.glasses && state.refractive === "none" && !focusAchieved()) {
            hint += " Låt dig inte luras av den skarpa tavlan &ndash; träffbilden styrs av <strong>kornets</strong> skärpa, inte tavlans. Skytteglasögon och diopter flyttar skärpan tillbaka till kornet.";
        }
        if (state.distanceM > 30) hint += " På längre håll förstoras samma lilla vingel.";
        if (Math.abs(elevCm) >= 2 && !state.diopter) {
            hint += " Du är inskjuten vid normalt ljus (~80&nbsp;%). När ljuset ändras ändras tavlans suddighet och därmed höjdträffen &ndash; ljusare drar upp, mörkare drar ner. En diopter håller höjden stilla.";
        }
        if (state.diopter) {
            hint += brightness() > 0.45
                ? " Dioptern ger en skarp, stabil siktbild som drar ihop träffbilden och håller höjdträffen still oavsett ljus."
                : " Men hålet är för litet för ljuset &ndash; du ser inte sikten och träffbilden öppnar upp.";
        }
        if (state.sightDx !== 0 || state.sightDy !== 0) {
            hint += " Lägg märke till hur ett pyttelitet linjeringsfel i kornet (bråkdels mm) flyttar hela träffbilden flera cm &ndash; därför är exakt likadan linjering varje skott helt avgörande.";
        }
        if (state.wobbleAmp > 0) {
            hint += " Skakningen gör att skottet går någonstans i vingelområdet &ndash; ju större vingel, desto öppnare träffbild. Lugn andning, stödhand och ett jämnt, kramande avtryck håller ihop den.";
        }
        document.getElementById("grpHint").innerHTML = hint;
    }

    // ---- Live caption ----------------------------------------------------
    function caption() {
        var parts = [];
        var reached = focusAchieved();
        if (state.focus === "front") {
            if (reached) {
                parts.push("<strong class='text-success'>Skärpan ligger på kornet &ndash; helt rätt.</strong> " +
                    "Kornet är skarpt, tavlan suddig och bakre siktet aningen mjukt. Så ska en bra siktbild se ut.");
            } else {
                parts.push("<strong class='text-success'>Skärpan ska ligga på kornet &ndash; helt rätt tanke.</strong> " +
                    "Men ögat når inte dit (se nedan), så kornet blir suddigt &ndash; och det är just kornet du riktar med.");
            }
        } else if (state.focus === "target") {
            if (reached) {
                parts.push("<strong class='text-danger'>Skärpan ligger på tavlan &ndash; nybörjarens misstag.</strong> " +
                    "Tavlan blir skarp, men både korn och bakre sikte blir suddiga och du tappar precisionen i riktmedlen.");
            } else {
                parts.push("<strong class='text-danger'>Du försöker lägga skärpan på tavlan &ndash; nybörjarens misstag.</strong> " +
                    "Här når ögat inte ens ut till tavlan, så hela bilden blir suddig.");
            }
        } else {
            if (reached) {
                parts.push("<strong>Skärpan ligger på bakre siktet.</strong> " +
                    "Bakre siktet blir skarpt, men kornet &ndash; det du faktiskt riktar med &ndash; och tavlan blir suddiga.");
            } else {
                parts.push("<strong>Du försöker lägga skärpan på bakre siktet.</strong> " +
                    "Men ögat når inte dit, så även bakre siktet blir suddigt.");
            }
        }

        if (!state.diopter && state.light < 0.30) {
            parts.push("I svagt ljus vidgas pupillen, skärpedjupet krymper och allt blir suddigare.");
        }
        if (state.glasses) {
            parts.push("<strong>Med skytteglasögon</strong> ställs skärpan på kornet &ndash; men ögat låses på det avståndet, så tavlan blir ännu suddigare. Därför blir en <strong>diopter nästan ett måste</strong> för den som behöver glasögon.");
        } else if (state.presbyopia && state.refractive === "none" && !reached) {
            parts.push("<strong>Ålderssynthet:</strong> ögat kan inte längre ställa om till det nära kornet, så blicken vilar längre bort &ndash; därför ser tavlan skarp ut medan <strong>kornet blir suddigt</strong>. " +
                "Lurigt nog hjälper dig inte den skarpa tavlan: det är kornet du riktar med, så träffbilden öppnar upp ändå. Det är just därför ålderssynta skyttar behöver <strong>skytteglasögon</strong> (skärpan tillbaka på kornet) och ofta <strong>diopter</strong>.");
        } else if (state.refractive === "myopia") {
            parts.push("<strong>Närsynthet:</strong> allt bortom ögats närgräns blir suddigt, särskilt tavlan. Korrektionsglas behövs." +
                (state.presbyopia ? " Ålderssyntheten gör knappt skillnad för en närsynt i skyttesituationen &ndash; det är tavlan som är suddig oavsett." : ""));
        } else if (state.refractive === "hyperopia") {
            parts.push("<strong>Långsynthet:</strong> ögat måste anstränga sig extra för att ställa skärpa, särskilt på kornet på nära håll." +
                (state.presbyopia ? " Med ålderssynthet dessutom orkar ögat inte alls &ndash; både korn och tavla blir suddiga och allt behöver korrektion." : ""));
        }

        if (state.diopter) {
            if (brightness() < 0.28) {
                parts.push("Diopterns hål är nu <strong>för litet för ljuset</strong> &ndash; bilden blir mörk. Öppna hålet eller höj ljuset.");
            } else {
                parts.push("Diopterns lilla hål ger <strong>nästan oändligt skärpedjup</strong>: korn och tavla blir skarpa samtidigt " +
                    "&ndash; så länge hålet inte är för litet och ljuset räcker.");
            }
        }
        if (targetDefocusPx() > 4) {
            parts.push("Den <strong>streckade ringen</strong> visar tavlans verkliga storlek &ndash; suddig upplevs den större, vilket lurar dig att sikta lägre och träffa lågt.");
        }
        document.getElementById("siktCaption").innerHTML = parts.join(" ");
    }

    // ---- UI wiring -------------------------------------------------------
    function updateBadges() {
        var impair = document.getElementById("siktImpairBadge");
        var labels = [];
        if (state.refractive === "myopia") labels.push("Närsynt");
        if (state.refractive === "hyperopia") labels.push("Långsynt");
        if (state.presbyopia) labels.push("Ålderssynt");
        if (labels.length) {
            impair.textContent = labels.join(" + ");
            impair.style.display = "";
        } else {
            impair.style.display = "none";
        }
        document.getElementById("siktGlassesBadge").style.display = state.glasses ? "" : "none";
    }

    function render() {
        draw();
        caption();
        drawGroup();
        updateGroupLabel();
    }

    // Wobble animation: drives only the sight picture (the group is a static result, not a live frame).
    function wobbleLoop(now) {
        if (state.wobbleAmp <= 0) { wobbleRaf = null; wob.tx = wob.ty = wob.ax = wob.ay = 0; draw(); return; }
        var t = now / 1000;
        // Sight-picture px per cm: target R=150 px = 15 cm. Same WOBBLE_PEAK_CM that drives the group,
        // so the visible wander and the shot scatter match.
        var peak = state.wobbleAmp * WOBBLE_PEAK_CM * (150 / TARGET_RADIUS_CM);
        var ww = 2 * Math.PI * state.wobbleFreq;
        wob.tx = peak * Math.sin(ww * t);            // two incommensurate freqs -> organic wander
        wob.ty = peak * 0.8 * Math.sin(ww * 0.78 * t + 1.3);
        var ap = peak * 0.08;                        // small, faster tremor in the alignment
        wob.ax = ap * Math.sin(ww * 2.3 * t + 0.5);
        wob.ay = ap * Math.sin(ww * 2.9 * t + 2.1);
        draw();
        wobbleRaf = requestAnimationFrame(wobbleLoop);
    }
    function syncWobbleAnim() {
        if (sim.running) return;   // the perfect-shot sim owns the picture while it runs
        if (state.wobbleAmp > 0) {
            if (wobbleRaf === null) wobbleRaf = requestAnimationFrame(wobbleLoop);
        } else {
            if (wobbleRaf !== null) { cancelAnimationFrame(wobbleRaf); wobbleRaf = null; }
            wob.tx = wob.ty = wob.ax = wob.ay = 0;
        }
    }

    // ---- Perfect-shot timing simulation ----------------------------------
    // Animates the natural arc: the gun rises into the 6-o'clock hold, settles, holds steady for a
    // few seconds, then the muscles tire and the wobble grows. Trigger pressure builds smoothly and
    // the shot breaks in the calm window — teaching "squeeze, don't jerk; break within ~10 s".
    function simScore(distCm) {
        if (distCm < 1.5) return "X";
        if (distCm < 5) return "10";
        if (distCm < 8.3) return "9";
        if (distCm < 11.6) return "8";
        if (distCm < 15) return "7";
        return "bom";
    }

    // Jerk ends shortly after the break (it's about the snatch, not riding the hold for 15 s).
    function simDuration() { return sim.mode === "jerk" ? SIM.BREAK_T + 2.0 : SIM.END; }

    function drawSimGroup(shots) {
        grpCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        grpCtx.clearRect(0, 0, GSIZE, GSIZE);
        grpCtx.fillStyle = "#eef2f8";
        grpCtx.fillRect(0, 0, GSIZE, GSIZE);
        drawTarget(grpCtx, GCX, GCY, GR);

        var cmk = GR * 0.07;
        grpCtx.strokeStyle = "rgba(220,53,69,0.9)";
        grpCtx.lineWidth = 2;
        grpCtx.beginPath();
        grpCtx.moveTo(GCX - cmk, GCY); grpCtx.lineTo(GCX + cmk, GCY);
        grpCtx.moveTo(GCX, GCY - cmk); grpCtx.lineTo(GCX, GCY + cmk);
        grpCtx.stroke();

        var lbl = document.getElementById("grpLabel");
        var size = document.getElementById("grpSize");
        var hint = document.getElementById("grpHint");

        if (shots && shots.length) {
            var pxPerCm = GR / TARGET_RADIUS_CM;
            var color = sim.mode === "jerk" ? "#c1121f" : "#e0a800";
            for (var i = 0; i < shots.length; i++) {
                grpCtx.beginPath();
                grpCtx.arc(GCX + shots[i].x * pxPerCm, GCY + shots[i].y * pxPerCm, GR * 0.06, 0, Math.PI * 2);
                grpCtx.fillStyle = color; grpCtx.fill();
                grpCtx.lineWidth = 2; grpCtx.strokeStyle = "#fff"; grpCtx.stroke();
            }
            if (sim.mode === "jerk") {
                lbl.textContent = "Ryckskott – utflygare";
                lbl.className = "fw-semibold text-danger";
                size.innerHTML = "5 skott lågt åt avtryckarsidan";
                hint.innerHTML = "Du slet i avtryckaren &ndash; riktmedlen kastades ur läge i samma stund skottet gick (lågt åt avtryckarsidan, vänster för en högerhänt). Utflygare trots att siktbilden såg perfekt ut. Krama avtryckaren mjukt tills det smäller.";
            } else {
                lbl.textContent = "Perfekt skott – " + sim.scoreText;
                lbl.className = "fw-semibold text-success";
                size.innerHTML = "Skottet smällde av sig självt";
                hint.innerHTML = "Mjukt, jämnt ökande tryck tills skottet överraskar dig &ndash; aldrig ett ryck. Smäller det inte i tid: ta ner och börja om.";
            }
        } else {
            lbl.textContent = "Siktar…";
            lbl.className = "fw-semibold text-muted";
            size.innerHTML = "Kramar avtryckaren mjukt…";
            hint.innerHTML = "";
        }
    }

    function fireSimShot() {
        var PXCM = 150 / TARGET_RADIUS_CM;
        if (sim.mode === "jerk") {
            // A snatched trigger throws the shot low + toward the trigger finger (right-handed = low-left),
            // and it's inconsistent — five scattered flyers down-left of the aim cross.
            var flyers = [];
            for (var i = 0; i < 5; i++) {
                flyers.push({ x: -8 + gauss() * 3.5, y: 10 + gauss() * 3.5 });  // cm: left + down, scattered
            }
            sim.shots = flyers;
            document.getElementById("simPress").style.background = "var(--bs-danger)";
            drawSimGroup(flyers);
        } else {
            var shot = { x: sightShift.x / PXCM, y: sightShift.y / PXCM };  // aim error at break (cm)
            sim.shots = [shot];
            sim.scoreText = simScore(Math.sqrt(shot.x * shot.x + shot.y * shot.y));
            document.getElementById("simPress").style.background = "var(--bs-success)";
            drawSimGroup([shot]);
        }
    }

    function updateSimUi(t, pressure) {
        document.getElementById("simPlay").style.left = Math.min(100, t / simDuration() * 100) + "%";
        document.getElementById("simPress").style.width = (pressure * 100) + "%";
        var p = document.getElementById("simPhase");
        if (!sim.fired) {
            if (t < SIM.LIFT) p.textContent = "Lyfter i läge – stora rörelser som snabbt lägger sig.";
            else if (t < SIM.BREAK_T - 1.3) p.textContent = "Stilla, sikta klockan 6. Öka trycket mjukt och jämnt.";
            else if (sim.mode === "jerk") p.textContent = "Sikten ser rätt ut … och du rycker till i avtryckaren!";
            else p.textContent = "Låt skottet överraska dig – ryck inte av!";
        } else if (sim.mode === "jerk") {
            p.innerHTML = "<strong>Ryckskott!</strong> Du slet i avtryckaren – riktmedlen kastades lågt åt avtryckarsidan. Fem utflygare lågt vänster, trots perfekt siktbild.";
        } else if (t < SIM.DRIFT_START) {
            p.innerHTML = "Skottet smällde – perfekt <strong>" + sim.scoreText + "</strong>!";
        } else if (t < SIM.TREMOR_START) {
            p.innerHTML = "Efter ~10 s <strong>lurar hjärnan dig</strong>: den visar kvar den inövade perfekta bilden (<span style='color:#0d6efd'>blå spökbild</span>) medan kornet i själva verket glidit (heldraget). Du skulle svära på att du låg rätt.";
        } else {
            p.innerHTML = "Nu tillkommer en fin, snabb darrning – men hjärnan visar fortfarande den perfekta bilden. Ett &quot;perfekt&quot; skott här sitter där det <strong>heldragna</strong> kornet pekar. <strong>Ta ner och börja om!</strong>";
        }
    }

    function simLoop(now) {
        if (sim.t0 === null) sim.t0 = now;
        var t = (now - sim.t0) / 1000;
        var PXCM = 150 / TARGET_RADIUS_CM;
        var TAU = 2 * Math.PI;
        var ax = 0, ay = 0;     // actual aim offset (cm); brain "sees" 0
        var fx = 0, fy = 0;     // extra front-sight alignment jitter (px)
        ghostActive = false;

        if (t < SIM.LIFT) {                                  // rise into the hold + settle
            var k = t / SIM.LIFT, ease = 1 - (1 - k) * (1 - k);
            var ampCm = 9 * (1 - ease) + 1.2 * ease, f = 0.6;
            ax = ampCm * Math.sin(TAU * f * t);
            ay = 30 * (1 - k) * (1 - k) + ampCm * 0.7 * Math.sin(TAU * f * 0.78 * t + 1.0);
            fx = ampCm * PXCM * 0.10 * Math.sin(TAU * f * 2.3 * t);
            fy = ampCm * PXCM * 0.10 * Math.sin(TAU * f * 2.9 * t + 1.5);
        } else {
            var b = 1.2;                                     // baseline steady micro-wander
            ax = b * Math.sin(TAU * 1.0 * t);
            ay = b * 0.7 * Math.sin(TAU * 0.78 * t + 1.0);
            fx = b * PXCM * 0.08 * Math.sin(TAU * 2.3 * t);
            fy = b * PXCM * 0.08 * Math.sin(TAU * 2.9 * t + 1.5);

            if (t >= SIM.DRIFT_START) {                      // brain shows frozen-perfect; sights creep off
                ghostActive = true;
                ghostAlpha = clamp((t - SIM.DRIFT_START) / 1.5, 0, 1);   // fade in over 1.5 s
                var dp = (t - SIM.DRIFT_START) / (SIM.END - SIM.DRIFT_START);
                var driftCm = 6 * dp * dp;                   // ease-in to ~6 cm of unseen drift
                ax += driftCm * Math.sin(TAU * 0.30 * t + 0.7);
                ay += driftCm * 0.8 * Math.sin(TAU * 0.23 * t + 2.1);
            }
            if (t >= SIM.TREMOR_START) {                     // fine tremor: high freq, low amplitude
                var rmp = Math.min(1, (t - SIM.TREMOR_START) / 1.0);
                var tremCm = 0.9 * rmp, ftrem = 10;
                ax += tremCm * Math.sin(TAU * ftrem * t);
                ay += tremCm * Math.sin(TAU * ftrem * 1.12 * t + 0.6);
                fx += tremCm * PXCM * 0.6 * Math.sin(TAU * ftrem * t);
                fy += tremCm * PXCM * 0.6 * Math.sin(TAU * ftrem * 1.1 * t + 1.0);
            }
        }
        sightShift.x = ax * PXCM;
        sightShift.y = ay * PXCM;
        wob.ax = fx;
        wob.ay = fy;

        // The jerk: at the break the muzzle is thrown low + toward the trigger finger (left, for a
        // right-handed shooter), springing back over ~0.35 s.
        if (sim.mode === "jerk" && sim.fired) {
            var ja = t - SIM.BREAK_T;
            if (ja >= 0 && ja < 0.35) {
                var imp = (1 - ja / 0.35); imp *= imp;
                sightShift.x += -70 * imp;
                sightShift.y += 55 * imp;
            }
        }

        // Trigger pressure: smooth ramp for a squeeze; held back then SNATCHED for a jerk.
        var pressure;
        if (t < SIM.PRESS_START) {
            pressure = 0;
        } else if (sim.mode === "jerk") {
            pressure = (t < SIM.BREAK_T - 0.3)
                ? clamp((t - SIM.PRESS_START) / (SIM.BREAK_T - SIM.PRESS_START), 0, 1) * 0.55
                : clamp(0.55 + (t - (SIM.BREAK_T - 0.3)) / 0.3 * 0.45, 0, 1);
        } else {
            pressure = clamp((t - SIM.PRESS_START) / (SIM.BREAK_T - SIM.PRESS_START), 0, 1);
        }
        if (!sim.fired && t >= SIM.BREAK_T) { sim.fired = true; fireSimShot(); }

        updateSimUi(t, pressure);
        draw();
        if (t >= simDuration()) { endSim(); return; }
        sim.raf = requestAnimationFrame(simLoop);
    }

    function endSim() {
        if (sim.raf !== null) { cancelAnimationFrame(sim.raf); sim.raf = null; }
        sim.running = false;
        sightShift.x = sightShift.y = 0;
        wob.ax = wob.ay = 0;
        ghostActive = false; ghostAlpha = 0;
        document.getElementById("perfectShotBtn").disabled = false;
        document.getElementById("jerkShotBtn").disabled = false;
        document.getElementById("simOverlay").style.display = "none";
        document.getElementById("simPress").style.background = "";
        syncWobbleAnim();   // resume free-play wobble if its amplitude is up
        draw(); caption();  // restore the live sight picture + caption…
        // …but deliberately DON'T redraw the Träffbild — the sim shot(s) stay on it until the user
        // touches any other control (which calls render() -> the free-play group).
    }

    window.siktPerfectShot = function (mode) {
        if (sim.running) return;
        if (wobbleRaf !== null) { cancelAnimationFrame(wobbleRaf); wobbleRaf = null; }
        wob.tx = wob.ty = wob.ax = wob.ay = 0;
        sim.mode = (mode === "jerk") ? "jerk" : "perfect";
        sim.running = true; sim.fired = false; sim.t0 = null; sim.shots = null;
        document.getElementById("perfectShotBtn").disabled = true;
        document.getElementById("jerkShotBtn").disabled = true;
        document.getElementById("simOverlay").style.display = "";
        var dur = simDuration();
        document.getElementById("simWindow").style.left = (SIM.LIFT / dur * 100).toFixed(1) + "%";
        document.getElementById("simWindow").style.width = ((Math.min(SIM.DRIFT_START, dur) - SIM.LIFT) / dur * 100).toFixed(1) + "%";
        document.getElementById("simPress").style.width = "0%";
        document.getElementById("simPress").style.background = "";
        drawSimGroup(null);
        sim.raf = requestAnimationFrame(simLoop);
    };

    window.siktNewSeries = function () {
        generateSamples();
        drawGroup();
        updateGroupLabel();
    };

    function syncLabels() {
        document.getElementById("lightVal").innerHTML = Math.round(state.light * 100) + "&nbsp;%";
        document.getElementById("apVal").innerHTML = state.aperture.toFixed(1) + "&nbsp;mm";
        document.getElementById("apertureWrap").style.display = state.diopter ? "" : "none";
        document.getElementById("wobbleAmpVal").innerHTML = Math.round(state.wobbleAmp * 100) + "&nbsp;%";
        document.getElementById("wobbleFreqVal").innerHTML = state.wobbleFreq.toFixed(1) + "&nbsp;Hz";
        updateBadges();
        updateSightDev();
    }

    function updateSightDev() {
        var el = document.getElementById("sightDevReadout");
        if (state.sightDx === 0 && state.sightDy === 0) {
            el.innerHTML = "<span class='text-success'>Centrerat &ndash; rätt linjering</span>";
            return;
        }
        var cmPerMm = 2500 / cfg.sightRadius;
        var mmParts = [], cmParts = [];
        if (state.sightDx !== 0) {
            mmParts.push(Math.abs(state.sightDx).toFixed(1) + " mm " + (state.sightDx > 0 ? "höger" : "vänster"));
            cmParts.push((Math.abs(state.sightDx) * cmPerMm).toFixed(1) + " cm " + (state.sightDx > 0 ? "höger" : "vänster"));
        }
        if (state.sightDy !== 0) {
            mmParts.push(Math.abs(state.sightDy).toFixed(1) + " mm " + (state.sightDy > 0 ? "upp" : "ned"));
            cmParts.push((Math.abs(state.sightDy) * cmPerMm).toFixed(1) + " cm " + (state.sightDy > 0 ? "högt" : "lågt"));
        }
        el.innerHTML = "Korn " + mmParts.join(", ") +
            " &rarr; <span class='text-danger fw-semibold'>träff " + cmParts.join(", ") + "</span>";
    }

    window.siktNudge = function (dx, dy) {
        state.sightDx = clamp(Math.round((state.sightDx + dx) * 10) / 10, -1.5, 1.5);
        state.sightDy = clamp(Math.round((state.sightDy + dy) * 10) / 10, -1.5, 1.5);
        syncLabels(); render();
    };
    window.siktSightCenter = function () {
        state.sightDx = 0; state.sightDy = 0;
        syncLabels(); render();
    };

    var focusRadios = document.querySelectorAll("input[name='siktFocus']");
    for (var k = 0; k < focusRadios.length; k++) {
        focusRadios[k].addEventListener("change", function (e) {
            state.focus = e.target.value;
            render();
        });
    }
    document.getElementById("lightRange").addEventListener("input", function (e) {
        state.light = parseInt(e.target.value, 10) / 100;
        syncLabels(); render();
    });
    var refrRadios = document.querySelectorAll("input[name='siktRefractive']");
    for (var rr = 0; rr < refrRadios.length; rr++) {
        refrRadios[rr].addEventListener("change", function (e) {
            state.refractive = e.target.value;
            syncLabels(); render();
        });
    }
    document.getElementById("presbyopiaToggle").addEventListener("change", function (e) {
        state.presbyopia = e.target.checked;
        syncLabels(); render();
    });
    document.getElementById("glassesToggle").addEventListener("change", function (e) {
        state.glasses = e.target.checked;
        syncLabels(); render();
    });
    document.getElementById("diopterToggle").addEventListener("change", function (e) {
        state.diopter = e.target.checked;
        syncLabels(); render();
    });
    document.getElementById("apRange").addEventListener("input", function (e) {
        state.aperture = parseFloat(e.target.value);
        syncLabels(); render();
    });
    document.getElementById("wobbleAmp").addEventListener("input", function (e) {
        state.wobbleAmp = parseInt(e.target.value, 10) / 100;
        syncLabels(); syncWobbleAnim(); render();
    });
    document.getElementById("wobbleFreq").addEventListener("input", function (e) {
        state.wobbleFreq = parseFloat(e.target.value);
        syncLabels();   // loop reads the new frequency live; group is unaffected
    });

    // --- Advanced settings (cogwheel modal) ---
    function syncCfgLabels() {
        document.getElementById("cfgMyopiaVal").innerHTML = cfg.myopia.toFixed(1) + "&nbsp;D";
        document.getElementById("cfgHyperopiaVal").innerHTML = cfg.hyperopia.toFixed(1) + "&nbsp;D";
        document.getElementById("cfgPresbyVal").innerHTML = cfg.presbyAmp.toFixed(2) + "&nbsp;D";
        // Residual accommodation -> reading-glasses add: the lens must supply the focus the eye can't.
        // 40 cm reading demand (2.5 D) minus what's left, rounded to the nearest 0.5 D, clamped to 0.5-4.
        var readAdd = clamp(Math.round((2.5 - cfg.presbyAmp) / 0.5) * 0.5, 0.5, 4);
        document.getElementById("cfgPresbyHint").innerHTML =
            "≈ +" + readAdd.toFixed(1) + " läsglasögon (vid 40&nbsp;cm läsavstånd)";
        document.getElementById("cfgSightRadiusVal").innerHTML = cfg.sightRadius + "&nbsp;mm";
        document.getElementById("cfgSightRadiusHint").innerHTML =
            "≈ " + (2500 / cfg.sightRadius).toFixed(1) + " cm träffläge per mm linjeringsfel (25 m)";
    }
    document.getElementById("cfgMyopia").addEventListener("input", function (e) {
        cfg.myopia = parseFloat(e.target.value); syncCfgLabels(); render();
    });
    document.getElementById("cfgHyperopia").addEventListener("input", function (e) {
        cfg.hyperopia = parseFloat(e.target.value); syncCfgLabels(); render();
    });
    document.getElementById("cfgPresby").addEventListener("input", function (e) {
        cfg.presbyAmp = parseFloat(e.target.value); syncCfgLabels(); render();
    });
    document.getElementById("cfgSightRadius").addEventListener("input", function (e) {
        cfg.sightRadius = parseInt(e.target.value, 10); syncCfgLabels(); render();
    });
    window.siktCfgReset = function () {
        cfg.myopia = CFG_DEFAULTS.myopia;
        cfg.hyperopia = CFG_DEFAULTS.hyperopia;
        cfg.presbyAmp = CFG_DEFAULTS.presbyAmp;
        cfg.sightRadius = CFG_DEFAULTS.sightRadius;
        document.getElementById("cfgMyopia").value = cfg.myopia;
        document.getElementById("cfgHyperopia").value = cfg.hyperopia;
        document.getElementById("cfgPresby").value = cfg.presbyAmp;
        document.getElementById("cfgSightRadius").value = cfg.sightRadius;
        syncCfgLabels(); render();
    };

    function pushStateToControls() {
        document.getElementById("focus" + state.focus.charAt(0).toUpperCase() + state.focus.slice(1)).checked = true;
        document.getElementById("lightRange").value = Math.round(state.light * 100);
        document.getElementById("refr" + state.refractive.charAt(0).toUpperCase() + state.refractive.slice(1)).checked = true;
        document.getElementById("presbyopiaToggle").checked = state.presbyopia;
        document.getElementById("glassesToggle").checked = state.glasses;
        document.getElementById("diopterToggle").checked = state.diopter;
        document.getElementById("apRange").value = state.aperture;
        document.getElementById("wobbleAmp").value = Math.round(state.wobbleAmp * 100);
        document.getElementById("wobbleFreq").value = state.wobbleFreq;
        syncLabels();
        syncWobbleAnim();
    }

    window.siktScenario = function (name) {
        if (sim.running) endSim();
        if (name === "correct") {
            state = { focus: "front", light: 0.80, refractive: "none", presbyopia: false, glasses: false, distanceM: 25, diopter: false, aperture: 1.2, sightDx: 0, sightDy: 0, wobbleAmp: 0, wobbleFreq: 1.0 };
        } else if (name === "beginner") {
            state = { focus: "target", light: 0.55, refractive: "none", presbyopia: false, glasses: false, distanceM: 25, diopter: false, aperture: 1.2, sightDx: 0, sightDy: 0, wobbleAmp: 0, wobbleFreq: 1.0 };
        }
        pushStateToControls();
        render();
    };

    window.siktReset = function () {
        state = { focus: "front", light: 0.80, refractive: "none", presbyopia: false, glasses: false, distanceM: 25, diopter: false, aperture: 1.2, sightDx: 0, sightDy: 0, wobbleAmp: 0, wobbleFreq: 1.0 };
        pushStateToControls();
        render();
    };

    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            if (wobbleRaf !== null) { cancelAnimationFrame(wobbleRaf); wobbleRaf = null; }
        } else {
            syncWobbleAnim();
        }
    });

    window.addEventListener("resize", function () { setupCanvas(); setupGroupCanvas(); render(); });

    // ---- Login gate: page is viewable, but controls are locked until logged in ----
    function showLoginModal() {
        var el = document.getElementById("siktLoginModal");
        if (el && window.bootstrap) bootstrap.Modal.getOrCreateInstance(el).show();
    }
    if (!SIKT_LOGGED_IN) {
        var gate = function (e) {
            var el = e.target.closest("button, input, label.btn");
            if (!el) return;
            if (el.closest("#siktLoginModal")) return;                 // let the login modal work
            if (el.closest("#siktTutorialBtn")) return;                // let the video-lesson button work (no login needed)
            if (!el.closest("#siktApp, #siktSettingsModal")) return;   // only gate the simulator
            if (e.type === "keydown") {
                var k = e.key;
                if (k !== " " && k !== "Enter" && k !== "ArrowLeft" && k !== "ArrowRight" && k !== "ArrowUp" && k !== "ArrowDown") return;
            }
            e.preventDefault();
            e.stopPropagation();
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();
            showLoginModal();
        };
        ["pointerdown", "mousedown", "touchstart", "click", "keydown"].forEach(function (ev) {
            document.addEventListener(ev, gate, true);   // capture phase: runs before Bootstrap + inline onclick
        });
    }

    setupCanvas();
    setupGroupCanvas();
    generateSamples();
    syncLabels();
    syncCfgLabels();
    render();
})();
</script>
