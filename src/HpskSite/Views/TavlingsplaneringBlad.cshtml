@model HpskSite.Models.Staffing.PlaneringBladModel
@using System.Globalization
@{
    Layout = null;
    var ci = CultureInfo.GetCultureInfo("sv-SE");
    string Kr(decimal? v) => v.HasValue && v.Value != 0 ? v.Value.ToString("#,##0", ci) + " kr" : "";
    string StatusSv(string s) => s switch
    {
        "Planerad" => "Planerad", "Pagar" => "Pågår", "Blockerad" => "Blockerad", "Klar" => "Klar",
        "Planned" => "Planerad", "Invited" => "Inbjuden", "Accepted" => "Accepterad", "Declined" => "Avböjt", "Confirmed" => "Bekräftad",
        _ => s
    };
    // Only role groups that actually have people (keeps the sheet tight); prep shows every område.
    var filledGroups = Model.Roster?.Groups?.Where(g => g.Assignments != null && g.Assignments.Count > 0).ToList()
                       ?? new List<HpskSite.Models.Staffing.StaffRoleGroup>();
    var areas = Model.Work?.Areas ?? new List<HpskSite.Models.Staffing.WorkAreaView>();

    // The grid: only days that are real (the undated bucket has no column on paper) and only rows that
    // carry someone or state a need — a printout of 29 empty rows helps nobody.
    var grid = Model.Grid;
    var gridCols = grid?.Columns?.Where(c => !string.IsNullOrEmpty(c.Key)).ToList()
                   ?? new List<HpskSite.Models.Staffing.GridColumn>();
    var gridRows = grid?.Rows?.Where(r => r.Filled > 0 || r.Needed > 0).ToList()
                   ?? new List<HpskSite.Models.Staffing.GridRow>();
    var unreachable = grid?.Unreachable ?? new List<string>();
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vem gör vad – @Model.CompName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; color: #1a1a1a; margin: 0; padding: 24px; }
        .wrap { max-width: 900px; margin: 0 auto; }
        h1 { font-size: 1.5rem; margin: 0 0 .2rem; }
        h2 { font-size: 1.15rem; margin: 1.4rem 0 .5rem; border-bottom: 2px solid #333; padding-bottom: .2rem; }
        h3 { font-size: 1rem; margin: .9rem 0 .3rem; }
        .meta { color: #555; margin-bottom: 1rem; }
        table { width: 100%; border-collapse: collapse; margin-bottom: .6rem; }
        th, td { text-align: left; padding: 5px 8px; border-bottom: 1px solid #ddd; vertical-align: top; font-size: .9rem; }
        th { background: #f3f3f3; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; color: #444; }
        .resp { color: #b8860b; }
        .muted { color: #777; }
        .pill { display: inline-block; font-size: .72rem; padding: 1px 7px; border: 1px solid #bbb; border-radius: 10px; color: #444; }
        .done { text-decoration: line-through; color: #888; }
        .overdue { color: #c00; font-weight: 600; }
        .blocked { color: #c00; }
        .toolbar { margin-bottom: 1rem; }
        .btn { display: inline-block; padding: 8px 16px; background: #0d6efd; color: #fff; border: 0; border-radius: 6px; text-decoration: none; cursor: pointer; font-size: .95rem; }
        .btn.secondary { background: #6c757d; }
        .area-head { display: flex; justify-content: space-between; align-items: baseline; }
        /* The grid sheet is wide, so it gets the full page and landscape paper. */
        .wide { max-width: none; }
        table.grid { table-layout: fixed; }
        table.grid th, table.grid td { border: 1px solid #ccc; padding: 4px 6px; font-size: .82rem; }
        table.grid th { background: #f3f3f3; text-transform: none; font-size: .85rem; letter-spacing: 0; color: #222; }
        table.grid .rolecol { width: 190px; font-weight: 600; }
        .daylabel { font-size: .74rem; font-weight: 400; }
        .person { line-height: 1.25; }
        .person .pname { font-weight: 500; }
        .person .club { color: #666; font-size: .74rem; margin-left: .25rem; }
        .person .tid { color: #333; font-size: .74rem; margin-left: .25rem; white-space: nowrap; }
        .note { color: #777; font-size: .7rem; margin: 0 0 3px 0; }
        .gap { color: #c00; font-size: .78rem; }
        .small-note { font-size: .78rem; margin-top: .4rem; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
            h2 { page-break-after: avoid; }
            tr { page-break-inside: avoid; }
            /* Repeat the day headings on every page — a grid whose columns you can't see is unusable. */
            thead { display: table-header-group; }
            .note { display: none; }   /* anteckningarna gör rutorna för höga på papper */
        }
        @@page { size: A4 landscape; margin: 10mm; }
    </style>
</head>
<body>
<div class="wrap @(Model.ShowBemanning ? "wide" : "")">
    @if (!Model.Exists)
    {
        <p>Tävlingen hittades inte.</p>
    }
    else if (!Model.CanAccess)
    {
        <p>Du har inte behörighet att se den här planeringen.</p>
    }
    else
    {
        <div class="toolbar no-print">
            <button class="btn" onclick="window.print()"><i class="bi bi-printer"></i> Skriv ut</button>
            <a class="btn secondary" href="/tavlingsplanering?c=@Model.CompetitionId"><i class="bi bi-arrow-left"></i> Tillbaka till planeringen</a>
        </div>

        <h1>@Model.Heading</h1>
        <div class="meta">
            <strong>@Model.CompName</strong>
            @if (!string.IsNullOrEmpty(Model.CompDate)) { <span> · Tävlingsdatum @Model.CompDate</span> }
            @if (Model.ShowForberedelser && Model.Work != null && (Model.Work.TotalEstimatedCost != 0 || Model.Work.TotalActualCost != 0))
            {
                <span> · Budget @Kr(Model.Work.TotalEstimatedCost)@(Model.Work.TotalActualCost != 0 ? $" · Utfall {Kr(Model.Work.TotalActualCost)}" : "")</span>
            }
            @if (Model.ShowBemanning && grid != null && grid.TotalAssigned > 0)
            {
                <span> · @grid.TotalAssigned uppdrag · @gridRows.Count funktioner · @gridCols.Count dagar</span>
            }
            <span> · Utskrivet @DateTime.Now.ToString("d MMMM yyyy HH:mm", ci)</span>
        </div>

        @*
            BEMANNING AS A GRID — roles down, days across, names in the cells.
            It used to print as a role-grouped list, which put one person on row after row and left the
            day axis out entirely. The organiser's own sheet is a matrix, and the printout is the thing
            they carry around the range, so it has to be the same shape as the plan they built.
        *@
        @if (Model.ShowBemanning)
        {
            @* Bara när flera avsnitt trycks — annars upprepar rubriken sig själv direkt under H1. *@
            @if (Model.Vy == HpskSite.Models.Staffing.PlaneringBladVy.Allt)
            {
                <h2><i class="bi bi-person-badge"></i> Bemanning</h2>
            }
            @if (grid == null || !gridRows.Any())
            {
                <p class="muted">Inga funktionärer tilldelade ännu.</p>
            }
            else
            {
                <table class="grid">
                    <thead>
                        <tr>
                            <th class="rolecol">Funktion</th>
                            @foreach (var col in gridCols)
                            {
                                <th>
                                    @col.Label
                                    @if (!string.IsNullOrEmpty(col.DayLabel)) { <div class="daylabel">@col.DayLabel</div> }
                                    @if (col.Kind != "Tavlingsdag" && !string.IsNullOrEmpty(col.KindLabel)) { <div class="muted daylabel">@col.KindLabel</div> }
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in gridRows)
                    {
                        <tr>
                            <td class="rolecol">
                                @row.RoleName
                                @if (!string.IsNullOrEmpty(row.ScopeLabel)) { <div class="muted daylabel">@row.ScopeLabel</div> }
                            </td>
                            @foreach (var col in gridCols)
                            {
                                var cell = row.Cells.TryGetValue(col.Key, out var list) ? list : new List<HpskSite.Models.Staffing.GridEntry>();
                                <td>
                                    @foreach (var e in cell)
                                    {
                                        <div class="person">
                                            @if (e.IsResponsible) { <span class="resp">★</span> }
                                            <span class="pname">@e.DisplayName</span>
                                            @if (!string.IsNullOrEmpty(e.ClubName)) { <span class="club">@e.ClubName</span> }
                                            @if (!string.IsNullOrEmpty(e.TimeLabel)) { <span class="tid">@e.TimeLabel</span> }
                                        </div>
                                        @if (!string.IsNullOrEmpty(e.Note))
                                        {
                                            <div class="note">@e.Note</div>
                                        }
                                    }
                                    @if (!cell.Any() && row.Needed > 0)
                                    {
                                        <div class="gap">— saknas @row.Needed</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>

                @if (unreachable.Any())
                {
                    <p class="muted small-note">
                        <strong>Utan konto på pistol.nu (@unreachable.Count):</strong>
                        @string.Join(", ", unreachable)
                        — de får inget personligt schema och inga påminnelser.
                    </p>
                }
            }
        }

        @if (Model.ShowDagsprogram)
        {
            @if (Model.Vy == HpskSite.Models.Staffing.PlaneringBladVy.Allt)
            {
                <h2><i class="bi bi-calendar2-event"></i> Dagsprogram</h2>
            }
            @if (!Model.Agenda.Any())
            {
                <p class="muted">Inget dagsprogram inlagt.</p>
            }
            else
            {
                foreach (var g in Model.Agenda.GroupBy(a => a.ItemDate?.Date).OrderBy(g => g.Key ?? DateTime.MaxValue))
                {
                    <h3>@(g.Key?.ToString("dddd d MMMM", ci) ?? "Tävlingsdagen")</h3>
                    <table>
                        <thead><tr><th style="width:16%">Tid</th><th style="width:44%">Vad</th><th style="width:24%">Var</th><th style="width:16%">Vem</th></tr></thead>
                        <tbody>
                        @foreach (var it in g.OrderBy(x => x.StartTime ?? "zz"))
                        {
                            <tr>
                                <td>@(string.IsNullOrEmpty(it.StartTime) ? "Under dagen" : it.StartTime + (string.IsNullOrEmpty(it.EndTime) ? "" : "–" + it.EndTime))</td>
                                <td>@it.Title</td>
                                <td>@it.Location</td>
                                <td>@(it.Audience == "Staff" ? "Funktionärer" : it.Audience == "Shooters" ? "Skyttar" : "Alla")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            }
        }

        @if (Model.ShowForberedelser)
        {
        @if (Model.Vy == HpskSite.Models.Staffing.PlaneringBladVy.Allt)
        {
            <h2><i class="bi bi-list-check"></i> Förberedelser</h2>
        }
        @if (!areas.Any())
        {
            <p class="muted">Inga förberedelseområden ännu.</p>
        }
        else
        {
            foreach (var area in areas)
            {
                <div class="area-head">
                    <h3>@area.Name <span class="muted">(@area.DoneCount/@area.TotalCount klara@(area.EstimatedCostSum != 0 ? $" · budget {Kr(area.EstimatedCostSum)}" : "")@(area.ActualCostSum != 0 ? $" · utfall {Kr(area.ActualCostSum)}" : ""))</span></h3>
                    @if (!string.IsNullOrEmpty(area.ResponsibleName)) { <span class="muted"><i class="bi bi-person"></i> @area.ResponsibleName</span> }
                </div>
                @if (area.Items != null && area.Items.Any())
                {
                    <table>
                        <thead>
                            <tr><th style="width:38%">Uppgift</th><th style="width:20%">Ansvarig</th><th style="width:14%">Deadline</th><th style="width:14%">Budget</th><th style="width:14%">Status</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var it in area.Items)
                        {
                            var done = string.Equals(it.Status, "Klar", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td class="@(done ? "done" : "")">
                                    @it.Title
                                    @if (it.IsBlocked)
                                    {
                                        <div class="blocked" style="font-size:.8rem"><i class="bi bi-slash-circle"></i> Blockeras av: @string.Join(", ", it.BlockedBy.Where(b => !b.Done).Select(b => b.Title))</div>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(it.AssignedName) ? "—" : it.AssignedName)</td>
                                <td class="@(it.IsOverdue ? "overdue" : "")">@(string.IsNullOrEmpty(it.DueDate) ? "" : it.DueDate)</td>
                                <td>@(Kr(it.EstimatedCost))@(it.ActualCost.HasValue && it.ActualCost != 0 ? $" ({Kr(it.ActualCost)})" : "")</td>
                                <td>@StatusSv(it.Status)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="muted">Inga uppgifter.</p>
                }
            }
        }
        }

        <p class="muted" style="margin-top:2rem; font-size:.8rem">Utskrivet från pistol.nu tävlingsplanering.</p>
    }
</div>
</body>
</html>
