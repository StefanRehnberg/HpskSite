@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Tävlingsplanering";
}
@*
    Tävling → Tävlingsplanering (2026-10-23): listan i ADMINLISTANS FORM (förlagan Träningar): rubrik +
    förklarande rad, blå Åtgärder, filter och antal ovanför tabellen, grå Åtgärder per rad.
    Visas: mina planeringar; andras bara när den sammankallande valt att visa dem för alla medlemmar
    (då kan man be om att få vara med); och för sajtadmin, som SUPPORT, planeringar med förfrågningar
    som väntar. Andras planeringar visar bara namn, tid och sammankallande — aldrig innehållet.
    Planeringar som hör till en tävling nås från tävlingens knapp Planering (/tavlingsplanering?c=…).
*@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/sv.js"></script>
<script src="~/js/planering-dates.js" asp-append-version="true"></script>
<style>
    .plh-page { padding-bottom: 5rem; }
    .plh-help { color: var(--bs-secondary-color); }
    .plh-badge { background: var(--bs-warning); color: #1b1206; font-weight: 700; font-size: .8rem; border-radius: 1rem; padding: .1rem .55rem; white-space: nowrap; display: inline-block; margin: 1px 0; }
    .plh-table td a.plh-name { font-weight: 600; text-decoration: none; }
    .plh-table td a.plh-name:hover { text-decoration: underline; }
    /* Stefan 2026-10-25: delplaneringarna står indragna under sin huvudplanering, med en linje till vänster. */
    .plh-table tr.plh-sub > td:first-child { padding-left: 2.25rem; position: relative; }
    .plh-table tr.plh-sub > td:first-child::before { content: ""; position: absolute; left: 1rem; top: 0; bottom: 0; border-left: 2px solid var(--bs-border-color); }
    .plh-table tr.plh-head > td { background: var(--bs-tertiary-bg); color: var(--bs-secondary-color); }
    .plh-kind { font-size: .75rem; color: var(--bs-secondary-color); font-weight: 600; text-transform: uppercase; letter-spacing: .02em; }
</style>

<div class="plh-page container-fluid px-lg-4 py-4">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h1 class="h3 mb-0"><i class="bi bi-diagram-3 me-2 text-primary"></i>Tävlingsplanering</h1>
        <div class="d-flex gap-2">
        @* Filmen om planeringen i stort — noden tutorial-planering-promo under /tutorials. *@
        <button type="button" class="btn btn-outline-primary text-nowrap" onclick="TutorialHelper.open('tutorial-planering-promo')" title="Se filmen om tävlingsplanering">
            <i class="bi bi-play-circle me-1"></i>Guide
        </button>
        <div class="dropdown">
            <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-sliders me-1"></i>Åtgärder
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="min-width:240px">
                <li><button class="dropdown-item" type="button" id="plhNew"><i class="bi bi-plus-circle me-2"></i>Ny planering</button></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" id="plhLab" href="/patrullgenerator/lab"><i class="bi bi-people me-2"></i>Prova patrullgeneratorn</a></li>
            </ul>
        </div>
        </div>
    </div>
    <p class="plh-help mb-3">Planera en tävling långt innan den finns — SM, kretsmästerskap eller klubbens egen tävling. Bjud in de som ska vara med, skriv till varandra och hitta tider för mötena.
        Bara de som är med ser innehållet. Vissa planeringar visas för alla medlemmar, och då kan du be om att få vara med.</p>
    <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
        <input type="search" class="form-control form-control-sm" id="plhSearch" placeholder="Sök på namn, plats eller sammankallande" style="max-width:320px" aria-label="Sök">
        <select class="form-select form-select-sm w-auto" id="plhFilter" aria-label="Visa"></select>
        <span class="small text-muted ms-auto" id="plhCount"></span>
    </div>
    <div id="plhMsg"></div>
    <div id="plhList"><div class="text-center py-5"><div class="spinner-border"></div></div></div>
</div>

<div class="modal fade" id="plhDlg" tabindex="-1" aria-hidden="true" aria-labelledby="plhDlgTitle">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5" id="plhDlgTitle"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button></div>
            <div class="modal-body"><div class="alert alert-danger d-none" id="plhDlgErr" role="alert"></div><div id="plhDlgBody"></div></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="plhDlgOk">OK</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="plhModal" tabindex="-1" aria-hidden="true" aria-labelledby="plhModalTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5" id="plhModalTitle">Ny planering</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button></div>
            <div class="modal-body">
                <div class="alert alert-danger d-none" id="plhErr" role="alert"></div>
                <div class="mb-3"><label class="form-label fw-semibold" for="plhName">Vad ska ni planera?</label>
                    <input id="plhName" class="form-control" maxlength="200" placeholder="Till exempel: SM 2028 eller Magnumträffen 2027"></div>
                @*
                    ⚠️ Ingen fråga om vilket SLAGS planering (Stefan 2026-10-22): valet ändrade ingenting —
                    alla planeringar fungerar likadant. Lägg inte tillbaka det förrän ett slag faktiskt styr något.
                *@
                @* Planeringstestet k2: grenfrågan stod efter datumen och skymdes av kalendern — ingen valde gren, och
                   Stationerna syntes inte. Den står nu direkt efter namnet. *@
                <div class="mb-3"><label class="form-label" for="plhDisc">Vilken gren gäller planeringen?</label>
                    <select id="plhDisc" class="form-select" style="max-width:320px">
                        <option value="">Flera grenar, eller vet inte än</option>
                        @foreach (var d in HpskSite.Models.CompetitionTypes.All)
                        {
                            <option value="@d.Id">@d.Name</option>
                        }
                    </select>
                    <div class="plh-help small mt-1">Välj Fältskytte om tävlingen har stationer — då får ni en egen del för stationerna, och bemanningen föreslår rätt roller. Gäller planeringen flera grenar, till exempel en SM-vecka, delar du upp den senare.</div>
                </div>
                <div class="plh-help small mb-3">Det går bra att börja långt innan tävlingen finns — även när ni ännu inte vet var eller när.</div>
                <div class="row g-2 mb-3">
                    <div class="col-12"><label class="form-label" for="plhTarget">Ungefär när och var (valfritt)</label>
                        <input id="plhTarget" class="form-control" maxlength="200" placeholder="Till exempel: augusti 2028, Skillingaryd?"></div>
                    <div class="col-sm-6"><label class="form-label" for="plhStart">Första dagen, om den är bestämd</label><input id="plhStart" class="form-control" placeholder="åååå-mm-dd"></div>
                    <div class="col-sm-6"><label class="form-label" for="plhEnd">Sista dagen</label><input id="plhEnd" class="form-control" placeholder="åååå-mm-dd"></div>
                </div>
                @*
                    ⚠️ Planeringsgruppen är sin egen enhet (Stefan 2026-10-23): den som är inbjuden är med, ingen
                    annan. Ingen förening eller styrelse får läsrätt — kretsar och klubbar utser personer, och vad var
                    och en företräder står på deltagarlistan.
                *@
                <p class="plh-help small mt-3 mb-0">Du blir <b>sammankallande</b> — den som leder gruppen. Sedan bjuder du in de andra och anger vad var och en företräder,
                    till exempel en krets, en klubb eller markägaren. Bara de som är inbjudna ser planeringen.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="plhCreate">Skapa planeringen</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const $ = id => document.getElementById(id);
    const esc = s => (s === null || s === undefined) ? '' : s.toString().replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c]));
    const tok = () => document.querySelector('input[name="__RequestVerificationToken"]').value;
    async function req(url, opts) {
        const r = await fetch(url, opts);
        // hpskRequestFailureMessage ger { msg, reload } — texten är .msg.
        if (!r.ok) throw new Error(window.hpskRequestFailureMessage ? window.hpskRequestFailureMessage(r.status).msg : 'Något gick fel (' + r.status + ').');
        return r.json();
    }
    const fmt = s => { if (!s) return ''; const d = new Date(s.replace(' ', 'T')); return isNaN(d) ? s : d.toLocaleString('sv-SE', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); };
    const post = (action, params) => req('/umbraco/surface/Planning/' + action, { method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': tok() }, body: new URLSearchParams(params).toString() });
    let data = null, rows = [], fns = [];
    const folded = new Set(); // huvudplaneringar vars delplaneringar användaren fällt ihop (bara när de är många)
    const FOLD_FROM = 6;
    const LEVELS = [['Follower', 'Följer'], ['Participant', 'Deltar'], ['Editor', 'Kan ändra'], ['Owner', 'Sammankallande']];

    function say(html, kind) { $('plhMsg').innerHTML = html ? `<div class="alert alert-${kind || 'success'} alert-dismissible">${html}<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Stäng"></button></div>` : ''; }

    // Dialogen: en för allt (fråga, förfrågan, support). onOk returnerar true = stäng, text = visa felet.
    function dialog(title, html, okLabel, onOk, okClass) {
        $('plhDlgTitle').textContent = title;
        $('plhDlgBody').innerHTML = html;
        const err = $('plhDlgErr'); err.classList.add('d-none');
        const ok = $('plhDlgOk');
        ok.textContent = okLabel || 'OK'; ok.className = 'btn ' + (okClass || 'btn-primary'); ok.classList.toggle('d-none', !onOk);
        const m = bootstrap.Modal.getOrCreateInstance($('plhDlg'));
        ok.onclick = async () => {
            ok.disabled = true;
            try { const r = await onOk($('plhDlgBody')); if (r === true) m.hide(); else if (typeof r === 'string') { err.textContent = r; err.classList.remove('d-none'); } }
            catch (e) { err.textContent = e.message; err.classList.remove('d-none'); }
            finally { ok.disabled = false; }
        };
        m.show();
    }

    function filters() {
        const mine = data.plannings.filter(p => p.status !== 'Archived'), arch = data.plannings.filter(p => p.status === 'Archived');
        const f = [['mine', `Mina planeringar (${mine.length})`], ['listed', `Kan be om att vara med (${data.listed.length})`], ['archived', `Arkiverade (${arch.length})`]];
        if (data.isSiteAdmin) f.push(['support', `Förfrågningar som väntar — support (${data.support.length})`]);
        return f;
    }
    function current() {
        const f = $('plhFilter').value;
        if (f === 'listed') return data.listed.map(p => Object.assign({ kind: 'listed' }, p));
        if (f === 'support') return data.support.map(p => Object.assign({ kind: 'support' }, p));
        return data.plannings.filter(p => (p.status === 'Archived') === (f === 'archived')).map(p => Object.assign({ kind: 'mine' }, p));
    }
    function menu(items) {
        const html = items.filter(Boolean).map(it => {
            if (it.divider) return '<li><hr class="dropdown-divider"></li>';
            if (it.href) return `<li><a class="dropdown-item" href="${it.href}"><i class="bi ${it.icon} me-2"></i>${esc(it.label)}</a></li>`;
            fns.push(it.fn);
            return `<li><button class="dropdown-item${it.danger ? ' text-danger' : ''}" type="button" data-plh-fn="${fns.length - 1}"><i class="bi ${it.icon} me-2"></i>${esc(it.label)}</button></li>`;
        }).join('');
        return `<div class="dropdown"><button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"
            data-bs-popper-config='{"strategy":"fixed"}'>Åtgärder</button><ul class="dropdown-menu dropdown-menu-end">${html}</ul></div>`;
    }
    function waits(p) {
        const w = [];
        if (p.pendingRequests) w.push(`<span class="plh-badge">${p.pendingRequests} väntar på godkännande</span>`);
        if (p.votesOwed) w.push(`<span class="plh-badge">Svara på ${p.votesOwed === 1 ? 'en mötestid' : p.votesOwed + ' möten'}</span>`);
        if (p.unread) w.push(`<span class="plh-badge">${p.unread} ${p.unread === 1 ? 'nytt meddelande' : 'nya meddelanden'}</span>`);
        if (p.kind === 'listed' && p.requested) w.push('<span class="badge bg-info-subtle text-info-emphasis">Förfrågan skickad</span>');
        return w.join(' ');
    }
    function render() {
        fns = [];
        const sel = $('plhFilter'), cur = sel.value;
        sel.innerHTML = filters().map(([v, l]) => `<option value="${v}"${v === cur ? ' selected' : ''}>${esc(l)}</option>`).join('');
        const all = current();
        const q = $('plhSearch').value.trim().toLowerCase();
        rows = q ? all.filter(p => [p.name, p.targetText, p.conveners].join(' ').toLowerCase().includes(q)) : all;
        $('plhCount').textContent = rows.length === all.length ? `${all.length} ${all.length === 1 ? 'planering' : 'planeringar'}` : `Visar ${rows.length} av ${all.length}`;
        if (!all.length) {
            const f = sel.value;
            $('plhList').innerHTML = `<div class="text-center text-muted py-4 border rounded">${
                f === 'listed' ? 'Ingen planering visas för alla medlemmar just nu.'
                : f === 'archived' ? 'Inga arkiverade planeringar.'
                : f === 'support' ? 'Inga förfrågningar väntar.'
                : 'Du är inte med i någon planering ännu. Skapa en under <b>Åtgärder → Ny planering</b>, eller vänta på en inbjudan — den kommer med mejl.'}</div>`;
            return;
        }
        const body = grouped(rows, all).map(x => x.head ? headRow(x.head, x.subs) : rowHtml(x.p, x.sub, x.subs)).join('');
        $('plhList').innerHTML = `<div class="table-responsive"><table class="table align-middle plh-table"><thead><tr>
            <th>Planering</th><th class="d-none d-md-table-cell">Sammankallande</th><th class="d-none d-md-table-cell">Din nivå</th>
            <th class="d-none d-md-table-cell">Nästa möte</th><th class="d-none d-md-table-cell">Väntar</th><th class="text-end"></th></tr></thead><tbody>${body}</tbody></table></div>`;
    }
    // Familjerna: varje huvudplanering följd av sina delplaneringar. En delplanering vars huvudplanering inte står i listan
    // får en rubrik (en huvudplanering man bara är med i via en delplanering — eller en som sökningen inte träffade).
    // Ordningen följer serverns: där familjens första planering står.
    function grouped(rows, all) {
        const byId = new Map(all.map(p => [p.id, p]));
        const out = [], seen = new Set();
        const subsOf = rootId => rows.filter(p => p.parentId === rootId);
        for (const p of rows) {
            const root = p.parentId || p.id;
            if (seen.has(root)) continue;
            seen.add(root);
            const subs = subsOf(root);
            const rootRow = rows.find(x => x.id === root);
            if (rootRow) out.push({ p: rootRow, sub: false, subs: subs.length });
            else {
                // Sökningen tog bort huvudplaneringen, men den finns i listan: visa den ändå, som sammanhang.
                const inAll = byId.get(root);
                if (inAll) out.push({ p: inAll, sub: false, subs: subs.length });
                else {
                    // Med i huvudplaneringen men den står under ett annat filter (aktiv/arkiverad): rubriken säger var.
                    const own = (data.plannings || []).find(x => x.id === root && !x.readOnly);
                    out.push({ head: own ? { id: root, name: own.name, elsewhere: own.status === 'Archived' ? 'Arkiverade' : 'Mina planeringar' }
                        : (data.parents || []).find(x => x.id === root) || { id: root, name: 'Huvudplaneringen' }, subs: subs.length });
                }
            }
            if (!folded.has(root)) subs.forEach(x => out.push({ p: x, sub: true }));
        }
        return out;
    }
    function foldButton(id, n) {
        if (n < FOLD_FROM) return '';
        return `<button type="button" class="btn btn-link btn-sm p-0 ms-1" data-plh-fold="${id}">${folded.has(id) ? 'Visa delplaneringarna' : 'Dölj delplaneringarna'}</button>`;
    }
    function headRow(h, n) {
        return `<tr class="plh-head" data-plh-head="${h.id}"><td colspan="6"><span class="plh-kind">Huvudplanering</span>
            <div class="fw-semibold">${esc(h.name)}</div>
            <div class="small">${h.elsewhere ? `Huvudplaneringen står under ${esc(h.elsewhere)}.`
                : `Du är med i ${n === 1 ? 'en delplanering' : n + ' delplaneringar'} här. Huvudplaneringen öppnar den som leder den.`}${foldButton(h.id, n)}</div></td></tr>`;
    }
    function rowHtml(p, sub, nSubs) {
        {
            const mine = p.kind === 'mine';
            const open = mine ? `/tavlingsplanering/${p.id}` : '';
            const name = mine ? `<a class="plh-name" href="${open}">${esc(p.name)}</a>` : `<span class="fw-semibold">${esc(p.name)}</span>`;
            const level = mine ? esc(p.accessLabel) : p.kind === 'listed' ? '<span class="text-muted">Inte med</span>' : '<span class="text-muted">Support</span>';
            const next = p.nextMeetingAt ? esc(fmt(p.nextMeetingAt)) : '<span class="text-muted">—</span>';
            const items = mine && p.readOnly ? [
                { href: open, icon: 'bi-box-arrow-up-right', label: 'Öppna' },
            ] : mine ? [
                { href: open, icon: 'bi-box-arrow-up-right', label: 'Öppna' },
                { divider: true },
                { icon: 'bi-box-arrow-right', label: 'Lämna planeringen…', danger: true, fn: () => leave(p) },
            ] : p.kind === 'listed' ? [
                p.requested ? { icon: 'bi-x-circle', label: 'Dra tillbaka förfrågan', fn: () => withdraw(p) }
                            : { icon: 'bi-person-plus', label: 'Be om att få vara med…', fn: () => ask(p) },
            ] : [{ icon: 'bi-person-check', label: 'Hantera förfrågningar…', fn: () => support(p) }];
            const kind = sub ? '<span class="plh-kind">Delplanering</span><br>' : '';
            const subsInfo = !sub && nSubs ? `<div class="small text-muted">${nSubs === 1 ? 'En delplanering' : nSubs + ' delplaneringar'}${foldButton(p.id, nSubs)}</div>` : '';
            return `<tr${sub ? ' class="plh-sub"' : ''} data-plh-row="${p.id}"><td>${kind}${name}<div class="small text-muted">${esc(p.targetText || '')}</div>${subsInfo}
                    <div class="d-md-none small mt-1">${p.conveners ? 'Sammankallande: ' + esc(p.conveners) + ' · ' : ''}Du: ${level}${p.nextMeetingAt ? ' · nästa möte ' + esc(fmt(p.nextMeetingAt)) : ''}</div>
                    <div class="d-md-none mt-1">${waits(p)}</div></td>
                <td class="d-none d-md-table-cell">${esc(p.conveners || '')}</td>
                <td class="d-none d-md-table-cell">${level}</td>
                <td class="d-none d-md-table-cell text-nowrap">${next}</td>
                <td class="d-none d-md-table-cell">${waits(p)}</td>
                <td class="text-end">${menu(items)}</td></tr>`;
        }
    }
    document.addEventListener('click', e => { const b = e.target.closest('[data-plh-fn]'); if (b) fns[+b.dataset.plhFn](); });
    document.addEventListener('click', e => {
        const b = e.target.closest('[data-plh-fold]'); if (!b) return;
        const id = +b.dataset.plhFold;
        if (folded.has(id)) folded.delete(id); else folded.add(id);
        render();
    });
    $('plhFilter').addEventListener('change', render);
    $('plhSearch').addEventListener('input', render);

    function ask(p) {
        dialog('Be om att få vara med', `<p>Du ber om att få vara med i <b>${esc(p.name)}</b>. ${p.conveners ? 'Den sammankallande (' + esc(p.conveners) + ')' : 'Den sammankallande'} får ett mejl och släpper in dig — du får ett mejl när det är gjort.</p>
            <label class="form-label" for="plhAskMsg">Varför vill du vara med? (valfritt)</label>
            <textarea id="plhAskMsg" class="form-control" rows="3" maxlength="1000" placeholder="Till exempel: jag är banansvarig i klubben som har banan"></textarea>`,
            'Skicka förfrågan', async body => {
                const r = await post('RequestAccess', { id: p.id, message: body.querySelector('#plhAskMsg').value });
                if (!r.success) return r.message;
                say(`Din förfrågan om att vara med i <b>${esc(p.name)}</b> är skickad.`); await load(); return true;
            });
    }
    async function withdraw(p) {
        const r = await post('WithdrawMyRequest', { id: p.id });
        if (!r.success) { say(esc(r.message), 'danger'); return; }
        say('Förfrågan är tillbakadragen.'); await load();
    }
    function leave(p) {
        dialog('Lämna planeringen?', `<p>Du lämnar <b>${esc(p.name)}</b> och får inga fler mejl därifrån. Dina meddelanden står kvar.</p>`, 'Lämna', async () => {
            const r = await post('RemoveParticipant', { id: p.id, participantId: p.participantId });
            if (!r.success) return r.message;
            say(`Du har lämnat ${esc(p.name)}.`); await load(); return true;
        }, 'btn-danger');
    }
    // Sajtadmin som SUPPORT: godkänner eller avböjer, men ser inget av planeringens innehåll.
    async function support(p) {
        const r = await req('/umbraco/surface/Planning/Requests?' + new URLSearchParams({ id: p.id }));
        if (!r.success) { say(esc(r.message || 'Det gick inte.'), 'danger'); return; }
        const pend = r.requests.filter(x => x.status === 'Pending');
        dialog('Förfrågningar — ' + p.name, `<p class="small text-muted">Du hanterar förfrågningarna som sajtens administratör (support). Det loggas. Du ser inget av planeringens innehåll.</p>
            ${pend.length ? pend.map(x => `<div class="border rounded p-2 mb-2" data-sup="${x.id}"><div><b>${esc(x.name)}</b> ${x.club ? '<span class="small text-muted">(' + esc(x.club) + ')</span>' : ''}</div>
                <div class="small">${x.kind === 'Invite' ? 'Har tackat ja till inbjudan' : 'Ber om att få vara med'}${x.message && x.kind === 'Request' ? ': ”' + esc(x.message) + '”' : ''}</div>
                <div class="row g-2 mt-1"><div class="col-sm-5"><select class="form-select form-select-sm" data-sup-level aria-label="Nivå">${LEVELS.map(([v, l]) => `<option value="${v}"${v === 'Participant' ? ' selected' : ''}>${l}</option>`).join('')}</select></div>
                    <div class="col-sm-7"><input class="form-control form-control-sm" data-sup-rep maxlength="200" value="${esc(x.proposedRepresents || '')}" placeholder="Företräder (valfritt)" aria-label="Företräder"></div></div>
                <div class="d-flex gap-2 mt-2"><button type="button" class="btn btn-primary btn-sm" data-sup-ok="${x.id}">Godkänn</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-sup-no="${x.id}">Avböj</button></div></div>`).join('') : '<p class="mb-0">Inga förfrågningar väntar.</p>'}`, null);
        $('plhDlgBody').onclick = async ev => {
            const okb = ev.target.closest('[data-sup-ok]'), nob = ev.target.closest('[data-sup-no]');
            if (!okb && !nob) return;
            const box = ev.target.closest('[data-sup]');
            const res = okb
                ? await post('ApproveRequest', { id: p.id, requestId: box.dataset.sup, access: box.querySelector('[data-sup-level]').value, representsText: box.querySelector('[data-sup-rep]').value })
                : await post('RejectRequest', { id: p.id, requestId: box.dataset.sup });
            if (!res.success) { $('plhDlgErr').textContent = res.message; $('plhDlgErr').classList.remove('d-none'); return; }
            box.innerHTML = `<span class="text-success">${okb ? 'Godkänd' : 'Avböjd'}.</span>`;
            load();
        };
    }

    async function load() {
        try {
            data = await req('/umbraco/surface/Planning/MyPlannings');
            if (!data.success) { $('plhList').innerHTML = `<p class="text-danger">${esc(data.message)}</p>`; return; }
            render();
        } catch (e) { $('plhList').innerHTML = `<p class="text-danger">${esc(e.message)}</p>`; }
    }
    $('plhNew').addEventListener('click', () => {
        $('plhErr').classList.add('d-none');
        const m = bootstrap.Modal.getOrCreateInstance($('plhModal')); m.show();
        $('plhModal').addEventListener('shown.bs.modal', () => $('plhName').focus(), { once: true });
    });
    // Omgång 3 (K8): "16 maj 2027" blev tyst 1 januari — den gemensamma tolkningen läser svenska datum och gör fältet rött annars.
    ['plhStart', 'plhEnd'].forEach(id => window.hpskPlDatePicker ? window.hpskPlDatePicker($(id))
        : window.flatpickr && window.flatpickr($(id), { locale: 'sv', dateFormat: 'Y-m-d', allowInput: true }));
    $('plhCreate').addEventListener('click', async () => {
        const btn = $('plhCreate');
        const dates = ['plhStart', 'plhEnd'].map(id => window.hpskPlParseDate ? window.hpskPlParseDate($(id).value) : $(id).value.trim());
        if (dates.some(d => d === null)) {
            $('plhErr').textContent = 'Ett datum går inte att läsa. Skriv till exempel 16 maj 2027 eller 2027-05-16.';
            $('plhErr').classList.remove('d-none'); return;
        }
        btn.disabled = true;
        try {
            const body = new URLSearchParams({ name: $('plhName').value, targetText: $('plhTarget').value,
                targetStart: dates[0], targetEnd: dates[1], discipline: $('plhDisc').value });
            const r = await req('/umbraco/surface/Planning/Create', { method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': tok() }, body: body.toString() });
            if (!r.success) { $('plhErr').textContent = r.message; $('plhErr').classList.remove('d-none'); $('plhErr').scrollIntoView({ block: 'nearest' }); return; }
            location.href = r.url + '#vy=oversikt';
        } catch (e) { $('plhErr').textContent = e.message; $('plhErr').classList.remove('d-none'); $('plhErr').scrollIntoView({ block: 'nearest' }); }
        finally { btn.disabled = false; }
    });
    load();
})();
</script>
