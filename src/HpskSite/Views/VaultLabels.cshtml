@model HpskSite.Controllers.VaultLabelsModel
@{
    Layout = null;
}
@*
    /valvet/etiketter — ett ark med en QR-etikett per lånevapen, att laminera och sätta på vapnen.

    ⚠️ PÅ VAPNET, INTE PÅ HYLLPLATSEN (Stefans beslut 2026-09-02). Ett vapen som läggs tillbaka på
    fel plats gör en hylletikett direkt felaktig — hyllplatsen är föränderligt tillstånd som ingen
    underhåller, vapnet är identiteten.

    ⚠️ NUMRET TRYCKS STORT intill koden. Numret är skyttens ord för vapnet ("jag har alltid nr 7"),
    och etiketten ska gå att läsa även av den som inte skannar.

    Etiketterna är avsiktligt ENKLA att skriva ut på vanligt papper och klippa — inte beroende av
    ett etikettark med en bestämd layout, som ingen klubb har.

    ⚠️⚠️ MÅTTEN ÄR I MILLIMETER, OCH DET ÄR FUNKTIONEN — INTE FORMGIVNING. En etikett ska få plats
    på ett vapen: på lådans sida, på kolven, i en kolvkåpa. Sätts QR-koden i rem eller px avgör
    webbläsarens px-till-mm-omräkning hur stor den blir på papperet, och den varierar mellan
    skrivare och zoomnivå — alltså blir den fysiska modulstorleken en slump. I mm är den mätbar:
    29 moduler + 8 modulers tyst zon över 18 mm ger ~0,49 mm per modul, precis över vad en
    mobilkamera läser pålitligt.

    ⚠️ KRYMP INTE .lab img UNDER 15 mm. Under det går modulen under 0,4 mm och koden blir en kod
    som läses i bra ljus av en ny telefon — alltså en som fallerar i ett valv, i mörker, för den
    som redan är osäker på tekniken. Behöver etiketten bli mindre än så är rätt åtgärd en kortare
    adress, inte en mindre kod.

    ⚠️ KODEN ÄR SVG, inte PNG. En rastrerad QR skalas ner av skrivaren och varje modulkant blir en
    gråskala — vid 18 mm är det skillnaden mellan en kod som läses direkt och en som kräver tre
    försök. Vektorn tar skrivarens egen upplösning.

    ⚠️ ADRESSEN TRYCKS ALDRIG SYNLIGT. Den bärs i data-label-url för felsökning och verifiering.
    Koden i den är hemligheten som gör att man måste stå framför vapnet för att kunna checka ut
    det — läsbar på ett foto av valvet vore den ingen hemlighet alls.
*@
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Vapenetiketter — @Model.ClubName</title>
    <style>
        :root { color-scheme: light; }
        body { font-family: "Segoe UI", system-ui, sans-serif; color: #111; background: #fff;
               margin: 0; padding: 1.5rem; }
        h1 { font-size: 1.25rem; margin: 0 0 .25rem; }
        .lead { color: #555; font-size: .875rem; margin: 0 0 1.25rem; max-width: 40rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, 46mm); gap: 3mm; }
        .lab { border: 1px dashed #999; border-radius: 1mm; padding: 2mm;
               display: flex; align-items: center; gap: 2mm; break-inside: avoid;
               width: 46mm; box-sizing: border-box; }
        .lab img { width: 18mm; height: 18mm; flex: 0 0 18mm; }
        .lab-text { min-width: 0; }
        .nr { font-size: 6mm; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
        .alias { font-size: 2.6mm; color: #444; line-height: 1.2;
                 overflow: hidden; text-overflow: ellipsis; }
        .brand { font-size: 2.1mm; color: #777; letter-spacing: .04em; text-transform: uppercase;
                 margin-top: .8mm; }
        .empty { border: 1px solid #ddd; padding: 1rem; border-radius: .25rem; color: #555; }
        .noprint button { font-size: 1rem; padding: .5rem 1rem; }
        @@media print { .noprint { display: none !important; } body { padding: .5rem; } }
    </style>
</head>
<body>
    @* ⚠️ RUBRIKEN MÅSTE STÄMMA MED URVALET. Rapporterat från prod 2026-09-02: sidan hette
       "Vapenetiketter — Varbergs Pistolklubb" för någon som tryckte på knappen inne i Falkenbergs
       administration, alltså ett ark med FEL klubbs vapen att klistra på rätt klubbs vapen. Den
       buggen låg i routens parameternamn, men rubriken var det enda som avslöjade den — därför
       står klubbnamnet kvar stort, och när sidan bara bär ETT vapen säger den det också. *@
    @if (Model.SingleFirearmId > 0 && Model.Firearms.Count == 1)
    {
        var one = Model.Firearms[0];
        <h1>Etikett för @(one.Number.HasValue ? $"nr {one.Number}" : one.Alias) — @Model.ClubName</h1>
        @* ⚠️ TEXTEN FÅR INTE LOVA ATT SKYTTEN SKANNAR TILLBAKA VAPNET. Den gjorde det, och det
           var fel: en skanning kan bara lägga ansvar PÅ skytten, aldrig ta bort det. Se
           kommentaren i det andra fallet nedan. *@
        <p class="lead">
            Klipp ut, laminera och sätt etiketten <strong>på vapnet</strong>. Skytten skannar den
            <strong>när hen hämtar vapnet</strong> — då registreras lånet på rätt vapen.
            Etiketten slutar aldrig gälla, så den behöver bara skrivas ut en gång.
        </p>
        <p class="lead">
            <strong>Återlämningen registrerar du</strong>, i valvet. Skytten kan inte stänga sitt
            eget lån.
        </p>
    }
    else
    {
        <h1>Vapenetiketter — @Model.ClubName</h1>
        @* ⚠️⚠️ TEXTEN LOVADE ATT SKYTTEN SKANNAR TILLBAKA VAPNET, och det var både felaktigt
           och farligt att skriva på ett papper som sitter i ett vapenvalv. Skanningen kan bara
           LÄGGA ansvar på skytten — att låta samma kod stänga lånet hade gjort att den enda person
           som har intresse av att lånet ser stängt ut också var den som kunde stänga det. Ett
           falskt "återlämnat" är det enda felet ett vapenregister inte får ha. *@
        <p class="lead">
            Klipp ut, laminera och sätt <strong>en etikett på varje vapen</strong>. Skytten skannar
            sin etikett <strong>när hen hämtar vapnet</strong> — då registreras lånet på rätt vapen,
            även om hen inte bokat i förväg. Etiketterna slutar aldrig gälla, så de behöver bara
            skrivas ut en gång.
        </p>
        <p class="lead">
            <strong>Återlämningen registrerar du</strong>, i valvet: <em>Tillbaka</em> på raden, eller
            <em>Kvällen är klar</em> när du låser. Skytten kan inte stänga sitt eget lån — det är du
            som tar emot vapnet, så det är bara du som kan bekräfta att det är tillbaka i skåpet.
        </p>
    }

    <p class="noprint"><button type="button" onclick="window.print()">Skriv ut</button></p>

    @if (Model.Firearms.Count == 0)
    {
        <div class="empty">
            @if (Model.SingleFirearmId > 0)
            {
                <text>
                    Vapnet är inte markerat som <strong>lånebart</strong>, så det har ingen etikett.
                    Ett vapen som inte kan lånas har inget att skanna.
                </text>
            }
            else
            {
                <text>
                    Klubben har inga vapen markerade som <strong>lånebara</strong>. Markera dem under
                    Klubbadministration → Klubben → Klubbvapen, så kommer etiketterna hit.
                </text>
            }
        </div>
    }
    else
    {
        <div class="grid">
            @foreach (var f in Model.Firearms)
            {
                <div class="lab" data-label-url="@f.Url" data-firearm-id="@f.FirearmId">
                    @* Bilden hämtas per vapen, som SVG. Går den inte att skapa försvinner den i
                       stället för att lämna en trasig bildikon på ett ark som ska lamineras. *@
                    <img src="/umbraco/surface/FirearmAdmin/GetFirearmLabelQr?clubId=@Model.ClubId&firearmId=@f.FirearmId"
                         alt="" onerror="this.remove()">
                    <div class="lab-text">
                        <div class="nr">@(f.Number.HasValue ? $"nr {f.Number}" : f.Alias)</div>
                        @if (f.Number.HasValue)
                        {
                            <div class="alias">@f.Alias@(string.IsNullOrEmpty(f.WeaponClass) ? "" : $" · {f.WeaponClass}")</div>
                        }
                        <div class="brand">pistol.nu · lånevapen</div>
                    </div>
                </div>
            }
        </div>
    }
</body>
</html>
