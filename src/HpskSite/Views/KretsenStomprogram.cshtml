@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    var year = ViewData["StomYear"] is int y ? y : DateTime.Today.Year;
    ViewBag.Title = "Förbundets stomprogram";
}

@* Kretsgranskning fas 4: Förbundets stomprogram — SM, landsdelsmästerskap och rikstävlingar som
   kretsarna ska undvika att lägga tävlingar på. Sajtadmin för in årets datum; kretskalendrarna
   visar dem som bakgrund och varnar (aldrig stopp) när en tävling i samma gren ligger samma dag.
   En rad utan gren gäller alla grener. *@
@await Html.PartialAsync("_HtmlEscape")

<div class="container" style="max-width:900px; padding:1.5rem 0 4rem; font-size:1.05rem;">
    @Html.AntiForgeryToken()
    <h1 class="mb-1" style="font-size:1.7rem;font-weight:700;"><i class="bi bi-calendar-range me-2"></i>Förbundets stomprogram</h1>
    <p class="text-muted">Årets fasta datum i Förbundets tävlingsprogram. Kretskalendrarna visar dem och varnar när en tävling i samma gren läggs samma dag. En rad utan gren gäller alla grener.</p>

    <div class="d-flex align-items-center gap-2 mb-3">
        <label class="form-label mb-0" for="spYear">År</label>
        <select class="form-select w-auto" id="spYear"></select>
    </div>

    <div id="spList"><div class="text-muted">Hämtar…</div></div>

    <div class="card mt-4 d-none" id="spAddCard">
        <div class="card-body">
            <h2 class="h6">Lägg till datum</h2>
            <p class="small text-muted mb-2">En rad per datum: <code>datum; namn; gren</code>. Grenen kan utelämnas (= alla grener). Ett flerdagarsdatum skrivs <code>2027-06-12–2027-06-13</code>. Rader kopierade ur ett kalkylblad (tabbar) fungerar också.</p>
            <textarea class="form-control font-monospace mb-2" id="spText" rows="6" placeholder="2027-06-12–2027-06-13; SM fältskytte; Fältskytte&#10;2027-08-21; SM precision; Precision&#10;2027-09-04; Förbundsmöte"></textarea>
            <button type="button" class="btn btn-primary" id="spAdd">Lägg till</button>
            <div id="spResult" class="mt-2" role="status"></div>
        </div>
    </div>
</div>

<script>
(function () {
    const $ = id => document.getElementById(id);
    const esc = s => window.hpskEsc(s == null ? '' : String(s));
    const token = () => document.querySelector('input[name="__RequestVerificationToken"]').value;
    let year = @year, canEdit = false;
    const sel = $('spYear');
    const now = new Date().getFullYear();
    for (let y = now - 1; y <= now + 3; y++) sel.insertAdjacentHTML('beforeend', '<option value="' + y + '"' + (y === year ? ' selected' : '') + '>' + y + '</option>');
    sel.addEventListener('change', () => { year = +sel.value; load(); });

    const post = (a, body) => fetch('/umbraco/surface/CompetitionApplication/' + a, {
        method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
        body: new URLSearchParams(body).toString()
    }).then(r => r.json());

    function load() {
        return fetch('/umbraco/surface/CompetitionApplication/GetStomprogram?year=' + year, { credentials: 'same-origin' }).then(r => r.json()).then(d => {
            if (!d.success) { $('spList').innerHTML = '<div class="alert alert-warning">' + esc(d.message) + '</div>'; return; }
            canEdit = d.canEdit;
            $('spAddCard').classList.toggle('d-none', !canEdit);
            if (!d.items.length) { $('spList').innerHTML = '<div class="alert alert-light border" id="spEmpty">Inget stomprogram är infört för ' + year + '.</div>'; return; }
            $('spList').innerHTML = '<div class="table-responsive"><table class="table align-middle" id="spTable"><thead><tr><th>Datum</th><th>Namn</th><th>Gren</th>' + (canEdit ? '<th></th>' : '') + '</tr></thead><tbody>'
                + d.items.map(i => '<tr data-sp-row="' + i.id + '"><td class="text-nowrap">' + esc(i.start) + (i.end ? ' – ' + esc(i.end) : '') + '</td><td>' + esc(i.name) + '</td><td>' + esc(i.disciplineLabel) + '</td>'
                    + (canEdit ? '<td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm" data-sp-del="' + i.id + '">Ta bort</button></td>' : '') + '</tr>').join('')
                + '</tbody></table></div>';
        }).catch(() => { $('spList').innerHTML = '<div class="alert alert-warning">Stomprogrammet kunde inte hämtas.</div>'; });
    }

    $('spAdd').addEventListener('click', () => {
        const res = $('spResult');
        post('AddStomprogram', { text: $('spText').value }).then(r => {
            res.className = 'mt-2 alert py-2 ' + (r.success ? 'alert-success' : 'alert-warning');
            res.innerHTML = esc(r.message || '') + (r.errors && r.errors.length ? '<ul class="mb-0 mt-1">' + r.errors.map(e => '<li>' + esc(e) + '</li>').join('') + '</ul>' : '');
            if (r.success) { $('spText').value = ''; load(); }
        });
    });
    document.addEventListener('click', e => {
        const b = e.target.closest('[data-sp-del]');
        if (!b) return;
        post('DeleteStomprogram', { id: b.dataset.spDel }).then(r => { if (r.success) load(); });
    });
    load();
})();
</script>
