@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8 prose">
        <h1 class="mb-4"><i class="bi bi-shield-check me-2"></i>Integritetspolicy</h1>

        <p class="lead mb-4">
            Denna integritetspolicy beskriver hur dina personuppgifter samlas in, används och
            skyddas när du använder webbplatsen Pistol.nu.
        </p>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-building me-2"></i>Personuppgiftsansvarig</h2>
            </div>
            <div class="card-body">
                <p>
                    Personuppgiftsansvarig för de uppgifter som behandlas i samband med ditt medlemskap
                    är den eller de föreningar (klubbar) där du är registrerad som medlem. Varje förening
                    ansvarar självständigt för behandlingen av sina medlemmars personuppgifter i enlighet
                    med gällande dataskyddslagstiftning.
                </p>
                <p class="mb-0">
                    <strong>Kontaktuppgifter:</strong> Kontaktinformation till din förening finns på
                    respektive klubbs sida på denna webbplats. Om kontaktuppgifter saknas kan du
                    kontakta <a href="mailto:admin@pistol.nu">admin@pistol.nu</a> för vägledning.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-hdd-network me-2"></i>Pistol.nu som personuppgiftsbiträde</h2>
            </div>
            <div class="card-body">
                <p>
                    Webbplatsen Pistol.nu drivs som en tjänst åt föreningarna. I dataskydds&shy;lagstiftningens
                    mening är Pistol.nu <strong>personuppgiftsbiträde</strong> som behandlar uppgifter
                    <strong>på uppdrag av</strong> din förening, vilken är personuppgiftsansvarig.
                </p>
                <p class="mb-0">
                    Behandlingen sker <strong>endast inom ramen för tjänsten</strong> – för att tillhandahålla
                    medlems-, tränings- och tävlingsfunktionerna – och enligt föreningens instruktioner.
                    Vi använder <strong>aldrig</strong> dina uppgifter för egna ändamål, vi säljer dem inte
                    vidare och vi använder dem inte för reklam eller profilering. Förhållandet mellan
                    Pistol.nu och varje förening regleras i ett <strong>personuppgiftsbiträdesavtal</strong>.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-collection me-2"></i>Vilka uppgifter vi samlar in</h2>
            </div>
            <div class="card-body">
                <p>Vi samlar in följande personuppgifter:</p>
                <ul>
                    <li><strong>Kontaktuppgifter:</strong> Namn, e-postadress, telefonnummer, adress</li>
                    <li><strong>Identifikation:</strong> Personnummer (för tävlingsregistrering), pistolkortnr</li>
                    <li><strong>Klubbtillhörighet:</strong> Vilken eller vilka klubbar du är medlem i</li>
                    <li><strong>Tävlingsdata:</strong> Tävlingsanmälningar, resultat och skytteklasser</li>
                    <li><strong>Träningsdata:</strong> Träningsresultat, framsteg i Skyttetrappan</li>
                    <li><strong>Tekniska uppgifter:</strong> Senaste aktivitet på webbplatsen</li>
                </ul>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-phone me-2"></i>Mobilappen</h2>
            </div>
            <div class="card-body">
                <h6 class="mt-3">Kameraåtkomst</h6>
                <p class="mb-0">
                    Appen begär tillgång till din kamera för att skanna QR-koder
                    när du går med i en träningsmatch samt för att fotografera tavlor
                    vid resultatregistrering. Tavelbilderna laddas upp till servern och
                    är synliga för alla som har tillgång till träningsmatchen.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-question-circle me-2"></i>Varför vi samlar in uppgifter</h2>
            </div>
            <div class="card-body">
                <p>Dina personuppgifter används för att:</p>
                <ul>
                    <li>Administrera ditt medlemskap i föreningen</li>
                    <li>Hantera tävlingsanmälningar och publicera resultat</li>
                    <li>Föra träningsstatistik och spåra framsteg</li>
                    <li>Skicka viktig information om tävlingar och föreningsaktiviteter</li>
                    <li>Uppfylla krav från Svenska Pistolskytteförbundet</li>
                </ul>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-file-earmark-text me-2"></i>Rättslig grund</h2>
            </div>
            <div class="card-body">
                <p>Dina personuppgifter behandlas baserat på:</p>
                <ul>
                    <li><strong>Avtal:</strong> För att fullgöra föreningens åtagande gentemot dig som medlem</li>
                    <li><strong>Berättigat intresse:</strong> För att administrera föreningsverksamheten</li>
                    <li><strong>Samtycke:</strong> Endast för vissa frivilliga funktioner, t.ex. utskick du själv valt att ta emot. Kärnbehandlingen av ditt medlemskap bygger inte på samtycke.</li>
                    <li><strong>Rättslig förpliktelse:</strong> Krav från idrottsförbund och myndigheter</li>
                </ul>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-clock-history me-2"></i>Hur länge vi sparar uppgifter</h2>
            </div>
            <div class="card-body">
                <ul>
                    <li><strong>Medlemsuppgifter:</strong> Så länge du är aktiv medlem, plus en rimlig tid därefter</li>
                    <li><strong>Tävlingsresultat:</strong> Sparas för historiska ändamål (resultatarkiv)</li>
                    <li><strong>Träningsdata:</strong> Sparas så länge du är aktiv medlem</li>
                    <li><strong>Betalningsuppgifter:</strong> Enligt bokföringslagen (7 år)</li>
                </ul>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-box-arrow-right me-2"></i>Vad som händer med dina uppgifter vid avslut</h2>
            </div>
            <div class="card-body">
                <p>Om ditt medlemskap upphör, eller om en förening slutar använda Pistol.nu:</p>
                <ul>
                    <li><strong>Export:</strong> Föreningen kan inför ett avslut få ut sina medlemmars uppgifter i ett maskinläsbart format. Du som medlem kan när som helst begära ett utdrag av dina egna uppgifter (se Dina rättigheter nedan).</li>
                    <li><strong>Radering:</strong> När uppgifterna inte längre behövs för det ändamål de samlades in för raderas de inom rimlig tid. Vid en förenings avslut raderas eller återlämnas uppgifterna enligt det som avtalats med föreningen.</li>
                    <li><strong>Lagstadgade undantag:</strong> Vissa uppgifter måste sparas längre enligt lag – t.ex. betalnings- och bokföringsunderlag (7 år enligt bokföringslagen). Officiella tävlingsresultat bevaras dessutom i resultatarkiv av historiska skäl.</li>
                </ul>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-person-check me-2"></i>Dina rättigheter</h2>
            </div>
            <div class="card-body">
                <p>Enligt GDPR har du följande rättigheter:</p>
                <ul>
                    <li><strong>Rätt till tillgång:</strong> Du kan begära att få veta vilka uppgifter vi har om dig</li>
                    <li><strong>Rätt till rättelse:</strong> Du kan begära att felaktiga uppgifter rättas</li>
                    <li><strong>Rätt till radering:</strong> Du kan begära att dina uppgifter raderas</li>
                    <li><strong>Rätt till begränsning:</strong> Du kan begära begränsad behandling av dina uppgifter</li>
                    <li><strong>Rätt till dataportabilitet:</strong> Du kan begära att få dina uppgifter i ett maskinläsbart format</li>
                </ul>
                <div class="alert alert-info mt-3 mb-0">
                    <i class="bi bi-envelope me-2"></i>
                    För att utöva dina rättigheter, kontakta i första hand din förening.
                    Kontaktuppgifter finns på respektive klubbs sida. Om du inte hittar
                    kontaktuppgifter kan du vända dig till <a href="mailto:admin@pistol.nu">admin@pistol.nu</a>
                    för vägledning.
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-cookie me-2"></i>Cookies</h2>
            </div>
            <div class="card-body">
                <p>Vi använder endast nödvändiga cookies för att:</p>
                <ul>
                    <li>Hålla dig inloggad på webbplatsen</li>
                    <li>Komma ihåg dina inställningar (t.ex. ljust/mörkt läge)</li>
                </ul>
                <p>
                    Vi använder inga tredjepartscookies för reklam eller spårning.
                </p>
                <p class="mb-0">
                    Vissa sidor laddar resurser från externa leverantörer (t.ex. kart&shy;tjänster och
                    script-bibliotek via CDN). Dessa kan behandla tekniska uppgifter som IP-adress för att
                    leverera innehållet, men används inte för spårning.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-shield-lock me-2"></i>Säkerhet</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Vi vidtar lämpliga tekniska och organisatoriska åtgärder för att skydda dina
                    personuppgifter mot obehörig åtkomst, förlust eller förstöring. All kommunikation
                    med webbplatsen sker via krypterad HTTPS-anslutning.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-diagram-3 me-2"></i>Underbiträden och driftleverantörer</h2>
            </div>
            <div class="card-body">
                <p>
                    För att kunna leverera tjänsten anlitar vi ett fåtal noggrant utvalda leverantörer
                    som behandlar personuppgifter på vårt uppdrag (underbiträden). Samtliga är bundna av
                    avtal som ålägger dem minst samma skyddsnivå som denna policy beskriver, och de får
                    bara behandla uppgifterna för att leverera sin del av tjänsten.
                </p>
                <ul>
                    <li><strong>Drift och databas:</strong> Simply.com (Danmark, EU) – webb- och databasdrift.</li>
                    <li><strong>E-post:</strong> Brevo (Frankrike, EU) – aviseringar, kvitton och föreningsutskick.</li>
                    <li><strong>AI-assistenten (frivillig hjälpfunktion):</strong> Mistral AI (Frankrike, EU) – behandlar de frågor du skriver i chatten. Skriv inte personuppgifter i chatten.</li>
                </ul>
                <p class="mb-0">
                    En aktuell och fullständig förteckning över underbiträden biläggs det
                    personuppgiftsbiträdesavtal som ingås med din förening.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-globe-europe-africa me-2"></i>Var dina uppgifter lagras</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Alla dina personuppgifter lagras och behandlas <strong>inom EU/EES</strong>. Vi
                    överför <strong>inte</strong> dina personuppgifter till länder utanför EU/EES.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-shield-exclamation me-2"></i>Personuppgiftsincidenter</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Om en personuppgiftsincident inträffar – t.ex. obehörig åtkomst till, förlust av eller
                    förändring av uppgifter – informerar vi den berörda föreningen <strong>utan onödigt
                    dröjsmål</strong> efter att vi fått kännedom om incidenten. Det gör att föreningen kan
                    fullgöra sin eventuella anmälningsskyldighet till Integritetsskyddsmyndigheten (inom
                    72 timmar) och vid behov informera dig. Vi bistår föreningen med den information och de
                    åtgärder som behövs för att hantera incidenten.
                </p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h5 mb-0"><i class="bi bi-envelope me-2"></i>Kontakt</h2>
            </div>
            <div class="card-body">
                <p>
                    Om du har frågor om hur dina personuppgifter hanteras, kontakta i första hand
                    den förening där du är medlem. Kontaktuppgifter finns på respektive klubbs sida
                    på denna webbplats.
                </p>
                <p class="mb-0">
                    Om du inte hittar kontaktuppgifter till din förening kan du kontakta
                    <a href="mailto:admin@pistol.nu">admin@pistol.nu</a> för vägledning.
                </p>
            </div>
        </div>

        <div class="card mb-4 border-warning">
            <div class="card-header bg-warning text-dark">
                <h2 class="h5 mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Tillsynsmyndighet</h2>
            </div>
            <div class="card-body">
                <p class="mb-0">
                    Om du anser att vi behandlar dina personuppgifter felaktigt har du rätt att
                    lämna klagomål till <a href="https://www.imy.se" target="_blank" rel="noopener">
                    Integritetsskyddsmyndigheten (IMY)</a>.
                </p>
            </div>
        </div>

        <p class="text-muted small">
            <i class="bi bi-calendar me-1"></i>Senast uppdaterad: 2026-06-05
        </p>
    </div>
</div>
