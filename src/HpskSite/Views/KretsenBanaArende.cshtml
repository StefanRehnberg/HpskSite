@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    var token = ViewData["ArendeToken"] as string ?? "";
    ViewBag.Title = "Kretsens granskning av banan";
}

@* Kretsgranskning fas 3 — länkläget för bangranskningen. En krets utan bangranskare får banan som
   en länk utan inloggning. Länken gäller EN granskning i 60 dagar och slutar gälla om banan ändras
   (servern jämför kontrollsumman). Ärendet renderas av _CourseReviewCase, samma funktion som
   kretsens inkorg. Länken till stationsbeskrivningarna bär samma token. *@

<div class="container" style="max-width:860px; padding:1.5rem 0 4rem; font-size:1.08rem;">
    @Html.AntiForgeryToken()
    <h1 class="mb-3" style="font-size:1.7rem;font-weight:700;"><i class="bi bi-signpost-split me-2"></i>Kretsens granskning av banan</h1>
    <div class="alert alert-light border small" id="craNudge">
        <i class="bi bi-lightbulb me-1"></i>Utser kretsen en bangranskare på pistol.nu hamnar banorna direkt hos den personen, med en knapp i mejlet.
        <a href="#" id="craKomIgang">Jag vill bli kretsens bangranskare</a>
    </div>
    <div id="craContent"><div class="text-muted">Hämtar…</div></div>
</div>

@await Html.PartialAsync("_CourseReviewCase")
<script>
(function () {
    const T = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(token));
    const box = document.getElementById('craContent');
    fetch('/umbraco/surface/CourseReview/GetByLink?t=' + encodeURIComponent(T)).then(r => r.json()).then(d => {
        if (!d.success) { box.innerHTML = '<div class="alert alert-warning" id="craInvalid">' + window.hpskEsc(d.message) + '</div>'; return; }
        if (d.region) document.getElementById('craKomIgang').href = '/kretsen/kom-igang?krets=' + d.region.id;
        window.hpskRenderCourseCase(box, d, { mode: 'lank', token: T });
    }).catch(() => { box.innerHTML = '<div class="alert alert-warning">Granskningen kunde inte hämtas. Försök igen om en stund.</div>'; });
})();
</script>
