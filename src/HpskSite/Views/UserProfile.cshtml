                        <option value="NationellHelmatch">Nationell Helmatch</option>
                        <option value="MagnumPrecision">Magnum Precision</option>
                        <option value="Faltskytte" selected>Fältskytte</option>
                    </select>
                    <select class="form-select form-select-sm" style="width:auto;" onchange="onFaltYearChange(this)">
                        ${years.map(y => `<option value="${y}" ${y === _faltSelectedYear ? 'selected' : ''}>${y}</option>`).join('')}
