                        <th class="text-center"></th>
                    </tr>
                </thead>
                <tbody>
                ${rows.map(r => {
                    const dateStr = new Date(r.date).toLocaleDateString('sv-SE');
                    const compLink = r.source === 'Hosted' && r.competitionId
                        ? `<a href="/competitions/${r.competitionId}">${escapeHtml(r.competitionName)}</a>`
                        : escapeHtml(r.competitionName);
                    const actions = r.source === 'External'
                        ? `<button class="btn btn-sm btn-outline-secondary me-1" data-fs-row='${escapeHtml(JSON.stringify(r))}' onclick='_faltEditFromButton(this)' title="Redigera"><i class="bi bi-pencil"></i></button>
                           <button class="btn btn-sm btn-outline-danger" onclick="deleteFaltskytteScore(${r.trainingScoreId})" title="Ta bort"><i class="bi bi-trash"></i></button>`
                        : `<span class="text-muted" title="Officiellt resultat — kan inte redigeras"><i class="bi bi-lock"></i></span>`;
                    const hitClass = r.hitPercent >= 80 ? 'fw-semibold text-success'
                                  : r.hitPercent >= 60 ? 'fw-semibold'
                                  : '';
                    return `
                        <tr>
                            <td>${_faltSourceIcon(r)}${dateStr}</td>
                            <td>${compLink}<span class="ms-1 text-muted small">· ${_faltModeLabel(r.mode)}</span></td>
