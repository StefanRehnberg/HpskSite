                            <button type="button" class="btn btn-outline-secondary active" data-metric="hit" onclick="renderFaltskytteChart('hit', this)">Träff %</button>
                            <button type="button" class="btn btn-outline-secondary" data-metric="figure" onclick="renderFaltskytteChart('figure', this)">Figur %</button>
                            <button type="button" class="btn btn-outline-secondary" data-metric="placement" onclick="renderFaltskytteChart('placement', this)">Placering %</button>
                        </div>
