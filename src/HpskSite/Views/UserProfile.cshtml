document.getElementById('marken-tab')?.addEventListener('shown.bs.tab', loadMarkenTab);
['guldserieModal', 'snabbserieModal', 'proofSerieModal'].forEach(id => {
    document.getElementById(id)?.addEventListener('hidden.bs.modal', markenStopStatusPoll);
});

function loadResults() {
    const content = document.getElementById('resultsContent');
    if (!content) return;

    // Show loading state
    content.innerHTML = `
        <div class="text-center py-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Laddar...</span>
            </div>
        </div>
    `;

    const competitionType = document.getElementById('competitionTypeFilter')?.value || 'Precision';
    const year = document.getElementById('yearFilter')?.value || new Date().getFullYear();
    const weaponClass = document.getElementById('weaponClassFilter')?.value || 'Alla';

    // (Standardmedaljer + Märken moved to the "Medaljer & Märken" tab — loaded by loadMarkenTab.)

    fetch(`/umbraco/surface/Member/GetMemberResults?competitionType=${competitionType}&year=${year}&weaponClass=${weaponClass}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                if (competitionType === 'Faltskytte') {
                    renderFaltskytteResultsTable(data.results || []);
                } else {
                    renderResultsTable(data.results);
                }
            } else {
                content.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i> ${data.message || 'Kunde inte ladda resultat'}
                    </div>
                `;
            }
        })
        .catch(error => {
            console.error('Error loading results:', error);
            content.innerHTML = `
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle"></i> Fel vid inläsning av resultat
                </div>
            `;
        });
}

// Standard-medal cell: the S/B badge plus a proof cue (only meaningful when a medal was won).
function renderStmCell(r) {
    if (r.stdMedal !== 'S' && r.stdMedal !== 'B') return '';
    const badge = r.stdMedal === 'S'
        ? '<span class="badge" style="background-color:#9ca3af;" title="Silver">S</span>'
        : '<span class="badge" style="background-color:#cd7f32;" title="Brons">B</span>';
    let cue = '';
    if (r.proofStatus === 'has') {
        cue = ' <i class="bi bi-paperclip text-success" title="Bevis finns"></i>';
    } else if (r.proofStatus === 'missing') {
        cue = ' <i class="bi bi-exclamation-triangle-fill text-warning" title="Saknar bevis – öppna resultatet och ladda upp"></i>';
    }
    return badge + cue;
}

function renderResultsTable(results) {
