                            <td class="text-center">${_faltMedalIcon(r.standardMedal)}${_faltProofCue(r)}</td>
                            <td class="text-center">${actions}</td>
                        </tr>`;
                }).join('')}
                </tbody>
            </table>
        </div>
        <div class="text-muted mt-2"><small><i class="bi bi-info-circle"></i> Visar ${rows.length} resultat</small></div>`;
    content.innerHTML = html;
