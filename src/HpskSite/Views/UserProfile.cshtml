@* ── Guldserie entry modal (5-shot keypad) ── *@
<div class="modal fade" id="guldserieModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-bullseye text-warning"></i> Ny guldserie</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div id="gsForm">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small mb-1">Vapengrupp</label>
                            <select id="gsWeapon" class="form-select" onchange="gsUpdateThreshold()">
                                <option value="C">C – kal .22</option>
                                <option value="A">A – grovpistol</option>
                                <option value="B">B – kal .32–.45</option>
                                <option value="R">R – revolver</option>
                            </select>
                        </div>
                        <div class="col-6" id="gsClubWrap" style="display:none;">
                            <label class="form-label small mb-1">Klubb (för validering)</label>
                            <select id="gsClub" class="form-select"></select>
                        </div>
                    </div>
                    <div class="text-center small text-muted mb-2" id="gsThresholdNote"></div>

                    <div class="shot-display mb-3">
                        <div class="shot-circles">
                            <span class="shot-circle" id="gs-circle-0">_</span>
                            <span class="shot-circle" id="gs-circle-1">_</span>
                            <span class="shot-circle" id="gs-circle-2">_</span>
                            <span class="shot-circle" id="gs-circle-3">_</span>
                            <span class="shot-circle" id="gs-circle-4">_</span>
                        </div>
                        <div class="mt-2 text-center"><strong>Totalt: <span id="gsTotal">0</span> p</strong></div>
                    </div>

                    <div class="gs-keypad mb-3">
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('X')">X</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('10')">10</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('9')">9</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('8')">8</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('7')">7</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('6')">6</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('5')">5</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('4')">4</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('3')">3</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('2')">2</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('1')">1</button>
                        <button type="button" class="btn btn-primary shot-btn" onclick="gsAddShot('0')">0</button>
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn btn-outline-warning flex-fill" onclick="gsClear()"><i class="bi bi-x-circle"></i> Rensa</button>
                        <button type="button" class="btn btn-outline-secondary flex-fill" onclick="gsBackspace()"><i class="bi bi-backspace"></i> Ångra skott</button>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small mb-1"><i class="bi bi-camera"></i> Foto på tavlan (valfritt)</label>
                        <input type="file" class="form-control" id="gsPhoto" accept="image/*" capture="environment">
                    </div>
                    <button type="button" class="btn btn-success btn-lg w-100" id="gsSaveBtn" onclick="gsSave()" disabled>
                        <i class="bi bi-send"></i> Skicka för validering
                    </button>
                </div>
                <div id="gsResult" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

