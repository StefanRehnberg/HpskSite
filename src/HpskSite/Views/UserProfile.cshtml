// Standardmedalj progress card — per-discipline klass-3 qualification + lifetime Guldmedalj.
function loadMedalSummary(year) {
    const card = document.getElementById('medalSummaryCard');
    const content = document.getElementById('medalSummaryContent');
    if (!card || !content) return;

    fetch(`/umbraco/surface/StandardMedal/GetMyMedalSummary?year=${year}`)
        .then(r => r.json())
        .then(data => {
            if (!data.success) { card.style.display = 'none'; return; }
            renderMedalSummary(data);
        })
        .catch(() => { card.style.display = 'none'; });
}

function renderMedalSummary(data) {
    const card = document.getElementById('medalSummaryCard');
    const content = document.getElementById('medalSummaryContent');
    const yearLabel = document.getElementById('medalSummaryYear');
    if (yearLabel) yearLabel.textContent = '· ' + data.year;

    const qual = (data.qualification || []).filter(q => q.points > 0);
    const gold = data.gold || {};
    const qThreshold = data.qualificationThreshold || 3;
    const gThreshold = data.goldThreshold || 50;

    // Nothing to show: no medals this year and no lifetime points toward gold.
    if (qual.length === 0 && (!gold.lifetimePoints || gold.lifetimePoints === 0)) {
        card.style.display = 'none';
        return;
    }
    card.style.display = 'block';

    let html = '';

    if (qual.length > 0) {
        html += '<div class="mb-2 small text-muted">Riksmästarklass (klass 3) – krav ' + qThreshold + ' p per gren:</div>';
        qual.forEach(q => {
            const pct = Math.min(100, Math.round((q.points / qThreshold) * 100));
            const barClass = q.qualified ? 'bg-success' : 'bg-warning';
            const badge = q.qualified
                ? '<span class="badge bg-success ms-2">Kvalificerad</span>'
                : '<span class="text-muted ms-2">' + Math.max(0, qThreshold - q.points) + ' p kvar</span>';
            html += `
                <div class="mb-2">
                    <div class="d-flex justify-content-between align-items-center flex-wrap">
                        <span><strong>${q.displayName}</strong>
                            <span class="text-muted small">(${q.silver}× silver, ${q.brons}× brons)</span>
                        </span>
                        <span>${q.points} / ${qThreshold} p ${badge}</span>
                    </div>
                    <div class="progress" style="height:6px;">
                        <div class="progress-bar ${barClass}" role="progressbar" style="width:${pct}%"></div>
                    </div>
                </div>`;
        });
    } else {
        html += '<div class="small text-muted mb-2">Inga standardmedaljer registrerade för ' + data.year + ' än.</div>';
    }

    const available = gold.available || 0;
    const goldPct = Math.min(100, Math.round((available / gThreshold) * 100));
    const goldLine = gold.canApply
        ? `<span class="badge bg-warning text-dark">Klar för guldmedalj!</span> ${available} p tillgängliga`
        : `${available} / ${gThreshold} p – ${gold.toNext} p till nästa guldmedalj`;
    const goldsAwardedLine = gold.goldsAwarded > 0
        ? ` <span class="text-muted small">(${gold.goldsAwarded} guldmedalj${gold.goldsAwarded === 1 ? '' : 'er'} hittills)</span>`
        : '';

    html += `
        <hr class="my-2">
        <div class="mb-1 small text-muted">Guldmedalj – 50 p sammanlagt över alla grenar:</div>
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <span><i class="bi bi-trophy-fill text-warning"></i> Guldmedalj${goldsAwardedLine}</span>
            <span>${goldLine}</span>
        </div>
        <div class="progress mt-1" style="height:6px;">
            <div class="progress-bar bg-warning" role="progressbar" style="width:${goldPct}%"></div>
        </div>`;

    content.innerHTML = html;
}

// Märken — Pistolskyttemärket: current valör, årtalsmärke ladder, and this year's Guldfodring.
// ── Medaljer & Märken tab ──────────────────────────────────────────
let markenTabInit = false;
let markenTabYear = new Date().getFullYear();
let markenClubs = [];

function loadMarkenTab() {
    const sel = document.getElementById('markenYearFilter');
    if (!sel) return;
    if (!markenTabInit) {
        const now = new Date().getFullYear();
        for (let y = now; y >= now - 6; y--) {
            const o = document.createElement('option');
            o.value = y; o.textContent = y;
            sel.appendChild(o);
        }
        markenTabInit = true;
        fetch('/umbraco/surface/Marken/GetMyClubsForSeries')
            .then(r => r.json()).then(d => { if (d.success) markenClubs = d.clubs || []; }).catch(() => {});
    }
    markenTabYear = parseInt(sel.value) || new Date().getFullYear();
    loadMarken(markenTabYear);
    loadMedalSummary(markenTabYear);
    loadMySeries(markenTabYear);
    loadValidationQueue();
    setTimeout(updateMarkenEmptyState, 800);
}

function updateMarkenEmptyState() {
    const anyVisible = ['markenCard', 'guldfodringCard', 'medalSummaryCard', 'mySeriesCard', 'markenQueueCard']
        .some(id => { const e = document.getElementById(id); return e && e.style.display !== 'none'; });
    const fam = document.getElementById('markenFamiliesContent');
    const famHas = fam && fam.children.length > 0;
    const empty = document.getElementById('markenEmptyState');
    if (empty) empty.style.display = (anyVisible || famHas) ? 'none' : 'block';
}

function loadMarken(year) {
    if (!document.getElementById('markenCard')) return;
    fetch(`/umbraco/surface/Marken/GetMyMarken?year=${year}`)
        .then(r => r.json())
        .then(data => {
            renderMarken(data.success ? (data.pistolskytte || {}) : {}, year);
            renderFamilies(data.success ? (data.families || []) : [], year);
            updateMarkenEmptyState();
        })
        .catch(() => { renderMarken({}, year); });
}

// Other discipline märken (Precision/Fält/Milsnabb/Nationell helmatch) — auto from competition results.
function renderFamilies(families, year) {
    const wrap = document.getElementById('markenFamiliesContent');
    if (!wrap) return;
    if (!families || families.length === 0) { wrap.innerHTML = ''; return; }
    wrap.innerHTML = families.map(f => {
        const valor = f.earnedLevel
            ? `<span class="badge bg-warning text-dark">${escapeHtmlMarken(f.earnedLevel)}</span>`
            : '<span class="text-muted small">Inget märke än</span>';
        const art = f.artalsmarke || {};
        const artLine = (art.fulfilledYears > 0)
            ? `<div class="small"><i class="bi bi-calendar-check text-warning"></i> ${escapeHtmlMarken(art.current || '')} <span class="text-muted">(${art.fulfilledYears} år${art.nextAtYears > 0 ? `, nästa vid ${art.nextAtYears}` : ''})</span></div>`
            : '';
        const prereq = f.prereqText ? `<div class="small text-warning mt-1"><i class="bi bi-exclamation-triangle"></i> ${escapeHtmlMarken(f.prereqText)}</div>` : '';

        let subtitle, status, detail;
        if (f.pattern === 'series') {
            const req = f.seriesRequired || 5;
            subtitle = `Färdighetsmärke (${req} serier på samma nivå${f.requiresSpeedSeriesToo ? ' + ' + req + ' snabbserier' : ''})`;
            status = `<span class="text-muted small">${f.thisYearAtGuld || 0}/${req} serier på guldnivå ${year}</span>`;
            detail = '';
        } else {
            const comps = (f.thisYearComps || []);
            subtitle = `Tävlingsmärke (${f.compsRequired || 3} tävlingar/år)`;
            status = f.thisYearLevel
                ? `<span class="badge bg-success-subtle text-success">${escapeHtmlMarken(f.thisYearLevel)}-nivå uppnådd ${year}</span>`
                : `<span class="text-muted small">${comps.length}/${f.compsRequired} tävlingar ${year}</span>`;
            detail = comps.length
                ? `<ul class="small text-muted mt-1 mb-1">${comps.slice(0, 6).map(c =>
                    `<li>${escapeHtmlMarken(c.name)} – ${escapeHtmlMarken(c.group)}: <strong>${c.total}</strong>${c.level ? ` <span class="badge bg-light text-dark border">${escapeHtmlMarken(c.level)}</span>` : ''}${c.source === 'SelfReported' ? ' <span class="text-muted">(egen)</span>' : ''}</li>`).join('')}</ul>`
                : `<div class="small text-muted mt-1">Inga tävlingsresultat ${year} än.</div>`;
        }
        return `
            <div class="card mb-3 border-warning-subtle">
                <div class="card-body">
                    <h6 class="card-title mb-2"><i class="bi bi-patch-check text-warning"></i> ${escapeHtmlMarken(f.displayName)} ${valor}</h6>
                    <div class="d-flex justify-content-between align-items-center flex-wrap"><span class="small text-muted">${subtitle}</span>${status}</div>
                    ${detail}${artLine}${prereq}
                </div>
            </div>`;
    }).join('');
}

function renderMarken(data, year) {
    const card = document.getElementById('markenCard');
    const content = document.getElementById('markenContent');
    const yearLabel = document.getElementById('markenYear');
    const gfCard = document.getElementById('guldfodringCard');
    const gfContent = document.getElementById('guldfodringContent');
    const gfYear = document.getElementById('guldfodringYear');
    if (!data || !data.success) { card.style.display = 'none'; if (gfCard) gfCard.style.display = 'none'; return; }
    if (yearLabel) yearLabel.textContent = '· ' + (data.year || year);

    const badges = (data.badges || []).filter(b => b.levelOrdinal >= 1 && b.levelOrdinal <= 3);
    const art = data.artalsmarke || {};
    const gf = data.guldfodring || {};
    const top = badges.length ? badges.reduce((a, b) => b.levelOrdinal > a.levelOrdinal ? b : a) : null;
    const hasGuld = badges.some(b => b.isGuld);

    // ── Pistolskyttemärket badge (valör + årtalsmärke) → markenCard ──
    if (!top && (art.fulfilledYears || 0) === 0) {
        card.style.display = 'none';
    } else {
        card.style.display = 'block';
        let html = '';
        if (top) {
            const guldBadge = badges.find(b => b.isGuld);
            const numTxt = guldBadge && guldBadge.uniqueNumber ? ` <span class="text-muted small">nr ${escapeHtmlMarken(guldBadge.uniqueNumber)}</span>` : '';
            html += `<div class="mb-2"><span class="badge bg-warning text-dark">${escapeHtmlMarken(top.level)}</span> ${escapeHtmlMarken(data.familyName || 'Pistolskyttemärket')}${numTxt}</div>`;
        }
        if (hasGuld || (art.fulfilledYears || 0) > 0) {
            const years = art.fulfilledYears || 0;
            const nextLine = art.nextAtYears > 0
                ? `<span class="text-muted small">Nästa: ${escapeHtmlMarken(art.next)} vid ${art.nextAtYears} år</span>`
                : `<span class="text-muted small">Högsta årtalsmärket uppnått</span>`;
            html += `
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <span><i class="bi bi-calendar-check text-warning"></i> ${art.current ? escapeHtmlMarken(art.current) : 'Inget årtalsmärke än'}</span>
                    <span class="small">${years} godkända guldfodringar</span>
                </div>
                <div class="small">${nextLine}</div>`;
        }
        content.innerHTML = html;
    }

    // ── This year's Guldfodring (two-part status) → guldfodringCard ──
    if (gfCard && gfContent) {
        const p = gf.persisted;
        const part1 = gf.part1Met || (p && p.part1Met);
        const part2 = gf.part2Met || (p && p.part2Met);
        const done = gf.candidateBothMet || (p && p.fulfilled);

        if (!part1 && !part2 && !done) {
            gfCard.style.display = 'none';
        } else {
            gfCard.style.display = 'block';
            if (gfYear) gfYear.textContent = '· ' + (data.year || year);
            const partRow = (label, met, detail) => `
                <div class="d-flex justify-content-between align-items-center">
                    <span>${met ? '<i class="bi bi-check-circle-fill text-success"></i>' : '<i class="bi bi-circle text-muted"></i>'} ${label}</span>
                    <span class="small text-muted">${detail || ''}</span>
                </div>`;
            const pendingTxt = gf.pendingPrecisionCount > 0 ? ` <span class="text-muted">(${gf.pendingPrecisionCount} väntar)</span>` : '';
            const speedPending = gf.pendingSpeedCount > 0 ? ` <span class="text-muted">(${gf.pendingSpeedCount} väntar)</span>` : '';
            const speedDetail = gf.part2ViaFalt
                ? (gf.part2Detail || 'fältmedalj')
                : `${gf.part2SeriesCount || 0}/${gf.part2Required || 3} godkända snabbserier${speedPending}`;
            let html = partRow('Precisionsdel', part1, `${gf.qualifyingSeriesCount || 0}/${gf.requiredSeries} godkända serier${pendingTxt}`);
            html += partRow('Snabbskyttedel', part2, speedDetail);
            if (gf.part1Note) html += `<div class="small text-muted mt-1">${escapeHtmlMarken(gf.part1Note)}</div>`;
            if (done) {
                html += `<div class="mt-2"><span class="badge bg-success"><i class="bi bi-check2-all me-1"></i>Guldfodring ${data.year} uppfylld</span></div>`;
            } else {
                html += `<div class="mt-2 small text-muted">Skicka in guldserier och snabbserier (eller en fältmedalj) ovan; en funktionär validerar dem och årets guldfodring blir klar automatiskt.</div>`;
            }
            gfContent.innerHTML = html;
        }
    }
}

function escapeHtmlMarken(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function getAntiForgeryTokenMarken() {
    const el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}

// ── My submitted series ────────────────────────────────────────────
function loadMySeries(year) {
    const card = document.getElementById('mySeriesCard');
    const content = document.getElementById('mySeriesContent');
    if (!card || !content) return;
    fetch(`/umbraco/surface/Marken/GetMySeries?year=${year}`)
        .then(r => r.json())
        .then(d => {
            const list = (d.series || []);
            const yl = document.getElementById('mySeriesYear'); if (yl) yl.textContent = '· ' + year;
            if (!d.success || list.length === 0) { card.style.display = 'none'; updateMarkenEmptyState(); return; }
            card.style.display = 'block';
            content.innerHTML = list.map(s => {
                const badge = s.status === 'Verified' ? '<span class="badge bg-success">Godkänd</span>'
                    : s.status === 'Rejected' ? '<span class="badge bg-danger">Avvisad</span>'
                    : '<span class="badge bg-secondary">Väntar</span>';
                const dateRaw = s.kind === 'comp' ? s.competitionDate : s.seriesDate;
                const date = dateRaw ? new Date(dateRaw).toLocaleDateString('sv-SE') : '';
                return `<div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                    <span>${markenEvidenceDesc(s)} <span class="text-muted small">${date}</span></span> ${badge}</div>`;
            }).join('');
            updateMarkenEmptyState();
        })
        .catch(() => { card.style.display = 'none'; });
}

// Shared description for any evidence item (Guldserie / Snabbserie / competition result).
function markenEvidenceDesc(s) {
    if (s.kind === 'comp') {
        const lvl = s.reachedLevel
            ? ` <span class="badge bg-light text-dark border">${escapeHtmlMarken(s.reachedLevel)}</span>`
            : ' <span class="text-warning small">under krav</span>';
        return `${escapeHtmlMarken(s.familyName)} – ${escapeHtmlMarken(s.competitionName)}: <strong>${s.total}</strong> <span class="text-muted">(${escapeHtmlMarken(s.weaponGroup)})</span>${lvl}`;
    }
    if (s.family && s.family !== 'Pistolskytte') {
        const typ = s.seriesType === 'Speed' ? 'snabbserie' : 'serie';
        return `${escapeHtmlMarken(s.familyName)} ${typ} <strong>${s.total} p</strong> <span class="text-muted">(nivå ${escapeHtmlMarken(s.claimedLevel)})</span>${s.qualifies ? '' : ' <span class="text-warning small">under krav</span>'}`;
    }
    return s.seriesType === 'Precision'
        ? `Guldserie <strong>${s.total} p</strong> <span class="text-muted">(krav ${s.threshold}, ${escapeHtmlMarken(s.weaponGroup)})</span>${s.qualifies ? '' : ' <span class="text-warning small">under krav</span>'}`
        : `Snabbserie ${escapeHtmlMarken(s.claimedLevel)} <span class="text-muted">(${escapeHtmlMarken(s.targetName)})</span>`;
}

// ── Validation queue (board / Skjutledare) ─────────────────────────
function loadValidationQueue() {
    const card = document.getElementById('markenQueueCard');
    const content = document.getElementById('markenQueueContent');
    if (!card || !content) return;
    fetch('/umbraco/surface/Marken/GetPendingSeries')
        .then(r => r.json())
        .then(d => {
            const list = (d.items || []);
            if (!d.success || list.length === 0) { card.style.display = 'none'; updateMarkenEmptyState(); return; }
            card.style.display = 'block';
            content.innerHTML = list.map(renderQueueItem).join('');
            updateMarkenEmptyState();
        })
        .catch(() => { card.style.display = 'none'; });
}

function renderQueueItem(s) {
    const photoUrl = s.kind === 'comp'
        ? `/umbraco/surface/Marken/GetCompResultPhoto?id=${s.id}`
        : `/umbraco/surface/Marken/GetSeriePhoto?id=${s.id}`;
    const photo = s.hasPhoto ? ` <a href="${photoUrl}" target="_blank" rel="noopener"><i class="bi bi-camera"></i></a>` : '';
    const shots = (s.kind !== 'comp' && s.seriesType === 'Precision' && s.shots) ? `<div class="small text-muted">${s.shots.map(escapeHtmlMarken).join(' · ')}</div>` : '';
    return `<div class="border-bottom py-2">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
            <div><strong>${escapeHtmlMarken(s.memberName)}</strong> <span class="text-muted small">${escapeHtmlMarken(s.clubName || '')}</span><br>${markenEvidenceDesc(s)}${photo}${shots}</div>
            <div class="text-nowrap">
                <button class="btn btn-sm btn-success" onclick="queueAct('${s.kind}', ${s.id}, true)"><i class="bi bi-check-lg me-1"></i>Godkänn</button>
                <button class="btn btn-sm btn-outline-danger" onclick="queueAct('${s.kind}', ${s.id}, false)"><i class="bi bi-x-lg me-1"></i>Avvisa</button>
            </div>
        </div></div>`;
}

function queueAct(kind, id, approve) {
    if (!approve && !confirm('Avvisa?')) return;
    const url = approve ? '/umbraco/surface/Marken/VerifyEvidence' : '/umbraco/surface/Marken/RejectEvidence';
    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryTokenMarken() },
        body: JSON.stringify({ kind, id })
    })
    .then(r => r.json())
    .then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte uppdatera.')); return; }
        loadValidationQueue();
        loadMarken(markenTabYear); // a verify may complete a guldfodring/family
    })
    .catch(() => alert('Något gick fel.'));
}

// ── Club picker population (shared by both entry modals) ────────────
function markenPopulateClubPicker(wrapId, selectId) {
    const wrap = document.getElementById(wrapId);
    const sel = document.getElementById(selectId);
    if (!wrap || !sel) return;
    sel.innerHTML = markenClubs.map(c => `<option value="${c.id}">${escapeHtmlMarken(c.name)}</option>`).join('');
    wrap.style.display = markenClubs.length > 1 ? '' : 'none';
}
function markenSelectedClubId(selectId) {
    if (markenClubs.length === 1) return markenClubs[0].id;
    const sel = document.getElementById(selectId);
    return sel && sel.value ? parseInt(sel.value) : (markenClubs[0] ? markenClubs[0].id : 0);
}
function markenUploadPhoto(inputId) {
    const input = document.getElementById(inputId);
    if (!input || !input.files || input.files.length === 0) return Promise.resolve(null);
    const fd = new FormData();
    fd.append('file', input.files[0]);
    fd.append('__RequestVerificationToken', getAntiForgeryTokenMarken());
    return fetch('/umbraco/surface/Marken/UploadSeriePhoto', { method: 'POST', body: fd })
        .then(r => r.json()).then(d => d.success ? d.fileRef : null).catch(() => null);
}
let markenQrPoll = null;
function markenStopStatusPoll() { if (markenQrPoll) { clearInterval(markenQrPoll); markenQrPoll = null; } }

function markenRenderQr(container, res, modalId, kind) {
    const qr = `/umbraco/surface/Faltskytte/GenerateQrCode?url=${encodeURIComponent(res.verifyUrl)}`;
    container.innerHTML = `
        <div class="text-center" id="qrPending_${res.id}">
            <div class="alert ${res.qualifies === false ? 'alert-warning' : 'alert-success'}">${escapeHtmlMarken(res.message)}</div>
            <p class="mb-2">Visa koden för en styrelsemedlem eller skjutledare så kan de validera direkt:</p>
            <img src="${qr}" alt="QR" class="img-fluid border rounded" style="max-width:240px;">
            <div class="text-muted small mt-2"><span class="spinner-border spinner-border-sm"></span> Väntar på validering…</div>
            <div class="d-grid mt-3"><button class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button></div>
        </div>`;
    container.style.display = 'block';
    markenStartStatusPoll(res.id, modalId, container, kind || 'series');
}

// Poll the shooter's own evidence so the screen updates the instant a functionary validates it
// (on their own device / via QR). On resolution: refresh the list behind, show a result, auto-close.
function markenStartStatusPoll(id, modalId, container, kind) {
    markenStopStatusPoll();
    const statusUrl = kind === 'comp'
        ? `/umbraco/surface/Marken/GetMyCompResultStatus?id=${id}`
        : `/umbraco/surface/Marken/GetMySerieStatus?id=${id}`;
    markenQrPoll = setInterval(() => {
        fetch(statusUrl)
            .then(r => r.json())
            .then(d => {
                if (!d.success || (d.status !== 'Verified' && d.status !== 'Rejected')) return;
                markenStopStatusPoll();
                loadMySeries(markenTabYear);
                loadMarken(markenTabYear);
                const ok = d.status === 'Verified';
                container.innerHTML = `<div class="text-center py-3">
                    <div class="alert ${ok ? 'alert-success' : 'alert-secondary'} mb-0">
                        <i class="bi ${ok ? 'bi-check-circle-fill' : 'bi-x-circle'}"></i> ${ok ? 'Godkänd!' : 'Avvisad'}
                    </div></div>`;
                setTimeout(() => {
                    const m = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if (m) m.hide();
                }, 1400);
            })
            .catch(() => {});
    }, 3000);
}

// ── Guldserie modal ────────────────────────────────────────────────
let gsShots = [];
function openGuldserieModal() {
    gsShots = [];
    document.getElementById('gsForm').style.display = 'block';
    document.getElementById('gsResult').style.display = 'none';
    document.getElementById('gsPhoto').value = '';
    gsRenderShots();
    gsUpdateThreshold();
    markenPopulateClubPicker('gsClubWrap', 'gsClub');
    bootstrap.Modal.getOrCreateInstance(document.getElementById('guldserieModal')).show();
}
function gsGuldKrav(group) { return group === 'A' ? 43 : group === 'B' ? 45 : 46; }
function gsUpdateThreshold() {
    const g = document.getElementById('gsWeapon').value;
    document.getElementById('gsThresholdNote').textContent = `Guldkrav: ${gsGuldKrav(g)} p/serie (åldersavdrag tillämpas automatiskt för 55+/65+).`;
}
function gsAddShot(v) { if (gsShots.length < 5) { gsShots.push(v); gsRenderShots(); } }
function gsBackspace() { gsShots.pop(); gsRenderShots(); }
function gsClear() { gsShots = []; gsRenderShots(); }
function gsRenderShots() {
    let total = 0;
    for (let i = 0; i < 5; i++) {
        const c = document.getElementById('gs-circle-' + i);
        if (i < gsShots.length) {
            c.textContent = gsShots[i]; c.classList.add('filled');
            total += gsShots[i] === 'X' ? 10 : (parseInt(gsShots[i]) || 0);
        } else { c.textContent = '_'; c.classList.remove('filled'); }
    }
    document.getElementById('gsTotal').textContent = total;
    document.getElementById('gsSaveBtn').disabled = gsShots.length !== 5;
}
function gsSave() {
    const btn = document.getElementById('gsSaveBtn');
    const clubId = markenSelectedClubId('gsClub');
    if (!clubId) { alert('Du måste vara medlem i en klubb för att skicka in.'); return; }
    btn.disabled = true; btn.textContent = 'Skickar...';
    markenUploadPhoto('gsPhoto').then(photoRef => {
        return fetch('/umbraco/surface/Marken/SubmitSeries', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryTokenMarken() },
            body: JSON.stringify({ seriesType: 'Precision', clubId, weaponGroup: document.getElementById('gsWeapon').value, shots: gsShots, claimedLevel: 'Guld', photoRef })
        });
    }).then(r => r.json()).then(res => {
        if (!res.success) { alert('Fel: ' + (res.message || 'Kunde inte spara.')); btn.disabled = false; btn.innerHTML = '<i class="bi bi-send"></i> Skicka för validering'; return; }
        document.getElementById('gsForm').style.display = 'none';
        markenRenderQr(document.getElementById('gsResult'), res, 'guldserieModal');
        loadMySeries(markenTabYear);
    }).catch(() => { alert('Något gick fel.'); btn.disabled = false; });
}

