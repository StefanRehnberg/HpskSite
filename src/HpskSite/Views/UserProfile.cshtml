function renderFaltskytteDashboard(data) {
    const content = document.getElementById('dashboardContent');
    if (!content) return;

    const years = data.availableYears || [];
    if (_faltSelectedYear === null || !years.includes(_faltSelectedYear)) {
        _faltSelectedYear = data.defaultYear || (years[0] ?? new Date().getFullYear());
    }
    const stats = data.statsByYear?.[String(_faltSelectedYear)] || _faltEmptyStats();

    let trendHtml = '';
    if (data.hitPercentYoYDelta !== null && data.hitPercentYoYDelta !== undefined) {
        const d = data.hitPercentYoYDelta;
        const sign = d > 0 ? '+' : '';
        const color = Math.abs(d) < 0.5 ? 'secondary' : (d > 0 ? 'success' : 'danger');
        const arrow = Math.abs(d) < 0.5 ? 'arrow-right' : (d > 0 ? 'arrow-up' : 'arrow-down');
        trendHtml = `<small class="text-${color} text-center d-block"><i class="bi bi-${arrow}"></i> ${sign}${d} % mot förra året</small>`;
    }

    content.innerHTML = `
        <div class="row mb-3">
            <div class="col-12 d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Översikt — Fältskytte</h5>
