                            <div class="d-flex justify-content-around mb-2">
                                <div class="text-center">
                                    <img src="/images/StdMedS.png" alt="Silver" style="height:32px;width:auto;">
                                    <div class="fw-bold">${stats.medalStats.silverCount} st</div>
                                </div>
                                <div class="text-center">
