    if (!rows || rows.length === 0) {
        content.innerHTML = `
            <div class="alert alert-info">
                <h5><i class="bi bi-info-circle"></i> Inga Fältskytte-resultat</h5>
                <p>Det finns inga Fältskytte-resultat för de valda filtren. Lägg in egna resultat från externa tävlingar via knappen ovan.</p>
                <button class="btn btn-primary" onclick="openTrainingScoreModal()">
                    <i class="bi bi-plus-circle"></i> Lägg in Resultat
                </button>
            </div>`;
        return;
    }

    const html = `
        <p class="small text-muted mb-2">
            <i class="bi bi-trophy text-primary"></i> = tävling på pistol.nu (resultat hämtas automatiskt).
            <i class="bi bi-globe text-secondary ms-2"></i> = extern tävling som du själv lagt in.
