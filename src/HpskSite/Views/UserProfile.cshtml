                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card stats-card h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2"><i class="bi bi-clipboard-data"></i> Aktivitet</h6>
                        <h3 class="mb-3 text-center">${stats.totalCompetitions} <small class="text-muted fs-6">tävlingar</small></h3>
                        <div class="small">
                            ${(stats.activityByWeaponGroup || []).map((w, i, arr) => `
                                <div class="d-flex justify-content-between ${i < arr.length - 1 ? 'border-bottom' : ''} py-1">
                                    <span><strong>${w.weaponGroup}</strong></span>
                                    <span class="text-muted">${w.count} tävl.</span>
                                </div>
                            `).join('') || '<div class="text-muted text-center py-2">Inga tävlingar</div>'}
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card stats-card h-100">
                    <div class="card-body">
                        <h6 class="text-muted mb-2"><i class="bi bi-bullseye"></i> Träffprocent</h6>
                        <h3 class="mb-2 text-center">${stats.hitPercentAvg.toFixed(1)} <small class="text-muted fs-6">% snitt</small></h3>
                        <div class="small">
                            ${(stats.hitPercentByWeaponGroup || []).map(w => `
                                <div class="d-flex justify-content-between"><span>${w.weaponGroup}</span><span class="text-muted">${w.hitPercent.toFixed(1)} %</span></div>
                                <div class="pct-bar mb-1"><div style="width:${Math.min(100, w.hitPercent)}%"></div></div>
