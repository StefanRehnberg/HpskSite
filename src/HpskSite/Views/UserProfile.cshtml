                                    <small class="text-muted">av ${stats.totalCompetitions} tävl.</small>
                                </div>
                            </div>
                        ` : `<div class="text-muted text-center py-3"><i class="bi bi-info-circle"></i><p class="mb-0 mt-1 small">Ingen placeringsdata än</p></div>`}
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12 mb-3">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
