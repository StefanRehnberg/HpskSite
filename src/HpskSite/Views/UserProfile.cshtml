                            <td class="text-end fw-semibold">${_faltHeadline(r)}</td>
                            <td class="text-end ${hitClass}">${r.hitPercent.toFixed(1)} %</td>
                            <td class="text-end">${r.figurePercent.toFixed(1)} %</td>
