@using Umbraco.Cms.Web.Website.Controllers
@using Umbraco.Cms.Web.Website.Models
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Web.Common.PublishedModels
@using Umbraco.Cms.Core.Services
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Min Sida";

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;

    // Get member data with properties
    var memberData = isLoggedIn ? MemberService.GetByEmail(currentMember?.Email ?? "") : null;
}

@* Check if user is logged in *@
@if (!isLoggedIn)
{
    <div class="alert alert-warning">
        <h4>Access Denied</h4>
        <p>You must be logged in to access this page.</p>
        <a href="/login-register/" class="btn btn-primary">Login</a>
    </div>
    return;
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0"><i class="bi bi-person"></i> Min Sida</h3>
                        <div id="primaryClubButton" class="d-none">
                            <a href="#" id="clubLink" class="btn btn-primary">
                                <i class="bi bi-building"></i> Min klubb: <span id="clubName"></span>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    @* Anti-forgery token for AJAX requests *@
                    @Html.AntiForgeryToken()

                    @* Tab Navigation *@
                    <ul class="nav nav-tabs mb-4" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard-pane" type="button" role="tab">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="results-tab" data-bs-toggle="tab" data-bs-target="#results-pane" type="button" role="tab">
                                <i class="bi bi-clipboard-data"></i> Resultat
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="marken-tab" data-bs-toggle="tab" data-bs-target="#marken-pane" type="button" role="tab">
                                <i class="bi bi-patch-check"></i> Medaljer &amp; Märken
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="competitions-tab" data-bs-toggle="tab" data-bs-target="#competitions-pane" type="button" role="tab">
                                <i class="bi bi-trophy"></i> Tävlingar
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="handicap-tab" data-bs-toggle="tab" data-bs-target="#handicap-pane" type="button" role="tab">
                                <i class="bi bi-calculator"></i> Handikapp
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile-pane" type="button" role="tab">
                                <i class="bi bi-person-circle"></i> Profil
                            </button>
                        </li>
                    </ul>

                    @* Tab Content *@
                    <div class="tab-content" id="profileTabContent">

                        @* Dashboard Tab *@
                        <div class="tab-pane fade show active" id="dashboard-pane" role="tabpanel">
                            <div id="trainingGroupInfo" class="d-none">
                                <div class="card border-primary mb-3">
                                    <div class="card-body py-2">
                                        <i class="bi bi-people-fill text-primary me-2"></i>
                                        <strong id="trainingGroupNames"></strong>
                                        <br><small class="text-muted" id="trainingGroupTrainers"></small>
                                        <a href="/skyttetrappan/" class="btn btn-sm btn-outline-primary float-end" title="Gå till Skyttetrappan">
                                            <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div id="dashboardContent">
                                <div class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Laddar dashboard...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* End Dashboard Tab *@

                        @* Training Results Tab *@
                        <div class="tab-pane fade" id="results-pane" role="tabpanel">
                            @* Action Bar + Filters *@
                            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                                <button class="btn btn-primary" onclick="openTrainingScoreModal()">
                                    <i class="bi bi-plus-circle"></i> Lägg in Resultat
                                </button>
                                <div class="d-flex gap-2 flex-wrap">
                                    <select id="competitionTypeFilter" class="form-select form-select-sm" style="width: auto;" onchange="loadResults()">
                                        <option value="Precision" selected>Precision</option>
                                        <option value="Milsnabb">Milsnabb</option>
                                        <option value="Duell">Duell</option>
                                        <option value="NationellHelmatch">Nationell Helmatch</option>
                                        <option value="MagnumPrecision">Magnum Precision</option>
                                        <option value="Faltskytte">Fältskytte</option>
                                    </select>
                                    <select id="yearFilter" class="form-select form-select-sm" style="width: auto;" onchange="loadResults()">
                                        @* Options populated by JavaScript *@
                                    </select>
                                    <select id="weaponClassFilter" class="form-select form-select-sm" style="width: auto;" onchange="loadResults()">
                                        <option value="Alla" selected>Alla</option>
                                        <option value="A">A - Tjänstevapen</option>
                                        <option value="A_Opt">A Opt - Optisk</option>
                                        <option value="A_M">AM - Militära pistoler</option>
                                        <option value="A_P">AP - Fickmodell</option>
                                        <option value="A_G">AG - Moderna tjänstepistoler</option>
                                        <option value="B">B - Kal. 32-45</option>
                                        <option value="C">C - Kal. 22</option>
                                        <option value="R">R - Revolver</option>
                                        <option value="M">M - Magnum</option>
                                        <option value="L">L - Luftpistol</option>
                                    </select>
                                </div>
                            </div>

                            @* Results Content *@
                            <div id="resultsContent">
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Laddar...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @* Medaljer & Märken Tab *@
                        <div class="tab-pane fade" id="marken-pane" role="tabpanel">
                            <div class="d-flex justify-content-end mb-3">
                                <select id="markenYearFilter" class="form-select form-select-sm" style="width:auto;" onchange="loadMarkenTab()">
                                    @* populated by JS *@
                                </select>
                            </div>

                            @* Validation queue — only shown to board members / Skjutledare with pending series. *@
                            <div id="markenQueueCard" class="card mb-3 border-info" style="display:none;">
                                <div class="card-body">
                                    <h6 class="card-title mb-1"><i class="bi bi-clipboard-check text-info"></i> Serier att validera</h6>
                                    <p class="text-muted small mb-2">Du är funktionär (styrelse/skjutledare). Skyttar i din klubb har skickat in serier – kontrollera och godkänn eller avvisa.</p>
                                    <div id="markenQueueContent"></div>
                                </div>
                            </div>

                            @* Entry buttons — "Jag har skjutit en ..." *@
                            <div class="row g-2 mb-3">
                                <div class="col-12 col-sm-4">
                                    <button class="btn btn-warning btn-lg w-100 py-3 fw-bold" onclick="openGuldserieModal()">
                                        <i class="bi bi-bullseye"></i> Jag har skjutit en GULDSERIE!
                                    </button>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <button class="btn btn-outline-warning btn-lg w-100 py-3 fw-bold" onclick="openSnabbserieModal()">
                                        <i class="bi bi-stopwatch"></i> Jag har skjutit en SNABBSERIE!
                                    </button>
                                </div>
                                <div class="col-12 col-sm-4">
                                    <button class="btn btn-outline-warning btn-lg w-100 py-3 fw-bold" onclick="openProofSerieModal()">
                                        <i class="bi bi-wind"></i> Jag har skjutit en LUFTPISTOLSERIE!
                                    </button>
                                </div>
                            </div>

                            @* My submitted series this year — collapsible (can get long). *@
                            <div id="mySeriesCard" class="card mb-3" style="display:none;">
                                <div class="card-body py-2">
                                    <button class="btn btn-link p-0 text-decoration-none w-100 text-start fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#mySeriesCollapse">
                                        <i class="bi bi-list-check"></i> Mina inskickade serier <span id="mySeriesYear" class="text-muted fw-normal small"></span>
                                        <i class="bi bi-chevron-down float-end"></i>
                                    </button>
                                    <div id="mySeriesCollapse" class="collapse mt-2"><div id="mySeriesContent"></div></div>
                                </div>
                            </div>

                            @* This year's Guldfodring (two-part status). *@
                            <div id="guldfodringCard" class="card mb-3 border-warning-subtle" style="display:none;">
                                <div class="card-body">
                                    <h6 class="card-title mb-2"><i class="bi bi-calendar-check text-warning"></i> Guldfodring <span id="guldfodringYear" class="text-muted fw-normal small"></span></h6>
                                    <div id="guldfodringContent"></div>
                                </div>
                            </div>

                            @* Standardmedaljer — klass-3 qualification (per discipline) + Guldmedalj. *@
                            <div id="medalSummaryCard" class="card mb-3 border-warning-subtle" style="display:none;">
                                <div class="card-body">
                                    <h6 class="card-title mb-3">
                                        <i class="bi bi-award text-warning"></i> Standardmedaljer
                                        <span id="medalSummaryYear" class="text-muted fw-normal small"></span>
                                    </h6>
                                    <div id="medalSummaryContent"></div>
                                </div>
                            </div>

                            @* Märken — Pistolskyttemärket valör + årtalsmärke, then the discipline families. *@
                            <div id="markenCard" class="card mb-3 border-warning-subtle" style="display:none;">
                                <div class="card-body">
                                    <h6 class="card-title mb-3">
                                        <i class="bi bi-patch-check text-warning"></i> Pistolskyttemärket
                                        <span id="markenYear" class="text-muted fw-normal small"></span>
                                    </h6>
                                    <div id="markenContent"></div>
                                </div>
                            </div>
                            <div id="markenFamiliesContent"></div>

                            <div id="markenEmptyState" class="text-muted text-center py-4" style="display:none;">
                                <i class="bi bi-patch-check d-block mb-2" style="font-size:2rem;opacity:.4;"></i>
                                Inga märken eller medaljer registrerade för valt år än. Skjut en guldserie och be en funktionär validera den.
                            </div>
                        </div>
                        @* End Medaljer & Märken Tab *@

                        @* Competitions Tab *@
                        <div class="tab-pane fade" id="competitions-pane" role="tabpanel">
                            @* Filter Bar *@
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-3 col-sm-6">
                                            <label for="compYearFilter" class="form-label">År</label>
                                            <select id="compYearFilter" class="form-select" onchange="applyCompetitionFilters()">
                                                <option value="">Alla år</option>
                                                @* Options populated by JavaScript *@
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-sm-6">
                                            <label for="compStatusFilter" class="form-label">Status</label>
                                            <select id="compStatusFilter" class="form-select" onchange="applyCompetitionFilters()">
                                                <option value="all" selected>Alla</option>
                                                <option value="upcoming">Kommande</option>
                                                <option value="past">Genomförda</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-sm-6">
                                            <label for="compPaymentFilter" class="form-label">Betalning</label>
                                            <select id="compPaymentFilter" class="form-select" onchange="applyCompetitionFilters()">
                                                <option value="all">Alla</option>
                                                <option value="paid">Betald</option>
                                                <option value="not_paid">Ej betald</option>
                                                <option value="no_invoice">Ingen avgift</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 col-sm-6">
                                            <label for="compSearchFilter" class="form-label">Sök</label>
                                            <input type="text" id="compSearchFilter" class="form-control" placeholder="Sök tävlingar..." oninput="applyCompetitionFiltersDebounced()">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Competitions Content *@
                            <div id="competitionsContent">
                                <div class="text-center py-3">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Laddar...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @* End Competitions Tab *@

                        @* Handikapp Tab *@
                        <div class="tab-pane fade" id="handicap-pane" role="tabpanel">

                            <!-- Precision Shooting Settings Section -->
                            <div class="mb-4">
                                <h5 class="mb-3" role="button" data-bs-toggle="collapse" data-bs-target="#precisionSection" aria-expanded="true">
                                    <img src="/images/competition-types/Precision.png" alt="Precision" style="height: 20px; width: auto;" class="me-2">Precisionsskytte
                                    <i class="bi bi-chevron-down float-end small"></i>
                                </h5>
                                <div class="collapse show" id="precisionSection">
                                    <div class="card border-light">
                                        <div class="card-body">
                                            <!-- Shooter Class Selection -->
                                            <label class="form-label fw-semibold">Skytteklass</label>
                                            <div class="mb-3">
                                                @{
                                                    var currentShooterClass = memberData?.GetValue("precisionShooterClass")?.ToString() ?? "";
                                                }
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="shooterClass" id="class1" value="Klass 1 - Nybörjare" @(currentShooterClass == "Klass 1 - Nybörjare" ? "checked" : "")>
                                                    <label class="form-check-label" for="class1">Klass 1 - Nybörjare</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="shooterClass" id="class2" value="Klass 2 - Guldmärkesskytt" @(currentShooterClass == "Klass 2 - Guldmärkesskytt" ? "checked" : "")>
                                                    <label class="form-check-label" for="class2">Klass 2 - Guldmärkesskytt</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="shooterClass" id="class3" value="Klass 3 - Riksmästare" @(currentShooterClass == "Klass 3 - Riksmästare" ? "checked" : "")>
                                                    <label class="form-check-label" for="class3">Klass 3 - Riksmästare</label>
                                                </div>
                                            </div>

                                            <hr class="my-3">

                                            <!-- Handicap Info Section -->
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <label class="form-label fw-semibold mb-0">Ditt Handikappindex</label>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="recalculateMyHandicap('Precision')" id="recalculateHandicapBtn" title="Omberäkna handikapp från alla resultat">
                                                    <i class="bi bi-arrow-clockwise"></i> Omberäkna
                                                </button>
                                            </div>
                                            <div id="handicapInfoContainer">
                                                <div class="text-center py-3">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                        <span class="visually-hidden">Laddar...</span>
                                                    </div>
                                                    <span class="ms-2 text-muted">Laddar handikappinformation...</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Milsnabb Shooting Settings Section -->
                            <div class="mb-4">
                                <h5 class="mb-3" role="button" data-bs-toggle="collapse" data-bs-target="#milsnabbSection" aria-expanded="true">
                                    <img src="/images/competition-types/Milsnabb.png" alt="Milsnabb" style="height: 20px; width: auto;" class="me-2">Milsnabb
                                    <i class="bi bi-chevron-down float-end small"></i>
                                </h5>
                                <div class="collapse show" id="milsnabbSection">
                                    <div class="card border-light">
                                        <div class="card-body">
                                            <!-- Shooter Class Selection -->
                                            <label class="form-label fw-semibold">Skytteklass</label>
                                            <div class="mb-3">
                                                @{
                                                    var currentMilsnabbShooterClass = memberData?.GetValue("milsnabbShooterClass")?.ToString() ?? "";
                                                }
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="milsnabbShooterClass" id="milsnabbClass1" value="Klass 1 - Nybörjare" @(currentMilsnabbShooterClass == "Klass 1 - Nybörjare" ? "checked" : "")>
                                                    <label class="form-check-label" for="milsnabbClass1">Klass 1 - Nybörjare</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="milsnabbShooterClass" id="milsnabbClass2" value="Klass 2 - Guldmärkesskytt" @(currentMilsnabbShooterClass == "Klass 2 - Guldmärkesskytt" ? "checked" : "")>
                                                    <label class="form-check-label" for="milsnabbClass2">Klass 2 - Guldmärkesskytt</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="milsnabbShooterClass" id="milsnabbClass3" value="Klass 3 - Riksmästare" @(currentMilsnabbShooterClass == "Klass 3 - Riksmästare" ? "checked" : "")>
                                                    <label class="form-check-label" for="milsnabbClass3">Klass 3 - Riksmästare</label>
                                                </div>
                                            </div>

                                            <hr class="my-3">

                                            <!-- Handicap Info Section -->
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <label class="form-label fw-semibold mb-0">Ditt Handikappindex</label>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="recalculateMyHandicap('Milsnabb')" id="recalculateMilsnabbHandicapBtn" title="Omberäkna handikapp från alla resultat">
                                                    <i class="bi bi-arrow-clockwise"></i> Omberäkna
                                                </button>
                                            </div>
                                            <div id="milsnabbHandicapInfoContainer">
                                                <div class="text-center py-3">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                        <span class="visually-hidden">Laddar...</span>
                                                    </div>
                                                    <span class="ms-2 text-muted">Laddar handikappinformation...</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Duell Shooting Settings Section -->
                            <div class="mb-4">
                                <h5 class="mb-3" role="button" data-bs-toggle="collapse" data-bs-target="#duellSection" aria-expanded="true">
                                    <img src="/images/competition-types/Duell.png" alt="Duell" style="height: 20px; width: auto;" class="me-2">Duell
                                    <i class="bi bi-chevron-down float-end small"></i>
                                </h5>
                                <div class="collapse show" id="duellSection">
                                    <div class="card border-light">
                                        <div class="card-body">
                                            <!-- Shooter Class Selection -->
                                            <label class="form-label fw-semibold">Skytteklass</label>
                                            <div class="mb-3">
                                                @{
                                                    var currentDuellShooterClass = memberData?.GetValue("duellShooterClass")?.ToString() ?? "";
                                                }
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="duellShooterClass" id="duellClass1" value="Klass 1 - Nybörjare" @(currentDuellShooterClass == "Klass 1 - Nybörjare" ? "checked" : "")>
                                                    <label class="form-check-label" for="duellClass1">Klass 1 - Nybörjare</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="duellShooterClass" id="duellClass2" value="Klass 2 - Guldmärkesskytt" @(currentDuellShooterClass == "Klass 2 - Guldmärkesskytt" ? "checked" : "")>
                                                    <label class="form-check-label" for="duellClass2">Klass 2 - Guldmärkesskytt</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="duellShooterClass" id="duellClass3" value="Klass 3 - Riksmästare" @(currentDuellShooterClass == "Klass 3 - Riksmästare" ? "checked" : "")>
                                                    <label class="form-check-label" for="duellClass3">Klass 3 - Riksmästare</label>
                                                </div>
                                            </div>

                                            <hr class="my-3">

                                            <!-- Handicap Info Section -->
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <label class="form-label fw-semibold mb-0">Ditt Handikappindex</label>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="recalculateMyHandicap('Duell')" id="recalculateDuellHandicapBtn" title="Omberäkna handikapp från alla resultat">
                                                    <i class="bi bi-arrow-clockwise"></i> Omberäkna
                                                </button>
                                            </div>
                                            <div id="duellHandicapInfoContainer">
                                                <div class="text-center py-3">
                                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                        <span class="visually-hidden">Laddar...</span>
                                                    </div>
                                                    <span class="ms-2 text-muted">Laddar handikappinformation...</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Nationell Helmatch Shooting Settings Section -->
                            <div class="mb-4">
                                <h5 class="mb-3" role="button" data-bs-toggle="collapse" data-bs-target="#nationellHelmatchSection" aria-expanded="true">
                                    <img src="/images/competition-types/NationellHelmatch.png" alt="Nationell Helmatch" style="height: 20px; width: auto;" class="me-2">Nationell Helmatch
                                    <i class="bi bi-chevron-down float-end small"></i>
                                </h5>
                                <div class="collapse show" id="nationellHelmatchSection">
                                    <div class="card border-light">
                                        <div class="card-body">
                                            <!-- Shooter Class Selection -->
                                            <label class="form-label fw-semibold">Skytteklass</label>
                                            <div class="mb-3">
                                                @{
                                                    var currentNationellHelmatchShooterClass = memberData?.GetValue("nationellHelmatchShooterClass")?.ToString() ?? "";
                                                }
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="nationellHelmatchShooterClass" id="nationellHelmatchClass1" value="Klass 1 - Nybörjare" @(currentNationellHelmatchShooterClass == "Klass 1 - Nybörjare" ? "checked" : "")>
                                                    <label class="form-check-label" for="nationellHelmatchClass1">Klass 1 - Nybörjare</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="nationellHelmatchShooterClass" id="nationellHelmatchClass2" value="Klass 2 - Guldmärkesskytt" @(currentNationellHelmatchShooterClass == "Klass 2 - Guldmärkesskytt" ? "checked" : "")>
