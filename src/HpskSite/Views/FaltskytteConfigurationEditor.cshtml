                    <i class="bi bi-check-lg me-1"></i>Importera
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Weapon class picker modal -->
<div class="modal fade" id="fkEditorWeaponClassModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Välj vapenklasser</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Välj de vapengrupper som stationerna ska konfigureras för. Du kan ändra detta senare.</p>
                <div id="fkEditorWeaponClassChecks"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" onclick="fkEditorApplyWeaponClasses()">Tillämpa</button>
            </div>
        </div>
    </div>
</div>

<!-- Flatpickr for the secrecy timestamp -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

@* The shared configurator script must load AFTER the DOM nodes it queries. *@
@await Html.PartialAsync("_FaltskytteConfiguratorScript")

<script>
// Standalone editor mode flag — the shared configurator script branches on this
// to route saves to /FaltskytteConfiguration/Update instead of the legacy
// per-competition save endpoint.
window._faltCfgEditorMode = 'configuration';
window._faltCfgConfigurationId = @configId;

var fkEditorConfig = null;
var fkEditorMetaSaveTimer = null;
var fkEditorSecretFlatpickr = null;

// SHB-aligned default list. Operator can prune via "Välj vapenklasser" modal.
var FALT_DEFAULT_WEAPON_CLASSES = ['A', 'B', 'C', 'R'];

document.addEventListener('DOMContentLoaded', async function() {
    fkEditorSecretFlatpickr = flatpickr('#fkEditorSecret', {
        locale: 'sv',
        enableTime: true,
        time_24hr: true,
        dateFormat: 'Y-m-d H:i',
        minDate: 'today'
    });

    await fkEditorLoad();
});

async function fkEditorLoad() {
    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/Get?id=@configId');
        var data = await resp.json();
        if (!data.success) {
            alert('Kunde inte ladda konfigurationen: ' + (data.message || 'Okänt fel'));
            window.location.href = '/faltkonfig';
            return;
        }
        fkEditorConfig = data.configuration;
        fkEditorRenderMeta();

        var blob = {};
        try { blob = fkEditorConfig.jsonBlob ? JSON.parse(fkEditorConfig.jsonBlob) : {}; } catch (e) { blob = {}; }

        // Detect weapon classes from the loaded blob. New configs may be empty.
        var weaponClasses = Object.keys(blob).filter(function(k) { return !k.startsWith('_'); });
        if (weaponClasses.length === 0) weaponClasses = FALT_DEFAULT_WEAPON_CLASSES.slice();

        // Initialize the configurator. After this the shared JS owns rendering.
        // faltCfgOpen skips its legacy modal show() when the element is absent.
        faltCfgOpen(weaponClasses, blob);

        document.getElementById('fkEditorRoot').style.display = '';
    } catch (e) {
        console.error(e);
        alert('Nätverksfel vid laddning.');
    }
}

function fkEditorRenderMeta() {
    if (!fkEditorConfig) return;
    document.getElementById('fkEditorTitle').textContent = fkEditorConfig.name || 'Redigera konfiguration';
    document.getElementById('fkEditorName').value = fkEditorConfig.name || '';
    document.getElementById('fkEditorDesc').value = fkEditorConfig.description || '';
    document.getElementById('fkEditorVis').value = fkEditorConfig.visibility || 'Private';
    if (fkEditorSecretFlatpickr) {
        if (fkEditorConfig.secretUntil) fkEditorSecretFlatpickr.setDate(fkEditorConfig.secretUntil, false);
        else fkEditorSecretFlatpickr.clear();
    }
    var secretBadge = document.getElementById('fkEditorSecretBadge');
    if (fkEditorConfig.isSecret) {
        secretBadge.style.display = '';
        secretBadge.title = 'Hemlig fram till ' + fkEditorConfig.secretUntil;
    } else {
        secretBadge.style.display = 'none';
    }
    fkEditorRenderCollaborators();
}

function fkEditorRenderCollaborators() {
    var container = document.getElementById('fkEditorCollabList');
    if (!fkEditorConfig.collaborators || fkEditorConfig.collaborators.length === 0) {
        container.innerHTML = '<span class="text-muted small">Inga medredigerare ännu.</span>';
        return;
    }
    container.innerHTML = fkEditorConfig.collaborators.map(function(c) {
        return '<span class="badge bg-light text-dark border d-flex align-items-center gap-1">' +
            '<i class="bi bi-person"></i>' + escapeHtml(c.memberName) +
            '<button class="btn btn-link btn-sm text-danger p-0 ms-1" onclick="fkEditorRemoveCollaborator(' + c.memberId + ')" title="Ta bort"><i class="bi bi-x-circle-fill"></i></button>' +
        '</span>';
    }).join('');
}

function escapeHtml(s) {
    if (s == null) return '';
    return String(s).replace(/[&<>"']/g, function(c) {
        return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
}

async function fkEditorSaveMeta() {
    if (!fkEditorConfig) return;
    var body = {
        id: fkEditorConfig.id,
        name: document.getElementById('fkEditorName').value || '',
        description: document.getElementById('fkEditorDesc').value || '',
        visibility: document.getElementById('fkEditorVis').value,
        secretUntil: document.getElementById('fkEditorSecret').value || null,
        clearSecretUntil: !document.getElementById('fkEditorSecret').value
    };
    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/Update', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify(body)
        });
        var data = await resp.json();
        if (!data.success) {
            alert('Kunde inte spara: ' + (data.message || 'Okänt fel'));
            return;
        }
        // Refresh server-side state (e.g. isSecret).
        fkEditorConfig.name = body.name;
        fkEditorConfig.description = body.description;
        fkEditorConfig.visibility = body.visibility;
        fkEditorConfig.secretUntil = body.secretUntil;
        fkEditorConfig.isSecret = !!body.secretUntil && new Date(body.secretUntil) > new Date();
        fkEditorRenderMeta();
    } catch (e) {
        console.error(e);
        alert('Nätverksfel.');
    }
}

function fkEditorClearSecret() {
    if (fkEditorSecretFlatpickr) fkEditorSecretFlatpickr.clear();
    fkEditorSaveMeta();
}

async function fkEditorSaveAll() {
    // Persist metadata then the JSON blob.
    await fkEditorSaveMeta();
    await faltCfgSaveAll();
    document.getElementById('fkEditorSavedBadge').style.display = '';
    document.getElementById('fkEditorDirtyBadge').style.display = 'none';
    setTimeout(function() { document.getElementById('fkEditorSavedBadge').style.display = 'none'; }, 3000);
}

// ─── Collaborators ───────────────────────────────────────────────────

var fkEditorMemberSearchTimer = null;

function fkEditorMemberSearch() {
    if (fkEditorMemberSearchTimer) clearTimeout(fkEditorMemberSearchTimer);
    var q = document.getElementById('fkEditorMemberSearch').value.trim();
    if (q.length < 2) {
        document.getElementById('fkEditorMemberResults').style.display = 'none';
        return;
    }
    fkEditorMemberSearchTimer = setTimeout(function() { fkEditorMemberSearchDo(q); }, 250);
}

async function fkEditorMemberSearchDo(q) {
    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/SearchMembers?query=' + encodeURIComponent(q));
        var data = await resp.json();
        var container = document.getElementById('fkEditorMemberResults');
        if (!data.success) {
            container.innerHTML = '<div class="list-group-item text-danger small">' + (data.message || 'Fel') + '</div>';
            container.style.display = '';
            return;
        }
        if (!data.members || data.members.length === 0) {
            container.innerHTML = '<div class="list-group-item text-muted small">Inga matchningar.</div>';
            container.style.display = '';
            return;
        }
        var existingIds = (fkEditorConfig.collaborators || []).map(function(c) { return c.memberId; });
        container.innerHTML = data.members.map(function(m) {
            var already = existingIds.indexOf(m.memberId) >= 0;
            return '<button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"' +
                (already ? ' disabled' : ' onclick="fkEditorAddCollaborator(' + m.memberId + ')"') + '>' +
                '<span><i class="bi bi-person me-1"></i>' + escapeHtml(m.memberName) +
                    (m.clubName ? ' <small class="text-muted">(' + escapeHtml(m.clubName) + ')</small>' : '') + '</span>' +
                (already ? '<span class="badge bg-secondary">Redan tillagd</span>' : '<i class="bi bi-plus"></i>') +
            '</button>';
        }).join('');
        container.style.display = '';
    } catch (e) {
        console.error(e);
    }
}

async function fkEditorAddCollaborator(memberId) {
    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/AddCollaborator', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ configId: fkEditorConfig.id, memberId: memberId })
        });
        var data = await resp.json();
        if (!data.success) { alert('Kunde inte lägga till: ' + (data.message || 'Okänt fel')); return; }
        // Reload the config to get fresh collaborator list.
        await fkEditorReloadMeta();
        document.getElementById('fkEditorMemberSearch').value = '';
        document.getElementById('fkEditorMemberResults').style.display = 'none';
    } catch (e) {
        console.error(e);
        alert('Nätverksfel.');
    }
}

async function fkEditorRemoveCollaborator(memberId) {
    if (!confirm('Ta bort medredigerare?')) return;
    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/RemoveCollaborator', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ configId: fkEditorConfig.id, memberId: memberId })
        });
        var data = await resp.json();
        if (!data.success) { alert('Kunde inte ta bort: ' + (data.message || 'Okänt fel')); return; }
        await fkEditorReloadMeta();
    } catch (e) {
        console.error(e);
        alert('Nätverksfel.');
    }
}

async function fkEditorReloadMeta() {
    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/Get?id=' + fkEditorConfig.id);
        var data = await resp.json();
        if (data.success) {
            fkEditorConfig.collaborators = data.configuration.collaborators || [];
            fkEditorRenderMeta();
        }
    } catch (e) { console.error(e); }
}

// ─── Weapon class picker ─────────────────────────────────────────────

function fkEditorOpenWeaponClassPicker() {
    var allClasses = (window.HpskShootingClasses || []).map(function(sc) { return sc.weapon; });
    var unique = [...new Set(allClasses)].filter(function(w) { return w; });
    // Group: A-family first, then R, B, C.
    var ordered = ['A', 'A_Opt', 'A_M', 'A_P', 'A_G', 'R', 'B', 'C'].filter(function(w) { return unique.indexOf(w) >= 0; });
    var currentSet = new Set(faltCfgWeaponClasses);
    var container = document.getElementById('fkEditorWeaponClassChecks');
    container.innerHTML = ordered.map(function(wc) {
        var checked = currentSet.has(wc) ? 'checked' : '';
        return '<div class="form-check"><input class="form-check-input" type="checkbox" value="' + wc + '" id="fkEditorWC_' + wc + '" ' + checked + '>' +
               '<label class="form-check-label" for="fkEditorWC_' + wc + '">' + wc + '</label></div>';
    }).join('');
    bootstrap.Modal.getOrCreateInstance(document.getElementById('fkEditorWeaponClassModal')).show();
}

function fkEditorApplyWeaponClasses() {
    var picked = Array.from(document.querySelectorAll('#fkEditorWeaponClassChecks input[type=checkbox]:checked'))
                      .map(function(el) { return el.value; });
    if (picked.length === 0) { alert('Välj minst en vapenklass.'); return; }
    bootstrap.Modal.getInstance(document.getElementById('fkEditorWeaponClassModal')).hide();

    // Re-init configurator with the new class set; keep the existing JSON.
    var blob = JSON.parse(JSON.stringify(faltCfgData));
    // Remove unselected classes from the blob.
    Object.keys(blob).forEach(function(k) {
        if (k.startsWith('_')) return;
        if (picked.indexOf(k) < 0) delete blob[k];
    });
    faltCfgOpen(picked, blob);
    faltCfgMarkDirty(picked[0], 1); // surface a dirty indicator on station 1
}

// ─── Linked-station reload UX ────────────────────────────────────────
// After every renderActiveTab, scan station cards for _linkedFromConfigId
// meta and inject a banner that shows the link state (in-sync, diverged,
// or source-unavailable). Source configs are fetched once + cached.

var fkLinkSourceCache = {}; // configId -> { blob, name } | null
var fkLinkFetchInFlight = {}; // configId -> Promise (dedup concurrent fetches)
var fkLinkFirstRender = true;

async function fkLinkEnsureSource(configId) {
    if (configId in fkLinkSourceCache) return fkLinkSourceCache[configId];
    if (fkLinkFetchInFlight[configId]) return fkLinkFetchInFlight[configId];
    fkLinkFetchInFlight[configId] = (async function() {
        try {
            var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/GetStationsForImport?id=' + configId);
            var data = await resp.json();
            if (data.success) {
                try {
                    fkLinkSourceCache[configId] = { blob: JSON.parse(data.jsonBlob), name: data.name };
                } catch (e) { fkLinkSourceCache[configId] = null; }
            } else {
                fkLinkSourceCache[configId] = null;
            }
        } catch (e) {
            fkLinkSourceCache[configId] = null;
        }
        delete fkLinkFetchInFlight[configId];
        return fkLinkSourceCache[configId];
    })();
    return fkLinkFetchInFlight[configId];
}

function fkLinkStationsWithMeta(stationNum) {
    // Collect per-class link metadata for one station number. Empty when no class
    // on this station has _linkedFromConfigId.
    var entries = [];
    faltCfgWeaponClasses.forEach(function(wc) {
        var stations = (faltCfgData[wc] && faltCfgData[wc].stations) || [];
        var st = stations.find(function(s) { return s.station === stationNum; });
        if (st && st._linkedFromConfigId) {
            entries.push({ wc: wc, station: st });
        }
    });
    return entries;
}

async function fkLinkPostRender() {
    var cards = document.querySelectorAll('.card[data-station]');
    if (cards.length === 0) return;

    // Collect distinct source ids needed; fetch them up front (parallel).
    var ids = new Set();
    cards.forEach(function(card) {
        var stationNum = parseInt(card.dataset.station);
        fkLinkStationsWithMeta(stationNum).forEach(function(e) { ids.add(e.station._linkedFromConfigId); });
    });
    await Promise.all([...ids].map(fkLinkEnsureSource));

    cards.forEach(function(card) {
        // Remove any prior banner to avoid duplicates on re-render.
        var existing = card.querySelector('.fk-link-banner');
        if (existing) existing.remove();

        var stationNum = parseInt(card.dataset.station);
        var entries = fkLinkStationsWithMeta(stationNum);
        if (entries.length === 0) return;

        // Aggregate: are all classes linked from the same source/station? Diverged anywhere?
        var first = entries[0].station;
        var srcId = first._linkedFromConfigId;
        var srcStationNum = first._linkedFromStationNumber;
        var source = fkLinkSourceCache[srcId];
        var sourceName = source ? source.name : null;

        var diverged = false;
        var unavailable = !source;
        if (!unavailable) {
            // Find source's station in any class to compute current checksum.
            var classes = Object.keys(source.blob).filter(function(k) { return !k.startsWith('_'); });
            var srcSt = null;
            for (var i = 0; i < classes.length && !srcSt; i++) {
                var srcStations = source.blob[classes[i]].stations || source.blob[classes[i]].Stations || [];
                srcSt = srcStations.find(function(s) { return (s.station || s.Station) === srcStationNum; });
            }
            if (!srcSt) {
                unavailable = true;
            } else {
                var currentChecksum = fkImportComputeChecksum(srcSt);
                diverged = currentChecksum !== first._linkedFromChecksum;
            }
        }

        var banner = document.createElement('div');
        banner.className = 'fk-link-banner';
        if (unavailable) {
            banner.className += ' alert alert-secondary py-1 px-2 small mb-2 mt-1';
            banner.innerHTML = '<i class="bi bi-link-45deg me-1"></i>Länkad från en konfiguration som inte längre är åtkomlig. ' +
                '<button class="btn btn-link btn-sm p-0 align-baseline text-danger" onclick="fkLinkUnlink(' + stationNum + ')">Avlänka</button>';
        } else if (diverged) {
            banner.className += ' alert alert-warning py-1 px-2 small mb-2 mt-1';
            banner.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i><strong>Källan har ändrats</strong> &mdash; "' + escapeHtml(sourceName) + '" station ' + srcStationNum + '. ' +
                '<button class="btn btn-link btn-sm p-0 align-baseline" onclick="fkLinkReload(' + stationNum + ')">Ladda om</button> &middot; ' +
                '<button class="btn btn-link btn-sm p-0 align-baseline text-danger" onclick="fkLinkUnlink(' + stationNum + ')">Avlänka</button>';
        } else {
            banner.className += ' alert alert-info py-1 px-2 small mb-2 mt-1';
            banner.innerHTML = '<i class="bi bi-link-45deg me-1"></i>Länkad från "' + escapeHtml(sourceName) + '" station ' + srcStationNum + ' (synkad). ' +
                '<button class="btn btn-link btn-sm p-0 align-baseline text-danger" onclick="fkLinkUnlink(' + stationNum + ')">Avlänka</button>';
        }

        var cardBody = card.querySelector('.card-body');
        if (cardBody) cardBody.insertBefore(banner, cardBody.firstChild);
    });
}

function fkLinkReload(stationNum) {
    faltCfgWeaponClasses.forEach(function(wc) {
        var stations = (faltCfgData[wc] && faltCfgData[wc].stations) || [];
        var st = stations.find(function(s) { return s.station === stationNum; });
        if (!st || !st._linkedFromConfigId) return;
        var source = fkLinkSourceCache[st._linkedFromConfigId];
        if (!source || !source.blob) return;
        var srcStations = (source.blob[wc] && source.blob[wc].stations) || [];
        var srcSt = srcStations.find(function(s) { return s.station === st._linkedFromStationNumber; });
        if (!srcSt) return;

        var copy = JSON.parse(JSON.stringify(srcSt));
        copy.station = stationNum;
        copy.isShootOffOnly = st.isShootOffOnly;
        copy._linkedFromConfigId = st._linkedFromConfigId;
        copy._linkedFromStationNumber = st._linkedFromStationNumber;
        copy._linkedFromChecksum = fkImportComputeChecksum(srcSt);

        var idx = stations.indexOf(st);
        stations[idx] = copy;
    });
    faltCfgMarkDirty(faltCfgWeaponClasses[0], stationNum);
    renderActiveTab();
}

function fkLinkUnlink(stationNum) {
    if (!confirm('Avlänka station ' + stationNum + '? Stationen blir en oberoende kopia.')) return;
    faltCfgWeaponClasses.forEach(function(wc) {
        var stations = (faltCfgData[wc] && faltCfgData[wc].stations) || [];
        var st = stations.find(function(s) { return s.station === stationNum; });
        if (!st) return;
        delete st._linkedFromConfigId;
        delete st._linkedFromStationNumber;
        delete st._linkedFromChecksum;
    });
    faltCfgMarkDirty(faltCfgWeaponClasses[0], stationNum);
    renderActiveTab();
}

// Hook the shared renderer so link banners are re-decorated on every render.
(function() {
    if (typeof renderActiveTab !== 'function') return; // shared script not loaded yet (shouldn't happen)
    var orig = renderActiveTab;
    window.renderActiveTab = function() {
        var result = orig.apply(this, arguments);
        // Fire-and-forget; cached source data makes this near-instant after first run.
        fkLinkPostRender().catch(function(e) { console.error(e); });
        return result;
    };
})();

// ─── Import station from another configuration ──────────────────────

var fkImportSourceConfig = null;     // full Get response of the picked source config
var fkImportSelectedStation = null;  // station number in source

async function fkImportOpen() {
    document.getElementById('fkImportSourceSelect').innerHTML = '<option value="">Laddar...</option>';
    document.getElementById('fkImportStationPicker').style.display = 'none';
    document.getElementById('fkImportDestPicker').style.display = 'none';
    document.getElementById('fkImportSummary').style.display = 'none';
    document.getElementById('fkImportApplyBtn').disabled = true;
    fkImportSourceConfig = null;
    fkImportSelectedStation = null;
    bootstrap.Modal.getOrCreateInstance(document.getElementById('fkImportModal')).show();

    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/ListAccessible');
        var data = await resp.json();
        if (!data.success) {
            document.getElementById('fkImportSourceSelect').innerHTML = '<option value="">' + (data.message || 'Fel') + '</option>';
            return;
        }
        var sel = document.getElementById('fkImportSourceSelect');
        sel.innerHTML = '<option value="">Välj konfiguration...</option>';
        data.configurations.forEach(function(c) {
            if (c.id === fkEditorConfig.id) return; // can't import from self
            var label = c.name + ' (' + c.stationCount + ' stationer, ' + c.ownerMemberName + ')';
            sel.innerHTML += '<option value="' + c.id + '">' + escapeHtml(label) + '</option>';
        });
    } catch (e) { console.error(e); }
}

async function fkImportSourceChanged() {
    var id = parseInt(document.getElementById('fkImportSourceSelect').value);
    fkImportSourceConfig = null;
    fkImportSelectedStation = null;
    document.getElementById('fkImportStationPicker').style.display = 'none';
    document.getElementById('fkImportDestPicker').style.display = 'none';
    document.getElementById('fkImportSummary').style.display = 'none';
    document.getElementById('fkImportApplyBtn').disabled = true;
    if (!id) return;

    try {
        var resp = await fetch('/umbraco/surface/FaltskytteConfiguration/GetStationsForImport?id=' + id);
        var data = await resp.json();
        if (!data.success) { alert('Kunde inte ladda: ' + (data.message || 'Fel')); return; }

        var srcBlob = {};
        try { srcBlob = data.jsonBlob ? JSON.parse(data.jsonBlob) : {}; } catch(e) { srcBlob = {}; }
        fkImportSourceConfig = { id: data.id, name: data.name, blob: srcBlob };

        // Detect source's stations from the first non-meta weapon class.
        var srcStations = fkImportStationsFromBlob(srcBlob);
        var list = document.getElementById('fkImportStationList');
        if (srcStations.length === 0) {
            list.innerHTML = '<div class="col-12 text-muted small">Källan saknar konfigurerade stationer.</div>';
        } else {
            list.innerHTML = srcStations.map(function(st) {
                var summary = fkImportStationSummary(srcBlob, st.station);
                return '<div class="col-md-6"><button type="button" class="btn btn-outline-secondary w-100 text-start" onclick="fkImportPickStation(' + st.station + ')">' +
                    '<div class="d-flex justify-content-between"><span class="fw-bold">Station ' + st.station + '</span><small class="text-muted">' + summary.classes + ' klass(er), ' + summary.targetGroups + ' målgr.</small></div>' +
                    '<div class="small text-muted">' + escapeHtml(summary.preview) + '</div>' +
                '</button></div>';
            }).join('');
        }
        document.getElementById('fkImportStationPicker').style.display = '';
    } catch (e) { console.error(e); alert('Nätverksfel.'); }
}

// Pull station numbers from the first weapon class in the blob (all classes share station numbers).
function fkImportStationsFromBlob(blob) {
    var classes = Object.keys(blob).filter(function(k) { return !k.startsWith('_'); });
    for (var i = 0; i < classes.length; i++) {
        var st = (blob[classes[i]] && (blob[classes[i]].stations || blob[classes[i]].Stations)) || [];
        if (st.length > 0) return st;
    }
    return [];
}

function fkImportStationSummary(blob, stationNum) {
    var classes = Object.keys(blob).filter(function(k) { return !k.startsWith('_'); });
    var firstStation = null;
    for (var i = 0; i < classes.length; i++) {
        var stations = (blob[classes[i]].stations || blob[classes[i]].Stations) || [];
        var st = stations.find(function(s) { return s.station === stationNum || s.Station === stationNum; });
        if (st) { firstStation = st; break; }
    }
    if (!firstStation) return { classes: classes.length, targetGroups: 0, preview: '' };
    var tgs = firstStation.targetGroups || firstStation.TargetGroups || [];
    var figNames = [];
    tgs.forEach(function(tg) {
        (tg.figures || tg.Figures || []).forEach(function(f) {
            if (f.targetName || f.TargetName) figNames.push(f.targetName || f.TargetName);
        });
    });
    return {
        classes: classes.length,
        targetGroups: tgs.length,
        preview: figNames.length ? figNames.slice(0, 4).join(', ') + (figNames.length > 4 ? '...' : '') : '(inga figurer valda)'
    };
}

function fkImportPickStation(stationNum) {
    fkImportSelectedStation = stationNum;

    // Highlight pick.
    document.querySelectorAll('#fkImportStationList button').forEach(function(b) { b.classList.remove('btn-primary'); b.classList.add('btn-outline-secondary'); });
    var pickedBtn = document.querySelector('#fkImportStationList button[onclick*="fkImportPickStation(' + stationNum + ')"]');
    if (pickedBtn) { pickedBtn.classList.remove('btn-outline-secondary'); pickedBtn.classList.add('btn-primary'); }

    // Populate destination select with this config's station numbers.
    var destSel = document.getElementById('fkImportDestSelect');
    destSel.innerHTML = '';
    var destStations = (faltCfgData[faltCfgWeaponClasses[0]] && faltCfgData[faltCfgWeaponClasses[0]].stations) || [];
    destStations.forEach(function(s) {
        destSel.innerHTML += '<option value="' + s.station + '">Station ' + s.station + '</option>';
    });
    document.getElementById('fkImportDestPicker').style.display = '';

    fkImportRefreshSummary();
    document.getElementById('fkImportApplyBtn').disabled = false;
}

function fkImportRefreshSummary() {
    if (!fkImportSourceConfig || fkImportSelectedStation == null) return;
    var srcClasses = Object.keys(fkImportSourceConfig.blob).filter(function(k) { return !k.startsWith('_'); });
    var destClasses = faltCfgWeaponClasses;
    var overlap = srcClasses.filter(function(c) { return destClasses.indexOf(c) >= 0; });
    var missingInDest = srcClasses.filter(function(c) { return destClasses.indexOf(c) < 0; });
    var missingInSrc = destClasses.filter(function(c) { return srcClasses.indexOf(c) < 0; });

    var lines = [];
    lines.push('<strong>Importerar:</strong> Station ' + fkImportSelectedStation + ' från "' + escapeHtml(fkImportSourceConfig.name) + '"');
    lines.push('Klasser som kommer kopieras: ' + (overlap.length ? overlap.join(', ') : '<em>inga</em>'));
    if (missingInDest.length) lines.push('<span class="text-warning">Källan har klasser som inte finns här: ' + missingInDest.join(', ') + ' (hoppas över)</span>');
    if (missingInSrc.length) lines.push('<span class="text-muted">Den här konfigurationen har klasser som källan saknar: ' + missingInSrc.join(', ') + ' (lämnas orörda)</span>');

    var box = document.getElementById('fkImportSummary');
    box.innerHTML = lines.join('<br>');
    box.style.display = '';
}

async function fkImportApply() {
    if (!fkImportSourceConfig || fkImportSelectedStation == null) return;
    var destStationNum = parseInt(document.getElementById('fkImportDestSelect').value);
    var importType = document.querySelector('input[name="fkImportType"]:checked').value;

    var srcBlob = fkImportSourceConfig.blob;
    var srcClasses = Object.keys(srcBlob).filter(function(k) { return !k.startsWith('_'); });
    var copied = 0;

    for (var i = 0; i < faltCfgWeaponClasses.length; i++) {
        var wc = faltCfgWeaponClasses[i];
        if (srcClasses.indexOf(wc) < 0) continue;
        var srcStations = srcBlob[wc].stations || srcBlob[wc].Stations || [];
        var srcSt = srcStations.find(function(s) { return (s.station || s.Station) === fkImportSelectedStation; });
        if (!srcSt) continue;
        var destStations = faltCfgData[wc].stations || [];
        var destSt = destStations.find(function(s) { return s.station === destStationNum; });
        if (!destSt) continue;

        // Deep-clone source so subsequent edits don't bleed back into the source blob.
        var copy = JSON.parse(JSON.stringify(srcSt));
        copy.station = destStationNum;
        // Carry the existing isShootOffOnly flag — that's a destination-side decision.
        copy.isShootOffOnly = destSt.isShootOffOnly;

        // Strip any leftover linked-from meta from a chain of links; we set fresh
        // values below for the link case.
        delete copy._linkedFromConfigId;
        delete copy._linkedFromStationNumber;
        delete copy._linkedFromChecksum;

        if (importType === 'link') {
            copy._linkedFromConfigId = fkImportSourceConfig.id;
            copy._linkedFromStationNumber = fkImportSelectedStation;
            copy._linkedFromChecksum = fkImportComputeChecksum(srcSt);
        }

        var idx = destStations.indexOf(destSt);
        destStations[idx] = copy;
        copied++;
    }

    if (copied === 0) {
        alert('Inga vapenklasser matchade mellan käll- och destinationskonfigurationen. Inget kopierat.');
        return;
    }

    // Mark every affected class's station dirty + re-render.
    faltCfgWeaponClasses.forEach(function(c) { faltCfgDirtyStations.add(c + '_' + destStationNum); });
    var anyClass = faltCfgWeaponClasses[0];
    faltCfgMarkDirty(anyClass, destStationNum);
    renderActiveTab();

    bootstrap.Modal.getInstance(document.getElementById('fkImportModal')).hide();
}

// Stable checksum over the meaningful station fields, ignoring _linkedFrom* keys
// so a checksum can be compared against the live source after the dest's own
// link meta is stripped off. Cyrb53-style fast non-crypto hash.
function fkImportComputeChecksum(station) {
    var snapshot = JSON.parse(JSON.stringify(station));
    delete snapshot._linkedFromConfigId;
    delete snapshot._linkedFromStationNumber;
    delete snapshot._linkedFromChecksum;
    var canonical = JSON.stringify(snapshot, Object.keys(snapshot).sort());
    return fkSimpleHash(canonical);
}

function fkSimpleHash(str) {
    var h1 = 0xdeadbeef, h2 = 0x41c6ce57;
    for (var i = 0; i < str.length; i++) {
        var ch = str.charCodeAt(i);
        h1 = Math.imul(h1 ^ ch, 2654435761);
        h2 = Math.imul(h2 ^ ch, 1597334677);
    }
    h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507);
    h1 ^= Math.imul(h2 ^ (h2 >>> 13), 3266489909);
    h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507);
    h2 ^= Math.imul(h1 ^ (h1 >>> 13), 3266489909);
    return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(16);
}

@* Make sure HpskShootingClasses is available for the weapon-class picker. *@
</script>

