@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Core.Services
@using HpskSite.Services
@using HpskSite.Controllers
@using Umbraco.Cms.Infrastructure.Scoping
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject IMemberGroupService MemberGroupService
@inject ClubService ClubService
@inject ShootingRangeService RangeService
@inject IScopeProvider ScopeProvider
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Träningsmatch";

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;
    var isAdmin = false;

    // Get member data for identifying own scores and spectator registration
    int? memberId = null;
    string memberName = "";
    string profilePictureUrl = "";
    string clubName = "";

    // Creator's clubs (primary + additional) for the create-match club picker + scope selector
    var myClubsForMatch = new List<object>();
    int myPrimaryClubIdForMatch = 0;
    // Club IDs in the member's region (derived from the primary club's regionalPage ancestor)
    var myRegionClubIds = new List<int>();
    // If the member is currently checked in at a range today, the club to bias defaults toward (0 = none)
    int myCheckInClubId = 0;

    // Check for join code in URL
    var joinCode = Context.Request.Query["join"].ToString();

    // Check for guest session
    GuestSessionInfo? guestSession = null;
    bool isGuest = false;
    if (!isLoggedIn && !string.IsNullOrEmpty(joinCode))
    {
        using var scope = ScopeProvider.CreateScope();
        guestSession = await GuestMatchController.ValidateGuestSession(joinCode, Context.Request, scope.Database);
        scope.Complete();

        if (guestSession != null)
        {
            isGuest = true;
            memberName = guestSession.DisplayName;
        }
    }

    if (isLoggedIn && currentMember != null)
    {
        var member = MemberService.GetByEmail(currentMember.Email ?? string.Empty);
        memberId = member?.Id;

        if (member != null)
        {
            var firstName = member.GetValue<string>("firstName") ?? "";
            var lastName = member.GetValue<string>("lastName") ?? "";
            memberName = $"{firstName} {lastName}".Trim();
            profilePictureUrl = member.GetValue<string>("profilePictureUrl") ?? "";

            // Look up primary club name using ClubService
            var primaryClubId = member.GetValue<int>("primaryClubId");
            if (primaryClubId > 0)
            {
                clubName = ClubService.GetClubNameById(primaryClubId) ?? "";
            }

            // Build the member's full club set (primary + additional via memberClubIds CSV),
            // de-duplicated, primary first. Used by the create-match club picker and scope selector.
            myPrimaryClubIdForMatch = primaryClubId;
            var clubIdOrder = new List<int>();
            if (primaryClubId > 0) clubIdOrder.Add(primaryClubId);
            var additionalClubsCsv = member.HasProperty("memberClubIds") ? member.GetValue<string>("memberClubIds") : null;
            if (!string.IsNullOrWhiteSpace(additionalClubsCsv))
            {
                foreach (var part in additionalClubsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                {
                    if (int.TryParse(part, out var cid) && cid > 0 && !clubIdOrder.Contains(cid))
                    {
                        clubIdOrder.Add(cid);
                    }
                }
            }
            foreach (var cid in clubIdOrder)
            {
                var name = ClubService.GetClubNameById(cid);
                if (!string.IsNullOrEmpty(name))
                {
                    myClubsForMatch.Add(new { id = cid, name });
                }
            }

            // Region scope: all clubs sharing the primary club's regionalPage ancestor.
            // Empty when the club isn't under a region (legacy direct clubsPage) → no region tier.
            if (primaryClubId > 0)
            {
                var clubNode = Umbraco.Content(primaryClubId);
                var regionNode = clubNode?.AncestorOrSelf("regionalPage");
                if (regionNode != null)
                {
                    foreach (var c in regionNode.Descendants("club"))
                    {
                        myRegionClubIds.Add(c.Id);
                    }
                }
            }

            // Check-in bias: if the member is checked in at a range today, prefer that range's
            // club (only when it's one of their own clubs, so it's selectable / in scope).
            if (memberId.HasValue)
            {
                var openSession = await RangeService.GetOpenSessionForMemberAsync(memberId.Value);
                if (openSession != null)
                {
                    var rangeClubIds = await RangeService.GetClubIdsForRangeAsync(openSession.RangeId);
                    myCheckInClubId = rangeClubIds.FirstOrDefault(cid => clubIdOrder.Contains(cid));
                }
            }

            // Check if user is administrator
            var adminGroup = MemberGroupService.GetByName("Administrators");
            if (adminGroup != null)
            {
                var memberGroups = MemberService.GetAllRoles(member.Id);
                isAdmin = memberGroups.Contains("Administrators");
            }
        }
    }
}

