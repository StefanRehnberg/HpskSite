<!-- SignalR Client Library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

@if (isLoggedIn || isGuest)
{
    <script>
        // Global state
        let currentMatchCode = null;
        let currentMatch = null;
        let currentMemberId = @(memberId ?? 0);
        let isCurrentUserAdmin = @(isAdmin ? "true" : "false");
        let isSpectator = false;
        let hubConnection = null;
        let isGuestUser = @(isGuest ? "true" : "false");
        let guestParticipantId = @(guestSession?.GuestId ?? 0);
        let guestMatchCode = '@(guestSession?.MatchCode ?? "")';

        // The current member's clubs (primary + additional) for the create-match club picker
        window.myClubsForMatch = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(myClubsForMatch));
        window.myPrimaryClubId = @(myPrimaryClubIdForMatch);
        window.myRegionClubIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(myRegionClubIds));
        window.myCheckInClubId = @(myCheckInClubId);

        // Escape text before interpolating into innerHTML (club/match names are user/admin-set)
        function escMatchHtml(s) {
            return (s == null ? '' : String(s)).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        }

        // Throttle a fire-and-forget background sweep so repeated page loads don't spam the endpoint
        function sweepGate(key, minMs) {
            try {
                const last = parseInt(localStorage.getItem(key) || '0', 10);
                const now = Date.now();
                if (now - last < minMs) return false;
                localStorage.setItem(key, String(now));
                return true;
            } catch (e) { return true; }
        }

        // ===== Match scope selector (Mina klubbar / specifik klubb / Min region / Alla) =====
        // Narrows the live match lists to what's relevant to this member. Filters only —
        // it never hides unattributed matches (clubId null) and never affects code/QR joins.
        (function initMatchScope() {
            let saved = null;
            try { saved = localStorage.getItem('hpsk_match_scope'); } catch (e) { }
            window.matchScopeWasSaved = !!saved;
            window.matchScope = saved || 'myclubs';
        })();

        function buildMatchScopeOptions() {
            const sel = document.getElementById('matchScopeSelect');
            const wrap = document.getElementById('matchScopeWrapper');
            if (!sel || !wrap) return;

            const clubs = Array.isArray(window.myClubsForMatch) ? window.myClubsForMatch : [];
            const regionIds = Array.isArray(window.myRegionClubIds) ? window.myRegionClubIds : [];

            // Nothing to filter by → hide the selector and show everything
            if (clubs.length === 0 && regionIds.length === 0) {
                wrap.style.setProperty('display', 'none', 'important');
                window.matchScope = 'all';
                return;
            }

            let opts = '';
            if (clubs.length > 0) {
                opts += '<option value="myclubs">Mina klubbar</option>';
                if (clubs.length > 1) {
                    for (const c of clubs) {
                        opts += `<option value="club:${c.id}">${c.name}</option>`;
                    }
                }
            }
            if (regionIds.length > 0) {
                opts += '<option value="region">Min region</option>';
            }
            opts += '<option value="all">Alla</option>';
            sel.innerHTML = opts;

            // Check-in bias: with no saved preference, default to the club the member is checked
            // in at today (only when a specific-club option exists for it). Never overrides a
            // saved choice — purely a default, the user can change it freely.
            if (!window.matchScopeWasSaved && window.myCheckInClubId > 0 && clubs.length > 1) {
                if (clubs.some(c => c.id === window.myCheckInClubId)) {
                    window.matchScope = 'club:' + window.myCheckInClubId;
                }
            }

            // Restore saved scope if still a valid option, else fall back
            const valid = Array.from(sel.options).some(o => o.value === window.matchScope);
            if (!valid) window.matchScope = (clubs.length > 0) ? 'myclubs' : 'all';
            sel.value = window.matchScope;

            wrap.style.setProperty('display', 'flex', 'important');
        }

        function filterMatchesByScope(matches) {
            if (!Array.isArray(matches)) return matches;
            const scope = window.matchScope || 'myclubs';
            if (scope === 'all') return matches;

            let allowed;
            if (scope === 'region') {
                allowed = window.myRegionClubIds || [];
            } else if (scope.indexOf('club:') === 0) {
                allowed = [parseInt(scope.slice(5), 10)];
            } else { // myclubs
                allowed = (window.myClubsForMatch || []).map(c => c.id);
                if (allowed.length === 0) return matches;
            }
            // Never hide unattributed matches (clubId null) — only filter out other clubs' matches
            return matches.filter(m => !m.clubId || allowed.indexOf(m.clubId) !== -1);
        }

        function onMatchScopeChange() {
            const sel = document.getElementById('matchScopeSelect');
            if (sel) window.matchScope = sel.value;
            try { localStorage.setItem('hpsk_match_scope', window.matchScope); } catch (e) { }
            // Re-render already-loaded live tabs from their raw (unfiltered) data
            if (window.ongoingMatchesRaw) renderOngoingMatches(window.ongoingMatchesRaw);
            if (window.upcomingMatchesRaw) renderUpcomingMatches(window.upcomingMatchesRaw);
            // Tab badges must track the active scope too (a tab not yet rendered still needs its count refreshed)
            recomputeMatchBadges();
        }

        // Show/hide + set a tab count badge
        function setMatchBadge(id, count) {
            const badge = document.getElementById(id);
            if (!badge) return;
            if (count > 0) {
                badge.textContent = count;
                badge.style.display = 'inline-block';
            } else {
                badge.style.display = 'none';
            }
        }

        // Recompute the Pågående/Kommande tab badges from the cached raw lists, applying the active scope.
        // This keeps the badge honest with the filtered list — a match in another club no longer shows as a
        // phantom count on a tab whose list is empty.
        function recomputeMatchBadges() {
            if (Array.isArray(window.ongoingMatchesRaw)) {
                setMatchBadge('ongoingMatchCount', filterMatchesByScope(window.ongoingMatchesRaw).length);
            }
            if (Array.isArray(window.upcomingMatchesRaw)) {
                setMatchBadge('upcomingMatchCount', filterMatchesByScope(window.upcomingMatchesRaw).length);
            }
        }

        // Escape hatch from the scope-filtered empty state: switch to "Alla" and re-render so the user can
        // see and join matches held at other clubs/regions straight from the list (not only via code/QR).
        function revealAllMatches() {
            window.matchScope = 'all';
            const sel = document.getElementById('matchScopeSelect');
            if (sel) sel.value = 'all';
            try { localStorage.setItem('hpsk_match_scope', 'all'); } catch (e) { }
            if (Array.isArray(window.ongoingMatchesRaw)) renderOngoingMatches(window.ongoingMatchesRaw);
            if (Array.isArray(window.upcomingMatchesRaw)) renderUpcomingMatches(window.upcomingMatchesRaw);
            recomputeMatchBadges();
        }

        document.addEventListener('DOMContentLoaded', buildMatchScopeOptions);

        // Inactivity timer state
        let inactivityTimerId = null;
        let lastActivityDate = null;
        const INACTIVITY_THRESHOLD_MS = 30 * 60 * 1000; // 30 minutes
        const INACTIVITY_CHECK_INTERVAL_MS = 30 * 1000;  // check every 30 seconds

        // ===== Connection Status Banner Functions =====
        function showConnectionBanner(message, type, clickable = false) {
            let banner = document.getElementById('connectionBanner');
            if (!banner) {
                banner = document.createElement('div');
                banner.id = 'connectionBanner';
                banner.style.cssText = 'position:fixed;top:0;left:0;right:0;padding:12px;text-align:center;z-index:9999;font-weight:bold;';
                document.body.prepend(banner);
            }
            banner.className = type === 'warning' ? 'bg-warning text-dark' : 'bg-danger text-white';
            banner.textContent = message;
            banner.style.display = 'block';

            if (clickable) {
                banner.style.cursor = 'pointer';
                banner.onclick = () => {
                    showConnectionBanner("Återansluter...", "warning");
                    hubConnection.start()
                        .then(() => {
                            hideConnectionBanner();
                            reconnectToMatchGroups();
                        })
                        .catch(err => {
                            console.error("Manual reconnect failed:", err);
                            showConnectionBanner("Kunde inte återansluta. Tryck för att försöka igen.", "danger", true);
                        });
                };
            } else {
                banner.style.cursor = 'default';
                banner.onclick = null;
            }
        }

        function hideConnectionBanner() {
            const banner = document.getElementById('connectionBanner');
            if (banner) {
                banner.style.display = 'none';
            }
        }

        function reconnectToMatchGroups() {
            if (currentMatchCode) {
                joinMatchSignalRGroup(currentMatchCode);
                // Check if current user is the match creator (organizer)
                if (currentMatch && currentMatch.createdByMemberId === currentMemberId) {
                    joinOrganizerSignalRGroup(currentMatchCode);
                }
                // Refresh match data to get latest state
                if (typeof loadMatchData === 'function') {
                    loadMatchData(currentMatchCode, isSpectator);
                }
            }
        }

        // Set member data on body for other scripts to access
        document.body.dataset.memberId = '@(memberId ?? 0)';
        document.body.dataset.memberName = '@Html.Raw(memberName.Replace("'", "\\'"))';
        document.body.dataset.profilePictureUrl = '@Html.Raw(profilePictureUrl.Replace("'", "\\'"))';
        document.body.dataset.clubName = '@Html.Raw(clubName.Replace("'", "\\'"))';

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Run auto-close in background (don't block UI)
            autoCloseStaleMatches();

            // Load badge counts in parallel (non-blocking)
            loadBadgeCounts();

            // Check for join code in URL
            const urlParams = new URLSearchParams(window.location.search);
            const joinCode = urlParams.get('join');

            // Handle guest users - they're already added as participants, just load the match
            if (isGuestUser && guestMatchCode) {
                // Clear URL parameter and load match directly
                window.history.replaceState({}, '', window.location.pathname);
                loadMatch(guestMatchCode);
            } else if (joinCode) {
                // Try to join the match (for registered users)
                joinMatchByCode(joinCode);
            } else {
                // Check for active matches immediately
                checkActiveMatches();
            }

            // Deep-link to the Topplista tab (e.g. from the home hub: /traningsmatch?tab=topplista)
            if (urlParams.get('tab') === 'topplista') {
                const rankBtn = document.getElementById('ranking-tab');
                if (rankBtn) rankBtn.click();
            }
        });

        // Check if user has any active matches
        function checkActiveMatches() {
            // Show loading state to clear previous view
            showLoading();

            fetch('/umbraco/surface/TrainingMatch/GetMyActiveMatches')
                .then(response => response.json())
                .then(result => {
                    hideLoading();

                    if (result.success) {
                        // Refresh member ID from server response to keep client in sync
                        if (result.currentMemberId !== null && result.currentMemberId !== undefined) {
                            if (currentMemberId !== result.currentMemberId) {
                                console.log(`Member ID refreshed: ${currentMemberId} -> ${result.currentMemberId}`);
                            }
                            currentMemberId = result.currentMemberId;
                            document.body.dataset.memberId = result.currentMemberId;
                        }

                        if (result.matches && result.matches.length > 0) {
                            // User has active match - show main view with active match card
                            const latestMatch = result.matches[0];
                            currentMatchCode = latestMatch.matchCode;

                            // Show main view (tabs) but also update active match card
                            showMainView();

                            // Load ongoing matches as default tab
                            loadOngoingMatches();

                            // Update active match card in sidebar
                            fetch(`/umbraco/surface/TrainingMatch/GetMatch?matchCode=${latestMatch.matchCode}`)
                                .then(response => response.json())
                                .then(matchResult => {
                                    if (matchResult.success) {
                                        currentMatch = matchResult.match;
                                        updateActiveMatchCard(matchResult.match);
                                    }
                                });
                        } else {
                            // No active matches - show main view with tabs
                            showMainView();
                            // Load ongoing matches as default tab
                            loadOngoingMatches();
                            updateActiveMatchCard(null);
                        }
                    } else {
                        // Error or no active matches - show main view
                        showMainView();
                        loadOngoingMatches();
                        updateActiveMatchCard(null);
                    }
                })
                .catch(error => {
                    console.error('Error checking active matches:', error);
                    hideLoading();
                    showMainView();
                    loadOngoingMatches();
                });
        }

        // Store pending match code for after shooter class is set
        let pendingJoinMatchCode = null;
        let pendingJoinDiscipline = 'Precision';

        // Join match by code
        async function joinMatchByCode(code, teamId = null) {
            console.log('joinMatchByCode called with code:', code, 'teamId:', teamId);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const requestBody = { matchCode: code };
                if (teamId !== null) {
                    requestBody.teamId = teamId;
                }

                const response = await fetch('/umbraco/surface/TrainingMatch/JoinMatch', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify(requestBody)
                });
                const result = await response.json();

                if (result.success) {
                    // Unregister as spectator first (wait for it to complete)
                    await unregisterAsSpectator(code);
                    // Clear URL parameter and load match
                    window.history.replaceState({}, '', window.location.pathname);
                    // Load the match (will switch to scoreboard view)
                    loadMatch(code);
                } else if (result.requiresTeam && result.teams) {
                    // Team match - show team selection modal
                    // Check if showTeamSelectionModal function exists (from TrainingMatchJoin.cshtml)
                    if (typeof showTeamSelectionModal === 'function') {
                        showTeamSelectionModal(code, result.teams, result.isOpen !== false);
                    } else {
                        alert('Välj ett lag att gå med i: ' + result.teams.map(t => t.teamName).join(', '));
                    }
                } else if (result.needsShooterClass) {
                    // User needs to set their shooter class before joining handicap match
                    pendingJoinMatchCode = code;
                    pendingJoinDiscipline = result.discipline || 'Precision';
                    showShooterClassModal();
                } else {
                    alert(result.message || 'Kunde inte gå med i matchen');
                    hideLoading();
                    showNoMatchState();
                }
            } catch (error) {
                console.error('Error joining match:', error);
                alert('Något gick fel vid anslutning till matchen');
                hideLoading();
                showNoMatchState();
            }
        }

        // Wrapper function called from team selection modal
        function joinMatchByCodeWithTeam(code, teamId) {
            joinMatchByCode(code, teamId);
        }

        // Show shooter class selection modal
        function showShooterClassModal() {
            const modal = new bootstrap.Modal(document.getElementById('shooterClassModal'));
            modal.show();
        }

        // Save shooter class and retry joining match
        async function saveShooterClassAndJoin() {
            const selectedClass = document.querySelector('input[name="shooterClassRadio"]:checked')?.value;
            if (!selectedClass) {
                alert('Välj en skytteklass');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const saveBtn = document.getElementById('saveShooterClassBtn');
            const originalText = saveBtn.innerHTML;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sparar...';
            saveBtn.disabled = true;

            try {
                const response = await fetch('/umbraco/surface/TrainingMatch/SetShooterClass', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ shooterClass: selectedClass, discipline: pendingJoinDiscipline || 'Precision' })
                });
                const result = await response.json();

                if (result.success) {
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('shooterClassModal'));
                    modal.hide();

                    // Now retry joining the match
                    if (pendingJoinMatchCode) {
                        showToast('Skytteklass sparad! Ansluter till matchen...', 'success');
                        setTimeout(() => {
                            joinMatchByCode(pendingJoinMatchCode);
                            pendingJoinMatchCode = null;
                        }, 500);
                    }
                } else {
                    alert(result.message || 'Kunde inte spara skytteklass');
                }
            } catch (error) {
                console.error('Error saving shooter class:', error);
                alert('Något gick fel vid sparande av skytteklass');
            } finally {
                saveBtn.innerHTML = originalText;
                saveBtn.disabled = false;
            }
        }

        // ===== Inactivity Timer Functions =====
        function startInactivityTimer() {
            stopInactivityTimer();
            inactivityTimerId = setInterval(checkInactivity, INACTIVITY_CHECK_INTERVAL_MS);
        }

        function stopInactivityTimer() {
            if (inactivityTimerId) {
                clearInterval(inactivityTimerId);
                inactivityTimerId = null;
            }
            const banner = document.getElementById('inactivityBanner');
            if (banner) banner.style.display = 'none';
        }

        function checkInactivity() {
            if (!currentMatch || !lastActivityDate) return;
            if (currentMatch.status !== 'Active') return;

            // Only show banner to the creator
            const myId = parseInt(document.body.dataset.memberId) || 0;
            if (currentMatch.createdByMemberId !== myId) return;

            const elapsed = Date.now() - new Date(lastActivityDate).getTime();
            const banner = document.getElementById('inactivityBanner');
            if (!banner) return;

            if (elapsed >= INACTIVITY_THRESHOLD_MS) {
                banner.style.display = 'flex';
            }
        }

        async function extendMatch() {
            if (!currentMatchCode) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            try {
                const response = await fetch('/umbraco/surface/TrainingMatch/ExtendMatch', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ matchCode: currentMatchCode })
                });
                const result = await response.json();
                if (result.success) {
                    lastActivityDate = result.lastActivityDate;
                    const banner = document.getElementById('inactivityBanner');
                    if (banner) banner.style.display = 'none';
                    showToast('Matchen fortsätter!', 'success');
                } else {
                    showToast(result.message || 'Kunde inte förlänga matchen', 'warning');
                }
            } catch (error) {
                console.error('Error extending match:', error);
                showToast('Något gick fel', 'danger');
            }
        }

        function endMatchFromBanner() {
            if (confirm('Är du säker på att du vill avsluta matchen? Detta kan inte ångras.')) {
                completeMatch();
            }
        }

        // Load match data
        function loadMatch(matchCode) {
            showLoading();
            currentMatchCode = matchCode;
            isSpectator = false; // Reset spectator mode when loading a match normally

            fetch(`/umbraco/surface/TrainingMatch/GetMatch?matchCode=${matchCode}`, { credentials: 'same-origin' })
                .then(response => response.json())
                .then(result => {
                    hideLoading();
                    if (result.success) {
                        // Handle guest sessions from server
                        if (result.isGuestSession) {
                            isGuestUser = true;
                            guestParticipantId = result.guestId;
                            guestMatchCode = matchCode;
                            console.log('Guest session confirmed by server:', result.guestName, 'ID:', result.guestId);
                        }

                        // Refresh member ID from server response to keep client in sync
                        // This MUST happen BEFORE the creator check below!
                        // For guests, currentMemberId will be null
                        if (result.currentMemberId !== null && result.currentMemberId !== undefined) {
                            if (currentMemberId !== result.currentMemberId) {
                                console.log(`Member ID refreshed: ${currentMemberId} -> ${result.currentMemberId}`);
                            }
                            currentMemberId = result.currentMemberId;
                            document.body.dataset.memberId = result.currentMemberId;
                        }

                        currentMatch = result.match;
                        showScoreboardView();
                        renderScoreboard(result.match);

                        // Track inactivity for active matches
                        lastActivityDate = result.match.lastActivityDate || result.match.createdDate;
                        const myIdForTimer = parseInt(document.body.dataset.memberId) || 0;
                        if (result.match.status === 'Active' && result.match.createdByMemberId === myIdForTimer) {
                            startInactivityTimer();
                        } else {
                            stopInactivityTimer();
                        }

                        // Note: We don't update active match card here since sidebar is hidden
                        // It will be updated when user goes back to main view

                        // Join SignalR groups
                        joinMatchSignalRGroup(matchCode);

                        // If user is the creator (not a guest), join organizer group for join request notifications
                        const myMemberId = parseInt(document.body.dataset.memberId) || 0;
                        if (!isGuestUser && result.match.createdByMemberId === myMemberId) {
                            joinOrganizerSignalRGroup(matchCode);
                            loadPendingJoinRequests(matchCode);
                        }
                    } else {
                        // Not found is usually benign here (the match was just completed or removed) —
                        // show a non-blocking toast instead of an alert dialog and return to the list.
                        currentMatchCode = null;
                        showToast(result.message || 'Matchen kunde inte laddas (kan ha avslutats).', 'info');
                        showMainView();
                        loadOngoingMatches();
                    }
                })
                .catch(error => {
                    console.error('Error loading match:', error);
                    hideLoading();
                    showToast('Något gick fel vid laddning av matchen', 'warning');
                    showMainView();
                    loadOngoingMatches();
                });
        }

        // Refresh current match
        function refreshMatch() {
            if (currentMatchCode) {
                loadMatch(currentMatchCode);
            }
        }

        // Alias for refreshMatch (used by guest modal)
        function refreshMatchData() {
            refreshMatch();
        }

        // UI State functions
        function showLoading() {
            document.getElementById('loadingState').style.display = 'block';
            document.getElementById('mainView').style.display = 'none';
            document.getElementById('scoreboardView').style.display = 'none';
            // Hide the floating add score button
            const addScoreBtn = document.getElementById('addScoreBtn');
            if (addScoreBtn) addScoreBtn.style.display = 'none';
        }

        function hideLoading() {
            document.getElementById('loadingState').style.display = 'none';
        }

        function showMainView() {
            document.getElementById('mainView').style.display = 'block';
            document.getElementById('scoreboardView').style.display = 'none';
            // Show sidebar and restore column widths
            showSidebar();
            // Hide the floating add score button
            const addScoreBtn = document.getElementById('addScoreBtn');
            if (addScoreBtn) addScoreBtn.style.display = 'none';
        }

        function showScoreboardView() {
            document.getElementById('mainView').style.display = 'none';
            document.getElementById('scoreboardView').style.display = 'block';
            // Hide sidebar and expand scoreboard to full width
            hideSidebar();
        }

        // Show/hide entire sidebar column based on view state
        function showSidebar() {
            const sidebarColumn = document.getElementById('sidebarColumn');
            const mobileActiveWrapper = document.getElementById('activeMatchWrapperMobile');
            const mainColumn = document.getElementById('scoreboardView').parentElement;

            if (sidebarColumn) {
                sidebarColumn.style.display = '';
            }
            // Show mobile active match wrapper (the card inside is controlled by updateActiveMatchCard)
            if (mobileActiveWrapper) {
                mobileActiveWrapper.classList.remove('scoreboard-hidden');
            }
            // Restore column class
            if (mainColumn) {
                mainColumn.classList.remove('col-12');
                mainColumn.classList.add('col-lg-8');
            }
        }

        function hideSidebar() {
            const sidebarColumn = document.getElementById('sidebarColumn');
            const mobileActiveWrapper = document.getElementById('activeMatchWrapperMobile');
            const mainColumn = document.getElementById('scoreboardView').parentElement;

            if (sidebarColumn) {
                sidebarColumn.style.display = 'none';
            }
            // Hide mobile active match wrapper when viewing scoreboard
            if (mobileActiveWrapper) {
                mobileActiveWrapper.classList.add('scoreboard-hidden');
            }
            // Expand main column to full width
            if (mainColumn) {
                mainColumn.classList.remove('col-lg-8');
                mainColumn.classList.add('col-12');
            }
        }

        // Legacy aliases for compatibility
        function showNoMatchState() {
            showMainView();
        }

        function showActiveMatchState() {
            showScoreboardView();
        }

        // Update active match card (both mobile and desktop versions)
        function updateActiveMatchCard(match) {
            const mobileCard = document.getElementById('activeMatchCardMobile');
            const desktopCard = document.getElementById('activeMatchCardDesktop');

            if (!match) {
                if (mobileCard) mobileCard.style.display = 'none';
                if (desktopCard) desktopCard.style.display = 'none';
                return;
            }

            // Calculate user's score
            const myParticipant = match.participants?.find(p => p.memberId === currentMemberId);
            let scoreText = 'Inga registrerade serier ännu';
            if (myParticipant && myParticipant.scores?.length > 0) {
                const totalScore = myParticipant.scores.reduce((sum, s) => sum + s.total, 0);
                scoreText = `Din poäng: ${totalScore} (${myParticipant.scores.length} serier)`;
            }

            const matchName = match.matchName || match.matchCode;
            const weaponBadge = 'Klass ' + match.weaponClass;
            const participantCount = (match.participants?.length || 0) + ' deltagare';
            const discipline = match.discipline || 'Precision';
            const disciplineIconHtml = (discipline !== 'Precision')
                ? `<img src="/images/competition-types/${discipline}.png" alt="${discipline}" style="height: 18px; width: auto;" title="${discipline}">`
                : '';

            // Update mobile card
            if (mobileCard) {
                mobileCard.style.display = 'block';
                document.getElementById('activeMatchNameMobile').textContent = matchName;
                document.getElementById('activeMatchWeaponBadgeMobile').textContent = weaponBadge;
                document.getElementById('activeMatchParticipantsMobile').textContent = participantCount;
                document.getElementById('activeMatchScoreMobile').textContent = scoreText;
                const mobileDiscipline = document.getElementById('activeMatchDisciplineIconMobile');
                if (mobileDiscipline) mobileDiscipline.innerHTML = disciplineIconHtml;
            }

            // Update desktop card
            if (desktopCard) {
                desktopCard.style.display = 'block';
                document.getElementById('activeMatchNameDesktop').textContent = matchName;
                document.getElementById('activeMatchWeaponBadgeDesktop').textContent = weaponBadge;
                document.getElementById('activeMatchParticipantsDesktop').textContent = participantCount;
                document.getElementById('activeMatchScoreDesktop').textContent = scoreText;
                const desktopDiscipline = document.getElementById('activeMatchDisciplineIconDesktop');
                if (desktopDiscipline) desktopDiscipline.innerHTML = disciplineIconHtml;
            }
        }

        // Go to active match from sidebar card
        function goToActiveMatch() {
            if (currentMatchCode) {
                loadMatch(currentMatchCode);
            }
        }

        // Create new match
        // Store pending create match data for after shooter class is set
        let pendingCreateMatchData = null;

        function createMatch(matchName, weaponClass, startDate, isOpen = true, hasHandicap = false, isTeamMatch = false, maxShootersPerTeam = null, teams = null, discipline = 'Precision') {
            console.log('createMatch called:', { matchName, weaponClass, startDate, isOpen, hasHandicap, isTeamMatch, maxShootersPerTeam, teams, discipline });
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            console.log('Token:', token ? 'present' : 'MISSING');

            // Club the match is held at — read from the create-match picker (survives the
            // shooter-class retry path since the field persists in the DOM after the modal hides).
            const clubSel = document.getElementById('createMatchClub');
            const clubIdParsed = clubSel && clubSel.value ? parseInt(clubSel.value, 10) : NaN;

            const requestBody = {
                matchName: matchName,
                weaponClass: weaponClass,
                startDate: startDate,
                isOpen: isOpen,
                hasHandicap: hasHandicap,
                isTeamMatch: isTeamMatch,
                discipline: discipline,
                clubId: isNaN(clubIdParsed) ? null : clubIdParsed
            };

            if (isTeamMatch) {
                requestBody.maxShootersPerTeam = maxShootersPerTeam;
                if (teams) {
                    requestBody.teams = teams;
                }
            }

            console.log('Sending request to CreateMatch...');
            fetch('/umbraco/surface/TrainingMatch/CreateMatch', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify(requestBody)
            })
            .then(response => {
                console.log('Response status:', response.status);
                return response.json();
            })
            .then(result => {
                console.log('CreateMatch result:', result);
                if (result.success) {
                    loadMatch(result.matchCode);
                } else if (result.needsShooterClass) {
                    // User needs to set their shooter class before creating handicap match
                    pendingCreateMatchData = { matchName, weaponClass, startDate, isOpen, hasHandicap, isTeamMatch, maxShootersPerTeam, teams, discipline };
                    showShooterClassModalForCreate(result.discipline || discipline);
                } else {
                    alert(result.message || 'Kunde inte skapa matchen');
                }
            })
            .catch(error => {
                console.error('Error creating match:', error);
                alert('Något gick fel vid skapande av matchen');
            });
        }

        // Show shooter class modal for creating a match
        function showShooterClassModalForCreate(discipline) {
            // Update modal to use create handler
            const saveBtn = document.getElementById('saveShooterClassBtn');
            saveBtn.onclick = () => saveShooterClassAndCreate(discipline);
            showShooterClassModal();
        }

        // Save shooter class and retry creating match
        async function saveShooterClassAndCreate(discipline) {
            const selectedClass = document.querySelector('input[name="shooterClassRadio"]:checked')?.value;
            if (!selectedClass) {
                alert('Välj en skytteklass');
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const saveBtn = document.getElementById('saveShooterClassBtn');
            const originalText = saveBtn.innerHTML;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Sparar...';
            saveBtn.disabled = true;

            try {
                const response = await fetch('/umbraco/surface/TrainingMatch/SetShooterClass', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ shooterClass: selectedClass, discipline: discipline || 'Precision' })
                });
                const result = await response.json();

                if (result.success) {
                    // Close modal
                    const modal = bootstrap.Modal.getInstance(document.getElementById('shooterClassModal'));
                    modal.hide();

                    // Reset button handler to default
                    saveBtn.onclick = saveShooterClassAndJoin;

                    // Now retry creating the match
                    if (pendingCreateMatchData) {
                        showToast('Skytteklass sparad! Skapar matchen...', 'success');
                        setTimeout(() => {
                            createMatch(
                                pendingCreateMatchData.matchName,
                                pendingCreateMatchData.weaponClass,
                                pendingCreateMatchData.startDate,
                                pendingCreateMatchData.isOpen,
                                pendingCreateMatchData.hasHandicap,
                                pendingCreateMatchData.isTeamMatch,
                                pendingCreateMatchData.maxShootersPerTeam,
                                pendingCreateMatchData.teams,
                                pendingCreateMatchData.discipline
                            );
                            pendingCreateMatchData = null;
                        }, 500);
                    }
                } else {
                    alert(result.message || 'Kunde inte spara skytteklass');
                }
            } catch (error) {
                console.error('Error saving shooter class:', error);
                alert('Något gick fel vid sparande av skytteklass');
            } finally {
                saveBtn.innerHTML = originalText;
                saveBtn.disabled = false;
            }
        }

        // Leave current match
        function leaveMatch() {
            if (!currentMatchCode) return;

            if (!confirm('Är du säker på att du vill lämna matchen? Dina resultat kommer att tas bort.')) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/umbraco/surface/TrainingMatch/LeaveMatch', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({ matchCode: currentMatchCode })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    currentMatchCode = null;
                    currentMatch = null;
                    // Hide active match card and show main view
                    updateActiveMatchCard(null);
                    showMainView();
                    loadOngoingMatches();
                } else {
                    alert(result.message || 'Kunde inte lämna matchen');
                }
            })
            .catch(error => {
                console.error('Error leaving match:', error);
                alert('Något gick fel');
            });
        }

        // Exit spectator mode (for viewers who want to go back)
        async function exitSpectatorMode() {
            if (currentMatchCode) {
                // Unregister as spectator
                await unregisterAsSpectator(currentMatchCode);
            }

            // Reset state
            currentMatchCode = null;
            currentMatch = null;
            isSpectator = false;

            // Show main view with tabs
            showMainView();
            loadOngoingMatches();
        }

        // Go back to main view from scoreboard (without leaving match)
        function backToMainView() {
            showMainView();

            // Only show active match card if user is a PARTICIPANT (not spectator)
            if (currentMatch && currentMatchCode && !isSpectator) {
                // Check if user is actually a participant in this match
                const isParticipant = currentMatch.participants?.some(p => p.memberId === currentMemberId);
                if (isParticipant) {
                    updateActiveMatchCard(currentMatch);
                } else {
                    updateActiveMatchCard(null);
                }
            } else {
                updateActiveMatchCard(null);
            }

            // Refresh ongoing matches
            ongoingMatchesLoaded = false;
            loadOngoingMatches();
        }

        // Complete/end match
        // Note: Confirmation is handled by confirmEndMatch() in TrainingMatchScoreboard.cshtml
        function completeMatch() {
            if (!currentMatchCode) return;
            stopInactivityTimer();

            // Clear the active code up-front so our own SignalR echo (MatchCompleted / MatchDeleted)
            // can't trigger a refresh of a match that may have just been removed (the <4-series case),
            // which is what produced the misleading "Match hittades inte" dialog.
            const codeBeingClosed = currentMatchCode;
            currentMatchCode = null;
            currentMatch = null;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/umbraco/surface/TrainingMatch/CompleteMatch', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({ matchCode: codeBeingClosed })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    // Use the server message so the shooter learns *why* a short match wasn't saved
                    // (fewer than 4 series → not transferred to results).
                    showToast(result.message || 'Matchen har avslutats!', result.deleted ? 'warning' : 'success');
                    // Hide active match card
                    updateActiveMatchCard(null);
                    // Refresh ongoing matches list and badge immediately
                    ongoingMatchesLoaded = false;
                    loadOngoingMatches();
                    showMainView();
                } else {
                    // Restore context so the user can retry if the close genuinely failed.
                    currentMatchCode = codeBeingClosed;
                    alert(result.message || 'Kunde inte avsluta matchen');
                }
            })
            .catch(error => {
                console.error('Error completing match:', error);
                currentMatchCode = codeBeingClosed;
                alert('Något gick fel');
            });
        }

        // Stop match from list (Ongoing tab)
        function stopMatchFromList(matchCode, matchName) {
            if (!confirm(`Avsluta "${matchName}"?\n\nMatchen kommer att avslutas och flyttas till historiken.`)) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/umbraco/surface/TrainingMatch/CompleteMatch', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({ matchCode: matchCode })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    showToast(result.message || 'Matchen har avslutats', result.deleted ? 'warning' : 'success');
                    // Refresh ongoing matches list
                    ongoingMatchesLoaded = false;
                    loadOngoingMatches();
                    loadBadgeCounts();
                } else {
                    alert(result.message || 'Kunde inte avsluta matchen');
                }
            })
            .catch(error => {
                console.error('Error stopping match:', error);
                alert('Något gick fel');
            });
        }

        // Delete match from list (Upcoming tab)
        function deleteMatchFromList(matchCode, matchName) {
            if (!confirm(`Radera "${matchName}"?\n\nMatchen och alla anmälningar tas bort permanent.`)) {
                return;
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch('/umbraco/surface/TrainingMatch/DeleteMatch', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token || ''
                },
                body: JSON.stringify({ matchCode: matchCode })
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    showToast('Matchen har raderats', 'success');
                    // Refresh upcoming matches list
                    upcomingMatchesLoaded = false;
                    loadUpcomingMatches();
                    loadBadgeCounts();
                } else {
                    alert(result.message || 'Kunde inte radera matchen');
                }
            })
            .catch(error => {
                console.error('Error deleting match:', error);
                alert('Något gick fel');
            });
        }

        // Show share modal
        function showShareModal() {
            if (!currentMatchCode) return;

            const modal = new bootstrap.Modal(document.getElementById('shareMatchModal'));

            // Update share info
            document.getElementById('shareMatchCode').textContent = currentMatchCode;
            document.getElementById('shareMatchLink').value = window.location.origin + '/traningsmatch/?join=' + currentMatchCode;

            // Load QR code
            document.getElementById('shareQrCode').src = '/umbraco/surface/TrainingMatch/GetJoinQrCode?matchCode=' + currentMatchCode;

            modal.show();
        }

        // Copy link to clipboard
        function copyShareLink() {
            const linkInput = document.getElementById('shareMatchLink');
            linkInput.select();
            document.execCommand('copy');

            // Show feedback
            const btn = document.querySelector('#shareMatchModal .btn-outline-primary');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check"></i> Kopierad!';
            btn.classList.remove('btn-outline-primary');
            btn.classList.add('btn-success');

            setTimeout(() => {
                btn.innerHTML = originalText;
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-primary');
            }, 2000);
        }

        // Match History functions
        let matchHistoryLoaded = false;

        function loadMatchHistoryIfNeeded() {
            if (!matchHistoryLoaded) {
                loadMatchHistory();
            }
        }

        // loadMatchHistory is defined in TrainingMatchHistory.cshtml partial

        // View a completed match in modal (read-only)
        function viewCompletedMatch(matchCode) {
            // Show modal and loading state
            const modal = new bootstrap.Modal(document.getElementById('historyMatchModal'));
            document.getElementById('historyMatchLoading').style.display = 'block';
            document.getElementById('historyMatchScoreboard').style.display = 'none';
            modal.show();

            // Fetch match data
            fetch(`/umbraco/surface/TrainingMatch/GetMatch?matchCode=${matchCode}`)
                .then(response => response.json())
                .then(result => {
                    document.getElementById('historyMatchLoading').style.display = 'none';

                    if (result.success) {
                        renderHistoryMatchModal(result.match);
                        document.getElementById('historyMatchScoreboard').style.display = 'block';
                    } else {
                        alert(result.message || 'Kunde inte ladda matchen');
                        bootstrap.Modal.getInstance(document.getElementById('historyMatchModal')).hide();
                    }
                })
                .catch(error => {
                    console.error('Error loading match:', error);
                    document.getElementById('historyMatchLoading').style.display = 'none';
                    alert('Något gick fel vid laddning av matchen');
                    bootstrap.Modal.getInstance(document.getElementById('historyMatchModal')).hide();
                });
        }

        // Render history match modal content (read-only scoreboard)
        function renderHistoryMatchModal(match) {
            // Update header info
            document.getElementById('historyMatchName').textContent = match.matchName || 'Träningsmatch';
            document.getElementById('historyMatchCode').textContent = match.matchCode;
            document.getElementById('historyMatchWeaponClass').textContent = 'Klass ' + match.weaponClass;

            // Show/hide handicap badge
            const historyHandicapBadge = document.getElementById('historyHandicapBadge');
            if (historyHandicapBadge) {
                historyHandicapBadge.style.display = match.hasHandicap ? 'inline-block' : 'none';
            }

            // Format completed date
            const completedDate = match.completedDate ? new Date(match.completedDate) : new Date(match.createdDate);
            document.getElementById('historyMatchDate').textContent = completedDate.toLocaleDateString('sv-SE', {
                year: 'numeric', month: 'short', day: 'numeric'
            });

            // Build participant header row
            const headerRow = document.getElementById('historyParticipantHeaderRow');
            headerRow.innerHTML = '';

            // Determine effective series limit:
            // If maxSeriesCount is set in match settings, use it.
            // Otherwise, use the minimum series count across all participants (equalizes scoring).
            let effectiveSeriesLimit;
            if (match.maxSeriesCount) {
                effectiveSeriesLimit = match.maxSeriesCount;
            } else {
                const participantsWithScores = match.participants.filter(p => p.scores && p.scores.length > 0);
                effectiveSeriesLimit = participantsWithScores.length > 0
                    ? Math.min(...participantsWithScores.map(p => p.scores.length))
                    : 0;
            }

            // Helper to get equalized scores (first N series limited by effectiveSeriesLimit, sorted by seriesNumber)
            function getEqualizedScores(participant) {
                if (!participant.scores || participant.scores.length === 0) return [];
                return [...participant.scores]
                    .sort((a, b) => a.seriesNumber - b.seriesNumber)
                    .slice(0, effectiveSeriesLimit);
            }

            // Get final score based on equalized series (match series limit applied)
            function getFinalScore(participant) {
                const eqScores = getEqualizedScores(participant);
                if (match.hasHandicap && participant.handicapPerSeries !== null && participant.handicapPerSeries !== undefined) {
                    const hcpPerSeries = roundToQuarter(participant.handicapPerSeries);
                    return calculateAdjustedTotalWithCap(eqScores, hcpPerSeries).total;
                }
                return eqScores.reduce((sum, s) => sum + Math.min(s.total, 50), 0);
            }

            // Sort participants by final score (using equalized series)
            const sortedParticipants = [...match.participants].sort((a, b) => {
                return getFinalScore(b) - getFinalScore(a);
            });

            // Create ranking map
            const rankings = new Map();
            sortedParticipants.forEach((p, index) => {
                rankings.set(p.memberId, index + 1);
            });

            match.participants.forEach((participant) => {
                const th = document.createElement('th');
                th.className = 'participant-column';

                const ranking = rankings.get(participant.memberId);
                let rankBadge = '';
                if (ranking === 1) rankBadge = '<span class="badge bg-warning text-dark">🥇 1:a</span>';
                else if (ranking === 2) rankBadge = '<span class="badge bg-secondary">🥈 2:a</span>';
                else if (ranking === 3) rankBadge = '<span class="badge bg-danger">🥉 3:e</span>';
                else rankBadge = `<span class="badge bg-light text-dark">${ranking}:e</span>`;

                // Build handicap info if match has handicap enabled
                let handicapInfo = '';
                if (match.hasHandicap && participant.handicapPerSeries !== null && participant.handicapPerSeries !== undefined) {
                    const hcpDisplay = formatHandicap(participant.handicapPerSeries);
                    const provisionalBadge = participant.isProvisional
                        ? '<span class="provisional-badge" title="Provisoriskt handicap (färre än 8 matcher)">(P)</span>'
                        : '';
                    handicapInfo = `
                        <div class="participant-handicap">
                            <span class="handicap-value">${hcpDisplay}</span>
                            ${provisionalBadge}
                        </div>
                    `;
                }

                th.innerHTML = `
                    <div class="participant-header">
                        ${renderAvatarForHistory(participant)}
                        <div class="participant-name">${participant.firstName || 'Skytt'}</div>
                        ${handicapInfo}
                        ${rankBadge}
                    </div>
                `;
                headerRow.appendChild(th);
            });

            // Find max series to display (show ALL series in history view)
            let maxSeries = 0;
            match.participants.forEach(p => {
                if (p.scores && p.scores.length > maxSeries) {
                    maxSeries = p.scores.length;
                }
            });
            // Note: Don't limit maxSeries here - show all series in history view
            // The maxSeriesCount is only used for equalized ranking calculation above

            // Build score rows
            const tbody = document.getElementById('historyScoreboardBody');
            tbody.innerHTML = '';

            // Series grouping (4+4+4 for Milsnabb / Nationell helmatch, else 6/7/10/12).
            // Shared with the live board's renderScoreboard via trainingMatchSeriesGrouping
            // (defined in TrainingMatchScoreboard.cshtml) so the rule can't drift.
            const grouping = trainingMatchSeriesGrouping(match.discipline);

            for (let seriesNum = 1; seriesNum <= maxSeries; seriesNum++) {
                const tr = document.createElement('tr');

                match.participants.forEach((participant) => {
                    const td = document.createElement('td');
                    td.className = 'score-cell';

                    const score = participant.scores?.find(s => s.seriesNumber === seriesNum);
                    if (score) {
                        // Build photo indicator
                        const hasPhoto = score.targetPhotoUrl && score.targetPhotoUrl.length > 0;
                        const photoIndicator = hasPhoto
                            ? '<i class="bi bi-camera-fill photo-indicator" style="position:absolute;left:4px;top:4px;font-size:0.7rem;color:var(--bs-info);"></i>'
                            : '';

                        // Build reaction display
                        let reactionHtml = '';
                        if (score.reactions && score.reactions.length > 0) {
                            const firstEmoji = score.reactions[0].emoji;
                            const count = score.reactions.length;
                            reactionHtml = count > 1
                                ? `<span class="reaction-indicator">${firstEmoji}<small>+${count-1}</small></span>`
                                : `<span class="reaction-indicator">${firstEmoji}</span>`;
                        }

                        td.innerHTML = `
                            ${photoIndicator}
                            <span class="score-value">${score.total}</span>
                            ${score.xCount > 0 ? `<span class="x-count">${score.xCount}x</span>` : ''}
                            ${reactionHtml}
                        `;
                        td.classList.add('has-score');
                        td.style.position = 'relative';
                        td.style.cursor = 'pointer';

                        // Click to open photo viewer
                        td.onclick = () => openHistoryPhotoViewer(participant, score, match);
                    } else {
                        td.innerHTML = '<span class="score-empty">-</span>';
                    }

                    tr.appendChild(td);
                });

                tbody.appendChild(tr);

                // Add summary row at group boundaries (4+4+4 grouped, else 6/7/10/12).
                if (grouping.summaryAfter.includes(seriesNum) && seriesNum <= maxSeries) {
                    const summaryRow = document.createElement('tr');
                    summaryRow.className = 'summary-row';

                    // For grouped disciplines, show this group's subtotal (just the block of 4);
                    // otherwise show the cumulative total up to this series.
                    const groupStart = grouping.isGrouped ? seriesNum - 3 : 1;

                    match.participants.forEach((participant) => {
                        const td = document.createElement('td');
                        td.className = 'summary-cell';

                        const summarizedScores = (participant.scores || [])
                            .filter(s => s.seriesNumber >= groupStart && s.seriesNumber <= seriesNum)
                            .sort((a, b) => a.seriesNumber - b.seriesNumber);
                        const sumTotal = summarizedScores.reduce((sum, s) => sum + s.total, 0);
                        const sumX = summarizedScores.reduce((sum, s) => sum + (s.xCount || 0), 0);

                        let labelHtml = '';
                        if (grouping.isGrouped) {
                            const groupNum = seriesNum / 4;
                            const label = grouping.groupLabels[groupNum - 1] || `Grupp ${groupNum}`;
                            labelHtml = ` <small class="text-muted">(${label})</small>`;
                        }

                        td.innerHTML = `
                            <span class="summary-total">${sumTotal}</span>
                            ${sumX > 0 ? `<span class="summary-x">(${sumX}x)</span>` : ''}${labelHtml}
                        `;
                        summaryRow.appendChild(td);
                    });

                    tbody.appendChild(summaryRow);
                }
            }

            // Add total row (using equalized scores for fair comparison)
            const totalRow = document.createElement('tr');
            totalRow.className = 'total-row';

            match.participants.forEach(participant => {
                const td = document.createElement('td');
                td.className = 'total-cell';

                // Use equalized scores (first N series based on match series limit)
                const equalizedScores = getEqualizedScores(participant);
                const rawTotal = equalizedScores.reduce((sum, s) => sum + Math.min(s.total, 50), 0);
                const totalX = equalizedScores.reduce((sum, s) => sum + (s.xCount || 0), 0);
                const effectiveSeriesCount = equalizedScores.length;
                const actualSeriesCount = participant.scores?.length || 0;

                // Show equalized series count, and actual if different
                const seriesDisplay = effectiveSeriesCount !== actualSeriesCount
                    ? `${effectiveSeriesCount} av ${actualSeriesCount} serier`
                    : `${effectiveSeriesCount} serier`;

                // Check if handicap is enabled
                if (match.hasHandicap && participant.handicapPerSeries !== null && participant.handicapPerSeries !== undefined) {
                    // Recalculate from equalized scores to match the effective series limit
                    const hcpPerSeries = roundToQuarter(participant.handicapPerSeries);
                    const result = calculateAdjustedTotalWithCap(equalizedScores, hcpPerSeries);
                    const finalScore = result.total;
                    const hcpTotalDisplay = formatHandicap(result.effectiveHandicap);

                    td.innerHTML = `
                        <div class="total-score handicap-final">${finalScore}</div>
                        <div class="total-handicap-breakdown">
                            <span class="raw-score">${rawTotal}</span>
                            <span class="hcp-addition">${hcpTotalDisplay}</span>
                        </div>
                        <div class="total-details">${seriesDisplay}${totalX > 0 ? ` | ${totalX}x` : ''}</div>
                    `;
                } else {
                    td.innerHTML = `
                        <div class="total-score">${rawTotal}</div>
                        <div class="total-details">${seriesDisplay}${totalX > 0 ? ` | ${totalX}x` : ''}</div>
                    `;
                }
                totalRow.appendChild(td);
            });

            tbody.appendChild(totalRow);
        }

        // Helper for rendering avatars in history modal
        function renderAvatarForHistory(participant) {
            if (participant.profilePictureUrl) {
                return `<img src="${participant.profilePictureUrl}" alt="${participant.firstName}"
                             class="participant-avatar">`;
            }

            const initials = ((participant.firstName?.[0] || '') + (participant.lastName?.[0] || '')).toUpperCase();
            return `<div class="participant-avatar participant-avatar-initials">${initials}</div>`;
        }

        // Open photo viewer for history modal (read-only, shows photo/score and reactions)
        function openHistoryPhotoViewer(participant, score, match) {
            const shooterName = participant.firstName || 'Skytt';
            const hasPhoto = score.targetPhotoUrl && score.targetPhotoUrl.length > 0;

            // Build shots display if available
            let shotsHtml = '';
            if (score.shots && score.shots.length > 0) {
                shotsHtml = `<div class="history-shots mt-2">
                    <small class="text-muted">Skott:</small>
                    <span class="ms-2">${score.shots.join(' - ')}</span>
                </div>`;
            }

            // Build reactions list
            let reactionsHtml = '';
            if (score.reactions && score.reactions.length > 0) {
                // Group reactions by emoji
                const grouped = {};
                score.reactions.forEach(r => {
                    if (!grouped[r.emoji]) grouped[r.emoji] = [];
                    grouped[r.emoji].push(r.firstName || 'Okänd');
                });

                reactionsHtml = `<div class="history-reactions mt-3">
                    <small class="text-muted d-block mb-2">Reaktioner:</small>
                    ${Object.entries(grouped).map(([emoji, names]) => `
                        <div class="d-flex align-items-center gap-2 py-1">
                            <span class="fs-5">${emoji}</span>
                            <span class="text-muted small flex-grow-1">${names.join(', ')}</span>
                            <span class="badge bg-secondary">${names.length}</span>
                        </div>
                    `).join('')}
                </div>`;
            }

            // Build modal content
            const modalContent = `
                <div class="modal fade" id="historyPhotoModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered ${hasPhoto ? 'modal-lg' : ''}">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">
                                    ${shooterName} - Serie ${score.seriesNumber}
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                ${hasPhoto ? `
                                    <div class="text-center mb-3">
                                        <img src="${score.targetPhotoUrl}" class="img-fluid rounded"
                                             style="max-height: 400px;" alt="Tavla">
                                    </div>
                                ` : ''}
                                <div class="text-center">
                                    <div class="fs-2 fw-bold">${score.total}</div>
                                    ${score.xCount > 0 ? `<div class="text-muted">${score.xCount}x</div>` : ''}
                                    ${shotsHtml}
                                </div>
                                ${reactionsHtml}
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Remove existing modal if any
            const existingModal = document.getElementById('historyPhotoModal');
            if (existingModal) existingModal.remove();

            // Add modal to DOM and show
            document.body.insertAdjacentHTML('beforeend', modalContent);
            const modal = new bootstrap.Modal(document.getElementById('historyPhotoModal'));
            modal.show();

            // Clean up modal on hide
            document.getElementById('historyPhotoModal').addEventListener('hidden.bs.modal', function() {
                this.remove();
            });
        }

        // ===== SignalR Integration =====

        function initializeSignalR() {
            hubConnection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/trainingmatch")
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .build();

            // Event handlers
            hubConnection.on("JoinRequestReceived", (request) => {
                showJoinRequestNotification(request);
            });

            hubConnection.on("JoinRequestAccepted", async (matchCode) => {
                showToast('Din förfrågan har accepterats!', 'success');
                // Unregister as spectator first (wait for it to complete)
                await unregisterAsSpectator(matchCode);
                // Load the match (will switch to scoreboard view)
                loadMatch(matchCode);
            });

            hubConnection.on("JoinRequestBlocked", (matchCode) => {
                showToast('Din förfrågan har avvisats.', 'danger');
            });

            hubConnection.on("ParticipantJoined", (participant) => {
                if (currentMatchCode) {
                    refreshMatch();
                }
            });

            hubConnection.on("ParticipantLeft", (memberId) => {
                if (currentMatchCode) {
                    refreshMatch();
                }
            });

            hubConnection.on("ScoreUpdated", (data) => {
                if (currentMatchCode) {
                    // Reset inactivity clock — someone entered a score
                    lastActivityDate = new Date().toISOString();
                    const inactBanner = document.getElementById('inactivityBanner');
                    if (inactBanner) inactBanner.style.display = 'none';
                    refreshMatch();
                }
            });

            hubConnection.on("MatchCompleted", (matchCode) => {
                if (currentMatchCode === matchCode) {
                    stopInactivityTimer();
                    showToast('Matchen har avslutats', 'info');
                    refreshMatch();
                }
            });

            hubConnection.on("MatchDeleted", (matchCode) => {
                if (currentMatchCode === matchCode) {
                    showToast('Matchen har raderats', 'warning');
                    // Redirect back to match list after short delay
                    setTimeout(() => {
                        window.location.href = '/traningsmatchen';
                    }, 2000);
                }
            });

            hubConnection.on("MatchStarted", (matchCode) => {
                if (currentMatchCode === matchCode) {
                    // Update global state
                    if (window.currentMatchState) {
                        window.currentMatchState.hasStarted = true;
                    }
                    // Hide scheduled match banners
                    const bannerCreator = document.getElementById('scheduledMatchBannerCreator');
                    const bannerParticipant = document.getElementById('scheduledMatchBannerParticipant');
                    if (bannerCreator) bannerCreator.style.display = 'none';
                    if (bannerParticipant) bannerParticipant.style.display = 'none';
                    // Show toast notification
                    showToast('Matchen har startat! Du kan nu registrera resultat.', 'success');
                }
            });

            hubConnection.on("MatchRefresh", (matchCode) => {
                if (currentMatchCode === matchCode) {
                    refreshMatch();
                }
            });

            hubConnection.on("SpectatorListUpdated", (spectators) => {
                if (typeof updateSpectatorsDisplay === 'function') {
                    // Pass match status to hide spectators for completed matches
                    updateSpectatorsDisplay(spectators, currentMatch?.status);
                }
            });

            hubConnection.on("ReactionUpdated", (data) => {
                console.log("ReactionUpdated:", data);
                if (typeof updateReactionDisplay === 'function') {
                    updateReactionDisplay(data.targetMemberId, data.seriesNumber, data.reactions);
                }
            });

            hubConnection.on("SettingsUpdated", (data) => {
                console.log("SettingsUpdated:", data);
                // Reload match data to get updated settings and recalculated totals
                if (currentMatch && typeof loadMatchData === 'function') {
                    loadMatchData(currentMatch.matchCode, isSpectator);
                }
            });

            // Connection state handlers for mobile disconnect recovery
            hubConnection.onreconnecting((error) => {
                console.log("SignalR reconnecting...", error);
                showConnectionBanner("Återansluter...", "warning");
            });

            hubConnection.onreconnected((connectionId) => {
                console.log("SignalR reconnected:", connectionId);
                hideConnectionBanner();
                reconnectToMatchGroups();
            });

            hubConnection.onclose((error) => {
                console.log("SignalR connection closed:", error);
                showConnectionBanner("Anslutningen bröts. Tryck för att återansluta.", "danger", true);
            });

            // Start connection
            hubConnection.start()
                .then(() => {
                    console.log("SignalR connected");
                })
                .catch(err => {
                    console.error("SignalR connection error:", err);
                });
        }

        // Join match SignalR group when viewing a match
        function joinMatchSignalRGroup(matchCode) {
            if (hubConnection && hubConnection.state === signalR.HubConnectionState.Connected) {
                hubConnection.invoke("JoinMatchGroup", matchCode);
                console.log("Joined match group for", matchCode);
            } else {
                // Retry when connected
                console.log("SignalR not connected, will retry joining match group...");
                setTimeout(() => joinMatchSignalRGroup(matchCode), 1000);
            }
        }

        // Join organizer group when creating/owning a match
        function joinOrganizerSignalRGroup(matchCode) {
            if (hubConnection && hubConnection.state === signalR.HubConnectionState.Connected) {
                hubConnection.invoke("JoinOrganizerGroup", matchCode);
                console.log("Joined organizer group for", matchCode);
            } else {
                // Retry when connected
                console.log("SignalR not connected, will retry joining organizer group...");
                setTimeout(() => joinOrganizerSignalRGroup(matchCode), 1000);
            }
        }

        // Leave match SignalR group
        function leaveMatchSignalRGroup(matchCode) {
            if (hubConnection && hubConnection.state === signalR.HubConnectionState.Connected) {
                hubConnection.invoke("LeaveMatchGroup", matchCode);
            }
        }

        // Handle page visibility changes (mobile screen on/off)
        document.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'visible') {
                console.log("Page became visible, checking SignalR connection...");
                if (hubConnection && hubConnection.state !== signalR.HubConnectionState.Connected) {
                    console.log("SignalR not connected, attempting reconnect...");
                    showConnectionBanner("Återansluter...", "warning");
                    hubConnection.start()
                        .then(() => {
                            console.log("SignalR reconnected after visibility change");
                            hideConnectionBanner();
                            reconnectToMatchGroups();
                        })
                        .catch(err => {
                            console.error("Failed to reconnect:", err);
                            showConnectionBanner("Kunde inte återansluta. Tryck för att försöka igen.", "danger", true);
                        });
                }
            }
        });

