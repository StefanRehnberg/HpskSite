@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Planering";
    var competitionId = ViewData["CompetitionId"];
    var compName = ViewData["CompetitionName"]?.ToString() ?? "";
    var discipline = ViewData["Discipline"]?.ToString() ?? "Precision";
    var manageUrl = ViewData["ManageUrl"]?.ToString() ?? "/";
    var canAccess = ViewData["CanAccess"] as bool? ?? false;
    var compExists = ViewData["CompetitionExists"] as bool? ?? false;

    var childVd = new ViewDataDictionary(ViewData);
    childVd["CompetitionId"] = competitionId;
    childVd["Discipline"] = discipline;
}

@* Flatpickr for the date/time pickers used by the _WorkBreakdown + _StaffingRoster partials
   (uppgift-deadline, funktionärspass, samt hjälppassens datum/tid). *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

@* container-fluid, som /competitionmanagement. Rutnätet vill ha varenda pixel: varje sparad bildpunkt
   är en dagkolumn till som ryms utan att man behöver scrolla i sidled. *@
<div class="container-fluid mt-4 mb-5">
    @* One line by default, expandable, and dismissible for the session. The full-height version ate 40%
       of the first screen and opened with "en massa testdata" — which reads as "don't trust this with my
       SM" to the exact person we most want using it. The offer to help is still here, just not shouted. *@
    <div class="alert alert-warning border-warning py-2 mb-3" role="alert" id="planBeta" style="display:none">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <i class="bi bi-cone-striped flex-shrink-0"></i>
            <span class="small flex-grow-1">
                <strong>Beta.</strong> Tävlingsplaneringen byggs fortfarande — hör gärna av dig om något
                saknas eller krånglar.
                <a href="#" class="ms-1" data-bs-toggle="collapse" data-bs-target="#planBetaMore">Mer</a>
            </span>
            <button type="button" class="btn-close btn-sm" aria-label="Dölj" onclick="planBetaDismiss()"></button>
        </div>
        <div class="collapse mt-2 small" id="planBetaMore">
            Har du erfarenhet av <strong>större tävlingar</strong> (krets- eller SM-nivå)? Testa att planera
            en tänkt tävling — bygg förberedelselistan, lägg upp bemanningen och kör igenom upprop och
            materiel — och berätta vad som <em>saknas</em>, vad som är <em>krångligt</em> och vad som blir
            <em>fel</em>. Använd knappen <strong>Rapportera fel</strong> nere till höger. Din återkoppling
            avgör vad vi bygger härnäst. 🙏
        </div>
    </div>
    <script>
        // Dismissed for this browser, not forever-for-everyone: a returning organiser shouldn't have to
        // read a construction sign every time they open their plan.
        (function () {
            var el = document.getElementById('planBeta');
            if (!el) return;
            try { if (localStorage.getItem('hpsk_plan_beta_hidden') !== '1') el.style.display = ''; }
            catch (e) { el.style.display = ''; }
        })();
        function planBetaDismiss() {
            var el = document.getElementById('planBeta');
            if (el) el.style.display = 'none';
            try { localStorage.setItem('hpsk_plan_beta_hidden', '1'); } catch (e) { }
        }
    </script>

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
        <div>
            <h1><i class="bi bi-clipboard-check me-2"></i>Planering</h1>
            @if (compExists)
            {
                <p class="text-muted mb-0">Förbereder: <strong>@compName</strong></p>
            }
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (compExists && canAccess)
            {
                @* Hela planen. Varje flik har dessutom sin egen utskrift — de är olika dokument. *@
                <a href="/tavlingsplanering/blad?c=@competitionId&amp;vy=allt" target="_blank" rel="noopener" class="btn btn-outline-primary" title="Skriv ut hela planen">
                    <i class="bi bi-printer"></i> Skriv ut allt
                </a>
            }
            <a href="@manageUrl" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Tillbaka till tävlingshantering
            </a>
        </div>
    </div>

    @if (!compExists)
    {
        <div class="alert alert-warning">Tävlingen hittades inte.</div>
    }
    else if (!canAccess)
    {
        <div class="alert alert-warning">Du har inte behörighet att planera den här tävlingen.</div>
    }
    else
    {
        @* One line, not a paragraph. Three tab names that say what they are beat five sentences
           explaining them — if the screen needs an essay, the screen is wrong. Where to work on the DAY
           is the one thing the tabs genuinely can't say, so that link stays. *@
        <p class="text-muted small mb-3">
            Arbetet <em>före</em> tävlingen. Själva tävlingsdagen sköter du från
            <a href="@manageUrl">Funktionärer-fliken</a>.
        </p>

        <ul class="nav nav-tabs mb-3" id="planeringPills" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="plan-forberedelser-tab" data-bs-toggle="tab" data-bs-target="#plan-forberedelser" type="button" role="tab">
                    <i class="bi bi-list-check me-1"></i>Förberedelser
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="plan-bemanning-tab" data-bs-toggle="tab" data-bs-target="#plan-bemanning" type="button" role="tab">
                    <i class="bi bi-person-badge me-1"></i>Bemanning
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="plan-dagsprogram-tab" data-bs-toggle="tab" data-bs-target="#plan-dagsprogram" type="button" role="tab">
                    <i class="bi bi-calendar2-event me-1"></i>Dagsprogram
                </button>
            </li>
        </ul>

        <div class="tab-content" id="planeringPillContent">
            <div class="tab-pane fade show active" id="plan-forberedelser" role="tabpanel">
                @await Html.PartialAsync("_WorkBreakdown", childVd)
            </div>
            <div class="tab-pane fade" id="plan-bemanning" role="tabpanel">
                @await Html.PartialAsync("_StaffingRoster", childVd)
            </div>
            <div class="tab-pane fade" id="plan-dagsprogram" role="tabpanel">
                @await Html.PartialAsync("_CompetitionAgenda", childVd)
            </div>
        </div>

        @* Remember which tab you were on. Planering is three tab levels deep (page → pill → sub-tab), and
           re-navigating all three on every visit is the friction an organiser feels most — they come back
           to the same job they left. Per competition, so a different comp starts fresh. *@
        <script>
            (function () {
                var KEY = 'hpsk_plan_tab_@competitionId';
                document.querySelectorAll('#planeringPills button[data-bs-toggle="tab"]').forEach(function (b) {
                    b.addEventListener('shown.bs.tab', function () {
                        try { localStorage.setItem(KEY, b.id); } catch (e) { }
                    });
                });
                try {
                    var last = localStorage.getItem(KEY);
                    if (last && last !== 'plan-forberedelser-tab') {
                        var btn = document.getElementById(last);
                        if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
                    }
                } catch (e) { }
            })();
        </script>
    }
</div>
