@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@using Umbraco.Cms.Core.Security;
@using Umbraco.Cms.Core.Services;
@using System.Globalization;
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject HpskSite.Services.AdminAuthorizationService AuthorizationService
@inject HpskSite.Services.SitePages.SitePageViewFactory SitePages
@inject HpskSite.Services.ClubRosterService ClubRoster
@inject HpskSite.Services.BoardRoleService BoardRoles
@inject HpskSite.Services.SitePages.SiteViewerResolver SiteViewers
@inject HpskSite.Services.SitePages.SiteOwnerService SiteOwners
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";

    // Get club properties directly from this Club node
    var clubId = Model?.Id ?? 0;
    // Try to read custom clubName property first, fall back to page name
    var clubName = Model?.Value<string>("clubName") ?? Model?.Name ?? "Club";

    ViewBag.Title = clubName;

    // Get club properties from this node
    var description = HpskSite.Extensions.RteHelper.SafeMarkup(Model?.Value<string>("description")); // Short description (for SEO, meta tags, etc.)
    var aboutClub = HpskSite.Extensions.RteHelper.SafeMarkup(Model?.Value<string>("aboutClub")); // Rich text content for welcome section
    var logo = Model?.Value<IPublishedContent>("logo");
    var bannerImage = Model?.Value<IPublishedContent>("bannerImage");
    var contactPerson = Model?.Value<string>("contactPerson") ?? "";
    var contactEmail = Model?.Value<string>("contactEmail") ?? "";
    var contactPhone = Model?.Value<string>("contactPhone") ?? "";

    // Welcome message: use rich text aboutClub content, fallback to description if empty
    var welcomeMessage = !string.IsNullOrEmpty(aboutClub) ? aboutClub : description;

    // Get current member to check permissions
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;
    var isClubAdmin = false;
    var isClubMember = false;
    var isClubBoard = false;

    // Check if current member is club admin or member for this specific club
    if (currentMember != null && clubId > 0)
    {
        // Use AdminAuthorizationService for club admin check
        // This correctly checks: Site Admin, ClubAdmin_{clubId}, AND RegionalAdmin_{regionCode}
        isClubAdmin = await AuthorizationService.IsClubAdminForClub(clubId);

        // Get the member from MemberService for club membership check
        var member = MemberService.GetByEmail(currentMember.Email);

        if (member != null)
        {
            // Aktiv medlem = en aktiv rad i ClubMembership (status annan än Utträdd/Avliden), aldrig de råa
            // egenskaperna, som räknade en utträdd som medlem (Stefans beslut 2026-11-07).
            isClubMember = ClubRoster.ActiveMemberIds(clubId).Contains(member.Id);
            // Styrelse = en aktiv styrelseroll (BoardRoles.IsBoardMember), den enda källan för styrelsen (klubbsidorna F1).
            isClubBoard = BoardRoles.IsBoardMemberOf(HpskSite.Models.DocumentOwnerType.Club, clubId, member.Id);
        }
    }

    // Find login page dynamically (same approach as Master.cshtml)
    var loginPage = Model.SiteRoot().Children.FirstOrDefault(x => x.Name == "Login & Register")
                    ?? Model.SiteRoot().Children.FirstOrDefault(x => x.Name.ToLower().Contains("login"));
    var loginUrl = loginPage != null ? loginPage.Url() : "/login-register";
}

@{
    ViewBag.clubId = clubId;
    ViewBag.clubName = clubName;
    ViewBag.description = description;
    ViewBag.logo = logo;
    ViewBag.bannerImage = bannerImage;
    ViewBag.isClubMember = isClubMember;
    ViewBag.isClubAdmin = isClubAdmin;

    // Klubbsidorna steg 1: den nya sidstrukturen (av = dagens vy, oförändrad). Se SitePageView.
    var sp = SitePages.For(HpskSite.Services.SitePages.SiteTemplates.Club, clubId, Model.Url(),
        new HpskSite.Services.SitePages.SiteViewer(isLoggedIn, isClubMember, isClubBoard, isClubAdmin));
    ViewBag.sitePageView = sp;
    // Panelregistret (K0b): EN ritväg för systemsidornas paneler.
    var panelCtx = new HpskSite.Services.SitePages.SitePanelContext(HpskSite.Services.SitePages.SiteTemplates.Club, clubId, clubName, Model, sp.Viewer);
    // Klubbens egen text före/efter systemsidorna (slots): bara när egen redigering är PÅ (annars ritas ingenting).
    ViewBag.slotCtx = sp.Enabled && SiteOwners.IsEditingEnabled(HpskSite.Services.SitePages.SiteTemplates.Club, clubId)
        ? new HpskSite.Services.SitePages.SiteSlotContext(HpskSite.Services.SitePages.SiteTemplates.Club, clubId, sp.Viewer, Model.Url(), Model)
        : null;
    // Hemsidan (egna sidor): länken syns bara för klubbens EGEN admin och bara när brytare 2 är PÅ.
    ViewBag.canEditSite = sp.Enabled && SiteOwners.IsEditingEnabled(HpskSite.Services.SitePages.SiteTemplates.Club, clubId)
        && await SiteViewers.IsOwnAdminAsync(HpskSite.Services.SitePages.SiteTemplates.Club, clubId, null);

    // OpenGraph meta tags - use logo for social sharing preview
    // Fallback chain: club logo → region logo → site default
    var regionPage = Model?.Parent?.Parent; // club → clubsPage → regionalPage
    if (regionPage?.ContentType.Alias != "regionalPage")
    {
        regionPage = null;
    }
    var regionLogo = regionPage?.Value<IPublishedContent>("logo");
    // Besökarens vy: en extern länk längst ned i vänstermenyn till kretsens hemsida.
    ViewBag.regionUrl = regionPage?.Url();
    ViewBag.regionLabel = "Kretsens hemsida";
    var siteDefaultLogo = "/images/HPSK_Logo.png";

    ViewBag.OgTitle = clubName;
    ViewBag.OgDescription = !string.IsNullOrEmpty(description) ? description : $"Välkommen till {clubName}";
    ViewBag.OgImage = logo?.Url() ?? regionLogo?.Url() ?? siteDefaultLogo;
}

<!-- JavaScript global variables - MUST come before partials that use them -->
@await Html.PartialAsync("_EventBadges")
<script>
// Declare clubId and isLoggedIn in global scope so partials can access them
const clubId = @clubId;
const isLoggedIn = @isLoggedIn.ToString().ToLower();
// Make clubId available to wizard modal
window.currentClubId = clubId;
</script>

@{ var lockedNeeds = HpskSite.Services.SitePages.SitePageRequest.LockedNeedsMembership(Context); }
<div class="club-page container-fluid">
    <!-- Club Header with Logo and Banner -->
    @await Html.PartialAsync("ClubHeader")

    @if (!isLoggedIn)
    {
        <!-- TIER 1: PUBLIC VIEW (Om-text, kontakt, publika dokument, inloggningsruta) — ritas av panelregistret -->
        <div class="container-fluid mt-4@(sp.Enabled ? " hpsk-sidelayout" : "")">
            @if (sp.Enabled)
            {
                @await Html.PartialAsync("ClubNavigation")
                @Html.Raw("<div class=\"hpsk-sidebody\">")
            }
            @if (lockedNeeds != null)
            {
                @await Html.PartialAsync("_SiteLocked", ("Club", clubName, lockedNeeds.Value, false, loginUrl.TrimEnd('/') + "/?tab=login&returnUrl=" + Uri.EscapeDataString(Context.Request.Path.Value!.TrimEnd('/') + "/")))
            }
            else if (sp.Enabled && !sp.IsRoot)
            {
                @* "Visa publikt": en omgjord systemsida som klubben publicerat för alla (Banor, Kalender, Tävlingar, Rekord). Samma flikpanel som för en inloggad, så panelernas skript fungerar likadant. *@
                <div class="tab-content mt-3" id="clubTabContent">
                    <div class="tab-pane fade show active" id="@HpskSite.Services.SitePages.SiteTemplates.LegacyPaneId(HpskSite.Services.SitePages.SiteTemplates.Club, sp.PageKey)" role="tabpanel">
                        @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = sp.PageKey })
                    </div>
                </div>
            }
            else
            {
                @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "home" })
            }
            @if (sp.Enabled)
            {
                @Html.Raw("</div>")
            }
        </div>
    }
    else
    {
        <!-- TIER 2 & 3: MEMBER/ADMIN VIEW - With tabs and role-based functionality -->
        <div class="container-fluid mt-4@(sp.Enabled ? " hpsk-sidelayout" : "")">
            @await Html.PartialAsync("ClubNavigation")
            @if (sp.Enabled)
            {
                @Html.Raw("<div class=\"hpsk-sidebody\">")
            }
            @if (lockedNeeds != null)
            {
                @await Html.PartialAsync("_SiteLocked", ("Club", clubName, lockedNeeds.Value, true, loginUrl))
            }

            <!-- Tab Content -->
            <div class="tab-content mt-3" id="clubTabContent">

                @* Klubbsidorna: med den nya sidstrukturen PÅ skrivs bara den här sidans panel ut (sp.ShowsPane); av = alla, som förut. *@
                <!-- TIER 2: About Tab (All logged-in users) -->
                @if (sp.ShowsPane("clubHome"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubHome")" id="clubHome" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("home", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "home" })
                    @await Html.PartialAsync("_SitePageSlots", ("home", "after"))
                </div>
                }

                <!-- TIER 2: About Tab (All logged-in users) -->
                @if (sp.ShowsPane("clubAbout"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubAbout")" id="clubAbout" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("about", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "about" })
                    @await Html.PartialAsync("_SitePageSlots", ("about", "after"))
                </div>
                }

                <!-- TIER 2: Banor Tab (All logged-in users) -->
                @if (sp.ShowsPane("clubRanges"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubRanges")" id="clubRanges" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("ranges", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "ranges" })
                    @await Html.PartialAsync("_SitePageSlots", ("ranges", "after"))
                </div>
                }

                <!-- TIER 2: Calendar Tab (All logged-in users) -->
                @if (sp.ShowsPane("clubCalendar"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubCalendar")" id="clubCalendar" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("calendar", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "calendar" })
                    @await Html.PartialAsync("_SitePageSlots", ("calendar", "after"))
                </div>
                }

                <!-- TIER 2: Competitions Tab (All logged-in users) -->
                @if (sp.ShowsPane("clubCompetitions"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubCompetitions")" id="clubCompetitions" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("competitions", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "competitions" })
                    @await Html.PartialAsync("_SitePageSlots", ("competitions", "after"))
                </div>
                }

                <!-- TIER 2: Members Directory (All logged-in users) -->
                @if (sp.ShowsPane("clubMembers"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubMembers")" id="clubMembers" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("members", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "members" })
                    @await Html.PartialAsync("_SitePageSlots", ("members", "after"))
                </div>
                }

                <!-- TIER 2: Records (All logged-in users) -->
                @if (sp.ShowsPane("clubRecords"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubRecords")" id="clubRecords" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("records", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "records" })
                    @await Html.PartialAsync("_SitePageSlots", ("records", "after"))
                </div>
                }

                <!-- TIER 2: Documents Tab (All logged-in users) -->
                @if (sp.ShowsPane("clubDocuments"))
                {
                <div class="tab-pane fade @sp.PaneClass("clubDocuments")" id="clubDocuments" role="tabpanel">
                    @await Html.PartialAsync("_SitePageSlots", ("documents", "before"))
                    @await Html.PartialAsync("_SitePanels", panelCtx with { PageKey = "documents" })
                    @await Html.PartialAsync("_SitePageSlots", ("documents", "after"))
                </div>
                }

                @if (isClubAdmin && sp.ShowsPane("clubAdmin"))
                {
                    <!-- TIER 3: Admin Tab (Club admins only) -->
                    <div class="tab-pane fade @sp.PaneClass("clubAdmin")" id="clubAdmin" role="tabpanel">
                        @await Html.PartialAsync("ClubAdminPanel")
                    </div>
                }
            </div>
            @if (sp.Enabled)
            {
                @Html.Raw("</div>")
            }
        </div>
    }
</div>

