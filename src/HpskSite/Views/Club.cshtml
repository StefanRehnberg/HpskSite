.club-page {
    padding-bottom: 2rem;
}

.list-group-item:hover {
    background-color: var(--bs-secondary-bg);
}

.event-snippet {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
</style>
