@using Umbraco.Cms.Web.Common.PublishedModels;
@using Umbraco.Extensions;
@using Umbraco.Cms.Core.Security;
@using Umbraco.Cms.Core.Services;
@using System.Globalization;
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject HpskSite.Services.AdminAuthorizationService AuthorizationService
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";

    // Get club properties directly from this Club node
    var clubId = Model?.Id ?? 0;
    // Try to read custom clubName property first, fall back to page name
    var clubName = Model?.Value<string>("clubName") ?? Model?.Name ?? "Club";

    ViewBag.Title = clubName;

    // Get club properties from this node
    var description = HpskSite.Extensions.RteHelper.ExtractMarkup(Model?.Value<string>("description")); // Short description (for SEO, meta tags, etc.)
    var aboutClub = HpskSite.Extensions.RteHelper.ExtractMarkup(Model?.Value<string>("aboutClub")); // Rich text content for welcome section
    var logo = Model?.Value<IPublishedContent>("logo");
    var bannerImage = Model?.Value<IPublishedContent>("bannerImage");
    var contactPerson = Model?.Value<string>("contactPerson") ?? "";
    var contactEmail = Model?.Value<string>("contactEmail") ?? "";
    var contactPhone = Model?.Value<string>("contactPhone") ?? "";

    // Welcome message: use rich text aboutClub content, fallback to description if empty
    var welcomeMessage = !string.IsNullOrEmpty(aboutClub) ? aboutClub : description;

    // Get featured items - handle both single item and collection (competitions and series)
    var featuredItemsRaw = Model?.Value("featuredItems");
    var featuredItems = new List<IPublishedContent>();

    if (featuredItemsRaw is IEnumerable<IPublishedContent> multipleItems)
    {
        featuredItems = multipleItems
            .Where(c => c.ContentType.Alias == "competition" || c.ContentType.Alias == "competitionSeries")
            .ToList();
    }
    else if (featuredItemsRaw is IPublishedContent singleItem)
    {
        if (singleItem.ContentType.Alias == "competition" || singleItem.ContentType.Alias == "competitionSeries")
        {
            featuredItems.Add(singleItem);
        }
    }

    // Get current member to check permissions
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;
    var isClubAdmin = false;
    var isClubMember = false;

    // Check if current member is club admin or member for this specific club
    if (currentMember != null && clubId > 0)
    {
        // Use AdminAuthorizationService for club admin check
        // This correctly checks: Site Admin, ClubAdmin_{clubId}, AND RegionalAdmin_{regionCode}
        isClubAdmin = await AuthorizationService.IsClubAdminForClub(clubId);

        // Get the member from MemberService for club membership check
        var member = MemberService.GetByEmail(currentMember.Email);

        if (member != null)
        {
            // Check if member belongs to this club (primary or additional)
            var primaryClubId = member.GetValue("primaryClubId")?.ToString();
            var memberClubIds = member.GetValue("memberClubIds")?.ToString() ?? "";
            isClubMember = primaryClubId == clubId.ToString() ||
                          memberClubIds.Split(',').Select(s => s.Trim()).Contains(clubId.ToString());
        }
    }

    // Find login page dynamically (same approach as Master.cshtml)
    var loginPage = Model.Root().Children.FirstOrDefault(x => x.Name == "Login & Register")
                    ?? Model.Root().Children.FirstOrDefault(x => x.Name.ToLower().Contains("login"));
    var loginUrl = loginPage != null ? loginPage.Url() : "/login-register";
}

@{
    ViewBag.clubId = clubId;
    ViewBag.clubName = clubName;
    ViewBag.description = description;
    ViewBag.logo = logo;
    ViewBag.bannerImage = bannerImage;
    ViewBag.isClubMember = isClubMember;
    ViewBag.isClubAdmin = isClubAdmin;

    // OpenGraph meta tags - use logo for social sharing preview
    // Fallback chain: club logo → region logo → site default
    var regionPage = Model?.Parent?.Parent; // club → clubsPage → regionalPage
    if (regionPage?.ContentType.Alias != "regionalPage")
    {
        regionPage = null;
    }
    var regionLogo = regionPage?.Value<IPublishedContent>("logo");
    var siteDefaultLogo = "/images/HPSK_Logo.png";

    ViewBag.OgTitle = clubName;
    ViewBag.OgDescription = !string.IsNullOrEmpty(description) ? description : $"Välkommen till {clubName}";
    ViewBag.OgImage = logo?.Url() ?? regionLogo?.Url() ?? siteDefaultLogo;
}

<!-- JavaScript global variables - MUST come before partials that use them -->
<script>
// Declare clubId and isLoggedIn in global scope so partials can access them
const clubId = @clubId;
const isLoggedIn = @isLoggedIn.ToString().ToLower();
// Make clubId available to wizard modal
window.currentClubId = clubId;
</script>

<div class="club-page container-fluid">
    <!-- Club Header with Logo and Banner -->
    @await Html.PartialAsync("ClubHeader")

    @if (!isLoggedIn)
    {
        <!-- TIER 1: PUBLIC VIEW - About section only -->
        <div class="container-fluid mt-4">
            <div class="row">
                <div class="col-lg-8">
                    <!-- About Club -->
                    @if (!string.IsNullOrEmpty(welcomeMessage))
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="bi bi-info-circle me-2"></i>Om Klubben
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="prose">
                                    @Html.Raw(welcomeMessage)
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="col-lg-4">
                    <!-- Contact Information -->
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <i class="bi bi-telephone me-2"></i>Kontaktinformation
                            </h5>
                        </div>
                        <div class="card-body">
                            @if (!string.IsNullOrEmpty(contactPerson))
                            {
                                <p class="mb-2">
                                    <strong>Kontaktperson:</strong><br />
                                    @contactPerson
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(contactEmail))
                            {
                                <p class="mb-2">
                                    <strong>E-post:</strong><br />
                                    <a href="mailto:@contactEmail">@contactEmail</a>
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(contactPhone))
                            {
                                <p class="mb-0">
                                    <strong>Telefon:</strong><br />
                                    @contactPhone
                                </p>
                            }
                        </div>
                    </div>

                    <!-- Public Quick Link Documents -->
                    <div id="publicQuickLinkDocumentsCard" class="card mb-4" style="display: none;">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Dokument</h5>
                        </div>
                        <div class="list-group list-group-flush" id="publicQuickLinkDocuments"></div>
                    </div>

                    <!-- Login Prompt -->
                    <div class="card">
                        <div class="card-body text-center">
                            <i class="bi bi-lock fs-1 text-muted mb-3 d-block"></i>
                            <h6 class="mb-2">Medlemsinloggning</h6>
                            <p class="text-muted small mb-3">Logga in för att se händelser, nyheter, kalender och mer</p>
                            <a href="@loginUrl" class="btn btn-primary btn-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Logga in
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- TIER 2 & 3: MEMBER/ADMIN VIEW - With tabs and role-based functionality -->
        <div class="container-fluid mt-4">
            @await Html.PartialAsync("ClubNavigation")

            <!-- Tab Content -->
            <div class="tab-content mt-3" id="clubTabContent">

                <!-- TIER 2: About Tab (All logged-in users) -->
                <div class="tab-pane fade show active" id="clubHome" role="tabpanel">
                    <div class="row">
                        <!-- Main Content Column -->
                        <div class="col-lg-8">
                            <!-- Upcoming Events -->
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="bi bi-calendar-event me-2"></i>Kommande Händelser
                                    </h5>
                                </div>
                                <div class="card-body" id="upcomingEventsContainer">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Laddar händelser...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar Column -->
                        <div class="col-lg-4">
                            <!-- Featured Items (Competitions and Series) -->
                            @if (featuredItems.Any() || isClubAdmin)
                            {
                                var featuredItemIds = featuredItems.Select(f => f.Id).ToList();
                                <div class="card mb-4">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0"><i class="bi bi-star-fill me-2 text-warning"></i>Utvalda Tävlingar</h5>
                                        @if (isClubAdmin)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" onclick="openFeaturedPicker(@clubId, 'club', [@string.Join(",", featuredItemIds)])" title="Redigera">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                    </div>
                                    @if (!featuredItems.Any())
                                    {
                                        <div class="card-body text-center text-muted">
                                            <small>Inga utvalda tävlingar. Klicka pennan för att lägga till.</small>
                                        </div>
                                    }
                                    <div class="list-group list-group-flush">
                                        @foreach (var item in featuredItems)
                                        {
                                            var isSeries = item.ContentType.Alias == "competitionSeries";

                                            if (isSeries)
                                            {
                                                // Series display
                                                var seriesName = item.Value<string>("seriesName") ?? item.Name;
                                                var seriesDescription = item.Value<string>("shortDescription") ?? "";
                                                var competitionCount = item.Children.Count(c => c.ContentType.Alias == "competition");

                                                <a href="@item.Url()" class="list-group-item list-group-item-action">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <strong class="d-block">@seriesName</strong>
                                                            @if (!string.IsNullOrEmpty(seriesDescription))
                                                            {
                                                                <small class="text-muted d-block">@seriesDescription</small>
                                                            }
                                                            <small class="text-muted">
                                                                <i class="bi bi-collection me-1"></i>@competitionCount tävlingar
                                                            </small>
                                                        </div>
                                                        <span class="badge bg-purple" style="background-color: #6f42c1;">Serie</span>
                                                    </div>
                                                </a>
                                            }
                                            else
                                            {
                                                // Competition display
                                                var compName = item.Value<string>("competitionName") ?? item.Name;
                                                var compDate = item.Value<DateTime>("competitionDate");
                                                var compEndDate = item.Value<DateTime?>("competitionEndDate");
                                                var venue = item.Value<string>("venue") ?? "";
                                                var isActiveComp = item.Value<bool>("isActive");
                                                var registrationOpenDate = item.Value<DateTime>("registrationOpenDate");
                                                var registrationCloseDate = item.Value<DateTime>("registrationCloseDate");

                                                // Determine status
                                                var now = DateTime.Now;
                                                var hasValidEnd = compEndDate.HasValue && compEndDate.Value.Year > 1900 && compEndDate.Value.Date >= compDate.Date;
                                                var effectiveEnd = hasValidEnd ? compEndDate!.Value.Date : compDate.Date;
                                                string statusText;
                                                string statusBadgeClass;

                                                if (!isActiveComp)
                                                {
                                                    statusText = "Inaktiv";
                                                    statusBadgeClass = "bg-secondary";
                                                }
                                                else if (now < registrationOpenDate)
                                                {
                                                    statusText = "Anmälan öppnar snart";
                                                    statusBadgeClass = "bg-info";
                                                }
                                                else if (now >= registrationOpenDate && now <= registrationCloseDate)
                                                {
                                                    statusText = "Anmälan öppen";
                                                    statusBadgeClass = "bg-success";
                                                }
                                                else if (now > registrationCloseDate && now.Date < compDate.Date)
                                                {
                                                    statusText = "Anmälan stängd";
                                                    statusBadgeClass = "bg-warning text-dark";
                                                }
                                                else if (now.Date >= compDate.Date && now.Date <= effectiveEnd)
                                                {
                                                    statusText = "Pågår";
                                                    statusBadgeClass = "bg-primary";
                                                }
                                                else if (now.Date > effectiveEnd)
                                                {
                                                    statusText = "Avslutad";
                                                    statusBadgeClass = "bg-secondary";
                                                }
                                                else
                                                {
                                                    statusText = "Kommande";
                                                    statusBadgeClass = "bg-info";
                                                }

                                                // Check if multi-day
                                                var hasValidEndDate = compEndDate.HasValue &&
                                                                      compEndDate.Value > DateTime.MinValue &&
                                                                      compEndDate.Value.Year > 1900 &&
                                                                      compEndDate.Value.Date > compDate.Date;

                                                <a href="@item.Url()" class="list-group-item list-group-item-action">
                                                    <div class="d-flex justify-content-between align-items-start">
                                                        <div>
                                                            <strong class="d-block">@compName</strong>
                                                            <small class="text-muted">
                                                                <i class="bi bi-calendar3 me-1"></i>
                                                                @if (hasValidEndDate)
                                                                {
                                                                    @compDate.ToString("d MMM", CultureInfo.GetCultureInfo("sv-SE"))
                                                                    <text> - </text>
                                                                    @compEndDate!.Value.ToString("d MMM", CultureInfo.GetCultureInfo("sv-SE"))
                                                                }
                                                                else
                                                                {
                                                                    @compDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))
                                                                }
                                                            </small>
                                                            @if (!string.IsNullOrEmpty(venue))
                                                            {
                                                                <small class="text-muted d-block">
                                                                    <i class="bi bi-geo-alt me-1"></i>@venue
                                                                </small>
                                                            }
                                                        </div>
                                                        <span class="badge @statusBadgeClass">@statusText</span>
                                                    </div>
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Contact Information -->
                            @if (!string.IsNullOrEmpty(contactPerson) || !string.IsNullOrEmpty(contactEmail) || !string.IsNullOrEmpty(contactPhone))
                            {
                                <div class="card mb-4">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Kontakt</h5>
                                    </div>
                                    <div class="card-body">
                                        @if (!string.IsNullOrEmpty(contactPerson))
                                        {
                                            <div class="d-flex align-items-center mb-3">
                                                <i class="bi bi-person fs-4 text-primary me-3"></i>
                                                <div>
                                                    <small class="text-muted d-block">Kontaktperson</small>
                                                    <span>@contactPerson</span>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(contactEmail))
                                        {
                                            <div class="d-flex align-items-center mb-3">
                                                <i class="bi bi-envelope fs-4 text-primary me-3"></i>
                                                <div>
                                                    <small class="text-muted d-block">E-post</small>
                                                    <a href="mailto:@contactEmail">@contactEmail</a>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(contactPhone))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-telephone fs-4 text-primary me-3"></i>
                                                <div>
                                                    <small class="text-muted d-block">Telefon</small>
                                                    <a href="tel:@contactPhone">@contactPhone</a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Quick Links -->
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i>Snabblänkar</h5>
                                </div>
                                <div class="list-group list-group-flush">
                                    <a href="#" onclick="document.getElementById('clubCalendar-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-calendar3 me-3 text-primary"></i>
                                        <div>
                                            <strong>Kalender</strong>
                                            <small class="d-block text-muted">Se alla händelser</small>
                                        </div>
                                    </a>
                                    <a href="#" onclick="document.getElementById('clubMembers-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-people me-3 text-primary"></i>
                                        <div>
                                            <strong>Medlemmar</strong>
                                            <small class="d-block text-muted">Medlemskatalog</small>
                                        </div>
                                    </a>
                                    <a href="#" onclick="document.getElementById('clubRecords-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-award me-3 text-primary"></i>
                                        <div>
                                            <strong>Klubbrekord</strong>
                                            <small class="d-block text-muted">Rekord i @clubName</small>
                                        </div>
                                    </a>
                                    <a href="#" onclick="document.getElementById('clubCompetitions-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-trophy me-3 text-primary"></i>
                                        <div>
                                            <strong>Tävlingar</strong>
                                            <small class="d-block text-muted">Tävlingar arrangerade av @clubName</small>
                                        </div>
                                    </a>
                                    <div id="clubQuickLinkDocuments"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TIER 2: About Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubAbout" role="tabpanel">
                    @if (!string.IsNullOrEmpty(welcomeMessage))
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Om klubben</h5>
                            </div>
                            <div class="card-body">
                                <div class="prose">
                                    @Html.Raw(welcomeMessage)
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">Ingen information om klubben har lagts till ännu.</div>
                    }
                </div>

                <!-- TIER 2: Banor Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubRanges" role="tabpanel">
                    <div class="card mb-4" id="clubRangesCard" style="display:none">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Våra skjutbanor</h5>
                        </div>
                        <div class="card-body">
                            <div id="clubRangesList" class="mb-3"></div>
                            <div id="clubRangesMap" style="height:340px;border-radius:.5rem;border:1px solid var(--bs-border-color);display:none"></div>
                        </div>
                    </div>
                    <div id="clubRangesEmpty" class="alert alert-info" style="display:none">
                        <i class="bi bi-info-circle me-1"></i>Inga skjutbanor är kopplade till klubben ännu.
                        En klubbadministratör kan hävda eller koppla en bana i <a href="/skjutbanor">skjutbanedatabasen</a>.
                    </div>
                    <link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" />
                    <script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js"></script>
                    <script>
                    (function () {
                        const crClubId = @clubId;
                        const DAYS = { 1:'Mån', 2:'Tis', 3:'Ons', 4:'Tor', 5:'Fre', 6:'Lör', 7:'Sön' };
                        const esc = s => (s == null ? '' : String(s)).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
                        let crMap = null, crPts = [], crBuilt = false, crMarkers = {};
                        function buildMap() {
                            if (crBuilt || !crPts.length) { if (crMap) setTimeout(() => crMap.invalidateSize(), 60); return; }
                            crBuilt = true;
                            document.getElementById('clubRangesMap').style.display = '';
                            crMap = L.map('clubRangesMap');
                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(crMap);
                            crMarkers = {};
                            crPts.forEach(p => {
                                crMarkers[p.id] = L.circleMarker([p.lat, p.lng], { radius: 9, color: '#fff', weight: 2, fillColor: '#198754', fillOpacity: 1 })
                                    .bindPopup(`<div class="fw-semibold mb-1">${esc(p.name)}</div><a class="btn btn-sm btn-primary" style="color:#fff" href="/skjutbanor?range=${p.id}">Visa</a>`)
                                    .addTo(crMap);
                            });
                            if (crPts.length === 1) {
                                crMap.setView([crPts[0].lat, crPts[0].lng], 14); // most clubs have one range
                            } else {
                                const g = L.featureGroup(crPts.map(p => L.marker([p.lat, p.lng])));
                                crMap.fitBounds(g.getBounds().pad(0.2), { maxZoom: 14 });
                            }
                            setTimeout(() => crMap.invalidateSize(), 80);
                        }
                        async function load() {
                            try {
                                const d = await (await fetch('/umbraco/surface/ShootingRange/GetClubRanges?clubId=' + crClubId)).json();
                                if (!d.success || !d.ranges.length) { document.getElementById('clubRangesEmpty').style.display = ''; return; }
                                document.getElementById('clubRangesCard').style.display = '';
                                crPts = [];
                                document.getElementById('clubRangesList').innerHTML = d.ranges.map(r => {
                                    if (r.latitude != null && r.longitude != null) crPts.push({ id: r.id, name: r.name, lat: r.latitude, lng: r.longitude });
                                    const times = r.allocations.length
                                        ? r.allocations.map(a => `<span class="badge bg-info-subtle text-info-emphasis me-1 mb-1">${DAYS[a.dayOfWeek]} ${a.startTime}–${a.endTime}${a.note ? ' (' + esc(a.note) + ')' : ''}</span>`).join('')
                                        : '<span class="text-muted small">Inga tider angivna.</span>';
                                    return `<div class="mb-2"><a href="/skjutbanor?range=${r.id}" class="fw-semibold text-decoration-none" onclick="return crNameClick(${r.id})">${esc(r.name)}</a>${r.city ? ' <span class="text-muted small">· ' + esc(r.city) + '</span>' : ''}<div class="mt-1">${times}</div></div>`;
                                }).join('');
                                // Build immediately if the Banor tab is already active; otherwise on first show
                                // (Leaflet needs a sized, visible container to zoom correctly).
                                if (document.getElementById('clubRanges').classList.contains('active')) buildMap();
                            } catch (e) { }
                        }
                        // Clicking a range NAME pans/zooms the map to it (the map marker opens the range page).
                        window.crNameClick = function (id) {
                            buildMap();
                            const pt = crPts.find(p => p.id === id);
                            if (pt && crMap) {
                                crMap.setView([pt.lat, pt.lng], 15);
                                if (crMarkers[id]) crMarkers[id].openPopup();
                                document.getElementById('clubRangesMap').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                                return false; // panned — don't navigate
                            }
                            return true; // range has no coordinates — fall back to opening its page
                        };
                        const tabBtn = document.getElementById('clubRanges-tab');
                        if (tabBtn) tabBtn.addEventListener('shown.bs.tab', buildMap);
                        load();
                    })();
                    </script>
                </div>

                <!-- TIER 2: Calendar Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubCalendar" role="tabpanel">
                    @await Html.PartialAsync("ClubCalendar")
                </div>

                <!-- TIER 2: Competitions Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubCompetitions" role="tabpanel">
                    @await Html.PartialAsync("ClubCompetitionsList")
                </div>

                <!-- TIER 2: Members Directory (All logged-in users) -->
                <div class="tab-pane fade" id="clubMembers" role="tabpanel">
                    @await Html.PartialAsync("ClubInstructorsPublicPanel")
                    @{
                        var ligaVD = new ViewDataDictionary(ViewData);
                        ligaVD["LeaderboardClubId"] = clubId;
                    }
                    @await Html.PartialAsync("ClubGuldserieLeaderboard", null, ligaVD)
                    @await Html.PartialAsync("ClubMembersDirectory")
                </div>

                <!-- TIER 2: Records (All logged-in users) -->
                <div class="tab-pane fade" id="clubRecords" role="tabpanel">
                    @{
                        var clubRecVD = new ViewDataDictionary(ViewData);
                        clubRecVD["RecordsScopeType"] = "Club";
                        clubRecVD["RecordsScopeId"] = clubId.ToString();
                        clubRecVD["RecordsCanEdit"] = isClubAdmin;
                        clubRecVD["RecordsScopeName"] = clubName;
                    }
                    @await Html.PartialAsync("RecordsHallOfFame", null, clubRecVD)
                </div>

                <!-- TIER 2: Documents Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubDocuments" role="tabpanel">
                    @{ ViewBag.DocumentOwnerType = 0; ViewBag.DocumentOwnerId = clubId; }
                    @await Html.PartialAsync("DocumentArchive")
                </div>

                @if (isClubAdmin)
                {
                    <!-- TIER 3: Admin Tab (Club admins only) -->
                    <div class="tab-pane fade" id="clubAdmin" role="tabpanel">
                        @await Html.PartialAsync("ClubAdminPanel")
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

<!-- CKEditor for rich text editing -->
<script src="https://cdn.ckeditor.com/ckeditor5/41.0.0/classic/ckeditor.js"></script>

<!-- Anti-forgery token for AJAX requests -->
@Html.AntiForgeryToken()

<!-- Competition Management Modals (for club admin) -->
@if (isClubAdmin)
{
    @await Html.PartialAsync("CompetitionWizardModal")
    @await Html.PartialAsync("CompetitionEditModal")
    @await Html.PartialAsync("SpringskytteEditModal")
    @await Html.PartialAsync("CompetitionAdvertEditModal")
    @await Html.PartialAsync("CompetitionDeleteConfirmModal")
    @await Html.PartialAsync("FeaturedItemsPicker")

    @* Åtgärder → Redigera tävlingen — delad med krets- och sajtlistorna *@
    @await Html.PartialAsync("_CompetitionEditDispatch")
}

<!-- JavaScript for club page functionality -->
<script>
// clubId and isLoggedIn are already declared globally above, before the partials

// Color map for event types (matches ClubCalendar.cshtml)
const eventTypeColors = {
    'Tävling': '#0d6efd',    // Blue
    'Träning': '#198754',    // Green
    'Städning': '#d63384',   // Pink
    'Möte': '#fd7e14',       // Orange
    'Socialt': '#0dcaf0',    // Cyan
    'Nyhet': '#6610f2',      // Purple
    'Annat': '#6c757d',      // Gray
    'default': '#6c757d'
};

document.addEventListener('DOMContentLoaded', function() {
    // Deep-link: open a specific tab when the URL carries its pane id as a hash
    // (e.g. .../region/club/#clubCompetitions from a competition-page breadcrumb).
    if (window.location.hash && window.location.hash.length > 1) {
        var deepTabBtn = document.getElementById(window.location.hash.substring(1) + '-tab');
        if (deepTabBtn) deepTabBtn.click();
    }

    // Always load public quick link documents (visible to everyone)
    if (clubId > 0) {
        loadClubQuickLinkDocuments();
    }

    // Only load events for logged-in users (they appear in the tabs)
    // Public visitors don't see events or news - only the about section
    if (clubId > 0 && isLoggedIn) {
        loadUpcomingEvents();
    }
});

function loadUpcomingEvents() {
    fetch(`/umbraco/surface/Club/GetClubEvents?clubId=${clubId}`)
        .then(response => response.json())
        .then(data => {
            const container = document.getElementById('upcomingEventsContainer');
            if (data.success && data.data && data.data.length > 0) {
                const now = new Date();
                // Show future events + all Nyhet items (news persist regardless of date)
                const visibleEvents = data.data.filter(event =>
                    event.type === 'Nyhet' || (event.date && new Date(event.date) >= now)
                );

                if (visibleEvents.length > 0) {
                    // Sort: Nyhet without date first, then by date ascending
                    visibleEvents.sort((a, b) => {
                        const aIsNews = a.type === 'Nyhet';
                        const bIsNews = b.type === 'Nyhet';
                        if (aIsNews && !a.date) return -1;
                        if (bIsNews && !b.date) return 1;
                        const aDate = a.date ? new Date(a.date) : new Date(0);
                        const bDate = b.date ? new Date(b.date) : new Date(0);
                        return aDate - bDate;
                    });

                    let html = '<ul class="list-group list-group-flush">';
                    visibleEvents.slice(0, 5).forEach(event => {
                        const color = eventTypeColors[event.type] || eventTypeColors.default;
                        const eventNameHtml = event.url
                            ? `<a href="${event.url}" class="text-decoration-none"><h6 class="mb-0">${event.name}</h6></a>`
                            : `<h6 class="mb-0">${event.name}</h6>`;

                        // Date text (inline with name) - skip invalid/missing dates
                        let dateText = '';
                        if (event.date) {
                            const d = new Date(event.date);
                            if (d.getFullYear() > 1900) {
                                dateText = event.type === 'Nyhet'
                                    ? d.toLocaleDateString('sv-SE')
                                    : d.toLocaleDateString('sv-SE') + (event.venue ? ' - ' + event.venue : '');
                            }
                        }

                        // Extract first line of plain text from description
                        let snippet = '';
                        if (event.description) {
                            const tmp = document.createElement('div');
                            tmp.innerHTML = event.description;
                            const text = (tmp.textContent || '').trim();
                            const firstLine = text.split(/\r?\n/)[0].trim();
                            snippet = firstLine.length > 120 ? firstLine.substring(0, 117) + '...' : firstLine;
                        }

                        html += `
                            <li class="list-group-item py-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div style="min-width: 0; flex: 1;">
                                        <div class="d-flex align-items-baseline gap-2">
                                            ${eventNameHtml}
                                            ${dateText ? `<small class="text-muted flex-shrink-0">${dateText}</small>` : ''}
                                        </div>
                                        ${snippet ? `<p class="mb-0 text-muted small event-snippet">${snippet}</p>` : ''}
                                    </div>
                                    <span class="badge ms-2 flex-shrink-0" style="background-color: ${color}">${event.type}</span>
                                </div>
                            </li>
                        `;
                    });
                    html += '</ul>';
                    container.innerHTML = html;
                } else {
                    container.innerHTML = '<p class="text-muted">Inga kommande händelser planerade.</p>';
                }
            } else {
                container.innerHTML = '<p class="text-muted">Inga händelser hittades.</p>';
            }
        })
        .catch(error => {
            console.error('Error loading events:', error);
            document.getElementById('upcomingEventsContainer').innerHTML = '<p class="text-danger">Fel vid hämtning av händelser.</p>';
        });
}

function loadClubQuickLinkDocuments() {
    fetch(`/umbraco/surface/Document/GetQuickLinks?ownerType=0&ownerId=${clubId}`)
        .then(r => r.json())
        .then(data => {
            if (data.success && data.data && data.data.length > 0) {
                let html = '';
                data.data.forEach(doc => {
                    html += `<a href="/umbraco/surface/Document/DownloadDocument?id=${doc.id}" class="list-group-item list-group-item-action d-flex align-items-center" target="_blank">
                        <i class="bi ${doc.icon} me-3 text-primary"></i>
                        <div>
                            <strong>${doc.title}</strong>
                            <small class="d-block text-muted">${doc.fileName}</small>
                        </div>
                    </a>`;
                });

                // Populate logged-in quick links section
                const memberContainer = document.getElementById('clubQuickLinkDocuments');
                if (memberContainer) memberContainer.innerHTML = html;

                // Populate public quick links section
                const publicContainer = document.getElementById('publicQuickLinkDocuments');
                if (publicContainer) {
                    publicContainer.innerHTML = html;
                    const card = document.getElementById('publicQuickLinkDocumentsCard');
                    if (card) card.style.display = '';
                }
            }
        })
        .catch(err => console.error('Quick link documents error:', err));
}

function escapeHtml(text) {
    if (!text) return '';
    const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
    };
    return text.replace(/[&<>"']/g, m => map[m]);
}

</script>

