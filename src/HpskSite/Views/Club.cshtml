                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- TIER 2 & 3: MEMBER/ADMIN VIEW - With tabs and role-based functionality -->
        <div class="container-fluid mt-4">
            @await Html.PartialAsync("ClubNavigation")

            <!-- Tab Content -->
            <div class="tab-content mt-3" id="clubTabContent">

                <!-- TIER 2: About Tab (All logged-in users) -->
                <div class="tab-pane fade show active" id="clubHome" role="tabpanel">
                    @* "Det här händer i {klubben}" — samma flöde som startsidan och kretssidan, låst till
                       klubbens egna tävlingar, händelser och träningar. Ersätter "Utvalda tävlingar" (C3 F3). *@
                    @await Html.PartialAsync("_WhatsHappening", new HpskSite.Models.WhatsHappeningScope { LockedClubId = clubId, LockedClubName = clubName })
                    <div class="row">
                        <!-- Main Content Column -->
                        <div class="col-lg-8">
                            <!-- Upcoming Events -->
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="bi bi-calendar-event me-2"></i>Kommande Händelser
                                    </h5>
                                </div>
                                <div class="card-body" id="upcomingEventsContainer">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Laddar händelser...</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sidebar Column -->
                        <div class="col-lg-4">
                            @* Motionerna (för klubbens medlemmar) och styrelsens ärenden (för styrelseledamöter). *@
                            @await Html.PartialAsync("_ClubMotionCard", null, new ViewDataDictionary(ViewData) { { "MotionCardClubId", clubId } })
                            <!-- Contact Information -->
                            @if (!string.IsNullOrEmpty(contactPerson) || !string.IsNullOrEmpty(contactEmail) || !string.IsNullOrEmpty(contactPhone))
                            {
                                <div class="card mb-4">
                                    <div class="card-header bg-primary text-white">
                                        <h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Kontakt</h5>
                                    </div>
                                    <div class="card-body">
                                        @if (!string.IsNullOrEmpty(contactPerson))
                                        {
                                            <div class="d-flex align-items-center mb-3">
                                                <i class="bi bi-person fs-4 text-primary me-3"></i>
                                                <div>
                                                    <small class="text-muted d-block">Kontaktperson</small>
                                                    <span>@contactPerson</span>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(contactEmail))
                                        {
                                            <div class="d-flex align-items-center mb-3">
                                                <i class="bi bi-envelope fs-4 text-primary me-3"></i>
                                                <div>
                                                    <small class="text-muted d-block">E-post</small>
                                                    <a href="mailto:@contactEmail">@contactEmail</a>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(contactPhone))
                                        {
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-telephone fs-4 text-primary me-3"></i>
                                                <div>
                                                    <small class="text-muted d-block">Telefon</small>
                                                    <a href="tel:@contactPhone">@contactPhone</a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Quick Links -->
                            <div class="card mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i>Snabblänkar</h5>
                                </div>
                                <div class="list-group list-group-flush">
                                    <a href="#" onclick="document.getElementById('clubCalendar-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-calendar3 me-3 text-primary"></i>
                                        <div>
                                            <strong>Kalender</strong>
                                            <small class="d-block text-muted">Se alla händelser</small>
                                        </div>
                                    </a>
                                    <a href="#" onclick="document.getElementById('clubMembers-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-people me-3 text-primary"></i>
                                        <div>
                                            <strong>Medlemmar</strong>
                                            <small class="d-block text-muted">Medlemskatalog</small>
                                        </div>
                                    </a>
                                    <a href="#" onclick="document.getElementById('clubRecords-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-award me-3 text-primary"></i>
                                        <div>
                                            <strong>Klubbrekord</strong>
                                            <small class="d-block text-muted">Rekord i @clubName</small>
                                        </div>
                                    </a>
                                    <a href="#" onclick="document.getElementById('clubCompetitions-tab').click(); return false;" class="list-group-item list-group-item-action d-flex align-items-center">
                                        <i class="bi bi-trophy me-3 text-primary"></i>
                                        <div>
                                            <strong>Tävlingar</strong>
                                            <small class="d-block text-muted">Tävlingar arrangerade av @clubName</small>
                                        </div>
                                    </a>
                                    <div id="clubQuickLinkDocuments"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- TIER 2: About Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubAbout" role="tabpanel">
                    @if (!string.IsNullOrEmpty(welcomeMessage))
                    {
                        <div class="card mb-4">
                            <div class="card-header">
                                <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Om klubben</h5>
                            </div>
                            <div class="card-body">
                                <div class="prose">
                                    @Html.Raw(welcomeMessage)
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">Ingen information om klubben har lagts till ännu.</div>
                    }
                </div>

                <!-- TIER 2: Banor Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubRanges" role="tabpanel">
                    @*
                        Klubbens banor (omgjord 2026-10-11): ett kort per bana med samma karta som tävlingssidan
                        (röd punkt, Vägbeskrivning), klubbens fasta tider och länkar till banans egen sida
                        (/skjutbana/{id}) och dess kalender. Kartan ritas när fliken visas — Leaflet räknar fel i
                        en dold ruta. ⚠️ Inga användartexter i onclick.
                    *@
                    <div id="clubRangesList"></div>
                    <div id="clubRangesEmpty" class="alert alert-info" style="display:none">
                        <i class="bi bi-info-circle me-1"></i>Ingen skjutbana är kopplad till klubben ännu.
                        Klubbens administratör hittar er bana bland <a href="/skjutbanor">skjutbanorna</a> och gör anspråk på den.
                    </div>
                    <link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" />
                    <script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js"></script>
                    <script src="~/js/range-map.js" asp-append-version="true"></script>
                    <script>
                    (function () {
                        const crClubId = @clubId;
                        const DAYS = { 1:'Måndag', 2:'Tisdag', 3:'Onsdag', 4:'Torsdag', 5:'Fredag', 6:'Lördag', 7:'Söndag' };
                        const RELATION = { Owner:'Klubben äger banan', Huvudman:'Klubben äger banan', PrimaryUser:'Klubbens huvudbana', User:'Klubben använder banan', Tenant:'Klubben hyr tider på banan' };
                        const esc = s => (s == null ? '' : String(s)).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
                        let ranges = [];
                        function drawMaps() {
                            if (!document.getElementById('clubRanges').classList.contains('active') || !window.hpskRangeMap) return;
                            ranges.forEach(r => window.hpskRangeMap.render(document.getElementById('crMap' + r.id), r));
                        }
                        async function load() {
                            try {
                                const res = await fetch('/umbraco/surface/ShootingRange/GetClubRanges?clubId=' + crClubId, { credentials: 'same-origin' });
                                const d = res.ok ? await res.json() : null;
                                if (!d || !d.success || !d.ranges.length) { document.getElementById('clubRangesEmpty').style.display = ''; return; }
                                ranges = d.ranges;
                                document.getElementById('clubRangesList').innerHTML = ranges.map(r => {
                                    const pos = window.hpskRangeMap && window.hpskRangeMap.hasPos(r);
                                    const addr = window.hpskRangeMap ? window.hpskRangeMap.addressText(r) : (r.city || '');
                                    const times = r.allocations.length
                                        ? '<ul class="list-unstyled mb-0">' + r.allocations.slice().sort((a, b) => a.dayOfWeek - b.dayOfWeek || a.startTime.localeCompare(b.startTime))
                                            .map(a => `<li>${DAYS[a.dayOfWeek]} ${esc(a.startTime)}–${esc(a.endTime)}${a.note ? ' <span class="text-muted">(' + esc(a.note) + ')</span>' : ''}</li>`).join('') + '</ul>'
                                        : '<span class="text-muted">Inga fasta tider.</span>';
                                    return `<div class="card mb-3"><div class="card-body">
                                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                                            <div><h5 class="mb-0"><a class="text-decoration-none" href="/skjutbana/${r.id}">${esc(r.name)}</a></h5>
                                                <div class="small text-muted">${esc(RELATION[r.relationType] || '')}</div></div>
                                            <div class="d-flex flex-wrap gap-2">
                                                ${pos ? `<a class="btn btn-sm btn-outline-primary" target="_blank" rel="noopener" href="${esc(window.hpskRangeMap.directionsUrl(r))}"><i class="bi bi-signpost-2 me-1"></i>Vägbeskrivning</a>` : ''}
                                                <a class="btn btn-sm btn-outline-primary" href="/skjutbana/${r.id}#vy=kalender"><i class="bi bi-calendar3 me-1"></i>Banans kalender</a>
                                                <a class="btn btn-sm btn-outline-secondary" href="/skjutbana/${r.id}">Om banan</a>
                                            </div></div>
                                        <div class="row g-3">
                                            <div class="col-md-7">${addr ? `<div class="mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>${esc(addr)}</div>` : ''}
                                                ${pos ? `<div id="crMap${r.id}" style="height:220px;border-radius:.5rem;border:1px solid var(--bs-border-color)"></div>` : '<div class="text-muted small">Banan har ingen plats på kartan ännu.</div>'}</div>
                                            <div class="col-md-5"><div class="fw-semibold mb-1">Klubbens tider</div>${times}</div>
                                        </div></div></div>`;
                                }).join('');
                                drawMaps();
                            } catch (e) { document.getElementById('clubRangesEmpty').style.display = ''; }
                        }
                        const tabBtn = document.getElementById('clubRanges-tab');
                        if (tabBtn) tabBtn.addEventListener('shown.bs.tab', drawMaps);
                        load();
                    })();
                    </script>
                </div>

                <!-- TIER 2: Calendar Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubCalendar" role="tabpanel">
                    @await Html.PartialAsync("ClubCalendar")
                </div>

                <!-- TIER 2: Competitions Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubCompetitions" role="tabpanel">
                    @await Html.PartialAsync("ClubCompetitionsList")
                </div>

                <!-- TIER 2: Members Directory (All logged-in users) -->
                <div class="tab-pane fade" id="clubMembers" role="tabpanel">
                    @await Html.PartialAsync("ClubInstructorsPublicPanel")
                    @{
                        var ligaVD = new ViewDataDictionary(ViewData);
                        ligaVD["LeaderboardClubId"] = clubId;
                    }
                    @await Html.PartialAsync("ClubGuldserieLeaderboard", null, ligaVD)
                    @await Html.PartialAsync("ClubMembersDirectory")
                </div>

                <!-- TIER 2: Records (All logged-in users) -->
                <div class="tab-pane fade" id="clubRecords" role="tabpanel">
                    @{
                        var clubRecVD = new ViewDataDictionary(ViewData);
                        clubRecVD["RecordsScopeType"] = "Club";
                        clubRecVD["RecordsScopeId"] = clubId.ToString();
                        clubRecVD["RecordsCanEdit"] = isClubAdmin;
                        clubRecVD["RecordsScopeName"] = clubName;
                    }
                    @await Html.PartialAsync("RecordsHallOfFame", null, clubRecVD)
                </div>

                <!-- TIER 2: Documents Tab (All logged-in users) -->
                <div class="tab-pane fade" id="clubDocuments" role="tabpanel">
                    @{ ViewBag.DocumentOwnerType = 0; ViewBag.DocumentOwnerId = clubId; }
                    @await Html.PartialAsync("DocumentArchive")
                </div>

                @if (isClubAdmin)
                {
                    <!-- TIER 3: Admin Tab (Club admins only) -->
                    <div class="tab-pane fade" id="clubAdmin" role="tabpanel">
                        @await Html.PartialAsync("ClubAdminPanel")
                    </div>
                }
            </div>
        </div>
    }
</div>

