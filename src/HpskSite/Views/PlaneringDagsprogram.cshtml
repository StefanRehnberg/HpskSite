@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Dagsprogram";
    var planningId = ViewData["PlanningId"] as int? ?? 0;
    var exists = ViewData["Exists"] as bool? ?? false;
    var canAccess = ViewData["CanAccess"] as bool? ?? false;
    var competitionId = ViewData["CompetitionId"] as int? ?? 0;
    var planningName = ViewData["PlanningName"]?.ToString() ?? "";
    var compName = ViewData["CompetitionName"]?.ToString() ?? "";
    var discipline = ViewData["Discipline"]?.ToString() ?? "Precision";

    var childVd = new ViewDataDictionary(ViewData);
    childVd["CompetitionId"] = competitionId;
    childVd["PlanningId"] = planningId;
    childVd["Discipline"] = discipline;
}

@* Planeringens dagsprogram (Stefan 2026-10-23: en planering, inte två), i planeringens ram med vänstermenyn.
   Dagsprogrammet hör till tävlingen, så sidan har innehåll först när planeringen är kopplad.
   Se TavlingsplaneringController.PlanningAgenda. *@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/sv.js"></script>
<script src="~/js/planering-dates.js" asp-append-version="true"></script>
@await Html.PartialAsync("_PlaneringShellStyles")
<style>.pl-page .pl-main { min-width: 0; }</style>

<div class="pl-page container-fluid py-4" id="plApp">
    @Html.AntiForgeryToken()
    <div class="pl-shell">
        <nav class="pl-rail" aria-label="Planeringens delar">
            <a href="/tavlingsplanering" class="pl-back" id="plBack">← Mina planeringar</a>
            <div class="pl-org" id="plOrg">@planningName</div>
            <div class="pl-role" id="plRole"></div>
            <div id="plRail" style="display:contents"></div>
        </nav>
        <div class="pl-main">
            <div class="pl-head">
                <div>
                    <h1 id="plTitle">Dagsprogram</h1>
                    <div class="pl-sub" id="plSub">@if (exists && canAccess)
                        {<text>@planningName</text>@if (!string.IsNullOrEmpty(compName))
                        {<span> · tävlingen <strong>@compName</strong></span>}}</div>
                </div>
                <div class="dropdown d-none pl-noprint" id="plActions">
                    <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-sliders me-1"></i>Åtgärder
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width:270px" id="plActionsList"></ul>
                </div>
            </div>
            <div id="plMsg" aria-live="polite"></div>

            @if (!exists || !canAccess)
            {
                <div class="alert alert-warning">Planeringen finns inte, eller så har du inte behörighet att ändra i den.</div>
            }
            else if (competitionId <= 0)
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-1"></i>Dagsprogrammet hör till tävlingen — vad som händer när under tävlingsdagarna,
                    som skyttarna och funktionärerna ser i Mitt schema. Koppla planeringen till tävlingen när den är upplagd, så kan du
                    göra dagsprogrammet här.
                </div>
            }
            else
            {
                @* ⚠️ FÖRE delvyn: anropen får planeringens id, så den som får ändra i planeringen når tävlingens
                   dagsprogram genom kopplingen (StaffingController.CanManageAgendaAsync). *@
                <script>
                    (function () {
                        var PID = @planningId;
                        var orig = window.fetch;
                        window.fetch = function (u, o) {
                            if (typeof u === 'string' && u.indexOf('/umbraco/surface/Staffing/') >= 0 && u.indexOf('planningId=') < 0)
                                u += (u.indexOf('?') >= 0 ? '&' : '?') + 'planningId=' + PID;
                            return orig.call(this, u, o);
                        };
                    })();
                </script>

                @await Html.PartialAsync("_CompetitionAgenda", childVd)
            }
        </div>
    </div>

    @* Samma dialoger som övriga planeringssidor (planering.js formModal/plConfirm). *@
    <div class="modal fade pl-modal" id="plConfirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="plConfirmTitle">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5" id="plConfirmTitle"></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button></div>
                <div class="modal-body" id="plConfirmText" style="white-space:pre-line;"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn btn-primary" id="plConfirmOk">OK</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade pl-modal" id="plFormModal" tabindex="-1" aria-hidden="true" aria-labelledby="plFormTitle" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content">
                <div class="modal-header"><h2 class="modal-title h5" id="plFormTitle"></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button></div>
                <div class="modal-body">
                    <div class="alert alert-danger d-none" id="plFormErr" role="alert"></div>
                    <div id="plFormBody"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="plFormCancel">Avbryt</button>
                    <button type="button" class="btn btn-primary" id="plFormOk">Spara</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (exists && canAccess)
{
    <script>window.PL_CONFIG = { id: @planningId, token: '', railOnly: 'dagsprogram' };</script>
    <script src="~/js/planering.js" asp-append-version="true"></script>
}
