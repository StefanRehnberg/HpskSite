@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Min kurs";
    var initialGroup = ViewData["MinKursGroupId"] as int? ?? 0;
}
@*
    Fas D: Min kurs. Mobil först. Varje knapp bär ett id i ett data-attribut och läses av EN delegerad
    lyssnare — ingen användartext (namn, anteckningar) byggs in i ett onclick.

    Närvaron skrivs genom ClubEvent/SetAttendance (kind = Training) — samma väg som deltagarsidan,
    så det finns EN sanning om vem som var där.
*@
@await Html.PartialAsync("_HtmlEscape")
@* Deltagarens vy öppnar ett tillfälle (anmälan, lånevapen) i samma panel som kalendern. *@
@await Html.PartialAsync("_TrainingPanelModal")
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>
<style>
    /* ── Skalet: samma form som Ekonomin (Stefan 2026-10-06) ─────────────────────────────────
       Vänsterkort med kursens namn, rollen och klubben, "← Tillbaka" och sidans delar; allt
       innehåll i EN kolumn till höger. Värdena är Ekonomins (.ek-page .rail) så de två sidorna
       ser likadana ut — ändras den ena, ändra den andra. */
    .mk-page .mk-shell { display: flex; gap: 1.5rem; align-items: flex-start; }
    .mk-page .mk-rail { width: 250px; flex-shrink: 0; position: sticky; top: 1rem;
        background-color: var(--bs-tertiary-bg); border: 1px solid var(--bs-border-color);
        border-radius: .5rem; padding: 8px; }
    .mk-page .mk-rail .mk-course { font-size: 1.1rem; font-weight: 700; padding: 6px 12px 0; }
    .mk-page .mk-rail .mk-role { font-size: .8rem; color: var(--bs-secondary-color); padding: 0 12px 10px; }
    .mk-page .mk-rail a.mk-nav { display: block; padding: 8px 12px; border-radius: 8px;
        color: var(--bs-body-color); text-decoration: none; border-left: 3px solid transparent; }
    .mk-page .mk-rail a.mk-nav:hover { background-color: var(--bs-secondary-bg); }
    .mk-page .mk-rail a.mk-nav.on { font-weight: 600; background-color: var(--bs-primary-bg-subtle);
        color: var(--bs-primary-text-emphasis); border-left-color: var(--bs-primary); }
    .mk-page .mk-rail a.mk-back { color: var(--bs-secondary-color); font-size: .9rem; padding-bottom: 10px;
        margin-bottom: 6px; border-bottom: 1px solid var(--bs-border-color); border-radius: 0; }
    .mk-page .mk-rail a.mk-back:hover { color: var(--bs-link-color); background: none; }
    .mk-page .mk-main { flex: 1 1 auto; min-width: 0; }
    .mk-page .mk-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
        flex-wrap: wrap; margin-bottom: 1rem; }
    .mk-page h1 { font-size: 1.6rem; font-weight: 700; margin: 0; }
    @@media (max-width: 991px) {
        .mk-page .mk-shell { flex-direction: column; }
        .mk-page .mk-rail { width: 100%; position: static; display: flex; flex-wrap: wrap; gap: .3rem; align-items: center; }
        .mk-page .mk-rail .mk-course, .mk-page .mk-rail .mk-role, .mk-page .mk-rail #mkPickerWrap { width: 100%; }
        .mk-page .mk-rail .mk-role { padding-bottom: 4px; }
        .mk-page .mk-rail a.mk-nav { border-left: 0; }
        .mk-page .mk-rail a.mk-nav.on { border-left: 0; box-shadow: inset 0 -3px 0 var(--bs-primary); }
        .mk-page .mk-rail a.mk-back { width: 100%; }
        .mk-page .mk-main { width: 100%; }
    }
    /* Chattknappen ligger fast nere till höger — luft under sista raden så den aldrig täcker den. */
    .mk-page .mk-main { padding-bottom: 5.5rem; }
    .mk-today { border-left: 4px solid var(--bs-success); }
    .mk-person { border: 1px solid var(--bs-border-color); border-radius: .5rem; padding: .5rem .75rem; margin-bottom: .375rem; background: var(--bs-body-bg); }
    .mk-person .mk-name { font-weight: 600; min-width: 0; }
    .mk-badge-img { vertical-align: middle; }
    .mk-person .mk-sub { min-width: 0; }
    .mk-person .btn-link { text-decoration: none; }
    .mk-att .btn { min-width: 3.6rem; padding-left: .5rem; padding-right: .5rem; }
    .mk-grid thead th:first-child { position: sticky; left: 0; background: var(--bs-body-bg); z-index: 2; }
    .mk-occ-row { cursor: pointer; }
    .mk-occ-desc { white-space: pre-line; }
    .mk-occ-cell { overflow-wrap: anywhere; }
    .mk-occ-facts i { opacity: .7; }
    .mk-state { font-size: .8125rem; white-space: nowrap; }
    .mk-badge { font-size: .875rem; color: var(--bs-secondary-color); }
    .mk-ready { color: var(--bs-success-text-emphasis); font-weight: 600; }
    .mk-missed { color: var(--bs-danger-text-emphasis); }
    .mk-grid th, .mk-grid td { white-space: nowrap; text-align: center; vertical-align: middle; }
    .mk-grid thead th { vertical-align: bottom; }
    .mk-occname { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-size: .75rem; line-height: 1.15; white-space: normal; max-width: 7rem; margin: 0 auto; color: var(--bs-secondary-color); }
    .mk-grid tbody td:first-child { position: sticky; left: 0; background: var(--bs-body-bg); z-index: 1; }
    .mk-grid th:first-child, .mk-grid td:first-child, .mk-grid td.mk-badgecell { text-align: left; }
    .mk-grid .mk-cell-missed { color: var(--bs-danger-text-emphasis); font-weight: 600; }
    .mk-seriesrow { display: flex; justify-content: space-between; align-items: center; padding: .375rem 0; border-bottom: 1px solid var(--bs-border-color); }
</style>

@* ⚠️ container-FLUID, som Ekonomin och klubbsidans adminpanel — en smal centrerad kolumn med en
   kant-till-kant-översikt under såg ut som två sidor ihopklistrade. *@
<div class="mk-page container-fluid py-4" id="mkApp" data-group="@initialGroup">
<div class="mk-shell">
    <nav class="mk-rail" id="mkRail" aria-label="Kursens delar">
        <div class="mk-course" id="mkRailName">Min kurs</div>
        <div class="mk-role" id="mkRailRole"></div>
        <div class="mb-2 px-2 d-none" id="mkPickerWrap">
            <label class="form-label small text-muted mb-1" for="mkPicker">Byt kurs</label>
            <select class="form-select form-select-sm" id="mkPicker"></select>
        </div>
        <a href="/" class="mk-nav mk-back" id="mkBack">← Tillbaka</a>
        <div id="mkRailLinks" style="display:contents"></div>
    </nav>
    <div class="mk-main">
    <div class="mk-head">
        <div>
            <h1 id="mkTitle">Min kurs</h1>
            <div class="text-muted small" id="mkCourseSub"></div>
        </div>
        <div class="dropdown d-none" id="mkActions">
            <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-sliders me-1"></i>Åtgärder
            </button>
            @* ⚠️ Menyn byggs PER DEL (setActions) och bär bara HANDLINGAR för delen man står på —
               aldrig en plats som rälsen redan har (Stefan 2026-10-06: "Deltagare" och "Kursens
               deltagare…", "Inställningar" och "Kursens standard…" på två ställen). *@
            <ul class="dropdown-menu dropdown-menu-end" style="min-width:240px" id="mkActionsList"></ul>
        </div>
    </div>
    <div id="mkMsg"></div>
    <div id="mkBody"><div class="text-center py-5"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar…</span></div></div></div>
    @* Översikten är en egen del i rälsen och tar hela innehållskolumnens bredd. *@
    <div id="mkOverviewWrap"></div>
    </div>
</div>
</div>
@* Notisinställningen för deltagarens påminnelse. Renderas EN gång här (partialen äger fasta id:n)
   och flyttas in i deltagarvyn när den ritas — tränarvyn visar den inte. *@
<div class="d-none" id="mkPushHome">
    @await Html.PartialAsync("_WebPushSetup", new ViewDataDictionary(ViewData) { { "WebPushShowMatchPrefs", false }, { "WebPushShowRankingPref", false }, { "WebPushShowSchedulePref", true }, { "WebPushMatchPrefDefault", "Off" } })
</div>

<!-- Registrera serie -->
<div class="modal fade" id="mkSeriesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5" id="mkSeriesTitle">Registrera serie</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2" id="mkSeriesReq"></p>
                <div id="mkSeriesDenied" class="alert alert-warning d-none"></div>
                <div id="mkSeriesEntry">
                    <div class="d-flex gap-2 mb-2">
                        <div class="btn-group flex-grow-1" role="group" aria-label="Serietyp">
                            <input type="radio" class="btn-check" name="mkType" id="mkTypePrec" value="Precision" checked>
                            <label class="btn btn-outline-primary" for="mkTypePrec">Precision</label>
                            <input type="radio" class="btn-check" name="mkType" id="mkTypeSpeed" value="Speed">
                            <label class="btn btn-outline-primary" for="mkTypeSpeed">Tillämpning</label>
                        </div>
                        <select class="form-select w-auto" id="mkWeaponGroup" aria-label="Vapengrupp">
                            <option value="C">C (.22)</option>
                            <option value="B">B</option>
                            <option value="A">A</option>
                        </select>
                    </div>
                    <div id="mkSpeedWrap" class="d-none mb-2">
                        <label class="form-label" for="mkSpeedTarget">Mål</label>
                        <select class="form-select mb-2" id="mkSpeedTarget">
                            <option value="C30_25m">1/6 C30, 25 m</option>
                            <option value="B100_50m">B100, 50 m</option>
                        </select>
                        <label class="form-label" for="mkSpeedLevel">Klarade valör</label>
                        <select class="form-select" id="mkSpeedLevel">
                            <option value="">Välj…</option>
                            <option value="Brons">Brons</option>
                            <option value="Silver">Silver</option>
                            <option value="Guld">Guld</option>
                            <option value="none">Inte godkänd</option>
                        </select>
                    </div>
                    <div id="mkPrecWrap">
                    <div class="btn-group w-100 mb-1" role="group" aria-label="Inmatning">
                        <input type="radio" class="btn-check" name="mkMode" id="mkModeShots" value="shots" checked>
                        <label class="btn btn-outline-secondary" for="mkModeShots">Skott</label>
                        <input type="radio" class="btn-check" name="mkMode" id="mkModeTotal" value="total">
                        <label class="btn btn-outline-secondary" for="mkModeTotal">Bara total</label>
                    </div>
                    <p class="form-text mb-2" id="mkModeHelp">Med skott sparas varje skott i träningsloggen. Med bara total sparas seriens summa.</p>
                    <div id="mkShotsWrap">
                        <div class="sp-shots mb-2" id="mkShots">
                            <span class="sp-shot">_</span><span class="sp-shot">_</span><span class="sp-shot">_</span><span class="sp-shot">_</span><span class="sp-shot">_</span>
                        </div>
                        <div class="sp-pad" id="mkPad">
                            <button type="button" class="sp-key sp-k-w3" data-shot="10">10</button>
                            <button type="button" class="sp-key sp-k-w3" data-shot="X">X</button>
                            <button type="button" class="sp-key" data-shot="7">7</button>
                            <button type="button" class="sp-key" data-shot="8">8</button>
                            <button type="button" class="sp-key" data-shot="9">9</button>
                            <button type="button" class="sp-key" data-shot="4">4</button>
                            <button type="button" class="sp-key" data-shot="5">5</button>
                            <button type="button" class="sp-key" data-shot="6">6</button>
                            <button type="button" class="sp-key" data-shot="1">1</button>
                            <button type="button" class="sp-key" data-shot="2">2</button>
                            <button type="button" class="sp-key" data-shot="3">3</button>
                            <button type="button" class="sp-key sp-k-w4 sp-k-ghost" data-shot="0">0</button>
                            <button type="button" class="sp-key sp-k-clear" data-mk="clear-shots">RENSA</button>
                        </div>
                    </div>
                    <div id="mkTotalWrap" class="d-none mb-2">
                        <label class="form-label" for="mkTotal">Seriens total (0–50)</label>
                        <input type="number" min="0" max="50" class="form-control form-control-lg" id="mkTotal" inputmode="numeric">
                    </div>
                    </div>
                    <div class="small text-muted mt-2" id="mkGuldNote"></div>
                    <div class="d-flex align-items-center gap-2 mt-3">
                        <div class="me-auto fw-semibold" id="mkSeriesSum"></div>
                        <button type="button" class="btn btn-success" id="mkSeriesSave" disabled>Spara serien</button>
                    </div>
                    <div id="mkSeriesErr" class="text-danger small mt-2"></div>
                </div>
                <h3 class="h6 mt-4 mb-1">Dagens serier</h3>
                <div id="mkSeriesList" class="small"></div>
            </div>
        </div>
    </div>
</div>

<!-- Anteckning -->
<div class="modal fade" id="mkNoteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5" id="mkNoteTitle">Anteckning</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Anteckningen följer med till nästa tillfälle, så nästa instruktör ser den. Den sparas tills någon tar bort den.</p>
                <textarea class="form-control" id="mkNoteText" rows="4" maxlength="2000"></textarea>
                <div id="mkNoteErr" class="text-danger small mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="mkNoteSave">Spara</button>
            </div>
        </div>
    </div>
</div>

<!-- Märkesserier för en deltagare: det märkesläget räknar (Stefan 2026-10-06) -->
<div class="modal fade" id="mkBadgeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5" id="mkBadgeTitle">Märkesserier i år</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="mkBadgeBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- En deltagares uppgifter: kontakt, adress, målsmän, närmast anhörig (Stefan 2026-10-06) -->
<div class="modal fade" id="mkPersonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5" id="mkPersonTitle">Deltagaren</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body" id="mkPersonBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Mejla deltagare: välj alla eller några -->
<div class="modal fade" id="mkMailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5">Mejla deltagare</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-center mb-1">
                    <span class="form-label mb-0 me-auto">Mottagare</span>
                    <button type="button" class="btn btn-link btn-sm p-0 me-3" data-mk="mail-all">Markera alla</button>
                    <button type="button" class="btn btn-link btn-sm p-0" data-mk="mail-none">Avmarkera alla</button>
                </div>
                <div id="mkMailList" class="border rounded p-2 mb-2" style="max-height:14rem;overflow:auto"></div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="mkMailGuardians">
                    <label class="form-check-label" for="mkMailGuardians">Skicka också till målsman (när deltagaren har en registrerad)</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="mkMailLink" checked>
                    <label class="form-check-label" for="mkMailLink">Lägg till en länk till kursen — där ser eleven alla tillfällen och vilka som är obligatoriska</label>
                </div>
                <label class="form-label" for="mkMailSubject">Ämne</label>
                <input class="form-control mb-2" id="mkMailSubject" maxlength="150" autocomplete="off">
                <label class="form-label" for="mkMailBody">Meddelande</label>
                <textarea class="form-control" id="mkMailBody" rows="6" maxlength="5000"></textarea>
                <div class="form-text">Svar på mejlet går direkt till dig.</div>
                <div id="mkMailMsg" class="mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="mkMailSend">Skicka</button>
            </div>
        </div>
    </div>
</div>

<!-- Koppla träningar -->
<div class="modal fade" id="mkLinkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5">Koppla träningar till kursen</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">En kopplad träning är fortfarande en vanlig klubbträning för alla. Kursens krav (anmälan, obligatorisk närvaro) gäller bara kursens deltagare.</p>
                <div class="border rounded p-2 mb-3 bg-body-tertiary" id="mkLinkBulk">
                    <div class="small fw-semibold mb-1">Markera flera</div>
                    <div id="mkLinkSchedules" class="d-flex flex-wrap gap-1 mb-2"></div>
                    <div class="d-flex flex-wrap gap-1 align-items-end">
                        <div>
                            <label class="form-label small mb-0" for="mkLinkDay">Veckodag</label>
                            <select class="form-select form-select-sm" id="mkLinkDay">
                                <option value="1">måndag</option><option value="2">tisdag</option><option value="3">onsdag</option>
                                <option value="4">torsdag</option><option value="5">fredag</option><option value="6">lördag</option><option value="0">söndag</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-0" for="mkLinkFrom">Från</label>
                            <input type="text" class="form-control form-control-sm" id="mkLinkFrom" autocomplete="off" style="width:8.5rem">
                        </div>
                        <div>
                            <label class="form-label small mb-0" for="mkLinkTo">Till</label>
                            <input type="text" class="form-control form-control-sm" id="mkLinkTo" autocomplete="off" style="width:8.5rem">
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-mk="link-day">Markera</button>
                    </div>
                    <div class="small text-muted mt-1" id="mkLinkBulkMsg"></div>
                </div>
                <div id="mkLinkList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="mkLinkSave">Koppla valda</button>
            </div>
        </div>
    </div>
</div>

<!-- Tillfällets krav -->
<div class="modal fade" id="mkOccModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5" id="mkOccTitle">Tillfället</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Gäller bara det här tillfället och bara kursens deltagare. Kursens krav för alla tillfällen ställs in under <strong>Inställningar</strong>.</p>
                <div class="mb-3">
                    <label class="form-label" for="mkOccAtt">Närvaro för kursens deltagare</label>
                    <select class="form-select" id="mkOccAtt">
                        <option value="">Som kursen</option>
                        <option value="Optional">Valfri</option>
                        <option value="Mandatory">Obligatorisk</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="mkOccReg">Anmälan för kursens deltagare</label>
                    <select class="form-select" id="mkOccReg">
                        <option value="">Som kursen</option>
                        <option value="NotRequired">Krävs inte</option>
                        <option value="Required">Krävs</option>
                    </select>
                </div>
                <div class="mb-1">
                    <label class="form-label" for="mkOccNote">Rubrik i kursen</label>
                    <input class="form-control" id="mkOccNote" maxlength="500" placeholder="Teori 1: vapenkunskap och säkerhet" autocomplete="off">
                    <div class="form-text">Visas i stället för träningens namn, i dagens kort och i kursöversikten.</div>
                </div>
                <div id="mkOccErr" class="text-danger small mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="mkOccSave">Spara</button>
            </div>
        </div>
    </div>
</div>

<!-- Kursens deltagare -->
<div class="modal fade" id="mkMembersModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5" id="mkMembersTitle">Lägg till deltagare</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="mkMemberSearch">Sök en medlem i klubben</label>
                <input class="form-control mb-2" id="mkMemberSearch" autocomplete="off" placeholder="Skriv namn eller e-post">
                <div id="mkMemberHits" class="list-group mb-3"></div>
                <div class="small text-muted mb-2">Hittar du inte personen? Är hen nyregistrerad måste klubben först godkänna medlemskapet.</div>
                <div id="mkMembersMsg"></div>
                @* Listan över deltagarna står under Deltagare — här bara antalet, så dialogen inte blir en andra deltagarlista. *@
                <div class="small text-muted mt-2" id="mkMembersCount"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
            </div>
        </div>
    </div>
</div>

<!-- Lånevapen till tillfället (D7) -->
<div class="modal fade" id="mkLoanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5" id="mkLoanTitle">Lånevapen</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Du bokar ett lånevapen åt varje deltagare du kryssar i. Vilket vapen var och en får avgörs i valvet när vapnen lämnas ut.</p>
                <div id="mkLoanList"></div>
                <div id="mkLoanResult" class="small mt-2"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
                <button type="button" class="btn btn-primary" id="mkLoanSave">Boka för valda</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var esc = window.hpskEsc;
    var app = document.getElementById('mkApp');
    var groupId = parseInt(app.getAttribute('data-group'), 10) || 0;
    var course = null, notes = [], current = null, seriesState = null;
    var courses = [];   // MyCourses — bär rollen (trainer / manager / participant) per kurs

    function token() { var el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
    function getJson(url) {
        return fetch(url, { credentials: 'same-origin' }).then(function (r) {
            if (!r.ok) throw new Error(window.hpskRequestFailureMessage ? window.hpskRequestFailureMessage(r.status) : 'Fel ' + r.status);
            return r.json();
        });
    }
    function post(url, body) {
        return fetch(url, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        }).then(function (r) { return r.text().then(function (t) { try { return JSON.parse(t); } catch (e) { return { success: false, message: 'Sidan har varit öppen för länge — ladda om och försök igen.' }; } }); });
    }
    function msg(text, kind) {
        document.getElementById('mkMsg').innerHTML = text ? '<div class="alert alert-' + (kind || 'success') + ' py-2">' + esc(text) + '</div>' : '';
    }
    function dayLabel(iso, withWeekday) {
        var d = new Date(iso + 'T12:00:00');
        return d.toLocaleDateString('sv-SE', withWeekday ? { weekday: 'short', day: 'numeric', month: 'short' } : { day: 'numeric', month: 'short' });
    }
    function cell(m, t) { return (course.cells || {})[m + ':' + t] || { state: 'none', missed: false }; }

    // ── Kurserna ──
    function loadCourses() {
        return getJson('/umbraco/surface/TrainingCourse/MyCourses').then(function (d) {
            var list = (d && d.success && d.courses) || [];
            courses = list;
            if (!list.length) {
                // ⚠️ Texten talar till BÅDE den som går en kurs och den som leder en. Den sa förut bara
                // "du är inte tränare", vilket är fel besked till en nybörjare som letar efter sin kurs.
                document.getElementById('mkBody').innerHTML = '<div class="alert alert-info">Du är inte med i någon pågående kurs just nu. ' +
                    'Går du en nybörjarkurs lägger klubben eller din instruktör till dig i kursen — då dyker den upp här.</div>';
                return null;
            }
            var saved = 0;
            try { saved = parseInt(localStorage.getItem('hpsk_minkurs_group'), 10) || 0; } catch (e) { }
            var pick = list.some(function (c) { return c.groupId === groupId; }) ? groupId
                     : list.some(function (c) { return c.groupId === saved; }) ? saved : list[0].groupId;
            // ⚠️ Väljaren listar bara kurser man GÅR eller LEDER. En klubbadmin har rätt att öppna
            // klubbens alla kurser, men de nås från Admin → Träningsgrupper — i väljaren läste de
            // som att en deltagare kunde byta till kurser hen inte är med i (Stefan 2026-10-06).
            // Den öppna kursen står alltid med, även när den nåddes som klubbens kurs.
            var mineList = list.filter(function (c) { return c.role !== 'manager' || c.groupId === pick; });
            var sel = document.getElementById('mkPicker');
            // Kurserna heter ofta likadant ("Nybörjare 2026", "Nybörjare 2027") och kan ligga i olika
            // klubbar — raden säger därför både klubben och om man går eller leder kursen.
            sel.innerHTML = mineList.map(function (c) {
                var role = c.role === 'participant' ? 'du går kursen' : c.role === 'manager' ? 'klubbens kurs' : 'du är instruktör';
                return '<option value="' + c.groupId + '">' + esc(c.name) + ' (' + (c.clubName ? esc(c.clubName) + ', ' : '') + role + ')</option>';
            }).join('');
            sel.value = String(pick);
            document.getElementById('mkPickerWrap').classList.toggle('d-none', mineList.length < 2);
            return pick;
        });
    }

    function roleOf(id) {
        var c = courses.find(function (x) { return x.groupId === id; });
        return c ? c.role : 'trainer';
    }

    // ── Skalet: rälsen (samma form som Ekonomin, Stefan 2026-10-06) ──
    // Vyn står i adressen (#vy=…) så att en omladdning eller ett bokmärke landar där man var.
    var view = null, club = null, partView = null;
    // Tillfällen: genomförda döljs som standard, som i Träningar.
    var showDone = false, canHandOutLoans = false, meId = 0;
    // "Upprop", inte "I dag": vyn visar dagens tillfälle, annars nästa — en rubrik "I dag" över
    // ett tillfälle i april läses som fel.
    var TRAINER_VIEWS = [['idag', 'Upprop'], ['deltagare', 'Deltagare'], ['tillfallen', 'Tillfällen'], ['oversikt', 'Översikt'], ['installningar', 'Inställningar']];
    var PART_VIEWS = [['min', 'Min kurs'], ['tillfallen', 'Tillfällen'], ['serier', 'Mina serier']];
    function viewsFor(role) { return role === 'participant' ? PART_VIEWS : TRAINER_VIEWS; }
    function ensureView(role) {
        var list = viewsFor(role);
        if (view && list.some(function (x) { return x[0] === view; })) return;
        var m = (location.hash || '').match(/vy=([a-z]+)/);
        view = m && list.some(function (x) { return x[0] === m[1]; }) ? m[1] : list[0][0];
    }
    function drawShell(name, counts) {
        var role = roleOf(groupId);
        document.getElementById('mkRailName').textContent = name;
        document.getElementById('mkRailRole').textContent =
            (role === 'participant' ? 'Deltagare' : role === 'manager' ? 'Klubbens kurs' : 'Instruktör') + (club && club.name ? ' · ' + club.name : '');
        // Tillbaka dit man kom ifrån: klubbadmin till Träningsgrupper, instruktören till klubben,
        // deltagaren (som kanske inte ens är medlem i klubben) till startsidan.
        var back = document.getElementById('mkBack');
        back.href = role === 'manager' && club && club.url ? club.url + '#clubAdmin/traininggroups'
                  : role === 'trainer' && club && club.url ? club.url : '/';
        var list = viewsFor(role);
        document.getElementById('mkRailLinks').innerHTML = list.map(function (v) {
            var n = counts && counts[v[0]] != null ? ' <span class="text-muted small">(' + counts[v[0]] + ')</span>' : '';
            return '<a href="#vy=' + v[0] + '" class="mk-nav' + (v[0] === view ? ' on' : '') + '" data-mk-view="' + v[0] + '">' + esc(v[1]) + n + '</a>';
        }).join('');
        var label = list.find(function (x) { return x[0] === view; });
        document.getElementById('mkTitle').textContent = label ? label[1] : 'Min kurs';
    }

    function loadCourse(id) {
        groupId = id;
        try { localStorage.setItem('hpsk_minkurs_group', String(id)); } catch (e) { }
        ensureView(roleOf(id));
        if (roleOf(id) === 'participant') return loadParticipant(id);
        return getJson('/umbraco/surface/TrainingCourse/Get?groupId=' + id).then(function (d) {
            if (!d.success) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kursen kunde inte läsas.') + '</div>'; return; }
            course = d.course; notes = d.notes || []; club = d.club || null; canHandOutLoans = !!d.canHandOutLoans; meId = d.me || 0;
            render();
        }).catch(function (e) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-danger">' + esc(e.message) + '</div>'; });
    }

    // ── Deltagarens vy (UX-omgången 2026-10-06) ──
    // ⚠️ Bara hens egna rader: servern (TrainingCourse/Mine) skickar inga andra deltagare och inga
    // tränaranteckningar. Tillfällena öppnas i träningspanelen, där anmälan och lånevapen finns.
    function loadParticipant(id) {
        document.getElementById('mkActions').classList.add('d-none');
        document.getElementById('mkOverviewWrap').innerHTML = '';
        return getJson('/umbraco/surface/TrainingCourse/Mine?groupId=' + id).then(function (d) {
            if (!d.success) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kursen kunde inte läsas.') + '</div>'; return; }
            club = d.club || null; partView = d.course;
            renderParticipant(d.course);
        }).catch(function (e) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-danger">' + esc(e.message) + '</div>'; });
    }

    function myState(o, c) {
        if (o.isCancelled) return '<span class="mk-state text-muted">inställt</span>';
        if (c.missed) return '<span class="mk-state badge bg-danger-subtle text-danger-emphasis">Missad</span>';
        switch (c.state) {
            case 'present': return '<span class="mk-state badge bg-success-subtle text-success-emphasis"><i class="bi bi-check-lg"></i> Var där</span>';
            case 'checkedin': return '<span class="mk-state badge bg-success-subtle text-success-emphasis">Incheckad</span>';
            case 'excused': return '<span class="mk-state badge bg-secondary-subtle text-secondary-emphasis">Giltig frånvaro</span>';
            case 'absent': return '<span class="mk-state badge bg-warning-subtle text-warning-emphasis">Inte där</span>';
            case 'signedup': return '<span class="mk-state badge bg-primary-subtle text-primary-emphasis">Anmäld</span>';
        }
        return o.isPast ? '<span class="mk-state text-muted">–</span>' : '';
    }

    function occTitle(o) { return o.note || o.name; }
    function occWhen(o) { return dayLabel(o.date, true) + (o.startTime ? ' ' + o.startTime + (o.endTime ? '–' + o.endTime : '') : ''); }

    // Gren · plats · skjutledare — det som skiljer tillfällena åt. Utan raden var listan bara datum.
    function occFacts(o) {
        var parts = [];
        if (o.discipline) parts.push('<i class="bi bi-bullseye me-1"></i>' + esc(o.discipline));
        if (o.venue) parts.push('<i class="bi bi-geo-alt me-1"></i>' + esc(o.venue));
        if (o.skjutledareName) parts.push('<i class="bi bi-person-badge me-1"></i>skjutledare ' + esc(o.skjutledareName));
        return parts.join('<span class="mx-1">·</span>');
    }

    function occRow(o, c) {
        var facts = occFacts(o);
        return '<button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2 mk-occ-row" data-training-panel="' + o.trainingId + '">' +
            '<div class="me-auto text-start" style="min-width:0">' +
            '<div class="small text-muted">' + esc(occWhen(o)) + '</div>' +
            // Märket på EGEN rad: inne i den trunkerade titeln klipptes det bort på telefonen,
            // och då syntes inte att tillfället var obligatoriskt.
            '<div class="text-truncate">' + esc(occTitle(o)) + '</div>' +
            (facts ? '<div class="small text-muted mk-occ-facts">' + facts + '</div>' : '') +
            (o.mandatoryForCourse ? '<span class="badge bg-warning text-dark">★ Obligatoriskt</span>' : '') +
            '</div>' + (c.loanBooked && !o.isPast ? '<span class="mk-state badge bg-info-subtle text-info-emphasis"><i class="bi bi-safe2 me-1"></i>Lånevapen</span>' : '') +
            myState(o, c) + '</button>';
    }

    // ⚠️ Notisinställningen bor i #mkPushHome och lånas in i deltagarvyn. Den måste parkeras FÖRE
    // varje omritning av #mkBody — annars följer den med ut ur DOM:en och är borta vid nästa kursbyte.
    function parkPush() {
        var home = document.getElementById('mkPushHome'), p = document.getElementById('webPushSetup');
        if (home && p && !home.contains(p)) home.appendChild(p);
    }

    function renderParticipant(v) {
        parkPush();
        document.getElementById('mkCourseSub').textContent = v.name + (v.trainers.length ? ' · instruktör' + (v.trainers.length > 1 ? 'er ' : ' ') + v.trainers.join(', ') : '');
        var mine = function (o) { return v.mine[o.trainingId] || { state: 'none', missed: false }; };
        var occ = v.occasions || [];
        var next = occ.find(function (o) { return !o.isCancelled && !o.isPast; });
        drawShell(v.name, { tillfallen: occ.length, serier: (v.badgeSeries || []).length });
        document.getElementById('mkOverviewWrap').innerHTML = '';
        // Tre delar i rälsen: Min kurs (nästa gång, krav, märke, påminnelser), Tillfällen, Mina serier.
        var html = '', occHtml = '', seriesHtml = '';

        if (!occ.length) {
            html += '<div class="alert alert-info">Kursen har inga tillfällen inlagda än. Din instruktör lägger in dem — titta in här igen.</div>';
        }
        if (next) {
            var c = mine(next);
            html += '<div class="card mk-today mb-3"><div class="card-body">' +
                '<div class="small text-uppercase text-muted fw-semibold">' + (next.isToday ? 'I dag' : 'Nästa gång') + ' · ' + esc(occWhen(next)) + '</div>' +
                '<div class="fs-5 fw-semibold">' + esc(occTitle(next)) + '</div>' +
                // Vad det är för träning: gren, plats, skjutledare — och träningens egen beskrivning.
                (occFacts(next) ? '<div class="small text-muted mt-1">' + occFacts(next) + '</div>' : '') +
                (v.trainers.length ? '<div class="small text-muted"><i class="bi bi-people me-1"></i>Instruktör' + (v.trainers.length > 1 ? 'er ' : ' ') + esc(v.trainers.join(', ')) + '</div>' : '') +
                (next.description ? '<div class="small mt-2 mk-occ-desc">' + esc(next.description) + '</div>' : '') +
                '<div class="small mb-2 mt-2">' +
                (next.mandatoryForCourse ? '<span class="badge bg-warning text-dark me-1">★ Obligatoriskt för kursen</span>' : '') + '</div>' +
                (next.registrationRequired && c.state !== 'signedup' && c.state !== 'present'
                    ? '<div class="small mb-2"><i class="bi bi-exclamation-circle me-1"></i>Anmälan krävs till det här tillfället.</div>' : '') +
                '<button type="button" class="btn btn-primary" data-training-panel="' + next.trainingId + '">' +
                (next.registrationRequired && c.state !== 'signedup' ? 'Anmäl dig' : 'Visa tillfället') + '</button>' +
                (c.state === 'signedup' ? ' <span class="badge bg-primary-subtle text-primary-emphasis ms-1">Du är anmäld</span>' : '') +
                (c.loanBooked ? ' <span class="badge bg-info-subtle text-info-emphasis ms-1"><i class="bi bi-safe2 me-1"></i>Lånevapen bokat</span>' : '') +
                '</div></div>';
        } else if (occ.length) {
            html += '<div class="alert alert-light border">Kursen har inga fler tillfällen inlagda.</div>';
        }

        var missed = occ.filter(function (o) { return mine(o).missed; });
        if (missed.length) {
            // Kort, med datumen — vilka tillfällen det gäller står märkta "Missad" under Tidigare tillfällen.
            html += '<div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>Du har missat ' +
                (missed.length === 1 ? 'ett obligatoriskt tillfälle' : missed.length + ' obligatoriska tillfällen') + ' (' +
                missed.map(function (o) { return esc(dayLabel(o.date)); }).join(', ') +
                '). Prata med din instruktör om hur du tar igen det.</div>';
        }

        var b = v.badge || {};
        html += '<div class="card mb-3"><div class="card-body py-2 d-flex align-items-center gap-3">' +
            (badgeImg(b, 64) ? '<div class="flex-shrink-0">' + badgeImg(b, 64) + '</div>' : '') +
            '<div>' +
            '<div class="small text-uppercase text-muted fw-semibold">Mitt märkesläge</div>' +
            '<div class="' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' + esc(b.text || 'Inga godkända serier än.') +
            (b.readyForPistolskyttekort ? ' · klar för Pistolskyttekortet' : '') + '</div>' +
            '<div class="small text-muted">Bronsmärket krävs för Pistolskyttekortet. Din instruktör registrerar serierna på banan.</div>' +
            '</div></div></div>';

        var upcoming = occ.filter(function (o) { return !o.isPast; });
        var past = occ.filter(function (o) { return o.isPast; }).reverse();
        occHtml = !occ.length ? '<div class="text-muted">Kursen har inga tillfällen inlagda än.</div>'
            : '<p class="text-muted small">Tryck på ett tillfälle för att anmäla dig eller boka lånevapen. ★ = obligatoriskt för kursen.</p>' +
              '<h2 class="h6">Kommande</h2>' +
              (upcoming.length
                ? '<div class="list-group mb-3">' + upcoming.map(function (o) { return occRow(o, mine(o)); }).join('') + '</div>'
                : '<div class="text-muted small mb-3">Inga kommande tillfällen.</div>') +
              (past.length ? '<h2 class="h6">Tidigare</h2><div class="list-group mb-3">' + past.map(function (o) { return occRow(o, mine(o)); }).join('') + '</div>' : '');
        function valorBadge(val) {
            return val ? '<span class="badge bg-success-subtle text-success-emphasis">' + esc(val) + '</span>' : '<span class="text-muted small">under brons</span>';
        }
        // ⚠️ Två listor, och den första är den märkesläget räknar: årets godkända serier oavsett var
        // de sköts (kursen, en tävling, inskickade). Förut visades bara kursens serier, så märkesläget
        // kunde säga "Precision 3/3" över en tom lista.
        seriesHtml = '<h2 class="h6">Räknas mot märket i år</h2>' + badgeSeriesTable(v.badgeSeries || [], b) +
            '<h2 class="h6">Skjutna på kursen</h2>' +
            ((v.series && v.series.length)
                ? '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Dag</th><th>Tillfälle</th><th class="text-end">Poäng</th><th>Valör</th></tr></thead><tbody>' +
                    v.series.map(function (s) {
                        return '<tr><td class="text-nowrap">' + esc(dayLabel(s.date)) + '</td><td>' + esc(s.occasion) + '</td><td class="text-end">' + s.total + '</td><td>' + valorBadge(s.valor) + '</td></tr>';
                    }).join('') + '</tbody></table></div>'
                : '<div class="text-muted small mb-3">Inga serier registrerade på kursen än. Din instruktör registrerar dem på banan.</div>');

        html += '<div class="card mb-3 mt-3"><div class="card-body py-2">' +
            '<div class="small text-uppercase text-muted fw-semibold mb-1">Håll koll</div>' +
            (upcoming.some(function (o) { return o.startTime && !o.isCancelled; })
                ? '<a class="btn btn-outline-primary btn-sm mb-2" href="/min-kurs/kalender.ics?g=' + v.groupId + '"><i class="bi bi-calendar-plus me-1"></i>Lägg kursens tillfällen i min kalender</a>' +
                  '<div class="small text-muted mb-2">Filen påminner dig dagen innan. Ändras schemat behöver du hämta den igen.</div>'
                : '') +
            '<div id="mkPushSlot"></div>' +
            '</div></div>';

        document.getElementById('mkBody').innerHTML = view === 'tillfallen' ? occHtml : view === 'serier' ? seriesHtml : html;
        // Notisinställningen flyttas in (inte kopieras — den äger fasta id:n och sina lyssnare).
        var push = document.getElementById('webPushSetup');
        var slot = document.getElementById('mkPushSlot');
        if (push && slot) {
            slot.appendChild(push);
            var label = document.createElement('div');
            label.className = 'small text-muted mt-1';
            label.textContent = 'Med notiser påslagna och "Påminnelser" ikryssat får du ett meddelande dagen innan varje tillfälle.';
            slot.appendChild(label);
        }
    }

    // Upprop är sidan för ETT tillfälle: det valda (Tillfällen → Öppna tillfället, Översiktens rubrik,
    // väljaren), annars dagens, annars nästa, annars det senaste. Valet står i adressen (#vy=idag&t=…).
    var selectedOcc = 0;
    (function () { var m = (location.hash || '').match(/[&#]t=(\d+)/); if (m) selectedOcc = parseInt(m[1], 10); })();
    function pickCurrent() {
        if (selectedOcc) {
            var sel = course.occasions.find(function (o) { return o.trainingId === selectedOcc; });
            if (sel) return sel;
        }
        var occ = course.occasions.filter(function (o) { return !o.isCancelled; });
        return occ.find(function (o) { return o.isToday; })
            || occ.find(function (o) { return !o.isPast; })
            || occ[occ.length - 1] || null;
    }
    function gotoOcc(trainingId) {
        if (!trainingId) return;
        selectedOcc = trainingId;
        var h = '#vy=idag&t=' + trainingId;
        if (location.hash === h) { view = 'idag'; render(); return; }
        if (view === 'idag') { history.replaceState(null, '', h); render(); }
        else location.hash = h;   // hashchange ritar om och gör en historikpost
        window.scrollTo({ top: 0 });
    }
    function stepOcc(dir) {
        var list = course.occasions;
        var i = list.findIndex(function (o) { return current && o.trainingId === current.trainingId; });
        var n = list[i + dir];
        if (n) gotoOcc(n.trainingId);
    }
    // Väljaren överst i Upprop: föregående · datum · nästa.
    function occNavigator() {
        var list = course.occasions;
        var i = list.findIndex(function (o) { return o.trainingId === current.trainingId; });
        return '<div class="d-flex align-items-center gap-2 mb-3 mk-occnav">' +
            '<button type="button" class="btn btn-sm btn-outline-secondary" data-mk="occ-step" data-dir="-1"' + (i <= 0 ? ' disabled' : '') + ' aria-label="Föregående tillfälle"><i class="bi bi-chevron-left"></i></button>' +
            // ⚠️ min-width:0 + flex: en lång tillfällesrubrik gjorde annars sidan bredare än telefonen.
            '<select class="form-select form-select-sm flex-grow-1" style="min-width:0;max-width:30rem" id="mkOccPick" aria-label="Välj tillfälle">' +
            list.map(function (o) {
                return '<option value="' + o.trainingId + '"' + (o.trainingId === current.trainingId ? ' selected' : '') + '>' +
                    esc(dayLabel(o.date, true) + ' · ' + (o.note || o.name)) + (o.isToday ? ' (i dag)' : '') + (o.isCancelled ? ' (inställt)' : '') + '</option>';
            }).join('') + '</select>' +
            '<button type="button" class="btn btn-sm btn-outline-secondary" data-mk="occ-step" data-dir="1"' + (i >= list.length - 1 ? ' disabled' : '') + ' aria-label="Nästa tillfälle"><i class="bi bi-chevron-right"></i></button>' +
            '</div>';
    }

    // Sidans blå Åtgärder: bara HANDLINGAR för delen man står på. Ingen handling → ingen knapp.
    function setActions(items) {
        document.getElementById('mkActionsList').innerHTML = items.join('');
        document.getElementById('mkActions').classList.toggle('d-none', !items.length);
    }
    function actionsFor(v) {
        if (v === 'idag' && current) {
            var a = [];
            if (!current.isPast) a.push(menuItem('data-mk="loan"', 'bi-safe', 'Lånevapen till tillfället…'));
            a.push(menuItem('data-mk="occ" data-training="' + current.trainingId + '"', 'bi-pencil', 'Ändra tillfället i kursen…'));
            return a;
        }
        if (v === 'deltagare') return [menuItem('data-mk="members"', 'bi-person-plus', 'Lägg till deltagare…'),
                                       menuItem('data-mk="mail"', 'bi-envelope', 'Mejla deltagare…')];
        if (v === 'tillfallen') return [menuItem('data-mk="link"', 'bi-link-45deg', 'Koppla träningar till kursen…')];
        if (v === 'installningar') return [menuItem('data-mk="members" data-role="Trainer"', 'bi-person-plus', 'Lägg till instruktör…')];
        return [];
    }

    function render() {
        parkPush();
        var sub = course.name + (course.trainers.length ? ' · instruktörer ' + course.trainers.map(function (t) { return t.name; }).join(', ') : '');
        document.getElementById('mkCourseSub').textContent = sub;
        current = pickCurrent();
        var html = '';

        if (!course.occasions.length) {
            html += '<div class="alert alert-info">Inga träningar är kopplade till kursen än. Gå till <strong>Tillfällen</strong> och välj <strong>Åtgärder → Koppla träningar till kursen…</strong></div>';
        } else if (current) {
            html += occNavigator();
            var here = course.participants.filter(function (p) { var s = cell(p.memberId, current.trainingId).state; return s === 'present' || s === 'checkedin'; }).length;
            var when = (current.isToday ? 'I dag' : current.isPast ? 'Genomfört' : 'Kommande') + ' · ' + dayLabel(current.date, true) + (current.startTime ? ' ' + current.startTime : '') +
                (current.isCancelled ? ' · inställt' : '');
            var future = !current.isToday && !current.isPast;
            var loansNow = course.participants.filter(function (p) { return cell(p.memberId, current.trainingId).loanBooked; }).length;
            // Samma uppgifter som deltagarens nästa-kort: vad det är för träning, var, vem.
            html += '<div class="card mk-today mb-3"><div class="card-body py-2">' +
                '<div class="small text-uppercase text-muted fw-semibold">' + esc(when) + (current.endTime && current.startTime ? '–' + esc(current.endTime) : '') + '</div>' +
                '<div class="fs-5 fw-semibold">' + esc(current.note || current.name) + '</div>' +
                (occFacts(current) ? '<div class="small text-muted mt-1">' + occFacts(current) + '</div>' : '') +
                (current.description ? '<div class="small mt-2 mk-occ-desc">' + esc(current.description) + '</div>' : '') +
                '<div class="small text-muted mt-2">' + mandatoryBadges(current) +
                // Före tillfället finns ingen närvaro att räkna — "0 av 4 här" läses som att ingen kom.
                (future ? course.participants.length + ' deltagare' : here + ' av ' + course.participants.length + ' här') +
                (loansNow ? ' · <span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-safe2 me-1"></i>' + loansNow + ' lånevapen bokade</span>' : '') + '</div>' +
                (future ? '<div class="small text-muted mt-1"><i class="bi bi-info-circle me-1"></i>Närvaron tas på tillfällets dag.</div>' : '') +
                // Vem lämnar ut lånevapnen — skjutledaren eller klubbadmin (Stefans beslut 2026-10-06).
                (loansNow && !current.isPast
                    ? '<div class="small mt-2"><i class="bi bi-safe2 me-1"></i>' +
                      // ⚠️ "Skjutledare för tillfället" (vald per träning) är inte klubbens skjutledarroll,
                      // som valvet kräver. Står Holger själv som skjutledare utan rollen ska texten säga det —
                      // inte hänvisa honom till sig själv.
                      (canHandOutLoans
                          ? 'Lånevapnen lämnar du ut i valvet. <a href="/valvet?club=' + (club ? club.id : '') + '" target="_blank" rel="noopener">Öppna valvet</a>'
                          : current.skjutledareMemberId && current.skjutledareMemberId === meId
                              ? 'Du står som skjutledare för tillfället, men lånevapen lämnas ut av den som har klubbens skjutledarroll eller av klubbadmin. Be klubbadmin om rollen om du ska lämna ut vapen.'
                              : 'Lånevapnen lämnas ut av klubbens skjutledare eller av klubbadmin' + (current.skjutledareName ? ' — i kväll är ' + esc(current.skjutledareName) + ' skjutledare' : '') + '.') +
                      '</div>'
                    : '') +
                '</div></div>';

            // Från förra tillfället: anteckningar från tillfällen FÖRE det aktuella.
            var prevIds = course.occasions.filter(function (o) { return o.date < current.date; }).map(function (o) { return o.trainingId; });
            var handover = notes.filter(function (n) { return prevIds.indexOf(n.trainingId) >= 0; });
            var seen = {};
            handover = handover.filter(function (n) { if (seen[n.memberId]) return false; seen[n.memberId] = true; return true; });
            if (handover.length) {
                html += '<div class="alert alert-light border mb-3"><div class="small fw-semibold mb-1"><i class="bi bi-chat-left-text me-1"></i>Från tidigare tillfällen</div>' +
                    handover.map(function (n) {
                        var p = course.participants.find(function (x) { return x.memberId === n.memberId; });
                        return '<div class="small"><strong>' + esc(p ? p.name : '') + ':</strong> ' + esc(n.note) +
                            ' <span class="text-muted">(' + esc(n.authorName) + ', ' + esc(dayLabel(n.date)) + ')</span></div>';
                    }).join('') + '</div>';
            }

            if (!course.participants.length) html += '<div class="alert alert-info">Kursen har inga deltagare än.</div>';
            course.participants.forEach(function (p) { html += personCard(p); });
        }

        drawShell(course.name, { deltagare: course.participants.length, tillfallen: course.occasions.length });
        setActions(actionsFor(view));
        var ov = '';
        if (view === 'deltagare') html = participantsView();
        else if (view === 'tillfallen') html = occasionsView();
        else if (view === 'oversikt') { html = ''; ov = overview(); }
        else if (view === 'installningar') html = settingsView();
        document.getElementById('mkBody').innerHTML = html;
        document.getElementById('mkOverviewWrap').innerHTML = ov;
        if (ov) afterOverview();
    }

    function trainerNames() { return course.trainers.map(function (t) { return t.name; }).join(', '); }

    // Pistolskyttemärket i den valör deltagaren HÅLLER (verifierat märke, heldLevel). Ingen bild
    // före bronsmärket — bilden visar vad hen har tagit, inte vad hen siktar på.
    var BADGE_IMG = { Brons: 'PistolskytteB.png', Silver: 'PistolskytteS.png', Guld: 'Pistolskytte.png' };
    function badgeImg(b, size) {
        var f = b && BADGE_IMG[b.heldLevel];
        if (!f) return '';
        var t = 'Pistolskyttemärket i ' + b.heldLevel.toLowerCase() + ' — klar för Pistolskyttekortet';
        return '<img src="/images/marken/' + f + '" alt="' + esc(t) + '" title="' + esc(t) + '" class="mk-badge-img" ' +
            'style="height:' + size + 'px;width:auto" onerror="this.remove()">';
    }

    // Årets godkända märkesserier — det märkesläget räknar. EN renderare för deltagarens Mina serier
    // och instruktörens dialog, så de två aldrig visar olika saker.
    function badgeSeriesTable(bs, b) {
        var vb = function (val) {
            return val ? '<span class="badge bg-success-subtle text-success-emphasis">' + esc(val) + '</span>' : '<span class="text-muted small">under brons</span>';
        };
        return '<p class="text-muted small mb-2">Det är de här serierna märkesläget räknar — från kursen, tävlingar och inskickade serier. ' +
            (b && b.targetLevel ? 'Serier markerade med ✓ når ' + esc(b.targetLevel.toLowerCase()) + ', nästa valör.' : '') + '</p>' +
            (bs.length
                ? '<div class="table-responsive mb-3"><table class="table table-sm mk-badge-series"><thead><tr><th>Dag</th><th>Serie</th><th>Var</th><th class="text-end">Poäng</th><th>Valör</th><th></th></tr></thead><tbody>' +
                    bs.map(function (s) {
                        return '<tr><td class="text-nowrap">' + esc(dayLabel(s.date)) + '</td><td>' + esc(s.kind) + (s.weaponGroup ? ' <span class="text-muted small">' + esc(s.weaponGroup) + '</span>' : '') +
                            '</td><td class="small">' + esc(s.source) + '</td><td class="text-end">' + (s.kind && s.kind.indexOf('tillämpning') >= 0 ? '' : s.total) + '</td><td>' + vb(s.valor) +
                            '</td><td>' + (s.countsTowardTarget ? '<i class="bi bi-check-lg text-success" title="Räknas mot nästa valör"></i>' : '') + '</td></tr>';
                    }).join('') + '</tbody></table></div>'
                : '<div class="text-muted small mb-3">Inga godkända serier i år än.</div>');
    }

    function openBadgeSeries(memberId) {
        var p = course.participants.find(function (x) { return x.memberId === memberId; });
        document.getElementById('mkBadgeTitle').textContent = 'Märkesserier i år — ' + (p ? p.name : '');
        document.getElementById('mkBadgeBody').innerHTML = '<div class="text-muted">Laddar…</div>';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkBadgeModal')).show();
        getJson('/umbraco/surface/TrainingCourse/MemberBadgeSeries?groupId=' + groupId + '&memberId=' + memberId).then(function (d) {
            if (!d.success) { document.getElementById('mkBadgeBody').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Serierna kunde inte läsas.') + '</div>'; return; }
            var b = d.badge || {};
            document.getElementById('mkBadgeBody').innerHTML =
                '<div class="d-flex align-items-center gap-3 mb-3">' + badgeImg(b, 48) +
                '<div class="' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' + esc(b.text || '') + '</div></div>' +
                badgeSeriesTable(d.series || [], b);
        });
    }

    // ── Visa deltagaren: kontakt, adress, målsmän, närmast anhörig ──
    function openPerson(memberId) {
        var body = document.getElementById('mkPersonBody');
        body.innerHTML = '<div class="text-muted">Laddar…</div>';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkPersonModal')).show();
        getJson('/umbraco/surface/TrainingCourse/ParticipantInfo?groupId=' + groupId + '&memberId=' + memberId).then(function (d) {
            if (!d.success) { body.innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Uppgifterna kunde inte läsas.') + '</div>'; return; }
            var p = d.person;
            document.getElementById('mkPersonTitle').textContent = p.name;
            var b = (course.badges || {})[memberId] || {};
            // Ett tomt fält står som "saknas" — en tom rad läses som att ingen tittat.
            var val = function (v) { return v ? esc(v) : '<span class="text-muted">saknas</span>'; };
            var tel = function (v) { return v ? '<a href="tel:' + esc(v.replace(/[^\d+]/g, '')) + '">' + esc(v) + '</a>' : '<span class="text-muted">saknas</span>'; };
            var mail = function (v) { return v ? '<a href="mailto:' + esc(v) + '">' + esc(v) + '</a>' : '<span class="text-muted">saknas</span>'; };
            var row = function (label, html) { return '<dt class="col-5 col-sm-4 fw-normal text-muted">' + label + '</dt><dd class="col-7 col-sm-8 mb-1 text-break">' + html + '</dd>'; };
            var addr = [p.coAddress ? 'c/o ' + p.coAddress : '', p.address, (p.postalCode + ' ' + p.city).trim()].filter(Boolean).map(esc).join('<br>');
            var h = '<div class="d-flex align-items-center gap-3 mb-3">' + badgeImg(b, 40) +
                '<div><div class="small text-muted">' + esc(p.club || '') + '</div>' +
                '<div class="small ' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' + esc(b.text || '') + '</div></div></div>' +
                '<h3 class="h6">Kontakt</h3><dl class="row mb-3">' +
                row('Mobil', tel(p.phone)) + (p.landline ? row('Telefon', tel(p.landline)) : '') +
                row('E-post', mail(p.email)) + row('Adress', addr || '<span class="text-muted">saknas</span>') +
                row('Född', p.born ? esc(p.born) + ' (' + p.age + ' år)' : '<span class="text-muted">saknas</span>') + '</dl>' +
                '<h3 class="h6">Närmast anhörig</h3><dl class="row mb-3">' +
                row('Namn', val(p.emergency.name)) + row('Telefon', tel(p.emergency.phone)) + '</dl>';
            if (p.guardians.length || (p.age != null && p.age < 18)) {
                h += '<h3 class="h6">Målsman</h3>' + (p.guardians.length
                    ? p.guardians.map(function (g) { return '<dl class="row mb-2">' + row('Namn', val(g.name)) + row('Mobil', tel(g.mobile)) + row('E-post', mail(g.email)) + '</dl>'; }).join('')
                    : '<p class="small text-warning-emphasis">Deltagaren är under 18 men har ingen målsman registrerad.</p>');
            }
            h += '<p class="small text-muted mb-0">Uppgifterna kommer från medlemsregistret. Medlemmen ändrar dem själv under Min sida, eller klubben i medlemsregistret.</p>';
            body.innerHTML = h;
        });
    }

    // ── Mejla deltagare: alla förvalda, eller bara den rad man kom från ──
    function openMail(memberId) {
        var list = document.getElementById('mkMailList');
        list.innerHTML = course.participants.map(function (p, i) {
            var on = !memberId || p.memberId === memberId;
            return '<div class="form-check"><input class="form-check-input" type="checkbox" id="mkMail' + i + '" data-mail-member="' + p.memberId + '"' + (on ? ' checked' : '') + '>' +
                '<label class="form-check-label" for="mkMail' + i + '">' + esc(p.name) + '</label></div>';
        }).join('') || '<div class="text-muted small">Kursen har inga deltagare.</div>';
        document.getElementById('mkMailGuardians').checked = false;
        document.getElementById('mkMailLink').checked = true;
        document.getElementById('mkMailSubject').value = '';
        document.getElementById('mkMailBody').value = '';
        document.getElementById('mkMailMsg').innerHTML = '';
        document.getElementById('mkMailSend').disabled = false;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkMailModal')).show();
    }
    function sendMail() {
        var ids = Array.prototype.map.call(document.querySelectorAll('#mkMailList input:checked'), function (c) { return c.getAttribute('data-mail-member'); });
        var box = document.getElementById('mkMailMsg');
        var subject = document.getElementById('mkMailSubject').value.trim(), message = document.getElementById('mkMailBody').value.trim();
        var fail = function (t) { box.innerHTML = '<div class="alert alert-warning py-2 small">' + esc(t) + '</div>'; };
        if (!ids.length) return fail('Välj minst en mottagare.');
        if (!subject || !message) return fail('Skriv ämne och meddelande.');
        var btn = document.getElementById('mkMailSend');
        btn.disabled = true;
        postForm('/umbraco/surface/TrainingGroup/SendGroupMessage', {
            trainingGroupId: groupId, subject: subject, message: message, memberIds: ids.join(','),
            includeGuardians: document.getElementById('mkMailGuardians').checked ? '1' : '0',
            includeCourseLink: document.getElementById('mkMailLink').checked ? '1' : '0'
        }).then(function (d) {
            btn.disabled = false;
            // ⚠️ Svaret säger vilka som INTE nåddes — det står kvar i dialogen så att det går att läsa.
            box.innerHTML = '<div class="alert alert-' + (d.success && !(d.noEmail || []).length && !(d.failed || []).length ? 'success' : 'warning') + ' py-2 small">' + esc(d.message || '') + '</div>';
            if (d.success) btn.disabled = true;
        });
    }

    // Radens Åtgärder — samma form som Träningars rader (grå, text, popper fixed i .table-responsive).
    function rowMenu(items) {
        return '<div class="dropdown"><button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" ' +
            'data-bs-popper-config=\'{"strategy":"fixed"}\' aria-expanded="false"><i class="bi bi-sliders me-1"></i>Åtgärder</button>' +
            '<ul class="dropdown-menu dropdown-menu-end">' + items.join('') + '</ul></div>';
    }
    function menuItem(attrs, icon, label) {
        return '<li><button type="button" class="dropdown-item" ' + attrs + '><i class="bi ' + icon + ' me-2"></i>' + label + '</button></li>';
    }
    // Destruktivt sist, i rött, med utskriven text (husregeln för radmenyer).
    function dangerItem(attrs, icon, label) {
        return '<li><button type="button" class="dropdown-item text-danger" ' + attrs + '><i class="bi ' + icon + ' me-2"></i>' + label + '</button></li>';
    }

    // Deltagare: en rad per deltagare med närvaro, missade obligatoriska och märkesläget.
    function participantsView() {
        var held = course.occasions.filter(function (o) { return !o.isCancelled && (o.isPast || o.isToday); });
        // Förlagan (Träningar): förklarande rad + antal ovanför listan, åtgärderna i sidans blå
        // Åtgärder och i varje rads grå Åtgärder — ingen extra knapp bredvid den blå.
        var h = '<p class="text-muted small mb-2">' + course.participants.length + ' deltagare · ' +
            (course.trainers.length ? 'instruktör' + (course.trainers.length > 1 ? 'er ' : ' ') + esc(trainerNames()) : 'ingen instruktör utsedd') +
            '. Närvaro, serier och anteckningar för ett tillfälle tas under <strong>Upprop</strong>.</p>';
        if (!course.participants.length) return h + '<div class="alert alert-info">Kursen har inga deltagare än.</div>';
        // ⚠️ På telefon står närvaro, missade och märkesläge under namnet — som kolumner rullade
        // märkesläget och radens Åtgärder ut ur bild.
        h += '<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Namn</th><th class="text-center d-none d-md-table-cell">Närvaro</th><th class="d-none d-md-table-cell">Missade obligatoriska</th><th class="d-none d-md-table-cell">Märkesläge</th><th class="text-end"></th></tr></thead><tbody>';
        course.participants.forEach(function (p) {
            var here = held.filter(function (o) { var s = cell(p.memberId, o.trainingId).state; return s === 'present' || s === 'checkedin'; }).length;
            var missed = course.occasions.filter(function (o) { return cell(p.memberId, o.trainingId).missed; });
            var b = (course.badges || {})[p.memberId] || {};
            // Bara det som gäller deltagaren i hela kursen. Serie och anteckning hör till ett tillfälle
            // och görs under Upprop — här vore de "för vilket tillfälle?".
            var items = [menuItem('data-mk="person" data-member="' + p.memberId + '"', 'bi-person-vcard', 'Visa deltagaren…'),
                         menuItem('data-mk="mail" data-member="' + p.memberId + '"', 'bi-envelope', 'Mejla deltagaren…'),
                         menuItem('data-mk="badge-series" data-member="' + p.memberId + '"', 'bi-award', 'Märkesserier i år…'),
                         '<li><hr class="dropdown-divider"></li>',
                         dangerItem('data-mk="rm-member" data-member="' + p.memberId + '"', 'bi-person-dash', 'Ta bort ur kursen…')];
            var missedTxt = missed.map(function (o) { return esc(dayLabel(o.date)); }).join(', ');
            var badgeTxt = esc(b.text || '') + (b.readyForPistolskyttekort ? ' · klar för Pistolskyttekortet' : '');
            h += '<tr><td><div class="fw-semibold text-nowrap">' + badgeImg(b, 28) + (badgeImg(b, 28) ? ' ' : '') + esc(p.name) + '</div>' +
                '<div class="d-md-none small">' +
                (held.length ? '<div class="text-muted">Närvaro ' + here + ' av ' + held.length + '</div>' : '') +
                (missed.length ? '<div class="mk-missed">Missade: ' + missedTxt + '</div>' : '') +
                '<div class="' + (b.readyForPistolskyttekort ? 'mk-ready' : 'text-muted') + '">' + badgeTxt + '</div></div></td>' +
                // "0 av 0" sa ingenting innan kursen börjat.
                '<td class="text-center text-nowrap d-none d-md-table-cell">' + (held.length ? here + ' av ' + held.length : '<span class="text-muted">–</span>') + '</td>' +
                '<td class="d-none d-md-table-cell">' + (missed.length ? '<span class="mk-missed">' + missedTxt + '</span>' : '<span class="text-muted">–</span>') + '</td>' +
                '<td class="small d-none d-md-table-cell ' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' + badgeTxt + '</td>' +
                '<td class="text-end">' + rowMenu(items) + '</td></tr>';
        });
        return h + '</tbody></table></div>';
    }

    // Tillfällen: kursens kopplade träningar med kursens krav och hur många som var där.
    function occasionsView() {
        // Förlagan (Träningar): förklarande rad, filter + antal ovanför listan, grå Åtgärder per rad.
        var h = '<p class="text-muted small mb-2">Kursens kopplade träningar. ★ = obligatoriskt för kursen. ' +
            'Öppna ett tillfälle för upprop, serier och lånevapen.</p>';
        if (!course.occasions.length) return h + '<div class="alert alert-info">Inga träningar är kopplade till kursen än.</div>';
        var done = course.occasions.filter(function (o) { return o.isPast; }).length;
        // Är kursen slut finns inget kommande att visa — då visas alla direkt, utan växel.
        var allDone = done === course.occasions.length;
        var shown = course.occasions.filter(function (o) { return showDone || allDone || !o.isPast; });
        h += '<div class="d-flex align-items-center flex-wrap gap-3 mb-2">' +
            (allDone ? '<span class="small text-muted">Alla kursens tillfällen är genomförda.</span>'
                : '<div class="form-check form-switch mb-0"><input class="form-check-input" type="checkbox" id="mkShowDone"' + (showDone ? ' checked' : '') + '>' +
                  '<label class="form-check-label small" for="mkShowDone">Visa genomförda (' + done + ')</label></div>') +
            '<span class="text-muted small ms-auto">' + shown.length + ' av ' + course.occasions.length + ' tillfällen</span></div>';
        // ⚠️ På telefon döljs Tid, Krav och Var där och står i stället under namnet — med alla sex
        // kolumner rullade radens Åtgärder ut ur bild.
        var md = ' class="d-none d-md-table-cell"';
        h += '<div class="table-responsive"><table class="table align-middle"><thead><tr><th class="d-none d-md-table-cell">Datum</th><th' + md + '>Tid</th><th>Tillfälle</th><th' + md + '>Krav</th><th class="text-center d-none d-md-table-cell">Var där</th><th></th></tr></thead><tbody>';
        shown.forEach(function (o) {
            var here = course.participants.filter(function (p) { var s = cell(p.memberId, o.trainingId).state; return s === 'present' || s === 'checkedin'; }).length;
            var loans = course.participants.filter(function (p) { return cell(p.memberId, o.trainingId).loanBooked; }).length;
            var req = (o.mandatoryForCourse ? '<span class="badge bg-warning text-dark me-1">★ Obligatoriskt</span>' : '') +
                (o.registrationRequired ? '<span class="badge bg-secondary-subtle text-secondary-emphasis">Anmälan krävs</span>' : '');
            var facts = occFacts(o);
            // "Öppna tillfället" leder till Upprop för just det tillfället — kursens sida för ett
            // tillfälle. Träningspanelen (med träningens allmänna deltagarlista) erbjuds inte här: den
            // gäller hela träningen, inte kursen, och var en omväg till en annan sida.
            var items = [menuItem('data-mk="goto-occ" data-training="' + o.trainingId + '"', 'bi-box-arrow-in-right', 'Öppna tillfället'),
                         menuItem('data-mk="occ" data-training="' + o.trainingId + '"', 'bi-pencil', 'Ändra tillfället i kursen…'),
                         '<li><hr class="dropdown-divider"></li>',
                         dangerItem('data-mk="unlink-occ" data-training="' + o.trainingId + '"', 'bi-x-circle', 'Ta bort ur kursen…')];
            h += '<tr' + (o.isPast || o.isCancelled ? ' class="text-muted"' : '') + '>' +
                '<td class="text-nowrap d-none d-md-table-cell">' + esc(dayLabel(o.date, true)) + (o.isToday ? ' <span class="badge bg-success">I dag</span>' : '') + '</td>' +
                '<td class="text-nowrap d-none d-md-table-cell">' + (o.startTime ? esc(o.startTime + (o.endTime ? '–' + o.endTime : '')) : '<span class="text-muted">–</span>') + '</td>' +
                '<td class="mk-occ-cell"><div class="small fw-semibold d-md-none">' + esc(dayLabel(o.date, true)) + (o.isToday ? ' <span class="badge bg-success">I dag</span>' : '') + '</div>' +
                esc(o.note || o.name) + (o.note ? '<div class="small text-muted">' + esc(o.name) + '</div>' : '') +
                (o.isCancelled ? ' <span class="badge bg-danger">Inställd</span>' : '') +
                (o.startTime ? '<div class="small text-muted d-md-none">' + esc(o.startTime + (o.endTime ? '–' + o.endTime : '')) + '</div>' : '') +
                (facts ? '<div class="small text-muted mk-occ-facts">' + facts + '</div>' : '') +
                (req ? '<div class="d-md-none mt-1">' + req + '</div>' : '') +
                (o.isPast || o.isToday ? '<div class="small text-muted d-md-none">' + here + ' av ' + course.participants.length + ' var där</div>' : '') +
                (loans && !o.isPast ? '<div class="small"><span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-safe2 me-1"></i>' + loans + ' lånevapen bokade</span></div>' : '') + '</td>' +
                '<td class="d-none d-md-table-cell">' + (req || '<span class="text-muted">–</span>') + '</td>' +
                '<td class="text-center d-none d-md-table-cell">' + (o.isPast || o.isToday ? here + ' av ' + course.participants.length : '<span class="text-muted">–</span>') + '</td>' +
                '<td class="text-end">' + rowMenu(items) + '</td></tr>';
        });
        return h + '</tbody></table></div>';
    }

    // Inställningar: kursens standardkrav och vem som leder kursen.
    function settingsView() {
        // Redigeras här, direkt — Inställningar ÄR platsen för kursens krav (inget menyval, ingen dialog).
        var sel = function (id, cur, opts) {
            return '<select class="form-select" id="' + id + '">' + opts.map(function (o) {
                return '<option value="' + o[0] + '"' + (o[0] === cur ? ' selected' : '') + '>' + o[1] + '</option>';
            }).join('') + '</select>';
        };
        return '<div class="card mb-3"><div class="card-body">' +
            '<h2 class="h6 mb-1">Kursens krav</h2>' +
            '<p class="small text-muted">Gäller alla kursens tillfällen som inte har en egen inställning, och bara kursens deltagare. ' +
            'Ett enskilt tillfälle ändras under <strong>Tillfällen</strong>. En missad obligatorisk dag visas, men spärrar ingenting.</p>' +
            '<div class="row g-3 mb-3" style="max-width:520px">' +
            '<div class="col-sm-6"><label class="form-label" for="mkSetAtt">Närvaro</label>' +
            sel('mkSetAtt', course.defaultAttendance || 'Optional', [['Optional', 'Valfri'], ['Mandatory', 'Obligatorisk']]) + '</div>' +
            '<div class="col-sm-6"><label class="form-label" for="mkSetReg">Anmälan</label>' +
            sel('mkSetReg', course.defaultRegistration || 'NotRequired', [['NotRequired', 'Krävs inte'], ['Required', 'Krävs']]) + '</div>' +
            '</div>' +
            '<button type="button" class="btn btn-primary" data-mk="save-defaults">Spara</button>' +
            '</div></div>' +
            '<div class="card mb-3"><div class="card-body">' +
            '<h2 class="h6 mb-1">Instruktörer</h2>' +
            '<div>' + (course.trainers.length ? esc(trainerNames()) : '<span class="text-muted">Ingen utsedd</span>') + '</div>' +
            '<div class="small text-muted">Behöver du en vikarie eller fler instruktörer: <strong>Åtgärder → Lägg till instruktör…</strong> ' +
            'En instruktör tas bort av klubbadmin eller skjutledare.</div>' +
            '</div></div>';
    }

    // Översikten rullar i sidled när tillfällena inte får plats. Utan ett synligt tecken ser den
    // avklippt ut ("8 o…"), så: en rad som säger det, och tabellen rullas så att det aktuella
    // tillfället syns. ⚠️ Avståndet mäts med getBoundingClientRect, inte offsetLeft (som räknas mot
    // offsetParent och inte mot rullningsytan).
    function afterOverview() {
        var box = document.getElementById('mkOverviewScroll');
        var hint = document.getElementById('mkScrollHint');
        if (!box || !hint) return;
        var overflow = box.scrollWidth > box.clientWidth + 2;
        hint.classList.toggle('d-none', !overflow);
        if (!overflow || !current) return;
        var th = box.querySelector('th[data-occ="' + current.trainingId + '"]');
        var first = box.querySelector('thead th');
        if (!th || !first) return;
        var delta = th.getBoundingClientRect().left - box.getBoundingClientRect().left - first.getBoundingClientRect().width - 8;
        if (delta > 0) box.scrollLeft += delta;
    }

    function personCard(p) {
        var c = cell(p.memberId, current.trainingId);
        var b = (course.badges || {})[p.memberId] || {};
        var missed = course.occasions.filter(function (o) { return cell(p.memberId, o.trainingId).missed; });
        var btn = function (status, label, active) {
            return '<button type="button" class="btn btn-sm ' + (active ? 'btn-success' : 'btn-outline-secondary') + '" data-mk="att" data-member="' + p.memberId + '" data-status="' + status + '">' + label + '</button>';
        };
        var isHere = c.state === 'present', isAbsent = c.state === 'absent', isExcused = c.state === 'excused';
        var future = !current.isToday && !current.isPast;
        // Två rader i stället för tre (UX-omgången 2026-10-06): namn + närvaro överst, märkesläget och
        // serie/anteckning under. Elva deltagare gav en 3 000 px lång sida på telefonen.
        return '<div class="mk-person" data-mk-person="' + p.memberId + '">' +
            '<div class="d-flex align-items-center gap-2">' +
            '<div class="mk-name me-auto text-truncate">' + badgeImg(b, 24) + (badgeImg(b, 24) ? ' ' : '') + esc(p.name) +
            (c.state === 'checkedin' ? ' <span class="badge bg-info-subtle text-info-emphasis fw-normal">QR</span>' : '') +
            (c.loanBooked ? ' <span class="badge bg-info-subtle text-info-emphasis fw-normal"><i class="bi bi-safe2 me-1"></i>Lånevapen</span>' : '') + '</div>' +
            // Närvaro tas på tillfällets dag eller i efterhand — inte för ett tillfälle i april.
            (future ? '' :
            '<div class="btn-group mk-att flex-shrink-0" role="group" aria-label="Närvaro">' +
            btn('Present', 'Här', isHere) + btn('Absent', 'Ej här', isAbsent) + btn('Excused', 'Giltig', isExcused) +
            '</div>') + '</div>' +
            // Knapparna står ihop till höger (flex-shrink-0) och texten bryter i sin egen kolumn —
            // med flex-wrap hamnade "Anteckning" ensam på en tredje rad på telefonen.
            '<div class="d-flex align-items-start gap-1 mt-1">' +
            '<div class="mk-sub flex-grow-1 small">' +
            // Med märkesbilden bredvid namnet är "Bronsmärket klart · " en upprepning som gjorde raden
            // en rad högre på telefonen — bilden säger det redan.
            '<span class="mk-badge ' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' +
            // Likaså "klar för Pistolskyttekortet": det är exakt samma sak som att hålla bronsmärket,
            // så med bilden står det i bildens titel i stället.
            esc(badgeImg(b, 24) ? (b.text || '').replace(/^(Brons|Silver)märket klart · /, '') : (b.text || '')) +
            (b.readyForPistolskyttekort && !badgeImg(b, 24) ? ' · klar för Pistolskyttekortet' : '') + '</span>' +
            // Fler än två datum gör raden hög — då ett antal, och datumen i titeln (och i översikten).
            (missed.length ? '<span class="mk-missed" title="' + esc(missed.map(function (o) { return dayLabel(o.date); }).join(', ')) + '"> · <i class="bi bi-exclamation-triangle-fill"></i> missade ' +
                (missed.length <= 2 ? missed.map(function (o) { return esc(dayLabel(o.date)); }).join(', ') : missed.length + ' obligatoriska') + '</span>' : '') +
            '</div>' +
            '<div class="d-flex flex-shrink-0">' +
            (future ? '' : '<button type="button" class="btn btn-sm btn-link px-1 py-0" data-mk="series" data-member="' + p.memberId + '"><i class="bi bi-bullseye me-1"></i>Serie</button>') +
            '<button type="button" class="btn btn-sm btn-link px-1 py-0" data-mk="note" data-member="' + p.memberId + '"><i class="bi bi-pencil me-1"></i>Anteckning</button>' +
            '</div></div></div>';
    }

    function overview() {
        if (!course.occasions.length) return '';
        var head = course.occasions.map(function (o) {
            var label = o.note || o.name;
            return '<th data-occ="' + o.trainingId + '"><button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-mk="goto-occ" data-training="' + o.trainingId + '" title="' + esc(label) + ' — öppna tillfället">' +
                esc(dayLabel(o.date)) + (o.mandatoryForCourse ? ' ★' : '') +
                '<span class="mk-occname">' + esc(label) + '</span></button>' +
                (o.isCancelled ? '<div class="small text-danger">inställd</div>' : '') + '</th>';
        }).join('');
        var rows = course.participants.map(function (p) {
            var tds = course.occasions.map(function (o) {
                var c = cell(p.memberId, o.trainingId);
                if (o.isCancelled) return '<td class="text-muted">–</td>';
                if (c.missed) return '<td class="mk-cell-missed">Missad</td>';
                var text = { present: '✓', checkedin: 'QR', excused: 'Giltig', absent: '✗', signedup: o.isPast ? '?' : 'Anmäld', none: o.isPast ? '' : '–' }[c.state] || '';
                return '<td>' + text + '</td>';
            }).join('');
            var b = (course.badges || {})[p.memberId] || {};
            return '<tr><td>' + esc(p.name) + '</td>' + tds + '<td class="mk-badgecell small">' + esc(b.text || '') + '</td></tr>';
        }).join('');
        return '<h2 class="h5 mt-2" id="mkOverview">Kursöversikt — alla tillfällen</h2>' +
            '<div class="small text-muted mb-1 d-none" id="mkScrollHint"><i class="bi bi-arrow-left-right me-1"></i>Rulla tabellen i sidled för fler tillfällen.</div>' +
            '<div class="table-responsive" id="mkOverviewScroll"><table class="table table-sm mk-grid"><thead><tr><th>Deltagare</th>' + head + '<th>Märkesläge</th></tr></thead><tbody>' +
            rows + '</tbody></table></div>' +
            '<p class="small text-muted">★ = obligatoriskt för kursen. QR = incheckad på banan inom en timme kring tillfället. En missad obligatorisk dag visas, men spärrar ingenting. Klicka på ett datum för att öppna tillfället.</p>';
    }

    // ── Närvaro ──
    function setAttendance(memberId, status) {
        if (!current) return;
        var c = cell(memberId, current.trainingId);
        var already = (status === 'Present' && c.state === 'present') || (status === 'Absent' && c.state === 'absent') || (status === 'Excused' && c.state === 'excused');
        post('/umbraco/surface/ClubEvent/SetAttendance', {
            eventId: current.trainingId, kind: 'Training', memberId: memberId, status: already ? '' : status
        }).then(function (d) {
            if (!d.success) { msg(d.message || 'Närvaron kunde inte sparas.', 'warning'); return; }
            msg('');
            loadCourse(groupId);
        });
    }

    // ── Serier ──
    var shots = [];
    function renderShots() {
        var spans = document.querySelectorAll('#mkShots .sp-shot');
        spans.forEach(function (s, i) { s.textContent = shots[i] || '_'; s.classList.toggle('filled', !!shots[i]); s.classList.toggle('is-next', i === shots.length); });
        document.querySelectorAll('#mkPad [data-shot]').forEach(function (k) { k.disabled = shots.length >= 5; });
        updateSum();
    }
    function mode() { return document.getElementById('mkModeTotal').checked ? 'total' : 'shots'; }
    function seriesType() { return document.getElementById('mkTypeSpeed').checked ? 'Speed' : 'Precision'; }
    function weaponGroup() { return document.getElementById('mkWeaponGroup').value || 'C'; }
    function thresholdsNow() {
        var t = seriesState && seriesState.thresholds[seriesState.memberId];
        return t ? t[weaponGroup()] : null;
    }
    // Växla mellan precision (poäng) och tillämpning (mål + klarad valör).
    function syncSeriesType() {
        var speed = seriesType() === 'Speed';
        document.getElementById('mkSpeedWrap').classList.toggle('d-none', !speed);
        document.getElementById('mkPrecWrap').classList.toggle('d-none', speed);
        var t = thresholdsNow();
        document.getElementById('mkSeriesReq').textContent = (speed ? 'Tillämpning' : 'Precision') + ' · vapengrupp ' + weaponGroup() +
            (!speed && t ? ' · krav brons ' + t.brons + ', silver ' + t.silver + ', guld ' + t.guld : '') +
            (current ? ' · ' + dayLabel(current.date, true) : '');
        document.getElementById('mkGuldNote').textContent = seriesState && !seriesState.canSignOffGuld
            ? 'Brons och silver godkänner du själv. En guldserie godkänns av styrelsen eller skjutledare — den sparas och väntar i klubbens kö.' : '';
        updateSum();
    }
    function currentTotal() {
        if (mode() === 'total') { var v = document.getElementById('mkTotal').value; return v === '' ? null : parseInt(v, 10); }
        if (shots.length !== 5) return null;
        return shots.reduce(function (a, s) { return a + (s === 'X' ? 10 : parseInt(s, 10)); }, 0);
    }
    function valorFor(total, t) {
        if (total == null || !t) return '';
        return total >= t.guld ? 'Guld' : total >= t.silver ? 'Silver' : total >= t.brons ? 'Brons' : 'under brons';
    }
    function updateSum() {
        var can = !!(seriesState && seriesState.canRecord);
        if (seriesType() === 'Speed') {
            var lvl = document.getElementById('mkSpeedLevel').value;
            document.getElementById('mkSeriesSum').textContent = lvl === 'none' ? 'Inte godkänd' : lvl ? 'Klarade ' + lvl.toLowerCase() : '';
            document.getElementById('mkSeriesSave').disabled = !lvl || !can;
            return;
        }
        var total = currentTotal();
        document.getElementById('mkSeriesSum').textContent = total == null ? '' : total + ' p — ' + valorFor(total, thresholdsNow());
        document.getElementById('mkSeriesSave').disabled = total == null || total < 0 || total > 50 || !can;
    }
    var SPEED_TARGETS = { 'C30_25m': '1/6 C30, 25 m', 'B100_50m': 'B100, 50 m' };
    function renderSeriesList() {
        var list = (seriesState.series || []).filter(function (s) { return s.memberId === seriesState.memberId; });
        document.getElementById('mkSeriesList').innerHTML = list.length ? list.map(function (s) {
            var speed = s.seriesType === 'Speed';
            var v = s.valor ? '<span class="badge bg-success-subtle text-success-emphasis">' + esc(s.valor) + '</span>'
                : '<span class="text-muted">' + (speed ? 'inte godkänd' : 'under brons') + '</span>';
            var pend = s.pending ? ' <span class="badge bg-warning-subtle text-warning-emphasis" title="Godkänns av styrelsen eller skjutledare">väntar på godkännande</span>' : '';
            return '<div class="mk-seriesrow"><div>' +
                (speed ? 'Tillämpning ' + s.seriesNumber + ' · ' + esc(SPEED_TARGETS[s.target] || s.target || '') + ' '
                       : 'Serie ' + s.seriesNumber + ' · ' + s.total + ' p ') + v + pend +
                (s.weaponGroup && s.weaponGroup !== 'C' ? ' <span class="text-muted">vapengrupp ' + esc(s.weaponGroup) + '</span>' : '') +
                (speed || s.shotByShot ? '' : ' <span class="text-muted">(bara total)</span>') + '</div>' +
                (seriesState.canRecord ? '<button type="button" class="btn btn-sm btn-link text-danger" data-mk="del-series" data-series="' + s.id + '">Ta bort</button>' : '') + '</div>';
        }).join('') : '<div class="text-muted">Inga serier registrerade på det här tillfället än.</div>';
    }
    function openSeries(memberId) {
        if (!current) return;
        var p = course.participants.find(function (x) { return x.memberId === memberId; });
        getJson('/umbraco/surface/TrainingCourse/Series?groupId=' + groupId + '&trainingId=' + current.trainingId).then(function (d) {
            if (!d.success) { msg(d.message || 'Serierna kunde inte läsas.', 'warning'); return; }
            seriesState = { memberId: memberId, canRecord: d.canRecord, canSignOffGuld: !!d.canSignOffGuld, series: d.series || [], thresholds: d.thresholds || {} };
            document.getElementById('mkSeriesTitle').textContent = p ? p.name : 'Registrera serie';
            var denied = document.getElementById('mkSeriesDenied');
            denied.textContent = d.canRecord ? '' : d.cannotRecordReason;
            denied.classList.toggle('d-none', !!d.canRecord);
            document.getElementById('mkSeriesEntry').classList.toggle('d-none', !d.canRecord);
            // Valen (typ, vapengrupp, mål) står kvar mellan deltagarna — samma tillfälle skjuter ofta samma sak.
            shots = []; document.getElementById('mkTotal').value = ''; document.getElementById('mkSeriesErr').textContent = '';
            document.getElementById('mkSpeedLevel').value = '';
            renderShots(); renderSeriesList(); syncSeriesType();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('mkSeriesModal')).show();
        });
    }
    function saveSeries() {
        var btn = document.getElementById('mkSeriesSave');
        btn.disabled = true;
        var body = { groupId: groupId, trainingId: current.trainingId, memberId: seriesState.memberId,
                     seriesType: seriesType(), weaponGroup: weaponGroup() };
        if (seriesType() === 'Speed') {
            var lvl = document.getElementById('mkSpeedLevel').value;
            body.target = document.getElementById('mkSpeedTarget').value;
            body.claimedLevel = lvl === 'none' ? '' : lvl;
        }
        else if (mode() === 'total') body.total = currentTotal(); else body.shots = shots.slice();
        post('/umbraco/surface/TrainingCourse/RecordSeries', body).then(function (d) {
            if (!d.success) { document.getElementById('mkSeriesErr').textContent = d.message || 'Serien kunde inte sparas.'; updateSum(); return; }
            seriesState.series.push(d.series);
            shots = []; document.getElementById('mkTotal').value = ''; document.getElementById('mkSpeedLevel').value = '';
            document.getElementById('mkSeriesErr').textContent = '';
            renderShots(); renderSeriesList();
            msg(d.message);
        });
    }

    // ── Anteckning ──
    var noteMember = 0;
    function openNote(memberId) {
        if (!current) return;
        noteMember = memberId;
        var p = course.participants.find(function (x) { return x.memberId === memberId; });
        var existing = notes.find(function (n) { return n.memberId === memberId && n.trainingId === current.trainingId; });
        document.getElementById('mkNoteTitle').textContent = 'Anteckning — ' + (p ? p.name : '') + ', ' + dayLabel(current.date);
        document.getElementById('mkNoteText').value = existing ? existing.note : '';
        document.getElementById('mkNoteErr').textContent = '';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkNoteModal')).show();
    }
    function saveNote() {
        post('/umbraco/surface/TrainingCourse/SaveNote', {
            groupId: groupId, trainingId: current.trainingId, memberId: noteMember, note: document.getElementById('mkNoteText').value
        }).then(function (d) {
            if (!d.success) { document.getElementById('mkNoteErr').textContent = d.message || 'Kunde inte spara.'; return; }
            bootstrap.Modal.getInstance(document.getElementById('mkNoteModal')).hide();
            msg(d.message); loadCourse(groupId);
        });
    }

    // ── Koppla träningar ──
    var linkCandidates = [];
    function setLinkDate(id, ymd) {
        var el = document.getElementById(id);
        if (window.flatpickr) { if (!el._flatpickr) flatpickr(el, { locale: 'sv', dateFormat: 'Y-m-d' }); el._flatpickr.setDate(ymd, false); }
        else el.value = ymd;
    }
    // Snabbval: markerar bara rutor — ingenting kopplas förrän "Koppla valda" trycks, så valet går att granska.
    function markLink(pred) {
        var n = 0;
        linkCandidates.forEach(function (t) {
            if (t.linked || t.isCancelled || !pred(t)) return;
            var box = document.getElementById('mkl' + t.id);
            if (box && !box.checked) { box.checked = true; n++; }
        });
        document.getElementById('mkLinkBulkMsg').textContent = n === 0 ? 'Inga fler tillfällen att markera.' : (n === 1 ? 'Ett tillfälle markerades.' : n + ' tillfällen markerades.');
    }
    function renderLinkSchedules() {
        var groups = {};
        linkCandidates.forEach(function (t) {
            if (!t.scheduleId || t.linked || t.isCancelled) return;
            (groups[t.scheduleId] = groups[t.scheduleId] || []).push(t);
        });
        var ids = Object.keys(groups);
        document.getElementById('mkLinkSchedules').innerHTML = ids.map(function (id) {
            var first = groups[id][0];
            var wd = new Date(first.date + 'T12:00:00').toLocaleDateString('sv-SE', { weekday: 'long' });
            return '<button type="button" class="btn btn-sm btn-outline-secondary" data-mk="link-schedule" data-schedule="' + id + '">Hela schemat: ' +
                esc(first.name) + ' (' + esc(wd) + 'ar, ' + groups[id].length + ')</button>';
        }).join('');
    }

    function openLink() {
        document.getElementById('mkLinkBulkMsg').textContent = '';
        getJson('/umbraco/surface/TrainingCourse/Candidates?groupId=' + groupId).then(function (d) {
            var list = (d && d.trainings) || [];
            linkCandidates = list;
            var open = list.filter(function (t) { return !t.linked && !t.isCancelled; });
            document.getElementById('mkLinkBulk').classList.toggle('d-none', open.length < 2);
            if (open.length) {
                setLinkDate('mkLinkFrom', open[0].date);
                setLinkDate('mkLinkTo', open[open.length - 1].date);
                document.getElementById('mkLinkDay').value = String(new Date(open[0].date + 'T12:00:00').getDay());
            }
            renderLinkSchedules();
            document.getElementById('mkLinkList').innerHTML = list.length ? list.map(function (t) {
                return '<div class="form-check"><input class="form-check-input" type="checkbox" id="mkl' + t.id + '" value="' + t.id + '"' +
                    (t.linked ? ' checked disabled' : '') + '><label class="form-check-label" for="mkl' + t.id + '">' +
                    esc(dayLabel(t.date, true)) + (t.startTime ? ' ' + esc(t.startTime) : '') + ' — ' + esc(t.name) +
                    (t.linked ? ' <span class="text-muted small">(kopplad)</span>' : '') + (t.isCancelled ? ' <span class="text-danger small">(inställd)</span>' : '') +
                    '</label></div>';
            }).join('') : '<div class="text-muted">Klubben har inga kommande träningar. Skapa dem under <em>Administration → Träningar</em>.</div>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('mkLinkModal')).show();
        });
    }
    function saveLink() {
        var ids = Array.prototype.slice.call(document.querySelectorAll('#mkLinkList input:checked:not(:disabled)')).map(function (i) { return parseInt(i.value, 10); });
        post('/umbraco/surface/TrainingCourse/Link', { groupId: groupId, trainingIds: ids }).then(function (d) {
            bootstrap.Modal.getInstance(document.getElementById('mkLinkModal')).hide();
            msg(d.message, d.success ? 'success' : 'warning'); loadCourse(groupId);
        });
    }

    // ── Tillfällets krav ──
    var occId = 0;
    function openOcc(trainingId) {
        var o = course.occasions.find(function (x) { return x.trainingId === trainingId; });
        if (!o) return;
        occId = trainingId;
        document.getElementById('mkOccTitle').textContent = 'Tillfället ' + dayLabel(o.date, true) + ' i kursen';
        document.getElementById('mkOccAtt').value = o.attendanceOverride || '';
        document.getElementById('mkOccReg').value = o.registrationOverride || '';
        document.getElementById('mkOccNote').value = o.note || '';
        document.getElementById('mkOccErr').textContent = '';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkOccModal')).show();
    }
    function saveOcc() {
        post('/umbraco/surface/TrainingCourse/SetLink', {
            groupId: groupId, trainingId: occId,
            attendance: document.getElementById('mkOccAtt').value || null,
            registration: document.getElementById('mkOccReg').value || null,
            note: document.getElementById('mkOccNote').value
        }).then(function (d) {
            if (!d.success) { document.getElementById('mkOccErr').textContent = d.message || 'Kunde inte spara.'; return; }
            bootstrap.Modal.getInstance(document.getElementById('mkOccModal')).hide();
            msg(d.message); loadCourse(groupId);
        });
    }
    // Från tillfällets rad under Tillfällen.
    function unlinkOcc(trainingId) {
        var o = course.occasions.find(function (x) { return x.trainingId === trainingId; });
        if (!confirm('Ta bort tillfället ' + (o ? dayLabel(o.date, true) : '') + ' ur kursen? Träningen finns kvar som vanlig klubbträning, och närvaron som redan är registrerad står kvar.')) return;
        post('/umbraco/surface/TrainingCourse/Unlink', { groupId: groupId, trainingId: trainingId }).then(function (d) {
            msg(d.message, d.success ? 'success' : 'warning'); loadCourse(groupId);
        });
    }

    // Kursens standard redigeras direkt under Inställningar — ingen dialog, inget menyval.
    function saveDefaults() {
        post('/umbraco/surface/TrainingCourse/SetDefaults', {
            groupId: groupId, attendance: document.getElementById('mkSetAtt').value, registration: document.getElementById('mkSetReg').value
        }).then(function (d) {
            msg(d.message, d.success ? 'success' : 'warning'); loadCourse(groupId);
        });
    }

    function mandatoryBadges(o) {
        return o.mandatoryForCourse ? '<span class="badge bg-warning text-dark me-1">Obligatoriskt för kursen</span>' : '';
    }

    // ── Kursens deltagare ──
    // Tränaren lägger till och tar bort DELTAGARE. Tränare utses av klubben (servern vägrar annars).
    function postForm(url, fields) {
        var fd = new FormData();
        fd.append('__RequestVerificationToken', token());
        Object.keys(fields).forEach(function (k) { fd.append(k, fields[k]); });
        return fetch(url, { method: 'POST', credentials: 'same-origin', body: fd }).then(function (r) {
            return r.text().then(function (t) { try { return JSON.parse(t); } catch (e) { return { success: false, message: 'Sidan har varit öppen för länge — ladda om och försök igen.' }; } });
        });
    }
    // Samma sökdialog lägger till deltagare (Deltagare → Åtgärder) och instruktörer (Inställningar →
    // Åtgärder). Instruktören får lägga till andra instruktörer, t.ex. en vikarie (Stefan 2026-10-06).
    var memberRole = 'Member';
    function renderMembers() {
        document.getElementById('mkMembersCount').textContent = memberRole === 'Trainer'
            ? 'Kursens instruktörer: ' + (course.trainers.map(function (t) { return t.name; }).join(', ') || 'ingen') +
              '. En instruktör kan bara tas bort av klubbadmin eller skjutledare.'
            : 'Kursen har ' + course.participants.length + ' deltagare.';
    }
    function openMembers(role) {
        memberRole = role === 'Trainer' ? 'Trainer' : 'Member';
        document.getElementById('mkMembersTitle').textContent = memberRole === 'Trainer' ? 'Lägg till instruktör' : 'Lägg till deltagare';
        document.getElementById('mkMemberSearch').value = '';
        document.getElementById('mkMemberHits').innerHTML = '';
        document.getElementById('mkMembersMsg').innerHTML = '';
        renderMembers();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkMembersModal')).show();
    }
    var searchTimer = null, searchSeq = 0;
    function searchMembers() {
        var q = document.getElementById('mkMemberSearch').value.trim();
        var hits = document.getElementById('mkMemberHits');
        clearTimeout(searchTimer);
        if (q.length < 2) { hits.innerHTML = ''; return; }
        searchTimer = setTimeout(function () {
            var seq = ++searchSeq;
            getJson('/umbraco/surface/TrainingGroup/SearchMembers?query=' + encodeURIComponent(q) + '&trainingGroupId=' + groupId).then(function (d) {
                if (seq !== searchSeq) return;
                var inCourse = {};
                course.participants.concat(course.trainers).forEach(function (p) { inCourse[p.memberId] = true; });
                var rows = (d.data || []);
                hits.innerHTML = rows.length ? rows.map(function (m) {
                    var taken = inCourse[m.memberId];
                    return '<button type="button" class="list-group-item list-group-item-action py-1"' + (taken ? ' disabled' : '') +
                        ' data-mk="add-member" data-member="' + m.memberId + '">' + esc(m.memberName) +
                        (taken ? ' <span class="small text-muted">(redan med)</span>' : '') + '</button>';
                }).join('') : '<div class="small text-muted px-1">Ingen medlem i klubben matchar.</div>';
            });
        }, 300);
    }
    function membersMsg(d) {
        document.getElementById('mkMembersMsg').innerHTML = '<div class="alert alert-' + (d.success ? 'success' : 'warning') + ' py-1 small">' + esc(d.message || '') + '</div>';
    }
    function addMember(id) {
        postForm('/umbraco/surface/TrainingGroup/AddTrainingGroupMember', { trainingGroupId: groupId, memberId: id, role: memberRole, sendEmail: 'false' }).then(function (d) {
            membersMsg(d);
            if (!d.success) return;
            document.getElementById('mkMemberSearch').value = '';
            document.getElementById('mkMemberHits').innerHTML = '';
            loadCourse(groupId).then(renderMembers);
        });
    }
    // Ta bort ur kursen görs från deltagarens rad under Deltagare.
    function removeMember(id) {
        var p = course.participants.find(function (x) { return x.memberId === id; });
        if (!confirm('Ta bort ' + (p ? p.name : 'deltagaren') + ' ur kursen? Närvaro och serier som redan registrerats finns kvar.')) return;
        postForm('/umbraco/surface/TrainingGroup/RemoveTrainingGroupMember', { trainingGroupId: groupId, memberId: id }).then(function (d) {
            if (!d.success) { msg(d.message || 'Kunde inte ta bort deltagaren.', 'warning'); return; }
            loadCourse(groupId);
        });
    }

    // ── Lånevapen till tillfället ──
    function openLoan() {
        if (!current) return;
        document.getElementById('mkLoanTitle').textContent = 'Lånevapen · ' + dayLabel(current.date, true) + (current.startTime ? ' ' + current.startTime : '');
        document.getElementById('mkLoanResult').innerHTML = '';
        document.getElementById('mkLoanList').innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>';
        document.getElementById('mkLoanSave').disabled = true;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkLoanModal')).show();
        loadLoan();
    }
    function loadLoan() {
        return getJson('/umbraco/surface/TrainingCourse/LoanWeapons?groupId=' + groupId + '&trainingId=' + current.trainingId).then(function (d) {
            var list = document.getElementById('mkLoanList');
            if (!d.success) { list.innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message || 'Kunde inte läsas.') + '</div>'; return; }
            if (!d.participants.length) { list.innerHTML = '<div class="alert alert-info py-2">Kursen har inga deltagare.</div>'; return; }
            var open = d.participants.filter(function (x) { return !x.booked; }).length;
            list.innerHTML = '<div class="small text-muted mb-2">' + (d.participants.length - open) + ' av ' + d.participants.length + ' har redan ett lånevapen bokat.</div>' +
                d.participants.map(function (x, i) {
                    return '<div class="form-check py-1"><input class="form-check-input" type="checkbox" id="mkLoan' + i + '" data-loan-member="' + x.memberId + '"' +
                        (x.booked ? ' checked disabled' : ' checked') + '>' +
                        '<label class="form-check-label" for="mkLoan' + i + '">' + esc(x.name) +
                        (x.booked ? ' <span class="badge bg-success-subtle text-success-emphasis">lånevapen bokat</span>' : '') + '</label></div>';
                }).join('');
            document.getElementById('mkLoanSave').disabled = open === 0;
        }).catch(function (e) { document.getElementById('mkLoanList').innerHTML = '<div class="alert alert-danger py-2">' + esc(e.message) + '</div>'; });
    }
    function saveLoan() {
        var ids = Array.prototype.slice.call(document.querySelectorAll('[data-loan-member]'))
            .filter(function (c) { return c.checked && !c.disabled; })
            .map(function (c) { return parseInt(c.getAttribute('data-loan-member'), 10); });
        var res = document.getElementById('mkLoanResult');
        if (!ids.length) { res.innerHTML = '<span class="text-danger">Välj minst en deltagare.</span>'; return; }
        var btn = document.getElementById('mkLoanSave');
        btn.disabled = true;
        post('/umbraco/surface/TrainingCourse/AssignLoanWeapons', { groupId: groupId, trainingId: current.trainingId, memberIds: ids }).then(function (d) {
            // Svaret säger per person vad som hände — den som blev utan vapen är den tränaren behöver prata med.
            var failed = (d.results || []).filter(function (r) { return !r.ok; });
            res.innerHTML = '<div class="alert alert-' + (d.success && !failed.length ? 'success' : 'warning') + ' py-2 mb-0">' + esc(d.message || '') +
                (failed.length ? '<ul class="mb-0 mt-1">' + failed.map(function (r) { return '<li>' + esc(r.name) + ': ' + esc(r.message || '') + '</li>'; }).join('') + '</ul>' : '') + '</div>';
            loadLoan();
        });
    }

    document.addEventListener('click', function (e) {
        // Rälsens delar är vanliga länkar (#vy=…): webbläsaren gör en historikpost av klicket, så
        // bakåtknappen går till förra delen, och hashchange-lyssnaren nedan ritar om.
        if (e.target.closest('[data-mk-view]')) return;
        var b = e.target.closest('[data-mk], [data-shot]');
        if (!b) return;
        if (b.hasAttribute('data-shot')) { if (shots.length < 5) { shots.push(b.getAttribute('data-shot')); renderShots(); } return; }
        var act = b.getAttribute('data-mk');
        var member = parseInt(b.getAttribute('data-member'), 10) || 0;
        if (act === 'att') setAttendance(member, b.getAttribute('data-status'));
        else if (act === 'series') openSeries(member);
        else if (act === 'note') openNote(member);
        else if (act === 'clear-shots') { shots = []; renderShots(); }
        else if (act === 'del-series') {
            if (!confirm('Ta bort serien? Den tas bort ur träningsloggen och, om den nådde brons, ur märkesserierna.')) return;
            post('/umbraco/surface/TrainingCourse/DeleteSeries', { groupId: groupId, seriesId: parseInt(b.getAttribute('data-series'), 10) }).then(function (d) {
                if (!d.success) { document.getElementById('mkSeriesErr').textContent = d.message; return; }
                openSeries(seriesState.memberId);
            });
        }
        else if (act === 'link') openLink();
        else if (act === 'link-schedule') { var sid = parseInt(b.getAttribute('data-schedule'), 10); markLink(function (t) { return t.scheduleId === sid; }); }
        else if (act === 'link-day') {
            var wd = parseInt(document.getElementById('mkLinkDay').value, 10);
            var from = document.getElementById('mkLinkFrom').value, to = document.getElementById('mkLinkTo').value;
            markLink(function (t) { return new Date(t.date + 'T12:00:00').getDay() === wd && (!from || t.date >= from) && (!to || t.date <= to); });
        }
        else if (act === 'save-defaults') saveDefaults();
        else if (act === 'loan') openLoan();
        else if (act === 'members') openMembers(b.getAttribute('data-role'));
        else if (act === 'add-member') addMember(member);
        else if (act === 'rm-member') removeMember(member);
        else if (act === 'occ') openOcc(parseInt(b.getAttribute('data-training'), 10));
        else if (act === 'badge-series') openBadgeSeries(member);
        else if (act === 'person') openPerson(member);
        else if (act === 'mail') openMail(member);
        else if (act === 'mail-all' || act === 'mail-none') document.querySelectorAll('#mkMailList input').forEach(function (c) { c.checked = act === 'mail-all'; });
        else if (act === 'unlink-occ') unlinkOcc(parseInt(b.getAttribute('data-training'), 10));
        else if (act === 'goto-occ') gotoOcc(parseInt(b.getAttribute('data-training'), 10));
        else if (act === 'occ-step') stepOcc(parseInt(b.getAttribute('data-dir'), 10));
    });
    document.addEventListener('change', function (e) {
        if (e.target && e.target.id === 'mkShowDone') { showDone = e.target.checked; render(); }
        if (e.target && e.target.id === 'mkOccPick') gotoOcc(parseInt(e.target.value, 10));
    });
    document.querySelectorAll('input[name="mkMode"]').forEach(function (r) {
        r.addEventListener('change', function () {
            var t = mode() === 'total';
            document.getElementById('mkShotsWrap').classList.toggle('d-none', t);
            document.getElementById('mkTotalWrap').classList.toggle('d-none', !t);
            updateSum();
        });
    });
    document.getElementById('mkTotal').addEventListener('input', updateSum);
    document.querySelectorAll('input[name="mkType"]').forEach(function (r) { r.addEventListener('change', syncSeriesType); });
    document.getElementById('mkWeaponGroup').addEventListener('change', syncSeriesType);
    document.getElementById('mkSpeedLevel').addEventListener('change', updateSum);
    document.getElementById('mkSeriesSave').addEventListener('click', saveSeries);
    document.getElementById('mkNoteSave').addEventListener('click', saveNote);
    document.getElementById('mkLinkSave').addEventListener('click', saveLink);
    document.getElementById('mkOccSave').addEventListener('click', saveOcc);
    document.getElementById('mkLoanSave').addEventListener('click', saveLoan);
    document.getElementById('mkMemberSearch').addEventListener('input', searchMembers);
    document.getElementById('mkMailSend').addEventListener('click', sendMail);
    // Bakåtknappen och en inklistrad länk byter också del (#vy=…).
    window.addEventListener('hashchange', function () {
        var m = (location.hash || '').match(/vy=([a-z]+)/);
        var t = (location.hash || '').match(/[&#]t=(\d+)/);
        var occ = t ? parseInt(t[1], 10) : 0;
        if (!m || (m[1] === view && occ === selectedOcc)) return;
        var role = roleOf(groupId);
        if (!viewsFor(role).some(function (x) { return x[0] === m[1]; })) return;
        view = m[1];
        // Rälsens "Upprop" (utan t=) går tillbaka till dagens/nästa tillfälle.
        selectedOcc = occ;
        if (role === 'participant') { if (partView) renderParticipant(partView); }
        else if (course) render();
        window.scrollTo({ top: 0 });
    });
    // Byte av kurs börjar på kursens första del — en annan kurs kan ha en annan roll och andra delar.
    document.getElementById('mkPicker').addEventListener('change', function () { view = null; loadCourse(parseInt(this.value, 10)); });
    // Uppropet uppdaterar listan när serie-dialogen stängs, så märkesläget följer med.
    document.getElementById('mkSeriesModal').addEventListener('hidden.bs.modal', function () { loadCourse(groupId); });

    loadCourses().then(function (id) { if (id) loadCourse(id); });
})();
</script>
