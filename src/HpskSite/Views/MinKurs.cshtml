<!-- Kursens standard -->
<div class="modal fade" id="mkDefModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h2 class="modal-title h5">Kursens standard</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted">Gäller alla kopplade tillfällen som inte har en egen inställning. Kraven gäller bara kursens deltagare. En missad obligatorisk dag visas, men spärrar ingenting.</p>
                <div class="mb-3">
                    <label class="form-label" for="mkDefAtt">Närvaro</label>
                    <select class="form-select" id="mkDefAtt"><option value="Optional">Valfri</option><option value="Mandatory">Obligatorisk</option></select>
                </div>
                <div class="mb-1">
                    <label class="form-label" for="mkDefReg">Anmälan</label>
                    <select class="form-select" id="mkDefReg"><option value="NotRequired">Krävs inte</option><option value="Required">Krävs</option></select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                <button type="button" class="btn btn-primary" id="mkDefSave">Spara</button>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var esc = window.hpskEsc;
    var app = document.getElementById('mkApp');
    var groupId = parseInt(app.getAttribute('data-group'), 10) || 0;
    var course = null, notes = [], current = null, seriesState = null;
    var courses = [];   // MyCourses — bär rollen (trainer / manager / participant) per kurs

    function token() { var el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
    function getJson(url) {
        return fetch(url, { credentials: 'same-origin' }).then(function (r) {
            if (!r.ok) throw new Error(window.hpskRequestFailureMessage ? window.hpskRequestFailureMessage(r.status) : 'Fel ' + r.status);
            return r.json();
        });
    }
    function post(url, body) {
        return fetch(url, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify(body)
        }).then(function (r) { return r.text().then(function (t) { try { return JSON.parse(t); } catch (e) { return { success: false, message: 'Sidan har varit öppen för länge — ladda om och försök igen.' }; } }); });
    }
    function msg(text, kind) {
        document.getElementById('mkMsg').innerHTML = text ? '<div class="alert alert-' + (kind || 'success') + ' py-2">' + esc(text) + '</div>' : '';
    }
    function dayLabel(iso, withWeekday) {
        var d = new Date(iso + 'T12:00:00');
        return d.toLocaleDateString('sv-SE', withWeekday ? { weekday: 'short', day: 'numeric', month: 'short' } : { day: 'numeric', month: 'short' });
    }
    function cell(m, t) { return (course.cells || {})[m + ':' + t] || { state: 'none', missed: false }; }

    // ── Kurserna ──
    function loadCourses() {
        return getJson('/umbraco/surface/TrainingCourse/MyCourses').then(function (d) {
            var list = (d && d.success && d.courses) || [];
            courses = list;
            if (!list.length) {
                // ⚠️ Texten talar till BÅDE den som går en kurs och den som leder en. Den sa förut bara
                // "du är inte tränare", vilket är fel besked till en nybörjare som letar efter sin kurs.
                document.getElementById('mkBody').innerHTML = '<div class="alert alert-info">Du är inte med i någon pågående kurs just nu. ' +
                    'Går du en nybörjarkurs lägger klubben eller din instruktör till dig i kursen — då dyker den upp här.</div>';
                return null;
            }
            var saved = 0;
            try { saved = parseInt(localStorage.getItem('hpsk_minkurs_group'), 10) || 0; } catch (e) { }
            var pick = list.some(function (c) { return c.groupId === groupId; }) ? groupId
                     : list.some(function (c) { return c.groupId === saved; }) ? saved : list[0].groupId;
            // ⚠️ Väljaren listar bara kurser man GÅR eller LEDER. En klubbadmin har rätt att öppna
            // klubbens alla kurser, men de nås från Admin → Träningsgrupper — i väljaren läste de
            // som att en deltagare kunde byta till kurser hen inte är med i (Stefan 2026-10-06).
            // Den öppna kursen står alltid med, även när den nåddes som klubbens kurs.
            var mineList = list.filter(function (c) { return c.role !== 'manager' || c.groupId === pick; });
            var sel = document.getElementById('mkPicker');
            // Kurserna heter ofta likadant ("Nybörjare 2026", "Nybörjare 2027") och kan ligga i olika
            // klubbar — raden säger därför både klubben och om man går eller leder kursen.
            sel.innerHTML = mineList.map(function (c) {
                var role = c.role === 'participant' ? 'du går kursen' : c.role === 'manager' ? 'klubbens kurs' : 'du är instruktör';
                return '<option value="' + c.groupId + '">' + esc(c.name) + ' (' + (c.clubName ? esc(c.clubName) + ', ' : '') + role + ')</option>';
            }).join('');
            sel.value = String(pick);
            document.getElementById('mkPickerWrap').classList.toggle('d-none', mineList.length < 2);
            return pick;
        });
    }

    function roleOf(id) {
        var c = courses.find(function (x) { return x.groupId === id; });
        return c ? c.role : 'trainer';
    }

    // ── Skalet: rälsen (samma form som Ekonomin, Stefan 2026-10-06) ──
    // Vyn står i adressen (#vy=…) så att en omladdning eller ett bokmärke landar där man var.
    var view = null, club = null, partView = null;
    // "Upprop", inte "I dag": vyn visar dagens tillfälle, annars nästa — en rubrik "I dag" över
    // ett tillfälle i april läses som fel.
    var TRAINER_VIEWS = [['idag', 'Upprop'], ['deltagare', 'Deltagare'], ['tillfallen', 'Tillfällen'], ['oversikt', 'Översikt'], ['installningar', 'Inställningar']];
    var PART_VIEWS = [['min', 'Min kurs'], ['tillfallen', 'Tillfällen'], ['serier', 'Mina serier']];
    function viewsFor(role) { return role === 'participant' ? PART_VIEWS : TRAINER_VIEWS; }
    function ensureView(role) {
        var list = viewsFor(role);
        if (view && list.some(function (x) { return x[0] === view; })) return;
        var m = (location.hash || '').match(/vy=([a-z]+)/);
        view = m && list.some(function (x) { return x[0] === m[1]; }) ? m[1] : list[0][0];
    }
    function drawShell(name, counts) {
        var role = roleOf(groupId);
        document.getElementById('mkRailName').textContent = name;
        document.getElementById('mkRailRole').textContent =
            (role === 'participant' ? 'Deltagare' : role === 'manager' ? 'Klubbens kurs' : 'Instruktör') + (club && club.name ? ' · ' + club.name : '');
        // Tillbaka dit man kom ifrån: klubbadmin till Träningsgrupper, instruktören till klubben,
        // deltagaren (som kanske inte ens är medlem i klubben) till startsidan.
        var back = document.getElementById('mkBack');
        back.href = role === 'manager' && club && club.url ? club.url + '#clubAdmin/traininggroups'
                  : role === 'trainer' && club && club.url ? club.url : '/';
        var list = viewsFor(role);
        document.getElementById('mkRailLinks').innerHTML = list.map(function (v) {
            var n = counts && counts[v[0]] != null ? ' <span class="text-muted small">(' + counts[v[0]] + ')</span>' : '';
            return '<a href="#vy=' + v[0] + '" class="mk-nav' + (v[0] === view ? ' on' : '') + '" data-mk-view="' + v[0] + '">' + esc(v[1]) + n + '</a>';
        }).join('');
        var label = list.find(function (x) { return x[0] === view; });
        document.getElementById('mkTitle').textContent = label ? label[1] : 'Min kurs';
    }

    function loadCourse(id) {
        groupId = id;
        try { localStorage.setItem('hpsk_minkurs_group', String(id)); } catch (e) { }
        ensureView(roleOf(id));
        if (roleOf(id) === 'participant') return loadParticipant(id);
        return getJson('/umbraco/surface/TrainingCourse/Get?groupId=' + id).then(function (d) {
            if (!d.success) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kursen kunde inte läsas.') + '</div>'; return; }
            course = d.course; notes = d.notes || []; club = d.club || null;
            document.getElementById('mkActions').classList.remove('d-none');
            render();
        }).catch(function (e) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-danger">' + esc(e.message) + '</div>'; });
    }

    // ── Deltagarens vy (UX-omgången 2026-10-06) ──
    // ⚠️ Bara hens egna rader: servern (TrainingCourse/Mine) skickar inga andra deltagare och inga
    // tränaranteckningar. Tillfällena öppnas i träningspanelen, där anmälan och lånevapen finns.
    function loadParticipant(id) {
        document.getElementById('mkActions').classList.add('d-none');
        document.getElementById('mkOverviewWrap').innerHTML = '';
        return getJson('/umbraco/surface/TrainingCourse/Mine?groupId=' + id).then(function (d) {
            if (!d.success) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-warning">' + esc(d.message || 'Kursen kunde inte läsas.') + '</div>'; return; }
            club = d.club || null; partView = d.course;
            renderParticipant(d.course);
        }).catch(function (e) { document.getElementById('mkBody').innerHTML = '<div class="alert alert-danger">' + esc(e.message) + '</div>'; });
    }

    function myState(o, c) {
        if (o.isCancelled) return '<span class="mk-state text-muted">inställt</span>';
        if (c.missed) return '<span class="mk-state badge bg-danger-subtle text-danger-emphasis">Missad</span>';
        switch (c.state) {
            case 'present': return '<span class="mk-state badge bg-success-subtle text-success-emphasis"><i class="bi bi-check-lg"></i> Var där</span>';
            case 'checkedin': return '<span class="mk-state badge bg-success-subtle text-success-emphasis">Incheckad</span>';
            case 'excused': return '<span class="mk-state badge bg-secondary-subtle text-secondary-emphasis">Giltig frånvaro</span>';
            case 'absent': return '<span class="mk-state badge bg-warning-subtle text-warning-emphasis">Inte där</span>';
            case 'signedup': return '<span class="mk-state badge bg-primary-subtle text-primary-emphasis">Anmäld</span>';
        }
        return o.isPast ? '<span class="mk-state text-muted">–</span>' : '';
    }

    function occTitle(o) { return o.note || o.name; }
    function occWhen(o) { return dayLabel(o.date, true) + (o.startTime ? ' ' + o.startTime + (o.endTime ? '–' + o.endTime : '') : ''); }

    // Gren · plats · skjutledare — det som skiljer tillfällena åt. Utan raden var listan bara datum.
    function occFacts(o) {
        var parts = [];
        if (o.discipline) parts.push('<i class="bi bi-bullseye me-1"></i>' + esc(o.discipline));
        if (o.venue) parts.push('<i class="bi bi-geo-alt me-1"></i>' + esc(o.venue));
        if (o.skjutledareName) parts.push('<i class="bi bi-person-badge me-1"></i>skjutledare ' + esc(o.skjutledareName));
        return parts.join('<span class="mx-1">·</span>');
    }

    function occRow(o, c) {
        var facts = occFacts(o);
        return '<button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-2 mk-occ-row" data-training-panel="' + o.trainingId + '">' +
            '<div class="me-auto text-start" style="min-width:0">' +
            '<div class="small text-muted">' + esc(occWhen(o)) + '</div>' +
            // Märket på EGEN rad: inne i den trunkerade titeln klipptes det bort på telefonen,
            // och då syntes inte att tillfället var obligatoriskt.
            '<div class="text-truncate">' + esc(occTitle(o)) + '</div>' +
            (facts ? '<div class="small text-muted mk-occ-facts">' + facts + '</div>' : '') +
            (o.mandatoryForCourse ? '<span class="badge bg-warning text-dark">★ Obligatoriskt</span>' : '') +
            '</div>' + (c.loanBooked && !o.isPast ? '<span class="mk-state badge bg-info-subtle text-info-emphasis"><i class="bi bi-safe2 me-1"></i>Lånevapen</span>' : '') +
            myState(o, c) + '</button>';
    }

    // ⚠️ Notisinställningen bor i #mkPushHome och lånas in i deltagarvyn. Den måste parkeras FÖRE
    // varje omritning av #mkBody — annars följer den med ut ur DOM:en och är borta vid nästa kursbyte.
    function parkPush() {
        var home = document.getElementById('mkPushHome'), p = document.getElementById('webPushSetup');
        if (home && p && !home.contains(p)) home.appendChild(p);
    }

    function renderParticipant(v) {
        parkPush();
        document.getElementById('mkCourseSub').textContent = v.name + (v.trainers.length ? ' · instruktör' + (v.trainers.length > 1 ? 'er ' : ' ') + v.trainers.join(', ') : '');
        var mine = function (o) { return v.mine[o.trainingId] || { state: 'none', missed: false }; };
        var occ = v.occasions || [];
        var next = occ.find(function (o) { return !o.isCancelled && !o.isPast; });
        drawShell(v.name, { tillfallen: occ.length, serier: (v.badgeSeries || []).length });
        document.getElementById('mkOverviewWrap').innerHTML = '';
        // Tre delar i rälsen: Min kurs (nästa gång, krav, märke, påminnelser), Tillfällen, Mina serier.
        var html = '', occHtml = '', seriesHtml = '';

        if (!occ.length) {
            html += '<div class="alert alert-info">Kursen har inga tillfällen inlagda än. Din instruktör lägger in dem — titta in här igen.</div>';
        }
        if (next) {
            var c = mine(next);
            html += '<div class="card mk-today mb-3"><div class="card-body">' +
                '<div class="small text-uppercase text-muted fw-semibold">' + (next.isToday ? 'I dag' : 'Nästa gång') + ' · ' + esc(occWhen(next)) + '</div>' +
                '<div class="fs-5 fw-semibold">' + esc(occTitle(next)) + '</div>' +
                // Vad det är för träning: gren, plats, skjutledare — och träningens egen beskrivning.
                (occFacts(next) ? '<div class="small text-muted mt-1">' + occFacts(next) + '</div>' : '') +
                (v.trainers.length ? '<div class="small text-muted"><i class="bi bi-people me-1"></i>Instruktör' + (v.trainers.length > 1 ? 'er ' : ' ') + esc(v.trainers.join(', ')) + '</div>' : '') +
                (next.description ? '<div class="small mt-2 mk-occ-desc">' + esc(next.description) + '</div>' : '') +
                '<div class="small mb-2 mt-2">' +
                (next.mandatoryForCourse ? '<span class="badge bg-warning text-dark me-1">★ Obligatoriskt för kursen</span>' : '') + '</div>' +
                (next.registrationRequired && c.state !== 'signedup' && c.state !== 'present'
                    ? '<div class="small mb-2"><i class="bi bi-exclamation-circle me-1"></i>Anmälan krävs till det här tillfället.</div>' : '') +
                '<button type="button" class="btn btn-primary" data-training-panel="' + next.trainingId + '">' +
                (next.registrationRequired && c.state !== 'signedup' ? 'Anmäl dig' : 'Visa tillfället') + '</button>' +
                (c.state === 'signedup' ? ' <span class="badge bg-primary-subtle text-primary-emphasis ms-1">Du är anmäld</span>' : '') +
                (c.loanBooked ? ' <span class="badge bg-info-subtle text-info-emphasis ms-1"><i class="bi bi-safe2 me-1"></i>Lånevapen bokat</span>' : '') +
                '</div></div>';
        } else if (occ.length) {
            html += '<div class="alert alert-light border">Kursen har inga fler tillfällen inlagda.</div>';
        }

        var missed = occ.filter(function (o) { return mine(o).missed; });
        if (missed.length) {
            // Kort, med datumen — vilka tillfällen det gäller står märkta "Missad" under Tidigare tillfällen.
            html += '<div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>Du har missat ' +
                (missed.length === 1 ? 'ett obligatoriskt tillfälle' : missed.length + ' obligatoriska tillfällen') + ' (' +
                missed.map(function (o) { return esc(dayLabel(o.date)); }).join(', ') +
                '). Prata med din instruktör om hur du tar igen det.</div>';
        }

        var b = v.badge || {};
        html += '<div class="card mb-3"><div class="card-body py-2 d-flex align-items-center gap-3">' +
            (badgeImg(b, 64) ? '<div class="flex-shrink-0">' + badgeImg(b, 64) + '</div>' : '') +
            '<div>' +
            '<div class="small text-uppercase text-muted fw-semibold">Mitt märkesläge</div>' +
            '<div class="' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' + esc(b.text || 'Inga godkända serier än.') +
            (b.readyForPistolskyttekort ? ' · klar för Pistolskyttekortet' : '') + '</div>' +
            '<div class="small text-muted">Bronsmärket krävs för Pistolskyttekortet. Din instruktör registrerar serierna på banan.</div>' +
            '</div></div></div>';

        var upcoming = occ.filter(function (o) { return !o.isPast; });
        var past = occ.filter(function (o) { return o.isPast; }).reverse();
        occHtml = !occ.length ? '<div class="text-muted">Kursen har inga tillfällen inlagda än.</div>'
            : '<p class="text-muted small">Tryck på ett tillfälle för att anmäla dig eller boka lånevapen. ★ = obligatoriskt för kursen.</p>' +
              '<h2 class="h6">Kommande</h2>' +
              (upcoming.length
                ? '<div class="list-group mb-3">' + upcoming.map(function (o) { return occRow(o, mine(o)); }).join('') + '</div>'
                : '<div class="text-muted small mb-3">Inga kommande tillfällen.</div>') +
              (past.length ? '<h2 class="h6">Tidigare</h2><div class="list-group mb-3">' + past.map(function (o) { return occRow(o, mine(o)); }).join('') + '</div>' : '');
        function valorBadge(val) {
            return val ? '<span class="badge bg-success-subtle text-success-emphasis">' + esc(val) + '</span>' : '<span class="text-muted small">under brons</span>';
        }
        // ⚠️ Två listor, och den första är den märkesläget räknar: årets godkända serier oavsett var
        // de sköts (kursen, en tävling, inskickade). Förut visades bara kursens serier, så märkesläget
        // kunde säga "Precision 3/3" över en tom lista.
        var bs = v.badgeSeries || [];
        seriesHtml = '<h2 class="h6">Räknas mot märket i år</h2>' +
            '<p class="text-muted small mb-2">Det är de här serierna märkesläget räknar. ' +
            (b.targetLevel ? 'Serier markerade med ✓ når ' + esc(b.targetLevel.toLowerCase()) + ', nästa valör.' : '') + '</p>' +
            (bs.length
                ? '<div class="table-responsive mb-3"><table class="table table-sm mk-badge-series"><thead><tr><th>Dag</th><th>Serie</th><th>Var</th><th class="text-end">Poäng</th><th>Valör</th><th></th></tr></thead><tbody>' +
                    bs.map(function (s) {
                        return '<tr><td class="text-nowrap">' + esc(dayLabel(s.date)) + '</td><td>' + esc(s.kind) + (s.weaponGroup ? ' <span class="text-muted small">' + esc(s.weaponGroup) + '</span>' : '') +
                            '</td><td class="small">' + esc(s.source) + '</td><td class="text-end">' + (s.kind && s.kind.indexOf('tillämpning') >= 0 ? '' : s.total) + '</td><td>' + valorBadge(s.valor) +
                            '</td><td>' + (s.countsTowardTarget ? '<i class="bi bi-check-lg text-success" title="Räknas mot nästa valör"></i>' : '') + '</td></tr>';
                    }).join('') + '</tbody></table></div>'
                : '<div class="text-muted small mb-3">Inga godkända serier i år än.</div>') +
            '<h2 class="h6">Skjutna på kursen</h2>' +
            ((v.series && v.series.length)
                ? '<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Dag</th><th>Tillfälle</th><th class="text-end">Poäng</th><th>Valör</th></tr></thead><tbody>' +
                    v.series.map(function (s) {
                        return '<tr><td class="text-nowrap">' + esc(dayLabel(s.date)) + '</td><td>' + esc(s.occasion) + '</td><td class="text-end">' + s.total + '</td><td>' + valorBadge(s.valor) + '</td></tr>';
                    }).join('') + '</tbody></table></div>'
                : '<div class="text-muted small mb-3">Inga serier registrerade på kursen än. Din instruktör registrerar dem på banan.</div>');

        html += '<div class="card mb-3 mt-3"><div class="card-body py-2">' +
            '<div class="small text-uppercase text-muted fw-semibold mb-1">Håll koll</div>' +
            (upcoming.some(function (o) { return o.startTime && !o.isCancelled; })
                ? '<a class="btn btn-outline-primary btn-sm mb-2" href="/min-kurs/kalender.ics?g=' + v.groupId + '"><i class="bi bi-calendar-plus me-1"></i>Lägg kursens tillfällen i min kalender</a>' +
                  '<div class="small text-muted mb-2">Filen påminner dig dagen innan. Ändras schemat behöver du hämta den igen.</div>'
                : '') +
            '<div id="mkPushSlot"></div>' +
            '</div></div>';

        document.getElementById('mkBody').innerHTML = view === 'tillfallen' ? occHtml : view === 'serier' ? seriesHtml : html;
        // Notisinställningen flyttas in (inte kopieras — den äger fasta id:n och sina lyssnare).
        var push = document.getElementById('webPushSetup');
        var slot = document.getElementById('mkPushSlot');
        if (push && slot) {
            slot.appendChild(push);
            var label = document.createElement('div');
            label.className = 'small text-muted mt-1';
            label.textContent = 'Med notiser påslagna och "Påminnelser" ikryssat får du ett meddelande dagen innan varje tillfälle.';
            slot.appendChild(label);
        }
    }

    // Dagens tillfälle, annars nästa, annars det senaste.
    function pickCurrent() {
        var occ = course.occasions.filter(function (o) { return !o.isCancelled; });
        return occ.find(function (o) { return o.isToday; })
            || occ.find(function (o) { return !o.isPast; })
            || occ[occ.length - 1] || null;
    }

    function render() {
        parkPush();
        var sub = course.name + (course.trainers.length ? ' · instruktörer ' + course.trainers.map(function (t) { return t.name; }).join(', ') : '');
        document.getElementById('mkCourseSub').textContent = sub;
        current = pickCurrent();
        // Lånevapen bokas för dagens eller ett kommande tillfälle — aldrig i efterhand.
        document.getElementById('mkLoanItem').classList.toggle('d-none', !current || current.isPast);
        var html = '';

        if (!course.occasions.length) {
            html += '<div class="alert alert-info">Inga träningar är kopplade till kursen än. Välj <strong>Åtgärder → Koppla träningar till kursen…</strong>.</div>';
        } else if (current) {
            var here = course.participants.filter(function (p) { var s = cell(p.memberId, current.trainingId).state; return s === 'present' || s === 'checkedin'; }).length;
            var when = (current.isToday ? 'I dag' : current.isPast ? 'Senast' : 'Nästa') + ' · ' + dayLabel(current.date, true) + (current.startTime ? ' ' + current.startTime : '');
            html += '<div class="card mk-today mb-3"><div class="card-body py-2">' +
                '<div class="small text-uppercase text-muted fw-semibold">' + esc(when) + '</div>' +
                '<div class="fw-semibold">' + esc(current.note || current.name) + '</div>' +
                '<div class="small text-muted">' + mandatoryBadges(current) +
                here + ' av ' + course.participants.length + ' här' +
                (current.skjutledareName ? ' · skjutledare ' + esc(current.skjutledareName) : '') + '</div>' +
                '</div></div>';

            // Från förra tillfället: anteckningar från tillfällen FÖRE det aktuella.
            var prevIds = course.occasions.filter(function (o) { return o.date < current.date; }).map(function (o) { return o.trainingId; });
            var handover = notes.filter(function (n) { return prevIds.indexOf(n.trainingId) >= 0; });
            var seen = {};
            handover = handover.filter(function (n) { if (seen[n.memberId]) return false; seen[n.memberId] = true; return true; });
            if (handover.length) {
                html += '<div class="alert alert-light border mb-3"><div class="small fw-semibold mb-1"><i class="bi bi-chat-left-text me-1"></i>Från tidigare tillfällen</div>' +
                    handover.map(function (n) {
                        var p = course.participants.find(function (x) { return x.memberId === n.memberId; });
                        return '<div class="small"><strong>' + esc(p ? p.name : '') + ':</strong> ' + esc(n.note) +
                            ' <span class="text-muted">(' + esc(n.authorName) + ', ' + esc(dayLabel(n.date)) + ')</span></div>';
                    }).join('') + '</div>';
            }

            if (!course.participants.length) html += '<div class="alert alert-info">Kursen har inga deltagare än.</div>';
            course.participants.forEach(function (p) { html += personCard(p); });
        }
        // Lyft ur Åtgärder-menyn: att lägga till en nybörjare som dyker upp är vardag för tränaren,
        // och en åtgärd bakom en meny hittar August inte.
        html += '<button type="button" class="btn btn-outline-primary btn-sm mt-1 mb-3" data-mk="members"><i class="bi bi-person-plus me-1"></i>Lägg till eller ta bort deltagare</button>';

        drawShell(course.name, { deltagare: course.participants.length, tillfallen: course.occasions.length });
        var ov = '';
        if (view === 'deltagare') html = participantsView();
        else if (view === 'tillfallen') html = occasionsView();
        else if (view === 'oversikt') { html = ''; ov = overview(); }
        else if (view === 'installningar') html = settingsView();
        document.getElementById('mkBody').innerHTML = html;
        document.getElementById('mkOverviewWrap').innerHTML = ov;
        if (ov) afterOverview();
    }

    function trainerNames() { return course.trainers.map(function (t) { return t.name; }).join(', '); }

    // Pistolskyttemärket i den valör deltagaren HÅLLER (verifierat märke, heldLevel). Ingen bild
    // före bronsmärket — bilden visar vad hen har tagit, inte vad hen siktar på.
    var BADGE_IMG = { Brons: 'PistolskytteB.png', Silver: 'PistolskytteS.png', Guld: 'Pistolskytte.png' };
    function badgeImg(b, size) {
        var f = b && BADGE_IMG[b.heldLevel];
        if (!f) return '';
        var t = 'Pistolskyttemärket i ' + b.heldLevel.toLowerCase() + ' — klar för Pistolskyttekortet';
        return '<img src="/images/marken/' + f + '" alt="' + esc(t) + '" title="' + esc(t) + '" class="mk-badge-img" ' +
            'style="height:' + size + 'px;width:auto" onerror="this.remove()">';
    }

    // Deltagare: en rad per deltagare med närvaro, missade obligatoriska och märkesläget.
    function participantsView() {
        var held = course.occasions.filter(function (o) { return !o.isCancelled && (o.isPast || o.isToday); });
        var h = '<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">' +
            '<span class="text-muted small">' + course.participants.length + ' deltagare · ' +
            (course.trainers.length ? 'instruktör' + (course.trainers.length > 1 ? 'er ' : ' ') + esc(trainerNames()) : 'ingen instruktör utsedd') + '</span>' +
            '<button type="button" class="btn btn-sm btn-outline-primary" data-mk="members"><i class="bi bi-person-plus me-1"></i>Lägg till eller ta bort deltagare</button></div>';
        if (!course.participants.length) return h + '<div class="alert alert-info">Kursen har inga deltagare än.</div>';
        h += '<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Namn</th><th class="text-center">Närvaro</th><th>Missade obligatoriska</th><th>Märkesläge</th></tr></thead><tbody>';
        course.participants.forEach(function (p) {
            var here = held.filter(function (o) { var s = cell(p.memberId, o.trainingId).state; return s === 'present' || s === 'checkedin'; }).length;
            var missed = course.occasions.filter(function (o) { return cell(p.memberId, o.trainingId).missed; });
            var b = (course.badges || {})[p.memberId] || {};
            h += '<tr><td class="fw-semibold text-nowrap">' + badgeImg(b, 28) + (badgeImg(b, 28) ? ' ' : '') + esc(p.name) + '</td>' +
                '<td class="text-center text-nowrap">' + here + ' av ' + held.length + '</td>' +
                '<td>' + (missed.length ? '<span class="mk-missed">' + missed.map(function (o) { return esc(dayLabel(o.date)); }).join(', ') + '</span>' : '<span class="text-muted">–</span>') + '</td>' +
                '<td class="small ' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' + esc(b.text || '') + (b.readyForPistolskyttekort ? ' · klar för Pistolskyttekortet' : '') + '</td></tr>';
        });
        return h + '</tbody></table></div>';
    }

    // Tillfällen: kursens kopplade träningar med kursens krav och hur många som var där.
    function occasionsView() {
        var h = '<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">' +
            '<span class="text-muted small">★ = obligatoriskt för kursen. Ändra ett tillfälles krav och namn med <em>Ändra</em>.</span>' +
            '<button type="button" class="btn btn-sm btn-outline-primary" data-mk="link"><i class="bi bi-link-45deg me-1"></i>Koppla träningar till kursen…</button></div>';
        if (!course.occasions.length) return h + '<div class="alert alert-info">Inga träningar är kopplade till kursen än.</div>';
        h += '<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Datum</th><th>Tid</th><th>Tillfälle</th><th>Krav</th><th class="text-center">Var där</th><th></th></tr></thead><tbody>';
        course.occasions.forEach(function (o) {
            var here = course.participants.filter(function (p) { var s = cell(p.memberId, o.trainingId).state; return s === 'present' || s === 'checkedin'; }).length;
            var req = (o.mandatoryForCourse ? '<span class="badge bg-warning text-dark me-1">★ Obligatoriskt</span>' : '') +
                (o.registrationRequired ? '<span class="badge bg-secondary-subtle text-secondary-emphasis">Anmälan krävs</span>' : '');
            h += '<tr' + (o.isPast || o.isCancelled ? ' class="text-muted"' : '') + '>' +
                '<td class="text-nowrap">' + esc(dayLabel(o.date, true)) + (o.isToday ? ' <span class="badge bg-success">I dag</span>' : '') + '</td>' +
                '<td class="text-nowrap">' + esc(o.startTime || '') + '</td>' +
                '<td>' + esc(o.note || o.name) + (o.note ? '<div class="small text-muted">' + esc(o.name) + '</div>' : '') +
                (o.isCancelled ? ' <span class="badge bg-danger">Inställd</span>' : '') + '</td>' +
                '<td>' + (req || '<span class="text-muted">–</span>') + '</td>' +
                '<td class="text-center">' + (o.isPast || o.isToday ? here + ' av ' + course.participants.length : '–') + '</td>' +
                '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-secondary" data-mk="occ" data-training="' + o.trainingId + '">Ändra</button></td></tr>';
        });
        return h + '</tbody></table></div>';
    }

    // Inställningar: kursens standardkrav och vem som leder kursen.
    function settingsView() {
        var att = course.defaultAttendance === 'Mandatory' ? 'Obligatorisk' : 'Valfri';
        var reg = course.defaultRegistration === 'Required' ? 'Krävs' : 'Krävs inte';
        return '<div class="card mb-3"><div class="card-body">' +
            '<div class="d-flex justify-content-between align-items-start flex-wrap gap-2">' +
            '<div><h2 class="h6 mb-1">Kursens standard</h2>' +
            '<div>Närvaro: <strong>' + att + '</strong> · Anmälan: <strong>' + reg + '</strong></div>' +
            '<div class="small text-muted">Gäller alla kopplade tillfällen som inte har en egen inställning, och bara kursens deltagare.</div></div>' +
            '<button type="button" class="btn btn-sm btn-outline-primary" data-mk="defaults">Ändra…</button></div></div></div>' +
            '<div class="card mb-3"><div class="card-body">' +
            '<h2 class="h6 mb-1">Instruktörer</h2>' +
            '<div>' + (course.trainers.length ? esc(trainerNames()) : '<span class="text-muted">Ingen utsedd</span>') + '</div>' +
            '<div class="small text-muted">Instruktörer utses av klubben (klubbadmin eller skjutledare) under Admin → Träningsgrupper.</div>' +
            '</div></div>';
    }

    // Översikten rullar i sidled när tillfällena inte får plats. Utan ett synligt tecken ser den
    // avklippt ut ("8 o…"), så: en rad som säger det, och tabellen rullas så att det aktuella
    // tillfället syns. ⚠️ Avståndet mäts med getBoundingClientRect, inte offsetLeft (som räknas mot
    // offsetParent och inte mot rullningsytan).
    function afterOverview() {
        var box = document.getElementById('mkOverviewScroll');
        var hint = document.getElementById('mkScrollHint');
        if (!box || !hint) return;
        var overflow = box.scrollWidth > box.clientWidth + 2;
        hint.classList.toggle('d-none', !overflow);
        if (!overflow || !current) return;
        var th = box.querySelector('th[data-occ="' + current.trainingId + '"]');
        var first = box.querySelector('thead th');
        if (!th || !first) return;
        var delta = th.getBoundingClientRect().left - box.getBoundingClientRect().left - first.getBoundingClientRect().width - 8;
        if (delta > 0) box.scrollLeft += delta;
    }

    function personCard(p) {
        var c = cell(p.memberId, current.trainingId);
        var b = (course.badges || {})[p.memberId] || {};
        var missed = course.occasions.filter(function (o) { return cell(p.memberId, o.trainingId).missed; });
        var btn = function (status, label, active) {
            return '<button type="button" class="btn btn-sm ' + (active ? 'btn-success' : 'btn-outline-secondary') + '" data-mk="att" data-member="' + p.memberId + '" data-status="' + status + '">' + label + '</button>';
        };
        var isHere = c.state === 'present', isAbsent = c.state === 'absent', isExcused = c.state === 'excused';
        // Två rader i stället för tre (UX-omgången 2026-10-06): namn + närvaro överst, märkesläget och
        // serie/anteckning under. Elva deltagare gav en 3 000 px lång sida på telefonen.
        return '<div class="mk-person" data-mk-person="' + p.memberId + '">' +
            '<div class="d-flex align-items-center gap-2">' +
            '<div class="mk-name me-auto text-truncate">' + badgeImg(b, 24) + (badgeImg(b, 24) ? ' ' : '') + esc(p.name) +
            (c.state === 'checkedin' ? ' <span class="badge bg-info-subtle text-info-emphasis fw-normal">QR</span>' : '') + '</div>' +
            '<div class="btn-group mk-att flex-shrink-0" role="group" aria-label="Närvaro">' +
            btn('Present', 'Här', isHere) + btn('Absent', 'Ej här', isAbsent) + btn('Excused', 'Giltig', isExcused) +
            '</div></div>' +
            // Knapparna står ihop till höger (flex-shrink-0) och texten bryter i sin egen kolumn —
            // med flex-wrap hamnade "Anteckning" ensam på en tredje rad på telefonen.
            '<div class="d-flex align-items-start gap-1 mt-1">' +
            '<div class="mk-sub flex-grow-1 small">' +
            // Med märkesbilden bredvid namnet är "Bronsmärket klart · " en upprepning som gjorde raden
            // en rad högre på telefonen — bilden säger det redan.
            '<span class="mk-badge ' + (b.readyForPistolskyttekort ? 'mk-ready' : '') + '">' +
            // Likaså "klar för Pistolskyttekortet": det är exakt samma sak som att hålla bronsmärket,
            // så med bilden står det i bildens titel i stället.
            esc(badgeImg(b, 24) ? (b.text || '').replace(/^(Brons|Silver)märket klart · /, '') : (b.text || '')) +
            (b.readyForPistolskyttekort && !badgeImg(b, 24) ? ' · klar för Pistolskyttekortet' : '') + '</span>' +
            // Fler än två datum gör raden hög — då ett antal, och datumen i titeln (och i översikten).
            (missed.length ? '<span class="mk-missed" title="' + esc(missed.map(function (o) { return dayLabel(o.date); }).join(', ')) + '"> · <i class="bi bi-exclamation-triangle-fill"></i> missade ' +
                (missed.length <= 2 ? missed.map(function (o) { return esc(dayLabel(o.date)); }).join(', ') : missed.length + ' obligatoriska') + '</span>' : '') +
            '</div>' +
            '<div class="d-flex flex-shrink-0">' +
            '<button type="button" class="btn btn-sm btn-link px-1 py-0" data-mk="series" data-member="' + p.memberId + '"><i class="bi bi-bullseye me-1"></i>Serie</button>' +
            '<button type="button" class="btn btn-sm btn-link px-1 py-0" data-mk="note" data-member="' + p.memberId + '"><i class="bi bi-pencil me-1"></i>Anteckning</button>' +
            '</div></div></div>';
    }

    function overview() {
        if (!course.occasions.length) return '';
        var head = course.occasions.map(function (o) {
            var label = o.note || o.name;
            return '<th data-occ="' + o.trainingId + '"><button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" data-mk="occ" data-training="' + o.trainingId + '" title="' + esc(label) + ' — klicka för tillfällets krav">' +
                esc(dayLabel(o.date)) + (o.mandatoryForCourse ? ' ★' : '') +
                '<span class="mk-occname">' + esc(label) + '</span></button>' +
                (o.isCancelled ? '<div class="small text-danger">inställd</div>' : '') + '</th>';
        }).join('');
        var rows = course.participants.map(function (p) {
            var tds = course.occasions.map(function (o) {
                var c = cell(p.memberId, o.trainingId);
                if (o.isCancelled) return '<td class="text-muted">–</td>';
                if (c.missed) return '<td class="mk-cell-missed">Missad</td>';
                var text = { present: '✓', checkedin: 'QR', excused: 'Giltig', absent: '✗', signedup: o.isPast ? '?' : 'Anmäld', none: o.isPast ? '' : '–' }[c.state] || '';
                return '<td>' + text + '</td>';
            }).join('');
            var b = (course.badges || {})[p.memberId] || {};
            return '<tr><td>' + esc(p.name) + '</td>' + tds + '<td class="mk-badgecell small">' + esc(b.text || '') + '</td></tr>';
        }).join('');
        return '<h2 class="h5 mt-2" id="mkOverview">Kursöversikt — alla tillfällen</h2>' +
            '<div class="small text-muted mb-1 d-none" id="mkScrollHint"><i class="bi bi-arrow-left-right me-1"></i>Rulla tabellen i sidled för fler tillfällen.</div>' +
            '<div class="table-responsive" id="mkOverviewScroll"><table class="table table-sm mk-grid"><thead><tr><th>Deltagare</th>' + head + '<th>Märkesläge</th></tr></thead><tbody>' +
            rows + '</tbody></table></div>' +
            '<p class="small text-muted">★ = obligatoriskt för kursen. QR = incheckad på banan inom en timme kring tillfället. En missad obligatorisk dag visas, men spärrar ingenting. Klicka på ett tillfälle för att ändra kursens krav och namn.</p>';
    }

    // ── Närvaro ──
    function setAttendance(memberId, status) {
        if (!current) return;
        var c = cell(memberId, current.trainingId);
        var already = (status === 'Present' && c.state === 'present') || (status === 'Absent' && c.state === 'absent') || (status === 'Excused' && c.state === 'excused');
        post('/umbraco/surface/ClubEvent/SetAttendance', {
            eventId: current.trainingId, kind: 'Training', memberId: memberId, status: already ? '' : status
        }).then(function (d) {
            if (!d.success) { msg(d.message || 'Närvaron kunde inte sparas.', 'warning'); return; }
            msg('');
            loadCourse(groupId);
        });
    }

    // ── Serier ──
    var shots = [];
    function renderShots() {
        var spans = document.querySelectorAll('#mkShots .sp-shot');
        spans.forEach(function (s, i) { s.textContent = shots[i] || '_'; s.classList.toggle('filled', !!shots[i]); s.classList.toggle('is-next', i === shots.length); });
        document.querySelectorAll('#mkPad [data-shot]').forEach(function (k) { k.disabled = shots.length >= 5; });
        updateSum();
    }
    function mode() { return document.getElementById('mkModeTotal').checked ? 'total' : 'shots'; }
    function currentTotal() {
        if (mode() === 'total') { var v = document.getElementById('mkTotal').value; return v === '' ? null : parseInt(v, 10); }
        if (shots.length !== 5) return null;
        return shots.reduce(function (a, s) { return a + (s === 'X' ? 10 : parseInt(s, 10)); }, 0);
    }
    function valorFor(total, t) {
        if (total == null || !t) return '';
        return total >= t.guld ? 'Guld' : total >= t.silver ? 'Silver' : total >= t.brons ? 'Brons' : 'under brons';
    }
    function updateSum() {
        var total = currentTotal();
        var t = seriesState && seriesState.thresholds[seriesState.memberId];
        document.getElementById('mkSeriesSum').textContent = total == null ? '' : total + ' p — ' + valorFor(total, t);
        document.getElementById('mkSeriesSave').disabled = total == null || total < 0 || total > 50 || !(seriesState && seriesState.canRecord);
    }
    function renderSeriesList() {
        var list = (seriesState.series || []).filter(function (s) { return s.memberId === seriesState.memberId; });
        document.getElementById('mkSeriesList').innerHTML = list.length ? list.map(function (s) {
            var v = s.valor ? '<span class="badge bg-success-subtle text-success-emphasis">' + esc(s.valor) + '</span>' : '<span class="text-muted">under brons</span>';
            return '<div class="mk-seriesrow"><div>Serie ' + s.seriesNumber + ' · ' + s.total + ' p ' + v +
                (s.shotByShot ? '' : ' <span class="text-muted">(bara total)</span>') + '</div>' +
                (seriesState.canRecord ? '<button type="button" class="btn btn-sm btn-link text-danger" data-mk="del-series" data-series="' + s.id + '">Ta bort</button>' : '') + '</div>';
        }).join('') : '<div class="text-muted">Inga serier registrerade på det här tillfället än.</div>';
    }
    function openSeries(memberId) {
        if (!current) return;
        var p = course.participants.find(function (x) { return x.memberId === memberId; });
        getJson('/umbraco/surface/TrainingCourse/Series?groupId=' + groupId + '&trainingId=' + current.trainingId).then(function (d) {
            if (!d.success) { msg(d.message || 'Serierna kunde inte läsas.', 'warning'); return; }
            seriesState = { memberId: memberId, canRecord: d.canRecord, series: d.series || [], thresholds: d.thresholds || {} };
            var t = seriesState.thresholds[memberId];
            document.getElementById('mkSeriesTitle').textContent = p ? p.name : 'Registrera serie';
            document.getElementById('mkSeriesReq').textContent = 'Precision · vapengrupp C (.22)' +
                (t ? ' · krav brons ' + t.brons + ', silver ' + t.silver + ', guld ' + t.guld : '') + ' · ' + dayLabel(current.date, true);
            var denied = document.getElementById('mkSeriesDenied');
            denied.textContent = d.canRecord ? '' : d.cannotRecordReason;
            denied.classList.toggle('d-none', !!d.canRecord);
            document.getElementById('mkSeriesEntry').classList.toggle('d-none', !d.canRecord);
            shots = []; document.getElementById('mkTotal').value = ''; document.getElementById('mkSeriesErr').textContent = '';
            renderShots(); renderSeriesList();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('mkSeriesModal')).show();
        });
    }
    function saveSeries() {
        var btn = document.getElementById('mkSeriesSave');
        btn.disabled = true;
        var body = { groupId: groupId, trainingId: current.trainingId, memberId: seriesState.memberId };
        if (mode() === 'total') body.total = currentTotal(); else body.shots = shots.slice();
        post('/umbraco/surface/TrainingCourse/RecordSeries', body).then(function (d) {
            if (!d.success) { document.getElementById('mkSeriesErr').textContent = d.message || 'Serien kunde inte sparas.'; updateSum(); return; }
            seriesState.series.push(d.series);
            shots = []; document.getElementById('mkTotal').value = '';
            document.getElementById('mkSeriesErr').textContent = '';
            renderShots(); renderSeriesList();
            msg(d.message);
        });
    }

    // ── Anteckning ──
    var noteMember = 0;
    function openNote(memberId) {
        if (!current) return;
        noteMember = memberId;
        var p = course.participants.find(function (x) { return x.memberId === memberId; });
        var existing = notes.find(function (n) { return n.memberId === memberId && n.trainingId === current.trainingId; });
        document.getElementById('mkNoteTitle').textContent = 'Anteckning — ' + (p ? p.name : '') + ', ' + dayLabel(current.date);
        document.getElementById('mkNoteText').value = existing ? existing.note : '';
        document.getElementById('mkNoteErr').textContent = '';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkNoteModal')).show();
    }
    function saveNote() {
        post('/umbraco/surface/TrainingCourse/SaveNote', {
            groupId: groupId, trainingId: current.trainingId, memberId: noteMember, note: document.getElementById('mkNoteText').value
        }).then(function (d) {
            if (!d.success) { document.getElementById('mkNoteErr').textContent = d.message || 'Kunde inte spara.'; return; }
            bootstrap.Modal.getInstance(document.getElementById('mkNoteModal')).hide();
            msg(d.message); loadCourse(groupId);
        });
    }

    // ── Koppla träningar ──
    var linkCandidates = [];
    function setLinkDate(id, ymd) {
        var el = document.getElementById(id);
        if (window.flatpickr) { if (!el._flatpickr) flatpickr(el, { locale: 'sv', dateFormat: 'Y-m-d' }); el._flatpickr.setDate(ymd, false); }
        else el.value = ymd;
    }
    // Snabbval: markerar bara rutor — ingenting kopplas förrän "Koppla valda" trycks, så valet går att granska.
    function markLink(pred) {
        var n = 0;
        linkCandidates.forEach(function (t) {
            if (t.linked || t.isCancelled || !pred(t)) return;
            var box = document.getElementById('mkl' + t.id);
            if (box && !box.checked) { box.checked = true; n++; }
        });
        document.getElementById('mkLinkBulkMsg').textContent = n === 0 ? 'Inga fler tillfällen att markera.' : (n === 1 ? 'Ett tillfälle markerades.' : n + ' tillfällen markerades.');
    }
    function renderLinkSchedules() {
        var groups = {};
        linkCandidates.forEach(function (t) {
            if (!t.scheduleId || t.linked || t.isCancelled) return;
            (groups[t.scheduleId] = groups[t.scheduleId] || []).push(t);
        });
        var ids = Object.keys(groups);
        document.getElementById('mkLinkSchedules').innerHTML = ids.map(function (id) {
            var first = groups[id][0];
            var wd = new Date(first.date + 'T12:00:00').toLocaleDateString('sv-SE', { weekday: 'long' });
            return '<button type="button" class="btn btn-sm btn-outline-secondary" data-mk="link-schedule" data-schedule="' + id + '">Hela schemat: ' +
                esc(first.name) + ' (' + esc(wd) + 'ar, ' + groups[id].length + ')</button>';
        }).join('');
    }

    function openLink() {
        document.getElementById('mkLinkBulkMsg').textContent = '';
        getJson('/umbraco/surface/TrainingCourse/Candidates?groupId=' + groupId).then(function (d) {
            var list = (d && d.trainings) || [];
            linkCandidates = list;
            var open = list.filter(function (t) { return !t.linked && !t.isCancelled; });
            document.getElementById('mkLinkBulk').classList.toggle('d-none', open.length < 2);
            if (open.length) {
                setLinkDate('mkLinkFrom', open[0].date);
                setLinkDate('mkLinkTo', open[open.length - 1].date);
                document.getElementById('mkLinkDay').value = String(new Date(open[0].date + 'T12:00:00').getDay());
            }
            renderLinkSchedules();
            document.getElementById('mkLinkList').innerHTML = list.length ? list.map(function (t) {
                return '<div class="form-check"><input class="form-check-input" type="checkbox" id="mkl' + t.id + '" value="' + t.id + '"' +
                    (t.linked ? ' checked disabled' : '') + '><label class="form-check-label" for="mkl' + t.id + '">' +
                    esc(dayLabel(t.date, true)) + (t.startTime ? ' ' + esc(t.startTime) : '') + ' — ' + esc(t.name) +
                    (t.linked ? ' <span class="text-muted small">(kopplad)</span>' : '') + (t.isCancelled ? ' <span class="text-danger small">(inställd)</span>' : '') +
                    '</label></div>';
            }).join('') : '<div class="text-muted">Klubben har inga kommande träningar. Skapa dem under <em>Administration → Träningar</em>.</div>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById('mkLinkModal')).show();
        });
    }
    function saveLink() {
        var ids = Array.prototype.slice.call(document.querySelectorAll('#mkLinkList input:checked:not(:disabled)')).map(function (i) { return parseInt(i.value, 10); });
        post('/umbraco/surface/TrainingCourse/Link', { groupId: groupId, trainingIds: ids }).then(function (d) {
            bootstrap.Modal.getInstance(document.getElementById('mkLinkModal')).hide();
            msg(d.message, d.success ? 'success' : 'warning'); loadCourse(groupId);
        });
    }

    // ── Tillfällets krav ──
    var occId = 0;
    function openOcc(trainingId) {
        var o = course.occasions.find(function (x) { return x.trainingId === trainingId; });
        if (!o) return;
        occId = trainingId;
        document.getElementById('mkOccTitle').textContent = o.name + ', ' + dayLabel(o.date, true);
        document.getElementById('mkOccAtt').value = o.attendanceOverride || '';
        document.getElementById('mkOccReg').value = o.registrationOverride || '';
        document.getElementById('mkOccNote').value = o.note || '';
        document.getElementById('mkOccErr').textContent = '';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkOccModal')).show();
    }
    function saveOcc() {
        post('/umbraco/surface/TrainingCourse/SetLink', {
            groupId: groupId, trainingId: occId,
            attendance: document.getElementById('mkOccAtt').value || null,
            registration: document.getElementById('mkOccReg').value || null,
            note: document.getElementById('mkOccNote').value
        }).then(function (d) {
            if (!d.success) { document.getElementById('mkOccErr').textContent = d.message || 'Kunde inte spara.'; return; }
            bootstrap.Modal.getInstance(document.getElementById('mkOccModal')).hide();
            msg(d.message); loadCourse(groupId);
        });
    }
    function unlinkOcc() {
        if (!confirm('Ta bort tillfället från kursen? Träningen finns kvar som vanlig klubbträning, och närvaron som redan är registrerad står kvar.')) return;
        post('/umbraco/surface/TrainingCourse/Unlink', { groupId: groupId, trainingId: occId }).then(function (d) {
            bootstrap.Modal.getInstance(document.getElementById('mkOccModal')).hide();
            msg(d.message, d.success ? 'success' : 'warning'); loadCourse(groupId);
        });
    }

    function openDefaults() {
        document.getElementById('mkDefAtt').value = course.defaultAttendance || 'Optional';
        document.getElementById('mkDefReg').value = course.defaultRegistration || 'NotRequired';
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkDefModal')).show();
    }
    function saveDefaults() {
        post('/umbraco/surface/TrainingCourse/SetDefaults', {
            groupId: groupId, attendance: document.getElementById('mkDefAtt').value, registration: document.getElementById('mkDefReg').value
        }).then(function (d) {
            bootstrap.Modal.getInstance(document.getElementById('mkDefModal')).hide();
            msg(d.message, d.success ? 'success' : 'warning'); loadCourse(groupId);
        });
    }

    function mandatoryBadges(o) {
        return o.mandatoryForCourse ? '<span class="badge bg-warning text-dark me-1">Obligatoriskt för kursen</span>' : '';
    }

    // ── Kursens deltagare ──
    // Tränaren lägger till och tar bort DELTAGARE. Tränare utses av klubben (servern vägrar annars).
    function postForm(url, fields) {
        var fd = new FormData();
        fd.append('__RequestVerificationToken', token());
        Object.keys(fields).forEach(function (k) { fd.append(k, fields[k]); });
        return fetch(url, { method: 'POST', credentials: 'same-origin', body: fd }).then(function (r) {
            return r.text().then(function (t) { try { return JSON.parse(t); } catch (e) { return { success: false, message: 'Sidan har varit öppen för länge — ladda om och försök igen.' }; } });
        });
    }
    function renderMembers() {
        var list = course.participants;
        document.getElementById('mkMembersCount').textContent = 'Deltagare (' + list.length + ')';
        document.getElementById('mkMembersList').innerHTML = list.length ? list.map(function (p) {
            return '<div class="d-flex align-items-center border-bottom py-1"><span class="me-auto">' + esc(p.name) + '</span>' +
                '<button type="button" class="btn btn-sm btn-outline-danger" data-mk="rm-member" data-member="' + p.memberId + '">Ta bort</button></div>';
        }).join('') : '<div class="text-muted small">Inga deltagare än.</div>';
        document.getElementById('mkTrainersLine').textContent = course.trainers.length
            ? 'Instruktör' + (course.trainers.length > 1 ? 'er' : '') + ': ' + course.trainers.map(function (t) { return t.name; }).join(', ') + ' (utses av klubben)' : '';
    }
    function openMembers() {
        document.getElementById('mkMemberSearch').value = '';
        document.getElementById('mkMemberHits').innerHTML = '';
        document.getElementById('mkMembersMsg').innerHTML = '';
        renderMembers();
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkMembersModal')).show();
    }
    var searchTimer = null, searchSeq = 0;
    function searchMembers() {
        var q = document.getElementById('mkMemberSearch').value.trim();
        var hits = document.getElementById('mkMemberHits');
        clearTimeout(searchTimer);
        if (q.length < 2) { hits.innerHTML = ''; return; }
        searchTimer = setTimeout(function () {
            var seq = ++searchSeq;
            getJson('/umbraco/surface/TrainingGroup/SearchMembers?query=' + encodeURIComponent(q) + '&trainingGroupId=' + groupId).then(function (d) {
                if (seq !== searchSeq) return;
                var inCourse = {};
                course.participants.concat(course.trainers).forEach(function (p) { inCourse[p.memberId] = true; });
                var rows = (d.data || []);
                hits.innerHTML = rows.length ? rows.map(function (m) {
                    var taken = inCourse[m.memberId];
                    return '<button type="button" class="list-group-item list-group-item-action py-1"' + (taken ? ' disabled' : '') +
                        ' data-mk="add-member" data-member="' + m.memberId + '">' + esc(m.memberName) +
                        (taken ? ' <span class="small text-muted">(redan med)</span>' : '') + '</button>';
                }).join('') : '<div class="small text-muted px-1">Ingen medlem i klubben matchar.</div>';
            });
        }, 300);
    }
    function membersMsg(d) {
        document.getElementById('mkMembersMsg').innerHTML = '<div class="alert alert-' + (d.success ? 'success' : 'warning') + ' py-1 small">' + esc(d.message || '') + '</div>';
    }
    function addMember(id) {
        postForm('/umbraco/surface/TrainingGroup/AddTrainingGroupMember', { trainingGroupId: groupId, memberId: id, role: 'Member', sendEmail: 'false' }).then(function (d) {
            membersMsg(d);
            if (!d.success) return;
            document.getElementById('mkMemberSearch').value = '';
            document.getElementById('mkMemberHits').innerHTML = '';
            loadCourse(groupId).then(renderMembers);
        });
    }
    function removeMember(id) {
        var p = course.participants.find(function (x) { return x.memberId === id; });
        if (!confirm('Ta bort ' + (p ? p.name : 'deltagaren') + ' ur kursen? Närvaro och serier som redan registrerats finns kvar.')) return;
        postForm('/umbraco/surface/TrainingGroup/RemoveTrainingGroupMember', { trainingGroupId: groupId, memberId: id }).then(function (d) {
            membersMsg(d);
            if (d.success) loadCourse(groupId).then(renderMembers);
        });
    }

    // ── Lånevapen till tillfället ──
    function openLoan() {
        if (!current) return;
        document.getElementById('mkLoanTitle').textContent = 'Lånevapen · ' + dayLabel(current.date, true) + (current.startTime ? ' ' + current.startTime : '');
        document.getElementById('mkLoanResult').innerHTML = '';
        document.getElementById('mkLoanList').innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div></div>';
        document.getElementById('mkLoanSave').disabled = true;
        bootstrap.Modal.getOrCreateInstance(document.getElementById('mkLoanModal')).show();
        loadLoan();
    }
    function loadLoan() {
        return getJson('/umbraco/surface/TrainingCourse/LoanWeapons?groupId=' + groupId + '&trainingId=' + current.trainingId).then(function (d) {
            var list = document.getElementById('mkLoanList');
            if (!d.success) { list.innerHTML = '<div class="alert alert-warning py-2">' + esc(d.message || 'Kunde inte läsas.') + '</div>'; return; }
            if (!d.participants.length) { list.innerHTML = '<div class="alert alert-info py-2">Kursen har inga deltagare.</div>'; return; }
            var open = d.participants.filter(function (x) { return !x.booked; }).length;
            list.innerHTML = '<div class="small text-muted mb-2">' + (d.participants.length - open) + ' av ' + d.participants.length + ' har redan ett lånevapen bokat.</div>' +
                d.participants.map(function (x, i) {
                    return '<div class="form-check py-1"><input class="form-check-input" type="checkbox" id="mkLoan' + i + '" data-loan-member="' + x.memberId + '"' +
                        (x.booked ? ' checked disabled' : ' checked') + '>' +
                        '<label class="form-check-label" for="mkLoan' + i + '">' + esc(x.name) +
                        (x.booked ? ' <span class="badge bg-success-subtle text-success-emphasis">lånevapen bokat</span>' : '') + '</label></div>';
                }).join('');
            document.getElementById('mkLoanSave').disabled = open === 0;
        }).catch(function (e) { document.getElementById('mkLoanList').innerHTML = '<div class="alert alert-danger py-2">' + esc(e.message) + '</div>'; });
    }
    function saveLoan() {
        var ids = Array.prototype.slice.call(document.querySelectorAll('[data-loan-member]'))
            .filter(function (c) { return c.checked && !c.disabled; })
            .map(function (c) { return parseInt(c.getAttribute('data-loan-member'), 10); });
        var res = document.getElementById('mkLoanResult');
        if (!ids.length) { res.innerHTML = '<span class="text-danger">Välj minst en deltagare.</span>'; return; }
        var btn = document.getElementById('mkLoanSave');
        btn.disabled = true;
        post('/umbraco/surface/TrainingCourse/AssignLoanWeapons', { groupId: groupId, trainingId: current.trainingId, memberIds: ids }).then(function (d) {
            // Svaret säger per person vad som hände — den som blev utan vapen är den tränaren behöver prata med.
            var failed = (d.results || []).filter(function (r) { return !r.ok; });
            res.innerHTML = '<div class="alert alert-' + (d.success && !failed.length ? 'success' : 'warning') + ' py-2 mb-0">' + esc(d.message || '') +
                (failed.length ? '<ul class="mb-0 mt-1">' + failed.map(function (r) { return '<li>' + esc(r.name) + ': ' + esc(r.message || '') + '</li>'; }).join('') + '</ul>' : '') + '</div>';
            loadLoan();
        });
    }

    document.addEventListener('click', function (e) {
        // Rälsens delar är vanliga länkar (#vy=…): webbläsaren gör en historikpost av klicket, så
        // bakåtknappen går till förra delen, och hashchange-lyssnaren nedan ritar om.
        if (e.target.closest('[data-mk-view]')) return;
        var b = e.target.closest('[data-mk], [data-shot]');
        if (!b) return;
        if (b.hasAttribute('data-shot')) { if (shots.length < 5) { shots.push(b.getAttribute('data-shot')); renderShots(); } return; }
        var act = b.getAttribute('data-mk');
        var member = parseInt(b.getAttribute('data-member'), 10) || 0;
        if (act === 'att') setAttendance(member, b.getAttribute('data-status'));
        else if (act === 'series') openSeries(member);
        else if (act === 'note') openNote(member);
        else if (act === 'clear-shots') { shots = []; renderShots(); }
        else if (act === 'del-series') {
            if (!confirm('Ta bort serien? Den tas bort ur träningsloggen och, om den nådde brons, ur märkesserierna.')) return;
            post('/umbraco/surface/TrainingCourse/DeleteSeries', { groupId: groupId, seriesId: parseInt(b.getAttribute('data-series'), 10) }).then(function (d) {
                if (!d.success) { document.getElementById('mkSeriesErr').textContent = d.message; return; }
                openSeries(seriesState.memberId);
            });
        }
        else if (act === 'link') openLink();
        else if (act === 'link-schedule') { var sid = parseInt(b.getAttribute('data-schedule'), 10); markLink(function (t) { return t.scheduleId === sid; }); }
        else if (act === 'link-day') {
            var wd = parseInt(document.getElementById('mkLinkDay').value, 10);
            var from = document.getElementById('mkLinkFrom').value, to = document.getElementById('mkLinkTo').value;
            markLink(function (t) { return new Date(t.date + 'T12:00:00').getDay() === wd && (!from || t.date >= from) && (!to || t.date <= to); });
        }
        else if (act === 'defaults') openDefaults();
        else if (act === 'loan') openLoan();
        else if (act === 'members') openMembers();
        else if (act === 'add-member') addMember(member);
        else if (act === 'rm-member') removeMember(member);
        else if (act === 'occ') openOcc(parseInt(b.getAttribute('data-training'), 10));
    });
    document.querySelectorAll('input[name="mkMode"]').forEach(function (r) {
        r.addEventListener('change', function () {
            var t = mode() === 'total';
            document.getElementById('mkShotsWrap').classList.toggle('d-none', t);
            document.getElementById('mkTotalWrap').classList.toggle('d-none', !t);
            updateSum();
        });
    });
    document.getElementById('mkTotal').addEventListener('input', updateSum);
    document.getElementById('mkSeriesSave').addEventListener('click', saveSeries);
    document.getElementById('mkNoteSave').addEventListener('click', saveNote);
    document.getElementById('mkLinkSave').addEventListener('click', saveLink);
    document.getElementById('mkOccSave').addEventListener('click', saveOcc);
    document.getElementById('mkOccUnlink').addEventListener('click', unlinkOcc);
    document.getElementById('mkDefSave').addEventListener('click', saveDefaults);
    document.getElementById('mkLoanSave').addEventListener('click', saveLoan);
    document.getElementById('mkMemberSearch').addEventListener('input', searchMembers);
    // Bakåtknappen och en inklistrad länk byter också del (#vy=…).
    window.addEventListener('hashchange', function () {
        var m = (location.hash || '').match(/vy=([a-z]+)/);
        if (!m || m[1] === view) return;
        var role = roleOf(groupId);
        if (!viewsFor(role).some(function (x) { return x[0] === m[1]; })) return;
        view = m[1];
        if (role === 'participant') { if (partView) renderParticipant(partView); }
        else if (course) render();
        window.scrollTo({ top: 0 });
    });
    // Byte av kurs börjar på kursens första del — en annan kurs kan ha en annan roll och andra delar.
    document.getElementById('mkPicker').addEventListener('change', function () { view = null; loadCourse(parseInt(this.value, 10)); });
    // Uppropet uppdaterar listan när serie-dialogen stängs, så märkesläget följer med.
    document.getElementById('mkSeriesModal').addEventListener('hidden.bs.modal', function () { loadCourse(groupId); });

    loadCourses().then(function (id) { if (id) loadCourse(id); });
})();
</script>
