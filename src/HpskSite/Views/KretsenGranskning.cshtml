@using HpskSite.Controllers
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    var m = ViewData["KretsGranskning"] as KretsAnsokningarModel ?? new KretsAnsokningarModel();
    ViewBag.Title = "Resultatgranskning — " + m.RegionName;
}

@* Kretsgranskning fas 2: kretsens granskning av resultatlistor. Egen sida, eftersom
   resultatgranskaren sällan är kretsadministratör. Granskningen är en STÄMPEL; bara en krets som
   slagit på "Kräv kretsens godkännande" håller inne standardmedaljerna. Behörigheten prövas av
   varje endpoint. *@

<style>
    .kg-page { font-size: 1.05rem; padding: 1.5rem 0 4rem; }
    .kg-page h1 { font-size: 1.8rem; font-weight: 700; }
</style>

<div class="container kg-page">
    <h1 class="mb-1"><i class="bi bi-clipboard-check me-2"></i>Resultatgranskning — @m.RegionName</h1>

    @if (!m.Allowed)
    {
        <div class="alert alert-secondary mt-3" id="kgNotAllowed">
            Den här sidan är för kretsens resultatgranskare och kretsadministratören.
            Ska du ha uppdraget kan du be om det på <a href="/kretsen/kom-igang?krets=@m.RegionId">Kom igång</a>.
        </div>
    }
    else
    {
        @await Html.PartialAsync("_KretsResultReviewInbox", m)
    }
    <p class="mt-3"><a href="@m.RegionUrl"><i class="bi bi-arrow-left me-1"></i>Till @m.RegionName</a></p>
</div>

@if (m.Allowed)
{
<script>window.hpskKretsResultReviewInit();</script>
}
