@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    var token = ViewData["ArendeToken"] as string ?? "";
    ViewBag.Title = "Kretsens granskning av resultatlistan";
}

@* Kretsgranskning fas 2 — länkläget för resultatgranskningen. En krets utan resultatgranskare får
   listan som en länk utan inloggning. Länken gäller EN granskning i 60 dagar och slutar gälla om
   resultatlistan ändras (servern jämför kontrollsumman). Ärendet renderas av _ResultReviewCase,
   samma funktion som kretsens inkorg. *@

<div class="container" style="max-width:820px; padding:1.5rem 0 4rem; font-size:1.08rem;">
    @Html.AntiForgeryToken()
    <h1 class="mb-3" style="font-size:1.7rem;font-weight:700;"><i class="bi bi-clipboard-check me-2"></i>Kretsens granskning av resultatlistan</h1>
    <div class="alert alert-light border small" id="rraNudge">
        <i class="bi bi-lightbulb me-1"></i>Utser kretsen en resultatgranskare på pistol.nu hamnar listorna direkt hos den personen, med en knapp i mejlet.
        <a href="#" id="rraKomIgang">Jag vill bli kretsens resultatgranskare</a>
    </div>
    <div id="rraContent"><div class="text-muted">Hämtar…</div></div>
</div>

@await Html.PartialAsync("_ResultReviewCase")
<script>
(function () {
    const T = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(token));
    const box = document.getElementById('rraContent');
    fetch('/umbraco/surface/ResultReview/GetByLink?t=' + encodeURIComponent(T)).then(r => r.json()).then(d => {
        if (!d.success) { box.innerHTML = '<div class="alert alert-warning" id="rraInvalid">' + window.hpskEsc(d.message) + '</div>'; return; }
        if (d.region) document.getElementById('rraKomIgang').href = '/kretsen/kom-igang?krets=' + d.region.id;
        window.hpskRenderReviewCase(box, d, { mode: 'lank', token: T });
    }).catch(() => { box.innerHTML = '<div class="alert alert-warning">Granskningen kunde inte hämtas. Försök igen om en stund.</div>'; });
})();
</script>
