@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Newtonsoft.Json
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Core.Services
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject HpskSite.Services.ClubService ClubService
@inject HpskSite.Services.AdminAuthorizationService AuthService
@{
    Layout = null;
    var competition = Model.Parent; // Competition -> Result (direct child)
    
    // Get properties using Value<T>
    var resultData = Model.Value<string>("resultData") ?? "";
    var lastUpdated = Model.Value<DateTime>("lastUpdated", fallback: Fallback.ToDefaultValue, defaultValue: DateTime.Now);
    var isOfficial = Model.Value<bool>("isOfficial", fallback: Fallback.ToDefaultValue, defaultValue: false);
    
    // Get competition type
    var competitionTypeId = "";
    try { competitionTypeId = competition.Value<string>("competitionType") ?? "Precision"; } catch { competitionTypeId = "Precision"; }
    var isSpringskytte = competitionTypeId == "Springskytte";
    var isFaltskytte = competitionTypeId == "Faltskytte" || competitionTypeId == "MagnumFalt";

    // Deltävling toggle: when /resultat/?sub=true is requested, the page renders the
    // sub-competition subset (filtered to registrations with isSubCompetition=true).
    // Used to label the heading, swap the public title, and route the result-loading
    // endpoint to subCompetitionOnly=true. Falls back to the main list when missing.
    var isSubCompetitionView = false;
    var subCompetitionName = "";
    try
    {
        var subParam = Context.Request.Query["sub"].ToString();
        isSubCompetitionView = string.Equals(subParam, "true", StringComparison.OrdinalIgnoreCase);
        subCompetitionName = competition.Value<string>("subCompetitionName") ?? "";
        // Defensive: ignore ?sub=true when the competition has no deltävling configured.
        if (string.IsNullOrWhiteSpace(subCompetitionName)) isSubCompetitionView = false;
    }
    catch { /* keep defaults */ }

    // Team results support
    var allowTeams = false;
    try { allowTeams = competition.Value<bool>("allowTeams"); } catch { }

    // Get competition configuration for finals
    var numberOfSeriesOrStations = 0;
    var numberOfFinalSeries = 0;
    try { numberOfSeriesOrStations = competition.Value<int>("numberOfSeriesOrStations"); } catch { }
    try { numberOfFinalSeries = competition.Value<int>("numberOfFinalSeries"); } catch { }
    
    var hasFinalsRound = numberOfFinalSeries > 0;
    var qualificationSeriesCount = hasFinalsRound ? (numberOfSeriesOrStations - numberOfFinalSeries) : numberOfSeriesOrStations;
    
    // Get current member info for highlighting
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var currentMemberName = currentMember?.Name ?? "";
    var currentMemberClub = "";

    // Authorization: who may delete a shooter's results from this competition?
    var canDeleteResults = false;

    if (currentMember != null)
    {
        var memberData = MemberService.GetByEmail(currentMember.Email ?? "");
        if (memberData != null)
        {
            var primaryClubIdStr = memberData.GetValue<string>("primaryClubId");
            if (!string.IsNullOrEmpty(primaryClubIdStr) && int.TryParse(primaryClubIdStr, out int primaryClubId))
            {
                currentMemberClub = ClubService.GetClubNameById(primaryClubId) ?? "";
            }

            var isSiteAdmin = await AuthService.IsCurrentUserAdminAsync();
            var isCompetitionManager = await AuthService.IsCompetitionManager(competition.Id);

            var isClubAdmin = false;
            var isSkjutledare = false;
            var competitionClubId = competition.Value<int>("clubId");
            if (competitionClubId > 0)
            {
                isClubAdmin = await AuthService.IsClubAdminForClub(competitionClubId);
                isSkjutledare = await AuthService.IsSkjutledareForClub(competitionClubId);
            }
            // Region-hosted (clubId unset — the SM shape): the krets is the organiser.
            var isRegionHost = await AuthService.IsRegionHostAdminAsync(
                competitionClubId, competition.Value<string>("regionalFederation"));

            canDeleteResults = isSiteAdmin || isCompetitionManager || isClubAdmin || isSkjutledare || isRegionHost;
        }
    }
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(isSubCompetitionView ? subCompetitionName : Model.Name) - @competition.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { padding: 20px; background-color: #f8f9fa; font-family: Arial, sans-serif; }
        .print-only { display: none; }
        
        /* Plain table styling like start lists */
        .results-table {
            font-size: 11px;
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            background: white;
        }
        
        .results-table th,
        .results-table td {
            padding: 3px 6px;
            border: 1px solid #ddd;
            text-align: left;
            line-height: 1.2;
            white-space: nowrap;
        }

        /* Fixed layout so score columns align across class tables and the table fits the viewport */
        .results-table-fixed {
            table-layout: fixed;
        }

        .results-cell-truncate {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        
        .results-table th {
            background-color: #f5f5f5;
            font-weight: bold;
            font-size: 10px;
            text-align: center;
        }
        
        .results-table td {
            font-size: 11px;
        }
        
        .results-table .text-center {
            text-align: center;
        }
        
        .results-table .text-right {
            text-align: right;
        }
        
        /* Class header styling */
        .class-header {
            background-color: #e9ecef;
            padding: 8px 12px;
            margin: 20px 0 5px 0;
            border-left: 4px solid #007bff;
            font-weight: bold;
            font-size: 14px;
        }
        
        /* Compact spacing */
        .class-results-section {
            margin-bottom: 25px;
        }
        
        /* User highlighting */
        .current-user { background-color: #cce5ff !important; } /* Light blue for current user */
        .same-club { background-color: #f0f8ff !important; } /* Very light blue for same club */
        
        .x-count { color: #dc3545; font-size: 9px; }

        /* Grouped sub-total columns (Milsnabb, Nationell Helmatch) */
        .results-table .subtotal-col {
            border-left: 2px solid #999;
            font-weight: bold;
        }
        .results-table th.subtotal-col {
            background-color: #e8e8e8;
        }

        /* Individual series columns (Milsnabb, Nationell Helmatch) - hide on mobile */
        .results-table .milsnabb-series {
            /* visible by default on desktop */
        }
        @@media (max-width: 767.98px) {
            .results-table .milsnabb-series { display: none; }
        }

        @@media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background-color: white; padding: 0; font-size: 10px; }
            .results-table { font-size: 9px; }
            .results-table th, .results-table td { padding: 2px 4px; }
            .class-header { font-size: 12px; }
            .print-footer {
                position: fixed;
                bottom: 0;
                left: 0;
                right: 0;
                text-align: right;
                font-size: 9px;
                color: #555;
                padding: 4px 8px;
            }
        }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="container-fluid">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <div>
                <h1>
                        <i class="bi bi-trophy text-warning me-2"></i>
                                @(isSubCompetitionView ? subCompetitionName : Model.Name)
                </h1>
                <p class="text-muted mb-0">@competition.Name</p>
                            </div>
                        <div>
                <button class="btn btn-outline-secondary" onclick="window.print()">
                                <i class="bi bi-printer me-1"></i>Skriv ut
                            </button>
                            </div>
                        </div>

        <!-- Print Header -->
        <div class="print-only mb-4">
            <h1>@(isSubCompetitionView ? subCompetitionName : Model.Name) @competition.Name</h1>
            <hr>
        </div>

        <!-- Print Footer -->
        <div class="print-footer print-only">
            Utskriven: <span id="printTimestamp"></span>
        </div>

        <script>
            (function () {
                function setPrintTimestamp() {
                    var now = new Date();
                    var pad = function (n) { return n < 10 ? '0' + n : n; };
                    var stamp = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate())
                        + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes());
                    var el = document.getElementById('printTimestamp');
                    if (el) el.textContent = stamp;
                }
                setPrintTimestamp();
                window.addEventListener('beforeprint', setPrintTimestamp);
            })();
        </script>

        @if (allowTeams)
        {
            <!-- Tab navigation for Individual/Team results -->
            <ul class="nav nav-tabs mb-3 no-print" id="resultsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="individualTab" data-bs-toggle="tab" data-bs-target="#individualResults" type="button" role="tab">
                        <i class="bi bi-person me-1"></i>Individuellt
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="teamTab" data-bs-toggle="tab" data-bs-target="#teamResults" type="button" role="tab">
                        <i class="bi bi-people-fill me-1"></i>Lagresultat
                    </button>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="individualResults" role="tabpanel">
                    <div id="resultsContent">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Laddar resultat...</span>
                            </div>
                            <p class="mt-2">Laddar resultat...</p>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="teamResults" role="tabpanel">
                    <div id="teamResultsContent">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Laddar lagresultat...</span>
                            </div>
                            <p class="mt-2">Laddar lagresultat...</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Results Content (no teams) -->
            <div id="resultsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Laddar resultat...</span>
                    </div>
                    <p class="mt-2">Laddar resultat...</p>
                </div>
            </div>
        }
        </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script>
    // Get competition ID from the URL or parent
    const competitionId = @(competition?.Id ?? 0);
    const refreshInterval = 15000; // 15 seconds
    let autoRefreshTimer = null;
    let isOfficialResults = false;
    
    // Finals configuration
    const hasFinalsRound = @(hasFinalsRound.ToString().ToLower());
    const qualificationSeriesCount = @qualificationSeriesCount;
    const numberOfFinalSeries = @numberOfFinalSeries;
    const totalSeriesCount = @numberOfSeriesOrStations;
    
    // Competition type
    const isSpringskytte = @(isSpringskytte.ToString().ToLower());
    const isFaltskytte = @(isFaltskytte.ToString().ToLower());

    // Deltävling view: when set, every result-loading endpoint gets &subCompetitionOnly=true
    // and the resulting rows are the IsSubCompetition-only subset with their own merges + medals.
    const isSubCompetitionView = @(isSubCompetitionView.ToString().ToLower());
    const subQs = isSubCompetitionView ? '&subCompetitionOnly=true' : '';

    // Team results
    const allowTeams = @(allowTeams.ToString().ToLower());

    // Current user info for highlighting
    const currentUserName = '@Html.Raw(currentMemberName.Replace("'", "\\'"))';
    const currentUserClub = '@Html.Raw(currentMemberClub.Replace("'", "\\'"))';

    // Admin-only delete capability for individual shooter results
    const canDeleteResults = @(canDeleteResults.ToString().ToLower());
        
        // Fetch and display results
        async function loadResults() {
            const container = document.getElementById('resultsContent');

            // Springskytte uses its own endpoint and rendering
            if (isSpringskytte) {
                await loadSpringskytteResults(container);
                return;
            }

            // Fältskytte uses its own endpoint and rendering
            if (isFaltskytte) {
                await loadFaltskytteResults(container);
                return;
            }

            try {
                const response = await fetch(`/umbraco/surface/CompetitionResults/GetResultsList?competitionId=${competitionId}${subQs}`);
                const data = await response.json();
                
                if (!data.success || !data.exists) {
                    container.innerHTML = `
                            <div class="alert alert-info">
                                <h4 class="alert-heading">Inga resultat ännu</h4>
                            <p class="mb-0">Det finns inga registrerade resultat för denna tävling ännu. Resultat visas automatiskt här när domare börjar registrera skjutresultat.</p>
                            </div>
                    `;
                    return;
                }
                
                isOfficialResults = data.isOfficial;
                const results = data.results;
                const isAwardingStandardMedals = data.isAwardingStandardMedals || false;
                const competitionTypeId = data.competitionTypeId || 'Precision';
                const isMilsnabb = competitionTypeId === 'Milsnabb';
                const isNationellHelmatch = competitionTypeId === 'NationellHelmatch';

                // Hur grenens 12 serier delas i delsummor: [förstaSerieIndex, sistaExklusive, rubrik].
                // Var hårdkodat till 3 grupper om 4 på TRE ställen (kolumnräkningen, rubrikerna och
                // cellerna), vilket gjorde Sportpistols 2 grupper om 6 omöjlig att uttrycka.
                // null = ingen gruppering, alltså vanlig serie-per-kolumn-tabell.
                const seriesGroups =
                    isMilsnabb ? [[0, 4, '10s'], [4, 8, '8s'], [8, 12, '6s']]
                    : isNationellHelmatch ? [[0, 4, 'Prec'], [4, 8, 'Duell'], [8, 12, 'Fält']]
                    // Standardpistol: 150 s / 20 s / 10 s — samma 3x4-form som Milsnabb.
                    : competitionTypeId === 'Standardpistol' ? [[0, 4, '150s'], [4, 8, '20s'], [8, 12, '10s']]
                    // Sportpistol: precisionshalva + duellhalva, alltså 2 grupper om 6.
                    : competitionTypeId === 'Sportpistol' ? [[0, 6, 'Prec'], [6, 12, 'Duell']]
                    : null;
                const isGrouped12 = seriesGroups !== null;

                // Build HTML for results
                let html = '';

                if (results.classGroups && results.classGroups.length > 0) {
                    results.classGroups.forEach(classGroup => {
                        // Allocate column widths so the table fits the viewport while leaving as
                        // much room as possible for Namn and Förening. Single-series columns
                        // (1..N, F1..FN, milsnabb 1..12) hold at most 2 chars ("50"), so they
                        // get a narrow width. Tot/X/S/subtotal columns hold up to 3 chars ("500")
                        // and need slightly more room.
                        let seriesColCount = 0;
                        let totalColCount = 0;
                        let seriesCountForRow = 0;
                        let showFinals = false;

                        // Use the MAX series count across all shooters in this class so that
                        // shooters with missing series rows still align with the header
                        // (missing cells render as 0 in the body below).
                        const maxSeriesCount = classGroup.shooters.length > 0
                            ? Math.max(0, ...classGroup.shooters.map(s => (s.results || []).length))
                            : 0;

                        if (isGrouped12) {
                            seriesColCount = 12;
                            totalColCount = seriesGroups.length; // en delsumma per grupp
                        } else if (classGroup.shooters.length > 0 && classGroup.shooters[0].results) {
                            seriesCountForRow = maxSeriesCount;
                            if (hasFinalsRound && seriesCountForRow >= totalSeriesCount) {
                                seriesColCount = qualificationSeriesCount + numberOfFinalSeries;
                                totalColCount = 1; // mid Tot between qualification and finals
                                showFinals = true;
                            } else {
                                seriesColCount = seriesCountForRow;
                            }
                        }
                        totalColCount += 2; // final Tot + X
                        if (isAwardingStandardMedals) totalColCount += 1; // S
                        // Add a "Sj" (Särskjutning) column only when at least one shooter in this
                        // class has shoot-off rounds entered. The shoot-off scores are shown
                        // separately from the qualification Tot — they only decide medal order.
                        const classHasShootOff = classGroup.shooters.some(s =>
                            Array.isArray(s.shootOffRoundTotals) && s.shootOffRoundTotals.length > 0);
                        if (classHasShootOff) totalColCount += 2; // Sj column gets double width to fit "49 / 47"
                        const deleteColCount = canDeleteResults ? 1 : 0;

                        const platsPct = 4;
                        const klassPct = 5;
                        const fixedTextPct = platsPct + klassPct;
                        const targetSeriesPct = 3;  // 2-char single-series cells
                        const targetTotalPct  = 4;  // 3-char total/subtotal cells
                        const targetDeletePct = 3;  // tiny trash-icon col
                        const minTextSharePct = 20; // floor for Namn + Förening combined

                        const targetNumericPct =
                            seriesColCount * targetSeriesPct +
                            totalColCount  * targetTotalPct  +
                            deleteColCount * targetDeletePct;
                        const availableNumericPct = 100 - fixedTextPct - minTextSharePct;
                        const scale = targetNumericPct > availableNumericPct
                            ? availableNumericPct / targetNumericPct
                            : 1;

                        const seriesPct = targetSeriesPct * scale;
                        const totalPct  = targetTotalPct  * scale;
                        const deletePct = targetDeletePct * scale;

                        const usedNumericPct =
                            seriesColCount * seriesPct +
                            totalColCount  * totalPct  +
                            deleteColCount * deletePct;
                        const textSharePct = 100 - fixedTextPct - usedNumericPct;
                        const namnPct = textSharePct / 2;
                        const foreningPct = textSharePct / 2;

                        // Class header — admin sees a pen icon for inline-editing the class name.
                        // The auto-generated combined name (classGroup.className) is preserved
                        // as the override key so renaming + reverting are roundtrip-safe.
                        const autoName = classGroup.className || '';
                        const displayName = classGroup.displayClassName || autoName;
                        const renameAttr = canDeleteResults
                            ? ` data-rename="1" data-original="${autoName.replace(/"/g, '&quot;')}" data-current="${displayName.replace(/"/g, '&quot;')}"`
                            : '';
                        const renameBtn = canDeleteResults
                            ? ` <button type="button" class="btn btn-link btn-sm p-0 ms-2 rename-class-btn no-print" title="Byt namn på klassgruppen" aria-label="Byt namn">
                                  <i class="bi bi-pencil-square"></i>
                               </button>`
                            : '';
                        html += `
                            <div class="class-results-section">
                                <div class="class-header"${renameAttr}>
                                    <span class="class-header-name">${displayName}</span> (${classGroup.shooters.length} deltagare)${renameBtn}
                                </div>
                                <table class="results-table results-table-fixed">
                                    <thead>
                                        <tr>
                                            <th style="width:${platsPct}%">Plats</th>
                                            <th style="width:${namnPct}%">Namn</th>
                                            <th style="width:${foreningPct}%">Förening</th>
                                            <th style="width:${klassPct}%">Klass</th>
                        `;

                        // Add series columns based on competition type
                        if (isGrouped12) {
                            // 12 serier i grupper med delsumma efter varje grupp.
                            seriesGroups.forEach(([start, end, label]) => {
                                for (let i = start + 1; i <= end; i++) html += `<th class="milsnabb-series" style="width:${seriesPct}%">${i}</th>`;
                                html += `<th class="subtotal-col" style="width:${totalPct}%">${label}</th>`;
                            });
                        } else if (classGroup.shooters.length > 0 && classGroup.shooters[0].results) {
                            const seriesCount = maxSeriesCount;

                            if (hasFinalsRound && seriesCount >= totalSeriesCount) {
                                for (let i = 1; i <= qualificationSeriesCount; i++) {
                                    html += `<th style="width:${seriesPct}%">${i}</th>`;
                                }
                                html += `<th style="width:${totalPct}%">Tot</th>`;
                                for (let i = 1; i <= numberOfFinalSeries; i++) {
                                    html += `<th style="width:${seriesPct}%">F${i}</th>`;
                                }
                            } else {
                                for (let i = 1; i <= seriesCount; i++) {
                                    html += `<th style="width:${seriesPct}%">${i}</th>`;
                                }
                            }
                        }

                        html += `
                                            <th style="width:${totalPct}%">Tot</th>
                                            <th style="width:${totalPct}%">X</th>
                        `;

                        if (classHasShootOff) {
                            html += `<th style="width:${totalPct * 2}%" title="Särskjutning">Sär</th>`;
                        }

                        if (isAwardingStandardMedals) {
                            html += `<th style="width:${totalPct}%">S</th>`;
                        }

                        if (canDeleteResults) {
                            html += `<th class="no-print" style="width:${deletePct}%"></th>`;
                        }

                        html += `
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                        // Add shooters
                        classGroup.shooters.forEach((shooter, index) => {
                            const position = index + 1;
                            let totalScore = 0;
                            let totalXCount = 0;
                            let qualificationScore = 0;

                            // Calculate series scores
                            const seriesScores = [];
                            shooter.results.forEach(result => {
                                const shots = JSON.parse(result.shots);
                                let score = 0;
                                let xCount = 0;
                                shots.forEach(shot => {
                                    score += (shot === 'X' ? 10 : parseInt(shot));
                                    if (shot === 'X') xCount++;
                                });
                                seriesScores.push({score, xCount});
                                totalScore += score;
                                totalXCount += xCount;
                            });

                            // Row styling
                            let rowClass = '';
                            if (currentUserName && shooter.name === currentUserName) {
                                rowClass = 'current-user';
                            } else if (currentUserClub && shooter.club === currentUserClub) {
                                rowClass = 'same-club';
                            }

                            html += `
                                <tr class="${rowClass}">
                                    <td class="text-center">${position}</td>
                                    <td class="results-cell-truncate" title="${shooter.name}">${shooter.name}</td>
                                    <td class="results-cell-truncate" title="${shooter.club}">${shooter.club}</td>
                                    <td class="text-center">${shooter.shootingClass || classGroup.className}</td>
                            `;

                            // Add series scores based on competition type
                            if (isGrouped12) {
                                // Samma grupper som rubrikerna — en källa, så de inte kan glida isär.
                                seriesGroups.forEach(([start, end]) => {
                                    let groupTotal = 0;
                                    for (let i = start; i < end; i++) {
                                        const s = i < seriesScores.length ? seriesScores[i].score : 0;
                                        groupTotal += s;
                                        html += `<td class="text-center milsnabb-series">${i < seriesScores.length ? s : '-'}</td>`;
                                    }
                                    html += `<td class="text-center subtotal-col">${groupTotal}</td>`;
                                });
                            } else if (hasFinalsRound && seriesScores.length >= totalSeriesCount) {
                                for (let i = 0; i < qualificationSeriesCount; i++) {
                                    html += `<td class="text-center">${i < seriesScores.length ? seriesScores[i].score : 0}</td>`;
                                }
                                qualificationScore = seriesScores.slice(0, qualificationSeriesCount).reduce((sum, s) => sum + s.score, 0);
                                html += `<td class="text-center"><strong>${qualificationScore}</strong></td>`;
                                for (let i = qualificationSeriesCount; i < totalSeriesCount; i++) {
                                    html += `<td class="text-center">${i < seriesScores.length ? seriesScores[i].score : 0}</td>`;
                                }
                            } else {
                                // Iterate up to seriesColCount (max across shooters) so cells line up
                                // with the header. Shooters who are missing a series get 0 in that slot.
                                for (let i = 0; i < seriesColCount; i++) {
                                    const s = i < seriesScores.length ? seriesScores[i].score : 0;
                                    html += `<td class="text-center">${s}</td>`;
                                }
                            }

                            html += `
                                    <td class="text-center"><strong>${totalScore}</strong></td>
                                    <td class="text-center">${totalXCount}</td>
                            `;

                            if (classHasShootOff) {
                                // Show each round's total separated by " / ". Empty cell for
                                // shooters who weren't part of a shoot-off in this class.
                                const rounds = Array.isArray(shooter.shootOffRoundTotals) ? shooter.shootOffRoundTotals : [];
                                if (rounds.length > 0) {
                                    const tip = rounds.map((t, i) => `Runda ${i + 1}: ${t}`).join(', ');
                                    const display = rounds.join(' / ');
                                    html += `<td class="text-center" title="${tip}"><strong>${display}</strong></td>`;
                                } else {
                                    html += `<td class="text-center text-muted">—</td>`;
                                }
                            }

                            if (isAwardingStandardMedals) {
                                const medal = shooter.standardMedal || '';
                                html += `<td class="text-center"><strong>${medal}</strong></td>`;
                            }

                            if (canDeleteResults) {
                                const rowClass = shooter.shootingClass || classGroup.className || '';
                                const safeClassAttr = rowClass.replace(/"/g, '&quot;');
                                const safeNameAttr = (shooter.name || '').replace(/"/g, '&quot;');
                                html += `<td class="no-print text-center">`
                                     + `<button type="button" class="btn btn-sm btn-outline-danger py-0 px-1 delete-shooter-btn" `
                                     + `data-member-id="${shooter.memberId}" `
                                     + `data-shooting-class="${safeClassAttr}" `
                                     + `data-shooter-name="${safeNameAttr}" `
                                     + `title="Ta bort alla resultat för denna skytt i klassen">`
                                     + `<i class="bi bi-trash"></i>`
                                     + `</button></td>`;
                            }

                            html += `
                                </tr>
                            `;
                        });

                        html += `
                                    </tbody>
                                </table>
                            </div>
                        `;

                        // Särskjutning footnotes — surfaced from CalculateFinalResults when a shoot-off
                        // resolved a medal-tier tie ("Särskjutning avgjorde guldet: Anna 50 vs Berit 47").
                        if (Array.isArray(classGroup.shootOffNotes) && classGroup.shootOffNotes.length > 0) {
                            html += '<div class="text-muted small mt-1 mb-3">';
                            classGroup.shootOffNotes.forEach(note => {
                                const safe = String(note).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
                                html += `<div><i class="bi bi-info-circle me-1"></i>${safe}</div>`;
                            });
                            html += '</div>';
                        }
                    });

                    container.innerHTML = html;
                    
                    // Setup auto-refresh for preliminary results
                    if (!isOfficialResults && !autoRefreshTimer) {
                        console.log('Preliminary results - enabling auto-refresh');
                        autoRefreshTimer = setInterval(loadResults, refreshInterval);
                    }
                } else {
                    container.innerHTML = `
                        <div class="alert alert-warning">
                            <h4 class="alert-heading">Ingen resultatdata tillgänglig</h4>
                            <p class="mb-0">Resultatdata finns men kunde inte formateras korrekt.</p>
                    </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading results:', error);
                container.innerHTML = `
                    <div class="alert alert-danger">
                        <h4 class="alert-heading">Fel vid laddning av resultat</h4>
                        <p class="mb-0">${error.message}</p>
                </div>
                `;
            }
        }
        
        // Load results when page loads
        document.addEventListener('DOMContentLoaded', loadResults);

        // Admin: delete all results for one shooter in one shooting class.
        // Uses event delegation so re-rendered tables stay wired up.
        async function deleteShooterFromClass(memberId, shootingClass, shooterName) {
            if (!memberId || !shootingClass) {
                alert('Saknar nödvändig data för att ta bort resultat.');
                return;
            }

            const confirmed = confirm(`Ta bort alla resultat för ${shooterName || 'denna skytt'} i klass ${shootingClass}?\n\nDetta kan inte ångras.`);
            if (!confirmed) return;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';
            if (!token) {
                alert('Säkerhetstoken saknas. Ladda om sidan och försök igen.');
                return;
            }

            try {
                const response = await fetch('/umbraco/surface/CompetitionResults/DeleteShooterFromClass', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({
                        competitionId: competitionId,
                        memberId: memberId,
                        shootingClass: shootingClass
                    })
                });

                const data = await response.json();
                if (data.success) {
                    await loadResults();
                } else {
                    alert('Kunde inte ta bort resultat: ' + (data.message || 'Okänt fel'));
                }
            } catch (err) {
                console.error('Delete error', err);
                alert('Ett fel uppstod vid borttagning.');
            }
        }

        document.addEventListener('click', function (ev) {
            const btn = ev.target.closest('.delete-shooter-btn');
            if (!btn) return;
            ev.preventDefault();
            const memberId = parseInt(btn.getAttribute('data-member-id'), 10);
            const shootingClass = btn.getAttribute('data-shooting-class') || '';
            const shooterName = btn.getAttribute('data-shooter-name') || '';
            deleteShooterFromClass(memberId, shootingClass, shooterName);
        });

        // Inline rename of a class group — admin only. Pen icon next to class title swaps
        // the name span for an input + Spara / Avbryt / Återställ buttons.
        async function saveClassNameOverride(originalName, customName) {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const response = await fetch('/umbraco/surface/CompetitionResults/SaveClassNameOverride', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                    body: JSON.stringify({
                        competitionId: parseInt(competitionId, 10),
                        originalName: originalName,
                        customName: customName,
                        isSubCompetition: isSubCompetitionView
                    })
                });
                const data = await response.json();
                if (!data.Success && !data.success) {
                    alert('Kunde inte spara: ' + (data.Message || data.message || 'okänt fel'));
                    return false;
                }
                return true;
            } catch (err) {
                console.error('Rename error', err);
                alert('Ett fel uppstod vid namnändring.');
                return false;
            }
        }

        document.addEventListener('click', function (ev) {
            const btn = ev.target.closest('.rename-class-btn');
            if (!btn) return;
            ev.preventDefault();
            const header = btn.closest('.class-header');
            if (!header || header.dataset.renaming === '1') return;
            header.dataset.renaming = '1';

            const original = header.getAttribute('data-original') || '';
            const current = header.getAttribute('data-current') || original;
            const nameSpan = header.querySelector('.class-header-name');
            if (!nameSpan) return;

            // Build inline editor preserving the surrounding markup so layout doesn't jump.
            const editor = document.createElement('span');
            editor.className = 'class-header-editor d-inline-flex align-items-center gap-2';
            editor.innerHTML = `
                <input type="text" class="form-control form-control-sm class-header-input" style="max-width: 24rem;" />
                <button type="button" class="btn btn-success btn-sm class-header-save"><i class="bi bi-check-lg"></i> Spara</button>
                <button type="button" class="btn btn-outline-secondary btn-sm class-header-cancel">Avbryt</button>
                <button type="button" class="btn btn-outline-warning btn-sm class-header-reset" title="Återställ till automatiskt namn (${original.replace(/"/g, '&quot;')})">Återställ</button>
            `;
            const input = editor.querySelector('.class-header-input');
            input.value = current;

            // Hide the title span and the pen button while editing.
            nameSpan.style.display = 'none';
            btn.style.display = 'none';
            header.insertBefore(editor, nameSpan.nextSibling);
            input.focus();
            input.select();

            const finish = () => {
                header.dataset.renaming = '';
                editor.remove();
                nameSpan.style.display = '';
                btn.style.display = '';
            };

            editor.querySelector('.class-header-cancel').addEventListener('click', () => finish());

            editor.querySelector('.class-header-save').addEventListener('click', async () => {
                const newName = input.value.trim();
                if (newName === current) { finish(); return; }
                const ok = await saveClassNameOverride(original, newName);
                if (ok) { finish(); location.reload(); }
            });

            editor.querySelector('.class-header-reset').addEventListener('click', async () => {
                if (!confirm('Återställ till det automatiskt genererade namnet "' + original + '"?')) return;
                const ok = await saveClassNameOverride(original, '');
                if (ok) { finish(); location.reload(); }
            });

            input.addEventListener('keydown', (ev) => {
                if (ev.key === 'Enter') { ev.preventDefault(); editor.querySelector('.class-header-save').click(); }
                else if (ev.key === 'Escape') { ev.preventDefault(); finish(); }
            });
        });
        
        // Springskytte results rendering
        async function loadSpringskytteResults(container) {
            try {
                // publicOnly: each weapon group is published on its own, so this page shows only the
                // groups the organiser has made official — A can be up while C is still being scored.
                const response = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteResults?competitionId=${competitionId}${subQs}&publicOnly=true`);
                const data = await response.json();

                if (!data.success || !data.classGroups?.length) {
                    container.innerHTML = `
                        <div class="alert alert-info">
                            <h4 class="alert-heading">Inga resultat ännu</h4>
                            <p class="mb-0">Det finns inga publicerade resultat för denna tävling ännu.</p>
                        </div>`;
                    return;
                }

                // Say which groups are still missing, so a shooter doesn't read a partial list as final.
                const springPending = (data.weaponClassesWithResults || [])
                    .filter(wc => !(data.officialWeaponClasses || []).includes(wc));

                const springAwardingMedals = data.isAwardingStandardMedals === true;
                // Only show the manual Straff/Avdrag columns when the competition actually has any.
                const springAnyAdjust = data.classGroups.some(g => g.shooters.some(s => (s.penaltyPoints || 0) > 0 || (s.reductionSeconds || 0) > 0));
                let html = '';
                if (springPending.length) {
                    html += `<div class="alert alert-info">
                        <i class="bi bi-hourglass-split me-1"></i>
                        Resultaten för vapengrupp ${springPending.join(', ')} är inte publicerade ännu.
                    </div>`;
                }
                data.classGroups.forEach(group => {
                    html += `
                        <div class="class-results-section">
                            <div class="class-header">
                                ${group.className} (${group.shooters.length} deltagare)
                            </div>
                            <table class="results-table">
                                <thead>
                                    <tr>
                                        <th>Plats</th>
                                        <th>Namn</th>
                                        <th>Förening</th>
                                        <th>Löptid</th>
                                        <th>Skjutp.</th>
                                        <th>Tillägg</th>
                                        ${springAnyAdjust ? '<th>Straff</th><th>Avdrag</th>' : ''}
                                        <th>Sluttid</th>
                                        ${springAwardingMedals ? '<th>Medalj</th>' : ''}
                                    </tr>
                                </thead>
                                <tbody>`;

                    group.shooters.forEach(s => {
                        let rowClass = '';
                        if (currentUserName && s.name === currentUserName) rowClass = 'current-user';
                        else if (currentUserClub && s.club === currentUserClub) rowClass = 'same-club';

                        const medal = s.standardMedal === 'S' ? '<strong>S</strong>'
                            : s.standardMedal === 'B' ? '<strong>B</strong>' : '';

                        html += `
                                    <tr class="${rowClass}">
                                        <td class="text-center">${s.status || s.rank || '-'}</td>
                                        <td>${s.name}</td>
                                        <td title="${s.club}">${s.clubShort || s.club}</td>
                                        <td class="text-center">${s.sprintTimeDisplay || '-'}</td>
                                        <td class="text-center">${s.shootingScore ?? '-'}</td>
                                        <td class="text-center">${s.penaltyTimeDisplay || '-'}</td>
                                        ${springAnyAdjust ? `<td class="text-center">${s.penaltyPoints ? s.penaltyMinutesDisplay : '-'}</td><td class="text-center">${s.reductionSeconds ? s.reductionDisplay : '-'}</td>` : ''}
                                        <td class="text-center"><strong>${s.totalTimeDisplay || '-'}</strong></td>
                                        ${springAwardingMedals ? `<td class="text-center">${medal}</td>` : ''}
                                    </tr>`;
                    });

                    html += `
                                </tbody>
                            </table>
                        </div>`;
                });

                container.innerHTML = html;

                // Auto-refresh for live results
                if (!autoRefreshTimer) {
                    autoRefreshTimer = setInterval(loadResults, refreshInterval);
                }
            } catch (error) {
                console.error('Error loading Springskytte results:', error);
                container.innerHTML = `
                    <div class="alert alert-danger">
                        <h4>Fel vid laddning av resultat</h4>
                        <p>${error.message}</p>
                    </div>`;
            }
        }

        // Fältskytte results rendering
        function faltExtractStationConfigs(results) {
            var configs = [];
            var wc = results.config?.weaponConfigs || results.config?.WeaponConfigs || {};
            var firstWc = Object.values(wc)[0];
            if (firstWc) {
                (firstWc.stations || firstWc.Stations || []).forEach(function(st) {
                    var stNum = st.station || st.Station;
                    var hasPm = false;
                    (st.targetGroups || st.TargetGroups || []).forEach(function(tg) {
                        (tg.figures || tg.Figures || []).forEach(function(fig) {
                            if (fig.isPoangmal || fig.IsPoangmal) hasPm = true;
                        });
                    });
                    configs.push({ station: stNum, hasPoangmal: hasPm });
                });
            }
            return configs;
        }

        async function loadFaltskytteResults(container) {
            try {
                const response = await fetch(`/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=${competitionId}${subQs}`);
                const data = await response.json();

                if (!data.success) {
                    container.innerHTML = `<div class="alert alert-info">${data.message || 'Inga resultat.'}</div>`;
                    return;
                }

                const results = data.results;
                const isPoang = results.scoringMode === 'Poang';
                const stationConfigs = faltExtractStationConfigs(results);
                const faltAwardingMedals = results.isAwardingStandardMedals === true;
                let html = '';

                results.classGroups.forEach(group => {
                    // Show admin-overridden display name when present, fall back to auto.
                    const displayName = group.displayClassName || group.className || '';
                    // Per-class "Sär" column only when at least one shooter has shoot-off rounds.
                    const classHasShootOff = (group.shooters || []).some(s => Array.isArray(s.shootOffRounds) && s.shootOffRounds.length > 0);

                    html += `<div class="mb-4">`;
                    html += `<h4 class="border-bottom pb-2">${displayName} <small class="text-muted">(${group.shooters.length} deltagare)</small></h4>`;
                    html += `<div class="table-responsive"><table class="table table-sm table-hover">`;
                    html += `<thead class="table-light"><tr>
                        <th style="width:50px" class="text-center">Plats</th>
                        <th>Namn</th><th>Förening</th><th>Klass</th>`;

                    for (let i = 1; i <= results.stationCount; i++) {
                        const cfg = stationConfigs.find(s => s.station === i);
                        html += `<th class="text-center">${i}${cfg?.hasPoangmal ? '*' : ''}</th>`;
                    }

                    html += isPoang
                        ? `<th class="text-center fw-bold">Poäng</th>`
                        : `<th class="text-center fw-bold">Tot</th>`;
                    html += `<th class="text-center">Pm</th>`;
                    if (classHasShootOff) html += `<th class="text-center" title="Särskjutning">Sär</th>`;
                    if (faltAwardingMedals) html += `<th class="text-center">Std</th>`;
                    html += `</tr></thead><tbody>`;

                    group.shooters.forEach((shooter, idx) => {
                        const isCurrentUser = shooter.name === currentUserName;
                        const rowClass = isCurrentUser ? 'table-info fw-bold' : '';
                        html += `<tr class="${rowClass}">
                            <td class="text-center">${idx + 1}</td>
                            <td>${shooter.name}</td>
                            <td>${shooter.club}</td>
                            <td class="text-center">${shooter.shootingClass}</td>`;

                        for (let i = 1; i <= results.stationCount; i++) {
                            const st = shooter.stations.find(s => s.stationNumber === i);
                            if (st) {
                                let cell = `${st.hits}/${st.figures}`;
                                if (st.tiebreakerScore != null) cell += ` <small>${st.tiebreakerScore}p</small>`;
                                html += `<td class="text-center">${cell}</td>`;
                            } else {
                                html += `<td class="text-center text-muted">-</td>`;
                            }
                        }

                        html += isPoang
                            ? `<td class="text-center fw-bold">${shooter.totalPoints}</td>`
                            : `<td class="text-center fw-bold">${shooter.totalHits}/${shooter.totalFigures}</td>`;
                        html += `<td class="text-center">${shooter.totalTiebreakerScore || ''}</td>`;
                        if (classHasShootOff) {
                            const rounds = Array.isArray(shooter.shootOffRounds) ? shooter.shootOffRounds : [];
                            if (rounds.length > 0) {
                                const tip = rounds.map((t, i) => 'Runda ' + (i + 1) + ': ' + t).join(', ');
                                html += `<td class="text-center" title="${tip}"><strong>${rounds.join(' / ')}</strong></td>`;
                            } else {
                                html += `<td class="text-center text-muted">—</td>`;
                            }
                        }
                        if (faltAwardingMedals) {
                            var stdM = shooter.standardMedal || '';
                            html += `<td class="text-center fw-bold${stdM === 'S' ? ' text-primary' : stdM === 'B' ? ' text-warning' : ''}">${stdM}</td>`;
                        }
                        html += `</tr>`;
                    });

                    html += `</tbody></table>`;

                    // Per-class footnotes from server (e.g. "Särskjutning avgjorde guldet: Anna 5/4 vs Berit 4/3")
                    if (Array.isArray(group.shootOffNotes) && group.shootOffNotes.length > 0) {
                        html += '<div class="text-muted small mt-1 mb-2">';
                        group.shootOffNotes.forEach(note => {
                            const safe = String(note).replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
                            html += `<div><i class="bi bi-info-circle me-1"></i>${safe}</div>`;
                        });
                        html += '</div>';
                    }

                    html += `</div></div>`;
                });

                if (!html) html = '<div class="alert alert-info">Inga resultat att visa.</div>';
                container.innerHTML = html;
            } catch (error) {
                console.error('Error loading Fältskytte results:', error);
                container.innerHTML = `<div class="alert alert-danger"><p>${error.message}</p></div>`;
            }
        }

        // Team results loading
        async function loadTeamResults() {
            const container = document.getElementById('teamResultsContent');
            if (!container) return;

            try {
                const response = await fetch(`/umbraco/surface/CompetitionTeam/GetTeamResults?competitionId=${competitionId}`);
                const data = await response.json();

                if (!data.success || !data.classGroups?.length) {
                    container.innerHTML = `
                        <div class="alert alert-info">
                            <h4 class="alert-heading">Inga lagresultat</h4>
                            <p class="mb-0">Det finns inga lag registrerade för denna tävling ännu.</p>
                        </div>`;
                    return;
                }

                let html = '';
                data.classGroups.forEach(group => {
                    html += `
                        <div class="class-results-section">
                            <div class="class-header">
                                ${group.teamClass} (${group.teams.length} lag)
                            </div>
                            <table class="results-table">
                                <thead>
                                    <tr>
                                        <th>Plats</th>
                                        <th>Lag</th>
                                        <th>Förening</th>
                                        <th>Medlemmar</th>
                                        ${data.isSpringskytte ? '<th>Total tid</th>' : '<th>Poäng</th><th>X</th>'}
                                    </tr>
                                </thead>
                                <tbody>`;

                    group.teams.forEach(team => {
                        const membersHtml = team.members.map(m => {
                            if (!m.hasResult) return `${m.name} (${m.status || 'Inget resultat'})`;
                            if (data.isSpringskytte) return `${m.name} (${m.timeDisplay})`;
                            return `${m.name} (${m.score}p${m.xCount > 0 ? ', ' + m.xCount + 'X' : ''})`;
                        }).join('<br>');

                        const rankDisplay = team.rank > 0 ? team.rank : '-';

                        html += `
                                    <tr${!team.isComplete ? ' class="text-muted"' : ''}>
                                        <td class="text-center">${rankDisplay}</td>
                                        <td><strong>${team.teamName}</strong></td>
                                        <td>${team.clubName}</td>
                                        <td class="small">${membersHtml}</td>
                                        ${data.isSpringskytte
                                            ? `<td class="text-center"><strong>${team.totalTimeDisplay}</strong></td>`
                                            : `<td class="text-center"><strong>${team.totalScore}</strong></td><td class="text-center">${team.totalXCount}</td>`
                                        }
                                    </tr>`;
                    });

                    html += `
                                </tbody>
                            </table>
                        </div>`;
                });

                container.innerHTML = html;
            } catch (error) {
                console.error('Error loading team results:', error);
                container.innerHTML = `
                    <div class="alert alert-danger">
                        <h4>Fel vid laddning av lagresultat</h4>
                        <p>${error.message}</p>
                    </div>`;
            }
        }

        // Load team results when tab is shown
        if (allowTeams) {
            const teamTab = document.getElementById('teamTab');
            if (teamTab) {
                let teamResultsLoaded = false;
                teamTab.addEventListener('shown.bs.tab', () => {
                    if (!teamResultsLoaded) {
                        loadTeamResults();
                        teamResultsLoaded = true;
                    }
                });
            }
        }

        // Stop auto-refresh when page is hidden
        document.addEventListener('visibilitychange', () => {
            if (document.hidden && autoRefreshTimer) {
                clearInterval(autoRefreshTimer);
                autoRefreshTimer = null;
            } else if (!document.hidden && !isOfficialResults && !autoRefreshTimer) {
                autoRefreshTimer = setInterval(loadResults, refreshInterval);
            }
        });
</script>
