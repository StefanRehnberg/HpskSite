@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using Newtonsoft.Json
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Core.Services
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject HpskSite.Services.ClubService ClubService
@{
    Layout = null;
    var competition = Model.Parent; // Competition -> Result (direct child)
    
    // Get properties using Value<T>
    var resultData = Model.Value<string>("resultData") ?? "";
    var lastUpdated = Model.Value<DateTime>("lastUpdated", fallback: Fallback.ToDefaultValue, defaultValue: DateTime.Now);
    var isOfficial = Model.Value<bool>("isOfficial", fallback: Fallback.ToDefaultValue, defaultValue: false);
    
    // Get competition type
    var competitionTypeId = "";
    try { competitionTypeId = competition.Value<string>("competitionType") ?? "Precision"; } catch { competitionTypeId = "Precision"; }
    var isSpringskytte = competitionTypeId == "Springskytte";
    var isFaltskytte = competitionTypeId == "Faltskytte" || competitionTypeId == "MagnumFalt";

    // Team results support
    var allowTeams = false;
    try { allowTeams = competition.Value<bool>("allowTeams"); } catch { }

    // Get competition configuration for finals
    var numberOfSeriesOrStations = 0;
    var numberOfFinalSeries = 0;
    try { numberOfSeriesOrStations = competition.Value<int>("numberOfSeriesOrStations"); } catch { }
    try { numberOfFinalSeries = competition.Value<int>("numberOfFinalSeries"); } catch { }
    
    var hasFinalsRound = numberOfFinalSeries > 0;
    var qualificationSeriesCount = hasFinalsRound ? (numberOfSeriesOrStations - numberOfFinalSeries) : numberOfSeriesOrStations;
    
    // Get current member info for highlighting
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var currentMemberName = currentMember?.Name ?? "";
    var currentMemberClub = "";
    
    if (currentMember != null)
    {
        var memberData = MemberService.GetByEmail(currentMember.Email ?? "");
        if (memberData != null)
        {
            var primaryClubIdStr = memberData.GetValue<string>("primaryClubId");
            if (!string.IsNullOrEmpty(primaryClubIdStr) && int.TryParse(primaryClubIdStr, out int primaryClubId))
            {
                currentMemberClub = ClubService.GetClubNameById(primaryClubId) ?? "";
            }
        }
    }
}

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Name - @competition.Name</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { padding: 20px; background-color: #f8f9fa; font-family: Arial, sans-serif; }
        .print-only { display: none; }
        
        /* Plain table styling like start lists */
        .results-table {
            font-size: 11px;
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
            background: white;
        }
        
        .results-table th,
        .results-table td {
            padding: 3px 6px;
            border: 1px solid #ddd;
            text-align: left;
            line-height: 1.2;
            white-space: nowrap;
        }
        
        .results-table th {
            background-color: #f5f5f5;
            font-weight: bold;
            font-size: 10px;
            text-align: center;
        }
        
        .results-table td {
            font-size: 11px;
        }
        
        .results-table .text-center {
            text-align: center;
        }
        
        .results-table .text-right {
            text-align: right;
        }
        
        /* Class header styling */
        .class-header {
            background-color: #e9ecef;
            padding: 8px 12px;
            margin: 20px 0 5px 0;
            border-left: 4px solid #007bff;
            font-weight: bold;
            font-size: 14px;
        }
        
        /* Compact spacing */
        .class-results-section {
            margin-bottom: 25px;
        }
        
        /* User highlighting */
        .current-user { background-color: #cce5ff !important; } /* Light blue for current user */
        .same-club { background-color: #f0f8ff !important; } /* Very light blue for same club */
        
        .x-count { color: #dc3545; font-size: 9px; }

        /* Grouped sub-total columns (Milsnabb, Nationell Helmatch) */
        .results-table .subtotal-col {
            border-left: 2px solid #999;
            font-weight: bold;
        }
        .results-table th.subtotal-col {
            background-color: #e8e8e8;
        }

        /* Individual series columns (Milsnabb, Nationell Helmatch) - hide on mobile */
        .results-table .milsnabb-series {
            /* visible by default on desktop */
        }
        @@media (max-width: 767.98px) {
            .results-table .milsnabb-series { display: none; }
        }

        @@media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background-color: white; padding: 0; font-size: 10px; }
            .results-table { font-size: 9px; }
            .results-table th, .results-table td { padding: 2px 4px; }
            .class-header { font-size: 12px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <div>
                <h1>
                        <i class="bi bi-trophy text-warning me-2"></i>
                                @Model.Name
                </h1>
                <p class="text-muted mb-0">@competition.Name</p>
                            </div>
                        <div>
                <button class="btn btn-outline-secondary" onclick="window.print()">
                                <i class="bi bi-printer me-1"></i>Skriv ut
                            </button>
                            </div>
                        </div>

        <!-- Print Header -->
        <div class="print-only mb-4">
            <h1>@Model.Name</h1>
            <h2>@competition.Name</h2>
            <p><strong>Datum:</strong> @lastUpdated.ToString("yyyy-MM-dd HH:mm")</p>
            <p><strong>Status:</strong> @(isOfficial ? "Officiellt" : "Preliminärt")</p>
            <hr>
                    </div>

        @if (allowTeams)
        {
            <!-- Tab navigation for Individual/Team results -->
            <ul class="nav nav-tabs mb-3 no-print" id="resultsTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="individualTab" data-bs-toggle="tab" data-bs-target="#individualResults" type="button" role="tab">
                        <i class="bi bi-person me-1"></i>Individuellt
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="teamTab" data-bs-toggle="tab" data-bs-target="#teamResults" type="button" role="tab">
                        <i class="bi bi-people-fill me-1"></i>Lagresultat
                    </button>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="individualResults" role="tabpanel">
                    <div id="resultsContent">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Laddar resultat...</span>
                            </div>
                            <p class="mt-2">Laddar resultat...</p>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="teamResults" role="tabpanel">
                    <div id="teamResultsContent">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Laddar lagresultat...</span>
                            </div>
                            <p class="mt-2">Laddar lagresultat...</p>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Results Content (no teams) -->
            <div id="resultsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Laddar resultat...</span>
                    </div>
                    <p class="mt-2">Laddar resultat...</p>
                </div>
            </div>
        }
        </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<script>
    // Get competition ID from the URL or parent
    const competitionId = @(competition?.Id ?? 0);
    const refreshInterval = 15000; // 15 seconds
    let autoRefreshTimer = null;
    let isOfficialResults = false;
    
    // Finals configuration
    const hasFinalsRound = @(hasFinalsRound.ToString().ToLower());
    const qualificationSeriesCount = @qualificationSeriesCount;
    const numberOfFinalSeries = @numberOfFinalSeries;
    const totalSeriesCount = @numberOfSeriesOrStations;
    
    // Competition type
    const isSpringskytte = @(isSpringskytte.ToString().ToLower());
    const isFaltskytte = @(isFaltskytte.ToString().ToLower());

    // Team results
    const allowTeams = @(allowTeams.ToString().ToLower());

    // Current user info for highlighting
    const currentUserName = '@Html.Raw(currentMemberName.Replace("'", "\\'"))';
    const currentUserClub = '@Html.Raw(currentMemberClub.Replace("'", "\\'"))';
        
        // Fetch and display results
        async function loadResults() {
            const container = document.getElementById('resultsContent');

            // Springskytte uses its own endpoint and rendering
            if (isSpringskytte) {
                await loadSpringskytteResults(container);
                return;
            }

            // Fältskytte uses its own endpoint and rendering
            if (isFaltskytte) {
                await loadFaltskytteResults(container);
                return;
            }

            try {
                const response = await fetch(`/umbraco/surface/CompetitionResults/GetResultsList?competitionId=${competitionId}`);
                const data = await response.json();
                
                if (!data.success || !data.exists) {
                    container.innerHTML = `
                            <div class="alert alert-info">
                                <h4 class="alert-heading">Inga resultat ännu</h4>
                            <p class="mb-0">Det finns inga registrerade resultat för denna tävling ännu. Resultat visas automatiskt här när domare börjar registrera skjutresultat.</p>
                            </div>
                    `;
                    return;
                }
                
                isOfficialResults = data.isOfficial;
                const results = data.results;
                const isAwardingStandardMedals = data.isAwardingStandardMedals || false;
                const competitionTypeId = data.competitionTypeId || 'Precision';
                const isMilsnabb = competitionTypeId === 'Milsnabb';
                const isNationellHelmatch = competitionTypeId === 'NationellHelmatch';
                const isGrouped12 = isMilsnabb || isNationellHelmatch;

                // Build HTML for results
                let html = '';

                if (results.classGroups && results.classGroups.length > 0) {
                    results.classGroups.forEach(classGroup => {
                        // Class header
                        html += `
                            <div class="class-results-section">
                                <div class="class-header">
                                    ${classGroup.className} (${classGroup.shooters.length} deltagare)
                                </div>
                                <table class="results-table">
                                    <thead>
                                        <tr>
                                            <th>Plats</th>
                                            <th>Namn</th>
                                            <th>Förening</th>
                                            <th>Klass</th>
                        `;

                        // Add series columns based on competition type
                        if (isGrouped12) {
                            // 12 series in 3 groups of 4 with subtotals
                            const groupHeaders = isNationellHelmatch
                                ? ['Prec', 'Duell', 'Fält']
                                : ['10s', '8s', '6s'];
                            for (let g = 0; g < 3; g++) {
                                for (let i = g*4+1; i <= g*4+4; i++) html += `<th class="milsnabb-series">${i}</th>`;
                                html += `<th class="subtotal-col">${groupHeaders[g]}</th>`;
                            }
                        } else if (classGroup.shooters.length > 0 && classGroup.shooters[0].results) {
                            const seriesCount = classGroup.shooters[0].results.length;

                            if (hasFinalsRound && seriesCount >= totalSeriesCount) {
                                for (let i = 1; i <= qualificationSeriesCount; i++) {
                                    html += `<th>${i}</th>`;
                                }
                                html += `<th>Tot</th>`;
                                for (let i = 1; i <= numberOfFinalSeries; i++) {
                                    html += `<th>F${i}</th>`;
                                }
                            } else {
                                for (let i = 1; i <= seriesCount; i++) {
                                    html += `<th>${i}</th>`;
                                }
                            }
                        }

                        html += `
                                            <th>Tot</th>
                                            <th>X</th>
                        `;

                        if (isAwardingStandardMedals) {
                            html += `<th>S</th>`;
                        }

                        html += `
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;

                        // Add shooters
                        classGroup.shooters.forEach((shooter, index) => {
                            const position = index + 1;
                            let totalScore = 0;
                            let totalXCount = 0;
                            let qualificationScore = 0;

                            // Calculate series scores
                            const seriesScores = [];
                            shooter.results.forEach(result => {
                                const shots = JSON.parse(result.shots);
                                let score = 0;
                                let xCount = 0;
                                shots.forEach(shot => {
                                    score += (shot === 'X' ? 10 : parseInt(shot));
                                    if (shot === 'X') xCount++;
                                });
                                seriesScores.push({score, xCount});
                                totalScore += score;
                                totalXCount += xCount;
                            });

                            // Row styling
                            let rowClass = '';
                            if (currentUserName && shooter.name === currentUserName) {
                                rowClass = 'current-user';
                            } else if (currentUserClub && shooter.club === currentUserClub) {
                                rowClass = 'same-club';
                            }

                            html += `
                                <tr class="${rowClass}">
                                    <td class="text-center">${position}</td>
                                    <td>${shooter.name}</td>
                                    <td>${shooter.club}</td>
                                    <td class="text-center">${shooter.shootingClass || classGroup.className}</td>
                            `;

                            // Add series scores based on competition type
                            if (isGrouped12) {
                                // 12 series in 3 groups of 4 with subtotals
                                const groups = [[0,4],[4,8],[8,12]];
                                groups.forEach(([start, end]) => {
                                    let groupTotal = 0;
                                    for (let i = start; i < end; i++) {
                                        const s = i < seriesScores.length ? seriesScores[i].score : 0;
                                        groupTotal += s;
                                        html += `<td class="text-center milsnabb-series">${i < seriesScores.length ? s : '-'}</td>`;
                                    }
                                    html += `<td class="text-center subtotal-col">${groupTotal}</td>`;
                                });
                            } else if (hasFinalsRound && seriesScores.length >= totalSeriesCount) {
                                for (let i = 0; i < qualificationSeriesCount; i++) {
                                    html += `<td class="text-center">${i < seriesScores.length ? seriesScores[i].score : '-'}</td>`;
                                }
                                qualificationScore = seriesScores.slice(0, qualificationSeriesCount).reduce((sum, s) => sum + s.score, 0);
                                html += `<td class="text-center"><strong>${qualificationScore}</strong></td>`;
                                for (let i = qualificationSeriesCount; i < totalSeriesCount; i++) {
                                    html += `<td class="text-center">${i < seriesScores.length ? seriesScores[i].score : '-'}</td>`;
                                }
                            } else {
                                seriesScores.forEach(s => {
                                    html += `<td class="text-center">${s.score}</td>`;
                                });
                            }

                            html += `
                                    <td class="text-center"><strong>${totalScore}</strong></td>
                                    <td class="text-center">${totalXCount}</td>
                            `;

                            if (isAwardingStandardMedals) {
                                const medal = shooter.standardMedal || '';
                                html += `<td class="text-center"><strong>${medal}</strong></td>`;
                            }

                            html += `
                                </tr>
                            `;
                        });

                        html += `
                                    </tbody>
                                </table>
                            </div>
                        `;
                    });
                    
                    container.innerHTML = html;
                    
                    // Setup auto-refresh for preliminary results
                    if (!isOfficialResults && !autoRefreshTimer) {
                        console.log('Preliminary results - enabling auto-refresh');
                        autoRefreshTimer = setInterval(loadResults, refreshInterval);
                    }
                } else {
                    container.innerHTML = `
                        <div class="alert alert-warning">
                            <h4 class="alert-heading">Ingen resultatdata tillgänglig</h4>
                            <p class="mb-0">Resultatdata finns men kunde inte formateras korrekt.</p>
                    </div>
                    `;
                }
            } catch (error) {
                console.error('Error loading results:', error);
                container.innerHTML = `
                    <div class="alert alert-danger">
                        <h4 class="alert-heading">Fel vid laddning av resultat</h4>
                        <p class="mb-0">${error.message}</p>
                </div>
                `;
            }
        }
        
        // Load results when page loads
        document.addEventListener('DOMContentLoaded', loadResults);
        
        // Springskytte results rendering
        async function loadSpringskytteResults(container) {
            try {
                const response = await fetch(`/umbraco/surface/Springskytte/GetSpringskytteResults?competitionId=${competitionId}`);
                const data = await response.json();

                if (!data.success || !data.classGroups?.length) {
                    container.innerHTML = `
                        <div class="alert alert-info">
                            <h4 class="alert-heading">Inga resultat ännu</h4>
                            <p class="mb-0">Det finns inga registrerade resultat för denna tävling ännu.</p>
                        </div>`;
                    return;
                }

                let html = '';
                data.classGroups.forEach(group => {
                    html += `
                        <div class="class-results-section">
                            <div class="class-header">
                                ${group.className} (${group.shooters.length} deltagare)
                            </div>
                            <table class="results-table">
                                <thead>
                                    <tr>
                                        <th>Plats</th>
                                        <th>Namn</th>
                                        <th>Förening</th>
                                        <th>Löptid</th>
                                        <th>Skjutp.</th>
                                        <th>Tillägg</th>
                                        <th>Sluttid</th>
                                        <th>Medalj</th>
                                    </tr>
                                </thead>
                                <tbody>`;

                    group.shooters.forEach(s => {
                        let rowClass = '';
                        if (currentUserName && s.name === currentUserName) rowClass = 'current-user';
                        else if (currentUserClub && s.club === currentUserClub) rowClass = 'same-club';

                        const medal = s.standardMedal === 'S' ? '<strong>S</strong>'
                            : s.standardMedal === 'B' ? '<strong>B</strong>' : '';

                        html += `
                                    <tr class="${rowClass}">
                                        <td class="text-center">${s.status || s.rank || '-'}</td>
                                        <td>${s.name}</td>
                                        <td>${s.club}</td>
                                        <td class="text-center">${s.sprintTimeDisplay || '-'}</td>
                                        <td class="text-center">${s.shootingScore ?? '-'}</td>
                                        <td class="text-center">${s.penaltyTimeDisplay || '-'}</td>
                                        <td class="text-center"><strong>${s.totalTimeDisplay || '-'}</strong></td>
                                        <td class="text-center">${medal}</td>
                                    </tr>`;
                    });

                    html += `
                                </tbody>
                            </table>
                        </div>`;
                });

                container.innerHTML = html;

                // Auto-refresh for live results
                if (!autoRefreshTimer) {
                    autoRefreshTimer = setInterval(loadResults, refreshInterval);
                }
            } catch (error) {
                console.error('Error loading Springskytte results:', error);
                container.innerHTML = `
                    <div class="alert alert-danger">
                        <h4>Fel vid laddning av resultat</h4>
                        <p>${error.message}</p>
                    </div>`;
            }
        }

        // Fältskytte results rendering
        async function loadFaltskytteResults(container) {
            try {
                const response = await fetch(`/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=${competitionId}`);
                const data = await response.json();

                if (!data.success) {
                    container.innerHTML = `<div class="alert alert-info">${data.message || 'Inga resultat.'}</div>`;
                    return;
                }

                const results = data.results;
                const isPoang = results.scoringMode === 'Poang';
                let html = '';

                results.classGroups.forEach(group => {
                    html += `<div class="mb-4">`;
                    html += `<h4 class="border-bottom pb-2">${group.className} <small class="text-muted">(${group.shooters.length} deltagare)</small></h4>`;
                    html += `<div class="table-responsive"><table class="table table-sm table-hover">`;
                    html += `<thead class="table-light"><tr>
                        <th style="width:50px" class="text-center">Plats</th>
                        <th>Namn</th><th>Förening</th><th>Klass</th>`;

                    for (let i = 1; i <= results.stationCount; i++) {
                        const cfg = results.stationConfigs.find(s => s.station === i);
                        html += `<th class="text-center">${i}${cfg?.hasPoangmal ? '*' : ''}</th>`;
                    }

                    html += isPoang
                        ? `<th class="text-center fw-bold">Poäng</th>`
                        : `<th class="text-center fw-bold">Tot</th>`;
                    html += `<th class="text-center">Pm</th></tr></thead><tbody>`;

                    group.shooters.forEach((shooter, idx) => {
                        const isCurrentUser = shooter.name === currentUserName;
                        const rowClass = isCurrentUser ? 'table-info fw-bold' : '';
                        html += `<tr class="${rowClass}">
                            <td class="text-center">${idx + 1}</td>
                            <td>${shooter.name}</td>
                            <td>${shooter.club}</td>
                            <td class="text-center">${shooter.shootingClass}</td>`;

                        for (let i = 1; i <= results.stationCount; i++) {
                            const st = shooter.stations.find(s => s.stationNumber === i);
                            if (st) {
                                let cell = `${st.hits}/${st.figures}`;
                                if (st.tiebreakerScore != null) cell += ` <small>${st.tiebreakerScore}p</small>`;
                                html += `<td class="text-center">${cell}</td>`;
                            } else {
                                html += `<td class="text-center text-muted">-</td>`;
                            }
                        }

                        html += isPoang
                            ? `<td class="text-center fw-bold">${shooter.totalPoints}</td>`
                            : `<td class="text-center fw-bold">${shooter.totalHits}/${shooter.totalFigures}</td>`;
                        html += `<td class="text-center">${shooter.totalTiebreakerScore || ''}</td>`;
                        html += `</tr>`;
                    });

                    html += `</tbody></table></div></div>`;
                });

                if (!html) html = '<div class="alert alert-info">Inga resultat att visa.</div>';
                container.innerHTML = html;
            } catch (error) {
                console.error('Error loading Fältskytte results:', error);
                container.innerHTML = `<div class="alert alert-danger"><p>${error.message}</p></div>`;
            }
        }

        // Team results loading
        async function loadTeamResults() {
            const container = document.getElementById('teamResultsContent');
            if (!container) return;

            try {
                const response = await fetch(`/umbraco/surface/CompetitionTeam/GetTeamResults?competitionId=${competitionId}`);
                const data = await response.json();

                if (!data.success || !data.classGroups?.length) {
                    container.innerHTML = `
                        <div class="alert alert-info">
                            <h4 class="alert-heading">Inga lagresultat</h4>
                            <p class="mb-0">Det finns inga lag registrerade för denna tävling ännu.</p>
                        </div>`;
                    return;
                }

                let html = '';
                data.classGroups.forEach(group => {
                    html += `
                        <div class="class-results-section">
                            <div class="class-header">
                                ${group.teamClass} (${group.teams.length} lag)
                            </div>
                            <table class="results-table">
                                <thead>
                                    <tr>
                                        <th>Plats</th>
                                        <th>Lag</th>
                                        <th>Förening</th>
                                        <th>Medlemmar</th>
                                        ${data.isSpringskytte ? '<th>Total tid</th>' : '<th>Poäng</th><th>X</th>'}
                                    </tr>
                                </thead>
                                <tbody>`;

                    group.teams.forEach(team => {
                        const membersHtml = team.members.map(m => {
                            if (!m.hasResult) return `${m.name} (${m.status || 'Inget resultat'})`;
                            if (data.isSpringskytte) return `${m.name} (${m.timeDisplay})`;
                            return `${m.name} (${m.score}p${m.xCount > 0 ? ', ' + m.xCount + 'X' : ''})`;
                        }).join('<br>');

                        const rankDisplay = team.rank > 0 ? team.rank : '-';

                        html += `
                                    <tr${!team.isComplete ? ' class="text-muted"' : ''}>
                                        <td class="text-center">${rankDisplay}</td>
                                        <td><strong>${team.teamName}</strong></td>
                                        <td>${team.clubName}</td>
                                        <td class="small">${membersHtml}</td>
                                        ${data.isSpringskytte
                                            ? `<td class="text-center"><strong>${team.totalTimeDisplay}</strong></td>`
                                            : `<td class="text-center"><strong>${team.totalScore}</strong></td><td class="text-center">${team.totalXCount}</td>`
                                        }
                                    </tr>`;
                    });

                    html += `
                                </tbody>
                            </table>
                        </div>`;
                });

                container.innerHTML = html;
            } catch (error) {
                console.error('Error loading team results:', error);
                container.innerHTML = `
                    <div class="alert alert-danger">
                        <h4>Fel vid laddning av lagresultat</h4>
                        <p>${error.message}</p>
                    </div>`;
            }
        }

        // Load team results when tab is shown
        if (allowTeams) {
            const teamTab = document.getElementById('teamTab');
            if (teamTab) {
                let teamResultsLoaded = false;
                teamTab.addEventListener('shown.bs.tab', () => {
                    if (!teamResultsLoaded) {
                        loadTeamResults();
                        teamResultsLoaded = true;
                    }
                });
            }
        }

        // Stop auto-refresh when page is hidden
        document.addEventListener('visibilitychange', () => {
            if (document.hidden && autoRefreshTimer) {
                clearInterval(autoRefreshTimer);
                autoRefreshTimer = null;
            } else if (!document.hidden && !isOfficialResults && !autoRefreshTimer) {
                autoRefreshTimer = setInterval(loadResults, refreshInterval);
            }
        });
</script>
            </body>
            </html>
