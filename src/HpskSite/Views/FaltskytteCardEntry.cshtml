@using HpskSite.Controllers
@model FaltskytteCardEntryPageModel
@{
    // Sekretariatets kortinmatning (/kortinmatning/{id}). Staff-grindad, chromeless, full bredd, öppnas i ny flik
    // från Stationer-fliken. Statusvy (alla patruller) och kortvy (en patrull: skyttar x stationer) i samma sida.
    // Sparar via /umbraco/surface/FaltskytteCardEntry/SaveCard (egen väg, rör inte SaveStationResult).
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <title>Kortinmatning@(string.IsNullOrEmpty(Model.CompetitionName) ? "" : " — " + Model.CompetitionName)</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #f5f6f8; }
        /* Kortet ska rymmas i bredd utan sidscroll: fast tabelllayout, stationskolumnerna delar på resten. */
        .ke-grid { table-layout: fixed; width: 100%; }
        .ke-grid th, .ke-grid td { padding-left: .35rem; padding-right: .35rem; vertical-align: top; }
        .ke-grid th.st { text-align: center; vertical-align: bottom; font-size: 13px; }
        .ke-grid th.st small { display: block; font-weight: 400; font-size: 11px; line-height: 1.2; }
        .ke-grid th.nm, .ke-grid td.nm { width: 168px; }
        .ke-grid th.sm { width: 64px; text-align: center; }
        .ke-grid th.rs { width: 92px; }
        .ke-grid tr.ke-dns td { background: #eceff3; color: #6c757d; }
        .ke-cell { width: 100%; padding-left: 2px; padding-right: 2px; font-variant-numeric: tabular-nums; }
        .ke-pmrow { display: flex; gap: 3px; align-items: center; margin-top: 4px; }
        .ke-pmlab { font-size: 11px; color: #6c757d; margin-right: 1px; }
        .ke-pm { flex: 1 1 0; min-width: 0; width: 100%; padding-left: 2px; padding-right: 2px; border-style: dashed; }
        .ke-msg { font-size: 11.5px; min-height: 16px; line-height: 1.25; white-space: normal; overflow-wrap: anywhere; margin-top: 2px; }
        .ke-msg .btn { font-size: 11.5px; padding: 1px 6px; margin-top: 3px; white-space: normal; text-align: left; }
        .ke-cell.ke-saved { border-color: #198754; }
        .ke-cell.ke-dirty { border-color: #ffc107; background: #fffbea; }
        .ke-cell.ke-conflict { border-color: #dc3545; background: #fdecea; }
        .ke-sum { font-weight: 700; text-align: center; font-variant-numeric: tabular-nums; white-space: nowrap; }
        .ke-rowstate { font-size: 12px; color: #6c757d; }
        .ke-scroll { overflow-x: auto; }
        #keStatus td, #keStatus th { white-space: nowrap; }
    </style>
    @await Html.PartialAsync("_ShootingClassesBootstrap")
</head>
<body>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3 border-bottom pb-2">
        <div>
            <div class="small text-uppercase text-muted" style="letter-spacing:.06em">Tävlingshantering</div>
            <h2 class="mb-0"><i class="bi bi-ui-checks-grid me-2"></i>Kortinmatning</h2>
            <div class="text-muted">@Model.CompetitionName · mata in patrullernas papperskort</div>
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span id="keConn" class="badge bg-secondary" title="Anslutning"><i class="bi bi-wifi"></i></span>
            <a class="btn btn-outline-secondary btn-sm" href="/competitionmanagement?competitionId=@Model.CompetitionId">Tillbaka till tävlingen</a>
        </div>
    </div>

    @if (!Model.CanEnter)
    {
        <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Du har inte behörighet till kortinmatningen. Logga in med ett konto som är funktionär på tävlingen.</div>
    }
    else
    {
        @Html.AntiForgeryToken()
        <div id="keBanner"></div>

        @* ===== Statusvy ===== *@
        <section id="keStatusView">
            <div class="alert alert-info py-2">
                <i class="bi bi-info-circle me-1"></i>
                Skriv av kortet så som det står: <strong>2+1+2</strong> (träffar per figur) eller <strong>5/3</strong> (5 träff i 3 figurer).
                Resultatlistan ändras först när du trycker <em>Uppdatera</em> under Resultat.
            </div>
            <div class="card mb-3">
                <div class="card-body py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <strong><i class="bi bi-slash-circle me-1"></i>Stationsinmatningen</strong>
                        <span id="keLockState" class="badge bg-secondary ms-1">…</span>
                        <div class="text-muted small">När sekretariatet matar in korten bör stationssidorna (<code>/station</code>) vara stängda, så ingen skriver över ett inmatat kort av misstag.</div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm" id="keLockBtn">…</button>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between flex-wrap gap-2 mb-2">
                        <div class="btn-group btn-group-sm" id="keFilters" role="group" aria-label="Filter">
                            <button type="button" class="btn btn-primary" data-f="all">Alla</button>
                            <button type="button" class="btn btn-outline-primary" data-f="none">Ej inmatade</button>
                            <button type="button" class="btn btn-outline-primary" data-f="prog">Pågår</button>
                            <button type="button" class="btn btn-outline-primary" data-f="done">Klara</button>
                        </div>
                        <div class="d-flex gap-2 align-items-center">
                            <span class="text-muted small" id="keCount"></span>
                            <button type="button" class="btn btn-primary btn-sm" id="keNext"><i class="bi bi-arrow-right-circle me-1"></i>Mata in nästa kort</button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0" id="keStatus">
                            <thead class="table-light"><tr>
                                <th>Patrull</th><th>Vapengrupp</th><th class="text-center">Skyttar</th><th class="text-center">Stationer inmatade</th>
                                <th>Läge</th><th>Senast ändrad av</th><th></th>
                            </tr></thead>
                            <tbody><tr><td colspan="7" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm"></span> Laddar…</td></tr></tbody>
                        </table>
                    </div>
                    <div class="text-muted small mt-2">Läget räknas ur raderna som finns: inga rader = ej inmatad, några = pågår, alla stationer för alla skyttar = klar.</div>
                </div>
            </div>
        </section>

        @* ===== Kortvy ===== *@
        <section id="keCardView" class="d-none">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <div>
                    <button type="button" class="btn btn-link p-0" id="keBack">← Alla patruller</button>
                    <h3 class="mb-0" id="keCardTitle">Patrull</h3>
                    <div class="text-muted" id="keCardSub"></div>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span id="keStamp" class="small text-muted"></span>
                    <button type="button" class="btn btn-primary" id="keSaveAll"><i class="bi bi-check2-circle me-1"></i>Spara kortet</button>
                </div>
            </div>
            <div id="keCardBanner"></div>
            <div class="card mb-3">
                <div class="card-body">
                    <div class="small text-muted mb-2">
                        Tom ruta = ej inmatad · <strong>0/0</strong> = skjutit utan träff · på poängstationer finns även rutor för <strong>Poäng</strong> under träffarna ·
                        Enter, Tab eller → = nästa ruta · ← = föregående · ↑ ↓ = annan skytt. Rutan sparas när du lämnar den.
                    </div>
                    <div class="ke-scroll"><table class="table table-sm align-middle ke-grid mb-0" id="keGrid"></table></div>
                </div>
            </div>
            <div class="card mb-3">
                <div class="card-header py-2 fw-bold">Kontroll innan kortet är klart</div>
                <div class="card-body py-2"><ul class="mb-0" id="keWarns"></ul></div>
            </div>
            <div class="text-muted small">Saknas en skytt på kortet eller står hen inte i patrullen? Lägg till hen i patrullen under Startlistor först. Skyttar markerade DNS går inte att mata in.</div>
        </section>
    }
</div>

@if (Model.CanEnter)
{
<script>
(function () {
    var COMP = @Model.CompetitionId;
    var POLL = 15000;
    var $ = function (s) { return document.querySelector(s); };
    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function token() { var el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
    function setConn(ok) { var e = $('#keConn'); if (e) e.className = 'badge ' + (ok ? 'bg-success' : 'bg-danger'); }
    function hhmm(d) { try { return new Date(d).toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' }); } catch (e) { return ''; } }
    function nowHm() { return new Date().toLocaleTimeString('sv-SE', { hour: '2-digit', minute: '2-digit' }); }
    function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function lsSet(k, v) { try { if (v == null) localStorage.removeItem(k); else localStorage.setItem(k, v); } catch (e) { } }

    // ───────── parsning av en ruta ─────────
    // "2+1+2" = träffar per figur. "5/3" = 5 träff i 3 figurer (fördelning okänd). "2+1+2 5/3" = båda, måste stämma.
    function parseCell(text, slots, maxPer) {
        var t = (text || '').trim();
        if (t === '') return { empty: true };
        t = t.replace(/\s*\+\s*/g, '+').replace(/\s*\/\s*/g, '/');
        var m;
        function checkFig(txt) {
            var arr = txt.split('+').map(function (x) { return parseInt(x, 10); });
            if (arr.length !== slots) return { error: 'Stationen har ' + slots + (slots === 1 ? ' figur' : ' figurer') + ', du skrev ' + arr.length + ' värden.' };
            if (arr.some(function (v) { return v > maxPer; })) return { error: 'Högst ' + maxPer + ' träff per figur.' };
            var sum = arr.reduce(function (a, b) { return a + b; }, 0);
            if (sum > 6) return { error: 'Högst 6 träff per station.' };
            return { mode: 'fig', arr: arr, hits: sum, figs: arr.filter(function (v) { return v > 0; }).length };
        }
        function checkTot(h, f) {
            if (h > 6) return { error: 'Högst 6 träff per station.' };
            if (f > slots) return { error: 'Stationen har ' + slots + (slots === 1 ? ' figur' : ' figurer') + '.' };
            if (f > h) return { error: 'Fler figurer än träffar.' };
            if (h > 0 && f === 0) return { error: 'Träffar utan träffad figur.' };
            if (h > f * maxPer) return { error: 'Högst ' + maxPer + ' träff per figur.' };
            return { mode: 'tot', hits: h, figs: f };
        }
        if ((m = /^(\d+(?:\+\d+)*)$/.exec(t))) return checkFig(m[1]);
        if ((m = /^(\d+)\/(\d+)$/.exec(t))) return checkTot(parseInt(m[1], 10), parseInt(m[2], 10));
        if ((m = /^(\d+(?:\+\d+)*)[\s.;:,\-]+(\d+)\/(\d+)$/.exec(t))) {
            var r = checkFig(m[1]);
            if (r.error) return r;
            if (r.hits !== parseInt(m[2], 10) || r.figs !== parseInt(m[3], 10)) return { error: 'Siffrorna stämmer inte: ' + m[1] + ' blir ' + r.hits + '/' + r.figs + '.' };
            return r;
        }
        return { error: 'Skriv 2+1+2 eller 5/3.' };
    }
    function describe(p) {
        if (p.empty || p.error) return '';
        return p.hits + ' träff i ' + p.figs + (p.figs === 1 ? ' figur' : ' figurer') + (p.mode === 'tot' ? ' (fördelning okänd)' : '');
    }
    function rowToText(r) {
        if (!r) return '';
        if (r.hitsPerFigure && r.hitsPerFigure.length) return r.hitsPerFigure.join('+');
        return r.hits + '/' + r.figures;
    }
    function pmToStrings(r, n) { var o = []; for (var i = 0; i < n; i++) { var v = r && r.poangmalScores ? r.poangmalScores[i] : null; o.push(v == null ? '' : String(v)); } return o; }

    // ───────── statusvy ─────────
    var filter = 'all', statusData = null, statusTimer = null;
    var LABEL = { none: 'Ej inmatad', prog: 'Pågår', done: 'Klar' };
    var BADGE = { none: 'bg-secondary', prog: 'bg-warning text-dark', done: 'bg-success' };

    function loadStatus() {
        return fetch('/umbraco/surface/FaltskytteCardEntry/Status?competitionId=' + COMP)
            .then(function (r) { return r.json(); })
            .then(function (d) { setConn(true); if (!d.success) { $('#keBanner').innerHTML = '<div class="alert alert-danger">' + esc(d.message) + '</div>'; return; } statusData = d; drawLock(); drawStatus(); })
            .catch(function () { setConn(false); });
    }
    function drawLock() {
        var on = !!(statusData && statusData.stationEntryLocked);
        $('#keLockState').className = 'badge ms-1 ' + (on ? 'bg-danger' : 'bg-success');
        $('#keLockState').textContent = on ? 'Stängd' : 'Öppen';
        $('#keLockBtn').textContent = on ? 'Öppna stationsinmatningen igen' : 'Stäng stationsinmatningen';
        $('#keLockBtn').className = 'btn btn-sm ' + (on ? 'btn-outline-success' : 'btn-outline-danger');
    }
    $('#keLockBtn').addEventListener('click', function () {
        var want = !(statusData && statusData.stationEntryLocked);
        $('#keLockBtn').disabled = true;
        fetch('/umbraco/surface/FaltskytteCardEntry/SetStationEntryLock', {
            method: 'POST', headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
            body: JSON.stringify({ competitionId: COMP, locked: want })
        }).then(function (r) { return r.json(); }).then(function (d) {
            $('#keLockBtn').disabled = false;
            if (!d.success) { $('#keBanner').innerHTML = '<div class="alert alert-danger">' + esc(d.message) + '</div>'; return; }
            statusData.stationEntryLocked = d.locked; drawLock();
            $('#keBanner').innerHTML = '<div class="alert alert-success py-2">' + (d.locked ? 'Stationsinmatningen är stängd. Stationssidorna sparar inte längre resultat.' : 'Stationsinmatningen är öppen igen.') + '</div>';
        }).catch(function () { $('#keLockBtn').disabled = false; setConn(false); });
    });
    function drawStatus() {
        if (!statusData) return;
        var tb = $('#keStatus tbody'), shown = 0, html = '';
        statusData.patrols.forEach(function (p) {
            if (filter !== 'all' && p.state !== filter) return;
            shown++;
            html += '<tr><td><strong>Patrull ' + p.patrolNumber + '</strong></td><td>' + esc(p.weaponGroup || '') + '</td>' +
                '<td class="text-center">' + p.shooters + (p.dns ? ' <span class="text-muted small">(+' + p.dns + ' DNS)</span>' : '') + '</td>' +
                '<td class="text-center">' + p.stationsDone + ' av ' + p.stationsTotal + '</td>' +
                '<td><span class="badge ' + BADGE[p.state] + '">' + LABEL[p.state] + '</span></td>' +
                '<td>' + (p.lastBy ? esc(p.lastBy) + ' <span class="text-muted small">' + hhmm(p.lastModified) + '</span>' : '<span class="text-muted">—</span>') + '</td>' +
                '<td class="text-end"><a class="btn btn-sm ' + (p.state === 'done' ? 'btn-outline-secondary' : 'btn-primary') + '" href="#patrull=' + p.patrolNumber + '">' + (p.state === 'done' ? 'Öppna' : 'Mata in') + '</a></td></tr>';
        });
        tb.innerHTML = html || '<tr><td colspan="7" class="text-center text-muted py-3">Inga patruller i det här filtret.</td></tr>';
        $('#keCount').textContent = 'Visar ' + shown + ' av ' + statusData.patrols.length;
    }
    $('#keFilters').addEventListener('click', function (e) {
        var b = e.target.closest('[data-f]'); if (!b) return; filter = b.dataset.f;
        document.querySelectorAll('#keFilters button').forEach(function (x) { x.className = 'btn ' + (x === b ? 'btn-primary' : 'btn-outline-primary'); });
        drawStatus();
    });
    $('#keNext').addEventListener('click', function () {
        if (!statusData) return;
        var p = statusData.patrols.filter(function (x) { return x.state !== 'done'; })[0];
        if (p) location.hash = '#patrull=' + p.patrolNumber;
    });

    // ───────── kortvy ─────────
    var card = null, patrolNo = 0, cells = {}, pollTimer = null, saveChain = Promise.resolve(), me = 0, draftKey = '';

    function key(mid, st) { return mid + '|' + st; }
    function shooterOf(mid) { return card.shooters.filter(function (s) { return s.memberId === mid; })[0]; }
    function stationOf(sh, n) { return sh.stations.filter(function (s) { return s.station === n; })[0]; }
    function allStationNumbers() {
        var set = {};
        card.shooters.forEach(function (s) { s.stations.forEach(function (st) { set[st.station] = st; }); });
        return Object.keys(set).map(Number).sort(function (a, b) { return a - b; }).map(function (n) { return set[n]; });
    }

    function openPatrol(n) {
        patrolNo = n; cells = {}; card = null;
        $('#keStatusView').classList.add('d-none'); $('#keCardView').classList.remove('d-none');
        $('#keCardTitle').textContent = 'Patrull ' + n; $('#keCardSub').textContent = 'Laddar…'; $('#keGrid').innerHTML = ''; $('#keCardBanner').innerHTML = '';
        $('#keStamp').textContent = '';
        draftKey = 'hpsk_kortinmatning_' + COMP + '_' + n;
        clearInterval(statusTimer); clearInterval(pollTimer);
        fetchCard(true);
        pollTimer = setInterval(function () { fetchCard(false); }, POLL);
    }
    function closePatrol() {
        clearInterval(pollTimer); card = null;
        $('#keCardView').classList.add('d-none'); $('#keStatusView').classList.remove('d-none');
        loadStatus(); clearInterval(statusTimer); statusTimer = setInterval(loadStatus, POLL);
    }

    function fetchCard(initial) {
        return fetch('/umbraco/surface/FaltskytteCardEntry/Card?competitionId=' + COMP + '&patrolNumber=' + patrolNo)
            .then(function (r) { return r.json(); })
            .then(function (d) {
                setConn(true);
                if (!d.success) { $('#keCardBanner').innerHTML = '<div class="alert alert-danger">' + esc(d.message) + '</div>'; return; }
                if (initial) { card = d; me = d.me; buildCells(); drawGrid(); applyDrafts(); refreshAll(); }
                else mergeServer(d);
            })
            .catch(function () { setConn(false); });
    }

    function buildCells() {
        cells = {};
        card.shooters.forEach(function (sh) {
            sh.stations.forEach(function (st) {
                var row = sh.rows.filter(function (r) { return r.station === st.station; })[0];
                cells[key(sh.memberId, st.station)] = {
                    mid: sh.memberId, st: st.station, slots: st.slots, maxPer: st.maxPerFigure, pmN: st.poangmal,
                    text: rowToText(row), pm: pmToStrings(row, st.poangmal),
                    version: row ? row.version : null, state: row ? 'saved' : 'empty', msg: '', current: null,
                    serverText: rowToText(row), serverPm: pmToStrings(row, st.poangmal)
                };
            });
        });
        $('#keCardTitle').textContent = 'Patrull ' + card.patrolNumber;
        var n = card.shooters.filter(function (s) { return !s.dns; }).length, d = card.shooters.length - n;
        $('#keCardSub').textContent = 'Vapengrupp ' + (card.weaponGroup || '') + ' · ' + n + ' skyttar att mata in' + (d ? ', ' + d + ' DNS' : '') + ' · klassen hämtas från patrullen';
    }

    function drawGrid() {
        var sts = allStationNumbers();
        var h = '<thead class="table-light"><tr><th class="nm">Skytt</th>';
        sts.forEach(function (s) {
            h += '<th class="st">Station ' + s.station + '<small class="text-muted">' + (s.name ? esc(s.name) + '<br>' : '') + s.slots + (s.slots === 1 ? ' figur' : ' figurer') + (s.poangmal ? ' + poäng' : '') + '</small></th>';
        });
        h += '<th class="sm">Träffar</th><th class="rs">Läge</th></tr></thead><tbody>';
        card.shooters.forEach(function (sh, i) {
            var cls = (window.getShootingClassName ? window.getShootingClassName(sh.shootingClass) : sh.shootingClass);
            if (sh.dns) {
                h += '<tr class="ke-dns"><td class="nm"><strong>' + esc(sh.name) + '</strong><br><small>' + esc(sh.club) + ' · ' + esc(cls) + '</small></td><td colspan="' + (sts.length + 2) + '">Ej start (DNS). Går inte att mata in.</td></tr>';
                return;
            }
            h += '<tr data-sh="' + sh.memberId + '"><td class="nm"><strong>' + esc(sh.name) + '</strong><br><small class="text-muted">' + esc(sh.club) + ' · ' + esc(cls) + '</small>' +
                (sh.otherClassRows ? '<br><small class="text-muted">Står även i en annan klass</small>' : '') +
                (sh.configMissing ? '<br><small class="text-danger">Stationskonfiguration saknas för klassen</small>' : '') + '</td>';
            sts.forEach(function (s) {
                var c = cells[key(sh.memberId, s.station)];
                if (!c) { h += '<td class="text-center text-muted">—</td>'; return; }
                h += '<td><input type="text" class="form-control form-control-sm text-center ke-cell" autocomplete="off" inputmode="text" id="c_' + sh.memberId + '_' + s.station + '" data-m="' + sh.memberId + '" data-s="' + s.station + '" aria-label="' + esc(sh.name) + ' station ' + s.station + '" placeholder="2+1+2">';
                if (c.pmN) {
                    h += '<div class="ke-pmrow"><span class="ke-pmlab">Poäng</span>';
                    for (var p = 0; p < c.pmN; p++) h += '<input type="text" class="form-control form-control-sm text-center ke-pm" autocomplete="off" inputmode="numeric" maxlength="2" id="p_' + sh.memberId + '_' + s.station + '_' + p + '" data-m="' + sh.memberId + '" data-s="' + s.station + '" data-p="' + p + '" aria-label="Poäng ' + (p + 1) + '">';
                    h += '</div>';
                }
                h += '<div class="ke-msg" id="m_' + sh.memberId + '_' + s.station + '"></div></td>';
            });
            h += '<td class="ke-sum" id="sum_' + sh.memberId + '"></td><td class="ke-rowstate" id="rs_' + sh.memberId + '"></td></tr>';
        });
        $('#keGrid').innerHTML = h + '</tbody>';
    }

    function cellEls(c) { return { input: document.getElementById('c_' + c.mid + '_' + c.st), msg: document.getElementById('m_' + c.mid + '_' + c.st) }; }
    function possessive(name) { var f = (name || '').split(' ')[0]; if (!f) return 'det redan sparade värdet'; return f + (/[sxz]$/i.test(f) ? '' : 's') + ' värde'; }

    function validateCell(c) {
        var p = parseCell(c.text, c.slots, c.maxPer);
        var pmAny = c.pm.some(function (v) { return v !== ''; });
        if (p.error) return { error: p.error };
        if (pmAny) {
            for (var i = 0; i < c.pm.length; i++) {
                if (c.pm[i] !== '' && !(/^\d{1,2}$/.test(c.pm[i]) && parseInt(c.pm[i], 10) <= 50)) return { error: 'Poäng måste vara 0–50.' };
            }
            if (p.empty) return { error: 'Fyll i träffarna först, sedan sparas poängen.', soft: true };
        }
        return p;
    }

    function paint(c) {
        var e = cellEls(c); if (!e.input) return;
        if (document.activeElement !== e.input) e.input.value = c.text;
        c.pm.forEach(function (v, i) { var pe = document.getElementById('p_' + c.mid + '_' + c.st + '_' + i); if (pe && document.activeElement !== pe) pe.value = v; });
        e.input.className = 'form-control form-control-sm text-center ke-cell' + (c.state === 'saved' ? ' ke-saved' : c.state === 'dirty' || c.state === 'saving' ? ' ke-dirty' : c.state === 'conflict' || c.state === 'error' ? ' ke-conflict' : '');
        var v = validateCell(c), msg = '';
        if (c.state === 'conflict') {
            var cur = c.current, whoRaw = cur && cur.enteredBy ? cur.enteredBy : '', who = whoRaw ? esc(whoRaw) : 'Någon annan';
            var theirs = cur ? esc(rowToText(cur)) : 'en annan rad', mine = esc(c.text);
            msg = '<div class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> <strong>Två personer har ändrat den här rutan.</strong> ' + who + ' hann spara <b>' + theirs + '</b>, du skrev <b>' + mine + '</b>. Vilket ska gälla?</div>' +
                '<button type="button" class="btn btn-outline-danger" data-act="mine" data-m="' + c.mid + '" data-s="' + c.st + '">Spara mitt (' + mine + ')</button> ' +
                '<button type="button" class="btn btn-outline-secondary" data-act="theirs" data-m="' + c.mid + '" data-s="' + c.st + '">Behåll ' + esc(possessive(whoRaw)) + ' (' + theirs + ')</button>';
        } else if (c.state === 'error') {
            msg = '<span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> ' + esc(c.msg) + '</span>';
        } else if (v.error && v.soft) {
            msg = '<span class="text-muted">' + esc(v.error) + '</span>';
        } else if (v.error) {
            msg = '<span class="text-danger"><i class="bi bi-x-circle-fill"></i> ' + esc(v.error) + '</span>';
            e.input.className += ' is-invalid';
        } else if (c.state === 'saving') {
            msg = '<span class="text-muted"><span class="spinner-border spinner-border-sm"></span> Sparar…</span>';
        } else if (c.state === 'saved') {
            msg = '<span class="text-success"><i class="bi bi-check-circle-fill"></i> ' + describe(v) + '</span>';
        } else if (c.state === 'dirty') {
            msg = '<span class="text-warning-emphasis"><i class="bi bi-circle-fill text-warning"></i> Ej sparad. ' + describe(v) + '</span>';
        }
        e.msg.innerHTML = msg;
    }

    function refreshRow(mid) {
        var sh = shooterOf(mid); if (!sh || sh.dns) return;
        var hits = 0, figs = 0, n = 0, total = sh.stations.length, saved = 0, pending = 0, bad = 0;
        sh.stations.forEach(function (st) {
            var c = cells[key(mid, st.station)], v = validateCell(c);
            if (!v.empty && !v.error) { hits += v.hits; figs += v.figs; n++; }
            if (c.state === 'saved') saved++; else if (c.state === 'dirty' || c.state === 'saving') pending++;
            if (c.state === 'conflict' || c.state === 'error' || (v.error && !v.soft)) bad++;
        });
        var s = document.getElementById('sum_' + mid); if (s) s.textContent = n ? hits + '/' + figs : '';
        var rs = document.getElementById('rs_' + mid);
        if (rs) rs.innerHTML = bad ? '<span class="text-danger">' + bad + ' att rätta</span>' : pending ? '<span class="text-warning">' + pending + ' ej sparade</span>' : (n + ' av ' + total + ' stationer');
    }
    function refreshAll() {
        Object.keys(cells).forEach(function (k) { paint(cells[k]); });
        card.shooters.forEach(function (s) { refreshRow(s.memberId); });
        drawWarns();
    }

    function drawWarns() {
        var out = [];
        card.shooters.forEach(function (sh) {
            if (sh.dns) return;
            var miss = [], pmMiss = [];
            sh.stations.forEach(function (st) {
                var c = cells[key(sh.memberId, st.station)], v = validateCell(c);
                if (v.empty) miss.push(st.station);
                else if (st.poangmal && c.pm.some(function (x) { return x === ''; })) pmMiss.push(st.station);
            });
            if (miss.length) out.push('<b>' + esc(sh.name) + '</b>: saknar station ' + miss.join(', ') + '. Resultatlistan räknar en saknad station som 0 träff.');
            if (pmMiss.length) out.push('<b>' + esc(sh.name) + '</b>: saknar poäng på station ' + pmMiss.join(', ') + '.');
        });
        $('#keWarns').innerHTML = out.length ? out.map(function (t) { return '<li>' + t + '</li>'; }).join('') : '<li class="text-success">Inget att anmärka på. Alla skyttar har alla stationer.</li>';
    }

    // ───────── utkast i webbläsaren ─────────
    function saveDrafts() {
        var d = {};
        Object.keys(cells).forEach(function (k) { var c = cells[k]; if (c.state === 'dirty' || c.state === 'error' || c.state === 'conflict') d[k] = { text: c.text, pm: c.pm }; });
        lsSet(draftKey, Object.keys(d).length ? JSON.stringify(d) : null);
    }
    function applyDrafts() {
        var raw = lsGet(draftKey); if (!raw) return;
        var d; try { d = JSON.parse(raw); } catch (e) { return; }
        var n = 0;
        Object.keys(d).forEach(function (k) {
            var c = cells[k]; if (!c) return;
            if (d[k].text === c.serverText && JSON.stringify(d[k].pm) === JSON.stringify(c.serverPm)) return;
            c.text = d[k].text; c.pm = d[k].pm; c.state = 'dirty'; n++;
        });
        if (n) $('#keCardBanner').innerHTML = '<div class="alert alert-warning py-2">Det fanns ' + n + ' osparade rutor från den här webbläsaren. De ligger kvar gulmarkerade. Tryck <em>Spara kortet</em> för att spara dem.</div>';
    }

    // ───────── sparning ─────────
    function payloadRow(c) {
        var p = parseCell(c.text, c.slots, c.maxPer);
        var pm = c.pmN ? c.pm.map(function (v) { return v === '' ? null : parseInt(v, 10); }) : null;
        if (pm && pm.every(function (v) { return v === null; })) pm = null;
        var r = { memberId: c.mid, station: c.st, mode: p.mode, expectedVersion: c.version, poangmalScores: pm };
        if (p.mode === 'fig') r.hitsPerFigure = p.arr; else { r.hits = p.hits; r.figures = p.figs; }
        return r;
    }
    function saveCells(list) {
        list = list.filter(function (c) { var v = validateCell(c); return !v.empty && !v.error && c.state !== 'conflict'; });
        if (!list.length) return Promise.resolve();
        list.forEach(function (c) { c.state = 'saving'; c.msg = ''; paint(c); });
        saveChain = saveChain.then(function () {
            return fetch('/umbraco/surface/FaltskytteCardEntry/SaveCard', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                body: JSON.stringify({ competitionId: COMP, patrolNumber: patrolNo, rows: list.map(payloadRow) })
            }).then(function (r) { return r.json(); }).then(function (d) {
                setConn(true);
                if (!d.success) { list.forEach(function (c) { c.state = 'error'; c.msg = d.message || 'Sparningen misslyckades.'; paint(c); }); return; }
                d.results.forEach(function (res) {
                    var c = cells[key(res.memberId, res.station)]; if (!c) return;
                    if (res.status === 'saved') {
                        var row = res.row; c.version = res.version; c.state = 'saved'; c.msg = '';
                        c.serverText = c.text; c.serverPm = c.pm.slice(); c.current = null;
                        $('#keStamp').innerHTML = '<span class="text-success">Sparat ' + nowHm() + '</span>';
                    } else if (res.status === 'conflict') { c.state = 'conflict'; c.current = res.current; c.msg = res.message || ''; }
                    else { c.state = 'error'; c.msg = res.message || 'Nekad.'; }
                    paint(c); refreshRow(c.mid);
                });
                saveDrafts(); drawWarns();
            }).catch(function () {
                setConn(false);
                list.forEach(function (c) { if (c.state === 'saving') { c.state = 'error'; c.msg = 'Nådde inte servern. Värdet finns kvar i webbläsaren, försök igen.'; paint(c); refreshRow(c.mid); } });
                saveDrafts();
                $('#keCardBanner').innerHTML = '<div class="alert alert-danger py-2 d-flex justify-content-between"><span><strong>Sparningen nådde inte servern.</strong> Dina värden finns kvar. Försök igen när anslutningen är tillbaka.</span><button type="button" class="btn btn-sm btn-outline-danger" id="keRetry">Försök igen</button></div>';
            });
        });
        return saveChain;
    }

    function mergeServer(d) {
        var changedBy = {}, changed = 0;
        d.shooters.forEach(function (sh) {
            sh.rows.forEach(function (row) {
                var c = cells[key(sh.memberId, row.station)]; if (!c) return;
                if (c.version === row.version) return;
                var focused = document.activeElement && document.activeElement.id && document.activeElement.id.indexOf('_' + sh.memberId + '_' + row.station) > -1;
                if (c.state === 'dirty' || c.state === 'saving' || c.state === 'conflict' || focused) return;
                c.text = rowToText(row); c.pm = pmToStrings(row, c.pmN); c.version = row.version; c.state = 'saved';
                c.serverText = c.text; c.serverPm = c.pm.slice();
                if (row.enteredById && row.enteredById !== me) { changed++; if (row.enteredBy) changedBy[row.enteredBy] = 1; }
                paint(c); refreshRow(c.mid);
            });
        });
        if (changed) {
            var who = Object.keys(changedBy); who = who.length ? who.join(', ') : 'Någon annan';
            $('#keCardBanner').innerHTML = '<div class="alert alert-warning py-2"><strong>' + esc(who) + '</strong> har ändrat ' + changed + (changed === 1 ? ' ruta' : ' rutor') + ' på det här kortet. Du ser de senaste värdena.</div>';
            drawWarns();
        }
    }

    // ───────── händelser i rutnätet ─────────
    var grid = $('#keGrid');
    grid.addEventListener('input', function (e) {
        var t = e.target; if (!t.dataset || !t.dataset.m) return;
        var c = cells[key(+t.dataset.m, +t.dataset.s)]; if (!c) return;
        if (t.dataset.p != null) c.pm[+t.dataset.p] = t.value.trim(); else c.text = t.value;
        if (c.state === 'saved' || c.state === 'empty' || c.state === 'error') c.state = 'dirty';
        if (c.text === c.serverText && JSON.stringify(c.pm) === JSON.stringify(c.serverPm) && c.state === 'dirty') c.state = c.version ? 'saved' : 'empty';
        paint(c); refreshRow(c.mid); saveDrafts(); drawWarns();
    });
    grid.addEventListener('change', function (e) {
        var t = e.target; if (!t.dataset || !t.dataset.m) return;
        var c = cells[key(+t.dataset.m, +t.dataset.s)]; if (!c || c.state !== 'dirty') return;
        saveCells([c]);
    });
    function inputsInOrder() { return [].slice.call(grid.querySelectorAll('tr[data-sh] input')); }
    function move(x, d) { var a = inputsInOrder(), i = a.indexOf(x) + d; if (i >= 0 && i < a.length) { a[i].focus(); a[i].select(); } }
    grid.addEventListener('keydown', function (e) {
        var x = e.target; if (x.tagName !== 'INPUT') return;
        if (e.key === 'Enter') { e.preventDefault(); move(x, 1); }
        else if (e.key === 'ArrowRight' && x.selectionStart === x.value.length) { e.preventDefault(); move(x, 1); }
        else if (e.key === 'ArrowLeft' && x.selectionEnd === 0) { e.preventDefault(); move(x, -1); }
        else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            var rows = [].slice.call(grid.querySelectorAll('tr[data-sh]')), tr = x.closest('tr'), ri = rows.indexOf(tr) + (e.key === 'ArrowDown' ? 1 : -1);
            if (ri < 0 || ri >= rows.length) return;
            var mine = [].slice.call(tr.querySelectorAll('input')), idx = mine.indexOf(x);
            var theirs = [].slice.call(rows[ri].querySelectorAll('input')); var tgt = theirs[idx] || theirs[0];
            if (tgt) { tgt.focus(); tgt.select(); }
        }
    });
    grid.addEventListener('click', function (e) {
        var b = e.target.closest('[data-act]'); if (!b) return;
        var c = cells[key(+b.dataset.m, +b.dataset.s)]; if (!c) return;
        if (b.dataset.act === 'theirs') {
            var cur = c.current; c.text = rowToText(cur); c.pm = pmToStrings(cur, c.pmN); c.version = cur ? cur.version : null;
            c.serverText = c.text; c.serverPm = c.pm.slice(); c.state = cur ? 'saved' : 'empty'; c.current = null;
            paint(c); refreshRow(c.mid); saveDrafts(); drawWarns();
        } else {
            c.version = c.current ? c.current.version : null; c.state = 'dirty'; c.current = null;
            saveCells([c]);
        }
    });
    $('#keSaveAll').addEventListener('click', function () {
        var list = Object.keys(cells).map(function (k) { return cells[k]; }).filter(function (c) { return c.state === 'dirty' || c.state === 'error'; });
        var bad = Object.keys(cells).map(function (k) { return cells[k]; }).filter(function (c) { var v = validateCell(c); return v.error && !v.soft; });
        if (bad.length) { $('#keStamp').innerHTML = '<span class="text-danger">Rätta de röda rutorna först (' + bad.length + ')</span>'; return; }
        if (!list.length) { $('#keStamp').innerHTML = '<span class="text-muted">Allt är redan sparat ' + nowHm() + '</span>'; return; }
        saveCells(list).then(function () {
            var left = Object.keys(cells).filter(function (k) { return cells[k].state !== 'saved' && cells[k].state !== 'empty'; }).length;
            if (!left) { $('#keCardBanner').innerHTML = ''; $('#keStamp').innerHTML = '<span class="text-success">Kortet sparat ' + nowHm() + '</span>'; }
        });
    });
    document.addEventListener('click', function (e) {
        if (e.target && e.target.id === 'keRetry') { $('#keCardBanner').innerHTML = ''; $('#keSaveAll').click(); }
    });
    $('#keBack').addEventListener('click', function () { location.hash = ''; });

    window.addEventListener('beforeunload', function (e) {
        if (card && Object.keys(cells).some(function (k) { return cells[k].state === 'dirty' || cells[k].state === 'saving'; })) { e.preventDefault(); e.returnValue = ''; }
    });

    function route() {
        var m = /^#patrull=(\d+)$/.exec(location.hash);
        if (m) openPatrol(parseInt(m[1], 10)); else closePatrol();
    }
    window.addEventListener('hashchange', route);
    route();
})();
</script>
}
</body>
</html>
