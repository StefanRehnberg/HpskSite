@using Umbraco.Cms.Core.Security
@inject IMemberManager MemberManager
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Skjutbanor";

    // Gamla länkar (/skjutbanor?range=ID — klubbsidan, mejl, startsidans påminnelser) leder till banans
    // egen sida sedan 2026-10-11.
    if (int.TryParse(Context.Request.Query["range"], out var deepLinkId) && deepLinkId > 0)
    {
        Context.Response.Redirect($"/skjutbana/{deepLinkId}");
        return;
    }

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;
}
@*
    Katalogen över skjutbanor, /skjutbanor (omgjord 2026-10-11). Samma form som klubbens Träningar:
    rubrik och en förklarande rad, blå Åtgärder, filtren ÖVER listan med antal, och en grå Åtgärder per
    rad. Kartan är en VY av samma lista, inte sidans startläge. Varje bana har en egen sida,
    /skjutbana/{id} — den gamla modalen med sex flikar finns inte längre.

    ⚠️ Inga användartexter i onclick: raderna bär id i data-attribut och läses av EN lyssnare.
*@
@if (!isLoggedIn)
{
    <div class="container py-5 text-center">
        <h1 class="h4"><i class="bi bi-lock me-2"></i>Inloggning krävs</h1>
        <p class="text-muted">Du måste vara inloggad för att se skjutbanorna.</p>
        <a class="btn btn-primary" href="/login-register?returnUrl=%2Fskjutbanor"><i class="bi bi-box-arrow-in-right me-1"></i>Logga in</a>
    </div>
    return;
}

@Html.AntiForgeryToken()
<link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@@1.5.3/dist/MarkerCluster.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@@1.5.3/dist/MarkerCluster.Default.css" />
<script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@@1.5.3/dist/leaflet.markercluster.js"></script>
<style>
    .rh-state { display: inline-flex; align-items: center; gap: .35rem; font-size: .8rem; font-weight: 600;
        padding: .12rem .55rem; border-radius: 1rem; white-space: nowrap; background: var(--bs-secondary-bg); }
    .rh-state::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .rh-state.ok { background: var(--bs-success-bg-subtle); color: var(--bs-success-text-emphasis); }
    .rh-state.wait { background: var(--bs-warning-bg-subtle); color: var(--bs-warning-text-emphasis); }
    .rh-state.bad { background: var(--bs-danger-bg-subtle); color: var(--bs-danger-text-emphasis); }
    .rh-table th { font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; color: var(--bs-secondary-color); font-weight: 600; }
    .rh-mine { background: var(--bs-primary-bg-subtle) !important; }
    #rhMap { height: 65vh; min-height: 360px; border-radius: .5rem; border: 1px solid var(--bs-border-color); }
</style>

<div class="container py-4" id="rhApp" style="padding-bottom:5.5rem">
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <h1 class="h4 mb-0"><i class="bi bi-geo-alt me-2"></i>Skjutbanor</h1>
        <div class="dropdown d-none" id="rhActions">
            <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-sliders me-1"></i>Åtgärder
            </button>
            <ul class="dropdown-menu dropdown-menu-end" style="min-width:260px">
                <li><h6 class="dropdown-header">Lägg till</h6></li>
                <li><button class="dropdown-item" type="button" data-rh="new"><i class="bi bi-plus-circle me-2"></i>Ny skjutbana…</button></li>
                <li><button class="dropdown-item" type="button" data-rh="place"><i class="bi bi-geo-alt me-2"></i>Placera en ny bana på kartan</button></li>
                <li class="d-none" data-rh-admin><hr class="dropdown-divider"></li>
                <li class="d-none" data-rh-admin><h6 class="dropdown-header">Sajtadministratör</h6></li>
                <li class="d-none" data-rh-admin><button class="dropdown-item" type="button" data-rh="import"><i class="bi bi-cloud-upload me-2"></i>Läs in banor från OpenStreetMap…</button></li>
            </ul>
        </div>
    </div>
    <p class="text-muted">
        Sveriges skjutbanor. Öppna en bana för karta och vägbeskrivning, banans kalender och klubbarnas tider —
        och, för banans förvaltare, tillstånd, dokument och aktivitet.
    </p>

    @* Filtren står ÖVER listan, med antalet — samma form som klubbens Träningar. *@
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <input type="search" class="form-control" id="rhSearch" placeholder="Sök på namn, ort eller kommun" style="max-width:20rem" autocomplete="off" aria-label="Sök skjutbana">
        <select class="form-select w-auto" id="rhFilter" aria-label="Vilka banor">
            <option value="mine">Mina klubbars banor</option>
            <option value="all">Alla banor</option>
            <option value="managed">Banor jag förvaltar</option>
            <option value="unclaimed">Banor utan förvaltare</option>
        </select>
        <div class="btn-group" role="group" aria-label="Visning">
            <input type="radio" class="btn-check" name="rhView" id="rhViewList" value="list" checked>
            <label class="btn btn-outline-primary" for="rhViewList"><i class="bi bi-list-ul me-1"></i>Lista</label>
            <input type="radio" class="btn-check" name="rhView" id="rhViewMap" value="map">
            <label class="btn btn-outline-primary" for="rhViewMap"><i class="bi bi-map me-1"></i>Karta</label>
        </div>
        <span class="small text-muted ms-auto" id="rhCount"></span>
    </div>
    <div id="rhMsg" aria-live="polite"></div>
    <div id="rhPlaceHint" class="alert alert-info py-2 d-none">
        <i class="bi bi-hand-index me-1"></i>Klicka på kartan där den nya skjutbanan ligger.
        <button type="button" class="btn btn-link btn-sm p-0 ms-2 align-baseline" data-rh="place-cancel">Avbryt</button>
    </div>

    <div id="rhListWrap">
        <div id="rhList"><div class="text-center py-4"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar…</span></div></div></div>
    </div>
    <div id="rhMapWrap" class="d-none">
        <div id="rhMap"></div>
        <div class="small text-muted mt-1" id="rhMapCount"></div>
    </div>
</div>

@* Läs in banor från OpenStreetMap (sajtadministratör). *@
<div class="modal fade" id="rhImportModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title h5">Läs in banor från OpenStreetMap</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted small">Ladda upp en GeoJSON-export (overpass-turbo, sport=shooting). Banorna läggs in utan förvaltare,
            och de som redan finns hoppas över (de känns igen på sitt OSM-id).</p>
        <input type="file" class="form-control" id="rhImportFile" accept=".geojson,.json,application/json" aria-label="GeoJSON-fil">
        <div id="rhImportResult" class="mt-3 small"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Stäng</button>
        <button type="button" class="btn btn-primary" id="rhImportSubmit"><i class="bi bi-cloud-upload me-1"></i>Läs in</button>
      </div>
    </div>
  </div>
</div>

@await Html.PartialAsync("_RangeEditModal")

<script>
(function () {
    'use strict';
    const $ = id => document.getElementById(id);
    const STATUS = { Active: ['Aktiv', 'ok'], Inactive: ['Inte i bruk', 'wait'], Decommissioned: ['Avvecklad', 'bad'], UnclaimedSeed: ['Ingen förvaltare', 'wait'] };
    // En lista med tusen rader går inte att läsa — sökningen och filtret är vägen till resten.
    const LIST_CAP = 100;
    let all = [], canCreate = false, view = 'list', map = null, cluster = null, placing = false;

    function esc(s) { return (s == null ? '' : String(s)).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[c])); }
    function token() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
    function msg(html, kind) { $('rhMsg').innerHTML = html ? `<div class="alert alert-${kind || 'warning'} py-2">${html}</div>` : ''; }
    function remember(k, v) { try { localStorage.setItem(k, v); } catch (e) { } }
    function recall(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }

    function filtered() {
        const q = ($('rhSearch').value || '').trim().toLowerCase();
        const f = $('rhFilter').value;
        return all.filter(r => {
            if (f === 'mine' && !r.mine) return false;
            if (f === 'managed' && !r.canManage) return false;
            if (f === 'unclaimed' && r.status !== 'UnclaimedSeed') return false;
            if (q && !`${r.name} ${r.city || ''} ${r.municipality || ''} ${r.county || ''}`.toLowerCase().includes(q)) return false;
            return true;
        }).sort((a, b) => (b.mine - a.mine) || (b.canManage - a.canManage) || a.name.localeCompare(b.name, 'sv'));
    }

    function render() {
        const rows = filtered();
        $('rhCount').textContent = `${rows.length} av ${all.length} banor`;
        if (view === 'map') { renderMap(rows); return; }
        if (!rows.length) {
            const f = $('rhFilter').value;
            $('rhList').innerHTML = `<div class="text-center text-muted py-4 border rounded">${f === 'mine'
                ? 'Ingen av dina klubbar är kopplad till en skjutbana. Välj <strong>Alla banor</strong> och sök upp er bana.'
                : 'Ingen skjutbana matchar sökningen.'}</div>`;
            return;
        }
        const shown = rows.slice(0, LIST_CAP);
        $('rhList').innerHTML = `<div class="table-responsive"><table class="table table-hover align-middle rh-table">
            <thead><tr><th>Skjutbana</th><th class="d-none d-md-table-cell">Ort och kommun</th><th class="d-none d-lg-table-cell">Klubbar</th><th>Status</th><th></th></tr></thead><tbody>
            ${shown.map(r => {
                const st = STATUS[r.status] || [r.status, ''];
                const place = [r.city, r.municipality].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(' · ');
                return `<tr${r.mine ? ' class="rh-mine"' : ''}>
                    <td><a class="fw-semibold" href="/skjutbana/${r.id}">${esc(r.name)}</a>
                        ${r.mine ? ' <span class="badge bg-primary-subtle text-primary-emphasis">Din klubb</span>' : ''}
                        ${r.canManage && !r.mine ? ' <span class="badge bg-secondary-subtle text-secondary-emphasis">Du förvaltar</span>' : ''}
                        ${place ? `<div class="small text-muted d-md-none">${esc(place)}</div>` : ''}</td>
                    <td class="d-none d-md-table-cell">${esc(place)}</td>
                    <td class="d-none d-lg-table-cell">${r.clubCount || '<span class="text-muted">—</span>'}</td>
                    <td><span class="rh-state ${st[1]}">${esc(st[0])}</span></td>
                    <td class="text-end"><div class="dropdown d-inline-block">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">Åtgärder</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/skjutbana/${r.id}">Öppna banan</a></li>
                            <li><a class="dropdown-item" href="/skjutbana/${r.id}#vy=kalender">Banans kalender</a></li>
                            ${r.status === 'UnclaimedSeed' && canCreate ? `<li><hr class="dropdown-divider"></li><li><a class="dropdown-item" href="/skjutbana/${r.id}#vy=oversikt&ansprak=1">Gör anspråk på banan…</a></li>` : ''}
                        </ul></div></td></tr>`;
            }).join('')}</tbody></table></div>
            ${rows.length > LIST_CAP ? `<p class="small text-muted">Visar de första ${LIST_CAP} av ${rows.length}. Sök på namn, ort eller kommun för att hitta fler, eller välj Karta.</p>` : ''}`;
    }

    // ── Kartan: samma lista, som punkter ────────────────────────────────
    function dot(color) {
        return L.divIcon({ className: 'rh-dot', iconSize: [14, 14], iconAnchor: [7, 7],
            html: `<span style="display:block;width:14px;height:14px;border-radius:50%;background:${color};border:2px solid #fff;box-shadow:0 0 3px rgba(0,0,0,.5)"></span>` });
    }
    function initMap() {
        if (map) { setTimeout(() => map.invalidateSize(), 60); return; }
        map = L.map('rhMap').setView([62.5, 16.5], 5);
        const streets = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© OpenStreetMap' }).addTo(map);
        const sat = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom: 19, attribution: 'Tiles © Esri' });
        let satOn = false;
        const Toggle = L.Control.extend({ options: { position: 'topright' }, onAdd: function () {
            const b = L.DomUtil.create('button', 'btn btn-sm btn-light shadow-sm'); b.type = 'button';
            b.innerHTML = '<i class="bi bi-globe-americas me-1"></i>Satellit';
            L.DomEvent.disableClickPropagation(b);
            L.DomEvent.on(b, 'click', e => { L.DomEvent.stop(e); satOn = !satOn;
                if (satOn) { map.removeLayer(streets); sat.addTo(map); b.innerHTML = '<i class="bi bi-map me-1"></i>Karta'; }
                else { map.removeLayer(sat); streets.addTo(map); b.innerHTML = '<i class="bi bi-globe-americas me-1"></i>Satellit'; } });
            return b; } });
        map.addControl(new Toggle());
        cluster = L.markerClusterGroup({ chunkedLoading: true, maxClusterRadius: 50 });
        map.addLayer(cluster);
        map.on('click', e => {
            if (!placing) return;
            stopPlacing();
            window.hpskRangeEdit.open(null, { lat: e.latlng.lat, lng: e.latlng.lng }, id => location.href = '/skjutbana/' + id);
        });
        setTimeout(() => map.invalidateSize(), 60);
    }
    function renderMap(rows) {
        initMap();
        cluster.clearLayers();
        const pts = rows.filter(r => r.latitude != null && r.longitude != null);
        pts.forEach(r => {
            const color = r.mine ? '#0d6efd' : r.status === 'Active' ? '#198754' : r.status === 'UnclaimedSeed' ? '#ffc107' : '#6c757d';
            cluster.addLayer(L.marker([r.latitude, r.longitude], { icon: dot(color) }).bindPopup(
                `<div class="fw-semibold mb-1">${esc(r.name)}</div><div class="small text-muted mb-2">${esc([r.city, r.municipality].filter(Boolean).join(' · '))}</div>` +
                `<a class="btn btn-sm btn-primary" style="color:#fff" href="/skjutbana/${r.id}">Öppna banan</a>`));
        });
        $('rhMapCount').textContent = `${pts.length} banor på kartan` + (rows.length > pts.length ? ` — ${rows.length - pts.length} saknar plats` : '')
            + '. Blå = dina klubbars, grön = aktiv, gul = ingen förvaltare.';
        const mine = pts.filter(r => r.mine);
        if (mine.length && !map._rhFitted) {
            map._rhFitted = true;
            map.fitBounds(L.latLngBounds(mine.map(r => [r.latitude, r.longitude])).pad(0.5), { maxZoom: 12 });
        }
    }
    function setView(v) {
        view = v;
        remember('hpsk_rh_view', v);
        $('rhListWrap').classList.toggle('d-none', v !== 'list');
        $('rhMapWrap').classList.toggle('d-none', v !== 'map');
        render();
    }
    function startPlacing() {
        if (view !== 'map') { $('rhViewMap').checked = true; setView('map'); }
        placing = true;
        $('rhPlaceHint').classList.remove('d-none');
        $('rhMap').style.cursor = 'crosshair';
    }
    function stopPlacing() {
        placing = false;
        $('rhPlaceHint').classList.add('d-none');
        $('rhMap').style.cursor = '';
    }

    async function doImport() {
        const f = $('rhImportFile').files[0];
        if (!f) { $('rhImportResult').innerHTML = '<span class="text-danger">Välj en fil.</span>'; return; }
        const b = $('rhImportSubmit'); b.disabled = true;
        try {
            const fd = new FormData();
            fd.append('file', f); fd.append('__RequestVerificationToken', token());
            const r = await fetch('/umbraco/surface/ShootingRange/ImportOsm', { method: 'POST', headers: { 'RequestVerificationToken': token() }, body: fd });
            const d = r.ok ? await r.json() : { success: false, message: 'Inläsningen misslyckades.' };
            $('rhImportResult').innerHTML = d.success
                ? `<span class="text-success">${d.imported} banor lästes in, ${d.skipped} fanns redan.</span>`
                : `<span class="text-danger">${esc(d.message)}</span>`;
            if (d.success) load();
        } finally { b.disabled = false; }
    }

    async function load() {
        try {
            const r = await fetch('/umbraco/surface/ShootingRange/GetRanges', { credentials: 'same-origin' });
            const d = r.ok ? await r.json() : null;
            if (!d || !d.success) { $('rhList').innerHTML = `<div class="alert alert-warning">${esc((d && d.message) || 'Skjutbanorna kunde inte hämtas.')}</div>`; return; }
            all = d.ranges; canCreate = d.canCreate;
            $('rhActions').classList.toggle('d-none', !d.canCreate && !d.isSiteAdmin);
            document.querySelectorAll('[data-rh-admin]').forEach(el => el.classList.toggle('d-none', !d.isSiteAdmin));
            document.querySelectorAll('[data-rh="new"],[data-rh="place"]').forEach(el => el.closest('li').classList.toggle('d-none', !d.canCreate));
            document.querySelector('[data-rh="new"]').closest('ul').firstElementChild.classList.toggle('d-none', !d.canCreate);
            // Utan egna banor är "Mina klubbars banor" en tom lista — då börjar katalogen med alla.
            const saved = recall('hpsk_rh_filter');
            const f = $('rhFilter');
            if (saved && [...f.options].some(o => o.value === saved) && (saved !== 'mine' || d.hasMine)) f.value = saved;
            else f.value = d.hasMine ? 'mine' : 'all';
            render();
        } catch (e) { $('rhList').innerHTML = '<div class="alert alert-warning">Skjutbanorna kunde inte hämtas.</div>'; }
    }

    document.addEventListener('click', e => {
        const b = e.target.closest('[data-rh]'); if (!b) return;
        const a = b.dataset.rh;
        if (a === 'new') window.hpskRangeEdit.open(null, null, id => location.href = '/skjutbana/' + id);
        else if (a === 'place') startPlacing();
        else if (a === 'place-cancel') stopPlacing();
        else if (a === 'import') { $('rhImportResult').innerHTML = ''; $('rhImportFile').value = ''; bootstrap.Modal.getOrCreateInstance($('rhImportModal')).show(); }
    });
    $('rhImportSubmit').addEventListener('click', doImport);
    $('rhSearch').addEventListener('input', render);
    $('rhFilter').addEventListener('change', () => { remember('hpsk_rh_filter', $('rhFilter').value); render(); });
    document.querySelectorAll('input[name="rhView"]').forEach(r => r.addEventListener('change', () => setView(r.value)));
    if (recall('hpsk_rh_view') === 'map') { $('rhViewMap').checked = true; view = 'map'; $('rhListWrap').classList.add('d-none'); $('rhMapWrap').classList.remove('d-none'); }

    // Glömda incheckningar stängs vid sidladdning (svepet är begränsat per webbläsare).
    try {
        const k = 'hpsk_sweep_checkins', last = parseInt(recall(k) || '0', 10);
        if (Date.now() - last >= 5 * 60 * 1000) { remember(k, String(Date.now())); fetch('/umbraco/surface/ShootingRange/AutoCloseStaleCheckIns').catch(() => { }); }
    } catch (e) { }
    load();
})();
</script>
