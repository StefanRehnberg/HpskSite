@using HpskSite.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Styrelsearbete";
    var data = ViewData["StyrelseData"] as StyrelsePageModel ?? new StyrelsePageModel();
    var sel = data.Selected;
}
@*
    /styrelse i EKONOMINS SKAL (omgjord 2026-10-08).

    Sidan byggdes i juni för äldre ledamöter (större text, stora klickytor, autospar) och hade egna
    stora flikknappar. Den formen behålls i innehållet, men skalet är sajtens förlaga för en egen
    sida (Ekonomi, Min kurs): vänsterkort med föreningen och rollen, ← Tillbaka, rälsens delar, och
    allt innehåll i EN kolumn. Rälsen = platser, blå Åtgärder = handlingar för den del man står på.

    Delen står i adressen (#vy=…&id=…) så att bakåtknappen, en omladdning och länkar i mejl landar
    rätt. All logik ligger i /js/styrelse.js; här finns bara skalet, konfigurationen och dialogerna.
*@
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>
<style>
    /* ── Skalet: samma värden som Ekonomin (.ek-page .rail) och Min kurs. Ändras den ena, ändra de andra. */
    .sv-page { padding-bottom: 5.5rem; }
    .sv-page .sv-shell { display: flex; gap: 1.5rem; align-items: flex-start; }
    .sv-page .sv-rail { width: 250px; flex-shrink: 0; position: sticky; top: 1rem;
        background-color: var(--bs-tertiary-bg); border: 1px solid var(--bs-border-color);
        border-radius: .5rem; padding: 8px; }
    .sv-page .sv-rail .sv-org { font-size: 1.1rem; font-weight: 700; padding: 6px 12px 0; }
    .sv-page .sv-rail .sv-role { font-size: .8rem; color: var(--bs-secondary-color); padding: 0 12px 10px; }
    .sv-page .sv-rail a.sv-nav { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px;
        border-radius: 8px; color: var(--bs-body-color); text-decoration: none; border-left: 3px solid transparent; }
    .sv-page .sv-rail a.sv-nav:hover { background-color: var(--bs-secondary-bg); }
    .sv-page .sv-rail a.sv-nav.on { font-weight: 600; background-color: var(--bs-primary-bg-subtle);
        color: var(--bs-primary-text-emphasis); border-left-color: var(--bs-primary); }
    .sv-page .sv-rail a.sv-back { display: block; color: var(--bs-secondary-color); font-size: .9rem; padding: 6px 12px 10px;
        margin-bottom: 6px; border-bottom: 1px solid var(--bs-border-color); text-decoration: none; }
    .sv-page .sv-rail a.sv-back:hover { color: var(--bs-link-color); }
    .sv-page .sv-rail .sv-ext { border-top: 1px solid var(--bs-border-color); margin-top: 6px; padding-top: 6px; }
    .sv-page .sv-rail .sv-count { background: var(--bs-warning); color: #1b1206; font-size: .72rem; font-weight: 700;
        border-radius: 1rem; padding: .05rem .5rem; }
    .sv-page .sv-main { flex: 1 1 auto; min-width: 0; font-size: 1.05rem; }
    .sv-page .sv-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
        flex-wrap: wrap; margin-bottom: 1rem; }
    .sv-page h1 { font-size: 1.7rem; font-weight: 700; margin: 0; }
    .sv-page .sv-sub { color: var(--bs-secondary-color); margin-top: .15rem; }
    .sv-page .sv-crumb { margin-bottom: .35rem; font-size: .95rem; }
    @@media (max-width: 991px) {
        .sv-page .sv-shell { flex-direction: column; }
        .sv-page .sv-rail { width: 100%; position: static; display: flex; flex-wrap: wrap; gap: .2rem; align-items: center; }
        .sv-page .sv-rail .sv-org, .sv-page .sv-rail .sv-role, .sv-page .sv-rail .sv-back,
        .sv-page .sv-rail #svScopeWrap, .sv-page .sv-rail .sv-ext { width: 100%; }
        .sv-page .sv-rail a.sv-nav { border-left: 0; gap: .4rem; }
        .sv-page .sv-rail a.sv-nav.on { border-left: 0; box-shadow: inset 0 -3px 0 var(--bs-primary); }
        .sv-page .sv-main { width: 100%; }
    }

    /* ── Innehållet: kort, tonade rader för det som väntar, lägen som brickor. */
    .sv-card { background: var(--bs-body-bg); border: 1px solid var(--bs-border-color); border-radius: .75rem;
        padding: 1.1rem 1.25rem; margin-bottom: 1rem; }
    .sv-card > h2, .sv-cardh h2 { font-size: 1.2rem; font-weight: 700; margin: 0 0 .6rem; }
    .sv-cardh { display: flex; justify-content: space-between; align-items: baseline; gap: .75rem; flex-wrap: wrap; margin-bottom: .6rem; }
    .sv-cardh h2 { margin: 0; }
    .sv-attn { background: var(--bs-warning-bg-subtle); border-color: var(--bs-warning-border-subtle); }
    .sv-todo { display: flex; align-items: center; gap: .8rem; background: var(--bs-warning-bg-subtle);
        border: 1px solid var(--bs-warning-border-subtle); border-radius: .5rem; padding: .55rem .85rem; margin-bottom: .5rem; }
    .sv-todo .n { font-weight: 700; min-width: 1.6rem; text-align: right; }
    .sv-todo .t { flex: 1; min-width: 0; }
    .sv-todo.done { background: var(--bs-success-bg-subtle); border-color: var(--bs-success-border-subtle); }
    .sv-help { color: var(--bs-secondary-color); font-size: .95rem; }
    .sv-label { font-weight: 600; margin-bottom: .25rem; display: block; }
    .sv-page .form-control, .sv-page .form-select, .sv-modal .form-control, .sv-modal .form-select { font-size: 1.05rem; }
    .sv-page .form-select { padding-right: 2.5rem; background-position: right .9rem center; }
    .sv-page textarea.form-control { line-height: 1.5; }
    .sv-person { display: flex; align-items: center; justify-content: space-between; gap: .75rem;
        padding: .6rem .25rem; border-bottom: 1px solid var(--bs-border-color); }
    .sv-person:last-child { border-bottom: 0; }
    .sv-check { width: 1.4rem; height: 1.4rem; }
    .sv-saved { color: var(--bs-success); font-weight: 600; opacity: 0; transition: opacity .2s; font-size: .9rem; }
    .sv-saved.show { opacity: 1; }
    .sv-state { display: inline-flex; align-items: center; gap: .35rem; font-size: .8rem; font-weight: 600;
        padding: .12rem .55rem; border-radius: 1rem; white-space: nowrap; }
    .sv-state::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .sv-state.plan { background: var(--bs-secondary-bg); color: var(--bs-body-color); }
    .sv-state.wait { background: var(--bs-warning-bg-subtle); color: var(--bs-warning-text-emphasis); }
    .sv-state.ok { background: var(--bs-success-bg-subtle); color: var(--bs-success-text-emphasis); }
    .sv-state.blue { background: var(--bs-primary-bg-subtle); color: var(--bs-primary-text-emphasis); }
    .sv-state.off { background: var(--bs-tertiary-bg); color: var(--bs-secondary-color); }
    .sv-quorum-ok { background: var(--bs-success-bg-subtle); border-color: var(--bs-success-border-subtle); }
    .sv-quorum-no { background: var(--bs-warning-bg-subtle); border-color: var(--bs-warning-border-subtle); }
    /* Mötets livscykel: fem lägen som en stegrad, det aktuella blått, de avklarade gröna. */
    .sv-steps { display: flex; flex-wrap: wrap; margin: .2rem 0 .9rem; }
    .sv-steps div { flex: 1 1 0; min-width: 110px; font-size: .82rem; padding: .4rem .5rem; border-top: 4px solid var(--bs-border-color);
        color: var(--bs-secondary-color); }
    .sv-steps div.done { border-top-color: var(--bs-success); color: var(--bs-body-color); }
    .sv-steps div.now { border-top-color: var(--bs-primary); color: var(--bs-primary-text-emphasis); font-weight: 700; }
    .sv-next { background: var(--bs-primary-bg-subtle); color: var(--bs-primary-text-emphasis); border-radius: .5rem;
        padding: .65rem .9rem; margin-bottom: 1rem; display: flex; gap: .8rem; align-items: center; flex-wrap: wrap; }
    .sv-next .t { flex: 1; min-width: 220px; }
    /* Tre lika breda faser som ryms på en telefon (390 px) — en fast minbredd sköt ut sidan i sidled. */
    .sv-phases { display: flex; width: 100%; max-width: 30rem; }
    .sv-phases .btn { flex: 1 1 0; min-width: 0; white-space: nowrap; padding-left: .4rem; padding-right: .4rem; }
    /* Dagordningen: huvudpunkt med numret, underpunkter indragna under den. */
    .sv-ag { padding: .7rem 0; border-top: 1px solid var(--bs-border-color); }
    .sv-ag:first-child { border-top: 0; }
    .sv-ag .sv-no { flex: none; min-width: 2.6rem; font-weight: 700; color: var(--bs-secondary-color); font-variant-numeric: tabular-nums; }
    .sv-sub-ag { margin: .5rem 0 0 2.6rem; padding: .55rem .75rem; border: 1px dashed var(--bs-border-color);
        border-radius: .5rem; background: var(--bs-tertiary-bg); }
    .sv-src { font-size: .88rem; color: var(--bs-secondary-color); }
    .sv-table td, .sv-table th { vertical-align: top; }
    .sv-table th { font-size: .75rem; letter-spacing: .04em; text-transform: uppercase; color: var(--bs-secondary-color); font-weight: 600; }
    @@media print {
        .sv-rail, .sv-noprint, .navbar, footer, #svActions { display: none !important; }
    }
</style>

<div class="sv-page container-fluid py-4" id="svApp">
    @Html.AntiForgeryToken()

    @if (sel == null)
    {
        <h1>Styrelsearbete</h1>
        <div class="sv-card mt-3" style="max-width:720px;">
            <p class="mb-1" style="font-size:1.15rem;">Du sitter inte i någon styrelse just nu.</p>
            <p class="sv-help mb-0">När du väljs in i en klubbs eller krets styrelse dyker arbetsytan upp här automatiskt. Hör med din klubb om du tror att detta är fel.</p>
        </div>
    }
    else
    {
        <div class="sv-shell">
            <nav class="sv-rail" aria-label="Styrelsearbetets delar">
                <a href="@sel.BackUrl" class="sv-back" id="svBack">← Tillbaka</a>
                <div class="sv-org">@sel.Name</div>
                <div class="sv-role">@sel.RoleTitle · @sel.Kind</div>
                @if (data.Scopes.Count > 1)
                {
                    <div class="mb-2 px-2" id="svScopeWrap">
                        <label class="form-label small text-muted mb-1" for="svScope">Byt styrelse</label>
                        <select id="svScope" class="form-select form-select-sm">
                            @foreach (var s in data.Scopes)
                            {
                                var selected = s.OwnerType == sel.OwnerType && s.OwnerId == sel.OwnerId;
                                <option value="@s.OwnerType-@s.OwnerId" selected="@selected">@s.Kind: @s.Name</option>
                            }
                        </select>
                    </div>
                }
                <div id="svRailLinks" style="display:contents"></div>
                @*
                    ⚠️⚠️ VÄGEN IN TILL EKONOMIN. Utan den finns ingen för en ledamot: /ekonomi nås annars
                    bara från klubbens adminpanel, som kräver klubbadmin. Styrelsen LÄSER, kassören
                    SKRIVER (LedgerAccessService). Valberedningen har inget läge där.
                *@
                @if (!sel.ValberedningOnly)
                {
                    <div class="sv-ext">
                        <a class="sv-nav" href="/ekonomi?type=@sel.OwnerType&id=@sel.OwnerId" target="_blank" rel="noopener"
                           title="Budget, utfall och avgifter. Öppnas i en ny flik.">Föreningens ekonomi <span aria-hidden="true">↗</span></a>
                    </div>
                }
            </nav>
            <div class="sv-main">
                <div class="sv-crumb d-none" id="svCrumb"></div>
                <div class="sv-head">
                    <div>
                        <h1 id="svTitle">Styrelsearbete</h1>
                        <div class="sv-sub" id="svSub"></div>
                    </div>
                    <div class="dropdown d-none sv-noprint" id="svActions">
                        <button class="btn btn-primary shadow dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-sliders me-1"></i>Åtgärder
                        </button>
                        @* Menyn byggs PER DEL och bär bara handlingar för delen man står på — aldrig en plats rälsen redan har. *@
                        <ul class="dropdown-menu dropdown-menu-end" style="min-width:270px" id="svActionsList"></ul>
                    </div>
                </div>
                <div id="svMsg" aria-live="polite"></div>
                <div id="svBody"><div class="text-center py-5"><div class="spinner-border" role="status"><span class="visually-hidden">Laddar…</span></div></div></div>
            </div>
        </div>

        @* EN dialog för frågor (i stället för confirm()) och EN för formulär (i stället för prompt()). *@
        <div class="modal fade sv-modal" id="svConfirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="svConfirmTitle">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header"><h2 class="modal-title h5" id="svConfirmTitle"></h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button></div>
                    <div class="modal-body" id="svConfirmText" style="white-space:pre-line;"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="svConfirmOk">OK</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade sv-modal" id="svFormModal" tabindex="-1" aria-hidden="true" aria-labelledby="svFormTitle">
            <div class="modal-dialog modal-lg modal-dialog-scrollable modal-fullscreen-sm-down">
                <div class="modal-content">
                    <div class="modal-header"><h2 class="modal-title h5" id="svFormTitle"></h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button></div>
                    <div class="modal-body">
                        <div class="alert alert-danger d-none" id="svFormErr" role="alert"></div>
                        <div id="svFormBody"></div>
                    </div>
                    <div class="modal-footer" id="svFormFoot">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                        <button type="button" class="btn btn-primary" id="svFormOk">Spara</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            window.SV_CONFIG = {
                ownerType: @sel.OwnerType,
                ownerId: @sel.OwnerId,
                orgName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(sel.Name)),
                canManage: @(sel.CanManageRoles ? "true" : "false"),
                canPlace: @(sel.CanPlace ? "true" : "false"),
                valbOnly: @(sel.ValberedningOnly ? "true" : "false"),
                startTab: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Context.Request.Query["tab"].ToString())),
                kretsUppdrag: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    BoardRoleDefinitions.KretsUppdragRoleKeys.Select(k => new {
                        key = k,
                        label = BoardRoleDefinitions.GetLabel(k),
                        task = BoardRoleDefinitions.KretsUppdragTask(k)
                    })))
            };
        </script>
        <script src="~/js/styrelse.js" asp-append-version="true"></script>
    }
</div>
