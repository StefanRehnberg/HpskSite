@using HpskSite.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Styrelsearbete";
    var data = ViewData["StyrelseData"] as StyrelsePageModel ?? new StyrelsePageModel();
    var sel = data.Selected;
}

<style>
    /* Senior-friendly: larger text, generous spacing, big targets, calm layout. */
    .styrelse-page { font-size: 1.12rem; max-width: 900px; margin: 0 auto; padding: 1.5rem 1rem 4rem; }
    .styrelse-page h1 { font-size: 2rem; font-weight: 700; }
    .styrelse-page h2 { font-size: 1.5rem; font-weight: 700; margin-top: 0; }
    .styrelse-page .btn { border-radius: .6rem; }
    .styrelse-page .btn-xl { font-size: 1.2rem; padding: .85rem 1.4rem; font-weight: 600; }
    .sv-nav { display: flex; gap: .75rem; margin: 1.25rem 0 1.5rem; }
    .sv-nav button { flex: 1; font-size: 1.25rem; font-weight: 600; padding: 1rem; border-radius: .8rem;
        border: 2px solid var(--bs-border-color); background: var(--bs-body-bg); color: var(--bs-body-color); }
    .sv-nav button.active { background: var(--bs-primary); color: #fff; border-color: var(--bs-primary); }
    .sv-card { border: 1px solid var(--bs-border-color); border-radius: .9rem; padding: 1.25rem 1.35rem; margin-bottom: 1.1rem; background: var(--bs-body-bg); }
    .sv-card.highlight { border-color: var(--bs-primary); border-width: 2px; }
    .sv-label { font-weight: 600; margin-bottom: .25rem; display: block; }
    .styrelse-page .form-control, .styrelse-page .form-select { font-size: 1.1rem; padding: .6rem .8rem; }
    .styrelse-page textarea.form-control { line-height: 1.5; }
    .sv-help { color: var(--bs-secondary-color); font-size: .98rem; }
    .sv-person { display: flex; align-items: center; justify-content: space-between; gap: .75rem;
        padding: .75rem .25rem; border-bottom: 1px solid var(--bs-border-color); }
    .sv-person:last-child { border-bottom: 0; }
    .sv-check { width: 1.5rem; height: 1.5rem; }
    .sv-saved { color: var(--bs-success); font-weight: 600; opacity: 0; transition: opacity .2s; }
    .sv-saved.show { opacity: 1; }
    .sv-agenda-num { display:inline-flex; align-items:center; justify-content:center; width:2rem; height:2rem;
        border-radius:50%; background:var(--bs-primary); color:#fff; font-weight:700; margin-right:.5rem; flex:none; }
    .sv-quorum-ok { background: var(--bs-success-bg-subtle); border-color: var(--bs-success); }
    .sv-quorum-no { background: var(--bs-warning-bg-subtle); border-color: var(--bs-warning); }
    @@media print {
        .sv-nav, .sv-noprint, .navbar, footer { display: none !important; }
        .styrelse-page { max-width: 100%; }
    }
</style>

<div class="styrelse-page">
    @Html.AntiForgeryToken()

    @if (sel == null)
    {
        <h1>Styrelsearbete</h1>
        <div class="sv-card mt-3">
            <p class="mb-1" style="font-size:1.15rem;">Du sitter inte i någon styrelse just nu.</p>
            <p class="sv-help mb-0">När du väljs in i en klubbs eller krets styrelse dyker arbetsytan upp här automatiskt. Hör med din klubb om du tror att detta är fel.</p>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 sv-noprint">
            <h1 class="mb-0">Styrelsearbete</h1>
            @if (data.Scopes.Count > 1)
            {
                <div>
                    <label class="sv-help d-block mb-1" for="svScope">Välj klubb eller krets</label>
                    <select id="svScope" class="form-select" style="min-width:240px;" onchange="svSwitchScope()">
                        @foreach (var s in data.Scopes)
                        {
                            var selected = s.OwnerType == sel.OwnerType && s.OwnerId == sel.OwnerId;
                            <option value="@s.OwnerType-@s.OwnerId" selected="@selected">@s.Kind: @s.Name</option>
                        }
                    </select>
                </div>
            }
        </div>
        <p class="sv-help mt-1">@sel.Kind: <strong>@sel.Name</strong></p>

        <div class="sv-nav sv-noprint">
            <button id="svTabMoten" class="active" onclick="svShow('moten')"><i class="bi bi-calendar-event me-2"></i>Möten</button>
            <button id="svTabStyrelse" onclick="svShow('styrelse')"><i class="bi bi-people me-2"></i>Styrelsen</button>
            <button id="svTabArshjul" onclick="svShow('arshjul')"><i class="bi bi-arrow-repeat me-2"></i>Årshjul</button>
            <button id="svTabValb" onclick="svShow('valberedning')"><i class="bi bi-person-check me-2"></i>Valberedning</button>
        </div>

        <div id="svMoten"></div>
        <div id="svStyrelse" style="display:none;"></div>
        <div id="svMeeting" style="display:none;"></div>
        <div id="svArshjul" style="display:none;"></div>
        <div id="svValb" style="display:none;"></div>
    }
</div>

@if (sel != null)
{
<!-- Flatpickr -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/sv.js"></script>

<script>
(function () {
    const OWNER_TYPE = @sel.OwnerType;
    const OWNER_ID = @sel.OwnerId;
    const CAN_MANAGE = @(sel.CanManageRoles ? "true" : "false");
    const IS_CLUB = OWNER_TYPE === 0;
    let svMeetings = [], svActions = [], svYear = null, svDocs = null;
    let svWheelYear = null, svNomYear = null;
    const POST_KEYS = [['Ordforande','Ordförande'],['ViceOrdforande','Vice ordförande'],['Sekreterare','Sekreterare'],['Kassor','Kassör'],['Ledamot','Ledamot'],['Suppleant','Suppleant'],['Revisor','Revisor'],['Valberedning','Valberedning']];
    const NOM_STATUSES = ['Föreslagen','Tillfrågad','Tackat ja','Tackat nej'];

    const $ = id => document.getElementById(id);
    function token() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
    function post(ctrl, action, params) {
        return fetch('/umbraco/surface/' + ctrl + '/' + action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token() },
            body: new URLSearchParams(params).toString()
        }).then(r => r.json());
    }
    function get(ctrl, action, qs) {
        return fetch('/umbraco/surface/' + ctrl + '/' + action + '?' + new URLSearchParams(qs).toString()).then(r => r.json());
    }
    function esc(s) {
        if (s === null || s === undefined) return '';
        const m = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
        return s.toString().replace(/[&<>"']/g, c => m[c]);
    }
    function flash(el) { if (!el) return; el.classList.add('show'); setTimeout(() => el.classList.remove('show'), 1800); }

    window.svSwitchScope = function () {
        const v = $('svScope').value.split('-');
        location.href = '/styrelse?type=' + v[0] + '&id=' + v[1];
    };

    window.svShow = function (which) {
        $('svMeeting').style.display = 'none';
        const panes = { moten: 'svMoten', styrelse: 'svStyrelse', arshjul: 'svArshjul', valberedning: 'svValb' };
        const tabs = { moten: 'svTabMoten', styrelse: 'svTabStyrelse', arshjul: 'svTabArshjul', valberedning: 'svTabValb' };
        Object.keys(panes).forEach(k => { $(panes[k]).style.display = (k === which) ? '' : 'none'; $(tabs[k]).classList.toggle('active', k === which); });
        if (which === 'moten') loadMoten();
        if (which === 'styrelse') loadStyrelse();
        if (which === 'arshjul') loadArshjul();
        if (which === 'valberedning') loadValberedning();
    };

    // =====================================================================
    //  MÖTEN (list + create + my tasks)
    // =====================================================================
    function loadMoten() {
        const c = $('svMoten');
        c.innerHTML = spinner();
        Promise.all([
            get('BoardMeeting', 'GetMeetings', { ownerType: OWNER_TYPE, ownerId: OWNER_ID }),
            get('BoardMeeting', 'GetOpenActions', { ownerType: OWNER_TYPE, ownerId: OWNER_ID })
        ]).then(([m, a]) => {
            renderMoten(c, (m.success && m.data) ? m.data : [], (a.success && a.data) ? a.data : []);
        }).catch(() => c.innerHTML = errBox('Kunde inte hämta möten.'));
    }

    function renderMoten(c, meetings, actions) {
        svMeetings = meetings; svActions = actions;
        // Year list = years present in meetings + the current year, newest first.
        const yrs = new Set(meetings.map(m => (m.meetingDate || '').slice(0, 4)).filter(Boolean));
        yrs.add(String(new Date().getFullYear()));
        const years = Array.from(yrs).sort().reverse();
        if (svYear == null || !years.includes(svYear)) svYear = years[0];

        let html = '';

        // Next meeting (nearest future) — independent of the year filter.
        const upcoming = meetings.filter(x => !x.isPast);
        if (upcoming.length) {
            const n = upcoming[upcoming.length - 1]; // meetings are date DESC, so last upcoming = soonest
            html += `<div class="sv-card highlight">
                <h2><i class="bi bi-calendar-event me-2"></i>Nästa möte</h2>
                <p style="font-size:1.2rem;margin:.4rem 0 .2rem;"><strong>${esc(n.title)}</strong></p>
                <p class="sv-help mb-3">${esc(n.meetingDate)}${n.location ? ' · ' + esc(n.location) : ''}</p>
                <button class="btn btn-primary btn-xl" onclick="openMeeting(${n.id}, true)"><i class="bi bi-folder2-open me-2"></i>Öppna mötet</button>
            </div>`;
        }

        // Create new meeting
        html += `<div class="sv-card">
            <h2><i class="bi bi-plus-circle me-2"></i>Skapa nytt möte</h2>
            <p class="sv-help">Välj typ av möte. Dagordningen fylls i automatiskt åt dig och alla i styrelsen läggs till som närvarande – du kan ändra allt sedan.</p>
            <label class="sv-label" for="svNewType">Typ av möte</label>
            <select id="svNewType" class="form-select mb-3" style="max-width:420px;">
                <option value="Styrelsemote">Vanligt styrelsemöte</option>
                <option value="Konstituerande">Konstituerande möte (efter årsmötet)</option>
                <option value="Arsmote">Årsmöte</option>
                <option value="ExtraArsmote">Extra årsmöte</option>
                <option value="Custom">Eget möte</option>
            </select>
            <div>
                <button class="btn btn-success btn-xl" onclick="createMeeting()"><i class="bi bi-plus-lg me-2"></i>Skapa möte</button>
            </div>
        </div>`;

        // Att göra — ALL open tasks (incl. unfinished ones from earlier years), never year-filtered.
        html += `<div class="sv-card">
            <h2><i class="bi bi-check2-square me-2"></i>Att göra</h2>`;
        if (!actions.length) {
            html += `<p class="sv-help mb-0">Inga öppna uppgifter just nu.</p>`;
        } else {
            html += `<p class="sv-help">Uppgifter som styrelsen beslutat och som ännu inte är klara (oavsett år).</p>`;
            actions.forEach(a => {
                const who = a.assignedToName ? ` – ${esc(a.assignedToName)}` : '';
                const due = a.dueDate ? `<span class="${a.isOverdue ? 'text-danger' : 'sv-help'}"> (senast ${esc(a.dueDate)})</span>` : '';
                html += `<div class="sv-person" id="svTask_${a.id}">
                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input sv-check" onchange="markActionDone(${a.id}, this.checked, 'moten')">
                        <span class="svTaskText">${esc(a.description)}<span class="sv-help">${who}</span>${due}</span>
                    </label>
                </div>`;
            });
        }
        html += `</div>`;

        // Meetings for the selected year (year selector lives here).
        html += `<div class="sv-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="mb-0"><i class="bi bi-calendar3 me-2"></i>Möten</h2>
                <div><label class="sv-help me-1" for="svYear">Visa år</label>
                    <select id="svYear" class="form-select d-inline-block" style="width:auto;" onchange="svChangeYear()">
                        ${years.map(y => `<option value="${y}" ${y === svYear ? 'selected' : ''}>${y}</option>`).join('')}
                    </select></div>
            </div>
            <div id="svMeetingList" class="mt-2"></div>
        </div>`;

        c.innerHTML = html;
        renderMeetingList();
    }

    function renderMeetingList() {
        const list = $('svMeetingList'); if (!list) return;
        const ofYear = svMeetings.filter(m => (m.meetingDate || '').slice(0, 4) === svYear);
        if (!ofYear.length) { list.innerHTML = `<p class="sv-help mb-0">Inga möten ${svYear}.</p>`; return; }
        let h = '';
        ofYear.forEach(m => {
            h += `<div class="sv-person">
                <span><strong>${esc(m.title)}</strong><span class="sv-help d-block">${esc(m.meetingDate)}</span></span>
                <span class="d-flex align-items-center gap-2">${statusBadge(m.status)}
                    <button class="btn btn-outline-primary" onclick="openMeeting(${m.id}, true)">Öppna</button></span>
            </div>`;
        });
        list.innerHTML = h;
    }

    window.svChangeYear = function () { svYear = $('svYear').value; renderMeetingList(); };

    window.createMeeting = function () {
        const type = $('svNewType').value;
        const now = new Date();
        const def = now.toISOString().slice(0, 10) + ' 18:30';
        post('BoardMeeting', 'CreateMeeting', { ownerType: OWNER_TYPE, ownerId: OWNER_ID, meetingType: type, title: '', meetingDate: def, location: '' })
            .then(r => { if (r.success) openMeeting(r.data.id, true); else alert(r.message || 'Kunde inte skapa mötet'); });
    };

    // =====================================================================
    //  ETT MÖTE (protokoll)
    // =====================================================================
    // scroll=true only when navigating in from the list/create; in-place refreshes keep the position.
    window.openMeeting = function (meetingId, scroll) {
        $('svMoten').style.display = 'none';
        $('svStyrelse').style.display = 'none';
        const c = $('svMeeting'); c.style.display = '';
        if (scroll) c.innerHTML = spinner();
        get('BoardMeeting', 'GetMeetingDetail', { meetingId }).then(d => {
            if (!d.success) { c.innerHTML = errBox(d.message || 'Kunde inte öppna mötet.'); return; }
            renderMeeting(c, d);
            if (scroll) window.scrollTo({ top: 0, behavior: 'smooth' });
        }).catch(() => c.innerHTML = errBox('Kunde inte öppna mötet.'));
    };

    function renderMeeting(c, d) {
        const m = d.meeting, q = d.quorum, locked = m.status === 'Justerat';
        let html = `<button class="btn btn-outline-secondary btn-xl mb-3 sv-noprint" onclick="svShow('moten')"><i class="bi bi-arrow-left me-2"></i>Tillbaka till möten</button>`;

        // Header
        html += `<div class="sv-card">`;
        if (locked) {
            html += `<h2>${esc(m.title)}</h2>
                <p class="sv-help">${esc(m.typeLabel)} · ${esc(m.meetingDate)}${m.location ? ' · ' + esc(m.location) : ''}</p>
                <p class="text-success mb-0"><i class="bi bi-lock-fill me-1"></i>Protokollet är justerat och låst.${m.justifiedDate ? ' (' + esc(m.justifiedDate) + ')' : ''}</p>`;
        } else {
            html += `<div class="row g-3">
                <div class="col-12"><label class="sv-label">Rubrik</label>
                    <input type="text" id="mTitle" class="form-control" value="${esc(m.title)}" onchange="saveMeeting()"></div>
                <div class="col-12 col-md-6"><label class="sv-label">Datum och tid</label>
                    <input type="text" id="mDate" class="form-control" value="${esc(m.meetingDate)}"></div>
                <div class="col-12 col-md-6"><label class="sv-label">Plats</label>
                    <input type="text" id="mLoc" class="form-control" value="${esc(m.location || '')}" onchange="saveMeeting()" placeholder="t.ex. Klubbstugan"></div>
            </div>
            <div class="mt-2"><span id="mSaved" class="sv-saved"><i class="bi bi-check-lg"></i> Sparat</span></div>`;
        }
        html += `</div>`;

        // Kallelse (send the meeting notice by email)
        const isArs = m.meetingType === 'Arsmote' || m.meetingType === 'ExtraArsmote';
        html += `<div class="sv-card sv-noprint"><h2><i class="bi bi-envelope-paper me-2"></i>Kallelse</h2>`;
        if (m.kallelseSentDate)
            html += `<p class="text-success mb-2"><i class="bi bi-check-circle me-1"></i>Kallelse skickad ${esc(m.kallelseSentDate)}${m.kallelseRecipientCount != null ? ' till ' + m.kallelseRecipientCount + ' mottagare' : ''}.</p>`;
        if (!locked) {
            html += `<p class="sv-help">Skicka kallelse med dagordningen via e-post. ${isArs ? 'För årsmöte går kallelsen till <strong>alla medlemmar i klubben</strong>.' : 'Kallelsen går till <strong>styrelsen</strong>.'}</p>
                <textarea id="kallelseMsg" class="form-control mb-2" rows="2" placeholder="Eget meddelande i kallelsen (frivilligt)…"></textarea>
                <button class="btn btn-primary btn-xl" onclick="sendKallelse(${m.id})"><i class="bi bi-envelope-paper me-2"></i>${m.kallelseSentDate ? 'Skicka kallelse igen' : 'Skicka kallelse'}</button>`;
        }
        html += `</div>`;

        // Quorum + attendance (toggling presence updates the banner in place — no reload/scroll)
        html += `<div id="svQuorum" class="sv-card ${q.isMet ? 'sv-quorum-ok' : 'sv-quorum-no'}" data-required="${q.required}" data-total="${q.total}">
            <h2><i class="bi bi-people me-2"></i>Närvaro</h2>
            <p id="svQuorumMsg" style="font-size:1.15rem;margin-bottom:.75rem;">${quorumMsgHtml(q)}</p>`;
        d.attendees.forEach(a => {
            const roleTxt = a.roleTitle ? `<span class="sv-help">${esc(a.roleTitle)}</span>` : '';
            if (locked) {
                html += `<div class="sv-person"><span>${esc(a.memberName || '-')} ${roleTxt}</span><span>${esc(a.attendanceStatus)}</span></div>`;
            } else {
                html += `<div class="sv-person">
                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input sv-check svAttChk" ${a.attendanceStatus === 'Närvarande' ? 'checked' : ''} onchange="togglePresent(${a.id}, this.checked)">
                        <span>${esc(a.memberName || '-')}<br>${roleTxt}</span>
                    </label>
                    <span class="sv-help" id="svAttStatus_${a.id}">${a.attendanceStatus === 'Närvarande' ? 'Närvarande' : 'Frånvarande'}</span>
                </div>`;
            }
        });
        if (!locked && CAN_MANAGE) {
            html += `<button class="btn btn-link p-0 mt-2 sv-noprint" onclick="syncBoard(${m.id})">Saknas någon? Hämta styrelsen igen</button>`;
        }
        html += `</div>`;

        // Agenda / protokoll
        html += `<div class="sv-card">
            <h2><i class="bi bi-list-ol me-2"></i>Dagordning och beslut</h2>`;
        d.agenda.forEach((it, i) => html += agendaCard(it, i + 1, locked, d.links || []));
        if (!locked) {
            html += `<div class="mt-3"><label class="sv-label">Lägg till en punkt</label>
                <div class="d-flex gap-2" style="max-width:540px;">
                    <input type="text" id="newAgenda" class="form-control" placeholder="Rubrik på punkten">
                    <button class="btn btn-outline-primary" onclick="addAgenda(${m.id})">Lägg till</button>
                </div></div>`;
        }
        html += `</div>`;

        // Actions
        html += `<div class="sv-card">
            <h2><i class="bi bi-check2-square me-2"></i>Uppgifter (att göra)</h2>`;
        if (d.actions.length) {
            d.actions.forEach(a => {
                const who = a.assignedToName ? ` – ${esc(a.assignedToName)}` : '';
                const due = a.dueDate ? `<span class="${a.isOverdue ? 'text-danger' : 'sv-help'}"> (senast ${esc(a.dueDate)})</span>` : '';
                html += `<div class="sv-person" id="svAct_${a.id}">
                    <label class="d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input sv-check" ${a.isDone ? 'checked' : ''} ${locked ? 'disabled' : ''} onchange="markActionDone(${a.id}, this.checked, 'meeting')">
                        <span class="svActText ${a.isDone ? 'text-decoration-line-through sv-help' : ''}">${esc(a.description)}<span class="sv-help">${who}</span>${due}</span>
                    </label>
                    ${locked ? '' : `<button class="btn btn-sm btn-outline-danger sv-noprint" onclick="removeAction(${a.id}, ${m.id})" title="Ta bort">Ta bort</button>`}
                </div>`;
            });
        } else {
            html += `<p class="sv-help">Inga uppgifter ännu.</p>`;
        }
        if (!locked) {
            const opts = '<option value="">Ingen särskild person</option>' +
                d.attendees.map(a => `<option value="${a.memberId}">${esc(a.memberName || '')}</option>`).join('');
            html += `<div class="row g-2 mt-2" style="max-width:640px;">
                <div class="col-12"><input type="text" id="actDesc" class="form-control" placeholder="Vad ska göras?"></div>
                <div class="col-12 col-md-6"><label class="sv-help">Vem ansvarar?</label><select id="actWho" class="form-select">${opts}</select></div>
                <div class="col-12 col-md-6"><label class="sv-help">Klart senast (frivilligt)</label><input type="text" id="actDue" class="form-control" placeholder="Välj datum"></div>
                <div class="col-12"><button class="btn btn-primary" onclick="addAction(${m.id})"><i class="bi bi-plus-lg me-1"></i>Lägg till uppgift</button></div>
            </div>`;
        }
        html += `</div>`;

        // Justering + print
        if (!locked) {
            const adj = d.attendees.map(a => `<option value="${a.memberId}">${esc(a.memberName || '')}</option>`).join('');
            html += `<div class="sv-card sv-noprint">
                <h2><i class="bi bi-lock me-2"></i>Klar med protokollet?</h2>
                <p class="sv-help">När protokollet är justerat låses det så att inget ändras av misstag.</p>
                <label class="sv-label">Vem justerar protokollet?</label>
                <select id="adjuster" class="form-select mb-3" style="max-width:420px;">${adj || '<option value="">—</option>'}</select>
                <button class="btn btn-success btn-xl" onclick="justera(${m.id})"><i class="bi bi-lock-fill me-2"></i>Markera som justerat</button>
            </div>`;
        }
        html += `<div class="mt-3 d-flex gap-2 flex-wrap sv-noprint">
            <a class="btn btn-outline-secondary btn-xl" href="/styrelse/dagordning/${m.id}" target="_blank"><i class="bi bi-card-list me-2"></i>Skriv ut dagordning</a>
            <a class="btn btn-outline-secondary btn-xl" href="/styrelse/protokoll/${m.id}" target="_blank"><i class="bi bi-printer me-2"></i>Skriv ut protokoll</a>
        </div>`;

        c.innerHTML = html;

        if (typeof flatpickr !== 'undefined' && !locked) {
            if ($('mDate')) flatpickr('#mDate', { locale: 'sv', enableTime: true, time_24hr: true, dateFormat: 'Y-m-d H:i', onChange: saveMeeting });
            if ($('actDue')) flatpickr('#actDue', { locale: 'sv', dateFormat: 'Y-m-d' });
        }
        window._mId = m.id;
        window._mYear = parseInt((m.meetingDate || '').slice(0, 4), 10) || new Date().getFullYear();
    }

    function agendaCard(it, num, locked, allLinks) {
        const links = (allLinks || []).filter(l => l.agendaItemId === it.id);
        const linksHtml = links.map(l => linkChip(l, locked)).join('');
        if (locked) {
            return `<div class="mb-3 pb-2" style="border-bottom:1px solid var(--bs-border-color);">
                <div style="font-size:1.15rem;font-weight:600;"><span class="sv-agenda-num">${num}</span>${esc(it.heading)}</div>
                ${it.discussion ? `<div class="mt-1" style="white-space:pre-wrap;">${esc(it.discussion)}</div>` : ''}
                ${it.decision ? `<div class="mt-1"><strong>Beslut:</strong> <span style="white-space:pre-wrap;">${esc(it.decision)}</span></div>` : ''}
                ${linksHtml ? `<div class="mt-1">${linksHtml}</div>` : ''}
            </div>`;
        }
        return `<div class="mb-3 pb-3" style="border-bottom:1px solid var(--bs-border-color);">
            <div class="d-flex align-items-center mb-2">
                <span class="sv-agenda-num">${num}</span>
                <input type="text" class="form-control" style="font-weight:600;" value="${esc(it.heading)}" id="ag_h_${it.id}" onchange="saveAgenda(${it.id})">
                <button class="btn btn-sm btn-outline-danger ms-2 sv-noprint" onclick="removeAgenda(${it.id})" title="Ta bort punkt">Ta bort</button>
            </div>
            <label class="sv-help">Anteckningar</label>
            <textarea class="form-control mb-2" rows="2" id="ag_disc_${it.id}" onchange="saveAgenda(${it.id})" placeholder="Vad sas under punkten?">${esc(it.discussion || '')}</textarea>
            <label class="sv-help">Beslut</label>
            <textarea class="form-control" rows="2" id="ag_dec_${it.id}" onchange="saveAgenda(${it.id})" placeholder="Vad beslutade styrelsen?">${esc(it.decision || '')}</textarea>
            <span id="ag_saved_${it.id}" class="sv-saved"><i class="bi bi-check-lg"></i> Sparat</span>
            <div class="mt-2">${linksHtml}</div>
            <details class="sv-noprint mt-1"><summary class="sv-help" style="cursor:pointer;">+ Bifoga dokument, möte, valberedningens förslag eller länk</summary>
                <div class="mt-2 d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-secondary" onclick="attachDoc(${it.id})"><i class="bi bi-file-earmark me-1"></i>Dokument</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="attachMeeting(${it.id})"><i class="bi bi-calendar-event me-1"></i>Tidigare möte</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="attachValforslag(${it.id})"><i class="bi bi-person-check me-1"></i>Valberedningens förslag</button>
                    <button class="btn btn-sm btn-outline-secondary" onclick="attachUrl(${it.id})"><i class="bi bi-link-45deg me-1"></i>Länk (URL)</button>
                </div>
            </details>
        </div>`;
    }

    function linkChip(l, locked) {
        const icon = l.kind === 'document' ? 'bi-file-earmark-text' : l.kind === 'meeting' ? 'bi-calendar-event'
            : l.kind === 'valforslag' ? 'bi-person-check' : 'bi-link-45deg';
        let href = '#', extra = 'target="_blank"';
        if (l.kind === 'document') href = '/umbraco/surface/Document/DownloadDocument?id=' + l.refId;
        else if (l.kind === 'meeting') { href = '#'; extra = `onclick="event.preventDefault();openMeeting(${l.refId}, true)"`; }
        else if (l.kind === 'valforslag') href = `/styrelse/valforslag?type=${OWNER_TYPE}&id=${OWNER_ID}&year=${l.refId}`;
        else href = l.url || '#';
        const rm = locked ? '' : ` <a href="#" class="text-danger ms-1 sv-noprint" title="Ta bort" onclick="event.preventDefault();removeLink(${l.id})">✕</a>`;
        return `<div class="sv-help" style="margin:.1rem 0;"><i class="bi ${icon} me-1"></i><a href="${href}" ${extra}>${esc(l.label)}</a>${rm}</div>`;
    }

    window.saveMeeting = function () {
        post('BoardMeeting', 'UpdateMeeting', {
            meetingId: window._mId, meetingType: '', title: $('mTitle').value,
            meetingDate: $('mDate').value, location: $('mLoc').value, notes: ''
        }).then(r => { if (r.success) flash($('mSaved')); });
    };
    window.saveAgenda = function (id) {
        post('BoardMeeting', 'UpdateAgendaItem', { agendaItemId: id, heading: $('ag_h_' + id).value, discussion: $('ag_disc_' + id).value, decision: $('ag_dec_' + id).value })
            .then(r => { if (r.success) flash($('ag_saved_' + id)); });
    };
    window.addAgenda = function (mid) {
        const h = $('newAgenda').value.trim(); if (!h) return;
        post('BoardMeeting', 'AddAgendaItem', { meetingId: mid, heading: h }).then(r => { if (r.success) openMeeting(mid); });
    };
    window.removeAgenda = function (id) {
        if (!confirm('Ta bort den här punkten?')) return;
        post('BoardMeeting', 'RemoveAgendaItem', { agendaItemId: id }).then(r => { if (r.success) openMeeting(window._mId); });
    };
    // Presence toggle updates the beslutsför banner in place — no reload, no scroll jump.
    window.togglePresent = function (id, present) {
        const lbl = $('svAttStatus_' + id);
        post('BoardMeeting', 'SetAttendance', { attendeeId: id, attendanceStatus: present ? 'Närvarande' : 'Frånvarande' })
            .then(r => { if (r.success) { if (lbl) lbl.textContent = present ? 'Närvarande' : 'Frånvarande'; updateQuorum(); } });
    };
    function updateQuorum() {
        const card = $('svQuorum'); if (!card) return;
        const req = parseInt(card.dataset.required, 10) || 0;
        const total = parseInt(card.dataset.total, 10) || 0;
        const present = card.querySelectorAll('.svAttChk:checked').length;
        const met = present >= req && req > 0;
        card.classList.toggle('sv-quorum-ok', met);
        card.classList.toggle('sv-quorum-no', !met);
        $('svQuorumMsg').innerHTML = quorumMsgHtml({ isMet: met, present, total, required: req });
    }
    function quorumMsgHtml(q) {
        return (q.isMet
            ? `<i class="bi bi-check-circle-fill text-success me-1"></i><strong>Styrelsen är beslutsför.</strong>`
            : `<i class="bi bi-exclamation-triangle-fill text-warning me-1"></i><strong>Styrelsen är inte beslutsför.</strong>`)
            + `<span class="sv-help d-block">${q.present} av ${q.total} närvarande (minst ${q.required} krävs).</span>`;
    }
    window.syncBoard = function (mid) { post('BoardMeeting', 'SyncAttendees', { meetingId: mid }).then(r => { if (r.success) openMeeting(mid); }); };
    window.sendKallelse = function (mid) {
        const msg = $('kallelseMsg') ? $('kallelseMsg').value : '';
        get('BoardKallelse', 'GetKallelsePreview', { meetingId: mid }).then(p => {
            if (!p.success) { alert(p.message || 'Kunde inte förbereda kallelsen'); return; }
            if (p.count === 0) { alert('Inga mottagare med e-postadress hittades (' + p.audience + ').'); return; }
            if (p.tooMany) { alert('För många mottagare (' + p.count + ') för direktutskick. Använd klubbens Brevo-utskick under Medlemmar.'); return; }
            if (!confirm('Skicka kallelse till ' + p.count + ' mottagare (' + p.audience + ')?')) return;
            post('BoardKallelse', 'SendKallelse', { meetingId: mid, message: msg }).then(r => {
                if (r.success) { alert('Kallelsen skickades till ' + r.sent + ' mottagare' + (r.failed ? ' (' + r.failed + ' misslyckades)' : '') + '.'); openMeeting(mid, true); }
                else alert(r.message || 'Utskicket misslyckades');
            });
        });
    };
    window.addAction = function (mid) {
        const desc = $('actDesc').value.trim(); if (!desc) { alert('Skriv vad som ska göras'); return; }
        post('BoardMeeting', 'AddAction', { ownerType: OWNER_TYPE, ownerId: OWNER_ID, meetingId: mid, agendaItemId: '', description: desc, assignedToMemberId: $('actWho').value || '', dueDate: $('actDue').value || '' })
            .then(r => { if (r.success) openMeeting(mid); else alert(r.message || 'Kunde inte lägga till'); });
    };
    // Checking off a task updates the row in place — no reload, no scroll to top.
    window.markActionDone = function (id, done, ctx) {
        post('BoardMeeting', 'SetActionDone', { actionId: id, done }).then(r => {
            if (!r.success) return;
            const row = $((ctx === 'moten' ? 'svTask_' : 'svAct_') + id);
            const txt = row && row.querySelector('.svTaskText, .svActText');
            if (txt) { txt.classList.toggle('text-decoration-line-through', done); txt.classList.toggle('sv-help', done); }
        });
    };
    window.removeAction = function (id, mid) {
        if (!confirm('Ta bort uppgiften?')) return;
        post('BoardMeeting', 'RemoveAction', { actionId: id }).then(r => { if (r.success) openMeeting(mid); });
    };

    // ---- Agenda attachments (dokument / tidigare möte / länk) ----------
    function svChoose(title, options, cb) {
        if (!options.length) { alert('Inget att välja.'); return; }
        const ov = document.createElement('div');
        ov.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:3000;display:flex;align-items:center;justify-content:center;padding:1rem;';
        ov.innerHTML = `<div style="background:var(--bs-body-bg);border-radius:.8rem;padding:1.2rem;max-width:480px;width:100%;max-height:80vh;overflow:auto;">
            <h3 style="font-size:1.3rem;">${esc(title)}</h3><div id="svChooseList" class="mt-2"></div>
            <div class="text-end mt-2"><button class="btn btn-outline-secondary btn-xl" id="svChooseCancel">Avbryt</button></div></div>`;
        document.body.appendChild(ov);
        const list = ov.querySelector('#svChooseList');
        options.forEach(o => {
            const b = document.createElement('button');
            b.className = 'btn btn-outline-primary w-100 text-start mb-2'; b.style.padding = '.7rem 1rem';
            b.textContent = o.label;
            b.onclick = () => { document.body.removeChild(ov); cb(o); };
            list.appendChild(b);
        });
        const close = () => document.body.removeChild(ov);
        ov.querySelector('#svChooseCancel').onclick = close;
        ov.onclick = e => { if (e.target === ov) close(); };
    }
    function loadDocs() {
        if (svDocs) return Promise.resolve(svDocs);
        return get('Document', 'GetPublicDocuments', { ownerType: OWNER_TYPE, ownerId: OWNER_ID })
            .then(r => { svDocs = (r.success && r.data) ? r.data : []; return svDocs; });
    }
    function loadMeetingsForPicker() {
        if (svMeetings.length) return Promise.resolve(svMeetings);
        return get('BoardMeeting', 'GetMeetings', { ownerType: OWNER_TYPE, ownerId: OWNER_ID })
            .then(r => { svMeetings = (r.success && r.data) ? r.data : []; return svMeetings; });
    }
    window.attachDoc = function (itemId) {
        loadDocs().then(docs => {
            if (!docs.length) { alert('Det finns inga dokument i arkivet för den här klubben/kretsen ännu. Lägg upp dokument under fliken Dokument först.'); return; }
            svChoose('Välj dokument att bifoga', docs.map(d => ({ label: d.title + (d.fileName ? ' (' + d.fileName + ')' : ''), v: d })), o =>
                post('BoardMeeting', 'AddAgendaLink', { agendaItemId: itemId, kind: 'document', refId: o.v.id, url: '', label: o.v.title })
                    .then(r => { if (r.success) openMeeting(window._mId); }));
        });
    };
    window.attachMeeting = function (itemId) {
        loadMeetingsForPicker().then(ms => {
            const opts = ms.filter(m => m.id !== window._mId).map(m => ({ label: m.title + ' (' + m.meetingDate + ')', v: m }));
            if (!opts.length) { alert('Det finns inga andra möten att länka till.'); return; }
            svChoose('Välj möte att länka', opts, o =>
                post('BoardMeeting', 'AddAgendaLink', { agendaItemId: itemId, kind: 'meeting', refId: o.v.id, url: '', label: o.v.title })
                    .then(r => { if (r.success) openMeeting(window._mId); }));
        });
    };
    window.attachValforslag = function (itemId) {
        // Links the valberedningens förslag for the meeting's year (årsmöte-året). Offer ±1 year too.
        const y = window._mYear || new Date().getFullYear();
        svChoose('Vilket års förslag?', [y, y - 1, y + 1].map(yr => ({ label: 'Valberedningens förslag ' + yr, v: yr })), o =>
            post('BoardMeeting', 'AddAgendaLink', { agendaItemId: itemId, kind: 'valforslag', refId: o.v, url: '', label: 'Valberedningens förslag ' + o.v })
                .then(r => { if (r.success) openMeeting(window._mId); }));
    };
    window.attachUrl = function (itemId) {
        const label = prompt('Vad heter länken? (t.ex. Verksamhetsberättelse 2025)'); if (!label) return;
        const url = prompt('Klistra in webbadressen (URL):'); if (!url) return;
        post('BoardMeeting', 'AddAgendaLink', { agendaItemId: itemId, kind: 'url', refId: '', url, label })
            .then(r => { if (r.success) openMeeting(window._mId); });
    };
    window.removeLink = function (id) {
        post('BoardMeeting', 'RemoveAgendaLink', { linkId: id }).then(r => { if (r.success) openMeeting(window._mId); });
    };
    window.justera = function (mid) {
        const adj = $('adjuster').value; if (!adj) { alert('Välj vem som justerar'); return; }
        if (!confirm('Markera protokollet som justerat? Det går inte att ändra efteråt.')) return;
        post('BoardMeeting', 'SetJusterat', { meetingId: mid, adjusterMemberId: adj }).then(r => { if (r.success) openMeeting(mid); else alert(r.message || 'Gick inte att justera'); });
    };

    // =====================================================================
    //  STYRELSEN (roster + manage)
    // =====================================================================
    function loadStyrelse() {
        const c = $('svStyrelse'); c.innerHTML = spinner();
        Promise.all([
            get('BoardRole', 'GetBoardMembers', { ownerType: OWNER_TYPE, ownerId: OWNER_ID }),
            get('BoardRole', 'GetExpiringTerms', { ownerType: OWNER_TYPE, ownerId: OWNER_ID, withinDays: 365 })
        ]).then(([r, e]) => {
            renderStyrelse(c, (r.success && r.data) ? r.data : [], (e.success && e.data) ? e.data : []);
        }).catch(() => c.innerHTML = errBox('Kunde inte hämta styrelsen.'));
    }

    function renderStyrelse(c, roles, expiring) {
        let html = `<div class="sv-card"><h2><i class="bi bi-people me-2"></i>Styrelsen</h2>`;
        if (!roles.length) {
            html += `<p class="sv-help">Inga roller är tilldelade ännu.</p>`;
        } else {
            roles.forEach(r => {
                const term = r.termEndsDate
                    ? (r.isTermExpired
                        ? `<span class="text-danger">Mandat gick ut ${esc(r.termEndsDate)}</span>`
                        : `Vald t.o.m. ${esc(r.termEndsDate)}`)
                    : '<span class="sv-help">Ingen mandattid angiven</span>';
                html += `<div class="sv-person">
                    <span><strong style="font-size:1.1rem;">${esc(r.memberName || '-')}</strong>
                        <span class="d-block">${esc(r.title)}</span>
                        <span class="sv-help d-block">${term}</span></span>
                    ${CAN_MANAGE ? `<button class="btn btn-outline-danger btn-sm sv-noprint" onclick="removeRole(${r.id}, '${esc(r.memberName)}', '${esc(r.title)}')">Ta bort</button>` : ''}
                </div>`;
            });
        }
        html += `</div>`;

        // Expiring terms
        if (expiring.length) {
            html += `<div class="sv-card sv-quorum-no"><h2><i class="bi bi-hourglass-split me-2"></i>Mandat som snart går ut</h2>
                <p class="sv-help">Dags att förbereda val på årsmötet för dessa.</p>`;
            expiring.forEach(r => {
                html += `<div class="sv-person"><span>${esc(r.memberName || '-')} – ${esc(r.title)}</span>
                    <span>${r.isTermExpired ? '<span class="text-danger">utgånget</span>' : 'till ' + esc(r.termEndsDate)}</span></div>`;
            });
            html += `</div>`;
        }

        // Manage (admins only)
        if (CAN_MANAGE) {
            html += `<div class="sv-card sv-noprint"><h2><i class="bi bi-person-plus me-2"></i>Lägg till någon i styrelsen</h2>
                <div class="row g-3" style="max-width:640px;">
                    <div class="col-12"><label class="sv-label">Person</label>${IS_CLUB
                        ? `<select id="addMember" class="form-select"><option value="">Välj medlem…</option></select>`
                        : `<input type="text" id="addMemberSearch" class="form-control" placeholder="Sök namn…" autocomplete="off"><select id="addMemberResults" class="form-select mt-1 d-none" size="4"></select>`}
                    </div>
                    <div class="col-12 col-md-6"><label class="sv-label">Roll</label>
                        <select id="addRole" class="form-select" onchange="onRoleChange()"><option value="">Välj roll…</option></select></div>
                    <div class="col-12 col-md-6 d-none" id="customWrap"><label class="sv-label">Egen titel</label>
                        <input type="text" id="addCustom" class="form-control" placeholder="t.ex. Materialförvaltare"></div>
                    <div class="col-6 col-md-4"><label class="sv-label">Vald datum</label><input type="text" id="addElected" class="form-control"></div>
                    <div class="col-6 col-md-3"><label class="sv-label">Mandat (år)</label><input type="number" id="addYears" class="form-control" min="1" max="10" placeholder="2"></div>
                    <div class="col-12 col-md-5"><label class="sv-label">Mandat t.o.m.</label><input type="text" id="addEnds" class="form-control"></div>
                    <div class="col-12"><button class="btn btn-success btn-xl" onclick="assignRole()"><i class="bi bi-plus-lg me-2"></i>Lägg till i styrelsen</button></div>
                </div></div>`;
        }
        c.innerHTML = html;
        if (CAN_MANAGE) initManage();
    }

    function initManage() {
        // roles dropdown
        get('BoardRole', 'GetAvailableRoles', {}).then(r => {
            if (!r.success) return;
            const sel = $('addRole');
            r.data.forEach(x => sel.innerHTML += `<option value="${x.key}">${esc(x.label)}</option>`);
            sel.innerHTML += '<option value="Custom">Annat…</option>';
        });
        if (IS_CLUB) {
            get('ClubAdmin', 'GetClubMembers', { clubId: OWNER_ID }).then(r => {
                const sel = $('addMember'); if (!sel || !r.success) return;
                (r.data || []).filter(m => m.isApproved !== false).forEach(m => sel.innerHTML += `<option value="${m.id}">${esc(m.memberName)}</option>`);
            });
        } else {
            const inp = $('addMemberSearch');
            let t = null;
            inp?.addEventListener('input', e => {
                clearTimeout(t); const q = e.target.value.trim();
                if (q.length < 2) { $('addMemberResults').classList.add('d-none'); return; }
                t = setTimeout(() => get('BoardRole', 'SearchMembers', { query: q, ownerType: OWNER_TYPE, ownerId: OWNER_ID }).then(r => {
                    const s = $('addMemberResults'); s.innerHTML = '';
                    (r.data || []).forEach(m => s.innerHTML += `<option value="${m.id}">${esc(m.name)}</option>`);
                    s.classList.remove('d-none');
                }), 300);
            });
            $('addMemberResults')?.addEventListener('change', function () {
                const o = this.options[this.selectedIndex];
                if (o?.value) { inp.value = o.textContent; this.dataset.id = o.value; this.classList.add('d-none'); }
            });
        }
        if (typeof flatpickr !== 'undefined') {
            let dirty = false;
            const ends = flatpickr('#addEnds', { locale: 'sv', dateFormat: 'Y-m-d', onChange: () => dirty = true });
            flatpickr('#addElected', { locale: 'sv', dateFormat: 'Y-m-d', onChange: fill });
            $('addYears')?.addEventListener('input', fill);
            function fill() {
                if (dirty) return;
                const el = $('addElected').value, y = parseInt($('addYears').value, 10);
                if (!el || !y) return;
                const d = new Date(el + 'T00:00:00'); if (isNaN(d)) return;
                d.setFullYear(d.getFullYear() + y); ends.setDate(d.toISOString().slice(0, 10), false);
            }
        }
    }

    window.onRoleChange = function () {
        const v = $('addRole').value;
        $('customWrap').classList.toggle('d-none', v !== 'Custom');
    };
    window.assignRole = function () {
        const memberId = IS_CLUB ? $('addMember').value : ($('addMemberResults')?.dataset.id || '');
        const roleKey = $('addRole').value;
        const custom = $('addCustom') ? $('addCustom').value.trim() : '';
        if (!memberId) { alert('Välj en person'); return; }
        if (!roleKey) { alert('Välj en roll'); return; }
        if (roleKey === 'Custom' && !custom) { alert('Skriv en titel'); return; }
        post('BoardRole', 'AssignBoardRole', {
            ownerType: OWNER_TYPE, ownerId: OWNER_ID, memberId, roleKey,
            customTitle: roleKey === 'Custom' ? custom : '', isBoardMember: true,
            electedDate: $('addElected').value || '', termEndsDate: $('addEnds').value || '', termYears: $('addYears').value || ''
        }).then(r => { if (r.success) loadStyrelse(); else alert(r.message || 'Kunde inte lägga till'); });
    };
    window.removeRole = function (id, name, title) {
        if (!confirm(`Ta bort ${name} (${title}) från styrelsen?`)) return;
        post('BoardRole', 'RemoveBoardRole', { boardRoleId: id }).then(r => { if (r.success) loadStyrelse(); });
    };

    // =====================================================================
    //  ÅRSHJUL (annual cycle checklist)
    // =====================================================================
    function loadArshjul() {
        const c = $('svArshjul'); c.innerHTML = spinner();
        const y = svWheelYear || new Date().getFullYear();
        get('BoardGovernance', 'GetYearWheel', { ownerType: OWNER_TYPE, ownerId: OWNER_ID, year: y })
            .then(r => { if (!r.success) { c.innerHTML = errBox(r.message || 'Fel'); return; } svWheelYear = y; renderArshjul(c, r.data || [], r.years || [y]); })
            .catch(() => c.innerHTML = errBox('Kunde inte hämta årshjulet.'));
    }
    function renderArshjul(c, items, years) {
        if (!years.includes(svWheelYear)) years.unshift(svWheelYear);
        let html = `<div class="sv-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Årshjul ${svWheelYear}</h2>
                <div><label class="sv-help me-1">Visa år</label>
                    <select class="form-select d-inline-block" style="width:auto;" onchange="svWheelSetYear(this.value)">
                        ${years.map(y => `<option value="${y}" ${y == svWheelYear ? 'selected' : ''}>${y}</option>`).join('')}
                    </select></div>
            </div>
            <p class="sv-help mt-1">Föreningens årliga uppgifter. Bocka av när de är klara. (Standarduppgifter fylls i automatiskt – ändra fritt.)</p>`;
        items.forEach(it => {
            const dt = it.targetDate ? `<span class="${it.isOverdue ? 'text-danger' : 'sv-help'}"> · ${esc(it.targetDate)}${it.isOverdue ? ' (försenat)' : ''}</span>` : '';
            html += `<div class="sv-person" id="svWheel_${it.id}">
                <label class="d-flex align-items-center gap-2 mb-0" style="cursor:pointer;">
                    <input type="checkbox" class="form-check-input sv-check" ${it.done ? 'checked' : ''} onchange="svWheelDone(${it.id}, this.checked)">
                    <span class="svWheelText ${it.done ? 'text-decoration-line-through sv-help' : ''}">${esc(it.title)}${dt}</span>
                </label>
                ${CAN_MANAGE ? `<button class="btn btn-sm btn-outline-danger sv-noprint" onclick="svWheelRemove(${it.id})" title="Ta bort">Ta bort</button>` : ''}
            </div>`;
        });
        html += `<div class="row g-2 mt-2" style="max-width:640px;">
            <div class="col-12 col-md-7"><input type="text" id="svWheelNewTitle" class="form-control" placeholder="Lägg till egen uppgift…"></div>
            <div class="col-6 col-md-3"><input type="text" id="svWheelNewDate" class="form-control" placeholder="Datum (frivilligt)"></div>
            <div class="col-6 col-md-2"><button class="btn btn-primary w-100" onclick="svWheelAdd()"><i class="bi bi-plus-lg"></i></button></div>
        </div></div>`;
        c.innerHTML = html;
        if (typeof flatpickr !== 'undefined' && $('svWheelNewDate')) flatpickr('#svWheelNewDate', { locale: 'sv', dateFormat: 'Y-m-d' });
    }
    window.svWheelSetYear = function (y) { svWheelYear = parseInt(y, 10); loadArshjul(); };
    window.svWheelDone = function (id, done) {
        post('BoardGovernance', 'SetWheelDone', { itemId: id, done }).then(r => {
            if (!r.success) return;
            const t = $('svWheel_' + id) && $('svWheel_' + id).querySelector('.svWheelText');
            if (t) { t.classList.toggle('text-decoration-line-through', done); t.classList.toggle('sv-help', done); }
        });
    };
    window.svWheelAdd = function () {
        const title = $('svWheelNewTitle').value.trim(); if (!title) return;
        post('BoardGovernance', 'AddWheelItem', { ownerType: OWNER_TYPE, ownerId: OWNER_ID, year: svWheelYear, title, targetDate: $('svWheelNewDate').value || '' })
            .then(r => { if (r.success) loadArshjul(); });
    };
    window.svWheelRemove = function (id) {
        if (!confirm('Ta bort uppgiften från årshjulet?')) return;
        post('BoardGovernance', 'RemoveWheelItem', { itemId: id }).then(r => { if (r.success) loadArshjul(); });
    };

    // =====================================================================
    //  VALBEREDNING (nominations)
    // =====================================================================
    function loadValberedning() {
        const c = $('svValb'); c.innerHTML = spinner();
        // Valberedningen arbetar inför NÄSTA årsmöte → utgå från nästa år (året går att byta i listan).
        const y = svNomYear || (new Date().getFullYear() + 1);
        get('BoardGovernance', 'GetNominations', { ownerType: OWNER_TYPE, ownerId: OWNER_ID, year: y })
            .then(r => { if (!r.success) { c.innerHTML = errBox(r.message || 'Fel'); return; } svNomYear = y; renderValberedning(c, r); })
            .catch(() => c.innerHTML = errBox('Kunde inte hämta valberedningen.'));
    }
    function renderValberedning(c, r) {
        const noms = r.data || [], posts = r.postsUpForElection || [], years = r.years || [svNomYear];
        if (!years.includes(svNomYear)) years.unshift(svNomYear);
        let html = `<div class="sv-card">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="mb-0"><i class="bi bi-person-check me-2"></i>Valberedning ${svNomYear}</h2>
                <div class="d-flex gap-2 align-items-center">
                    <label class="sv-help">Inför år</label>
                    <select class="form-select d-inline-block" style="width:auto;" onchange="svNomSetYear(this.value)">
                        ${years.map(y => `<option value="${y}" ${y == svNomYear ? 'selected' : ''}>${y}</option>`).join('')}
                    </select>
                    <a class="btn btn-outline-secondary sv-noprint" href="/styrelse/valforslag?type=${OWNER_TYPE}&id=${OWNER_ID}&year=${svNomYear}" target="_blank"><i class="bi bi-printer me-1"></i>Skriv ut förslag</a>
                </div>
            </div>`;

        // Posts up for election
        html += `<p class="sv-help mt-1"><strong>Poster på val (mandat t.o.m. ${svNomYear}):</strong> `;
        html += posts.length
            ? posts.map(p => `${esc(p.title)} (${esc(p.memberName || '')})`).join(', ')
            : `inga mandat med slutdatum t.o.m. ${svNomYear}. Ange mandattider på fliken <strong>Styrelsen</strong> (eller välj ett annat år ovan) så listas posterna automatiskt.`;
        html += `</p></div>`;

        // Nominations
        html += `<div class="sv-card"><h2><i class="bi bi-people me-2"></i>Förslag på kandidater</h2>`;
        if (!noms.length) html += `<p class="sv-help">Inga förslag ännu.</p>`;
        noms.forEach(n => {
            html += `<div class="sv-person">
                <span><strong>${esc(n.candidateName)}</strong> <span class="sv-help">till ${esc(n.postLabel)}</span>
                    <span class="badge ${nomBadge(n.status)} ms-1">${esc(n.status)}</span>
                    ${n.notes ? `<span class="sv-help d-block">${esc(n.notes)}</span>` : ''}</span>
                <span class="d-flex gap-1 sv-noprint">
                    <select class="form-select form-select-sm" style="width:auto;" onchange="svNomStatus(${n.id}, this.value)">
                        ${NOM_STATUSES.map(s => `<option ${s === n.status ? 'selected' : ''}>${s}</option>`).join('')}
                    </select>
                    <button class="btn btn-sm btn-outline-danger" onclick="svNomRemove(${n.id})" title="Ta bort">✕</button>
                </span>
            </div>`;
        });
        // Add form
        html += `<div class="row g-2 mt-2" style="max-width:720px;">
            <div class="col-12 col-md-4"><label class="sv-help">Namn på kandidat</label><input type="text" id="svNomName" class="form-control" placeholder="För- och efternamn"></div>
            <div class="col-12 col-md-4"><label class="sv-help">Föreslås till post</label>
                <select id="svNomPost" class="form-select">${POST_KEYS.map(p => `<option value="${p[0]}">${p[1]}</option>`).join('')}<option value="">Annan…</option></select>
                <input type="text" id="svNomPostCustom" class="form-control mt-1 d-none" placeholder="Egen post">
            </div>
            <div class="col-12 col-md-4"><label class="sv-help">Status</label><select id="svNomStatusNew" class="form-select">${NOM_STATUSES.map(s => `<option>${s}</option>`).join('')}</select></div>
            <div class="col-12"><input type="text" id="svNomNotes" class="form-control" placeholder="Anteckning (frivilligt)"></div>
            <div class="col-12"><button class="btn btn-success btn-xl" onclick="svNomAdd()"><i class="bi bi-plus-lg me-2"></i>Lägg till förslag</button></div>
        </div></div>`;
        c.innerHTML = html;
        const postSel = $('svNomPost');
        if (postSel) postSel.addEventListener('change', () => $('svNomPostCustom').classList.toggle('d-none', postSel.value !== ''));
    }
    function nomBadge(s) { return s === 'Tackat ja' ? 'bg-success' : s === 'Tackat nej' ? 'bg-secondary' : s === 'Tillfrågad' ? 'bg-info text-dark' : 'bg-light text-dark'; }
    window.svNomSetYear = function (y) { svNomYear = parseInt(y, 10); loadValberedning(); };
    window.svNomAdd = function () {
        const name = $('svNomName').value.trim();
        const postKey = $('svNomPost').value;
        const postLabel = postKey ? (POST_KEYS.find(p => p[0] === postKey)?.[1] || postKey) : $('svNomPostCustom').value.trim();
        if (!name) { alert('Skriv kandidatens namn'); return; }
        if (!postLabel) { alert('Ange vilken post'); return; }
        post('BoardGovernance', 'AddNomination', { ownerType: OWNER_TYPE, ownerId: OWNER_ID, year: svNomYear, postKey, postLabel, candidateName: name, status: $('svNomStatusNew').value, notes: $('svNomNotes').value || '' })
            .then(r => { if (r.success) loadValberedning(); else alert(r.message || 'Kunde inte lägga till'); });
    };
    window.svNomStatus = function (id, status) {
        post('BoardGovernance', 'SetNominationStatus', { nominationId: id, status })
            .then(r => { if (r.success) loadValberedning(); });
    };
    window.svNomRemove = function (id) {
        if (!confirm('Ta bort förslaget?')) return;
        post('BoardGovernance', 'RemoveNomination', { nominationId: id }).then(r => { if (r.success) loadValberedning(); });
    };

    // ---- shared ----
    function statusBadge(s) {
        const map = { 'Planerat': 'bg-secondary', 'Genomfört': 'bg-info text-dark', 'Justerat': 'bg-success' };
        return `<span class="badge ${map[s] || 'bg-secondary'}">${esc(s)}</span>`;
    }
    function spinner() { return '<div class="text-center text-muted py-4"><div class="spinner-border"></div><div class="mt-2">Hämtar…</div></div>'; }
    function errBox(msg) { return `<div class="sv-card"><p class="text-danger mb-0">${esc(msg)}</p></div>`; }

    // initial
    svShow('moten');
})();
</script>
}
