@using Umbraco.Cms.Web.Common.PublishedModels;
@using System.Globalization;
@using Umbraco.Cms.Core.Security;
@using Umbraco.Cms.Core.Services;
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject HpskSite.Services.AdminAuthorizationService AuthorizationService
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";

    // Get region properties
    var regionCode = Model.Value<string>("regionCode") ?? "";
    var regionName = Model.Value<string>("regionName") ?? Model.Name;
    var welcomeTitle = Model.Value<string>("welcomeTitle") ?? $"Välkommen till {regionName}";
    var welcomeText = Model.Value<string>("welcomeText");
    var aboutRegion = Model.Value<string>("aboutRegion");
    var contactPerson = Model.Value<string>("contactPerson");
    var contactEmail = Model.Value<string>("contactEmail");
    var contactPhone = Model.Value<string>("contactPhone");
    var bannerImage = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("bannerImage");
    var logo = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("logo");

    // Find the clubsPage child
    var clubsPage = Model.Children.FirstOrDefault(c => c.ContentType.Alias == "clubsPage");
    var clubsUrl = clubsPage?.Url() ?? $"{Model.Url()}klubbar";

    // Count clubs in this region
    var clubCount = 0;
    if (clubsPage != null)
    {
        clubCount = clubsPage.Children.Count(c => c.ContentType.Alias == "club");
    }

    // Get featured items - handle both single item and collection (competitions and series)
    var featuredItemsRaw = Model.Value("featuredItems");
    var featuredItems = new List<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>();

    if (featuredItemsRaw is IEnumerable<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent> multipleItems)
    {
        featuredItems = multipleItems
            .Where(c => c.ContentType.Alias == "competition" || c.ContentType.Alias == "competitionSeries")
            .ToList();
    }
    else if (featuredItemsRaw is Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent singleItem)
    {
        if (singleItem.ContentType.Alias == "competition" || singleItem.ContentType.Alias == "competitionSeries")
        {
            featuredItems.Add(singleItem);
        }
    }

    ViewBag.Title = regionName;

    // OpenGraph meta tags - use logo for social sharing preview
    // Fallback chain: region logo → site default
    var siteDefaultLogo = "/images/HPSK_Logo.png";

    ViewBag.OgTitle = regionName;
    ViewBag.OgDescription = !string.IsNullOrEmpty(welcomeText) ? welcomeText : $"Välkommen till {regionName}";
    ViewBag.OgImage = logo?.Url() ?? siteDefaultLogo;

    // Check if user is logged in
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;

    // Check if current user is regional admin
    var isRegionalAdmin = false;
    if (!string.IsNullOrEmpty(regionCode))
    {
        isRegionalAdmin = await AuthorizationService.IsRegionalAdminForRegion(regionCode);
    }
}

<!-- Hero Banner Section -->
<div class="row mb-4">
    <div class="col-12">
        @if (bannerImage != null)
        {
            <div class="position-relative rounded overflow-hidden" style="height: 300px;">
                <img src="@bannerImage.Url()" alt="@regionName" class="w-100 h-100" style="object-fit: cover;">
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                     style="background: linear-gradient(135deg, rgba(0,123,255,0.6) 0%, rgba(0,86,179,0.65) 100%);">
                    <div class="text-center text-white p-4">
                        @if (logo != null)
                        {
                            <img src="@logo.Url()" alt="@regionName Logo" class="mb-3" style="max-height: 80px; max-width: 200px;">
                        }
                        <h1 class="display-4 fw-bold">@welcomeTitle</h1>
                        @if (!string.IsNullOrEmpty(welcomeText))
                        {
                            <div class="lead mt-3">@Html.Raw(welcomeText)</div>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="jumbotron bg-primary text-white p-5 rounded">
                <div class="d-flex align-items-center justify-content-center flex-column">
                    @if (logo != null)
                    {
                        <img src="@logo.Url()" alt="@regionName Logo" class="mb-3" style="max-height: 80px; max-width: 200px;">
                    }
                    <h1 class="display-4 fw-bold text-center">@welcomeTitle</h1>
                    @if (!string.IsNullOrEmpty(welcomeText))
                    {
                        <div class="lead mt-3 text-center">@Html.Raw(welcomeText)</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@{
    ViewBag.isRegionalAdmin = isRegionalAdmin;
    ViewBag.isLoggedIn = isLoggedIn;
    ViewBag.regionContentId = Model.Id;
    ViewBag.regionName = regionName;
}

<script>
    var regionId = @Model.Id;
</script>

<!-- Tab Navigation (visible to all visitors) -->
@await Html.PartialAsync("RegionalNavigation")

@if (isRegionalAdmin)
{
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("FeaturedItemsPicker")
}

<div class="tab-content" id="regionPageTabContent">
    <!-- Home Tab -->
    <div class="tab-pane fade show active" id="regionHome" role="tabpanel" aria-labelledby="regionHome-tab">
        @await Html.PartialAsync("_RegionPublicContent", Model, new ViewDataDictionary(ViewData)
        {
            { "clubsPage", clubsPage },
            { "clubsUrl", clubsUrl },
            { "clubCount", clubCount },
            { "featuredItems", featuredItems },
            { "aboutRegion", aboutRegion },
            { "contactPerson", contactPerson },
            { "contactEmail", contactEmail },
            { "contactPhone", contactPhone }
        })
    </div>

    <!-- Om (About) Tab -->
    <div class="tab-pane fade" id="regionAbout" role="tabpanel" aria-labelledby="regionAbout-tab">
        @if (!string.IsNullOrEmpty(aboutRegion))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Om @regionName</h5>
                </div>
                <div class="card-body">
                    <div id="regionAboutContent"></div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>Ingen information om kretsen har lagts till ännu.
            </div>
        }
    </div>

    @if (isLoggedIn)
    {
        <!-- Documents Tab -->
        <div class="tab-pane fade" id="regionDocuments" role="tabpanel" aria-labelledby="regionDocuments-tab">
            @{
                ViewBag.DocumentOwnerType = 1;
                ViewBag.DocumentOwnerId = Model.Id;
            }
            @await Html.PartialAsync("DocumentArchive")
        </div>
    }

    @if (isRegionalAdmin)
    {
        <!-- Administration Tab -->
        <div class="tab-pane fade" id="regionAdmin" role="tabpanel" aria-labelledby="regionAdmin-tab">
            @await Html.PartialAsync("RegionalAdminPanel")
        </div>
    }
</div>

<script>
(function() {
    var regionOwnerId = @Model.Id;

    // Safe RTE rendering for about region content
    var aboutEl = document.getElementById('regionAboutContent');
    if (aboutEl) {
        aboutEl.innerHTML = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(aboutRegion ?? ""));
    }

    // Quick link documents
    fetch('/umbraco/surface/Document/GetQuickLinks?ownerType=1&ownerId=' + regionOwnerId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
            var container = document.getElementById('regionQuickLinkDocuments');
            if (!container) return;
            if (data.success && data.data && data.data.length > 0) {
                var html = '';
                data.data.forEach(function(doc) {
                    html += '<a href="/umbraco/surface/Document/DownloadDocument?id=' + doc.id + '" class="list-group-item list-group-item-action d-flex align-items-center" target="_blank">'
                        + '<i class="bi ' + doc.icon + ' me-3 text-primary"></i>'
                        + '<div><strong>' + doc.title + '</strong>'
                        + '<small class="d-block text-muted">' + doc.fileName + '</small></div></a>';
                });
                container.innerHTML = html;
            }
        })
        .catch(function(err) { console.error('Region quick link documents error:', err); });

    // Event type colors (same as club events)
    var eventTypeColors = {
        'Tävling': '#0d6efd',
        'Träning': '#198754',
        'Städning': '#d63384',
        'Möte': '#fd7e14',
        'Socialt': '#0dcaf0',
        'Nyhet': '#6610f2',
        'Annat': '#6c757d',
        'default': '#6c757d'
    };

    // Load upcoming events for the region
    function loadUpcomingEvents() {
        fetch('/umbraco/surface/Club/GetRegionEvents?regionId=' + regionId)
            .then(function(response) { return response.json(); })
            .then(function(data) {
                var container = document.getElementById('upcomingEventsContainer');
                if (data.success && data.data && data.data.length > 0) {
                    var now = new Date();
                    var visibleEvents = data.data.filter(function(event) {
                        return event.type === 'Nyhet' || (event.date && new Date(event.date) >= now);
                    });

                    if (visibleEvents.length > 0) {
                        visibleEvents.sort(function(a, b) {
                            var aIsNews = a.type === 'Nyhet';
                            var bIsNews = b.type === 'Nyhet';
                            if (aIsNews && !a.date) return -1;
                            if (bIsNews && !b.date) return 1;
                            var aDate = a.date ? new Date(a.date) : new Date(0);
                            var bDate = b.date ? new Date(b.date) : new Date(0);
                            return aDate - bDate;
                        });

                        var html = '<ul class="list-group list-group-flush">';
                        visibleEvents.slice(0, 5).forEach(function(event) {
                            var color = eventTypeColors[event.type] || eventTypeColors['default'];
                            var eventNameHtml = event.url
                                ? '<a href="' + event.url + '" class="text-decoration-none"><h6 class="mb-0">' + event.name + '</h6></a>'
                                : '<h6 class="mb-0">' + event.name + '</h6>';

                            var dateText = '';
                            if (event.date) {
                                var d = new Date(event.date);
                                if (d.getFullYear() > 1900) {
                                    dateText = event.type === 'Nyhet'
                                        ? d.toLocaleDateString('sv-SE')
                                        : d.toLocaleDateString('sv-SE') + (event.venue ? ' - ' + event.venue : '');
                                }
                            }

                            var snippet = '';
                            if (event.description) {
                                var tmp = document.createElement('div');
                                tmp.innerHTML = event.description;
                                var text = (tmp.textContent || '').trim();
                                var firstLine = text.split(/\r?\n/)[0].trim();
                                snippet = firstLine.length > 120 ? firstLine.substring(0, 117) + '...' : firstLine;
                            }

                            html += '<li class="list-group-item py-2">'
                                + '<div class="d-flex justify-content-between align-items-start">'
                                + '<div style="min-width: 0; flex: 1;">'
                                + '<div class="d-flex align-items-baseline gap-2">'
                                + eventNameHtml
                                + (dateText ? '<small class="text-muted flex-shrink-0">' + dateText + '</small>' : '')
                                + '</div>'
                                + (snippet ? '<p class="mb-0 text-muted small">' + snippet + '</p>' : '')
                                + '</div>'
                                + '<span class="badge ms-2 flex-shrink-0" style="background-color: ' + color + '">' + event.type + '</span>'
                                + '</div></li>';
                        });
                        html += '</ul>';
                        container.innerHTML = html;
                    } else {
                        container.innerHTML = '<p class="text-muted">Inga kommande händelser planerade.</p>';
                    }
                } else {
                    container.innerHTML = '<p class="text-muted">Inga händelser hittades.</p>';
                }
            })
            .catch(function(error) {
                console.error('Error loading events:', error);
                document.getElementById('upcomingEventsContainer').innerHTML = '<p class="text-danger">Fel vid hämtning av händelser.</p>';
            });
    }

    loadUpcomingEvents();
})();
</script>

<style>
.jumbotron {
    background: linear-gradient(135deg, var(--bs-primary) 0%, #0056b3 100%);
}

@@media (max-width: 991.98px) {
    .display-4 {
        font-size: 2rem;
    }
}
</style>
