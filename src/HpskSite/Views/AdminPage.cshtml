@using Umbraco.Cms.Web.Website.Controllers
@using Umbraco.Cms.Web.Website.Models
@using Umbraco.Cms.Core.Security
@using Umbraco.Cms.Core.Services
@inject IMemberManager MemberManager
@inject IMemberService MemberService
@inject HpskSite.Services.AdminAuthorizationService AuthService
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    ViewBag.Title = "Administration";

    var currentMember = await MemberManager.GetCurrentMemberAsync();
    var isLoggedIn = currentMember != null;

    bool isSiteAdmin = false;
    bool isRegionalAdmin = false;
    string userDefaultRegion = "";
    List<string> managedRegions = new List<string>();
    string managedRegionsJson = "[]"; // JSON array of managed regions for JavaScript

    if (isLoggedIn && currentMember != null)
    {
        // Check if user is site administrator
        isSiteAdmin = await AuthService.IsCurrentUserAdminAsync();

        // Check if user is a regional admin
        managedRegions = await AuthService.GetManagedRegions();
        isRegionalAdmin = !isSiteAdmin && managedRegions.Any();

        // Serialize managed regions to JSON for JavaScript
        managedRegionsJson = System.Text.Json.JsonSerializer.Serialize(managedRegions);

        // For regional admins, set default to their first managed region
        if (isRegionalAdmin && managedRegions.Any())
        {
            userDefaultRegion = managedRegions.First();
        }
        else
        {
            // For site admins, get user's default region from their primary club
            var member = MemberService.GetByEmail(currentMember.Email);
            if (member != null)
            {
                var primaryClubIdStr = member.GetValue<string>("primaryClubId");
                if (!string.IsNullOrEmpty(primaryClubIdStr) && int.TryParse(primaryClubIdStr, out var clubId))
                {
                    var clubNode = Umbraco.Content(clubId);
                    if (clubNode != null)
                    {
                        userDefaultRegion = clubNode.Value<string>("regionalFederation") ?? "";
                    }
                }
            }
        }
    }

    // Allow access if site admin OR regional admin
    bool hasAccess = isSiteAdmin || isRegionalAdmin;
}

@* Check if user is logged in *@
@if (!isLoggedIn)
{
    <div class="container mt-4">
        <div class="alert alert-warning">
            <h4>Access Denied</h4>
            <p>You must be logged in to access this page.</p>
            <a href="/login-register/" class="btn btn-primary">Login</a>
        </div>
    </div>
    return;
}

@* Check if user has admin access (site admin or regional admin) *@
@if (!hasAccess)
{
    <div class="container mt-4">
        <div class="alert alert-danger">
            <h4>Access Denied</h4>
            <p>You must be a site administrator or regional administrator to access this page.</p>
            <p>Only members in the "Administrators" or "RegionalAdmin_*" groups have access to the administration panel.</p>
            <a href="/" class="btn btn-primary">Return to Home</a>
        </div>
    </div>
    return;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Administration Panel</h1>
            <p class="mb-0">
                Welcome, @(currentMember?.UserName ?? "Unknown User")!
                @if (isRegionalAdmin && !isSiteAdmin)
                {
                    <span class="badge bg-info ms-2">
                        <i class="bi bi-geo-alt me-1"></i>Kretsadministratör
                    </span>
                }
            </p>
        </div>
        @if (isSiteAdmin)
        {
            <div class="admin-tools">
                <a href="/umbraco" target="_blank" class="btn btn-outline-primary">
                    <i class="bi bi-gear-fill me-2"></i>Umbraco Backoffice
                    <i class="bi bi-box-arrow-up-right ms-1"></i>
                </a>
            </div>
        }
    </div>

    @* Anti-forgery token for AJAX requests *@
    @Html.AntiForgeryToken()

    <!-- Navigation tabs -->
    <ul class="nav nav-tabs" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="competitions-tab" data-bs-toggle="tab" data-bs-target="#competitions" type="button" role="tab">Tävlingar</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="series-tab" data-bs-toggle="tab" data-bs-target="#series" type="button" role="tab">Serier</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">Användare</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="clubs-tab" data-bs-toggle="tab" data-bs-target="#clubs" type="button" role="tab">Klubbar</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="invoices-tab" data-bs-toggle="tab" data-bs-target="#invoices" type="button" role="tab">Fakturor</button>
        </li>
        @if (isSiteAdmin)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="regions-tab" data-bs-toggle="tab" data-bs-target="#regions" type="button" role="tab">Kretsar</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="riksinstruktor-tab" data-bs-toggle="tab" data-bs-target="#riksinstruktor" type="button" role="tab">Riksinstruktörer</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="statistics-tab" data-bs-toggle="tab" data-bs-target="#statistics" type="button" role="tab">Statistik</button>
            </li>
        }
        @if (isSiteAdmin || isRegionalAdmin)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="figurkatalog-tab" data-bs-toggle="tab" data-bs-target="#figurkatalog" type="button" role="tab">Figurkatalog</button>
            </li>
        }
    </ul>

    <!-- Load modals BEFORE tab content so JavaScript functions are available -->
    <!-- Modals for Competition Management -->
    @await Html.PartialAsync("CompetitionWizardModal")
    @await Html.PartialAsync("CompetitionAdvertModal")
    @await Html.PartialAsync("CompetitionEditModal")
    @await Html.PartialAsync("SpringskytteEditModal")
    @await Html.PartialAsync("CompetitionAdvertEditModal")
    @await Html.PartialAsync("UploadInvitationModal")
    @await Html.PartialAsync("CompetitionDeleteConfirmModal")

    <!-- Modals for Series Management -->
    @await Html.PartialAsync("SeriesEditModal")
    @await Html.PartialAsync("SeriesStrategyModal")
    @await Html.PartialAsync("SeriesCopyModal")
    @await Html.PartialAsync("SeriesDeleteConfirmModal")

    <!-- Tab content -->
    <div class="tab-content" id="adminTabContent">
        <div class="tab-pane fade show active" id="competitions" role="tabpanel" data-user-default-region="@userDefaultRegion" data-managed-regions="@managedRegionsJson" data-is-site-admin="@isSiteAdmin.ToString().ToLower()">
            <div class="card mt-3">
                <div class="card-body">
                    @await Html.PartialAsync("AdminCompetitionsList")
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="series" role="tabpanel" data-user-default-region="@userDefaultRegion" data-managed-regions="@managedRegionsJson" data-is-site-admin="@isSiteAdmin.ToString().ToLower()">
            <div class="card mt-3">
                <div class="card-body">
                    @await Html.PartialAsync("AdminSeriesList")
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="users" role="tabpanel" data-user-default-region="@userDefaultRegion" data-managed-regions="@managedRegionsJson" data-is-site-admin="@isSiteAdmin.ToString().ToLower()">
            <div class="card mt-3">
                <div class="card-body">
                    @await Html.PartialAsync("UserManagement")
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="clubs" role="tabpanel" data-user-default-region="@userDefaultRegion" data-managed-regions="@managedRegionsJson" data-is-site-admin="@isSiteAdmin.ToString().ToLower()">
            <div class="card mt-3">
                <div class="card-body">
                    @await Html.PartialAsync("ClubManagement")
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="invoices" role="tabpanel" data-user-default-region="@userDefaultRegion" data-managed-regions="@managedRegionsJson" data-is-site-admin="@isSiteAdmin.ToString().ToLower()">
            <div class="card mt-3">
                <div class="card-body">
                    @await Html.PartialAsync("AdminInvoicesList")
                </div>
            </div>
        </div>

        @if (isSiteAdmin)
        {
            <div class="tab-pane fade" id="regions" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        @await Html.PartialAsync("RegionalManagement")
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="riksinstruktor" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        @await Html.PartialAsync("RiksinstruktorAdminPanel")
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="statistics" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        @await Html.PartialAsync("AdminStatistics")
                    </div>
                </div>
            </div>
        }
        @if (isSiteAdmin || isRegionalAdmin)
        {
            <div class="tab-pane fade" id="figurkatalog" role="tabpanel">
                <div class="card mt-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0"><i class="bi bi-bullseye me-2"></i>Figurkatalog — Fältskytte</h5>
                            <button class="btn btn-primary btn-sm" onclick="faltPickerOpen(null, null)">
                                <i class="bi bi-pencil-square me-1"></i>Öppna katalogen
                            </button>
                        </div>
                        <p class="text-muted">Hantera figurer, varianter, avstånd och bilder för fältskyttemål.</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
