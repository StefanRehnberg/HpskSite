@using Umbraco.Cms.Web.Common.PublishedModels
@using Newtonsoft.Json
@using HpskSite.CompetitionTypes.Faltskytte.Models
@using HpskSite.CompetitionTypes.Faltskytte.Services
@inject Umbraco.Cms.Core.Services.IMemberService MemberService
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager
@inject Umbraco.Cms.Core.Services.IContentService ContentService
@inject HpskSite.Services.ClubService ClubService
@inject Umbraco.Cms.Infrastructure.Persistence.IUmbracoDatabaseFactory DbFactory
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";

    // Read query params: c = competitionId, s = stationNumber
    var cStr = Context.Request.Query["c"].FirstOrDefault();
    var sStr = Context.Request.Query["s"].FirstOrDefault();
    int competitionId = 0;
    int stationNumber = 0;
    int.TryParse(cStr, out competitionId);
    int.TryParse(sStr, out stationNumber);

    // Load competition
    IPublishedContent? competition = null;
    string competitionName = "";
    string competitionType = "";
    int competitionClubId = 0;

    if (competitionId > 0)
    {
        var node = Umbraco.Content(competitionId);
        if (node != null && node.ContentType.Alias == "competition")
        {
            competition = node;
            competitionName = node.Value<string>("competitionName") ?? "";
            competitionType = node.Value<string>("competitionType") ?? "Precision";
            competitionClubId = node.Value<int>("clubId");
        }
    }

    // Check authorization
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    bool canEnterResults = false;
    bool isLoggedIn = currentMember != null;

    if (currentMember != null && competition != null)
    {
        var memberData = MemberService.GetByEmail(currentMember.Email ?? "");
        if (memberData != null)
        {
            var roles = MemberService.GetAllRoles(memberData.Id)?.ToList() ?? new List<string>();
            bool isSiteAdmin = roles.Contains("Administrators");

            // Competition manager
            var cmJson = competition.Value<string>("competitionManagers") ?? "[]";
            int[] cmIds;
            try { cmIds = JsonConvert.DeserializeObject<int[]>(cmJson) ?? Array.Empty<int>(); }
            catch { cmIds = Array.Empty<int>(); }
            bool isCompetitionManager = cmIds.Contains(memberData.Id);

            // Club admin or skjutledare for competition's club
            bool isClubStaff = false;
            if (competitionClubId > 0)
            {
                isClubStaff = roles.Contains($"ClubAdmin_{competitionClubId}")
                    || roles.Contains($"Skjutledare_{competitionClubId}");
            }

            canEnterResults = isSiteAdmin || isCompetitionManager || isClubStaff;
        }
    }

    bool isFaltskytte = competitionType is "Faltskytte" or "MagnumFalt";
    bool isSpringskytte = competitionType == "Springskytte";
    bool isPrecision = !isFaltskytte && !isSpringskytte;

    // Detect shoot-off-only stations early so we can render a friendly notice
    // instead of routing into the regular entry/info flow. Shoot-off entries
    // go through the Resultat tab's per-shooter modal, never via /station.
    bool isShootOffOnlyStation = false;
    if (isFaltskytte && competition != null && stationNumber > 0)
    {
        try
        {
            var rawCfg = competition.Value<string>("stationConfig") ?? "";
            if (!string.IsNullOrEmpty(rawCfg))
            {
                var parsedCfg = FaltskytteConfigParser.Parse(rawCfg);
                var firstWc = parsedCfg.WeaponConfigs.Values.FirstOrDefault();
                var stCfg = firstWc?.Stations.FirstOrDefault(s => s.Station == stationNumber);
                if (stCfg != null && stCfg.IsShootOffOnly) isShootOffOnlyStation = true;
            }
        }
        catch { /* config parse failure → fall through to normal handling */ }
    }

    // ── Fältskytte self-service mode ─────────────────────────────
    // Tri-modal: staff (canEnterResults), self-service (logged-in shooter
    // in a patrol of a competition with faltskytteSelfServiceResults on),
    // or public (everyone else). Resolved here so the rendering tree
    // below can dispatch on a single state.
    bool selfServiceFlag = competition != null
        && competition.HasProperty("faltskytteSelfServiceResults")
        && competition.Value<bool>("faltskytteSelfServiceResults");

    // "none" | "picker" | "resolved"
    string selfServiceMode = "none";
    int? selfServicePatrolId = null;
    int? selfServicePatrolNumber = null;
    string? selfServicePatrolWeapon = null;
    var selfServicePatrols = new List<FaltskyttePatrol>();

    if (isFaltskytte && !canEnterResults && isLoggedIn && competition != null && selfServiceFlag)
    {
        var memberData = MemberService.GetByEmail(currentMember!.Email ?? "");
        if (memberData != null)
        {
            using var db = DbFactory.CreateDatabase();
            selfServicePatrols = await FaltskytteSelfServiceQueries
                .GetPatrolsForMemberAsync(db, competitionId, memberData.Id);

            if (selfServicePatrols.Count > 0)
            {
                // Did the picker (or a previous resolution) hand us ?p=patrolId?
                int.TryParse(Context.Request.Query["p"].FirstOrDefault(), out var pParam);
                FaltskyttePatrol? resolved = null;
                if (pParam > 0)
                    resolved = selfServicePatrols.FirstOrDefault(p => p.Id == pParam);
                if (resolved == null && selfServicePatrols.Count == 1)
                    resolved = selfServicePatrols[0];

                if (resolved != null)
                {
                    selfServiceMode = "resolved";
                    selfServicePatrolId = resolved.Id;
                    selfServicePatrolNumber = resolved.PatrolNumber;
                    selfServicePatrolWeapon = resolved.WeaponGroup;
                }
                else
                {
                    selfServiceMode = "picker";
                }
            }
        }
    }

    bool willEnter = canEnterResults || selfServiceMode == "resolved";

    ViewBag.Title = competition != null
        ? $"Station {stationNumber} — {competitionName}"
        : "Station";
}

<div class="container-fluid mt-3">

    @if (competitionId == 0 || (stationNumber == 0 && isFaltskytte))
    {
        <!-- No params (or no station for Fältskytte) — show resume prompt or landing -->
        <div class="text-center py-5">
            <h4><i class="bi bi-qr-code me-2"></i>Stationssida</h4>
            <p class="text-muted">Skanna QR-koden på ett stationskort för att komma till rätt station.</p>
            <div id="stationResumePrompt" style="display:none" class="mt-3">
                <div class="alert alert-info d-inline-block">
                    <strong>Fortsätt där du slutade?</strong>
                    <div id="stationResumeInfo" class="mt-1"></div>
                    <div class="mt-2">
                        <button class="btn btn-primary btn-sm" onclick="stationResume()">Ja, fortsätt</button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('stationResumePrompt').style.display='none'">Nej</button>
                    </div>
                </div>
            </div>
        </div>
        <script>
        (function() {
            try {
                var saved = JSON.parse(localStorage.getItem('hpsk_station_resume') || 'null');
                if (saved && saved.competitionId && saved.stationNumber) {
                    var age = (Date.now() - new Date(saved.timestamp).getTime()) / 1000 / 60 / 60;
                    if (age < 24) {
                        document.getElementById('stationResumeInfo').textContent = 'Station ' + saved.stationNumber + (saved.competitionName ? ' — ' + saved.competitionName : '');
                        document.getElementById('stationResumePrompt').style.display = '';
                    }
                }
            } catch(e) {}
            window.stationResume = function() {
                var saved = JSON.parse(localStorage.getItem('hpsk_station_resume') || 'null');
                if (saved) window.location.href = '/station?c=' + saved.competitionId + '&s=' + saved.stationNumber;
            };
        })();
        </script>
    }
    else if (competition == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Tävlingen hittades inte.
        </div>
    }
    else if (isShootOffOnlyStation)
    {
        <div class="alert alert-info">
            <h5 class="alert-heading"><i class="bi bi-bullseye me-2"></i>Särskjutnings-station</h5>
            <p class="mb-0">
                Station @stationNumber är reserverad för särskjutning och hanteras via
                <strong>Resultat-fliken</strong> på tävlingens administrationssida —
                inte via det vanliga station-flödet.
            </p>
        </div>
    }
    else if (willEnter)
    {
        <!-- Authorized (staff or self-service shooter): Show result entry UI -->
        <script>
        try {
            localStorage.setItem('hpsk_station_resume', JSON.stringify({
                competitionId: @competitionId,
                stationNumber: @stationNumber,
                competitionName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(competitionName)),
                timestamp: new Date().toISOString()
            }));
        } catch(e) {}
        </script>

        @if (isFaltskytte)
        {
            var entryViewData = new ViewDataDictionary(ViewData);
            entryViewData["CompetitionId"] = competitionId;
            entryViewData["CompetitionName"] = competitionName;
            entryViewData["PresetStationNumber"] = stationNumber;
            // Self-service hints — partial filters its patrol list to this one
            // patrol, skips roll call, and renders a locked read-only view if
            // CurrentStation drifts away from the requested station.
            entryViewData["IsSelfService"] = selfServiceMode == "resolved";
            entryViewData["PresetPatrolId"] = selfServicePatrolId;
            entryViewData["PresetPatrolNumber"] = selfServicePatrolNumber;
            entryViewData["PresetPatrolWeapon"] = selfServicePatrolWeapon;
            @await Html.PartialAsync("FaltskytteStationEntry", entryViewData)
        }
        else if (isSpringskytte)
        {
            var entryViewData = new ViewDataDictionary(ViewData);
            entryViewData["CompetitionId"] = competitionId;
            entryViewData["CompetitionName"] = competitionName;
            entryViewData["NumberOfSeriesOrStations"] = competition.Value<int>("numberOfSeriesOrStations");
            entryViewData["CompetitionType"] = competitionType;
            entryViewData["IsStationPage"] = true;
            entryViewData["PresetWeaponClass"] = sStr ?? "";
            @await Html.PartialAsync("SpringskytteResultsManagement", entryViewData)
        }
        else
        {
            var entryViewData = new ViewDataDictionary(ViewData);
            entryViewData["CompetitionId"] = competitionId;
            entryViewData["CompetitionName"] = competitionName;
            entryViewData["NumberOfSeriesOrStations"] = competition.Value<int>("numberOfSeriesOrStations");
            entryViewData["NumberOfFinalSeries"] = competition.Value<int>("numberOfFinalSeries");
            entryViewData["CompetitionType"] = competitionType;
            entryViewData["IsStationPage"] = true;
            entryViewData["PresetTeamNumber"] = stationNumber;
            @await Html.PartialAsync("CompetitionResultsManagement", entryViewData)
        }
    }
    else if (selfServiceMode == "picker")
    {
        <!-- Multi-class shooter: pick which patrol to use for this round.
             The choice is reflected in the URL via ?p=<patrolId> — when the
             page reloads with that param the resolution branch picks it up
             and renders the entry surface scoped to the chosen patrol. -->
        <div class="text-center py-4">
            <h4><i class="bi bi-people me-2"></i>Vilken patrull skjuter du i nu?</h4>
            <p class="text-muted small mb-3">Du är anmäld i flera klasser. Välj patrull för att fortsätta till station @stationNumber.</p>
            <div class="d-grid gap-2 col-md-6 mx-auto">
                @foreach (var p in selfServicePatrols)
                {
                    var label = $"Patrull {p.PatrolNumber}"
                        + (string.IsNullOrEmpty(p.Label) ? "" : $" — {p.Label}")
                        + (string.IsNullOrEmpty(p.WeaponGroup) ? "" : $" ({p.WeaponGroup})");
                    var href = $"/station?c={competitionId}&s={stationNumber}&p={p.Id}";
                    <a class="btn btn-primary btn-lg" href="@href" data-faltselfservice-pick="@p.Id"><i class="bi bi-arrow-right me-1"></i>@label</a>
                }
            </div>
        </div>
        <script>
        // Persist the picker choice so subsequent scans resolve straight to
        // this patrol without prompting again. Cleared by a "Byt patrull"
        // link in the entry partial header.
        document.querySelectorAll('[data-faltselfservice-pick]').forEach(function(a) {
            a.addEventListener('click', function() {
                try {
                    localStorage.setItem('hpsk_faltselfservice_' + @competitionId, a.getAttribute('data-faltselfservice-pick'));
                } catch(e) {}
            });
        });
        // Auto-resolve from cache: if we have a remembered patrolId for this
        // competition, redirect to it before the user has to tap.
        (function() {
            try {
                var cached = localStorage.getItem('hpsk_faltselfservice_' + @competitionId);
                if (!cached) return;
                var pid = parseInt(cached, 10);
                if (!pid) return;
                // Only auto-resolve if this patrol is still in the picker list
                var match = document.querySelector('[data-faltselfservice-pick="' + pid + '"]');
                if (match) window.location.replace(match.getAttribute('href'));
            } catch(e) {}
        })();
        </script>
    }
    else
    {
        <!-- Not authorized for entry: Show station info card -->
        var infoViewData = new ViewDataDictionary(ViewData);
        infoViewData["CompetitionId"] = competitionId;
        infoViewData["CompetitionName"] = competitionName;
        infoViewData["CompetitionType"] = competitionType;
        infoViewData["StationNumber"] = stationNumber;
        infoViewData["IsLoggedIn"] = isLoggedIn;
        // When self-service is enabled and the viewer isn't logged in, the
        // info card surfaces a small "Logga in för att registrera resultat"
        // link so shooters know how to switch to the entry view.
        infoViewData["ShowSelfServiceLoginPrompt"] = selfServiceFlag && !isLoggedIn;
        @await Html.PartialAsync("StationInfoCard", infoViewData)
    }

</div>