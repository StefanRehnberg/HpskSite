@using Umbraco.Cms.Web.Common.PublishedModels
@using Newtonsoft.Json
@using HpskSite.CompetitionTypes.Faltskytte.Models
@using HpskSite.CompetitionTypes.Faltskytte.Services
@inject Umbraco.Cms.Core.Services.IMemberService MemberService
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager
@inject Umbraco.Cms.Core.Services.IContentService ContentService
@inject HpskSite.Services.ClubService ClubService
@inject Umbraco.Cms.Infrastructure.Persistence.IUmbracoDatabaseFactory DbFactory
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtection
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";

    // Read query params: c = competitionId, s = stationNumber
    var cStr = Context.Request.Query["c"].FirstOrDefault();
    var sStr = Context.Request.Query["s"].FirstOrDefault();
    int competitionId = 0;
    int stationNumber = 0;
    int.TryParse(cStr, out competitionId);
    int.TryParse(sStr, out stationNumber);

    // ── QR-1: read-only Förutsättningar via opaque token (?t=) ──────────
    // Public, no login, NON-enumerable. Decodes "<compId>:<station>" (minted by
    // GetStationInfoToken) and renders the layout + static figure timeline
    // server-side. Mutually exclusive with ?c&s — when present it short-circuits.
    var tToken = Context.Request.Query["t"].FirstOrDefault();
    bool isInfoToken = !string.IsNullOrEmpty(tToken);
    bool infoTokenValid = false;
    int infoStation = 0;
    string infoCompName = "";
    string infoScoringMode = "Normal";
    Dictionary<string, FaltskytteStationConfig>? infoStations = null;
    if (isInfoToken)
    {
        try
        {
            var raw = DataProtection.CreateProtector("Faltskytte.StationInfoQr.v1").Unprotect(tToken!);
            var parts = raw.Split(':');
            if (parts.Length == 2 && int.TryParse(parts[0], out var infoCompId) && int.TryParse(parts[1], out infoStation))
            {
                var infoNode = Umbraco.Content(infoCompId);
                if (infoNode != null && infoNode.ContentType.Alias == "competition"
                    && (infoNode.Value<string>("competitionType") ?? "") is "Faltskytte" or "MagnumFalt")
                {
                    var cfg = FaltskytteConfigParser.Parse(infoNode.Value<string>("stationConfig") ?? "");
                    var byWc = new Dictionary<string, FaltskytteStationConfig>();
                    foreach (var kv in cfg.WeaponConfigs)
                    {
                        var st = kv.Value.Stations.FirstOrDefault(s => s.Station == infoStation);
                        if (st != null) byWc[kv.Key] = st;
                    }
                    if (byWc.Count > 0)
                    {
                        infoStations = byWc;
                        infoCompName = infoNode.Value<string>("competitionName") ?? infoNode.Name ?? "";
                        infoScoringMode = infoNode.Value<string>("scoringMode") ?? "Normal";
                        infoTokenValid = true;
                    }
                }
            }
        }
        catch { infoTokenValid = false; }
    }

    // Load competition
    IPublishedContent? competition = null;
    string competitionName = "";
    string competitionType = "";
    int competitionClubId = 0;

    if (competitionId > 0)
    {
        var node = Umbraco.Content(competitionId);
        if (node != null && node.ContentType.Alias == "competition")
        {
            competition = node;
            competitionName = node.Value<string>("competitionName") ?? "";
            competitionType = node.Value<string>("competitionType") ?? "Precision";
            competitionClubId = node.Value<int>("clubId");
        }
    }

    // Check authorization
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    bool canEnterResults = false;
    bool isLoggedIn = currentMember != null;

    if (currentMember != null && competition != null)
    {
        var memberData = MemberService.GetByEmail(currentMember.Email ?? "");
        if (memberData != null)
        {
            var roles = MemberService.GetAllRoles(memberData.Id)?.ToList() ?? new List<string>();
            bool isSiteAdmin = roles.Contains("Administrators");

            // Competition manager
            var cmJson = competition.Value<string>("competitionManagers") ?? "[]";
            int[] cmIds;
            try { cmIds = JsonConvert.DeserializeObject<int[]>(cmJson) ?? Array.Empty<int>(); }
            catch { cmIds = Array.Empty<int>(); }
            bool isCompetitionManager = cmIds.Contains(memberData.Id);

            // Club admin or skjutledare for competition's club
            bool isClubStaff = false;
            if (competitionClubId > 0)
            {
                isClubStaff = roles.Contains($"ClubAdmin_{competitionClubId}")
                    || roles.Contains($"Skjutledare_{competitionClubId}");
            }

            canEnterResults = isSiteAdmin || isCompetitionManager || isClubStaff;
        }
    }

    bool isFaltskytte = competitionType is "Faltskytte" or "MagnumFalt";
    bool isSpringskytte = competitionType == "Springskytte";
    bool isPrecision = !isFaltskytte && !isSpringskytte;

    // Detect shoot-off-only stations early so we can render a friendly notice
    // instead of routing into the regular entry/info flow. Shoot-off entries
    // go through the Resultat tab's per-shooter modal, never via /station.
    bool isShootOffOnlyStation = false;
    if (isFaltskytte && competition != null && stationNumber > 0)
    {
        try
        {
            var rawCfg = competition.Value<string>("stationConfig") ?? "";
            if (!string.IsNullOrEmpty(rawCfg))
            {
                var parsedCfg = FaltskytteConfigParser.Parse(rawCfg);
                var firstWc = parsedCfg.WeaponConfigs.Values.FirstOrDefault();
                var stCfg = firstWc?.Stations.FirstOrDefault(s => s.Station == stationNumber);
                if (stCfg != null && stCfg.IsShootOffOnly) isShootOffOnlyStation = true;
            }
        }
        catch { /* config parse failure → fall through to normal handling */ }
    }

    // ── Fältskytte QR-2 destinations (login required) ────────────────────
    // After scanning the entry QR, a user may have access to the Stationschef
    // view (staff) AND/OR self-service entry for the patrol(s) they're in (when
    // self-service is on). Patrols are resolved for EVERYONE — including staff —
    // so a functionary who is also a shooter gets to choose rather than being
    // forced into the chief view. 0 destinations → no access; 1 → go straight
    // there; 2+ → chooser.
    bool selfServiceFlag = competition != null
        && competition.HasProperty("faltskytteSelfServiceResults")
        && competition.Value<bool>("faltskytteSelfServiceResults");

    var memberPatrols = new List<FaltskyttePatrol>();
    if (isFaltskytte && isLoggedIn && competition != null && selfServiceFlag)
    {
        var memberData = MemberService.GetByEmail(currentMember!.Email ?? "");
        if (memberData != null)
        {
            using var db = DbFactory.CreateDatabase();
            memberPatrols = await FaltskytteSelfServiceQueries
                .GetPatrolsForMemberAsync(db, competitionId, memberData.Id);
        }
    }

    int.TryParse(Context.Request.Query["p"].FirstOrDefault(), out var pParam);
    bool chiefChosen = Context.Request.Query["role"].FirstOrDefault() == "chief";
    bool hasChief = canEnterResults;
    int destCount = (hasChief ? 1 : 0) + memberPatrols.Count;

    FaltskyttePatrol? resolvedPatrol = null;
    bool renderChief = false;
    bool showChooser = false;
    if (destCount == 0) { /* no access — handled in the body */ }
    else if (pParam > 0 && memberPatrols.Any(p => p.Id == pParam))
        resolvedPatrol = memberPatrols.First(p => p.Id == pParam);
    else if (chiefChosen && hasChief)
        renderChief = true;
    else if (destCount == 1)
    {
        if (memberPatrols.Count == 1 && !hasChief) resolvedPatrol = memberPatrols[0];
        else renderChief = true; // single destination is the chief view
    }
    else showChooser = true;

    bool willEnter = renderChief || resolvedPatrol != null;

    ViewBag.Title = competition != null
        ? $"Station {stationNumber} — {competitionName}"
        : "Station";
}

<div class="container-fluid mt-3">

    @if (isInfoToken)
    {
        @* QR-1: read-only Förutsättningar + static timeline (public, token-gated). *@
        if (infoTokenValid)
        {
            var infoVd = new ViewDataDictionary(ViewData);
            infoVd["CompetitionName"] = infoCompName;
            infoVd["StationNumber"] = infoStation;
            infoVd["ScoringMode"] = infoScoringMode;
            infoVd["StationsByWeaponClass"] = infoStations;
            @await Html.PartialAsync("FaltskytteStationInfoStatic", infoVd)
        }
        else
        {
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Ogiltig länk.</div>
        }
    }
    else if (competitionId == 0 || (stationNumber == 0 && isFaltskytte))
    {
        <!-- No params (or no station for Fältskytte) — show resume prompt or landing -->
        <div class="text-center py-5">
            <h4><i class="bi bi-qr-code me-2"></i>Stationssida</h4>
            <p class="text-muted">Skanna QR-koden på ett stationskort för att komma till rätt station.</p>
            <div id="stationResumePrompt" style="display:none" class="mt-3">
                <div class="alert alert-info d-inline-block">
                    <strong>Fortsätt där du slutade?</strong>
                    <div id="stationResumeInfo" class="mt-1"></div>
                    <div class="mt-2">
                        <button class="btn btn-primary btn-sm" onclick="stationResume()">Ja, fortsätt</button>
                        <button class="btn btn-outline-secondary btn-sm" onclick="document.getElementById('stationResumePrompt').style.display='none'">Nej</button>
                    </div>
                </div>
            </div>
        </div>
        <script>
        (function() {
            try {
                var saved = JSON.parse(localStorage.getItem('hpsk_station_resume') || 'null');
                if (saved && saved.competitionId && saved.stationNumber) {
                    var age = (Date.now() - new Date(saved.timestamp).getTime()) / 1000 / 60 / 60;
                    if (age < 24) {
                        document.getElementById('stationResumeInfo').textContent = 'Station ' + saved.stationNumber + (saved.competitionName ? ' — ' + saved.competitionName : '');
                        document.getElementById('stationResumePrompt').style.display = '';
                    }
                }
            } catch(e) {}
            window.stationResume = function() {
                var saved = JSON.parse(localStorage.getItem('hpsk_station_resume') || 'null');
                if (saved) window.location.href = '/station?c=' + saved.competitionId + '&s=' + saved.stationNumber;
            };
        })();
        </script>
    }
    else if (competition == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-2"></i>Tävlingen hittades inte.
        </div>
    }
    else if (isShootOffOnlyStation)
    {
        <div class="alert alert-info">
            <h5 class="alert-heading"><i class="bi bi-bullseye me-2"></i>Särskjutnings-station</h5>
            <p class="mb-0">
                Station @stationNumber är reserverad för särskjutning och hanteras via
                <strong>Resultat-fliken</strong> på tävlingens administrationssida —
                inte via det vanliga station-flödet.
            </p>
        </div>
    }
    else if (willEnter)
    {
        <!-- Authorized (staff or self-service shooter): Show result entry UI -->
        <script>
        try {
            localStorage.setItem('hpsk_station_resume', JSON.stringify({
                competitionId: @competitionId,
                stationNumber: @stationNumber,
                competitionName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(competitionName)),
                timestamp: new Date().toISOString()
            }));
        } catch(e) {}
        </script>

        @if (isFaltskytte)
        {
            var entryViewData = new ViewDataDictionary(ViewData);
            entryViewData["CompetitionId"] = competitionId;
            entryViewData["CompetitionName"] = competitionName;
            entryViewData["PresetStationNumber"] = stationNumber;
            // Self-service hints — partial filters its patrol list to this one
            // patrol, skips roll call, and renders a locked read-only view if
            // CurrentStation drifts away from the requested station.
            entryViewData["IsSelfService"] = resolvedPatrol != null;
            entryViewData["PresetPatrolId"] = resolvedPatrol?.Id;
            entryViewData["PresetPatrolNumber"] = resolvedPatrol?.PatrolNumber;
            entryViewData["PresetPatrolWeapon"] = resolvedPatrol?.WeaponGroup;
            @await Html.PartialAsync("FaltskytteStationEntry", entryViewData)
        }
        else if (isSpringskytte)
        {
            var entryViewData = new ViewDataDictionary(ViewData);
            entryViewData["CompetitionId"] = competitionId;
            entryViewData["CompetitionName"] = competitionName;
            entryViewData["NumberOfSeriesOrStations"] = competition.Value<int>("numberOfSeriesOrStations");
            entryViewData["CompetitionType"] = competitionType;
            entryViewData["IsStationPage"] = true;
            entryViewData["PresetWeaponClass"] = sStr ?? "";
            @await Html.PartialAsync("SpringskytteResultsManagement", entryViewData)
        }
        else
        {
            var entryViewData = new ViewDataDictionary(ViewData);
            entryViewData["CompetitionId"] = competitionId;
            entryViewData["CompetitionName"] = competitionName;
            entryViewData["NumberOfSeriesOrStations"] = competition.Value<int>("numberOfSeriesOrStations");
            entryViewData["NumberOfFinalSeries"] = competition.Value<int>("numberOfFinalSeries");
            entryViewData["CompetitionType"] = competitionType;
            entryViewData["IsStationPage"] = true;
            entryViewData["PresetTeamNumber"] = stationNumber;
            // Phase comes from the URL: ?phase=finals pins this entry view to the finals
            // start list + finals series rows; anything else defaults to qualification.
            var phaseParam = Context.Request.Query["phase"].ToString();
            entryViewData["PresetPhase"] = phaseParam == "finals" ? "finals" : "qualification";
            @await Html.PartialAsync("CompetitionResultsManagement", entryViewData)
        }
    }
    else if (showChooser)
    {
        @* Dual-role / multi-patrol: let the scanner pick where to go. The choice
           is carried in the URL (?role=chief or ?p=<patrolId>) so the resolution
           block above renders the chosen surface on the next load. No sticky
           memory — the shooter selects every scan (safest: avoids entering
           results under the wrong class/patrol). *@
        <div class="text-center py-4">
            <h4><i class="bi bi-signpost-split me-2"></i>Vad vill du göra?</h4>
            <p class="text-muted small mb-3">Station @stationNumber — välj hur du vill fortsätta.</p>
            <div class="d-grid gap-2 col-md-6 mx-auto">
                @if (hasChief)
                {
                    <a class="btn btn-outline-primary btn-lg" href="/station?c=@competitionId&s=@stationNumber&role=chief"><i class="bi bi-person-badge me-1"></i>Stationschef</a>
                }
                @foreach (var p in memberPatrols)
                {
                    var t = p.StartTime.HasValue ? p.StartTime.Value.ToString("HH:mm") : "";
                    var lbl = (string.IsNullOrEmpty(p.WeaponGroup) ? "" : p.WeaponGroup + " · ")
                        + "Patrull " + p.PatrolNumber
                        + (string.IsNullOrEmpty(t) ? "" : " · " + t)
                        + (string.IsNullOrEmpty(p.Label) ? "" : " — " + p.Label);
                    <a class="btn btn-primary btn-lg" href="/station?c=@competitionId&s=@stationNumber&p=@p.Id"><i class="bi bi-arrow-right me-1"></i>@lbl</a>
                }
            </div>
        </div>
    }
    else if (!isLoggedIn)
    {
        @* Not logged in — offer login, return to this entry URL. NO layout shown. *@
        <div class="text-center py-5">
            <h4><i class="bi bi-box-arrow-in-right me-2"></i>Logga in för att registrera resultat</h4>
            <p class="text-muted">Station @stationNumber@(string.IsNullOrEmpty(competitionName) ? "" : " — " + competitionName)</p>
            <a class="btn btn-primary" href="/login-register?returnUrl=/station?c=@(competitionId)%26s=@(stationNumber)"><i class="bi bi-box-arrow-in-right me-1"></i>Logga in</a>
        </div>
    }
    else
    {
        @* Logged in but no valid destination (not staff, not in a patrol, or
           self-service off). Never reveal the layout here. *@
        <div class="alert alert-warning text-center">
            <i class="bi bi-exclamation-triangle me-2"></i>Du har inte behörighet att registrera resultat på den här stationen.
        </div>
    }

</div>