@model int
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>Incheckning – pistol.nu</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background: #f6f7f9; padding: 1rem; }
        .ci-card { max-width: 480px; margin: 1rem auto; }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()
    <div class="ci-card">
        <div class="text-center mb-3">
            <i class="bi bi-geo-alt-fill text-success" style="font-size:2rem;"></i>
            <h4 class="mb-0">Incheckning</h4>
            <div class="text-muted" id="ciRangeName"></div>
        </div>
        <div class="card">
            <div class="card-body" id="ciContent">
                <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
            </div>
        </div>
        <p class="text-muted small text-center mt-3">
            Incheckning hjälper klubben att räkna aktivitet för rapportering till miljöförvaltningen.
        </p>
    </div>

    <script>
        const RANGE_ID = @Model;
        const el = document.getElementById('ciContent');
        function token() { return document.querySelector('input[name="__RequestVerificationToken"]').value; }
        async function postJson(url, body) {
            const r = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token() },
                body: JSON.stringify(body || {})
            });
            return await r.json();
        }
        function esc(s){ return (s==null?'':String(s)).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }

        async function load() {
            // End-of-day auto-checkout for forgotten check-ins (fire-and-forget; throttled per client)
            try {
                const _k = 'hpsk_sweep_checkins', _last = parseInt(localStorage.getItem(_k) || '0', 10);
                if (Date.now() - _last >= 5 * 60 * 1000) {
                    localStorage.setItem(_k, String(Date.now()));
                    fetch('/umbraco/surface/ShootingRange/AutoCloseStaleCheckIns').catch(() => { });
                }
            } catch (e) {
                fetch('/umbraco/surface/ShootingRange/AutoCloseStaleCheckIns').catch(() => { });
            }
            const d = await (await fetch('/umbraco/surface/ShootingRange/CheckInStatus?rangeId=' + RANGE_ID)).json();
            if (d.needLogin) {
                el.innerHTML = `<div class="text-center">
                    <p>Du måste vara inloggad för att checka in.</p>
                    <a class="btn btn-primary" href="/login-register?returnUrl=${encodeURIComponent(location.pathname + location.search)}">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Logga in</a></div>`;
                return;
            }
            if (!d.success) { el.innerHTML = `<div class="text-danger text-center">${esc(d.message || 'Fel')}</div>`; return; }
            document.getElementById('ciRangeName').textContent = d.rangeName || '';

            if (d.checkedIn) {
                el.innerHTML = activitiesHtml(d.activities) + `
                    <div class="text-center mb-3">
                        <span class="badge bg-success mb-2">Incheckad${d.since ? ' sedan ' + d.since : ''}</span>
                        <p class="mb-1">Hur många skott sköt du?</p>
                        <input type="number" inputmode="numeric" min="0" class="form-control form-control-lg text-center" id="ciShots" placeholder="0" style="max-width:180px;margin:0 auto">
                    </div>
                    <button class="btn btn-primary btn-lg w-100" id="ciOutBtn" onclick="doCheckOut(${d.sessionId})">
                        <i class="bi bi-box-arrow-right me-1"></i>Checka ut</button>`;
            } else {
                el.innerHTML = `
                    <button class="btn btn-success btn-lg w-100" id="ciInBtn" onclick="doCheckIn()">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Checka in</button>`;
            }
        }
        // Närvaro på det som pågår på banan (Michael, Luleå 2026-10-11). Servern registrerar själv när
        // EN aktivitet pågår; pågår flera väljer medlemmen här. Bara aktiviteter medlemmen får delta i.
        function activitiesHtml(list) {
            if (!list || !list.length) return '';
            const rows = list.map(a => {
                const when = a.start ? ' · ' + esc(a.start) + (a.end ? '–' + esc(a.end) : '') : '';
                const right = a.present
                    ? '<span class="badge bg-success-subtle text-success-emphasis"><i class="bi bi-check2 me-1"></i>Närvaro registrerad</span>'
                    : `<button class="btn btn-sm btn-primary" data-ci-att="${a.id}" data-ci-kind="${esc(a.occasionKind)}">Registrera min närvaro</button>`;
                return `<li class="list-group-item d-flex justify-content-between align-items-center gap-2 flex-wrap">
                    <div><div class="fw-semibold">${esc(a.name)}</div><div class="small text-muted">${esc(a.owner)}${when}</div></div>${right}</li>`;
            }).join('');
            const head = list.length > 1 && list.some(a => !a.present)
                ? 'Flera aktiviteter pågår på banan. Välj den du är på.'
                : 'Pågår på banan nu';
            return `<div class="mb-3" id="ciActivities"><div class="small text-muted mb-1">${head}</div><ul class="list-group">${rows}</ul></div>`;
        }
        function showError(msg) {
            const old = document.getElementById('ciErr'); if (old) old.remove();
            el.insertAdjacentHTML('afterbegin', `<div class="alert alert-danger py-2 small" id="ciErr">${esc(msg || 'Något gick fel.')}</div>`);
        }
        el.addEventListener('click', async e => {
            const b = e.target.closest('[data-ci-att]'); if (!b) return;
            b.disabled = true; b.textContent = 'Registrerar…';
            const d = await postJson('/umbraco/surface/ShootingRange/RangeAttendance',
                { rangeId: RANGE_ID, id: parseInt(b.dataset.ciAtt, 10), kind: b.dataset.ciKind });
            if (!d.success) { showError(d.message); b.disabled = false; b.textContent = 'Registrera min närvaro'; return; }
            load();
        });
        async function doCheckIn() {
            const btn = document.getElementById('ciInBtn'); btn.disabled = true;
            const d = await postJson('/umbraco/surface/ShootingRange/CheckIn', { id: RANGE_ID });
            if (!d.success) { showError(d.message); btn.disabled = false; return; }
            load();
        }
        async function doCheckOut(sessionId) {
            const shots = parseInt(document.getElementById('ciShots').value) || 0;
            const btn = document.getElementById('ciOutBtn'); btn.disabled = true;
            const d = await postJson('/umbraco/surface/ShootingRange/CheckOut', { sessionId, shotCount: shots });
            if (!d.success) { showError(d.message); btn.disabled = false; return; }
            el.innerHTML = `<div class="text-center py-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size:2.5rem"></i>
                <p class="mt-2 mb-0">Tack! Utcheckad${shots ? ' – ' + shots + ' skott registrerade' : ''}.</p></div>`;
            document.getElementById('ciRangeName').textContent = '';
        }
        load();
    </script>
</body>
</html>
