@using HpskSite.Models
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "Master.cshtml";
    var denied = ViewBag.Denied == true;
    var noTest = ViewBag.NoTest == true;
    var course = ViewBag.Course as Course;
    var version = ViewBag.Version as CourseTestVersion;
    var questions = ViewBag.Questions as List<CourseTestQuestion> ?? new List<CourseTestQuestion>();
    var passMark = ViewBag.PassMark as int?;
    ViewBag.Title = course != null ? $"Prov – {course.Title}" : "Prov";
}

<div class="container py-4" style="max-width: 820px;">
    @if (denied || course == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-lock me-2"></i>Du har inte tillgång till det här provet. En instruktör behöver först aktivera provet för dig.
            <a href="/utbildning" class="alert-link">Till Utbildning</a>.
        </div>
    }
    else if (noTest || questions.Count == 0)
    {
        <h1 class="h3">@course.Title – prov</h1>
        <div class="alert alert-info mt-3">Provet är inte färdigställt ännu. Försök igen senare.</div>
    }
    else
    {
        @Html.AntiForgeryToken()
        <h1 class="h3 mb-1">@course.Title – prov</h1>
        <p class="text-body-secondary">
            @questions.Count frågor.@(passMark.HasValue ? $" Du behöver minst {passMark} rätt för godkänt." : "")
            Välj ett svar per fråga och tryck <strong>Lämna in</strong>.
        </p>

        <div id="provResult"></div>

        <form id="provForm" data-course-id="@course.Id" data-version-id="@version!.Id">
            @for (var qi = 0; qi < questions.Count; qi++)
            {
                var q = questions[qi];
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title">@(qi + 1). @q.Q</h6>
                        @for (var oi = 0; oi < q.Options.Count; oi++)
                        {
                            var id = $"q{qi}_o{oi}";
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="q@(qi)" id="@id" value="@oi">
                                <label class="form-check-label" for="@id">@q.Options[oi]</label>
                            </div>
                        }
                    </div>
                </div>
            }
            <button type="button" class="btn btn-primary" id="provSubmitBtn" onclick="utbProvSubmit(@questions.Count)">
                <i class="bi bi-check2-circle me-1"></i>Lämna in
            </button>
            <a href="/utbildning" class="btn btn-outline-secondary">Avbryt</a>
        </form>
    }
</div>

<script>
function utbProvSubmit(qCount) {
    const form = document.getElementById('provForm');
    const fd = new FormData();
    fd.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
    fd.append('courseId', form.dataset.courseId);
    fd.append('versionId', form.dataset.versionId);
    let unanswered = 0;
    for (let i = 0; i < qCount; i++) {
        const sel = form.querySelector('input[name="q' + i + '"]:checked');
        if (!sel) { unanswered++; fd.append('answers', '-1'); }
        else fd.append('answers', sel.value);
    }
    if (unanswered > 0 && !confirm('Du har ' + unanswered + ' obesvarade frågor. Lämna in ändå?')) return;

    const btn = document.getElementById('provSubmitBtn');
    btn.disabled = true;
    fetch('/umbraco/surface/CourseTest/SubmitOnline', { method: 'POST', body: fd })
        .then(r => r.json())
        .then(d => {
            const box = document.getElementById('provResult');
            if (!d.success) { box.innerHTML = '<div class="alert alert-danger">' + (d.message || 'Fel') + '</div>'; btn.disabled = false; return; }
            const cls = d.passed ? 'alert-success' : 'alert-warning';
            const head = d.passed ? '<i class="bi bi-check-circle me-1"></i>Godkänt!' : '<i class="bi bi-x-circle me-1"></i>Ej godkänt';
            box.innerHTML = '<div class="alert ' + cls + '"><h5>' + head + '</h5>Du fick ' + d.score + ' av ' + d.max + ' rätt. ' +
                'Resultatet har registrerats. <a href="/utbildning" class="alert-link">Till Utbildning</a>.</div>';
            form.style.display = 'none';
            box.scrollIntoView({ behavior: 'smooth' });
        })
        .catch(() => { document.getElementById('provResult').innerHTML = '<div class="alert alert-danger">Nätverksfel.</div>'; btn.disabled = false; });
}
</script>
