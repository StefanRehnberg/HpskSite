@using HpskSite.CompetitionTypes.Faltskytte.Models
@using HpskSite.CompetitionTypes.Faltskytte.Services
@model FaltskyttePrintStationCardsModel
@{
    // Stationskort. EN renderare (StationCardRenderer), densamma som konfiguratorns "Skriv ut stationskort"
    // (Stefan 2026-11-21, fas 3a). Den här vyn bara hämtar blocken och lämnar över dokumentet.
    // Does NOT use FaltskytteStationInfoStatic — that partial drives the on-screen
    // QR-1 landing page (timeline visualization), a different audience.
    Layout = null;
    // I Poängläge visas inte Max träff/fig (kontrollen är dold i konfiguratorn).
    var isPoang = string.Equals(Model.ScoringMode, "Poang", StringComparison.OrdinalIgnoreCase);
    var blocks = Model.Stations.SelectMany(s => StationCardRenderer.BuildBlocks(s, Model.StrictGrouping, Model.CourseStations)).ToList();
    var title = "Stationskort" + (string.IsNullOrEmpty(Model.CompetitionName) ? "" : " — " + Model.CompetitionName);
}
@Html.Raw(StationCardRenderer.RenderDocument(title, Model.Notice, blocks, isPoang, Model.AutoPrint))
