@{
    Layout = null;
    var compId = ViewData["CompetitionId"];
    var compName = ViewData["CompetitionName"]?.ToString() ?? "Tävling";
    var isOfficial = (bool)(ViewData["IsOfficial"] ?? false);
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Stafettresultat – @compName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <style>
        body { background:#f8f9fa; padding:1rem; }
        .sr-wrap { max-width: 1000px; margin: 0 auto; }
        table.result-table { width:100%; border-collapse:collapse; background:#fff; }
        table.result-table th, table.result-table td { border:1px solid #dee2e6; padding:4px 8px; font-size:14px; }
        table.result-table th { background:#f1f3f5; text-align:left; }
        .result-table td.rank { text-align:center; font-weight:bold; width:48px; }
        .result-table td.time { font-family:monospace; font-weight:bold; }
        .class-header { border-left:4px solid #0d6efd; background:#eef2f7; padding:8px 12px; font-weight:600; margin:1rem 0 0; }
        @@media print { body { background:#fff; padding:0; } .no-print { display:none !important; } }
    </style>
</head>
<body>
<div class="sr-wrap">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h3 mb-1"><i class="bi bi-people-fill me-2"></i>Stafettresultat</h1>
            <div class="text-muted">@compName</div>
        </div>
        <button type="button" class="btn btn-outline-primary btn-sm no-print" onclick="window.print()">
            <i class="bi bi-printer me-1"></i>Skriv ut
        </button>
    </div>

    @if (!isOfficial)
    {
        <div class="alert alert-warning">
            <i class="bi bi-hourglass-split me-1"></i>Stafettresultaten är inte publicerade ännu.
        </div>
    }
    else
    {
        <div id="srContent"><div class="text-muted">Laddar…</div></div>
        <script>
        (function () {
            const compId = @compId;
            const esc = (s) => (s == null ? '' : String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])));
            fetch('/umbraco/surface/Springskytte/GetSpringskytteStafettResults?competitionId=' + compId)
                .then(r => r.json())
                .then(d => {
                    const el = document.getElementById('srContent');
                    const groups = (d && d.classGroups) || [];
                    if (!groups.length) { el.innerHTML = '<div class="alert alert-info">Inga stafettresultat.</div>'; return; }
                    el.innerHTML = groups.map(g => `
                        <div class="class-header">${esc(g.className)}</div>
                        <table class="result-table mb-2">
                            <thead><tr><th style="width:48px" class="text-center">#</th><th>Lag</th><th>Förening</th><th style="width:120px">Sluttid</th></tr></thead>
                            <tbody>
                            ${g.teams.map(t => `
                                <tr>
                                    <td class="rank">${t.rank > 0 ? t.rank : ''}</td>
                                    <td><strong>${esc(t.teamName)}</strong>${(t.members && t.members.filter(m => !m.isSpare).length) ? `<div class="small text-muted">${t.members.filter(m => !m.isSpare).map(m => esc(m.name)).join(', ')}</div>` : ''}</td>
                                    <td>${esc(t.club)}</td>
                                    <td class="time">${t.status ? esc(t.status) : esc(t.elapsedDisplay)}</td>
                                </tr>`).join('')}
                            </tbody>
                        </table>`).join('');
                })
                .catch(() => { document.getElementById('srContent').innerHTML = '<div class="alert alert-danger">Kunde inte ladda resultat.</div>'; });
        })();
        </script>
    }
</div>
</body>
</html>
