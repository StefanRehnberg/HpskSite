										<strong>@competitionDate.ToString("dddd, d MMMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))@(competitionDate.TimeOfDay != TimeSpan.Zero ? ", kl " + competitionDate.ToString("HH:mm") : "")</strong>
