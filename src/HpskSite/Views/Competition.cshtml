							</p>
							<button class="btn btn-success w-100" disabled>
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						else if (regNotYetOpen)
						{
							<p class="text-muted small mb-2">
								<i class="bi bi-clock me-1"></i>Anmälan öppnar @registrationOpenDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))
							</p>
							<button class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#registrationNotOpenModal">
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#registrationNotOpenModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#registrationNotOpenModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						else if (canRegister)
						{
							<p class="text-muted small mb-2">
								<i class="bi bi-calendar-check me-1"></i>Sista anmälningsdag: @registrationCloseDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))
							</p>
							<button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#registrationModal">
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button type="button" class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#teamRegistrationModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button type="button" class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#stafettRegistrationModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						else
						{
							@* Not active or no shooting classes configured *@
							<p class="text-muted small mb-2">
								<i class="bi bi-info-circle me-1"></i>Anmälan är inte tillgänglig just nu.
							</p>
							<button class="btn btn-success w-100" disabled>
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						@* Distributed result reporting button (always full-width so it stays readable on mobile) *@
						@if (canReportDistributedResults)
						{
							<button type="button" class="btn btn-outline-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#distributedResultModal">
								<i class="bi bi-pencil-square me-1"></i>Rapportera resultat
							</button>
						}

						@* Unpaid invoices button — shown/hidden by JS *@
						<div id="unpaidInvoicesButtonContainer" style="display:none;" class="mt-2">
							<button type="button" class="btn btn-warning w-100" data-bs-toggle="modal" data-bs-target="#unpaidInvoicesModal">
								<i class="bi bi-wallet2 me-1"></i>Betala anmälningsavgift
							</button>
						</div>
					</div>
				</div>



				@* ======================================== Registration Not Open Modal ======================================== *@
				<div class="modal fade" id="registrationNotOpenModal" tabindex="-1" aria-labelledby="registrationNotOpenModalLabel" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title" id="registrationNotOpenModalLabel">
									<i class="bi bi-clock me-2"></i>Anmälan har inte öppnat
								</h5>
								<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
							</div>
							<div class="modal-body">
								<p>Anmälan till <strong>@competitionName</strong> har inte öppnat ännu.</p>
								<p>Anmälan öppnar <strong>@registrationOpenDate.ToString("dddd d MMMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))</strong>.</p>
								<p class="text-muted small mb-0">Kom tillbaka efter detta datum för att anmäla dig.</p>
							</div>
							<div class="modal-footer">
								<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
							</div>
						</div>
					</div>
				</div>

				@* Notiser card — between Anmälan and Information. Opt-in prompt when NOT subscribed;
				   only "Meddelanden från arrangören" when subscribed. Training-match prefs never shown here. *@
				@if (currentMember != null)
				{
					bool notisTutorialExists = false;
					try
					{
						var homeNode = Umbraco.ContentAtRoot().FirstOrDefault();
						var tutHub = homeNode?.Children?.FirstOrDefault(x => x.ContentType.Alias == "tutorialPage");
						notisTutorialExists = tutHub?.Children?.Any(t => t.ContentType.Alias == "tutorial"
							&& (t.Value<string>("tutorialId") ?? "") == "tutorial-notiser") ?? false;
					}
					catch { }

					<div class="card information-sidebar" id="pnShooterCard" data-comp="@Model.Id">
						<div class="card-header">
							<h5 class="mb-0"><i class="bi bi-bell me-2"></i>Notiser</h5>
						</div>
						<div class="card-body">
							@* Opt-in prompt — shown only when NOT subscribed (JS decides). *@
							<div id="pnOptIn" style="display:none">
								<p class="small text-body-secondary mb-2">
									Aktivera notiser så får du meddelanden från arrangören — schemaändringar,
									särskjutning och när resultatlistan publiceras — direkt i telefonen.
								</p>
								@await Html.PartialAsync("_WebPushSetup", new ViewDataDictionary(ViewData) { { "WebPushShowMatchPrefs", false }, { "WebPushOptInOnly", true } })
								@if (notisTutorialExists)
								{
									<script>window.pnNotisTutorialId = 'tutorial-notiser';</script>
								}
								<p id="pnCardApple" class="small text-body-secondary mt-2 mb-0" style="display:none">
									<i class="bi bi-apple me-1"></i>
									På iPhone kräver Apple ett extra steg: lägg först till pistol.nu på hemskärmen,
									öppna appen därifrån och aktivera sedan notiser. Det är en begränsning i iOS, inte i pistol.nu.
								</p>
								@if (notisTutorialExists)
								{
									<div id="pnCardTut" class="mt-2" style="display:none">
										<button type="button" class="btn btn-outline-secondary btn-sm" onclick="TutorialHelper.open('tutorial-notiser')">
											<i class="bi bi-play-circle me-1"></i>Visa hur på iPhone
										</button>
									</div>
								}
							</div>
							@* Messages — shown only when subscribed. *@
							<div id="pnMessages" style="display:none">
								<div id="pnShooterList" class="small"></div>
							</div>
						</div>
					</div>

					<script>
					(function () {
						var card = document.getElementById('pnShooterCard');
						if (!card || window.__pnShooterInit) return;
						window.__pnShooterInit = true;
						var compId = parseInt(card.getAttribute('data-comp'), 10) || 0;
						var optIn = document.getElementById('pnOptIn');
						var mbox = document.getElementById('pnMessages');
						var list = document.getElementById('pnShooterList');
						function esc(s){return (s==null?'':String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
						function fmt(iso){try{return new Date(iso).toLocaleString('sv-SE',{dateStyle:'short',timeStyle:'short'});}catch(e){return '';}}
						function loadMsgs(){
							fetch('/umbraco/surface/ParticipantMessage/GetMyMessages?competitionId=' + compId, { headers: { 'Accept': 'application/json' } })
								.then(function(r){return r.json();})
								.then(function(j){
									var head = '<div class="fw-semibold mb-1">Meddelanden från arrangören</div>';
									if(!j||!j.success){ list.innerHTML=head; return; }
									var msgs = j.messages || [];
									if(!msgs.length){ list.innerHTML=head+'<div class="text-body-secondary">Inga meddelanden från arrangören ännu.</div>'; return; }
									list.innerHTML = head + msgs.map(function(m){
										var uc = m.urgency==='Safety' ? '#dc3545' : (m.urgency==='Urgent' ? '#fd7e14' : '#0d6efd');
										var ul = m.urgency==='Safety' ? ' · Säkerhet' : (m.urgency==='Urgent' ? ' · Viktigt' : '');
										return '<div style="border:1px solid var(--bs-border-color);border-left:4px solid '+uc+';border-radius:8px;background:var(--bs-tertiary-bg);padding:8px 10px;margin-bottom:8px;">'+
											'<div style="font-size:12px;color:var(--bs-secondary-color);">Från <strong style="color:var(--bs-body-color);">tävlingsledningen</strong> · '+esc(fmt(m.createdDate))+ul+'</div>'+
											'<div style="white-space:pre-wrap;word-break:break-word;">'+esc(m.body)+'</div></div>';
									}).join('');
								})
								.catch(function(){});
						}
						function showOptIn(){
							optIn.style.display=''; mbox.style.display='none';
							if (window.HpskWebPush && window.HpskWebPush.isIOS) {
								var a=document.getElementById('pnCardApple'); if(a) a.style.display='';
								var t=document.getElementById('pnCardTut'); if(t) t.style.display='';
							}
						}
						function showMsgs(){ optIn.style.display='none'; mbox.style.display=''; loadMsgs(); }
						function decide(){
							var api = window.HpskWebPush;
							if(!api || !api.isSupported){ showOptIn(); return; }
							api.getSubscription().then(function(sub){ if(sub) showMsgs(); else showOptIn(); }).catch(function(){ showOptIn(); });
						}
						decide();
						// Re-evaluate shortly after the user toggles opt-in via the _WebPushSetup button.
						document.addEventListener('click', function(e){ if(e.target && e.target.closest && e.target.closest('#webPushToggle')) setTimeout(decide, 1500); });
						setInterval(function(){ if(!document.hidden && mbox.style.display!=='none') loadMsgs(); }, 60000);
					})();
					</script>
				}

				<div class="card information-sidebar">
					<div class="card-header">
						<h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Information</h5>
					</div>
					<div class="card-body">
					@{
						// Calculate days remaining
						var daysRemaining = (competitionDate.Date - now.Date).Days;
						string daysText;
						string daysBadgeClass;

						if (daysRemaining < 0)
						{
							daysText = $"{Math.Abs(daysRemaining)} dagar sedan";
							daysBadgeClass = "bg-secondary";
						}
						else if (daysRemaining == 0)
						{
							daysText = "Idag!";
							daysBadgeClass = "bg-success";
						}
						else if (daysRemaining == 1)
						{
							daysText = "Imorgon";
							daysBadgeClass = "bg-warning";
						}
						else if (daysRemaining <= 7)
						{
							daysText = $"{daysRemaining} dagar";
							daysBadgeClass = "bg-warning";
						}
						else
						{
							daysText = $"{daysRemaining} dagar";
							daysBadgeClass = "bg-danger";
						}

						// Calculate "Senast uppdaterad" from Model.UpdateDate
						var updateDate = Model.UpdateDate;
						var timeSinceUpdate = DateTime.Now - updateDate;
						string updateText;
						if (timeSinceUpdate.TotalMinutes < 1)
						{
							updateText = "Just nu";
						}
						else if (timeSinceUpdate.TotalHours < 1)
						{
							updateText = $"{(int)timeSinceUpdate.TotalMinutes} minuter sedan";
						}
						else if (timeSinceUpdate.TotalHours < 24)
						{
							updateText = $"{(int)timeSinceUpdate.TotalHours} timmar sedan";
						}
						else
						{
							updateText = updateDate.ToString("yyyy-MM-dd HH:mm");
						}

						// Button visibility logic
						var showStartListPending = now <= registrationCloseDate;
						var competitionCompleted = now.Date > competitionDate.Date;
						var competitionOngoing = now.Date == competitionDate.Date || (now > registrationCloseDate && now.Date <= competitionDate.Date);
						var showResultsPending = now.Date < competitionDate.Date;
					}

					<!-- Antal skyttar -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-people me-1 text-primary"></i> Antal skyttar:</span>
							<span class="badge bg-primary">@uniqueShooterCount</span>
						</div>
					</div>

					<!-- Antal starter -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-flag me-1 text-info"></i> Antal starter:</span>
							<span class="badge bg-info">@totalStartsCount</span>
						</div>
					</div>

					<!-- Dagar till tävling -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-calendar-event me-1 text-danger"></i> Dagar till tävling:</span>
							<span class="badge @daysBadgeClass">@daysText</span>
						</div>
					</div>

					<!-- Senast uppdaterad -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-clock-history me-1 text-secondary"></i> Senast uppdaterad:</span>
							<span class="badge bg-secondary">@updateText</span>
						</div>
					</div>

					<hr>

					@if (!isExternal)
					{
						<!-- Registered Shooters Button -->
						<div class="mb-2">
							<button type="button" class="btn btn-outline-primary w-100" onclick="openRegisteredShootersModal()">
								<i class="bi bi-people-fill me-1"></i> Visa anmälda skyttar
							</button>
						</div>

						<!-- Start List Section -->
						<div class="mb-2">
							@if (isFaltskytte)
							{
								@* Patrullista opens its own public page (clubhouse screen) — mirrors "Visa resultat".
								   Shown once the organiser publishes the patrols; no login (a clubhouse screen isn't logged in). *@
								@if (Model.Value<bool>("faltskyttePatrolsPublished"))
								{
									<a href="/patrullista/@Model.Id" class="btn btn-info w-100" target="_blank" rel="noopener">
										<i class="bi bi-people me-1"></i> Visa patrullista
									</a>
								}
								else
								{
									<p class="text-muted small mb-0">
										<i class="bi bi-hourglass-split me-1"></i> Patrullista har inte publicerats än.
									</p>
								}
							}
							else if (isSpringskytte)
							{
								@* Springskytte can have several start lists (per weapon group / day). One button
								   opens the /startlista/{id} hub that lists them all, instead of one button each. *@
								var springStartLists = competitionChildren
									.Where(c => c.ContentType.Alias == "precisionStartList")
									.ToList();
								if (springStartLists.Any())
								{
									<a href="/startlista/@Model.Id" class="btn btn-info w-100" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('startlistan'); }">
										<i class="bi bi-list-ol me-1"></i> @(springStartLists.Count > 1 ? "Visa startlistor" : "Visa startlista")
									</a>
								}
								else
								{
									<p class="text-muted small mb-0">
										<i class="bi bi-hourglass-split me-1"></i> Startlista har inte publicerats än.
									</p>
								}
							}
							else if (hasOfficialStartList)
							{
								<a href="@startListPageUrl" class="btn btn-info w-100" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('startlistan'); }">
									<i class="bi bi-list-ol me-1"></i> Visa startlista
								</a>
							}
							else
							{
								<p class="text-muted small mb-0">
									<i class="bi bi-hourglass-split me-1"></i> Startlista har inte publicerats än.
								</p>
							}

							@if (hasOfficialFinalsStartList)
							{
								<a href="@finalsStartListPageUrl" class="btn btn-warning w-100 mt-2" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('finalsstartlistan'); }">
									<i class="bi bi-trophy me-1"></i> Visa finalsstartlista
								</a>
							}

							@*
								The member's own times, in context — a link, not a card. This is what keeps a
								competition further out than the home card's window from being a dead end: the
								full itinerary (shooting + funktionärsuppdrag + dagsprogram, with print and
								.ics) lives on /mitt-schema. Only rendered when they actually have something
								here, so it never shows an empty promise.
							*@
							@if (showMyScheduleLink)
							{
								<a href="/mitt-schema?c=@Model.Id" class="btn btn-outline-primary w-100 mt-2">
									<i class="bi bi-calendar2-week me-1"></i> Ditt schema
									@if (mySchedule!.IsToday)
									{
										<span class="badge bg-primary ms-1">Idag</span>
									}
									@if (mySchedule.ConflictCount > 0)
									{
										@* Spelled out: a bare "⚠ 2" on a button next to neutral "Visa …" buttons reads as
										   a count of nothing in particular. The word is what makes it actionable. *@
										<span class="badge bg-warning text-dark ms-1" title="Två saker ligger på samma tid — hör av dig till tävlingsledningen">
											<i class="bi bi-exclamation-triangle"></i>
											@mySchedule.ConflictCount krock@(mySchedule.ConflictCount == 1 ? "" : "ar")
										</span>
									}
								</a>
							}
						</div>

						<!-- Results Section -->
						<div class="mt-2">
							@if (hasResultPage && isResultsOfficial)
							{
								<a href="@resultsUrl" class="btn btn-warning w-100" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('resultatlistan'); }">
									<i class="bi bi-trophy me-1"></i> Visa resultat
								</a>

								@if (showLiveResults)
								{
									<a class="btn btn-outline-secondary w-100 mt-2" href="/live?c=@Model.Id" target="_blank" rel="noopener"><i class="bi bi-tv me-1"></i> Visa Live resultat</a>
								}
							}
							else if (showLiveResults)
							{
								@if (hasResultPage)
								{
									<a class="btn btn-outline-secondary w-100 mt-2" href="/live?c=@Model.Id" target="_blank" rel="noopener"><i class="bi bi-tv me-1"></i> Visa Live resultat</a>
								}
								else
								{
									<div id="liveResultsCheck">
										<p class="text-muted small mb-0" id="noResultsText">
											<i class="bi bi-hourglass-split me-1"></i> Resultat har inte publicerats än.
										</p>
									</div>
								}
							}
							else
							{
								<p class="text-muted small mb-0">
									<i class="bi bi-hourglass-split me-1"></i> Resultat har inte publicerats än.
								</p>
							}
							@if (hasResultPage && hasSubCompetition && isSubResultsOfficial)
							{
								<a href="@subResultsUrl" class="btn btn-warning w-100 mt-2" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('resultatlistan'); }">
									<i class="bi bi-trophy me-1"></i> Visa @subCompetitionNameRaw resultat
								</a>
							}
							@if (isSpringskytte && isStafettResultsOfficial)
							{
								<a href="@stafettResultsUrl" class="btn btn-warning w-100 mt-2" target="_blank" rel="noopener">
									<i class="bi bi-people-fill me-1"></i> Visa stafettresultat
								</a>
							}
						</div>
					}
					else
					{
						<!-- External Competition - Show external registration options -->
						@if (!string.IsNullOrEmpty(externalUrl))
						{
							<div class="mb-2">
								<a href="@externalUrl" target="_blank" class="btn btn-info w-100">
									<i class="bi bi-box-arrow-up-right me-1"></i>Extern länk
								</a>
							</div>
						}
						@if (!string.IsNullOrEmpty(externalRegistrationEmail))
						{
							<div class="mb-2">
								<a href="mailto:@externalRegistrationEmail?subject=Anmälan till @competitionName" class="btn btn-success w-100">
									<i class="bi bi-envelope me-1"></i>Anmäl via mejl
								</a>
							</div>
						}
					}
				</div>
			</div>


			@* Contact Information Card *@
			<div class="card mt-4">
				<div class="card-header">
					<h5 class="mb-0"><i class="bi bi-person-lines-fill me-2"></i>Kontaktinformation</h5>
				</div>
				<div class="card-body">
					@if (!string.IsNullOrEmpty(competitionDirector))
					{
						<div class="mb-2">
							<i class="bi bi-person me-1 text-primary"></i>
