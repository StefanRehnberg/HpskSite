@using HpskSite.Models
@using HpskSite.Extensions
@using HpskSite.CompetitionTypes.Springskytte.Models
@using Umbraco.Cms.Web.Common.PublishedModels;
@using System.Linq;
@using System;
@using System.Globalization;
@inject Umbraco.Cms.Core.Services.IMemberService MemberService
@inject Umbraco.Cms.Core.Security.IMemberManager MemberManager
@inject HpskSite.Services.AdminAuthorizationService AuthService
@inject HpskSite.Services.ClubService ClubService
@inject Umbraco.Cms.Core.Services.IContentService ContentService
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
	Layout = "Master.cshtml";
	ViewBag.Title = Model.Value<string>("competitionName") ?? "Competition";

	// Get competition manager IDs from JSON array
	var competitionManagersJson = Model.Value<string>("competitionManagers") ?? "[]";
	int[] managerIds;
	try
	{
		managerIds = Newtonsoft.Json.JsonConvert.DeserializeObject<int[]>(competitionManagersJson) ?? Array.Empty<int>();
	}
	catch
	{
		managerIds = Array.Empty<int>();
	}

    var competitionName = Model.Value<string>("competitionName") ?? "";
    var description = HpskSite.Extensions.RteHelper.ExtractMarkup(Model.Value<string>("description"));
    var competitionDate = Model.Value<DateTime>("competitionDate");
    var competitionEndDate = Model.Value<DateTime?>("competitionEndDate");
    var venue = Model.Value<string>("venue") ?? "";

    // Multi-day competition logic
    var hasValidEndDate = competitionEndDate.HasValue &&
                          competitionEndDate.Value > DateTime.MinValue &&
                          competitionEndDate.Value.Year > 1900 &&
                          competitionEndDate.Value.Date >= competitionDate.Date;
    var isMultiDay = hasValidEndDate && competitionEndDate!.Value.Date != competitionDate.Date;
    var dateIcon = isMultiDay ? "📅" : "🕐";
    var durationInfo = isMultiDay ?
        $"({(competitionEndDate.Value.Date - competitionDate.Date).Days + 1} dagar)" :
        "(1 dag)";
    var maxParticipants = Model.Value<int>("maxParticipants");
    var registrationFee = Model.Value<string>("registrationFee") ?? "";
    var juniorRegistrationFeeStr = Model.Value<string>("juniorRegistrationFee") ?? "";
    var subCompetitionFeeStr = Model.Value<string>("subCompetitionFee") ?? "";
    var subCompetitionFeeModeRaw = Model.HasProperty("subCompetitionFeeMode") ? Model.Value<string>("subCompetitionFeeMode") ?? "" : "";
    var subCompetitionNameRaw = Model.HasProperty("subCompetitionName") ? Model.Value<string>("subCompetitionName") ?? "" : "";
    var teamRegistrationFeeStr = Model.Value<string>("teamRegistrationFee") ?? "";
    var stafettRegistrationFeeStr = Model.Value<string>("stafettRegistrationFee") ?? "";
    decimal.TryParse(juniorRegistrationFeeStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var juniorRegistrationFeeVal);
    decimal.TryParse(subCompetitionFeeStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var subCompetitionFeeVal);
    decimal.TryParse(teamRegistrationFeeStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var teamRegistrationFeeVal);
    decimal.TryParse(stafettRegistrationFeeStr, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var stafettRegistrationFeeVal);
    var subCompetitionFeeIsPerRegistration = string.Equals(subCompetitionFeeModeRaw, "perRegistration", StringComparison.OrdinalIgnoreCase);
    var registrationOpenDate = Model.Value<DateTime>("registrationOpenDate");
    var registrationCloseDate = Model.Value<DateTime>("registrationCloseDate");
    var competitionDirector = Model.Value<string>("competitionDirector") ?? "";
    var contactEmail = Model.Value<string>("contactEmail") ?? "";
    var contactPhone = Model.Value<string>("contactPhone") ?? "";
    var isActive = Model.Value<bool>("isActive");
    var showLiveResults = Model.Value<bool>("showLiveResults");
    var competitionType = Model.Value<IPublishedContent>("competitionType");
    var competitionTypeStr = Model.Value<string>("competitionType") ?? "Precision";
    var isSpringskytte = competitionTypeStr == "Springskytte";
    var isFaltskytte = competitionTypeStr == "Faltskytte" || competitionTypeStr == "MagnumFalt";
    var dpConfigJson = "";
    var isDirektplacering = false;
    try
    {
        if (Model.HasProperty("direktplaceringConfig"))
        {
            dpConfigJson = Model.Value<string>("direktplaceringConfig") ?? "";
            if (!string.IsNullOrEmpty(dpConfigJson))
            {
                isDirektplacering = dpConfigJson.Contains("\"enabled\":true") || dpConfigJson.Contains("\"Enabled\":true");
            }
        }
    }
    catch { }
    var rsJson = Model.HasProperty("rollingStart") ? Model.Value<string>("rollingStart") : "";
    object rsConfig = null;
    if (!string.IsNullOrEmpty(rsJson)) { try { rsConfig = Newtonsoft.Json.JsonConvert.DeserializeObject(rsJson); } catch {} }
    var numberOfSeriesOrStations = Model.Value<int>("numberOfSeriesOrStations");
    var numberOfFinalSeries = Model.Value<int>("numberOfFinalSeries");

    // External competition properties
    var isExternal = Model.Value<bool>("isExternal");
    var externalUrl = Model.Value<string>("externalUrl");
    var externalRegistrationEmail = Model.Value<string>("externalRegistrationEmail");
    IPublishedContent? invitationFile = null;
    try
    {
        invitationFile = Model.Value<IPublishedContent>("invitationFile");
    }
    catch (ArgumentException)
    {
        // Invalid invitation file path - ignore and continue
    }
    var hasInvitation = invitationFile != null;
    // Get multiple shooting classes support - handle both string array and comma-separated string
    var shootingClassIdsRaw = Model.Value("shootingClassIds");
    var shootingClassIds = "";

    // Handle different data types from Umbraco multiselect
    if (shootingClassIdsRaw is string[] stringArray)
    {
        shootingClassIds = string.Join(",", stringArray);
    }
    else if (shootingClassIdsRaw is IEnumerable<string> enumerable)
    {
        shootingClassIds = string.Join(",", enumerable);
    }
    else if (shootingClassIdsRaw is string stringValue)
    {
        shootingClassIds = stringValue ?? "";
    }
    else if (shootingClassIdsRaw != null)
    {
        // Try generic Value<T> approach for Flexible Dropdown
        try
        {
            var typed = Model.Value<IEnumerable<string>>("shootingClassIds");
            if (typed != null)
            {
                shootingClassIds = string.Join(",", typed);
            }
        }
        catch
        {
            // Fallback to empty if all parsing fails
            shootingClassIds = "";
        }
    }

    var allowDualCClassRegistration = Model.Value<bool>("allowDualCClassRegistration");
    var allowSelfReporting = Model.Value<bool>("allowSelfReporting");
    var allowTeams = Model.Value<bool>("allowTeams");
    var allowStafett = Model.Value<bool>("allowStafett");

    // Get competition shooting classes using Models.ShootingClasses
    var competitionShootingClasses = new List<ShootingClass>();

    // Try to parse shooting class IDs - handle JSON array format
    if (!string.IsNullOrEmpty(shootingClassIds))
    {
        var ids = new List<string>();

        // Check if it's a JSON array format: ["A1","B2"]
        if (shootingClassIds.StartsWith("[") && shootingClassIds.EndsWith("]"))
        {
            try
            {
                // Parse JSON array manually (simple approach)
                var jsonContent = shootingClassIds.Substring(1, shootingClassIds.Length - 2); // Remove [ and ]
                ids.AddRange(jsonContent.Split(',')
                    .Select(s => s.Trim().Trim('"'))
                    .Where(s => !string.IsNullOrEmpty(s)));
            }
            catch
            {
                // If JSON parsing fails, try as comma-separated
                ids.AddRange(shootingClassIds.Split(',')
                    .Select(id => id.Trim())
                    .Where(id => !string.IsNullOrEmpty(id)));
            }
        }
        else
        {
            // Already comma-separated or single value
            ids.AddRange(shootingClassIds.Split(',')
                .Select(id => id.Trim())
                .Where(id => !string.IsNullOrEmpty(id)));
        }

        foreach (var id in ids)
        {
            var shootingClass = HpskSite.Models.ShootingClasses.GetById(id);
            if (shootingClass != null)
            {
                competitionShootingClasses.Add(shootingClass);
            }
        }
    }


    var hasShootingClasses = competitionShootingClasses.Any();
    var shootingClassNames = hasShootingClasses
        ? string.Join(", ", competitionShootingClasses.Select(sc => sc.Name))
        : "Inga klasser angivna";

    // Parse Springskytte class IDs directly (they don't map to standard ShootingClasses)
    var springClassIds = new List<string>();
    if (isSpringskytte && !string.IsNullOrEmpty(shootingClassIds))
    {
        if (shootingClassIds.StartsWith("[") && shootingClassIds.EndsWith("]"))
        {
            try { springClassIds.AddRange(System.Text.Json.JsonSerializer.Deserialize<string[]>(shootingClassIds) ?? Array.Empty<string>()); }
            catch { springClassIds.AddRange(shootingClassIds.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s))); }
        }
        else
        {
            springClassIds.AddRange(shootingClassIds.Split(',').Select(s => s.Trim()).Where(s => !string.IsNullOrEmpty(s)));
        }
    }

    // Group available shooting classes by weapon (so A_opt_X is its own group, not lumped into A).
    var aClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A).ToList();
    var aOptClasses = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_Opt).ToList();
    var aMClasses   = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_M).ToList();
    var aPClasses   = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_P).ToList();
    var aGClasses   = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.A_G).ToList();
    var bClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.B).ToList();
    var cClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.C).ToList();
    var rClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.R).ToList();
    var lClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.L).ToList();
    var mClasses    = competitionShootingClasses.Where(sc => sc.Weapon == HpskSite.Models.WeaponClass.M).ToList();

    // Subdivide C classes into subcategories for proper validation
    var cRegularClasses = cClasses.Where(sc => sc.Id == "C1" || sc.Id == "C2" || sc.Id == "C3").ToList();
    var cVetClasses = cClasses.Where(sc => sc.Id == "C_Vet_Y" || sc.Id == "C_Vet_A").ToList();
    var cJuniorClasses = cClasses.Where(sc => sc.Id == "C_Jun").ToList();
    var cDamClasses = cClasses.Where(sc => sc.Id.EndsWith("_Dam") && sc.Id.StartsWith("C")).ToList();

    // Subdivide L classes into subcategories (same structure as C)
    var lRegularClasses = lClasses.Where(sc => sc.Id == "L1" || sc.Id == "L2" || sc.Id == "L3").ToList();
    var lVetClasses = lClasses.Where(sc => sc.Id == "L_Vet_Y" || sc.Id == "L_Vet_A").ToList();
    var lJuniorClasses = lClasses.Where(sc => sc.Id == "L_Jun").ToList();
    var lDamClasses = lClasses.Where(sc => sc.Id.EndsWith("_Dam") && sc.Id.StartsWith("L")).ToList();

    var now = DateTime.Now;
    string status = "Okänd";
    string badgeClass = "secondary";

    if (!isActive)
    {
        status = "Inaktiv";
        badgeClass = "danger";
    }
    else if (now < registrationOpenDate)
    {
        status = "Anmälan öppnar snart";
        badgeClass = "info";
    }
    else if (now >= registrationOpenDate && now <= registrationCloseDate)
    {
        status = "Anmälan öppen";
        badgeClass = "success";
    }
    else if (now > registrationCloseDate && now < competitionDate)
    {
        status = "Anmälan stängd";
        badgeClass = "warning";
    }
    else if (now.Date == competitionDate.Date)
    {
        status = "Tävling idag";
        badgeClass = "primary";
    }
    else if (now > competitionDate)
    {
        status = "Tävlingen avslutad";
        badgeClass = "secondary";
    }

    // Check if current user can manage this competition
    var currentMember = await MemberManager.GetCurrentMemberAsync();
    bool canManageCompetition = false;

    // Get current user info for highlighting in registered shooters modal
    var currentMemberName = currentMember?.Name ?? "";
    var currentMemberClub = "";
    // Registration info computed server-side for performance
    var regRole = "member";
    var regMemberId = 0;
    var regMemberEmail = "";
    int? regClubId = null;
    var regClubName = "";
    var svComparer = StringComparer.Create(new CultureInfo("sv-SE"), ignoreCase: true);
    var allClubsJson = "[]";
    var regRegionCode = "";
    var isRegionalAdmin = false;
    var clubsWithRegionsJson = "[]";

    // Distributed result reporting authorization (computed below alongside other auth)
    bool canReportDistributedResults = false;

    if (currentMember != null)
    {
        var memberData = MemberService.GetByEmail(currentMember.Email ?? "");
        if (memberData != null)
        {
            regMemberId = memberData.Id;
            regMemberEmail = memberData.Email ?? "";
            var primaryClubIdStr = memberData.GetValue<string>("primaryClubId");
            if (!string.IsNullOrEmpty(primaryClubIdStr) && int.TryParse(primaryClubIdStr, out int primaryClubId))
            {
                regClubId = primaryClubId;
                regClubName = ClubService.GetClubNameById(primaryClubId) ?? "";
                currentMemberClub = regClubName;
                // Look up region for member's club (O(1) cache lookup)
                if (string.IsNullOrEmpty(regRegionCode))
                {
                    var memberClubNode = Umbraco.Content(primaryClubId);
                    if (memberClubNode != null)
                        regRegionCode = memberClubNode.Value<string>("regionalFederation") ?? "";
                }
            }

            // Load roles once — derive all authorization from this (avoids ~24 redundant service calls)
            var roles = MemberService.GetAllRoles(memberData.Id)?.ToList() ?? new List<string>();
            bool isSiteAdmin = roles.Contains("Administrators");
            bool isClubAdmin = roles.Any(r => r.StartsWith("ClubAdmin_"));
            bool isSkjutledare = roles.Any(r => r.StartsWith("Skjutledare_"));

            // Competition manager role (managerIds from line 23, memberData.Id available here)
            bool isCompetitionManager = managerIds.Contains(memberData.Id);

            if (isSiteAdmin) regRole = "admin";
            else if (isClubAdmin) regRole = "clubAdmin";
            else if (isSkjutledare) regRole = "skjutledare";

            // Detect regional admin
            var regionalAdminRole = roles.FirstOrDefault(r => r.StartsWith("RegionalAdmin_"));
            if (regionalAdminRole != null)
            {
                regRegionCode = regionalAdminRole.Replace("RegionalAdmin_", "");
                isRegionalAdmin = true;
                if (regRole == "member") regRole = "regionalAdmin";
            }

            // Competition manager can register others for their managed competition
            if (isCompetitionManager && regRole == "member") regRole = "competitionManager";

            // For club admin / skjutledare without primaryClubId, use role-derived club
            if (!regClubId.HasValue && isClubAdmin)
            {
                var clubAdminRole = roles.First(r => r.StartsWith("ClubAdmin_"));
                if (int.TryParse(clubAdminRole.Replace("ClubAdmin_", ""), out int cid))
                {
                    regClubId = cid;
                    regClubName = ClubService.GetClubNameById(cid) ?? "";
                }
            }
            if (!regClubId.HasValue && isSkjutledare)
            {
                var skjRole = roles.First(r => r.StartsWith("Skjutledare_"));
                if (int.TryParse(skjRole.Replace("Skjutledare_", ""), out int cid))
                {
                    regClubId = cid;
                    regClubName = ClubService.GetClubNameById(cid) ?? "";
                }
            }

            // Build club list for non-member roles (sorted Swedish)
            if (regRole != "member")
            {
                var clubs = ClubService.GetAllClubs()
                    .Where(c => c.IsActive)
                    .OrderBy(c => c.Name, svComparer)
                    .Select(c => new { id = c.Id, name = c.Name })
                    .ToList();
                allClubsJson = System.Text.Json.JsonSerializer.Serialize(clubs);
            }
            else if (regClubId.HasValue)
            {
                // Member only sees own club
                var ownClub = new[] { new { id = regClubId.Value, name = regClubName } };
                allClubsJson = System.Text.Json.JsonSerializer.Serialize(ownClub);
            }

            // Build clubs-with-regions for team registration (only for admin/regional admin who need club picker)
            // Uses Umbraco.Content() O(1) lookups — no DescendantsOrSelf
            if (allowTeams && (isSiteAdmin || isRegionalAdmin))
            {
                var allActiveClubs = ClubService.GetAllClubs().Where(c => c.IsActive).ToList();
                var clubsWithRegionsList = new List<Dictionary<string, object>>();
                foreach (var c in allActiveClubs)
                {
                    var cNode = Umbraco.Content(c.Id);
                    var region = cNode?.Value<string>("regionalFederation") ?? "";
                    clubsWithRegionsList.Add(new Dictionary<string, object>
                    {
                        ["id"] = c.Id,
                        ["name"] = c.Name,
                        ["region"] = region
                    });
                }
                var jsonOpts = new System.Text.Json.JsonSerializerOptions
                {
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                };
                clubsWithRegionsJson = System.Text.Json.JsonSerializer.Serialize(
                    clubsWithRegionsList.OrderBy(x => (string)x["name"], svComparer), jsonOpts);
            }

            // Competition management — compute from already-loaded roles and managerIds
            // isCompetitionManager already computed above (line ~288)
            bool isClubAdminForCompetition = false;
            var competitionClubId = Model.Value<int>("clubId");
            if (competitionClubId > 0)
            {
                // Check direct club admin, site admin, or regional admin for the club's region
                isClubAdminForCompetition = isSiteAdmin
                    || roles.Contains($"ClubAdmin_{competitionClubId}")
                    || roles.Any(r =>
                    {
                        if (!r.StartsWith("RegionalAdmin_")) return false;
                        var clubNode = Umbraco.Content(competitionClubId);
                        if (clubNode == null || clubNode.ContentType.Alias != "club") return false;
                        var clubRegion = clubNode.Value<string>("regionalFederation") ?? "";
                        return r == $"RegionalAdmin_{clubRegion}";
                    });
            }
            canManageCompetition = isSiteAdmin || isCompetitionManager || isClubAdminForCompetition;

            // Distributed result reporting — uses same auth values (no duplicate service calls)
            if (allowSelfReporting && !isExternal)
            {
                canReportDistributedResults = isSiteAdmin || isCompetitionManager || isClubAdmin || isSkjutledare || isRegionalAdmin;
            }
        }
    }

    // Server-side sidebar data (replaces 3 slow AJAX calls with in-memory published content cache lookups)
    var competitionChildren = Model.Children()?.ToList() ?? new List<IPublishedContent>();

    // 1. Registration counts — use IContentService to include saved-but-unpublished registrations
    long _regHubTotal;
    var competitionContentChildren = ContentService.GetPagedChildren(Model.Id, 0, 100, out _regHubTotal);
    var regHub = competitionContentChildren.FirstOrDefault(c => c.ContentType.Alias == "competitionRegistrationsHub");
    var registrationContents = new List<Umbraco.Cms.Core.Models.IContent>();
    if (regHub != null)
    {
        long totalRegs;
        registrationContents = ContentService.GetPagedChildren(regHub.Id, 0, 1000, out totalRegs)
            .Where(c => c.ContentType.Alias == "competitionRegistration")
            .ToList();
    }
    var uniqueShooterCount = registrationContents
        .Select(r => r.GetValue<string>("memberId") ?? "")
        .Where(id => !string.IsNullOrEmpty(id))
        .Distinct()
        .Count();
    var totalStartsCount = 0;
    foreach (var reg in registrationContents)
    {
        var classesJson = reg.GetValue<string>("shootingClasses") ?? "";
        if (!string.IsNullOrEmpty(classesJson))
        {
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(classesJson);
                totalStartsCount += doc.RootElement.GetArrayLength();
            }
            catch { totalStartsCount += 1; }
        }
        else
        {
            totalStartsCount += 1;
        }
    }

    // 2. Start list availability from published content
    var startListsHub = competitionChildren.FirstOrDefault(c => c.ContentType.Alias == "competitionStartListsHub");
    var officialStartList = startListsHub?.Children()?.FirstOrDefault(sl => sl.Value<bool>("isOfficialStartList"));
    var hasOfficialStartList = officialStartList != null;
    var startListPageUrl = hasOfficialStartList ? officialStartList.Url() : "";

    // 3. Result page availability from published content
    var resultPageNode = competitionChildren.FirstOrDefault(c => c.ContentType.Alias == "competitionResult" && c.Name == "Resultat");
    var hasResultPage = resultPageNode != null;
    var isResultsOfficial = resultPageNode?.Value<bool>("isOfficial") ?? false;
    // Deltävling result list — published independently of the main result list. When
    // subCompetitionIsOfficial is true on the same competitionResult node, a second
    // public button is rendered pointing at /resultat/?sub=true (handled by the
    // /resultat/ page). Value<bool> returns false when the property is missing, so
    // we don't need a separate HasProperty guard — a clean falsy value is the
    // correct "no sub-comp published yet" answer.
    var isSubResultsOfficial = resultPageNode?.Value<bool>("subCompetitionIsOfficial") ?? false;
    var hasSubCompetition = !string.IsNullOrWhiteSpace(subCompetitionNameRaw);

    // Results URL (used in sidebar and JavaScript)
    var resultsUrl = Model.Url().TrimEnd('/') + "/resultat/";
    var subResultsUrl = resultsUrl + "?sub=true";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb with Series Context -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Model.Root().Url()">Hem</a></li>
                    @if (Model.Parent?.ContentType.Alias == "competitionsHub")
                    {
                        <li class="breadcrumb-item"><a href="@Model.Parent.Url()">Tävlingar</a></li>
                    }
                    else if (Model.Parent?.ContentType.Alias == "competitionSeries")
                    {
                        @if (Model.Parent.Parent?.ContentType.Alias == "competitionsHub")
                        {
                            <li class="breadcrumb-item"><a href="@Model.Parent.Parent.Url()">Tävlingar</a></li>
                        }
                        else if (Model.Parent.Parent?.ContentType.Alias == "competitionSeason")
                        {
                            <li class="breadcrumb-item"><a href="@Model.Parent.Parent.Parent.Url()">Tävlingar</a></li>
                        }
                        <li class="breadcrumb-item"><a href="@Model.Parent.Url()">@Model.Parent.Name</a></li>
                    }
                    else if (Model.Parent?.ContentType.Alias == "competitionSeason")
                    {
                        <li class="breadcrumb-item"><a href="@Model.Parent.Parent.Url()">Tävlingar</a></li>
                    }
                    <li class="breadcrumb-item active">@competitionName</li>
                </ol>
            </nav>
        </div>
    </div>

    @* Series Information Banner (when competition is part of a series) *@
    @if (Model.Parent?.ContentType.Alias == "competitionSeries")
    {
        var seriesContent = Model.Parent;
        var seriesName = seriesContent.Value<string>("seriesName") ?? seriesContent.Name;
        var seriesLogo = seriesContent.Value<IPublishedContent>("seriesLogo");
        var allSeriesCompetitions = seriesContent.Children.Where(x => x.ContentType.Alias == "competition")
                                                          .OrderBy(x => x.Value<int?>("seriesSortOrder") ?? int.MaxValue)
                                                          .ThenBy(x => x.Value<DateTime>("competitionDate"))
                                                          .ToList();
        var currentIndex = allSeriesCompetitions.FindIndex(x => x.Id == Model.Id);
        var roundNumber = currentIndex + 1;
        var totalRounds = allSeriesCompetitions.Count();
        var previousCompetition = currentIndex > 0 ? allSeriesCompetitions[currentIndex - 1] : null;
        var nextCompetition = currentIndex < allSeriesCompetitions.Count - 1 ? allSeriesCompetitions[currentIndex + 1] : null;

        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-primary">
                    <div class="card-header bg-primary text-white">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <div class="d-flex align-items-center">
                                    @if (seriesLogo != null)
                                    {
                                        <img src="@seriesLogo.Url()" alt="@seriesName Logo" class="me-3" style="max-height: 40px; max-width: 60px;">
                                    }
                                    <div>
                                        <h5 class="mb-1">🏆 @seriesName</h5>
                                        <small class="opacity-75">Omgång @roundNumber av @totalRounds</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 text-end">
                                <a href="@seriesContent.Url()" class="btn btn-light btn-sm">
                                    <i class="bi bi-list"></i> Visa serie
                                </a>
                            </div>
                        </div>
                    </div>
                    @if (previousCompetition != null || nextCompetition != null)
                    {
                        <div class="card-footer bg-light">
                            <div class="row align-items-center">
                                <div class="col-6 col-md-4">
                                    @if (previousCompetition != null)
                                    {
                                        <a href="@previousCompetition.CompetitionUrl()" class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-chevron-left"></i> Föregående
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Visar första tävlingen i serien</span>
                                    }
                                </div>
                                <div class="d-none d-md-block col-md-4 text-center">
                                    <small class="text-muted">@seriesName navigering</small>
                                </div>
                                <div class="col-6 col-md-4 text-end">
                                    @if (nextCompetition != null)
                                    {
                                        <a href="@nextCompetition.CompetitionUrl()" class="btn btn-outline-secondary btn-sm">
                                            Nästa <i class="bi bi-chevron-right"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Visar sista tävlingen i serien</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
			<div class="card mb-4">
			<div class="card-header">
			<div class="d-flex justify-content-between align-items-center">
			<h2 class="card-title h4 mb-0">@competitionName</h2>
			<div class="d-flex gap-2 align-items-center">
			@* ======================================== EXTERNAL COMPETITION BUTTONS ======================================== *@
			@if (isExternal)
			{
				@* External competition - show external link and email button *@
				@if (!string.IsNullOrEmpty(externalUrl))
				{
					<a href="@externalUrl" target="_blank" class="btn btn-info">
						<i class="bi bi-box-arrow-up-right"></i> Gå till tävlingssida
					</a>
				}

				@if (!string.IsNullOrEmpty(externalRegistrationEmail) && isActive && now >= registrationOpenDate && now <= registrationCloseDate)
				{
					<a href="mailto:@externalRegistrationEmail?subject=Anmälan till @Uri.EscapeDataString(competitionName)"
					   class="btn btn-outline-info">
						<i class="bi bi-envelope"></i> Anmäl via e-post
					</a>
				}
			}
			@* ======================================== INTERNAL COMPETITION BUTTONS ======================================== *@
			else
			{
				@* Registration and Rapportera resultat buttons live in the "Anmälan" card in the right column *@

				@* Management button (admin/competition manager only) - Bulls eye icon only *@
				@if (canManageCompetition)
				{
				<a href="/competitionmanagement?competitionId=@Model.Id" class="btn btn-outline-secondary" title="Administrera tävling">
				<i class="bi bi-bullseye me-1"></i>Administrera tävling
				</a>
				}
			}
			</div>
			</div>
			</div>
				<div class="card-body">
					<div class="row">
						<div class="col-md-6">
							<p><strong>Datum & Plats:</strong></p>
							<ul class="list-unstyled">
								<li>
									@dateIcon
									@if (isMultiDay)
									{
										<strong>@competitionDate.ToString("dddd, d MMMM", CultureInfo.GetCultureInfo("sv-SE"))@(competitionDate.TimeOfDay != TimeSpan.Zero ? ", kl " + competitionDate.ToString("HH:mm") : "") - @competitionEndDate!.Value.ToString("dddd, d MMMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))</strong>
										<small class="text-muted">@durationInfo</small>
									}
									else
									{
										<strong>@competitionDate.ToString("dddd, d MMMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))@(competitionDate.TimeOfDay != TimeSpan.Zero ? ", kl " + competitionDate.ToString("HH:mm") : "")</strong>
										<small class="text-muted">@durationInfo</small>
									}
								</li>
								<li><i class="bi bi-geo-alt"></i> @venue</li>
							</ul>

							@if (isSpringskytte)
							{
								<p><strong>Klasser:</strong></p>
								if (springClassIds.Any())
								{
									<div class="mb-2 d-flex flex-wrap gap-1">
										@foreach (var cls in springClassIds)
										{
											<span class="badge bg-primary">@SpringskytteClasses.FormatWithAgeSpan(cls)</span>
										}
									</div>
								}
								else
								{
									<div class="alert alert-warning mb-2">
										<i class="bi bi-exclamation-triangle"></i> Inga klasser har angivits för denna tävling.
									</div>
								}
							}
							else
							{
								<p><strong>Skjutklasser:</strong></p>
								@if (hasShootingClasses)
								{
									<div class="mb-2">
										@foreach (var shootingClass in competitionShootingClasses)
										{
											<span class="badge bg-primary me-2"
												  data-bs-toggle="tooltip"
												  data-bs-placement="top"
												  title="@shootingClass.Description">@shootingClass.Name</span>
										}
									</div>
								}
								else
								{
									<div class="alert alert-warning mb-2">
										<i class="bi bi-exclamation-triangle"></i> Inga skytteklasser har angivits för denna tävling.
									</div>
								}
							}
						</div>
						<div class="col-md-6">
							<p><strong>Anmälningsdetaljer:</strong></p>
							<ul class="list-unstyled">
								@if (!isExternal)
								{
									@if (isFaltskytte)
									{
										@if (rsConfig != null)
										{
											<li><i class="bi bi-arrow-repeat"></i> <strong>Rullande start</strong> — anmälan på plats</li>
										}
										else
										{
											<li><i class="bi bi-pencil-square"></i> Föranmälan krävs</li>
										}
									}
									<li><i class="bi bi-currency-dollar"></i> Avgift: <strong>@registrationFee kr</strong> <small class="text-muted">per anmäld klass</small></li>
										@if (juniorRegistrationFeeVal > 0)
										{
											<li class="ms-4"><i class="bi bi-person-arms-up"></i> Junioravgift: <strong>@juniorRegistrationFeeStr kr</strong> <small class="text-muted">per anmäld juniorklass</small></li>
										}
										@if (subCompetitionFeeVal > 0)
										{
											var subCompModeLabel = subCompetitionFeeIsPerRegistration ? "en gång per anmälan" : "per anmäld klass";
											var subCompLabelSuffix = string.IsNullOrEmpty(subCompetitionNameRaw) ? "Deltävling" : subCompetitionNameRaw;
											<li class="ms-4"><i class="bi bi-plus-circle"></i> Deltävlingsavgift (@subCompLabelSuffix): <strong>@subCompetitionFeeStr kr</strong> <small class="text-muted">@subCompModeLabel</small></li>
										}
										@if (allowTeams && teamRegistrationFeeVal > 0)
										{
											<li class="ms-4"><i class="bi bi-people"></i> Lagavgift: <strong>@teamRegistrationFeeStr kr</strong> <small class="text-muted">per lag</small></li>
										}
										@if (allowStafett && stafettRegistrationFeeVal > 0)
										{
											<li class="ms-4"><i class="bi bi-flag"></i> Stafettavgift: <strong>@stafettRegistrationFeeStr kr</strong> <small class="text-muted">per lag</small></li>
										}
								}
								<li><i class="bi bi-calendar-check"></i> Öppnar: @registrationOpenDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))</li>
								<li><i class="bi bi-calendar-x"></i> Stänger: @registrationCloseDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))</li>
							</ul>

							<p><strong>Tävlingsinformation:</strong></p>
							<ul class="list-unstyled">
								@if (competitionType != null)
								{
									<li><i class="bi bi-trophy"></i> Typ: <strong>@competitionType.Name</strong></li>
								}
								@if (!isSpringskytte)
								{
									<li><i class="bi bi-list-ol"></i> Antal serier: <strong>@(numberOfFinalSeries > 0 ? $"{numberOfSeriesOrStations - numberOfFinalSeries} + {numberOfFinalSeries}" : $"{numberOfSeriesOrStations}")</strong></li>
								}
								@if (!isExternal)
								{
									<li><i class="bi bi-broadcast@(showLiveResults ? "" : "-off")"></i> Live-resultat: <strong>@(showLiveResults ? "Ja" : "Nej")</strong></li>
								}
							</ul>
						</div>
					</div>
				</div>
			</div>

			@* Beskrivning Card *@
			@if (!string.IsNullOrWhiteSpace(description))
			{
				<div class="card mb-4">
					<div class="card-header">
						<h3 class="card-title h5 mb-0"><i class="bi bi-text-paragraph me-2"></i>Beskrivning</h3>
					</div>
					<div class="card-body">
						<div class="prose">
							@Html.Raw(System.Net.WebUtility.HtmlDecode(description))
						</div>
					</div>
				</div>
			}

			@* ======================================== Invitation File Display (Both Internal & External) ======================================== *@
			@if (hasInvitation && invitationFile != null)
			{
				<div class="card mb-4">
					<div class="card-header" style="background-color: var(--bs-tertiary-bg);">
						<h3 class="card-title h5 mb-0">
							<i class="bi bi-file-earmark-pdf me-2"></i>Inbjudan
							@if (isExternal)
							{
								<span class="badge bg-info ms-2">Extern tävling</span>
							}
						</h3>
					</div>
					<div class="card-body">
						<div class="mb-3">
							<a href="@invitationFile.Url()" class="btn btn-primary" target="_blank" download>
								<i class="bi bi-download me-1"></i>Ladda ner inbjudan
							</a>
							<small class="text-muted ms-2">@invitationFile.Name</small>
						</div>
						@if (invitationFile.Url().EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
						{
							<div class="ratio ratio-4x3" style="min-height: 600px;">
								<iframe src="@invitationFile.Url()"
										frameborder="0"
										style="border: 1px solid #ddd; border-radius: 4px;"
										title="Tävlingsinbjudan">
								</iframe>
							</div>
							<p class="text-muted small mt-2">
								<i class="bi bi-info-circle"></i> PDF-förhandsgranskning. Om den inte visas korrekt, ladda ner filen ovan.
							</p>
						}
						else
						{
							<div class="alert alert-info">
								<i class="bi bi-file-earmark-word me-1"></i>
								Dokumentet är inte en PDF-fil och kan inte förhandsgranskas. Klicka på "Ladda ner inbjudan" ovan.
							</div>
						}
					</div>
				</div>
			}

		</div>

		@* ======================================== INTERNAL COMPETITION ONLY: Information Sidebar ======================================== *@
		@if (!isExternal)
		{
			<div class="col-lg-4">
				@* ======================================== Anmälan Card ======================================== *@
				<div class="card mb-4">
					<div class="card-header">
						<h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Anmälan</h5>
					</div>
					<div class="card-body">
						@{
							var regClosed = now > registrationCloseDate;
							var regNotYetOpen = now < registrationOpenDate;
							var regOpen = !regClosed && !regNotYetOpen;
							var canRegister = isActive && regOpen && (hasShootingClasses || isSpringskytte);
						}
						@if (regClosed)
						{
							<p class="text-muted small mb-2">
								<i class="bi bi-calendar-x me-1"></i>Anmälan stängde @registrationCloseDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))
							</p>
							<button class="btn btn-success w-100" disabled>
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						else if (regNotYetOpen)
						{
							<p class="text-muted small mb-2">
								<i class="bi bi-clock me-1"></i>Anmälan öppnar @registrationOpenDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))
							</p>
							<button class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#registrationNotOpenModal">
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#registrationNotOpenModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#registrationNotOpenModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						else if (canRegister)
						{
							<p class="text-muted small mb-2">
								<i class="bi bi-calendar-check me-1"></i>Sista anmälningsdag: @registrationCloseDate.ToString("d MMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))
							</p>
							<button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#registrationModal">
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button type="button" class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#teamRegistrationModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button type="button" class="btn btn-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#stafettRegistrationModal">
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						else
						{
							@* Not active or no shooting classes configured *@
							<p class="text-muted small mb-2">
								<i class="bi bi-info-circle me-1"></i>Anmälan är inte tillgänglig just nu.
							</p>
							<button class="btn btn-success w-100" disabled>
								<i class="bi bi-person-plus me-1"></i>Anmäl
							</button>
							@if (allowTeams)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl lag
								</button>
							}
							@if (allowStafett)
							{
								<button class="btn btn-success w-100 mt-2" disabled>
									<i class="bi bi-people-fill me-1"></i>Anmäl stafettlag
								</button>
							}
						}
						@* Distributed result reporting button (always full-width so it stays readable on mobile) *@
						@if (canReportDistributedResults)
						{
							<button type="button" class="btn btn-outline-success w-100 mt-2" data-bs-toggle="modal" data-bs-target="#distributedResultModal">
								<i class="bi bi-pencil-square me-1"></i>Rapportera resultat
							</button>
						}

						@* Unpaid invoices button — shown/hidden by JS *@
						<div id="unpaidInvoicesButtonContainer" style="display:none;" class="mt-2">
							<button type="button" class="btn btn-warning w-100" data-bs-toggle="modal" data-bs-target="#unpaidInvoicesModal">
								<i class="bi bi-wallet2 me-1"></i>Betala anmälningsavgift
							</button>
						</div>
					</div>
				</div>



				@* ======================================== Registration Not Open Modal ======================================== *@
				<div class="modal fade" id="registrationNotOpenModal" tabindex="-1" aria-labelledby="registrationNotOpenModalLabel" aria-hidden="true">
					<div class="modal-dialog modal-dialog-centered">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title" id="registrationNotOpenModalLabel">
									<i class="bi bi-clock me-2"></i>Anmälan har inte öppnat
								</h5>
								<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Stäng"></button>
							</div>
							<div class="modal-body">
								<p>Anmälan till <strong>@competitionName</strong> har inte öppnat ännu.</p>
								<p>Anmälan öppnar <strong>@registrationOpenDate.ToString("dddd d MMMM yyyy", CultureInfo.GetCultureInfo("sv-SE"))</strong>.</p>
								<p class="text-muted small mb-0">Kom tillbaka efter detta datum för att anmäla dig.</p>
							</div>
							<div class="modal-footer">
								<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Stäng</button>
							</div>
						</div>
					</div>
				</div>

				<div class="card information-sidebar">
					<div class="card-header">
						<h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Information</h5>
					</div>
					<div class="card-body">
					@{
						// Calculate days remaining
						var daysRemaining = (competitionDate.Date - now.Date).Days;
						string daysText;
						string daysBadgeClass;

						if (daysRemaining < 0)
						{
							daysText = $"{Math.Abs(daysRemaining)} dagar sedan";
							daysBadgeClass = "bg-secondary";
						}
						else if (daysRemaining == 0)
						{
							daysText = "Idag!";
							daysBadgeClass = "bg-success";
						}
						else if (daysRemaining == 1)
						{
							daysText = "Imorgon";
							daysBadgeClass = "bg-warning";
						}
						else if (daysRemaining <= 7)
						{
							daysText = $"{daysRemaining} dagar";
							daysBadgeClass = "bg-warning";
						}
						else
						{
							daysText = $"{daysRemaining} dagar";
							daysBadgeClass = "bg-danger";
						}

						// Calculate "Senast uppdaterad" from Model.UpdateDate
						var updateDate = Model.UpdateDate;
						var timeSinceUpdate = DateTime.Now - updateDate;
						string updateText;
						if (timeSinceUpdate.TotalMinutes < 1)
						{
							updateText = "Just nu";
						}
						else if (timeSinceUpdate.TotalHours < 1)
						{
							updateText = $"{(int)timeSinceUpdate.TotalMinutes} minuter sedan";
						}
						else if (timeSinceUpdate.TotalHours < 24)
						{
							updateText = $"{(int)timeSinceUpdate.TotalHours} timmar sedan";
						}
						else
						{
							updateText = updateDate.ToString("yyyy-MM-dd HH:mm");
						}

						// Button visibility logic
						var showStartListPending = now <= registrationCloseDate;
						var competitionCompleted = now.Date > competitionDate.Date;
						var competitionOngoing = now.Date == competitionDate.Date || (now > registrationCloseDate && now.Date <= competitionDate.Date);
						var showResultsPending = now.Date < competitionDate.Date;
					}

					<!-- Antal skyttar -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-people me-1 text-primary"></i> Antal skyttar:</span>
							<span class="badge bg-primary">@uniqueShooterCount</span>
						</div>
					</div>

					<!-- Antal starter -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-flag me-1 text-info"></i> Antal starter:</span>
							<span class="badge bg-info">@totalStartsCount</span>
						</div>
					</div>

					<!-- Dagar till tävling -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-calendar-event me-1 text-danger"></i> Dagar till tävling:</span>
							<span class="badge @daysBadgeClass">@daysText</span>
						</div>
					</div>

					<!-- Senast uppdaterad -->
					<div class="mb-3">
						<div class="d-flex justify-content-between align-items-center">
							<span><i class="bi bi-clock-history me-1 text-secondary"></i> Senast uppdaterad:</span>
							<span class="badge bg-secondary">@updateText</span>
						</div>
					</div>

					<hr>

					@if (!isExternal)
					{
						<!-- Registered Shooters Button -->
						<div class="mb-2">
							<button type="button" class="btn btn-outline-primary w-100" onclick="openRegisteredShootersModal()">
								<i class="bi bi-people-fill me-1"></i> Visa anmälda skyttar
							</button>
						</div>

						<!-- Start List Section -->
						<div class="mb-2">
							@if (isFaltskytte)
							{
								<div id="faltPublicPatrols_@Model.Id">
									<p class="text-muted small mb-0">
										<i class="bi bi-hourglass-split me-1"></i> Patrullista har inte publicerats än.
									</p>
								</div>
								<script>
								(function() {
									var container = document.getElementById('faltPublicPatrols_@Model.Id');
									fetch('/umbraco/surface/Faltskytte/GetPublicPatrols?competitionId=@Model.Id')
										.then(function(r) { return r.json(); })
										.then(function(data) {
											if (!data.success || !data.published || !data.patrols || data.patrols.length === 0) return;
											container.innerHTML = '<button class="btn btn-info w-100" onclick="handlePatrullistaClick_@(Model.Id)()">' +
												'<i class="bi bi-people me-1"><\/i> Visa patrullista<\/button>';
											window['handlePatrullistaClick_@(Model.Id)'] = function() {
												if (!currentUserIsLoggedIn) { showLoginRequiredModal('patrullistan'); return; }
												window['faltShowPublicPatrols_@(Model.Id)']();
											};
											window['faltShowPublicPatrols_@(Model.Id)'] = function() {
												var byGroup = {};
												data.patrols.forEach(function(p) {
													var wg = p.weaponGroup || '?';
													if (!byGroup[wg]) byGroup[wg] = [];
													byGroup[wg].push(p);
												});
												var body = '';
												Object.keys(byGroup).forEach(function(wg) {
													var grp = byGroup[wg];
													var total = grp.reduce(function(s,p){return s+p.members.length;},0);
													body += '<div class="card mb-3"><div class="card-header py-2">' +
														'<strong>Vapengrupp ' + wg + '<\/strong>' +
														'<span class="badge bg-primary ms-2">' + grp.length + ' patruller<\/span>' +
														'<span class="badge bg-secondary ms-2">' + total + ' skyttar<\/span>' +
														'<\/div><div class="card-body p-0">';
													grp.forEach(function(p) {
														var t = p.startTime ? new Date(p.startTime).toLocaleTimeString('sv-SE',{hour:'2-digit',minute:'2-digit'}) : '';
														body += '<div class="border-bottom px-3 py-2">' +
															'<div class="mb-1"><strong>Patrull ' + p.patrolNumber + '<\/strong>' +
															(t ? '<span class="text-muted ms-2"><i class="bi bi-clock me-1"><\/i>' + t + '<\/span>' : '') +
															'<span class="badge bg-secondary ms-2">' + p.members.length + '<\/span><\/div>';
														p.members.forEach(function(m) {
															body += '<div class="small ms-2">' + m.name +
																' <span class="text-muted">(' + (m.club || '') + ')<\/span>' +
																' <span class="badge bg-body-secondary text-body">' + m.shootingClass + '<\/span><\/div>';
														});
														body += '<\/div>';
													});
													body += '<\/div><\/div>';
												});
												var modalId = 'faltPatrolModal_@(Model.Id)';
												var existing = document.getElementById(modalId);
												if (existing) existing.remove();
												var modal = document.createElement('div');
												modal.id = modalId;
												modal.className = 'modal fade';
												modal.tabIndex = -1;
												modal.innerHTML = '<div class="modal-dialog modal-lg modal-dialog-scrollable">' +
													'<div class="modal-content"><div class="modal-header">' +
													'<h5 class="modal-title"><i class="bi bi-people me-2"><\/i>Patrullista<\/h5>' +
													'<button type="button" class="btn-close" data-bs-dismiss="modal"><\/button>' +
													'<\/div><div class="modal-body">' + body + '<\/div>' +
													'<div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Stäng<\/button><\/div>' +
													'<\/div><\/div>';
												document.body.appendChild(modal);
												bootstrap.Modal.getOrCreateInstance(modal).show();
											};
										}).catch(function() {});
								})();
								</script>
							}
							else if (isSpringskytte)
							{
								@* Springskytte: start lists are precisionStartList children directly under competition *@
								var springStartLists = competitionChildren
									.Where(c => c.ContentType.Alias == "precisionStartList")
									.ToList();
								if (springStartLists.Any())
								{
									foreach (var sl in springStartLists)
									{
										var slName = sl.Name;
										var slConfigJson = sl.Value<string>("configurationData");
										if (!string.IsNullOrEmpty(slConfigJson))
										{
											try
											{
												var slConfig = Newtonsoft.Json.JsonConvert.DeserializeObject<dynamic>(slConfigJson);
												var listName = (string)slConfig?.ListName;
												if (!string.IsNullOrEmpty(listName)) slName = listName;
											}
											catch { }
										}
										var hasCustomName = !string.IsNullOrEmpty(slName) && slName != "Startlista";
										var buttonText = hasCustomName ? $"Startlista: {slName}" : "Visa startlista";
										<a href="@sl.Url()" class="btn btn-info w-100 mb-1" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('startlistan'); }">
											<i class="bi bi-list-ol me-1"></i> @buttonText
										</a>
									}
								}
								else
								{
									<p class="text-muted small mb-0">
										<i class="bi bi-hourglass-split me-1"></i> Startlista har inte publicerats än.
									</p>
								}
							}
							else if (hasOfficialStartList)
							{
								<a href="@startListPageUrl" class="btn btn-info w-100" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('startlistan'); }">
									<i class="bi bi-list-ol me-1"></i> Visa startlista
								</a>
							}
							else
							{
								<p class="text-muted small mb-0">
									<i class="bi bi-hourglass-split me-1"></i> Startlista har inte publicerats än.
								</p>
							}
						</div>

						<!-- Results Section -->
						<div class="mt-2">
							@if (hasResultPage && isResultsOfficial)
							{
								<a href="@resultsUrl" class="btn btn-warning w-100" target="_blank" onclick="if (!currentUserIsLoggedIn) { event.preventDefault(); showLoginRequiredModal('resultatlistan'); }">
									<i class="bi bi-trophy me-1"></i> Visa resultat
