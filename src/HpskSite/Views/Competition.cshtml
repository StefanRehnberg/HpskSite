        role: '@regRole',
        memberId: @regMemberId,
        memberName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(currentMemberName))',
        email: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(regMemberEmail))',
        clubId: @(regClubId.HasValue ? regClubId.Value.ToString() : "null"),
        clubName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(regClubName))'
    },
    clubs: @Html.Raw(allClubsJson),
    competitionType: '@competitionTypeStr',
    rollingStart: @(rsConfig != null ? Html.Raw(rsJson) : Html.Raw("null")),
    subCompetitionName: '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(Model.HasProperty("subCompetitionName") ? Model.Value<string>("subCompetitionName") ?? "" : ""))',
    isDirektplacering: @(isDirektplacering.ToString().ToLower()),
    direktplaceringConfig: @(isDirektplacering ? Html.Raw(dpConfigJson) : Html.Raw("null"))
};

// Show success/error messages from server
@if (TempData["Success"] != null)
{
    var successMsg = TempData["Success"].ToString();
    var jsEncodedMsg = System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(successMsg);
    <text>
    showNotification('@Html.Raw(jsEncodedMsg)', 'success');

    // Show payment prompt for self-registrations only (not admin registering someone else)
    var msg = '@Html.Raw(jsEncodedMsg)';
    if (msg.indexOf('anmält dig') !== -1) {
        setTimeout(function() {
            showPaymentPrompt(@Model.Id);
        }, 1000);
    }
    </text>
}

@if (TempData["Error"] != null)
{
