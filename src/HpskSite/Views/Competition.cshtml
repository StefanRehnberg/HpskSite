@* DEBUG: swishNumber = "@swishNumber", hasSwishNumber = @hasSwishNumberValue *@
@if (!isSpringskytte)
{
<script>
// Configuration object for competition-registration.js
window.CompetitionConfig = {
    competitionId: @Model.Id,
