@* JavaScript for Information Sidebar *@
<script>
// Shared helper: format Springskytte age class with age span (e.g. "H 50" → "H 50-59")
window.formatAgeSpan = function(cls) {
    if (!cls) return cls;
    var inline = {'21':'21-34','35':'35-49','50':'50-59','60':'60-64','65':'65-69','70':'70+'};
    var parens = {'15':'-15 år','18':'16-18 år','jun':'15-20 år'};
    for (var code in inline) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls.substring(0, cls.length - code.length) + inline[code];
    }
    for (var code in parens) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls + ' (' + parens[code] + ')';
    }
    return cls;
};

// Current user information for highlighting
const currentUserName = '@Html.Raw(currentMemberName.Replace("'", "\\'"))';
const currentUserClub = '@Html.Raw(currentMemberClub.Replace("'", "\\'"))';
const currentUserIsLoggedIn = @(currentMember != null ? "true" : "false");

window.showLoginRequiredModal = function(whatLabel) {
    var body = document.getElementById('loginRequiredModalBody');
    if (body) body.textContent = 'Du behöver vara inloggad för att se ' + whatLabel + '.';
    var el = document.getElementById('loginRequiredModal');
    if (el) bootstrap.Modal.getOrCreateInstance(el).show();
};

window.openRegisteredShootersModal = function() {
    if (!currentUserIsLoggedIn) { showLoginRequiredModal('anmälda skyttar'); return; }
    var el = document.getElementById('registeredShootersModal');
    if (el) bootstrap.Modal.getOrCreateInstance(el).show();
};

document.addEventListener('DOMContentLoaded', function() {
    const competitionId = @Model.Id;

    @if (showLiveResults && !hasResultPage)
    {
        @* Only AJAX call needed: showLiveResults enabled but no result page — lightweight DB check *@
        <text>
    @if (isSpringskytte)
    {
        @:fetch(`/umbraco/surface/Springskytte/GetSpringskytteResults?competitionId=${competitionId}`)
    }
    else if (isFaltskytte)
    {
        @:fetch(`/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=${competitionId}`)
    }
    else
    {
        @:fetch(`/umbraco/surface/CompetitionResults/GetResultsStats?competitionId=${competitionId}`)
    }
        .then(response => response.json())
        .then(data => {
            var hasResults = @Html.Raw(isSpringskytte || isFaltskytte ? "data.success && data.results && data.results.classGroups && data.results.classGroups.length > 0" : "data.Success && data.Count > 0");
            if (hasResults) {
                var container = document.getElementById('liveResultsCheck');
                if (container) {
                    container.innerHTML = '<button class="btn btn-outline-light w-100 mt-2" onclick="openResultBoard()"><i class="bi bi-tv me-1"></i> Visa Live resultat</button>';
                }
            }
        })
        .catch(error => console.error('Error checking results:', error));
        </text>
    }

    // Handle registered shooters modal
    const registeredShootersModal = document.getElementById('registeredShootersModal');
    if (registeredShootersModal) {
        registeredShootersModal.addEventListener('show.bs.modal', function () {
            const modalBody = document.getElementById('registeredShootersModalBody');
            modalBody.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Laddar...</span></div></div>';

            fetch(`/umbraco/surface/Competition/GetCompetitionRegistrations?competitionId=${competitionId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.registrations && data.registrations.length > 0) {
                        // Group by shooter (memberId and memberName)
                        const shooterMap = new Map();
                        data.registrations.forEach(reg => {
                            const key = reg.memberId;
                            if (!shooterMap.has(key)) {
                                shooterMap.set(key, {
                                    name: reg.memberName,
                                    club: reg.memberClub || 'Okänd klubb',
                                    classes: []
                                });
                            }

                            // Add all shooting classes from this registration's shootingClasses array
                            if (reg.shootingClasses && Array.isArray(reg.shootingClasses)) {
                                reg.shootingClasses.forEach(sc => {
                                    // Use className for display, with age span for Springskytte
                                    var cls = sc.className || sc.class;
                                    shooterMap.get(key).classes.push(window.formatAgeSpan ? window.formatAgeSpan(cls) : cls);
                                });
                            }
                        });

                        // Build HTML
                        let html = '<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Namn</th><th>Förening</th><th>Klasser</th></tr></thead><tbody>';

                        // Sort by name
                        const shooters = Array.from(shooterMap.values()).sort((a, b) => a.name.localeCompare(b.name));

                        shooters.forEach(shooter => {
                            // Determine row class for highlighting
                            let rowClass = '';
                            if (currentUserName && shooter.name === currentUserName) {
                                rowClass = 'current-user';
                            } else if (currentUserClub && shooter.club === currentUserClub) {
                                rowClass = 'same-club';
                            }

                            html += `<tr class="${rowClass}">
                                <td>${shooter.name}</td>
                                <td>${shooter.club}</td>
                                <td>${shooter.classes.join(', ')}</td>
                            </tr>`;
                        });

                        html += '</tbody></table></div>';

                        // Calculate total starts (sum of all class entries)
                        const totalStarts = Array.from(shooterMap.values()).reduce((sum, shooter) => sum + shooter.classes.length, 0);
                        html += `<p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>${shooters.length} skyttar, ${totalStarts} starter totalt</p>`;

                        modalBody.innerHTML = html;
                    } else {
                        modalBody.innerHTML = '<p class="text-center text-muted">Inga anmälda skyttar än.</p>';
                    }
                })
                .catch(error => {
                    console.error('Error fetching registered shooters:', error);
                    modalBody.innerHTML = '<p class="text-center text-danger">Kunde inte ladda anmälda skyttar.</p>';
                });
        });
    }
});
</script>

@* ======================================== Live Result Board (Resultattavla) — opens in new tab ======================================== *@
@if (showLiveResults && !isExternal)
{
<script>
function openResultBoard() {
    var w = window.open('', '_blank');
    if (!w) { alert('Popup blockerad. Tillåt popups för denna sida.'); return; }

    var compName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(competitionName));
    var compId = @Model.Id;
    var hasFinalsRound = @(numberOfFinalSeries > 0 ? "true" : "false");
    var qualSeriesCount = @(numberOfFinalSeries > 0 ? numberOfSeriesOrStations - numberOfFinalSeries : numberOfSeriesOrStations);
    var numFinalSeries = @numberOfFinalSeries;
    var totalSeriesCount = @numberOfSeriesOrStations;
    var compTypeId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Value<string>("competitionType") ?? "Precision"));
    var configuredWCs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        competitionShootingClasses
            .Select(sc => sc.Weapon.ToString())
            .Distinct()
            .OrderBy(wc => { var o = new[] {"C","B","A","R","L","M"}; var i = Array.IndexOf(o, wc); return i < 0 ? 99 : i; })
            .ToArray()
    ));

    var css ='*{box-sizing:border-box}'
+'html,body{margin:0;padding:0;height:100%;overflow:hidden;font-family:Arial,sans-serif}'
+'body{background:#1a1a2e;color:#e0e0e0;display:flex;flex-direction:column}'
+'.rb-header{background:#16213e;border-bottom:1px solid #0f3460;padding:.5rem 1rem;display:flex;align-items:center;gap:.75rem;flex-shrink:0;flex-wrap:wrap}'
+'.rb-header h1{font-size:1.1rem;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0}'
+'.rb-badge-live{background:#27ae60;font-size:.75rem;letter-spacing:.05em;padding:.25rem .5rem;border-radius:.25rem;white-space:nowrap}'
+'.rb-badge-official{background:#f39c12;color:#1a1a2e;font-size:.75rem;letter-spacing:.05em;padding:.25rem .5rem;border-radius:.25rem;white-space:nowrap}'
+'.rb-pulse{animation:rbPulse 1.5s ease-in-out infinite}'
+'@@keyframes rbPulse{0%,100%{opacity:1}50%{opacity:.3}}'
+'.rb-wc-select{background:#1a1a2e;color:#e0e0e0;border:1px solid #0f3460;border-radius:.25rem;padding:.25rem .5rem;font-size:.85rem;cursor:pointer}'
+'.rb-wc-select:focus{outline:none;border-color:#4ecca3}'
+'.rb-ts{color:rgba(255,255,255,.5);font-size:.75rem;white-space:nowrap}'
+'.rb-table-wrap{flex:1;overflow-y:auto;padding:.5rem}'
+'.rb-table{width:100%;border-collapse:collapse;font-size:1.1rem}'
+'.rb-table th{position:sticky;top:0;background:#16213e;color:#4ecca3;padding:.45rem .5rem;text-align:center;font-weight:600;font-size:.85rem;border-bottom:2px solid #0f3460;z-index:1}'
+'.rb-table td{padding:.4rem .5rem;border-bottom:1px solid rgba(255,255,255,.06);text-align:center}'
+'.rb-table th:nth-child(2),.rb-table td:nth-child(2){text-align:left}'
+'.rb-table th:nth-child(4),.rb-table td:nth-child(4){text-align:left}'
+'.rb-table tbody tr:hover{background:rgba(78,204,163,.07)}'
+'.rb-pos-1{color:#ffd700;font-weight:700}'
+'.rb-pos-2{color:#c0c0c0;font-weight:700}'
+'.rb-pos-3{color:#cd7f32;font-weight:700}'
+'.rb-medal-s{color:#c0c0c0;font-weight:700}'
+'.rb-medal-b{color:#cd7f32;font-weight:700}'
+'.rb-subtotal{border-left:2px solid rgba(78,204,163,.4);font-weight:700;color:#4ecca3}'
+'@@media(max-width:767.98px){.rb-table{font-size:.95rem}.rb-table .rb-series-col{display:none}.rb-header{padding:.4rem .75rem}}'
+'@@media(min-width:768px) and (max-width:991.98px){.rb-table{font-size:.95rem}}'
+'@@media(max-height:500px){.rb-header{padding:.25rem .75rem}.rb-header h1{font-size:.9rem}.rb-table td,.rb-table th{padding:.25rem .4rem}}';

    var d = w.document;
    d.open();
    d.write('<!DOCTYPE html><html lang="sv"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1.0">');
    d.write('<title>Resultattavla \u2014 ' + compName + '</title>');
    d.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">');
    d.write('<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@@1.11.3/font/bootstrap-icons.min.css">');
    d.write('<style>' + css + '</style></head><body>');
    d.write('<div class="rb-header"><h1><i class="bi bi-trophy me-2"></i>' + compName + '</h1>');
    d.write('<span class="rb-badge-live" id="rbStatusBadge"><i class="bi bi-broadcast me-1 rb-pulse"></i>LIVE</span>');
    d.write('<select class="rb-wc-select" id="rbWcSelect"><option value="Alla">Alla</option></select>');
    d.write('<span class="rb-ts" id="rbLastUpdated"></span>');
    d.write('</div>');
    d.write('<div class="rb-table-wrap" id="rbTableWrap"><div style="text-align:center;padding:3rem 0"><div class="spinner-border text-light" role="status"></div></div></div>');
    d.close();

    var isSpringskytte = compTypeId === 'Springskytte';

    // Inject script into the new window after document is ready
    var s = w.document.createElement('script');
    s.textContent = '(' + rbBoardScript.toString() + ')(' + compId + ',' + hasFinalsRound + ',' + qualSeriesCount + ',' + numFinalSeries + ',' + totalSeriesCount + ',' + JSON.stringify(configuredWCs) + ',' + JSON.stringify(compTypeId) + ');';
    w.document.body.appendChild(s);
