@if (regMemberId > 0)
{
    <script>
    (function() {
        const unpaidCompetitionId = @Model.Id;
        const unpaidHasSwish = @(hasSwishNumberValue.ToString().ToLower());
        const unpaidFee = @(decimal.TryParse(registrationFee, out var _unpaidFee) ? _unpaidFee : 0m);

        if (!unpaidHasSwish || unpaidFee <= 0) return;

        fetch(`/umbraco/surface/Swish/GetUnpaidInvoices?competitionId=${unpaidCompetitionId}`)
            .then(r => r.json())
            .then(data => {
                if (!data.success || !data.invoices || data.invoices.length === 0) return;
                // Show the button in the Anmälan card
                const btnContainer = document.getElementById('unpaidInvoicesButtonContainer');
                if (btnContainer) btnContainer.style.display = 'block';

                // Populate modal on open
                document.getElementById('unpaidInvoicesModal')?.addEventListener('show.bs.modal', function() {
                    renderUnpaidInvoices(data.invoices);
                });
            })
            .catch(() => {});

        function renderUnpaidInvoices(invoices) {
            const body = document.getElementById('unpaidInvoicesModalBody');
            if (!body) return;

            let html = '<div class="list-group">';
            invoices.forEach(inv => {
                const typeLabel = inv.isTeam ? '<span class="badge bg-info me-1">Lag</span>' : '';
                html += `
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                ${typeLabel}<strong>${escapeHtmlUnpaid(inv.memberName)}</strong>
                                <div class="text-muted small">${escapeHtmlUnpaid(inv.invoiceNumber)} &middot; ${inv.createdDate}</div>
                            </div>
                            <span class="badge bg-warning text-dark fs-6">${inv.amount.toFixed(0)} kr</span>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm w-100" onclick="payUnpaidInvoice(${inv.id}, ${inv.isTeam}, ${inv.noInvoice || false})">
                            <i class="bi bi-qr-code me-1"></i>Betala med Swish
                        </button>
                    </div>`;
            });
            html += '</div>';
            body.innerHTML = html;
        }

        window.payUnpaidInvoice = function(invoiceId, isTeam, noInvoice) {
            // Hide unpaid invoices modal
            const unpaidModal = bootstrap.Modal.getInstance(document.getElementById('unpaidInvoicesModal'));
            if (unpaidModal) unpaidModal.hide();

            // Open Swish QR modal
            const swishModalEl = document.getElementById('swishPaymentModal');
            if (!swishModalEl) return;

            const modalBody = document.getElementById('swishPaymentModalBody');
            modalBody.innerHTML = `
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Laddar QR-kod...</span>
                </div>
                <p class="mt-2">Laddar betalningsinformation...</p>
            `;

            setTimeout(() => {
                bootstrap.Modal.getOrCreateInstance(swishModalEl).show();
            }, 200);

            // For no-invoice or individual: use GeneratePaymentQR (creates invoice on-the-fly)
            // For team invoices with existing invoice: use GenerateInvoiceQRCode
            let url;
            if (noInvoice || !isTeam) {
                url = `/umbraco/surface/Swish/GeneratePaymentQR?competitionId=${unpaidCompetitionId}`;
            } else {
                url = `/umbraco/surface/InvoiceAdmin/GenerateInvoiceQRCode?invoiceId=${invoiceId}`;
            }

            fetch(url)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const qrSrc = data.qrCode || (data.qrCodeBase64 ? `data:image/png;base64,${data.qrCodeBase64}` : '');
                        const invNum = data.invoiceNumber || '';
                        const amount = data.amount || '';
                        const swishAppButton = data.swishAppUrl ? `
                            <a href="${data.swishAppUrl}" class="btn btn-success btn-lg w-100 mb-2">
                                <i class="bi bi-phone me-1"></i> Öppna Swish och betala
                            </a>
                            <div class="text-muted small mb-3">— eller scanna QR-koden med Swish-appen på en annan telefon —</div>
                        ` : '';
                        modalBody.innerHTML = `
                            ${swishAppButton}
                            <div class="mb-3">
                                <img src="${qrSrc}" alt="Swish QR Code" style="max-width: 300px; width: 100%;" class="img-fluid">
                            </div>
                            <div class="alert alert-info text-start mb-0">
                                <p class="mb-1"><strong>Belopp:</strong> ${amount} kr</p>
                                ${data.includesSubCompetition ? `<p class="mb-1 small text-muted">Inkluderar ${data.subCompetitionFeeTotal} kr i deltävlingsavgift${data.subCompetitionName ? ` (${data.subCompetitionName})` : ''}.</p>` : ''}
                                ${data.shootingClasses ? `<p class="mb-1"><strong>Klasser:</strong> ${data.shootingClasses}</p>` : ''}
                                ${data.teamName ? `<p class="mb-1"><strong>Lag:</strong> ${data.teamName}</p>` : ''}
                                <p class="mb-0"><strong>Fakturanummer:</strong> ${invNum}</p>
                            </div>
                        `;
                    } else {
                        modalBody.innerHTML = `
                            <div class="alert alert-danger mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i>${data.message || 'Kunde inte skapa betalning.'}
                            </div>
                        `;
                    }
                })
                .catch(() => {
                    modalBody.innerHTML = `
                        <div class="alert alert-danger mb-0">
                            <i class="bi bi-exclamation-triangle me-1"></i>Ett nätverksfel uppstod.
                        </div>
                    `;
                });
        };

        function escapeHtmlUnpaid(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    })();
    </script>
}

