				<script>
					(function () {
						function openResultList() {
							var el = document.getElementById('resultListCollapse');
							if (!el) return;
							var inst = bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
							inst.show();
							var card = document.getElementById('resultatCard');
							if (card && card.scrollIntoView) {
								card.scrollIntoView({ behavior: 'smooth', block: 'start' });
							}
						}
						if (window.location.hash === '#resultat') {
							document.addEventListener('DOMContentLoaded', openResultList);
							if (document.readyState !== 'loading') openResultList();
						}
						window.addEventListener('hashchange', function () {
							if (window.location.hash === '#resultat') openResultList();
						});
					})();
				</script>
			}

		</div>

		@* ======================================== INTERNAL COMPETITION ONLY: Information Sidebar ======================================== *@
		@if (!isExternal)
		{
			<div class="col-lg-4">
				@* ======================================== Anmälan Card ======================================== *@
