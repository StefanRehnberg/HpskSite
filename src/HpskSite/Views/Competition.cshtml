@* JavaScript for Information Sidebar *@
<script>
// Shared helper: format Springskytte age class with age span (e.g. "H 50" → "H 50-59")
window.formatAgeSpan = function(cls) {
    if (!cls) return cls;
    var inline = {'21':'21-34','35':'35-49','50':'50-59','60':'60-64','65':'65-69','70':'70+'};
    var parens = {'15':'-15 år','18':'16-18 år','jun':'15-20 år'};
    for (var code in inline) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls.substring(0, cls.length - code.length) + inline[code];
    }
    for (var code in parens) {
        if (cls.endsWith(' ' + code) || cls.endsWith('-' + code))
            return cls + ' (' + parens[code] + ')';
    }
    return cls;
};

// Current user information for highlighting
const currentUserName = '@Html.Raw(currentMemberName.Replace("'", "\\'"))';
const currentUserClub = '@Html.Raw(currentMemberClub.Replace("'", "\\'"))';
const currentUserIsLoggedIn = @(currentMember != null ? "true" : "false");

window.showLoginRequiredModal = function(whatLabel) {
    var body = document.getElementById('loginRequiredModalBody');
    if (body) body.textContent = 'Du behöver vara inloggad för att se ' + whatLabel + '.';
    var el = document.getElementById('loginRequiredModal');
    if (el) bootstrap.Modal.getOrCreateInstance(el).show();
};

window.openRegisteredShootersModal = function() {
    if (!currentUserIsLoggedIn) { showLoginRequiredModal('anmälda skyttar'); return; }
    var el = document.getElementById('registeredShootersModal');
    if (el) bootstrap.Modal.getOrCreateInstance(el).show();
};

document.addEventListener('DOMContentLoaded', function() {
    const competitionId = @Model.Id;

    @if (showLiveResults && !hasResultPage)
    {
        @* Only AJAX call needed: showLiveResults enabled but no result page — lightweight DB check *@
        <text>
    @if (isSpringskytte)
    {
        @:fetch(`/umbraco/surface/Springskytte/GetSpringskytteResults?competitionId=${competitionId}`)
    }
    else if (isFaltskytte)
    {
        @:fetch(`/umbraco/surface/Faltskytte/GetFaltskytteResults?competitionId=${competitionId}`)
    }
    else
    {
        @:fetch(`/umbraco/surface/CompetitionResults/GetResultsStats?competitionId=${competitionId}`)
    }
        .then(response => response.json())
        .then(data => {
            var hasResults = @Html.Raw(isSpringskytte || isFaltskytte ? "data.success && data.results && data.results.classGroups && data.results.classGroups.length > 0" : "data.Success && data.Count > 0");
            if (hasResults) {
                var container = document.getElementById('liveResultsCheck');
                if (container) {
                    container.innerHTML = '<a class="btn btn-outline-secondary w-100 mt-2" href="/live?c=@Model.Id" target="_blank" rel="noopener"><i class="bi bi-tv me-1"></i> Visa Live resultat</a>';
                }
            }
        })
        .catch(error => console.error('Error checking results:', error));
        </text>
    }

    // Handle registered shooters modal
    const registeredShootersModal = document.getElementById('registeredShootersModal');
    if (registeredShootersModal) {
        registeredShootersModal.addEventListener('show.bs.modal', function () {
            const modalBody = document.getElementById('registeredShootersModalBody');
            modalBody.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Laddar...</span></div></div>';

            fetch(`/umbraco/surface/Competition/GetRegisteredShooters?competitionId=${competitionId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.registrations && data.registrations.length > 0) {
                        // Group by shooter (memberId and memberName)
                        const shooterMap = new Map();
                        data.registrations.forEach(reg => {
                            const key = reg.memberId;
                            if (!shooterMap.has(key)) {
                                shooterMap.set(key, {
                                    name: reg.memberName,
                                    club: reg.memberClub || 'Okänd klubb',
                                    classes: []
                                });
                            }

                            // Add all shooting classes from this registration's shootingClasses array
                            if (reg.shootingClasses && Array.isArray(reg.shootingClasses)) {
                                reg.shootingClasses.forEach(sc => {
                                    // Use className for display, with age span for Springskytte
                                    var cls = sc.className || sc.class;
                                    shooterMap.get(key).classes.push(window.formatAgeSpan ? window.formatAgeSpan(cls) : cls);
                                });
                            }
                        });

                        // Build HTML
                        let html = '<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Namn</th><th>Förening</th><th>Klasser</th></tr></thead><tbody>';

                        // Sort by name
                        const shooters = Array.from(shooterMap.values()).sort((a, b) => a.name.localeCompare(b.name));

                        shooters.forEach(shooter => {
                            // Determine row class for highlighting
                            let rowClass = '';
                            if (currentUserName && shooter.name === currentUserName) {
                                rowClass = 'current-user';
                            } else if (currentUserClub && shooter.club === currentUserClub) {
                                rowClass = 'same-club';
                            }

                            html += `<tr class="${rowClass}">
                                <td>${shooter.name}</td>
                                <td>${shooter.club}</td>
                                <td>${shooter.classes.join(', ')}</td>
                            </tr>`;
                        });

                        html += '</tbody></table></div>';

                        // Calculate total starts (sum of all class entries)
                        const totalStarts = Array.from(shooterMap.values()).reduce((sum, shooter) => sum + shooter.classes.length, 0);
                        html += `<p class="text-muted small mt-2 mb-0"><i class="bi bi-info-circle me-1"></i>${shooters.length} skyttar, ${totalStarts} starter totalt</p>`;

                        modalBody.innerHTML = html;
                    } else {
                        modalBody.innerHTML = '<p class="text-center text-muted">Inga anmälda skyttar än.</p>';
                    }
                })
                .catch(error => {
                    console.error('Error fetching registered shooters:', error);
                    modalBody.innerHTML = '<p class="text-center text-danger">Kunde inte ladda anmälda skyttar.</p>';
                });
        });
    }
});
</script>

