									</button>
								}
							}
							else if (showLiveResults)
							{
								@if (hasResultPage)
								{
									<button class="btn btn-outline-light w-100 mt-2" onclick="openResultBoard()">
										<i class="bi bi-tv me-1"></i> Visa Live resultat
									</button>
								}
								else
								{
