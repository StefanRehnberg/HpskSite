@model HpskSite.Controllers.TrainingPanelModel
@{
    Layout = null;
    var sv = new System.Globalization.CultureInfo("sv-SE");
    var m = Model;
    // ⚠️ ViewData till kortet byggs HÄR, i vyns toppblock — ett @{ } inne i else-grenen nedan
    // spräcker runtime-kompileringen utan meddelande (se razor-smafallor i minnet).
    var signupData = new ViewDataDictionary(ViewData);
    signupData["EventId"] = m.Id;
    signupData["Kind"] = HpskSite.Models.ClubEvents.OccasionTraining;
}
@functions {
    private static string WhenText(HpskSite.Controllers.TrainingPanelModel m, System.Globalization.CultureInfo sv)
    {
        var d = m.Date!.Value;
        var text = d.ToString("dddd d MMMM", sv);
        if (d.TimeOfDay != TimeSpan.Zero) text += " kl. " + d.ToString("HH:mm");
        if (m.EndDate.HasValue) text += "–" + m.EndDate.Value.ToString("HH:mm");
        return text;
    }
}
<!DOCTYPE html>
<html lang="sv" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(string.IsNullOrEmpty(m.Name) ? "Träning" : m.Name)</title>
    @* ⚠️ Panelen ligger i en iframe. Varje länk (inloggning, deltagarlistan) ska öppnas i
       FÖRÄLDERN, annars landar inloggningssidan inne i en liten dialog. *@
    <base target="_top">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="~/css/theme.css" rel="stylesheet" asp-append-version="true">
    <script>
        // Samma tema som sajten — läses ur samma nyckel som Master.cshtml.
        try { document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('hpsk-theme') || 'light'); } catch (e) { }
    </script>
    @await Html.PartialAsync("_RequestFailureNet")
    <style>
        body { background: var(--bs-body-bg); padding: 1rem; }
        .tp-facts { display: grid; grid-template-columns: auto 1fr; gap: .25rem .75rem; font-size: .95rem; }
        .tp-facts dt { color: var(--bs-secondary-color); font-weight: normal; }
        .tp-facts dd { margin: 0; }
    </style>
</head>
<body>
    @Html.AntiForgeryToken()
    @if (m.Error != null)
    {
        <div class="alert alert-warning mb-0">@m.Error</div>
    }
    else
    {
        <div id="tpHead">
            <div class="d-flex align-items-start gap-2 flex-wrap mb-2">
                <h1 class="h5 mb-0 me-auto">@m.Name</h1>
                @if (m.IsCancelled) { <span class="badge bg-danger">Inställd</span> }
                @if (m.IsMandatory) { <span class="badge bg-warning text-dark">Obligatorisk för klubbens medlemmar</span> }
            </div>
            <dl class="tp-facts mb-3">
                @if (m.Date.HasValue)
                {
                    <dt>När</dt>
                    <dd>@WhenText(m, sv)</dd>
                }
                @if (!string.IsNullOrEmpty(m.Venue)) { <dt>Var</dt><dd>@m.Venue</dd> }
                @if (!string.IsNullOrEmpty(m.Discipline)) { <dt>Gren</dt><dd>@m.Discipline</dd> }
                <dt>Skjutledare</dt><dd>@(string.IsNullOrEmpty(m.SkjutledareName) ? "Ingen utsedd än" : m.SkjutledareName)</dd>
                @if (!string.IsNullOrEmpty(m.ClubName)) { <dt>Klubb</dt><dd>@m.ClubName</dd> }
            </dl>
            @foreach (var c in m.MyCourses)
            {
                @* Nybörjaren ska själv se att tillfället hör till hens kurs och vad det kräver. *@
                <div class="alert alert-info py-2 mb-3" id="tpCourse">
                    <div><i class="bi bi-mortarboard me-1"></i>Ingår i din kurs <strong>@c.CourseName</strong></div>
                    @if (!string.IsNullOrWhiteSpace(c.Note)) { <div class="fw-semibold mt-1">@c.Note</div> }
                    @if (c.Mandatory) { <div class="mt-1"><span class="badge bg-warning text-dark">Obligatoriskt för din kurs</span></div> }
                    @if (c.RegistrationRequired) { <div class="small mt-1">Kursen kräver att du anmäler dig nedan.</div> }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(m.Description))
            {
                <p class="mb-3" style="white-space:pre-line">@m.Description</p>
            }
            @if (m.IsCancelled)
            {
                <div class="alert alert-danger py-2">Träningen är inställd.</div>
            }
            else if (!m.RegistrationRequired && !m.LoanWeaponsOffered && !m.MyCourses.Any(c => c.RegistrationRequired))
            {
                @* Utan anmälan visas inget kort — utan den här raden ser panelen ut att sakna en knapp. *@
                <div class="alert alert-light border py-2 mb-3" id="tpNoSignup"><i class="bi bi-door-open me-1"></i>Ingen anmälan behövs — kom direkt.</div>
            }
            @if (m.CanManage)
            {
                <p class="mb-3">
                    <a class="btn btn-sm btn-outline-primary" href="/evenemang/deltagare?e=@m.Id&kind=training" target="_blank" rel="noopener">
                        <i class="bi bi-list-check me-1"></i>Deltagarlistan och upprop
                    </a>
                </p>
            }
        </div>
        @await Html.PartialAsync("_ClubEventSignup", null, signupData)
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Höjden till dialogen, så att panelen aldrig får en egen rullningslist inne i en annan.
        (function () {
            function send() {
                try { parent.postMessage({ hpskTrainingPanelHeight: document.documentElement.scrollHeight }, location.origin); } catch (e) { }
            }
            if (window.ResizeObserver) new ResizeObserver(send).observe(document.body);
            window.addEventListener('load', send);
            setTimeout(send, 300);
        })();
    </script>
</body>
</html>
