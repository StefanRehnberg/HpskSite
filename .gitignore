# Visual Studio
.vs/

# Build outputs
[Bb]in/
[Oo]bj/

# User-specific files
*.user
*.suo

# Claude Code (local settings and plans)
.claude/

# NuGet
*.nupkg
nul

# Android keystore (NEVER commit!)
*.keystore
*.jks

# Firebase Admin SDK credentials (server-side - NEVER commit!)
*firebase-adminsdk*.json
firebase-service-account.json

# Note: google-services.json and GoogleService-Info.plist are CLIENT-SIDE
# Firebase configs that ARE safe to commit (security is via Firebase rules)

# Umbraco App_Data (runtime data)
App_Data/

# Log files
Logs/

# Sensitive configuration files (use .template.json versions instead)
appsettings.Production.json
appsettings.Development.json
**/Properties/launchSettings.json
/src/HpskSite/club-invitation-email.html
/src/HpskSite/hallandsserien-invitation-email.html
/src/HpskSite/series-announcement-email.html
/Marketing

# Curated content — see CONTENT.md
# (Code is source-available under FSL-1.1-Apache-2.0; the curated data/images/docs are not.)
/src/HpskSite/Clubs.json
/src/HpskSite/Associations.json
/src/HpskSite/access.txt
/src/HpskSite/wwwroot/images/
/src/HpskSite/wwwroot/assets/illustrations/
/src/HpskSite/KnowledgeBase/docs/
/src/HpskSite/Documentation/
# All docs belong under src/HpskSite/Documentation/ (above). A Documentation/ folder at the
# repo root is not ignored by that rule, so ignore it too — otherwise a doc written there
# silently becomes tracked/published.
/Documentation/

# Course / Utbildning lesson material is proprietary content and lives under App_Data/utbildning
# (already covered by the App_Data/ ignore above) — served only via the gated /innehall route,
# never as a static file. Deployed by file, not source.

# Operational scripts + DB migrations (run locally / in SSMS; not part of source)
/src/HpskSite/Migrations/
/src/HpskSite/publishToProd.ps1
/src/HpskSite/startsite.bat

# Reference documents shared by external contributors (not part of source)
/Pokalen 2 tidutrakning.xls
/*.xls
/*.xlsx
# Prospect club member export — contains real personnummer/PII, keep out of git
/MemberData/
/src/HpskSite/wwwroot/assets/skjuthandboken/

# Local working notes — session logs, findings, design sketches, handoffs.
# One rule instead of one exclude line per file: anything dropped in here is ignored,
# so a new findings file never has to be added anywhere. This is working material, NOT
# project documentation — that belongs in src/HpskSite/Documentation/ and is committed.
# README.md is deliberately tracked so the folder and its purpose survive a fresh clone.
# (backlog.md stays at the repo root: it is referenced by name from CLAUDE.md and two
# views, and is excluded via .git/info/exclude.)
/notes/*
!/notes/README.md

# hpsk-verify: verifieringsskripten committas (CLAUDE.md refererar dem per funktion),
# men aldrig deras beroenden. Playwright drar in 160+ filer och browsrarna laddas
# separat med `npx playwright install`.
/hpsk-verify/node_modules/

# ⚠️⚠️ PERSONUPPGIFTER FÅR INTE IN I DET HÄR REPOT — det är PUBLIKT på GitHub.
# SSMData/ är underlaget till SSM 2026-testdatat: 280 rader med namngivna skyttar, deras
# klubb och deras resultat. Resultaten är visserligen publicerade på pistol.nu, men en CSV
# i ett publikt repo är en annan spridning, och git-historiken går inte att städa i
# efterhand utan att skriva om main. Filerna behövs bara lokalt för att seeda dev.
# Samma regel gäller varje nytt exportunderlag: hör det hemma i en databas, inte i git.
/SSMData/

# Medlemsexporter som hamnar i reporoten. `medlemmar_2026-09-15.csv` låg ostagead här
# 2026-09-21, och exakt den filtypen har svepts med i en commit TVÅ gånger tidigare — varje
# gång via ett `git add -A`. En regel är billigare än en tredje historikstädning.
/medlemmar*.csv
/medlemsexport*.csv

# Skärmdumpar som klistras in i reporoten under felsökning. De är arbetsmaterial, och en
# skärmdump från en inloggad yta bär nästan alltid någons namn.
/Screenshot*.jpg
/Screenshot*.png

# Arbetsmaterial till ekonomibygget: verkliga klubbars bokföringsexempel, kontoplaner och
# underlag som delats för att vi ska förstå hur en kassör faktiskt arbetar. Det är någon
# annans räkenskapsinformation och hör inte i ett publikt repo. Planen och besluten som
# kommer UR materialet hör i notes/ekonomi-plan-2026-09-17.md, inte här.
/Ekonomi Exempel/
